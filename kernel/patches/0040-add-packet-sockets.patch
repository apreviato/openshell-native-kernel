diff --git a/kernel/libs/aster-bigtcp/src/iface/mod.rs b/kernel/libs/aster-bigtcp/src/iface/mod.rs
index c715802..6eca72f 100644
--- a/kernel/libs/aster-bigtcp/src/iface/mod.rs
+++ b/kernel/libs/aster-bigtcp/src/iface/mod.rs
@@ -27,6 +27,28 @@ pub fn config_generation() -> u64 {
     CONFIG_GENERATION.load(core::sync::atomic::Ordering::Acquire)
 }
 
+/// Hands every Ethernet frame an interface receives to `tap`, with the
+/// interface's index, while [`tap_frames`] says so (packet sockets).
+pub fn set_frame_tap(tap: fn(u32, &[u8])) {
+    FRAME_TAP.call_once(|| tap);
+}
+
+/// Whether received frames go to the tap: only while something listens,
+/// as each frame is copied for it.
+pub fn tap_frames(on: bool) {
+    TAPPING.store(on, core::sync::atomic::Ordering::Release);
+}
+
+pub(crate) fn frame_tap() -> Option<fn(u32, &[u8])> {
+    if !TAPPING.load(core::sync::atomic::Ordering::Acquire) {
+        return None;
+    }
+    FRAME_TAP.get().copied()
+}
+
+static FRAME_TAP: spin::Once<fn(u32, &[u8])> = spin::Once::new();
+static TAPPING: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
+
 pub(crate) fn bump_config_generation() {
     CONFIG_GENERATION.fetch_add(1, core::sync::atomic::Ordering::AcqRel);
 }
