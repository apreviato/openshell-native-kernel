@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: MPL-2.0
+
+use super::CSocketAddrFamily;
+use crate::{net::socket::packet::PacketSocketAddr, prelude::*};
+
+/// Linux's `struct sockaddr_ll`, the address of a packet socket.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Pod)]
+pub(crate) struct CSocketAddrLl {
+    /// Address family (AF_PACKET).
+    sll_family: u16,
+    /// The EtherType, in network byte order.
+    sll_protocol: u16,
+    sll_ifindex: i32,
+    /// The hardware type (`ARPHRD_ETHER`).
+    sll_hatype: u16,
+    sll_pkttype: u8,
+    /// The length of the hardware address.
+    sll_halen: u8,
+    sll_addr: [u8; 8],
+}
+
+impl From<PacketSocketAddr> for CSocketAddrLl {
+    fn from(value: PacketSocketAddr) -> Self {
+        let mut sll_addr = [0u8; 8];
+        sll_addr[..6].copy_from_slice(&value.address);
+        Self {
+            sll_family: CSocketAddrFamily::AF_PACKET as _,
+            sll_protocol: value.protocol.to_be(),
+            sll_ifindex: value.ifindex as i32,
+            sll_hatype: value.hardware_type,
+            sll_pkttype: value.packet_type,
+            sll_halen: 6,
+            sll_addr,
+        }
+    }
+}
+
+impl From<CSocketAddrLl> for PacketSocketAddr {
+    fn from(value: CSocketAddrLl) -> Self {
+        let mut address = [0u8; 6];
+        address.copy_from_slice(&value.sll_addr[..6]);
+        Self {
+            protocol: u16::from_be(value.sll_protocol),
+            ifindex: value.sll_ifindex.max(0) as u32,
+            hardware_type: value.sll_hatype,
+            packet_type: value.sll_pkttype,
+            address,
+        }
+    }
+}
