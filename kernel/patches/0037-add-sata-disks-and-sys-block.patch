new file mode 100755
index 0000000..28a5684
--- /dev/null
+++ b/kernel/comps/ahci/src/identify.rs
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! What IDENTIFY DEVICE tells of a disk (ACS-3, 7.12.7): its size, its
+//! logical block, the commands it takes, its model.
+
+use alloc::{string::String, vec::Vec};
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) struct Identity {
+    /// Logical blocks.
+    pub(crate) blocks: u64,
+    /// Bytes per logical block (512, or 4096 on "4Kn" disks).
+    pub(crate) logical: u64,
+    /// 48-bit addresses (READ/WRITE DMA EXT): every disk over 128 GiB.
+    pub(crate) lba48: bool,
+    /// FLUSH CACHE EXT.
+    pub(crate) flush_ext: bool,
+    pub(crate) model: String,
+}
+
+/// IDENTIFY DEVICE's 256 words; `None` for a disk without logical block
+/// addressing, without blocks, or with blocks of an odd size.
+pub(crate) fn parse_identify(data: &[u8]) -> Option<Identity> {
+    if data.len() < 512 {
+        return None;
+    }
+    let word = |index: usize| u16::from_le_bytes([data[2 * index], data[2 * index + 1]]);
+    // Logical block addressing (any disk since the 1990s).
+    if word(49) & (1 << 9) == 0 {
+        return None;
+    }
+    let lba48 = word(83) & (1 << 10) != 0;
+    let blocks = if lba48 {
+        (0..4).fold(0u64, |total, index| {
+            total | (u64::from(word(100 + index)) << (16 * index))
+        })
+    } else {
+        u64::from(word(60)) | (u64::from(word(61)) << 16)
+    };
+    // Words 117-118: the logical block's size in words, when word 106 is
+    // valid (bits 15:14 = 01) and says it is longer than 256 words.
+    let logical = if word(106) & 0xC000 == 0x4000 && word(106) & (1 << 12) != 0 {
+        (u64::from(word(117)) | (u64::from(word(118)) << 16)) * 2
+    } else {
+        512
+    };
+    if blocks == 0 || !matches!(logical, 512 | 1024 | 2048 | 4096) {
+        return None;
+    }
+    // The model: 40 characters, two per word, the first in the high byte.
+    let mut model = Vec::with_capacity(40);
+    for index in 27..47 {
+        let [low, high] = word(index).to_le_bytes();
+        model.extend([high, low]);
+    }
+    let model = String::from_utf8_lossy(&model).trim().into();
+    Some(Identity {
+        blocks,
+        logical,
+        lba48,
+        flush_ext: lba48 && word(83) & (1 << 13) != 0,
+        model,
+    })
+}
diff --git a/kernel/comps/ahci/src/lib.rs b/kernel/comps/ahci/src/lib.rs
new file mode 100755
index 0000000..38e0cdd
--- /dev/null
+++ b/kernel/comps/ahci/src/lib.rs
@@ -0,0 +1,158 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! SATA disks through AHCI controllers, the way nearly every PC since 2008
+//! connects its SATA SSDs and hard disks (Intel, AMD, ASMedia, JMicron,
+//! Marvell and the others, and Intel's "RAID" mode, which is AHCI as well).
+//! Each disk is a block device `sda`, `sdb`, ... (names shared with USB
+//! disks, as in Linux), with its partitions. Requests are served by one
+//! task per controller, woken by the controller's MSI interrupt, or each
+//! millisecond where it has none.
+
+#![no_std]
+#![deny(unsafe_code)]
+
+extern crate alloc;
+
+// This crate's log prefix for `ostd::log`.
+macro_rules! __log_prefix {
+    () => {
+        "ahci: "
+    };
+}
+
+mod disk;
+mod hba;
+mod identify;
+
+use alloc::{format, string::String, sync::Arc, vec::Vec};
+use core::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+use aster_pci::{
+    PCI_BUS, PciDeviceId,
+    bus::{PciDevice, PciDriver},
+    common_device::PciCommonDevice,
+};
+use component::{ComponentInitError, init_component};
+use ostd::{
+    bus::BusProbeError,
+    sync::{SpinLock, WaitQueue},
+    timer::Jiffies,
+};
+
+/// Wakes the controllers' tasks: requests, interrupts, the timer.
+static WAKE: WaitQueue = WaitQueue::new();
+static WOKEN: AtomicBool = AtomicBool::new(false);
+/// Tasks waiting for a command or for time to pass: the timer wakes them.
+static BUSY: AtomicUsize = AtomicUsize::new(0);
+/// Whether some controller has no interrupt: then the timer wakes the tasks
+/// each millisecond while commands run, rather than every 20.
+static POLLING: AtomicBool = AtomicBool::new(false);
+static TICKS: AtomicUsize = AtomicUsize::new(0);
+static PENDING: SpinLock<Vec<(PciCommonDevice, String)>> = SpinLock::new(Vec::new());
+static NAMES: AtomicUsize = AtomicUsize::new(0);
+
+pub(crate) fn now_ms() -> u64 {
+    Jiffies::elapsed().as_duration().as_millis() as u64
+}
+
+pub(crate) fn wake() {
+    WOKEN.store(true, Ordering::Release);
+    WAKE.wake_all();
+}
+
+/// Waits for a request, an interrupt or the timer.
+pub(crate) fn sleep() {
+    WAKE.wait_until(|| WOKEN.swap(false, Ordering::AcqRel).then_some(()));
+}
+
+/// Waits about `ms` milliseconds.
+pub(crate) fn sleep_ms(ms: u64) {
+    let deadline = now_ms() + ms;
+    BUSY.fetch_add(1, Ordering::AcqRel);
+    while now_ms() < deadline {
+        sleep();
+    }
+    BUSY.fetch_sub(1, Ordering::AcqRel);
+}
+
+/// Commands are running (`hba::Port::issue`), or not any more.
+pub(crate) fn busy(running: bool) {
+    if running {
+        BUSY.fetch_add(1, Ordering::AcqRel);
+    } else {
+        BUSY.fetch_sub(1, Ordering::AcqRel);
+    }
+}
+
+pub(crate) fn no_interrupt() {
+    POLLING.store(true, Ordering::Relaxed);
+}
+
+/// Each timer tick (1 ms): the tasks that wait, every tick without
+/// interrupts, every 20 with them (time-outs, a lost interrupt).
+fn tick() {
+    let ticks = TICKS.fetch_add(1, Ordering::Relaxed);
+    if BUSY.load(Ordering::Relaxed) == 0 {
+        return;
+    }
+    if POLLING.load(Ordering::Relaxed) || ticks % 20 == 0 {
+        wake();
+    }
+}
+
+/// AHCI (01:06:01); and Intel's RAID mode (01:04), which runs the same
+/// AHCI interface for its member disks, as Linux's `ahci` takes it.
+fn supports(id: &PciDeviceId) -> bool {
+    match (id.class, id.subclass, id.prog_if) {
+        (0x01, 0x06, 0x01) => true,
+        (0x01, 0x04, _) => id.vendor_id == 0x8086,
+        _ => false,
+    }
+}
+
+#[derive(Debug)]
+struct Claimed(PciDeviceId);
+
+impl PciDevice for Claimed {
+    fn device_id(&self) -> PciDeviceId {
+        self.0
+    }
+}
+
+#[derive(Debug)]
+struct Driver;
+
+impl PciDriver for Driver {
+    fn probe(
+        &self,
+        device: PciCommonDevice,
+    ) -> Result<Arc<dyn PciDevice>, (BusProbeError, PciCommonDevice)> {
+        let id = *device.device_id();
+        if !supports(&id) {
+            return Err((BusProbeError::DeviceNotMatch, device));
+        }
+        let name = format!("ahci{}", NAMES.fetch_add(1, Ordering::Relaxed));
+        PENDING.lock().push((device, name));
+        Ok(Arc::new(Claimed(id)))
+    }
+}
+
+#[init_component]
+fn init() -> Result<(), ComponentInitError> {
+    PCI_BUS.lock().register_driver(Arc::new(Driver));
+    ostd::timer::register_callback_on_cpu(tick);
+    Ok(())
+}
+
+// One task per controller, once there is a scheduler: it resets the
+// controller, finds the disks and serves their requests.
+#[init_component(kthread)]
+fn start() -> Result<(), ComponentInitError> {
+    for (device, name) in core::mem::take(&mut *PENDING.lock()) {
+        aster_core::spawn_kernel_thread(move || match hba::Controller::new(device, name) {
+            Some(controller) => controller.run(),
+            None => ostd::warn!("a SATA controller did not start"),
+        });
+    }
+    Ok(())
+}
