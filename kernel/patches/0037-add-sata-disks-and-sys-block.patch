diff --git a/kernel/core/src/fs/fs_impls/sysfs/block.rs b/kernel/core/src/fs/fs_impls/sysfs/block.rs
new file mode 100755
index 0000000..0b8932a
--- /dev/null
+++ b/kernel/core/src/fs/fs_impls/sysfs/block.rs
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! `/sys/block`: a directory for each disk (not its partitions), with what
+//! Linux tools and OpenShell's Drives read there:
+//!
+//! - `dev`: its numbers (`8:0`);
+//! - `size`: its size in 512-byte sectors;
+//! - `removable`: whether its medium can be taken out (a card reader, most
+//!   USB sticks);
+//! - `ro`: whether it is read-only (never, yet);
+//! - `device/vendor` and `device/model`: what the disk says of itself;
+//!   `ATA` is every SATA disk's vendor, as Linux's libata names it.
+
+use alloc::{format, string::String};
+
+use aster_block::BlockDevice;
+use aster_systree::{
+    BranchNodeFields, Error, Result, SysAttrSetBuilder, SysBranchNode, SysNode, SysPerms, SysStr,
+    inherit_sys_branch_node,
+};
+use aster_util::printer::VmPrinter;
+use inherit_methods_macro::inherit_methods;
+use ostd::mm::{VmReader, VmWriter};
+use spin::Once;
+
+use crate::prelude::*;
+
+static BLOCK_ROOT: Once<Arc<BlockRoot>> = Once::new();
+
+fn root() -> &'static Arc<BlockRoot> {
+    BLOCK_ROOT.call_once(|| {
+        let root = BlockRoot::new();
+        super::systree_singleton()
+            .root()
+            .add_child(root.clone())
+            .unwrap();
+        root
+    })
+}
+
+/// Gives a disk its `/sys/block/<name>` directory.
+pub(crate) fn add_disk(device: &Arc<dyn BlockDevice>) {
+    if device.is_partition() {
+        return;
+    }
+    let _ = root().add_child(DiskNode::new(device));
+}
+
+/// Takes a disk's directory away.
+pub(crate) fn remove_disk(device: &Arc<dyn BlockDevice>) {
+    if !device.is_partition() {
+        let _ = root().remove_child(device.name());
+    }
+}
+
+/// `/sys/block`.
+#[derive(Debug)]
+struct BlockRoot {
+    fields: BranchNodeFields<dyn SysNode, Self>,
+}
+
+#[inherit_methods(from = "self.fields")]
+impl BlockRoot {
+    fn new() -> Arc<Self> {
+        let attrs = SysAttrSetBuilder::new()
+            .build()
+            .expect("Failed to build the /sys/block attribute set");
+        Arc::new_cyclic(|weak_self| BlockRoot {
+            fields: BranchNodeFields::new(SysStr::from("block"), attrs, weak_self.clone()),
+        })
+    }
+
+    fn add_child(&self, new_child: Arc<dyn SysNode>) -> Result<()>;
+    fn remove_child(&self, child_name: &str) -> Result<Arc<dyn SysNode>>;
+}
+
+inherit_sys_branch_node!(BlockRoot, fields, {
+    fn read_attr_at(&self, _name: &str, _offset: usize, _writer: &mut VmWriter) -> Result<usize> {
+        Err(Error::AttributeError)
+    }
+
+    fn write_attr(&self, _name: &str, _reader: &mut VmReader) -> Result<usize> {
+        Err(Error::AttributeError)
+    }
+
+    fn perms(&self) -> SysPerms {
+        SysPerms::DEFAULT_RO_PERMS
+    }
+});
+
+fn read_only_attrs(names: &[&'static str]) -> aster_systree::SysAttrSet {
+    let mut builder = SysAttrSetBuilder::new();
+    for name in names {
+        builder.add(SysStr::from(*name), SysPerms::DEFAULT_RO_ATTR_PERMS);
+    }
+    builder
+        .build()
+        .expect("Failed to build a disk's attribute set")
+}
+
+fn print(text: &str, offset: usize, writer: &mut VmWriter) -> Result<usize> {
+    let mut printer = VmPrinter::new_skip(writer, offset);
+    writeln!(printer, "{}", text)?;
+    Ok(printer.bytes_written())
+}
+
+/// `/sys/block/<disk>`.
+#[derive(Debug)]
+struct DiskNode {
+    fields: BranchNodeFields<dyn SysNode, Self>,
+    device: Weak<dyn BlockDevice>,
+    dev: String,
+    removable: bool,
+}
+
+#[inherit_methods(from = "self.fields")]
+impl DiskNode {
+    fn new(device: &Arc<dyn BlockDevice>) -> Arc<Self> {
+        let id = device.id();
+        let node = Arc::new_cyclic(|weak_self| DiskNode {
+            fields: BranchNodeFields::new(
+                SysStr::from(String::from(device.name())),
+                read_only_attrs(&["dev", "size", "removable", "ro"]),
+                weak_self.clone(),
+            ),
+            device: Arc::downgrade(device),
+            dev: format!("{}:{}", id.major().get(), id.minor().get()),
+            removable: device.removable(),
+        });
+        let about = DeviceNode::new(
+            device.vendor().unwrap_or("").into(),
+            device.model().unwrap_or("").into(),
+        );
+        let _ = node.add_child(about);
+        node
+    }
+
+    fn add_child(&self, new_child: Arc<dyn SysNode>) -> Result<()>;
+}
+
+inherit_sys_branch_node!(DiskNode, fields, {
+    fn read_attr_at(&self, name: &str, offset: usize, writer: &mut VmWriter) -> Result<usize> {
+        match name {
+            "dev" => print(&self.dev, offset, writer),
+            "size" => {
+                let sectors = self
+                    .device
+                    .upgrade()
+                    .map_or(0, |device| device.metadata().nr_sectors);
+                print(&format!("{}", sectors), offset, writer)
+            }
+            "removable" => print(if self.removable { "1" } else { "0" }, offset, writer),
+            "ro" => print("0", offset, writer),
+            _ => Err(Error::AttributeError),
+        }
+    }
+
+    fn write_attr(&self, _name: &str, _reader: &mut VmReader) -> Result<usize> {
+        Err(Error::AttributeError)
+    }
+
+    fn perms(&self) -> SysPerms {
+        SysPerms::DEFAULT_RO_PERMS
+    }
+});
+
+/// `/sys/block/<disk>/device`.
+#[derive(Debug)]
+struct DeviceNode {
+    fields: BranchNodeFields<dyn SysNode, Self>,
+    vendor: String,
+    model: String,
+}
+
+#[inherit_methods(from = "self.fields")]
+impl DeviceNode {
+    fn new(vendor: String, model: String) -> Arc<Self> {
+        Arc::new_cyclic(|weak_self| DeviceNode {
+            fields: BranchNodeFields::new(
+                SysStr::from("device"),
+                read_only_attrs(&["vendor", "model"]),
+                weak_self.clone(),
+            ),
+            vendor,
+            model,
+        })
+    }
+}
+
+inherit_sys_branch_node!(DeviceNode, fields, {
+    fn read_attr_at(&self, name: &str, offset: usize, writer: &mut VmWriter) -> Result<usize> {
+        match name {
+            "vendor" => print(&self.vendor, offset, writer),
+            "model" => print(&self.model, offset, writer),
+            _ => Err(Error::AttributeError),
+        }
+    }
+
+    fn write_attr(&self, _name: &str, _reader: &mut VmReader) -> Result<usize> {
+        Err(Error::AttributeError)
+    }
+
+    fn perms(&self) -> SysPerms {
+        SysPerms::DEFAULT_RO_PERMS
+    }
+});
