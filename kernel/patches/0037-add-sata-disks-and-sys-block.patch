new file mode 100755
index 0000000..f080636
--- /dev/null
+++ b/kernel/core/comps/block/src/scsi_disk.rs
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The names and numbers of SCSI-style disks, which SATA and USB disks share
+//! as in Linux: `sda`, `sdb`, ... `sdz`, `sdaa`, ..., with major number 8
+//! (or another free one) and 16 minors each. A name freed by a disk that
+//! went away goes to the next disk, as Linux's lowest free index does.
+
+use alloc::{collections::BTreeSet, format};
+
+use device_id::{DeviceId, MajorId, MinorId};
+use ostd::sync::Mutex;
+use spin::Once;
+
+use crate::{DEVICE_MINORS, MajorIdOwner, acquire_major, allocate_major, prelude::*};
+
+/// Linux's SCSI disk major number.
+const SCSI_DISK_MAJOR: u16 = 8;
+
+static MAJOR: Once<Option<MajorIdOwner>> = Once::new();
+static TAKEN: Mutex<BTreeSet<u32>> = Mutex::new(BTreeSet::new());
+
+/// A disk's name and numbers, held until it is released.
+#[derive(Debug)]
+pub struct ScsiDiskIdentity {
+    name: String,
+    id: DeviceId,
+    index: u32,
+}
+
+impl ScsiDiskIdentity {
+    /// The lowest free name (`sda` first) and its device numbers.
+    pub fn take() -> Option<Self> {
+        let major = MAJOR
+            .call_once(|| {
+                acquire_major(MajorId::new(SCSI_DISK_MAJOR))
+                    .or_else(|_| allocate_major())
+                    .ok()
+            })
+            .as_ref()?
+            .get();
+        let mut taken = TAKEN.lock();
+        let index = (0..).find(|index| !taken.contains(index))?;
+        let minor = index.checked_mul(DEVICE_MINORS)?;
+        if minor > 0xF_FFFF {
+            return None;
+        }
+        taken.insert(index);
+        Some(Self {
+            name: disk_name(index),
+            id: DeviceId::new(major, MinorId::new(minor)),
+            index,
+        })
+    }
+
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+
+    pub fn id(&self) -> DeviceId {
+        self.id
+    }
+}
+
+impl Drop for ScsiDiskIdentity {
+    fn drop(&mut self) {
+        TAKEN.lock().remove(&self.index);
+    }
+}
+
+/// sda .. sdz, then sdaa, as Linux names them.
+fn disk_name(index: u32) -> String {
+    let mut letters = Vec::new();
+    let mut n = index + 1;
+    while n > 0 {
+        n -= 1;
+        letters.push(b'a' + (n % 26) as u8);
+        n /= 26;
+    }
+    letters.reverse();
+    format!("sd{}", String::from_utf8(letters).unwrap_or_default())
+}
