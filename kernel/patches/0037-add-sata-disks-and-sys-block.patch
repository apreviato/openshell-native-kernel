index 0000000..1f97236
--- /dev/null
+++ b/kernel/comps/ahci/src/disk.rs
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! A SATA disk as the kernel's block device `sda`, `sdb`, ...: its requests
+//! wait in a queue that its controller's task serves (`crate::hba`).
+
+use alloc::{collections::VecDeque, string::String, sync::Arc};
+
+use aster_block::{
+    BlockDevice, BlockDeviceMeta, PartitionManager, ScsiDiskIdentity,
+    bio::{BioEnqueueError, SubmittedBio},
+};
+use device_id::DeviceId;
+use ostd::sync::{LocalIrqDisabled, SpinLock};
+
+pub(crate) struct AhciDisk {
+    identity: ScsiDiskIdentity,
+    /// 512-byte sectors.
+    sectors: usize,
+    pub(crate) queue: SpinLock<VecDeque<SubmittedBio>, LocalIrqDisabled>,
+    partitions: PartitionManager,
+    model: String,
+}
+
+impl core::fmt::Debug for AhciDisk {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.debug_struct("AhciDisk")
+            .field("name", &self.identity.name())
+            .field("sectors", &self.sectors)
+            .finish()
+    }
+}
+
+impl AhciDisk {
+    pub(crate) fn new(sectors: usize, model: String) -> Option<Arc<Self>> {
+        Some(Arc::new(Self {
+            identity: ScsiDiskIdentity::take()?,
+            sectors,
+            queue: SpinLock::new(VecDeque::new()),
+            partitions: PartitionManager::new(),
+            model,
+        }))
+    }
+
+    pub(crate) fn name(&self) -> &str {
+        self.identity.name()
+    }
+}
+
+impl BlockDevice for AhciDisk {
+    fn enqueue(&self, bio: SubmittedBio) -> Result<(), BioEnqueueError> {
+        self.queue.lock().push_back(bio);
+        crate::wake();
+        Ok(())
+    }
+
+    fn metadata(&self) -> BlockDeviceMeta {
+        BlockDeviceMeta {
+            max_nr_segments_per_bio: crate::hba::MAX_PRDT,
+            nr_sectors: self.sectors,
+        }
+    }
+
+    fn name(&self) -> &str {
+        self.identity.name()
+    }
+
+    fn id(&self) -> DeviceId {
+        self.identity.id()
+    }
+
+    fn partition_manager(&self) -> Option<&PartitionManager> {
+        Some(&self.partitions)
+    }
+
+    /// "ATA", as Linux's libata names the vendor of every SATA disk
+    /// (/sys/block/sdX/device/vendor): how a SATA disk tells from a USB one.
+    fn vendor(&self) -> Option<&str> {
+        Some("ATA")
+    }
+
+    fn model(&self) -> Option<&str> {
+        Some(&self.model)
+    }
+}
diff --git a/kernel/comps/ahci/src/hba.rs b/kernel/comps/ahci/src/hba.rs
new file mode 100755
index 0000000..373a6ad
--- /dev/null
+++ b/kernel/comps/ahci/src/hba.rs
@@ -0,0 +1,753 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The controller (the HBA of AHCI 1.3.1): its hand-over from the firmware
+//! and reset, its ports and the disks on them, and their commands. One
+//! command at a time per port, in slot 0: a request becomes READ/WRITE DMA
+//! (EXT) commands of up to MAX_PRDT pieces each, or a FLUSH CACHE (EXT).
+
+use alloc::{collections::VecDeque, string::String, sync::Arc, vec, vec::Vec};
+use core::sync::atomic::{AtomicU32, Ordering};
+
+use aster_block::bio::{BioStatus, BioType, SubmittedBio};
+use aster_pci::{
+    capability::msi::CapabilityMsiData, cfg_space::BarAccess, common_device::PciCommonDevice,
+};
+use ostd::{
+    io::IoMem,
+    irq::IrqLine,
+    mm::{HasDaddr, HasSize, VmIo, VmIoOnce, dma::DmaCoherent},
+};
+
+use crate::{disk::AhciDisk, identify::parse_identify, now_ms, sleep_ms};
+
+/// Pieces of a command's scatter-gather list: a 4 KiB command table holds
+/// 248 after its 128-byte header.
+pub(crate) const MAX_PRDT: usize = 248;
+/// The most one piece may hold (AHCI's 22-bit byte count).
+const PRD_MAX_BYTES: u64 = 4 << 20;
+/// How long a command may take, as Linux's SCSI layer waits.
+const COMMAND_TIMEOUT_MS: u64 = 30_000;
+
+/// The controller's registers.
+mod reg {
+    pub(super) const CAP: usize = 0x00;
+    pub(super) const GHC: usize = 0x04;
+    pub(super) const IS: usize = 0x08;
+    pub(super) const PI: usize = 0x0C;
+    pub(super) const CAP2: usize = 0x24;
+    pub(super) const BOHC: usize = 0x28;
+}
+
+/// A port's registers, from its base (0x100 + 0x80 × port).
+mod port {
+    pub(super) const CLB: usize = 0x00;
+    pub(super) const CLBU: usize = 0x04;
+    pub(super) const FB: usize = 0x08;
+    pub(super) const FBU: usize = 0x0C;
+    pub(super) const IS: usize = 0x10;
+    pub(super) const IE: usize = 0x14;
+    pub(super) const CMD: usize = 0x18;
+    pub(super) const TFD: usize = 0x20;
+    pub(super) const SIG: usize = 0x24;
+    pub(super) const SSTS: usize = 0x28;
+    pub(super) const SCTL: usize = 0x2C;
+    pub(super) const SERR: usize = 0x30;
+    pub(super) const CI: usize = 0x38;
+}
+
+const CAP_S64A: u32 = 1 << 31;
+const CAP_SCLO: u32 = 1 << 24;
+const GHC_HR: u32 = 1 << 0;
+const GHC_IE: u32 = 1 << 1;
+const GHC_AE: u32 = 1 << 31;
+const CAP2_BOH: u32 = 1 << 0;
+const BOHC_BOS: u32 = 1 << 0;
+const BOHC_OOS: u32 = 1 << 1;
+const BOHC_BB: u32 = 1 << 4;
+
+const CMD_ST: u32 = 1 << 0;
+const CMD_SUD: u32 = 1 << 1;
+const CMD_POD: u32 = 1 << 2;
+const CMD_CLO: u32 = 1 << 3;
+const CMD_FRE: u32 = 1 << 4;
+const CMD_FR: u32 = 1 << 14;
+const CMD_CR: u32 = 1 << 15;
+
+const TFD_ERR: u32 = 1 << 0;
+const TFD_DRQ: u32 = 1 << 3;
+const TFD_BSY: u32 = 1 << 7;
+
+/// PxIS errors: task file, host bus fatal and data, interface fatal and
+/// non-fatal, overflow.
+const IS_ERRORS: u32 = (1 << 30) | (1 << 29) | (1 << 28) | (1 << 27) | (1 << 26) | (1 << 24);
+/// What interrupts: the device's FISes (register, PIO setup, DMA setup, set
+/// device bits), a finished piece, and the errors.
+const IE_MASK: u32 = 0b10_1111 | IS_ERRORS;
+
+/// A disk (ATA), an optical drive (ATAPI), a port multiplier.
+const SIG_ATA: u32 = 0x0000_0101;
+const SIG_ATAPI: u32 = 0xEB14_0101;
+const SIG_PM: u32 = 0x9669_0101;
+
+mod ata {
+    pub(super) const IDENTIFY: u8 = 0xEC;
+    pub(super) const READ_DMA: u8 = 0xC8;
+    pub(super) const WRITE_DMA: u8 = 0xCA;
+    pub(super) const READ_DMA_EXT: u8 = 0x25;
+    pub(super) const WRITE_DMA_EXT: u8 = 0x35;
+    pub(super) const FLUSH_CACHE: u8 = 0xE7;
+    pub(super) const FLUSH_CACHE_EXT: u8 = 0xEA;
+}
+
+/// The controller's registers.
+struct Regs(IoMem);
+
+impl Regs {
+    fn read(&self, at: usize) -> u32 {
+        self.0.read_once::<u32>(at).unwrap_or(u32::MAX)
+    }
+
+    fn write(&self, at: usize, value: u32) {
+        let _ = self.0.write_once::<u32>(at, &value);
+    }
+
+    fn port_read(&self, n: usize, at: usize) -> u32 {
+        self.read(0x100 + 0x80 * n + at)
+    }
+
+    fn port_write(&self, n: usize, at: usize, value: u32) {
+        self.write(0x100 + 0x80 * n + at, value);
+    }
+
+    /// Whether `done` holds within `ms` milliseconds.
+    fn wait(&self, ms: u64, done: impl Fn(&Self) -> bool) -> bool {
+        let deadline = now_ms() + ms;
+        loop {
+            if done(self) {
+                return true;
+            }
+            if now_ms() >= deadline {
+                return false;
+            }
+            sleep_ms(1);
+        }
+    }
+}
+
+/// The interrupt: each port's status, cleared, for the task (MSI is edge
+/// triggered: the port's register first, then the controller's).
+fn interrupt(io: &IoMem, events: &[AtomicU32; 32]) {
+    let pending = io.read_once::<u32>(reg::IS).unwrap_or(0);
+    if pending == 0 || pending == u32::MAX {
+        return;
+    }
+    for (n, event) in events.iter().enumerate() {
+        if pending & (1 << n) != 0 {
+            let at = 0x100 + 0x80 * n + port::IS;
+            let status = io.read_once::<u32>(at).unwrap_or(0);
+            let _ = io.write_once::<u32>(at, &status);
+            event.fetch_or(status, Ordering::AcqRel);
+        }
+    }
+    let _ = io.write_once::<u32>(reg::IS, &pending);
+    crate::wake();
+}
+
+/// One ATA command, ready for slot 0.
+#[derive(Debug)]
+struct Command {
+    ata: u8,
+    lba: u64,
+    /// Logical blocks (0 with LBA28 is 256).
+    count: u32,
+    write: bool,
+    /// Bus addresses and lengths.
+    prds: Vec<(u64, u32)>,
+}
+
+/// The commands that do a request (`None`: one the disk cannot do).
+fn plan(
+    bio: &SubmittedBio,
+    logical: u64,
+    blocks: u64,
+    lba48: bool,
+    flush_ext: bool,
+    s64a: bool,
+) -> Option<VecDeque<Command>> {
+    let write = match bio.type_() {
+        BioType::Read => false,
+        BioType::Write => true,
+        BioType::Flush => {
+            let ata = if flush_ext {
+                ata::FLUSH_CACHE_EXT
+            } else {
+                ata::FLUSH_CACHE
+            };
+            return Some(VecDeque::from([Command {
+                ata,
+                lba: 0,
+                count: 0,
+                write: false,
+                prds: Vec::new(),
+            }]));
+        }
+    };
+    let ata = match (write, lba48) {
+        (false, true) => ata::READ_DMA_EXT,
+        (true, true) => ata::WRITE_DMA_EXT,
+        (false, false) => ata::READ_DMA,
+        (true, false) => ata::WRITE_DMA,
+    };
+    let max_bytes = if lba48 { 65535 } else { 256 } * logical;
+    // A partition's requests carry its start (`sid_offset`).
+    let mut at = (bio.sid_range().start.to_raw() + bio.sid_offset()) * 512;
+    let mut commands = VecDeque::new();
+    let mut prds = Vec::new();
+    let mut bytes = 0u64;
+    let mut finish = |prds: &mut Vec<(u64, u32)>, bytes: &mut u64, at: &mut u64| -> Option<()> {
+        if *at % logical != 0 || *bytes % logical != 0 {
+            return None;
+        }
+        let (lba, count) = (*at / logical, *bytes / logical);
+        if lba + count > blocks {
+            return None;
+        }
+        commands.push_back(Command {
+            ata,
+            lba,
+            count: count as u32,
+            write,
+            prds: core::mem::take(prds),
+        });
+        *at += *bytes;
+        *bytes = 0;
+        Some(())
+    };
+    for segment in bio.segments() {
+        let slice = segment.dma_slice();
+        let mut address = slice.daddr() as u64;
+        let mut left = slice.size() as u64;
+        while left > 0 {
+            let piece = left.min(PRD_MAX_BYTES).min(max_bytes - bytes);
+            // Pieces are whole words; without 64-bit addressing, below 4 GiB.
+            if address % 2 != 0 || piece % 2 != 0 || (!s64a && address + piece > 1 << 32) {
+                return None;
+            }
+            prds.push((address, piece as u32));
+            bytes += piece;
+            address += piece;
+            left -= piece;
+            if prds.len() == MAX_PRDT || bytes == max_bytes {
+                finish(&mut prds, &mut bytes, &mut at)?;
+            }
+        }
+    }
+    if !prds.is_empty() {
+        finish(&mut prds, &mut bytes, &mut at)?;
+    }
+    Some(commands)
+}
+
+/// A request being done: its commands still to go.
+struct Job {
+    bio: SubmittedBio,
+    commands: VecDeque<Command>,
+    /// Its current command failed once and runs again.
+    retried: bool,
+}
+
+enum Progress {
+    Running,
+    Done,
+    Failed,
+}
+
+/// A port's command slot 0 and its memory.
+struct Slot {
+    n: usize,
+    /// The command list (1 KiB) and, at 1 KiB, the received FISes.
+    lists: DmaCoherent,
+    /// Slot 0's command table.
+    table: DmaCoherent,
+    /// The port's interrupt status since its command was issued.
+    status: u32,
+    issued_at: u64,
+}
+
+/// A port with a disk.
+struct Port {
+    slot: Slot,
+    disk: Arc<AhciDisk>,
+    blocks: u64,
+    logical: u64,
+    lba48: bool,
+    flush_ext: bool,
+    job: Option<Job>,
+}
+
+pub(crate) struct Controller {
+    name: String,
+    regs: Regs,
+    cap: u32,
+    ports: Vec<Port>,
+    events: Arc<[AtomicU32; 32]>,
+    /// Holds the interrupt line.
+    _msi: Option<CapabilityMsiData>,
+}
+
+impl Controller {
+    pub(crate) fn new(mut device: PciCommonDevice, name: String) -> Option<Self> {
+        let id = *device.device_id();
+        let location = *device.location();
+        // Memory decoding and bus mastering; INTx stays off (MSI or polling).
+        location.write16(0x04, location.read16(0x04) | 0x0406);
+        let io = match device.bar_manager_mut().bar_mut(5)?.acquire().ok()? {
+            BarAccess::Memory(io) => io,
+            BarAccess::Io => return None,
+        };
+        let regs = Regs(io);
+        let events: Arc<[AtomicU32; 32]> = Arc::new(core::array::from_fn(|_| AtomicU32::new(0)));
+        let mut msi = device.acquire_msi_capability();
+        let interrupts = match (msi.as_mut(), IrqLine::alloc()) {
+            (Some(msi), Ok(mut irq)) => {
+                let io = regs.0.clone();
+                let events = events.clone();
+                irq.on_active(move |_| interrupt(&io, &events));
+                msi.set_interrupt_vector(irq);
+                true
+            }
+            _ => {
+                crate::no_interrupt();
+                ostd::notice!("{}: no MSI; polling", name);
+                false
+            }
+        };
+
+        // The firmware hands the controller over (BIOS/OS handoff).
+        if regs.read(reg::CAP2) & CAP2_BOH != 0 && regs.read(reg::BOHC) & BOHC_BOS != 0 {
+            regs.write(reg::BOHC, regs.read(reg::BOHC) | BOHC_OOS);
+            if !regs.wait(25, |regs| regs.read(reg::BOHC) & BOHC_BOS == 0)
+                && regs.read(reg::BOHC) & BOHC_BB != 0
+            {
+                regs.wait(2000, |regs| regs.read(reg::BOHC) & BOHC_BOS == 0);
+            }
+        }
+        // Reset; the ports the firmware enabled stay so.
+        let implemented = regs.read(reg::PI);
+        regs.write(reg::GHC, regs.read(reg::GHC) | GHC_AE);
+        regs.write(reg::GHC, regs.read(reg::GHC) | GHC_HR);
+        if !regs.wait(1000, |regs| regs.read(reg::GHC) & GHC_HR == 0) {
+            ostd::warn!("{}: the controller does not reset", name);
+            return None;
+        }
+        regs.write(reg::GHC, GHC_AE);
+        if regs.read(reg::PI) == 0 {
+            regs.write(reg::PI, implemented);
+        }
+        let implemented = regs.read(reg::PI);
+        // Intel's port enable bits (PCS), which a reset may clear: Linux's
+        // ahci_intel_pcs_quirk, for the chipsets before Denverton.
+        if id.vendor_id == 0x8086 && !(0x19b0..=0x19cf).contains(&id.device_id) {
+            let pcs = location.read16(0x92);
+            let wanted = (implemented & 0xff) as u16;
+            if pcs & wanted != wanted {
+                location.write16(0x92, pcs | wanted);
+            }
+        }
+        let cap = regs.read(reg::CAP);
+        let s64a = cap & CAP_S64A != 0;
+
+        // Every implemented port idle and set up, its link reset where it is
+        // not up, all together; then the disks.
+        let mut ready = Vec::new();
+        for n in (0..32).filter(|n| implemented & (1 << n) != 0) {
+            if let Some(memory) = prepare_port(&regs, n, s64a) {
+                ready.push((n, memory));
+            }
+        }
+        let det = |regs: &Regs, n: usize| regs.port_read(n, port::SSTS) & 0xF;
+        let down: Vec<usize> = ready
+            .iter()
+            .map(|(n, _)| *n)
+            .filter(|&n| det(&regs, n) != 3)
+            .collect();
+        if !down.is_empty() {
+            for &n in &down {
+                let sctl = regs.port_read(n, port::SCTL) & !0xF0F;
+                regs.port_write(n, port::SCTL, sctl | 0x301);
+            }
+            sleep_ms(2);
+            for &n in &down {
+                let sctl = regs.port_read(n, port::SCTL) & !0xF0F;
+                regs.port_write(n, port::SCTL, sctl | 0x300);
+            }
+            regs.wait(300, |regs| down.iter().all(|&n| det(regs, n) == 3));
+        }
+        let mut controller = Self {
+            name,
+            regs,
+            cap,
+            ports: Vec::new(),
+            events,
+            _msi: msi,
+        };
+        for (n, (lists, table)) in ready {
+            if det(&controller.regs, n) == 3 {
+                controller.start_port(n, lists, table);
+            }
+        }
+        if interrupts {
+            controller.regs.write(reg::IS, u32::MAX);
+            controller.regs.write(reg::GHC, GHC_AE | GHC_IE);
+        }
+        if controller.ports.is_empty() {
+            ostd::notice!("{}: no disks", controller.name);
+        }
+        Some(controller)
+    }
+
+    /// The disk on port `n`: ready, identified, offered to the system.
+    fn start_port(&mut self, n: usize, lists: DmaCoherent, table: DmaCoherent) {
+        let regs = &self.regs;
+        // Ready: not busy (a hard disk spinning up takes seconds).
+        if !regs.wait(10_000, |regs| {
+            regs.port_read(n, port::TFD) & (TFD_BSY | TFD_DRQ) == 0
+        }) {
+            ostd::warn!("{}: port {}: the device stays busy", self.name, n);
+            return;
+        }
+        match regs.port_read(n, port::SIG) {
+            SIG_ATA => {}
+            SIG_ATAPI => {
+                ostd::notice!(
+                    "{}: port {}: an optical drive (not supported)",
+                    self.name,
+                    n
+                );
+                return;
+            }
+            SIG_PM => {
+                ostd::notice!(
+                    "{}: port {}: a port multiplier (not supported)",
+                    self.name,
+                    n
+                );
+                return;
+            }
+            signature => {
+                ostd::notice!(
+                    "{}: port {}: a device of signature {:#x} (not supported)",
+                    self.name,
+                    n,
+                    signature
+                );
+                return;
+            }
+        }
+        regs.port_write(n, port::SERR, u32::MAX);
+        regs.port_write(n, port::IS, u32::MAX);
+        regs.port_write(n, port::CMD, regs.port_read(n, port::CMD) | CMD_ST);
+        regs.port_write(n, port::IE, IE_MASK);
+
+        let Ok(buffer) = DmaCoherent::alloc(1, true) else {
+            return;
+        };
+        let mut slot = Slot {
+            n,
+            lists,
+            table,
+            status: 0,
+            issued_at: 0,
+        };
+        let identify = Command {
+            ata: ata::IDENTIFY,
+            lba: 0,
+            count: 0,
+            write: false,
+            prds: vec![(buffer.daddr() as u64, 512)],
+        };
+        let mut data = [0u8; 512];
+        let identity = self
+            .run_now(&mut slot, &identify)
+            .then(|| buffer.read_bytes(0, &mut data[..]).ok())
+            .flatten()
+            .and_then(|()| parse_identify(&data));
+        let Some(identity) = identity else {
+            ostd::warn!(
+                "{}: port {}: the disk does not identify itself",
+                self.name,
+                n
+            );
+            return;
+        };
+        let sectors = (identity.blocks * identity.logical / 512) as usize;
+        let Some(disk) = AhciDisk::new(sectors, identity.model.clone()) else {
+            return;
+        };
+        ostd::notice!(
+            "{}: port {}: {}: {} ({} MB{}{})",
+            self.name,
+            n,
+            disk.name(),
+            identity.model,
+            sectors / 2048,
+            if identity.logical != 512 {
+                ", 4096-byte sectors"
+            } else {
+                ""
+            },
+            if identity.lba48 { "" } else { ", LBA28" }
+        );
+        self.ports.push(Port {
+            slot,
+            disk: disk.clone(),
+            blocks: identity.blocks,
+            logical: identity.logical,
+            lba48: identity.lba48,
+            flush_ext: identity.flush_ext,
+            job: None,
+        });
+        let device: Arc<dyn aster_block::BlockDevice> = disk;
+        if aster_block::register(device.clone()).is_ok() {
+            // Reading the partition table takes this task's service.
+            aster_core::spawn_kernel_thread(move || aster_block::scan_device_partitions(&device));
+        }
+    }
+
+    /// Runs one command and waits for it (while starting a port).
+    fn run_now(&self, slot: &mut Slot, command: &Command) -> bool {
+        issue(&self.regs, slot, command, &self.events);
+        loop {
+            match progress(&self.regs, slot, &self.events) {
+                Progress::Done => return true,
+                Progress::Failed => {
+                    recover(&self.regs, self.cap, slot.n, &self.events);
+                    return false;
+                }
+                Progress::Running if now_ms() - slot.issued_at > COMMAND_TIMEOUT_MS => {
+                    recover(&self.regs, self.cap, slot.n, &self.events);
+                    return false;
+                }
+                Progress::Running => sleep_ms(1),
+            }
+        }
+    }
+
+    /// Serves the disks' requests, for good.
+    pub(crate) fn run(mut self) -> ! {
+        loop {
+            for index in 0..self.ports.len() {
+                self.step(index);
+            }
+            crate::sleep();
+        }
+    }
+
+    /// Moves port `index`'s work on: what finished, what fails, what waits.
+    fn step(&mut self, index: usize) {
+        loop {
+            let port = &mut self.ports[index];
+            let Some(job) = port.job.as_mut() else {
+                let Some(bio) = port.disk.queue.lock().pop_front() else {
+                    return;
+                };
+                match plan(
+                    &bio,
+                    port.logical,
+                    port.blocks,
+                    port.lba48,
+                    port.flush_ext,
+                    self.cap & CAP_S64A != 0,
+                ) {
+                    Some(commands) if !commands.is_empty() => {
+                        crate::busy(true);
+                        issue(&self.regs, &mut port.slot, &commands[0], &self.events);
+                        port.job = Some(Job {
+                            bio,
+                            commands,
+                            retried: false,
+                        });
+                    }
+                    _ => bio.complete(BioStatus::IoError),
+                }
+                continue;
+            };
+            let outcome = match progress(&self.regs, &mut port.slot, &self.events) {
+                Progress::Running if now_ms() - port.slot.issued_at <= COMMAND_TIMEOUT_MS => return,
+                Progress::Running => {
+                    ostd::warn!("{}: {}: a command timed out", self.name, port.disk.name());
+                    Progress::Failed
+                }
+                other => other,
+            };
+            match outcome {
+                Progress::Done => {
+                    job.commands.pop_front();
+                    job.retried = false;
+                }
+                _ => {
+                    recover(&self.regs, self.cap, port.slot.n, &self.events);
+                    if job.retried {
+                        ostd::warn!(
+                            "{}: {}: an I/O error at block {}",
+                            self.name,
+                            port.disk.name(),
+                            job.commands[0].lba
+                        );
+                        let job = port.job.take().unwrap();
+                        job.bio.complete(BioStatus::IoError);
+                        crate::busy(false);
+                        continue;
+                    }
+                    job.retried = true;
+                }
+            }
+            let job = port.job.as_ref().unwrap();
+            if let Some(command) = job.commands.front() {
+                issue(&self.regs, &mut port.slot, command, &self.events);
+            } else {
+                let job = port.job.take().unwrap();
+                job.bio.complete(BioStatus::Complete);
+                crate::busy(false);
+            }
+        }
+    }
+}
+
+/// Port `n` idle (its engines stopped), its memory given; `None` where it
+/// does not stop or the memory is out of reach.
+fn prepare_port(regs: &Regs, n: usize, s64a: bool) -> Option<(DmaCoherent, DmaCoherent)> {
+    let command = regs.port_read(n, port::CMD);
+    if command & (CMD_ST | CMD_CR) != 0 {
+        regs.port_write(n, port::CMD, command & !CMD_ST);
+        if !regs.wait(500, |regs| regs.port_read(n, port::CMD) & CMD_CR == 0) {
+            return None;
+        }
+    }
+    let command = regs.port_read(n, port::CMD);
+    if command & (CMD_FRE | CMD_FR) != 0 {
+        regs.port_write(n, port::CMD, command & !CMD_FRE);
+        if !regs.wait(500, |regs| regs.port_read(n, port::CMD) & CMD_FR == 0) {
+            return None;
+        }
+    }
+    let lists = DmaCoherent::alloc(1, true).ok()?;
+    let table = DmaCoherent::alloc(1, true).ok()?;
+    let (lists_address, table_address) = (lists.daddr() as u64, table.daddr() as u64);
+    if !s64a && (lists_address >> 32 != 0 || table_address >> 32 != 0) {
+        return None;
+    }
+    regs.port_write(n, port::CLB, lists_address as u32);
+    regs.port_write(n, port::CLBU, (lists_address >> 32) as u32);
+    regs.port_write(n, port::FB, (lists_address + 1024) as u32);
+    regs.port_write(n, port::FBU, ((lists_address + 1024) >> 32) as u32);
+    regs.port_write(n, port::SERR, u32::MAX);
+    regs.port_write(n, port::IS, u32::MAX);
+    // Powered, spun up, receiving FISes; no partial or slumber link states.
+    regs.port_write(
+        n,
+        port::CMD,
+        regs.port_read(n, port::CMD) | CMD_SUD | CMD_POD | CMD_FRE,
+    );
+    let sctl = regs.port_read(n, port::SCTL) & !0xF0F;
+    regs.port_write(n, port::SCTL, sctl | 0x300);
+    Some((lists, table))
+}
+
+/// Writes `command` in slot 0 and issues it.
+fn issue(regs: &Regs, slot: &mut Slot, command: &Command, events: &[AtomicU32; 32]) {
+    let lba = command.lba;
+    let ext = matches!(command.ata, ata::READ_DMA_EXT | ata::WRITE_DMA_EXT);
+    let rw = ext || matches!(command.ata, ata::READ_DMA | ata::WRITE_DMA);
+    // The Register Host-to-Device FIS.
+    let mut fis = [0u8; 64];
+    fis[0] = 0x27;
+    fis[1] = 0x80;
+    fis[2] = command.ata;
+    if rw {
+        fis[4] = lba as u8;
+        fis[5] = (lba >> 8) as u8;
+        fis[6] = (lba >> 16) as u8;
+        fis[7] = if ext {
+            0x40
+        } else {
+            0x40 | ((lba >> 24) as u8 & 0x0F)
+        };
+        if ext {
+            fis[8] = (lba >> 24) as u8;
+            fis[9] = (lba >> 32) as u8;
+            fis[10] = (lba >> 40) as u8;
+        }
+        fis[12] = command.count as u8;
+        fis[13] = (command.count >> 8) as u8;
+    }
+    let _ = slot.table.write_bytes(0, &fis[..]);
+    for (index, &(address, length)) in command.prds.iter().enumerate() {
+        let entry = [address as u32, (address >> 32) as u32, 0, length - 1];
+        let _ = slot.table.write_val(0x80 + 16 * index, &entry);
+    }
+    let table = slot.table.daddr() as u64;
+    let header = [
+        5 | (u32::from(command.write) << 6) | ((command.prds.len() as u32) << 16),
+        0,
+        table as u32,
+        (table >> 32) as u32,
+        0,
+        0,
+        0,
+        0,
+    ];
+    let _ = slot.lists.write_val(0, &header);
+    events[slot.n].store(0, Ordering::Release);
+    slot.status = 0;
+    slot.issued_at = now_ms();
+    regs.port_write(slot.n, port::CI, 1);
+}
+
+/// Where slot 0's command is.
+fn progress(regs: &Regs, slot: &mut Slot, events: &[AtomicU32; 32]) -> Progress {
+    // From the interrupt, or read here without one.
+    let polled = regs.port_read(slot.n, port::IS);
+    if polled != 0 && polled != u32::MAX {
+        regs.port_write(slot.n, port::IS, polled);
+    }
+    slot.status |= events[slot.n].swap(0, Ordering::AcqRel) | polled;
+    if slot.status & IS_ERRORS != 0 {
+        return Progress::Failed;
+    }
+    if regs.port_read(slot.n, port::CI) & 1 != 0 {
+        return Progress::Running;
+    }
+    if regs.port_read(slot.n, port::TFD) & TFD_ERR != 0 {
+        Progress::Failed
+    } else {
+        Progress::Done
+    }
+}
+
+/// After an error or a time-out, as Linux's error handler: the engine
+/// stopped, the errors cleared, a stuck device let go (command list
+/// override, else a link reset), the engine started again.
+fn recover(regs: &Regs, cap: u32, n: usize, events: &[AtomicU32; 32]) {
+    regs.port_write(n, port::CMD, regs.port_read(n, port::CMD) & !CMD_ST);
+    regs.wait(500, |regs| regs.port_read(n, port::CMD) & CMD_CR == 0);
+    regs.port_write(n, port::SERR, u32::MAX);
+    regs.port_write(n, port::IS, u32::MAX);
+    events[n].store(0, Ordering::Release);
+    let stuck = |regs: &Regs| regs.port_read(n, port::TFD) & (TFD_BSY | TFD_DRQ) != 0;
+    if stuck(regs) && cap & CAP_SCLO != 0 {
+        regs.port_write(n, port::CMD, regs.port_read(n, port::CMD) | CMD_CLO);
+        regs.wait(500, |regs| regs.port_read(n, port::CMD) & CMD_CLO == 0);
+    }
+    if stuck(regs) {
+        let sctl = regs.port_read(n, port::SCTL) & !0xF0F;
+        regs.port_write(n, port::SCTL, sctl | 0x301);
+        sleep_ms(2);
+        regs.port_write(n, port::SCTL, sctl | 0x300);
+        regs.wait(1000, |regs| regs.port_read(n, port::SSTS) & 0xF == 3);
+        regs.wait(10_000, |regs| !stuck(regs));
+        regs.port_write(n, port::SERR, u32::MAX);
+        regs.port_write(n, port::IS, u32::MAX);
+    }
+    regs.port_write(n, port::CMD, regs.port_read(n, port::CMD) | CMD_ST);
+}
