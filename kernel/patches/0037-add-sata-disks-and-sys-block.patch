@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! MSI capability support: one message per function, for the devices that
+//! offer MSI but not MSI-X (most SATA controllers, HD Audio, many network
+//! controllers).
+
+use ostd::irq::IrqLine;
+
+use crate::{
+    PciDeviceLocation,
+    arch::{MSIX_DEFAULT_MSG_ADDR, construct_remappable_msix_address},
+    cfg_space::{Command, PciCommonCfgOffset},
+    common_device::PciCommonDevice,
+};
+
+/// Message Control: MSI Enable.
+const ENABLE: u16 = 1 << 0;
+/// Message Control: Multiple Message Enable (one message: 0).
+const MULTIPLE_MESSAGE_ENABLE: u16 = 0b111 << 4;
+/// Message Control: 64-bit Address Capable.
+const ADDRESS_64: u16 = 1 << 7;
+/// Message Control: Per-Vector Masking Capable.
+const PER_VECTOR_MASKING: u16 = 1 << 8;
+
+/// Raw information about the MSI capability.
+#[derive(Debug)]
+pub(super) struct RawCapabilityMsi {
+    cap_ptr: u16,
+    msg_ctrl: u16,
+}
+
+impl RawCapabilityMsi {
+    pub(super) fn parse(dev: &PciCommonDevice, cap_ptr: u16) -> Self {
+        Self {
+            cap_ptr,
+            msg_ctrl: dev.location().read16(cap_ptr + 2),
+        }
+    }
+}
+
+/// The MSI capability of a function.
+#[derive(Debug)]
+pub struct CapabilityMsiData {
+    loc: PciDeviceLocation,
+    ptr: u16,
+    msg_ctrl: u16,
+    irq: Option<IrqLine>,
+}
+
+impl CapabilityMsiData {
+    pub(super) fn new(loc: &PciDeviceLocation, raw_cap: &RawCapabilityMsi) -> Self {
+        Self {
+            loc: *loc,
+            ptr: raw_cap.cap_ptr,
+            msg_ctrl: raw_cap.msg_ctrl,
+            irq: None,
+        }
+    }
+
+    /// Sends the function's interrupts to `irq` and turns MSI on, and the
+    /// legacy INTx line off.
+    ///
+    /// If an interrupt line was set before, it is replaced.
+    pub fn set_interrupt_vector(&mut self, irq: IrqLine) {
+        let is_64bit = self.msg_ctrl & ADDRESS_64 != 0;
+        // With interrupt remapping, the message names the remapping entry
+        // and carries no vector; otherwise it is the vector itself.
+        let (address, data) = match irq.remapping_index() {
+            Some(index) => (construct_remappable_msix_address(index as u32), 0u16),
+            None => (MSIX_DEFAULT_MSG_ADDR, irq.num() as u16),
+        };
+
+        // Off while the message is written, with one message only.
+        let control = self.loc.read16(self.ptr + 2) & !(ENABLE | MULTIPLE_MESSAGE_ENABLE);
+        self.loc.write16(self.ptr + 2, control);
+        self.loc.write32(self.ptr + 4, address);
+        let data_offset = if is_64bit {
+            self.loc.write32(self.ptr + 8, 0);
+            12
+        } else {
+            8
+        };
+        self.loc.write16(self.ptr + data_offset, data);
+        if self.msg_ctrl & PER_VECTOR_MASKING != 0 {
+            let mask_offset = data_offset + 4;
+            let mask = self.loc.read32(self.ptr + mask_offset);
+            self.loc.write32(self.ptr + mask_offset, mask & !1);
+        }
+        self.irq = Some(irq);
+        self.loc.write16(self.ptr + 2, control | ENABLE);
+
+        // Disable INTx. Enable bus master.
+        self.loc.write16(
+            PciCommonCfgOffset::Command as u16,
+            self.loc.read16(PciCommonCfgOffset::Command as u16)
+                | (Command::INTERRUPT_DISABLE | Command::BUS_MASTER).bits(),
+        );
+    }
+
+    /// Returns a mutable reference to the [`IrqLine`], once set.
+    ///
+    /// Users can register callbacks using the returned [`IrqLine`] reference.
+    pub fn irq_mut(&mut self) -> Option<&mut IrqLine> {
+        self.irq.as_mut()
+    }
+
+    /// Returns true if the MSI Enable bit is set.
+    pub fn is_enabled(&self) -> bool {
+        self.loc.read16(self.ptr + 2) & ENABLE != 0
+    }
+}
