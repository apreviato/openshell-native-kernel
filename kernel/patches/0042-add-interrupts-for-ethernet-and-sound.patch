diff --git a/kernel/core/comps/pci/src/irq_stats.rs b/kernel/core/comps/pci/src/irq_stats.rs
new file mode 100644
index 0000000..9939f38
--- /dev/null
+++ b/kernel/core/comps/pci/src/irq_stats.rs
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! How many interrupts each device raised, by the name its driver gave
+//! it: what `/proc/interrupts` shows, and how to tell on a computer
+//! whether a device's interrupts arrive at all.
+
+use alloc::{string::String, sync::Arc, vec::Vec};
+use core::sync::atomic::{AtomicU64, Ordering};
+
+use ostd::sync::SpinLock;
+
+static COUNTERS: SpinLock<Vec<(u8, String, Arc<AtomicU64>)>> = SpinLock::new(Vec::new());
+
+/// A device's count, which its interrupt handler adds to.
+#[derive(Clone, Debug)]
+pub struct InterruptCounter(Arc<AtomicU64>);
+
+impl InterruptCounter {
+    /// One more interrupt. Safe in the handler: it takes no lock.
+    pub fn count(&self) {
+        self.0.fetch_add(1, Ordering::Relaxed);
+    }
+
+    pub fn total(&self) -> u64 {
+        self.0.load(Ordering::Relaxed)
+    }
+}
+
+/// A counter for the interrupts of `name` on the interrupt line `line`.
+pub fn interrupt_counter(line: u8, name: &str) -> InterruptCounter {
+    let counter = Arc::new(AtomicU64::new(0));
+    COUNTERS.lock().push((line, String::from(name), counter.clone()));
+    InterruptCounter(counter)
+}
+
+/// Each counted device: its interrupt line, its name, its count so far.
+pub fn interrupt_counts() -> Vec<(u8, String, u64)> {
+    let mut counts: Vec<_> =
+        COUNTERS.lock().iter().map(|(line, name, counter)| (*line, name.clone(), counter.load(Ordering::Relaxed))).collect();
+    counts.sort();
+    counts
+}
