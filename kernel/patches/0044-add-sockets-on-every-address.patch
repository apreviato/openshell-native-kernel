+/// A port bound to every address (0.0.0.0) is held on the loopback
+/// interface (`resolve_bind_iface_and_config`). The connection from it
+/// leaves through the interface of its route, from that interface's address
+/// and the same port.
+fn rehome(
+    bound_port: BoundTcpPort,
+    remote_endpoint: &IpEndpoint,
+    can_reuse: bool,
+) -> core::result::Result<BoundTcpPort, (Error, BoundTcpPort)> {
+    let bound = bound_port.endpoint();
+    if !bound.addr.is_unspecified() {
+        return Ok(bound_port);
+    }
+    let resolved = get_ephemeral_endpoint(remote_endpoint).and_then(|source| {
+        resolve_bind_iface_and_config(&IpEndpoint::new(source.addr, bound.port), can_reuse)
+    });
+    let (iface, config) = match resolved {
+        Ok(resolved) => resolved,
+        Err(err) => return Err((err, bound_port)),
+    };
+    if Arc::ptr_eq(&iface, bound_port.iface()) {
+        return Ok(bound_port);
+    }
+    match iface.bind_tcp(config) {
+        Ok(rehomed) => Ok(rehomed),
+        Err(err) => Err((err.into(), bound_port)),
+    }
+}
