diff --git a/kernel/comps/ath10k/src/boot.rs b/kernel/comps/ath10k/src/boot.rs
new file mode 100644
index 0000000..06e6020
--- /dev/null
+++ b/kernel/comps/ath10k/src/boot.rs
@@ -0,0 +1,302 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The target's boot as Linux's ath10k `core.c` and `bmi.c` run it: the
+//! firmware file's elements, the board data (`board-2.bin` by the card's
+//! PCI IDs, else `board.bin`), the host interest area, the OTP program,
+//! the code swap segment and the firmware's download through BMI.
+
+use alloc::{format, string::String, vec::Vec};
+
+use ostd::mm::{HasDaddr, VmIo, dma::DmaCoherent};
+
+use crate::pci::{Pci, dma32};
+
+/// The host interest area (`QCA988X_HOST_INTEREST_ADDRESS`) and the
+/// offsets of its items (`struct host_interest`).
+const HOST_INTEREST: u32 = 0x0040_0800;
+const HI_APP_HOST_INTEREST: u32 = 0x00;
+const HI_OPTION_FLAG: u32 = 0x10;
+const HI_SERIAL_ENABLE: u32 = 0x14;
+const HI_BE: u32 = 0x44;
+const HI_BOARD_DATA: u32 = 0x54;
+const HI_BOARD_DATA_INITIALIZED: u32 = 0x58;
+const HI_BOARD_EXT_DATA: u32 = 0xac;
+const HI_HCI_UART_PWR_MGMT_PARAMS_EXT: u32 = 0xbc;
+pub(crate) const HI_OPTION_FLAG2: u32 = 0xcc;
+pub(crate) const HI_INTERCONNECT_STATE: u32 = 0xf8;
+pub(crate) const HI_EARLY_ALLOC: u32 = 0x100;
+const HI_FW_SWAP: u32 = 0x104;
+const HTC_PROTOCOL_VERSION: u32 = 0x0002;
+const HI_OPTION_NUM_DEV_SHIFT: u32 = 9;
+const HI_OPTION_FW_MODE_AP: u32 = 0x2;
+const HI_OPTION_FW_MODE_SHIFT: u32 = 12;
+const HI_OPTION_MAC_ADDR_METHOD_SHIFT: u32 = 3;
+/// `patch_load_addr` of every QCA6174 and QCA9377.
+const PATCH_LOAD_ADDR: u32 = 0x1234;
+const BOARD_DATA_SZ: usize = 8192;
+// BMI (`bmi.h`).
+const BMI_DONE: u32 = 1;
+const BMI_READ_MEMORY: u32 = 2;
+const BMI_WRITE_MEMORY: u32 = 3;
+const BMI_EXECUTE: u32 = 4;
+const BMI_GET_TARGET_INFO: u32 = 8;
+const BMI_LZ_STREAM_START: u32 = 13;
+const BMI_LZ_DATA: u32 = 14;
+const BMI_MAX_DATA_SIZE: usize = 256;
+// Firmware elements (`enum ath10k_fw_ie_type`).
+const FW_IE_FW_VERSION: u32 = 0;
+const FW_IE_FEATURES: u32 = 2;
+const FW_IE_FW_IMAGE: u32 = 3;
+const FW_IE_OTP_IMAGE: u32 = 4;
+const FW_IE_WMI_OP_VERSION: u32 = 5;
+const FW_IE_HTT_OP_VERSION: u32 = 6;
+const FW_IE_FW_CODE_SWAP_IMAGE: u32 = 7;
+const BD_IE_BOARD: u32 = 0;
+const BD_IE_BOARD_NAME: u32 = 0;
+const BD_IE_BOARD_DATA: u32 = 1;
+/// `ATH10K_FW_FEATURE_IGNORE_OTP_RESULT`.
+const FEATURE_IGNORE_OTP_RESULT: usize = 7;
+
+pub(crate) fn host_interest(item: u32) -> u32 {
+    HOST_INTEREST + item
+}
+
+fn le32(data: &[u8], at: usize) -> u32 {
+    data.get(at..at + 4).map_or(0, |b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+}
+
+/// Elements `{id, len, data aligned to 4}` after a magic.
+fn elements<'a>(data: &'a [u8], magic: &[u8]) -> Option<Vec<(u32, &'a [u8])>> {
+    if data.len() < magic.len() + 1 || &data[..magic.len()] != magic || data[magic.len()] != 0 {
+        return None;
+    }
+    let mut at = (magic.len() + 1).next_multiple_of(4);
+    let mut out = Vec::new();
+    while at + 8 <= data.len() {
+        let (id, len) = (le32(data, at), le32(data, at + 4) as usize);
+        at += 8;
+        let value = data.get(at..at + len)?;
+        out.push((id, value));
+        at += len.next_multiple_of(4);
+    }
+    Some(out)
+}
+
+/// What the firmware file holds (`struct ath10k_fw_file`).
+pub(crate) struct FirmwareFile {
+    pub(crate) version: String,
+    pub(crate) features: Vec<u8>,
+    pub(crate) image: Vec<u8>,
+    pub(crate) otp: Vec<u8>,
+    pub(crate) codeswap: Vec<u8>,
+    pub(crate) wmi_op_version: u32,
+    pub(crate) htt_op_version: u32,
+}
+
+impl FirmwareFile {
+    /// `ath10k_core_fetch_firmware_api_n`.
+    pub(crate) fn parse(data: &[u8]) -> Option<Self> {
+        let mut file = Self { version: String::new(), features: Vec::new(), image: Vec::new(), otp: Vec::new(), codeswap: Vec::new(), wmi_op_version: 0, htt_op_version: 0 };
+        for (id, value) in elements(data, b"QCA-ATH10K")? {
+            match id {
+                FW_IE_FW_VERSION => file.version = String::from_utf8_lossy(value).into_owned(),
+                FW_IE_FEATURES => file.features = value.to_vec(),
+                FW_IE_FW_IMAGE => file.image = value.to_vec(),
+                FW_IE_OTP_IMAGE => file.otp = value.to_vec(),
+                FW_IE_WMI_OP_VERSION if value.len() == 4 => file.wmi_op_version = le32(value, 0),
+                FW_IE_HTT_OP_VERSION if value.len() == 4 => file.htt_op_version = le32(value, 0),
+                FW_IE_FW_CODE_SWAP_IMAGE => file.codeswap = value.to_vec(),
+                _ => {}
+            }
+        }
+        if file.image.is_empty() { None } else { Some(file) }
+    }
+
+    pub(crate) fn has_feature(&self, bit: usize) -> bool {
+        self.features.get(bit / 8).is_some_and(|byte| byte & (1 << (bit % 8)) != 0)
+    }
+}
+
+/// The board data for a board name in `board-2.bin`
+/// (`ath10k_core_fetch_board_data_api_n`).
+pub(crate) fn board_data(file: &[u8], name: &str) -> Option<Vec<u8>> {
+    for (id, container) in elements(file, b"QCA-ATH10K-BOARD")? {
+        if id != BD_IE_BOARD {
+            continue;
+        }
+        let mut matched = false;
+        let mut at = 0;
+        while at + 8 <= container.len() {
+            let (sub, len) = (le32(container, at), le32(container, at + 4) as usize);
+            at += 8;
+            let value = container.get(at..at + len)?;
+            match sub {
+                BD_IE_BOARD_NAME => matched = value == name.as_bytes(),
+                BD_IE_BOARD_DATA if matched => return Some(value.to_vec()),
+                _ => {}
+            }
+            at += len.next_multiple_of(4);
+        }
+    }
+    None
+}
+
+/// BMI over the PCI pipes.
+pub(crate) struct Bmi<'a> {
+    pub(crate) pci: &'a mut Pci,
+}
+
+impl Bmi<'_> {
+    fn command(&mut self, words: &[u32], payload: &[u8], response: Option<usize>) -> Result<Vec<u8>, String> {
+        let mut request = Vec::with_capacity(words.len() * 4 + payload.len());
+        for word in words {
+            request.extend_from_slice(&word.to_le_bytes());
+        }
+        request.extend_from_slice(payload);
+        self.pci.bmi(&request, response)
+    }
+
+    pub(crate) fn target_info(&mut self) -> Result<(u32, u32), String> {
+        let answer = self.command(&[BMI_GET_TARGET_INFO], &[], Some(8))?;
+        // `resp.get_target_info`: version, type.
+        Ok((le32(&answer, 0), le32(&answer, 4)))
+    }
+
+    pub(crate) fn read32(&mut self, address: u32) -> Result<u32, String> {
+        let answer = self.command(&[BMI_READ_MEMORY, address, 4], &[], Some(4))?;
+        Ok(le32(&answer, 0))
+    }
+
+    pub(crate) fn write_memory(&mut self, mut address: u32, data: &[u8]) -> Result<(), String> {
+        let header = 12;
+        let mut at = 0;
+        while at < data.len() {
+            let n = (data.len() - at).min(BMI_MAX_DATA_SIZE - header);
+            let mut chunk = data[at..at + n].to_vec();
+            chunk.resize(n.next_multiple_of(4), 0);
+            self.command(&[BMI_WRITE_MEMORY, address, chunk.len() as u32], &chunk, None)?;
+            address += n as u32;
+            at += n;
+        }
+        Ok(())
+    }
+
+    pub(crate) fn write32(&mut self, address: u32, value: u32) -> Result<(), String> {
+        self.write_memory(address, &value.to_le_bytes())
+    }
+
+    fn execute(&mut self, address: u32, param: u32) -> Result<u32, String> {
+        let answer = self.command(&[BMI_EXECUTE, address, param], &[], Some(4))?;
+        Ok(le32(&answer, 0))
+    }
+
+    /// `ath10k_bmi_fast_download`.
+    fn fast_download(&mut self, address: u32, data: &[u8]) -> Result<(), String> {
+        self.command(&[BMI_LZ_STREAM_START, address], &[], None)?;
+        let head = data.len() / 4 * 4;
+        let mut at = 0;
+        while at < head {
+            let n = (head - at).min(BMI_MAX_DATA_SIZE - 8);
+            self.command(&[BMI_LZ_DATA, n as u32], &data[at..at + n], None)?;
+            at += n;
+        }
+        if head < data.len() {
+            let mut trailer = [0u8; 4];
+            trailer[..data.len() - head].copy_from_slice(&data[head..]);
+            self.command(&[BMI_LZ_DATA, 4], &trailer, None)?;
+        }
+        self.command(&[BMI_LZ_STREAM_START, 0], &[], None).map(|_| ())
+    }
+
+    pub(crate) fn done(&mut self) -> Result<(), String> {
+        self.command(&[BMI_DONE], &[], None).map(|_| ())
+    }
+}
+
+/// `struct ath10k_swap_code_seg_hw_info` with `ATH10K_SWAP_CODE_SEG_NUM_MAX`
+/// (16) segments.
+const HW_INFO: usize = 16 + 16 * 4 + 16 * 8;
+
+/// The code swap segment in host memory (`ath10k_swap_code_seg_*`): the
+/// target fetches code from it.
+pub(crate) struct CodeSwap {
+    _memory: DmaCoherent,
+    target_addr: u32,
+    hw_info: [u8; HW_INFO],
+}
+
+impl CodeSwap {
+    pub(crate) fn new(data: &[u8]) -> Result<Option<Self>, String> {
+        if data.is_empty() {
+            return Ok(None);
+        }
+        let length = data.len().next_multiple_of(2);
+        let memory = dma32(length).ok_or_else(|| String::from("no DMA memory for the code swap"))?;
+        let (mut at, mut filled) = (0usize, 0usize);
+        let mut target_addr = None;
+        // Items {address, length, data}; the tail (16 bytes, length 0) is a
+        // zero magic of 12 bytes and the BMI write address.
+        while data.len() - at >= 16 {
+            let payload = le32(data, at + 4) as usize;
+            if payload == 0 {
+                if data.len() - at != 16 || data[at..at + 12].iter().any(|&byte| byte != 0) {
+                    return Err(String::from("the code swap's tail is wrong"));
+                }
+                target_addr = Some(le32(data, at + 12));
+                break;
+            }
+            let start = at + 8;
+            let chunk = data.get(start..start + payload).ok_or_else(|| String::from("the code swap is broken"))?;
+            let _ = memory.write_bytes(filled, chunk);
+            filled += payload;
+            at = start + payload;
+        }
+        let target_addr = target_addr.ok_or_else(|| String::from("the code swap has no tail"))?;
+        // `struct ath10k_swap_code_seg_hw_info`: swap_size, num_segs, size,
+        // size_log2, bus_addr[SEG_NUM_MAX], reserved[SEG_NUM_MAX] (64-bit).
+        let mut hw_info = [0u8; HW_INFO];
+        hw_info[0..4].copy_from_slice(&(filled as u32).to_le_bytes());
+        hw_info[4..8].copy_from_slice(&1u32.to_le_bytes());
+        hw_info[8..12].copy_from_slice(&(length as u32).to_le_bytes());
+        hw_info[12..16].copy_from_slice(&(usize::BITS - 1 - length.leading_zeros()).to_le_bytes());
+        hw_info[16..20].copy_from_slice(&(memory.daddr() as u32).to_le_bytes());
+        Ok(Some(Self { _memory: memory, target_addr, hw_info }))
+    }
+}
+
+/// Linux's `ath10k_core_start` up to HTC for a BMI target: the host
+/// interest settings, the board data and OTP, the code swap, the
+/// firmware, the UART off.
+pub(crate) fn boot(bmi: &mut Bmi<'_>, dev_id: u16, firmware: &FirmwareFile, board: &[u8], swap: Option<&CodeSwap>) -> Result<(), String> {
+    // `ath10k_init_configure_target`.
+    bmi.write32(host_interest(HI_APP_HOST_INTEREST), HTC_PROTOCOL_VERSION)?;
+    let mut option = bmi.read32(host_interest(HI_OPTION_FLAG))?;
+    option |= (1 << HI_OPTION_NUM_DEV_SHIFT) | (HI_OPTION_FW_MODE_AP << HI_OPTION_FW_MODE_SHIFT) | (1 << HI_OPTION_MAC_ADDR_METHOD_SHIFT);
+    bmi.write32(host_interest(HI_OPTION_FLAG), option)?;
+    bmi.write32(host_interest(HI_BE), 0)?;
+    bmi.write32(host_interest(HI_FW_SWAP), 0)?;
+    bmi.write32(host_interest(HI_HCI_UART_PWR_MGMT_PARAMS_EXT), dev_id as u32)?;
+    // `ath10k_download_and_run_otp` (board data first).
+    let ext = bmi.read32(host_interest(HI_BOARD_EXT_DATA))?;
+    if ext != 0 && board.len() > BOARD_DATA_SZ {
+        return Err(String::from("the board data has an extension this driver does not write"));
+    }
+    let board_address = bmi.read32(host_interest(HI_BOARD_DATA))?;
+    bmi.write_memory(board_address, &board[..board.len().min(BOARD_DATA_SZ)])?;
+    bmi.write32(host_interest(HI_BOARD_DATA_INITIALIZED), 1)?;
+    if !firmware.otp.is_empty() {
+        bmi.fast_download(PATCH_LOAD_ADDR, &firmware.otp)?;
+        let result = bmi.execute(PATCH_LOAD_ADDR, 0)?;
+        if result != 0 && !firmware.has_feature(FEATURE_IGNORE_OTP_RESULT) {
+            return Err(format!("the OTP program failed ({result:#x})"));
+        }
+    }
+    // `ath10k_download_fw`.
+    if let Some(swap) = swap {
+        bmi.write_memory(swap.target_addr, &swap.hw_info)?;
+    }
+    bmi.fast_download(PATCH_LOAD_ADDR, &firmware.image)?;
+    // `ath10k_init_uart`.
+    bmi.write32(host_interest(HI_SERIAL_ENABLE), 0)?;
+    Ok(())
+}
