new file mode 100644
index 0000000..412941c
--- /dev/null
+++ b/kernel/comps/ath10k/src/htc.rs
@@ -0,0 +1,209 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! HTC, the host-target message layer of Linux's ath10k `htc.c`: an 8-byte
+//! header with the endpoint, the target's READY with its credits, services
+//! connected to endpoints, credit reports in the trailers.
+
+use alloc::{string::String, vec::Vec};
+
+use crate::pci::{Pci, SERVICE_MAP};
+
+pub(crate) const SVC_RSVD_CTRL: u16 = 0x0001;
+pub(crate) const SVC_WMI_CONTROL: u16 = 0x0100;
+pub(crate) const SVC_HTT_DATA_MSG: u16 = 0x0300;
+const MSG_READY: u16 = 1;
+const MSG_CONNECT_SERVICE: u16 = 2;
+const MSG_CONNECT_SERVICE_RESP: u16 = 3;
+const MSG_SETUP_COMPLETE_EX: u16 = 5;
+const FLAG_NEED_CREDIT_UPDATE: u8 = 0x01;
+const FLAG_TRAILER_PRESENT: u8 = 0x02;
+const CONN_FLAGS_DISABLE_CREDIT_FLOW_CTRL: u16 = 1 << 3;
+const RECORD_CREDITS: u8 = 1;
+const HEADER: usize = 8;
+const ENDPOINTS: usize = 8;
+const WAIT_MS: u64 = 3000;
+
+#[derive(Clone, Copy, Default)]
+struct Endpoint {
+    ul_pipe: usize,
+    dl_pipe: usize,
+    credits: u32,
+    credit_flow: bool,
+    seq: u8,
+}
+
+pub(crate) struct Htc {
+    endpoints: [Endpoint; ENDPOINTS],
+    credit_size: u32,
+    total_credits: u32,
+}
+
+/// A message HTC delivered: its endpoint and payload.
+pub(crate) struct Message {
+    pub(crate) endpoint: usize,
+    pub(crate) payload: Vec<u8>,
+}
+
+/// The pipes (host to target, target to host) carrying a service.
+pub(crate) fn pipes_of(service: u16) -> (usize, usize) {
+    let (mut ul, mut dl) = (0, 0);
+    for [svc, dir, pipe] in SERVICE_MAP {
+        if svc == service as u32 {
+            match dir {
+                1 => ul = pipe as usize,
+                2 => dl = pipe as usize,
+                _ => {}
+            }
+        }
+    }
+    (ul, dl)
+}
+
+impl Htc {
+    /// `ath10k_htc_init`: endpoint 0 is the control service.
+    pub(crate) fn new() -> Self {
+        let mut endpoints = [Endpoint::default(); ENDPOINTS];
+        let (ul, dl) = pipes_of(SVC_RSVD_CTRL);
+        endpoints[0] = Endpoint { ul_pipe: ul, dl_pipe: dl, credits: 0, credit_flow: false, seq: 0 };
+        Self { endpoints, credit_size: 0, total_credits: 0 }
+    }
+
+    /// `ath10k_htc_send`: the header, a credit when the endpoint counts
+    /// them, the payload on the endpoint's pipe. Err: no credit or full.
+    pub(crate) fn send(&mut self, pci: &mut Pci, endpoint: usize, payload: &[u8]) -> Result<(), ()> {
+        let ep = &mut self.endpoints[endpoint];
+        let len = HEADER + payload.len();
+        if ep.credit_flow {
+            let needed = (len as u32).div_ceil(self.credit_size.max(1));
+            if ep.credits < needed {
+                return Err(());
+            }
+            ep.credits -= needed;
+        }
+        let mut message = Vec::with_capacity(len);
+        message.push(endpoint as u8);
+        message.push(if ep.credit_flow { FLAG_NEED_CREDIT_UPDATE } else { 0 });
+        message.extend_from_slice(&(payload.len() as u16).to_le_bytes());
+        message.push(0);
+        message.push(ep.seq);
+        message.extend_from_slice(&[0, 0]);
+        message.extend_from_slice(payload);
+        ep.seq = ep.seq.wrapping_add(1);
+        let pipe = ep.ul_pipe;
+        pci.send(pipe, &message, endpoint as u16)
+    }
+
+    /// The header gone, the trailer's credit reports taken
+    /// (`ath10k_htc_rx_completion_handler`).
+    pub(crate) fn receive(&mut self, raw: &[u8]) -> Option<Message> {
+        if raw.len() < HEADER {
+            return None;
+        }
+        let endpoint = raw[0] as usize;
+        let flags = raw[1];
+        let len = u16::from_le_bytes([raw[2], raw[3]]) as usize;
+        if endpoint >= ENDPOINTS || HEADER + len > raw.len() {
+            return None;
+        }
+        let mut payload = &raw[HEADER..HEADER + len];
+        if flags & FLAG_TRAILER_PRESENT != 0 {
+            let trailer_len = raw[4] as usize;
+            if trailer_len < 2 || trailer_len > len {
+                return None;
+            }
+            let (body, trailer) = payload.split_at(len - trailer_len);
+            self.trailer(trailer);
+            payload = body;
+        }
+        if payload.is_empty() {
+            return None;
+        }
+        Some(Message { endpoint, payload: payload.to_vec() })
+    }
+
+    fn trailer(&mut self, mut trailer: &[u8]) {
+        while trailer.len() >= 2 {
+            let (id, len) = (trailer[0], trailer[1] as usize);
+            let Some(record) = trailer.get(2..2 + len) else { return };
+            if id == RECORD_CREDITS {
+                for report in record.chunks_exact(4) {
+                    if let Some(ep) = self.endpoints.get_mut(report[0] as usize) {
+                        ep.credits += report[1] as u32;
+                    }
+                }
+            }
+            trailer = &trailer[2 + len..];
+        }
+    }
+
+    /// Waits for a control message on endpoint 0 (CE 1), handing other
+    /// messages to `other`.
+    fn control(&mut self, pci: &mut Pci, other: &mut impl FnMut(Message)) -> Result<Vec<u8>, String> {
+        let deadline = crate::now_ms() + WAIT_MS;
+        loop {
+            let pipe = self.endpoints[0].dl_pipe;
+            for raw in pci.receive(pipe) {
+                if let Some(message) = self.receive(&raw) {
+                    if message.endpoint == 0 {
+                        return Ok(message.payload);
+                    }
+                    other(message);
+                }
+            }
+            if crate::now_ms() >= deadline {
+                return Err(String::from("the target did not answer HTC"));
+            }
+            crate::delay_us(200);
+        }
+    }
+
+    /// `ath10k_htc_wait_target`: the READY message and its credits.
+    pub(crate) fn wait_target(&mut self, pci: &mut Pci) -> Result<(), String> {
+        let message = self.control(pci, &mut |_| {})?;
+        if message.len() < 8 || u16::from_le_bytes([message[0], message[1]]) != MSG_READY {
+            return Err(String::from("the target's first HTC message is not READY"));
+        }
+        self.total_credits = u16::from_le_bytes([message[2], message[3]]) as u32;
+        self.credit_size = u16::from_le_bytes([message[4], message[5]]) as u32;
+        if self.total_credits == 0 || self.credit_size == 0 {
+            return Err(String::from("the target gave no HTC credits"));
+        }
+        Ok(())
+    }
+
+    /// `ath10k_htc_connect_service`: WMI gets every credit, the others
+    /// none (no credit flow).
+    pub(crate) fn connect(&mut self, pci: &mut Pci, service: u16, other: &mut impl FnMut(Message)) -> Result<usize, String> {
+        let allocation = if service == SVC_WMI_CONTROL { self.total_credits.min(0xff) } else { 0 };
+        let mut flags = (allocation as u16) << 8;
+        if service != SVC_WMI_CONTROL {
+            flags |= CONN_FLAGS_DISABLE_CREDIT_FLOW_CTRL;
+        }
+        let mut request = Vec::with_capacity(8);
+        request.extend_from_slice(&MSG_CONNECT_SERVICE.to_le_bytes());
+        request.extend_from_slice(&service.to_le_bytes());
+        request.extend_from_slice(&flags.to_le_bytes());
+        request.extend_from_slice(&[0, 0]);
+        self.send(pci, 0, &request).map_err(|()| String::from("HTC's control pipe is full"))?;
+        let answer = self.control(pci, other)?;
+        if answer.len() < 8 || u16::from_le_bytes([answer[0], answer[1]]) != MSG_CONNECT_SERVICE_RESP {
+            return Err(String::from("no answer to an HTC service's connection"));
+        }
+        let (status, endpoint) = (answer[4], answer[5] as usize);
+        if status != 0 || endpoint >= ENDPOINTS {
+            return Err(alloc::format!("HTC refused service {service:#x} (status {status})"));
+        }
+        let (ul, dl) = pipes_of(service);
+        self.endpoints[endpoint] = Endpoint { ul_pipe: ul, dl_pipe: dl, credits: allocation, credit_flow: service == SVC_WMI_CONTROL, seq: 0 };
+        Ok(endpoint)
+    }
+
+    /// `ath10k_htc_start`: setup complete.
+    pub(crate) fn start(&mut self, pci: &mut Pci) -> Result<(), String> {
+        // `struct ath10k_htc_setup_complete_extended`: pads, flags, bundles.
+        let mut message = Vec::with_capacity(12);
+        message.extend_from_slice(&MSG_SETUP_COMPLETE_EX.to_le_bytes());
+        message.extend_from_slice(&[0u8; 10]);
+        self.send(pci, 0, &message).map_err(|()| String::from("HTC's control pipe is full"))
+    }
+}
diff --git a/kernel/comps/ath10k/src/htt.rs b/kernel/comps/ath10k/src/htt.rs
new file mode 100644
index 0000000..69e0fb4
--- /dev/null
+++ b/kernel/comps/ath10k/src/htt.rs
@@ -0,0 +1,617 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! HTT, the data path of Linux's ath10k (`htt_tx.c`, `htt_rx.c`): frames
+//! out through a TX descriptor naming the frame's buffer, frames in through
+//! a ring of buffers the host fills and the target writes, each with an
+//! RX descriptor before the payload. The target says which buffers it
+//! filled either in ring order (RX_IND) or by address (RX_IN_ORD_PADDR_IND,
+//! when its firmware reorders, `WMI_SERVICE_RX_FULL_REORDER`).
+
+use alloc::{vec, vec::Vec};
+
+use ostd::mm::{HasDaddr, PAGE_SIZE, VmIo, dma::DmaCoherent};
+
+use crate::pci::dma32;
+
+// Messages (`enum htt_h2t_msg_type`, `htt_tlv_t2h_msg_types`).
+const H2T_VERSION_REQ: u8 = 0;
+const H2T_TX_FRM: u8 = 1;
+const H2T_RX_RING_CFG: u8 = 2;
+const H2T_AGGR_CFG: u8 = 5;
+const T2H_VERSION_CONF: u8 = 0;
+const T2H_RX_IND: u8 = 1;
+const T2H_PEER_MAP: u8 = 3;
+const T2H_PEER_UNMAP: u8 = 4;
+const T2H_TX_COMPL_IND: u8 = 7;
+const T2H_RX_IN_ORD_PADDR_IND: u8 = 0x12;
+// The RX ring (`HTT_RX_RING_SIZE`, `HTT_RX_RING_FILL_LEVEL`).
+const RX_BUF: usize = 2048;
+const RX_RING: usize = 2048;
+const RX_FILL: usize = RX_RING / 2 - 1;
+/// The buffers: the fill level and some being read.
+const RX_BUFFERS: usize = RX_FILL + 64;
+/// Buffers per DMA block.
+const BLOCK: usize = PAGE_SIZE * 16;
+const PER_BLOCK: usize = BLOCK / RX_BUF;
+/// `struct htt_rx_desc_v1` and its parts' offsets.
+const RX_DESC: usize = 300;
+const ATTENTION: usize = 4;
+const FRAG_INFO: usize = 8;
+const MPDU_START: usize = 12;
+const MSDU_START: usize = 24;
+const MSDU_END: usize = 40;
+const PPDU_START: usize = 84;
+const HDR_STATUS: usize = 236;
+const RX_MSDU_SIZE: usize = RX_BUF - RX_DESC;
+const ATTENTION_MSDU_DONE: u32 = 1 << 31;
+const ATTENTION_FCS_ERR: u32 = 1 << 30;
+const ATTENTION_DECRYPT_ERR: u32 = 1 << 29;
+const ATTENTION_TKIP_MIC_ERR: u32 = 1 << 28;
+const ATTENTION_LENGTH_ERRS: u32 = (1 << 27) | (1 << 17);
+const MSDU_END_LAST: u32 = 1 << 15;
+const MPDU_START_ENCRYPTED: u32 = 1 << 13;
+const ENCRYPT_NONE: u32 = 7;
+const DECAP_RAW: u32 = 0;
+const DECAP_NATIVE_WIFI: u32 = 1;
+const DECAP_ETHERNET: u32 = 2;
+/// Every part of the descriptor and every kind of frame.
+const RX_RING_FLAGS: u16 = 0xffff;
+/// An invalid combined RSSI.
+const RSSI_INVALID: u8 = 0x80;
+/// Where an RX indication's prefix is: the HTT header, the indication's
+/// own (7 bytes), the PPDU's (36).
+const RX_IND_PREFIX: usize = 1 + 7 + 36;
+/// The range statuses of bad frames: FCS, duplicate, replay, TKIP MIC,
+/// decryption, length (`enum htt_rx_mpdu_status`).
+const RX_STATUS_DROP: [u8; 6] = [2, 3, 4, 9, 10, 11];
+/// The in-order indication's header and its MSDU descriptors.
+const IN_ORD_HEADER: usize = 8;
+const IN_ORD_DESC: usize = 8;
+const IN_ORD_OFFLOAD: u8 = 1 << 5;
+const IN_ORD_FRAG: u8 = 1 << 6;
+/// `struct htt_rx_offload_msdu`'s header.
+const OFFLOAD_HEADER: usize = 7;
+/// `ATH10K_DEFAULT_NOISE_FLOOR`.
+const NOISE_FLOOR: i32 = -95;
+// TX.
+const TX_SLOTS: usize = 128;
+const TX_BUF: usize = 2048;
+/// `struct ath10k_htt_txbuf_32`: frags[2] (16), the HTC header (8), the
+/// HTT command (1), the TX descriptor (15); padded to 64.
+const TXBUF: usize = 64;
+const TXBUF_HTC: usize = 16;
+const TXBUF_SENT: usize = 8 + 1 + 15;
+/// `htt->prefetch_len`: the headers the target classifies by.
+const PREFETCH: usize = 36 + 4 + 8 + 2;
+pub(crate) const TX_MODE_NATIVE_WIFI: u8 = 1;
+pub(crate) const TX_MODE_MGMT: u8 = 3;
+pub(crate) const TID_NON_QOS: u8 = 0x10;
+pub(crate) const TID_MGMT: u8 = 0x11;
+const FLAGS0_MAC_HDR_PRESENT: u8 = 1 << 0;
+const FLAGS0_NO_ENCRYPT: u8 = 1 << 2;
+const FLAGS1_POSTPONED: u16 = 1 << 11;
+const INVALID_PEER: u32 = 0xffff;
+/// The aggregates' sizes Linux asks for (`ATH10K_HTT_MAX_NUM_AMPDU_DEFAULT`,
+/// `..._AMSDU_DEFAULT`).
+const MAX_AMPDU: u8 = 64;
+const MAX_AMSDU: u8 = 3;
+
+/// A frame the target gave: an 802.11 frame with its signal, whether the
+/// chip decrypted it and the length of the cipher's header left in it; or
+/// an Ethernet frame and whether it came protected.
+pub(crate) enum Received {
+    Frame { frame: Vec<u8>, signal: i8, decrypted: bool, security_header: u8 },
+    Ethernet(Vec<u8>, bool),
+}
+
+/// What a T2H message changed besides frames.
+#[derive(Default)]
+pub(crate) struct Changes {
+    pub(crate) tx_done: bool,
+    pub(crate) peer_mapped: bool,
+    pub(crate) peer_unmapped: bool,
+}
+
+pub(crate) struct Htt {
+    pub(crate) endpoint: usize,
+    // RX.
+    ring: DmaCoherent,
+    alloc_index: DmaCoherent,
+    blocks: Vec<DmaCoherent>,
+    free: Vec<usize>,
+    /// The buffer in each ring slot (in ring order).
+    slots: Vec<Option<usize>>,
+    read: usize,
+    write: usize,
+    filled: usize,
+    pub(crate) in_order: bool,
+    signal: i8,
+    // TX.
+    txbufs: DmaCoherent,
+    frames: DmaCoherent,
+    busy: Vec<bool>,
+    next: usize,
+    pub(crate) peers: Vec<(u16, [u8; 6])>,
+    pub(crate) version: Option<(u8, u8)>,
+}
+
+fn le32(data: &[u8], at: usize) -> u32 {
+    data.get(at..at + 4).map_or(0, |b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+}
+
+fn le16(data: &[u8], at: usize) -> u16 {
+    data.get(at..at + 2).map_or(0, |b| u16::from_le_bytes([b[0], b[1]]))
+}
+
+impl Htt {
+    pub(crate) fn new() -> Option<Self> {
+        let mut blocks = Vec::new();
+        for _ in 0..RX_BUFFERS.div_ceil(PER_BLOCK) {
+            blocks.push(dma32(BLOCK)?);
+        }
+        Some(Self {
+            endpoint: 0,
+            ring: dma32(RX_RING * 4)?,
+            alloc_index: dma32(4)?,
+            blocks,
+            free: (0..RX_BUFFERS).rev().collect(),
+            slots: vec![None; RX_RING],
+            read: 0,
+            write: 0,
+            filled: 0,
+            in_order: false,
+            signal: -100,
+            txbufs: dma32(TX_SLOTS * TXBUF)?,
+            frames: dma32(TX_SLOTS * TX_BUF)?,
+            busy: vec![false; TX_SLOTS],
+            next: 0,
+            peers: Vec::new(),
+            version: None,
+        })
+    }
+
+    // ---- H2T messages (their HTC payloads). ----
+
+    /// `ath10k_htt_h2t_ver_req_msg`.
+    pub(crate) fn version_request() -> Vec<u8> {
+        vec![H2T_VERSION_REQ, 0, 0, 0]
+    }
+
+    /// `ath10k_htt_h2t_aggr_cfg_msg_32` (`struct htt_aggr_conf`).
+    pub(crate) fn aggregation_config() -> Vec<u8> {
+        vec![H2T_AGGR_CFG, MAX_AMPDU, MAX_AMSDU]
+    }
+
+    /// `ath10k_htt_send_rx_ring_cfg_32`.
+    pub(crate) fn ring_config(&self) -> Vec<u8> {
+        let mut out = vec![H2T_RX_RING_CFG, 1, 0, 0];
+        out.extend_from_slice(&(self.alloc_index.daddr() as u32).to_le_bytes());
+        out.extend_from_slice(&(self.ring.daddr() as u32).to_le_bytes());
+        out.extend_from_slice(&(RX_RING as u16).to_le_bytes());
+        out.extend_from_slice(&(RX_BUF as u16).to_le_bytes());
+        out.extend_from_slice(&RX_RING_FLAGS.to_le_bytes());
+        out.extend_from_slice(&(self.write as u16).to_le_bytes());
+        // Offsets in words: 802.11 header, payload, PPDU start/end, MPDU
+        // start/end, MSDU start/end, attention, fragments.
+        for offset in [HDR_STATUS / 4, RX_DESC / 4, PPDU_START / 4, 31, MPDU_START / 4, 20, MSDU_START / 4, MSDU_END / 4, ATTENTION / 4, FRAG_INFO / 4] {
+            out.extend_from_slice(&(offset as u16).to_le_bytes());
+        }
+        out
+    }
+
+    // ---- RX buffers. ----
+
+    fn buffer_address(&self, buffer: usize) -> u32 {
+        (self.blocks[buffer / PER_BLOCK].daddr() + (buffer % PER_BLOCK) * RX_BUF) as u32
+    }
+
+    fn buffer_of(&self, address: u32) -> Option<usize> {
+        self.blocks.iter().enumerate().find_map(|(index, block)| {
+            let start = block.daddr() as u32;
+            let offset = address.checked_sub(start)? as usize;
+            (offset < BLOCK && offset % RX_BUF == 0).then_some(index * PER_BLOCK + offset / RX_BUF)
+        })
+    }
+
+    fn buffer_read(&self, buffer: usize, at: usize, out: &mut [u8]) {
+        let _ = self.blocks[buffer / PER_BLOCK].read_bytes((buffer % PER_BLOCK) * RX_BUF + at, out);
+    }
+
+    fn buffer_clear_attention(&self, buffer: usize) {
+        let _ = self.blocks[buffer / PER_BLOCK].write_bytes((buffer % PER_BLOCK) * RX_BUF + ATTENTION, &[0u8; 4]);
+    }
+
+    /// `__ath10k_htt_rx_ring_fill_n`: free buffers into the ring up to the
+    /// fill level, the new index where the target reads it.
+    pub(crate) fn fill(&mut self) {
+        let mut moved = false;
+        while self.filled < RX_FILL {
+            let Some(buffer) = self.free.pop() else { break };
+            self.buffer_clear_attention(buffer);
+            let _ = self.ring.write_bytes(self.write * 4, &self.buffer_address(buffer).to_le_bytes());
+            self.slots[self.write] = Some(buffer);
+            self.write = (self.write + 1) % RX_RING;
+            self.filled += 1;
+            moved = true;
+        }
+        if moved {
+            let _ = self.alloc_index.write_bytes(0, &(self.write as u32).to_le_bytes());
+        }
+    }
+
+    /// The next buffer in ring order (`ath10k_htt_rx_netbuf_pop`).
+    fn pop(&mut self) -> Option<usize> {
+        if self.filled == 0 {
+            return None;
+        }
+        let buffer = self.slots[self.read].take();
+        self.read = (self.read + 1) % RX_RING;
+        self.filled -= 1;
+        buffer
+    }
+
+    /// The buffer at an address (`ath10k_htt_rx_pop_paddr`). The target
+    /// may keep buffers past the slot it took them from (it reorders), so
+    /// the slot may hold a newer one already.
+    fn pop_address(&mut self, address: u32) -> Option<usize> {
+        let buffer = self.buffer_of(address)?;
+        if self.free.contains(&buffer) {
+            return None;
+        }
+        if let Some(slot) = self.slots.iter().position(|slot| *slot == Some(buffer)) {
+            self.slots[slot] = None;
+        }
+        self.filled = self.filled.saturating_sub(1);
+        Some(buffer)
+    }
+
+    fn release_buffers(&mut self, buffers: &[usize]) {
+        self.free.extend_from_slice(buffers);
+    }
+
+    // ---- T2H messages. ----
+
+    /// A T2H message: frames into `out`, the peers and TX slots kept.
+    pub(crate) fn handle(&mut self, message: &[u8], out: &mut Vec<Received>) -> Changes {
+        let mut changes = Changes::default();
+        let Some(&kind) = message.first() else { return changes };
+        match kind {
+            T2H_VERSION_CONF if message.len() >= 4 => self.version = Some((message[2], message[1])),
+            T2H_PEER_MAP if message.len() >= 10 => {
+                let id = le16(message, 2);
+                let mut address = [0u8; 6];
+                address.copy_from_slice(&message[4..10]);
+                self.peers.retain(|&(peer, _)| peer != id);
+                self.peers.push((id, address));
+                changes.peer_mapped = true;
+            }
+            T2H_PEER_UNMAP if message.len() >= 4 => {
+                let id = le16(message, 2);
+                self.peers.retain(|&(peer, _)| peer != id);
+                changes.peer_unmapped = true;
+            }
+            T2H_TX_COMPL_IND if message.len() >= 4 => {
+                for index in 0..message[2] as usize {
+                    let id = le16(message, 4 + index * 2) as usize;
+                    if let Some(slot) = self.busy.get_mut(id) {
+                        *slot = false;
+                    }
+                }
+                changes.tx_done = true;
+            }
+            T2H_RX_IND => {
+                self.rx_indication(message, out);
+                self.fill();
+            }
+            T2H_RX_IN_ORD_PADDR_IND => {
+                self.in_order_indication(message, out);
+                self.fill();
+            }
+            _ => {}
+        }
+        changes
+    }
+
+    /// `ath10k_htt_rx_proc_rx_ind_ll`: each MPDU of each range from the
+    /// ring.
+    fn rx_indication(&mut self, message: &[u8], out: &mut Vec<Received>) {
+        if message.len() < RX_IND_PREFIX + 4 {
+            return;
+        }
+        let ranges = (le32(message, 4) >> 24) as usize;
+        let fw_bytes = le16(message, RX_IND_PREFIX) as usize;
+        let ranges_at = RX_IND_PREFIX + 4 + fw_bytes.next_multiple_of(4);
+        for range in 0..ranges {
+            let at = ranges_at + range * 4;
+            let Some(entry) = message.get(at..at + 2) else { break };
+            let (count, status) = (entry[0] as usize, entry[1]);
+            for _ in 0..count {
+                let Some(msdus) = self.pop_mpdu() else { return };
+                if !RX_STATUS_DROP.contains(&status) {
+                    self.mpdu(&msdus, None, out);
+                }
+                self.release_buffers(&msdus);
+            }
+        }
+    }
+
+    /// `ath10k_htt_rx_amsdu_pop`: the MSDUs of one MPDU. Chained buffers
+    /// (an MSDU longer than a buffer) are dropped.
+    fn pop_mpdu(&mut self) -> Option<Vec<usize>> {
+        let mut msdus = Vec::new();
+        loop {
+            let Some(buffer) = self.pop() else {
+                self.release_buffers(&msdus);
+                return None;
+            };
+            msdus.push(buffer);
+            let mut desc = [0u8; MSDU_END + 20];
+            self.buffer_read(buffer, 0, &mut desc);
+            if le32(&desc, ATTENTION) & ATTENTION_MSDU_DONE == 0 {
+                // A stale descriptor: Linux gives up on the indication too.
+                self.release_buffers(&msdus);
+                return None;
+            }
+            for _ in 0..desc[FRAG_INFO + 2] {
+                if let Some(chained) = self.pop() {
+                    self.release_buffers(&[chained]);
+                }
+            }
+            if le32(&desc, MSDU_END + 16) & MSDU_END_LAST != 0 {
+                return Some(msdus);
+            }
+        }
+    }
+
+    /// `ath10k_htt_rx_in_ord_ind`: the MSDUs by address, cut into MPDUs at
+    /// their last MSDU; offloaded frames are 802.11 frames already.
+    fn in_order_indication(&mut self, message: &[u8], out: &mut Vec<Received>) {
+        if message.len() < IN_ORD_HEADER {
+            return;
+        }
+        let info = message[1];
+        let count = le16(message, 6) as usize;
+        let mut msdus: Vec<(usize, usize)> = Vec::with_capacity(count);
+        for index in 0..count {
+            let at = IN_ORD_HEADER + index * IN_ORD_DESC;
+            if message.len() < at + IN_ORD_DESC {
+                break;
+            }
+            let (address, length) = (le32(message, at), le16(message, at + 4) as usize);
+            match self.pop_address(address) {
+                Some(buffer) => msdus.push((buffer, length)),
+                None => ostd::warn!("the target filled an unknown RX buffer {:#x}", address),
+            }
+        }
+        let buffers: Vec<usize> = msdus.iter().map(|&(buffer, _)| buffer).collect();
+        if info & IN_ORD_FRAG != 0 {
+            // Fragments: not reassembled here.
+        } else if info & IN_ORD_OFFLOAD != 0 {
+            for &(buffer, _) in &msdus {
+                let mut header = [0u8; OFFLOAD_HEADER];
+                self.buffer_read(buffer, 0, &mut header);
+                let length = (le16(&header, 0) as usize).min(RX_BUF - OFFLOAD_HEADER);
+                let mut frame = vec![0u8; length];
+                self.buffer_read(buffer, OFFLOAD_HEADER, &mut frame);
+                if frame.len() >= 24 {
+                    // Decrypted by the firmware, which leaves the Protected
+                    // bit (`ath10k_htt_rx_h_rx_offload_prep`).
+                    let decrypted = frame[1] & 0x40 != 0;
+                    out.push(Received::Frame { frame, signal: self.signal, decrypted, security_header: 0 });
+                }
+            }
+        } else {
+            let mut mpdu = Vec::new();
+            for &(buffer, _) in &msdus {
+                mpdu.push(buffer);
+                let mut desc = [0u8; MSDU_END + 20];
+                self.buffer_read(buffer, 0, &mut desc);
+                if le32(&desc, ATTENTION) & ATTENTION_MSDU_DONE == 0 {
+                    mpdu.clear();
+                    continue;
+                }
+                if le32(&desc, MSDU_END + 16) & MSDU_END_LAST != 0 {
+                    self.mpdu(&mpdu, Some(&msdus), out);
+                    mpdu.clear();
+                }
+            }
+        }
+        self.release_buffers(&buffers);
+    }
+
+    /// The MSDUs of an MPDU as frames (`ath10k_htt_rx_h_mpdu` and the
+    /// undecaps). `lengths`: the in-order indication's payload lengths.
+    fn mpdu(&mut self, msdus: &[usize], lengths: Option<&[(usize, usize)]>, out: &mut Vec<Received>) {
+        let Some(&first_buffer) = msdus.first() else { return };
+        let mut first = [0u8; RX_DESC];
+        self.buffer_read(first_buffer, 0, &mut first);
+        // The error flags are valid in the last MSDU's descriptor.
+        let mut last = [0u8; 8];
+        self.buffer_read(*msdus.last().unwrap_or(&first_buffer), 0, &mut last);
+        let attention = le32(&last, ATTENTION);
+        if attention & (ATTENTION_FCS_ERR | ATTENTION_DECRYPT_ERR | ATTENTION_TKIP_MIC_ERR) != 0 {
+            return;
+        }
+        let mpdu_info = le32(&first, MPDU_START);
+        let encrypt = if mpdu_info & MPDU_START_ENCRYPTED != 0 { mpdu_info >> 28 } else { ENCRYPT_NONE };
+        let original: [u8; 64] = first[HDR_STATUS..HDR_STATUS + 64].try_into().unwrap();
+        let rssi = first[PPDU_START + 16];
+        if rssi != RSSI_INVALID {
+            self.signal = (NOISE_FLOOR + rssi as i32).clamp(-127, -1) as i8;
+        }
+        let signal = self.signal;
+        let decrypted = encrypt != ENCRYPT_NONE;
+        for &buffer in msdus {
+            let mut desc = [0u8; MSDU_END + 20];
+            self.buffer_read(buffer, 0, &mut desc);
+            if le32(&desc, ATTENTION) & ATTENTION_LENGTH_ERRS != 0 {
+                continue;
+            }
+            let length = lengths
+                .and_then(|lengths| lengths.iter().find(|&&(entry, _)| entry == buffer).map(|&(_, length)| length))
+                .unwrap_or((le32(&desc, MSDU_START) & 0x3fff) as usize);
+            let decap = (le32(&desc, MSDU_START + 8) >> 8) & 3;
+            let mut payload = vec![0u8; length.min(RX_MSDU_SIZE)];
+            self.buffer_read(buffer, RX_DESC, &mut payload);
+            match decap {
+                DECAP_NATIVE_WIFI => {
+                    if let Some((frame, security_header)) = undecap_nwifi(&payload, &original, encrypt) {
+                        out.push(Received::Frame { frame, signal, decrypted, security_header });
+                    }
+                }
+                DECAP_ETHERNET => out.push(Received::Ethernet(payload, decrypted)),
+                DECAP_RAW if payload.len() > 4 && !decrypted => {
+                    // With its FCS (`ath10k_htt_rx_h_undecap_raw`).
+                    payload.truncate(payload.len() - 4);
+                    out.push(Received::Frame { frame: payload, signal, decrypted: false, security_header: 0 });
+                }
+                _ => {}
+            }
+        }
+    }
+
+    // ---- TX. ----
+
+    fn slot(&mut self) -> Option<usize> {
+        for step in 0..TX_SLOTS {
+            let slot = (self.next + step) % TX_SLOTS;
+            if !self.busy[slot] {
+                self.busy[slot] = true;
+                self.next = (slot + 1) % TX_SLOTS;
+                return Some(slot);
+            }
+        }
+        None
+    }
+
+    /// `ath10k_htt_tx_32`: the frame in its slot, the TX descriptor with
+    /// the HTC header before it; the two pieces for the CE (the HTC header
+    /// and descriptor, the frame's first bytes for the target to classify).
+    /// Management frames are named by their own address, data frames by
+    /// the fragment list.
+    pub(crate) fn tx(&mut self, frame: &[u8], mode: u8, vdev: u8, tid: u8, no_encrypt: bool) -> Option<(usize, [(u32, usize); 2])> {
+        if frame.len() > TX_BUF || frame.is_empty() {
+            return None;
+        }
+        let slot = self.slot()?;
+        let frame_address = (self.frames.daddr() + slot * TX_BUF) as u32;
+        let _ = self.frames.write_bytes(slot * TX_BUF, frame);
+        let txbuf_address = (self.txbufs.daddr() + slot * TXBUF) as u32;
+        let prefetch = PREFETCH.min(frame.len()).next_multiple_of(4);
+        let mut flags0 = (mode << 5) | FLAGS0_MAC_HDR_PRESENT;
+        if no_encrypt {
+            flags0 |= FLAGS0_NO_ENCRYPT;
+        }
+        let flags1 = (vdev as u16 & 0x3f) | ((tid as u16 & 0x1f) << 6) | FLAGS1_POSTPONED;
+        let frags_address = if mode == TX_MODE_MGMT { frame_address } else { txbuf_address };
+        let mut txbuf = [0u8; TXBUF_HTC + TXBUF_SENT];
+        txbuf[0..4].copy_from_slice(&frame_address.to_le_bytes());
+        txbuf[4..8].copy_from_slice(&(frame.len() as u32).to_le_bytes());
+        // The HTC header: endpoint, no flags, the length after it.
+        txbuf[TXBUF_HTC] = self.endpoint as u8;
+        txbuf[TXBUF_HTC + 2..TXBUF_HTC + 4].copy_from_slice(&((1 + 15 + prefetch) as u16).to_le_bytes());
+        // The HTT command and descriptor.
+        let at = TXBUF_HTC + 8;
+        txbuf[at] = H2T_TX_FRM;
+        txbuf[at + 1] = flags0;
+        txbuf[at + 2..at + 4].copy_from_slice(&flags1.to_le_bytes());
+        txbuf[at + 4..at + 6].copy_from_slice(&(frame.len() as u16).to_le_bytes());
+        txbuf[at + 6..at + 8].copy_from_slice(&(slot as u16).to_le_bytes());
+        txbuf[at + 8..at + 12].copy_from_slice(&frags_address.to_le_bytes());
+        txbuf[at + 12..at + 16].copy_from_slice(&INVALID_PEER.to_le_bytes());
+        let _ = self.txbufs.write_bytes(slot * TXBUF, &txbuf);
+        Some((slot, [(txbuf_address + TXBUF_HTC as u32, TXBUF_SENT), (frame_address, prefetch)]))
+    }
+
+    /// A slot whose frame did not go out.
+    pub(crate) fn release(&mut self, slot: usize) {
+        if let Some(busy) = self.busy.get_mut(slot) {
+            *busy = false;
+        }
+    }
+
+    pub(crate) fn reset_tx(&mut self) {
+        self.busy.iter_mut().for_each(|busy| *busy = false);
+    }
+}
+
+/// Linux's `ath10k_htt_rx_h_undecap_nwifi`: the original 802.11 header
+/// (and the cipher's header) in place of the native Wi-Fi one, its DA and
+/// SA kept, the A-MSDU bit cleared (the chip split the A-MSDU). The frame
+/// and the length of the cipher's header in it.
+fn undecap_nwifi(payload: &[u8], original: &[u8; 64], encrypt: u32) -> Option<(Vec<u8>, u8)> {
+    if payload.len() < 24 {
+        return None;
+    }
+    let (da, sa) = (address_da(payload)?, address_sa(payload)?);
+    // The native Wi-Fi header is padded to 4 bytes.
+    let body = payload.get(header_length(payload).next_multiple_of(4)..)?;
+    let header_len = header_length(original);
+    // The cipher's header (`ath10k_htt_rx_crypto_param_len`).
+    let crypto = match encrypt {
+        ENCRYPT_NONE => 0,
+        0 | 1 | 3 => 4,
+        _ => 8,
+    };
+    let crypto_at = header_len.next_multiple_of(4);
+    let mut frame = Vec::with_capacity(header_len + crypto + body.len());
+    frame.extend_from_slice(original.get(..header_len)?);
+    if crypto > 0 {
+        frame.extend_from_slice(original.get(crypto_at..crypto_at + crypto)?);
+    }
+    frame.extend_from_slice(body);
+    set_da_sa(&mut frame, &da, &sa);
+    if frame[0] & 0xfc == 0x88 {
+        let qos = if frame[1] & 0x03 == 0x03 { 30 } else { 24 };
+        if let Some(byte) = frame.get_mut(qos) {
+            *byte &= !0x80;
+        }
+    }
+    Some((frame, crypto as u8))
+}
+
+/// `ieee80211_hdrlen` of a data or management frame.
+fn header_length(header: &[u8]) -> usize {
+    let (fc0, fc1) = (header[0], header[1]);
+    let mut length = if fc0 & 0x0c == 0x08 && fc1 & 0x03 == 0x03 { 30 } else { 24 };
+    if fc0 & 0x0c == 0x08 && fc0 & 0x80 != 0 {
+        length += 2;
+        if fc1 & 0x80 != 0 {
+            length += 4;
+        }
+    }
+    length
+}
+
+fn da_offset(frame: &[u8]) -> usize {
+    if frame[1] & 0x01 != 0 { 16 } else { 4 }
+}
+
+fn sa_offset(frame: &[u8]) -> usize {
+    match frame[1] & 0x03 {
+        0x02 => 16,
+        0x03 => 24,
+        _ => 10,
+    }
+}
+
+/// `ieee80211_get_DA`/`_SA` of a frame by its DS bits.
+fn address_da(frame: &[u8]) -> Option<[u8; 6]> {
+    let at = da_offset(frame);
+    frame.get(at..at + 6)?.try_into().ok()
+}
+
+fn address_sa(frame: &[u8]) -> Option<[u8; 6]> {
+    let at = sa_offset(frame);
+    frame.get(at..at + 6)?.try_into().ok()
+}
+
+fn set_da_sa(frame: &mut [u8], da: &[u8; 6], sa: &[u8; 6]) {
+    let (da_at, sa_at) = (da_offset(frame), sa_offset(frame));
+    if frame.len() >= da_at + 6 {
+        frame[da_at..da_at + 6].copy_from_slice(da);
+    }
+    if frame.len() >= sa_at + 6 {
+        frame[sa_at..sa_at + 6].copy_from_slice(sa);
+    }
+}
