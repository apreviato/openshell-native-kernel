--- /dev/null
+++ b/kernel/comps/wlan/src/device.rs
@@ -0,0 +1,999 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! A Wi-Fi interface as a station: the networks it heard, and the link to
+//! one of them, made in the steps a supplicant asks for (authenticate,
+//! associate, install the keys, authorize) and reported to it frame by
+//! frame, as Linux's mac80211 does for wpa_supplicant.
+
+use alloc::{
+    collections::{BTreeMap, VecDeque},
+    string::String,
+    sync::Arc,
+    vec::Vec,
+};
+use core::sync::atomic::{AtomicBool, AtomicU8, AtomicU32, Ordering};
+
+use ostd::sync::{LocalIrqDisabled, Mutex, SpinLock};
+
+use crate::{
+    cfg,
+    ieee80211::{self as wifi, Address},
+    netdev,
+    radio::{self, Association, BandId, Info, Join, Key, Radio, RxInfo, ScanRequest},
+};
+
+pub(crate) const ENOENT: i32 = 2;
+pub(crate) const EBUSY: i32 = 16;
+pub(crate) const EINVAL: i32 = 22;
+pub(crate) const ENOLINK: i32 = 67;
+pub(crate) const ENETDOWN: i32 = 100;
+pub(crate) const ENOTCONN: i32 = 107;
+
+/// A network that is not heard for this long is forgotten.
+const BSS_EXPIRE_MS: u64 = 30_000;
+/// The most networks remembered: a crowded building has a few hundred.
+const BSS_MAX: usize = 512;
+/// A scan the radio never ends is given up.
+const SCAN_TIMEOUT_MS: u64 = 30_000;
+/// How long an answer to an authentication or association frame is waited
+/// for, and how many times the frame is sent.
+const MLME_TIMEOUT_MS: u64 = 500;
+const MLME_TRIES: u8 = 3;
+/// SAE's answers take the access point an elliptic-curve computation.
+const SAE_TIMEOUT_MS: u64 = 2_000;
+/// An authentication that no association follows is dropped.
+const AUTHENTICATED_IDLE_MS: u64 = 5_000;
+/// Frames waiting for the task, from the radio.
+const EVENT_QUEUE: usize = 256;
+
+pub(crate) const ALGORITHM_OPEN: u16 = 0;
+pub(crate) const ALGORITHM_SAE: u16 = 3;
+const STATUS_SUCCESS: u16 = 0;
+/// SAE statuses that ask the supplicant for another commit.
+const STATUS_ANTI_CLOGGING: u16 = 76;
+const STATUS_SAE_HASH_TO_ELEMENT: u16 = 126;
+const STATUS_SAE_PK: u16 = 127;
+
+/// The link's state as the data path reads it.
+const LINK_NONE: u8 = 0;
+const LINK_ASSOCIATED: u8 = 1;
+const LINK_AUTHORIZED: u8 = 2;
+
+/// A network heard in a scan.
+#[derive(Clone, Debug)]
+pub(crate) struct Bss {
+    pub bssid: Address,
+    pub freq: u16,
+    pub signal: i8,
+    pub timestamp: u64,
+    pub interval: u16,
+    pub capability: u16,
+    /// Of the last probe response, or of the last beacon without one.
+    pub elements: Vec<u8>,
+    /// Of the last beacon.
+    pub beacon_elements: Option<Vec<u8>>,
+    /// When it was last heard, in milliseconds since boot.
+    pub seen: u64,
+    probed: bool,
+}
+
+impl Bss {
+    pub(crate) fn ssid(&self) -> &[u8] {
+        wifi::Elements(&self.elements).get(wifi::IE_SSID).unwrap_or(&[])
+    }
+
+    fn join(&self) -> Join {
+        Join {
+            bssid: self.bssid,
+            freq: self.freq,
+            beacon_interval: self.interval,
+            capability: self.capability,
+            elements: self.elements.clone(),
+        }
+    }
+}
+
+/// An authentication to run.
+#[derive(Clone, Debug)]
+pub(crate) struct AuthRequest {
+    pub bssid: Address,
+    pub algorithm: u16,
+    /// The fields after the algorithm that the supplicant computed (SAE:
+    /// transaction, status and the algorithm's body).
+    pub data: Vec<u8>,
+    /// Elements to end the frame with.
+    pub elements: Vec<u8>,
+}
+
+/// An association to run.
+#[derive(Clone, Debug)]
+pub(crate) struct AssocRequest {
+    pub bssid: Address,
+    /// The supplicant's elements (the RSN one, its capabilities).
+    pub elements: Vec<u8>,
+    pub previous: Option<Address>,
+    /// The pairwise cipher cannot run under 802.11n and later (TKIP, WEP).
+    pub legacy_cipher: bool,
+    /// Management frames are protected once the keys are in place.
+    pub protect_management: bool,
+    /// The frames that authenticate the link go to the supplicant's
+    /// socket, bound to this port, rather than through the interface.
+    pub control_port: Option<u32>,
+    /// The socket whose closing ends the link.
+    pub owner: Option<u32>,
+}
+
+enum Link {
+    Idle,
+    Authenticating { bss: Bss, algorithm: u16, frame: Vec<u8>, tries: u8, deadline: u64 },
+    Authenticated { bss: Bss, since: u64 },
+    Associating { bss: Bss, frame: Vec<u8>, tries: u8, deadline: u64, request: AssocRequest },
+    Associated { bss: Bss },
+}
+
+impl Link {
+    fn bss(&self) -> Option<&Bss> {
+        match self {
+            Link::Idle => None,
+            Link::Authenticating { bss, .. }
+            | Link::Authenticated { bss, .. }
+            | Link::Associating { bss, .. }
+            | Link::Associated { bss } => Some(bss),
+        }
+    }
+}
+
+struct Scan {
+    started: u64,
+}
+
+struct State {
+    up: bool,
+    networks: BTreeMap<Address, Bss>,
+    /// Changes with the list of networks (nl80211's generation).
+    generation: u32,
+    scan: Option<Scan>,
+    link: Link,
+    /// The keys in place: index, pairwise, cipher.
+    keys: Vec<(u8, bool, u32)>,
+    control_port: Option<u32>,
+    owner: Option<u32>,
+    protect_management: bool,
+}
+
+/// What the radio's driver reports, for the task.
+enum Event {
+    Management(Vec<u8>, RxInfo),
+    /// A data frame that came while the association's answer was still
+    /// waiting for the task: it keeps its place behind it.
+    Data(Vec<u8>, RxInfo),
+    /// A frame that authenticates the link (EAPOL), as Ethernet, and
+    /// whether it came unencrypted.
+    Port(Vec<u8>, bool),
+    ScanDone { aborted: bool },
+    Lost,
+}
+
+/// What a supplicant reads of the link.
+#[derive(Clone, Debug)]
+pub(crate) struct LinkInfo {
+    pub freq: u16,
+    pub ssid: Vec<u8>,
+    pub associated: bool,
+}
+
+/// A Wi-Fi interface.
+pub struct Device {
+    /// Its number among the radios (nl80211's wiphy index).
+    pub(crate) index: u32,
+    /// The interface's name (`wlan0`).
+    pub(crate) name: String,
+    pub(crate) info: Info,
+    radio: Arc<dyn Radio>,
+    state: Mutex<State>,
+    events: SpinLock<VecDeque<Event>, LocalIrqDisabled>,
+    net: Arc<netdev::Shared>,
+    link: AtomicU8,
+    bssid: SpinLock<Address, LocalIrqDisabled>,
+    /// An association request is out: the access point's first data frame
+    /// (its handshake) may come right behind its answer.
+    associating: AtomicBool,
+    /// A pairwise key is in place: data that comes unencrypted is dropped.
+    encrypted: AtomicBool,
+    ifindex: AtomicU32,
+}
+
+impl Device {
+    pub(crate) fn new(index: u32, name: String, info: Info, radio: Arc<dyn Radio>) -> Arc<Self> {
+        Arc::new(Self {
+            index,
+            name,
+            info,
+            radio,
+            state: Mutex::new(State {
+                up: false,
+                networks: BTreeMap::new(),
+                generation: 1,
+                scan: None,
+                link: Link::Idle,
+                keys: Vec::new(),
+                control_port: None,
+                owner: None,
+                protect_management: false,
+            }),
+            events: SpinLock::new(VecDeque::new()),
+            net: netdev::Shared::new(),
+            link: AtomicU8::new(LINK_NONE),
+            bssid: SpinLock::new([0; 6]),
+            associating: AtomicBool::new(false),
+            encrypted: AtomicBool::new(false),
+            ifindex: AtomicU32::new(0),
+        })
+    }
+
+    pub(crate) fn net(&self) -> &Arc<netdev::Shared> {
+        &self.net
+    }
+
+    /// The interface's index in the kernel's network stack.
+    pub(crate) fn ifindex(&self) -> u32 {
+        let known = self.ifindex.load(Ordering::Relaxed);
+        if known != 0 {
+            return known;
+        }
+        let found = crate::ifindex_of(&self.name).unwrap_or(0);
+        self.ifindex.store(found, Ordering::Relaxed);
+        found
+    }
+
+    // ---- What the radio's driver calls. None of these sleeps. ----
+
+    /// A frame the radio received: management frames wait for the task,
+    /// data goes on to the network stack.
+    pub fn received(&self, frame: &[u8], info: RxInfo) {
+        if wifi::is_management(frame) {
+            self.push(Event::Management(frame.to_vec(), info));
+        } else if wifi::is_data(frame) {
+            self.received_data(frame, &info);
+        }
+    }
+
+    fn received_data(&self, frame: &[u8], info: &RxInfo) {
+        let link = self.link.load(Ordering::Acquire);
+        if frame.len() < wifi::HEADER {
+            return;
+        }
+        if link == LINK_NONE {
+            // Management frames wait for the task; data that follows the
+            // association's answer must not overtake it.
+            if self.associating.load(Ordering::Acquire) {
+                self.push(Event::Data(frame.to_vec(), *info));
+            }
+            return;
+        }
+        let Some((_, transmitter, _)) = wifi::addresses(frame) else { return };
+        if transmitter != *self.bssid.lock() {
+            return;
+        }
+        let protected = frame[1] & wifi::PROTECTED != 0;
+        if protected && !info.decrypted {
+            return;
+        }
+        let security = if protected { info.security_header as usize } else { 0 };
+        for ethernet in wifi::ethernet_from_data(frame, &self.info.address, security) {
+            self.received_ethernet(ethernet, protected);
+        }
+    }
+
+    /// A frame from the network, already as Ethernet (chips whose firmware
+    /// converts), and whether it came encrypted.
+    pub fn received_ethernet(&self, ethernet: Vec<u8>, protected: bool) {
+        let link = self.link.load(Ordering::Acquire);
+        let encrypted = self.encrypted.load(Ordering::Acquire);
+        match wifi::ethertype(&ethernet) {
+            None => {}
+            Some(wifi::ETHERTYPE_EAPOL | wifi::ETHERTYPE_PREAUTH) => {
+                // Unencrypted only until the pairwise key is in place.
+                if link != LINK_NONE && (protected || !encrypted) {
+                    self.push(Event::Port(ethernet, !protected));
+                }
+            }
+            Some(_) => {
+                if link == LINK_AUTHORIZED && (protected || !encrypted) {
+                    self.net.received(ethernet);
+                    netdev::notify_received();
+                }
+            }
+        }
+    }
+
+    /// The scan the radio was running ended.
+    pub fn scan_done(&self, aborted: bool) {
+        self.push(Event::ScanDone { aborted });
+    }
+
+    /// The access point is not heard any more.
+    pub fn connection_lost(&self) {
+        self.push(Event::Lost);
+    }
+
+    /// The radio takes frames to send again.
+    pub fn ready_to_send(&self) {
+        crate::wake();
+    }
+
+    fn push(&self, event: Event) {
+        {
+            let mut events = self.events.lock();
+            if events.len() >= EVENT_QUEUE {
+                // Beacons flood a scan; what matters (an answer to this
+                // station) is sent again by its sender.
+                return;
+            }
+            events.push_back(event);
+        }
+        crate::wake();
+    }
+
+    // ---- The task: events, time-outs, frames to send. ----
+
+    /// One pass. Returns whether something is still waiting on a time-out.
+    pub(crate) fn run(&self, now: u64) -> bool {
+        self.radio.tick(now);
+        loop {
+            let Some(event) = self.events.lock().pop_front() else { break };
+            let mut state = self.state.lock();
+            match event {
+                Event::Management(frame, info) => self.management(&mut state, &frame, &info, now),
+                Event::Data(frame, info) => {
+                    if self.link.load(Ordering::Acquire) != LINK_NONE {
+                        self.received_data(&frame, &info);
+                    }
+                }
+                Event::Port(ethernet, unencrypted) => self.port_frame(&state, ethernet, unencrypted),
+                Event::ScanDone { aborted } => self.end_scan(&mut state, aborted, now),
+                Event::Lost => {
+                    if let Link::Associated { bss } = &state.link {
+                        let bssid = bss.bssid;
+                        ostd::notice!("{}: the access point is not heard any more", self.name);
+                        // Told as a frame this station sent to leave: the
+                        // supplicant then looks for the network again.
+                        let frame = wifi::deauth(&bssid, &self.info.address, &bssid, wifi::REASON_DISASSOC_INACTIVITY, false);
+                        self.disconnect(&mut state);
+                        cfg::mlme_frame(self, cfg::Mlme::Deauthenticate, &frame, None);
+                    }
+                }
+            }
+        }
+        let mut state = self.state.lock();
+        self.timeouts(&mut state, now);
+        self.send_queued(&state);
+        state.scan.is_some() || !matches!(state.link, Link::Idle | Link::Associated { .. })
+    }
+
+    fn send_queued(&self, state: &State) {
+        if !state.up {
+            self.net.clear_tx();
+            return;
+        }
+        while let Some(ethernet) = self.net.next_tx() {
+            if self.link.load(Ordering::Acquire) != LINK_AUTHORIZED {
+                continue;
+            }
+            // The supplicant's own frames take the control port.
+            if matches!(wifi::ethertype(&ethernet), Some(wifi::ETHERTYPE_EAPOL)) && state.control_port.is_some() {
+                continue;
+            }
+            match self.radio.send(&ethernet, !self.encrypted.load(Ordering::Acquire)) {
+                Err(radio::Error::Busy) => {
+                    self.net.put_back(ethernet);
+                    break;
+                }
+                _ => self.net.sent(),
+            }
+        }
+    }
+
+    fn timeouts(&self, state: &mut State, now: u64) {
+        if state.scan.as_ref().is_some_and(|scan| now >= scan.started + SCAN_TIMEOUT_MS) {
+            ostd::warn!("{}: the scan did not end", self.name);
+            self.radio.abort_scan();
+            self.end_scan(state, true, now);
+        }
+        match &mut state.link {
+            Link::Authenticating { bss, frame, tries, deadline, algorithm } if now >= *deadline => {
+                // SAE's frames are the supplicant's to send again.
+                if *tries < MLME_TRIES && *algorithm != ALGORITHM_SAE {
+                    *tries += 1;
+                    *deadline = now + MLME_TIMEOUT_MS;
+                    let _ = self.radio.send_management(frame);
+                } else {
+                    let bssid = bss.bssid;
+                    ostd::notice!("{}: no answer to the authentication", self.name);
+                    self.disconnect(state);
+                    cfg::mlme_timeout(self, cfg::Mlme::Authenticate, &bssid);
+                }
+            }
+            Link::Associating { bss, frame, tries, deadline, .. } if now >= *deadline => {
+                if *tries < MLME_TRIES {
+                    *tries += 1;
+                    *deadline = now + MLME_TIMEOUT_MS;
+                    let _ = self.radio.send_management(frame);
+                } else {
+                    let bssid = bss.bssid;
+                    ostd::notice!("{}: no answer to the association", self.name);
+                    self.disconnect(state);
+                    cfg::mlme_timeout(self, cfg::Mlme::Associate, &bssid);
+                }
+            }
+            Link::Authenticated { since, .. } if now >= *since + AUTHENTICATED_IDLE_MS => {
+                self.disconnect(state);
+            }
+            _ => {}
+        }
+    }
+
+    fn end_scan(&self, state: &mut State, aborted: bool, now: u64) {
+        if state.scan.take().is_none() {
+            return;
+        }
+        let current = state.link.bss().map(|bss| bss.bssid);
+        state.networks.retain(|bssid, bss| Some(*bssid) == current || now < bss.seen + BSS_EXPIRE_MS);
+        state.generation = state.generation.wrapping_add(1);
+        cfg::scan_finished(self, aborted);
+    }
+
+    fn port_frame(&self, state: &State, ethernet: Vec<u8>, unencrypted: bool) {
+        match state.control_port {
+            Some(port) => cfg::control_port_frame(self, port, &ethernet, unencrypted),
+            None => {
+                self.net.received(ethernet);
+                netdev::notify_received();
+            }
+        }
+    }
+
+    fn management(&self, state: &mut State, frame: &[u8], info: &RxInfo, now: u64) {
+        let Some(kind) = wifi::kind(frame) else { return };
+        let Some((receiver, transmitter, _)) = wifi::addresses(frame) else { return };
+        match kind {
+            wifi::BEACON | wifi::PROBE_RESPONSE => self.heard(state, frame, info, now),
+            wifi::AUTH if receiver == self.info.address => self.auth_answer(state, frame, &transmitter),
+            wifi::ASSOC_RESPONSE | wifi::REASSOC_RESPONSE if receiver == self.info.address => {
+                self.assoc_answer(state, frame, &transmitter)
+            }
+            wifi::DEAUTH | wifi::DISASSOC => {
+                let ours = receiver == self.info.address || receiver == wifi::BROADCAST;
+                let Some(bss) = state.link.bss() else { return };
+                if !ours || bss.bssid != transmitter {
+                    return;
+                }
+                let command = if kind == wifi::DEAUTH { cfg::Mlme::Deauthenticate } else { cfg::Mlme::Disassociate };
+                // With management frame protection, a frame that came
+                // unprotected is only reported: anyone can send one.
+                let protected = frame[1] & wifi::PROTECTED != 0 && info.decrypted;
+                if state.protect_management && self.encrypted.load(Ordering::Acquire) && !protected {
+                    cfg::mlme_frame(self, command.unprotected(), frame, None);
+                    return;
+                }
+                ostd::notice!(
+                    "{}: the access point ended the link (reason {})",
+                    self.name,
+                    wifi::parse_deauth(frame).unwrap_or(0)
+                );
+                self.disconnect(state);
+                cfg::mlme_frame(self, command, frame, None);
+            }
+            _ => {}
+        }
+    }
+
+    fn heard(&self, state: &mut State, frame: &[u8], info: &RxInfo, now: u64) {
+        let Some(beacon) = wifi::parse_beacon(frame) else { return };
+        // The channel the network says it is on, when it says: frames are
+        // heard on the neighbouring channels as well.
+        let elements = wifi::Elements(beacon.elements);
+        let freq = match elements.get(wifi::IE_DS_PARAMS).and_then(|value| value.first()) {
+            Some(&channel) if BandId::of(info.freq) == BandId::Ghz2 => match channel {
+                14 => 2484,
+                1..=13 => 2407 + 5 * channel as u16,
+                _ => info.freq,
+            },
+            _ => info.freq,
+        };
+        if self.info.channel(freq).is_none() {
+            return;
+        }
+        if !state.networks.contains_key(&beacon.bssid) && state.networks.len() >= BSS_MAX {
+            return;
+        }
+        let entry = state.networks.entry(beacon.bssid).or_insert_with(|| Bss {
+            bssid: beacon.bssid,
+            freq,
+            signal: info.signal,
+            timestamp: beacon.timestamp,
+            interval: beacon.interval,
+            capability: beacon.capability,
+            elements: Vec::new(),
+            beacon_elements: None,
+            seen: now,
+            probed: false,
+        });
+        entry.freq = freq;
+        entry.signal = info.signal;
+        entry.timestamp = beacon.timestamp;
+        entry.interval = beacon.interval;
+        entry.capability = beacon.capability;
+        entry.seen = now;
+        if beacon.probe_response {
+            entry.elements = beacon.elements.to_vec();
+            entry.probed = true;
+        } else {
+            entry.beacon_elements = Some(beacon.elements.to_vec());
+            // A hidden network's beacon has an empty name: the probe
+            // response's elements stay.
+            if !entry.probed {
+                entry.elements = beacon.elements.to_vec();
+            }
+        }
+    }
+
+    fn auth_answer(&self, state: &mut State, frame: &[u8], from: &Address) {
+        let Link::Authenticating { bss, algorithm, .. } = &state.link else { return };
+        if bss.bssid != *from {
+            return;
+        }
+        let Some((answered, transaction, status)) = wifi::parse_auth(frame) else { return };
+        if answered != *algorithm {
+            return;
+        }
+        let bss = bss.clone();
+        let sae = answered == ALGORITHM_SAE;
+        // The second frame ends the exchange: an open system's answer,
+        // SAE's confirm.
+        if status == STATUS_SUCCESS && transaction == 2 {
+            ostd::info!("{}: authenticated", self.name);
+            state.link = Link::Authenticated { bss, since: crate::now_ms() };
+        } else if sae && (status == STATUS_SUCCESS || matches!(status, STATUS_ANTI_CLOGGING | STATUS_SAE_HASH_TO_ELEMENT | STATUS_SAE_PK)) {
+            // The supplicant answers with its next frame.
+            if let Link::Authenticating { deadline, .. } = &mut state.link {
+                *deadline = crate::now_ms() + SAE_TIMEOUT_MS;
+            }
+        } else {
+            ostd::notice!("{}: authentication refused (status {})", self.name, status);
+            self.disconnect(state);
+        }
+        cfg::mlme_frame(self, cfg::Mlme::Authenticate, frame, None);
+    }
+
+    fn assoc_answer(&self, state: &mut State, frame: &[u8], from: &Address) {
+        let Link::Associating { bss, frame: sent, request, .. } = &state.link else { return };
+        if bss.bssid != *from {
+            return;
+        }
+        let Some((capability, status, aid, elements)) = wifi::parse_assoc_response(frame) else { return };
+        let request_elements = wifi::assoc_request_elements(sent).to_vec();
+        if status != STATUS_SUCCESS {
+            ostd::notice!("{}: association refused (status {})", self.name, status);
+            self.disconnect(state);
+            cfg::mlme_frame(self, cfg::Mlme::Associate, frame, Some(&request_elements));
+            return;
+        }
+        let bss = bss.clone();
+        let qos = wifi::Elements(elements).vendor(wifi::WMM_OUI_TYPE).is_some();
+        let association = Association { aid, capability, elements: elements.to_vec(), request_elements: request_elements.clone(), qos };
+        let (control_port, owner, protect_management) = (request.control_port, request.owner, request.protect_management);
+        if let Err(error) = self.radio.associated(&association) {
+            ostd::warn!("{}: the radio did not take the association: {:?}", self.name, error);
+            let leave = wifi::deauth(&bss.bssid, &self.info.address, &bss.bssid, wifi::REASON_DEAUTH_LEAVING, false);
+            let _ = self.radio.send_management(&leave);
+            self.disconnect(state);
+            cfg::mlme_timeout(self, cfg::Mlme::Associate, &bss.bssid);
+            return;
+        }
+        ostd::notice!(
+            "{}: associated with {} ({} MHz)",
+            self.name,
+            crate::Mac(&bss.bssid),
+            bss.freq
+        );
+        state.control_port = control_port;
+        state.owner = owner;
+        state.protect_management = protect_management;
+        state.link = Link::Associated { bss };
+        self.link.store(LINK_ASSOCIATED, Ordering::Release);
+        self.associating.store(false, Ordering::Release);
+        cfg::mlme_frame(self, cfg::Mlme::Associate, frame, Some(&request_elements));
+    }
+
+    /// Drops the link, whatever its state, without a word to the network.
+    fn disconnect(&self, state: &mut State) {
+        if matches!(state.link, Link::Idle) {
+            return;
+        }
+        let was_authorized = self.link.swap(LINK_NONE, Ordering::AcqRel) == LINK_AUTHORIZED;
+        self.associating.store(false, Ordering::Release);
+        self.encrypted.store(false, Ordering::Release);
+        *self.bssid.lock() = [0; 6];
+        state.link = Link::Idle;
+        state.keys.clear();
+        state.control_port = None;
+        state.owner = None;
+        state.protect_management = false;
+        self.radio.leave();
+        self.net.clear_tx();
+        if was_authorized {
+            crate::link_changed(&self.name, false);
+        }
+    }
+
+    // ---- What a supplicant asks (nl80211). ----
+
+    pub(crate) fn is_up(&self) -> bool {
+        self.state.lock().up
+    }
+
+    /// The interface goes up (the radio is powered) or down.
+    pub(crate) fn set_up(&self, up: bool) -> Result<(), i32> {
+        let mut state = self.state.lock();
+        if state.up == up {
+            return Ok(());
+        }
+        if up {
+            self.radio.start().map_err(|error| {
+                ostd::warn!("{}: the radio did not start: {:?}", self.name, error);
+                error.errno()
+            })?;
+            state.up = true;
+        } else {
+            if state.scan.is_some() {
+                self.radio.abort_scan();
+                self.end_scan(&mut state, true, crate::now_ms());
+            }
+            if let Some(bss) = state.link.bss().cloned() {
+                let frame = wifi::deauth(&bss.bssid, &self.info.address, &bss.bssid, wifi::REASON_DEAUTH_LEAVING, false);
+                let _ = self.radio.send_management(&frame);
+                self.disconnect(&mut state);
+                cfg::mlme_frame(self, cfg::Mlme::Deauthenticate, &frame, None);
+            }
+            self.radio.stop();
+            state.up = false;
+        }
+        ostd::notice!("{}: {}", self.name, if up { "up" } else { "down" });
+        Ok(())
+    }
+
+    pub(crate) fn scan(&self, request: ScanRequest, flush: bool) -> Result<(), i32> {
+        let mut state = self.state.lock();
+        if !state.up {
+            return Err(ENETDOWN);
+        }
+        if state.scan.is_some() {
+            return Err(EBUSY);
+        }
+        // While a link is being made the radio stays on its channel.
+        if matches!(state.link, Link::Authenticating { .. } | Link::Associating { .. }) {
+            return Err(EBUSY);
+        }
+        if flush {
+            let current = state.link.bss().map(|bss| bss.bssid);
+            state.networks.retain(|bssid, _| Some(*bssid) == current);
+        }
+        self.radio.scan(&request).map_err(radio::Error::errno)?;
+        state.scan = Some(Scan { started: crate::now_ms() });
+        drop(state);
+        cfg::scan_started(self);
+        crate::wake();
+        Ok(())
+    }
+
+    pub(crate) fn abort_scan(&self) -> Result<(), i32> {
+        let state = self.state.lock();
+        if state.scan.is_none() {
+            return Err(ENOENT);
+        }
+        self.radio.abort_scan();
+        Ok(())
+    }
+
+    /// The networks heard, the list's generation, and the one linked to.
+    pub(crate) fn networks(&self) -> (Vec<Bss>, u32, Option<(Address, bool)>) {
+        let state = self.state.lock();
+        let now = crate::now_ms();
+        let current = match &state.link {
+            Link::Associated { bss } => Some((bss.bssid, true)),
+            Link::Authenticated { bss, .. } | Link::Associating { bss, .. } => Some((bss.bssid, false)),
+            _ => None,
+        };
+        let list = state
+            .networks
+            .values()
+            .filter(|bss| current.is_some_and(|(bssid, _)| bssid == bss.bssid) || now < bss.seen + BSS_EXPIRE_MS)
+            .cloned()
+            .collect();
+        (list, state.generation, current)
+    }
+
+    pub(crate) fn link_info(&self) -> Option<LinkInfo> {
+        let state = self.state.lock();
+        let bss = state.link.bss()?;
+        Some(LinkInfo {
+            freq: bss.freq,
+            ssid: bss.ssid().to_vec(),
+            associated: matches!(state.link, Link::Associated { .. }),
+        })
+    }
+
+    pub(crate) fn authenticate(&self, request: AuthRequest) -> Result<(), i32> {
+        let mut state = self.state.lock();
+        if !state.up {
+            return Err(ENETDOWN);
+        }
+        // SAE takes several frames: the next one of an exchange in
+        // progress goes out on the link as it is.
+        if let Link::Authenticating { bss, algorithm, frame, deadline, .. } = &mut state.link
+            && bss.bssid == request.bssid
+            && *algorithm == request.algorithm
+            && request.algorithm == ALGORITHM_SAE
+        {
+            *frame = self.auth_frame(&request);
+            *deadline = crate::now_ms() + SAE_TIMEOUT_MS;
+            return self.radio.send_management(frame).map_err(radio::Error::errno);
+        }
+        let Some(bss) = state.networks.get(&request.bssid).cloned() else {
+            return Err(ENOENT);
+        };
+        if let Some(current) = state.link.bss().cloned() {
+            // Another network (or the same one again): leave first.
+            if matches!(state.link, Link::Associated { .. }) {
+                let frame = wifi::deauth(&current.bssid, &self.info.address, &current.bssid, wifi::REASON_DEAUTH_LEAVING, false);
+                let _ = self.radio.send_management(&frame);
+                self.disconnect(&mut state);
+                cfg::mlme_frame(self, cfg::Mlme::Deauthenticate, &frame, None);
+            } else {
+                self.disconnect(&mut state);
+            }
+        }
+        if state.scan.is_some() {
+            self.radio.abort_scan();
+        }
+        self.radio.join(&bss.join()).map_err(|error| {
+            ostd::warn!("{}: the radio did not tune to {}: {:?}", self.name, crate::Mac(&bss.bssid), error);
+            error.errno()
+        })?;
+        let frame = self.auth_frame(&request);
+        ostd::info!(
+            "{}: authenticating with {} ({} MHz, algorithm {})",
+            self.name,
+            crate::Mac(&bss.bssid),
+            bss.freq,
+            request.algorithm
+        );
+        if let Err(error) = self.radio.send_management(&frame) {
+            self.radio.leave();
+            return Err(error.errno());
+        }
+        *self.bssid.lock() = bss.bssid;
+        let timeout = if request.algorithm == ALGORITHM_SAE { SAE_TIMEOUT_MS } else { MLME_TIMEOUT_MS };
+        state.link = Link::Authenticating {
+            bss,
+            algorithm: request.algorithm,
+            frame,
+            tries: 1,
+            deadline: crate::now_ms() + timeout,
+        };
+        drop(state);
+        crate::wake();
+        Ok(())
+    }
+
+    fn auth_frame(&self, request: &AuthRequest) -> Vec<u8> {
+        let mut fields = Vec::with_capacity(4 + request.data.len() + request.elements.len());
+        if request.data.len() >= 4 {
+            fields.extend_from_slice(&request.data);
+        } else {
+            // Transaction 1, status 0.
+            fields.extend_from_slice(&[1, 0, 0, 0]);
+        }
+        fields.extend_from_slice(&request.elements);
+        wifi::auth(&request.bssid, &self.info.address, request.algorithm, &fields)
+    }
+
+    pub(crate) fn associate(&self, request: AssocRequest) -> Result<(), i32> {
+        let mut state = self.state.lock();
+        if !state.up {
+            return Err(ENETDOWN);
+        }
+        let Link::Authenticated { bss, .. } = &state.link else {
+            return Err(ENOTCONN);
+        };
+        if bss.bssid != request.bssid {
+            return Err(ENOTCONN);
+        }
+        let bss = bss.clone();
+        let frame = self.assoc_frame(&bss, &request);
+        self.associating.store(true, Ordering::Release);
+        if let Err(error) = self.radio.send_management(&frame) {
+            self.associating.store(false, Ordering::Release);
+            return Err(error.errno());
+        }
+        state.link = Link::Associating { bss, frame, tries: 1, deadline: crate::now_ms() + MLME_TIMEOUT_MS, request };
+        drop(state);
+        crate::wake();
+        Ok(())
+    }
+
+    fn assoc_frame(&self, bss: &Bss, request: &AssocRequest) -> Vec<u8> {
+        let theirs = wifi::Elements(&bss.elements);
+        let Some((band, _)) = self.info.channel(bss.freq) else {
+            return Vec::new();
+        };
+        let mut capability = wifi::CAP_ESS;
+        if band.id == BandId::Ghz2 {
+            capability |= wifi::CAP_SHORT_PREAMBLE;
+        }
+        if band.id != BandId::Ghz2 || bss.capability & wifi::CAP_SHORT_SLOT != 0 {
+            capability |= wifi::CAP_SHORT_SLOT;
+        }
+        if bss.capability & wifi::CAP_PRIVACY != 0 {
+            capability |= wifi::CAP_PRIVACY;
+        }
+        let mut elements = Vec::with_capacity(256);
+        wifi::put_element(&mut elements, wifi::IE_SSID, bss.ssid());
+        wifi::put_rates(&mut elements, band.id.rates());
+        elements.extend_from_slice(&request.elements);
+        // 802.11n and later need QoS (WMM) and a cipher of their time.
+        let wmm = theirs.vendor(wifi::WMM_OUI_TYPE).is_some();
+        let modern = wmm && !request.legacy_cipher;
+        let has = |id: u8| wifi::Elements(&request.elements).get(id).is_some();
+        if modern && band.id != BandId::Ghz6 && theirs.get(wifi::IE_HT_CAP).is_some() && !has(wifi::IE_HT_CAP) {
+            if let Some(ht) = &band.ht {
+                wifi::put_element(&mut elements, wifi::IE_HT_CAP, &ht.element());
+            }
+        }
+        if modern && band.id == BandId::Ghz5 && theirs.get(wifi::IE_VHT_CAP).is_some() && !has(wifi::IE_VHT_CAP) {
+            if let Some(vht) = &band.vht {
+                wifi::put_element(&mut elements, wifi::IE_VHT_CAP, &vht.element());
+            }
+        }
+        if modern && theirs.extension(wifi::EXT_HE_CAP).is_some() {
+            if let Some(he) = &band.he {
+                let mut value = alloc::vec![wifi::EXT_HE_CAP];
+                value.extend_from_slice(&he.element());
+                wifi::put_element(&mut elements, wifi::IE_EXTENSION, &value);
+            }
+        }
+        if wmm {
+            // The WMM information element: version 1, no power save.
+            wifi::put_element(&mut elements, wifi::IE_VENDOR, &[0x00, 0x50, 0xf2, 0x02, 0x00, 0x01, 0x00]);
+        }
+        let elements = wifi::order_elements(&elements);
+        wifi::assoc_request(&bss.bssid, &self.info.address, capability, 10, request.previous.as_ref(), &elements)
+    }
+
+    /// Leaves the network `bssid` (a deauthentication, or a
+    /// disassociation), telling it unless `silent`.
+    pub(crate) fn leave(&self, bssid: &Address, reason: u16, disassoc: bool, silent: bool) -> Result<(), i32> {
+        let mut state = self.state.lock();
+        let Some(bss) = state.link.bss() else {
+            return if disassoc { Err(ENOTCONN) } else { Ok(()) };
+        };
+        if bss.bssid != *bssid {
+            return if disassoc { Err(ENOTCONN) } else { Ok(()) };
+        }
+        let frame = wifi::deauth(bssid, &self.info.address, bssid, reason, disassoc);
+        if !silent {
+            let _ = self.radio.send_management(&frame);
+        }
+        ostd::notice!("{}: left {} (reason {})", self.name, crate::Mac(bssid), reason);
+        self.disconnect(&mut state);
+        drop(state);
+        let command = if disassoc { cfg::Mlme::Disassociate } else { cfg::Mlme::Deauthenticate };
+        cfg::mlme_frame(self, command, &frame, None);
+        Ok(())
+    }
+
+    pub(crate) fn set_key(&self, key: Key) -> Result<(), i32> {
+        let mut state = self.state.lock();
+        if !state.up {
+            return Err(ENETDOWN);
+        }
+        if state.link.bss().is_none() {
+            return Err(ENOLINK);
+        }
+        if !self.info.ciphers.contains(&key.cipher) {
+            return Err(EINVAL);
+        }
+        self.radio.set_key(&key).map_err(|error| {
+            ostd::warn!("{}: the radio did not take the key: {:?}", self.name, error);
+            error.errno()
+        })?;
+        state.keys.retain(|(index, pairwise, _)| !(*index == key.index && *pairwise == key.pairwise));
+        state.keys.push((key.index, key.pairwise, key.cipher));
+        if key.pairwise {
+            self.encrypted.store(true, Ordering::Release);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn remove_key(&self, index: u8, pairwise: bool) -> Result<(), i32> {
+        let mut state = self.state.lock();
+        let before = state.keys.len();
+        state.keys.retain(|(found, found_pairwise, _)| !(*found == index && *found_pairwise == pairwise));
+        if state.keys.len() == before {
+            return Err(ENOENT);
+        }
+        self.radio.remove_key(index, pairwise);
+        if pairwise {
+            self.encrypted.store(false, Ordering::Release);
+        }
+        Ok(())
+    }
+
+    /// The supplicant has the keys in place (or the network has none):
+    /// data flows.
+    pub(crate) fn authorize(&self, bssid: &Address, authorized: bool) -> Result<(), i32> {
+        let state = self.state.lock();
+        let Link::Associated { bss } = &state.link else {
+            return Err(ENOENT);
+        };
+        if bss.bssid != *bssid {
+            return Err(ENOENT);
+        }
+        self.radio.authorize(authorized);
+        let new = if authorized { LINK_AUTHORIZED } else { LINK_ASSOCIATED };
+        let old = self.link.swap(new, Ordering::AcqRel);
+        drop(state);
+        if old != new {
+            if authorized {
+                ostd::notice!("{}: connected", self.name);
+            }
+            crate::link_changed(&self.name, authorized);
+        }
+        Ok(())
+    }
+
+    /// A frame of the supplicant's (EAPOL) to `destination`.
+    pub(crate) fn control_port_send(&self, destination: &Address, ethertype: u16, payload: &[u8], plain: bool) -> Result<(), i32> {
+        let state = self.state.lock();
+        if !matches!(state.link, Link::Associated { .. }) {
+            return Err(ENOLINK);
+        }
+        let mut ethernet = Vec::with_capacity(14 + payload.len());
+        ethernet.extend_from_slice(destination);
+        ethernet.extend_from_slice(&self.info.address);
+        ethernet.extend_from_slice(&ethertype.to_be_bytes());
+        ethernet.extend_from_slice(payload);
+        let plain = plain || !self.encrypted.load(Ordering::Acquire);
+        self.radio.send(&ethernet, plain).map_err(radio::Error::errno)
+    }
+
+    pub(crate) fn link_stats(&self) -> Option<(Address, radio::LinkStats)> {
+        let state = self.state.lock();
+        let Link::Associated { bss } = &state.link else { return None };
+        let mut stats = self.radio.link_stats();
+        if stats.signal.is_none() {
+            stats.signal = state.networks.get(&bss.bssid).map(|heard| heard.signal);
+        }
+        Some((bss.bssid, stats))
+    }
+
+    /// The socket bound to `port` closed: a link it owned ends with it.
+    pub(crate) fn released(&self, port: u32) {
+        let mut state = self.state.lock();
+        if state.owner != Some(port) {
+            return;
+        }
+        if let Some(bss) = state.link.bss().cloned() {
+            ostd::notice!("{}: the supplicant went away, leaving {}", self.name, crate::Mac(&bss.bssid));
+            let frame = wifi::deauth(&bss.bssid, &self.info.address, &bss.bssid, wifi::REASON_DEAUTH_LEAVING, false);
+            let _ = self.radio.send_management(&frame);
+            self.disconnect(&mut state);
+        }
+    }
+
+    /// Whether data flows: the link is made and its keys are in place.
+    pub fn connected(&self) -> bool {
+        self.link.load(Ordering::Acquire) == LINK_AUTHORIZED
+    }
+}
