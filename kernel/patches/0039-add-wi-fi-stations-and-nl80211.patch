+// SPDX-License-Identifier: MPL-2.0
+
+use crate::{
+    net::socket::netlink::{addr::PortNum, receiver::QueueableMessage, table::MulticastMessage},
+    prelude::*,
+    util::MultiWrite,
+};
+
+/// A generic netlink message as the family that wrote it left it: one
+/// netlink message, header included.
+#[derive(Clone, Debug)]
+pub(crate) struct GenlMessage {
+    bytes: Arc<[u8]>,
+}
+
+impl GenlMessage {
+    pub(super) fn new(bytes: Vec<u8>) -> Self {
+        Self { bytes: bytes.into() }
+    }
+
+    /// Writes the message to `writer`, cut to what it holds.
+    pub(super) fn write_to(&self, writer: &mut dyn MultiWrite) -> Result<()> {
+        let _ = writer.write(&mut VmReader::from(&*self.bytes))?;
+        Ok(())
+    }
+}
+
+impl QueueableMessage for GenlMessage {
+    // A dump of the networks a scan heard is a few hundred messages.
+    const BUFFER_SIZE: usize = 1024 * 1024;
+
+    fn total_len(&self) -> usize {
+        self.bytes.len()
+    }
+
+    fn released(port: PortNum) {
+        aster_wlan::genl::released(port);
+    }
+}
+
+impl MulticastMessage for GenlMessage {}
