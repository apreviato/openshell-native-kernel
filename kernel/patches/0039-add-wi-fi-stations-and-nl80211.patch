+// SPDX-License-Identifier: MPL-2.0
+
+//! Generic netlink: the controller family (`nlctrl`), which tells programs
+//! the number of each family and of its multicast groups, and the dispatch
+//! of each request to its family. The kernel's `NETLINK_GENERIC` sockets
+//! hand the bytes programs write to [`request`] and deliver what [`Sink`]
+//! is given.
+
+use alloc::vec::Vec;
+
+use spin::Once;
+
+use crate::nl::{self, Attrs, Header, Message, Request};
+
+/// `nlctrl`'s family number, fixed (Linux's `GENL_ID_CTRL`).
+pub const FAMILY_CTRL: u16 = 0x10;
+/// nl80211's: the first number after the reserved ones.
+pub const FAMILY_NL80211: u16 = 0x14;
+
+const CTRL_CMD_NEWFAMILY: u32 = 1;
+const CTRL_CMD_GETFAMILY: u32 = 3;
+
+const CTRL_ATTR_FAMILY_ID: u32 = 1;
+const CTRL_ATTR_FAMILY_NAME: u32 = 2;
+const CTRL_ATTR_VERSION: u32 = 3;
+const CTRL_ATTR_HDRSIZE: u32 = 4;
+const CTRL_ATTR_MAXATTR: u32 = 5;
+const CTRL_ATTR_OPS: u32 = 6;
+const CTRL_ATTR_MCAST_GROUPS: u32 = 7;
+const CTRL_ATTR_OP_ID: u32 = 1;
+const CTRL_ATTR_OP_FLAGS: u32 = 2;
+const CTRL_ATTR_MCAST_GRP_NAME: u32 = 1;
+const CTRL_ATTR_MCAST_GRP_ID: u32 = 2;
+/// The operation has a `doit` handler.
+const GENL_CMD_CAP_DO: u32 = 0x02;
+const GENL_CMD_CAP_DUMP: u32 = 0x04;
+
+pub const ENOENT: i32 = 2;
+pub const EOPNOTSUPP: i32 = 95;
+pub const EPERM: i32 = 1;
+
+/// A family as the controller describes it.
+pub struct Family {
+    pub id: u16,
+    pub name: &'static str,
+    pub version: u8,
+    pub max_attr: u32,
+    /// Its commands that take requests.
+    pub commands: &'static [u32],
+    /// Its multicast groups: name and number (the bit, from 1, of a
+    /// socket's group mask).
+    pub groups: &'static [(&'static str, u32)],
+}
+
+/// `nlctrl`'s own group, the number Linux gives it.
+const CTRL_GROUPS: [(&str, u32); 1] = [("notify", 0x10)];
+
+static CTRL: Family = Family {
+    id: FAMILY_CTRL,
+    name: "nlctrl",
+    version: 2,
+    max_attr: 10,
+    commands: &[CTRL_CMD_GETFAMILY],
+    groups: &CTRL_GROUPS,
+};
+
+fn families() -> [&'static Family; 2] {
+    [&CTRL, &crate::cfg::FAMILY]
+}
+
+/// Where the kernel's sockets take messages to programs.
+#[derive(Clone, Copy)]
+pub struct Sink {
+    /// To the socket bound to a port.
+    pub unicast: fn(port: u32, message: Vec<u8>),
+    /// To the sockets in a multicast group.
+    pub multicast: fn(group: u32, message: Vec<u8>),
+}
+
+static SINK: Once<Sink> = Once::new();
+
+pub fn set_sink(sink: Sink) {
+    SINK.call_once(|| sink);
+}
+
+pub(crate) fn unicast(port: u32, message: Vec<u8>) {
+    if let Some(sink) = SINK.get() {
+        (sink.unicast)(port, message);
+    }
+}
+
+pub(crate) fn multicast(group: u32, message: Vec<u8>) {
+    if let Some(sink) = SINK.get() {
+        (sink.multicast)(group, message);
+    }
+}
+
+/// What a family answers a request with.
+pub(crate) enum Reply {
+    /// Messages, then the acknowledgement if the request asked for one
+    /// (or the end of the dump).
+    Messages(Vec<Vec<u8>>),
+    /// An error number.
+    Error(i32),
+}
+
+fn describe(family: &Family, request: &Header) -> Vec<u8> {
+    let mut message = Message::reply(request, CTRL_CMD_NEWFAMILY, CTRL.version);
+    message
+        .str(CTRL_ATTR_FAMILY_NAME, family.name)
+        .u16(CTRL_ATTR_FAMILY_ID, family.id)
+        .u32(CTRL_ATTR_VERSION, family.version as u32)
+        .u32(CTRL_ATTR_HDRSIZE, 0)
+        .u32(CTRL_ATTR_MAXATTR, family.max_attr);
+    message.nest(CTRL_ATTR_OPS, |message| {
+        for (index, command) in family.commands.iter().enumerate() {
+            message.nest(index as u32 + 1, |message| {
+                message.u32(CTRL_ATTR_OP_ID, *command).u32(CTRL_ATTR_OP_FLAGS, GENL_CMD_CAP_DO | GENL_CMD_CAP_DUMP);
+            });
+        }
+    });
+    message.nest(CTRL_ATTR_MCAST_GROUPS, |message| {
+        for (index, (name, id)) in family.groups.iter().enumerate() {
+            message.nest(index as u32 + 1, |message| {
+                message.u32(CTRL_ATTR_MCAST_GRP_ID, *id).str(CTRL_ATTR_MCAST_GRP_NAME, name);
+            });
+        }
+    });
+    message.finish()
+}
+
+fn control(request: &Request) -> Reply {
+    if request.command as u32 != CTRL_CMD_GETFAMILY {
+        return Reply::Error(EOPNOTSUPP);
+    }
+    if request.header.dump() {
+        return Reply::Messages(families().iter().map(|family| describe(family, &request.header)).collect());
+    }
+    let attrs: Attrs = request.attrs;
+    let wanted = families().into_iter().find(|family| match (attrs.u16(CTRL_ATTR_FAMILY_ID), attrs.str(CTRL_ATTR_FAMILY_NAME)) {
+        (Some(id), _) => family.id == id,
+        (None, Some(name)) => family.name.as_bytes() == name,
+        (None, None) => false,
+    });
+    match wanted {
+        Some(family) => Reply::Messages(alloc::vec![describe(family, &request.header)]),
+        None => Reply::Error(ENOENT),
+    }
+}
+
+/// Serves what a program wrote to its socket bound to `port`: each request
+/// in it, with the answers back to that port. `privileged`: the program
+/// administers the network (Linux's `CAP_NET_ADMIN`), which the requests
+/// that change something need.
+pub fn request(port: u32, privileged: bool, bytes: &[u8]) {
+    for (mut header, payload) in nl::messages(bytes) {
+        if header.kind < nl::NLMSG_MIN_TYPE {
+            continue;
+        }
+        if header.port == 0 {
+            header.port = port;
+        }
+        let reply = match Request::parse(header, payload) {
+            None => Reply::Error(22),
+            Some(request) => match header.kind {
+                FAMILY_CTRL => control(&request),
+                FAMILY_NL80211 => crate::cfg::request(port, privileged, &request),
+                _ => Reply::Error(ENOENT),
+            },
+        };
+        match reply {
+            Reply::Error(errno) => unicast(port, nl::error(&header, errno)),
+            Reply::Messages(messages) => {
+                for message in messages {
+                    unicast(port, message);
+                }
+                if header.dump() {
+                    unicast(port, nl::done(&header));
+                } else if header.flags & nl::NLM_F_ACK != 0 {
+                    unicast(port, nl::error(&header, 0));
+                }
+            }
+        }
+    }
+}
+
+/// The socket bound to `port` closed.
+pub fn released(port: u32) {
+    crate::cfg::released(port);
+}
diff --git a/kernel/comps/wlan/src/ieee80211.rs b/kernel/comps/wlan/src/ieee80211.rs
new file mode 100755
index 0000000..55dd700
--- /dev/null
+++ b/kernel/comps/wlan/src/ieee80211.rs
@@ -0,0 +1,462 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! 802.11 frames: the management frames a station sends and reads, the
+//! elements inside them, and data frames to and from Ethernet's framing.
+
+use alloc::vec::Vec;
+
+pub type Address = [u8; 6];
+
+pub const BROADCAST: Address = [0xff; 6];
+
+/// The first byte of the frame control field: type and subtype.
+pub const ASSOC_REQUEST: u8 = 0x00;
+pub const ASSOC_RESPONSE: u8 = 0x10;
+pub const REASSOC_REQUEST: u8 = 0x20;
+pub const REASSOC_RESPONSE: u8 = 0x30;
+pub const PROBE_REQUEST: u8 = 0x40;
+pub const PROBE_RESPONSE: u8 = 0x50;
+pub const BEACON: u8 = 0x80;
+pub const DISASSOC: u8 = 0xa0;
+pub const AUTH: u8 = 0xb0;
+pub const DEAUTH: u8 = 0xc0;
+pub const ACTION: u8 = 0xd0;
+pub const DATA: u8 = 0x08;
+pub const QOS_DATA: u8 = 0x88;
+pub const NULL_DATA: u8 = 0x48;
+
+/// The second byte of the frame control field.
+pub const TO_DS: u8 = 0x01;
+pub const FROM_DS: u8 = 0x02;
+pub const MORE_FRAGMENTS: u8 = 0x04;
+pub const PROTECTED: u8 = 0x40;
+pub const ORDER: u8 = 0x80;
+
+/// A management frame's header, and a data frame's between a station and
+/// its access point.
+pub const HEADER: usize = 24;
+
+/// Capability bits.
+pub const CAP_ESS: u16 = 1 << 0;
+pub const CAP_IBSS: u16 = 1 << 1;
+pub const CAP_PRIVACY: u16 = 1 << 4;
+pub const CAP_SHORT_PREAMBLE: u16 = 1 << 5;
+pub const CAP_SPECTRUM_MGMT: u16 = 1 << 8;
+pub const CAP_SHORT_SLOT: u16 = 1 << 10;
+pub const CAP_RADIO_MEASURE: u16 = 1 << 12;
+
+/// Element IDs.
+pub const IE_SSID: u8 = 0;
+pub const IE_RATES: u8 = 1;
+pub const IE_DS_PARAMS: u8 = 3;
+pub const IE_HT_CAP: u8 = 45;
+pub const IE_RSN: u8 = 48;
+pub const IE_EXT_RATES: u8 = 50;
+pub const IE_HT_OPERATION: u8 = 61;
+pub const IE_EXT_CAPABILITY: u8 = 127;
+pub const IE_VHT_CAP: u8 = 191;
+pub const IE_VHT_OPERATION: u8 = 192;
+pub const IE_VENDOR: u8 = 221;
+pub const IE_RSNX: u8 = 244;
+pub const IE_EXTENSION: u8 = 255;
+/// Extension element IDs (the byte after `IE_EXTENSION`'s length).
+pub const EXT_HE_CAP: u8 = 35;
+pub const EXT_HE_OPERATION: u8 = 36;
+
+/// Microsoft's OUI and the type of its WMM element.
+pub const WMM_OUI_TYPE: [u8; 4] = [0x00, 0x50, 0xf2, 0x02];
+
+pub const ETHERTYPE_EAPOL: u16 = 0x888e;
+/// Pre-authentication frames (RSN), which belong to the supplicant as well.
+pub const ETHERTYPE_PREAUTH: u16 = 0x88c7;
+
+/// Reason codes of the frames a station sends to leave.
+pub const REASON_UNSPECIFIED: u16 = 1;
+pub const REASON_DEAUTH_LEAVING: u16 = 3;
+pub const REASON_DISASSOC_INACTIVITY: u16 = 4;
+
+/// The LLC/SNAP header before an EtherType (RFC 1042), and the one bridges
+/// use for AppleTalk ARP and IPX (802.1H).
+const RFC1042: [u8; 6] = [0xaa, 0xaa, 0x03, 0x00, 0x00, 0x00];
+const BRIDGE_TUNNEL: [u8; 6] = [0xaa, 0xaa, 0x03, 0x00, 0x00, 0xf8];
+const ETHERTYPE_AARP: u16 = 0x80f3;
+const ETHERTYPE_IPX: u16 = 0x8137;
+
+pub fn is_multicast(address: &Address) -> bool {
+    address[0] & 1 != 0
+}
+
+/// The channel number of a frequency in MHz, in the 2.4, 5 or 6 GHz band.
+pub fn channel_of(freq: u16) -> Option<u8> {
+    match freq {
+        2484 => Some(14),
+        2412..=2472 if (freq - 2407) % 5 == 0 => Some(((freq - 2407) / 5) as u8),
+        5935 => Some(2),
+        5955..=7115 if (freq - 5950) % 5 == 0 => Some(((freq - 5950) / 5) as u8),
+        5160..=5885 if freq % 5 == 0 => Some(((freq - 5000) / 5) as u8),
+        _ => None,
+    }
+}
+
+/// A frame's kind (the first byte of its frame control), if it has a header.
+pub fn kind(frame: &[u8]) -> Option<u8> {
+    (frame.len() >= HEADER).then(|| frame[0] & 0xfc)
+}
+
+pub fn is_management(frame: &[u8]) -> bool {
+    frame.first().is_some_and(|first| first & 0x0c == 0x00)
+}
+
+pub fn is_data(frame: &[u8]) -> bool {
+    frame.first().is_some_and(|first| first & 0x0c == 0x08)
+}
+
+fn address(frame: &[u8], index: usize) -> Address {
+    let start = 4 + 6 * index;
+    frame[start..start + 6].try_into().unwrap()
+}
+
+/// The addresses of a frame with a header: receiver, transmitter and the
+/// third one (the BSSID in management frames).
+pub fn addresses(frame: &[u8]) -> Option<(Address, Address, Address)> {
+    (frame.len() >= HEADER).then(|| (address(frame, 0), address(frame, 1), address(frame, 2)))
+}
+
+/// The elements of a frame's body: each ID and value. An extension
+/// element's value starts with its extension ID.
+#[derive(Clone, Copy, Debug)]
+pub struct Elements<'a>(pub &'a [u8]);
+
+impl<'a> Elements<'a> {
+    pub fn iter(&self) -> impl Iterator<Item = (u8, &'a [u8])> + use<'a> {
+        let mut rest = self.0;
+        core::iter::from_fn(move || {
+            let (&id, after) = rest.split_first()?;
+            let (&length, after) = after.split_first()?;
+            let value = after.get(..length as usize)?;
+            rest = &after[length as usize..];
+            Some((id, value))
+        })
+    }
+
+    pub fn get(&self, id: u8) -> Option<&'a [u8]> {
+        self.iter().find(|(found, _)| *found == id).map(|(_, value)| value)
+    }
+
+    /// An extension element's value, after its extension ID.
+    pub fn extension(&self, ext: u8) -> Option<&'a [u8]> {
+        self.iter()
+            .find(|(id, value)| *id == IE_EXTENSION && value.first() == Some(&ext))
+            .map(|(_, value)| &value[1..])
+    }
+
+    /// A vendor element's value, after its OUI and type.
+    pub fn vendor(&self, oui_type: [u8; 4]) -> Option<&'a [u8]> {
+        self.iter()
+            .find(|(id, value)| *id == IE_VENDOR && value.starts_with(&oui_type))
+            .map(|(_, value)| &value[4..])
+    }
+}
+
+/// Appends an element. Values longer than an element holds are cut.
+pub fn put_element(out: &mut Vec<u8>, id: u8, value: &[u8]) {
+    let value = &value[..value.len().min(255)];
+    out.push(id);
+    out.push(value.len() as u8);
+    out.extend_from_slice(value);
+}
+
+/// What a beacon or probe response says of its network.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Beacon<'a> {
+    pub bssid: Address,
+    pub timestamp: u64,
+    pub interval: u16,
+    pub capability: u16,
+    pub elements: &'a [u8],
+    /// A probe response, rather than a beacon.
+    pub probe_response: bool,
+}
+
+pub fn parse_beacon(frame: &[u8]) -> Option<Beacon<'_>> {
+    let probe_response = match kind(frame)? {
+        BEACON => false,
+        PROBE_RESPONSE => true,
+        _ => return None,
+    };
+    let body = frame.get(HEADER..)?;
+    if body.len() < 12 {
+        return None;
+    }
+    Some(Beacon {
+        bssid: address(frame, 2),
+        timestamp: u64::from_le_bytes(body[0..8].try_into().ok()?),
+        interval: u16::from_le_bytes([body[8], body[9]]),
+        capability: u16::from_le_bytes([body[10], body[11]]),
+        elements: &body[12..],
+        probe_response,
+    })
+}
+
+fn header(kind: u8, to: &Address, from: &Address, bssid: &Address) -> Vec<u8> {
+    let mut frame = Vec::with_capacity(128);
+    frame.extend_from_slice(&[kind, 0, 0, 0]);
+    frame.extend_from_slice(to);
+    frame.extend_from_slice(from);
+    frame.extend_from_slice(bssid);
+    // The sequence number is the radio's to assign.
+    frame.extend_from_slice(&[0, 0]);
+    frame
+}
+
+/// A probe request for `ssid` (empty: any network).
+pub fn probe_request(own: &Address, ssid: &[u8], rates: &[u8], extra: &[u8]) -> Vec<u8> {
+    let mut frame = header(PROBE_REQUEST, &BROADCAST, own, &BROADCAST);
+    put_element(&mut frame, IE_SSID, ssid);
+    put_rates(&mut frame, rates);
+    frame.extend_from_slice(extra);
+    frame
+}
+
+/// Supported rates (units of 500 kbit/s; the highest bit marks a basic
+/// rate): the first eight in one element, the others in the extended one.
+pub fn put_rates(out: &mut Vec<u8>, rates: &[u8]) {
+    let (first, more) = rates.split_at(rates.len().min(8));
+    put_element(out, IE_RATES, first);
+    if !more.is_empty() {
+        put_element(out, IE_EXT_RATES, more);
+    }
+}
+
+/// An authentication frame: `fields` are the ones after the algorithm
+/// (transaction, status, and what the algorithm adds).
+pub fn auth(bssid: &Address, own: &Address, algorithm: u16, fields: &[u8]) -> Vec<u8> {
+    let mut frame = header(AUTH, bssid, own, bssid);
+    frame.extend_from_slice(&algorithm.to_le_bytes());
+    frame.extend_from_slice(fields);
+    frame
+}
+
+/// What an authentication frame carries: algorithm, transaction, status.
+pub fn parse_auth(frame: &[u8]) -> Option<(u16, u16, u16)> {
+    if kind(frame)? != AUTH {
+        return None;
+    }
+    let body = frame.get(HEADER..HEADER + 6)?;
+    let field = |at: usize| u16::from_le_bytes([body[at], body[at + 1]]);
+    Some((field(0), field(2), field(4)))
+}
+
+/// A deauthentication (or disassociation) frame.
+pub fn deauth(to: &Address, from: &Address, bssid: &Address, reason: u16, disassoc: bool) -> Vec<u8> {
+    let mut frame = header(if disassoc { DISASSOC } else { DEAUTH }, to, from, bssid);
+    frame.extend_from_slice(&reason.to_le_bytes());
+    frame
+}
+
+/// The reason of a deauthentication or disassociation frame.
+pub fn parse_deauth(frame: &[u8]) -> Option<u16> {
+    if !matches!(kind(frame)?, DEAUTH | DISASSOC) {
+        return None;
+    }
+    let body = frame.get(HEADER..HEADER + 2)?;
+    Some(u16::from_le_bytes([body[0], body[1]]))
+}
+
+/// An association request (a reassociation one after `previous`): its
+/// fixed fields, then `elements`, already in order.
+pub fn assoc_request(
+    bssid: &Address,
+    own: &Address,
+    capability: u16,
+    listen_interval: u16,
+    previous: Option<&Address>,
+    elements: &[u8],
+) -> Vec<u8> {
+    let kind = if previous.is_some() { REASSOC_REQUEST } else { ASSOC_REQUEST };
+    let mut frame = header(kind, bssid, own, bssid);
+    frame.extend_from_slice(&capability.to_le_bytes());
+    frame.extend_from_slice(&listen_interval.to_le_bytes());
+    if let Some(previous) = previous {
+        frame.extend_from_slice(previous);
+    }
+    frame.extend_from_slice(elements);
+    frame
+}
+
+/// The offset of an association request's elements.
+pub fn assoc_request_elements(frame: &[u8]) -> &[u8] {
+    let fixed = if kind(frame) == Some(REASSOC_REQUEST) { 10 } else { 4 };
+    frame.get(HEADER + fixed..).unwrap_or(&[])
+}
+
+/// An association response: capability, status, association ID, elements.
+pub fn parse_assoc_response(frame: &[u8]) -> Option<(u16, u16, u16, &[u8])> {
+    if !matches!(kind(frame)?, ASSOC_RESPONSE | REASSOC_RESPONSE) {
+        return None;
+    }
+    let body = frame.get(HEADER..)?;
+    if body.len() < 6 {
+        return None;
+    }
+    let field = |at: usize| u16::from_le_bytes([body[at], body[at + 1]]);
+    // The two highest bits of the ID field are always set.
+    Some((field(0), field(2), field(4) & 0x3fff, &body[6..]))
+}
+
+/// The order the standard gives the elements of an association request
+/// (the ones a station sends). Elements it does not list go before the
+/// vendor ones, in the order given.
+fn element_rank(id: u8, value: &[u8]) -> u16 {
+    const ORDER: [u8; 20] = [0, 1, 50, 33, 36, 48, 46, 70, 54, 59, 45, 72, 127, 110, 107, 191, 199, 148, 240, 244];
+    if let Some(rank) = ORDER.iter().position(|listed| *listed == id) {
+        return rank as u16;
+    }
+    match id {
+        IE_VENDOR => 1000,
+        IE_EXTENSION => 500 + value.first().copied().unwrap_or(0) as u16,
+        _ => 400,
+    }
+}
+
+/// Puts elements in an association request's order (a stable sort: equal
+/// ranks keep the order given).
+pub fn order_elements(elements: &[u8]) -> Vec<u8> {
+    let mut list: Vec<(u8, &[u8])> = Elements(elements).iter().collect();
+    list.sort_by_key(|(id, value)| element_rank(*id, value));
+    let mut out = Vec::with_capacity(elements.len());
+    for (id, value) in list {
+        put_element(&mut out, id, value);
+    }
+    out
+}
+
+/// An Ethernet frame as an 802.11 data frame to the access point `bssid`,
+/// with the priority `tid` when the network has QoS (WMM).
+pub fn data_from_ethernet(ethernet: &[u8], bssid: &Address, tid: Option<u8>, protected: bool) -> Option<Vec<u8>> {
+    if ethernet.len() < 14 {
+        return None;
+    }
+    let (destination, source) = (&ethernet[0..6], &ethernet[6..12]);
+    let ethertype = u16::from_be_bytes([ethernet[12], ethernet[13]]);
+    let mut frame = Vec::with_capacity(ethernet.len() + 22);
+    let flags = TO_DS | if protected { PROTECTED } else { 0 };
+    frame.extend_from_slice(&[if tid.is_some() { QOS_DATA } else { DATA }, flags, 0, 0]);
+    frame.extend_from_slice(bssid);
+    frame.extend_from_slice(source);
+    frame.extend_from_slice(destination);
+    frame.extend_from_slice(&[0, 0]);
+    if let Some(tid) = tid {
+        frame.extend_from_slice(&[tid & 0x0f, 0]);
+    }
+    if ethertype >= 0x0600 {
+        let snap = if matches!(ethertype, ETHERTYPE_AARP | ETHERTYPE_IPX) { BRIDGE_TUNNEL } else { RFC1042 };
+        frame.extend_from_slice(&snap);
+        frame.extend_from_slice(&ethernet[12..]);
+    } else {
+        // An 802.3 length: what follows already has its LLC header.
+        frame.extend_from_slice(&ethernet[14..]);
+    }
+    Some(frame)
+}
+
+/// The priority (TID) of an Ethernet frame: its IP header's precedence,
+/// and voice for the frames that authenticate the link.
+pub fn tid_of(ethernet: &[u8]) -> u8 {
+    if ethernet.len() < 16 {
+        return 0;
+    }
+    match u16::from_be_bytes([ethernet[12], ethernet[13]]) {
+        0x0800 => ethernet[15] >> 5,
+        0x86dd => (ethernet[14] & 0x0f) >> 1,
+        ETHERTYPE_EAPOL => 7,
+        _ => 0,
+    }
+}
+
+fn ethernet_from_llc(destination: &[u8], source: &[u8], payload: &[u8]) -> Vec<u8> {
+    let mut frame = Vec::with_capacity(payload.len() + 14);
+    frame.extend_from_slice(destination);
+    frame.extend_from_slice(source);
+    let snap = payload.len() >= 8 && {
+        let ethertype = u16::from_be_bytes([payload[6], payload[7]]);
+        (payload[..6] == RFC1042 && !matches!(ethertype, ETHERTYPE_AARP | ETHERTYPE_IPX)) || payload[..6] == BRIDGE_TUNNEL
+    };
+    if snap {
+        frame.extend_from_slice(&payload[6..]);
+    } else {
+        frame.extend_from_slice(&(payload.len() as u16).to_be_bytes());
+        frame.extend_from_slice(payload);
+    }
+    frame
+}
+
+/// The Ethernet frames of a data frame from the access point, for the
+/// station `own`. `security` is the length of the cipher's header, still
+/// in a protected frame after the 802.11 header (0 once the radio removed
+/// it). Frames that are not data for this station give nothing.
+pub fn ethernet_from_data(frame: &[u8], own: &Address, security: usize) -> Vec<Vec<u8>> {
+    let mut out = Vec::new();
+    if frame.len() < HEADER || !is_data(frame) {
+        return out;
+    }
+    let (subtype, flags) = (frame[0] & 0xf0, frame[1]);
+    // Only frames from the distribution system (the access point) with a
+    // body: data and QoS data, not the null and CF variants.
+    if flags & (TO_DS | FROM_DS) != FROM_DS || subtype & 0x40 != 0 || flags & MORE_FRAGMENTS != 0 {
+        return out;
+    }
+    let (destination, source) = (address(frame, 0), address(frame, 2));
+    if destination != *own && !is_multicast(&destination) {
+        return out;
+    }
+    let mut offset = HEADER;
+    let mut amsdu = false;
+    if subtype & 0x80 != 0 {
+        let Some(qos) = frame.get(offset) else { return out };
+        amsdu = qos & 0x80 != 0;
+        offset += 2;
+        if flags & ORDER != 0 {
+            offset += 4;
+        }
+    }
+    if flags & PROTECTED != 0 {
+        offset += security;
+    }
+    let Some(body) = frame.get(offset..) else { return out };
+    if !amsdu {
+        if !body.is_empty() {
+            out.push(ethernet_from_llc(&destination, &source, body));
+        }
+        return out;
+    }
+    // An aggregate: subframes of destination, source, length and payload,
+    // each but the last padded to four bytes.
+    let mut rest = body;
+    let mut first = true;
+    while rest.len() >= 14 {
+        let (subframe_destination, subframe_source) = (&rest[0..6], &rest[6..12]);
+        let length = u16::from_be_bytes([rest[12], rest[13]]) as usize;
+        let Some(payload) = rest.get(14..14 + length) else { break };
+        // A plain frame made to look like an aggregate starts with the
+        // LLC header where the first destination would be: an injected
+        // frame, dropped whole.
+        if first && subframe_destination == RFC1042 {
+            out.clear();
+            return out;
+        }
+        first = false;
+        let wanted = subframe_destination == own || subframe_destination[0] & 1 != 0;
+        if wanted && !payload.is_empty() {
+            out.push(ethernet_from_llc(subframe_destination, subframe_source, payload));
+        }
+        let advance = (14 + length + 3) & !3;
+        rest = rest.get(advance..).unwrap_or(&[]);
+    }
+    out
+}
+
+/// The EtherType of an Ethernet frame.
+pub fn ethertype(ethernet: &[u8]) -> Option<u16> {
+    Some(u16::from_be_bytes([*ethernet.get(12)?, *ethernet.get(13)?]))
+}
diff --git a/kernel/comps/wlan/src/lib.rs b/kernel/comps/wlan/src/lib.rs
new file mode 100755
index 0000000..7c91ecd
--- /dev/null
+++ b/kernel/comps/wlan/src/lib.rs
@@ -0,0 +1,182 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Wi-Fi: what every chip's driver shares. Each radio a driver registers
+//! (`register`, with the operations of [`radio::Radio`]) becomes a station
+//! interface `wlan0`, `wlan1`, ... that programs run through nl80211
+//! (`cfg`, over generic netlink, `genl`) exactly as on Linux: the stock
+//! wpa_supplicant scans, authenticates, associates and installs the keys,
+//! with WPA2 and WPA3 computed on its side, and the frames of the link's
+//! own handshake (EAPOL) go through its netlink socket. `device` keeps the
+//! networks heard and runs each step's frames and time-outs; `netdev` is
+//! the Ethernet device the kernel's network stack gets, which asks for an
+//! address by DHCP when a link is made.
+//!
+//! `wlan.sim` on the kernel command line adds a simulated radio with two
+//! access points (`sim`), for tests without hardware.
+
+#![no_std]
+#![deny(unsafe_code)]
+
+extern crate alloc;
+
+// This crate's log prefix for `ostd::log`.
+macro_rules! __log_prefix {
+    () => {
+        "wlan: "
+    };
+}
+
+mod cfg;
+mod consts;
+mod device;
+pub mod genl;
+pub mod ieee80211;
+mod netdev;
+mod nl;
+pub mod radio;
+mod sim;
+
+use alloc::{format, sync::Arc, vec::Vec};
+use core::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+use component::{ComponentInitError, init_component};
+pub use device::Device;
+use ostd::{
+    sync::{SpinLock, WaitQueue},
+    timer::Jiffies,
+};
+use spin::Once;
+
+/// Wakes the task: a frame from a radio, a frame to send, the timer.
+static WAKE: WaitQueue = WaitQueue::new();
+static WOKEN: AtomicBool = AtomicBool::new(false);
+/// A step of some link or a scan waits on a time-out: the timer wakes the
+/// task while it does.
+static WAITING: AtomicBool = AtomicBool::new(false);
+static TICKS: AtomicUsize = AtomicUsize::new(0);
+static DEVICES: SpinLock<Vec<Arc<Device>>> = SpinLock::new(Vec::new());
+
+/// `wlan.sim`: a simulated radio and its access points.
+static SIMULATED: AtomicBool = AtomicBool::new(false);
+aster_cmdline::define_flag_param!("wlan.sim", SIMULATED);
+
+/// What the kernel's network stack does for this component.
+#[derive(Clone, Copy)]
+pub struct Hooks {
+    /// The index of the interface with this name.
+    pub ifindex: fn(name: &str) -> Option<u32>,
+    /// A link was made (its keys are in place) or ended: the interface
+    /// asks for an address again, or drops the one it had.
+    pub link_changed: fn(name: &str, connected: bool),
+}
+
+static HOOKS: Once<Hooks> = Once::new();
+
+pub fn set_hooks(hooks: Hooks) {
+    HOOKS.call_once(|| hooks);
+}
+
+pub(crate) fn ifindex_of(name: &str) -> Option<u32> {
+    HOOKS.get().and_then(|hooks| (hooks.ifindex)(name))
+}
+
+pub(crate) fn link_changed(name: &str, connected: bool) {
+    if let Some(hooks) = HOOKS.get() {
+        (hooks.link_changed)(name, connected);
+    }
+}
+
+pub(crate) fn now_ms() -> u64 {
+    Jiffies::elapsed().as_duration().as_millis() as u64
+}
+
+pub(crate) fn wake() {
+    WOKEN.store(true, Ordering::Release);
+    WAKE.wake_all();
+}
+
+/// Each timer tick (1 ms): every 20, the task, while something waits on a
+/// time-out.
+fn tick() {
+    let ticks = TICKS.fetch_add(1, Ordering::Relaxed);
+    if ticks % 20 == 0 && WAITING.load(Ordering::Relaxed) {
+        wake();
+    }
+}
+
+/// An address as it is written.
+pub(crate) struct Mac<'a>(pub &'a [u8; 6]);
+
+impl core::fmt::Display for Mac<'_> {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        let a = self.0;
+        write!(f, "{:02x}:{:02x}:{:02x}:{:02x}:{:02x}:{:02x}", a[0], a[1], a[2], a[3], a[4], a[5])
+    }
+}
+
+/// A chip's driver registers its radio: it becomes the next `wlan`
+/// interface, down until a program brings it up. The driver reports what
+/// the radio receives to the device it gets back.
+pub fn register(info: radio::Info, radio: Arc<dyn radio::Radio>) -> Arc<Device> {
+    let device = {
+        let mut devices = DEVICES.lock();
+        let index = devices.len() as u32;
+        let device = Device::new(index, format!("wlan{index}"), info, radio);
+        devices.push(device.clone());
+        device
+    };
+    ostd::notice!(
+        "{}: {} radio, address {}",
+        device.name,
+        device.info.driver,
+        Mac(&device.info.address)
+    );
+    netdev::register(device.name.clone(), device.info.address, device.net().clone());
+    cfg::device_added(&device);
+    device
+}
+
+pub(crate) fn devices() -> Vec<Arc<Device>> {
+    DEVICES.lock().clone()
+}
+
+fn device_named(name: &str) -> Option<Arc<Device>> {
+    DEVICES.lock().iter().find(|device| device.name == name).cloned()
+}
+
+/// Whether the interface `name` is one of this component's, and then
+/// whether it is up, and whether a link carries data.
+pub fn interface_state(name: &str) -> Option<(bool, bool)> {
+    let device = device_named(name)?;
+    Some((device.is_up(), device.connected()))
+}
+
+/// Brings one of this component's interfaces up or down (`None`: not
+/// one). An error is Linux's number for it.
+pub fn set_interface_up(name: &str, up: bool) -> Option<Result<(), i32>> {
+    let device = device_named(name)?;
+    Some(device.set_up(up))
+}
+
+/// The component's task, which the kernel starts once it has a
+/// scheduler: the links' steps and time-outs, the frames to send.
+pub fn run() -> ! {
+    if SIMULATED.load(Ordering::Relaxed) {
+        sim::register();
+    }
+    loop {
+        WAKE.wait_until(|| WOKEN.swap(false, Ordering::AcqRel).then_some(()));
+        let now = now_ms();
+        let mut waiting = false;
+        for device in devices() {
+            waiting |= device.run(now);
+        }
+        WAITING.store(waiting, Ordering::Relaxed);
+    }
+}
+
+#[init_component]
+fn init() -> Result<(), ComponentInitError> {
+    ostd::timer::register_callback_on_cpu(tick);
+    Ok(())
+}
diff --git a/kernel/comps/wlan/src/netdev.rs b/kernel/comps/wlan/src/netdev.rs
new file mode 100755
index 0000000..fb49e9a
--- /dev/null
+++ b/kernel/comps/wlan/src/netdev.rs
@@ -0,0 +1,136 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! A Wi-Fi interface as the kernel's network stack sees it: an Ethernet
+//! device whose frames go through two queues between the stack and this
+//! component's task (`crate::device`), which hands them to the radio while
+//! the link is up. The stack gives it an interface, which asks a DHCP
+//! server for its address each time a link is made (the kernel's
+//! `net::iface`).
+
+use alloc::{collections::VecDeque, string::String, sync::Arc, vec::Vec};
+
+use aster_bigtcp::{
+    device::{AnyNetworkDevice, ChecksumCapabilities, DeviceCapabilities, EthernetAddress, Medium, NetError},
+    packet::{FreshTxPacket, LinkLayer, RxPacket, TxPacket},
+};
+use aster_softirq::BottomHalfDisabled;
+use ostd::{
+    mm::{VmReader, VmWriter},
+    sync::{LocalIrqDisabled, SpinLock},
+};
+
+/// Frames waiting either way.
+const QUEUE: usize = 512;
+
+/// The queues between the network stack and the task.
+#[derive(Debug)]
+pub(crate) struct Shared {
+    rx: SpinLock<VecDeque<Vec<u8>>, LocalIrqDisabled>,
+    tx: SpinLock<VecDeque<Vec<u8>>, LocalIrqDisabled>,
+}
+
+impl Shared {
+    pub(crate) fn new() -> Arc<Self> {
+        Arc::new(Self { rx: SpinLock::new(VecDeque::new()), tx: SpinLock::new(VecDeque::new()) })
+    }
+
+    /// A frame from the network, for the stack.
+    pub(crate) fn received(&self, frame: Vec<u8>) {
+        let mut rx = self.rx.lock();
+        if rx.len() < QUEUE {
+            rx.push_back(frame);
+        }
+    }
+
+    /// The next frame the stack wants sent.
+    pub(crate) fn next_tx(&self) -> Option<Vec<u8>> {
+        self.tx.lock().pop_front()
+    }
+
+    /// A frame the radio had no room for: it goes first again.
+    pub(crate) fn put_back(&self, frame: Vec<u8>) {
+        self.tx.lock().push_front(frame);
+    }
+
+    /// A frame left the queue: the stack may have more.
+    pub(crate) fn sent(&self) {
+        aster_network::raise_send_softirq();
+    }
+
+    /// Without a link, what waits is dropped.
+    pub(crate) fn clear_tx(&self) {
+        self.tx.lock().clear();
+    }
+}
+
+#[derive(Debug)]
+struct WlanNetDevice {
+    mac: EthernetAddress,
+    shared: Arc<Shared>,
+}
+
+impl AnyNetworkDevice for WlanNetDevice {
+    fn mac_addr(&self) -> EthernetAddress {
+        self.mac
+    }
+
+    fn capabilities(&self) -> DeviceCapabilities {
+        let mut capabilities = DeviceCapabilities::default();
+        capabilities.max_transmission_unit = 1514;
+        capabilities.medium = Medium::Ethernet;
+        capabilities.checksum = ChecksumCapabilities::default();
+        capabilities
+    }
+
+    fn can_receive(&self) -> bool {
+        !self.shared.rx.lock().is_empty()
+    }
+
+    fn can_send(&self) -> bool {
+        self.shared.tx.lock().len() < QUEUE
+    }
+
+    fn receive(&mut self) -> Result<RxPacket<LinkLayer>, NetError> {
+        let frame = self.shared.rx.lock().pop_front().ok_or(NetError::NotReady)?;
+        let fresh = FreshTxPacket::<LinkLayer>::alloc(frame.len()).map_err(|_| NetError::NoMemory)?;
+        let mut builder = fresh.to_builder();
+        let written = builder.append_writer().write(&mut VmReader::from(frame.as_slice()));
+        builder.commit(written);
+        builder.build().to_rx_packet().ok_or(NetError::NoMemory)
+    }
+
+    fn send(&mut self, packet: TxPacket<LinkLayer>) -> Result<(), NetError> {
+        let mut frame = alloc::vec![0u8; packet.len()];
+        let length = packet.reader().read(&mut VmWriter::from(frame.as_mut_slice()));
+        frame.truncate(length);
+        {
+            let mut tx = self.shared.tx.lock();
+            if tx.len() >= QUEUE {
+                return Err(NetError::Busy);
+            }
+            tx.push_back(frame);
+        }
+        crate::wake();
+        Ok(())
+    }
+
+    fn alloc_tx_buffer(payload_len: usize) -> Result<FreshTxPacket, ostd::Error> {
+        FreshTxPacket::alloc(payload_len)
+    }
+
+    fn free_processed_tx_buffers(&mut self) {}
+
+    fn notify_poll_end(&mut self) {}
+}
+
+/// Offers the interface to the network stack as `name`.
+pub(crate) fn register(name: String, mac: [u8; 6], shared: Arc<Shared>) {
+    let device: Arc<SpinLock<dyn AnyNetworkDevice, BottomHalfDisabled>> =
+        Arc::new(SpinLock::new(WlanNetDevice { mac: EthernetAddress(mac), shared }));
+    aster_network::register_device(name, device);
+}
+
+/// The stack has frames to read.
+pub(crate) fn notify_received() {
+    aster_network::raise_receive_softirq();
+}
diff --git a/kernel/comps/wlan/src/nl.rs b/kernel/comps/wlan/src/nl.rs
new file mode 100755
index 0000000..eb12d67
--- /dev/null
+++ b/kernel/comps/wlan/src/nl.rs
@@ -0,0 +1,272 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Netlink messages and their attributes, as bytes: what generic netlink
+//! families (`crate::genl`, `crate::cfg`) read from programs and write back.
+
+use alloc::vec::Vec;
+
+pub(crate) const HEADER: usize = 16;
+pub(crate) const GENL_HEADER: usize = 4;
+
+pub(crate) const NLMSG_ERROR: u16 = 2;
+pub(crate) const NLMSG_DONE: u16 = 3;
+/// The first message type that belongs to a family.
+pub(crate) const NLMSG_MIN_TYPE: u16 = 0x10;
+
+pub(crate) const NLM_F_MULTI: u16 = 0x2;
+pub(crate) const NLM_F_ACK: u16 = 0x4;
+pub(crate) const NLM_F_DUMP: u16 = 0x300;
+/// An error message that carries only the header of its request.
+pub(crate) const NLM_F_CAPPED: u16 = 0x100;
+
+const NLA_TYPE_MASK: u16 = 0x3fff;
+
+/// Rounds up to netlink's alignment.
+pub(crate) const fn align(length: usize) -> usize {
+    (length + 3) & !3
+}
+
+/// A message's header.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct Header {
+    pub(crate) length: u32,
+    pub(crate) kind: u16,
+    pub(crate) flags: u16,
+    pub(crate) seq: u32,
+    pub(crate) port: u32,
+}
+
+impl Header {
+    fn parse(bytes: &[u8]) -> Option<Self> {
+        let bytes = bytes.get(..HEADER)?;
+        Some(Self {
+            length: u32::from_ne_bytes(bytes[0..4].try_into().ok()?),
+            kind: u16::from_ne_bytes(bytes[4..6].try_into().ok()?),
+            flags: u16::from_ne_bytes(bytes[6..8].try_into().ok()?),
+            seq: u32::from_ne_bytes(bytes[8..12].try_into().ok()?),
+            port: u32::from_ne_bytes(bytes[12..16].try_into().ok()?),
+        })
+    }
+
+    fn write(&self, bytes: &mut Vec<u8>) {
+        bytes.extend_from_slice(&self.length.to_ne_bytes());
+        bytes.extend_from_slice(&self.kind.to_ne_bytes());
+        bytes.extend_from_slice(&self.flags.to_ne_bytes());
+        bytes.extend_from_slice(&self.seq.to_ne_bytes());
+        bytes.extend_from_slice(&self.port.to_ne_bytes());
+    }
+
+    pub(crate) fn dump(&self) -> bool {
+        self.flags & NLM_F_DUMP == NLM_F_DUMP
+    }
+}
+
+/// The messages of one write, each with its header and what follows it.
+/// Stops at the first one whose length does not fit.
+pub(crate) fn messages(bytes: &[u8]) -> impl Iterator<Item = (Header, &[u8])> {
+    let mut rest = bytes;
+    core::iter::from_fn(move || {
+        let header = Header::parse(rest)?;
+        let length = header.length as usize;
+        if length < HEADER || length > rest.len() {
+            return None;
+        }
+        let payload = &rest[HEADER..length];
+        rest = rest.get(align(length)..).unwrap_or(&[]);
+        Some((header, payload))
+    })
+}
+
+/// A generic netlink request: its command and its attributes.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Request<'a> {
+    pub(crate) header: Header,
+    pub(crate) command: u8,
+    pub(crate) attrs: Attrs<'a>,
+}
+
+impl<'a> Request<'a> {
+    pub(crate) fn parse(header: Header, payload: &'a [u8]) -> Option<Self> {
+        let command = *payload.first()?;
+        Some(Self { header, command, attrs: Attrs(payload.get(GENL_HEADER..)?) })
+    }
+}
+
+/// A run of attributes.
+#[derive(Clone, Copy, Debug, Default)]
+pub(crate) struct Attrs<'a>(pub &'a [u8]);
+
+impl<'a> Attrs<'a> {
+    /// Each attribute's type (without its flags) and its value.
+    pub(crate) fn iter(&self) -> impl Iterator<Item = (u32, &'a [u8])> + use<'a> {
+        let mut rest = self.0;
+        core::iter::from_fn(move || {
+            if rest.len() < 4 {
+                return None;
+            }
+            let length = u16::from_ne_bytes([rest[0], rest[1]]) as usize;
+            let kind = u16::from_ne_bytes([rest[2], rest[3]]) & NLA_TYPE_MASK;
+            if length < 4 || length > rest.len() {
+                return None;
+            }
+            let value = &rest[4..length];
+            rest = rest.get(align(length)..).unwrap_or(&[]);
+            Some((kind as u32, value))
+        })
+    }
+
+    pub(crate) fn get(&self, kind: u32) -> Option<&'a [u8]> {
+        self.iter().find(|(found, _)| *found == kind).map(|(_, value)| value)
+    }
+
+    pub(crate) fn has(&self, kind: u32) -> bool {
+        self.get(kind).is_some()
+    }
+
+    pub(crate) fn nested(&self, kind: u32) -> Option<Attrs<'a>> {
+        self.get(kind).map(Attrs)
+    }
+
+    pub(crate) fn u8(&self, kind: u32) -> Option<u8> {
+        self.get(kind)?.first().copied()
+    }
+
+    pub(crate) fn u16(&self, kind: u32) -> Option<u16> {
+        Some(u16::from_ne_bytes(self.get(kind)?.get(..2)?.try_into().ok()?))
+    }
+
+    pub(crate) fn u32(&self, kind: u32) -> Option<u32> {
+        Some(u32::from_ne_bytes(self.get(kind)?.get(..4)?.try_into().ok()?))
+    }
+
+    pub(crate) fn u64(&self, kind: u32) -> Option<u64> {
+        Some(u64::from_ne_bytes(self.get(kind)?.get(..8)?.try_into().ok()?))
+    }
+
+    /// A value of exactly `N` bytes (an address).
+    pub(crate) fn array<const N: usize>(&self, kind: u32) -> Option<[u8; N]> {
+        self.get(kind)?.try_into().ok()
+    }
+
+    /// A string, without the NUL that ends it.
+    pub(crate) fn str(&self, kind: u32) -> Option<&'a [u8]> {
+        let value = self.get(kind)?;
+        Some(value.split(|byte| *byte == 0).next().unwrap_or(value))
+    }
+}
+
+/// A message being written.
+#[derive(Clone, Debug)]
+pub(crate) struct Message {
+    bytes: Vec<u8>,
+}
+
+impl Message {
+    /// A message of a generic netlink family.
+    pub(crate) fn new(family: u16, flags: u16, seq: u32, port: u32, command: u32, version: u8) -> Self {
+        let mut bytes = Vec::with_capacity(256);
+        Header { length: 0, kind: family, flags, seq, port }.write(&mut bytes);
+        bytes.extend_from_slice(&[command as u8, version, 0, 0]);
+        Self { bytes }
+    }
+
+    /// The answer to `request`: a part of a dump if it asked for one.
+    pub(crate) fn reply(request: &Header, command: u32, version: u8) -> Self {
+        let flags = if request.dump() { NLM_F_MULTI } else { 0 };
+        Self::new(request.kind, flags, request.seq, request.port, command, version)
+    }
+
+    pub(crate) fn put(&mut self, kind: u32, value: &[u8]) -> &mut Self {
+        let length = 4 + value.len();
+        // An attribute's length is 16 bits: what does not fit is left out.
+        if length > u16::MAX as usize {
+            return self;
+        }
+        self.bytes.extend_from_slice(&(length as u16).to_ne_bytes());
+        self.bytes.extend_from_slice(&(kind as u16).to_ne_bytes());
+        self.bytes.extend_from_slice(value);
+        self.bytes.resize(align(self.bytes.len()), 0);
+        self
+    }
+
+    pub(crate) fn flag(&mut self, kind: u32) -> &mut Self {
+        self.put(kind, &[])
+    }
+
+    pub(crate) fn u8(&mut self, kind: u32, value: u8) -> &mut Self {
+        self.put(kind, &[value])
+    }
+
+    pub(crate) fn u16(&mut self, kind: u32, value: u16) -> &mut Self {
+        self.put(kind, &value.to_ne_bytes())
+    }
+
+    pub(crate) fn u32(&mut self, kind: u32, value: u32) -> &mut Self {
+        self.put(kind, &value.to_ne_bytes())
+    }
+
+    pub(crate) fn u64(&mut self, kind: u32, value: u64) -> &mut Self {
+        self.put(kind, &value.to_ne_bytes())
+    }
+
+    /// A string with the NUL that ends it.
+    pub(crate) fn str(&mut self, kind: u32, value: &str) -> &mut Self {
+        let mut bytes = Vec::with_capacity(value.len() + 1);
+        bytes.extend_from_slice(value.as_bytes());
+        bytes.push(0);
+        self.put(kind, &bytes)
+    }
+
+    /// An attribute that holds the attributes `fill` writes.
+    pub(crate) fn nest(&mut self, kind: u32, fill: impl FnOnce(&mut Self)) -> &mut Self {
+        let start = self.bytes.len();
+        self.bytes.extend_from_slice(&[0, 0]);
+        self.bytes.extend_from_slice(&(kind as u16).to_ne_bytes());
+        fill(self);
+        let length = self.bytes.len() - start;
+        if length > u16::MAX as usize {
+            self.bytes.truncate(start);
+            return self;
+        }
+        self.bytes[start..start + 2].copy_from_slice(&(length as u16).to_ne_bytes());
+        self
+    }
+
+    pub(crate) fn finish(mut self) -> Vec<u8> {
+        let length = self.bytes.len() as u32;
+        self.bytes[0..4].copy_from_slice(&length.to_ne_bytes());
+        self.bytes
+    }
+}
+
+/// The answer that ends a request: `errno` (0: done, as its `NLM_F_ACK`
+/// asked) with the request's header.
+pub(crate) fn error(request: &Header, errno: i32) -> Vec<u8> {
+    let mut bytes = Vec::with_capacity(HEADER + 4 + HEADER);
+    let header = Header {
+        length: (HEADER + 4 + HEADER) as u32,
+        kind: NLMSG_ERROR,
+        flags: NLM_F_CAPPED,
+        seq: request.seq,
+        port: request.port,
+    };
+    header.write(&mut bytes);
+    bytes.extend_from_slice(&(-errno).to_ne_bytes());
+    request.write(&mut bytes);
+    bytes
+}
+
+/// The message that ends a dump.
+pub(crate) fn done(request: &Header) -> Vec<u8> {
+    let mut bytes = Vec::with_capacity(HEADER + 4);
+    let header = Header {
+        length: (HEADER + 4) as u32,
+        kind: NLMSG_DONE,
+        flags: NLM_F_MULTI,
+        seq: request.seq,
+        port: request.port,
+    };
+    header.write(&mut bytes);
+    bytes.extend_from_slice(&0i32.to_ne_bytes());
+    bytes
+}
diff --git a/kernel/comps/wlan/src/radio.rs b/kernel/comps/wlan/src/radio.rs
new file mode 100755
index 0000000..e710358
--- /dev/null
+++ b/kernel/comps/wlan/src/radio.rs
@@ -0,0 +1,340 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! What a Wi-Fi chip's driver gives this component and what it is asked:
+//! the chip's bands and ciphers, and the operations of a station (scan,
+//! tune to a network, send frames, hold keys).
+
+use alloc::{string::String, vec::Vec};
+
+use crate::ieee80211::Address;
+
+/// Cipher suite selectors (OUI 00-0F-AC and the suite's number).
+pub const CIPHER_WEP40: u32 = 0x000f_ac01;
+pub const CIPHER_TKIP: u32 = 0x000f_ac02;
+pub const CIPHER_CCMP: u32 = 0x000f_ac04;
+pub const CIPHER_WEP104: u32 = 0x000f_ac05;
+/// Protects broadcast management frames (802.11w).
+pub const CIPHER_BIP_CMAC: u32 = 0x000f_ac06;
+pub const CIPHER_GCMP: u32 = 0x000f_ac08;
+pub const CIPHER_GCMP_256: u32 = 0x000f_ac09;
+pub const CIPHER_CCMP_256: u32 = 0x000f_ac0a;
+pub const CIPHER_BIP_GMAC: u32 = 0x000f_ac0b;
+pub const CIPHER_BIP_GMAC_256: u32 = 0x000f_ac0c;
+
+/// The length of the header a cipher puts before a frame's body.
+pub fn cipher_header(cipher: u32) -> usize {
+    match cipher {
+        CIPHER_WEP40 | CIPHER_WEP104 => 4,
+        CIPHER_TKIP | CIPHER_CCMP | CIPHER_CCMP_256 | CIPHER_GCMP | CIPHER_GCMP_256 => 8,
+        _ => 0,
+    }
+}
+
+/// Why a radio did not do what it was asked.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Error {
+    /// It is doing something that excludes this (a scan in progress).
+    Busy,
+    /// The chip or its driver has no such thing.
+    Unsupported,
+    /// The chip did not answer or refused.
+    Failed,
+    /// The radio is off.
+    Down,
+    /// The request does not make sense for this chip.
+    Invalid,
+    Memory,
+}
+
+impl Error {
+    /// Linux's error number for it.
+    pub fn errno(self) -> i32 {
+        match self {
+            Error::Busy => 16,
+            Error::Unsupported => 95,
+            Error::Failed => 5,
+            Error::Down => 100,
+            Error::Invalid => 22,
+            Error::Memory => 12,
+        }
+    }
+}
+
+pub type Result<T> = core::result::Result<T, Error>;
+
+/// The bands.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub enum BandId {
+    Ghz2,
+    Ghz5,
+    Ghz6,
+}
+
+impl BandId {
+    pub fn of(freq: u16) -> Self {
+        match freq {
+            ..3000 => BandId::Ghz2,
+            5925.. => BandId::Ghz6,
+            _ => BandId::Ghz5,
+        }
+    }
+
+    /// The rates of the band, in units of 500 kbit/s: 802.11b's (2.4 GHz
+    /// only) and 802.11g/a's.
+    pub fn rates(self) -> &'static [u8] {
+        const ALL: [u8; 12] = [2, 4, 11, 22, 12, 18, 24, 36, 48, 72, 96, 108];
+        match self {
+            BandId::Ghz2 => &ALL,
+            _ => &ALL[4..],
+        }
+    }
+}
+
+/// A channel the chip tunes to.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Channel {
+    /// Its center frequency, in MHz.
+    pub freq: u16,
+    /// The chip's regulatory data forbids it here.
+    pub disabled: bool,
+    /// Only listening until a network is heard on it (no probe requests).
+    pub passive: bool,
+    /// Shared with radars.
+    pub radar: bool,
+    /// The most power allowed, in dBm.
+    pub max_power: u8,
+}
+
+impl Channel {
+    pub const fn new(freq: u16) -> Self {
+        Self { freq, disabled: false, passive: false, radar: false, max_power: 20 }
+    }
+}
+
+/// 802.11n capabilities.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct HtCap {
+    pub info: u16,
+    /// The longest aggregate (exponent) and the spacing in one.
+    pub ampdu_factor: u8,
+    pub ampdu_density: u8,
+    pub mcs: [u8; 16],
+}
+
+impl HtCap {
+    /// The element's value.
+    pub fn element(&self) -> [u8; 26] {
+        let mut out = [0u8; 26];
+        out[0..2].copy_from_slice(&self.info.to_le_bytes());
+        out[2] = (self.ampdu_factor & 3) | ((self.ampdu_density & 7) << 2);
+        out[3..19].copy_from_slice(&self.mcs);
+        out
+    }
+}
+
+/// 802.11ac capabilities.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct VhtCap {
+    pub info: u32,
+    /// The supported MCS and NSS set, as in the element.
+    pub mcs: [u8; 8],
+}
+
+impl VhtCap {
+    pub fn element(&self) -> [u8; 12] {
+        let mut out = [0u8; 12];
+        out[0..4].copy_from_slice(&self.info.to_le_bytes());
+        out[4..12].copy_from_slice(&self.mcs);
+        out
+    }
+}
+
+/// 802.11ax capabilities, as in the element.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct HeCap {
+    pub mac: [u8; 6],
+    pub phy: [u8; 11],
+    pub mcs: Vec<u8>,
+    pub ppe: Vec<u8>,
+}
+
+impl HeCap {
+    /// The extension element's value, after its extension ID.
+    pub fn element(&self) -> Vec<u8> {
+        let mut out = Vec::with_capacity(17 + self.mcs.len() + self.ppe.len());
+        out.extend_from_slice(&self.mac);
+        out.extend_from_slice(&self.phy);
+        out.extend_from_slice(&self.mcs);
+        out.extend_from_slice(&self.ppe);
+        out
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Band {
+    pub id: BandId,
+    pub channels: Vec<Channel>,
+    pub ht: Option<HtCap>,
+    pub vht: Option<VhtCap>,
+    pub he: Option<HeCap>,
+}
+
+/// What a chip is and can do.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Info {
+    /// The driver, for the log.
+    pub driver: String,
+    pub address: Address,
+    pub bands: Vec<Band>,
+    /// The ciphers it runs, `CIPHER_BIP_CMAC` among them when it protects
+    /// management frames.
+    pub ciphers: Vec<u32>,
+    /// How many names one scan asks for by name.
+    pub max_scan_ssids: u8,
+    /// The most bytes of extra elements in a probe request.
+    pub max_scan_ie_len: u16,
+}
+
+impl Info {
+    pub fn channel(&self, freq: u16) -> Option<(&Band, &Channel)> {
+        self.bands.iter().find_map(|band| {
+            let channel = band.channels.iter().find(|channel| channel.freq == freq)?;
+            Some((band, channel))
+        })
+    }
+
+    pub fn protects_management(&self) -> bool {
+        self.ciphers.contains(&CIPHER_BIP_CMAC)
+    }
+}
+
+/// A scan to run.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct ScanRequest {
+    /// The channels, in MHz: the passive ones are only listened to.
+    pub freqs: Vec<u16>,
+    /// The names to ask for (an empty one: any network); none: only listen.
+    pub ssids: Vec<Vec<u8>>,
+    /// Elements for the probe requests, after the name and the rates.
+    pub elements: Vec<u8>,
+}
+
+/// The network to tune to before authenticating.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Join {
+    pub bssid: Address,
+    pub freq: u16,
+    pub beacon_interval: u16,
+    pub capability: u16,
+    /// The elements of its last beacon or probe response.
+    pub elements: Vec<u8>,
+}
+
+/// What the association settled.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Association {
+    pub aid: u16,
+    pub capability: u16,
+    /// The elements of the association response.
+    pub elements: Vec<u8>,
+    /// The elements this station sent in its request.
+    pub request_elements: Vec<u8>,
+    /// The network takes QoS data frames (WMM).
+    pub qos: bool,
+}
+
+/// A key to install.
+#[derive(Clone, PartialEq, Eq)]
+pub struct Key {
+    pub index: u8,
+    pub cipher: u32,
+    /// For frames between this station and the access point alone;
+    /// otherwise the group's, for broadcasts.
+    pub pairwise: bool,
+    pub key: Vec<u8>,
+    /// The packet number the receiver starts from.
+    pub seq: Vec<u8>,
+}
+
+impl core::fmt::Debug for Key {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        // Never the key itself.
+        f.debug_struct("Key")
+            .field("index", &self.index)
+            .field("cipher", &format_args!("{:#x}", self.cipher))
+            .field("pairwise", &self.pairwise)
+            .field("length", &self.key.len())
+            .finish()
+    }
+}
+
+/// What the radio knows of the link to the access point.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct LinkStats {
+    /// Of the last frames from it, in dBm.
+    pub signal: Option<i8>,
+    /// The rate of the last frames sent, in units of 100 kbit/s.
+    pub tx_rate: Option<u32>,
+}
+
+/// A frame the radio received.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct RxInfo {
+    /// The channel it came on, in MHz.
+    pub freq: u16,
+    /// In dBm.
+    pub signal: i8,
+    /// A protected frame the chip decrypted and verified; the cipher's
+    /// header is still there if `security_header` is not 0.
+    pub decrypted: bool,
+    pub security_header: u8,
+}
+
+/// The operations of a chip's driver. They are called from tasks that may
+/// sleep, one at a time.
+pub trait Radio: Send + Sync {
+    /// Powers the radio (the interface goes up).
+    fn start(&self) -> Result<()>;
+
+    /// Turns the radio off.
+    fn stop(&self);
+
+    /// Starts a scan. Beacons and probe responses arrive as received
+    /// frames; `Device::scan_done` ends it.
+    fn scan(&self, request: &ScanRequest) -> Result<()>;
+
+    /// Ends the scan in progress early (`Device::scan_done` still comes).
+    fn abort_scan(&self);
+
+    /// Tunes to a network, ready to exchange management frames with it.
+    fn join(&self, network: &Join) -> Result<()>;
+
+    /// The network accepted this station.
+    fn associated(&self, association: &Association) -> Result<()>;
+
+    /// Forgets the network, its keys included.
+    fn leave(&self);
+
+    fn set_key(&self, key: &Key) -> Result<()>;
+
+    fn remove_key(&self, index: u8, pairwise: bool);
+
+    /// The keys are in place: data may flow (or not any more).
+    fn authorize(&self, authorized: bool);
+
+    /// Sends a management frame, complete but for the sequence number,
+    /// which is the radio's.
+    fn send_management(&self, frame: &[u8]) -> Result<()>;
+
+    /// Sends an Ethernet frame to the network, encrypted with the pairwise
+    /// key unless `plain`. `Error::Busy`: later, the queue is full.
+    fn send(&self, ethernet: &[u8], plain: bool) -> Result<()>;
+
+    fn link_stats(&self) -> LinkStats {
+        LinkStats::default()
+    }
+
+    /// Called every 20 ms or so while a scan or a link's step is under
+    /// way, for radios without a task of their own.
+    fn tick(&self, _now_ms: u64) {}
+}
diff --git a/kernel/comps/wlan/src/sim/crypto.rs b/kernel/comps/wlan/src/sim/crypto.rs
new file mode 100755
index 0000000..e3d06af
--- /dev/null
+++ b/kernel/comps/wlan/src/sim/crypto.rs
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! What the simulated access point computes of WPA2's handshake: the key
+//! from the passphrase (PBKDF2), the session's keys (the PRF), the frames'
+//! integrity code (HMAC-SHA1) and the wrapping of the group key (AES key
+//! wrap, around the kernel's AES). Only the simulation uses these: a real
+//! link's are the supplicant's and the chip's.
+
+use alloc::vec::Vec;
+
+/// SHA-1 of the concatenation of `parts`.
+pub(crate) fn sha1(parts: &[&[u8]]) -> [u8; 20] {
+    let mut state: [u32; 5] = [0x6745_2301, 0xefcd_ab89, 0x98ba_dcfe, 0x1032_5476, 0xc3d2_e1f0];
+    let mut block = [0u8; 64];
+    let mut filled = 0;
+    let mut total: u64 = 0;
+    let absorb = |state: &mut [u32; 5], block: &[u8; 64]| {
+        let mut w = [0u32; 80];
+        for (index, word) in block.chunks_exact(4).enumerate() {
+            w[index] = u32::from_be_bytes([word[0], word[1], word[2], word[3]]);
+        }
+        for index in 16..80 {
+            w[index] = (w[index - 3] ^ w[index - 8] ^ w[index - 14] ^ w[index - 16]).rotate_left(1);
+        }
+        let [mut a, mut b, mut c, mut d, mut e] = *state;
+        for (index, word) in w.iter().enumerate() {
+            let (f, k) = match index {
+                0..20 => ((b & c) | (!b & d), 0x5a82_7999),
+                20..40 => (b ^ c ^ d, 0x6ed9_eba1),
+                40..60 => ((b & c) | (b & d) | (c & d), 0x8f1b_bcdc),
+                _ => (b ^ c ^ d, 0xca62_c1d6u32),
+            };
+            let next = a.rotate_left(5).wrapping_add(f).wrapping_add(e).wrapping_add(k).wrapping_add(*word);
+            e = d;
+            d = c;
+            c = b.rotate_left(30);
+            b = a;
+            a = next;
+        }
+        for (value, add) in state.iter_mut().zip([a, b, c, d, e]) {
+            *value = value.wrapping_add(add);
+        }
+    };
+    for part in parts {
+        total += part.len() as u64;
+        for byte in *part {
+            block[filled] = *byte;
+            filled += 1;
+            if filled == 64 {
+                absorb(&mut state, &block);
+                filled = 0;
+            }
+        }
+    }
+    block[filled] = 0x80;
+    filled += 1;
+    if filled > 56 {
+        block[filled..].fill(0);
+        absorb(&mut state, &block);
+        filled = 0;
+    }
+    block[filled..56].fill(0);
+    block[56..].copy_from_slice(&(total * 8).to_be_bytes());
+    absorb(&mut state, &block);
+    let mut out = [0u8; 20];
+    for (bytes, word) in out.chunks_exact_mut(4).zip(state) {
+        bytes.copy_from_slice(&word.to_be_bytes());
+    }
+    out
+}
+
+pub(crate) fn hmac_sha1(key: &[u8], parts: &[&[u8]]) -> [u8; 20] {
+    let mut padded = [0u8; 64];
+    if key.len() > 64 {
+        padded[..20].copy_from_slice(&sha1(&[key]));
+    } else {
+        padded[..key.len()].copy_from_slice(key);
+    }
+    let inner_key = padded.map(|byte| byte ^ 0x36);
+    let outer_key = padded.map(|byte| byte ^ 0x5c);
+    let mut inner: Vec<&[u8]> = Vec::with_capacity(parts.len() + 1);
+    inner.push(&inner_key);
+    inner.extend_from_slice(parts);
+    let digest = sha1(&inner);
+    sha1(&[&outer_key, &digest])
+}
+
+/// The 256-bit key of a WPA2 passphrase and network name: PBKDF2 with
+/// HMAC-SHA1 and 4096 rounds.
+pub(crate) fn passphrase_key(passphrase: &[u8], ssid: &[u8]) -> [u8; 32] {
+    let mut out = [0u8; 40];
+    for (index, chunk) in out.chunks_exact_mut(20).enumerate() {
+        let mut round = hmac_sha1(passphrase, &[ssid, &(index as u32 + 1).to_be_bytes()]);
+        let mut sum = round;
+        for _ in 1..4096 {
+            round = hmac_sha1(passphrase, &[&round]);
+            for (total, byte) in sum.iter_mut().zip(round) {
+                *total ^= byte;
+            }
+        }
+        chunk.copy_from_slice(&sum);
+    }
+    out[..32].try_into().unwrap()
+}
+
+/// 802.11's PRF: `N` bytes from a key, a label and data.
+pub(crate) fn prf<const N: usize>(key: &[u8], label: &[u8], data: &[u8]) -> [u8; N] {
+    let mut out = [0u8; N];
+    for (index, chunk) in out.chunks_mut(20).enumerate() {
+        let digest = hmac_sha1(key, &[label, &[0], data, &[index as u8]]);
+        chunk.copy_from_slice(&digest[..chunk.len()]);
+    }
+    out
+}
+
+/// Wraps `plain` (a multiple of 8 bytes) with a 128-bit block cipher
+/// under the key-encryption key (RFC 3394): `encrypt` is AES with it.
+pub(crate) fn key_wrap(encrypt: impl Fn(&mut [u8; 16]), plain: &[u8]) -> Vec<u8> {
+    let blocks = plain.len() / 8;
+    let mut a = [0xa6u8; 8];
+    let mut r = plain[..blocks * 8].to_vec();
+    for round in 0..6 {
+        for index in 0..blocks {
+            let mut block = [0u8; 16];
+            block[..8].copy_from_slice(&a);
+            block[8..].copy_from_slice(&r[index * 8..index * 8 + 8]);
+            encrypt(&mut block);
+            let counter = (blocks * round + index + 1) as u64;
+            a.copy_from_slice(&block[..8]);
+            for (byte, counter) in a.iter_mut().zip(counter.to_be_bytes()) {
+                *byte ^= counter;
+            }
+            r[index * 8..index * 8 + 8].copy_from_slice(&block[8..]);
+        }
+    }
+    let mut out = Vec::with_capacity(8 + r.len());
+    out.extend_from_slice(&a);
+    out.extend_from_slice(&r);
+    out
+}
diff --git a/kernel/comps/wlan/src/sim/mod.rs b/kernel/comps/wlan/src/sim/mod.rs
new file mode 100755
index 0000000..8df2682
--- /dev/null
+++ b/kernel/comps/wlan/src/sim/mod.rs
@@ -0,0 +1,527 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! A simulated radio (`wlan.sim` on the kernel command line) that hears
+//! two access points, an open one and a WPA2 one, each with a gateway that
+//! leases an address (`net`). It answers as a chip and its networks would:
+//! beacons and probe responses to scans, the authentication and
+//! association frames, and WPA2's four-way handshake from the access
+//! point's side (`crypto`). With it the whole path programs use (nl80211,
+//! wpa_supplicant, the keys, DHCP) runs in a virtual machine, where no
+//! real Wi-Fi chip exists.
+
+mod crypto;
+mod net;
+
+use alloc::{sync::Arc, vec, vec::Vec};
+
+use ostd::sync::SpinLock;
+use spin::Once;
+
+use crate::{
+    Device,
+    ieee80211::{self as wifi, Address},
+    radio::{self, Association, Band, BandId, Channel, HtCap, Info, Join, Key, LinkStats, Radio, RxInfo, ScanRequest},
+};
+
+/// The simulated radio's own address.
+const STATION: Address = [0x02, 0x00, 0x00, 0x00, 0x00, 0x01];
+
+struct AccessPoint {
+    bssid: Address,
+    ssid: &'static [u8],
+    freq: u16,
+    signal: i8,
+    /// WPA2's passphrase; none: an open network.
+    passphrase: Option<&'static [u8]>,
+}
+
+static ACCESS_POINTS: [AccessPoint; 2] = [
+    AccessPoint { bssid: [0x02, 0x00, 0x00, 0x00, 0x01, 0x00], ssid: b"OpenShell Sim", freq: 2412, signal: -48, passphrase: None },
+    AccessPoint {
+        bssid: [0x02, 0x00, 0x00, 0x00, 0x02, 0x00],
+        ssid: b"OpenShell Sim WPA2",
+        freq: 5180,
+        signal: -61,
+        passphrase: Some(b"openshell-sim"),
+    },
+];
+
+/// The RSN element of the WPA2 access point: CCMP for the group and the
+/// pair, a pre-shared key.
+const RSN: [u8; 22] = [48, 20, 1, 0, 0x00, 0x0f, 0xac, 4, 1, 0, 0x00, 0x0f, 0xac, 4, 1, 0, 0x00, 0x0f, 0xac, 2, 0, 0];
+/// The WMM parameter element: best effort's defaults for every class.
+const WMM: [u8; 26] = [
+    221, 24, 0x00, 0x50, 0xf2, 0x02, 0x01, 0x01, 0x00, 0x00, 0x03, 0xa4, 0x00, 0x00, 0x27, 0xa4, 0x00, 0x00, 0x42, 0x43, 0x5e, 0x00, 0x62, 0x32,
+    0x2f, 0x00,
+];
+
+const EAPOL_KEY_HEADER: usize = 4 + 95;
+const KEY_INFO_VERSION_AES: u16 = 2;
+const KEY_INFO_PAIRWISE: u16 = 1 << 3;
+const KEY_INFO_INSTALL: u16 = 1 << 6;
+const KEY_INFO_ACK: u16 = 1 << 7;
+const KEY_INFO_MIC: u16 = 1 << 8;
+const KEY_INFO_SECURE: u16 = 1 << 9;
+const KEY_INFO_ENCRYPTED: u16 = 1 << 12;
+
+/// AES-128 under `key`, a block at a time.
+fn aes128(key: [u8; 16]) -> impl Fn(&mut [u8; 16]) {
+    use aes_gcm::aes::{Aes128, BlockEncrypt, NewBlockCipher};
+
+    let cipher = Aes128::new(&key.into());
+    move |block| {
+        let mut state = (*block).into();
+        cipher.encrypt_block(&mut state);
+        block.copy_from_slice(&state);
+    }
+}
+
+/// WPA2's handshake, from the access point's side.
+enum Handshake {
+    None,
+    /// The first message went out with this nonce.
+    Started { anonce: [u8; 32] },
+    /// The station's answer was right: the third message went out.
+    Installing { ptk: [u8; 48] },
+    Done,
+}
+
+/// How long the simulated radio takes to scan.
+const SCAN_MS: u64 = 300;
+
+struct State {
+    up: bool,
+    /// The scan in progress, and when it ends.
+    scan: Option<(ScanRequest, u64)>,
+    joined: Option<usize>,
+    associated: bool,
+    handshake: Handshake,
+    replay: u64,
+    pairwise_key: bool,
+    group_key: bool,
+    authorized: bool,
+    /// The key of the WPA2 network's passphrase, computed once.
+    pmk: Option<[u8; 32]>,
+}
+
+struct Sim {
+    device: Once<Arc<Device>>,
+    state: SpinLock<State>,
+}
+
+pub(crate) fn register() {
+    let sim = Arc::new(Sim {
+        device: Once::new(),
+        state: SpinLock::new(State {
+            up: false,
+            scan: None,
+            joined: None,
+            associated: false,
+            handshake: Handshake::None,
+            replay: 0,
+            pairwise_key: false,
+            group_key: false,
+            authorized: false,
+            pmk: None,
+        }),
+    });
+    let info = Info {
+        driver: "simulated".into(),
+        address: STATION,
+        bands: vec![
+            Band {
+                id: BandId::Ghz2,
+                channels: (1..=13u16)
+                    .map(|channel| Channel { passive: channel > 11, ..Channel::new(2407 + 5 * channel) })
+                    .collect(),
+                ht: Some(HtCap { info: 0x0020, ampdu_factor: 3, ampdu_density: 6, mcs: { let mut mcs = [0u8; 16]; mcs[0] = 0xff; mcs } }),
+                vht: None,
+                he: None,
+            },
+            Band {
+                id: BandId::Ghz5,
+                channels: [36u16, 40, 44, 48, 52, 56, 60, 64, 149, 153, 157, 161]
+                    .iter()
+                    .map(|channel| Channel { passive: true, radar: (52..=64).contains(channel), ..Channel::new(5000 + 5 * channel) })
+                    .collect(),
+                ht: Some(HtCap { info: 0x0020, ampdu_factor: 3, ampdu_density: 6, mcs: { let mut mcs = [0u8; 16]; mcs[0] = 0xff; mcs } }),
+                vht: None,
+                he: None,
+            },
+        ],
+        ciphers: vec![radio::CIPHER_CCMP, radio::CIPHER_BIP_CMAC],
+        max_scan_ssids: 4,
+        max_scan_ie_len: 512,
+    };
+    let device = crate::register(info, sim.clone());
+    sim.device.call_once(|| device);
+}
+
+impl Sim {
+    fn device(&self) -> &Arc<Device> {
+        self.device.get().unwrap()
+    }
+
+    fn deliver(&self, frame: &[u8], ap: &AccessPoint, decrypted: bool) {
+        let info = RxInfo { freq: ap.freq, signal: ap.signal, decrypted, security_header: 0 };
+        self.device().received(frame, info);
+    }
+
+    fn elements(ap: &AccessPoint) -> Vec<u8> {
+        let mut elements = Vec::with_capacity(96);
+        wifi::put_element(&mut elements, wifi::IE_SSID, ap.ssid);
+        // The basic rates carry the highest bit.
+        let rates: Vec<u8> = BandId::of(ap.freq).rates().iter().enumerate().map(|(index, rate)| if index == 0 { rate | 0x80 } else { *rate }).collect();
+        wifi::put_rates(&mut elements, &rates);
+        if let Some(channel) = wifi::channel_of(ap.freq).filter(|_| BandId::of(ap.freq) == BandId::Ghz2) {
+            wifi::put_element(&mut elements, wifi::IE_DS_PARAMS, &[channel]);
+        }
+        if ap.passphrase.is_some() {
+            elements.extend_from_slice(&RSN);
+        }
+        elements.extend_from_slice(&WMM);
+        elements
+    }
+
+    fn management(kind: u8, ap: &AccessPoint, to: &Address, body: &[u8]) -> Vec<u8> {
+        let mut frame = Vec::with_capacity(wifi::HEADER + body.len());
+        frame.extend_from_slice(&[kind, 0, 0, 0]);
+        frame.extend_from_slice(to);
+        frame.extend_from_slice(&ap.bssid);
+        frame.extend_from_slice(&ap.bssid);
+        frame.extend_from_slice(&[0, 0]);
+        frame.extend_from_slice(body);
+        frame
+    }
+
+    fn beacon(ap: &AccessPoint, probe_response: bool) -> Vec<u8> {
+        let capability = wifi::CAP_ESS | wifi::CAP_SHORT_SLOT | if ap.passphrase.is_some() { wifi::CAP_PRIVACY } else { 0 };
+        let mut body = Vec::with_capacity(128);
+        body.extend_from_slice(&crate::now_ms().wrapping_mul(1000).to_le_bytes());
+        body.extend_from_slice(&100u16.to_le_bytes());
+        body.extend_from_slice(&capability.to_le_bytes());
+        body.extend_from_slice(&Self::elements(ap));
+        if probe_response {
+            Self::management(wifi::PROBE_RESPONSE, ap, &STATION, &body)
+        } else {
+            Self::management(wifi::BEACON, ap, &wifi::BROADCAST, &body)
+        }
+    }
+
+    /// An Ethernet frame from the access point's side, as the data frame
+    /// the station hears.
+    fn data(&self, ap: &AccessPoint, ethernet: &[u8], protected: bool) {
+        let mut frame = Vec::with_capacity(ethernet.len() + 20);
+        let flags = wifi::FROM_DS | if protected { wifi::PROTECTED } else { 0 };
+        frame.extend_from_slice(&[wifi::QOS_DATA, flags, 0, 0]);
+        frame.extend_from_slice(&ethernet[0..6]);
+        frame.extend_from_slice(&ap.bssid);
+        frame.extend_from_slice(&ethernet[6..12]);
+        frame.extend_from_slice(&[0, 0, 0, 0]);
+        frame.extend_from_slice(&[0xaa, 0xaa, 0x03, 0x00, 0x00, 0x00]);
+        frame.extend_from_slice(&ethernet[12..]);
+        self.deliver(&frame, ap, protected);
+    }
+
+    fn eapol_key(info: u16, replay: u64, nonce: &[u8; 32], key_data: &[u8]) -> Vec<u8> {
+        let mut frame = Vec::with_capacity(EAPOL_KEY_HEADER + key_data.len());
+        frame.extend_from_slice(&[2, 3]);
+        frame.extend_from_slice(&((95 + key_data.len()) as u16).to_be_bytes());
+        frame.push(2);
+        frame.extend_from_slice(&info.to_be_bytes());
+        frame.extend_from_slice(&16u16.to_be_bytes());
+        frame.extend_from_slice(&replay.to_be_bytes());
+        frame.extend_from_slice(nonce);
+        frame.extend_from_slice(&[0u8; 16 + 8 + 8 + 16]);
+        frame.extend_from_slice(&(key_data.len() as u16).to_be_bytes());
+        frame.extend_from_slice(key_data);
+        frame
+    }
+
+    fn send_eapol(&self, ap: &AccessPoint, eapol: &[u8]) {
+        let mut ethernet = Vec::with_capacity(14 + eapol.len());
+        ethernet.extend_from_slice(&STATION);
+        ethernet.extend_from_slice(&ap.bssid);
+        ethernet.extend_from_slice(&wifi::ETHERTYPE_EAPOL.to_be_bytes());
+        ethernet.extend_from_slice(eapol);
+        self.data(ap, &ethernet, false);
+    }
+
+    /// A nonce: nothing here is secret, only different each time.
+    fn nonce(salt: u8) -> [u8; 32] {
+        let mut nonce = [salt; 32];
+        nonce[..8].copy_from_slice(&crate::now_ms().to_le_bytes());
+        let digest = crypto::sha1(&[&nonce]);
+        nonce[8..28].copy_from_slice(&digest);
+        nonce
+    }
+
+    fn start_handshake(&self, state: &mut State, ap: &AccessPoint) {
+        let anonce = Self::nonce(0x5a);
+        state.replay += 1;
+        state.handshake = Handshake::Started { anonce };
+        let info = KEY_INFO_VERSION_AES | KEY_INFO_PAIRWISE | KEY_INFO_ACK;
+        self.send_eapol(ap, &Self::eapol_key(info, state.replay, &anonce, &[]));
+    }
+
+    /// Whether a frame's integrity code is right under `kck`.
+    fn mic_valid(eapol: &[u8], kck: &[u8]) -> bool {
+        let Some(mic) = eapol.get(81..97) else { return false };
+        let mut zeroed = eapol.to_vec();
+        zeroed[81..97].fill(0);
+        crypto::hmac_sha1(kck, &[&zeroed])[..16] == *mic
+    }
+
+    fn sign(eapol: &mut [u8], kck: &[u8]) {
+        let mic = crypto::hmac_sha1(kck, &[eapol]);
+        eapol[81..97].copy_from_slice(&mic[..16]);
+    }
+
+    /// A frame of the handshake from the station.
+    fn handshake(&self, state: &mut State, ap: &AccessPoint, eapol: &[u8]) {
+        if eapol.len() < EAPOL_KEY_HEADER || eapol[1] != 3 {
+            return;
+        }
+        let info = u16::from_be_bytes([eapol[5], eapol[6]]);
+        let snonce: [u8; 32] = eapol[17..49].try_into().unwrap();
+        match &state.handshake {
+            Handshake::Started { anonce } if info & KEY_INFO_MIC != 0 && info & KEY_INFO_SECURE == 0 => {
+                let anonce = *anonce;
+                let Some(passphrase) = ap.passphrase else { return };
+                let pmk = *state.pmk.get_or_insert_with(|| crypto::passphrase_key(passphrase, ap.ssid));
+                let mut data = Vec::with_capacity(76);
+                let (low, high) = if ap.bssid < STATION { (ap.bssid, STATION) } else { (STATION, ap.bssid) };
+                data.extend_from_slice(&low);
+                data.extend_from_slice(&high);
+                let (low, high) = if anonce < snonce { (anonce, snonce) } else { (snonce, anonce) };
+                data.extend_from_slice(&low);
+                data.extend_from_slice(&high);
+                let ptk: [u8; 48] = crypto::prf(&pmk, b"Pairwise key expansion", &data);
+                if !Self::mic_valid(eapol, &ptk[..16]) {
+                    ostd::notice!("sim: the station's passphrase is wrong");
+                    let frame = Self::management(wifi::DEAUTH, ap, &STATION, &15u16.to_le_bytes());
+                    self.reset(state);
+                    self.deliver(&frame, ap, false);
+                    return;
+                }
+                // The group key, in its key data element, after the RSN
+                // element the beacon carries; padded and wrapped.
+                let gtk = Self::nonce(0xc3);
+                let mut key_data = RSN.to_vec();
+                key_data.extend_from_slice(&[0xdd, 22, 0x00, 0x0f, 0xac, 1, 1, 0]);
+                key_data.extend_from_slice(&gtk[..16]);
+                if key_data.len() % 8 != 0 {
+                    key_data.push(0xdd);
+                    key_data.resize(key_data.len().next_multiple_of(8), 0);
+                }
+                let wrapped = crypto::key_wrap(aes128(ptk[16..32].try_into().unwrap()), &key_data);
+                state.replay += 1;
+                let info = KEY_INFO_VERSION_AES
+                    | KEY_INFO_PAIRWISE
+                    | KEY_INFO_INSTALL
+                    | KEY_INFO_ACK
+                    | KEY_INFO_MIC
+                    | KEY_INFO_SECURE
+                    | KEY_INFO_ENCRYPTED;
+                let mut message = Self::eapol_key(info, state.replay, &anonce, &wrapped);
+                Self::sign(&mut message, &ptk[..16]);
+                state.handshake = Handshake::Installing { ptk };
+                self.send_eapol(ap, &message);
+            }
+            Handshake::Installing { ptk } if info & KEY_INFO_SECURE != 0 => {
+                if Self::mic_valid(eapol, &ptk[..16]) {
+                    state.handshake = Handshake::Done;
+                }
+            }
+            _ => {}
+        }
+    }
+
+    fn reset(&self, state: &mut State) {
+        state.joined = None;
+        state.associated = false;
+        state.handshake = Handshake::None;
+        state.pairwise_key = false;
+        state.group_key = false;
+        state.authorized = false;
+    }
+}
+
+impl Radio for Sim {
+    fn start(&self) -> radio::Result<()> {
+        self.state.lock().up = true;
+        Ok(())
+    }
+
+    fn stop(&self) {
+        let mut state = self.state.lock();
+        self.reset(&mut state);
+        state.scan = None;
+        state.up = false;
+    }
+
+    fn scan(&self, request: &ScanRequest) -> radio::Result<()> {
+        let mut state = self.state.lock();
+        if !state.up {
+            return Err(radio::Error::Down);
+        }
+        if state.scan.is_some() {
+            return Err(radio::Error::Busy);
+        }
+        state.scan = Some((request.clone(), crate::now_ms() + SCAN_MS));
+        Ok(())
+    }
+
+    fn abort_scan(&self) {
+        if self.state.lock().scan.take().is_some() {
+            self.device().scan_done(true);
+        }
+    }
+
+    fn tick(&self, now_ms: u64) {
+        let request = {
+            let mut state = self.state.lock();
+            match &state.scan {
+                Some((_, due)) if now_ms >= *due => state.scan.take().map(|(request, _)| request),
+                _ => None,
+            }
+        };
+        let Some(request) = request else { return };
+        for ap in ACCESS_POINTS.iter().filter(|ap| request.freqs.contains(&ap.freq)) {
+            self.deliver(&Self::beacon(ap, false), ap, false);
+            let Some((_, channel)) = self.device().info.channel(ap.freq) else { continue };
+            // A probe request goes out only where the radio may send
+            // first, for any name or for this one.
+            let asked = request.ssids.iter().any(|ssid| ssid.is_empty() || ssid == ap.ssid);
+            if asked && !channel.passive {
+                self.deliver(&Self::beacon(ap, true), ap, false);
+            }
+        }
+        self.device().scan_done(false);
+    }
+
+    fn join(&self, network: &Join) -> radio::Result<()> {
+        let mut state = self.state.lock();
+        let index = ACCESS_POINTS.iter().position(|ap| ap.bssid == network.bssid).ok_or(radio::Error::Failed)?;
+        self.reset(&mut state);
+        state.joined = Some(index);
+        Ok(())
+    }
+
+    fn associated(&self, _association: &Association) -> radio::Result<()> {
+        Ok(())
+    }
+
+    fn leave(&self) {
+        let mut state = self.state.lock();
+        self.reset(&mut state);
+    }
+
+    fn set_key(&self, key: &Key) -> radio::Result<()> {
+        let mut state = self.state.lock();
+        if key.cipher != radio::CIPHER_CCMP || key.key.len() != 16 {
+            return Err(radio::Error::Unsupported);
+        }
+        if key.pairwise {
+            state.pairwise_key = true;
+        } else {
+            state.group_key = true;
+        }
+        Ok(())
+    }
+
+    fn remove_key(&self, _index: u8, pairwise: bool) {
+        let mut state = self.state.lock();
+        if pairwise {
+            state.pairwise_key = false;
+        } else {
+            state.group_key = false;
+        }
+    }
+
+    fn authorize(&self, authorized: bool) {
+        self.state.lock().authorized = authorized;
+    }
+
+    fn send_management(&self, frame: &[u8]) -> radio::Result<()> {
+        let mut state = self.state.lock();
+        let Some(ap) = state.joined.map(|index| &ACCESS_POINTS[index]) else {
+            return Err(radio::Error::Failed);
+        };
+        let Some((to, _, _)) = wifi::addresses(frame) else { return Err(radio::Error::Invalid) };
+        if to != ap.bssid {
+            return Ok(());
+        }
+        match wifi::kind(frame) {
+            Some(wifi::AUTH) => {
+                let Some((algorithm, transaction, _)) = wifi::parse_auth(frame) else { return Ok(()) };
+                // Only the open system: status 13 refuses the others.
+                let status: u16 = if algorithm == 0 && transaction == 1 { 0 } else { 13 };
+                let mut body = Vec::with_capacity(6);
+                body.extend_from_slice(&algorithm.to_le_bytes());
+                body.extend_from_slice(&transaction.wrapping_add(1).to_le_bytes());
+                body.extend_from_slice(&status.to_le_bytes());
+                self.deliver(&Self::management(wifi::AUTH, ap, &STATION, &body), ap, false);
+            }
+            Some(wifi::ASSOC_REQUEST | wifi::REASSOC_REQUEST) => {
+                let theirs = wifi::Elements(wifi::assoc_request_elements(frame));
+                // A WPA2 network takes only stations that ask for its
+                // ciphers and key management, whatever capabilities they
+                // add (status 40: invalid element).
+                let rsn_matches = match (theirs.get(wifi::IE_RSN), ap.passphrase) {
+                    (None, None) => true,
+                    (Some(rsn), Some(_)) => rsn.len() >= 18 && rsn[..18] == RSN[2..20],
+                    _ => false,
+                };
+                let named = theirs.get(wifi::IE_SSID) == Some(ap.ssid);
+                let status: u16 = if rsn_matches && named { 0 } else { 40 };
+                let capability = wifi::CAP_ESS | wifi::CAP_SHORT_SLOT | if ap.passphrase.is_some() { wifi::CAP_PRIVACY } else { 0 };
+                let mut body = Vec::with_capacity(96);
+                body.extend_from_slice(&capability.to_le_bytes());
+                body.extend_from_slice(&status.to_le_bytes());
+                body.extend_from_slice(&(1u16 | 0xc000).to_le_bytes());
+                body.extend_from_slice(&Self::elements(ap)[2 + ap.ssid.len()..]);
+                self.deliver(&Self::management(wifi::ASSOC_RESPONSE, ap, &STATION, &body), ap, false);
+                if status == 0 {
+                    state.associated = true;
+                    if ap.passphrase.is_some() {
+                        self.start_handshake(&mut state, ap);
+                    }
+                }
+            }
+            Some(wifi::DEAUTH | wifi::DISASSOC) => self.reset(&mut state),
+            _ => {}
+        }
+        Ok(())
+    }
+
+    fn send(&self, ethernet: &[u8], plain: bool) -> radio::Result<()> {
+        let mut state = self.state.lock();
+        let Some(ap) = state.joined.map(|index| &ACCESS_POINTS[index]).filter(|_| state.associated) else {
+            return Err(radio::Error::Failed);
+        };
+        if wifi::ethertype(ethernet) == Some(wifi::ETHERTYPE_EAPOL) {
+            self.handshake(&mut state, ap, &ethernet[14..]);
+            return Ok(());
+        }
+        // Data flows once the station was authorized, encrypted exactly
+        // where the network has keys.
+        let secured = ap.passphrase.is_some();
+        let ready = if secured { matches!(state.handshake, Handshake::Done) && state.pairwise_key && state.group_key } else { true };
+        if !state.authorized || !ready || plain == secured {
+            return Ok(());
+        }
+        if let Some(reply) = net::answer(ethernet, &ap.bssid) {
+            self.data(ap, &reply, secured);
+        }
+        Ok(())
+    }
+
+    fn link_stats(&self) -> LinkStats {
+        let state = self.state.lock();
+        match state.joined {
+            Some(index) if state.associated => LinkStats { signal: Some(ACCESS_POINTS[index].signal), tx_rate: Some(540) },
+            _ => LinkStats::default(),
+        }
+    }
+}
diff --git a/kernel/comps/wlan/src/sim/net.rs b/kernel/comps/wlan/src/sim/net.rs
new file mode 100755
index 0000000..184adc5
--- /dev/null
+++ b/kernel/comps/wlan/src/sim/net.rs
@@ -0,0 +1,196 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The little network behind a simulated access point: a gateway that
+//! answers ARP and pings, leases one address by DHCP and refuses TCP
+//! connections as a host without services does, enough for the kernel's
+//! network stack to bring the interface up as on a real network and for a
+//! test to see data go both ways.
+
+use alloc::vec::Vec;
+
+pub(crate) const GATEWAY: [u8; 4] = [10, 77, 0, 1];
+pub(crate) const CLIENT: [u8; 4] = [10, 77, 0, 2];
+const NETMASK: [u8; 4] = [255, 255, 255, 0];
+const LEASE_SECONDS: u32 = 3600;
+
+const ETHERTYPE_IPV4: u16 = 0x0800;
+const ETHERTYPE_ARP: u16 = 0x0806;
+
+fn checksum(bytes: &[u8]) -> u16 {
+    let mut sum: u32 = 0;
+    for pair in bytes.chunks(2) {
+        sum += u32::from(u16::from_be_bytes([pair[0], *pair.get(1).unwrap_or(&0)]));
+    }
+    while sum >> 16 != 0 {
+        sum = (sum & 0xffff) + (sum >> 16);
+    }
+    !(sum as u16)
+}
+
+fn ethernet(destination: &[u8], source: &[u8; 6], ethertype: u16, payload: &[u8]) -> Vec<u8> {
+    let mut frame = Vec::with_capacity(14 + payload.len());
+    frame.extend_from_slice(destination);
+    frame.extend_from_slice(source);
+    frame.extend_from_slice(&ethertype.to_be_bytes());
+    frame.extend_from_slice(payload);
+    frame
+}
+
+fn ipv4(protocol: u8, source: [u8; 4], destination: [u8; 4], payload: &[u8]) -> Vec<u8> {
+    let mut packet = Vec::with_capacity(20 + payload.len());
+    packet.extend_from_slice(&[0x45, 0]);
+    packet.extend_from_slice(&((20 + payload.len()) as u16).to_be_bytes());
+    packet.extend_from_slice(&[0, 0, 0x40, 0, 64, protocol, 0, 0]);
+    packet.extend_from_slice(&source);
+    packet.extend_from_slice(&destination);
+    let sum = checksum(&packet);
+    packet[10..12].copy_from_slice(&sum.to_be_bytes());
+    packet.extend_from_slice(payload);
+    packet
+}
+
+/// The gateway's answer to a frame from the station, if it has one.
+/// `mac` is the gateway's address (the access point's).
+pub(crate) fn answer(frame: &[u8], mac: &[u8; 6]) -> Option<Vec<u8>> {
+    let source = frame.get(6..12)?;
+    let payload = frame.get(14..)?;
+    match u16::from_be_bytes([frame[12], frame[13]]) {
+        ETHERTYPE_ARP => arp(payload, mac).map(|reply| ethernet(source, mac, ETHERTYPE_ARP, &reply)),
+        ETHERTYPE_IPV4 => {
+            let header = usize::from(payload.first()? & 0x0f) * 4;
+            let total = usize::from(u16::from_be_bytes([*payload.get(2)?, *payload.get(3)?]));
+            let body = payload.get(header..total)?;
+            let (from, to): ([u8; 4], [u8; 4]) = (payload[12..16].try_into().ok()?, payload[16..20].try_into().ok()?);
+            match payload[9] {
+                1 if to == GATEWAY => {
+                    // An echo request becomes its reply.
+                    if *body.first()? != 8 {
+                        return None;
+                    }
+                    let mut reply = body.to_vec();
+                    reply[0] = 0;
+                    reply[2..4].fill(0);
+                    let sum = checksum(&reply);
+                    reply[2..4].copy_from_slice(&sum.to_be_bytes());
+                    Some(ethernet(source, mac, ETHERTYPE_IPV4, &ipv4(1, GATEWAY, from, &reply)))
+                }
+                6 if to == GATEWAY => {
+                    let reset = tcp_reset(body, from)?;
+                    Some(ethernet(source, mac, ETHERTYPE_IPV4, &ipv4(6, GATEWAY, from, &reset)))
+                }
+                17 => {
+                    let (from_port, to_port) = (u16::from_be_bytes([*body.first()?, *body.get(1)?]), u16::from_be_bytes([*body.get(2)?, *body.get(3)?]));
+                    let datagram = |reply: &[u8]| {
+                        let mut datagram = Vec::with_capacity(8 + reply.len());
+                        datagram.extend_from_slice(&to_port.to_be_bytes());
+                        datagram.extend_from_slice(&from_port.to_be_bytes());
+                        datagram.extend_from_slice(&((8 + reply.len()) as u16).to_be_bytes());
+                        // No checksum, as IPv4 allows.
+                        datagram.extend_from_slice(&[0, 0]);
+                        datagram.extend_from_slice(reply);
+                        datagram
+                    };
+                    if (from_port, to_port) != (68, 67) {
+                        return None;
+                    }
+                    let reply = dhcp(body.get(8..)?)?;
+                    Some(ethernet(&[0xff; 6], mac, ETHERTYPE_IPV4, &ipv4(17, GATEWAY, [255; 4], &datagram(&reply))))
+                }
+                _ => None,
+            }
+        }
+        _ => None,
+    }
+}
+
+fn arp(request: &[u8], mac: &[u8; 6]) -> Option<Vec<u8>> {
+    let request = request.get(..28)?;
+    // Ethernet and IPv4, a request, for the gateway.
+    if request[..8] != [0, 1, 8, 0, 6, 4, 0, 1] || request[24..28] != GATEWAY {
+        return None;
+    }
+    let mut reply = Vec::with_capacity(28);
+    reply.extend_from_slice(&[0, 1, 8, 0, 6, 4, 0, 2]);
+    reply.extend_from_slice(mac);
+    reply.extend_from_slice(&GATEWAY);
+    reply.extend_from_slice(&request[8..18]);
+    Some(reply)
+}
+
+/// The reset that refuses a connection request (a segment with only
+/// SYN) from `peer`.
+fn tcp_reset(segment: &[u8], peer: [u8; 4]) -> Option<Vec<u8>> {
+    let header = segment.get(..20)?;
+    // SYN without ACK or RST.
+    if header[13] & 0x16 != 0x02 {
+        return None;
+    }
+    let sequence = u32::from_be_bytes(header[4..8].try_into().ok()?);
+    let mut reset = Vec::with_capacity(20);
+    reset.extend_from_slice(&header[2..4]);
+    reset.extend_from_slice(&header[0..2]);
+    reset.extend_from_slice(&0u32.to_be_bytes());
+    reset.extend_from_slice(&sequence.wrapping_add(1).to_be_bytes());
+    // A 20-byte header, RST and ACK, no window.
+    reset.extend_from_slice(&[0x50, 0x14, 0, 0, 0, 0, 0, 0]);
+    // The checksum covers the addresses, the protocol and the length.
+    let mut summed = Vec::with_capacity(32);
+    summed.extend_from_slice(&GATEWAY);
+    summed.extend_from_slice(&peer);
+    summed.extend_from_slice(&[0, 6, 0, 20]);
+    summed.extend_from_slice(&reset);
+    let sum = checksum(&summed);
+    reset[16..18].copy_from_slice(&sum.to_be_bytes());
+    Some(reset)
+}
+
+fn dhcp(request: &[u8]) -> Option<Vec<u8>> {
+    const COOKIE: [u8; 4] = [99, 130, 83, 99];
+    if request.len() < 240 || request[0] != 1 || request[236..240] != COOKIE {
+        return None;
+    }
+    let mut kind = None;
+    let mut options = &request[240..];
+    while let [code, rest @ ..] = options {
+        match *code {
+            0 => options = rest,
+            255 => break,
+            _ => {
+                let length = usize::from(*rest.first()?);
+                let value = rest.get(1..1 + length)?;
+                if *code == 53 {
+                    kind = value.first().copied();
+                }
+                options = &rest[1 + length..];
+            }
+        }
+    }
+    // A discover gets an offer, a request its acknowledgement.
+    let answer = match kind? {
+        1 => 2,
+        3 => 5,
+        _ => return None,
+    };
+    let mut reply = alloc::vec![0u8; 240];
+    reply[0] = 2;
+    reply[1..4].copy_from_slice(&request[1..4]);
+    reply[4..8].copy_from_slice(&request[4..8]);
+    reply[10..12].copy_from_slice(&request[10..12]);
+    reply[16..20].copy_from_slice(&CLIENT);
+    reply[20..24].copy_from_slice(&GATEWAY);
+    reply[28..44].copy_from_slice(&request[28..44]);
+    reply[236..240].copy_from_slice(&COOKIE);
+    reply.extend_from_slice(&[53, 1, answer]);
+    reply.extend_from_slice(&[54, 4]);
+    reply.extend_from_slice(&GATEWAY);
+    reply.extend_from_slice(&[51, 4]);
+    reply.extend_from_slice(&LEASE_SECONDS.to_be_bytes());
+    reply.extend_from_slice(&[1, 4]);
+    reply.extend_from_slice(&NETMASK);
+    reply.extend_from_slice(&[3, 4]);
+    reply.extend_from_slice(&GATEWAY);
+    reply.extend_from_slice(&[6, 4]);
+    reply.extend_from_slice(&GATEWAY);
+    reply.push(255);
+    Some(reply)
+}
