@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Generic netlink sockets (`NETLINK_GENERIC`).
+//!
+//! The families behind them (the controller, `nlctrl`, and nl80211, which
+//! runs Wi-Fi interfaces) live in the `aster-wlan` component: what a
+//! program writes goes to it as bytes, and the messages it answers with or
+//! reports as events come back here to be queued for the sockets.
+
+use alloc::vec::Vec;
+
+pub(super) use message::GenlMessage;
+
+use crate::net::socket::netlink::{
+    GroupIdSet,
+    addr::MAX_GROUPS,
+    common::NetlinkSocket,
+    table::{NetlinkGenericProtocol, SupportedNetlinkProtocol},
+};
+
+mod bound;
+mod message;
+
+pub(crate) type NetlinkGenericSocket = NetlinkSocket<NetlinkGenericProtocol>;
+
+fn unicast(port: u32, message: Vec<u8>) {
+    let _ = NetlinkGenericProtocol::unicast(port, GenlMessage::new(message));
+}
+
+/// To the sockets in a group, by the group's number (from 1).
+fn multicast(group: u32, message: Vec<u8>) {
+    if (1..=MAX_GROUPS).contains(&group) {
+        let _ = NetlinkGenericProtocol::multicast(GroupIdSet::new(1 << (group - 1)), GenlMessage::new(message));
+    }
+}
+
+pub(super) fn init() {
+    aster_wlan::genl::set_sink(aster_wlan::genl::Sink { unicast, multicast });
+}
