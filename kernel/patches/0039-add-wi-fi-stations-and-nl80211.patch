index 0000000..a1c79d9
--- /dev/null
+++ b/kernel/core/src/net/socket/netlink/generic/bound.rs
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: MPL-2.0
+
+use super::message::GenlMessage;
+use crate::{
+    events::IoEvents,
+    net::socket::{
+        netlink::{NetlinkSocketAddr, common::BoundNetlink},
+        util::{RecvFlags, RecvOutput, SendFlags, datagram_common},
+    },
+    prelude::*,
+    util::{MultiRead, MultiWrite},
+};
+
+pub(super) type BoundNetlinkGeneric = BoundNetlink<GenlMessage>;
+
+/// The most a program writes at once: requests are a few hundred bytes.
+const MAX_REQUEST: usize = 64 * 1024;
+
+impl datagram_common::Bound for BoundNetlinkGeneric {
+    type Endpoint = NetlinkSocketAddr;
+
+    fn local_endpoint(&self) -> Self::Endpoint {
+        self.handle.addr()
+    }
+
+    fn bind(&mut self, endpoint: &Self::Endpoint) -> Result<()> {
+        self.bind_common(endpoint)
+    }
+
+    fn remote_endpoint(&self) -> Option<&Self::Endpoint> {
+        Some(&self.remote_addr)
+    }
+
+    fn set_remote_endpoint(&mut self, endpoint: &Self::Endpoint) {
+        self.remote_addr = *endpoint;
+    }
+
+    fn try_send(
+        &self,
+        reader: &mut dyn MultiRead,
+        remote: &Self::Endpoint,
+        flags: SendFlags,
+    ) -> Result<usize> {
+        if !flags.is_all_supported() {
+            warn!("unsupported flags: {:?}", flags);
+        }
+
+        if *remote != NetlinkSocketAddr::new_unspecified() {
+            return_errno_with_message!(
+                Errno::ECONNREFUSED,
+                "sending generic netlink messages to user space is not supported"
+            );
+        }
+
+        let length = reader.sum_lens();
+        if length > MAX_REQUEST {
+            return_errno_with_message!(Errno::EMSGSIZE, "the generic netlink request is too long");
+        }
+        let mut bytes = vec![0u8; length];
+        reader.read(&mut VmWriter::from(bytes.as_mut_slice()))?;
+
+        // The families answer to this socket's port, through its queue.
+        // Requests that change something are for processes that
+        // administer the network.
+        let privileged = crate::net::socket::util::options::check_current_privileged().is_ok();
+        aster_wlan::genl::request(self.handle.port(), privileged, &bytes);
+
+        Ok(length)
+    }
+
+    fn try_recv(
+        &self,
+        writer: &mut dyn MultiWrite,
+        flags: RecvFlags,
+    ) -> Result<(RecvOutput, Self::Endpoint)> {
+        if !flags.is_all_supported() {
+            warn!("unsupported flags: {:?}", flags);
+        }
+
+        let mut receive_queue = self.receive_queue.lock();
+
+        receive_queue.dequeue_if(|response, response_len| {
+            let copied_len = response_len.min(writer.sum_lens());
+            response.write_to(writer)?;
+
+            let remote = NetlinkSocketAddr::new_unspecified();
+
+            let should_dequeue = flags.receive_behavior().will_consume_data();
+            let output = RecvOutput::new_for_packet(flags, copied_len, response_len);
+            Ok((should_dequeue, (output, remote)))
+        })
+    }
+
+    fn check_io_events(&self) -> IoEvents {
+        self.check_io_events_common()
+    }
+}
