+// SPDX-License-Identifier: MPL-2.0
+
+//! nl80211, the generic netlink family through which Linux programs run
+//! Wi-Fi interfaces: wpa_supplicant (and `iw`) list the radio's bands,
+//! scan, and make a link in steps (authenticate, associate, keys), each
+//! reported back as an event. The names and numbers are Linux's
+//! (`crate::consts`, generated from its header).
+
+use alloc::{sync::Arc, vec, vec::Vec};
+
+use crate::{
+    consts::*,
+    device::{self, AssocRequest, AuthRequest, Bss, Device, EINVAL},
+    genl::{self, EOPNOTSUPP, Family, Reply},
+    ieee80211::Address,
+    nl::{Attrs, Header, Message, Request},
+    radio::{self, BandId, Key, ScanRequest},
+};
+
+const ENODEV: i32 = 19;
+const ENOENT: i32 = 2;
+
+const VERSION: u8 = 1;
+
+/// The multicast groups, by the numbers of a socket's group mask.
+const GROUP_CONFIG: u32 = 17;
+const GROUP_SCAN: u32 = 18;
+const GROUP_REGULATORY: u32 = 19;
+const GROUP_MLME: u32 = 20;
+const GROUP_VENDOR: u32 = 21;
+
+/// The commands that take requests here; programs read the list to learn
+/// what the radio's driver can do (authenticate and associate: the
+/// supplicant runs the link's steps itself).
+const COMMANDS: [u32; 27] = [
+    NL80211_CMD_GET_WIPHY,
+    NL80211_CMD_SET_WIPHY,
+    NL80211_CMD_GET_INTERFACE,
+    NL80211_CMD_SET_INTERFACE,
+    NL80211_CMD_GET_KEY,
+    NL80211_CMD_SET_KEY,
+    NL80211_CMD_NEW_KEY,
+    NL80211_CMD_DEL_KEY,
+    NL80211_CMD_GET_STATION,
+    NL80211_CMD_SET_STATION,
+    NL80211_CMD_GET_REG,
+    NL80211_CMD_REQ_SET_REG,
+    NL80211_CMD_GET_SCAN,
+    NL80211_CMD_TRIGGER_SCAN,
+    NL80211_CMD_ABORT_SCAN,
+    NL80211_CMD_AUTHENTICATE,
+    NL80211_CMD_ASSOCIATE,
+    NL80211_CMD_DEAUTHENTICATE,
+    NL80211_CMD_DISASSOCIATE,
+    NL80211_CMD_GET_SURVEY,
+    NL80211_CMD_REGISTER_FRAME,
+    NL80211_CMD_SET_POWER_SAVE,
+    NL80211_CMD_GET_POWER_SAVE,
+    NL80211_CMD_GET_PROTOCOL_FEATURES,
+    NL80211_CMD_CONTROL_PORT_FRAME,
+    NL80211_CMD_SET_NOACK_MAP,
+    NL80211_CMD_SET_QOS_MAP,
+];
+
+pub(crate) static FAMILY: Family = Family {
+    id: genl::FAMILY_NL80211,
+    name: "nl80211",
+    version: VERSION,
+    max_attr: NL80211_ATTR_MAX,
+    commands: &COMMANDS,
+    groups: &[
+        ("config", GROUP_CONFIG),
+        ("scan", GROUP_SCAN),
+        ("regulatory", GROUP_REGULATORY),
+        ("mlme", GROUP_MLME),
+        ("vendor", GROUP_VENDOR),
+    ],
+};
+
+/// The steps of a link, as commands and as the events that answer them.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Mlme {
+    Authenticate,
+    Associate,
+    Deauthenticate,
+    Disassociate,
+    UnprotectedDeauthenticate,
+    UnprotectedDisassociate,
+}
+
+impl Mlme {
+    fn command(self) -> u32 {
+        match self {
+            Mlme::Authenticate => NL80211_CMD_AUTHENTICATE,
+            Mlme::Associate => NL80211_CMD_ASSOCIATE,
+            Mlme::Deauthenticate => NL80211_CMD_DEAUTHENTICATE,
+            Mlme::Disassociate => NL80211_CMD_DISASSOCIATE,
+            Mlme::UnprotectedDeauthenticate => NL80211_CMD_UNPROT_DEAUTHENTICATE,
+            Mlme::UnprotectedDisassociate => NL80211_CMD_UNPROT_DISASSOCIATE,
+        }
+    }
+
+    /// The event for a frame that came without the protection the link has.
+    pub(crate) fn unprotected(self) -> Self {
+        match self {
+            Mlme::Disassociate => Mlme::UnprotectedDisassociate,
+            _ => Mlme::UnprotectedDeauthenticate,
+        }
+    }
+}
+
+fn wdev(device: &Device) -> u64 {
+    ((device.index as u64) << 32) | 1
+}
+
+fn band_number(id: BandId) -> u32 {
+    match id {
+        BandId::Ghz2 => NL80211_BAND_2GHZ,
+        BandId::Ghz5 => NL80211_BAND_5GHZ,
+        BandId::Ghz6 => NL80211_BAND_6GHZ,
+    }
+}
+
+/// The device a request names: by its interface, its wireless device
+/// number or its radio.
+fn device_of(attrs: &Attrs) -> Result<Arc<Device>, i32> {
+    let devices = crate::devices();
+    let found = if let Some(ifindex) = attrs.u32(NL80211_ATTR_IFINDEX) {
+        devices.into_iter().find(|device| device.ifindex() == ifindex)
+    } else if let Some(wdev) = attrs.u64(NL80211_ATTR_WDEV) {
+        devices.into_iter().find(|device| device.index as u64 == wdev >> 32)
+    } else if let Some(index) = attrs.u32(NL80211_ATTR_WIPHY) {
+        devices.into_iter().find(|device| device.index == index)
+    } else {
+        None
+    };
+    found.ok_or(ENODEV)
+}
+
+// ---- Requests. ----
+
+/// Reading the radio's abilities, the networks heard and the link's state
+/// is anyone's, as on Linux; every other request is for a process that
+/// administers the network.
+fn open_to_all(command: u32) -> bool {
+    matches!(
+        command,
+        NL80211_CMD_GET_PROTOCOL_FEATURES
+            | NL80211_CMD_GET_WIPHY
+            | NL80211_CMD_GET_INTERFACE
+            | NL80211_CMD_GET_REG
+            | NL80211_CMD_GET_SCAN
+            | NL80211_CMD_GET_SURVEY
+            | NL80211_CMD_GET_STATION
+            | NL80211_CMD_GET_POWER_SAVE
+    )
+}
+
+pub(crate) fn request(port: u32, privileged: bool, request: &Request) -> Reply {
+    let attrs = &request.attrs;
+    if !privileged && !open_to_all(request.command as u32) {
+        return Reply::Error(genl::EPERM);
+    }
+    let result = match request.command as u32 {
+        NL80211_CMD_GET_PROTOCOL_FEATURES => {
+            let mut message = Message::reply(&request.header, NL80211_CMD_GET_PROTOCOL_FEATURES, VERSION);
+            message.u32(NL80211_ATTR_PROTOCOL_FEATURES, NL80211_PROTOCOL_FEATURE_SPLIT_WIPHY_DUMP);
+            Ok(vec![message.finish()])
+        }
+        NL80211_CMD_GET_WIPHY => get_wiphy(request),
+        NL80211_CMD_GET_INTERFACE => get_interface(request),
+        NL80211_CMD_SET_INTERFACE => device_of(attrs).and_then(|_| match attrs.u32(NL80211_ATTR_IFTYPE) {
+            None | Some(NL80211_IFTYPE_STATION) => Ok(Vec::new()),
+            Some(_) => Err(EOPNOTSUPP),
+        }),
+        NL80211_CMD_SET_WIPHY | NL80211_CMD_REGISTER_FRAME | NL80211_CMD_SET_POWER_SAVE | NL80211_CMD_SET_NOACK_MAP | NL80211_CMD_SET_QOS_MAP => {
+            device_of(attrs).map(|_| Vec::new())
+        }
+        NL80211_CMD_GET_POWER_SAVE => device_of(attrs).map(|_| {
+            let mut message = Message::reply(&request.header, NL80211_CMD_GET_POWER_SAVE, VERSION);
+            message.u32(NL80211_ATTR_PS_STATE, NL80211_PS_DISABLED);
+            vec![message.finish()]
+        }),
+        NL80211_CMD_GET_REG => Ok(vec![regulatory(&request.header)]),
+        // The channels allowed are the chip's own regulatory data.
+        NL80211_CMD_REQ_SET_REG => Ok(Vec::new()),
+        NL80211_CMD_TRIGGER_SCAN => trigger_scan(attrs),
+        NL80211_CMD_ABORT_SCAN => device_of(attrs).and_then(|device| device.abort_scan().map(|()| Vec::new())),
+        NL80211_CMD_GET_SCAN => get_scan(request),
+        NL80211_CMD_GET_SURVEY => device_of(attrs).map(|_| Vec::new()),
+        NL80211_CMD_AUTHENTICATE => authenticate(attrs),
+        NL80211_CMD_ASSOCIATE => associate(port, attrs),
+        NL80211_CMD_DEAUTHENTICATE | NL80211_CMD_DISASSOCIATE => leave(request.command as u32, attrs),
+        NL80211_CMD_NEW_KEY => new_key(attrs),
+        NL80211_CMD_DEL_KEY => del_key(attrs),
+        // The key a group's frames use is the one last installed.
+        NL80211_CMD_SET_KEY => device_of(attrs).map(|_| Vec::new()),
+        NL80211_CMD_GET_KEY => device_of(attrs).and(Err(ENOENT)),
+        NL80211_CMD_SET_STATION => set_station(attrs),
+        NL80211_CMD_GET_STATION => get_station(request),
+        NL80211_CMD_CONTROL_PORT_FRAME => control_port_send(attrs),
+        _ => Err(EOPNOTSUPP),
+    };
+    match result {
+        Ok(messages) => Reply::Messages(messages),
+        Err(errno) => Reply::Error(errno),
+    }
+}
+
+/// The socket bound to `port` closed.
+pub(crate) fn released(port: u32) {
+    for device in crate::devices() {
+        device.released(port);
+    }
+}
+
+fn wiphy_header(device: &Device, request: &Header) -> Message {
+    let mut message = Message::reply(request, NL80211_CMD_NEW_WIPHY, VERSION);
+    message
+        .u32(NL80211_ATTR_WIPHY, device.index)
+        .str(NL80211_ATTR_WIPHY_NAME, &alloc::format!("phy{}", device.index))
+        .u32(NL80211_ATTR_GENERATION, 1);
+    message
+}
+
+fn put_general(device: &Device, message: &mut Message) {
+    let info = &device.info;
+    message
+        .u8(NL80211_ATTR_WIPHY_RETRY_SHORT, 7)
+        .u8(NL80211_ATTR_WIPHY_RETRY_LONG, 4)
+        .u32(NL80211_ATTR_WIPHY_FRAG_THRESHOLD, u32::MAX)
+        .u32(NL80211_ATTR_WIPHY_RTS_THRESHOLD, u32::MAX)
+        .u8(NL80211_ATTR_WIPHY_COVERAGE_CLASS, 0)
+        .u8(NL80211_ATTR_MAX_NUM_SCAN_SSIDS, info.max_scan_ssids)
+        .u16(NL80211_ATTR_MAX_SCAN_IE_LEN, info.max_scan_ie_len)
+        .u8(NL80211_ATTR_MAX_NUM_PMKIDS, 0);
+    let mut ciphers = Vec::with_capacity(info.ciphers.len() * 4);
+    for cipher in &info.ciphers {
+        ciphers.extend_from_slice(&cipher.to_ne_bytes());
+    }
+    message.put(NL80211_ATTR_CIPHER_SUITES, &ciphers);
+    message.nest(NL80211_ATTR_SUPPORTED_IFTYPES, |message| {
+        message.flag(NL80211_IFTYPE_STATION);
+    });
+}
+
+fn put_bands(bands: &[radio::Band], message: &mut Message) {
+    message.nest(NL80211_ATTR_WIPHY_BANDS, |message| {
+        for band in bands {
+            message.nest(band_number(band.id), |message| put_band(band, message));
+        }
+    });
+}
+
+fn put_band(band: &radio::Band, message: &mut Message) {
+    if let Some(ht) = &band.ht {
+        message
+            .put(NL80211_BAND_ATTR_HT_MCS_SET, &ht.mcs)
+            .u16(NL80211_BAND_ATTR_HT_CAPA, ht.info)
+            .u8(NL80211_BAND_ATTR_HT_AMPDU_FACTOR, ht.ampdu_factor)
+            .u8(NL80211_BAND_ATTR_HT_AMPDU_DENSITY, ht.ampdu_density);
+    }
+    if let Some(vht) = &band.vht {
+        message.put(NL80211_BAND_ATTR_VHT_MCS_SET, &vht.mcs).u32(NL80211_BAND_ATTR_VHT_CAPA, vht.info);
+    }
+    if let Some(he) = &band.he {
+        message.nest(NL80211_BAND_ATTR_IFTYPE_DATA, |message| {
+            message.nest(1, |message| {
+                message.nest(NL80211_BAND_IFTYPE_ATTR_IFTYPES, |message| {
+                    message.flag(NL80211_IFTYPE_STATION);
+                });
+                message
+                    .put(NL80211_BAND_IFTYPE_ATTR_HE_CAP_MAC, &he.mac)
+                    .put(NL80211_BAND_IFTYPE_ATTR_HE_CAP_PHY, &he.phy)
+                    .put(NL80211_BAND_IFTYPE_ATTR_HE_CAP_MCS_SET, &he.mcs)
+                    .put(NL80211_BAND_IFTYPE_ATTR_HE_CAP_PPE, &he.ppe);
+            });
+        });
+    }
+    message.nest(NL80211_BAND_ATTR_FREQS, |message| {
+        for (index, channel) in band.channels.iter().enumerate() {
+            message.nest(index as u32, |message| {
+                message.u32(NL80211_FREQUENCY_ATTR_FREQ, channel.freq as u32);
+                if channel.disabled {
+                    message.flag(NL80211_FREQUENCY_ATTR_DISABLED);
+                    return;
+                }
+                if channel.passive {
+                    message.flag(NL80211_FREQUENCY_ATTR_NO_IR);
+                }
+                if channel.radar {
+                    message.flag(NL80211_FREQUENCY_ATTR_RADAR);
+                }
+                message.u32(NL80211_FREQUENCY_ATTR_MAX_TX_POWER, channel.max_power as u32 * 100);
+            });
+        }
+    });
+    message.nest(NL80211_BAND_ATTR_RATES, |message| {
+        for (index, rate) in band.id.rates().iter().enumerate() {
+            message.nest(index as u32, |message| {
+                // In units of 100 kbit/s.
+                message.u32(NL80211_BITRATE_ATTR_RATE, *rate as u32 * 5);
+            });
+        }
+    });
+}
+
+fn put_abilities(device: &Device, message: &mut Message) {
+    message.nest(NL80211_ATTR_SUPPORTED_COMMANDS, |message| {
+        for (index, command) in COMMANDS.iter().enumerate() {
+            message.u32(index as u32 + 1, *command);
+        }
+    });
+    message.u32(NL80211_ATTR_FEATURE_FLAGS, NL80211_FEATURE_SAE | NL80211_FEATURE_SCAN_FLUSH);
+    // The frames that authenticate a link go through the supplicant's
+    // socket, both ways, never through packet sockets (the kernel has
+    // none): the three features that make wpa_supplicant do without one.
+    let mut features = [0u8; (NUM_NL80211_EXT_FEATURES as usize).div_ceil(8)];
+    let mut set = |feature: u32| features[feature as usize / 8] |= 1 << (feature % 8);
+    set(NL80211_EXT_FEATURE_CONTROL_PORT_OVER_NL80211);
+    set(NL80211_EXT_FEATURE_CONTROL_PORT_NO_PREAUTH);
+    set(NL80211_EXT_FEATURE_CONTROL_PORT_OVER_NL80211_TX_STATUS);
+    if device.info.protects_management() {
+        set(NL80211_EXT_FEATURE_MFP_OPTIONAL);
+    }
+    message.put(NL80211_ATTR_EXT_FEATURES, &features);
+    message.put(NL80211_ATTR_MAC, &device.info.address);
+}
+
+fn wiphy_messages(device: &Device, request: &Header, split: bool) -> Vec<Vec<u8>> {
+    if !split {
+        let mut message = wiphy_header(device, request);
+        put_general(device, &mut message);
+        put_bands(&device.info.bands, &mut message);
+        put_abilities(device, &mut message);
+        return vec![message.finish()];
+    }
+    let mut messages = Vec::new();
+    let mut message = wiphy_header(device, request);
+    put_general(device, &mut message);
+    messages.push(message.finish());
+    for band in &device.info.bands {
+        let mut message = wiphy_header(device, request);
+        put_bands(core::slice::from_ref(band), &mut message);
+        messages.push(message.finish());
+    }
+    let mut message = wiphy_header(device, request);
+    put_abilities(device, &mut message);
+    messages.push(message.finish());
+    messages
+}
+
+fn get_wiphy(request: &Request) -> Result<Vec<Vec<u8>>, i32> {
+    let attrs = &request.attrs;
+    let named = attrs.has(NL80211_ATTR_WIPHY) || attrs.has(NL80211_ATTR_IFINDEX) || attrs.has(NL80211_ATTR_WDEV);
+    if !request.header.dump() {
+        let device = device_of(attrs)?;
+        return Ok(wiphy_messages(&device, &request.header, false));
+    }
+    let split = attrs.has(NL80211_ATTR_SPLIT_WIPHY_DUMP);
+    let devices = if named { vec![device_of(attrs)?] } else { crate::devices() };
+    Ok(devices.iter().flat_map(|device| wiphy_messages(device, &request.header, split)).collect())
+}
+
+fn interface_message(device: &Device, request: &Header) -> Vec<u8> {
+    let mut message = Message::reply(request, NL80211_CMD_NEW_INTERFACE, VERSION);
+    message
+        .u32(NL80211_ATTR_IFINDEX, device.ifindex())
+        .str(NL80211_ATTR_IFNAME, &device.name)
+        .u32(NL80211_ATTR_WIPHY, device.index)
+        .u32(NL80211_ATTR_IFTYPE, NL80211_IFTYPE_STATION)
+        .u64(NL80211_ATTR_WDEV, wdev(device))
+        .put(NL80211_ATTR_MAC, &device.info.address)
+        .u32(NL80211_ATTR_GENERATION, 1)
+        .u8(NL80211_ATTR_4ADDR, 0);
+    if let Some(link) = device.link_info().filter(|link| link.associated) {
+        message
+            .put(NL80211_ATTR_SSID, &link.ssid)
+            .u32(NL80211_ATTR_WIPHY_FREQ, link.freq as u32)
+            .u32(NL80211_ATTR_CHANNEL_WIDTH, NL80211_CHAN_WIDTH_20)
+            .u32(NL80211_ATTR_CENTER_FREQ1, link.freq as u32);
+    }
+    message.finish()
+}
+
+fn get_interface(request: &Request) -> Result<Vec<Vec<u8>>, i32> {
+    if request.header.dump() {
+        return Ok(crate::devices().iter().map(|device| interface_message(device, &request.header)).collect());
+    }
+    let device = device_of(&request.attrs)?;
+    Ok(vec![interface_message(&device, &request.header)])
+}
+
+/// The world's regulatory domain, as Linux describes it: each chip's own
+/// data narrows it further, channel by channel.
+fn regulatory(request: &Header) -> Vec<u8> {
+    // Start and end in MHz, the widest channel in MHz, the most power in
+    // dBm, flags.
+    const RULES: [(u32, u32, u32, u32, u32); 7] = [
+        (2402, 2472, 40, 20, 0),
+        (2457, 2482, 20, 20, NL80211_RRF_NO_IR),
+        (5170, 5250, 80, 20, NL80211_RRF_NO_IR),
+        (5250, 5330, 80, 20, NL80211_RRF_NO_IR | NL80211_RRF_DFS),
+        (5490, 5730, 160, 20, NL80211_RRF_NO_IR | NL80211_RRF_DFS),
+        (5735, 5835, 80, 20, NL80211_RRF_NO_IR),
+        (5925, 7125, 320, 12, NL80211_RRF_NO_IR | NL80211_RRF_NO_OUTDOOR),
+    ];
+    let mut message = Message::reply(request, NL80211_CMD_GET_REG, VERSION);
+    message.str(NL80211_ATTR_REG_ALPHA2, "00");
+    message.nest(NL80211_ATTR_REG_RULES, |message| {
+        for (index, (start, end, width, power, flags)) in RULES.iter().enumerate() {
+            message.nest(index as u32, |message| {
+                message
+                    .u32(NL80211_ATTR_REG_RULE_FLAGS, *flags)
+                    .u32(NL80211_ATTR_FREQ_RANGE_START, start * 1000)
+                    .u32(NL80211_ATTR_FREQ_RANGE_END, end * 1000)
+                    .u32(NL80211_ATTR_FREQ_RANGE_MAX_BW, width * 1000)
+                    .u32(NL80211_ATTR_POWER_RULE_MAX_ANT_GAIN, 0)
+                    .u32(NL80211_ATTR_POWER_RULE_MAX_EIRP, power * 100);
+            });
+        }
+    });
+    message.finish()
+}
+
+fn trigger_scan(attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(attrs)?;
+    let info = &device.info;
+    let mut request = ScanRequest::default();
+    if let Some(ssids) = attrs.nested(NL80211_ATTR_SCAN_SSIDS) {
+        for (_, ssid) in ssids.iter() {
+            if ssid.len() > 32 || request.ssids.len() >= info.max_scan_ssids as usize {
+                return Err(EINVAL);
+            }
+            request.ssids.push(ssid.to_vec());
+        }
+    }
+    if let Some(elements) = attrs.get(NL80211_ATTR_IE) {
+        if elements.len() > info.max_scan_ie_len as usize {
+            return Err(EINVAL);
+        }
+        request.elements = elements.to_vec();
+    }
+    let usable = |freq: u16| info.channel(freq).is_some_and(|(_, channel)| !channel.disabled);
+    match attrs.nested(NL80211_ATTR_SCAN_FREQUENCIES) {
+        Some(freqs) => {
+            for (_, value) in freqs.iter() {
+                let Some(freq) = value.get(..4).and_then(|bytes| bytes.try_into().ok()).map(u32::from_ne_bytes) else {
+                    return Err(EINVAL);
+                };
+                let freq = u16::try_from(freq).map_err(|_| EINVAL)?;
+                if usable(freq) && !request.freqs.contains(&freq) {
+                    request.freqs.push(freq);
+                }
+            }
+            if request.freqs.is_empty() {
+                return Err(EINVAL);
+            }
+        }
+        None => {
+            for band in &info.bands {
+                request.freqs.extend(band.channels.iter().filter(|channel| !channel.disabled).map(|channel| channel.freq));
+            }
+        }
+    }
+    let flush = attrs.u32(NL80211_ATTR_SCAN_FLAGS).is_some_and(|flags| flags & NL80211_SCAN_FLAG_FLUSH != 0);
+    device.scan(request, flush)?;
+    Ok(Vec::new())
+}
+
+fn bss_message(device: &Device, request: &Header, bss: &Bss, generation: u32, current: Option<(Address, bool)>, now: u64) -> Vec<u8> {
+    let mut message = Message::reply(request, NL80211_CMD_NEW_SCAN_RESULTS, VERSION);
+    message
+        .u32(NL80211_ATTR_GENERATION, generation)
+        .u32(NL80211_ATTR_IFINDEX, device.ifindex())
+        .u64(NL80211_ATTR_WDEV, wdev(device));
+    message.nest(NL80211_ATTR_BSS, |message| {
+        message
+            .put(NL80211_BSS_BSSID, &bss.bssid)
+            .u64(NL80211_BSS_TSF, bss.timestamp)
+            .put(NL80211_BSS_INFORMATION_ELEMENTS, &bss.elements);
+        if let Some(elements) = &bss.beacon_elements {
+            message.put(NL80211_BSS_BEACON_IES, elements);
+        }
+        message
+            .u16(NL80211_BSS_BEACON_INTERVAL, bss.interval)
+            .u16(NL80211_BSS_CAPABILITY, bss.capability)
+            .u32(NL80211_BSS_FREQUENCY, bss.freq as u32)
+            .u32(NL80211_BSS_SIGNAL_MBM, (bss.signal as i32 * 100) as u32)
+            .u32(NL80211_BSS_SEEN_MS_AGO, now.saturating_sub(bss.seen).min(u32::MAX as u64) as u32)
+            .u64(NL80211_BSS_LAST_SEEN_BOOTTIME, bss.seen * 1_000_000);
+        match current {
+            Some((bssid, associated)) if bssid == bss.bssid => {
+                message.u32(NL80211_BSS_STATUS, if associated { NL80211_BSS_STATUS_ASSOCIATED } else { NL80211_BSS_STATUS_AUTHENTICATED });
+            }
+            _ => {}
+        }
+    });
+    message.finish()
+}
+
+fn get_scan(request: &Request) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(&request.attrs)?;
+    let (networks, generation, current) = device.networks();
+    let now = crate::now_ms();
+    Ok(networks.iter().map(|bss| bss_message(&device, &request.header, bss, generation, current, now)).collect())
+}
+
+fn authenticate(attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(attrs)?;
+    let bssid: Address = attrs.array(NL80211_ATTR_MAC).ok_or(EINVAL)?;
+    let algorithm = match attrs.u32(NL80211_ATTR_AUTH_TYPE).ok_or(EINVAL)? {
+        NL80211_AUTHTYPE_OPEN_SYSTEM => device::ALGORITHM_OPEN,
+        NL80211_AUTHTYPE_FT => 2,
+        NL80211_AUTHTYPE_NETWORK_EAP => 0x80,
+        NL80211_AUTHTYPE_SAE => device::ALGORITHM_SAE,
+        // WEP's shared key and FILS are not run.
+        _ => return Err(EOPNOTSUPP),
+    };
+    let data = attrs.get(NL80211_ATTR_AUTH_DATA).unwrap_or(&[]);
+    if algorithm == device::ALGORITHM_SAE && data.len() < 4 {
+        return Err(EINVAL);
+    }
+    device.authenticate(AuthRequest {
+        bssid,
+        algorithm,
+        data: data.to_vec(),
+        elements: attrs.get(NL80211_ATTR_IE).unwrap_or(&[]).to_vec(),
+    })?;
+    Ok(Vec::new())
+}
+
+fn associate(port: u32, attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(attrs)?;
+    let bssid: Address = attrs.array(NL80211_ATTR_MAC).ok_or(EINVAL)?;
+    let protect_management = attrs.u32(NL80211_ATTR_USE_MFP).is_some_and(|mfp| mfp != NL80211_MFP_NO);
+    if protect_management && !device.info.protects_management() {
+        return Err(EOPNOTSUPP);
+    }
+    let legacy_cipher = attrs.get(NL80211_ATTR_CIPHER_SUITES_PAIRWISE).is_some_and(|suites| {
+        suites
+            .chunks_exact(4)
+            .map(|suite| u32::from_ne_bytes(suite.try_into().unwrap()))
+            .any(|suite| matches!(suite, radio::CIPHER_TKIP | radio::CIPHER_WEP40 | radio::CIPHER_WEP104))
+    });
+    let owner = attrs.has(NL80211_ATTR_SOCKET_OWNER).then_some(port);
+    let control_port = if attrs.has(NL80211_ATTR_CONTROL_PORT_OVER_NL80211) {
+        // The frames go to the socket that owns the link.
+        Some(owner.ok_or(EINVAL)?)
+    } else {
+        None
+    };
+    device.associate(AssocRequest {
+        bssid,
+        elements: attrs.get(NL80211_ATTR_IE).unwrap_or(&[]).to_vec(),
+        previous: attrs.array(NL80211_ATTR_PREV_BSSID),
+        legacy_cipher,
+        protect_management,
+        control_port,
+        owner,
+    })?;
+    Ok(Vec::new())
+}
+
+fn leave(command: u32, attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(attrs)?;
+    let bssid: Address = attrs.array(NL80211_ATTR_MAC).ok_or(EINVAL)?;
+    let reason = attrs.u16(NL80211_ATTR_REASON_CODE).ok_or(EINVAL)?;
+    if reason == 0 {
+        return Err(EINVAL);
+    }
+    let silent = attrs.has(NL80211_ATTR_LOCAL_STATE_CHANGE);
+    device.leave(&bssid, reason, command == NL80211_CMD_DISASSOCIATE, silent)?;
+    Ok(Vec::new())
+}
+
+/// A key's description: nested in one attribute, or (older programs) as
+/// attributes of the request itself.
+struct KeySpec<'a> {
+    index: u8,
+    cipher: Option<u32>,
+    data: Option<&'a [u8]>,
+    seq: &'a [u8],
+    kind: Option<u32>,
+}
+
+fn key_spec<'a>(attrs: &Attrs<'a>) -> KeySpec<'a> {
+    match attrs.nested(NL80211_ATTR_KEY) {
+        Some(key) => KeySpec {
+            index: key.u8(NL80211_KEY_IDX).unwrap_or(0),
+            cipher: key.u32(NL80211_KEY_CIPHER),
+            data: key.get(NL80211_KEY_DATA),
+            seq: key.get(NL80211_KEY_SEQ).unwrap_or(&[]),
+            kind: key.u32(NL80211_KEY_TYPE),
+        },
+        None => KeySpec {
+            index: attrs.u8(NL80211_ATTR_KEY_IDX).unwrap_or(0),
+            cipher: attrs.u32(NL80211_ATTR_KEY_CIPHER),
+            data: attrs.get(NL80211_ATTR_KEY_DATA),
+            seq: attrs.get(NL80211_ATTR_KEY_SEQ).unwrap_or(&[]),
+            kind: attrs.u32(NL80211_ATTR_KEY_TYPE),
+        },
+    }
+}
+
+/// Whether a key is the one between this station and one other (the
+/// access point): it has that station's address, and is not marked as a
+/// group's.
+fn pairwise(attrs: &Attrs, spec: &KeySpec) -> bool {
+    match spec.kind {
+        Some(NL80211_KEYTYPE_PAIRWISE) => true,
+        Some(_) => false,
+        None => attrs.array::<6>(NL80211_ATTR_MAC).is_some_and(|address| address != [0xff; 6]),
+    }
+}
+
+fn new_key(attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(attrs)?;
+    let spec = key_spec(attrs);
+    let (Some(cipher), Some(data)) = (spec.cipher, spec.data) else {
+        return Err(EINVAL);
+    };
+    // Indexes 0 to 3 hold data keys, 4 and 5 the management group's, 6
+    // and 7 the beacons'.
+    if spec.index > 7 || data.is_empty() || data.len() > 32 || spec.seq.len() > 16 {
+        return Err(EINVAL);
+    }
+    device.set_key(Key { index: spec.index, cipher, pairwise: pairwise(attrs, &spec), key: data.to_vec(), seq: spec.seq.to_vec() })?;
+    Ok(Vec::new())
+}
+
+fn del_key(attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(attrs)?;
+    let spec = key_spec(attrs);
+    device.remove_key(spec.index, pairwise(attrs, &spec))?;
+    Ok(Vec::new())
+}
+
+fn set_station(attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(attrs)?;
+    let bssid: Address = attrs.array(NL80211_ATTR_MAC).ok_or(EINVAL)?;
+    // A mask of the flags to change, and their new values.
+    let Some(flags) = attrs.get(NL80211_ATTR_STA_FLAGS2).filter(|flags| flags.len() >= 8) else {
+        return Ok(Vec::new());
+    };
+    let mask = u32::from_ne_bytes(flags[0..4].try_into().unwrap());
+    let set = u32::from_ne_bytes(flags[4..8].try_into().unwrap());
+    let authorized = 1u32 << NL80211_STA_FLAG_AUTHORIZED;
+    if mask & authorized != 0 {
+        device.authorize(&bssid, set & authorized != 0)?;
+    }
+    Ok(Vec::new())
+}
+
+fn station_message(device: &Device, request: &Header, bssid: &Address, stats: &radio::LinkStats) -> Vec<u8> {
+    let mut message = Message::reply(request, NL80211_CMD_NEW_STATION, VERSION);
+    message.u32(NL80211_ATTR_IFINDEX, device.ifindex()).put(NL80211_ATTR_MAC, bssid).u32(NL80211_ATTR_GENERATION, 1);
+    message.nest(NL80211_ATTR_STA_INFO, |message| {
+        if let Some(signal) = stats.signal {
+            message.u8(NL80211_STA_INFO_SIGNAL, signal as u8).u8(NL80211_STA_INFO_SIGNAL_AVG, signal as u8);
+        }
+        if let Some(rate) = stats.tx_rate {
+            message.nest(NL80211_STA_INFO_TX_BITRATE, |message| {
+                message.u32(NL80211_RATE_INFO_BITRATE32, rate);
+                if let Ok(rate) = u16::try_from(rate) {
+                    message.u16(NL80211_RATE_INFO_BITRATE, rate);
+                }
+            });
+        }
+    });
+    message.finish()
+}
+
+fn get_station(request: &Request) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(&request.attrs)?;
+    let link = device.link_stats();
+    if request.header.dump() {
+        return Ok(link.iter().map(|(bssid, stats)| station_message(&device, &request.header, bssid, stats)).collect());
+    }
+    let wanted: Address = request.attrs.array(NL80211_ATTR_MAC).ok_or(EINVAL)?;
+    match link {
+        Some((bssid, stats)) if bssid == wanted => Ok(vec![station_message(&device, &request.header, &bssid, &stats)]),
+        _ => Err(ENOENT),
+    }
+}
+
+fn control_port_send(attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(attrs)?;
+    let destination: Address = attrs.array(NL80211_ATTR_MAC).ok_or(EINVAL)?;
+    let ethertype = attrs.u16(NL80211_ATTR_CONTROL_PORT_ETHERTYPE).ok_or(EINVAL)?;
+    let payload = attrs.get(NL80211_ATTR_FRAME).ok_or(EINVAL)?;
+    if payload.is_empty() || payload.len() > 2304 {
+        return Err(EINVAL);
+    }
+    device.control_port_send(&destination, ethertype, payload, attrs.has(NL80211_ATTR_CONTROL_PORT_NO_ENCRYPT))?;
+    Ok(Vec::new())
+}
+
+// ---- Events. ----
+
+fn event(device: &Device, command: u32) -> Message {
+    let mut message = Message::new(genl::FAMILY_NL80211, 0, 0, 0, command, VERSION);
+    message
+        .u32(NL80211_ATTR_WIPHY, device.index)
+        .u32(NL80211_ATTR_IFINDEX, device.ifindex())
+        .u64(NL80211_ATTR_WDEV, wdev(device));
+    message
+}
+
+pub(crate) fn scan_started(device: &Device) {
+    genl::multicast(GROUP_SCAN, event(device, NL80211_CMD_TRIGGER_SCAN).finish());
+}
+
+pub(crate) fn scan_finished(device: &Device, aborted: bool) {
+    let command = if aborted { NL80211_CMD_SCAN_ABORTED } else { NL80211_CMD_NEW_SCAN_RESULTS };
+    genl::multicast(GROUP_SCAN, event(device, command).finish());
+}
+
+/// A management frame of the link: the access point's answer, or the one
+/// that ended it (from either side).
+pub(crate) fn mlme_frame(device: &Device, step: Mlme, frame: &[u8], request_elements: Option<&[u8]>) {
+    let mut message = event(device, step.command());
+    message.put(NL80211_ATTR_FRAME, frame);
+    if let Some(elements) = request_elements {
+        message.put(NL80211_ATTR_REQ_IE, elements);
+    }
+    genl::multicast(GROUP_MLME, message.finish());
+}
+
+/// The access point did not answer a step.
+pub(crate) fn mlme_timeout(device: &Device, step: Mlme, bssid: &Address) {
+    let mut message = event(device, step.command());
+    message.flag(NL80211_ATTR_TIMED_OUT).put(NL80211_ATTR_MAC, bssid);
+    genl::multicast(GROUP_MLME, message.finish());
+}
+
+/// A frame for the supplicant (EAPOL), to the socket that owns the link.
+pub(crate) fn control_port_frame(device: &Device, port: u32, ethernet: &[u8], unencrypted: bool) {
+    if ethernet.len() < 14 {
+        return;
+    }
+    let mut message = event(device, NL80211_CMD_CONTROL_PORT_FRAME);
+    message
+        .put(NL80211_ATTR_FRAME, &ethernet[14..])
+        .put(NL80211_ATTR_MAC, &ethernet[6..12])
+        .u16(NL80211_ATTR_CONTROL_PORT_ETHERTYPE, u16::from_be_bytes([ethernet[12], ethernet[13]]));
+    if unencrypted {
+        message.flag(NL80211_ATTR_CONTROL_PORT_NO_ENCRYPT);
+    }
+    genl::unicast(port, message.finish());
+}
+
+/// A radio appeared.
+pub(crate) fn device_added(device: &Device) {
+    let header = Header::default();
+    let mut message = Message::new(genl::FAMILY_NL80211, 0, 0, 0, NL80211_CMD_NEW_WIPHY, VERSION);
+    message.u32(NL80211_ATTR_WIPHY, device.index).str(NL80211_ATTR_WIPHY_NAME, &alloc::format!("phy{}", device.index));
+    genl::multicast(GROUP_CONFIG, message.finish());
+    let mut interface = interface_message(device, &header);
+    // An event of the family, not an answer: its type is the family's.
+    interface[4..6].copy_from_slice(&genl::FAMILY_NL80211.to_ne_bytes());
+    genl::multicast(GROUP_CONFIG, interface);
+}
