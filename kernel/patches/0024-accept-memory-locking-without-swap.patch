diff --git a/kernel/core/src/syscall/mlock.rs b/kernel/core/src/syscall/mlock.rs
new file mode 100644
index 0000000..033307a
--- /dev/null
+++ b/kernel/core/src/syscall/mlock.rs
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! `mlock`, `mlock2`, `munlock`, `mlockall` and `munlockall`.
+//!
+//! The kernel never swaps user memory out: every page that is resident stays
+//! resident, which is all that locking promises. The calls check their
+//! arguments as Linux does and succeed, so that programs that keep secrets
+//! only in locked memory (password prompts, key agents) run.
+
+use super::SyscallReturn;
+use crate::{prelude::*, vm::vmar::VMAR_CAP_ADDR};
+
+const MLOCK_ONFAULT: u32 = 0x01;
+const MCL_CURRENT: i32 = 1;
+const MCL_FUTURE: i32 = 2;
+const MCL_ONFAULT: i32 = 4;
+
+fn check_range(addr: Vaddr, len: usize) -> Result<()> {
+    if VMAR_CAP_ADDR.checked_sub(addr).is_none_or(|gap| gap < len) {
+        return_errno_with_message!(Errno::ENOMEM, "the range is not in userspace");
+    }
+    Ok(())
+}
+
+pub(super) fn sys_mlock(addr: Vaddr, len: usize, _ctx: &Context) -> Result<SyscallReturn> {
+    check_range(addr, len)?;
+    Ok(SyscallReturn::Return(0))
+}
+
+pub(super) fn sys_mlock2(addr: Vaddr, len: usize, flags: u32, _ctx: &Context) -> Result<SyscallReturn> {
+    if flags & !MLOCK_ONFAULT != 0 {
+        return_errno_with_message!(Errno::EINVAL, "invalid mlock2 flags");
+    }
+    check_range(addr, len)?;
+    Ok(SyscallReturn::Return(0))
+}
+
+pub(super) fn sys_munlock(addr: Vaddr, len: usize, _ctx: &Context) -> Result<SyscallReturn> {
+    check_range(addr, len)?;
+    Ok(SyscallReturn::Return(0))
+}
+
+pub(super) fn sys_mlockall(flags: i32, _ctx: &Context) -> Result<SyscallReturn> {
+    let known = MCL_CURRENT | MCL_FUTURE | MCL_ONFAULT;
+    if flags & !known != 0 || flags & (MCL_CURRENT | MCL_FUTURE) == 0 {
+        return_errno_with_message!(Errno::EINVAL, "invalid mlockall flags");
+    }
+    Ok(SyscallReturn::Return(0))
+}
+
+pub(super) fn sys_munlockall(_ctx: &Context) -> Result<SyscallReturn> {
+    Ok(SyscallReturn::Return(0))
+}
