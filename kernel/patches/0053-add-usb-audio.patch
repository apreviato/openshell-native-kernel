+/// An audio function on a slot: its card, controls and streams.
+pub(super) struct AudioFunction {
+    function: Function,
+    card: Arc<Card>,
+    mixer: Arc<UsbMixer>,
+    controls: Vec<MixerControl>,
+    streams: Vec<AudioStream>,
+}
+
+fn le(value: i64, bytes: usize) -> Vec<u8> {
+    value.to_le_bytes()[..bytes].to_vec()
+}
+
+fn i16_of(bytes: &[u8]) -> Option<i32> {
+    Some(i32::from(i16::from_le_bytes([*bytes.first()?, *bytes.get(1)?])))
+}
+
+/// What a stream's hardware can do: every setting's formats, rates and
+/// channels together; prepare picks the setting that has them.
+fn limits_of(alts: &[Alt]) -> HwLimits {
+    let mut formats = Vec::new();
+    let mut rates: Vec<u32> = Vec::new();
+    let (mut low, mut high, mut bits) = (u32::MAX, 0, 0);
+    for alt in alts {
+        if !formats.contains(&alt.format) {
+            formats.push(alt.format);
+        }
+        for rate in alt.rates.list() {
+            if !rates.contains(&rate) {
+                rates.push(rate);
+            }
+        }
+        low = low.min(u32::from(alt.channels));
+        high = high.max(u32::from(alt.channels));
+        bits = bits.max(u32::from(alt.bits));
+    }
+    rates.sort_unstable();
+    HwLimits {
+        info: info::MMAP | info::MMAP_VALID | info::BATCH | info::INTERLEAVED | info::BLOCK_TRANSFER | info::PAUSE,
+        formats: Mask::of(&formats),
+        rates,
+        channels: (low.min(high), high),
+        period_bytes: (64, 512 * 1024),
+        periods: (2, 1024),
+        buffer_bytes_max: BUFFER_BYTES_MAX,
+        byte_step: 1,
+        msbits: bits,
+    }
+}
+
+/// Linux's `xhci_get_burst_count` and `xhci_get_last_burst_packet_count`:
+/// a TD's TBC and TLBPC fields.
+fn burst_fields(version: u16, superspeed: bool, packets: usize, burst: usize) -> (u32, u32) {
+    if version < 0x100 || packets == 0 {
+        return (0, 0);
+    }
+    if !superspeed {
+        return (0, (packets - 1) as u32);
+    }
+    let bursts = packets.div_ceil(burst + 1);
+    let residue = packets % (burst + 1);
+    ((bursts - 1) as u32, if residue == 0 { burst as u32 } else { (residue - 1) as u32 })
+}
