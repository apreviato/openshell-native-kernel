+impl Controller {
+    // ── Starting ─────────────────────────────────────────────────────────
+
+    /// An audio control interface: its function becomes a card. Returns the
+    /// streaming interfaces it took.
+    pub(super) fn start_audio(&mut self, slot_id: u8, configuration: &Configuration, control: &Interface) -> super::Result<Vec<u8>> {
+        let mut function = audio::parse(configuration, control).ok_or(Error::Descriptor)?;
+        let interface = u16::from(function.control);
+        // Version 2: each stream's rates are its clock's.
+        if function.version == Version::V2 {
+            for index in 0..function.streams.len() {
+                let stream = function.streams[index].clone();
+                let rates = match function.clock_of(&stream).and_then(|clock| self.clock_source(slot_id, &function, clock)) {
+                    Some(source) => self.clock_rates(slot_id, interface, source),
+                    None => Vec::new(),
+                };
+                let rates = if rates.is_empty() { vec![48000] } else { rates };
+                for alt in &mut function.streams[index].alts {
+                    alt.rates = Rates::List(rates.clone());
+                }
+            }
+        }
+        // Each stream to its zero-bandwidth setting.
+        for stream in &function.streams {
+            let _ = self.control(slot_id, 0x01, SET_INTERFACE, 0, u16::from(stream.interface), Data::None);
+        }
+        // The card's names, as Linux's `usb_audio_make_shortname/longname`.
+        let (manufacturer_id, product_id, ids, speed, path) = {
+            let slot = &self.slots[&slot_id];
+            (slot.string_ids.0, slot.string_ids.1, slot.ids, slot.speed, self.port_path(slot_id))
+        };
+        let product = self.text(slot_id, product_id).filter(|s| !s.is_empty());
+        let manufacturer = self.text(slot_id, manufacturer_id).filter(|s| !s.is_empty());
+        let name = product.unwrap_or_else(|| format!("USB Device {:#06x}:{:#06x}", ids.0, ids.1));
+        let speed_name = match speed {
+            SPEED_LOW => "low",
+            SPEED_FULL => "full",
+            3 => "high",
+            4 => "super",
+            _ => "super-plus",
+        };
+        let location = self.location();
+        let place = path.iter().map(|port| port.to_string()).collect::<Vec<_>>().join(".");
+        let longname = match manufacturer {
+            Some(maker) if !name.contains(&maker) => format!("{} {} at usb-{}-{}, {} speed", maker, name, location, place, speed_name),
+            _ => format!("{} at usb-{}-{}, {} speed", name, location, place, speed_name),
+        };
+        let id = unique_id(&audio::card_id(&name));
+
+        // The streams: one playback and one capture, as most devices have.
+        let mut streams = Vec::new();
+        for direction in [Direction::Playback, Direction::Capture] {
+            let Some(stream) = function.streams.iter().find(|s| s.direction == direction && !s.alts.is_empty()) else { continue };
+            let shared = StreamShared::new();
+            let limits = limits_of(&stream.alts);
+            let pcm_direction = if direction == Direction::Playback { PcmDirection::Playback } else { PcmDirection::Capture };
+            let Some(pcm) = Pcm::new(pcm_direction, limits, "USB Audio".to_string(), "USB Audio".to_string(), Box::new(UsbStreamHw(shared.clone()))) else {
+                continue;
+            };
+            streams.push(AudioStream { desc: stream.clone(), pcm, shared, active: None });
+        }
+        if streams.is_empty() {
+            return Err(Error::Descriptor);
+        }
+
+        // The mixer: each feature control with its range and value now.
+        let mut strings = |index: u8| self.text(slot_id, index);
+        let features = function.controls(&mut strings, &name);
+        let mut controls = Vec::new();
+        let mut alsa_controls = Vec::new();
+        for feature in features {
+            let Some((control, alsa)) = self.mixer_control(slot_id, &function, feature) else { continue };
+            controls.push(control);
+            alsa_controls.push(alsa);
+        }
+        let mixer = Arc::new(UsbMixer { pending: SpinLock::new(Vec::new()) });
+        let info = CardInfo {
+            id,
+            driver: "USB-Audio".to_string(),
+            name: name.clone(),
+            longname,
+            mixer_name: "USB Mixer".to_string(),
+            components: format!("USB{:04x}:{:04x}", ids.0, ids.1),
+            pcm_name: "USB Audio".to_string(),
+        };
+        let playback = streams.iter().find(|s| s.desc.direction == Direction::Playback).map(|s| s.pcm.clone());
+        let capture = streams.iter().find(|s| s.desc.direction == Direction::Capture).map(|s| s.pcm.clone());
+        let mixer_for_card: Arc<dyn Mixer> = mixer.clone();
+        let card = aster_sound::add_card(move |index| Some(Card::external(index, info, playback, capture, alsa_controls, mixer_for_card)))
+            .ok_or(Error::NoMemory)?;
+        ostd::notice!(
+            "{}: sound card {}: {} (USB Audio {}){}{}",
+            self.name,
+            card.index,
+            card.name,
+            if function.version == Version::V2 { "2.0" } else { "1.0" },
+            if card.playback.is_some() { ", playback" } else { "" },
+            if card.capture.is_some() { ", capture" } else { "" }
+        );
+        let taken: Vec<u8> = function.streams.iter().map(|stream| stream.interface).collect();
+        let entry = AudioFunction { function, card, mixer, controls, streams };
+        self.slots.get_mut(&slot_id).ok_or(Error::Descriptor)?.audio.push(entry);
+        Ok(taken)
+    }
+
+    /// The controller's PCI place, as Linux names a bus (`0000:00:14.0`).
+    fn location(&self) -> String {
+        let location = *self._device.location();
+        format!("0000:{:02x}:{:02x}.{}", location.bus, location.device, location.function)
+    }
+
+    /// A string descriptor as text (UTF-16LE after its two-byte header).
+    fn text(&mut self, slot_id: u8, index: u8) -> Option<String> {
+        if index == 0 {
+            return None;
+        }
+        let raw = self.get_string(slot_id, index).ok()?;
+        let units: Vec<u16> = raw.get(2..)?.chunks_exact(2).map(|pair| u16::from_le_bytes([pair[0], pair[1]])).collect();
+        let text: String = char::decode_utf16(units).map(|c| c.unwrap_or('?')).collect();
+        Some(text.trim().to_string())
+    }
+
+    /// The clock source behind a clock entity (version 2): a selector's
+    /// current input, a multiplier's source (Linux's `__uac_clock_find_source`).
+    fn clock_source(&mut self, slot_id: u8, function: &Function, mut clock: u8) -> Option<u8> {
+        let interface = u16::from(function.control);
+        for _ in 0..8 {
+            match function.entities.get(&clock)? {
+                Entity::ClockSource { .. } => return Some(clock),
+                Entity::ClockMultiplier { source } => clock = *source,
+                Entity::ClockSelector { sources } => {
+                    let index = u16::from(clock) << 8 | interface;
+                    let pin = self
+                        .control(slot_id, FROM_INTERFACE, CUR_V2, CLOCK_SELECTOR_CONTROL << 8, index, Data::In(1))
+                        .ok()
+                        .and_then(|length| (length == 1).then(|| self.read_reply(slot_id, 1)).flatten())
+                        .and_then(|reply| reply.first().copied())
+                        .filter(|pin| *pin >= 1 && usize::from(*pin) <= sources.len())
+                        .unwrap_or(1);
+                    clock = sources[usize::from(pin) - 1];
+                }
+                _ => return None,
+            }
+        }
+        None
+    }
+
+    fn read_reply(&self, slot_id: u8, length: usize) -> Option<Vec<u8>> {
+        let mut data = vec![0u8; length];
+        self.slots.get(&slot_id)?.buffer.read_bytes(0, &mut data).ok()?;
+        Some(data)
+    }
+
+    /// A version 2 clock source's rates (its sampling frequency RANGE).
+    fn clock_rates(&mut self, slot_id: u8, interface: u16, clock: u8) -> Vec<u32> {
+        let index = u16::from(clock) << 8 | interface;
+        let value = SAMPLING_FREQ_CONTROL << 8;
+        let Ok(2) = self.control(slot_id, FROM_INTERFACE, RANGE_V2, value, index, Data::In(2)) else { return Vec::new() };
+        let Some(head) = self.read_reply(slot_id, 2) else { return Vec::new() };
+        let count = usize::from(u16::from_le_bytes([head[0], head[1]])).min(64);
+        let length = 2 + count * 12;
+        match self.control(slot_id, FROM_INTERFACE, RANGE_V2, value, index, Data::In(length)) {
+            Ok(got) => self.read_reply(slot_id, got).map(|reply| audio::rates_of_range(&reply)).unwrap_or_default(),
+            Err(_) => Vec::new(),
+        }
+    }
+
+    /// A feature control's range and present values, as an ALSA control.
+    fn mixer_control(&mut self, slot_id: u8, function: &Function, feature: FeatureControl) -> Option<(MixerControl, AlsaControl)> {
+        let index = u16::from(feature.unit) << 8 | u16::from(function.control);
+        let selector = (feature.control as u16) << 8;
+        let first = u16::from(feature.channels[0]);
+        let mut control = MixerControl { feature: feature.clone(), min: 0, max: 1, res: 1 };
+        let get = |this: &mut Self, request: u8, channel: u16, length: usize| -> Option<Vec<u8>> {
+            let got = this.control(slot_id, FROM_INTERFACE, request, selector | channel, index, Data::In(length)).ok()?;
+            this.read_reply(slot_id, got)
+        };
+        let kind = match feature.control {
+            Control::Mute => ControlKind::Boolean,
+            Control::Volume => {
+                let (min, max, res) = match function.version {
+                    Version::V1 => (
+                        i16_of(&get(self, GET_MIN, first, 2)?)?,
+                        i16_of(&get(self, GET_MAX, first, 2)?)?,
+                        i16_of(&get(self, GET_RES, first, 2)?)?,
+                    ),
+                    Version::V2 => {
+                        let range = get(self, RANGE_V2, first, 8)?;
+                        (i16_of(range.get(2..)?)?, i16_of(range.get(4..)?)?, i16_of(range.get(6..)?)?)
+                    }
+                };
+                if max <= min {
+                    return None;
+                }
+                control.min = min;
+                control.max = max;
+                control.res = if res <= 0 { 1 } else { res };
+                ControlKind::Integer { min: 0, max: i64::from((max - min + control.res - 1) / control.res) }
+            }
+        };
+        let current_request = if function.version == Version::V1 { GET_CUR } else { CUR_V2 };
+        let width = if feature.control == Control::Mute { 1 } else { 2 };
+        let mut values = Vec::new();
+        for &channel in &feature.channels {
+            let raw = get(self, current_request, u16::from(channel), width);
+            values.push(match (feature.control, raw) {
+                (Control::Mute, Some(raw)) => i64::from(raw.first().copied().unwrap_or(0) == 0),
+                (Control::Mute, None) => 1,
+                (Control::Volume, Some(raw)) => control.value_of(i16_of(&raw).unwrap_or(control.max)),
+                (Control::Volume, None) => control.value_of(control.max),
+            });
+        }
+        // The master behind per-channel controls stays neutral: unmuted, at 0 dB.
+        if feature.master_too {
+            let (payload, setter) = match feature.control {
+                Control::Mute => (vec![0u8], SET_CUR),
+                Control::Volume => (le(0, 2), SET_CUR),
+            };
+            let _ = self.control(slot_id, TO_INTERFACE, setter, selector, index, Data::Out(&payload));
+        }
+        let db = match feature.control {
+            Control::Volume => Some((control.min * 100 / 256, control.max * 100 / 256, false)),
+            Control::Mute => None,
+        };
+        let alsa = AlsaControl::external(feature.name.clone(), kind, feature.channels.len() as u32, db, values);
+        Some((control, alsa))
+    }
+
+    // ── The task's side ──────────────────────────────────────────────────
+
+    /// What the PCM layer and the mixers asked; then each running stream's
+    /// packets.
+    pub(super) fn serve_audio(&mut self) {
+        let slot_ids: Vec<u8> = self.slots.iter().filter(|(_, slot)| !slot.audio.is_empty()).map(|(id, _)| *id).collect();
+        for slot_id in slot_ids {
+            let functions = self.slots.get(&slot_id).map_or(0, |slot| slot.audio.len());
+            for f in 0..functions {
+                self.apply_mixer(slot_id, f);
+                let streams = self.slots.get(&slot_id).and_then(|slot| slot.audio.get(f)).map_or(0, |function| function.streams.len());
+                for s in 0..streams {
+                    loop {
+                        let request = self
+                            .slots
+                            .get(&slot_id)
+                            .and_then(|slot| slot.audio.get(f))
+                            .and_then(|function| function.streams[s].shared.requests.lock().pop_front());
+                        let Some(request) = request else { break };
+                        match request {
+                            Request::Prepare(setup, buffer) => {
+                                let result = self.prepare_stream(slot_id, f, s, setup, buffer);
+                                if let Some(stream) = self.stream(slot_id, f, s) {
+                                    stream.shared.answer(result);
+                                }
+                            }
+                            Request::Release => self.release_stream(slot_id, f, s),
+                        }
+                    }
+                    self.fill(slot_id, f, s);
+                }
+            }
+        }
+    }
+
+    fn stream(&mut self, slot_id: u8, f: usize, s: usize) -> Option<&mut AudioStream> {
+        self.slots.get_mut(&slot_id)?.audio.get_mut(f)?.streams.get_mut(s)
+    }
+
+    /// Puts the controls the card changed on the device.
+    fn apply_mixer(&mut self, slot_id: u8, f: usize) {
+        let pending = match self.slots.get(&slot_id).and_then(|slot| slot.audio.get(f)) {
+            Some(function) => core::mem::take(&mut *function.mixer.pending.lock()),
+            None => return,
+        };
+        for (index, values) in pending {
+            let Some((feature, interface, version, raws)) = self.slots.get(&slot_id).and_then(|slot| slot.audio.get(f)).and_then(|function| {
+                let control = function.controls.get(index)?;
+                let raws: Vec<i32> = values.iter().map(|value| control.raw_of(*value)).collect();
+                Some((control.feature.clone(), function.function.control, function.function.version, raws))
+            }) else {
+                continue;
+            };
+            let unit = u16::from(feature.unit) << 8 | u16::from(interface);
+            let setter = if version == Version::V1 { SET_CUR } else { CUR_V2 };
+            for (position, &channel) in feature.channels.iter().enumerate() {
+                let value = values.get(position).copied().unwrap_or(0);
+                let payload = match feature.control {
+                    Control::Mute => vec![u8::from(value == 0)],
+                    Control::Volume => le(i64::from(raws.get(position).copied().unwrap_or(0)), 2),
+                };
+                let selector = (feature.control as u16) << 8 | u16::from(channel);
+                let _ = self.control(slot_id, TO_INTERFACE, setter, selector, unit, Data::Out(&payload));
+            }
+        }
+    }
+
+    /// Sets a stream up for its parameters: the setting that has them, the
+    /// rate, the endpoints and buffers.
+    fn prepare_stream(&mut self, slot_id: u8, f: usize, s: usize, setup: Setup, buffer: Arc<Buffer>) -> Result<(), PcmError> {
+        self.release_stream(slot_id, f, s);
+        let (desc, function_version, control, clock) = {
+            let function = self.slots.get(&slot_id).and_then(|slot| slot.audio.get(f)).ok_or(PcmError::Disconnected)?;
+            let desc = function.streams[s].desc.clone();
+            let clock = function.function.clock_of(&desc);
+            (desc, function.function.version, function.function.control, clock)
+        };
+        let alt_index = desc
+            .alts
+            .iter()
+            .position(|alt| alt.format == setup.format && u32::from(alt.channels) == setup.channels && alt.rates.has(setup.rate))
+            .ok_or(PcmError::Invalid)?;
+        let alt = desc.alts[alt_index].clone();
+        if setup.frame_bytes != alt.frame_bytes() {
+            return Err(PcmError::Invalid);
+        }
+        let interface = u16::from(desc.interface);
+        // Version 2 sets the clock first; version 1 the setting first, then
+        // the endpoint's rate (Linux's order).
+        if function_version == Version::V2 {
+            let function = self.slots[&slot_id].audio[f].function.clone();
+            if let Some(source) = clock.and_then(|clock| self.clock_source(slot_id, &function, clock)) {
+                let settable = matches!(function.entities.get(&source), Some(Entity::ClockSource { controls, .. }) if controls & 3 == 3);
+                if settable {
+                    let index = u16::from(source) << 8 | u16::from(control);
+                    let _ = self.control(slot_id, TO_INTERFACE, CUR_V2, SAMPLING_FREQ_CONTROL << 8, index, Data::Out(&le(i64::from(setup.rate), 4)));
+                }
+            }
+        }
+        self.control(slot_id, 0x01, SET_INTERFACE, u16::from(alt.alternate), interface, Data::None).map_err(|_| PcmError::Io)?;
+        if function_version == Version::V1 && (alt.rate_control || alt.rates.several()) {
+            let _ = self.control(
+                slot_id,
+                TO_ENDPOINT,
+                SET_CUR,
+                SAMPLING_FREQ_CONTROL << 8,
+                u16::from(alt.endpoint.address),
+                Data::Out(&le(i64::from(setup.rate), 3)),
+            );
+        }
+        let speed = self.slots.get(&slot_id).map_or(SPEED_FULL, |slot| slot.speed);
+        let full_speed = speed == SPEED_FULL || speed == SPEED_LOW;
+        let endpoint = alt.endpoint;
+        let ring = ProducerRing::new().ok_or(PcmError::NoMemory)?;
+        let kind = if endpoint.is_in() { EP_ISOCH_IN } else { EP_ISOCH_OUT };
+        self.configure_endpoint(slot_id, &endpoint, kind, &ring).map_err(|_| PcmError::Io)?;
+        // The packets: their frames at this rate, and what one may hold.
+        let max_packet = usize::from(endpoint.max_packet & 0x7ff);
+        let (burst, mult) = if speed >= SPEED_SUPER {
+            (usize::from(endpoint.max_burst), usize::from(endpoint.mult))
+        } else {
+            (usize::from((endpoint.max_packet >> 11) & 3), 0)
+        };
+        let packet_max = max_packet * (burst + 1) * (mult + 1);
+        let per_second = audio::packets_per_second(full_speed, endpoint.interval);
+        let nominal = (u64::from(setup.rate) << 16) / u64::from(per_second);
+        let slot_size = packet_max.next_power_of_two().max(64);
+        let queued = ((per_second * QUEUED_MS / 1000).max(2) as usize).min(MAX_QUEUED);
+        let slot_count = queued + 2;
+        let pages = (slot_count * slot_size).div_ceil(PAGE_SIZE);
+        let slots = DmaCoherent::alloc(pages, true).map_err(|_| PcmError::NoMemory)?;
+        // An interrupt about once a millisecond.
+        let interrupt_every = (per_second / 1000).max(1) as usize;
+        let feedback = match alt.feedback {
+            Some(feedback) if !endpoint.is_in() => self.start_feedback(slot_id, &feedback, setup.rate, full_speed, endpoint.interval),
+            _ => None,
+        };
+        let active = Active {
+            setup,
+            buffer,
+            dci: endpoint.dci(),
+            ring,
+            slots,
+            slot_size,
+            free: (0..slot_count).rev().collect(),
+            in_flight: VecDeque::new(),
+            feedback,
+            packet_max,
+            freq: nominal,
+            accumulator: 0,
+            offset: 0,
+            queued,
+            interrupt_every,
+            since_interrupt: 0,
+            max_packet: max_packet.max(1),
+            burst,
+            superspeed: speed >= SPEED_SUPER,
+            sent: 0,
+            done: 0,
+            missed: 0,
+            dry: 0,
+        };
+        ostd::notice!(
+            "{}: slot {}: {} at {} Hz, {} channels, format {}: setting {}, {} packets/s of {} bytes at most, {} queued",
+            self.name,
+            slot_id,
+            if desc.direction == Direction::Playback { "playback" } else { "capture" },
+            setup.rate,
+            setup.channels,
+            setup.format,
+            alt.alternate,
+            per_second,
+            packet_max,
+            queued
+        );
+        let stream = self.stream(slot_id, f, s).ok_or(PcmError::Disconnected)?;
+        stream.shared.position.store(0, Ordering::Release);
+        stream.shared.delay.store(0, Ordering::Release);
+        stream.active = Some(active);
+        Ok(())
+    }
+
+    /// An asynchronous playback endpoint's feedback endpoint, with its first
+    /// transfers queued.
+    fn start_feedback(&mut self, slot_id: u8, endpoint: &Endpoint, rate: u32, full_speed: bool, data_interval: u8) -> Option<Feedback> {
+        let ring = ProducerRing::new()?;
+        self.configure_endpoint(slot_id, endpoint, EP_ISOCH_IN, &ring).ok()?;
+        let unit = if full_speed { 1000 } else { 8000 };
+        let mut feedback = Feedback {
+            dci: endpoint.dci(),
+            ring,
+            buffer: DmaCoherent::alloc(1, true).ok()?,
+            in_flight: VecDeque::new(),
+            size: usize::from(endpoint.max_packet & 0x7ff).clamp(3, 64),
+            nominal: ((u64::from(rate) << 16) / unit) as u32,
+            shift: u32::from(data_interval.clamp(1, 16)) - 1,
+        };
+        for index in 0..FEEDBACK_TDS {
+            Self::queue_feedback(&mut feedback, index);
+        }
+        let dci = feedback.dci;
+        self.ring(slot_id, dci);
+        Some(feedback)
+    }
+
+    fn queue_feedback(feedback: &mut Feedback, index: usize) {
+        let address = feedback.buffer.daddr() as u64 + (index * 64) as u64;
+        let trb = feedback.ring.push(Trb {
+            parameter: address,
+            status: feedback.size as u32,
+            control: Trb::with_type(TRB_ISOCH) | IOC | SIA,
+        });
+        feedback.in_flight.push_back((trb, index));
+    }
+
+    /// The stream is let go: its endpoints dropped, its setting back to zero
+    /// bandwidth.
+    fn release_stream(&mut self, slot_id: u8, f: usize, s: usize) {
+        // Playback's packets in flight play out first: a few milliseconds.
+        let deadline = crate::now_ms() + 20;
+        while crate::now_ms() < deadline
+            && self.stream(slot_id, f, s).is_some_and(|stream| {
+                stream.desc.direction == Direction::Playback && stream.active.as_ref().is_some_and(|active| !active.in_flight.is_empty())
+            })
+        {
+            let _ = self.wait_event(&mut |_| false, 1);
+        }
+        let Some(stream) = self.stream(slot_id, f, s) else { return };
+        let Some(active) = stream.active.take() else { return };
+        let interface = u16::from(stream.desc.interface);
+        stream.shared.position.store(0, Ordering::Release);
+        stream.shared.delay.store(0, Ordering::Release);
+        ostd::notice!(
+            "{}: slot {}: stream of interface {} ended: {} packets sent, {} done, {} missed, ring dry {} times",
+            self.name, slot_id, interface, active.sent, active.done, active.missed, active.dry
+        );
+        let mut dcis = vec![active.dci];
+        if let Some(feedback) = &active.feedback {
+            dcis.push(feedback.dci);
+        }
+        self.drop_endpoints(slot_id, &dcis);
+        let _ = self.control(slot_id, 0x01, SET_INTERFACE, 0, interface, Data::None);
+    }
+
+    /// Keeps a running stream's packets queued.
+    fn fill(&mut self, slot_id: u8, f: usize, s: usize) {
+        let version = self.version;
+        let Some(stream) = self.stream(slot_id, f, s) else { return };
+        let running = stream.shared.running.load(Ordering::Acquire);
+        let playback = stream.desc.direction == Direction::Playback;
+        let Some(active) = stream.active.as_mut() else { return };
+        let mut queued_any = false;
+        while running && active.in_flight.len() < active.queued {
+            let Some(slot) = active.free.pop() else { break };
+            let at = slot * active.slot_size;
+            let frame = active.setup.frame_bytes;
+            let bytes = if playback {
+                // The packet's frames: the rate's, the fraction carried over.
+                active.accumulator += active.freq;
+                let frames = (active.accumulator >> 16) as usize;
+                active.accumulator &= 0xffff;
+                let bytes = (frames * frame).min(active.packet_max / frame * frame);
+                // Out of the PCM buffer, wrapping at its end.
+                let total = active.setup.buffer_bytes();
+                let mut copied = 0;
+                let mut chunk = vec![0u8; bytes];
+                while copied < bytes {
+                    let from = (active.offset + copied) % total;
+                    let length = (bytes - copied).min(total - from);
+                    let _ = active.buffer.frames.read_bytes(from, &mut chunk[copied..copied + length]);
+                    copied += length;
+                }
+                let _ = active.slots.write_bytes(at, &chunk);
+                active.offset = (active.offset + bytes) % total;
+                bytes
+            } else {
+                active.packet_max
+            };
+            active.since_interrupt += 1;
+            let interrupt = active.since_interrupt >= active.interrupt_every;
+            if interrupt {
+                active.since_interrupt = 0;
+            }
+            let packets = bytes.div_ceil(active.max_packet).max(1);
+            let (tbc, tlbpc) = burst_fields(version, active.superspeed, packets, active.burst);
+            let trb = active.ring.push(Trb {
+                parameter: active.slots.daddr() as u64 + at as u64,
+                status: bytes as u32,
+                control: Trb::with_type(TRB_ISOCH) | IOC | SIA | if interrupt { 0 } else { BEI } | tbc << 7 | tlbpc << 16,
+            });
+            active.in_flight.push_back(Td { trb, slot, bytes });
+            active.sent += 1;
+            queued_any = true;
+        }
+        if playback {
+            let frame = active.setup.frame_bytes.max(1);
+            let flight: usize = active.in_flight.iter().map(|td| td.bytes).sum();
+            stream.shared.delay.store((flight / frame) as u64, Ordering::Release);
+            stream.shared.position.store(active.offset, Ordering::Release);
+        }
+        let dci = active.dci;
+        let pcm = stream.pcm.clone();
+        if queued_any {
+            self.ring(slot_id, dci);
+        }
+        if playback && queued_any {
+            pcm.update();
+        }
+    }
+
+    /// Whether an event is an audio stream's (its data or feedback endpoint).
+    pub(super) fn is_audio_endpoint(&self, slot_id: u8, dci: u8) -> bool {
+        self.slots.get(&slot_id).is_some_and(|slot| {
+            slot.audio.iter().any(|function| {
+                function.streams.iter().any(|stream| {
+                    stream.active.as_ref().is_some_and(|active| active.dci == dci || active.feedback.as_ref().is_some_and(|fb| fb.dci == dci))
+                })
+            })
+        })
+    }
+
+    /// A packet's end: playback's frees its buffer; capture's frames go to
+    /// the PCM buffer; feedback says the device's rate. More are queued.
+    pub(super) fn audio_done(&mut self, slot_id: u8, dci: u8, event: &Trb) {
+        let Some(slot) = self.slots.get(&slot_id) else { return };
+        let Some((f, s)) = slot.audio.iter().enumerate().find_map(|(f, function)| {
+            function
+                .streams
+                .iter()
+                .position(|stream| {
+                    stream.active.as_ref().is_some_and(|active| active.dci == dci || active.feedback.as_ref().is_some_and(|fb| fb.dci == dci))
+                })
+                .map(|s| (f, s))
+        }) else {
+            return;
+        };
+        let code = event.completion_code();
+        let Some(stream) = self.stream(slot_id, f, s) else { return };
+        let playback = stream.desc.direction == Direction::Playback;
+        let pcm = stream.pcm.clone();
+        let shared = stream.shared.clone();
+        let Some(active) = stream.active.as_mut() else { return };
+        let mut ring_feedback = None;
+        if active.feedback.as_ref().is_some_and(|feedback| feedback.dci == dci) {
+            let feedback = active.feedback.as_mut().unwrap();
+            if let Some(position) = feedback.in_flight.iter().position(|(trb, _)| *trb == event.parameter) {
+                let (_, index) = feedback.in_flight.remove(position).unwrap();
+                if code == SUCCESS || code == SHORT_PACKET {
+                    let mut raw = [0u8; 4];
+                    let _ = feedback.buffer.read_bytes(index * 64, &mut raw);
+                    let received = feedback.size.saturating_sub((event.status & 0xff_ffff) as usize).min(4);
+                    let value = match received {
+                        3 => u32::from(raw[0]) | u32::from(raw[1]) << 8 | u32::from(raw[2]) << 16,
+                        4 => u32::from_le_bytes(raw),
+                        _ => 0,
+                    };
+                    if let Some(per_unit) = audio::feedback_value(value, feedback.nominal) {
+                        active.freq = u64::from(per_unit) << feedback.shift;
+                    }
+                }
+                Self::queue_feedback(feedback, index);
+                ring_feedback = Some(feedback.dci);
+            }
+        } else {
+            match code {
+                // The ring ran dry (each packet reported its own end already:
+                // they all interrupt on completion), as Linux takes it.
+                RING_UNDERRUN | RING_OVERRUN => active.dry += 1,
+                _ => {
+                    // This packet and those before it (a missed one reports
+                    // nothing of its own) are done.
+                    if code == MISSED_SERVICE {
+                        active.missed += 1;
+                    }
+                    if let Some(position) = active.in_flight.iter().position(|td| td.trb == event.parameter) {
+                        active.done += position as u64 + 1;
+                        for _ in 0..position {
+                            if let Some(td) = active.in_flight.pop_front() {
+                                active.free.push(td.slot);
+                            }
+                        }
+                        let td = active.in_flight.pop_front().unwrap();
+                        if !playback && (code == SUCCESS || code == SHORT_PACKET) && code != MISSED_SERVICE {
+                            let received = td.bytes.saturating_sub((event.status & 0xff_ffff) as usize);
+                            let frame = active.setup.frame_bytes.max(1);
+                            let received = received / frame * frame;
+                            if received > 0 && shared.running.load(Ordering::Acquire) {
+                                let mut data = vec![0u8; received];
+                                let _ = active.slots.read_bytes(td.slot * active.slot_size, &mut data);
+                                let total = active.setup.buffer_bytes();
+                                let mut copied = 0;
+                                while copied < received {
+                                    let to = (active.offset + copied) % total;
+                                    let length = (received - copied).min(total - to);
+                                    let _ = active.buffer.frames.write_bytes(to, &data[copied..copied + length]);
+                                    copied += length;
+                                }
+                                active.offset = (active.offset + received) % total;
+                                shared.position.store(active.offset, Ordering::Release);
+                            }
+                        }
+                        active.free.push(td.slot);
+                    }
+                }
+            }
+        }
+        if let Some(feedback_dci) = ring_feedback {
+            self.ring(slot_id, feedback_dci);
+            return;
+        }
+        if !playback {
+            pcm.update();
+        }
+        self.fill(slot_id, f, s);
+    }
+
+    /// The device went: its cards go, whoever has them open sees them
+    /// disconnected.
+    pub(super) fn audio_gone(functions: &[AudioFunction]) {
+        for function in functions {
+            for stream in &function.streams {
+                stream.shared.gone.store(true, Ordering::Release);
+                stream.shared.running.store(false, Ordering::Release);
+                stream.shared.answered.wake_all();
+            }
+            aster_sound::remove_card(&function.card);
+        }
+    }
+}
+
+/// A card ID no other card has: ALSA adds `_1`, `_2`... to a repeated one.
+fn unique_id(id: &str) -> String {
+    let taken: Vec<String> = aster_sound::cards().iter().map(|card| card.id.clone()).collect();
+    if !taken.iter().any(|other| other == id) {
+        return id.to_string();
+    }
+    for number in 1..32 {
+        let suffix = format!("_{}", number);
+        let mut candidate: String = id.chars().take(15 - suffix.len()).collect();
+        candidate.push_str(&suffix);
+        if !taken.contains(&candidate) {
+            return candidate;
+        }
+    }
+    id.to_string()
+}
