+/// Endpoint context types.
+pub(super) const EP_ISOCH_OUT: u32 = 1;
+pub(super) const EP_ISOCH_IN: u32 = 5;
+/// The isochronous TRB, and its flags: Block Event Interrupt, Start
+/// Isochronous ASAP.
+const TRB_ISOCH: u32 = 5;
+const BEI: u32 = 1 << 9;
+const SIA: u32 = 1 << 31;
+/// Completion codes of isochronous transfers.
+const RING_UNDERRUN: u8 = 14;
+const RING_OVERRUN: u8 = 15;
+const MISSED_SERVICE: u8 = 23;
+
+/// Class requests (version 1: SET_CUR and GET_*; version 2: CUR and RANGE).
+const SET_CUR: u8 = 0x01;
+const GET_CUR: u8 = 0x81;
+const GET_MIN: u8 = 0x82;
+const GET_MAX: u8 = 0x83;
+const GET_RES: u8 = 0x84;
+const CUR_V2: u8 = 0x01;
+const RANGE_V2: u8 = 0x02;
+/// The sampling frequency control, of a version 1 endpoint and of a
+/// version 2 clock source; a clock selector's control.
+const SAMPLING_FREQ_CONTROL: u16 = 0x01;
+const CLOCK_SELECTOR_CONTROL: u16 = 0x01;
+/// Request types: class, to the interface or the endpoint.
+const TO_INTERFACE: u8 = 0x21;
+const FROM_INTERFACE: u8 = 0xa1;
+const TO_ENDPOINT: u8 = 0x22;
+
+/// Milliseconds of audio a stream keeps queued.
+const QUEUED_MS: u32 = 8;
+/// A stream's bounce buffers, and the feedback endpoint's transfers.
+const MAX_QUEUED: usize = 96;
+const FEEDBACK_TDS: usize = 4;
+/// The PCM buffer at most (Linux's `snd_usb_hardware`).
+const BUFFER_BYTES_MAX: u32 = 1024 * 1024;
+
+/// What the PCM layer asks a stream's task to do.
+enum Request {
+    Prepare(Setup, Arc<Buffer>),
+    Release,
+}
+
+/// What a stream shares between the PCM layer and the controller's task.
+pub(crate) struct StreamShared {
+    requests: SpinLock<VecDeque<Request>>,
+    running: AtomicBool,
+    /// Where the stream is in the PCM buffer, in bytes.
+    position: AtomicUsize,
+    /// Frames in flight (playback: queued, not yet played).
+    delay: AtomicU64,
+    answer: SpinLock<Option<Result<(), PcmError>>>,
+    answered: WaitQueue,
+    gone: AtomicBool,
+}
+
+impl StreamShared {
+    fn new() -> Arc<Self> {
+        Arc::new(Self {
+            requests: SpinLock::new(VecDeque::new()),
+            running: AtomicBool::new(false),
+            position: AtomicUsize::new(0),
+            delay: AtomicU64::new(0),
+            answer: SpinLock::new(None),
+            answered: WaitQueue::new(),
+            gone: AtomicBool::new(false),
+        })
+    }
+
+    fn answer(&self, result: Result<(), PcmError>) {
+        *self.answer.lock() = Some(result);
+        self.answered.wake_all();
+    }
+}
+
+/// The PCM layer's side of a stream.
+struct UsbStreamHw(Arc<StreamShared>);
+
+impl StreamHw for UsbStreamHw {
+    fn prepare(&self, setup: &Setup, buffer: &Arc<Buffer>) -> Result<(), PcmError> {
+        if self.0.gone.load(Ordering::Acquire) {
+            return Err(PcmError::Disconnected);
+        }
+        *self.0.answer.lock() = None;
+        self.0.requests.lock().push_back(Request::Prepare(*setup, buffer.clone()));
+        crate::wake();
+        self.0.answered.wait_until(|| {
+            if self.0.gone.load(Ordering::Acquire) {
+                return Some(Err(PcmError::Disconnected));
+            }
+            self.0.answer.lock().take()
+        })
+    }
+
+    fn start(&self) {
+        self.0.running.store(true, Ordering::Release);
+        crate::wake();
+    }
+
+    fn stop(&self) {
+        self.0.running.store(false, Ordering::Release);
+        crate::wake();
+    }
+
+    fn position(&self) -> usize {
+        self.0.position.load(Ordering::Acquire)
+    }
+
+    fn delay(&self) -> u64 {
+        self.0.delay.load(Ordering::Acquire)
+    }
+
+    fn release(&self) {
+        self.0.running.store(false, Ordering::Release);
+        self.0.requests.lock().push_back(Request::Release);
+        crate::wake();
+    }
+}
+
+/// The card's controls, put on the device by the task.
+pub(crate) struct UsbMixer {
+    pending: SpinLock<Vec<(usize, Vec<i64>)>>,
+}
+
+impl Mixer for UsbMixer {
+    fn apply(&self, index: usize, values: &[i64]) {
+        let mut pending = self.pending.lock();
+        pending.retain(|(other, _)| *other != index);
+        pending.push((index, values.to_vec()));
+        drop(pending);
+        crate::wake();
+    }
+}
+
+/// A control's device side: the feature unit, and a volume's range.
+struct MixerControl {
+    feature: FeatureControl,
+    /// The raw range (1/256 dB) and step of a volume.
+    min: i32,
+    max: i32,
+    res: i32,
+}
+
+impl MixerControl {
+    fn raw_of(&self, value: i64) -> i32 {
+        (self.min as i64 + value * self.res as i64).clamp(self.min as i64, self.max as i64) as i32
+    }
+
+    fn value_of(&self, raw: i32) -> i64 {
+        (i64::from(raw.clamp(self.min, self.max)) - i64::from(self.min)) / i64::from(self.res.max(1))
+    }
+}
+
+/// One packet in flight: its TRB, its bounce buffer, its bytes.
+struct Td {
+    trb: u64,
+    slot: usize,
+    bytes: usize,
+}
+
+/// A feedback endpoint's transfers.
+struct Feedback {
+    dci: u8,
+    ring: ProducerRing,
+    buffer: DmaCoherent,
+    in_flight: VecDeque<(u64, usize)>,
+    /// What one of its transfers asks for (3 bytes at full speed, 4 faster).
+    size: usize,
+    /// Frames per (micro)frame the device would have at the nominal rate, 16.16.
+    nominal: u32,
+    /// (Micro)frames per data packet, as a shift.
+    shift: u32,
+}
+
+/// A prepared stream: its setting, endpoint, buffers and packets.
+struct Active {
+    setup: Setup,
+    buffer: Arc<Buffer>,
+    dci: u8,
+    ring: ProducerRing,
+    slots: DmaCoherent,
+    slot_size: usize,
+    free: Vec<usize>,
+    in_flight: VecDeque<Td>,
+    feedback: Option<Feedback>,
+    /// What a packet may hold.
+    packet_max: usize,
+    /// Frames per packet, 16.16: the nominal rate's, or the device's own.
+    freq: u64,
+    accumulator: u64,
+    /// Where the next packet goes in (or comes from) the PCM buffer.
+    offset: usize,
+    /// Packets to keep queued, and every how many one interrupts.
+    queued: usize,
+    interrupt_every: usize,
+    since_interrupt: usize,
+    /// The endpoint's TD layout (bursts at SuperSpeed).
+    max_packet: usize,
+    burst: usize,
+    superspeed: bool,
+    /// Packets queued and done, missed by the controller, and times the
+    /// ring ran dry: the stream's report when it ends.
+    sent: u64,
+    done: u64,
+    missed: u64,
+    dry: u64,
+}
