@@ -0,0 +1,754 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! USB audio devices (headsets, speakers, microphones, sound cards) as the
+//! USB Audio Class describes them, versions 1 and 2: the audio control
+//! interface's terminals, units and clocks, and the streaming interfaces'
+//! alternate settings with their formats, rates and endpoints. The mixer's
+//! controls (the feature units' volumes and mutes) are named as Linux's
+//! `snd-usb-audio` names them, which is what PulseAudio's mixer paths look
+//! for. `xhci::audio` runs the streams and the controls.
+//!
+//! Reference: USB Audio 1.0 (`audio10.pdf`), USB Audio 2.0 (`Audio20 final`);
+//! Linux's `sound/usb/{stream,format,mixer,clock}.c`.
+
+use alloc::{
+    collections::BTreeMap,
+    format,
+    string::{String, ToString},
+    vec,
+    vec::Vec,
+};
+
+use crate::desc::{CS_INTERFACE, Configuration, Endpoint, Interface, TRANSFER_ISOCHRONOUS};
+
+/// The audio class, its subclasses and its versions (the interface protocol).
+pub(crate) const CLASS: u8 = 0x01;
+pub(crate) const SUBCLASS_CONTROL: u8 = 0x01;
+pub(crate) const SUBCLASS_STREAMING: u8 = 0x02;
+const PROTOCOL_V2: u8 = 0x20;
+const PROTOCOL_V3: u8 = 0x30;
+
+/// Audio control descriptors' subtypes (both versions; where they differ,
+/// version 2's are named so).
+mod ac {
+    pub(super) const HEADER: u8 = 0x01;
+    pub(super) const INPUT_TERMINAL: u8 = 0x02;
+    pub(super) const OUTPUT_TERMINAL: u8 = 0x03;
+    pub(super) const MIXER_UNIT: u8 = 0x04;
+    pub(super) const SELECTOR_UNIT: u8 = 0x05;
+    pub(super) const FEATURE_UNIT: u8 = 0x06;
+    /// Version 1's processing unit; version 2's effect unit.
+    pub(super) const PROCESSING_UNIT_V1: u8 = 0x07;
+    pub(super) const EFFECT_UNIT_V2: u8 = 0x07;
+    pub(super) const EXTENSION_UNIT_V1: u8 = 0x08;
+    pub(super) const PROCESSING_UNIT_V2: u8 = 0x08;
+    pub(super) const EXTENSION_UNIT_V2: u8 = 0x09;
+    pub(super) const CLOCK_SOURCE: u8 = 0x0a;
+    pub(super) const CLOCK_SELECTOR: u8 = 0x0b;
+    pub(super) const CLOCK_MULTIPLIER: u8 = 0x0c;
+    pub(super) const SAMPLE_RATE_CONVERTER: u8 = 0x0d;
+}
+
+/// Audio streaming descriptors' subtypes.
+mod as_ {
+    pub(super) const GENERAL: u8 = 0x01;
+    pub(super) const FORMAT_TYPE: u8 = 0x02;
+}
+
+/// Version 1's format tags; version 2's format bits.
+const FORMAT_PCM: u16 = 0x0001;
+const FORMAT_PCM8: u16 = 0x0002;
+const FORMAT_IEEE_FLOAT: u16 = 0x0003;
+const FORMATS_V2_PCM: u32 = 1 << 0;
+const FORMATS_V2_PCM8: u32 = 1 << 1;
+const FORMATS_V2_IEEE_FLOAT: u32 = 1 << 2;
+const FORMAT_TYPE_I: u8 = 0x01;
+
+/// The ALSA sample formats (`SNDRV_PCM_FORMAT_*`) of USB audio's PCM.
+pub(crate) mod alsa {
+    pub(crate) const S8: u32 = 0;
+    pub(crate) const U8: u32 = 1;
+    pub(crate) const S16_LE: u32 = 2;
+    pub(crate) const S32_LE: u32 = 10;
+    pub(crate) const FLOAT_LE: u32 = 14;
+    pub(crate) const S24_3LE: u32 = 32;
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Version {
+    V1,
+    V2,
+}
+
+/// The rates of a format: some, or any in a range (version 1's continuous
+/// rates; version 2 asks its clock).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum Rates {
+    List(Vec<u32>),
+    Range(u32, u32),
+}
+
+/// The rates ALSA knows (`snd_pcm_known_rates`), which a range offers.
+pub(crate) const KNOWN_RATES: [u32; 14] =
+    [8000, 11025, 16000, 22050, 32000, 44100, 48000, 64000, 88200, 96000, 176400, 192000, 352800, 384000];
+
+impl Rates {
+    /// Every rate it has: a range's as the known rates within it.
+    pub(crate) fn list(&self) -> Vec<u32> {
+        match self {
+            Rates::List(rates) => rates.clone(),
+            Rates::Range(low, high) => KNOWN_RATES.iter().copied().filter(|rate| (*low..=*high).contains(rate)).collect(),
+        }
+    }
+
+    pub(crate) fn has(&self, rate: u32) -> bool {
+        match self {
+            Rates::List(rates) => rates.contains(&rate),
+            Rates::Range(low, high) => (*low..=*high).contains(&rate),
+        }
+    }
+
+    /// Whether there are several, so the device must be told which.
+    pub(crate) fn several(&self) -> bool {
+        match self {
+            Rates::List(rates) => rates.len() > 1,
+            Rates::Range(low, high) => low != high,
+        }
+    }
+}
+
+/// One alternate setting of a streaming interface that carries audio.
+#[derive(Clone, Debug)]
+pub(crate) struct Alt {
+    pub alternate: u8,
+    /// Its ALSA sample format.
+    pub format: u32,
+    pub channels: u8,
+    /// Bytes a sample takes, and the bits that count.
+    pub bytes: u8,
+    pub bits: u8,
+    pub rates: Rates,
+    /// The endpoint that carries the samples.
+    pub endpoint: Endpoint,
+    /// The endpoint that says the device's rate (asynchronous playback).
+    pub feedback: Option<Endpoint>,
+    /// Version 1: the endpoint takes the rate (Sampling Frequency control).
+    pub rate_control: bool,
+}
+
+impl Alt {
+    pub(crate) fn frame_bytes(&self) -> usize {
+        usize::from(self.bytes) * usize::from(self.channels)
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Direction {
+    /// To the device (an OUT endpoint).
+    Playback,
+    /// From it.
+    Capture,
+}
+
+/// A streaming interface: one direction of a function.
+#[derive(Clone, Debug)]
+pub(crate) struct Stream {
+    pub interface: u8,
+    pub direction: Direction,
+    /// The terminal it is linked to.
+    pub terminal: u8,
+    pub alts: Vec<Alt>,
+}
+
+/// What a unit or terminal of the control interface is.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum Entity {
+    InputTerminal { kind: u16, channels: u8, clock: u8, name: u8 },
+    OutputTerminal { kind: u16, source: u8, clock: u8, name: u8 },
+    /// Its controls per channel, the master's first (version 1: a bit per
+    /// control; version 2: two bits per control).
+    Feature { source: u8, controls: Vec<u32>, name: u8 },
+    /// A mixer, selector, processing, extension, effect or rate unit: what
+    /// Linux treats as a virtual terminal when naming controls.
+    Unit { sources: Vec<u8> },
+    ClockSource { attributes: u8, controls: u8 },
+    ClockSelector { sources: Vec<u8> },
+    ClockMultiplier { source: u8 },
+}
+
+/// A USB audio function: its control interface, its units and terminals,
+/// and its streams.
+#[derive(Clone, Debug)]
+pub(crate) struct Function {
+    pub version: Version,
+    pub control: u8,
+    pub entities: BTreeMap<u8, Entity>,
+    pub streams: Vec<Stream>,
+}
+
+fn u16_at(d: &[u8], at: usize) -> u16 {
+    d.get(at..at + 2).map_or(0, |b| u16::from_le_bytes([b[0], b[1]]))
+}
+
+fn u24_at(d: &[u8], at: usize) -> u32 {
+    d.get(at..at + 3).map_or(0, |b| u32::from(b[0]) | u32::from(b[1]) << 8 | u32::from(b[2]) << 16)
+}
+
+fn u32_at(d: &[u8], at: usize) -> u32 {
+    d.get(at..at + 4).map_or(0, |b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+}
+
+/// The function whose control interface is `control`, with the streaming
+/// interfaces it has: version 1's header lists them; version 2's follow
+/// it in the configuration (its interface association groups them).
+/// Version 3 devices offer a version 1 or 2 configuration too.
+pub(crate) fn parse(configuration: &Configuration, control: &Interface) -> Option<Function> {
+    let version = match control.protocol {
+        PROTOCOL_V2 => Version::V2,
+        PROTOCOL_V3 => return None,
+        _ => Version::V1,
+    };
+    let mut entities = BTreeMap::new();
+    let mut listed: Vec<u8> = Vec::new();
+    for d in &control.class_descriptors {
+        if d.len() < 4 || d[1] != CS_INTERFACE {
+            continue;
+        }
+        let id = d[3];
+        let entity = match (d[2], version) {
+            (ac::HEADER, Version::V1) => {
+                let count = usize::from(*d.get(7).unwrap_or(&0));
+                listed = d.iter().skip(8).take(count).copied().collect();
+                continue;
+            }
+            (ac::HEADER, Version::V2) => continue,
+            (ac::INPUT_TERMINAL, Version::V1) if d.len() >= 12 => {
+                Entity::InputTerminal { kind: u16_at(d, 4), channels: d[7], clock: 0, name: d[11] }
+            }
+            (ac::INPUT_TERMINAL, Version::V2) if d.len() >= 17 => {
+                Entity::InputTerminal { kind: u16_at(d, 4), channels: d[8], clock: d[7], name: d[16] }
+            }
+            (ac::OUTPUT_TERMINAL, Version::V1) if d.len() >= 9 => {
+                Entity::OutputTerminal { kind: u16_at(d, 4), source: d[7], clock: 0, name: d[8] }
+            }
+            (ac::OUTPUT_TERMINAL, Version::V2) if d.len() >= 12 => {
+                Entity::OutputTerminal { kind: u16_at(d, 4), source: d[7], clock: d[8], name: d[11] }
+            }
+            (ac::FEATURE_UNIT, Version::V1) if d.len() >= 7 => {
+                let size = usize::from(d[5]);
+                if size == 0 {
+                    continue;
+                }
+                let count = (d.len() - 7) / size;
+                let controls = (0..count)
+                    .map(|channel| {
+                        let at = 6 + channel * size;
+                        d[at..at + size].iter().rev().fold(0u32, |value, byte| value << 8 | u32::from(*byte))
+                    })
+                    .collect();
+                Entity::Feature { source: d[4], controls, name: *d.last().unwrap_or(&0) }
+            }
+            (ac::FEATURE_UNIT, Version::V2) if d.len() >= 6 => {
+                let count = (d.len() - 6) / 4;
+                let controls = (0..count).map(|channel| u32_at(d, 5 + channel * 4)).collect();
+                Entity::Feature { source: d[4], controls, name: *d.last().unwrap_or(&0) }
+            }
+            (ac::MIXER_UNIT | ac::SELECTOR_UNIT, _) if d.len() >= 5 => {
+                let pins = usize::from(d[4]);
+                Entity::Unit { sources: d.iter().skip(5).take(pins).copied().collect() }
+            }
+            (ac::PROCESSING_UNIT_V1 | ac::EXTENSION_UNIT_V1, Version::V1) | (ac::PROCESSING_UNIT_V2 | ac::EXTENSION_UNIT_V2, Version::V2)
+                if d.len() >= 7 =>
+            {
+                let pins = usize::from(d[6]);
+                Entity::Unit { sources: d.iter().skip(7).take(pins).copied().collect() }
+            }
+            (ac::EFFECT_UNIT_V2, Version::V2) if d.len() >= 7 => Entity::Unit { sources: vec![d[6]] },
+            (ac::SAMPLE_RATE_CONVERTER, Version::V2) if d.len() >= 5 => Entity::Unit { sources: vec![d[4]] },
+            (ac::CLOCK_SOURCE, Version::V2) if d.len() >= 8 => Entity::ClockSource { attributes: d[4], controls: d[5] },
+            (ac::CLOCK_SELECTOR, Version::V2) if d.len() >= 5 => {
+                let pins = usize::from(d[4]);
+                Entity::ClockSelector { sources: d.iter().skip(5).take(pins).copied().collect() }
+            }
+            (ac::CLOCK_MULTIPLIER, Version::V2) if d.len() >= 5 => Entity::ClockMultiplier { source: d[4] },
+            _ => continue,
+        };
+        entities.insert(id, entity);
+    }
+    // The streaming interfaces.
+    let numbers: Vec<u8> = match version {
+        Version::V1 => listed,
+        Version::V2 => {
+            let mut numbers = Vec::new();
+            let mut next = control.number + 1;
+            while configuration.interfaces.iter().any(|i| i.number == next && i.class == CLASS && i.subclass == SUBCLASS_STREAMING) {
+                numbers.push(next);
+                next += 1;
+            }
+            numbers
+        }
+    };
+    let mut streams = Vec::new();
+    for number in numbers {
+        let alts: Vec<&Interface> = configuration
+            .interfaces
+            .iter()
+            .filter(|i| i.number == number && i.class == CLASS && i.subclass == SUBCLASS_STREAMING)
+            .collect();
+        let mut stream: Option<Stream> = None;
+        for interface in alts {
+            let Some((terminal, alt)) = parse_alt(version, interface) else { continue };
+            let direction = if alt.endpoint.is_in() { Direction::Capture } else { Direction::Playback };
+            let stream = stream.get_or_insert_with(|| Stream { interface: number, direction, terminal, alts: Vec::new() });
+            if stream.direction == direction {
+                stream.alts.push(alt);
+            }
+        }
+        streams.extend(stream);
+    }
+    if streams.is_empty() {
+        return None;
+    }
+    Some(Function { version, control: control.number, entities, streams })
+}
+
+/// An alternate setting's format and endpoints, with the terminal it is
+/// linked to; none for the zero-bandwidth setting or a format that is not
+/// PCM (compressed audio, MIDI).
+fn parse_alt(version: Version, interface: &Interface) -> Option<(u8, Alt)> {
+    let general = interface.functional(as_::GENERAL)?;
+    let format = interface.functional(as_::FORMAT_TYPE)?;
+    if format.get(3) != Some(&FORMAT_TYPE_I) {
+        return None;
+    }
+    let endpoint = *interface
+        .endpoints
+        .iter()
+        .find(|e| e.transfer_type() == TRANSFER_ISOCHRONOUS && e.usage() != 1)?;
+    let (terminal, kind, channels, bytes, bits, rates) = match version {
+        Version::V1 => {
+            if general.len() < 7 || format.len() < 8 {
+                return None;
+            }
+            let tag = u16_at(general, 5);
+            let (channels, bytes, bits) = (format[4], format[5], format[6]);
+            let count = usize::from(format[7]);
+            let rates = if count == 0 {
+                Rates::Range(u24_at(format, 8), u24_at(format, 11))
+            } else {
+                Rates::List((0..count).map(|i| u24_at(format, 8 + i * 3)).filter(|rate| *rate != 0).collect())
+            };
+            let kind = match tag {
+                FORMAT_PCM => Kind::Pcm,
+                FORMAT_PCM8 => Kind::Pcm8,
+                FORMAT_IEEE_FLOAT => Kind::Float,
+                _ => return None,
+            };
+            (general[3], kind, channels, bytes, bits, rates)
+        }
+        Version::V2 => {
+            if general.len() < 11 || format.len() < 6 {
+                return None;
+            }
+            let formats = u32_at(general, 6);
+            let kind = if formats & FORMATS_V2_PCM != 0 {
+                Kind::Pcm
+            } else if formats & FORMATS_V2_PCM8 != 0 {
+                Kind::Pcm8
+            } else if formats & FORMATS_V2_IEEE_FLOAT != 0 {
+                Kind::Float
+            } else {
+                return None;
+            };
+            // The rates come from the clock (asked once the device runs).
+            (general[3], kind, general[10], format[4], format[5], Rates::List(Vec::new()))
+        }
+    };
+    let format = alsa_format(kind, bytes)?;
+    if channels == 0 {
+        return None;
+    }
+    // Asynchronous playback's feedback: version 1 names its endpoint;
+    // version 2's is the setting's other isochronous endpoint, an IN one.
+    let feedback = interface
+        .endpoints
+        .iter()
+        .find(|e| {
+            e.transfer_type() == TRANSFER_ISOCHRONOUS
+                && e.is_in()
+                && !endpoint.is_in()
+                && (e.usage() == 1 || (endpoint.synch_address != 0 && e.address == endpoint.synch_address))
+        })
+        .copied();
+    let alt = Alt {
+        alternate: interface.alternate,
+        format,
+        channels,
+        bytes,
+        bits: if bits == 0 { bytes * 8 } else { bits },
+        rates,
+        endpoint,
+        feedback,
+        rate_control: endpoint.class_attributes & 1 != 0,
+    };
+    Some((terminal, alt))
+}
+
+#[derive(Clone, Copy)]
+enum Kind {
+    Pcm,
+    Pcm8,
+    Float,
+}
+
+/// The ALSA format of a sample: as Linux's `parse_audio_format_i_type`.
+fn alsa_format(kind: Kind, bytes: u8) -> Option<u32> {
+    Some(match (kind, bytes) {
+        (Kind::Pcm, 1) => alsa::S8,
+        (Kind::Pcm, 2) => alsa::S16_LE,
+        (Kind::Pcm, 3) => alsa::S24_3LE,
+        (Kind::Pcm, 4) => alsa::S32_LE,
+        (Kind::Pcm8, 1) => alsa::U8,
+        (Kind::Float, 4) => alsa::FLOAT_LE,
+        _ => return None,
+    })
+}
+
+impl Function {
+    /// The clock a stream's terminal runs on (version 2): its terminal's
+    /// clock entity, which may be a selector or a multiplier in front of the
+    /// clock source.
+    pub(crate) fn clock_of(&self, stream: &Stream) -> Option<u8> {
+        match self.entities.get(&stream.terminal)? {
+            Entity::InputTerminal { clock, .. } | Entity::OutputTerminal { clock, .. } if *clock != 0 => Some(*clock),
+            _ => None,
+        }
+    }
+
+    /// The terminal at the end of a path upstream from `id` (through
+    /// feature units, which pass audio as it is): Linux's
+    /// `check_input_term`. A mixer or another unit ends it as a virtual
+    /// terminal (none).
+    fn input_terminal(&self, mut id: u8) -> Option<u16> {
+        for _ in 0..32 {
+            match self.entities.get(&id)? {
+                Entity::InputTerminal { kind, .. } => return Some(*kind),
+                Entity::Feature { source, .. } => id = *source,
+                _ => return None,
+            }
+        }
+        None
+    }
+
+    fn terminal_name(&self, id: u8) -> u8 {
+        match self.entities.get(&id) {
+            Some(Entity::InputTerminal { name, .. } | Entity::OutputTerminal { name, .. }) => *name,
+            _ => 0,
+        }
+    }
+
+    /// The feature units' volumes and mutes, as ALSA controls: each output
+    /// terminal's path upstream, every unit once (Linux's
+    /// `snd_usb_mixer_controls`). `string` gives a string descriptor.
+    pub(crate) fn controls(&self, string: &mut dyn FnMut(u8) -> Option<String>, card_name: &str) -> Vec<FeatureControl> {
+        let mut controls = Vec::new();
+        let mut seen: Vec<u8> = Vec::new();
+        for (&terminal, entity) in &self.entities {
+            let Entity::OutputTerminal { kind: output, source, .. } = entity else { continue };
+            let mut pending = vec![*source];
+            while let Some(id) = pending.pop() {
+                if seen.contains(&id) {
+                    continue;
+                }
+                seen.push(id);
+                match self.entities.get(&id) {
+                    Some(Entity::Feature { source, controls: bits, name }) => {
+                        pending.push(*source);
+                        self.feature_controls(id, *source, bits, *name, terminal, *output, string, card_name, &mut controls);
+                    }
+                    Some(Entity::Unit { sources }) => pending.extend(sources.iter().copied()),
+                    _ => {}
+                }
+            }
+        }
+        // Names are unique, as ALSA's are (with an index otherwise): a
+        // second of the same name goes.
+        let mut names: Vec<String> = Vec::new();
+        controls.retain(|control| {
+            let unique = !names.contains(&control.name);
+            names.push(control.name.clone());
+            unique
+        });
+        controls
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn feature_controls(
+        &self,
+        unit: u8,
+        source: u8,
+        bits: &[u32],
+        name: u8,
+        terminal: u8,
+        output: u16,
+        string: &mut dyn FnMut(u8) -> Option<String>,
+        card_name: &str,
+        out: &mut Vec<FeatureControl>,
+    ) {
+        // The control's name: the unit's own, the terminal upstream's, or
+        // the output's (Linux's rule), then whether it plays or records.
+        let base = (name != 0).then(|| string(name)).flatten().filter(|s| !s.is_empty()).or_else(|| {
+            let upstream = self.upstream_terminal(source);
+            upstream
+                .and_then(|(id, kind)| term_name(kind, self.terminal_name(id), string))
+                .or_else(|| term_name(output, self.terminal_name(terminal), string))
+        });
+        let mut base = base.unwrap_or_else(|| format!("Feature {}", unit));
+        // A headset's "Speaker" is its headphones (Linux's
+        // `check_no_speaker_on_headset`), as PulseAudio expects.
+        if base == "Speaker" && card_name.contains("Headset") {
+            base = "Headphone".to_string();
+        }
+        let capture = output >> 8 == 0x01;
+        let direction = if capture { " Capture" } else { " Playback" };
+        let has = |channel: usize, control: Control| -> bool {
+            let value = bits.get(channel).copied().unwrap_or(0);
+            match self.version {
+                Version::V1 => value & (1 << (control as u32 - 1)) != 0,
+                // Two bits per control: 01 readable, 11 settable.
+                Version::V2 => (value >> ((control as u32 - 1) * 2)) & 3 == 3,
+            }
+        };
+        let channels = bits.len().saturating_sub(1);
+        for control in [Control::Mute, Control::Volume] {
+            let per_channel: Vec<u8> = (1..=channels).filter(|channel| has(*channel, control)).map(|channel| channel as u8).collect();
+            // Per channel when the first has it (Linux's rule), else the master.
+            let channels = if per_channel.first() == Some(&1) {
+                per_channel
+            } else if has(0, control) {
+                vec![0]
+            } else {
+                continue;
+            };
+            let suffix = if control == Control::Mute { " Switch" } else { " Volume" };
+            out.push(FeatureControl {
+                unit,
+                control,
+                channels,
+                master_too: has(0, control) && per_channel_first(bits, self.version, control),
+                name: format!("{}{}{}", base, direction, suffix),
+                capture,
+            });
+        }
+    }
+
+    /// The input terminal upstream of `id` through feature units, with its id.
+    fn upstream_terminal(&self, mut id: u8) -> Option<(u8, u16)> {
+        let kind = self.input_terminal(id)?;
+        for _ in 0..32 {
+            match self.entities.get(&id)? {
+                Entity::InputTerminal { .. } => return Some((id, kind)),
+                Entity::Feature { source, .. } => id = *source,
+                _ => return None,
+            }
+        }
+        None
+    }
+}
+
+fn per_channel_first(bits: &[u32], version: Version, control: Control) -> bool {
+    let value = bits.get(1).copied().unwrap_or(0);
+    match version {
+        Version::V1 => value & (1 << (control as u32 - 1)) != 0,
+        Version::V2 => (value >> ((control as u32 - 1) * 2)) & 3 == 3,
+    }
+}
+
+/// A feature unit control (`UAC_FU_*`: 1 mute, 2 volume).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Control {
+    Mute = 1,
+    Volume = 2,
+}
+
+/// One ALSA control over a feature unit's channels.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct FeatureControl {
+    pub unit: u8,
+    pub control: Control,
+    /// The channels it sets (0: the master).
+    pub channels: Vec<u8>,
+    /// The master has it too: set to its neutral value (0 dB, on).
+    pub master_too: bool,
+    pub name: String,
+    pub capture: bool,
+}
+
+/// A terminal's name, as Linux's `get_term_name` gives it: its string, or
+/// what its type is called.
+fn term_name(kind: u16, name: u8, string: &mut dyn FnMut(u8) -> Option<String>) -> Option<String> {
+    if name != 0 {
+        if let Some(text) = string(name).filter(|text| !text.is_empty()) {
+            return Some(text);
+        }
+    }
+    let named = match kind & 0xff00 {
+        0x0100 => Some("PCM"),
+        0x0200 => Some("Mic"),
+        0x0400 => Some("Headset"),
+        0x0500 => Some("Phone"),
+        _ => None,
+    };
+    if let Some(named) = named {
+        return Some(named.to_string());
+    }
+    let named = match kind {
+        0x0300 => "Output",
+        0x0301 => "Speaker",
+        0x0302 => "Headphone",
+        0x0303 => "HMD Audio",
+        0x0304 => "Speaker",
+        0x0305 => "Room Speaker",
+        0x0306 => "Com Speaker",
+        0x0307 => "LFE",
+        0x0600 => "External In",
+        0x0601 => "Analog In",
+        0x0602 => "Digital In",
+        0x0603 => "Line",
+        0x0604 => "Legacy In",
+        0x0605 => "IEC958 In",
+        0x0606 => "1394 DA Stream",
+        0x0607 => "1394 DV Stream",
+        0x0700 => "Embedded",
+        0x0701 => "Noise Source",
+        0x0702 => "Equalization Noise",
+        0x0703 => "CD",
+        0x0704 => "DAT",
+        0x0705 => "DCC",
+        0x0706 => "MiniDisk",
+        0x0707 => "Analog Tape",
+        0x0708 => "Phonograph",
+        0x0709 => "VCR Audio",
+        0x070a => "Video Disk Audio",
+        0x070b => "DVD Audio",
+        0x070c => "TV Tuner Audio",
+        0x070d => "Satellite Rec Audio",
+        0x070e => "Cable Tuner Audio",
+        0x070f => "DSS Audio",
+        0x0710 => "Radio Receiver",
+        0x0711 => "Radio Transmitter",
+        0x0712 => "Multi-Track Recorder",
+        0x0713 => "Synthesizer",
+        _ => return None,
+    };
+    Some(named.to_string())
+}
+
+/// The card's ID as ALSA makes one from its name: the last word's letters
+/// and digits, at most 15 (`snd_card_set_id`), "Default" without any.
+pub(crate) fn card_id(name: &str) -> String {
+    let word = name.split(|c: char| c.is_whitespace() || c == '_' || c == '-').filter(|w| w.chars().any(|c| c.is_ascii_alphanumeric())).last().unwrap_or("");
+    let mut id: String = word.chars().filter(char::is_ascii_alphanumeric).take(15).collect();
+    if id.starts_with(|c: char| c.is_ascii_digit()) {
+        id.insert(0, 'D');
+        id.truncate(15);
+    }
+    if id.is_empty() || id.starts_with("card") {
+        id = "Default".to_string();
+    }
+    id
+}
+
+/// A UAC2 range reply (`wNumSubRanges` and triplets of `size` bytes each):
+/// the rates it allows, as Linux's `parse_uac2_sample_rate_range`.
+pub(crate) fn rates_of_range(reply: &[u8]) -> Vec<u32> {
+    let count = usize::from(u16_at(reply, 0));
+    let mut rates = Vec::new();
+    for index in 0..count {
+        let at = 2 + index * 12;
+        if at + 12 > reply.len() {
+            break;
+        }
+        let (low, high, step) = (u32_at(reply, at), u32_at(reply, at + 4), u32_at(reply, at + 8));
+        if low == 0 {
+            continue;
+        }
+        if step == 0 || low == high {
+            if !rates.contains(&low) {
+                rates.push(low);
+            }
+            continue;
+        }
+        for rate in KNOWN_RATES {
+            if (low..=high).contains(&rate) && (rate - low) % step == 0 && !rates.contains(&rate) {
+                rates.push(rate);
+            }
+        }
+    }
+    rates.sort_unstable();
+    rates
+}
+
+/// How many packets per second an isochronous endpoint carries at a speed
+/// (bInterval is an exponent for full speed and faster: Linux's
+/// `snd_usb_parse_datainterval`).
+pub(crate) fn packets_per_second(full_speed: bool, interval: u8) -> u32 {
+    let exponent = u32::from(interval.clamp(1, 16)) - 1;
+    let base = if full_speed { 1000 } else { 8000 };
+    (base >> exponent.min(13)).max(1)
+}
+
+/// Frames per packet in 16.16 fixed point, from a feedback endpoint's
+/// value: full speed sends 10.14 in 3 bytes, faster speeds 16.16 in 4; some
+/// devices use other shifts. The one that lands near the nominal value is
+/// it (Linux's `snd_usb_handle_sync_urb`), none when nothing does.
+pub(crate) fn feedback_value(raw: u32, nominal: u32) -> Option<u32> {
+    if raw == 0 {
+        return None;
+    }
+    for shift in [0i32, 2, -1, 1, 3, 4] {
+        let value = if shift >= 0 { raw.checked_shl(shift as u32)? } else { raw >> (-shift) as u32 };
+        // Within an eighth of the nominal rate.
+        let low = nominal - nominal / 8;
+        let high = nominal + nominal / 8;
+        if (low..=high).contains(&value) {
+            return Some(value);
+        }
+    }
+    None
+}
+
+#[cfg(ktest)]
+mod tests {
+    use ostd::prelude::ktest;
+
+    use super::*;
+
+    #[ktest]
+    fn names_ids_like_alsa() {
+        assert_eq!(card_id("Logitech USB Headset"), "Headset");
+        assert_eq!(card_id("USB Audio Device"), "Device");
+        assert_eq!(card_id("Plantronics C320-M"), "M");
+        assert_eq!(card_id(""), "Default");
+    }
+
+    #[ktest]
+    fn reads_rate_ranges() {
+        let mut reply = vec![2, 0];
+        for (low, high, step) in [(44100u32, 44100u32, 0u32), (48000, 96000, 48000)] {
+            reply.extend_from_slice(&low.to_le_bytes());
+            reply.extend_from_slice(&high.to_le_bytes());
+            reply.extend_from_slice(&step.to_le_bytes());
+        }
+        assert_eq!(rates_of_range(&reply), vec![44100, 48000, 96000]);
+    }
+
+    #[ktest]
+    fn finds_the_feedback_format() {
+        // 48 frames per millisecond: 10.14 at full speed, 16.16 at high.
+        let nominal = 48 << 16;
+        assert_eq!(feedback_value(48 << 14, nominal), Some(nominal));
+        assert_eq!(feedback_value(nominal, nominal), Some(nominal));
+        assert_eq!(feedback_value(1, nominal), None);
+    }
+}
