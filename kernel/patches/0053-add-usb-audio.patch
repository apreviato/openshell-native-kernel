+/// Adds a card with the lowest free number, as Linux numbers them: `build`
+/// makes it with that number. Its device files follow (the card hook).
+pub fn add_card(build: impl FnOnce(u32) -> Option<Arc<Card>>) -> Option<Arc<Card>> {
+    let card = {
+        let mut cards = CARDS.lock();
+        let index = (0..MAX_CARDS).find(|index| cards.iter().all(|card| card.index != *index))?;
+        let card = build(index)?;
+        cards.push(card.clone());
+        card
+    };
+    if let Some(hook) = CARD_HOOK.get() {
+        hook(&card);
+    }
+    note_activity();
+    Some(card)
+}
+
+/// Takes a card away (its device went): its streams are disconnected,
+/// which whoever has them open sees, and its device files go.
+pub fn remove_card(card: &Arc<Card>) {
+    CARDS.lock().retain(|other| !Arc::ptr_eq(other, card));
+    for pcm in card.pcms() {
+        pcm.disconnect();
+    }
+    if let Some(hook) = CARD_GONE_HOOK.get() {
+        hook(card);
+    }
+    card.event_wait.wake_all();
+    note_activity();
+}
