+/// What period and buffer sizes in bytes must be multiples of: the
+/// hardware's step and, once the frame's size is known, whole frames (a
+/// USB device's 6-byte frames, 24 bits in 3 bytes on two channels, would
+/// otherwise leave a period a fraction of a frame and the periods no
+/// whole number).
+fn byte_step(params: &HwParams, limits: &HwLimits) -> u32 {
+    let step = limits.byte_step.max(1);
+    let frame = params.interval(param::FRAME_BITS);
+    if !frame.is_single() {
+        return step;
+    }
+    let bytes = params.get(param::FRAME_BITS) / 8;
+    if bytes == 0 {
+        return step;
+    }
+    let (mut a, mut b) = (step, bytes);
+    while b != 0 {
+        (a, b) = (b, a % b);
+    }
+    step / a * bytes
+}
