diff --git a/kernel/core/src/fs/firmware.rs b/kernel/core/src/fs/firmware.rs
new file mode 100644
index 0000000..b645d55
--- /dev/null
+++ b/kernel/core/src/fs/firmware.rs
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Firmware files for device drivers: what the `aster-firmware` component
+//! reads them with. A file is looked for under the directories Linux
+//! keeps firmware in, as the first process sees them: the system's root
+//! once that process has mounted it.
+
+use alloc::format;
+
+use super::{file::InodeType, vfs::path::FsPath};
+use crate::{
+    prelude::*,
+    process::{INIT_PROCESS_PID, pid_table, posix_thread::AsPosixThread},
+};
+
+const DIRECTORIES: [&str; 2] = ["/lib/firmware", "/usr/lib/firmware"];
+
+pub(super) fn init() {
+    aster_firmware::set_reader(read);
+}
+
+fn read(name: &str) -> Option<Vec<u8>> {
+    let process = pid_table::pid_table_mut().get_process_unfiltered(INIT_PROCESS_PID)?;
+    let thread = process.main_thread();
+    let fs = thread.as_posix_thread()?.read_fs();
+    let resolver = fs.resolver().read();
+    for directory in DIRECTORIES {
+        let path = format!("{}/{}", directory, name);
+        let Ok(fs_path) = FsPath::try_from(path.as_str()) else {
+            continue;
+        };
+        let Ok(found) = resolver.lookup(&fs_path) else {
+            continue;
+        };
+        let inode = found.inode();
+        let size = inode.size();
+        if inode.type_() != InodeType::File || size == 0 || size > aster_firmware::MAX_SIZE {
+            continue;
+        }
+        let mut bytes = vec![0u8; size];
+        let mut offset = 0;
+        while offset < size {
+            match inode.read_bytes_at(offset, &mut bytes[offset..]) {
+                Ok(0) | Err(_) => break,
+                Ok(length) => offset += length,
+            }
+        }
+        if offset == size {
+            return Some(bytes);
+        }
+    }
+    None
+}
