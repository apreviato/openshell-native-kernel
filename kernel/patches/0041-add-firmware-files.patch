diff --git a/kernel/comps/firmware/src/lib.rs b/kernel/comps/firmware/src/lib.rs
new file mode 100755
index 0000000..0462a7e
--- /dev/null
+++ b/kernel/comps/firmware/src/lib.rs
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Firmware files for the devices that need them (Wi-Fi and Bluetooth
+//! chips run code their makers publish in linux-firmware): a driver asks
+//! for a file by the name Linux knows it by, and gets its bytes from
+//! `/lib/firmware` of the running system.
+//!
+//! The kernel reads files; this component does not. The kernel registers
+//! its reader ([`set_reader`]) and drivers wait here ([`load`]) until the
+//! file is there: the first requests come while the system's files are
+//! still being found (the root of an installed system is mounted by the
+//! first program), so a file that is missing is looked for again for a
+//! while before the driver is told there is none.
+
+#![no_std]
+#![deny(unsafe_code)]
+
+extern crate alloc;
+
+// This crate's log prefix for `ostd::log`.
+macro_rules! __log_prefix {
+    () => {
+        "firmware: "
+    };
+}
+
+use alloc::{sync::Arc, vec::Vec};
+use core::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+use component::{ComponentInitError, init_component};
+use ostd::{sync::WaitQueue, timer::Jiffies};
+use spin::Once;
+
+/// The largest file taken: the biggest in linux-firmware are a few
+/// megabytes.
+pub const MAX_SIZE: usize = 32 * 1024 * 1024;
+/// The longest name, with its directories.
+const MAX_NAME: usize = 128;
+/// How long a missing file is looked for, and how often.
+const WAIT_MS: u64 = 45_000;
+const RETRY_MS: u64 = 500;
+
+/// Reads a firmware file by its name under the firmware directories, if
+/// it is there now.
+pub type Reader = fn(name: &str) -> Option<Vec<u8>>;
+
+static READER: Once<Reader> = Once::new();
+static WAKE: WaitQueue = WaitQueue::new();
+static WOKEN: AtomicBool = AtomicBool::new(false);
+static WAITERS: AtomicUsize = AtomicUsize::new(0);
+static TICKS: AtomicUsize = AtomicUsize::new(0);
+
+/// The kernel's reader of firmware files.
+pub fn set_reader(reader: Reader) {
+    READER.call_once(|| reader);
+}
+
+/// Whether a name is one a driver may ask for: a relative path of plain
+/// characters, without `..`.
+pub fn valid_name(name: &str) -> bool {
+    !name.is_empty()
+        && name.len() <= MAX_NAME
+        && name.split('/').all(|part| {
+            !part.is_empty()
+                && part != "."
+                && part != ".."
+                && part.bytes().all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'.' | b'_' | b'-'))
+        })
+}
+
+fn now_ms() -> u64 {
+    Jiffies::elapsed().as_duration().as_millis() as u64
+}
+
+/// Each timer tick (1 ms): every 100, the tasks that wait for a file.
+fn tick() {
+    let ticks = TICKS.fetch_add(1, Ordering::Relaxed);
+    if ticks % 100 == 0 && WAITERS.load(Ordering::Relaxed) != 0 {
+        WOKEN.store(true, Ordering::Release);
+        WAKE.wake_all();
+    }
+}
+
+fn sleep_ms(ms: u64) {
+    let deadline = now_ms() + ms;
+    WAITERS.fetch_add(1, Ordering::AcqRel);
+    while now_ms() < deadline {
+        WAKE.wait_until(|| WOKEN.swap(false, Ordering::AcqRel).then_some(()));
+    }
+    WAITERS.fetch_sub(1, Ordering::AcqRel);
+}
+
+/// The file `name` if it is there now.
+pub fn try_load(name: &str) -> Option<Arc<[u8]>> {
+    if !valid_name(name) {
+        return None;
+    }
+    let bytes = (READER.get()?)(name)?;
+    (!bytes.is_empty() && bytes.len() <= MAX_SIZE).then(|| bytes.into())
+}
+
+/// The file `name`, waiting for the system's files while they are not
+/// there yet. Called from a driver's own task: it sleeps.
+pub fn load(name: &str) -> Option<Arc<[u8]>> {
+    if !valid_name(name) {
+        ostd::warn!("{:?} is not a firmware name", name);
+        return None;
+    }
+    let deadline = now_ms() + WAIT_MS;
+    loop {
+        if let Some(bytes) = try_load(name) {
+            ostd::info!("{} ({} bytes)", name, bytes.len());
+            return Some(bytes);
+        }
+        if now_ms() >= deadline {
+            return None;
+        }
+        sleep_ms(RETRY_MS);
+    }
+}
+
+/// The first of `names` that is there (a chip's newest firmware first),
+/// with its name; waits as [`load`] does.
+pub fn load_first<'a>(names: impl IntoIterator<Item = &'a str> + Clone) -> Option<(&'a str, Arc<[u8]>)> {
+    let deadline = now_ms() + WAIT_MS;
+    loop {
+        for name in names.clone() {
+            if let Some(bytes) = try_load(name) {
+                ostd::info!("{} ({} bytes)", name, bytes.len());
+                return Some((name, bytes));
+            }
+        }
+        if now_ms() >= deadline {
+            return None;
+        }
+        sleep_ms(RETRY_MS);
+    }
+}
+
+#[init_component]
+fn init() -> Result<(), ComponentInitError> {
+    ostd::timer::register_callback_on_cpu(tick);
+    Ok(())
+}
