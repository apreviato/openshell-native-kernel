+impl Mvm {
+    pub(crate) fn new(trans: Transport, firmware: &Firmware) -> Self {
+        let mac = trans.mac;
+        let ax210 = matches!(mac.family, Family::Ax210 | Family::Bz);
+        let (tx_ant, rx_ant) = firmware.antennas();
+        let scan_slots = (firmware.scan_channels as usize).clamp(1, SCAN_MAX_CHANNELS);
+        Self {
+            ac7000: mac.family == Family::Ac7000,
+            nvm_sdp: ids::nvm_sdp(mac),
+            station_v7: !firmware.has_api(gen1::API_STA_TYPE) && !firmware.has_capability(gen1::CAPA_MULTI_QUEUE_RX),
+            lmac_scan: !firmware.has_capability(gen1::CAPA_UMAC_SCAN),
+            bt_mplut: firmware.has_capability(gen1::CAPA_BT_MPLUT),
+            valid_channels: None,
+            mld: mac.family == Family::Bz,
+            ap: None,
+            rx_agreements: Vec::new(),
+            beacon_version: if !firmware.has_capability(CAPA_CSA_AND_TBTT_OFFLOAD) {
+                6
+            } else if firmware.has_api(API_NEW_BEACON_TEMPLATE) {
+                9
+            } else {
+                7
+            },
+            power_save: false,
+            power_cmd_v2: firmware.command_version(LONG, MAC_PM_POWER_TABLE) >= 2,
+            baid_cmd: mac.family == Family::Bz || firmware.has_capability(ba::CAPA_BAID_ML_SUPPORT),
+            baid_remove_v1: firmware.command_version(DATA_PATH, 0x16) <= 1,
+            gen1: matches!(mac.family, Family::Ac9000 | Family::Ac8000 | Family::Ac7000),
+            legacy_rx: matches!(mac.family, Family::Ac8000 | Family::Ac7000),
+            last_phy: Vec::new(),
+            phy_db: Vec::new(),
+            time_event: None,
+            authorized: false,
+            rates: gen1::Rates::default(),
+            aux_queue: None,
+            station_queues: 0,
+            extra_phy_config: ids::extra_phy_config(mac),
+            scan_slots,
+            scan_version: firmware.command_version(LONG, SCAN_REQ_UMAC),
+            adaptive_dwell: firmware.has_api(gen1::API_ADAPTIVE_DWELL),
+            adaptive_dwell_v2: firmware.has_api(gen1::API_ADAPTIVE_DWELL_V2),
+            name: trans.name.clone(),
+            mac,
+            ax210,
+            tx_cmd_v10: firmware.command_version(LONG, TX_CMD) >= 10,
+            rx_desc_len: if ax210 { 64 } else { 48 },
+            uhb: firmware.has_capability(CAPA_ULTRA_HB_CHANNELS),
+            band_6: ax210 && firmware.has_capability(CAPA_ULTRA_HB_CHANNELS),
+            eht: mac.family == Family::Bz && ids::eht_radio(trans.hw_rf_id, trans.subsystem_device),
+            eht_320: mac.family == Family::Bz && ids::eht_radio(trans.hw_rf_id, trans.subsystem_device) && !ids::bw_limited(trans.subsystem_device),
+            tlc_v5: firmware.command_version(DATA_PATH, TLC_MNG_CONFIG_CMD) == TLC_CONFIG_V5,
+            cdb: firmware.has_capability(CAPA_CDB_SUPPORT),
+            lar: firmware.has_capability(CAPA_LAR_SUPPORT),
+            soc_latency: firmware.has_capability(CAPA_SOC_LATENCY_SUPPORT),
+            tx_ant: if tx_ant == 0 { 0x3 } else { tx_ant },
+            rx_ant: if rx_ant == 0 { 0x3 } else { rx_ant },
+            address: [0; 6],
+            band_24: true,
+            band_52: true,
+            ht: true,
+            scan_channels: (firmware.scan_channels as usize).clamp(1, SCAN_MAX_CHANNELS),
+            device: None,
+            dead: false,
+            mac_added: false,
+            phy_added: false,
+            binding_added: false,
+            station_added: false,
+            network: None,
+            associated: false,
+            aid: 0,
+            qos: false,
+            management_queue: None,
+            data_queue: None,
+            sequence: [0; 17],
+            pairwise: None,
+            scanning: false,
+            signal: None,
+            trans,
+        }
+    }
+
+    /// Back to the state `new` makes, the transport, the name and the
+    /// Wi-Fi component's device kept: before the firmware is loaded and
+    /// configured again after an error (generated from `new`'s values).
+    pub(crate) fn reset(&mut self, firmware: &Firmware) {
+        let mac = self.trans.mac;
+        let ax210 = matches!(mac.family, Family::Ax210 | Family::Bz);
+        let (tx_ant, rx_ant) = firmware.antennas();
+        let scan_slots = (firmware.scan_channels as usize).clamp(1, SCAN_MAX_CHANNELS);
+        self.ac7000 = mac.family == Family::Ac7000;
+        self.nvm_sdp = ids::nvm_sdp(mac);
+        self.station_v7 = !firmware.has_api(gen1::API_STA_TYPE) && !firmware.has_capability(gen1::CAPA_MULTI_QUEUE_RX);
+        self.lmac_scan = !firmware.has_capability(gen1::CAPA_UMAC_SCAN);
+        self.bt_mplut = firmware.has_capability(gen1::CAPA_BT_MPLUT);
+        self.valid_channels = None;
+        self.mld = mac.family == Family::Bz;
+        self.ap = None;
+        self.rx_agreements = Vec::new();
+        self.beacon_version = if !firmware.has_capability(CAPA_CSA_AND_TBTT_OFFLOAD) {
+                6
+            } else if firmware.has_api(API_NEW_BEACON_TEMPLATE) {
+                9
+            } else {
+                7
+            };
+        self.power_save = false;
+        self.power_cmd_v2 = firmware.command_version(LONG, MAC_PM_POWER_TABLE) >= 2;
+        self.baid_cmd = mac.family == Family::Bz || firmware.has_capability(ba::CAPA_BAID_ML_SUPPORT);
+        self.baid_remove_v1 = firmware.command_version(DATA_PATH, 0x16) <= 1;
+        self.gen1 = matches!(mac.family, Family::Ac9000 | Family::Ac8000 | Family::Ac7000);
+        self.legacy_rx = matches!(mac.family, Family::Ac8000 | Family::Ac7000);
+        self.last_phy = Vec::new();
+        self.phy_db = Vec::new();
+        self.time_event = None;
+        self.authorized = false;
+        self.rates = gen1::Rates::default();
+        self.aux_queue = None;
+        self.station_queues = 0;
+        self.extra_phy_config = ids::extra_phy_config(mac);
+        self.scan_slots = scan_slots;
+        self.scan_version = firmware.command_version(LONG, SCAN_REQ_UMAC);
+        self.adaptive_dwell = firmware.has_api(gen1::API_ADAPTIVE_DWELL);
+        self.adaptive_dwell_v2 = firmware.has_api(gen1::API_ADAPTIVE_DWELL_V2);
+        self.mac = mac;
+        self.ax210 = ax210;
+        self.tx_cmd_v10 = firmware.command_version(LONG, TX_CMD) >= 10;
+        self.rx_desc_len = if ax210 { 64 } else { 48 };
+        self.uhb = firmware.has_capability(CAPA_ULTRA_HB_CHANNELS);
+        self.band_6 = ax210 && firmware.has_capability(CAPA_ULTRA_HB_CHANNELS);
+        self.eht = mac.family == Family::Bz && ids::eht_radio(self.trans.hw_rf_id, self.trans.subsystem_device);
+        self.eht_320 = mac.family == Family::Bz && ids::eht_radio(self.trans.hw_rf_id, self.trans.subsystem_device) && !ids::bw_limited(self.trans.subsystem_device);
+        self.tlc_v5 = firmware.command_version(DATA_PATH, TLC_MNG_CONFIG_CMD) == TLC_CONFIG_V5;
+        self.cdb = firmware.has_capability(CAPA_CDB_SUPPORT);
+        self.lar = firmware.has_capability(CAPA_LAR_SUPPORT);
+        self.soc_latency = firmware.has_capability(CAPA_SOC_LATENCY_SUPPORT);
+        self.tx_ant = if tx_ant == 0 { 0x3 } else { tx_ant };
+        self.rx_ant = if rx_ant == 0 { 0x3 } else { rx_ant };
+        self.address = [0; 6];
+        self.band_24 = true;
+        self.band_52 = true;
+        self.ht = true;
+        self.scan_channels = (firmware.scan_channels as usize).clamp(1, SCAN_MAX_CHANNELS);
+        self.dead = false;
+        self.mac_added = false;
+        self.phy_added = false;
+        self.binding_added = false;
+        self.station_added = false;
+        self.network = None;
+        self.associated = false;
+        self.aid = 0;
+        self.qos = false;
+        self.management_queue = None;
+        self.data_queue = None;
+        self.sequence = [0; 17];
+        self.pairwise = None;
+        self.scanning = false;
+        self.signal = None;
+    }
+
+    // ---- Commands and what comes back. ----
+
+    /// Sends a command and waits for its answer, handling what else comes
+    /// meanwhile. Legacy commands go in the long group, as Linux sends
+    /// them with the wide header.
+    fn command(&mut self, group: u8, id: u8, payload: &[u8]) -> Result<Vec<u8>, String> {
+        if self.dead {
+            return Err(String::from("the firmware stopped"));
+        }
+        let group = if group == 0 { LONG } else { group };
+        let sequence = self
+            .trans
+            .send_command(group, id, 0, payload)
+            .ok_or_else(|| format!("command {group:#x}/{id:#x} did not fit the queue"))?;
+        self.wait_for(COMMAND_TIMEOUT_MS, &format!("command {group:#x}/{id:#x}"), |packet| packet.answers(sequence))
+    }
+
+    /// A command whose answer is a status: `ok` is the good one.
+    fn command_status(&mut self, group: u8, id: u8, payload: &[u8], ok: u32) -> Result<(), String> {
+        let answer = self.command(group, id, payload)?;
+        let status = le32(&answer, 0);
+        if answer.len() >= 4 && status != ok {
+            return Err(format!("command {group:#x}/{id:#x} refused (status {status:#x})"));
+        }
+        Ok(())
+    }
+
+    /// Waits for a notification of the long group (or another `group`).
+    fn notification(&mut self, group: u8, id: u8, timeout_ms: u64) -> Result<Vec<u8>, String> {
+        self.wait_for(timeout_ms, &format!("notification {group:#x}/{id:#x}"), |packet| {
+            packet.command == id && (packet.group == group || (group <= LONG && packet.group <= LONG))
+        })
+    }
+
+    fn wait_for(&mut self, timeout_ms: u64, what: &str, wanted: impl Fn(&Packet) -> bool) -> Result<Vec<u8>, String> {
+        let deadline = crate::now_ms() + timeout_ms;
+        let waiting = crate::WAKER.waiting();
+        let result = loop {
+            let causes = self.trans.causes();
+            let mut found = None;
+            for packet in self.trans.receive() {
+                if found.is_none() && wanted(&packet) {
+                    found = Some(packet.data);
+                } else {
+                    self.handle(packet);
+                }
+            }
+            if let Some(data) = found {
+                break Ok(data);
+            }
+            if causes.error {
+                self.died();
+                break Err(String::from("the firmware stopped with an error"));
+            }
+            if crate::now_ms() >= deadline {
+                break Err(format!("no answer to {what}"));
+            }
+            crate::sleep();
+        };
+        drop(waiting);
+        result
+    }
+
+    /// Reads what the card said: from its task, between commands.
+    pub(crate) fn poll(&mut self) {
+        if self.dead {
+            return;
+        }
+        let causes = self.trans.causes();
+        for packet in self.trans.receive() {
+            self.handle(packet);
+        }
+        if causes.error {
+            self.died();
+            return;
+        }
+        // The first generation's rate table, when its rate control moved:
+        // sent here, between commands, never from inside one's wait.
+        if self.gen1 && self.rates.dirty && self.associated {
+            if let Err(error) = self.send_rates() {
+                ostd::info!("{}: rates: {}", self.name, error);
+            }
+        }
+    }
+
+    fn died(&mut self) {
+        if self.dead {
+            return;
+        }
+        self.dead = true;
+        ostd::warn!("{}: the firmware stopped with an error", self.name);
+        if let Some(device) = &self.device {
+            if self.scanning {
+                device.scan_done(true);
+            }
+            device.connection_lost();
+        }
+        self.scanning = false;
+    }
+
+    fn handle(&mut self, packet: Packet) {
+        let legacy = packet.group <= LONG;
+        match packet.command {
+            gen1::REPLY_RX_PHY_CMD if legacy && self.legacy_rx => self.last_phy = packet.data,
+            REPLY_RX_MPDU_CMD if legacy && self.legacy_rx => self.rx_mpdu_legacy(&packet.data),
+            REPLY_RX_MPDU_CMD if legacy => self.rx_mpdu(&packet.data),
+            TX_CMD if legacy && self.gen1 => self.tx_response_gen1(packet.sequence, &packet.data),
+            TX_CMD if legacy => self.tx_response(&packet.data),
+            gen1::CALIB_RES_NOTIF_PHY_DB if legacy && self.gen1 => self.store_phy_db(&packet.data),
+            gen1::TIME_EVENT_NOTIFICATION if legacy && self.gen1 => self.time_event_notification(&packet.data),
+            SCAN_COMPLETE_UMAC if legacy => self.scan_complete(packet.data.get(6).copied().unwrap_or(0)),
+            // The LMAC scan's end (`struct iwl_periodic_scan_complete`).
+            gen1::SCAN_OFFLOAD_COMPLETE if legacy && self.lmac_scan => self.scan_complete(packet.data.get(2).copied().unwrap_or(0)),
+            MISSED_BEACONS_NOTIFICATION if legacy => self.missed_beacons(&packet.data),
+            ba::FRAME_RELEASE if legacy => self.frame_release(&packet.data),
+            ba::BAR_FRAME_RELEASE if legacy => self.bar_frame_release(&packet.data),
+            MISSED_BEACONS_NOTIF if packet.group == MAC_CONF => self.missed_beacons(&packet.data),
+            _ => {}
+        }
+    }
+
+    fn scan_complete(&mut self, status: u8) {
+        if self.scanning {
+            self.scanning = false;
+            if let Some(device) = &self.device {
+                device.scan_done(status != SCAN_OFFLOAD_COMPLETED);
+            }
+        }
+    }
+
+    /// A channel the NVM allows (all of them where the firmware keeps to
+    /// the region itself).
+    fn channel_allowed(&self, freq: u16) -> bool {
+        self.valid_channels.as_ref().is_none_or(|valid| valid.contains(&channel_number(freq)))
+    }
+
+    fn missed_beacons(&mut self, data: &[u8]) {
+        let missed = le32(data, 4);
+        if missed >= MISSED_BEACONS_LOST && self.associated {
+            ostd::info!("{}: {} beacons missed", self.name, missed);
+            if let Some(device) = &self.device {
+                device.connection_lost();
+            }
+        }
+    }
+
+    // ---- The firmware's start. ----
+
+    /// Everything between the firmware's ALIVE (`alive`, its notification)
+    /// and a radio ready to scan. The first generation's runtime program
+    /// (after the calibrating one, [`Mvm::run_init_image`]) takes its own.
+    pub(crate) fn init(&mut self, alive: &[u8], prefix: &str, firmware: &Firmware, file: &[u8]) -> Result<(), String> {
+        if self.gen1 {
+            // The 9000 family's address is in its registers; the 8000
+            // family's came from the NVM (or the MAC's own registers), the
+            // 7000 family's from the NVM.
+            if !self.legacy_rx {
+                self.address = self.trans.mac_address();
+            } else if self.address == [0; 6] && !self.ac7000 {
+                self.address = self.trans.mac_address_wfmp();
+            }
+            if self.address == [0; 6] || self.address[0] & 1 != 0 {
+                return Err(String::from("the card has no MAC address"));
+            }
+            self.init_gen1(firmware, file)?;
+            self.mac_context(FW_CTXT_ACTION_ADD)?;
+            self.mac_added = true;
+            return Ok(());
+        }
+        if self.mld {
+            return self.init_mld(alive, prefix, firmware);
+        }
+        if self.ax210 {
+            self.load_pnvm(alive, prefix)?;
+        }
+        self.command(SYSTEM, INIT_EXTENDED_CFG_CMD, &1u32.to_le_bytes())?;
+        self.command(REGULATORY, NVM_ACCESS_COMPLETE, &0u32.to_le_bytes())?;
+        self.notification(LONG, INIT_COMPLETE_NOTIF, COMMAND_TIMEOUT_MS)?;
+        let nvm = self.command(REGULATORY, NVM_GET_INFO, &0u32.to_le_bytes())?;
+        if nvm.len() >= 20 {
+            let sku = le32(&nvm, 8);
+            self.band_24 = sku & NVM_MAC_SKU_24 != 0;
+            self.band_52 = sku & NVM_MAC_SKU_52 != 0;
+            self.ht = sku & NVM_MAC_SKU_11N != 0;
+            let (tx, rx) = (le32(&nvm, 12) as u8, le32(&nvm, 16) as u8);
+            if tx & self.tx_ant != 0 {
+                self.tx_ant &= tx;
+            }
+            if rx & self.rx_ant != 0 {
+                self.rx_ant &= rx;
+            }
+            if sku & NVM_MAC_SKU_MIMO_DISABLED != 0 {
+                self.tx_ant &= self.tx_ant.wrapping_neg();
+                self.rx_ant &= self.rx_ant.wrapping_neg();
+            }
+        }
+        if !self.band_24 && !self.band_52 {
+            self.band_24 = true;
+        }
+        self.address = self.trans.mac_address();
+        if self.address == [0; 6] || self.address[0] & 1 != 0 {
+            return Err(String::from("the card has no MAC address"));
+        }
+        self.command(0, TX_ANT_CONFIGURATION_CMD, &(self.tx_ant as u32).to_le_bytes())?;
+        self.bt_config()?;
+        self.soc_configuration()?;
+        // The device may save power; the link's own power save is the MAC
+        // power command's.
+        self.command(0, POWER_TABLE_CMD, &Out::default().u16(DEVICE_POWER_FLAGS_POWER_SAVE_ENA).u16(0).0)?;
+        self.region();
+        let scan_config = Out::default().u8(0).u8(0).u8(0).u8(0).u32(self.tx_ant as u32).u32(self.rx_ant as u32).0.clone();
+        self.command(0, SCAN_CFG_CMD, &scan_config)?;
+        self.mac_context(FW_CTXT_ACTION_ADD)?;
+        self.mac_added = true;
+        Ok(())
+    }
+
+    /// Coexistence with the Bluetooth of the same card (Linux's
+    /// `iwl_mvm_send_bt_init_conf`): the firmware decides, with SCO
+    /// synchronization, the high band's own antenna use and, where the
+    /// firmware has it, its sharing table.
+    fn bt_config(&mut self) -> Result<(), String> {
+        let mut modules = BT_COEX_SYNC2SCO_ENABLED | BT_COEX_HIGH_BAND_RET;
+        if self.bt_mplut {
+            modules |= BT_COEX_MPLUT_ENABLED;
+        }
+        self.command(0, BT_CONFIG, &Out::default().u32(BT_COEX_NW).u32(modules).0).map(|_| ())
+    }
+
+    /// The platform's crystal latency, for firmware that asks for it
+    /// (`SOC_CONFIGURATION_CMD`).
+    fn soc_configuration(&mut self) -> Result<(), String> {
+        if !self.soc_latency {
+            return Ok(());
+        }
+        let (latency, ltr_delay, low_latency) = ids::soc_latency(self.mac);
+        let mut flags = if self.mac.integrated { 0 } else { SOC_CONFIG_CMD_FLAGS_DISCRETE };
+        if self.mac.integrated {
+            flags |= (ltr_delay as u32) << 2;
+        }
+        if low_latency {
+            flags |= SOC_CONFIG_CMD_FLAGS_LOW_LATENCY;
+        }
+        self.command(SYSTEM, SOC_CONFIGURATION_CMD, &Out::default().u32(flags).u32(latency).0).map(|_| ())
+    }
+
+    /// The firmware's region as it knows it ("ZZ": the world's until an
+    /// access point says where it is), with LAR.
+    fn region(&mut self) {
+        if !self.lar {
+            return;
+        }
+        let mut mcc = Out::default();
+        mcc.u16(u16::from_be_bytes(*b"ZZ")).u8(MCC_SOURCE_GET_CURRENT).u8(0).u32(0).zeros(20);
+        if let Err(error) = self.command(0, MCC_UPDATE_CMD, &mcc.0) {
+            ostd::info!("{}: region: {}", self.name, error);
+        }
+    }
+
+    /// The supplicant opened (or closed) the port: data frames go at the
+    /// rate control's rates once it is open.
+    pub(crate) fn authorize(&mut self, authorized: bool) {
+        self.authorized = authorized;
+        if self.mld {
+            self.mld_authorized();
+        }
+    }
+
+    /// The AX210 family's platform NVM data: the part of the `.pnvm` file
+    /// for this card's SKU (from ALIVE), then the doorbell, then the
+    /// firmware's word that it took it. Without the file the firmware runs
+    /// on its own defaults.
+    fn load_pnvm(&mut self, alive: &[u8], prefix: &str) -> Result<(), String> {
+        let sku = [le32(alive, 116), le32(alive, 120), le32(alive, 124)];
+        if sku == [0; 3] {
+            return Ok(());
+        }
+        let mut data = Vec::new();
+        let files = ids::pnvm_files(prefix);
+        match aster_firmware::load_first(files.iter().map(String::as_str)) {
+            Some((file_name, file)) => {
+                match fw::pnvm_data(&file, sku, ids::mac_type(self.trans.hw_rev), ids::rf_type(self.trans.hw_rf_id)) {
+                    Some(found) => {
+                        ostd::info!("{}: platform NVM data from {} ({} bytes)", self.name, file_name, found.len());
+                        data = found;
+                    }
+                    None => ostd::info!("{}: {} has nothing for this card", self.name, file_name),
+                }
+            }
+            None => ostd::info!("{}: no {} in /lib/firmware", self.name, files[0]),
+        }
+        self.trans.load_pnvm(&data).map_err(|error| format!("platform NVM data: {error:?}"))?;
+        if let Err(error) = self.notification(REGULATORY, PNVM_INIT_COMPLETE_NTFY, COMMAND_TIMEOUT_MS) {
+            ostd::info!("{}: platform NVM data: {}", self.name, error);
+        }
+        Ok(())
+    }
+
+    /// What this card is for the Wi-Fi component.
+    pub(crate) fn info(&self) -> Info {
+        let rx_streams = self.rx_ant.count_ones().clamp(1, 2) as usize;
+        let tx_streams = self.tx_ant.count_ones().clamp(1, 2) as usize;
+        // The AX2xx cards run 40 MHz and wider channels, VHT and HE; the
+        // first generation (7000 to 9000) HT at 40 MHz and VHT to 80 MHz,
+        // without LDPC (`iwl_init_ht_hw_capab`, `iwl_init_vht_hw_capab`).
+        let wide = !self.gen1;
+        let ht = self.ht.then(|| {
+            let mut mcs = [0u8; 16];
+            for stream in 0..rx_streams {
+                mcs[stream] = 0xff;
+            }
+            // The transmit MCS set is the receive one.
+            mcs[12] = 0x01;
+            // Static SM power save off, short GI at 20 MHz, one receive
+            // STBC stream; wide: LDPC, 40 MHz with its short GI, transmit
+            // STBC with two antennas.
+            let mut info = 0x000c | chan::HT_CAP_SGI_20 | 0x0100 | chan::HT_CAP_SUP_WIDTH_20_40 | chan::HT_CAP_SGI_40;
+            if wide {
+                info |= chan::HT_CAP_LDPC;
+            }
+            if tx_streams >= 2 {
+                info |= 0x0080;
+            }
+            HtCap { info, ampdu_factor: 3, ampdu_density: 5, mcs }
+        });
+        // MCS 0 to 9 on each stream there is, none on the others.
+        let stream_map = |streams: usize, value: u16| -> u16 { (0..8).fold(0u16, |map, stream| map | (if stream < streams { value } else { 3 }) << (stream * 2)) };
+        let vht = self.ht.then(|| {
+            let map = stream_map(rx_streams, 2);
+            let mut info = if wide { chan::VHT_CAP_RXLDPC } else { 0 }
+                | chan::VHT_CAP_SGI_80
+                | 0x0100
+                | chan::VHT_CAP_SU_BEAMFORMEE
+                | (3 << 13)
+                | (7 << chan::VHT_CAP_MAX_AMPDU_SHIFT)
+                | 0x1000_0000
+                | 0x2000_0000;
+            // 160 MHz, with its short GI (the AX2xx cards').
+            if wide {
+                info |= 0x0000_0004 | chan::VHT_CAP_SGI_160;
+            }
+            if tx_streams >= 2 {
+                info |= chan::VHT_CAP_TXSTBC;
+            }
+            let mut mcs = [0u8; 8];
+            mcs[0..2].copy_from_slice(&map.to_le_bytes());
+            mcs[4..6].copy_from_slice(&stream_map(tx_streams, 2).to_le_bytes());
+            VhtCap { info, mcs }
+        });
+        let he = |band: BandId| -> Option<HeCap> {
+            if !wide || !self.ht {
+                return None;
+            }
+            let mut phy = HE_PHY;
+            phy[0] = match band {
+                BandId::Ghz2 => chan::HE_PHY_40_IN_2G,
+                _ => chan::HE_PHY_40_80_IN_5G | chan::HE_PHY_160_IN_5G,
+            };
+            // MCS 0 to 11 on each stream, both ways, at 80 MHz (and 160).
+            let rx = stream_map(rx_streams, 2).to_le_bytes();
+            let tx = stream_map(tx_streams, 2).to_le_bytes();
+            let mut mcs = vec![rx[0], rx[1], tx[0], tx[1]];
+            if band != BandId::Ghz2 {
+                mcs.extend_from_slice(&[rx[0], rx[1], tx[0], tx[1]]);
+            }
+            Some(HeCap { mac: HE_MAC, phy, mcs, ppe: HE_PPE.to_vec() })
+        };
+        // 802.11be: two streams each way where both antennas are, else one;
+        // 320 MHz on 6 GHz where the model has it.
+        let two_by_two = self.tx_ant & self.rx_ant & 3 == 3;
+        let eht = |band: BandId| -> Option<EhtCap> {
+            if !self.eht || !wide || !self.ht {
+                return None;
+            }
+            let mut mac = [EHT_MAC0_OM_CONTROL, 0];
+            if band == BandId::Ghz2 {
+                mac[0] |= EHT_MAC0_MAX_MPDU_11454;
+            }
+            let mut phy = EHT_PHY;
+            let wide_320 = band == BandId::Ghz6 && self.eht_320;
+            if wide_320 {
+                phy[0] |= chan::EHT_PHY0_320_IN_6G;
+                phy[1] |= chan::EHT_PHY1_BEAMFORMEE_SS_320;
+            }
+            if two_by_two {
+                phy[2] |= EHT_PHY2_SOUNDING_2X2;
+                phy[4] |= EHT_PHY4_MAX_NC_1;
+            }
+            if !self.eht_320 {
+                phy[2] &= !chan::EHT_PHY2_SOUNDING_DIM_320;
+            }
+            let set = if two_by_two { 0x22 } else { 0x11 };
+            let sets = match band {
+                BandId::Ghz2 => 3,
+                BandId::Ghz5 => 6,
+                BandId::Ghz6 if wide_320 => 9,
+                BandId::Ghz6 => 6,
+            };
+            Some(EhtCap { mac, phy, mcs: vec![set; sets], ppe: Vec::new() })
+        };
+        let mut bands = Vec::new();
+        let allowed = |band: BandId| -> Vec<Channel> { channels(band).into_iter().filter(|channel| self.channel_allowed(channel.freq)).collect() };
+        if self.band_24 {
+            bands.push(Band { id: BandId::Ghz2, channels: allowed(BandId::Ghz2), ht, vht: None, he: he(BandId::Ghz2), eht: eht(BandId::Ghz2) });
+        }
+        if self.band_52 {
+            bands.push(Band { id: BandId::Ghz5, channels: allowed(BandId::Ghz5), ht, vht, he: he(BandId::Ghz5), eht: eht(BandId::Ghz5) });
+        }
+        // 6 GHz: HE only (`iwl_init_he_6ghz_capa` comes from the 5 GHz
+        // band's HT and VHT).
+        if self.band_6 && he(BandId::Ghz6).is_some() {
+            bands.push(Band { id: BandId::Ghz6, channels: allowed(BandId::Ghz6), ht: None, vht: None, he: he(BandId::Ghz6), eht: eht(BandId::Ghz6) });
+        }
+        // The first generation's firmware takes CCMP-256 as an external
+        // cipher only (Linux does not offer it there).
+        // The 8000 family's older receive path decrypts CCMP only.
+        let ciphers = if self.legacy_rx {
+            vec![radio::CIPHER_CCMP]
+        } else if self.gen1 {
+            vec![radio::CIPHER_CCMP, radio::CIPHER_GCMP, radio::CIPHER_GCMP_256]
+        } else {
+            vec![radio::CIPHER_CCMP, radio::CIPHER_GCMP, radio::CIPHER_GCMP_256, radio::CIPHER_CCMP_256]
+        };
+        Info {
+            driver: String::from("iwlwifi"),
+            address: self.address,
+            bands,
+            ciphers,
+            max_scan_ssids: PROBE_OPTION_MAX as u8,
+            max_scan_ie_len: 300,
+            // An access point ([`ap`]): on the AX2xx firmware's API, the
+            // MLD API, and the first generation's.
+            ap: true,
+            management: radio::ManagementProtection::Unicast,
+        }
+    }
+
+    // ---- Contexts. ----
+
+    /// The MAC context (`struct iwl_mac_ctx_cmd`, 148 bytes): the station,
+    /// its network when there is one, associated or not.
+    fn mac_context(&mut self, action: u32) -> Result<(), String> {
+        if self.mld {
+            return self.mld_mac_config(action);
+        }
+        let network = self.network.clone();
+        let bssid = network.as_ref().map_or(wifi::BROADCAST, |network| network.bssid);
+        let ghz2 = network.as_ref().is_none_or(|network| BandId::of(network.freq) == BandId::Ghz2);
+        let mut out = Out::default();
+        out.u32(0).u32(action).u32(FW_MAC_TYPE_BSS_STA).u32(0);
+        out.bytes(&self.address).u16(0).bytes(&bssid).u16(0);
+        // Basic rates: CCK 1, 2, 5.5 and 11 Mbit/s on 2.4 GHz; OFDM 6, 12
+        // and 24.
+        out.u32(if ghz2 { 0x0f } else { 0 }).u32(0x15);
+        // HT protection as the network asks (`iwl_mvm_mac_ctxt_set_ht_flags`):
+        // non-member and mixed always, 20 MHz stations' when wider.
+        let wider = network.as_ref().and_then(|network| network.chandef).is_some_and(|chandef| chandef.width >= Width::W40);
+        let protection = match network.as_ref().map_or(0, |network| network.ht_protection) {
+            1 | 3 => MAC_PROT_FLG_HT_PROT | MAC_PROT_FLG_FAT_PROT,
+            2 if wider => MAC_PROT_FLG_HT_PROT | MAC_PROT_FLG_FAT_PROT,
+            _ => 0,
+        };
+        out.u32(if self.associated { protection } else { 0 });
+        let capability = network.as_ref().map_or(0, |network| network.capability);
+        out.u32(if capability & wifi::CAP_SHORT_PREAMBLE != 0 { MAC_FLG_SHORT_PREAMBLE } else { 0 });
+        out.u32(if capability & wifi::CAP_SHORT_SLOT != 0 || !ghz2 { MAC_FLG_SHORT_SLOT } else { 0 });
+        let mut filter = MAC_FILTER_ACCEPT_GRP;
+        if !self.associated {
+            filter |= MAC_FILTER_IN_BEACON;
+        }
+        if network.as_ref().is_some_and(|network| network.peer.he.is_some()) {
+            filter |= MAC_FILTER_IN_11AX;
+        }
+        out.u32(filter);
+        let ht = network.as_ref().is_some_and(|network| network.ht_mcs.is_some());
+        out.u32(MAC_QOS_FLG_UPDATE_EDCA | if ht && self.associated { MAC_QOS_FLG_TGN } else { 0 });
+        // EDCA by the firmware's AC order (BK, BE, VI, VO): the defaults,
+        // each on its FIFO (gen2: BK 1, BE 2, VI 3, VO 4; the first
+        // generation's one lower).
+        let first_fifo = if self.gen1 { 0 } else { 1 };
+        for (index, (cw_min, cw_max, aifsn, txop)) in [(15u16, 1023u16, 7u8, 0u16), (15, 1023, 3, 0), (7, 15, 2, 3008), (3, 7, 2, 1504)].into_iter().enumerate() {
+            out.u16(cw_min).u16(cw_max).u8(aifsn).u8(1 << (first_fifo + index)).u16(txop);
+        }
+        out.zeros(8);
+        // The station's part of the union (48 bytes).
+        let (interval, dtim) = network.as_ref().map_or((0, 1), |network| (network.beacon_interval as u32, network.dtim_period.max(1) as u32));
+        out.u32(self.associated as u32).u32(0).u64(0).u32(interval).u32(0).u32(interval * dtim).u32(0).u32(1);
+        out.u32(if self.associated { self.aid as u32 } else { 0 }).u32(0);
+        out.zeros(4);
+        debug_assert_eq!(out.0.len(), 148);
+        self.command(0, MAC_CONTEXT_CMD, &out.0).map(|_| ())
+    }
+
+    fn lmac_id(&self, freq: u16) -> u32 {
+        if self.cdb && BandId::of(freq) != BandId::Ghz2 { 1 } else { 0 }
+    }
+
+    /// The PHY context on the network's channel, 20 MHz.
+    fn phy_context(&mut self, action: u32, freq: u16) -> Result<(), String> {
+        if self.gen1 {
+            let (width, position) = self.link_width(freq);
+            return self.phy_context_v1(action, freq, width, position);
+        }
+        if self.mld {
+            return self.mld_phy_context(action, freq);
+        }
+        let band = phy_band(freq);
+        let channel = channel_number(freq);
+        let (width, position) = self.link_width(freq);
+        let mut out = Out::default();
+        out.u32(0).u32(action);
+        if self.uhb {
+            out.u32(channel as u32).u8(band).u8(width).u8(position).u8(0);
+        } else {
+            out.u8(band).u8(channel).u8(width).u8(position).zeros(4);
+        }
+        out.u32(self.lmac_id(freq));
+        let chains = self.rx_ant.count_ones().clamp(1, 2);
+        out.u32(((self.rx_ant as u32) << PHY_RX_CHAIN_VALID_POS) | (chains << PHY_RX_CHAIN_CNT_POS) | (chains << PHY_RX_CHAIN_MIMO_CNT_POS));
+        out.u32(0).u8(0).zeros(3);
+        self.command(0, PHY_CONTEXT_CMD, &out.0).map(|_| ())
+    }
+
+    /// The PHY context's width and position for the link (or network) on
+    /// `freq`: 20 MHz without one. The first generation goes to 80 MHz.
+    fn link_width(&self, freq: u16) -> (u8, u8) {
+        let chandef = match &self.ap {
+            Some(ap) => Some(ap.config.chandef),
+            None => self.network.as_ref().and_then(|network| network.chandef),
+        }
+        .filter(|chandef| chandef.control == freq);
+        let (width, position) = chandef.map_or((PHY_CHANNEL_MODE20, 0), |chandef| Self::phy_width(&chandef));
+        if self.gen1 && width > PHY_CHANNEL_MODE80 {
+            return (PHY_CHANNEL_MODE20, 0);
+        }
+        (width, position)
+    }
+
+    /// The PHY context's width code and the primary channel's position: on
+    /// which side of the span's center, and how many 20 MHz channels away.
+    fn phy_width(chandef: &Chandef) -> (u8, u8) {
+        let width = match chandef.width {
+            Width::NoHt20 | Width::W20 => return (PHY_CHANNEL_MODE20, 0),
+            Width::W40 => PHY_CHANNEL_MODE40,
+            Width::W80 => PHY_CHANNEL_MODE80,
+            Width::W160 => PHY_CHANNEL_MODE160,
+            Width::W320 => PHY_CHANNEL_MODE320,
+        };
+        // `iwl_mvm_get_ctrl_pos`: 0 to 7 channels away, the third bit
+        // moved past the "above" one.
+        let offset = chandef.control as i32 - chandef.center as i32;
+        let distance = ((offset.abs() - 10) / 20) as u8 & 7;
+        let position = (distance & 3) | if distance & 4 != 0 { PHY_CTRL_POS_OFFS_EXT } else { 0 };
+        (width, if offset > 0 { PHY_CTRL_POS_ABOVE | position } else { position })
+    }
+
+    fn binding(&mut self, action: u32, freq: u16) -> Result<(), String> {
+        if self.gen1 {
+            return self.binding_v1(action);
+        }
+        if self.mld {
+            return self.mld_bind(action == FW_CTXT_ACTION_ADD);
+        }
+        let mut out = Out::default();
+        out.u32(0).u32(action).u32(0).u32(FW_CTXT_INVALID).u32(FW_CTXT_INVALID).u32(0).u32(self.lmac_id(freq));
+        self.command_status(0, BINDING_CONTEXT_CMD, &out.0, 0)
+    }
+
+    /// The access point's station (`struct iwl_mvm_add_sta_cmd`, 48
+    /// bytes): added, or changed once associated.
+    fn station(&mut self, modify: bool) -> Result<(), String> {
+        if self.mld {
+            return self.mld_station();
+        }
+        let network = self.network.clone().unwrap_or_default();
+        let mut flags = 0;
+        if self.associated && let Some(mcs) = network.ht_mcs {
+            // The largest aggregate: HT's 64 KiB, or what VHT and HE say.
+            let exponent = network.peer.vht.map_or(3, |vht| (vht.info >> chan::VHT_CAP_MAX_AMPDU_SHIFT) & 7).max(3);
+            flags |= if self.gen1 { STA_FLG_MAX_AGG_SIZE_64K } else { exponent << STA_FLG_MAX_AGG_SIZE_SHIFT };
+            flags |= (network.ampdu_density as u32 & 7) << STA_FLG_AGG_MPDU_DENS_SHIFT;
+            let streams = if self.gen1 { if mcs[1] != 0 { 2 } else { 1 } } else { network.peer.nss };
+            if streams >= 2 && self.rx_ant.count_ones() >= 2 && self.tx_ant.count_ones() >= 2 {
+                flags |= STA_FLG_MIMO_EN_MIMO2;
+            }
+            flags |= match network.peer.width {
+                Width::W160 | Width::W320 if !self.gen1 => STA_FLG_FAT_EN_160MHZ,
+                Width::W80 | Width::W160 | Width::W320 => STA_FLG_FAT_EN_80MHZ,
+                Width::W40 => STA_FLG_FAT_EN_40MHZ,
+                _ => 0,
+            };
+        }
+        let mut out = Out::default();
+        out.u8(modify as u8).u8(0).u16(0xffff).u32(0).bytes(&network.bssid).u16(0);
+        out.u8(0).u8(0).u16(0).u32(flags).u32(STA_FLG_FAT_EN_MSK | STA_FLG_MIMO_EN_MSK | STA_FLG_RTS_MIMO_PROT);
+        out.u8(0).u8(0).u16(0).u16(0).u8(0);
+        // A link station, with its queues when the host owns them.
+        out.u8(0).u16(if self.associated { self.aid } else { 0 }).u16(0).u32(self.station_queues).u16(0).u8(0).u8(0);
+        let command = self.station_command(out.0);
+        self.command_status(0, ADD_STA, &command, ADD_STA_SUCCESS)
+    }
+
+    /// `struct iwl_mvm_add_sta_cmd` as the firmware takes it: whole, or
+    /// version 7 (the 7000 family's firmware without station types): no
+    /// type (the second byte of a 16-bit sleep state) and nothing after
+    /// the queues.
+    fn station_command(&self, mut command: Vec<u8>) -> Vec<u8> {
+        const V7_LEN: usize = 44;
+        const STATION_TYPE: usize = 35;
+        if self.station_v7 {
+            command[STATION_TYPE] = 0;
+            command.truncate(V7_LEN);
+        }
+        command
+    }
+
+    /// A queue of the access point's station for `tid`: its memory, then
+    /// the firmware's number for it.
+    fn add_queue(&mut self, tid: u8) -> Result<TxQueue, String> {
+        let mut queue = self.trans.new_tx_queue().map_err(|error| format!("queue memory: {error:?}"))?;
+        let mut out = Out::default();
+        out.u32(0).u32(1).u8(tid).zeros(3).u32(0).u32(TX_QUEUE_SIZE.ilog2() - 3).u64(queue.counts_address()).u64(queue.tfds_address());
+        let answer = self.command(DATA_PATH, SCD_QUEUE_CONFIG_CMD, &out.0)?;
+        if answer.len() < 6 {
+            return Err(String::from("the firmware gave no queue"));
+        }
+        self.trans.tx_queue_started(&mut queue, le16(&answer, 0), le16(&answer, 4));
+        Ok(queue)
+    }
+
+    fn remove_queue(&mut self, tid: u8) {
+        let mut out = Out::default();
+        out.u32(1).u32(1).u32(tid as u32).zeros(24);
+        let _ = self.command(DATA_PATH, SCD_QUEUE_CONFIG_CMD, &out.0);
+    }
+
+    fn session_protection(&mut self, action: u32) -> Result<(), String> {
+        let mut out = Out::default();
+        out.u32(0).u32(action).u32(SESSION_PROTECT_CONF_ASSOC).u32(SESSION_PROTECTION_TU).u32(1).u32(0);
+        self.command(MAC_CONF, SESSION_PROTECTION_CMD, &out.0).map(|_| ())
+    }
+
+    /// The firmware's rate control for the access point (`struct
+    /// iwl_tlc_config_cmd_v4`): the legacy rates of the band, and MCS 0 to 7
+    /// on each stream both sides have, at 20 MHz.
+    fn rate_control(&mut self) -> Result<(), String> {
+        let network = self.network.clone().unwrap_or_default();
+        self.rate_control_for(0, &network.peer, network.freq, network.ht_mcs, network.ht_short_gi)
+    }
+
+    /// The rate control of a station (`sta_id`) by what it runs, on a
+    /// channel of `freq`.
+    fn rate_control_for(&mut self, sta_id: u8, peer: &Peer, freq: u16, ht_mcs: Option<[u8; 16]>, ht_short_gi: bool) -> Result<(), String> {
+        let ghz2 = BandId::of(freq) == BandId::Ghz2;
+        let legacy: u16 = if ghz2 { 0x0fff } else { 0x0ff0 };
+        let streams = (self.tx_ant.count_ones() as usize).clamp(1, 2).min(peer.nss.max(1) as usize);
+        // Per stream, the MCS up to 80 MHz and at 160 MHz.
+        let mut rates = [[0u16; 3]; 2];
+        let width = match peer.width {
+            Width::W320 => 4u8,
+            Width::W160 => 3,
+            Width::W80 => 2,
+            Width::W40 => 1,
+            _ => 0,
+        };
+        let mut sgi = 0u8;
+        let mut flags = 0u16;
+        let mode = if let (Some(eht), Some(he), true) = (&peer.eht, &peer.he, self.eht) {
+            // `iwl_mld_fill_eht_rates`: per width, the MCS groups (0-7 and
+            // 8-9 from the 0-9 set at 80 MHz and below; 0-9 at 160 and 320
+            // MHz; 10-11, 12-13) on as many streams as the access point
+            // takes and these cards send.
+            let own = if self.tx_ant & self.rx_ant & 3 == 3 { 2u8 } else { 1 };
+            for (slot, groups) in [(0usize, &[(0usize, 0x00ffu16), (0, 0x0300), (1, 0x0c00), (2, 0x3000)][..]), (1, &[(0, 0x03ff), (1, 0x0c00), (2, 0x3000)][..]), (2, &[(0, 0x03ff), (1, 0x0c00), (2, 0x3000)][..])] {
+                // Only as wide as the link goes.
+                if width < 2 + slot as u8 && slot > 0 {
+                    break;
+                }
+                let Some(set) = eht.mcs_set(he, true, slot) else { continue };
+                for &(index, mask) in groups {
+                    let nss = (set[index] & chan::EHT_MCS_NSS_RX).min(own) as usize;
+                    for stream in rates.iter_mut().take(nss) {
+                        stream[slot] |= mask;
+                    }
+                }
+            }
+            if peer.nss < 2 {
+                rates[1] = [0; 3];
+            }
+            if he.phy[1] & 0x20 != 0 {
+                flags |= TLC_FLAGS_LDPC;
+            }
+            if he.phy[2] & 0x08 != 0 && self.tx_ant.count_ones() >= 2 {
+                flags |= TLC_FLAGS_STBC;
+            }
+            if eht.phy[5] & EHT_PHY5_SUPP_EXTRA_LTF != 0 && EHT_PHY[5] & EHT_PHY5_SUPP_EXTRA_LTF != 0 {
+                flags |= TLC_FLAGS_EHT_EXTRA_LTF;
+            }
+            TLC_MODE_EHT
+        } else if let (Some(he), false) = (&peer.he, self.gen1) {
+            let theirs = [he.rx_map(), u16::from_le_bytes([*he.mcs.get(4).unwrap_or(&0xff), *he.mcs.get(5).unwrap_or(&0xff)])];
+            for stream in 0..streams {
+                for (slot, map) in theirs.iter().enumerate() {
+                    rates[stream][slot] = match (map >> (stream * 2)) & 3 {
+                        0 => 0x00ff,
+                        1 => 0x03ff,
+                        2 => 0x0fff,
+                        _ => 0,
+                    };
+                }
+            }
+            if he.phy[1] & 0x20 != 0 {
+                flags |= TLC_FLAGS_LDPC;
+            }
+            if he.phy[2] & 0x08 != 0 && self.tx_ant.count_ones() >= 2 {
+                flags |= TLC_FLAGS_STBC;
+            }
+            TLC_MODE_HE
+        } else if let (Some(vht), false) = (&peer.vht, self.gen1) {
+            for stream in 0..streams {
+                let highest = match (vht.rx_map() >> (stream * 2)) & 3 {
+                    0 => 7,
+                    1 => 8,
+                    2 => 9,
+                    _ => continue,
+                };
+                let mut supported = (1u16 << (highest + 1)) - 1;
+                if peer.width < Width::W40 {
+                    // MCS 9 has no 20 MHz rate with one stream's coding.
+                    supported &= !(1 << 9);
+                }
+                rates[stream][0] = supported;
+                if peer.width == Width::W160 {
+                    rates[stream][1] = supported;
+                }
+            }
+            if vht.info & chan::VHT_CAP_SGI_80 != 0 {
+                sgi |= 1 << 2;
+            }
+            if vht.info & chan::VHT_CAP_SGI_160 != 0 {
+                sgi |= 1 << 3;
+            }
+            if vht.info & chan::VHT_CAP_RXLDPC != 0 {
+                flags |= TLC_FLAGS_LDPC;
+            }
+            if vht.info & 0x0700 != 0 && self.tx_ant.count_ones() >= 2 {
+                flags |= TLC_FLAGS_STBC;
+            }
+            TLC_MODE_VHT
+        } else if let (Some(mcs), true) = (ht_mcs, self.ht) {
+            for stream in 0..streams {
+                if mcs[stream] != 0 {
+                    rates[stream][0] = mcs[stream] as u16;
+                }
+            }
+            TLC_MODE_HT
+        } else {
+            TLC_MODE_NON_HT
+        };
+        if mode == TLC_MODE_HT || mode == TLC_MODE_VHT {
+            if let Some(ht) = &peer.ht {
+                if ht.info & chan::HT_CAP_SGI_20 != 0 {
+                    sgi |= 1 << 0;
+                }
+                if ht.info & chan::HT_CAP_SGI_40 != 0 {
+                    sgi |= 1 << 1;
+                }
+                if ht.info & chan::HT_CAP_LDPC != 0 && !self.gen1 {
+                    flags |= TLC_FLAGS_LDPC;
+                }
+            } else if ht_short_gi {
+                sgi |= 1 << 0;
+            }
+        }
+        let max_mpdu = if mode >= TLC_MODE_VHT { VHT_MAX_MPDU_3895 } else { HT_MAX_AMSDU_3839 };
+        let mut out = Out::default();
+        out.u8(sta_id).zeros(3).u8(if self.gen1 { 0 } else { width });
+        out.u8(mode).u8(self.tx_ant & 3).u8(sgi).u16(flags).u16(legacy);
+        // Version 5's masks are 32 bits, version 4's (and older) 16.
+        for stream in rates {
+            for width in stream {
+                if self.tlc_v5 {
+                    out.u32(width as u32);
+                } else {
+                    out.u16(width);
+                }
+            }
+        }
+        out.u16(max_mpdu).u16(0);
+        self.command(DATA_PATH, TLC_MNG_CONFIG_CMD, &out.0).map(|_| ())
+    }
+
+    /// The HE access point's station context (`struct
+    /// iwl_he_sta_context_cmd_v2`, 88 bytes): its block-ack bitmap and
+    /// acknowledgment abilities, the network's color and RTS threshold;
+    /// no packet extension of its own (the firmware's defaults).
+    fn he_station_context(&mut self) -> Result<(), String> {
+        let network = self.network.clone().unwrap_or_default();
+        let Some(he) = &network.peer.he else { return Ok(()) };
+        let mut flags = 0;
+        if he.mac[2] & HE_MAC_CAP2_32BIT_BA_BITMAP != 0 {
+            flags |= STA_CTXT_HE_32BIT_BA_BITMAP;
+        }
+        if he.mac[2] & HE_MAC_CAP2_ACK_EN != 0 {
+            flags |= STA_CTXT_HE_ACK_ENABLED;
+        }
+        let mut out = Out::default();
+        // Station 0, every TID.
+        out.u8(0).u8(8).u8(0).u8(0).u32(flags);
+        out.zeros(6).u16(0).u32(0).zeros(4);
+        // Packet extension thresholds: none (7: no extension).
+        out.bytes(&[7u8; 16]);
+        out.u8(network.he_bss_color).u8(0).u16(network.he_rts_threshold);
+        out.u8(0).u8(0).u16(0);
+        out.zeros(32);
+        out.zeros(8);
+        debug_assert_eq!(out.0.len(), 88);
+        self.command(DATA_PATH, STA_HE_CTXT_CMD, &out.0).map(|_| ())
+    }
+
+    /// `iwl_mvm_power_build_cmd` (`struct iwl_mac_power_cmd`, 40 bytes):
+    /// the access point kept alive (every three DTIMs, 25 s at least); as a
+    /// station power saving allowed, and with power save on the firmware's
+    /// power management, dozing after 100 ms of quiet.
+    fn mac_power(&mut self) -> Result<(), String> {
+        let (dtim, interval) = self.network.as_ref().map_or((1, 100), |network| (network.dtim_period.max(1) as u32, network.beacon_interval.max(1) as u32));
+        let keep_alive = (3 * dtim * interval * 1024).div_ceil(1_000_000).max(POWER_KEEP_ALIVE_S);
+        let station = self.ap.is_none();
+        let managed = station && self.power_save && self.associated;
+        let mut flags = if station { POWER_FLAGS_POWER_SAVE_ENA } else { 0 };
+        if managed {
+            flags |= POWER_FLAGS_POWER_MANAGEMENT_ENA | if self.power_cmd_v2 { POWER_FLAGS_ENABLE_SMPS } else { 0 };
+        }
+        let timeout = if managed { PS_DATA_TIMEOUT_US } else { 0 };
+        let mut out = Out::default();
+        out.u32(0).u16(flags).u16(keep_alive as u16).u32(timeout).u32(timeout).zeros(24);
+        self.command(0, MAC_PM_POWER_TABLE, &out.0).map(|_| ())
+    }
+
+    pub(crate) fn set_power_save(&mut self, enabled: bool) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        self.power_save = enabled;
+        if self.associated && self.ap.is_none() {
+            self.mac_power().map_err(|error| {
+                ostd::info!("{}: power save: {}", self.name, error);
+                radio::Error::Failed
+            })?;
+        }
+        Ok(())
+    }
+
+    // ---- The radio's operations. ----
+
+    pub(crate) fn scan(&mut self, request: &ScanRequest) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if self.ap.is_some() {
+            return Err(radio::Error::Busy);
+        }
+        if self.scanning {
+            return Err(radio::Error::Busy);
+        }
+        let freqs: Vec<u16> = request
+            .freqs
+            .iter()
+            .copied()
+            .filter(|&freq| match BandId::of(freq) {
+                BandId::Ghz2 => self.band_24,
+                BandId::Ghz5 => self.band_52,
+                BandId::Ghz6 => self.band_6,
+            })
+            .filter(|&freq| channel_number(freq) != 0 && self.channel_allowed(freq))
+            .take(self.scan_channels)
+            .collect();
+        if freqs.is_empty() {
+            return Err(radio::Error::Invalid);
+        }
+        let (id, command) = if self.lmac_scan {
+            (gen1::SCAN_OFFLOAD_REQUEST_CMD, self.scan_request_lmac(request, &freqs))
+        } else if self.gen1 {
+            (SCAN_REQ_UMAC, self.scan_request_gen1(request, &freqs))
+        } else {
+            (SCAN_REQ_UMAC, self.scan_request(request, &freqs))
+        };
+        if let Err(error) = self.command(LONG, id, &command) {
+            ostd::warn!("{}: scan: {}", self.name, error);
+            return Err(radio::Error::Failed);
+        }
+        self.scanning = true;
+        Ok(())
+    }
+
+    /// `struct iwl_scan_req_umac_v17` as version 15 takes it (1940 bytes).
+    fn scan_request(&self, request: &ScanRequest, freqs: &[u16]) -> Vec<u8> {
+        let ssids: Vec<&Vec<u8>> = request.ssids.iter().take(PROBE_OPTION_MAX).collect();
+        let mut flags = SCAN_GEN_FLAGS_PASS_ALL | SCAN_GEN_FLAGS_ADAPTIVE_DWELL;
+        if ssids.is_empty() {
+            flags |= SCAN_GEN_FLAGS_FORCE_PASSIVE;
+        } else if ssids.len() == 1 && !ssids[0].is_empty() {
+            flags |= SCAN_GEN_FLAGS_USE_ALL_RX_CHAINS;
+        }
+        // Linux's timing for a scan without a link, and the wild one with.
+        let (max_out, suspend) = if self.associated { (120u32, 30u32) } else { (0, 0) };
+        let budget: u16 = if ssids.len() == 1 && !ssids[0].is_empty() { 100 } else { 300 };
+        let mut out = Out::default();
+        // uid, out-of-channel priority.
+        out.u32(0).u32(6);
+        // General parameters (36 bytes).
+        out.u16(flags).u8(0).u8(0).u8(10).u8(10).u8(2).u8(8).u8(10).u8(0).u16(budget);
+        out.u32(max_out).u32(max_out).u32(suspend).u32(suspend).u32(6).u8(110).u8(110).u8(0).u8(0);
+        // Channel parameters (540 bytes): each channel probes for all the
+        // names (bit i: the i-th of `direct_scan`).
+        let bitmap: u32 = if ssids.is_empty() { 0 } else { (1u32 << ssids.len()) - 1 };
+        out.u8(SCAN_CHANNEL_FLAG_ENABLE_CHAN_ORDER).u8(freqs.len() as u8).u8(10).u8(2);
+        for index in 0..SCAN_MAX_CHANNELS {
+            match freqs.get(index) {
+                Some(&freq) => {
+                    // 6 GHz channels only listened to (no probe without a
+                    // network heard).
+                    let probes = if BandId::of(freq) == BandId::Ghz6 { 0 } else { bitmap };
+                    out.u32(probes).u8(channel_number(freq)).u8(phy_band(freq)).u8(1).u8(0);
+                }
+                None => {
+                    out.zeros(8);
+                }
+            }
+        }
+        // Periodic parameters: one iteration, now.
+        out.u16(0).u8(1).u8(0).zeros(4).u16(0).u16(0);
+        // Probe parameters: the template, then the names.
+        let (template, segments) = self.probe_template(&request.elements);
+        for (offset, length) in segments {
+            out.u16(offset).u16(length);
+        }
+        let mut buffer = template;
+        buffer.resize(PROBE_TEMPLATE, 0);
+        out.bytes(&buffer);
+        out.u8(0).u8(0).u16(0);
+        for index in 0..PROBE_OPTION_MAX {
+            match ssids.get(index) {
+                Some(ssid) => {
+                    let mut entry = [0u8; 34];
+                    entry[1] = ssid.len().min(32) as u8;
+                    entry[2..2 + ssid.len().min(32)].copy_from_slice(&ssid[..ssid.len().min(32)]);
+                    out.bytes(&entry);
+                }
+                None => {
+                    out.zeros(34);
+                }
+            }
+        }
+        out.zeros(8 * 4 + 16 * 6);
+        debug_assert_eq!(out.0.len(), 1940);
+        out.0
+    }
+
+    /// The probe request the firmware sends (`struct iwl_scan_probe_req`):
+    /// the header and an empty name (the firmware puts each name in), the
+    /// 2.4 GHz part (rates, DS parameters, HT), the 5 GHz part (rates, HT),
+    /// none for 6 GHz, and the supplicant's elements. Returns the bytes and
+    /// the five segments (header, three bands, common).
+    fn probe_template(&self, common: &[u8]) -> (Vec<u8>, [(u16, u16); 5]) {
+        let mut buf = wifi::probe_request(&self.address, &[], &[], &[]);
+        // Just the header and the empty name element.
+        buf.truncate(wifi::HEADER + 2);
+        let header = (0u16, buf.len() as u16);
+        let ht = self.info().bands.first().and_then(|band| band.ht);
+        let band_part = |buf: &mut Vec<u8>, rates: &[u8], ds: bool| -> (u16, u16) {
+            let start = buf.len();
+            wifi::put_rates(buf, rates);
+            if ds {
+                wifi::put_element(buf, wifi::IE_DS_PARAMS, &[0]);
+            }
+            if let Some(ht) = ht {
+                wifi::put_element(buf, wifi::IE_HT_CAP, &ht.element());
+            }
+            (start as u16, (buf.len() - start) as u16)
+        };
+        let ghz2 = band_part(&mut buf, BandId::Ghz2.rates(), true);
+        let ghz5 = band_part(&mut buf, BandId::Ghz5.rates(), false);
+        let ghz6 = (buf.len() as u16, 0);
+        let room = PROBE_TEMPLATE.saturating_sub(buf.len());
+        let common = &common[..common.len().min(room)];
+        let shared = (buf.len() as u16, common.len() as u16);
+        buf.extend_from_slice(common);
+        (buf, [header, ghz2, ghz5, ghz6, shared])
+    }
+
+    pub(crate) fn abort_scan(&mut self) {
+        if self.scanning {
+            if self.lmac_scan {
+                let _ = self.command(LONG, gen1::SCAN_OFFLOAD_ABORT_CMD, &[]);
+            } else {
+                let _ = self.command(LONG, SCAN_ABORT_UMAC, &Out::default().u32(0).u32(0).0);
+            }
+        }
+    }
+
+    pub(crate) fn join(&mut self, join: &Join) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if self.ap.is_some() {
+            return Err(radio::Error::Busy);
+        }
+        self.leave();
+        let elements = wifi::Elements(&join.elements);
+        let ht_cap = elements.get(wifi::IE_HT_CAP).filter(|value| value.len() >= 26);
+        let network = Network {
+            bssid: join.bssid,
+            freq: join.freq,
+            beacon_interval: join.beacon_interval.max(1),
+            // The TIM element: count, period, ...
+            dtim_period: elements.get(5).and_then(|value| value.get(1).copied()).unwrap_or(1).max(1),
+            capability: join.capability,
+            ht_mcs: ht_cap.map(|value| {
+                let mut mcs = [0u8; 16];
+                mcs.copy_from_slice(&value[3..19]);
+                mcs
+            }),
+            ht_short_gi: ht_cap.is_some_and(|value| u16::from_le_bytes([value[0], value[1]]) & 0x0020 != 0),
+            ampdu_density: ht_cap.map_or(0, |value| (value[2] >> 2) & 7),
+            chandef: (!self.gen1).then_some(join.chandef),
+            peer: Peer::default(),
+            ht_protection: elements.get(wifi::IE_HT_OPERATION).and_then(|value| value.get(2)).map_or(0, |mode| mode & 3),
+            he_bss_color: elements.extension(wifi::EXT_HE_OPERATION).and_then(|value| value.get(3)).map_or(0, |color| color & 0x3f),
+            he_rts_threshold: elements
+                .extension(wifi::EXT_HE_OPERATION)
+                .filter(|value| value.len() >= 3)
+                .map_or(0, |value| (u16::from_le_bytes([value[0], value[1]]) >> 4) & 0x3ff),
+        };
+        self.network = Some(network);
+        let result = self.join_steps(join.freq);
+        if let Err(error) = &result {
+            ostd::warn!("{}: joining {}: {}", self.name, Hex(&join.bssid), error);
+            self.leave();
+            return Err(radio::Error::Failed);
+        }
+        Ok(())
+    }
+
+    fn join_steps(&mut self, freq: u16) -> Result<(), String> {
+        self.phy_context(FW_CTXT_ACTION_ADD, freq)?;
+        self.phy_added = true;
+        self.binding(FW_CTXT_ACTION_ADD, freq)?;
+        self.binding_added = true;
+        self.mac_context(FW_CTXT_ACTION_MODIFY)?;
+        if self.gen1 {
+            // The host's queues first, on their FIFOs, then the station
+            // that has them; the channel held by a time event.
+            self.add_queues_gen1()?;
+            self.station(false)?;
+            self.station_added = true;
+            self.reset_rates();
+            return self.time_event_add();
+        }
+        self.station(false)?;
+        self.station_added = true;
+        let management = self.add_queue(IWL_MGMT_TID)?;
+        self.management_queue = Some(management);
+        let data = self.add_queue(0)?;
+        self.data_queue = Some(data);
+        self.session_protection(FW_CTXT_ACTION_ADD)?;
+        Ok(())
+    }
+
+    pub(crate) fn associated(&mut self, association: &Association) -> radio::Result<()> {
+        if self.network.is_none() {
+            return Err(radio::Error::Invalid);
+        }
+        self.associated = true;
+        self.aid = association.aid & 0x3fff;
+        self.qos = association.qos;
+        if let Some(network) = self.network.as_mut() {
+            network.peer = association.peer.clone();
+            if !self.gen1 {
+                network.chandef = Some(association.chandef);
+            }
+        }
+        // The association response's HT capabilities are the ones that
+        // count.
+        if let Some(value) = wifi::Elements(&association.elements).get(wifi::IE_HT_CAP).filter(|value| value.len() >= 26)
+            && let Some(network) = self.network.as_mut()
+        {
+            let mut mcs = [0u8; 16];
+            mcs.copy_from_slice(&value[3..19]);
+            network.ht_mcs = Some(mcs);
+            network.ht_short_gi = u16::from_le_bytes([value[0], value[1]]) & 0x0020 != 0;
+            network.ampdu_density = (value[2] >> 2) & 7;
+        }
+        let result = (|| {
+            self.mac_context(FW_CTXT_ACTION_MODIFY)?;
+            self.station(true)?;
+            self.mac_power()?;
+            if self.gen1 {
+                // The driver's rates, from the association's capabilities.
+                self.reset_rates();
+                self.send_rates()?;
+                self.time_event_remove();
+                // The wild scan's timing, now that there is a link.
+                if let Err(error) = self.scan_config_gen1() {
+                    ostd::info!("{}: scan configuration: {}", self.name, error);
+                }
+                return Ok(());
+            }
+            if self.mld {
+                // The link's HE and beacon parameters are the MLD API's
+                // place for what the HE station context held.
+                self.mld_link_associated()?;
+            } else if let Err(error) = self.he_station_context() {
+                ostd::info!("{}: HE station context: {}", self.name, error);
+            }
+            self.rate_control()?;
+            let _ = self.session_protection(FW_CTXT_ACTION_REMOVE);
+            Ok::<(), String>(())
+        })();
+        if let Err(error) = result {
+            ostd::warn!("{}: association: {}", self.name, error);
+            self.associated = false;
+            return Err(radio::Error::Failed);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn leave(&mut self) {
+        let Some(network) = self.network.clone() else { return };
+        self.forget_rx_agreements(None);
+        self.power_save = false;
+        let was_associated = self.associated;
+        self.associated = false;
+        self.authorized = false;
+        self.pairwise = None;
+        if !self.dead {
+            if self.gen1 {
+                self.remove_queues_gen1();
+            } else {
+                if self.data_queue.take().is_some() {
+                    self.remove_queue(0);
+                }
+                if self.management_queue.take().is_some() {
+                    self.remove_queue(IWL_MGMT_TID);
+                }
+            }
+            if self.station_added {
+                if self.mld {
+                    self.mld_remove_station();
+                } else {
+                    let _ = self.command(0, REMOVE_STA, &[0, 0, 0, 0]);
+                }
+            }
+            if self.gen1 {
+                self.time_event_remove();
+            } else if was_associated {
+                let _ = self.session_protection(FW_CTXT_ACTION_REMOVE);
+            }
+            self.network = None;
+            let _ = self.mac_context(FW_CTXT_ACTION_MODIFY);
+            if self.binding_added {
+                let _ = self.binding(FW_CTXT_ACTION_REMOVE, network.freq);
+            }
+            if self.phy_added {
+                let _ = self.phy_context(FW_CTXT_ACTION_REMOVE, network.freq);
+            }
+        }
+        self.network = None;
+        self.data_queue = None;
+        self.management_queue = None;
+        self.station_queues = 0;
+        self.time_event = None;
+        self.station_added = false;
+        self.binding_added = false;
+        self.phy_added = false;
+        self.signal = None;
+        if self.gen1 && was_associated && !self.dead {
+            // The scan's timing without a link again.
+            let _ = self.scan_config_gen1();
+        }
+    }
+
+    pub(crate) fn set_key(&mut self, key: &Key) -> radio::Result<()> {
+        if self.ap.is_some() {
+            return self.ap_set_key(key);
+        }
+        if self.mld {
+            self.mld_set_key(key)?;
+            if key.pairwise {
+                self.pairwise = Some(PairwiseKey { index: key.index, pn: 1, cipher: key.cipher, key: key.key.clone(), offset: 0 });
+            }
+            return Ok(());
+        }
+        let flags = match key.cipher {
+            radio::CIPHER_CCMP | radio::CIPHER_CCMP_256 => STA_KEY_FLG_CCM,
+            radio::CIPHER_GCMP | radio::CIPHER_GCMP_256 => STA_KEY_FLG_GCMP,
+            _ => return Err(radio::Error::Unsupported),
+        };
+        if key.key.len() > 32 || key.index > 3 {
+            return Err(radio::Error::Invalid);
+        }
+        if (self.gen1 && key.cipher == radio::CIPHER_CCMP_256) || (self.legacy_rx && key.cipher != radio::CIPHER_CCMP) {
+            return Err(radio::Error::Unsupported);
+        }
+        let mut flags = flags | ((key.index as u16) << STA_KEY_FLG_KEYID_POS);
+        if key.key.len() == 32 {
+            flags |= STA_KEY_FLG_KEY_32BYTES;
+        }
+        if !key.pairwise {
+            flags |= STA_KEY_MULTICAST;
+        }
+        let mut material = [0u8; 32];
+        material[..key.key.len()].copy_from_slice(&key.key);
+        // The pairwise key at offset 0, the group's at their index.
+        let offset = if key.pairwise { 0 } else { key.index.max(1) };
+        let command = if self.gen1 {
+            // Version 1, as Linux sends it to this firmware.
+            Self::key_command_v1(gen1::AP_STA_ID, offset, flags | STA_KEY_FLG_WEP_KEY_MAP, &material)
+        } else {
+            let mut out = Out::default();
+            out.u8(0).u8(offset).u16(flags).bytes(&material).zeros(16).u64(0).u64(0).u64(0);
+            out.0
+        };
+        if let Err(error) = self.command_status(0, ADD_STA_KEY, &command, ADD_STA_SUCCESS) {
+            ostd::warn!("{}: key: {}", self.name, error);
+            return Err(radio::Error::Failed);
+        }
+        if key.pairwise {
+            self.pairwise = Some(PairwiseKey { index: key.index, pn: 1, cipher: key.cipher, key: key.key.clone(), offset });
+        }
+        Ok(())
+    }
+
+    pub(crate) fn remove_key(&mut self, index: u8, pairwise: bool) {
+        if self.ap.is_some() {
+            self.ap_remove_key(index, pairwise);
+            return;
+        }
+        if self.mld {
+            self.mld_remove_key(index, pairwise);
+            if pairwise {
+                self.pairwise = None;
+            }
+            return;
+        }
+        let offset = if pairwise { 0 } else { index.max(1) };
+        let mut flags = STA_KEY_NOT_VALID | ((index as u16) << STA_KEY_FLG_KEYID_POS);
+        if !pairwise {
+            flags |= STA_KEY_MULTICAST;
+        }
+        let command = if self.gen1 {
+            Self::key_command_v1(gen1::AP_STA_ID, offset, flags | STA_KEY_FLG_WEP_KEY_MAP, &[0; 32])
+        } else {
+            let mut out = Out::default();
+            out.u8(0).u8(offset).u16(flags).zeros(32 + 16 + 24);
+            out.0
+        };
+        let _ = self.command(0, ADD_STA_KEY, &command);
+        if pairwise {
+            self.pairwise = None;
+        }
+    }
+
+    // ---- Frames. ----
+
+    /// Puts the cipher's header (CCMP and GCMP share it) after the 802.11
+    /// header, with the pairwise key's next packet number.
+    fn insert_cipher_header(&mut self, frame: &mut Vec<u8>) -> bool {
+        let Some(key) = self.pairwise.as_mut() else { return false };
+        let pn = key.pn;
+        key.pn += 1;
+        let at = header_len(frame);
+        let header = [pn as u8, (pn >> 8) as u8, 0, 0x20 | (key.index << 6), (pn >> 16) as u8, (pn >> 24) as u8, (pn >> 32) as u8, (pn >> 40) as u8];
+        drop(frame.splice(at..at, header));
+        true
+    }
+
+    fn next_sequence(&mut self, frame: &mut [u8]) {
+        let qos = wifi::is_data(frame) && frame[0] & 0x80 != 0;
+        let slot = if qos { (frame.get(header_len(frame).saturating_sub(2)).copied().unwrap_or(0) & 0x0f) as usize } else { 16 };
+        let sequence = self.sequence[slot];
+        self.sequence[slot] = (sequence + 1) & 0x0fff;
+        if frame.len() >= 24 {
+            frame[22..24].copy_from_slice(&(sequence << 4).to_le_bytes());
+        }
+    }
+
+    /// Sends an 802.11 frame on a queue of the access point's station.
+    fn transmit(&mut self, mut frame: Vec<u8>, data: bool, encrypt: bool) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        let protected = frame.get(1).is_some_and(|flags| flags & wifi::PROTECTED != 0);
+        let encrypted = protected && encrypt && self.insert_cipher_header(&mut frame);
+        if protected && !encrypted {
+            // The Protected bit without a key: sent plain.
+            frame[1] &= !wifi::PROTECTED;
+        }
+        self.next_sequence(&mut frame);
+        if self.gen1 {
+            let queue = if data { self.data_queue.as_ref() } else { self.management_queue.as_ref() };
+            let Some(queue) = queue else { return Err(radio::Error::Down) };
+            let index = self.trans.tx_next_index(queue);
+            let (bytes, body_at) = self.tx_command_gen1(&frame, data, encrypted, queue.id, index);
+            let queue = if data { self.data_queue.as_mut() } else { self.management_queue.as_mut() };
+            let Some(queue) = queue else { return Err(radio::Error::Down) };
+            return self.trans.send_frame(queue, &bytes, body_at, frame.len()).map_err(|()| radio::Error::Busy);
+        }
+        let queue = if data { self.data_queue.as_ref() } else { self.management_queue.as_ref() };
+        let Some(queue) = queue else { return Err(radio::Error::Down) };
+        let index = self.trans.tx_next_index(queue);
+        let (bytes, body_at) = self.tx_command_gen2(&frame, data, encrypted, queue.id, index);
+        let queue = if data { self.data_queue.as_mut() } else { self.management_queue.as_mut() };
+        let Some(queue) = queue else { return Err(radio::Error::Down) };
+        self.trans.send_frame(queue, &bytes, body_at, frame.len()).map_err(|()| radio::Error::Busy)
+    }
+
+    /// The TX command of the AX2xx firmware (`struct iwl_tx_cmd_gen2`, or
+    /// `_gen3` on the AX210's): the frame's length, the encryption off for
+    /// plain frames, management at high priority, the header's length and
+    /// padding, then the header and the body four-aligned; where the body
+    /// starts.
+    fn tx_command_gen2(&self, frame: &[u8], data: bool, encrypted: bool, queue_id: u16, index: usize) -> (Vec<u8>, usize) {
+        let hdr = header_len(frame);
+        let mut flags = if encrypted { 0 } else { IWL_TX_FLAGS_ENCRYPT_DIS };
+        if !data {
+            flags |= IWL_TX_FLAGS_HIGH_PRI;
+        }
+        let offload = ((hdr as u32 / 2) << TX_CMD_OFFLD_MH_SIZE) | if hdr % 4 != 0 { 1 << TX_CMD_OFFLD_PAD } else { 0 };
+        let mut bytes = Out::default();
+        bytes.u8(TX_CMD).u8(0).u16((((queue_id & 0x1f) as u16) << 8) | (index as u16 & 0xff));
+        if self.tx_cmd_v10 {
+            bytes.u16(frame.len() as u16).u16(flags as u16).u32(offload).zeros(8).u32(0).zeros(8);
+        } else {
+            bytes.u16(frame.len() as u16).u16(offload as u16).u32(flags).zeros(8).u32(0);
+        }
+        bytes.bytes(&frame[..hdr]);
+        let body_at = bytes.0.len().next_multiple_of(4);
+        bytes.0.resize(body_at, 0);
+        bytes.bytes(&frame[hdr..]);
+        (bytes.0, body_at)
+    }
+
+    pub(crate) fn send_management(&mut self, frame: &[u8]) -> radio::Result<()> {
+        if frame.len() < wifi::HEADER {
+            return Err(radio::Error::Invalid);
+        }
+        if self.ap.is_some() {
+            return self.ap_send_management(frame);
+        }
+        self.transmit(frame.to_vec(), false, true)
+    }
+
+    pub(crate) fn send(&mut self, ethernet: &[u8], plain: bool) -> radio::Result<()> {
+        if self.ap.is_some() {
+            return self.ap_send(ethernet, plain);
+        }
+        let Some(network) = self.network.as_ref() else { return Err(radio::Error::Down) };
+        // The first generation's one data queue is BE's: every frame on it.
+        let tid = self.qos.then(|| if self.gen1 { self.data_tid_gen1() } else { wifi::tid_of(ethernet) });
+        let protected = !plain && self.pairwise.is_some();
+        let frame = wifi::data_from_ethernet(ethernet, &network.bssid, tid, protected).ok_or(radio::Error::Invalid)?;
+        self.transmit(frame, true, protected)
+    }
+
+    fn tx_response(&mut self, data: &[u8]) {
+        let frames = data.first().copied().unwrap_or(0) as usize;
+        let queue_id = le16(data, 36);
+        let status = le16(data, 40) & 0xff;
+        let ssn = le32(data, 40 + 4 * frames.max(1)) as u16;
+        if status != TX_STATUS_SUCCESS && status != TX_STATUS_DIRECT_DONE {
+            ostd::debug!("{}: frame on queue {} not sent (status {:#x})", self.name, queue_id, status);
+        }
+        let mut freed = [self.management_queue.as_mut(), self.data_queue.as_mut()].into_iter().flatten().find(|queue| queue.id == queue_id).map(|queue| {
+            self.trans.reclaim(queue, ssn);
+        });
+        if freed.is_none() {
+            freed = self.ap_reclaim(queue_id, ssn).then_some(());
+        }
+        if freed.is_some()
+            && let Some(device) = &self.device
+        {
+            device.ready_to_send();
+        }
+    }
+
+    fn rx_mpdu(&mut self, data: &[u8]) {
+        let desc = self.rx_desc_len;
+        if data.len() < desc {
+            return;
+        }
+        let length = le16(data, 0) as usize;
+        let flags2 = data[3];
+        let status = le32(data, 12);
+        if status & (RX_STATUS_CRC_OK | RX_STATUS_OVERRUN_OK) != (RX_STATUS_CRC_OK | RX_STATUS_OVERRUN_OK) {
+            return;
+        }
+        let (energy_a, energy_b, channel) = if self.ax210 { (data[40], data[41], data[42]) } else { (data[32], data[33], data[34]) };
+        // The band: the descriptor's (AX210 family on), else the channel's.
+        let band = if self.ax210 {
+            match data[7] >> RX_MAC_PHY_BAND_SHIFT {
+                PHY_BAND_24 => BandId::Ghz2,
+                PHY_BAND_6 => BandId::Ghz6,
+                _ => BandId::Ghz5,
+            }
+        } else if channel <= 14 {
+            BandId::Ghz2
+        } else {
+            BandId::Ghz5
+        };
+        let Some(body) = data.get(desc..(desc + length).min(data.len())) else { return };
+        if body.len() < wifi::HEADER {
+            return;
+        }
+        let mut frame: Vec<u8> = if flags2 & RX_MFLG2_PAD != 0 {
+            let hdr = header_len(body);
+            let mut frame = body[..hdr].to_vec();
+            frame.extend_from_slice(body.get(hdr + 2..).unwrap_or(&[]));
+            frame
+        } else {
+            body.to_vec()
+        };
+        // The hardware takes A-MSDUs apart: each subframe comes as a frame
+        // of its own with the MPDU's header, A-MSDU bit and all (the 9000
+        // family's third address reversed), as `iwl_mvm_rx_mpdu_mq` puts
+        // it right.
+        let mut amsdu_more = false;
+        if flags2 & RX_MFLG2_AMSDU != 0 && wifi::qos_control(&frame).is_some() {
+            let qos = if frame[1] & (wifi::TO_DS | wifi::FROM_DS) == wifi::TO_DS | wifi::FROM_DS { wifi::HEADER + 6 } else { wifi::HEADER };
+            frame[qos] &= !(wifi::QOS_AMSDU as u8);
+            if self.gen1 {
+                frame[16..22].reverse();
+            }
+            amsdu_more = data[4] & RX_AMSDU_LAST_SUBFRAME == 0;
+        }
+        let protected = frame[1] & wifi::PROTECTED != 0;
+        let security = (status >> 8) & 7;
+        let decrypted = protected && matches!(security, RX_STATUS_SEC_CCM | RX_STATUS_SEC_GCM) && status & RX_STATUS_MIC_OK != 0;
+        let energy = [energy_a, energy_b].into_iter().filter(|&energy| energy != 0).min().unwrap_or(127);
+        let signal = -(energy.min(127) as i16) as i8;
+        let freq = chan::freq_of(band, channel);
+        if let Some(network) = &self.network
+            && wifi::addresses(&frame).is_some_and(|(_, transmitter, _)| transmitter == network.bssid)
+        {
+            self.signal = Some(signal);
+        }
+        if let Some(device) = &self.device {
+            device.received(&frame, RxInfo { freq, signal, decrypted, security_header: if decrypted { 8 } else { 0 }, amsdu_more });
+        }
+    }
+
+    pub(crate) fn link_stats(&self) -> LinkStats {
+        LinkStats { signal: self.signal, tx_rate: None }
+    }
+}
+
+/// An address for the log.
+struct Hex<'a>(&'a Address);
+
+impl core::fmt::Display for Hex<'_> {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        let a = self.0;
+        write!(f, "{:02x}:{:02x}:{:02x}:{:02x}:{:02x}:{:02x}", a[0], a[1], a[2], a[3], a[4], a[5])
+    }
+}
