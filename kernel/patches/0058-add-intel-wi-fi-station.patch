+    let mut message = event(device, NL80211_CMD_DISCONNECT);
+    message.u16(NL80211_ATTR_REASON_CODE, reason);
+    if by_ap {
+        message.flag(NL80211_ATTR_DISCONNECTED_BY_AP);
+    }
+    genl::multicast(GROUP_MLME, message.finish());
+}
