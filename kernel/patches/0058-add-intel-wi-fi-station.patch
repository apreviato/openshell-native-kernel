+        assert_eq!(data, hex("588c979a61c663d2f066d0c2c0f989806d5f6b61dac384"));
+        assert_eq!(tag, hex("17e8d12cfdf926e0"));
+        assert!(ccm_decrypt(&cipher, &nonce, &aad, &mut data, &tag));
+        assert_eq!(data, hex("08090a0b0c0d0e0f101112131415161718191a1b1c1d1e"));
+    }
+
+    #[ktest]
+    fn management_round_trip() {
+        let frame = {
+            let mut frame = hex("d0400000 020304050607 0a0b0c0d0e0f 0a0b0c0d0e0f 1000");
+            frame.extend_from_slice(&[8, 4, 0x2a, 0x2b]);
