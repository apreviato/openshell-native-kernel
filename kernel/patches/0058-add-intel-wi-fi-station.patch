diff --git a/kernel/comps/wlan/src/ap.rs b/kernel/comps/wlan/src/ap.rs
new file mode 100644
index 0000000..80e50a1
--- /dev/null
+++ b/kernel/comps/wlan/src/ap.rs
@@ -0,0 +1,714 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! A Wi-Fi interface as an access point, for a hotspot. The daemon
+//! (hostapd) runs the network as it does over Linux's mac80211: it answers
+//! probe requests and the authentication and association frames itself
+//! (they reach it as nl80211 frame events), adds each station it accepts,
+//! runs WPA's handshake over the control port and installs the keys. This
+//! component keeps the stations, passes their data to the network stack
+//! and between them, and starts and stops the radio's beacons.
+
+use alloc::vec::Vec;
+use core::sync::atomic::Ordering;
+
+use crate::{
+    cfg,
+    device::{Device, EINVAL, ENETDOWN, ENOENT, EOPNOTSUPP, State},
+    ieee80211::{self as wifi, Address},
+    netdev,
+    radio::{self, ApConfig, BeaconTemplate, Chandef, Key, RxInfo, StationEntry},
+};
+
+pub(crate) const MODE_STATION: u8 = 0;
+pub(crate) const MODE_AP: u8 = 1;
+
+/// Station flags (the bits of nl80211's station flags).
+pub(crate) const STA_AUTHORIZED: u32 = 1 << 1;
+pub(crate) const STA_SHORT_PREAMBLE: u32 = 1 << 2;
+pub(crate) const STA_WME: u32 = 1 << 3;
+pub(crate) const STA_MFP: u32 = 1 << 4;
+pub(crate) const STA_AUTHENTICATED: u32 = 1 << 5;
+pub(crate) const STA_ASSOCIATED: u32 = 1 << 7;
+
+const EALREADY: i32 = 114;
+/// The most stations one network takes.
+const MAX_STATIONS: usize = 32;
+/// A station not heard for this long is told to the daemon once per
+/// interval as unexpected, at most.
+const UNEXPECTED_INTERVAL_MS: u64 = 1_000;
+
+/// A station of the network.
+#[derive(Clone, Debug)]
+pub(crate) struct Station {
+    pub entry: StationEntry,
+    pub flags: u32,
+    /// Its pairwise key is in place: its data comes and goes encrypted.
+    pub encrypted: bool,
+    pub since: u64,
+    pub last_rx: u64,
+    pub signal: i8,
+    pub rx_bytes: u64,
+    pub tx_bytes: u64,
+    pub rx_packets: u32,
+    pub tx_packets: u32,
+}
+
+impl Station {
+    fn authorized(&self) -> bool {
+        self.flags & STA_AUTHORIZED != 0
+    }
+}
+
+/// The network running.
+#[derive(Clone, Debug)]
+pub(crate) struct Running {
+    pub config: ApConfig,
+    /// The socket whose closing ends it.
+    pub owner: Option<u32>,
+    /// The socket the handshake's frames go to (else the interface).
+    pub control_port: Option<u32>,
+    /// Stations do not reach each other.
+    pub isolate: bool,
+    /// When a frame of a station not in the network was last told.
+    pub unexpected_told: u64,
+}
+
+/// Frames a socket asked to receive (`NL80211_CMD_REGISTER_FRAME`).
+#[derive(Clone, Debug)]
+pub(crate) struct Registration {
+    pub port: u32,
+    /// The frame control field's type and subtype bits.
+    pub kind: u8,
+    /// The start of the frame's body it must have.
+    pub prefix: Vec<u8>,
+}
+
+/// What `NL80211_CMD_GET_STATION` reports of a station.
+#[derive(Clone, Debug)]
+pub(crate) struct StationInfo {
+    pub address: Address,
+    pub flags: u32,
+    pub inactive_ms: u32,
+    pub connected_s: u32,
+    pub signal: i8,
+    pub rx_bytes: u64,
+    pub tx_bytes: u64,
+    pub rx_packets: u32,
+    pub tx_packets: u32,
+}
+
+impl Device {
+    pub(crate) fn is_ap(&self) -> bool {
+        self.mode.load(Ordering::Acquire) == MODE_AP
+    }
+
+    /// The interface becomes a station or an access point.
+    pub(crate) fn set_mode(&self, ap: bool) -> Result<(), i32> {
+        if ap && !self.info.ap {
+            return Err(EOPNOTSUPP);
+        }
+        let wanted = if ap { MODE_AP } else { MODE_STATION };
+        if self.mode.load(Ordering::Acquire) == wanted {
+            return Ok(());
+        }
+        let mut state = self.state.lock();
+        if state.scan.is_some() {
+            self.radio.abort_scan();
+            self.end_scan(&mut state, true, crate::now_ms());
+        }
+        if ap {
+            self.leave_any(&mut state);
+        } else {
+            self.stop_ap_locked(&mut state);
+        }
+        self.mode.store(wanted, Ordering::Release);
+        ostd::notice!("{}: now {}", self.name, if ap { "an access point" } else { "a station" });
+        Ok(())
+    }
+
+    // ---- What the radio's driver hands over. None of these sleeps. ----
+
+    pub(crate) fn ap_received(&self, frame: &[u8], info: RxInfo) {
+        if wifi::is_management(frame) {
+            // Beacons of other networks are of no use here.
+            if wifi::kind(frame) != Some(wifi::BEACON) {
+                self.push_management(frame.to_vec(), info);
+            }
+            return;
+        }
+        if !wifi::is_data(frame) || frame.len() < wifi::HEADER {
+            return;
+        }
+        let Some((receiver, from, _)) = wifi::addresses(frame) else { return };
+        if receiver != self.info.address {
+            return;
+        }
+        let now = crate::now_ms();
+        let known = {
+            let mut stations = self.stations.lock();
+            match stations.get_mut(&from) {
+                Some(station) => {
+                    station.last_rx = now;
+                    station.signal = info.signal;
+                    station.rx_packets = station.rx_packets.wrapping_add(1);
+                    station.rx_bytes += frame.len() as u64;
+                    true
+                }
+                None => false,
+            }
+        };
+        if !known {
+            self.push_unexpected(from);
+            return;
+        }
+        let protected = frame[1] & wifi::PROTECTED != 0;
+        if protected && !info.decrypted {
+            return;
+        }
+        match self.reorder(frame, &info, &from) {
+            Some(frames) => {
+                for (frame, info) in frames {
+                    self.ap_data(&frame, &info, &from);
+                }
+            }
+            None => self.ap_data(frame, &info, &from),
+        }
+    }
+
+    /// A data frame from a known station, in its turn: the handshake's
+    /// frames, the station's data.
+    pub(crate) fn ap_data(&self, frame: &[u8], info: &RxInfo, from: &Address) {
+        let Some(encrypted) = self.stations.lock().get(from).map(|station| station.encrypted) else { return };
+        let protected = frame[1] & wifi::PROTECTED != 0;
+        if encrypted && !protected {
+            // Only the handshake's own frames may come in the clear.
+            let security = 0;
+            for ethernet in wifi::ethernet_from_station(frame, &self.info.address, security) {
+                if matches!(wifi::ethertype(&ethernet), Some(wifi::ETHERTYPE_EAPOL)) {
+                    self.push_port(ethernet, true);
+                }
+            }
+            return;
+        }
+        let security = if protected { info.security_header as usize } else { 0 };
+        for ethernet in wifi::ethernet_from_station(frame, &self.info.address, security) {
+            self.ap_deliver(ethernet, protected, from);
+        }
+    }
+
+    /// A frame from a station, already as Ethernet (chips whose firmware
+    /// converts): its source names the station.
+    pub(crate) fn ap_received_ethernet(&self, ethernet: Vec<u8>, protected: bool) {
+        if ethernet.len() < 14 {
+            return;
+        }
+        let from: Address = ethernet[6..12].try_into().unwrap();
+        let known = {
+            let mut stations = self.stations.lock();
+            match stations.get_mut(&from) {
+                Some(station) => {
+                    station.last_rx = crate::now_ms();
+                    station.rx_packets = station.rx_packets.wrapping_add(1);
+                    station.rx_bytes += ethernet.len() as u64;
+                    true
+                }
+                None => false,
+            }
+        };
+        if known {
+            self.ap_deliver(ethernet, protected, &from);
+        } else {
+            self.push_unexpected(from);
+        }
+    }
+
+    /// Where a station's frame goes: the daemon (the handshake), the
+    /// network stack, other stations.
+    fn ap_deliver(&self, ethernet: Vec<u8>, protected: bool, from: &Address) {
+        let (authorized, encrypted) = match self.stations.lock().get(from) {
+            Some(station) => (station.authorized(), station.encrypted),
+            None => return,
+        };
+        match wifi::ethertype(&ethernet) {
+            None => {}
+            Some(wifi::ETHERTYPE_EAPOL | wifi::ETHERTYPE_PREAUTH) => self.push_port(ethernet, !protected),
+            Some(_) if authorized && (protected || !encrypted) => {
+                let destination: Address = ethernet[0..6].try_into().unwrap();
+                if wifi::is_multicast(&destination) {
+                    if !self.isolated() {
+                        self.net.forward(ethernet.clone());
+                    }
+                } else if destination != self.info.address {
+                    let other = self.stations.lock().get(&destination).is_some_and(Station::authorized);
+                    if other {
+                        if !self.isolated() {
+                            self.net.forward(ethernet);
+                        }
+                        return;
+                    }
+                }
+                self.net.received(ethernet);
+                netdev::notify_received();
+            }
+            Some(_) => {}
+        }
+    }
+
+    fn isolated(&self) -> bool {
+        // Read without the state's lock: a relaxed copy kept by `set_bss`.
+        self.isolate.load(Ordering::Relaxed)
+    }
+
+    // ---- The task. ----
+
+    /// A management frame from a station or a scanning device.
+    pub(crate) fn ap_management(&self, state: &mut State, frame: &[u8], info: &RxInfo) {
+        if state.ap.is_none() {
+            return;
+        }
+        let Some(kind) = wifi::kind(frame) else { return };
+        let Some((receiver, from, _)) = wifi::addresses(frame) else { return };
+        if receiver != self.info.address && receiver != wifi::BROADCAST {
+            return;
+        }
+        let body = &frame[wifi::HEADER..];
+        // Block acknowledgment agreements are this component's (`ba`), not
+        // the daemon's: with a station of the network, protected once its
+        // management frames are (802.11w).
+        let protected = frame[1] & wifi::PROTECTED != 0;
+        let at = wifi::HEADER + if protected { info.security_header as usize } else { 0 };
+        if kind == wifi::ACTION && frame.get(at) == Some(&wifi::CATEGORY_BLOCK_ACK) {
+            let pmf = self.stations.lock().get(&from).map(|station| station.entry.mfp && station.encrypted);
+            match pmf {
+                Some(pmf) if (!protected || info.decrypted) && (protected || !pmf) => {
+                    self.block_ack_action(state, &from, &frame[at..], pmf);
+                }
+                _ => {}
+            }
+            return;
+        }
+        let port = state
+            .registrations
+            .iter()
+            .find(|registration| registration.kind == kind && body.starts_with(&registration.prefix))
+            .map(|registration| registration.port);
+        if let Some(port) = port {
+            let freq = state.ap.as_ref().map_or(info.freq, |running| running.config.chandef.control);
+            cfg::frame_received(self, port, frame, freq, info.signal);
+        }
+    }
+
+    /// FullMAC: the firmware took a station into the network. It becomes
+    /// one of the network's (its WMM from its request) and the daemon
+    /// hears of it as `NL80211_CMD_NEW_STATION` with the request's
+    /// elements, from which it runs WPA's handshake.
+    pub(crate) fn ap_station_joined_event(&self, state: &mut State, address: Address, elements: Vec<u8>) {
+        if state.ap.is_none() {
+            return;
+        }
+        let qos = wifi::Elements(&elements).vendor(wifi::WMM_OUI_TYPE).is_some();
+        let now = crate::now_ms();
+        let entry = StationEntry {
+            address,
+            aid: 0,
+            listen_interval: 0,
+            capability: 0,
+            peer: radio::Peer { qos, ..radio::Peer::default() },
+            mfp: false,
+        };
+        let flags = STA_AUTHENTICATED | STA_ASSOCIATED | if qos { STA_WME } else { 0 };
+        {
+            let mut stations = self.stations.lock();
+            if stations.len() >= MAX_STATIONS && !stations.contains_key(&address) {
+                return;
+            }
+            stations.insert(
+                address,
+                Station { entry, flags, encrypted: false, since: now, last_rx: now, signal: 0, rx_bytes: 0, tx_bytes: 0, rx_packets: 0, tx_packets: 0 },
+            );
+        }
+        ostd::notice!("{}: station {} joined", self.name, crate::Mac(&address));
+        cfg::new_station_event(self, &address, &elements);
+    }
+
+    /// FullMAC: a station left the network the firmware runs.
+    pub(crate) fn ap_station_left_event(&self, state: &mut State, address: Address) {
+        if self.stations.lock().remove(&address).is_none() {
+            return;
+        }
+        self.ba_end_all(state, Some(&address));
+        ostd::notice!("{}: station {} left", self.name, crate::Mac(&address));
+        cfg::del_station_event(self, &address);
+    }
+
+    /// A frame of the handshake from a station.
+    pub(crate) fn ap_port_frame(&self, state: &State, ethernet: Vec<u8>, unencrypted: bool) {
+        match state.ap.as_ref().and_then(|running| running.control_port) {
+            Some(port) => cfg::control_port_frame(self, port, &ethernet, unencrypted),
+            None => {
+                self.net.received(ethernet);
+                netdev::notify_received();
+            }
+        }
+    }
+
+    /// A data frame of a device not in the network: the daemon is told
+    /// (it answers with a deauthentication), once a second at most.
+    pub(crate) fn ap_unexpected(&self, state: &mut State, from: &Address) {
+        let now = crate::now_ms();
+        let Some(running) = state.ap.as_mut() else { return };
+        let Some(port) = state.unexpected_port else { return };
+        if now < running.unexpected_told + UNEXPECTED_INTERVAL_MS {
+            return;
+        }
+        running.unexpected_told = now;
+        cfg::unexpected_frame(self, port, from);
+    }
+
+    /// What the network stack sends: to one station, or to all of them.
+    pub(crate) fn ap_send_queued(&self, state: &mut State, now: u64) {
+        if !state.up || state.ap.is_none() {
+            self.net.clear_tx();
+            return;
+        }
+        while let Some(ethernet) = self.net.next_tx() {
+            if ethernet.len() < 14 {
+                continue;
+            }
+            let destination: Address = ethernet[0..6].try_into().unwrap();
+            let plain = if wifi::is_multicast(&destination) {
+                !self.group_key.load(Ordering::Acquire)
+            } else {
+                let eapol = matches!(wifi::ethertype(&ethernet), Some(wifi::ETHERTYPE_EAPOL));
+                let (plain, offer) = {
+                    let mut stations = self.stations.lock();
+                    let Some(station) = stations.get_mut(&destination) else { continue };
+                    if !station.authorized() && !eapol {
+                        continue;
+                    }
+                    station.tx_packets = station.tx_packets.wrapping_add(1);
+                    station.tx_bytes += ethernet.len() as u64;
+                    // A station that takes aggregates (HT with QoS) is
+                    // offered the radio's agreements to send them.
+                    let peer = &station.entry.peer;
+                    let offer = (station.authorized() && peer.qos && peer.ht.is_some()).then_some(station.entry.mfp && station.encrypted);
+                    (!station.encrypted, offer)
+                };
+                if let Some(protect) = offer {
+                    self.ba_offer(state, &destination, &ethernet, protect, now);
+                }
+                plain
+            };
+            match self.radio.send(&ethernet, plain) {
+                Err(radio::Error::Busy) => {
+                    self.net.put_back(ethernet);
+                    break;
+                }
+                _ => self.net.sent(),
+            }
+        }
+    }
+
+    // ---- What the daemon asks (nl80211). ----
+
+    /// Starts the network the daemon described.
+    pub(crate) fn start_ap(&self, config: ApConfig, owner: Option<u32>, control_port: Option<u32>) -> Result<(), i32> {
+        let mut state = self.state.lock();
+        if !state.up {
+            return Err(ENETDOWN);
+        }
+        if !self.is_ap() {
+            return Err(EOPNOTSUPP);
+        }
+        if state.ap.is_some() {
+            return Err(EALREADY);
+        }
+        let Some((band, channel)) = self.info.channel(config.chandef.control) else {
+            return Err(EINVAL);
+        };
+        if channel.disabled || channel.passive || channel.radar {
+            // No beacons where the radio may not send first.
+            return Err(EINVAL);
+        }
+        let _ = band;
+        self.radio.start_ap(&config).map_err(|error| {
+            ostd::warn!("{}: the radio did not start the network: {:?}", self.name, error);
+            error.errno()
+        })?;
+        ostd::notice!(
+            "{}: running the network \"{}\" on {} MHz ({} MHz wide)",
+            self.name,
+            crate::Printable(&config.ssid),
+            config.chandef.control,
+            config.chandef.width.mhz()
+        );
+        self.group_key.store(false, Ordering::Release);
+        state.ap = Some(Running { config, owner, control_port, isolate: false, unexpected_told: 0 });
+        self.ap_running.store(true, Ordering::Release);
+        drop(state);
+        // The interface serves the network and shares the connection.
+        crate::sharing_changed(&self.name, true);
+        // The task runs the network from now on.
+        crate::wake();
+        Ok(())
+    }
+
+    pub(crate) fn set_beacon(&self, beacon: BeaconTemplate) -> Result<(), i32> {
+        let mut state = self.state.lock();
+        let Some(running) = state.ap.as_mut() else { return Err(ENOENT) };
+        self.radio.set_beacon(&beacon).map_err(radio::Error::errno)?;
+        running.config.beacon = beacon;
+        Ok(())
+    }
+
+    pub(crate) fn stop_ap(&self) -> Result<(), i32> {
+        let mut state = self.state.lock();
+        if state.ap.is_none() {
+            return Err(ENOENT);
+        }
+        self.stop_ap_locked(&mut state);
+        Ok(())
+    }
+
+    pub(crate) fn stop_ap_locked(&self, state: &mut State) {
+        if state.ap.is_none() {
+            return;
+        }
+        self.ba_end_all(state, None);
+        state.ap = None;
+        self.radio.stop_ap();
+        self.stations.lock().clear();
+        self.group_key.store(false, Ordering::Release);
+        self.net.clear_tx();
+        self.ap_running.store(false, Ordering::Release);
+        ostd::notice!("{}: the network stopped", self.name);
+        crate::sharing_changed(&self.name, false);
+    }
+
+    /// The channel chosen before the network starts (`NL80211_CMD_SET_WIPHY`).
+    pub(crate) fn set_ap_channel(&self, chandef: Chandef) {
+        self.state.lock().ap_channel = Some(chandef);
+    }
+
+    pub(crate) fn ap_channel(&self) -> Option<Chandef> {
+        let state = self.state.lock();
+        state.ap.as_ref().map(|running| running.config.chandef).or(state.ap_channel)
+    }
+
+    pub(crate) fn set_isolate(&self, isolate: bool) {
+        self.isolate.store(isolate, Ordering::Relaxed);
+        if let Some(running) = self.state.lock().ap.as_mut() {
+            running.isolate = isolate;
+        }
+    }
+
+    /// The daemon accepted a station.
+    pub(crate) fn new_station(&self, entry: StationEntry, flags: u32) -> Result<(), i32> {
+        let state = self.state.lock();
+        if state.ap.is_none() {
+            return Err(ENETDOWN);
+        }
+        {
+            let stations = self.stations.lock();
+            if stations.len() >= MAX_STATIONS && !stations.contains_key(&entry.address) {
+                return Err(28);
+            }
+        }
+        self.radio.add_station(&entry).map_err(|error| {
+            ostd::warn!("{}: the radio did not take the station {}: {:?}", self.name, crate::Mac(&entry.address), error);
+            error.errno()
+        })?;
+        let now = crate::now_ms();
+        let address = entry.address;
+        let station = Station {
+            entry,
+            flags,
+            encrypted: false,
+            since: now,
+            last_rx: now,
+            signal: 0,
+            rx_bytes: 0,
+            tx_bytes: 0,
+            rx_packets: 0,
+            tx_packets: 0,
+        };
+        self.stations.lock().insert(address, station);
+        if flags & STA_AUTHORIZED != 0 {
+            self.radio.authorize_station(&address, true);
+        }
+        ostd::notice!("{}: station {} joined", self.name, crate::Mac(&address));
+        Ok(())
+    }
+
+    /// New flags for a station (authorized once its keys are in place).
+    pub(crate) fn set_station(&self, address: &Address, mask: u32, set: u32) -> Result<(), i32> {
+        let _state = self.state.lock();
+        let (was, now) = {
+            let mut stations = self.stations.lock();
+            let Some(station) = stations.get_mut(address) else { return Err(ENOENT) };
+            let was = station.flags;
+            station.flags = (station.flags & !mask) | (set & mask);
+            (was, station.flags)
+        };
+        if (was ^ now) & STA_AUTHORIZED != 0 {
+            self.radio.authorize_station(address, now & STA_AUTHORIZED != 0);
+            if now & STA_AUTHORIZED != 0 {
+                ostd::notice!("{}: station {} connected", self.name, crate::Mac(address));
+            }
+        }
+        Ok(())
+    }
+
+    /// The daemon dropped a station, or all of them.
+    pub(crate) fn del_station(&self, address: Option<&Address>) -> Result<(), i32> {
+        let mut state = self.state.lock();
+        let removed: Vec<Address> = {
+            let mut stations = self.stations.lock();
+            match address {
+                Some(address) => match stations.remove(address) {
+                    Some(_) => alloc::vec![*address],
+                    None => return Err(ENOENT),
+                },
+                None => {
+                    let all = stations.keys().copied().collect();
+                    stations.clear();
+                    all
+                }
+            }
+        };
+        for address in removed {
+            self.ba_end_all(&mut state, Some(&address));
+            self.radio.remove_station(&address);
+            ostd::notice!("{}: station {} left", self.name, crate::Mac(&address));
+        }
+        Ok(())
+    }
+
+    pub(crate) fn station_infos(&self) -> Vec<StationInfo> {
+        let now = crate::now_ms();
+        self.stations
+            .lock()
+            .values()
+            .map(|station| StationInfo {
+                address: station.entry.address,
+                flags: station.flags,
+                inactive_ms: now.saturating_sub(station.last_rx).min(u32::MAX as u64) as u32,
+                connected_s: (now.saturating_sub(station.since) / 1000) as u32,
+                signal: station.signal,
+                rx_bytes: station.rx_bytes,
+                tx_bytes: station.tx_bytes,
+                rx_packets: station.rx_packets,
+                tx_packets: station.tx_packets,
+            })
+            .collect()
+    }
+
+    pub(crate) fn ap_set_key(&self, key: Key) -> Result<(), i32> {
+        let state = self.state.lock();
+        if state.ap.is_none() {
+            return Err(ENETDOWN);
+        }
+        if !self.info.ciphers.contains(&key.cipher) {
+            return Err(EINVAL);
+        }
+        if key.pairwise {
+            let Some(address) = key.address else { return Err(EINVAL) };
+            if !self.stations.lock().contains_key(&address) {
+                return Err(ENOENT);
+            }
+            self.radio.set_key(&key).map_err(radio::Error::errno)?;
+            if let Some(station) = self.stations.lock().get_mut(&address) {
+                station.encrypted = true;
+            }
+        } else {
+            self.radio.set_key(&key).map_err(radio::Error::errno)?;
+            self.group_key.store(true, Ordering::Release);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn ap_remove_key(&self, index: u8, pairwise: bool, address: Option<Address>) -> Result<(), i32> {
+        let _state = self.state.lock();
+        if pairwise {
+            let Some(address) = address else { return Err(EINVAL) };
+            let mut stations = self.stations.lock();
+            let Some(station) = stations.get_mut(&address) else { return Err(ENOENT) };
+            station.encrypted = false;
+        } else {
+            self.group_key.store(false, Ordering::Release);
+        }
+        self.radio.remove_key(index, pairwise);
+        Ok(())
+    }
+
+    /// A frame of the daemon's (the handshake) to a station.
+    pub(crate) fn ap_control_port_send(&self, destination: &Address, ethertype: u16, payload: &[u8], plain: bool) -> Result<(), i32> {
+        let state = self.state.lock();
+        if state.ap.is_none() {
+            return Err(ENETDOWN);
+        }
+        let encrypted = match self.stations.lock().get(destination) {
+            Some(station) => station.encrypted,
+            None if wifi::is_multicast(destination) => self.group_key.load(Ordering::Acquire),
+            None => return Err(ENOENT),
+        };
+        let mut ethernet = Vec::with_capacity(14 + payload.len());
+        ethernet.extend_from_slice(destination);
+        ethernet.extend_from_slice(&self.info.address);
+        ethernet.extend_from_slice(&ethertype.to_be_bytes());
+        ethernet.extend_from_slice(payload);
+        self.radio.send(&ethernet, plain || !encrypted).map_err(radio::Error::errno)
+    }
+
+    /// The socket bound to `port` closed: its frames and the network it
+    /// owned go with it.
+    pub(crate) fn ap_released(&self, state: &mut State, port: u32) {
+        state.registrations.retain(|registration| registration.port != port);
+        if state.unexpected_port == Some(port) {
+            state.unexpected_port = None;
+        }
+        if state.ap.as_ref().is_some_and(|running| running.owner == Some(port)) {
+            ostd::notice!("{}: the access point's daemon went away", self.name);
+            self.stop_ap_locked(state);
+        }
+    }
+
+    pub(crate) fn register_frame(&self, port: u32, kind: u8, prefix: Vec<u8>) -> Result<(), i32> {
+        let mut state = self.state.lock();
+        let duplicate = state.registrations.iter().any(|registration| {
+            registration.kind == kind && (registration.prefix.starts_with(&prefix) || prefix.starts_with(&registration.prefix))
+        });
+        if duplicate {
+            // Linux refuses two sockets the same frames (`EALREADY`).
+            return Err(EALREADY);
+        }
+        state.registrations.push(Registration { port, kind, prefix });
+        Ok(())
+    }
+
+    pub(crate) fn register_unexpected(&self, port: u32) -> Result<(), i32> {
+        let mut state = self.state.lock();
+        if !self.is_ap() {
+            return Err(EINVAL);
+        }
+        if state.unexpected_port.is_some_and(|known| known != port) {
+            return Err(EALREADY);
+        }
+        state.unexpected_port = Some(port);
+        Ok(())
+    }
+
+    /// A management frame the daemon or the supplicant sends
+    /// (`NL80211_CMD_FRAME`).
+    pub(crate) fn send_frame(&self, frame: &[u8]) -> Result<(), i32> {
+        let state = self.state.lock();
+        if !state.up {
+            return Err(ENETDOWN);
+        }
+        if frame.len() < wifi::HEADER || !wifi::is_management(frame) {
+            return Err(EINVAL);
+        }
+        drop(state);
+        self.radio.send_management(frame).map_err(radio::Error::errno)
+    }
+}
diff --git a/kernel/comps/wlan/src/apcfg.rs b/kernel/comps/wlan/src/apcfg.rs
new file mode 100644
index 0000000..69c5cc1
--- /dev/null
+++ b/kernel/comps/wlan/src/apcfg.rs
@@ -0,0 +1,465 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! nl80211's commands for an access point, as hostapd sends them to a
+//! Linux driver built on mac80211: the interface's type, the network
+//! (`START_AP`, `SET_BEACON`, `STOP_AP`), its stations, the management
+//! frames hostapd answers itself (registered, received and sent with their
+//! transmit status), and the frames of devices not in the network.
+
+use alloc::{vec, vec::Vec};
+use core::sync::atomic::{AtomicU64, Ordering};
+
+use crate::{
+    ap::{self, STA_ASSOCIATED, STA_AUTHENTICATED, STA_AUTHORIZED, STA_MFP, STA_SHORT_PREAMBLE, STA_WME},
+    cfg::{GROUP_MLME, VERSION, device_of, event},
+    chan,
+    consts::*,
+    device::{Device, EINVAL},
+    genl::{self, EOPNOTSUPP},
+    ieee80211::{self as wifi, Address},
+    nl::{Attrs, Header, Message},
+    radio::{ApConfig, BandId, BeaconTemplate, Chandef, HeCap, HtCap, Peer, StationEntry, VhtCap, Width},
+};
+
+const ENOENT: i32 = 2;
+
+/// Cookies for the frames sent, matched by their transmit status.
+static COOKIE: AtomicU64 = AtomicU64::new(1);
+
+fn next_cookie() -> u64 {
+    COOKIE.fetch_add(1, Ordering::Relaxed)
+}
+
+/// `NL80211_CMD_SET_INTERFACE`: station or access point.
+pub(crate) fn set_interface(attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(attrs)?;
+    match attrs.u32(NL80211_ATTR_IFTYPE) {
+        None => Ok(Vec::new()),
+        Some(NL80211_IFTYPE_STATION) => device.set_mode(false).map(|()| Vec::new()),
+        Some(NL80211_IFTYPE_AP) => device.set_mode(true).map(|()| Vec::new()),
+        Some(_) => Err(EOPNOTSUPP),
+    }
+}
+
+/// The channel a request gives: its primary frequency and the span
+/// (`NL80211_ATTR_CHANNEL_WIDTH` and the center), or the older channel
+/// type.
+pub(crate) fn chandef_of(device: &Device, attrs: &Attrs) -> Result<Option<Chandef>, i32> {
+    let Some(freq) = attrs.u32(NL80211_ATTR_WIPHY_FREQ) else { return Ok(None) };
+    let control = u16::try_from(freq).map_err(|_| EINVAL)?;
+    let (band, channel) = device.info.channel(control).ok_or(EINVAL)?;
+    if channel.disabled {
+        return Err(EINVAL);
+    }
+    let width = match attrs.u32(NL80211_ATTR_CHANNEL_WIDTH) {
+        Some(NL80211_CHAN_WIDTH_20_NOHT) => Width::NoHt20,
+        Some(NL80211_CHAN_WIDTH_20) => Width::W20,
+        Some(NL80211_CHAN_WIDTH_40) => Width::W40,
+        Some(NL80211_CHAN_WIDTH_80) => Width::W80,
+        Some(NL80211_CHAN_WIDTH_160) => Width::W160,
+        Some(_) => return Err(EINVAL),
+        None => match attrs.u32(NL80211_ATTR_WIPHY_CHANNEL_TYPE) {
+            Some(NL80211_CHAN_HT20) => Width::W20,
+            Some(NL80211_CHAN_HT40MINUS | NL80211_CHAN_HT40PLUS) => Width::W40,
+            _ => Width::NoHt20,
+        },
+    };
+    let center = match (width, attrs.u32(NL80211_ATTR_CENTER_FREQ1)) {
+        (Width::NoHt20 | Width::W20, _) => control,
+        (_, Some(center)) => u16::try_from(center).map_err(|_| EINVAL)?,
+        (Width::W40, None) => match attrs.u32(NL80211_ATTR_WIPHY_CHANNEL_TYPE) {
+            Some(NL80211_CHAN_HT40MINUS) => control - 10,
+            _ => control + 10,
+        },
+        _ => return Err(EINVAL),
+    };
+    let chandef = Chandef { control, width, center };
+    // Only spans the radio runs, made of channels it may use.
+    let wanted = chan::chandef_for(band, control, &span_elements(band.id, &chandef));
+    if wanted != chandef {
+        return Err(EINVAL);
+    }
+    Ok(Some(chandef))
+}
+
+/// The HT and VHT operation elements that describe `chandef`, to check it
+/// with the same rules a station's channel follows.
+fn span_elements(band: BandId, chandef: &Chandef) -> Vec<u8> {
+    let mut elements = Vec::new();
+    if chandef.width == Width::NoHt20 {
+        return elements;
+    }
+    let primary = wifi::channel_of(chandef.control).unwrap_or(0);
+    let secondary = match chandef.width {
+        Width::W20 => 0,
+        _ if chandef.secondary_above() => 0x05,
+        _ => 0x07,
+    };
+    if band == BandId::Ghz6 {
+        // HE operation with its 6 GHz part: parameters (6 GHz info bit),
+        // BSS color, basic MCS, then primary, control, center 0 and 1, and
+        // the minimum rate.
+        let control = match chandef.width {
+            Width::W40 => 1,
+            Width::W80 => 2,
+            Width::W160 => 3,
+            _ => 0,
+        };
+        let center = wifi::channel_of(chandef.center).unwrap_or(0);
+        let (seg0, seg1) = match chandef.width {
+            Width::W160 => (wifi::channel_of(chandef.center_80()).unwrap_or(0), center),
+            _ => (center, 0),
+        };
+        let value = [wifi::EXT_HE_OPERATION, 0, 0, 0x02, 0, 0xfc, 0xff, primary, control, seg0, seg1, 6];
+        wifi::put_element(&mut elements, wifi::IE_EXTENSION, &value);
+        return elements;
+    }
+    wifi::put_element(&mut elements, wifi::IE_HT_OPERATION, &[primary, secondary, 0, 0, 0, 0]);
+    if chandef.width >= Width::W80 {
+        let center = wifi::channel_of(chandef.center).unwrap_or(0);
+        let (seg0, seg1) = match chandef.width {
+            Width::W160 => (wifi::channel_of(chandef.center_80()).unwrap_or(0), center),
+            _ => (center, 0),
+        };
+        wifi::put_element(&mut elements, wifi::IE_VHT_OPERATION, &[1, seg0, seg1, 0, 0]);
+    }
+    elements
+}
+
+/// `NL80211_CMD_SET_WIPHY` and `NL80211_CMD_SET_CHANNEL`: the channel a
+/// network will start on, and settings taken as they come (retries,
+/// thresholds, the queues' parameters).
+pub(crate) fn set_wiphy(attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(attrs)?;
+    if let Some(chandef) = chandef_of(&device, attrs)? {
+        device.set_ap_channel(chandef);
+    }
+    Ok(Vec::new())
+}
+
+fn beacon_of(attrs: &Attrs) -> Option<BeaconTemplate> {
+    let head = attrs.get(NL80211_ATTR_BEACON_HEAD)?;
+    if head.len() < wifi::BEACON_ELEMENTS {
+        return None;
+    }
+    Some(BeaconTemplate {
+        head: head.to_vec(),
+        tail: attrs.get(NL80211_ATTR_BEACON_TAIL).unwrap_or(&[]).to_vec(),
+        probe_response: attrs.get(NL80211_ATTR_PROBE_RESP).map(<[u8]>::to_vec),
+    })
+}
+
+/// `NL80211_CMD_START_AP`.
+pub(crate) fn start_ap(port: u32, attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(attrs)?;
+    let beacon = beacon_of(attrs).ok_or(EINVAL)?;
+    let chandef = match chandef_of(&device, attrs)? {
+        Some(chandef) => chandef,
+        None => device.ap_channel().ok_or(EINVAL)?,
+    };
+    let beacon_interval = attrs.u32(NL80211_ATTR_BEACON_INTERVAL).ok_or(EINVAL)?;
+    let dtim_period = attrs.u32(NL80211_ATTR_DTIM_PERIOD).unwrap_or(2);
+    if !(1..=10_000).contains(&beacon_interval) || !(1..=255).contains(&dtim_period) {
+        return Err(EINVAL);
+    }
+    let ssid = attrs.get(NL80211_ATTR_SSID).ok_or(EINVAL)?;
+    if ssid.is_empty() || ssid.len() > 32 {
+        return Err(EINVAL);
+    }
+    let hidden = attrs.u32(NL80211_ATTR_HIDDEN_SSID).is_some_and(|hidden| hidden != NL80211_HIDDEN_SSID_NOT_IN_USE);
+    let owner = attrs.has(NL80211_ATTR_SOCKET_OWNER).then_some(port);
+    let control_port = attrs.has(NL80211_ATTR_CONTROL_PORT_OVER_NL80211).then_some(port);
+    let config = ApConfig {
+        chandef,
+        ssid: ssid.to_vec(),
+        hidden,
+        beacon_interval: beacon_interval as u16,
+        dtim_period: dtim_period as u8,
+        beacon,
+        privacy: attrs.has(NL80211_ATTR_PRIVACY),
+    };
+    device.start_ap(config, owner, control_port)?;
+    Ok(Vec::new())
+}
+
+/// `NL80211_CMD_SET_BEACON`.
+pub(crate) fn set_beacon(attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(attrs)?;
+    device.set_beacon(beacon_of(attrs).ok_or(EINVAL)?)?;
+    Ok(Vec::new())
+}
+
+/// `NL80211_CMD_STOP_AP`.
+pub(crate) fn stop_ap(attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(attrs)?;
+    device.stop_ap().or_else(|errno| if errno == ENOENT { Ok(()) } else { Err(errno) })?;
+    Ok(Vec::new())
+}
+
+/// `NL80211_CMD_SET_BSS`: only the stations' isolation matters here.
+pub(crate) fn set_bss(attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(attrs)?;
+    if let Some(isolate) = attrs.u8(NL80211_ATTR_AP_ISOLATE) {
+        device.set_isolate(isolate != 0);
+    }
+    Ok(Vec::new())
+}
+
+/// The flags of `NL80211_ATTR_STA_FLAGS2` (a mask and the values), or the
+/// older `NL80211_ATTR_STA_FLAGS` nest (every flag named is set).
+fn station_flags(attrs: &Attrs) -> (u32, u32) {
+    if let Some(flags) = attrs.get(NL80211_ATTR_STA_FLAGS2).filter(|flags| flags.len() >= 8) {
+        let mask = u32::from_ne_bytes(flags[0..4].try_into().unwrap());
+        let set = u32::from_ne_bytes(flags[4..8].try_into().unwrap());
+        return (mask, set);
+    }
+    if let Some(nested) = attrs.nested(NL80211_ATTR_STA_FLAGS) {
+        let mut set = 0;
+        for (flag, _) in nested.iter() {
+            if flag < 32 {
+                set |= 1 << flag;
+            }
+        }
+        let all = STA_AUTHORIZED | STA_SHORT_PREAMBLE | STA_WME | STA_MFP | STA_AUTHENTICATED | STA_ASSOCIATED;
+        return (all, set);
+    }
+    (0, 0)
+}
+
+/// What a station runs with this network: its capabilities from the
+/// request, narrowed by the network's channel and the radio's.
+fn station_peer(device: &Device, attrs: &Attrs, wme: bool) -> Peer {
+    let Some(chandef) = device.ap_channel() else { return Peer::default() };
+    let Some((band, _)) = device.info.channel(chandef.control) else { return Peer::default() };
+    let mut elements = Vec::new();
+    if let Some(rates) = attrs.get(NL80211_ATTR_STA_SUPPORTED_RATES) {
+        let (first, more) = rates.split_at(rates.len().min(8));
+        wifi::put_element(&mut elements, wifi::IE_RATES, first);
+        if !more.is_empty() {
+            wifi::put_element(&mut elements, wifi::IE_EXT_RATES, more);
+        }
+    }
+    if let Some(ht) = attrs.get(NL80211_ATTR_HT_CAPABILITY).filter(|ht| HtCap::parse(ht).is_some()) {
+        wifi::put_element(&mut elements, wifi::IE_HT_CAP, ht);
+    }
+    if let Some(vht) = attrs.get(NL80211_ATTR_VHT_CAPABILITY).filter(|vht| VhtCap::parse(vht).is_some()) {
+        wifi::put_element(&mut elements, wifi::IE_VHT_CAP, vht);
+    }
+    if let Some(he) = attrs.get(NL80211_ATTR_HE_CAPABILITY).filter(|he| HeCap::parse(he).is_some()) {
+        let mut value = vec![wifi::EXT_HE_CAP];
+        value.extend_from_slice(he);
+        wifi::put_element(&mut elements, wifi::IE_EXTENSION, &value);
+    }
+    if let Some(capa) = attrs.get(NL80211_ATTR_HE_6GHZ_CAPABILITY).filter(|capa| capa.len() >= 2) {
+        let mut value = vec![wifi::EXT_HE_6GHZ_CAP];
+        value.extend_from_slice(&capa[..2]);
+        wifi::put_element(&mut elements, wifi::IE_EXTENSION, &value);
+    }
+    let mut peer = chan::peer_of(band, &chandef, &elements, wme);
+    // A station narrower than the network gets frames as wide as it takes.
+    let takes = match (&peer.vht, &peer.ht) {
+        (Some(vht), _) if vht.takes_160() => Width::W160,
+        (Some(_), _) => Width::W80,
+        (None, Some(ht)) if ht.info & chan::HT_CAP_SUP_WIDTH_20_40 != 0 => Width::W40,
+        (None, Some(_)) => Width::W20,
+        (None, None) if peer.he.is_some() => chandef.width,
+        (None, None) => Width::NoHt20,
+    };
+    peer.width = peer.width.min(takes);
+    peer
+}
+
+/// `NL80211_CMD_NEW_STATION`: hostapd accepted a station.
+pub(crate) fn new_station(attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(attrs)?;
+    if !device.is_ap() {
+        return Err(EOPNOTSUPP);
+    }
+    let address: Address = attrs.array(NL80211_ATTR_MAC).ok_or(EINVAL)?;
+    let aid = attrs.u16(NL80211_ATTR_STA_AID).or(attrs.u16(NL80211_ATTR_PEER_AID)).ok_or(EINVAL)?;
+    let (mask, set) = station_flags(attrs);
+    // A station hostapd adds has authenticated and associated (it adds
+    // none before, as this component keeps no state of stations that have
+    // not: mac80211's way without "full AP client state").
+    let flags = (set & mask) | STA_AUTHENTICATED | STA_ASSOCIATED;
+    let entry = StationEntry {
+        address,
+        aid,
+        listen_interval: attrs.u16(NL80211_ATTR_STA_LISTEN_INTERVAL).unwrap_or(0),
+        capability: attrs.u16(NL80211_ATTR_STA_CAPABILITY).unwrap_or(0),
+        peer: station_peer(&device, attrs, flags & STA_WME != 0),
+        mfp: flags & STA_MFP != 0,
+    };
+    device.new_station(entry, flags)?;
+    Ok(Vec::new())
+}
+
+/// `NL80211_CMD_SET_STATION`: as an access point, a station's flags; as a
+/// station, the link's authorization.
+pub(crate) fn set_station(attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(attrs)?;
+    let address: Address = attrs.array(NL80211_ATTR_MAC).ok_or(EINVAL)?;
+    let (mask, set) = station_flags(attrs);
+    if device.is_ap() {
+        device.set_station(&address, mask, set)?;
+        return Ok(Vec::new());
+    }
+    if mask & STA_AUTHORIZED != 0 {
+        device.authorize(&address, set & STA_AUTHORIZED != 0)?;
+    }
+    Ok(Vec::new())
+}
+
+/// `NL80211_CMD_DEL_STATION`: one station, or all of them.
+pub(crate) fn del_station(attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(attrs)?;
+    if !device.is_ap() {
+        return Err(EOPNOTSUPP);
+    }
+    let address: Option<Address> = attrs.array(NL80211_ATTR_MAC).filter(|address| *address != wifi::BROADCAST);
+    match device.del_station(address.as_ref()) {
+        Err(ENOENT) if address.is_none() => Ok(Vec::new()),
+        result => result.map(|()| Vec::new()),
+    }
+}
+
+pub(crate) fn station_messages(device: &Device, request: &Header, wanted: Option<Address>) -> Result<Vec<Vec<u8>>, i32> {
+    let stations = device.station_infos();
+    let messages: Vec<Vec<u8>> = stations
+        .iter()
+        .filter(|station| wanted.is_none_or(|address| address == station.address))
+        .map(|station| station_message(device, request, station))
+        .collect();
+    if wanted.is_some() && messages.is_empty() {
+        return Err(ENOENT);
+    }
+    Ok(messages)
+}
+
+fn station_message(device: &Device, request: &Header, station: &ap::StationInfo) -> Vec<u8> {
+    let mut message = Message::reply(request, NL80211_CMD_NEW_STATION, VERSION);
+    message.u32(NL80211_ATTR_IFINDEX, device.ifindex()).put(NL80211_ATTR_MAC, &station.address).u32(NL80211_ATTR_GENERATION, 1);
+    message.nest(NL80211_ATTR_STA_INFO, |message| {
+        message
+            .u32(NL80211_STA_INFO_INACTIVE_TIME, station.inactive_ms)
+            .u32(NL80211_STA_INFO_CONNECTED_TIME, station.connected_s)
+            .u64(NL80211_STA_INFO_RX_BYTES64, station.rx_bytes)
+            .u64(NL80211_STA_INFO_TX_BYTES64, station.tx_bytes)
+            .u32(NL80211_STA_INFO_RX_BYTES, station.rx_bytes as u32)
+            .u32(NL80211_STA_INFO_TX_BYTES, station.tx_bytes as u32)
+            .u32(NL80211_STA_INFO_RX_PACKETS, station.rx_packets)
+            .u32(NL80211_STA_INFO_TX_PACKETS, station.tx_packets);
+        if station.signal != 0 {
+            message.u8(NL80211_STA_INFO_SIGNAL, station.signal as u8);
+        }
+        let mut flags = [0u8; 8];
+        let all = STA_AUTHORIZED | STA_SHORT_PREAMBLE | STA_WME | STA_MFP | STA_AUTHENTICATED | STA_ASSOCIATED;
+        flags[0..4].copy_from_slice(&all.to_ne_bytes());
+        flags[4..8].copy_from_slice(&(station.flags & all).to_ne_bytes());
+        message.put(NL80211_STA_INFO_STA_FLAGS, &flags);
+    });
+    message.finish()
+}
+
+/// `NL80211_CMD_REGISTER_FRAME`.
+pub(crate) fn register_frame(port: u32, attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(attrs)?;
+    // Action frames unless said otherwise.
+    let kind = attrs.u16(NL80211_ATTR_FRAME_TYPE).unwrap_or(0x00d0);
+    if kind & 0x0c != 0 {
+        // Only management frames.
+        return Err(EINVAL);
+    }
+    let prefix = attrs.get(NL80211_ATTR_FRAME_MATCH).unwrap_or(&[]).to_vec();
+    device.register_frame(port, (kind & 0xfc) as u8, prefix)?;
+    Ok(Vec::new())
+}
+
+/// `NL80211_CMD_UNEXPECTED_FRAME`: hostapd asks for the frames of devices
+/// not in its network.
+pub(crate) fn register_unexpected(port: u32, attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(attrs)?;
+    device.register_unexpected(port)?;
+    Ok(Vec::new())
+}
+
+/// `NL80211_CMD_FRAME`: a management frame to send; the answer carries the
+/// cookie its transmit status will have.
+pub(crate) fn send_frame(request: &Header, attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    let device = device_of(attrs)?;
+    let frame = attrs.get(NL80211_ATTR_FRAME).ok_or(EINVAL)?;
+    if let Some(freq) = attrs.u32(NL80211_ATTR_WIPHY_FREQ) {
+        // Only on the channel the radio is on.
+        let on = device.ap_channel().map(|chandef| chandef.control as u32).or(device.link_info().map(|link| link.freq as u32));
+        if on.is_some_and(|on| on != freq) && !attrs.has(NL80211_ATTR_OFFCHANNEL_TX_OK) {
+            return Err(EINVAL);
+        }
+    }
+    let acked = device.send_frame(frame).is_ok();
+    if attrs.has(NL80211_ATTR_DONT_WAIT_FOR_ACK) {
+        return Ok(Vec::new());
+    }
+    let cookie = next_cookie();
+    let mut answer = Message::reply(request, NL80211_CMD_FRAME, VERSION);
+    answer.u64(NL80211_ATTR_COOKIE, cookie);
+    let mut status = event(&device, NL80211_CMD_FRAME_TX_STATUS);
+    status.u64(NL80211_ATTR_COOKIE, cookie).put(NL80211_ATTR_FRAME, frame);
+    if acked {
+        status.flag(NL80211_ATTR_ACK);
+    }
+    genl::multicast(GROUP_MLME, status.finish());
+    Ok(vec![answer.finish()])
+}
+
+/// `NL80211_CMD_PROBE_CLIENT`: hostapd asks whether an idle station is
+/// still there. The radios here give no acknowledgment of a frame to it,
+/// so a station heard of lately is: one silent for as long as hostapd lets
+/// stations idle is not.
+pub(crate) fn probe_client(request: &Header, attrs: &Attrs) -> Result<Vec<Vec<u8>>, i32> {
+    const HEARD_LATELY_MS: u32 = 300_000;
+    let device = device_of(attrs)?;
+    if !device.is_ap() {
+        return Err(EOPNOTSUPP);
+    }
+    let address: Address = attrs.array(NL80211_ATTR_MAC).ok_or(EINVAL)?;
+    let station = device.station_infos().into_iter().find(|station| station.address == address).ok_or(ENOENT)?;
+    let cookie = next_cookie();
+    let mut answer = Message::reply(request, NL80211_CMD_PROBE_CLIENT, VERSION);
+    answer.u64(NL80211_ATTR_COOKIE, cookie);
+    let mut status = event(&device, NL80211_CMD_PROBE_CLIENT);
+    status.put(NL80211_ATTR_MAC, &address).u64(NL80211_ATTR_COOKIE, cookie);
+    if station.inactive_ms < HEARD_LATELY_MS {
+        status.flag(NL80211_ATTR_ACK);
+    }
+    genl::multicast(GROUP_MLME, status.finish());
+    Ok(vec![answer.finish()])
+}
+
+/// A frame a socket registered for came (`NL80211_CMD_FRAME`).
+pub(crate) fn frame_received(device: &Device, port: u32, frame: &[u8], freq: u16, signal: i8) {
+    let mut message = event(device, NL80211_CMD_FRAME);
+    message
+        .u32(NL80211_ATTR_WIPHY_FREQ, freq as u32)
+        .u32(NL80211_ATTR_RX_SIGNAL_DBM, signal as i32 as u32)
+        .put(NL80211_ATTR_FRAME, frame);
+    genl::unicast(port, message.finish());
+}
+
+/// A data frame of a device not in the network (hostapd answers it with a
+/// deauthentication).
+pub(crate) fn unexpected_frame(device: &Device, port: u32, from: &Address) {
+    let mut message = event(device, NL80211_CMD_UNEXPECTED_FRAME);
+    message.put(NL80211_ATTR_MAC, from);
+    genl::unicast(port, message.finish());
+}
+
+/// A frame sent over the control port went (or not): hostapd times WPA's
+/// handshake by these.
+pub(crate) fn control_port_status(device: &Device, ethernet: &[u8], acked: bool) {
+    let mut status = event(device, NL80211_CMD_CONTROL_PORT_FRAME_TX_STATUS);
+    status.u64(NL80211_ATTR_COOKIE, next_cookie()).put(NL80211_ATTR_FRAME, ethernet);
+    if acked {
+        status.flag(NL80211_ATTR_ACK);
+    }
+    genl::multicast(GROUP_MLME, status.finish());
+}
