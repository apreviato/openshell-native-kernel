+    }
+
+    /// The firmware sent the frames before `ssn` (a queue index): their
+    /// descriptors are free again.
+    pub(crate) fn reclaim(&self, queue: &mut TxQueue, ssn: u16) {
+        let wrap = self.tx_wrap();
+        let target = ssn as usize % TX_QUEUE_SIZE;
+        while queue.read != queue.write && queue.read % TX_QUEUE_SIZE != target {
+            queue.read = (queue.read + 1) % wrap;
+        }
+    }
+
+    /// The MAC address the factory or the platform wrote (Linux's
+    /// `iwl_set_hw_address_from_csr`): the platform's, else the chip's own.
+    pub(crate) fn mac_address(&self) -> [u8; 6] {
+        let read = |low: usize, high: usize| -> [u8; 6] {
+            let (low, high) = (self.r32(low).to_le_bytes(), self.r32(high).to_le_bytes());
+            [low[3], low[2], low[1], low[0], high[1], high[0]]
+        };
+        let strap = read(csr::MAC_ADDR0_STRAP, csr::MAC_ADDR1_STRAP);
+        if strap[0] & 1 == 0 && strap.iter().any(|&byte| byte != 0) {
+            return strap;
+        }
+        read(csr::MAC_ADDR0_OTP, csr::MAC_ADDR1_OTP)
+    }
+
+    /// The AX210 family's platform NVM data (`.pnvm`, the sections for
+    /// this card's SKU one after another; may be empty): where it is, then
+    /// the doorbell that has the firmware read it (Linux's
+    /// `iwl_pnvm_load`). Its answer is `PNVM_INIT_COMPLETE`.
+    pub(crate) fn load_pnvm(&mut self, data: &[u8]) -> Result<(), Error> {
+        if let Some(scratch) = &self.scratch
+            && !data.is_empty()
+        {
+            let block = dma(data.len())?;
+            block.write_bytes(0, data).map_err(|_| Error::Memory)?;
+            // `pnvm_cfg` in the control part.
+            scratch.write_val(16, &(block.daddr() as u64)).map_err(|_| Error::Memory)?;
+            scratch.write_val(24, &(data.len() as u32)).map_err(|_| Error::Memory)?;
+            self.pnvm = Some(block);
+        }
+        if !self.write_prph_awake(self.umac(csr::UREG_DOORBELL_TO_ISR6), csr::UREG_DOORBELL_TO_ISR6_PNVM) {
+            return Err(Error::NoClock);
+        }
+        Ok(())
+    }
+
+    /// Stops the chip: reset, interrupts off. The first generation's
+    /// DMA is stopped first, as its memory goes with the queues.
     pub(crate) fn stop(&mut self) {
         self.disable_interrupts();
+        if self.is_gen1() {
+            self.stop_dma_gen1();
+        }
         self.set_bits(csr::RESET, csr::RESET_SW_RESET);
         crate::delay_ms(6);
         self.rx = None;
         self.commands = None;
         self.images.clear();
         self.context.clear();
+        self.scratch = None;
+        self.pnvm = None;
+        self.gen1 = None;
     }
 }
diff --git a/kernel/comps/iwlwifi/src/trans/gen1.rs b/kernel/comps/iwlwifi/src/trans/gen1.rs
new file mode 100644
index 0000000..2503cef
--- /dev/null
+++ b/kernel/comps/iwlwifi/src/trans/gen1.rs
@@ -0,0 +1,623 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The first generation of the transport (the 9000 family), as Linux's
+//! `pcie` transport runs it (`iwl_pcie_load_given_ucode_8000`,
+//! `iwl_pcie_rx_mq_hw_init`, `iwl_pcie_tx_init`, `iwl_pcie_tx_start`,
+//! `iwl_trans_pcie_tx`).
+//!
+//! The host copies each section of the firmware into the chip through the
+//! DMA engine's service channel, a piece at a time, and tells the chip's
+//! boot code which it has: first the sections of the first processor
+//! (LMAC), then the second's (UMAC). The transmit queues are rings of 256
+//! descriptors the host keeps for all 31 of them; the scheduler (SCD), in
+//! the chip, reads each frame's length from a table the host fills, and the
+//! host starts it with the command queue once the firmware runs. The
+//! receive queue is the AX200's, which the host describes to the chip
+//! itself; the 8000 family's is the older single one, a ring of buffers
+//! the chip fills in order (`iwl_pcie_rx_hw_init`). The runtime program
+//! loads part of its code on demand from pages the host keeps for it
+//! ("paging").
+
+use alloc::vec::Vec;
+
+use ostd::mm::{HasDaddr, PAGE_SIZE, VmIo, dma::DmaCoherent};
+
+use super::{Error, FIRST_PIECE, TX_BUFFER, Transport, TxQueue, dma};
+use crate::{
+    csr,
+    fw::{Firmware, Section},
+    ids::Family,
+};
+
+/// The scheduler's queues (`num_of_queues`).
+const QUEUES: usize = 31;
+/// The older receive queue's ring (`RX_QUEUE_SIZE`), as its size field
+/// says it (`RX_QUEUE_SIZE_LOG`).
+pub(super) const LEGACY_RX_RING: usize = 256;
+const LEGACY_RX_RING_LOG: u32 = 8;
+/// The address the factory wrote, in the MAC's periphery (8000 family).
+const WFMP_MAC_ADDR_0: u32 = 0x00a0_3080;
+const WFMP_MAC_ADDR_1: u32 = 0x00a0_3084;
+/// Descriptors in a queue's ring (`TFD_QUEUE_SIZE_MAX`).
+pub(super) const RING: usize = 256;
+/// A descriptor (`struct iwl_tfd`): three unused bytes, the count of its
+/// pieces, 20 pieces of six bytes (address, length) and four unused.
+const TFD: usize = 128;
+const TFD_PIECES: usize = 20;
+/// The longest a piece may be: its length has 12 bits.
+const PIECE_MAX: usize = 0xff0;
+/// A queue's byte counts (`TFD_QUEUE_BC_SIZE`): the ring, then its first
+/// 64 entries again for the scheduler's look-ahead.
+const COUNTS: usize = RING + COUNTS_DUP;
+const COUNTS_DUP: usize = 64;
+/// The command queue: its number and FIFO (`IWL_MVM_DQA_CMD_QUEUE`,
+/// `IWL_MVM_TX_FIFO_CMD`), its buffers (`IWL_CMD_QUEUE_SIZE`) and their
+/// size (the radio's calibration results go back to the firmware whole).
+const COMMAND_QUEUE: usize = 0;
+const COMMAND_FIFO: u32 = 7;
+pub(super) const COMMAND_SLOTS: usize = 32;
+pub(super) const MAX_COMMAND: usize = 2 * PAGE_SIZE;
+/// Frames the scheduler sends of a queue in one go (`IWL_FRAME_LIMIT`).
+pub(crate) const FRAME_LIMIT: u32 = 64;
+/// The chip's addresses that the extended window reaches.
+const EXTENDED_START: u32 = 0x4_0000;
+const EXTENDED_END: u32 = 0x5_7fff;
+/// How long the chip has to take a piece of the firmware.
+const LOAD_TIMEOUT_MS: u64 = 5_000;
+/// The firmware's pages: the signature's block of 4 KiB, then blocks of
+/// eight 4 KiB pages (`FW_PAGING_SIZE`, `PAGING_BLOCK_SIZE`), 32 at most.
+const PAGING_PAGE: usize = 4096;
+const PAGES_PER_BLOCK: usize = 8;
+const MAX_PAGING_BLOCKS: usize = 32;
+/// In the byte count: the frame's CRC and delimiter, and the CCMP MIC the
+/// chip adds (`IWL_TX_CRC_SIZE`, `IWL_TX_DELIMITER_SIZE`).
+const CRC_AND_DELIMITER: usize = 8;
+const CCMP_MIC: usize = 8;
+/// The TX command's fields the transport reads or fills (`struct
+/// iwl_tx_cmd_v6_params`, after the 4-byte header): the station, the
+/// cipher, the scratch the chip writes back and where it is.
+const TX_CMD_STA_ID: usize = 4 + 16;
+const TX_CMD_SEC_CTL: usize = 4 + 17;
+const TX_CMD_SCRATCH: usize = 4 + 8;
+const TX_CMD_DRAM_LSB: usize = 4 + 44;
+const TX_CMD_DRAM_MSB: usize = 4 + 48;
+const TX_CMD_SEC_MASK: u8 = 0x7;
+const TX_CMD_SEC_CCM: u8 = 0x2;
+
+/// The first generation's memory, while the firmware runs.
+pub(super) struct Gen1 {
+    /// Every queue's ring: the scheduler may look at any.
+    rings: Vec<DmaCoherent>,
+    /// The byte counts of every queue, one table.
+    counts: DmaCoherent,
+    /// The "keep warm" page the DMA engine reads to stay awake.
+    _keep_warm: DmaCoherent,
+    /// The runtime program's pages.
+    paging: Vec<DmaCoherent>,
+}
+
+/// What the firmware is told of its pages (`struct iwl_fw_paging_cmd`).
+pub(crate) struct Paging {
+    /// Pages in the last block.
+    pub(crate) pages_in_last: u32,
+    /// Blocks after the signature's.
+    pub(crate) blocks: u32,
+    /// Each block's address in 4 KiB pages, the signature's first.
+    pub(crate) addresses: Vec<u32>,
+}
+
+/// A descriptor with its pieces.
+fn descriptor(pieces: &[(u64, usize)]) -> [u8; TFD] {
+    let mut tfd = [0u8; TFD];
+    tfd[3] = pieces.len() as u8;
+    for (number, (address, length)) in pieces.iter().enumerate() {
+        let at = 4 + number * 6;
+        tfd[at..at + 4].copy_from_slice(&(*address as u32).to_le_bytes());
+        let hi_n_len = ((*length as u16) << 4) | ((*address >> 32) as u16 & 0xf);
+        tfd[at + 4..at + 6].copy_from_slice(&hi_n_len.to_le_bytes());
+    }
+    tfd
+}
+
+/// `length` bytes at `address` as pieces, none longer than a piece may be.
+fn split(pieces: &mut Vec<(u64, usize)>, address: u64, length: usize) {
+    let mut done = 0;
+    while done < length {
+        let piece = (length - done).min(PIECE_MAX);
+        pieces.push((address + done as u64, piece));
+        done += piece;
+    }
+}
+
+impl Transport {
+    /// The 9000 and 8000 families' transport.
+    pub(super) fn is_gen1(&self) -> bool {
+        matches!(self.mac.family, Family::Ac9000 | Family::Ac8000)
+    }
+
+    /// The 8000 family's single receive queue.
+    pub(super) fn legacy_rx(&self) -> bool {
+        self.mac.family == Family::Ac8000
+    }
+
+    /// The address the factory wrote in the MAC (Linux's
+    /// `iwl_set_hw_address_family_8000`, from the WFMP registers), for
+    /// the 8000 family when its NVM overrides none.
+    pub(crate) fn mac_address_wfmp(&self) -> [u8; 6] {
+        if !self.grab() {
+            return [0; 6];
+        }
+        let (low, high) = (self.read_prph(WFMP_MAC_ADDR_0).to_le_bytes(), self.read_prph(WFMP_MAC_ADDR_1).to_le_bytes());
+        self.release();
+        [low[3], low[2], low[1], low[0], high[1], high[0]]
+    }
+
+    fn set_bits_prph(&self, address: u32, bits: u32) {
+        let value = self.read_prph(address);
+        self.write_prph(address, value | bits);
+    }
+
+    fn clear_bits_prph(&self, address: u32, bits: u32) {
+        let value = self.read_prph(address);
+        self.write_prph(address, value & !bits);
+    }
+
+    /// The low half first, as Linux writes them.
+    fn write_prph64(&self, address: u32, value: u64) {
+        self.write_prph(address, value as u32);
+        self.write_prph(address + 4, (value >> 32) as u32);
+    }
+
+    /// A word of the chip's memory; the chip must be awake.
+    fn write_mem32(&self, address: u32, value: u32) {
+        self.w32(csr::HBUS_TARG_MEM_WADDR, address);
+        self.w32(csr::HBUS_TARG_MEM_WDAT, value);
+    }
+
+    fn tcsr(register: usize, channel: usize) -> usize {
+        register + channel * csr::FH_TCSR_CHNL_STRIDE
+    }
+
+    /// The chip's configuration as the host sets it (Linux's
+    /// `iwl_mvm_nic_config`): the MAC's step and the radio's type, step
+    /// and dash from the firmware's PHY configuration.
+    fn nic_config(&self, phy_config: u32) {
+        let radio_type = phy_config & 0x3;
+        let radio_step = (phy_config >> 2) & 0x3;
+        let radio_dash = (phy_config >> 4) & 0x3;
+        let value = (self.hw_rev & csr::HW_IF_CONFIG_MAC_STEP_DASH)
+            | (radio_type << csr::HW_IF_CONFIG_PHY_TYPE_POS)
+            | (radio_step << csr::HW_IF_CONFIG_PHY_STEP_POS)
+            | (radio_dash << csr::HW_IF_CONFIG_PHY_DASH_POS);
+        let mask = csr::HW_IF_CONFIG_MAC_STEP_DASH | csr::HW_IF_CONFIG_PHY_MASK | csr::HW_IF_CONFIG_RADIO_SI | csr::HW_IF_CONFIG_MAC_SI;
+        self.w32(csr::HW_IF_CONFIG, (self.r32(csr::HW_IF_CONFIG) & !mask) | value);
+    }
+
+    /// The receive queue, described to the chip (Linux's
+    /// `iwl_pcie_rx_mq_hw_init`): the rings, 4 KiB buffers, 512
+    /// descriptors, and then the free buffers.
+    fn rx_init_gen1(&mut self) -> Result<(), Error> {
+        if self.legacy_rx() {
+            return self.rx_init_legacy();
+        }
+        let (free, used, status) = {
+            let rx = self.rx.as_ref().ok_or(Error::Memory)?;
+            (rx.free.daddr() as u64, rx.used.daddr() as u64, rx.status.daddr() as u64)
+        };
+        if !self.grab() {
+            return Err(Error::NoClock);
+        }
+        self.write_prph(csr::RFH_RXF_DMA_CFG, 0);
+        self.write_prph(csr::RFH_RXF_RXQ_ACTIVE, 0);
+        self.write_prph64(csr::RFH_Q0_FRBDCB_BA, free);
+        self.write_prph64(csr::RFH_Q0_URBDCB_BA, used);
+        self.write_prph64(csr::RFH_Q0_URBD_STTS_WPTR, status);
+        self.write_prph(csr::RFH_Q0_FRBDCB_WIDX, 0);
+        self.write_prph(csr::RFH_Q0_FRBDCB_RIDX, 0);
+        self.write_prph(csr::RFH_Q0_URBDCB_WIDX, 0);
+        self.write_prph(
+            csr::RFH_RXF_DMA_CFG,
+            csr::RFH_DMA_ENABLE | csr::RFH_DMA_RB_SIZE_4K | csr::RFH_DMA_MIN_RB_4_8 | csr::RFH_DMA_DROP_TOO_LARGE | csr::RFH_DMA_RBDCB_SIZE_512,
+        );
+        // Snooping; 64-byte chunks on the platform's bus, 128 on PCIe.
+        let chunk = if self.mac.integrated { 0 } else { csr::RFH_GEN_CFG_RB_CHUNK_128 };
+        self.write_prph(csr::RFH_GEN_CFG, csr::RFH_GEN_CFG_RFH_DMA_SNOOP | csr::RFH_GEN_CFG_SERVICE_DMA_SNOOP | chunk);
+        // Queue 0, its free and used rings.
+        self.write_prph(csr::RFH_RXF_RXQ_ACTIVE, 1 | (1 << 16));
+        self.release();
+        self.w8(csr::INT_COALESCING, csr::INT_COALESCING_DEFAULT);
+        if let Some(mut rx) = self.rx.take() {
+            self.tell_rx(&mut rx);
+            self.rx = Some(rx);
+        }
+        Ok(())
+    }
+
+    /// The older single receive queue (Linux's `iwl_pcie_rx_hw_init`):
+    /// stopped, its pointers reset, its ring and status, then 4 KiB
+    /// buffers, 256 of them, interrupting the host; then the free ones.
+    fn rx_init_legacy(&mut self) -> Result<(), Error> {
+        let (free, status) = {
+            let rx = self.rx.as_ref().ok_or(Error::Memory)?;
+            (rx.free.daddr() as u64, rx.status.daddr() as u64)
+        };
+        if !self.grab() {
+            return Err(Error::NoClock);
+        }
+        self.w32(csr::FH_MEM_RCSR_CHNL0_CONFIG, 0);
+        self.w32(csr::FH_MEM_RCSR_CHNL0_RBDCB_WPTR, 0);
+        self.w32(csr::FH_MEM_RCSR_CHNL0_FLUSH_RB_REQ, 0);
+        self.w32(csr::FH_RSCSR_CHNL0_RDPTR, 0);
+        self.w32(csr::FH_RSCSR_CHNL0_WPTR, 0);
+        self.w32(csr::FH_RSCSR_CHNL0_RBDCB_BASE, (free >> 8) as u32);
+        self.w32(csr::FH_RSCSR_CHNL0_STTS_WPTR, (status >> 4) as u32);
+        self.w32(
+            csr::FH_MEM_RCSR_CHNL0_CONFIG,
+            csr::FH_RCSR_RX_CONFIG_CHNL_EN
+                | csr::FH_RCSR_CHNL0_RX_IGNORE_RXF_EMPTY
+                | csr::FH_RCSR_CHNL0_RX_IRQ_DEST_HOST
+                | csr::FH_RCSR_RX_CONFIG_RB_SIZE_4K
+                | (csr::FH_RX_RB_TIMEOUT << csr::FH_RCSR_RX_CONFIG_IRQ_RBTH_POS)
+                | (LEGACY_RX_RING_LOG << csr::FH_RCSR_RX_CONFIG_RBDCB_SIZE_POS),
+        );
+        self.release();
+        self.w8(csr::INT_COALESCING, csr::INT_COALESCING_DEFAULT);
+        if let Some(mut rx) = self.rx.take() {
+            self.tell_rx(&mut rx);
+            self.rx = Some(rx);
+        }
+        Ok(())
+    }
+
+    /// Every queue's ring and the byte counts, told to the chip (Linux's
+    /// `iwl_pcie_tx_init`), with the scheduler's FIFOs off.
+    fn tx_init_gen1(&mut self) -> Result<(), Error> {
+        let mut rings = Vec::with_capacity(QUEUES);
+        for _ in 0..QUEUES {
+            rings.push(dma(RING * TFD)?);
+        }
+        let counts = dma(QUEUES * COUNTS * 2)?;
+        let keep_warm = dma(PAGE_SIZE)?;
+        if !self.grab() {
+            return Err(Error::NoClock);
+        }
+        self.write_prph(csr::SCD_TXFACT, 0);
+        self.w32(csr::FH_KW_MEM_ADDR, (keep_warm.daddr() >> 4) as u32);
+        for (queue, ring) in rings.iter().enumerate() {
+            self.w32(csr::fh_mem_cbbc(queue), (ring.daddr() >> 8) as u32);
+        }
+        self.set_bits_prph(csr::SCD_GP_CTRL, csr::SCD_GP_CTRL_AUTO_ACTIVE_MODE);
+        self.set_bits_prph(csr::SCD_GP_CTRL, csr::SCD_GP_CTRL_ENABLE_31_QUEUES);
+        self.release();
+        self.gen1 = Some(Gen1 { rings, counts, _keep_warm: keep_warm, paging: Vec::new() });
+        Ok(())
+    }
+
+    /// Linux's `iwl_trans_pcie_start_fw` for the first generation: the
+    /// chip, its queues, and the program (`init`: the calibrating one,
+    /// which runs with the radio's switch off too) copied in.
+    pub(super) fn start_firmware_gen1(&mut self, firmware: &Firmware, file: &[u8], init: bool) -> Result<(), Error> {
+        self.gen1 = None;
+        self.start_hw()?;
+        self.prepare_card()?;
+        self.w32(csr::INT, u32::MAX);
+        self.disable_interrupts();
+        if !init && self.rf_kill() {
+            return Err(Error::RfKill);
+        }
+        self.w32(csr::UCODE_DRV_GP1_CLR, csr::UCODE_SW_BIT_RFKILL);
+        self.w32(csr::UCODE_DRV_GP1_CLR, csr::UCODE_DRV_GP1_CMD_BLOCKED);
+        self.w32(csr::INT, u32::MAX);
+        self.apm_init()?;
+        self.nic_config(firmware.phy_config);
+        self.make_queues()?;
+        self.rx_init_gen1()?;
+        self.tx_init_gen1()?;
+        self.set_bits(csr::MAC_SHADOW_REG_CTRL, csr::MAC_SHADOW_REG_CTRL_ENABLE);
+        // While the firmware is copied: the service channel's end.
+        self.enable_causes(csr::MSIX_FH_CAUSES_D2S_CH0 | csr::MSIX_FH_CAUSES_D2S_CH1, Self::HW_CAUSES);
+        self.w32(csr::UCODE_DRV_GP1_CLR, csr::UCODE_SW_BIT_RFKILL);
+        self.load_image_gen1(firmware, file, init)?;
+        if !init && self.rf_kill() {
+            return Err(Error::RfKill);
+        }
+        Ok(())
+    }
+
+    /// Copies a program into the chip (Linux's
+    /// `iwl_pcie_load_given_ucode_8000`): the first processor's sections
+    /// up to a separator, then the second's, each section's bit set in
+    /// the load status as it arrives.
+    fn load_image_gen1(&mut self, firmware: &Firmware, file: &[u8], init: bool) -> Result<(), Error> {
+        let image = firmware.image(init);
+        if image.iter().all(Section::is_separator) {
+            return Err(Error::Firmware);
+        }
+        let buffer = dma(csr::FH_TB_MAX_LENGTH)?;
+        if !self.grab() {
+            return Err(Error::NoClock);
+        }
+        // A word for the host's debugging, and the processors let go to
+        // take the signed image.
+        self.write_prph(csr::WFPM_GP2, 0x0101_0101);
+        self.write_prph(csr::RELEASE_CPU_RESET, csr::RELEASE_CPU_RESET_BIT);
+        self.release();
+        let waiting = crate::WAKER.waiting();
+        let result = (|| {
+            let mut first = 0;
+            for cpu in 0..2u32 {
+                if cpu == 1 {
+                    first += 1;
+                }
+                let mut bits: u32 = 1;
+                let mut last = 0;
+                for (index, section) in image.iter().enumerate().skip(first) {
+                    last = index;
+                    if section.is_separator() || section.data.is_empty() {
+                        break;
+                    }
+                    self.load_section(&buffer, section, file)?;
+                    if !self.grab() {
+                        return Err(Error::NoClock);
+                    }
+                    let status = self.r32(csr::FH_UCODE_LOAD_STATUS);
+                    self.w32(csr::FH_UCODE_LOAD_STATUS, status | (bits << (16 * cpu)));
+                    self.release();
+                    bits = (bits << 1) | 1;
+                }
+                first = last;
+                self.enable_interrupts();
+                if !self.grab() {
+                    return Err(Error::NoClock);
+                }
+                self.w32(csr::FH_UCODE_LOAD_STATUS, if cpu == 0 { 0xffff } else { u32::MAX });
+                self.release();
+            }
+            Ok(())
+        })();
+        drop(waiting);
+        result
+    }
+
+    /// A section, in pieces of the service channel's longest copy; those
+    /// for the extended memory through its window.
+    fn load_section(&self, buffer: &DmaCoherent, section: &Section, file: &[u8]) -> Result<(), Error> {
+        let bytes = file.get(section.data.clone()).ok_or(Error::Firmware)?;
+        for (number, piece) in bytes.chunks(csr::FH_TB_MAX_LENGTH).enumerate() {
+            let address = section.offset.wrapping_add((number * csr::FH_TB_MAX_LENGTH) as u32);
+            let extended = (EXTENDED_START..=EXTENDED_END).contains(&address);
+            buffer.write_bytes(0, piece).map_err(|_| Error::Memory)?;
+            if extended && self.grab() {
+                self.set_bits_prph(csr::LMPM_CHICK, csr::LMPM_CHICK_EXTENDED_ADDR_SPACE);
+                self.release();
+            }
+            let result = self.load_chunk(address, buffer.daddr() as u64, piece.len() as u32);
+            if extended && self.grab() {
+                self.clear_bits_prph(csr::LMPM_CHICK, csr::LMPM_CHICK_EXTENDED_ADDR_SPACE);
+                self.release();
+            }
+            result?;
+        }
+        Ok(())
+    }
+
+    /// One copy of the service channel (Linux's
+    /// `iwl_pcie_load_firmware_chunk_fh`), waited for.
+    fn load_chunk(&self, address: u32, source: u64, length: u32) -> Result<(), Error> {
+        if !self.grab() {
+            return Err(Error::NoClock);
+        }
+        let config = Self::tcsr(csr::FH_TCSR_CHNL_TX_CONFIG, csr::FH_SRVC_CHNL);
+        // Paused while it is set up.
+        self.w32(config, 0);
+        self.w32(csr::FH_SRVC_SRAM_ADDR, address);
+        self.w32(csr::FH_TFDIB_CTRL0_SRVC, source as u32);
+        self.w32(csr::FH_TFDIB_CTRL1_SRVC, (((source >> 32) as u32 & 0xf) << csr::FH_TFDIB_HI_SHIFT) | length);
+        self.w32(Self::tcsr(csr::FH_TCSR_CHNL_TX_BUF_STS, csr::FH_SRVC_CHNL), csr::FH_TCSR_TX_BUF_STS_ONE_VALID);
+        self.w32(config, csr::FH_TCSR_TX_CONFIG_DMA_ENABLE | csr::FH_TCSR_TX_CONFIG_CIRQ_HOST_ENDTFD);
+        self.release();
+        let deadline = crate::now_ms() + LOAD_TIMEOUT_MS;
+        loop {
+            let causes = self.causes();
+            if causes.fh_tx {
+                return Ok(());
+            }
+            if causes.error || crate::now_ms() >= deadline {
+                ostd::warn!("{}: the chip did not take {} bytes for {:#x}", self.name, length, address);
+                return Err(Error::Load);
+            }
+            crate::sleep();
+        }
+    }
+
+    /// The firmware runs: the scheduler, its state cleared, the byte
+    /// counts, the command queue and every FIFO and DMA channel (Linux's
+    /// `iwl_pcie_tx_start`).
+    pub(super) fn tx_start_gen1(&mut self) -> Result<(), Error> {
+        let counts = self.gen1.as_ref().ok_or(Error::Memory)?.counts.daddr() as u64;
+        if !self.grab() {
+            return Err(Error::NoClock);
+        }
+        let scd_base = self.read_prph(csr::SCD_SRAM_BASE_ADDR);
+        // The queues' contexts, status and translation table: zero.
+        let end = (csr::SCD_TRANS_TBL_MEM + QUEUES as u32 * 2) & 0xfffc;
+        self.w32(csr::HBUS_TARG_MEM_WADDR, scd_base + csr::SCD_CONTEXT_MEM);
+        for _ in 0..(end - csr::SCD_CONTEXT_MEM) / 4 {
+            self.w32(csr::HBUS_TARG_MEM_WDAT, 0);
+        }
+        self.write_prph(csr::SCD_DRAM_BASE_ADDR, (counts >> 10) as u32);
+        self.scd_enable_queue(scd_base, COMMAND_QUEUE, COMMAND_FIFO);
+        self.write_prph(csr::SCD_TXFACT, 0xff);
+        for channel in 0..csr::FH_TCSR_CHANNELS {
+            self.w32(Self::tcsr(csr::FH_TCSR_CHNL_TX_CONFIG, channel), csr::FH_TCSR_TX_CONFIG_DMA_ENABLE | csr::FH_TCSR_TX_CONFIG_CREDIT_ENABLE);
+        }
+        let chicken = self.r32(csr::FH_TX_CHICKEN_BITS);
+        self.w32(csr::FH_TX_CHICKEN_BITS, chicken | csr::FH_TX_CHICKEN_SCD_AUTO_RETRY);
+        self.release();
+        if let Some(queue) = self.commands.as_mut() {
+            queue.write = 0;
+        }
+        Ok(())
+    }
+
+    /// A queue the host configures itself in the scheduler (Linux's
+    /// `iwl_trans_pcie_txq_enable` with a configuration: the command
+    /// queue): inactive, no aggregation, at 0, its window, active on its
+    /// FIFO.
+    fn scd_enable_queue(&self, scd_base: u32, queue: usize, fifo: u32) {
+        self.write_prph(csr::SCD_EN_CTRL, 0);
+        self.write_prph(csr::scd_queue_status(queue), csr::SCD_QUEUE_STTS_ACT_EN);
+        self.clear_bits_prph(csr::SCD_AGGR_SEL, 1 << queue);
+        self.w32(csr::HBUS_TARG_WRPTR, (queue as u32) << csr::HBUS_TARG_WRPTR_Q_SHIFT_GEN1);
+        self.write_prph(csr::scd_queue_rdptr(queue), 0);
+        let context = scd_base + csr::SCD_CONTEXT_MEM + queue as u32 * 8;
+        self.write_mem32(context, 0);
+        self.write_mem32(context + 4, (FRAME_LIMIT & csr::SCD_QUEUE_CTX_WIN_SIZE) | ((FRAME_LIMIT << 16) & csr::SCD_QUEUE_CTX_FRAME_LIMIT));
+        self.write_prph(csr::scd_queue_status(queue), csr::SCD_QUEUE_STTS_ACTIVE | fifo | csr::SCD_QUEUE_STTS_WSL | csr::SCD_QUEUE_STTS_MASK);
+        self.write_prph(csr::SCD_EN_CTRL, 1 << queue);
+    }
+
+    /// A command on queue 0 (Linux's `iwl_pcie_enqueue_hcmd`): the wide
+    /// header and the payload in the slot of its index, the first 20
+    /// bytes a piece, the rest after.
+    pub(super) fn send_command_gen1(&mut self, group: u8, command: u8, version: u8, payload: &[u8]) -> Option<u16> {
+        const HEADER: usize = 8;
+        let total = HEADER + payload.len();
+        let ring = self.gen1.as_ref()?.rings.get(COMMAND_QUEUE)?;
+        let queue = self.commands.as_mut()?;
+        if total > queue.slot {
+            return None;
+        }
+        let index = queue.write % RING;
+        let at = (queue.write % queue.size) * queue.slot;
+        let sequence = ((COMMAND_QUEUE as u16) << 8) | index as u16;
+        let mut bytes = Vec::with_capacity(total);
+        bytes.extend_from_slice(&[command, group]);
+        bytes.extend_from_slice(&sequence.to_le_bytes());
+        bytes.extend_from_slice(&(payload.len() as u16).to_le_bytes());
+        bytes.extend_from_slice(&[0, version]);
+        bytes.extend_from_slice(payload);
+        queue.buffers.write_bytes(at, &bytes).ok()?;
+        let address = (queue.buffers.daddr() + at) as u64;
+        let mut pieces = alloc::vec![(address, total.min(FIRST_PIECE))];
+        split(&mut pieces, address + FIRST_PIECE as u64, total.saturating_sub(FIRST_PIECE));
+        if pieces.len() > TFD_PIECES {
+            return None;
+        }
+        ring.write_bytes(index * TFD, &descriptor(&pieces)).ok()?;
+        queue.write = (queue.write + 1) % queue.wrap;
+        let pointer = queue.write as u32 | ((COMMAND_QUEUE as u32) << csr::HBUS_TARG_WRPTR_Q_SHIFT_GEN1);
+        self.w32(csr::HBUS_TARG_WRPTR, pointer);
+        Some(sequence)
+    }
+
+    /// A frame on a queue (Linux's `iwl_trans_pcie_tx`): the first 20
+    /// bytes of the TX command a piece, the rest of it with the 802.11
+    /// header another, the body after; the scheduler's byte count for its
+    /// index, with the station.
+    pub(super) fn send_frame_gen1(&mut self, queue: &mut TxQueue, bytes: &[u8], body_at: usize, frame_len: usize) -> Result<(), ()> {
+        let gen1 = self.gen1.as_ref().ok_or(())?;
+        let ring = gen1.rings.get(queue.id as usize).ok_or(())?;
+        if bytes.len() <= TX_CMD_DRAM_MSB {
+            return Err(());
+        }
+        let index = queue.write % RING;
+        let at = index * TX_BUFFER;
+        queue.buffers.write_bytes(at, bytes).map_err(|_| ())?;
+        let address = queue.buffers.daddr() as u64 + at as u64;
+        // Where the chip writes back the TX command's scratch: in the
+        // first piece.
+        let scratch = address + TX_CMD_SCRATCH as u64;
+        queue.buffers.write_val(at + TX_CMD_DRAM_LSB, &(scratch as u32)).map_err(|_| ())?;
+        queue.buffers.write_val(at + TX_CMD_DRAM_MSB, &((scratch >> 32) as u8)).map_err(|_| ())?;
+        let mut pieces = alloc::vec![(address, FIRST_PIECE)];
+        split(&mut pieces, address + FIRST_PIECE as u64, body_at - FIRST_PIECE);
+        split(&mut pieces, address + body_at as u64, bytes.len() - body_at);
+        if pieces.len() > TFD_PIECES {
+            return Err(());
+        }
+        ring.write_bytes(index * TFD, &descriptor(&pieces)).map_err(|_| ())?;
+        let mut length = frame_len + CRC_AND_DELIMITER;
+        if bytes[TX_CMD_SEC_CTL] & TX_CMD_SEC_MASK == TX_CMD_SEC_CCM {
+            length += CCMP_MIC;
+        }
+        let entry = (length.div_ceil(4) as u16 & 0x0fff) | ((bytes[TX_CMD_STA_ID] as u16) << 12);
+        let table = queue.id as usize * COUNTS;
+        gen1.counts.write_val((table + index) * 2, &entry).map_err(|_| ())?;
+        if index < COUNTS_DUP {
+            gen1.counts.write_val((table + RING + index) * 2, &entry).map_err(|_| ())?;
+        }
+        queue.write = (queue.write + 1) % RING;
+        let pointer = queue.write as u32 | ((queue.id as u32) << csr::HBUS_TARG_WRPTR_Q_SHIFT_GEN1);
+        self.w32(csr::HBUS_TARG_WRPTR, pointer);
+        Ok(())
+    }
+
+    /// The runtime program's pages (Linux's `iwl_save_fw_paging`): the
+    /// signature in a 4 KiB block, the code in 32 KiB blocks, kept while
+    /// the firmware runs. None: the program has none.
+    pub(crate) fn load_paging(&mut self, firmware: &Firmware, file: &[u8]) -> Result<Option<Paging>, Error> {
+        if firmware.paging_size == 0 {
+            return Ok(None);
+        }
+        let gen1 = self.gen1.as_mut().ok_or(Error::Memory)?;
+        let pages = firmware.paging_size as usize / PAGING_PAGE;
+        let blocks = pages.div_ceil(PAGES_PER_BLOCK);
+        if pages == 0 || blocks > MAX_PAGING_BLOCKS {
+            return Err(Error::Firmware);
+        }
+        let pages_in_last = pages - PAGES_PER_BLOCK * (blocks - 1);
+        let (signature, code) = firmware.paging_sections().ok_or(Error::Firmware)?;
+        let signature = file.get(signature.data.clone()).ok_or(Error::Firmware)?;
+        let code = file.get(code.data.clone()).ok_or(Error::Firmware)?;
+        if signature.len() > PAGING_PAGE || code.len() != pages * PAGING_PAGE {
+            return Err(Error::Firmware);
+        }
+        let mut memory = Vec::with_capacity(blocks + 1);
+        let first = dma(PAGING_PAGE)?;
+        first.write_bytes(0, signature).map_err(|_| Error::Memory)?;
+        memory.push(first);
+        for piece in code.chunks(PAGES_PER_BLOCK * PAGING_PAGE) {
+            let block = dma(PAGES_PER_BLOCK * PAGING_PAGE)?;
+            block.write_bytes(0, piece).map_err(|_| Error::Memory)?;
+            memory.push(block);
+        }
+        let addresses = memory.iter().map(|block| (block.daddr() >> 12) as u32).collect();
+        gen1.paging = memory;
+        Ok(Some(Paging { pages_in_last: pages_in_last as u32, blocks: blocks as u32, addresses }))
+    }
+
+    /// Stops the transmit and receive DMA and the chip's bus master
+    /// before the memory they use goes (Linux's `iwl_pcie_tx_stop_fh`,
+    /// `iwl_pcie_rx_mq_hw_stop`, `iwl_pcie_apm_stop_master`).
+    pub(super) fn stop_dma_gen1(&mut self) {
+        if self.gen1.is_some() && self.grab() {
+            self.write_prph(csr::SCD_TXFACT, 0);
+            let mut idle = 0;
+            for channel in 0..csr::FH_TCSR_CHANNELS {
+                self.w32(Self::tcsr(csr::FH_TCSR_CHNL_TX_CONFIG, channel), 0);
+                idle |= (1 << channel) << 16;
+            }
+            if !self.poll(csr::FH_TSSR_TX_STATUS, idle, idle, 5) {
+                ostd::warn!("{}: the transmit DMA did not stop", self.name);
+            }
+            if self.legacy_rx() {
+                self.w32(csr::FH_MEM_RCSR_CHNL0_CONFIG, 0);
+                if !self.poll(csr::FH_MEM_RSSR_RX_STATUS, csr::FH_RSSR_CHNL0_RX_IDLE, csr::FH_RSSR_CHNL0_RX_IDLE, 2) {
+                    ostd::warn!("{}: the receive DMA did not stop", self.name);
+                }
+            } else {
+                self.write_prph(csr::RFH_RXF_DMA_CFG, 0);
+                let deadline = crate::now_ms() + 2;
+                while self.read_prph(csr::RFH_GEN_STATUS) & csr::RFH_RXF_DMA_IDLE == 0 && crate::now_ms() < deadline {
+                    core::hint::spin_loop();
+                }
+            }
+            self.release();
+        }
+        self.set_bits(csr::RESET, csr::RESET_STOP_MASTER);
+        if !self.poll(csr::RESET, csr::RESET_MASTER_DISABLED, csr::RESET_MASTER_DISABLED, 1) {
+            ostd::warn!("{}: the chip's bus master did not stop", self.name);
+        }
+    }
+}
