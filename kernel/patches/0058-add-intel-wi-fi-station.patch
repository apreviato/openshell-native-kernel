+        buffer.release(3 + REORDER_TIMEOUT_MS, &mut out);
+        assert_eq!(seqs(&out), [10, 11, 12, 13, 15]);
+        // A frame beyond the window moves it, and the sequence wraps.
+        let mut wrap = ReorderBuffer::new(4094, 4);
+        let mut out = Vec::new();
