+        wrap.push(3, vec![3], info(false), 0, &mut out);
+        assert_eq!(seqs(&out), [1]);
+        wrap.push(0, vec![0], info(true), 0, &mut out);
+        wrap.push(0, vec![2], info(false), 0, &mut out);
+        assert_eq!(seqs(&out), [1, 0, 2]);
