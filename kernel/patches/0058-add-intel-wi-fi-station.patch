+// SPDX-License-Identifier: MPL-2.0
+
+//! A simulated device that joins the simulated radio's own network when
+//! it runs as an access point (a hotspot): it asks for the network by
+//! name, authenticates and associates through the frames hostapd answers,
+//! runs WPA2's handshake from the station's side, asks the hotspot's DHCP
+//! server for an address and sends a datagram through the shared
+//! connection, logging each step for a test to read.
+
+use alloc::vec::Vec;
+
+use super::{
+    KEY_INFO_ACK, KEY_INFO_INSTALL, KEY_INFO_MIC, KEY_INFO_PAIRWISE, KEY_INFO_SECURE, KEY_INFO_VERSION_AES, RSN, crypto,
+    net::{self, checksum},
+};
+use crate::ieee80211::{self as wifi, Address};
+
+/// The device's own address.
+pub(super) const CLIENT: Address = [0x02, 0x00, 0x00, 0x00, 0x03, 0x00];
+/// The passphrase it knows (the test's hostapd uses it).
+const PASSPHRASE: &[u8] = b"openshell-sim";
+/// Where the datagram goes through the shared connection: QEMU's user
+/// network host, where the test answers it.
+const ECHO_ADDRESS: [u8; 4] = [10, 0, 2, 2];
+const ECHO_PORT: u16 = 5577;
+const ECHO_TEXT: &[u8] = b"openshell hotspot";
+const OWN_PORT: u16 = 40_123;
+/// How long a step waits before it is tried again.
+const RETRY_MS: u64 = 1_000;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) enum Step {
+    Idle,
+    Probing,
+    Authenticating,
+    Associating,
+    /// Associated; the handshake (if the network has one) runs.
+    Handshake,
+    Leasing,
+    Requesting { offered: [u8; 4], server: [u8; 4] },
+    Echoing,
+    Done,
+}
+
+pub(super) struct Client {
+    pub step: Step,
+    pub ssid: Vec<u8>,
+    pub bssid: Address,
+    pub privacy: bool,
+    pub freq: u16,
+    pub next: u64,
+    snonce: [u8; 32],
+    ptk: Option<[u8; 48]>,
+    pub keys: bool,
+    xid: u32,
+    address: [u8; 4],
+    router: [u8; 4],
+}
+
+/// What the client sends next: a management frame or an Ethernet frame,
+/// both from its side of the air.
+pub(super) enum Out {
+    Management(Vec<u8>),
+    Data(Vec<u8>),
+}
+
+impl Client {
+    pub(super) fn new() -> Self {
+        Self {
+            step: Step::Idle,
+            ssid: Vec::new(),
+            bssid: [0; 6],
+            privacy: false,
+            freq: 0,
+            next: 0,
+            snonce: [0; 32],
+            ptk: None,
+            keys: false,
+            xid: 0x0510_2026,
+            address: [0; 4],
+            router: [0; 4],
+        }
+    }
+
+    /// The access point started: the device looks for it.
+    pub(super) fn start(&mut self, ssid: &[u8], bssid: Address, privacy: bool, freq: u16, now: u64) {
+        *self = Self::new();
+        self.ssid = ssid.to_vec();
+        self.bssid = bssid;
+        self.privacy = privacy;
+        self.freq = freq;
+        self.step = Step::Probing;
+        self.next = now + 300;
+    }
+
+    pub(super) fn stop(&mut self) {
+        *self = Self::new();
+    }
+
+    fn header(&self, kind: u8) -> Vec<u8> {
+        let mut frame = Vec::with_capacity(128);
+        frame.extend_from_slice(&[kind, 0, 0, 0]);
+        frame.extend_from_slice(&self.bssid);
+        frame.extend_from_slice(&CLIENT);
+        frame.extend_from_slice(&self.bssid);
+        frame.extend_from_slice(&[0, 0]);
+        frame
+    }
+
+    fn probe(&self) -> Vec<u8> {
+        let mut frame = Vec::with_capacity(64);
+        frame.extend_from_slice(&[wifi::PROBE_REQUEST, 0, 0, 0]);
+        frame.extend_from_slice(&wifi::BROADCAST);
+        frame.extend_from_slice(&CLIENT);
+        frame.extend_from_slice(&wifi::BROADCAST);
+        frame.extend_from_slice(&[0, 0]);
+        wifi::put_element(&mut frame, wifi::IE_SSID, &self.ssid);
+        wifi::put_rates(&mut frame, crate::radio::BandId::of(self.freq).rates());
+        frame
+    }
+
+    fn auth(&self) -> Vec<u8> {
+        let mut frame = self.header(wifi::AUTH);
+        frame.extend_from_slice(&[0, 0, 1, 0, 0, 0]);
+        frame
+    }
+
+    fn assoc(&self) -> Vec<u8> {
+        let mut frame = self.header(wifi::ASSOC_REQUEST);
+        let capability = wifi::CAP_ESS | wifi::CAP_SHORT_SLOT | if self.privacy { wifi::CAP_PRIVACY } else { 0 };
+        frame.extend_from_slice(&capability.to_le_bytes());
+        frame.extend_from_slice(&10u16.to_le_bytes());
+        wifi::put_element(&mut frame, wifi::IE_SSID, &self.ssid);
+        wifi::put_rates(&mut frame, crate::radio::BandId::of(self.freq).rates());
+        if self.privacy {
+            frame.extend_from_slice(&RSN);
+        }
+        // WMM's information element: version 1, no power save.
+        wifi::put_element(&mut frame, wifi::IE_VENDOR, &[0x00, 0x50, 0xf2, 0x02, 0x00, 0x01, 0x00]);
+        frame
+    }
+
+    /// A FullMAC firmware took the device into its network without frames
+    /// over the air: its association request's elements, for the daemon;
+    /// the handshake (or the lease) follows.
+    pub(super) fn joined_by_firmware(&mut self, now: u64) -> Vec<u8> {
+        let request = self.assoc();
+        ostd::notice!("sim client: associated through the firmware");
+        if self.privacy {
+            self.step = Step::Handshake;
+            self.next = u64::MAX;
+        } else {
+            self.step = Step::Leasing;
+            self.next = now + 100;
+        }
+        wifi::assoc_request_elements(&request).to_vec()
+    }
+
+    /// What the device does when its step's time comes.
+    pub(super) fn tick(&mut self, now: u64) -> Option<Out> {
+        if self.step == Step::Idle || self.step == Step::Done || now < self.next {
+            return None;
+        }
+        self.next = now + RETRY_MS;
+        match &self.step {
+            Step::Probing => {
+                ostd::notice!("sim client: looking for \"{}\"", crate::Printable(&self.ssid));
+                Some(Out::Management(self.probe()))
+            }
+            Step::Authenticating => Some(Out::Management(self.auth())),
+            Step::Associating => Some(Out::Management(self.assoc())),
+            Step::Handshake => None,
+            Step::Leasing => Some(Out::Data(self.dhcp(1, None))),
+            Step::Requesting { offered, server } => {
+                let (offered, server) = (*offered, *server);
+                Some(Out::Data(self.dhcp(3, Some((offered, server)))))
+            }
+            Step::Echoing => Some(Out::Data(self.echo())),
+            _ => None,
+        }
+    }
+
+    /// A management frame the access point sent to this device.
+    pub(super) fn management(&mut self, frame: &[u8], now: u64) -> Option<Out> {
+        match wifi::kind(frame)? {
+            wifi::PROBE_RESPONSE if self.step == Step::Probing => {
+                let beacon = wifi::parse_beacon(frame)?;
+                if wifi::Elements(beacon.elements).get(wifi::IE_SSID) != Some(&self.ssid[..]) {
+                    return None;
+                }
+                ostd::notice!("sim client: heard the hotspot");
+                self.step = Step::Authenticating;
+                self.next = now + RETRY_MS;
+                Some(Out::Management(self.auth()))
+            }
+            wifi::AUTH if self.step == Step::Authenticating => {
+                let (_, transaction, status) = wifi::parse_auth(frame)?;
+                if transaction != 2 || status != 0 {
+                    ostd::notice!("sim client: authentication refused ({})", status);
+                    return None;
+                }
+                self.step = Step::Associating;
+                self.next = now + RETRY_MS;
+                Some(Out::Management(self.assoc()))
+            }
+            wifi::ASSOC_RESPONSE if self.step == Step::Associating => {
+                let (_, status, aid, _) = wifi::parse_assoc_response(frame)?;
+                if status != 0 {
+                    ostd::notice!("sim client: association refused ({})", status);
+                    return None;
+                }
+                ostd::notice!("sim client: associated (AID {})", aid);
+                if self.privacy {
+                    self.step = Step::Handshake;
+                    self.next = u64::MAX;
+                    None
+                } else {
+                    self.step = Step::Leasing;
+                    self.next = now + 100;
+                    None
+                }
+            }
+            wifi::DEAUTH | wifi::DISASSOC => {
+                ostd::notice!("sim client: the hotspot ended the link ({})", wifi::parse_deauth(frame).unwrap_or(0));
+                self.step = Step::Probing;
+                self.next = now + RETRY_MS;
+                None
+            }
+            _ => None,
+        }
+    }
+
+    /// An Ethernet frame the access point sent to this device (or to all).
+    pub(super) fn ethernet(&mut self, ethernet: &[u8], now: u64) -> Option<Out> {
+        let destination = ethernet.get(0..6)?;
+        if destination != CLIENT && destination != wifi::BROADCAST {
+            return None;
+        }
+        match u16::from_be_bytes([*ethernet.get(12)?, *ethernet.get(13)?]) {
+            wifi::ETHERTYPE_EAPOL => self.eapol(&ethernet[14..], now),
+            0x0806 => self.arp(&ethernet[14..]),
+            0x0800 => self.ipv4(&ethernet[14..], now),
+            _ => None,
+        }
+    }
+
+    fn eapol(&mut self, eapol: &[u8], now: u64) -> Option<Out> {
+        if self.step != Step::Handshake || eapol.len() < 99 || eapol[1] != 3 {
+            return None;
+        }
+        let info = u16::from_be_bytes([eapol[5], eapol[6]]);
+        let replay: [u8; 8] = eapol[9..17].try_into().ok()?;
+        let anonce: [u8; 32] = eapol[17..49].try_into().ok()?;
+        if info & KEY_INFO_ACK == 0 || info & KEY_INFO_PAIRWISE == 0 {
+            return None;
+        }
+        if info & KEY_INFO_MIC == 0 {
+            // Message 1: the device's nonce, the keys, message 2.
+            self.snonce = super::Sim::nonce(0x77);
+            let pmk = crypto::passphrase_key(PASSPHRASE, &self.ssid);
+            let mut data = Vec::with_capacity(76);
+            let (low, high) = if self.bssid < CLIENT { (self.bssid, CLIENT) } else { (CLIENT, self.bssid) };
+            data.extend_from_slice(&low);
+            data.extend_from_slice(&high);
+            let (low, high) = if anonce < self.snonce { (anonce, self.snonce) } else { (self.snonce, anonce) };
+            data.extend_from_slice(&low);
+            data.extend_from_slice(&high);
+            let ptk: [u8; 48] = crypto::prf(&pmk, b"Pairwise key expansion", &data);
+            self.ptk = Some(ptk);
+            let mut message = key_frame(KEY_INFO_VERSION_AES | KEY_INFO_PAIRWISE | KEY_INFO_MIC, &replay, &self.snonce, &RSN);
+            sign(&mut message, &ptk[..16]);
+            return Some(Out::Data(self.eapol_frame(&message)));
+        }
+        // Message 3: checked, then message 4, and the keys are in place.
+        let ptk = self.ptk?;
+        if info & KEY_INFO_INSTALL == 0 || !mic_valid(eapol, &ptk[..16]) {
+            ostd::notice!("sim client: the hotspot's third message is not right");
+            return None;
+        }
+        let mut message = key_frame(KEY_INFO_VERSION_AES | KEY_INFO_PAIRWISE | KEY_INFO_MIC | KEY_INFO_SECURE, &replay, &[0; 32], &[]);
+        sign(&mut message, &ptk[..16]);
+        ostd::notice!("sim client: the handshake is done");
+        self.keys = true;
+        self.step = Step::Leasing;
+        self.next = now + 100;
+        Some(Out::Data(self.eapol_frame(&message)))
+    }
+
+    fn eapol_frame(&self, eapol: &[u8]) -> Vec<u8> {
+        net::ethernet(&self.bssid, &CLIENT, wifi::ETHERTYPE_EAPOL, eapol)
+    }
+
+    /// Answers the hotspot's question for this device's address.
+    fn arp(&self, packet: &[u8]) -> Option<Out> {
+        let packet = packet.get(..28)?;
+        if packet[..8] != [0, 1, 8, 0, 6, 4, 0, 1] || packet[24..28] != self.address || self.address == [0; 4] {
+            return None;
+        }
+        let mut reply = Vec::with_capacity(28);
+        reply.extend_from_slice(&[0, 1, 8, 0, 6, 4, 0, 2]);
+        reply.extend_from_slice(&CLIENT);
+        reply.extend_from_slice(&self.address);
+        reply.extend_from_slice(&packet[8..18]);
+        Some(Out::Data(net::ethernet(&packet[8..14], &CLIENT, 0x0806, &reply)))
+    }
+
+    fn ipv4(&mut self, packet: &[u8], now: u64) -> Option<Out> {
+        let header = usize::from(packet.first()? & 0x0f) * 4;
+        let total = usize::from(u16::from_be_bytes([*packet.get(2)?, *packet.get(3)?]));
+        if packet.get(9) != Some(&17) {
+            return None;
+        }
+        let from: [u8; 4] = packet.get(12..16)?.try_into().ok()?;
+        let body = packet.get(header..total)?;
+        let (from_port, to_port) = (u16::from_be_bytes([*body.first()?, *body.get(1)?]), u16::from_be_bytes([*body.get(2)?, *body.get(3)?]));
+        let payload = body.get(8..)?;
+        if (from_port, to_port) == (67, 68) {
+            return self.dhcp_answer(payload, now);
+        }
+        if self.step == Step::Echoing && from == ECHO_ADDRESS && from_port == ECHO_PORT && to_port == OWN_PORT && payload == ECHO_TEXT {
+            ostd::notice!("sim client: the echo came back through the shared connection");
+            self.step = Step::Done;
+        }
+        None
+    }
+
+    fn dhcp(&self, kind: u8, request: Option<([u8; 4], [u8; 4])>) -> Vec<u8> {
+        let mut message = alloc::vec![0u8; 240];
+        message[0] = 1;
+        message[1] = 1;
+        message[2] = 6;
+        message[4..8].copy_from_slice(&self.xid.to_be_bytes());
+        // Answers to the broadcast address: this device has none yet.
+        message[10] = 0x80;
+        message[28..34].copy_from_slice(&CLIENT);
+        message[236..240].copy_from_slice(&[99, 130, 83, 99]);
+        message.extend_from_slice(&[53, 1, kind]);
+        if let Some((offered, server)) = request {
+            message.extend_from_slice(&[50, 4]);
+            message.extend_from_slice(&offered);
+            message.extend_from_slice(&[54, 4]);
+            message.extend_from_slice(&server);
+        }
+        message.extend_from_slice(&[55, 3, 1, 3, 6, 255]);
+        let datagram = udp([0; 4], [255; 4], 68, 67, &message);
+        net::ethernet(&wifi::BROADCAST, &CLIENT, 0x0800, &net::ipv4(17, [0; 4], [255; 4], &datagram))
+    }
+
+    fn dhcp_answer(&mut self, reply: &[u8], now: u64) -> Option<Out> {
+        if reply.len() < 240 || reply[0] != 2 || reply[4..8] != self.xid.to_be_bytes() {
+            return None;
+        }
+        let offered: [u8; 4] = reply[16..20].try_into().ok()?;
+        let (mut kind, mut server, mut router) = (0, [0u8; 4], [0u8; 4]);
+        let mut options = &reply[240..];
+        while let [code, rest @ ..] = options {
+            match *code {
+                0 => options = rest,
+                255 => break,
+                _ => {
+                    let length = usize::from(*rest.first()?);
+                    let value = rest.get(1..1 + length)?;
+                    match *code {
+                        53 => kind = value.first().copied().unwrap_or(0),
+                        54 if length == 4 => server.copy_from_slice(value),
+                        3 if length >= 4 => router.copy_from_slice(&value[..4]),
+                        _ => {}
+                    }
+                    options = &rest[1 + length..];
+                }
+            }
+        }
+        match (&self.step, kind) {
+            (Step::Leasing, 2) => {
+                self.step = Step::Requesting { offered, server };
+                self.next = now + RETRY_MS;
+                Some(Out::Data(self.dhcp(3, Some((offered, server)))))
+            }
+            (Step::Requesting { .. }, 5) => {
+                self.address = offered;
+                self.router = router;
+                ostd::notice!(
+                    "sim client: leased {}.{}.{}.{} via {}.{}.{}.{}",
+                    offered[0],
+                    offered[1],
+                    offered[2],
+                    offered[3],
+                    router[0],
+                    router[1],
+                    router[2],
+                    router[3]
+                );
+                self.step = Step::Echoing;
+                self.next = now + RETRY_MS;
+                Some(Out::Data(self.echo()))
+            }
+            _ => None,
+        }
+    }
+
+    /// The datagram that crosses the shared connection, sent to the
+    /// hotspot's own address (its router), which passes it on.
+    fn echo(&self) -> Vec<u8> {
+        let datagram = udp(self.address, ECHO_ADDRESS, OWN_PORT, ECHO_PORT, ECHO_TEXT);
+        net::ethernet(&self.bssid, &CLIENT, 0x0800, &net::ipv4(17, self.address, ECHO_ADDRESS, &datagram))
+    }
+}
+
+/// A UDP datagram with its checksum.
+fn udp(source: [u8; 4], destination: [u8; 4], from: u16, to: u16, payload: &[u8]) -> Vec<u8> {
+    let length = (8 + payload.len()) as u16;
+    let mut datagram = Vec::with_capacity(length as usize);
+    datagram.extend_from_slice(&from.to_be_bytes());
+    datagram.extend_from_slice(&to.to_be_bytes());
+    datagram.extend_from_slice(&length.to_be_bytes());
+    datagram.extend_from_slice(&[0, 0]);
+    datagram.extend_from_slice(payload);
+    let mut summed = Vec::with_capacity(12 + datagram.len());
+    summed.extend_from_slice(&source);
+    summed.extend_from_slice(&destination);
+    summed.extend_from_slice(&[0, 17]);
+    summed.extend_from_slice(&length.to_be_bytes());
+    summed.extend_from_slice(&datagram);
+    let sum = match checksum(&summed) {
+        0 => 0xffff,
+        sum => sum,
+    };
+    datagram[6..8].copy_from_slice(&sum.to_be_bytes());
+    datagram
+}
+
+/// An EAPOL-Key frame of the station's side: version 1, RSN descriptor.
+fn key_frame(info: u16, replay: &[u8; 8], nonce: &[u8; 32], key_data: &[u8]) -> Vec<u8> {
+    let mut frame = Vec::with_capacity(99 + key_data.len());
+    frame.extend_from_slice(&[1, 3]);
+    frame.extend_from_slice(&((95 + key_data.len()) as u16).to_be_bytes());
+    frame.push(2);
+    frame.extend_from_slice(&info.to_be_bytes());
+    frame.extend_from_slice(&0u16.to_be_bytes());
+    frame.extend_from_slice(replay);
+    frame.extend_from_slice(nonce);
+    frame.extend_from_slice(&[0u8; 16 + 8 + 8 + 16]);
+    frame.extend_from_slice(&(key_data.len() as u16).to_be_bytes());
+    frame.extend_from_slice(key_data);
+    frame
+}
+
+fn sign(eapol: &mut [u8], kck: &[u8]) {
+    let mic = crypto::hmac_sha1(kck, &[eapol]);
+    eapol[81..97].copy_from_slice(&mic[..16]);
+}
+
+fn mic_valid(eapol: &[u8], kck: &[u8]) -> bool {
+    let Some(mic) = eapol.get(81..97) else { return false };
+    let mut zeroed = eapol.to_vec();
+    zeroed[81..97].fill(0);
+    crypto::hmac_sha1(kck, &[&zeroed])[..16] == *mic
+}
