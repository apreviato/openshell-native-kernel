+/// The driver's rate control: a ladder of the network's rates, slowest
+/// first, and where on it the first try goes.
+#[derive(Default)]
+pub(super) struct Rates {
+    ladder: Vec<u32>,
+    /// MIMO rates (two streams) on the ladder.
+    mimo: Vec<bool>,
+    top: usize,
+    /// The rate every table ends with: the band's lowest.
+    floor: u32,
+    sent: u32,
+    first_try: u32,
+    /// The table changed since the firmware last had it.
+    pub(super) dirty: bool,
+}
+
+fn legacy(plcp: u32, antenna: u32) -> u32 {
+    let cck = matches!(plcp, PLCP_1M | PLCP_2M | PLCP_5M | PLCP_11M);
+    plcp | if cck { RATE_CCK } else { 0 } | (antenna << RATE_ANT_POS)
+}
+
+impl Rates {
+    /// The ladder for a network: its band's legacy rates, or HT MCS 0-7
+    /// on one antenna and, with two antennas on both sides, the faster
+    /// two-stream ones.
+    fn for_network(network: &Network, ht: bool, tx_ant: u8) -> Self {
+        let single = (tx_ant & tx_ant.wrapping_neg()) as u32;
+        let both = (tx_ant & 0x3) as u32;
+        let ghz2 = BandId::of(network.freq) == BandId::Ghz2;
+        let floor = legacy(if ghz2 { PLCP_1M } else { PLCP_6M }, single);
+        let mut rates = Rates { floor, ..Rates::default() };
+        // The link's width (to 80 MHz) and its short guard interval.
+        let (width, sgi_wide) = match network.peer.width {
+            Width::W40 => (1, network.peer.ht.is_some_and(|cap| cap.info & chan::HT_CAP_SGI_40 != 0)),
+            Width::W80 | Width::W160 | Width::W320 => {
+                (2, network.peer.vht.is_some_and(|cap| cap.info & chan::VHT_CAP_SGI_80 != 0))
+            }
+            _ => (0, network.ht_short_gi),
+        };
+        if ht && !ghz2 && let Some(vht) = network.peer.vht.filter(|_| network.ht_mcs.is_some()) {
+            // VHT: one stream's MCS 0 to its highest, then two streams' MCS
+            // 5 and up (faster than one stream's fastest), where both ends
+            // have two. MCS 9 is not at 20 MHz.
+            let sgi = if sgi_wide { RATE_SGI } else { 0 };
+            let map = u16::from_le_bytes([vht.mcs[0], vht.mcs[1]]);
+            let top_of = |stream: u32| -> Option<u32> {
+                match (map >> (2 * stream)) & 3 {
+                    3 => None,
+                    code => Some((7 + code as u32).min(if width == 0 { 8 } else { 9 })),
+                }
+            };
+            let base = RATE_VHT | sgi | (width << RATE_WIDTH_POS);
+            if let Some(top) = top_of(0) {
+                for mcs in 0..=top {
+                    rates.ladder.push(base | mcs | (single << RATE_ANT_POS));
+                    rates.mimo.push(false);
+                }
+            }
+            if both == 0x3 && network.peer.nss >= 2 && let Some(top) = top_of(1) {
+                for mcs in 5..=top {
+                    rates.ladder.push(base | mcs | (1 << RATE_VHT_NSS_POS) | (both << RATE_ANT_POS));
+                    rates.mimo.push(true);
+                }
+            }
+            if !rates.ladder.is_empty() {
+                rates.top = rates.ladder.len().min(5).saturating_sub(1);
+                rates.dirty = true;
+                return rates;
+            }
+        }
+        match network.ht_mcs {
+            Some(mcs) if ht => {
+                let sgi = (if sgi_wide { RATE_SGI } else { 0 }) | (width.min(1) << RATE_WIDTH_POS);
+                for index in 0..8u32 {
+                    if mcs[0] & (1 << index) != 0 {
+                        rates.ladder.push(RATE_HT | sgi | index | (single << RATE_ANT_POS));
+                        rates.mimo.push(false);
+                    }
+                }
+                // The two-stream rates faster than one stream's fastest.
+                if both == 0x3 {
+                    for index in 12..16u32 {
+                        if mcs[1] & (1 << (index - 8)) != 0 {
+                            rates.ladder.push(RATE_HT | sgi | index | (both << RATE_ANT_POS));
+                            rates.mimo.push(true);
+                        }
+                    }
+                }
+                rates.top = rates.ladder.len().min(5).saturating_sub(1);
+            }
+            _ => {
+                let plcps: &[u32] = if ghz2 {
+                    &[PLCP_1M, PLCP_2M, PLCP_5M, PLCP_6M, PLCP_9M, PLCP_11M, PLCP_12M, PLCP_18M, PLCP_24M, PLCP_36M, PLCP_48M, PLCP_54M]
+                } else {
+                    &[PLCP_6M, PLCP_9M, PLCP_12M, PLCP_18M, PLCP_24M, PLCP_36M, PLCP_48M, PLCP_54M]
+                };
+                rates.ladder = plcps.iter().map(|&plcp| legacy(plcp, single)).collect();
+                rates.mimo = vec![false; rates.ladder.len()];
+                rates.top = rates.ladder.iter().position(|&rate| rate & 0xff == PLCP_24M).unwrap_or(0);
+            }
+        }
+        if rates.ladder.is_empty() {
+            rates.ladder.push(floor);
+            rates.mimo.push(false);
+            rates.top = 0;
+        }
+        rates.dirty = true;
+        rates
+    }
+
+    /// The 16 tries: the top rate twice, then each slower one, then the
+    /// floor; and how many lead with two streams.
+    fn table(&self) -> ([u32; LQ_ENTRIES], u8) {
+        let mut table = [self.floor; LQ_ENTRIES];
+        let mut at = 0;
+        let mut index = self.top as isize;
+        let mut first = true;
+        while index >= 0 && at < LQ_ENTRIES {
+            let tries = if first { 2 } else { 1 };
+            for _ in 0..tries {
+                if at < LQ_ENTRIES {
+                    table[at] = self.ladder[index as usize];
+                    at += 1;
+                }
+            }
+            first = false;
+            index -= 1;
+        }
+        let mut mimo = 0;
+        while mimo < LQ_ENTRIES && self.mimo_rate(table[mimo]) {
+            mimo += 1;
+        }
+        (table, mimo as u8)
+    }
+
+    fn mimo_rate(&self, rate: u32) -> bool {
+        self.ladder.iter().zip(&self.mimo).any(|(&known, &mimo)| mimo && known == rate)
+    }
+
+    /// A data frame's fate: up a rate when nearly all went at the first
+    /// try, down one when half did not.
+    fn feedback(&mut self, sent: bool, retries: u8) {
+        self.sent += 1;
+        if sent && retries == 0 {
+            self.first_try += 1;
+        }
+        if self.sent < RATE_WINDOW {
+            return;
+        }
+        let share = self.first_try * 100 / self.sent;
+        if share < RATE_DOWN_BELOW && self.top > 0 {
+            self.top -= 1;
+            self.dirty = true;
+        } else if share >= RATE_UP_FROM && self.top + 1 < self.ladder.len() {
+            self.top += 1;
+            self.dirty = true;
+        }
+        self.sent = 0;
+        self.first_try = 0;
+    }
+}
+
+impl Mvm {
+    // ---- The calibrating program. ----
+
+    /// Reads an NVM section through the firmware (`NVM_ACCESS_CMD`).
+    fn nvm_section(&mut self, section: u16) -> Result<Vec<u8>, String> {
+        let mut data = Vec::new();
+        while data.len() < NVM_SECTION_MAX {
+            let mut out = Out::default();
+            out.u8(0).u8(0).u16(section).u16(data.len() as u16).u16(NVM_CHUNK as u16);
+            let answer = self.command(0, NVM_ACCESS_CMD, &out.0)?;
+            let (length, status) = (le16(&answer, 2) as usize, le16(&answer, 6));
+            if status != 0 {
+                // Past the end of a section that fills whole chunks.
+                if status == NVM_STATUS_NOT_VALID_ADDRESS && !data.is_empty() {
+                    break;
+                }
+                return Err(format!("NVM section {section}: status {status:#x}"));
+            }
+            data.extend_from_slice(answer.get(8..8 + length).unwrap_or(&[]));
+            if length < NVM_CHUNK {
+                break;
+            }
+        }
+        Ok(data)
+    }
+
+    /// The calibrating program's run (Linux's `iwl_run_init_mvm_ucode`):
+    /// the NVM's facts, the antennas, the calibrations, their results.
+    pub(crate) fn run_init_image(&mut self, firmware: &Firmware) -> Result<(), String> {
+        if self.ac7000 {
+            // Before the 8000 family the calibrating program takes the
+            // coexistence with Bluetooth too.
+            self.bt_config()?;
+            self.read_nvm_7000();
+        } else {
+            self.read_nvm_ext();
+        }
+        if !self.band_24 && !self.band_52 {
+            self.band_24 = true;
+        }
+        if self.trans.rf_kill() {
+            // The radio's switch is off: no calibrations until it is on.
+            return Err(String::from("the radio's switch is off"));
+        }
+        self.command(0, super::TX_ANT_CONFIGURATION_CMD, &(self.tx_ant as u32).to_le_bytes())?;
+        self.phy_configuration(firmware, true)?;
+        self.notification(LONG, INIT_COMPLETE_NOTIF, CALIB_TIMEOUT_MS)?;
+        ostd::info!("{}: calibrated, {} result(s) kept", self.name, self.phy_db.len());
+        Ok(())
+    }
+
+    /// What the NVM says of the bands and the antennas (`NVM_SKU_CAP_*`,
+    /// the radio's transmit and receive antennas).
+    fn apply_sku(&mut self, tx: u8, rx: u8, sku: u32) {
+        self.band_24 = sku & NVM_SKU_24 != 0;
+        self.band_52 = sku & NVM_SKU_52 != 0;
+        self.ht = sku & NVM_SKU_11N != 0;
+        if tx & self.tx_ant != 0 {
+            self.tx_ant &= tx;
+        }
+        if rx & self.rx_ant != 0 {
+            self.rx_ant &= rx;
+        }
+        if sku & NVM_SKU_MIMO_DISABLED != 0 {
+            self.tx_ant &= self.tx_ant.wrapping_neg();
+            self.rx_ant &= self.rx_ant.wrapping_neg();
+        }
+    }
+
+    /// The 8000 and 9000 families' NVM (`IWL_NVM_EXT`): the PHY SKU
+    /// section, and the 8000 family's address override.
+    fn read_nvm_ext(&mut self) {
+        match self.nvm_section(NVM_SECTION_PHY_SKU) {
+            Ok(sku) if sku.len() >= 8 => {
+                let radio = le32(&sku, 0);
+                self.apply_sku(((radio >> 24) & 0xf) as u8, ((radio >> 28) & 0xf) as u8, le32(&sku, 4));
+            }
+            Ok(_) => ostd::info!("{}: the NVM has no PHY SKU section", self.name),
+            Err(error) => ostd::info!("{}: {}", self.name, error),
+        }
+        if self.legacy_rx {
+            // The 8000 family's address: the NVM's override when it has
+            // a valid one (the MAC's own registers otherwise, later).
+            if let Ok(section) = self.nvm_section(NVM_SECTION_MAC_OVERRIDE)
+                && let Some(bytes) = section.get(NVM_MAC_OVERRIDE_AT..NVM_MAC_OVERRIDE_AT + 6)
+            {
+                let mut address = [0u8; 6];
+                address.copy_from_slice(bytes);
+                if address != [0; 6] && address[0] & 1 == 0 && address != NVM_MAC_RESERVED {
+                    self.address = address;
+                }
+            }
+        }
+    }
+
+    /// The 7000 family's NVM (`IWL_NVM`, Linux's `iwl_parse_nvm_data`):
+    /// the software section's radio configuration and SKU, the hardware
+    /// section's address (16-bit words, little endian), and without LAR
+    /// the channels it allows (the software section's, or the 3168's
+    /// regulatory section's).
+    fn read_nvm_7000(&mut self) {
+        let read = |mvm: &mut Self, section: u16| {
+            mvm.nvm_section(section).unwrap_or_else(|error| {
+                ostd::info!("{}: {}", mvm.name, error);
+                Vec::new()
+            })
+        };
+        let hardware = read(self, NVM_SECTION_HW_7000);
+        let software = read(self, NVM_SECTION_SW);
+        if software.len() >= NVM_SW_SKU + 2 {
+            let radio = le16(&software, NVM_SW_RADIO_CFG) as u32;
+            self.apply_sku(((radio >> 8) & 0xf) as u8, ((radio >> 12) & 0xf) as u8, le16(&software, NVM_SW_SKU) as u32);
+        }
+        if let Some(bytes) = hardware.get(NVM_HW_ADDR..NVM_HW_ADDR + 6) {
+            let address = [bytes[1], bytes[0], bytes[3], bytes[2], bytes[5], bytes[4]];
+            if address != [0; 6] && address[0] & 1 == 0 {
+                self.address = address;
+            }
+        }
+        if self.lar {
+            return;
+        }
+        let (flags, at) = if self.nvm_sdp { (read(self, NVM_SECTION_REGULATORY_SDP), 0) } else { (software, NVM_SW_CHANNELS) };
+        let valid: Vec<u8> = NVM_CHANNELS
+            .iter()
+            .enumerate()
+            .filter(|(index, _)| le16(&flags, at + index * 2) & NVM_CHANNEL_VALID != 0)
+            .map(|(_, &channel)| channel)
+            .collect();
+        if !valid.is_empty() {
+            self.valid_channels = Some(valid);
+        }
+    }
+
+    /// The radio's configuration with its valid antennas and a program's
+    /// default calibrations (`PHY_CONFIGURATION_CMD` v1).
+    fn phy_configuration(&mut self, firmware: &Firmware, init: bool) -> Result<(), String> {
+        let chains = ((self.tx_ant as u32) << 16) | ((self.rx_ant as u32) << 20);
+        let config = (firmware.phy_config & (!FW_PHY_CFG_CHAINS | chains)) | self.extra_phy_config;
+        let (flow, event) = firmware.default_calib[init as usize];
+        let mut out = Out::default();
+        out.u32(config).u32(flow).u32(event);
+        self.command(0, PHY_CONFIGURATION_CMD, &out.0).map(|_| ())
+    }
+
+    /// A calibration result (`struct iwl_calib_res_notif_phy_db`): kept,
+    /// a channel group's in place of the one before for its group.
+    pub(super) fn store_phy_db(&mut self, data: &[u8]) {
+        let (kind, length) = (le16(data, 0), le16(data, 2) as usize);
+        let Some(entry) = data.get(4..4 + length) else { return };
+        let grouped = matches!(kind, PHY_DB_CALIB_CHG_PAPD | PHY_DB_CALIB_CHG_TXP);
+        let group = le16(entry, 0);
+        match self.phy_db.iter_mut().find(|(known, data)| *known == kind && (!grouped || le16(data, 0) == group)) {
+            Some(slot) => slot.1 = entry.to_vec(),
+            None => self.phy_db.push((kind, entry.to_vec())),
+        }
+    }
+
+    // ---- The runtime program. ----
+
+    /// Everything after the runtime program's ALIVE up to a radio ready
+    /// to scan (Linux's `iwl_mvm_up` for the 9000 family).
+    pub(super) fn init_gen1(&mut self, firmware: &Firmware, file: &[u8]) -> Result<(), String> {
+        match self.trans.load_paging(firmware, file) {
+            Ok(Some(paging)) => {
+                let mut out = Out::default();
+                out.u32(PAGING_SECURED | PAGING_ENABLED | paging.pages_in_last).u32(PAGING_BLOCK_EXP).u32(paging.blocks);
+                for index in 0..PAGING_BLOCKS_MAX {
+                    out.u32(paging.addresses.get(index).copied().unwrap_or(0));
+                }
+                self.command(LONG, FW_PAGING_BLOCK_CMD, &out.0)?;
+            }
+            Ok(None) => {}
+            Err(error) => return Err(format!("the firmware's pages: {error:?}")),
+        }
+        self.command(0, super::TX_ANT_CONFIGURATION_CMD, &(self.tx_ant as u32).to_le_bytes())?;
+        self.send_phy_db()?;
+        self.phy_configuration(firmware, false)?;
+        self.bt_config()?;
+        self.soc_configuration()?;
+        self.command(DATA_PATH, DQA_ENABLE_CMD, &0u32.to_le_bytes())?;
+        self.add_aux_station()?;
+        if firmware.has_capability(CAPA_CT_KILL_BY_FW) && firmware.has_capability(CAPA_TEMP_THS_REPORT_SUPPORT) {
+            // No thresholds: the firmware keeps the card from overheating.
+            if let Err(error) = self.command(PHY_OPS, TEMP_REPORTING_THRESHOLDS_CMD, &[0u8; 20]) {
+                ostd::info!("{}: temperature: {}", self.name, error);
+            }
+        }
+        self.command(0, super::POWER_TABLE_CMD, &Out::default().u16(super::DEVICE_POWER_FLAGS_POWER_SAVE_ENA).u16(0).0)?;
+        self.region();
+        self.scan_config_gen1()?;
+        // The request's layout follows the firmware's API bits; a stated
+        // version should agree.
+        let built = if self.adaptive_dwell_v2 { 8 } else if self.adaptive_dwell { 7 } else { 1 };
+        if self.scan_version != crate::fw::VERSION_UNKNOWN && self.scan_version != built {
+            ostd::warn!("{}: the firmware's scan is version {}, this driver builds {}", self.name, self.scan_version, built);
+        }
+        Ok(())
+    }
+
+    /// The calibration results back to the runtime program (Linux's
+    /// `iwl_send_phy_db_data`).
+    fn send_phy_db(&mut self) -> Result<(), String> {
+        let mut entries = core::mem::take(&mut self.phy_db);
+        entries.sort_by_key(|(kind, data)| {
+            let order = match *kind {
+                PHY_DB_CFG => 0,
+                PHY_DB_CALIB_NCH => 1,
+                PHY_DB_CALIB_CHG_PAPD => 2,
+                PHY_DB_CALIB_CHG_TXP => 3,
+                _ => 4,
+            };
+            (order, le16(data, 0))
+        });
+        let result = (|| {
+            let sent = [PHY_DB_CFG, PHY_DB_CALIB_NCH, PHY_DB_CALIB_CHG_PAPD, PHY_DB_CALIB_CHG_TXP];
+            for (kind, data) in entries.iter().filter(|(kind, _)| sent.contains(kind)) {
+                let mut out = Out::default();
+                out.u16(*kind).u16(data.len() as u16).bytes(data);
+                self.command(0, PHY_DB_CMD, &out.0)?;
+            }
+            Ok::<(), String>(())
+        })();
+        self.phy_db = entries;
+        result
+    }
+
+    /// The scanning station (Linux's `iwl_mvm_add_aux_sta`): its queue on
+    /// the multicast FIFO, then the station of the auxiliary MAC.
+    fn add_aux_station(&mut self) -> Result<(), String> {
+        let queue = self.enable_queue(AUX_QUEUE, FIFO_MCAST, AUX_STA_ID, MAX_TID)?;
+        self.aux_queue = Some(queue);
+        let mut out = Out::default();
+        out.u8(0).u8(0).u16(0xffff).u32(MAC_INDEX_AUX).zeros(6).u16(0);
+        out.u8(AUX_STA_ID).u8(0).u16(0).u32(0).u32(0);
+        out.u8(0).u8(0).u16(0).u16(0).u8(0);
+        out.u8(STA_TYPE_AUX_ACTIVITY).u16(0).u16(0).u32(1 << AUX_QUEUE).u16(0).u8(0).u8(0);
+        let command = self.station_command(out.0);
+        self.command_status(0, ADD_STA, &command, ADD_STA_SUCCESS)
+    }
+
+    /// A queue of the host's (Linux's `iwl_mvm_enable_txq`): where it
+    /// starts, then its station, TID and FIFO to the firmware.
+    pub(super) fn enable_queue(&mut self, number: u16, fifo: u8, station: u8, tid: u8) -> Result<crate::trans::TxQueue, String> {
+        let mut queue = self.trans.new_tx_queue().map_err(|error| format!("queue memory: {error:?}"))?;
+        self.trans.tx_queue_started(&mut queue, number, 0);
+        let mut out = Out::default();
+        out.u8(0).u8(station).u8(tid).u8(number as u8).u8(SCD_CFG_ENABLE_QUEUE).u8(0).u8(fifo).u8(FRAME_LIMIT as u8).u16(0).u16(0);
+        self.command(0, SCD_QUEUE_CFG, &out.0)?;
+        Ok(queue)
+    }
+
+    pub(super) fn disable_queue(&mut self, number: u16, station: u8, tid: u8) {
+        let mut out = Out::default();
+        out.u8(0).u8(station).u8(tid).u8(number as u8).u8(SCD_CFG_DISABLE_QUEUE).zeros(3).u16(0).u16(0);
+        let _ = self.command(0, SCD_QUEUE_CFG, &out.0);
+    }
+
+    /// The scan configuration (`struct iwl_scan_config_v1`): the chains,
+    /// the legacy rates, times, dwells, the address, the auxiliary
+    /// station and every channel the card may scan.
+    pub(super) fn scan_config_gen1(&mut self) -> Result<(), String> {
+        // The LMAC scan has its whole configuration in each request.
+        if self.lmac_scan {
+            return Ok(());
+        }
+        let mut numbers: Vec<u8> = Vec::new();
+        if self.band_24 {
+            numbers.extend(channels(BandId::Ghz2).iter().map(|channel| channel_number(channel.freq)));
+        }
+        if self.band_52 {
+            numbers.extend(channels(BandId::Ghz5).iter().map(|channel| channel_number(channel.freq)));
+        }
+        numbers.truncate(self.scan_channels);
+        let flags = SCAN_CONFIG_ACTIVATE
+            | SCAN_CONFIG_ALLOW_CHUB_REQS
+            | SCAN_CONFIG_SET_TX_CHAINS
+            | SCAN_CONFIG_SET_RX_CHAINS
+            | SCAN_CONFIG_SET_AUX_STA_ID
+            | SCAN_CONFIG_SET_ALL_TIMES
+            | SCAN_CONFIG_SET_LEGACY_RATES
+            | SCAN_CONFIG_SET_MAC_ADDR
+            | SCAN_CONFIG_SET_CHANNEL_FLAGS
+            | ((numbers.len() as u32) << SCAN_CONFIG_N_CHANNELS_POS)
+            | SCAN_CONFIG_CLEAR_FRAGMENTED;
+        let (max_out, suspend) = self.scan_times();
+        let mut out = Out::default();
+        out.u32(flags).u32(self.tx_ant as u32).u32(self.rx_ant as u32).u32(SCAN_CONFIG_RATES).u32(max_out).u32(suspend);
+        out.u8(SCAN_DWELL_ACTIVE).u8(SCAN_DWELL_PASSIVE).u8(SCAN_DWELL_FRAGMENTED).u8(SCAN_DWELL_EXTENDED);
+        out.bytes(&self.address).u8(AUX_STA_ID);
+        out.u8(CHANNEL_FLAG_EBS | CHANNEL_FLAG_ACCURATE_EBS | CHANNEL_FLAG_EBS_ADD | CHANNEL_FLAG_PRE_SCAN_PASSIVE2ACTIVE);
+        let mut array = numbers;
+        array.resize(self.scan_slots, 0);
+        out.bytes(&array);
+        self.command(0, SCAN_CFG_CMD, &out.0).map(|_| ())
+    }
+
+    /// Linux's timing for a scan without a link, and the wild one with.
+    fn scan_times(&self) -> (u32, u32) {
+        if self.associated { (120, 30) } else { (0, 0) }
+    }
+
+    /// `struct iwl_scan_req_umac` v8 with `iwl_scan_req_umac_tail_v1`:
+    /// the general part, the firmware's channel slots and the tail with
+    /// the schedule, the probe template and the names.
+    pub(super) fn scan_request_gen1(&self, request: &ScanRequest, freqs: &[u16]) -> Vec<u8> {
+        let ssids: Vec<&Vec<u8>> = request.ssids.iter().take(PROBE_OPTION_MAX).collect();
+        let directed = ssids.len() == 1 && !ssids[0].is_empty();
+        let mut flags = SCAN_GEN_FLAGS_PASS_ALL;
+        if ssids.is_empty() {
+            flags |= SCAN_GEN_FLAGS_PASSIVE;
+        }
+        if directed {
+            flags |= SCAN_GEN_FLAGS_PRE_CONNECT;
+        }
+        if self.adaptive_dwell {
+            flags |= SCAN_GEN_FLAGS_ADAPTIVE_DWELL;
+        }
+        let (max_out, suspend) = self.scan_times();
+        let budget = if directed { SCAN_ADWELL_BUDGET_DIRECTED } else { SCAN_ADWELL_BUDGET_FULL };
+        let mut out = Out::default();
+        out.u32(0).u32(0).u32(SCAN_PRIORITY_EXT_6).u16(flags).u8(0).u8(0);
+        if self.adaptive_dwell_v2 {
+            // v8 (9000 family): dwells per LMAC, the adaptive dwell's
+            // defaults, the times, the passive dwells and fragments.
+            out.u8(SCAN_DWELL_ACTIVE).u8(0).u8(0).u8(SCAN_ADWELL_N_APS).u8(SCAN_ADWELL_N_APS_SOCIAL).u8(SCAN_GEN_FLAGS2_ALLOW_CHNL_REORDER);
+            out.u16(budget);
+            out.u32(max_out).u32(0).u32(suspend).u32(0).u32(SCAN_PRIORITY_EXT_6);
+            out.u8(SCAN_DWELL_PASSIVE).u8(0).u8(0).u8(0);
+        } else if self.adaptive_dwell {
+            // v7 (8000 family): one dwell each, the adaptive dwell's
+            // defaults, the times.
+            out.u8(SCAN_DWELL_ACTIVE).u8(SCAN_DWELL_PASSIVE).u8(SCAN_DWELL_FRAGMENTED).u8(SCAN_ADWELL_N_APS).u8(SCAN_ADWELL_N_APS_SOCIAL).u8(0);
+            out.u16(budget);
+            out.u32(max_out).u32(0).u32(suspend).u32(0).u32(SCAN_PRIORITY_EXT_6);
+        } else {
+            // v1: the dwells and one LMAC's times.
+            out.u8(SCAN_DWELL_EXTENDED).u8(SCAN_DWELL_ACTIVE).u8(SCAN_DWELL_PASSIVE).u8(SCAN_DWELL_FRAGMENTED);
+            out.u32(max_out).u32(suspend).u32(SCAN_PRIORITY_EXT_6);
+        }
+        // The channels: no energy based scan, their count.
+        out.u8(0).u8(freqs.len() as u8).u16(0);
+        let bitmap: u32 = if ssids.is_empty() { 0 } else { (1u32 << ssids.len()) - 1 };
+        for slot in 0..self.scan_slots {
+            match freqs.get(slot) {
+                Some(&freq) => {
+                    out.u32(bitmap).u8(channel_number(freq)).u8(1).u16(0);
+                }
+                None => {
+                    out.zeros(8);
+                }
+            }
+        }
+        // One iteration, now.
+        out.u16(0).u8(1).u8(0).zeros(4).u16(0).u16(0);
+        let (template, segments) = self.probe_template(&request.elements);
+        // The header, 2.4 GHz, 5 GHz, the shared part.
+        for index in [0, 1, 2, 4] {
+            out.u16(segments[index].0).u16(segments[index].1);
+        }
+        let mut buffer = template;
+        buffer.resize(PROBE_TEMPLATE, 0);
+        out.bytes(&buffer);
+        for index in 0..PROBE_OPTION_MAX {
+            let mut entry = [0u8; 34];
+            if let Some(ssid) = ssids.get(index) {
+                let length = ssid.len().min(32);
+                entry[1] = length as u8;
+                entry[2..2 + length].copy_from_slice(&ssid[..length]);
+            }
+            out.bytes(&entry);
+        }
+        out.0
+    }
+
+    /// `struct iwl_scan_req_lmac` (Linux's `iwl_mvm_scan_lmac`), for
+    /// firmware without the UMAC scan: the dwells, the receive chains,
+    /// the flags, the times, the band of the first channel, the probes'
+    /// TX commands on the auxiliary station, the names, one iteration now;
+    /// then the firmware's channel slots and the probe template.
+    pub(super) fn scan_request_lmac(&self, request: &ScanRequest, freqs: &[u16]) -> Vec<u8> {
+        let ssids: Vec<&Vec<u8>> = request.ssids.iter().take(PROBE_OPTION_MAX).collect();
+        let mut flags = LMAC_SCAN_FLAG_PASS_ALL | LMAC_SCAN_FLAG_EXTENDED_DWELL;
+        if ssids.is_empty() {
+            flags |= LMAC_SCAN_FLAG_PASSIVE;
+        }
+        if ssids.len() == 1 && !ssids[0].is_empty() {
+            flags |= LMAC_SCAN_FLAG_PRE_CONNECTION;
+        }
+        let rx = self.rx_ant as u16;
+        let chains = (rx << PHY_RX_CHAIN_VALID_POS) | (rx << PHY_RX_CHAIN_FORCE_MIMO_SEL_POS) | (rx << PHY_RX_CHAIN_FORCE_SEL_POS) | PHY_RX_CHAIN_DRIVER_FORCE;
+        let band = freqs.first().map_or(PHY_BAND_24, |&freq| if BandId::of(freq) == BandId::Ghz2 { PHY_BAND_24 } else { PHY_BAND_5 });
+        let (max_out, suspend) = self.scan_times();
+        let antenna = ((self.tx_ant & self.tx_ant.wrapping_neg()) as u32) << RATE_ANT_POS;
+        let mut out = Out::default();
+        out.u32(0).u8(freqs.len() as u8).u8(SCAN_DWELL_ACTIVE).u8(SCAN_DWELL_PASSIVE).u8(SCAN_DWELL_FRAGMENTED).u8(SCAN_DWELL_EXTENDED).u8(0);
+        out.u16(chains).u32(flags).u32(max_out).u32(suspend).u32(band as u32).u32(MAC_FILTER_ACCEPT_GRP | MAC_FILTER_IN_BEACON);
+        // The probes: 1 Mbit/s CCK on 2.4 GHz, 6 Mbit/s on 5 GHz.
+        for rate in [PLCP_1M | RATE_CCK, PLCP_6M] {
+            out.u32(TX_FLG_SEQ_CTL | TX_FLG_BT_DIS).u32(rate | antenna).u8(AUX_STA_ID).zeros(3);
+        }
+        for index in 0..PROBE_OPTION_MAX {
+            let mut entry = [0u8; 34];
+            if let Some(ssid) = ssids.get(index) {
+                let length = ssid.len().min(32);
+                entry[1] = length as u8;
+                entry[2..2 + length].copy_from_slice(&ssid[..length]);
+            }
+            out.bytes(&entry);
+        }
+        // Priority, one iteration, no delay; the schedule; no energy based
+        // scan.
+        out.u32(SCAN_PRIORITY_EXT_6).u32(1).u32(0);
+        out.u16(0).u8(1).u8(1).zeros(4);
+        out.zeros(8);
+        // This request's names are bits 1 to 20.
+        let bitmap: u32 = if ssids.is_empty() { 0 } else { ((1u32 << ssids.len()) - 1) << 1 };
+        for slot in 0..self.scan_slots {
+            match freqs.get(slot) {
+                Some(&freq) => {
+                    out.u32(LMAC_CHANNEL_PARTIAL | bitmap).u16(channel_number(freq) as u16).u16(1).u32(0);
+                }
+                None => {
+                    out.zeros(12);
+                }
+            }
+        }
+        let (template, segments) = self.probe_template(&request.elements);
+        for index in [0, 1, 2, 4] {
+            out.u16(segments[index].0).u16(segments[index].1);
+        }
+        let mut buffer = template;
+        buffer.resize(PROBE_TEMPLATE, 0);
+        out.bytes(&buffer);
+        out.0
+    }
+
+    // ---- Joining. ----
+
+    /// The PHY context, version 1 (`struct iwl_phy_context_cmd_v1`): the
+    /// channel, its width and the primary's position, the transmit and
+    /// receive chains.
+    pub(super) fn phy_context_v1(&mut self, action: u32, freq: u16, width: u8, position: u8) -> Result<(), String> {
+        let band = if BandId::of(freq) == BandId::Ghz2 { PHY_BAND_24 } else { PHY_BAND_5 };
+        let channel = channel_number(freq);
+        let mut out = Out::default();
+        out.u32(0).u32(action).u32(0).u32(0);
+        if self.uhb {
+            out.u32(channel as u32).u8(band).u8(width).u8(position).u8(0);
+        } else {
+            out.u8(band).u8(channel).u8(width).u8(position);
+        }
+        let chains = self.rx_ant.count_ones().clamp(1, 2);
+        out.u32(self.tx_ant as u32);
+        out.u32(((self.rx_ant as u32) << PHY_RX_CHAIN_VALID_POS) | (chains << PHY_RX_CHAIN_CNT_POS) | (chains << PHY_RX_CHAIN_MIMO_CNT_POS));
+        out.u32(0).u32(0);
+        self.command(0, PHY_CONTEXT_CMD, &out.0).map(|_| ())
+    }
+
+    /// The binding, version 1: the MAC on the PHY, no LMAC.
+    pub(super) fn binding_v1(&mut self, action: u32) -> Result<(), String> {
+        let mut out = Out::default();
+        out.u32(0).u32(action).u32(0).u32(FW_CTXT_INVALID).u32(FW_CTXT_INVALID).u32(0);
+        self.command_status(0, BINDING_CONTEXT_CMD, &out.0, 0)
+    }
+
+    /// The access point's queues: management frames on VO, data on BE.
+    pub(super) fn add_queues_gen1(&mut self) -> Result<(), String> {
+        let management = self.enable_queue(MGMT_QUEUE, FIFO_VO, AP_STA_ID, MAX_TID)?;
+        self.management_queue = Some(management);
+        let data = self.enable_queue(DATA_QUEUE, FIFO_BE, AP_STA_ID, 0)?;
+        self.data_queue = Some(data);
+        self.station_queues = (1 << MGMT_QUEUE) | (1 << DATA_QUEUE);
+        Ok(())
+    }
+
+    pub(super) fn remove_queues_gen1(&mut self) {
+        if self.data_queue.take().is_some() {
+            self.disable_queue(DATA_QUEUE, AP_STA_ID, 0);
+        }
+        if self.management_queue.take().is_some() {
+            self.disable_queue(MGMT_QUEUE, AP_STA_ID, MAX_TID);
+        }
+        self.station_queues = 0;
+    }
+
+    /// The time event that keeps the card on the network's channel while
+    /// it authenticates and associates (Linux's `iwl_mvm_protect_session`),
+    /// waited for until it starts.
+    pub(super) fn time_event_add(&mut self) -> Result<(), String> {
+        let policy = TE_POLICY_NOTIFY_START | TE_POLICY_NOTIFY_END | TE_POLICY_START_IMMEDIATELY;
+        let mut out = Out::default();
+        out.u32(0).u32(FW_CTXT_ACTION_ADD).u32(TE_BSS_STA_AGGRESSIVE_ASSOC).u32(0).u32(TE_MAX_DELAY_TU).u32(0).u32(1).u32(SESSION_PROTECTION_TU);
+        out.u8(1).u8(0).u16(policy);
+        let answer = self.command(0, TIME_EVENT_CMD, &out.0)?;
+        if le32(&answer, 0) != 0 {
+            return Err(format!("time event refused (status {:#x})", le32(&answer, 0)));
+        }
+        let unique = le32(&answer, 8);
+        self.time_event = Some(unique);
+        let started = self.wait_for(TE_START_WAIT_MS, "the time event's start", |packet| {
+            packet.group <= LONG && packet.command == TIME_EVENT_NOTIFICATION && le32(&packet.data, 8) == unique && le32(&packet.data, 16) & 1 != 0
+        });
+        if let Err(error) = started {
+            ostd::info!("{}: {}", self.name, error);
+        }
+        Ok(())
+    }
+
+    pub(super) fn time_event_remove(&mut self) {
+        if let Some(unique) = self.time_event.take() {
+            let mut out = Out::default();
+            // The whole command (`struct iwl_time_event_cmd`, 36 bytes).
+            out.u32(0).u32(FW_CTXT_ACTION_REMOVE).u32(unique).zeros(24);
+            let _ = self.command(0, TIME_EVENT_CMD, &out.0);
+        }
+    }
+
+    /// The firmware's word on a time event: one that ended is gone.
+    pub(super) fn time_event_notification(&mut self, data: &[u8]) {
+        let (unique, action) = (le32(data, 8), le32(data, 16));
+        if action & 2 != 0 && self.time_event == Some(unique) {
+            self.time_event = None;
+        }
+    }
+
+    /// The rate table for the access point (`LQ_CMD`), from the rate
+    /// control's ladder.
+    pub(super) fn send_rates(&mut self) -> Result<(), String> {
+        let (table, mimo) = self.rates.table();
+        self.rates.dirty = false;
+        self.send_lq(AP_STA_ID, &table, mimo)
+    }
+
+    /// `LQ_CMD` for a station: its 16 tries, how many lead with two
+    /// streams, the aggregation limits.
+    pub(super) fn send_lq(&mut self, sta_id: u8, table: &[u32; LQ_ENTRIES], mimo: u8) -> Result<(), String> {
+        let single = self.tx_ant & self.tx_ant.wrapping_neg();
+        let mut out = Out::default();
+        out.u8(sta_id).u8(0).u16(0).u8(0).u8(mimo).u8(single).u8(self.tx_ant & 0x3);
+        out.zeros(4).u16(LQ_AGG_TIME_LIMIT).u8(LQ_AGG_DISABLE_START).u8(LQ_AGG_FRAME_LIMIT).u32(0);
+        for rate in table {
+            out.u32(*rate);
+        }
+        out.u32(0);
+        self.command(0, LQ_CMD, &out.0).map(|_| ())
+    }
+
+    /// The rate table of a client of the access point: its HT rates, or
+    /// the band's legacy ones (no adaptation of its own).
+    pub(super) fn client_rates(&self, freq: u16, ht_mcs: Option<[u8; 16]>, short_gi: bool) -> ([u32; LQ_ENTRIES], u8) {
+        let network = Network { freq, ht_mcs, ht_short_gi: short_gi, ..Network::default() };
+        Rates::for_network(&network, self.ht, self.tx_ant).table()
+    }
+
+    /// A new network's rates, from its HT capabilities.
+    pub(super) fn reset_rates(&mut self) {
+        let network = self.network.clone().unwrap_or_default();
+        self.rates = Rates::for_network(&network, self.ht, self.tx_ant);
+    }
+
+    // ---- Frames. ----
+
+    /// The band's lowest rate on the first antenna: management frames
+    /// and data before the port opens.
+    pub(super) fn lowest_rate(&self, freq: u16) -> u32 {
+        let single = (self.tx_ant & self.tx_ant.wrapping_neg()) as u32;
+        legacy(if BandId::of(freq) == BandId::Ghz2 { PLCP_1M } else { PLCP_6M }, single)
+    }
+
+    /// The TX command (v6) with its 4-byte header, then the 802.11 header
+    /// padded to four bytes, then the body (which starts with the cipher's
+    /// header when encrypted). Returns the bytes and where the body is.
+    pub(super) fn tx_command_gen1(&self, frame: &[u8], data: bool, encrypted: bool, queue: u16, index: usize) -> (Vec<u8>, usize) {
+        let hdr = header_len(frame);
+        let unicast = frame.get(4).is_some_and(|byte| byte & 1 == 0);
+        let qos = data && frame[0] & 0x80 != 0;
+        let mut flags = if unicast { TX_FLG_ACK } else { 0 };
+        if hdr % 4 != 0 {
+            flags |= TX_FLG_MH_PAD;
+        }
+        // Data at the rate control's rates once the port is open (or on
+        // a network without keys); the handshake's frames at the lowest.
+        let body = frame.get(hdr + if encrypted { CIPHER_HEADER } else { 0 }..).unwrap_or(&[]);
+        let eapol = body.starts_with(&[0xaa, 0xaa, 0x03, 0x00, 0x00, 0x00, 0x88, 0x8e]);
+        let rate_table = data && self.associated && !eapol && (self.authorized || self.pairwise.is_none());
+        let rate = if rate_table {
+            flags |= TX_FLG_STA_RATE;
+            0
+        } else {
+            self.lowest_rate(self.network.as_ref().map_or(2412, |network| network.freq))
+        };
+        let tid = if qos { frame.get(hdr.saturating_sub(2)).copied().unwrap_or(0) & 0x0f } else if data { TID_NON_QOS } else { MAX_TID };
+        let subtype = frame[0] & 0xfc;
+        let pm_timeout = if data {
+            PM_FRAME_NONE
+        } else if subtype == 0x00 || subtype == 0x20 {
+            PM_FRAME_ASSOC
+        } else if subtype == 0xd0 {
+            PM_FRAME_NONE
+        } else {
+            PM_FRAME_MGMT
+        };
+        let (sec_ctl, key) = match (&self.pairwise, encrypted) {
+            (Some(pairwise), true) if pairwise.cipher == radio::CIPHER_CCMP => {
+                let mut key = [0u8; 16];
+                let length = pairwise.key.len().min(16);
+                key[..length].copy_from_slice(&pairwise.key[..length]);
+                (TX_SEC_CCM, key)
+            }
+            (Some(pairwise), true) => {
+                let kind = if matches!(pairwise.cipher, radio::CIPHER_GCMP | radio::CIPHER_GCMP_256) { TX_SEC_GCMP } else { TX_SEC_CCM };
+                let mut key = [0u8; 16];
+                key[0] = pairwise.offset;
+                (kind | TX_SEC_KEY_FROM_TABLE, key)
+            }
+            _ => (0, [0u8; 16]),
+        };
+        Self::tx_command_v6(frame, AP_STA_ID, flags, rate, tid, pm_timeout, sec_ctl, &key, queue, index)
+    }
+
+    /// The TX command (v6) for station `sta_id`, its 4-byte header, the
+    /// 802.11 header padded to four bytes, the body (`sec_ctl` non-zero:
+    /// it starts with the cipher's header).
+    #[allow(clippy::too_many_arguments)]
+    pub(super) fn tx_command_v6(frame: &[u8], sta_id: u8, flags: u32, rate: u32, tid: u8, pm_timeout: u16, sec_ctl: u8, key: &[u8; 16], queue: u16, index: usize) -> (Vec<u8>, usize) {
+        let hdr = header_len(frame);
+        let iv = if sec_ctl != 0 { CIPHER_HEADER } else { 0 };
+        let offload = (((hdr + iv) as u32 / 2) << TX_OFFLD_MH_SIZE) | if hdr % 4 != 0 { 1 << TX_OFFLD_PAD } else { 0 };
+        let mut out = Out::default();
+        out.u8(TX_CMD).u8(0).u16(((queue & 0x1f) << 8) | (index as u16 & 0xff));
+        out.u16(frame.len() as u16).u16(offload as u16).u32(flags).u32(0).u32(rate);
+        out.u8(sta_id).u8(sec_ctl).u8(0).u8(0).bytes(key).u32(0).u32(TX_LIFE_TIME_INFINITE);
+        out.u32(0).u8(0).u8(TX_RTS_RETRY_LIMIT).u8(TX_DATA_RETRY_LIMIT).u8(tid).u16(pm_timeout).u16(0);
+        debug_assert_eq!(out.0.len(), 4 + TX_CMD_LEN);
+        out.bytes(&frame[..hdr]);
+        let body_at = out.0.len().next_multiple_of(4);
+        out.0.resize(body_at, 0);
+        out.bytes(&frame[hdr..]);
+        (out.0, body_at)
+    }
+
+    /// A data or management frame of the access point's (`to`: the station,
+    /// its queue): data to a client at its rate table, the rest at the
+    /// band's lowest rate; the key in the command for CCMP, by its slot
+    /// for GCMP.
+    pub(super) fn tx_command_gen1_ap(&self, frame: &[u8], sta_id: u8, rate_table: bool, freq: u16, key: Option<(u8, [u8; 16])>, queue: u16, index: usize) -> (Vec<u8>, usize) {
+        let hdr = header_len(frame);
+        let data = wifi::is_data(frame);
+        let unicast = frame.get(4).is_some_and(|byte| byte & 1 == 0);
+        let mut flags = if unicast { TX_FLG_ACK } else { 0 };
+        if hdr % 4 != 0 {
+            flags |= TX_FLG_MH_PAD;
+        }
+        let rate = if rate_table {
+            flags |= TX_FLG_STA_RATE;
+            0
+        } else {
+            self.lowest_rate(freq)
+        };
+        let qos = data && frame[0] & 0x80 != 0;
+        let tid = if qos { frame.get(hdr.saturating_sub(2)).copied().unwrap_or(0) & 0x0f } else if data { TID_NON_QOS } else { MAX_TID };
+        let (sec_ctl, material) = key.unwrap_or((0, [0; 16]));
+        Self::tx_command_v6(frame, sta_id, flags, rate, tid, PM_FRAME_NONE, sec_ctl, &material, queue, index)
+    }
+
+    /// The firmware sent a frame (`struct iwl_mvm_tx_resp_v3`): the
+    /// queue and index from the packet's sequence, the status after the
+    /// fixed part, the scheduler's next index after the statuses.
+    pub(super) fn tx_response_gen1(&mut self, sequence: u16, data: &[u8]) {
+        let queue_id = (sequence >> 8) & 0x1f;
+        let frames = data.first().copied().unwrap_or(0).max(1) as usize;
+        let retries = data.get(3).copied().unwrap_or(0);
+        let status = le16(data, 36) & 0xff;
+        let ssn = (le32(data, 36 + 4 * frames) & 0xfff) as u16;
+        let sent = status == TX_STATUS_SUCCESS || status == TX_STATUS_DIRECT_DONE;
+        if !sent {
+            ostd::debug!("{}: frame on queue {} not sent (status {:#x})", self.name, queue_id, status);
+        }
+        if queue_id == DATA_QUEUE && self.associated {
+            self.rates.feedback(sent, retries);
+        }
+        let mut freed = [self.management_queue.as_mut(), self.data_queue.as_mut(), self.aux_queue.as_mut()]
+            .into_iter()
+            .flatten()
+            .find(|queue| queue.id == queue_id)
+            .map(|queue| self.trans.reclaim(queue, ssn));
+        if freed.is_none() {
+            freed = self.ap_reclaim(queue_id, ssn).then_some(());
+        }
+        if freed.is_some()
+            && let Some(device) = &self.device
+        {
+            device.ready_to_send();
+        }
+    }
+
+    /// A frame on the older receive path (`struct iwl_rx_mpdu_res_start`,
+    /// the frame, its status), with the PHY's facts that came before it.
+    /// The chip leaves the CCMP MIC at the end: it goes here.
+    pub(super) fn rx_mpdu_legacy(&mut self, data: &[u8]) {
+        let length = le16(data, 0) as usize;
+        let Some(frame) = data.get(4..4 + length) else { return };
+        let status = le32(data, 4 + length);
+        if status & (RX_RES_CRC_OK | RX_RES_OVERRUN_OK) != (RX_RES_CRC_OK | RX_RES_OVERRUN_OK) || frame.len() < wifi::HEADER {
+            return;
+        }
+        let phy = &self.last_phy;
+        let energy = le32(phy, RX_PHY_ENERGY);
+        let signal = [energy & 0xff, (energy >> 8) & 0xff].into_iter().filter(|&energy| energy != 0).min().map_or(-127, |energy| -(energy.min(127) as i16)) as i8;
+        let channel = le16(phy, RX_PHY_CHANNEL);
+        let freq = if le16(phy, RX_PHY_FLAGS) & RX_PHY_BAND_24 != 0 {
+            if channel == 14 { 2484 } else { 2407 + 5 * channel }
+        } else {
+            5000 + 5 * channel
+        };
+        let protected = frame[1] & wifi::PROTECTED != 0;
+        let decrypted = protected && status & RX_RES_SEC_MASK == RX_RES_SEC_CCM && status & RX_RES_MIC_OK != 0;
+        let frame = if decrypted { &frame[..frame.len().saturating_sub(CCMP_MIC)] } else { frame };
+        if let Some(network) = &self.network
+            && wifi::addresses(frame).is_some_and(|(_, transmitter, _)| transmitter == network.bssid)
+        {
+            self.signal = Some(signal);
+        }
+        if let Some(device) = &self.device {
+            device.received(frame, radio::RxInfo { freq, signal, decrypted, security_header: if decrypted { CIPHER_HEADER as u8 } else { 0 }, amsdu_more: false });
+        }
+    }
+
+    /// The access point's TID for a data frame: one queue, on BE.
+    pub(super) fn data_tid_gen1(&self) -> u8 {
+        0
+    }
+
+    /// The station key command, version 1: the common part, TKIP's
+    /// fields unused.
+    pub(super) fn key_command_v1(sta_id: u8, offset: u8, flags: u16, material: &[u8; 32]) -> Vec<u8> {
+        let mut out = Out::default();
+        out.u8(sta_id).u8(offset).u16(flags).bytes(material).zeros(16).zeros(12);
+        out.0
+    }
+}
