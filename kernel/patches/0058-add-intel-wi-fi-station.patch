+/// FullMAC: the firmware's answer to a connection (a status other than 0:
+/// none was made).
+pub(crate) fn connect_result(device: &Device, bssid: &Address, status: u16, request: &[u8], response: &[u8], timed_out: bool) {
+    let mut message = event(device, NL80211_CMD_CONNECT);
+    if *bssid != [0; 6] {
+        message.put(NL80211_ATTR_MAC, bssid);
+    }
+    message.u16(NL80211_ATTR_STATUS_CODE, status);
+    if !request.is_empty() {
+        message.put(NL80211_ATTR_REQ_IE, request);
+    }
+    if !response.is_empty() {
+        message.put(NL80211_ATTR_RESP_IE, response);
+    }
+    if timed_out {
+        message.flag(NL80211_ATTR_TIMED_OUT);
+    }
+    genl::multicast(GROUP_MLME, message.finish());
+}
