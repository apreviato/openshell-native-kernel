+        state.client_added = false;
+        state.client_authorized = false;
+        Ok(())
+    }
+
+    fn set_beacon(&self, beacon: &BeaconTemplate) -> radio::Result<()> {
+        let mut state = self.state.lock();
+        let Some(ap) = state.ap.as_mut() else { return Err(radio::Error::Invalid) };
+        ap.beacon = beacon.clone();
+        Ok(())
+    }
+
+    fn stop_ap(&self) {
+        let mut state = self.state.lock();
+        state.ap = None;
+        state.client.stop();
+        state.client_added = false;
+        state.client_authorized = false;
+        self.reset(&mut state);
+    }
+
+    fn add_station(&self, station: &StationEntry) -> radio::Result<()> {
+        let mut state = self.state.lock();
+        if station.address == client::CLIENT {
+            state.client_added = true;
+        }
+        Ok(())
+    }
+
+    fn remove_station(&self, address: &Address) {
+        let mut state = self.state.lock();
+        if *address == client::CLIENT {
+            state.client_added = false;
+            state.client_authorized = false;
+            state.pairwise_key = false;
+        }
+    }
+
+    fn authorize_station(&self, address: &Address, authorized: bool) {
+        let mut state = self.state.lock();
+        if *address == client::CLIENT {
+            state.client_authorized = authorized;
+        }
+    }
+
+    fn makes_links(&self) -> bool {
+        self.full_mac
+    }
+
+    fn set_power_save(&self, enabled: bool) -> radio::Result<()> {
+        ostd::info!("sim: power save {}", if enabled { "on" } else { "off" });
+        Ok(())
+    }
+
+    /// The chip answers aggregates itself; the Wi-Fi component orders them.
+    fn rx_ba_start(&self, _ba: &mut BlockAck) -> radio::Result<Reorder> {
+        Ok(Reorder::Host)
+    }
+
+    /// As a FullMAC chip's firmware: the network found by its address or
+    /// its name, its answer, then its handshake.
+    fn connect(&self, request: &Connect) -> radio::Result<()> {
+        let mut state = self.state.lock();
+        if !state.up {
+            return Err(radio::Error::Down);
+        }
+        self.reset(&mut state);
+        let found = ACCESS_POINTS
+            .iter()
+            .position(|ap| request.bssid.map_or(ap.ssid == request.ssid.as_slice(), |bssid| bssid == ap.bssid));
+        let Some(index) = found else {
+            self.device().connect_done(Connected {
+                bssid: request.bssid.unwrap_or([0; 6]),
+                status: 1,
+                timed_out: true,
+                request_elements: Vec::new(),
+                response_elements: Vec::new(),
+            });
+            return Ok(());
+        };
+        let ap = &ACCESS_POINTS[index];
+        let rsn_matches = match (wifi::Elements(&request.elements).get(wifi::IE_RSN), ap.passphrase) {
+            (None, None) => true,
+            (Some(rsn), Some(_)) => rsn.len() >= 18 && rsn[..18] == RSN[2..20],
+            _ => false,
+        };
+        let status: u16 = if rsn_matches && ap.ssid == request.ssid.as_slice() { 0 } else { 40 };
+        let mut request_elements = Vec::with_capacity(34 + request.elements.len());
+        wifi::put_element(&mut request_elements, wifi::IE_SSID, ap.ssid);
+        request_elements.extend_from_slice(&request.elements);
+        let response_elements = Self::elements(ap)[2 + ap.ssid.len()..].to_vec();
+        self.device().connect_done(Connected { bssid: ap.bssid, status, timed_out: false, request_elements, response_elements });
+        if status == 0 {
+            state.joined = Some(index);
+            state.associated = true;
+            if ap.passphrase.is_some() {
+                self.start_handshake(&mut state, ap);
+            }
+        }
+        Ok(())
+    }
