+// SPDX-License-Identifier: MPL-2.0
+
+//! TKIP's Michael message integrity code, for radios whose chip decrypts
+//! TKIP but leaves the MIC to the host (Realtek's: Linux's mac80211 checks
+//! it for them, `IEEE80211_KEY_FLAG_GENERATE_MMIC`). These radios take TKIP
+//! as the group's cipher only, as WPA/WPA2 networks that still offer it to
+//! older stations use it: broadcasts come with it, this station sends with
+//! its pairwise CCMP key.
+//!
+//! Reference: IEEE 802.11-2020 12.5.2.3 (Michael), Linux's `michael.c`.
+
+use crate::ieee80211 as wifi;
+
+fn block(l: &mut u32, r: &mut u32) {
+    *r ^= l.rotate_left(17);
+    *l = l.wrapping_add(*r);
+    *r ^= ((*l & 0xff00_ff00) >> 8) | ((*l & 0x00ff_00ff) << 8);
+    *l = l.wrapping_add(*r);
+    *r ^= l.rotate_left(3);
+    *l = l.wrapping_add(*r);
+    *r ^= l.rotate_right(2);
+    *l = l.wrapping_add(*r);
+}
+
+/// Michael over `parts`, one after the other.
+pub fn michael(key: &[u8; 8], parts: &[&[u8]]) -> [u8; 8] {
+    let mut l = u32::from_le_bytes([key[0], key[1], key[2], key[3]]);
+    let mut r = u32::from_le_bytes([key[4], key[5], key[6], key[7]]);
+    let mut word = [0u8; 4];
+    let mut filled = 0;
+    for byte in parts.iter().flat_map(|part| part.iter()) {
+        word[filled] = *byte;
+        filled += 1;
+        if filled == 4 {
+            l ^= u32::from_le_bytes(word);
+            block(&mut l, &mut r);
+            filled = 0;
+        }
+    }
+    // The last word with 0x5a after the message, then a word of zeros.
+    word[filled] = 0x5a;
+    word[filled + 1..].fill(0);
+    l ^= u32::from_le_bytes(word);
+    block(&mut l, &mut r);
+    block(&mut l, &mut r);
+    let mut out = [0u8; 8];
+    out[..4].copy_from_slice(&l.to_le_bytes());
+    out[4..].copy_from_slice(&r.to_le_bytes());
+    out
+}
+
+/// The receive MIC key of a TKIP key as the supplicant hands it (the
+/// temporal key, then the transmit and the receive MIC keys).
+pub fn rx_mic_key(key: &[u8]) -> Option<[u8; 8]> {
+    key.get(24..32)?.try_into().ok()
+}
+
+/// Checks and removes the Michael MIC at the end of a data frame (an MSDU)
+/// the chip decrypted: its 802.11 header, then the TKIP header
+/// (`security_header` bytes), the body and the MIC, the ICV already gone.
+/// False: it does not check, and the frame is to be dropped.
+pub fn check_and_strip(frame: &mut alloc::vec::Vec<u8>, security_header: usize, key: &[u8; 8]) -> bool {
+    if frame.len() < wifi::HEADER || !wifi::is_data(frame) {
+        return false;
+    }
+    let to_ds = frame[1] & 1 != 0;
+    let from_ds = frame[1] & 2 != 0;
+    let four = to_ds && from_ds;
+    let qos = frame[0] & 0x80 != 0;
+    let mut header = wifi::HEADER + if four { 6 } else { 0 };
+    let priority = if qos { frame.get(header).map_or(0, |control| control & 0x0f) } else { 0 };
+    if qos {
+        header += 2;
+        // A frame with an HT control field (the Order bit on QoS data).
+        if frame[1] & 0x80 != 0 {
+            header += 4;
+        }
+    }
+    let start = header + security_header;
+    if frame.len() < start + 8 {
+        return false;
+    }
+    let address = |at: usize| -> [u8; 6] { frame[at..at + 6].try_into().unwrap() };
+    let (destination, source) = match (to_ds, from_ds) {
+        (false, false) => (address(4), address(10)),
+        (false, true) => (address(4), address(16)),
+        (true, false) => (address(16), address(10)),
+        (true, true) => (address(16), address(24)),
+    };
+    let end = frame.len() - 8;
+    let computed = michael(key, &[&destination, &source, &[priority, 0, 0, 0], &frame[start..end]]);
+    if computed != frame[end..] {
+        return false;
+    }
+    frame.truncate(end);
+    true
+}
