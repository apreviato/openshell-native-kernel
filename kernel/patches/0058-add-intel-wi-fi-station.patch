new file mode 100644
index 0000000..153709c
--- /dev/null
+++ b/kernel/comps/iwlwifi/src/mvm/mld.rs
@@ -0,0 +1,502 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The BZ family's firmware (BE200, BE201, BE202 and later): Linux's
+//! `iwlmld` command set, where the interface, its link to a network and
+//! the access point's station are each a context of their own (MAC_CONFIG,
+//! LINK_CONFIG, STA_CONFIG), keys are installed by station mask (SEC_KEY)
+//! and the PHY context's version 6 carries no receive chains. Scans, queues,
+//! the rate control, session protection, frames and their transmit and
+//! receive descriptors are the AX210 family's ([`super`]).
+//!
+//! The firmware's start: the platform's NVM data, `INIT_EXTENDED_CFG` with
+//! only the PHY to initialize, the PHY's configuration, `INIT_COMPLETE`;
+//! then the NVM's facts, the antennas, Bluetooth, the platform's latency,
+//! power, the region and the scan configuration, as `iwl_mld_start_fw`.
+
+use alloc::string::String;
+
+use aster_wlan::{
+    chan,
+    ieee80211::{self as wifi},
+    radio::{self, BandId, Key, Width},
+};
+
+use super::{
+    Mvm, Out, le32, COMMAND_TIMEOUT_MS, FW_CTXT_ACTION_ADD, FW_CTXT_ACTION_MODIFY, FW_CTXT_ACTION_REMOVE,
+    FW_CTXT_INVALID, FW_MAC_TYPE_BSS_STA, INIT_COMPLETE_NOTIF, INIT_EXTENDED_CFG_CMD, LONG, MAC_CONF, NVM_GET_INFO,
+    NVM_MAC_SKU_11N, NVM_MAC_SKU_24, NVM_MAC_SKU_52, NVM_MAC_SKU_MIMO_DISABLED, POWER_TABLE_CMD,
+    REGULATORY, SCAN_CFG_CMD, SYSTEM, TX_ANT_CONFIGURATION_CMD,
+};
+use crate::fw::Firmware;
+
+/// The MLD contexts' commands (`MAC_CONF` group).
+pub(super) const MAC_CONFIG_CMD: u8 = 0x08;
+pub(super) const LINK_CONFIG_CMD: u8 = 0x09;
+pub(super) const STA_CONFIG_CMD: u8 = 0x0a;
+pub(super) const STA_REMOVE_CMD: u8 = 0x0c;
+/// `DATA_PATH` group.
+pub(super) const SEC_KEY_CMD: u8 = 0x18;
+const DATA_PATH: u8 = 0x05;
+/// The PHY's configuration (long group).
+const PHY_CONFIGURATION_CMD: u8 = 0x6a;
+const PHY_CONTEXT_CMD: u8 = 0x08;
+
+/// `INIT_EXTENDED_CFG`'s flags: the PHY only (`BIT(IWL_INIT_PHY)`).
+const INIT_PHY: u32 = 1 << 1;
+const FW_PHY_CFG_CHAINS: u32 = 0xff << 16;
+
+/// The one MAC, link, PHY and access point station here.
+pub(super) const MAC_ID: u32 = 0;
+pub(super) const LINK_ID: u32 = 0;
+pub(super) const PHY_ID: u32 = 0;
+const AP_STATION: u32 = 0;
+pub(super) const STATION_TYPE_PEER: u32 = 0;
+
+/// MAC_CONFIG's filters (`enum iwl_mac_config_filter_flags`).
+const MAC_CFG_FILTER_ACCEPT_GRP: u32 = 1 << 2;
+const MAC_CFG_FILTER_ACCEPT_BEACON: u32 = 1 << 3;
+
+/// LINK_CONFIG's parts to change (`enum iwl_link_ctx_modify_flags`).
+pub(super) const LINK_MODIFY_ACTIVE: u32 = 1 << 0;
+pub(super) const LINK_MODIFY_RATES_INFO: u32 = 1 << 1;
+pub(super) const LINK_MODIFY_PROTECT_FLAGS: u32 = 1 << 2;
+pub(super) const LINK_MODIFY_QOS_PARAMS: u32 = 1 << 3;
+pub(super) const LINK_MODIFY_BEACON_TIMING: u32 = 1 << 4;
+pub(super) const LINK_MODIFY_HE_PARAMS: u32 = 1 << 5;
+/// Its protection flags (`enum iwl_link_ctx_protection_flags`) and flags.
+pub(super) const LINK_PROT_FLG_HT_PROT: u32 = 1 << 1;
+pub(super) const LINK_PROT_FLG_FAT_PROT: u32 = 1 << 2;
+pub(super) const LINK_FLG_BSS_COLOR_DIS: u32 = 1 << 0;
+/// QoS flags: the EDCA parameters are to be used, the link is 802.11n.
+pub(super) const MAC_QOS_FLG_UPDATE_EDCA: u32 = 1 << 0;
+pub(super) const MAC_QOS_FLG_TGN: u32 = 1 << 1;
+
+/// SEC_KEY's key flags (`enum iwl_sec_key_flags`).
+pub(super) const SEC_KEY_FLAG_CIPHER_CCMP: u32 = 0x02;
+pub(super) const SEC_KEY_FLAG_CIPHER_GCMP: u32 = 0x05;
+pub(super) const SEC_KEY_FLAG_KEY_SIZE: u32 = 0x10;
+pub(super) const SEC_KEY_FLAG_MCAST_KEY: u32 = 0x40;
+
+/// HTC abilities of an HE access point (`IWL_HE_HTC_*`).
+pub(super) const HE_HTC_SUPPORT: u32 = 1 << 0;
+pub(super) const HE_HTC_OMI_SUPP: u32 = 1 << 15;
+/// HE MAC capabilities: HTC (byte 0), acknowledgment-enabled aggregates
+/// (byte 2), OM control (byte 3).
+pub(super) const HE_MAC_CAP0_HTC_HE: u8 = 0x01;
+pub(super) const HE_MAC_CAP2_ACK_EN: u8 = 0x80;
+pub(super) const HE_MAC_CAP3_OMI_CONTROL: u8 = 0x02;
+
+/// The A-MPDU length exponent extensions: HE's (MAC byte 3), EHT's (MAC
+/// byte 1); the firmware's largest A-MPDU (`STA_FLG_MAX_AGG_SIZE_4M`).
+const HE_MAC_CAP3_AMPDU_EXP_EXT: u8 = 0x18;
+const EHT_MAC_CAP1_AMPDU_EXP_EXT: u8 = 0x01;
+const STA_AGG_SIZE_4M: u32 = 9;
+/// The packet extension's constellation thresholds (`enum
+/// iwl_he_pkt_ext_constellations`).
+const PKT_EXT_BPSK: u8 = 0;
+const PKT_EXT_4096QAM: u8 = 6;
+const PKT_EXT_NONE: u8 = 7;
+/// HE's PPE thresholds: present (PHY byte 6), their header's streams and
+/// RU bitmap, its length in bits; the nominal padding (PHY byte 9).
+const HE_PHY6_PPE_THRESHOLD_PRESENT: u8 = 0x80;
+const HE_PPE_NSS_MASK: u8 = 0x07;
+const HE_PPE_RU_MASK: u8 = 0x78;
+const HE_PPE_HEADER_BITS: usize = 7;
+const HE_PHY9_NOMINAL_PADDING_SHIFT: u8 = 6;
+/// EHT's: present and the common nominal padding (PHY byte 5), the
+/// header's streams and RU bitmap (16 bits), its length.
+const EHT_PPE_NSS_MASK: u16 = 0x000f;
+const EHT_PPE_RU_MASK: u16 = 0x01f0;
+const EHT_PPE_HEADER_BITS: usize = 9;
+const EHT_PHY5_NOMINAL_PADDING_SHIFT: u8 = 4;
+/// Each threshold is three bits.
+const PPET_BITS: usize = 3;
+
+/// A threshold at a bit position of the PPE thresholds field.
+fn ppe_value(ppe: &[u8], bit: usize) -> u8 {
+    let low = ppe.get(bit / 8).copied().unwrap_or(0) as u16;
+    let high = ppe.get(bit / 8 + 1).copied().unwrap_or(0) as u16;
+    ((((high << 8) | low) >> (bit % 8)) & 7) as u8
+}
+
+/// `iwl_mld_parse_ppe`: each stream's (two at most) thresholds for each
+/// width the RU bitmap names; with `inheritance` (802.11be), a width
+/// without its own takes the last one's.
+fn parse_ppe(out: &mut [[[u8; 2]; 5]; 2], nss: usize, ru_bitmap: u8, ppe: &[u8], mut bit: usize, inheritance: bool) {
+    for stream in out.iter_mut().take(nss) {
+        let mut ru = ru_bitmap << 1;
+        let (mut low, mut high) = (PKT_EXT_NONE, PKT_EXT_NONE);
+        for width in stream.iter_mut() {
+            ru >>= 1;
+            if ru & 1 == 0 {
+                if inheritance {
+                    *width = [low, high];
+                }
+                continue;
+            }
+            high = ppe_value(ppe, bit);
+            bit += PPET_BITS;
+            low = ppe_value(ppe, bit);
+            bit += PPET_BITS;
+            *width = [low, high];
+        }
+    }
+}
+
+/// `iwl_mld_set_pkt_ext_from_nominal_padding`: 0 µs none, 8 µs from BPSK
+/// on the low threshold, 16 and 20 µs on the high one.
+fn nominal_padding(out: &mut [[[u8; 2]; 5]; 2], padding: u8) {
+    let thresholds = match padding {
+        0 => [PKT_EXT_NONE, PKT_EXT_NONE],
+        1 => [PKT_EXT_BPSK, PKT_EXT_NONE],
+        _ => [PKT_EXT_NONE, PKT_EXT_BPSK],
+    };
+    for stream in out.iter_mut() {
+        for width in stream.iter_mut() {
+            *width = thresholds;
+        }
+    }
+}
+
+/// `iwl_mld_fill_pkt_ext`: the thresholds (two streams, five widths, low
+/// and high) from the access point's EHT PPE thresholds, else its HE ones
+/// (MCS 12 and 13 no less than the common nominal padding), else the
+/// nominal padding; for HE alone, its PPE thresholds or nominal padding.
+fn pkt_ext(peer: &radio::Peer) -> [u8; 20] {
+    let mut out = [[[PKT_EXT_NONE; 2]; 5]; 2];
+    let he_ppe = peer.he.as_ref().filter(|he| he.phy[6] & HE_PHY6_PPE_THRESHOLD_PRESENT != 0 && !he.ppe.is_empty());
+    let from_he = |out: &mut [[[u8; 2]; 5]; 2], inheritance: bool| {
+        if let Some(he) = he_ppe {
+            let nss = (he.ppe[0] & HE_PPE_NSS_MASK) as usize + 1;
+            let ru = (he.ppe[0] & HE_PPE_RU_MASK) >> HE_PPE_RU_MASK.trailing_zeros();
+            parse_ppe(out, nss, ru, &he.ppe, HE_PPE_HEADER_BITS, inheritance);
+        }
+    };
+    if let Some(eht) = &peer.eht {
+        let padding = (eht.phy[5] & 0x30) >> EHT_PHY5_NOMINAL_PADDING_SHIFT;
+        if eht.phy[5] & chan::EHT_PHY5_PPE_THRESHOLD_PRESENT != 0 && eht.ppe.len() >= 2 {
+            let header = u16::from_le_bytes([eht.ppe[0], eht.ppe[1]]);
+            let nss = (header & EHT_PPE_NSS_MASK) as usize + 1;
+            let ru = ((header & EHT_PPE_RU_MASK) >> EHT_PPE_RU_MASK.trailing_zeros()) as u8;
+            parse_ppe(&mut out, nss, ru, &eht.ppe, EHT_PPE_HEADER_BITS, true);
+        } else if he_ppe.is_some() {
+            from_he(&mut out, true);
+            // `iwl_mld_get_optimal_ppe_info`.
+            for stream in out.iter_mut() {
+                for width in stream.iter_mut() {
+                    if padding > 1 && width[1] == PKT_EXT_NONE {
+                        width[1] = PKT_EXT_4096QAM;
+                    } else if padding == 1 && width[0] == PKT_EXT_NONE && width[1] == PKT_EXT_NONE {
+                        width[0] = PKT_EXT_4096QAM;
+                    }
+                }
+            }
+        } else {
+            nominal_padding(&mut out, padding);
+        }
+    } else if let Some(he) = &peer.he {
+        if he_ppe.is_some() {
+            from_he(&mut out, false);
+        } else {
+            nominal_padding(&mut out, (he.phy[9] >> HE_PHY9_NOMINAL_PADDING_SHIFT) & 3);
+        }
+    }
+    let mut flat = [0u8; 20];
+    for (slot, value) in flat.iter_mut().zip(out.iter().flatten().flatten()) {
+        *slot = *value;
+    }
+    flat
+}
+
+impl Mvm {
+    /// Everything from the firmware's ALIVE to a radio ready to scan.
+    pub(super) fn init_mld(&mut self, alive: &[u8], prefix: &str, firmware: &Firmware) -> Result<(), String> {
+        self.load_pnvm(alive, prefix)?;
+        self.command(SYSTEM, INIT_EXTENDED_CFG_CMD, &INIT_PHY.to_le_bytes())?;
+        self.mld_phy_configuration(firmware)?;
+        self.notification(LONG, INIT_COMPLETE_NOTIF, COMMAND_TIMEOUT_MS)?;
+        let nvm = self.command(REGULATORY, NVM_GET_INFO, &0u32.to_le_bytes())?;
+        if nvm.len() >= 20 {
+            let sku = le32(&nvm, 8);
+            self.band_24 = sku & NVM_MAC_SKU_24 != 0;
+            self.band_52 = sku & NVM_MAC_SKU_52 != 0;
+            self.ht = sku & NVM_MAC_SKU_11N != 0;
+            let (tx, rx) = (le32(&nvm, 12) as u8, le32(&nvm, 16) as u8);
+            if tx & self.tx_ant != 0 {
+                self.tx_ant &= tx;
+            }
+            if rx & self.rx_ant != 0 {
+                self.rx_ant &= rx;
+            }
+            if sku & NVM_MAC_SKU_MIMO_DISABLED != 0 {
+                self.tx_ant &= self.tx_ant.wrapping_neg();
+                self.rx_ant &= self.rx_ant.wrapping_neg();
+            }
+        }
+        if !self.band_24 && !self.band_52 {
+            self.band_24 = true;
+        }
+        self.address = self.trans.mac_address();
+        if self.address == [0; 6] || self.address[0] & 1 != 0 {
+            return Err(String::from("the card has no MAC address"));
+        }
+        self.command(0, TX_ANT_CONFIGURATION_CMD, &(self.tx_ant as u32).to_le_bytes())?;
+        self.bt_config()?;
+        self.soc_configuration()?;
+        // The device may save power (the link's is the MAC power command's).
+        self.command(0, POWER_TABLE_CMD, &Out::default().u16(super::DEVICE_POWER_FLAGS_POWER_SAVE_ENA).u16(0).0)?;
+        self.region();
+        let scan_config = Out::default().u8(0).u8(0).u8(0).u8(0).u32(self.tx_ant as u32).u32(self.rx_ant as u32).0.clone();
+        self.command(0, SCAN_CFG_CMD, &scan_config)?;
+        // The interface's MAC and its one link, on no channel yet.
+        self.mld_mac_config(FW_CTXT_ACTION_ADD)?;
+        self.mld_link(FW_CTXT_ACTION_ADD, 0, false)?;
+        self.mac_added = true;
+        Ok(())
+    }
+
+    /// `PHY_CONFIGURATION_CMD` version 3: the radio's configuration with the
+    /// valid antennas, the regular program's default calibrations, no PHY
+    /// filters.
+    fn mld_phy_configuration(&mut self, firmware: &Firmware) -> Result<(), String> {
+        let chains = ((self.tx_ant as u32) << 16) | ((self.rx_ant as u32) << 20);
+        let config = (firmware.phy_config & (!FW_PHY_CFG_CHAINS | chains)) | self.extra_phy_config;
+        let (flow, event) = firmware.default_calib[0];
+        let mut out = Out::default();
+        out.u32(config).u32(flow).u32(event).zeros(16);
+        self.command(0, PHY_CONFIGURATION_CMD, &out.0).map(|_| ())
+    }
+
+    /// `MAC_CONFIG_CMD` version 3 (52 bytes): a station, associated or not,
+    /// with HE where the network has it.
+    pub(super) fn mld_mac_config(&mut self, action: u32) -> Result<(), String> {
+        let network = self.network.clone();
+        let he = network.as_ref().is_some_and(|network| network.peer.he.is_some());
+        let eht = network.as_ref().is_some_and(|network| network.peer.eht.is_some());
+        let mut filter = MAC_CFG_FILTER_ACCEPT_GRP;
+        if !self.associated {
+            filter |= MAC_CFG_FILTER_ACCEPT_BEACON;
+        }
+        let mut out = Out::default();
+        out.u32(MAC_ID).u32(action).u32(FW_MAC_TYPE_BSS_STA).bytes(&self.address).u16(0).u32(filter);
+        // HE, HE as an access point, EHT, UHR; reserved.
+        out.u8(he as u8).u8(0).u8(eht as u8).u8(0).u32(0);
+        out.u32(0);
+        // The client's part: associated, its ID.
+        out.u8(self.associated as u8).u8(0).u16(0).u16(if self.associated { self.aid } else { 0 }).u16(0).u16(0).u16(0).u32(0);
+        debug_assert_eq!(out.0.len(), 52);
+        self.command(MAC_CONF, MAC_CONFIG_CMD, &out.0).map(|_| ())
+    }
+
+    /// `LINK_CONFIG_CMD` version 7 (208 bytes): the link on its PHY when
+    /// it is active, with the network's rates, protection, EDCA, beacon
+    /// timing and, once associated with an HE network, its HE parameters.
+    pub(super) fn mld_link(&mut self, action: u32, mut changes: u32, active: bool) -> Result<(), String> {
+        let network = self.network.clone().unwrap_or_default();
+        let ghz2 = BandId::of(network.freq) == BandId::Ghz2;
+        let mut out = Out::default();
+        out.u32(action).u32(LINK_ID).u32(MAC_ID).u32(if active { PHY_ID } else { FW_CTXT_INVALID });
+        out.bytes(&self.address).u16(0);
+        let he = self.associated && network.peer.he.is_some();
+        if !he {
+            changes &= !LINK_MODIFY_HE_PARAMS;
+        }
+        out.u32(changes).u32(active as u32);
+        // Not blocking transmission, no bandwidth change.
+        out.u32(0);
+        // Basic rates: CCK 1, 2, 5.5 and 11 Mbit/s on 2.4 GHz; OFDM 6, 12
+        // and 24.
+        out.u32(if ghz2 { 0x0f } else { 0 }).u32(0x15);
+        out.u32((network.capability & wifi::CAP_SHORT_PREAMBLE != 0) as u32);
+        out.u32((network.capability & wifi::CAP_SHORT_SLOT != 0 || !ghz2) as u32);
+        let wider = network.chandef.is_some_and(|chandef| chandef.width >= Width::W40);
+        let protection = match network.ht_protection {
+            1 | 3 => LINK_PROT_FLG_HT_PROT | LINK_PROT_FLG_FAT_PROT,
+            2 if wider => LINK_PROT_FLG_HT_PROT | LINK_PROT_FLG_FAT_PROT,
+            _ => 0,
+        };
+        out.u32(if self.associated { protection } else { 0 });
+        let ht = network.ht_mcs.is_some();
+        out.u32(MAC_QOS_FLG_UPDATE_EDCA | if ht && self.associated { MAC_QOS_FLG_TGN } else { 0 });
+        // EDCA by the firmware's AC order (BK, BE, VI, VO), each on its
+        // FIFO, and the fifth entry unused.
+        for (index, (cw_min, cw_max, aifsn, txop)) in [(15u16, 1023u16, 7u8, 0u16), (15, 1023, 3, 0), (7, 15, 2, 3008), (3, 7, 2, 1504)].into_iter().enumerate() {
+            out.u16(cw_min).u16(cw_max).u8(aifsn).u8(1 << (1 + index)).u16(txop);
+        }
+        out.zeros(8);
+        // HE: trigger-based packet extension, random access, NDP feedback,
+        // the MU EDCA counters (none).
+        out.u8(0).u8(0).u8(0).u8(0).zeros(32);
+        let interval = network.beacon_interval as u32;
+        out.u32(interval).u32(interval * network.dtim_period.max(1) as u32);
+        out.u16(0).u16(if he { network.he_rts_threshold } else { 0 });
+        let flags = if he && network.he_bss_color == 0 { LINK_FLG_BSS_COLOR_DIS } else { 0 };
+        out.u32(flags).u32(0);
+        out.zeros(6).u16(0);
+        out.u8(0).u8(if he { network.he_bss_color } else { 0 }).u8(LINK_ID as u8).u8(0);
+        out.zeros(6).u16(0);
+        // The UHR parameters and reserved words.
+        out.zeros(8).zeros(8).zeros(16);
+        debug_assert_eq!(out.0.len(), 208);
+        self.command(MAC_CONF, LINK_CONFIG_CMD, &out.0).map(|_| ())
+    }
+
+    /// The link on the PHY context (a binding of the older API), or off it.
+    pub(super) fn mld_bind(&mut self, active: bool) -> Result<(), String> {
+        self.mld_link(
+            FW_CTXT_ACTION_MODIFY,
+            LINK_MODIFY_ACTIVE | LINK_MODIFY_RATES_INFO | LINK_MODIFY_PROTECT_FLAGS | LINK_MODIFY_QOS_PARAMS,
+            active,
+        )
+    }
+
+    /// Everything the association settled, on the link.
+    pub(super) fn mld_link_associated(&mut self) -> Result<(), String> {
+        self.mld_link(
+            FW_CTXT_ACTION_MODIFY,
+            LINK_MODIFY_RATES_INFO | LINK_MODIFY_PROTECT_FLAGS | LINK_MODIFY_QOS_PARAMS | LINK_MODIFY_BEACON_TIMING | LINK_MODIFY_HE_PARAMS,
+            true,
+        )
+    }
+
+    /// `PHY_CONTEXT_CMD` version 6 (32 bytes): the channel and its width,
+    /// no sub-band settings.
+    pub(super) fn mld_phy_context(&mut self, action: u32, freq: u16) -> Result<(), String> {
+        let band = super::phy_band(freq);
+        let channel = super::channel_number(freq);
+        let chandef = match &self.ap {
+            Some(ap) => Some(ap.config.chandef),
+            None => self.network.as_ref().and_then(|network| network.chandef),
+        }
+        .filter(|chandef| chandef.control == freq);
+        let (width, position) = chandef.map_or((0, 0), |chandef| Self::phy_width(&chandef));
+        let mut out = Out::default();
+        out.u32(PHY_ID).u32(action);
+        out.u32(channel as u32).u8(band).u8(width).u8(position).u8(0);
+        out.u32(self.lmac_id(freq));
+        out.u32(0).u32(0).u8(0).zeros(3);
+        debug_assert_eq!(out.0.len(), 32);
+        self.command(0, PHY_CONTEXT_CMD, &out.0).map(|_| ())
+    }
+
+    /// `STA_CONFIG_CMD` version 2 (104 bytes): the access point's station
+    /// on the link, its aggregates, streams and HE abilities once
+    /// associated. Until the port opens its management frames are taken
+    /// as protected, as Linux does.
+    pub(super) fn mld_station(&mut self) -> Result<(), String> {
+        let network = self.network.clone().unwrap_or_default();
+        let peer = &network.peer;
+        let mut out = Out::default();
+        out.u32(AP_STATION).u32(LINK_ID).bytes(&network.bssid).u16(0).bytes(&network.bssid).u16(0);
+        out.u32(STATION_TYPE_PEER).u32(if self.associated { self.aid as u32 } else { 0 }).u32(0);
+        out.u32(!self.authorized as u32);
+        let mimo = self.associated && peer.nss >= 2 && self.rx_ant.count_ones() >= 2 && self.tx_ant.count_ones() >= 2;
+        out.u32(mimo as u32).u32(0);
+        let ack = peer.he.as_ref().is_some_and(|he| he.mac[2] & HE_MAC_CAP2_ACK_EN != 0);
+        out.u32(ack as u32).u32(0);
+        // The aggregates (`iwl_mld_fill_ampdu_size_and_dens`): spacing and
+        // size from HT, or from HE's 6 GHz band capabilities on 6 GHz, the
+        // size from VHT elsewhere; HE's and EHT's extensions on it, as the
+        // exponent of 8 KiB, to the firmware's 4 MiB.
+        let (spacing, size) = if self.associated {
+            let mut spacing = if network.ht_mcs.is_some() { network.ampdu_density as u32 } else { 0 };
+            let mut size = peer.ht.map_or(0, |ht| ht.ampdu_factor as u32);
+            if BandId::of(network.freq) == BandId::Ghz6 {
+                if let Some(capa) = peer.he_6ghz {
+                    spacing = (capa & 7) as u32;
+                    size = ((capa >> chan::HE_6GHZ_CAP_MAX_AMPDU_SHIFT) & 7) as u32;
+                }
+            } else if let Some(vht) = &peer.vht {
+                size = (vht.info >> chan::VHT_CAP_MAX_AMPDU_SHIFT) & 7;
+            }
+            if let Some(he) = &peer.he {
+                size += ((he.mac[3] & HE_MAC_CAP3_AMPDU_EXP_EXT) >> HE_MAC_CAP3_AMPDU_EXP_EXT.trailing_zeros()) as u32;
+            }
+            if let Some(eht) = &peer.eht {
+                size += (eht.mac[1] & EHT_MAC_CAP1_AMPDU_EXP_EXT) as u32;
+            }
+            (spacing, size.min(STA_AGG_SIZE_4M))
+        } else {
+            (0, 0)
+        };
+        out.u32(spacing).u32(size);
+        // U-APSD: none.
+        out.u32(if self.qos { 128 } else { 0 }).u32(0);
+        // The packet extension the access point asks for.
+        out.bytes(&pkt_ext(peer));
+        let mut htc = 0;
+        if let Some(he) = &peer.he {
+            if he.mac[0] & HE_MAC_CAP0_HTC_HE != 0 {
+                htc |= HE_HTC_SUPPORT;
+            }
+            if he.mac[3] & HE_MAC_CAP3_OMI_CONTROL != 0 {
+                htc |= HE_HTC_OMI_SUPP;
+            }
+        }
+        out.u32(htc);
+        out.zeros(8);
+        debug_assert_eq!(out.0.len(), 104);
+        self.command(MAC_CONF, STA_CONFIG_CMD, &out.0).map(|_| ())
+    }
+
+    pub(super) fn mld_remove_station(&mut self) {
+        let _ = self.command(MAC_CONF, STA_REMOVE_CMD, &AP_STATION.to_le_bytes());
+    }
+
+    /// `SEC_KEY_CMD` (80 bytes to add, 16 to remove): keys belong to the
+    /// access point's station by its mask.
+    pub(super) fn mld_set_key(&mut self, key: &Key) -> radio::Result<()> {
+        self.mld_sec_key(key, 1 << AP_STATION)
+    }
+
+    /// A key on the stations of `sta_mask`.
+    pub(super) fn mld_sec_key(&mut self, key: &Key, sta_mask: u32) -> radio::Result<()> {
+        let mut flags = match key.cipher {
+            radio::CIPHER_CCMP | radio::CIPHER_CCMP_256 => SEC_KEY_FLAG_CIPHER_CCMP,
+            radio::CIPHER_GCMP | radio::CIPHER_GCMP_256 => SEC_KEY_FLAG_CIPHER_GCMP,
+            _ => return Err(radio::Error::Unsupported),
+        };
+        if key.key.len() > 32 || key.index > 3 {
+            return Err(radio::Error::Invalid);
+        }
+        if key.key.len() == 32 {
+            flags |= SEC_KEY_FLAG_KEY_SIZE;
+        }
+        if !key.pairwise {
+            flags |= SEC_KEY_FLAG_MCAST_KEY;
+        }
+        let mut material = [0u8; 32];
+        material[..key.key.len()].copy_from_slice(&key.key);
+        let mut seq = [0u8; 8];
+        seq[..key.seq.len().min(6)].copy_from_slice(&key.seq[..key.seq.len().min(6)]);
+        let mut out = Out::default();
+        out.u32(FW_CTXT_ACTION_ADD).u32(sta_mask).u32(key.index as u32).u32(flags).bytes(&material).zeros(16);
+        out.bytes(&seq).u64(0);
+        debug_assert_eq!(out.0.len(), 80);
+        if let Err(error) = self.command(DATA_PATH, SEC_KEY_CMD, &out.0) {
+            ostd::warn!("{}: key: {}", self.name, error);
+            return Err(radio::Error::Failed);
+        }
+        Ok(())
+    }
+
+    pub(super) fn mld_remove_key(&mut self, index: u8, pairwise: bool) {
+        self.mld_remove_sec_key(index, pairwise, 1 << AP_STATION);
+    }
+
+    pub(super) fn mld_remove_sec_key(&mut self, index: u8, pairwise: bool, sta_mask: u32) {
+        let mut out = Out::default();
+        out.u32(FW_CTXT_ACTION_REMOVE).u32(sta_mask).u32(index as u32).u32(if pairwise { 0 } else { SEC_KEY_FLAG_MCAST_KEY });
+        let _ = self.command(DATA_PATH, SEC_KEY_CMD, &out.0);
+    }
+
+    /// The port opened: the station's management frames are no longer
+    /// all taken as protected.
+    pub(super) fn mld_authorized(&mut self) {
+        if self.station_added
+            && let Err(error) = self.mld_station()
+        {
+            ostd::info!("{}: station: {}", self.name, error);
+        }
+    }
+}
