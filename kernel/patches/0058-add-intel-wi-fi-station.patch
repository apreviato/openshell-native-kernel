+/// Whether an action frame of this category must be protected once
+/// management frames are (802.11 table 9-51's robust categories).
+pub fn robust_category(category: u8) -> bool {
+    !matches!(category, 4 | 7 | 11 | 15 | 17 | 126 | 127)
+}
+
+/// An action frame with `body` (category, action, fields); `protected`
+/// sets the bit the radio encrypts it by.
+pub fn action(to: &Address, own: &Address, bssid: &Address, body: &[u8], protected: bool) -> Vec<u8> {
+    let mut frame = header(ACTION, to, own, bssid);
+    if protected {
+        frame[1] |= PROTECTED;
+    }
+    frame.extend_from_slice(body);
+    frame
+}
