+        }
+    }
+
+    // ---- Commands and what comes back. ----
+
+    /// Sends a command and waits for its answer, handling what else comes
+    /// meanwhile. Legacy commands go in the long group, as Linux sends
+    /// them with the wide header.
+    fn command(&mut self, group: u8, id: u8, payload: &[u8]) -> Result<Vec<u8>, String> {
+        if self.dead {
+            return Err(String::from("the firmware stopped"));
+        }
+        let group = if group == 0 { LONG } else { group };
+        let sequence = self
+            .trans
+            .send_command(group, id, 0, payload)
+            .ok_or_else(|| format!("command {group:#x}/{id:#x} did not fit the queue"))?;
+        self.wait_for(COMMAND_TIMEOUT_MS, &format!("command {group:#x}/{id:#x}"), |packet| packet.answers(sequence))
+    }
+
+    /// A command whose answer is a status: `ok` is the good one.
+    fn command_status(&mut self, group: u8, id: u8, payload: &[u8], ok: u32) -> Result<(), String> {
+        let answer = self.command(group, id, payload)?;
+        let status = le32(&answer, 0);
+        if answer.len() >= 4 && status != ok {
+            return Err(format!("command {group:#x}/{id:#x} refused (status {status:#x})"));
+        }
+        Ok(())
+    }
+
+    /// Waits for a notification of the long group (or another `group`).
+    fn notification(&mut self, group: u8, id: u8, timeout_ms: u64) -> Result<Vec<u8>, String> {
+        self.wait_for(timeout_ms, &format!("notification {group:#x}/{id:#x}"), |packet| {
+            packet.command == id && (packet.group == group || (group <= LONG && packet.group <= LONG))
+        })
+    }
+
+    fn wait_for(&mut self, timeout_ms: u64, what: &str, wanted: impl Fn(&Packet) -> bool) -> Result<Vec<u8>, String> {
+        let deadline = crate::now_ms() + timeout_ms;
+        let waiting = crate::WAKER.waiting();
+        let result = loop {
+            let causes = self.trans.causes();
+            let mut found = None;
+            for packet in self.trans.receive() {
+                if found.is_none() && wanted(&packet) {
+                    found = Some(packet.data);
+                } else {
+                    self.handle(packet);
+                }
+            }
+            if let Some(data) = found {
+                break Ok(data);
+            }
+            if causes.error {
+                self.died();
+                break Err(String::from("the firmware stopped with an error"));
+            }
+            if crate::now_ms() >= deadline {
+                break Err(format!("no answer to {what}"));
+            }
+            crate::sleep();
+        };
+        drop(waiting);
+        result
+    }
+
+    /// Reads what the card said: from its task, between commands.
+    pub(crate) fn poll(&mut self) {
+        if self.dead {
+            return;
+        }
+        let causes = self.trans.causes();
+        for packet in self.trans.receive() {
+            self.handle(packet);
+        }
+        if causes.error {
+            self.died();
+            return;
+        }
+        // The first generation's rate table, when its rate control moved:
+        // sent here, between commands, never from inside one's wait.
+        if self.gen1 && self.rates.dirty && self.associated {
+            if let Err(error) = self.send_rates() {
+                ostd::info!("{}: rates: {}", self.name, error);
+            }
+        }
+    }
+
+    fn died(&mut self) {
+        if self.dead {
+            return;
+        }
+        self.dead = true;
+        ostd::warn!("{}: the firmware stopped with an error; the card stays off until the next boot", self.name);
+        if let Some(device) = &self.device {
+            if self.scanning {
+                device.scan_done(true);
+            }
+            device.connection_lost();
+        }
+        self.scanning = false;
+    }
+
+    fn handle(&mut self, packet: Packet) {
+        let legacy = packet.group <= LONG;
+        match packet.command {
+            gen1::REPLY_RX_PHY_CMD if legacy && self.legacy_rx => self.last_phy = packet.data,
+            REPLY_RX_MPDU_CMD if legacy && self.legacy_rx => self.rx_mpdu_legacy(&packet.data),
+            REPLY_RX_MPDU_CMD if legacy => self.rx_mpdu(&packet.data),
+            TX_CMD if legacy && self.gen1 => self.tx_response_gen1(packet.sequence, &packet.data),
+            TX_CMD if legacy => self.tx_response(&packet.data),
+            gen1::CALIB_RES_NOTIF_PHY_DB if legacy && self.gen1 => self.store_phy_db(&packet.data),
+            gen1::TIME_EVENT_NOTIFICATION if legacy && self.gen1 => self.time_event_notification(&packet.data),
+            SCAN_COMPLETE_UMAC if legacy => {
+                let status = packet.data.get(6).copied().unwrap_or(0);
+                if self.scanning {
+                    self.scanning = false;
+                    if let Some(device) = &self.device {
+                        device.scan_done(status != SCAN_OFFLOAD_COMPLETED);
+                    }
+                }
+            }
+            MISSED_BEACONS_NOTIFICATION if legacy => self.missed_beacons(&packet.data),
+            MISSED_BEACONS_NOTIF if packet.group == MAC_CONF => self.missed_beacons(&packet.data),
+            _ => {}
+        }
+    }
+
+    fn missed_beacons(&mut self, data: &[u8]) {
+        let missed = le32(data, 4);
+        if missed >= MISSED_BEACONS_LOST && self.associated {
+            ostd::info!("{}: {} beacons missed", self.name, missed);
+            if let Some(device) = &self.device {
+                device.connection_lost();
+            }
+        }
+    }
+
+    // ---- The firmware's start. ----
+
+    /// Everything between the firmware's ALIVE (`alive`, its notification)
+    /// and a radio ready to scan. The first generation's runtime program
+    /// (after the calibrating one, [`Mvm::run_init_image`]) takes its own.
+    pub(crate) fn init(&mut self, alive: &[u8], prefix: &str, firmware: &Firmware, file: &[u8]) -> Result<(), String> {
+        if self.gen1 {
+            // The 9000 family's address is in its registers; the 8000
+            // family's came from the NVM (or the MAC's own registers).
+            if !self.legacy_rx {
+                self.address = self.trans.mac_address();
+            } else if self.address == [0; 6] {
+                self.address = self.trans.mac_address_wfmp();
+            }
+            if self.address == [0; 6] || self.address[0] & 1 != 0 {
+                return Err(String::from("the card has no MAC address"));
+            }
+            self.init_gen1(firmware, file)?;
+            self.mac_context(FW_CTXT_ACTION_ADD)?;
+            self.mac_added = true;
+            return Ok(());
+        }
+        if self.ax210 {
+            self.load_pnvm(alive, prefix)?;
+        }
+        self.command(SYSTEM, INIT_EXTENDED_CFG_CMD, &1u32.to_le_bytes())?;
+        self.command(REGULATORY, NVM_ACCESS_COMPLETE, &0u32.to_le_bytes())?;
+        self.notification(LONG, INIT_COMPLETE_NOTIF, COMMAND_TIMEOUT_MS)?;
+        let nvm = self.command(REGULATORY, NVM_GET_INFO, &0u32.to_le_bytes())?;
+        if nvm.len() >= 20 {
+            let sku = le32(&nvm, 8);
+            self.band_24 = sku & NVM_MAC_SKU_24 != 0;
+            self.band_52 = sku & NVM_MAC_SKU_52 != 0;
+            self.ht = sku & NVM_MAC_SKU_11N != 0;
+            let (tx, rx) = (le32(&nvm, 12) as u8, le32(&nvm, 16) as u8);
+            if tx & self.tx_ant != 0 {
+                self.tx_ant &= tx;
+            }
+            if rx & self.rx_ant != 0 {
+                self.rx_ant &= rx;
+            }
+            if sku & NVM_MAC_SKU_MIMO_DISABLED != 0 {
+                self.tx_ant &= self.tx_ant.wrapping_neg();
+                self.rx_ant &= self.rx_ant.wrapping_neg();
+            }
+        }
+        if !self.band_24 && !self.band_52 {
+            self.band_24 = true;
+        }
+        self.address = self.trans.mac_address();
+        if self.address == [0; 6] || self.address[0] & 1 != 0 {
+            return Err(String::from("the card has no MAC address"));
+        }
+        self.command(0, TX_ANT_CONFIGURATION_CMD, &(self.tx_ant as u32).to_le_bytes())?;
+        self.command(0, BT_CONFIG, &Out::default().u32(BT_COEX_NW).u32(0).0)?;
+        self.soc_configuration()?;
+        // Always awake: no power save.
+        self.command(0, POWER_TABLE_CMD, &Out::default().u16(0).u16(0).0)?;
+        self.region();
+        let scan_config = Out::default().u8(0).u8(0).u8(0).u8(0).u32(self.tx_ant as u32).u32(self.rx_ant as u32).0.clone();
+        self.command(0, SCAN_CFG_CMD, &scan_config)?;
+        self.mac_context(FW_CTXT_ACTION_ADD)?;
+        self.mac_added = true;
+        Ok(())
+    }
+
+    /// The platform's crystal latency, for firmware that asks for it
+    /// (`SOC_CONFIGURATION_CMD`).
+    fn soc_configuration(&mut self) -> Result<(), String> {
+        if !self.soc_latency {
+            return Ok(());
+        }
+        let (latency, ltr_delay, low_latency) = ids::soc_latency(self.mac);
+        let mut flags = if self.mac.integrated { 0 } else { SOC_CONFIG_CMD_FLAGS_DISCRETE };
+        if self.mac.integrated {
+            flags |= (ltr_delay as u32) << 2;
+        }
+        if low_latency {
+            flags |= SOC_CONFIG_CMD_FLAGS_LOW_LATENCY;
+        }
+        self.command(SYSTEM, SOC_CONFIGURATION_CMD, &Out::default().u32(flags).u32(latency).0).map(|_| ())
+    }
+
+    /// The firmware's region as it knows it ("ZZ": the world's until an
+    /// access point says where it is), with LAR.
+    fn region(&mut self) {
+        if !self.lar {
+            return;
+        }
+        let mut mcc = Out::default();
+        mcc.u16(u16::from_be_bytes(*b"ZZ")).u8(MCC_SOURCE_GET_CURRENT).u8(0).u32(0).zeros(20);
+        if let Err(error) = self.command(0, MCC_UPDATE_CMD, &mcc.0) {
+            ostd::info!("{}: region: {}", self.name, error);
+        }
+    }
+
+    /// The supplicant opened (or closed) the port: data frames go at the
+    /// rate control's rates once it is open.
+    pub(crate) fn authorize(&mut self, authorized: bool) {
+        self.authorized = authorized;
+    }
+
+    /// The AX210 family's platform NVM data: the part of the `.pnvm` file
+    /// for this card's SKU (from ALIVE), then the doorbell, then the
+    /// firmware's word that it took it. Without the file the firmware runs
+    /// on its own defaults.
+    fn load_pnvm(&mut self, alive: &[u8], prefix: &str) -> Result<(), String> {
+        let sku = [le32(alive, 116), le32(alive, 120), le32(alive, 124)];
+        if sku == [0; 3] {
+            return Ok(());
+        }
+        let mut data = Vec::new();
+        let files = ids::pnvm_files(prefix);
+        match aster_firmware::load_first(files.iter().map(String::as_str)) {
+            Some((file_name, file)) => {
+                match fw::pnvm_data(&file, sku, ids::mac_type(self.trans.hw_rev), ids::rf_type(self.trans.hw_rf_id)) {
+                    Some(found) => {
+                        ostd::info!("{}: platform NVM data from {} ({} bytes)", self.name, file_name, found.len());
+                        data = found;
+                    }
+                    None => ostd::info!("{}: {} has nothing for this card", self.name, file_name),
+                }
+            }
+            None => ostd::info!("{}: no {} in /lib/firmware", self.name, files[0]),
+        }
+        self.trans.load_pnvm(&data).map_err(|error| format!("platform NVM data: {error:?}"))?;
+        if let Err(error) = self.notification(REGULATORY, PNVM_INIT_COMPLETE_NTFY, COMMAND_TIMEOUT_MS) {
+            ostd::info!("{}: platform NVM data: {}", self.name, error);
+        }
+        Ok(())
+    }
+
+    /// What this card is for the Wi-Fi component.
+    pub(crate) fn info(&self) -> Info {
+        let rx_streams = self.rx_ant.count_ones().clamp(1, 2) as usize;
+        let ht = self.ht.then(|| {
+            let mut mcs = [0u8; 16];
+            for stream in 0..rx_streams {
+                mcs[stream] = 0xff;
+            }
+            // The transmit MCS set is the receive one.
+            mcs[12] = 0x01;
+            // 20 MHz only, short GI at 20 MHz, static SM power save off,
+            // one receive STBC stream.
+            HtCap { info: 0x000c | 0x0020 | 0x0100, ampdu_factor: 3, ampdu_density: 5, mcs }
+        });
+        let mut bands = Vec::new();
+        if self.band_24 {
+            bands.push(Band { id: BandId::Ghz2, channels: channels(BandId::Ghz2), ht, vht: None, he: None });
+        }
+        if self.band_52 {
+            bands.push(Band { id: BandId::Ghz5, channels: channels(BandId::Ghz5), ht, vht: None, he: None });
+        }
+        // The first generation's firmware takes CCMP-256 as an external
+        // cipher only (Linux does not offer it there).
+        // The 8000 family's older receive path decrypts CCMP only.
+        let ciphers = if self.legacy_rx {
+            vec![radio::CIPHER_CCMP]
+        } else if self.gen1 {
+            vec![radio::CIPHER_CCMP, radio::CIPHER_GCMP, radio::CIPHER_GCMP_256]
+        } else {
+            vec![radio::CIPHER_CCMP, radio::CIPHER_GCMP, radio::CIPHER_GCMP_256, radio::CIPHER_CCMP_256]
+        };
+        Info {
+            driver: String::from("iwlwifi"),
+            address: self.address,
+            bands,
+            ciphers,
+            max_scan_ssids: PROBE_OPTION_MAX as u8,
+            max_scan_ie_len: 300,
+        }
+    }
+
+    // ---- Contexts. ----
+
+    /// The MAC context (`struct iwl_mac_ctx_cmd`, 148 bytes): the station,
+    /// its network when there is one, associated or not.
+    fn mac_context(&mut self, action: u32) -> Result<(), String> {
+        let network = self.network.clone();
+        let bssid = network.as_ref().map_or(wifi::BROADCAST, |network| network.bssid);
+        let ghz2 = network.as_ref().is_none_or(|network| BandId::of(network.freq) == BandId::Ghz2);
+        let mut out = Out::default();
+        out.u32(0).u32(action).u32(FW_MAC_TYPE_BSS_STA).u32(0);
+        out.bytes(&self.address).u16(0).bytes(&bssid).u16(0);
+        // Basic rates: CCK 1, 2, 5.5 and 11 Mbit/s on 2.4 GHz; OFDM 6, 12
+        // and 24.
+        out.u32(if ghz2 { 0x0f } else { 0 }).u32(0x15);
+        out.u32(0);
+        let capability = network.as_ref().map_or(0, |network| network.capability);
+        out.u32(if capability & wifi::CAP_SHORT_PREAMBLE != 0 { MAC_FLG_SHORT_PREAMBLE } else { 0 });
+        out.u32(if capability & wifi::CAP_SHORT_SLOT != 0 || !ghz2 { MAC_FLG_SHORT_SLOT } else { 0 });
+        let mut filter = MAC_FILTER_ACCEPT_GRP;
+        if !self.associated {
+            filter |= MAC_FILTER_IN_BEACON;
+        }
+        out.u32(filter);
+        let ht = network.as_ref().is_some_and(|network| network.ht_mcs.is_some());
+        out.u32(MAC_QOS_FLG_UPDATE_EDCA | if ht && self.associated { MAC_QOS_FLG_TGN } else { 0 });
+        // EDCA by the firmware's AC order (BK, BE, VI, VO): the defaults,
+        // each on its FIFO (gen2: BK 1, BE 2, VI 3, VO 4; the first
+        // generation's one lower).
+        let first_fifo = if self.gen1 { 0 } else { 1 };
+        for (index, (cw_min, cw_max, aifsn, txop)) in [(15u16, 1023u16, 7u8, 0u16), (15, 1023, 3, 0), (7, 15, 2, 3008), (3, 7, 2, 1504)].into_iter().enumerate() {
+            out.u16(cw_min).u16(cw_max).u8(aifsn).u8(1 << (first_fifo + index)).u16(txop);
+        }
+        out.zeros(8);
+        // The station's part of the union (48 bytes).
+        let (interval, dtim) = network.as_ref().map_or((0, 1), |network| (network.beacon_interval as u32, network.dtim_period.max(1) as u32));
+        out.u32(self.associated as u32).u32(0).u64(0).u32(interval).u32(0).u32(interval * dtim).u32(0).u32(1);
+        out.u32(if self.associated { self.aid as u32 } else { 0 }).u32(0);
+        out.zeros(4);
+        debug_assert_eq!(out.0.len(), 148);
+        self.command(0, MAC_CONTEXT_CMD, &out.0).map(|_| ())
+    }
+
+    fn lmac_id(&self, freq: u16) -> u32 {
+        if self.cdb && BandId::of(freq) != BandId::Ghz2 { 1 } else { 0 }
+    }
+
+    /// The PHY context on the network's channel, 20 MHz.
+    fn phy_context(&mut self, action: u32, freq: u16) -> Result<(), String> {
+        if self.gen1 {
+            return self.phy_context_v1(action, freq);
+        }
+        let band = if BandId::of(freq) == BandId::Ghz2 { PHY_BAND_24 } else { PHY_BAND_5 };
+        let channel = channel_number(freq);
+        let mut out = Out::default();
+        out.u32(0).u32(action);
+        if self.uhb {
+            out.u32(channel as u32).u8(band).u8(0).u8(0).u8(0);
+        } else {
+            out.u8(band).u8(channel).u8(0).u8(0).zeros(4);
+        }
+        out.u32(self.lmac_id(freq));
+        let chains = self.rx_ant.count_ones().clamp(1, 2);
+        out.u32(((self.rx_ant as u32) << PHY_RX_CHAIN_VALID_POS) | (chains << PHY_RX_CHAIN_CNT_POS) | (chains << PHY_RX_CHAIN_MIMO_CNT_POS));
+        out.u32(0).u8(0).zeros(3);
+        self.command(0, PHY_CONTEXT_CMD, &out.0).map(|_| ())
+    }
+
+    fn binding(&mut self, action: u32, freq: u16) -> Result<(), String> {
+        if self.gen1 {
+            return self.binding_v1(action);
+        }
+        let mut out = Out::default();
+        out.u32(0).u32(action).u32(0).u32(FW_CTXT_INVALID).u32(FW_CTXT_INVALID).u32(0).u32(self.lmac_id(freq));
+        self.command_status(0, BINDING_CONTEXT_CMD, &out.0, 0)
+    }
+
+    /// The access point's station (`struct iwl_mvm_add_sta_cmd`, 48
+    /// bytes): added, or changed once associated.
+    fn station(&mut self, modify: bool) -> Result<(), String> {
+        let network = self.network.clone().unwrap_or_default();
+        let mut flags = 0;
+        if self.associated && let Some(mcs) = network.ht_mcs {
+            flags |= STA_FLG_MAX_AGG_SIZE_64K | ((network.ampdu_density as u32 & 7) << STA_FLG_AGG_MPDU_DENS_SHIFT);
+            if mcs[1] != 0 && self.rx_ant.count_ones() >= 2 && self.tx_ant.count_ones() >= 2 {
+                flags |= STA_FLG_MIMO_EN_MIMO2;
+            }
+        }
+        let mut out = Out::default();
+        out.u8(modify as u8).u8(0).u16(0xffff).u32(0).bytes(&network.bssid).u16(0);
+        out.u8(0).u8(0).u16(0).u32(flags).u32(STA_FLG_FAT_EN_MSK | STA_FLG_MIMO_EN_MSK | STA_FLG_RTS_MIMO_PROT);
+        out.u8(0).u8(0).u16(0).u16(0).u8(0);
+        // A link station, with its queues when the host owns them.
+        out.u8(0).u16(if self.associated { self.aid } else { 0 }).u16(0).u32(self.station_queues).u16(0).u8(0).u8(0);
+        self.command_status(0, ADD_STA, &out.0, ADD_STA_SUCCESS)
+    }
+
+    /// A queue of the access point's station for `tid`: its memory, then
+    /// the firmware's number for it.
+    fn add_queue(&mut self, tid: u8) -> Result<TxQueue, String> {
+        let mut queue = self.trans.new_tx_queue().map_err(|error| format!("queue memory: {error:?}"))?;
+        let mut out = Out::default();
+        out.u32(0).u32(1).u8(tid).zeros(3).u32(0).u32(TX_QUEUE_SIZE.ilog2() - 3).u64(queue.counts_address()).u64(queue.tfds_address());
+        let answer = self.command(DATA_PATH, SCD_QUEUE_CONFIG_CMD, &out.0)?;
+        if answer.len() < 6 {
+            return Err(String::from("the firmware gave no queue"));
+        }
+        self.trans.tx_queue_started(&mut queue, le16(&answer, 0), le16(&answer, 4));
+        Ok(queue)
+    }
+
+    fn remove_queue(&mut self, tid: u8) {
+        let mut out = Out::default();
+        out.u32(1).u32(1).u32(tid as u32).zeros(24);
+        let _ = self.command(DATA_PATH, SCD_QUEUE_CONFIG_CMD, &out.0);
+    }
+
+    fn session_protection(&mut self, action: u32) -> Result<(), String> {
+        let mut out = Out::default();
+        out.u32(0).u32(action).u32(SESSION_PROTECT_CONF_ASSOC).u32(SESSION_PROTECTION_TU).u32(1).u32(0);
+        self.command(MAC_CONF, SESSION_PROTECTION_CMD, &out.0).map(|_| ())
+    }
+
+    /// The firmware's rate control for the access point (`struct
+    /// iwl_tlc_config_cmd_v4`): the legacy rates of the band, and MCS 0 to 7
+    /// on each stream both sides have, at 20 MHz.
+    fn rate_control(&mut self) -> Result<(), String> {
+        let network = self.network.clone().unwrap_or_default();
+        let ghz2 = BandId::of(network.freq) == BandId::Ghz2;
+        let legacy: u16 = if ghz2 { 0x0fff } else { 0x0ff0 };
+        let mut out = Out::default();
+        out.u8(0).zeros(3).u8(0);
+        let mut ht_rates = [[0u16; 3]; 2];
+        let mode = match network.ht_mcs {
+            Some(mcs) if self.ht => {
+                let streams = (self.tx_ant.count_ones() as usize).clamp(1, 2);
+                for stream in 0..streams {
+                    if mcs[stream] != 0 {
+                        ht_rates[stream][0] = mcs[stream] as u16;
+                    }
+                }
+                1
+            }
+            _ => 0,
+        };
+        out.u8(mode).u8(self.tx_ant & 3).u8(if network.ht_short_gi { 1 } else { 0 }).u16(0).u16(legacy);
+        for stream in ht_rates {
+            for width in stream {
+                out.u16(width);
+            }
+        }
+        out.u16(3839).u16(0);
+        self.command(DATA_PATH, TLC_MNG_CONFIG_CMD, &out.0).map(|_| ())
+    }
+
+    fn mac_power(&mut self) -> Result<(), String> {
+        // Power management off; the access point is kept alive every 25 s.
+        let mut out = Out::default();
+        out.u32(0).u16(0).u16(25).zeros(32);
+        self.command(0, MAC_PM_POWER_TABLE, &out.0).map(|_| ())
+    }
+
+    // ---- The radio's operations. ----
+
+    pub(crate) fn scan(&mut self, request: &ScanRequest) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if self.scanning {
+            return Err(radio::Error::Busy);
+        }
+        let freqs: Vec<u16> = request
+            .freqs
+            .iter()
+            .copied()
+            .filter(|&freq| match BandId::of(freq) {
+                BandId::Ghz2 => self.band_24,
+                BandId::Ghz5 => self.band_52,
+                BandId::Ghz6 => false,
+            })
+            .filter(|&freq| channel_number(freq) != 0)
+            .take(self.scan_channels)
+            .collect();
+        if freqs.is_empty() {
+            return Err(radio::Error::Invalid);
+        }
+        let command = if self.gen1 { self.scan_request_gen1(request, &freqs) } else { self.scan_request(request, &freqs) };
+        if let Err(error) = self.command(LONG, SCAN_REQ_UMAC, &command) {
+            ostd::warn!("{}: scan: {}", self.name, error);
+            return Err(radio::Error::Failed);
+        }
+        self.scanning = true;
+        Ok(())
+    }
+
+    /// `struct iwl_scan_req_umac_v17` as version 15 takes it (1940 bytes).
+    fn scan_request(&self, request: &ScanRequest, freqs: &[u16]) -> Vec<u8> {
+        let ssids: Vec<&Vec<u8>> = request.ssids.iter().take(PROBE_OPTION_MAX).collect();
+        let mut flags = SCAN_GEN_FLAGS_PASS_ALL | SCAN_GEN_FLAGS_ADAPTIVE_DWELL;
+        if ssids.is_empty() {
+            flags |= SCAN_GEN_FLAGS_FORCE_PASSIVE;
+        } else if ssids.len() == 1 && !ssids[0].is_empty() {
+            flags |= SCAN_GEN_FLAGS_USE_ALL_RX_CHAINS;
+        }
+        // Linux's timing for a scan without a link, and the wild one with.
+        let (max_out, suspend) = if self.associated { (120u32, 30u32) } else { (0, 0) };
+        let budget: u16 = if ssids.len() == 1 && !ssids[0].is_empty() { 100 } else { 300 };
+        let mut out = Out::default();
+        // uid, out-of-channel priority.
+        out.u32(0).u32(6);
+        // General parameters (36 bytes).
+        out.u16(flags).u8(0).u8(0).u8(10).u8(10).u8(2).u8(8).u8(10).u8(0).u16(budget);
+        out.u32(max_out).u32(max_out).u32(suspend).u32(suspend).u32(6).u8(110).u8(110).u8(0).u8(0);
+        // Channel parameters (540 bytes): each channel probes for all the
+        // names (bit i: the i-th of `direct_scan`).
+        let bitmap: u32 = if ssids.is_empty() { 0 } else { (1u32 << ssids.len()) - 1 };
+        out.u8(SCAN_CHANNEL_FLAG_ENABLE_CHAN_ORDER).u8(freqs.len() as u8).u8(10).u8(2);
+        for index in 0..SCAN_MAX_CHANNELS {
+            match freqs.get(index) {
+                Some(&freq) => {
+                    let band = if BandId::of(freq) == BandId::Ghz2 { PHY_BAND_24 } else { PHY_BAND_5 };
+                    out.u32(bitmap).u8(channel_number(freq)).u8(band).u8(1).u8(0);
+                }
+                None => {
+                    out.zeros(8);
+                }
+            }
+        }
+        // Periodic parameters: one iteration, now.
+        out.u16(0).u8(1).u8(0).zeros(4).u16(0).u16(0);
+        // Probe parameters: the template, then the names.
+        let (template, segments) = self.probe_template(&request.elements);
+        for (offset, length) in segments {
+            out.u16(offset).u16(length);
+        }
+        let mut buffer = template;
+        buffer.resize(PROBE_TEMPLATE, 0);
+        out.bytes(&buffer);
+        out.u8(0).u8(0).u16(0);
+        for index in 0..PROBE_OPTION_MAX {
+            match ssids.get(index) {
+                Some(ssid) => {
+                    let mut entry = [0u8; 34];
+                    entry[1] = ssid.len().min(32) as u8;
+                    entry[2..2 + ssid.len().min(32)].copy_from_slice(&ssid[..ssid.len().min(32)]);
+                    out.bytes(&entry);
+                }
+                None => {
+                    out.zeros(34);
+                }
+            }
+        }
+        out.zeros(8 * 4 + 16 * 6);
+        debug_assert_eq!(out.0.len(), 1940);
+        out.0
+    }
+
+    /// The probe request the firmware sends (`struct iwl_scan_probe_req`):
+    /// the header and an empty name (the firmware puts each name in), the
+    /// 2.4 GHz part (rates, DS parameters, HT), the 5 GHz part (rates, HT),
+    /// none for 6 GHz, and the supplicant's elements. Returns the bytes and
+    /// the five segments (header, three bands, common).
+    fn probe_template(&self, common: &[u8]) -> (Vec<u8>, [(u16, u16); 5]) {
+        let mut buf = wifi::probe_request(&self.address, &[], &[], &[]);
+        // Just the header and the empty name element.
+        buf.truncate(wifi::HEADER + 2);
+        let header = (0u16, buf.len() as u16);
+        let ht = self.info().bands.first().and_then(|band| band.ht);
+        let band_part = |buf: &mut Vec<u8>, rates: &[u8], ds: bool| -> (u16, u16) {
+            let start = buf.len();
+            wifi::put_rates(buf, rates);
+            if ds {
+                wifi::put_element(buf, wifi::IE_DS_PARAMS, &[0]);
+            }
+            if let Some(ht) = ht {
+                wifi::put_element(buf, wifi::IE_HT_CAP, &ht.element());
+            }
+            (start as u16, (buf.len() - start) as u16)
+        };
+        let ghz2 = band_part(&mut buf, BandId::Ghz2.rates(), true);
+        let ghz5 = band_part(&mut buf, BandId::Ghz5.rates(), false);
+        let ghz6 = (buf.len() as u16, 0);
+        let room = PROBE_TEMPLATE.saturating_sub(buf.len());
+        let common = &common[..common.len().min(room)];
+        let shared = (buf.len() as u16, common.len() as u16);
+        buf.extend_from_slice(common);
+        (buf, [header, ghz2, ghz5, ghz6, shared])
+    }
+
+    pub(crate) fn abort_scan(&mut self) {
+        if self.scanning {
+            let _ = self.command(LONG, SCAN_ABORT_UMAC, &Out::default().u32(0).u32(0).0);
+        }
+    }
+
+    pub(crate) fn join(&mut self, join: &Join) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        self.leave();
+        let elements = wifi::Elements(&join.elements);
+        let ht_cap = elements.get(wifi::IE_HT_CAP).filter(|value| value.len() >= 26);
+        let network = Network {
+            bssid: join.bssid,
+            freq: join.freq,
+            beacon_interval: join.beacon_interval.max(1),
+            // The TIM element: count, period, ...
+            dtim_period: elements.get(5).and_then(|value| value.get(1).copied()).unwrap_or(1).max(1),
+            capability: join.capability,
+            ht_mcs: ht_cap.map(|value| {
+                let mut mcs = [0u8; 16];
+                mcs.copy_from_slice(&value[3..19]);
+                mcs
+            }),
+            ht_short_gi: ht_cap.is_some_and(|value| u16::from_le_bytes([value[0], value[1]]) & 0x0020 != 0),
+            ampdu_density: ht_cap.map_or(0, |value| (value[2] >> 2) & 7),
+        };
+        self.network = Some(network);
+        let result = self.join_steps(join.freq);
+        if let Err(error) = &result {
+            ostd::warn!("{}: joining {}: {}", self.name, Hex(&join.bssid), error);
+            self.leave();
+            return Err(radio::Error::Failed);
+        }
+        Ok(())
+    }
+
+    fn join_steps(&mut self, freq: u16) -> Result<(), String> {
+        self.phy_context(FW_CTXT_ACTION_ADD, freq)?;
+        self.phy_added = true;
+        self.binding(FW_CTXT_ACTION_ADD, freq)?;
+        self.binding_added = true;
+        self.mac_context(FW_CTXT_ACTION_MODIFY)?;
+        if self.gen1 {
+            // The host's queues first, on their FIFOs, then the station
+            // that has them; the channel held by a time event.
+            self.add_queues_gen1()?;
+            self.station(false)?;
+            self.station_added = true;
+            self.reset_rates();
+            return self.time_event_add();
+        }
+        self.station(false)?;
+        self.station_added = true;
+        let management = self.add_queue(IWL_MGMT_TID)?;
+        self.management_queue = Some(management);
+        let data = self.add_queue(0)?;
+        self.data_queue = Some(data);
+        self.session_protection(FW_CTXT_ACTION_ADD)?;
+        Ok(())
+    }
+
+    pub(crate) fn associated(&mut self, association: &Association) -> radio::Result<()> {
+        if self.network.is_none() {
+            return Err(radio::Error::Invalid);
+        }
+        self.associated = true;
+        self.aid = association.aid & 0x3fff;
+        self.qos = association.qos;
+        // The association response's HT capabilities are the ones that
+        // count.
+        if let Some(value) = wifi::Elements(&association.elements).get(wifi::IE_HT_CAP).filter(|value| value.len() >= 26)
+            && let Some(network) = self.network.as_mut()
+        {
+            let mut mcs = [0u8; 16];
+            mcs.copy_from_slice(&value[3..19]);
+            network.ht_mcs = Some(mcs);
+            network.ht_short_gi = u16::from_le_bytes([value[0], value[1]]) & 0x0020 != 0;
+            network.ampdu_density = (value[2] >> 2) & 7;
+        }
+        let result = (|| {
+            self.mac_context(FW_CTXT_ACTION_MODIFY)?;
+            self.station(true)?;
+            self.mac_power()?;
+            if self.gen1 {
+                // The driver's rates, from the association's capabilities.
+                self.reset_rates();
+                self.send_rates()?;
+                self.time_event_remove();
+                // The wild scan's timing, now that there is a link.
+                if let Err(error) = self.scan_config_gen1() {
+                    ostd::info!("{}: scan configuration: {}", self.name, error);
+                }
+                return Ok(());
+            }
+            self.rate_control()?;
+            let _ = self.session_protection(FW_CTXT_ACTION_REMOVE);
+            Ok::<(), String>(())
+        })();
+        if let Err(error) = result {
+            ostd::warn!("{}: association: {}", self.name, error);
+            self.associated = false;
+            return Err(radio::Error::Failed);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn leave(&mut self) {
+        let Some(network) = self.network.clone() else { return };
+        let was_associated = self.associated;
+        self.associated = false;
+        self.authorized = false;
+        self.pairwise = None;
+        if !self.dead {
+            if self.gen1 {
+                self.remove_queues_gen1();
+            } else {
+                if self.data_queue.take().is_some() {
+                    self.remove_queue(0);
+                }
+                if self.management_queue.take().is_some() {
+                    self.remove_queue(IWL_MGMT_TID);
+                }
+            }
+            if self.station_added {
+                let _ = self.command(0, REMOVE_STA, &[0, 0, 0, 0]);
+            }
+            if self.gen1 {
+                self.time_event_remove();
+            } else if was_associated {
+                let _ = self.session_protection(FW_CTXT_ACTION_REMOVE);
+            }
+            self.network = None;
+            let _ = self.mac_context(FW_CTXT_ACTION_MODIFY);
+            if self.binding_added {
+                let _ = self.binding(FW_CTXT_ACTION_REMOVE, network.freq);
+            }
+            if self.phy_added {
+                let _ = self.phy_context(FW_CTXT_ACTION_REMOVE, network.freq);
+            }
+        }
+        self.network = None;
+        self.data_queue = None;
+        self.management_queue = None;
+        self.station_queues = 0;
+        self.time_event = None;
+        self.station_added = false;
+        self.binding_added = false;
+        self.phy_added = false;
+        self.signal = None;
+        if self.gen1 && was_associated && !self.dead {
+            // The scan's timing without a link again.
+            let _ = self.scan_config_gen1();
+        }
+    }
+
+    pub(crate) fn set_key(&mut self, key: &Key) -> radio::Result<()> {
+        let flags = match key.cipher {
+            radio::CIPHER_CCMP | radio::CIPHER_CCMP_256 => STA_KEY_FLG_CCM,
+            radio::CIPHER_GCMP | radio::CIPHER_GCMP_256 => STA_KEY_FLG_GCMP,
+            _ => return Err(radio::Error::Unsupported),
+        };
+        if key.key.len() > 32 || key.index > 3 {
+            return Err(radio::Error::Invalid);
+        }
+        if (self.gen1 && key.cipher == radio::CIPHER_CCMP_256) || (self.legacy_rx && key.cipher != radio::CIPHER_CCMP) {
+            return Err(radio::Error::Unsupported);
+        }
+        let mut flags = flags | ((key.index as u16) << STA_KEY_FLG_KEYID_POS);
+        if key.key.len() == 32 {
+            flags |= STA_KEY_FLG_KEY_32BYTES;
+        }
+        if !key.pairwise {
+            flags |= STA_KEY_MULTICAST;
+        }
+        let mut material = [0u8; 32];
+        material[..key.key.len()].copy_from_slice(&key.key);
+        // The pairwise key at offset 0, the group's at their index.
+        let offset = if key.pairwise { 0 } else { key.index.max(1) };
+        let command = if self.gen1 {
+            // Version 1, as Linux sends it to this firmware.
+            Self::key_command_v1(offset, flags | STA_KEY_FLG_WEP_KEY_MAP, &material)
+        } else {
+            let mut out = Out::default();
+            out.u8(0).u8(offset).u16(flags).bytes(&material).zeros(16).u64(0).u64(0).u64(0);
+            out.0
+        };
+        if let Err(error) = self.command_status(0, ADD_STA_KEY, &command, ADD_STA_SUCCESS) {
+            ostd::warn!("{}: key: {}", self.name, error);
+            return Err(radio::Error::Failed);
+        }
+        if key.pairwise {
+            self.pairwise = Some(PairwiseKey { index: key.index, pn: 1, cipher: key.cipher, key: key.key.clone(), offset });
+        }
+        Ok(())
+    }
+
+    pub(crate) fn remove_key(&mut self, index: u8, pairwise: bool) {
+        let offset = if pairwise { 0 } else { index.max(1) };
+        let mut flags = STA_KEY_NOT_VALID | ((index as u16) << STA_KEY_FLG_KEYID_POS);
+        if !pairwise {
+            flags |= STA_KEY_MULTICAST;
+        }
+        let command = if self.gen1 {
+            Self::key_command_v1(offset, flags | STA_KEY_FLG_WEP_KEY_MAP, &[0; 32])
+        } else {
+            let mut out = Out::default();
+            out.u8(0).u8(offset).u16(flags).zeros(32 + 16 + 24);
+            out.0
+        };
+        let _ = self.command(0, ADD_STA_KEY, &command);
+        if pairwise {
+            self.pairwise = None;
+        }
+    }
+
+    // ---- Frames. ----
+
+    /// Puts the cipher's header (CCMP and GCMP share it) after the 802.11
+    /// header, with the pairwise key's next packet number.
+    fn insert_cipher_header(&mut self, frame: &mut Vec<u8>) -> bool {
+        let Some(key) = self.pairwise.as_mut() else { return false };
+        let pn = key.pn;
+        key.pn += 1;
+        let at = header_len(frame);
+        let header = [pn as u8, (pn >> 8) as u8, 0, 0x20 | (key.index << 6), (pn >> 16) as u8, (pn >> 24) as u8, (pn >> 32) as u8, (pn >> 40) as u8];
+        drop(frame.splice(at..at, header));
+        true
+    }
+
+    fn next_sequence(&mut self, frame: &mut [u8]) {
+        let qos = wifi::is_data(frame) && frame[0] & 0x80 != 0;
+        let slot = if qos { (frame.get(header_len(frame).saturating_sub(2)).copied().unwrap_or(0) & 0x0f) as usize } else { 16 };
+        let sequence = self.sequence[slot];
+        self.sequence[slot] = (sequence + 1) & 0x0fff;
+        if frame.len() >= 24 {
+            frame[22..24].copy_from_slice(&(sequence << 4).to_le_bytes());
+        }
+    }
+
+    /// Sends an 802.11 frame on a queue of the access point's station.
+    fn transmit(&mut self, mut frame: Vec<u8>, data: bool, encrypt: bool) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        let protected = frame.get(1).is_some_and(|flags| flags & wifi::PROTECTED != 0);
+        let encrypted = protected && encrypt && self.insert_cipher_header(&mut frame);
+        if protected && !encrypted {
+            // The Protected bit without a key: sent plain.
+            frame[1] &= !wifi::PROTECTED;
+        }
+        self.next_sequence(&mut frame);
+        if self.gen1 {
+            let queue = if data { self.data_queue.as_ref() } else { self.management_queue.as_ref() };
+            let Some(queue) = queue else { return Err(radio::Error::Down) };
+            let index = self.trans.tx_next_index(queue);
+            let (bytes, body_at) = self.tx_command_gen1(&frame, data, encrypted, queue.id, index);
+            let queue = if data { self.data_queue.as_mut() } else { self.management_queue.as_mut() };
+            let Some(queue) = queue else { return Err(radio::Error::Down) };
+            return self.trans.send_frame(queue, &bytes, body_at, frame.len()).map_err(|()| radio::Error::Busy);
+        }
+        let hdr = header_len(&frame);
+        let mut flags = if encrypted { 0 } else { IWL_TX_FLAGS_ENCRYPT_DIS };
+        if !data {
+            flags |= IWL_TX_FLAGS_HIGH_PRI;
+        }
+        let offload = ((hdr as u32 / 2) << TX_CMD_OFFLD_MH_SIZE) | if hdr % 4 != 0 { 1 << TX_CMD_OFFLD_PAD } else { 0 };
+        let queue = if data { self.data_queue.as_mut() } else { self.management_queue.as_mut() };
+        let Some(queue) = queue else { return Err(radio::Error::Down) };
+        let index = self.trans.tx_next_index(queue);
+        let mut bytes = Out::default();
+        bytes.u8(TX_CMD).u8(0).u16((((queue.id & 0x1f) as u16) << 8) | (index as u16 & 0xff));
+        if self.tx_cmd_v10 {
+            bytes.u16(frame.len() as u16).u16(flags as u16).u32(offload).zeros(8).u32(0).zeros(8);
+        } else {
+            bytes.u16(frame.len() as u16).u16(offload as u16).u32(flags).zeros(8).u32(0);
+        }
+        bytes.bytes(&frame[..hdr]);
+        let body_at = bytes.0.len().next_multiple_of(4);
+        bytes.0.resize(body_at, 0);
+        bytes.bytes(&frame[hdr..]);
+        self.trans.send_frame(queue, &bytes.0, body_at, frame.len()).map_err(|()| radio::Error::Busy)
+    }
+
+    pub(crate) fn send_management(&mut self, frame: &[u8]) -> radio::Result<()> {
+        if frame.len() < wifi::HEADER {
+            return Err(radio::Error::Invalid);
+        }
+        self.transmit(frame.to_vec(), false, true)
+    }
+
+    pub(crate) fn send(&mut self, ethernet: &[u8], plain: bool) -> radio::Result<()> {
+        let Some(network) = self.network.as_ref() else { return Err(radio::Error::Down) };
+        // The first generation's one data queue is BE's: every frame on it.
+        let tid = self.qos.then(|| if self.gen1 { self.data_tid_gen1() } else { wifi::tid_of(ethernet) });
+        let protected = !plain && self.pairwise.is_some();
+        let frame = wifi::data_from_ethernet(ethernet, &network.bssid, tid, protected).ok_or(radio::Error::Invalid)?;
+        self.transmit(frame, true, protected)
+    }
+
+    fn tx_response(&mut self, data: &[u8]) {
+        let frames = data.first().copied().unwrap_or(0) as usize;
+        let queue_id = le16(data, 36);
+        let status = le16(data, 40) & 0xff;
+        let ssn = le32(data, 40 + 4 * frames.max(1)) as u16;
+        if status != TX_STATUS_SUCCESS && status != TX_STATUS_DIRECT_DONE {
+            ostd::debug!("{}: frame on queue {} not sent (status {:#x})", self.name, queue_id, status);
+        }
+        let freed = [self.management_queue.as_mut(), self.data_queue.as_mut()].into_iter().flatten().find(|queue| queue.id == queue_id).map(|queue| {
+            self.trans.reclaim(queue, ssn);
+        });
+        if freed.is_some()
+            && let Some(device) = &self.device
+        {
+            device.ready_to_send();
+        }
+    }
+
+    fn rx_mpdu(&mut self, data: &[u8]) {
+        let desc = self.rx_desc_len;
+        if data.len() < desc {
+            return;
+        }
+        let length = le16(data, 0) as usize;
+        let flags2 = data[3];
+        let status = le32(data, 12);
+        if status & (RX_STATUS_CRC_OK | RX_STATUS_OVERRUN_OK) != (RX_STATUS_CRC_OK | RX_STATUS_OVERRUN_OK) {
+            return;
+        }
+        let (energy_a, energy_b, channel) = if self.ax210 { (data[40], data[41], data[42]) } else { (data[32], data[33], data[34]) };
+        let Some(body) = data.get(desc..(desc + length).min(data.len())) else { return };
+        if body.len() < wifi::HEADER {
+            return;
+        }
+        let frame: Vec<u8> = if flags2 & RX_MFLG2_PAD != 0 {
+            let hdr = header_len(body);
+            let mut frame = body[..hdr].to_vec();
+            frame.extend_from_slice(body.get(hdr + 2..).unwrap_or(&[]));
+            frame
+        } else {
+            body.to_vec()
+        };
+        let protected = frame[1] & wifi::PROTECTED != 0;
+        let security = (status >> 8) & 7;
+        let decrypted = protected && matches!(security, RX_STATUS_SEC_CCM | RX_STATUS_SEC_GCM) && status & RX_STATUS_MIC_OK != 0;
+        let energy = [energy_a, energy_b].into_iter().filter(|&energy| energy != 0).min().unwrap_or(127);
+        let signal = -(energy.min(127) as i16) as i8;
+        let freq = match channel {
+            1..=13 => 2407 + 5 * channel as u16,
+            14 => 2484,
+            _ => 5000 + 5 * channel as u16,
+        };
+        if let Some(network) = &self.network
+            && wifi::addresses(&frame).is_some_and(|(_, transmitter, _)| transmitter == network.bssid)
+        {
+            self.signal = Some(signal);
+        }
+        if let Some(device) = &self.device {
+            device.received(&frame, RxInfo { freq, signal, decrypted, security_header: if decrypted { 8 } else { 0 } });
+        }
+    }
+
+    pub(crate) fn link_stats(&self) -> LinkStats {
+        LinkStats { signal: self.signal, tx_rate: None }
+    }
+}
+
+/// An address for the log.
+struct Hex<'a>(&'a Address);
+
+impl core::fmt::Display for Hex<'_> {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        let a = self.0;
+        write!(f, "{:02x}:{:02x}:{:02x}:{:02x}:{:02x}:{:02x}", a[0], a[1], a[2], a[3], a[4], a[5])
+    }
+}
diff --git a/kernel/comps/iwlwifi/src/mvm/gen1.rs b/kernel/comps/iwlwifi/src/mvm/gen1.rs
new file mode 100644
index 0000000..4f68e4c
--- /dev/null
+++ b/kernel/comps/iwlwifi/src/mvm/gen1.rs
@@ -0,0 +1,912 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The 9000 family's commands (firmware API 46), and the 8000 family's
+//! (API 36: the same ones, the scan's older layout, frames on the older
+//! receive path), as Linux's `iwlmvm` sends them to the first generation of
+//! the transport.
+//!
+//! The firmware has two programs. The first calibrates the radio: the
+//! driver reads the NVM's PHY SKU section (bands, antennas), tells it the
+//! antennas and the calibrations to run, and keeps what it reports
+//! (`CALIB_RES_NOTIF_PHY_DB`) until it says it is done. The runtime
+//! program then gets its pages, those results back, the antennas and its
+//! calibrations, the queues' mode (DQA), an auxiliary station with its
+//! queue for scanning, and the scan configuration. The host owns the
+//! queue numbers: every queue is enabled with `SCD_QUEUE_CFG` on a FIFO,
+//! the management one on VO, data on BE. Rates are the driver's: a table
+//! of 16 retries (`LQ_CMD`) that moves up and down with how the frames
+//! fare. A time event keeps the card on the network's channel while it
+//! joins.
+
+use alloc::{format, string::String, vec, vec::Vec};
+
+use aster_wlan::{
+    ieee80211 as wifi,
+    radio::{self, BandId, ScanRequest},
+};
+
+use super::{
+    ADD_STA, ADD_STA_SUCCESS, BINDING_CONTEXT_CMD, FW_CTXT_ACTION_ADD, FW_CTXT_ACTION_REMOVE, FW_CTXT_INVALID, LONG, Mvm, Network,
+    PHY_BAND_24, PHY_BAND_5, PHY_CONTEXT_CMD, PHY_RX_CHAIN_CNT_POS, PHY_RX_CHAIN_MIMO_CNT_POS, PHY_RX_CHAIN_VALID_POS, PROBE_OPTION_MAX,
+    PROBE_TEMPLATE, SCAN_CFG_CMD, SESSION_PROTECTION_TU, TX_CMD, TX_STATUS_DIRECT_DONE, TX_STATUS_SUCCESS, channel_number, channels, header_len,
+    le16, le32, Out,
+};
+use crate::{fw::Firmware, trans::FRAME_LIMIT};
+
+// Commands and notifications of the long group.
+const LQ_CMD: u8 = 0x4e;
+const FW_PAGING_BLOCK_CMD: u8 = 0x4f;
+const TIME_EVENT_CMD: u8 = 0x29;
+pub(super) const TIME_EVENT_NOTIFICATION: u8 = 0x2a;
+const SCD_QUEUE_CFG: u8 = 0x1d;
+const PHY_CONFIGURATION_CMD: u8 = 0x6a;
+pub(super) const CALIB_RES_NOTIF_PHY_DB: u8 = 0x6b;
+const PHY_DB_CMD: u8 = 0x6c;
+const NVM_ACCESS_CMD: u8 = 0x88;
+pub(super) const INIT_COMPLETE_NOTIF: u8 = 0x04;
+/// The 8000 family's older receive path: the PHY's facts of the next
+/// frame (`struct iwl_rx_phy_info`), then the frame.
+pub(super) const REPLY_RX_PHY_CMD: u8 = 0xc0;
+// The other groups'.
+const PHY_OPS: u8 = 0x04;
+const TEMP_REPORTING_THRESHOLDS_CMD: u8 = 0x04;
+const DATA_PATH: u8 = 0x05;
+const DQA_ENABLE_CMD: u8 = 0x00;
+
+// Capabilities: the firmware keeps the card from overheating itself.
+const CAPA_CT_KILL_BY_FW: u32 = 74;
+const CAPA_TEMP_THS_REPORT_SUPPORT: u32 = 75;
+// API changes: the scan's adaptive dwell, and its second version.
+pub(super) const API_ADAPTIVE_DWELL: u32 = 32;
+pub(super) const API_ADAPTIVE_DWELL_V2: u32 = 42;
+
+/// The NVM's section with the radio's configuration and the SKU, read a
+/// chunk at a time.
+const NVM_SECTION_PHY_SKU: u16 = 12;
+/// The 8000 family's address override: six bytes after a word, unless
+/// it is the reserved one (Linux's `iwl_set_hw_address_family_8000`).
+const NVM_SECTION_MAC_OVERRIDE: u16 = 11;
+const NVM_MAC_OVERRIDE_AT: usize = 2;
+const NVM_MAC_RESERVED: [u8; 6] = [0x02, 0xcc, 0xaa, 0xff, 0xee, 0x00];
+const NVM_CHUNK: usize = 2048;
+const NVM_SECTION_MAX: usize = 32 * 1024;
+const NVM_STATUS_NOT_VALID_ADDRESS: u16 = 1;
+const NVM_SKU_24: u32 = 1 << 0;
+const NVM_SKU_52: u32 = 1 << 1;
+const NVM_SKU_11N: u32 = 1 << 2;
+const NVM_SKU_MIMO_DISABLED: u32 = 1 << 5;
+
+/// The calibration results (`IWL_PHY_DB_*`), in the order they go back:
+/// the configuration, the non-channel one, then each channel group's.
+const PHY_DB_CFG: u16 = 1;
+const PHY_DB_CALIB_NCH: u16 = 2;
+const PHY_DB_CALIB_CHG_PAPD: u16 = 4;
+const PHY_DB_CALIB_CHG_TXP: u16 = 5;
+/// The firmware's PHY configuration's antenna fields.
+const FW_PHY_CFG_CHAINS: u32 = 0xff << 16;
+/// How long the calibrations may take (`MVM_UCODE_CALIB_TIMEOUT`, with
+/// room).
+const CALIB_TIMEOUT_MS: u64 = 3_000;
+
+/// The paging command's flags (`PAGING_CMD_IS_SECURED`, `_IS_ENABLED`)
+/// and its block size in powers of two (32 KiB).
+const PAGING_SECURED: u32 = 1 << 9;
+const PAGING_ENABLED: u32 = 1 << 8;
+const PAGING_BLOCK_EXP: u32 = 15;
+const PAGING_BLOCKS_MAX: usize = 33;
+
+/// The host's queues (DQA): the auxiliary station's, the access point's
+/// management and data ones; their FIFOs; the TID of management frames.
+const AUX_QUEUE: u16 = 1;
+const MGMT_QUEUE: u16 = 5;
+const DATA_QUEUE: u16 = 10;
+const FIFO_BE: u8 = 1;
+const FIFO_VO: u8 = 3;
+const FIFO_MCAST: u8 = 5;
+const MAX_TID: u8 = 8;
+const SCD_CFG_DISABLE_QUEUE: u8 = 0;
+const SCD_CFG_ENABLE_QUEUE: u8 = 1;
+/// The stations: the access point's, and the auxiliary one of the MAC
+/// index the firmware keeps for it.
+pub(super) const AP_STA_ID: u8 = 0;
+const AUX_STA_ID: u8 = 1;
+const MAC_INDEX_AUX: u32 = 4;
+const STA_TYPE_AUX_ACTIVITY: u8 = 4;
+
+/// The time event that holds the channel while joining.
+const TE_BSS_STA_AGGRESSIVE_ASSOC: u32 = 0;
+const TE_POLICY_NOTIFY_START: u16 = 1 << 0;
+const TE_POLICY_NOTIFY_END: u16 = 1 << 1;
+const TE_POLICY_START_IMMEDIATELY: u16 = 1 << 11;
+const TE_MAX_DELAY_TU: u32 = 500;
+const TE_START_WAIT_MS: u64 = 500;
+
+/// TX command v6 (`struct iwl_tx_cmd_v6_params`).
+const TX_CMD_LEN: usize = 56;
+const TX_FLG_ACK: u32 = 1 << 3;
+const TX_FLG_STA_RATE: u32 = 1 << 4;
+const TX_FLG_MH_PAD: u32 = 1 << 20;
+const TX_OFFLD_MH_SIZE: u32 = 8;
+const TX_OFFLD_PAD: u32 = 13;
+const TX_SEC_CCM: u8 = 0x02;
+const TX_SEC_GCMP: u8 = 0x05;
+const TX_SEC_KEY_FROM_TABLE: u8 = 0x10;
+const TX_LIFE_TIME_INFINITE: u32 = u32::MAX;
+const TX_RTS_RETRY_LIMIT: u8 = 60;
+const TX_DATA_RETRY_LIMIT: u8 = 15;
+const TID_NON_QOS: u8 = 0;
+const PM_FRAME_NONE: u16 = 0;
+const PM_FRAME_MGMT: u16 = 2;
+const PM_FRAME_ASSOC: u16 = 3;
+/// The CCMP/GCMP header the driver writes after the 802.11 header.
+const CIPHER_HEADER: usize = 8;
+
+/// Rates in the firmware's first format (`rate_n_flags`, version 1):
+/// legacy ones by their PLCP value, CCK flagged; HT MCS 0-15; the
+/// antennas from bit 14.
+const RATE_HT: u32 = 0x100;
+const RATE_CCK: u32 = 0x200;
+const RATE_SGI: u32 = 0x2000;
+const RATE_ANT_POS: u32 = 14;
+const PLCP_1M: u32 = 10;
+const PLCP_2M: u32 = 20;
+const PLCP_5M: u32 = 55;
+const PLCP_11M: u32 = 110;
+const PLCP_6M: u32 = 13;
+const PLCP_9M: u32 = 15;
+const PLCP_12M: u32 = 5;
+const PLCP_18M: u32 = 7;
+const PLCP_24M: u32 = 9;
+const PLCP_36M: u32 = 11;
+const PLCP_48M: u32 = 1;
+const PLCP_54M: u32 = 3;
+/// The rate table (`struct iwl_lq_cmd`): 16 tries, aggregation limits.
+const LQ_ENTRIES: usize = 16;
+const LQ_AGG_TIME_LIMIT: u16 = 4000;
+const LQ_AGG_DISABLE_START: u8 = 3;
+const LQ_AGG_FRAME_LIMIT: u8 = 63;
+/// Frames per verdict of the rate control, and the share of them sent at
+/// the first try that moves it down or up.
+const RATE_WINDOW: u32 = 16;
+const RATE_DOWN_BELOW: u32 = 50;
+const RATE_UP_FROM: u32 = 90;
+
+/// The scan: configuration flags (`SCAN_CONFIG_FLAG_*`), its channels'
+/// flags (energy based scan), dwell times, the request's flags.
+const SCAN_CONFIG_ACTIVATE: u32 = 1 << 0;
+const SCAN_CONFIG_ALLOW_CHUB_REQS: u32 = 1 << 3;
+const SCAN_CONFIG_SET_TX_CHAINS: u32 = 1 << 8;
+const SCAN_CONFIG_SET_RX_CHAINS: u32 = 1 << 9;
+const SCAN_CONFIG_SET_AUX_STA_ID: u32 = 1 << 10;
+const SCAN_CONFIG_SET_ALL_TIMES: u32 = 1 << 11;
+const SCAN_CONFIG_SET_CHANNEL_FLAGS: u32 = 1 << 13;
+const SCAN_CONFIG_SET_LEGACY_RATES: u32 = 1 << 14;
+const SCAN_CONFIG_SET_MAC_ADDR: u32 = 1 << 15;
+const SCAN_CONFIG_CLEAR_FRAGMENTED: u32 = 1 << 17;
+const SCAN_CONFIG_N_CHANNELS_POS: u32 = 26;
+/// Every legacy rate (bits 0-7 OFDM, 8-11 CCK), supported and basic.
+const SCAN_CONFIG_RATES: u32 = 0x0fff | (0x0fff << 16);
+const CHANNEL_FLAG_EBS: u8 = 1 << 0;
+const CHANNEL_FLAG_ACCURATE_EBS: u8 = 1 << 1;
+const CHANNEL_FLAG_EBS_ADD: u8 = 1 << 2;
+const CHANNEL_FLAG_PRE_SCAN_PASSIVE2ACTIVE: u8 = 1 << 3;
+const SCAN_DWELL_ACTIVE: u8 = 10;
+const SCAN_DWELL_PASSIVE: u8 = 110;
+const SCAN_DWELL_FRAGMENTED: u8 = 44;
+const SCAN_DWELL_EXTENDED: u8 = 90;
+const SCAN_GEN_FLAGS_PASS_ALL: u16 = 1 << 2;
+const SCAN_GEN_FLAGS_PASSIVE: u16 = 1 << 3;
+const SCAN_GEN_FLAGS_PRE_CONNECT: u16 = 1 << 4;
+const SCAN_GEN_FLAGS_ADAPTIVE_DWELL: u16 = 1 << 13;
+const SCAN_GEN_FLAGS2_ALLOW_CHNL_REORDER: u8 = 1 << 1;
+const SCAN_PRIORITY_EXT_6: u32 = 6;
+const SCAN_ADWELL_N_APS: u8 = 2;
+const SCAN_ADWELL_N_APS_SOCIAL: u8 = 10;
+const SCAN_ADWELL_BUDGET_DIRECTED: u16 = 100;
+const SCAN_ADWELL_BUDGET_FULL: u16 = 300;
+/// The older receive path's frame status (`RX_MPDU_RES_STATUS_*`) and
+/// the PHY's facts (`struct iwl_rx_phy_info`): its flags (bit 0: 2.4 GHz),
+/// channel and the energy of each antenna.
+const RX_RES_CRC_OK: u32 = 1 << 0;
+const RX_RES_OVERRUN_OK: u32 = 1 << 1;
+const RX_RES_MIC_OK: u32 = 1 << 6;
+const RX_RES_SEC_MASK: u32 = 7 << 8;
+const RX_RES_SEC_CCM: u32 = 2 << 8;
+const RX_PHY_FLAGS: usize = 20;
+const RX_PHY_CHANNEL: usize = 22;
+const RX_PHY_ENERGY: usize = 24 + 4;
+const RX_PHY_BAND_24: u16 = 1 << 0;
+const CCMP_MIC: usize = 8;
+
+/// The driver's rate control: a ladder of the network's rates, slowest
+/// first, and where on it the first try goes.
+#[derive(Default)]
+pub(super) struct Rates {
+    ladder: Vec<u32>,
+    /// MIMO rates (two streams) on the ladder.
+    mimo: Vec<bool>,
+    top: usize,
+    /// The rate every table ends with: the band's lowest.
+    floor: u32,
+    sent: u32,
+    first_try: u32,
+    /// The table changed since the firmware last had it.
+    pub(super) dirty: bool,
+}
+
+fn legacy(plcp: u32, antenna: u32) -> u32 {
+    let cck = matches!(plcp, PLCP_1M | PLCP_2M | PLCP_5M | PLCP_11M);
+    plcp | if cck { RATE_CCK } else { 0 } | (antenna << RATE_ANT_POS)
+}
+
+impl Rates {
+    /// The ladder for a network: its band's legacy rates, or HT MCS 0-7
+    /// on one antenna and, with two antennas on both sides, the faster
+    /// two-stream ones.
+    fn for_network(network: &Network, ht: bool, tx_ant: u8) -> Self {
+        let single = (tx_ant & tx_ant.wrapping_neg()) as u32;
+        let both = (tx_ant & 0x3) as u32;
+        let ghz2 = BandId::of(network.freq) == BandId::Ghz2;
+        let floor = legacy(if ghz2 { PLCP_1M } else { PLCP_6M }, single);
+        let mut rates = Rates { floor, ..Rates::default() };
+        match network.ht_mcs {
+            Some(mcs) if ht => {
+                let sgi = if network.ht_short_gi { RATE_SGI } else { 0 };
+                for index in 0..8u32 {
+                    if mcs[0] & (1 << index) != 0 {
+                        rates.ladder.push(RATE_HT | sgi | index | (single << RATE_ANT_POS));
+                        rates.mimo.push(false);
+                    }
+                }
+                // The two-stream rates faster than one stream's fastest.
+                if both == 0x3 {
+                    for index in 12..16u32 {
+                        if mcs[1] & (1 << (index - 8)) != 0 {
+                            rates.ladder.push(RATE_HT | sgi | index | (both << RATE_ANT_POS));
+                            rates.mimo.push(true);
+                        }
+                    }
+                }
+                rates.top = rates.ladder.len().min(5).saturating_sub(1);
+            }
+            _ => {
+                let plcps: &[u32] = if ghz2 {
+                    &[PLCP_1M, PLCP_2M, PLCP_5M, PLCP_6M, PLCP_9M, PLCP_11M, PLCP_12M, PLCP_18M, PLCP_24M, PLCP_36M, PLCP_48M, PLCP_54M]
+                } else {
+                    &[PLCP_6M, PLCP_9M, PLCP_12M, PLCP_18M, PLCP_24M, PLCP_36M, PLCP_48M, PLCP_54M]
+                };
+                rates.ladder = plcps.iter().map(|&plcp| legacy(plcp, single)).collect();
+                rates.mimo = vec![false; rates.ladder.len()];
+                rates.top = rates.ladder.iter().position(|&rate| rate & 0xff == PLCP_24M).unwrap_or(0);
+            }
+        }
+        if rates.ladder.is_empty() {
+            rates.ladder.push(floor);
+            rates.mimo.push(false);
+            rates.top = 0;
+        }
+        rates.dirty = true;
+        rates
+    }
+
+    /// The 16 tries: the top rate twice, then each slower one, then the
+    /// floor; and how many lead with two streams.
+    fn table(&self) -> ([u32; LQ_ENTRIES], u8) {
+        let mut table = [self.floor; LQ_ENTRIES];
+        let mut at = 0;
+        let mut index = self.top as isize;
+        let mut first = true;
+        while index >= 0 && at < LQ_ENTRIES {
+            let tries = if first { 2 } else { 1 };
+            for _ in 0..tries {
+                if at < LQ_ENTRIES {
+                    table[at] = self.ladder[index as usize];
+                    at += 1;
+                }
+            }
+            first = false;
+            index -= 1;
+        }
+        let mut mimo = 0;
+        while mimo < LQ_ENTRIES && self.mimo_rate(table[mimo]) {
+            mimo += 1;
+        }
+        (table, mimo as u8)
+    }
+
+    fn mimo_rate(&self, rate: u32) -> bool {
+        self.ladder.iter().zip(&self.mimo).any(|(&known, &mimo)| mimo && known == rate)
+    }
+
+    /// A data frame's fate: up a rate when nearly all went at the first
+    /// try, down one when half did not.
+    fn feedback(&mut self, sent: bool, retries: u8) {
+        self.sent += 1;
+        if sent && retries == 0 {
+            self.first_try += 1;
+        }
+        if self.sent < RATE_WINDOW {
+            return;
+        }
+        let share = self.first_try * 100 / self.sent;
+        if share < RATE_DOWN_BELOW && self.top > 0 {
+            self.top -= 1;
+            self.dirty = true;
+        } else if share >= RATE_UP_FROM && self.top + 1 < self.ladder.len() {
+            self.top += 1;
+            self.dirty = true;
+        }
+        self.sent = 0;
+        self.first_try = 0;
+    }
+}
+
+impl Mvm {
+    // ---- The calibrating program. ----
+
+    /// Reads an NVM section through the firmware (`NVM_ACCESS_CMD`).
+    fn nvm_section(&mut self, section: u16) -> Result<Vec<u8>, String> {
+        let mut data = Vec::new();
+        while data.len() < NVM_SECTION_MAX {
+            let mut out = Out::default();
+            out.u8(0).u8(0).u16(section).u16(data.len() as u16).u16(NVM_CHUNK as u16);
+            let answer = self.command(0, NVM_ACCESS_CMD, &out.0)?;
+            let (length, status) = (le16(&answer, 2) as usize, le16(&answer, 6));
+            if status != 0 {
+                // Past the end of a section that fills whole chunks.
+                if status == NVM_STATUS_NOT_VALID_ADDRESS && !data.is_empty() {
+                    break;
+                }
+                return Err(format!("NVM section {section}: status {status:#x}"));
+            }
+            data.extend_from_slice(answer.get(8..8 + length).unwrap_or(&[]));
+            if length < NVM_CHUNK {
+                break;
+            }
+        }
+        Ok(data)
+    }
+
+    /// The calibrating program's run (Linux's `iwl_run_init_mvm_ucode`):
+    /// the NVM's facts, the antennas, the calibrations, their results.
+    pub(crate) fn run_init_image(&mut self, firmware: &Firmware) -> Result<(), String> {
+        match self.nvm_section(NVM_SECTION_PHY_SKU) {
+            Ok(sku) if sku.len() >= 8 => {
+                let radio = le32(&sku, 0);
+                let sku = le32(&sku, 4);
+                self.band_24 = sku & NVM_SKU_24 != 0;
+                self.band_52 = sku & NVM_SKU_52 != 0;
+                self.ht = sku & NVM_SKU_11N != 0;
+                let (tx, rx) = (((radio >> 24) & 0xf) as u8, ((radio >> 28) & 0xf) as u8);
+                if tx & self.tx_ant != 0 {
+                    self.tx_ant &= tx;
+                }
+                if rx & self.rx_ant != 0 {
+                    self.rx_ant &= rx;
+                }
+                if sku & NVM_SKU_MIMO_DISABLED != 0 {
+                    self.tx_ant &= self.tx_ant.wrapping_neg();
+                    self.rx_ant &= self.rx_ant.wrapping_neg();
+                }
+            }
+            Ok(_) => ostd::info!("{}: the NVM has no PHY SKU section", self.name),
+            Err(error) => ostd::info!("{}: {}", self.name, error),
+        }
+        if !self.band_24 && !self.band_52 {
+            self.band_24 = true;
+        }
+        if self.legacy_rx {
+            // The 8000 family's address: the NVM's override when it has
+            // a valid one (the MAC's own registers otherwise, later).
+            if let Ok(section) = self.nvm_section(NVM_SECTION_MAC_OVERRIDE)
+                && let Some(bytes) = section.get(NVM_MAC_OVERRIDE_AT..NVM_MAC_OVERRIDE_AT + 6)
+            {
+                let mut address = [0u8; 6];
+                address.copy_from_slice(bytes);
+                if address != [0; 6] && address[0] & 1 == 0 && address != NVM_MAC_RESERVED {
+                    self.address = address;
+                }
+            }
+        }
+        if self.trans.rf_kill() {
+            // The radio's switch is off: no calibrations until it is on.
+            return Err(String::from("the radio's switch is off"));
+        }
+        self.command(0, super::TX_ANT_CONFIGURATION_CMD, &(self.tx_ant as u32).to_le_bytes())?;
+        self.phy_configuration(firmware, true)?;
+        self.notification(LONG, INIT_COMPLETE_NOTIF, CALIB_TIMEOUT_MS)?;
+        ostd::info!("{}: calibrated, {} result(s) kept", self.name, self.phy_db.len());
+        Ok(())
+    }
+
+    /// The radio's configuration with its valid antennas and a program's
+    /// default calibrations (`PHY_CONFIGURATION_CMD` v1).
+    fn phy_configuration(&mut self, firmware: &Firmware, init: bool) -> Result<(), String> {
+        let chains = ((self.tx_ant as u32) << 16) | ((self.rx_ant as u32) << 20);
+        let config = (firmware.phy_config & (!FW_PHY_CFG_CHAINS | chains)) | self.extra_phy_config;
+        let (flow, event) = firmware.default_calib[init as usize];
+        let mut out = Out::default();
+        out.u32(config).u32(flow).u32(event);
+        self.command(0, PHY_CONFIGURATION_CMD, &out.0).map(|_| ())
+    }
+
+    /// A calibration result (`struct iwl_calib_res_notif_phy_db`): kept,
+    /// a channel group's in place of the one before for its group.
+    pub(super) fn store_phy_db(&mut self, data: &[u8]) {
+        let (kind, length) = (le16(data, 0), le16(data, 2) as usize);
+        let Some(entry) = data.get(4..4 + length) else { return };
+        let grouped = matches!(kind, PHY_DB_CALIB_CHG_PAPD | PHY_DB_CALIB_CHG_TXP);
+        let group = le16(entry, 0);
+        match self.phy_db.iter_mut().find(|(known, data)| *known == kind && (!grouped || le16(data, 0) == group)) {
+            Some(slot) => slot.1 = entry.to_vec(),
+            None => self.phy_db.push((kind, entry.to_vec())),
+        }
+    }
+
+    // ---- The runtime program. ----
+
+    /// Everything after the runtime program's ALIVE up to a radio ready
+    /// to scan (Linux's `iwl_mvm_up` for the 9000 family).
+    pub(super) fn init_gen1(&mut self, firmware: &Firmware, file: &[u8]) -> Result<(), String> {
+        match self.trans.load_paging(firmware, file) {
+            Ok(Some(paging)) => {
+                let mut out = Out::default();
+                out.u32(PAGING_SECURED | PAGING_ENABLED | paging.pages_in_last).u32(PAGING_BLOCK_EXP).u32(paging.blocks);
+                for index in 0..PAGING_BLOCKS_MAX {
+                    out.u32(paging.addresses.get(index).copied().unwrap_or(0));
+                }
+                self.command(LONG, FW_PAGING_BLOCK_CMD, &out.0)?;
+            }
+            Ok(None) => {}
+            Err(error) => return Err(format!("the firmware's pages: {error:?}")),
+        }
+        self.command(0, super::TX_ANT_CONFIGURATION_CMD, &(self.tx_ant as u32).to_le_bytes())?;
+        self.send_phy_db()?;
+        self.phy_configuration(firmware, false)?;
+        self.command(0, super::BT_CONFIG, &Out::default().u32(super::BT_COEX_NW).u32(0).0)?;
+        self.soc_configuration()?;
+        self.command(DATA_PATH, DQA_ENABLE_CMD, &0u32.to_le_bytes())?;
+        self.add_aux_station()?;
+        if firmware.has_capability(CAPA_CT_KILL_BY_FW) && firmware.has_capability(CAPA_TEMP_THS_REPORT_SUPPORT) {
+            // No thresholds: the firmware keeps the card from overheating.
+            if let Err(error) = self.command(PHY_OPS, TEMP_REPORTING_THRESHOLDS_CMD, &[0u8; 20]) {
+                ostd::info!("{}: temperature: {}", self.name, error);
+            }
+        }
+        self.command(0, super::POWER_TABLE_CMD, &Out::default().u16(0).u16(0).0)?;
+        self.region();
+        self.scan_config_gen1()?;
+        // The request's layout follows the firmware's API bits; a stated
+        // version should agree.
+        let built = if self.adaptive_dwell_v2 { 8 } else if self.adaptive_dwell { 7 } else { 1 };
+        if self.scan_version != crate::fw::VERSION_UNKNOWN && self.scan_version != built {
+            ostd::warn!("{}: the firmware's scan is version {}, this driver builds {}", self.name, self.scan_version, built);
+        }
+        Ok(())
+    }
+
+    /// The calibration results back to the runtime program (Linux's
+    /// `iwl_send_phy_db_data`).
+    fn send_phy_db(&mut self) -> Result<(), String> {
+        let mut entries = core::mem::take(&mut self.phy_db);
+        entries.sort_by_key(|(kind, data)| {
+            let order = match *kind {
+                PHY_DB_CFG => 0,
+                PHY_DB_CALIB_NCH => 1,
+                PHY_DB_CALIB_CHG_PAPD => 2,
+                PHY_DB_CALIB_CHG_TXP => 3,
+                _ => 4,
+            };
+            (order, le16(data, 0))
+        });
+        let result = (|| {
+            let sent = [PHY_DB_CFG, PHY_DB_CALIB_NCH, PHY_DB_CALIB_CHG_PAPD, PHY_DB_CALIB_CHG_TXP];
+            for (kind, data) in entries.iter().filter(|(kind, _)| sent.contains(kind)) {
+                let mut out = Out::default();
+                out.u16(*kind).u16(data.len() as u16).bytes(data);
+                self.command(0, PHY_DB_CMD, &out.0)?;
+            }
+            Ok::<(), String>(())
+        })();
+        self.phy_db = entries;
+        result
+    }
+
+    /// The scanning station (Linux's `iwl_mvm_add_aux_sta`): its queue on
+    /// the multicast FIFO, then the station of the auxiliary MAC.
+    fn add_aux_station(&mut self) -> Result<(), String> {
+        let queue = self.enable_queue(AUX_QUEUE, FIFO_MCAST, AUX_STA_ID, MAX_TID)?;
+        self.aux_queue = Some(queue);
+        let mut out = Out::default();
+        out.u8(0).u8(0).u16(0xffff).u32(MAC_INDEX_AUX).zeros(6).u16(0);
+        out.u8(AUX_STA_ID).u8(0).u16(0).u32(0).u32(0);
+        out.u8(0).u8(0).u16(0).u16(0).u8(0);
+        out.u8(STA_TYPE_AUX_ACTIVITY).u16(0).u16(0).u32(1 << AUX_QUEUE).u16(0).u8(0).u8(0);
+        self.command_status(0, ADD_STA, &out.0, ADD_STA_SUCCESS)
+    }
+
+    /// A queue of the host's (Linux's `iwl_mvm_enable_txq`): where it
+    /// starts, then its station, TID and FIFO to the firmware.
+    fn enable_queue(&mut self, number: u16, fifo: u8, station: u8, tid: u8) -> Result<crate::trans::TxQueue, String> {
+        let mut queue = self.trans.new_tx_queue().map_err(|error| format!("queue memory: {error:?}"))?;
+        self.trans.tx_queue_started(&mut queue, number, 0);
+        let mut out = Out::default();
+        out.u8(0).u8(station).u8(tid).u8(number as u8).u8(SCD_CFG_ENABLE_QUEUE).u8(0).u8(fifo).u8(FRAME_LIMIT as u8).u16(0).u16(0);
+        self.command(0, SCD_QUEUE_CFG, &out.0)?;
+        Ok(queue)
+    }
+
+    fn disable_queue(&mut self, number: u16, station: u8, tid: u8) {
+        let mut out = Out::default();
+        out.u8(0).u8(station).u8(tid).u8(number as u8).u8(SCD_CFG_DISABLE_QUEUE).zeros(3).u16(0).u16(0);
+        let _ = self.command(0, SCD_QUEUE_CFG, &out.0);
+    }
+
+    /// The scan configuration (`struct iwl_scan_config_v1`): the chains,
+    /// the legacy rates, times, dwells, the address, the auxiliary
+    /// station and every channel the card may scan.
+    pub(super) fn scan_config_gen1(&mut self) -> Result<(), String> {
+        let mut numbers: Vec<u8> = Vec::new();
+        if self.band_24 {
+            numbers.extend(channels(BandId::Ghz2).iter().map(|channel| channel_number(channel.freq)));
+        }
+        if self.band_52 {
+            numbers.extend(channels(BandId::Ghz5).iter().map(|channel| channel_number(channel.freq)));
+        }
+        numbers.truncate(self.scan_channels);
+        let flags = SCAN_CONFIG_ACTIVATE
+            | SCAN_CONFIG_ALLOW_CHUB_REQS
+            | SCAN_CONFIG_SET_TX_CHAINS
+            | SCAN_CONFIG_SET_RX_CHAINS
+            | SCAN_CONFIG_SET_AUX_STA_ID
+            | SCAN_CONFIG_SET_ALL_TIMES
+            | SCAN_CONFIG_SET_LEGACY_RATES
+            | SCAN_CONFIG_SET_MAC_ADDR
+            | SCAN_CONFIG_SET_CHANNEL_FLAGS
+            | ((numbers.len() as u32) << SCAN_CONFIG_N_CHANNELS_POS)
+            | SCAN_CONFIG_CLEAR_FRAGMENTED;
+        let (max_out, suspend) = self.scan_times();
+        let mut out = Out::default();
+        out.u32(flags).u32(self.tx_ant as u32).u32(self.rx_ant as u32).u32(SCAN_CONFIG_RATES).u32(max_out).u32(suspend);
+        out.u8(SCAN_DWELL_ACTIVE).u8(SCAN_DWELL_PASSIVE).u8(SCAN_DWELL_FRAGMENTED).u8(SCAN_DWELL_EXTENDED);
+        out.bytes(&self.address).u8(AUX_STA_ID);
+        out.u8(CHANNEL_FLAG_EBS | CHANNEL_FLAG_ACCURATE_EBS | CHANNEL_FLAG_EBS_ADD | CHANNEL_FLAG_PRE_SCAN_PASSIVE2ACTIVE);
+        let mut array = numbers;
+        array.resize(self.scan_slots, 0);
+        out.bytes(&array);
+        self.command(0, SCAN_CFG_CMD, &out.0).map(|_| ())
+    }
+
+    /// Linux's timing for a scan without a link, and the wild one with.
+    fn scan_times(&self) -> (u32, u32) {
+        if self.associated { (120, 30) } else { (0, 0) }
+    }
+
+    /// `struct iwl_scan_req_umac` v8 with `iwl_scan_req_umac_tail_v1`:
+    /// the general part, the firmware's channel slots and the tail with
+    /// the schedule, the probe template and the names.
+    pub(super) fn scan_request_gen1(&self, request: &ScanRequest, freqs: &[u16]) -> Vec<u8> {
+        let ssids: Vec<&Vec<u8>> = request.ssids.iter().take(PROBE_OPTION_MAX).collect();
+        let directed = ssids.len() == 1 && !ssids[0].is_empty();
+        let mut flags = SCAN_GEN_FLAGS_PASS_ALL;
+        if ssids.is_empty() {
+            flags |= SCAN_GEN_FLAGS_PASSIVE;
+        }
+        if directed {
+            flags |= SCAN_GEN_FLAGS_PRE_CONNECT;
+        }
+        if self.adaptive_dwell {
+            flags |= SCAN_GEN_FLAGS_ADAPTIVE_DWELL;
+        }
+        let (max_out, suspend) = self.scan_times();
+        let budget = if directed { SCAN_ADWELL_BUDGET_DIRECTED } else { SCAN_ADWELL_BUDGET_FULL };
+        let mut out = Out::default();
+        out.u32(0).u32(0).u32(SCAN_PRIORITY_EXT_6).u16(flags).u8(0).u8(0);
+        if self.adaptive_dwell_v2 {
+            // v8 (9000 family): dwells per LMAC, the adaptive dwell's
+            // defaults, the times, the passive dwells and fragments.
+            out.u8(SCAN_DWELL_ACTIVE).u8(0).u8(0).u8(SCAN_ADWELL_N_APS).u8(SCAN_ADWELL_N_APS_SOCIAL).u8(SCAN_GEN_FLAGS2_ALLOW_CHNL_REORDER);
+            out.u16(budget);
+            out.u32(max_out).u32(0).u32(suspend).u32(0).u32(SCAN_PRIORITY_EXT_6);
+            out.u8(SCAN_DWELL_PASSIVE).u8(0).u8(0).u8(0);
+        } else if self.adaptive_dwell {
+            // v7 (8000 family): one dwell each, the adaptive dwell's
+            // defaults, the times.
+            out.u8(SCAN_DWELL_ACTIVE).u8(SCAN_DWELL_PASSIVE).u8(SCAN_DWELL_FRAGMENTED).u8(SCAN_ADWELL_N_APS).u8(SCAN_ADWELL_N_APS_SOCIAL).u8(0);
+            out.u16(budget);
+            out.u32(max_out).u32(0).u32(suspend).u32(0).u32(SCAN_PRIORITY_EXT_6);
+        } else {
+            // v1: the dwells and one LMAC's times.
+            out.u8(SCAN_DWELL_EXTENDED).u8(SCAN_DWELL_ACTIVE).u8(SCAN_DWELL_PASSIVE).u8(SCAN_DWELL_FRAGMENTED);
+            out.u32(max_out).u32(suspend).u32(SCAN_PRIORITY_EXT_6);
+        }
+        // The channels: no energy based scan, their count.
+        out.u8(0).u8(freqs.len() as u8).u16(0);
+        let bitmap: u32 = if ssids.is_empty() { 0 } else { (1u32 << ssids.len()) - 1 };
+        for slot in 0..self.scan_slots {
+            match freqs.get(slot) {
+                Some(&freq) => {
+                    out.u32(bitmap).u8(channel_number(freq)).u8(1).u16(0);
+                }
+                None => {
+                    out.zeros(8);
+                }
+            }
+        }
+        // One iteration, now.
+        out.u16(0).u8(1).u8(0).zeros(4).u16(0).u16(0);
+        let (template, segments) = self.probe_template(&request.elements);
+        // The header, 2.4 GHz, 5 GHz, the shared part.
+        for index in [0, 1, 2, 4] {
+            out.u16(segments[index].0).u16(segments[index].1);
+        }
+        let mut buffer = template;
+        buffer.resize(PROBE_TEMPLATE, 0);
+        out.bytes(&buffer);
+        for index in 0..PROBE_OPTION_MAX {
+            let mut entry = [0u8; 34];
+            if let Some(ssid) = ssids.get(index) {
+                let length = ssid.len().min(32);
+                entry[1] = length as u8;
+                entry[2..2 + length].copy_from_slice(&ssid[..length]);
+            }
+            out.bytes(&entry);
+        }
+        out.0
+    }
+
+    // ---- Joining. ----
+
+    /// The PHY context, version 1 (`struct iwl_phy_context_cmd_v1`): the
+    /// channel at 20 MHz, the transmit and receive chains.
+    pub(super) fn phy_context_v1(&mut self, action: u32, freq: u16) -> Result<(), String> {
+        let band = if BandId::of(freq) == BandId::Ghz2 { PHY_BAND_24 } else { PHY_BAND_5 };
+        let channel = channel_number(freq);
+        let mut out = Out::default();
+        out.u32(0).u32(action).u32(0).u32(0);
+        if self.uhb {
+            out.u32(channel as u32).u8(band).u8(0).u8(0).u8(0);
+        } else {
+            out.u8(band).u8(channel).u8(0).u8(0);
+        }
+        let chains = self.rx_ant.count_ones().clamp(1, 2);
+        out.u32(self.tx_ant as u32);
+        out.u32(((self.rx_ant as u32) << PHY_RX_CHAIN_VALID_POS) | (chains << PHY_RX_CHAIN_CNT_POS) | (chains << PHY_RX_CHAIN_MIMO_CNT_POS));
+        out.u32(0).u32(0);
+        self.command(0, PHY_CONTEXT_CMD, &out.0).map(|_| ())
+    }
+
+    /// The binding, version 1: the MAC on the PHY, no LMAC.
+    pub(super) fn binding_v1(&mut self, action: u32) -> Result<(), String> {
+        let mut out = Out::default();
+        out.u32(0).u32(action).u32(0).u32(FW_CTXT_INVALID).u32(FW_CTXT_INVALID).u32(0);
+        self.command_status(0, BINDING_CONTEXT_CMD, &out.0, 0)
+    }
+
+    /// The access point's queues: management frames on VO, data on BE.
+    pub(super) fn add_queues_gen1(&mut self) -> Result<(), String> {
+        let management = self.enable_queue(MGMT_QUEUE, FIFO_VO, AP_STA_ID, MAX_TID)?;
+        self.management_queue = Some(management);
+        let data = self.enable_queue(DATA_QUEUE, FIFO_BE, AP_STA_ID, 0)?;
+        self.data_queue = Some(data);
+        self.station_queues = (1 << MGMT_QUEUE) | (1 << DATA_QUEUE);
+        Ok(())
+    }
+
+    pub(super) fn remove_queues_gen1(&mut self) {
+        if self.data_queue.take().is_some() {
+            self.disable_queue(DATA_QUEUE, AP_STA_ID, 0);
+        }
+        if self.management_queue.take().is_some() {
+            self.disable_queue(MGMT_QUEUE, AP_STA_ID, MAX_TID);
+        }
+        self.station_queues = 0;
+    }
+
+    /// The time event that keeps the card on the network's channel while
+    /// it authenticates and associates (Linux's `iwl_mvm_protect_session`),
+    /// waited for until it starts.
+    pub(super) fn time_event_add(&mut self) -> Result<(), String> {
+        let policy = TE_POLICY_NOTIFY_START | TE_POLICY_NOTIFY_END | TE_POLICY_START_IMMEDIATELY;
+        let mut out = Out::default();
+        out.u32(0).u32(FW_CTXT_ACTION_ADD).u32(TE_BSS_STA_AGGRESSIVE_ASSOC).u32(0).u32(TE_MAX_DELAY_TU).u32(0).u32(1).u32(SESSION_PROTECTION_TU);
+        out.u8(1).u8(0).u16(policy);
+        let answer = self.command(0, TIME_EVENT_CMD, &out.0)?;
+        if le32(&answer, 0) != 0 {
+            return Err(format!("time event refused (status {:#x})", le32(&answer, 0)));
+        }
+        let unique = le32(&answer, 8);
+        self.time_event = Some(unique);
+        let started = self.wait_for(TE_START_WAIT_MS, "the time event's start", |packet| {
+            packet.group <= LONG && packet.command == TIME_EVENT_NOTIFICATION && le32(&packet.data, 8) == unique && le32(&packet.data, 16) & 1 != 0
+        });
+        if let Err(error) = started {
+            ostd::info!("{}: {}", self.name, error);
+        }
+        Ok(())
+    }
+
+    pub(super) fn time_event_remove(&mut self) {
+        if let Some(unique) = self.time_event.take() {
+            let mut out = Out::default();
+            // The whole command (`struct iwl_time_event_cmd`, 36 bytes).
+            out.u32(0).u32(FW_CTXT_ACTION_REMOVE).u32(unique).zeros(24);
+            let _ = self.command(0, TIME_EVENT_CMD, &out.0);
+        }
+    }
+
+    /// The firmware's word on a time event: one that ended is gone.
+    pub(super) fn time_event_notification(&mut self, data: &[u8]) {
+        let (unique, action) = (le32(data, 8), le32(data, 16));
+        if action & 2 != 0 && self.time_event == Some(unique) {
+            self.time_event = None;
+        }
+    }
+
+    /// The rate table for the access point (`LQ_CMD`), from the rate
+    /// control's ladder.
+    pub(super) fn send_rates(&mut self) -> Result<(), String> {
+        let (table, mimo) = self.rates.table();
+        let single = self.tx_ant & self.tx_ant.wrapping_neg();
+        let mut out = Out::default();
+        out.u8(AP_STA_ID).u8(0).u16(0).u8(0).u8(mimo).u8(single).u8(self.tx_ant & 0x3);
+        out.zeros(4).u16(LQ_AGG_TIME_LIMIT).u8(LQ_AGG_DISABLE_START).u8(LQ_AGG_FRAME_LIMIT).u32(0);
+        for rate in table {
+            out.u32(rate);
+        }
+        out.u32(0);
+        self.rates.dirty = false;
+        self.command(0, LQ_CMD, &out.0).map(|_| ())
+    }
+
+    /// A new network's rates, from its HT capabilities.
+    pub(super) fn reset_rates(&mut self) {
+        let network = self.network.clone().unwrap_or_default();
+        self.rates = Rates::for_network(&network, self.ht, self.tx_ant);
+    }
+
+    // ---- Frames. ----
+
+    /// The band's lowest rate on the first antenna: management frames
+    /// and data before the port opens.
+    fn lowest_rate(&self, freq: u16) -> u32 {
+        let single = (self.tx_ant & self.tx_ant.wrapping_neg()) as u32;
+        legacy(if BandId::of(freq) == BandId::Ghz2 { PLCP_1M } else { PLCP_6M }, single)
+    }
+
+    /// The TX command (v6) with its 4-byte header, then the 802.11 header
+    /// padded to four bytes, then the body (which starts with the cipher's
+    /// header when encrypted). Returns the bytes and where the body is.
+    pub(super) fn tx_command_gen1(&self, frame: &[u8], data: bool, encrypted: bool, queue: u16, index: usize) -> (Vec<u8>, usize) {
+        let hdr = header_len(frame);
+        let unicast = frame.get(4).is_some_and(|byte| byte & 1 == 0);
+        let qos = data && frame[0] & 0x80 != 0;
+        let mut flags = if unicast { TX_FLG_ACK } else { 0 };
+        if hdr % 4 != 0 {
+            flags |= TX_FLG_MH_PAD;
+        }
+        // Data at the rate control's rates once the port is open (or on
+        // a network without keys); the handshake's frames at the lowest.
+        let body = frame.get(hdr + if encrypted { CIPHER_HEADER } else { 0 }..).unwrap_or(&[]);
+        let eapol = body.starts_with(&[0xaa, 0xaa, 0x03, 0x00, 0x00, 0x00, 0x88, 0x8e]);
+        let rate_table = data && self.associated && !eapol && (self.authorized || self.pairwise.is_none());
+        let rate = if rate_table {
+            flags |= TX_FLG_STA_RATE;
+            0
+        } else {
+            self.lowest_rate(self.network.as_ref().map_or(2412, |network| network.freq))
+        };
+        let tid = if qos { frame.get(hdr.saturating_sub(2)).copied().unwrap_or(0) & 0x0f } else if data { TID_NON_QOS } else { MAX_TID };
+        let subtype = frame[0] & 0xfc;
+        let pm_timeout = if data {
+            PM_FRAME_NONE
+        } else if subtype == 0x00 || subtype == 0x20 {
+            PM_FRAME_ASSOC
+        } else if subtype == 0xd0 {
+            PM_FRAME_NONE
+        } else {
+            PM_FRAME_MGMT
+        };
+        let iv = if encrypted { CIPHER_HEADER } else { 0 };
+        let offload = (((hdr + iv) as u32 / 2) << TX_OFFLD_MH_SIZE) | if hdr % 4 != 0 { 1 << TX_OFFLD_PAD } else { 0 };
+        let (sec_ctl, key) = match (&self.pairwise, encrypted) {
+            (Some(pairwise), true) if pairwise.cipher == radio::CIPHER_CCMP => {
+                let mut key = [0u8; 16];
+                let length = pairwise.key.len().min(16);
+                key[..length].copy_from_slice(&pairwise.key[..length]);
+                (TX_SEC_CCM, key)
+            }
+            (Some(pairwise), true) => {
+                let kind = if matches!(pairwise.cipher, radio::CIPHER_GCMP | radio::CIPHER_GCMP_256) { TX_SEC_GCMP } else { TX_SEC_CCM };
+                let mut key = [0u8; 16];
+                key[0] = pairwise.offset;
+                (kind | TX_SEC_KEY_FROM_TABLE, key)
+            }
+            _ => (0, [0u8; 16]),
+        };
+        let mut out = Out::default();
+        out.u8(TX_CMD).u8(0).u16(((queue & 0x1f) << 8) | (index as u16 & 0xff));
+        out.u16(frame.len() as u16).u16(offload as u16).u32(flags).u32(0).u32(rate);
+        out.u8(AP_STA_ID).u8(sec_ctl).u8(0).u8(0).bytes(&key).u32(0).u32(TX_LIFE_TIME_INFINITE);
+        out.u32(0).u8(0).u8(TX_RTS_RETRY_LIMIT).u8(TX_DATA_RETRY_LIMIT).u8(tid).u16(pm_timeout).u16(0);
+        debug_assert_eq!(out.0.len(), 4 + TX_CMD_LEN);
+        out.bytes(&frame[..hdr]);
+        let body_at = out.0.len().next_multiple_of(4);
+        out.0.resize(body_at, 0);
+        out.bytes(&frame[hdr..]);
+        (out.0, body_at)
+    }
+
+    /// The firmware sent a frame (`struct iwl_mvm_tx_resp_v3`): the
+    /// queue and index from the packet's sequence, the status after the
+    /// fixed part, the scheduler's next index after the statuses.
+    pub(super) fn tx_response_gen1(&mut self, sequence: u16, data: &[u8]) {
+        let queue_id = (sequence >> 8) & 0x1f;
+        let frames = data.first().copied().unwrap_or(0).max(1) as usize;
+        let retries = data.get(3).copied().unwrap_or(0);
+        let status = le16(data, 36) & 0xff;
+        let ssn = (le32(data, 36 + 4 * frames) & 0xfff) as u16;
+        let sent = status == TX_STATUS_SUCCESS || status == TX_STATUS_DIRECT_DONE;
+        if !sent {
+            ostd::debug!("{}: frame on queue {} not sent (status {:#x})", self.name, queue_id, status);
+        }
+        if queue_id == DATA_QUEUE && self.associated {
+            self.rates.feedback(sent, retries);
+        }
+        let freed = [self.management_queue.as_mut(), self.data_queue.as_mut(), self.aux_queue.as_mut()]
+            .into_iter()
+            .flatten()
+            .find(|queue| queue.id == queue_id)
+            .map(|queue| self.trans.reclaim(queue, ssn));
+        if freed.is_some()
+            && let Some(device) = &self.device
+        {
+            device.ready_to_send();
+        }
+    }
+
+    /// A frame on the older receive path (`struct iwl_rx_mpdu_res_start`,
+    /// the frame, its status), with the PHY's facts that came before it.
+    /// The chip leaves the CCMP MIC at the end: it goes here.
+    pub(super) fn rx_mpdu_legacy(&mut self, data: &[u8]) {
+        let length = le16(data, 0) as usize;
+        let Some(frame) = data.get(4..4 + length) else { return };
+        let status = le32(data, 4 + length);
+        if status & (RX_RES_CRC_OK | RX_RES_OVERRUN_OK) != (RX_RES_CRC_OK | RX_RES_OVERRUN_OK) || frame.len() < wifi::HEADER {
+            return;
+        }
+        let phy = &self.last_phy;
+        let energy = le32(phy, RX_PHY_ENERGY);
+        let signal = [energy & 0xff, (energy >> 8) & 0xff].into_iter().filter(|&energy| energy != 0).min().map_or(-127, |energy| -(energy.min(127) as i16)) as i8;
+        let channel = le16(phy, RX_PHY_CHANNEL);
+        let freq = if le16(phy, RX_PHY_FLAGS) & RX_PHY_BAND_24 != 0 {
+            if channel == 14 { 2484 } else { 2407 + 5 * channel }
+        } else {
+            5000 + 5 * channel
+        };
+        let protected = frame[1] & wifi::PROTECTED != 0;
+        let decrypted = protected && status & RX_RES_SEC_MASK == RX_RES_SEC_CCM && status & RX_RES_MIC_OK != 0;
+        let frame = if decrypted { &frame[..frame.len().saturating_sub(CCMP_MIC)] } else { frame };
+        if let Some(network) = &self.network
+            && wifi::addresses(frame).is_some_and(|(_, transmitter, _)| transmitter == network.bssid)
+        {
+            self.signal = Some(signal);
+        }
+        if let Some(device) = &self.device {
+            device.received(frame, radio::RxInfo { freq, signal, decrypted, security_header: if decrypted { CIPHER_HEADER as u8 } else { 0 } });
+        }
+    }
+
+    /// The access point's TID for a data frame: one queue, on BE.
+    pub(super) fn data_tid_gen1(&self) -> u8 {
+        0
+    }
+
+    /// The station key command, version 1: the common part, TKIP's
+    /// fields unused.
+    pub(super) fn key_command_v1(offset: u8, flags: u16, material: &[u8; 32]) -> Vec<u8> {
+        let mut out = Out::default();
+        out.u8(AP_STA_ID).u8(offset).u16(flags).bytes(material).zeros(16).zeros(12);
+        out.0
+    }
+}
