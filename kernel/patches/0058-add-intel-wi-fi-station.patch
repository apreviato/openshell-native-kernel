+impl Radio for IntelRadio {
+    fn start(&self) -> radio::Result<()> {
+        if self.card.mvm.lock().dead { Err(radio::Error::Down) } else { Ok(()) }
+    }
+
+    fn stop(&self) {
+        let mut mvm = self.card.mvm.lock();
+        mvm.abort_scan();
+        mvm.leave();
+    }
+
+    fn scan(&self, request: &ScanRequest) -> radio::Result<()> {
+        self.card.mvm.lock().scan(request)
+    }
+
+    fn abort_scan(&self) {
+        self.card.mvm.lock().abort_scan();
+    }
+
+    fn join(&self, network: &Join) -> radio::Result<()> {
+        self.card.mvm.lock().join(network)
+    }
+
+    fn associated(&self, association: &Association) -> radio::Result<()> {
+        self.card.mvm.lock().associated(association)
+    }
+
+    fn leave(&self) {
+        self.card.mvm.lock().leave();
+    }
