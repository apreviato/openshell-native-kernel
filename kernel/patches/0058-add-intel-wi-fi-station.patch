+const TLV_HW_TYPE: u32 = 58;
+const TLV_PNVM_VERSION: u32 = 62;
+const TLV_PNVM_SKU: u32 = 64;
+/// A section the firmware's own copy holds already.
+const PNVM_SECTION_SKIP: u32 = 0xdddd_eeee;
+
+/// The platform's NVM data (`.pnvm`) for a card: the sections of the part
+/// for its SKU (the ALIVE notification's) and its MAC and radio types, one
+/// after another, as Linux's `iwl_pnvm_parse` and
+/// `iwl_pcie_load_payloads_continuously` give them to the firmware. None:
+/// the file has no part for this card.
+pub(crate) fn pnvm_data(file: &[u8], sku: [u32; 3], mac_type: u32, rf_type: u32) -> Option<Vec<u8>> {
+    fn tlvs(mut data: &[u8]) -> impl Iterator<Item = (u32, &[u8], &[u8])> {
+        core::iter::from_fn(move || {
+            if data.len() < 8 {
+                return None;
+            }
+            let kind = u32::from_le_bytes([data[0], data[1], data[2], data[3]]);
+            let length = u32::from_le_bytes([data[4], data[5], data[6], data[7]]) as usize;
+            let value = data.get(8..8 + length)?;
+            let after = data.get(8..).unwrap_or(&[]);
+            data = data.get(8 + length.next_multiple_of(4)..).unwrap_or(&[]);
+            Some((kind, value, after))
+        })
+    }
+    for (kind, value, after) in tlvs(file) {
+        if kind != TLV_PNVM_SKU || value.len() < 12 {
+            continue;
+        }
+        let word = |at: usize| u32::from_le_bytes([value[at], value[at + 1], value[at + 2], value[at + 3]]);
+        if [word(0), word(4), word(8)] != sku {
+            continue;
+        }
+        // This SKU's sections follow its TLV, up to the next SKU's.
+        let section = after.get(value.len().next_multiple_of(4)..).unwrap_or(&[]);
+        let mut hw_match = false;
+        let mut out = Vec::new();
+        for (kind, value, _) in tlvs(section) {
+            match kind {
+                TLV_PNVM_SKU => break,
+                TLV_PNVM_VERSION => {}
+                TLV_HW_TYPE if value.len() >= 4 => {
+                    let mac = u16::from_le_bytes([value[0], value[1]]) as u32;
+                    let rf = u16::from_le_bytes([value[2], value[3]]) as u32;
+                    hw_match |= mac == mac_type && rf == rf_type;
+                }
+                TLV_SEC_RT if value.len() > 4 => {
+                    let offset = u32::from_le_bytes([value[0], value[1], value[2], value[3]]);
+                    if offset != PNVM_SECTION_SKIP {
+                        out.extend_from_slice(&value[4..]);
+                    }
+                }
+                _ => {}
+            }
+        }
