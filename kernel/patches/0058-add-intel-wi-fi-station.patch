+/// A queue's read pointer and status in the scheduler.
+pub(crate) fn scd_queue_rdptr(queue: usize) -> u32 {
+    if queue < 20 { SCD_BASE + 0x68 + queue as u32 * 4 } else { SCD_BASE + 0x2b4 + queue as u32 * 4 }
+}
+
+pub(crate) fn scd_queue_status(queue: usize) -> u32 {
+    if queue < 20 { SCD_BASE + 0x10c + queue as u32 * 4 } else { SCD_BASE + 0x334 + queue as u32 * 4 }
+}
+
+/// Where a queue's ring of descriptors is (its address >> 8).
+pub(crate) fn fh_mem_cbbc(queue: usize) -> usize {
+    match queue {
+        0..16 => FH_MEM_CBBC_0_15 + 4 * queue,
+        16..20 => FH_MEM_CBBC_16_19 + 4 * (queue - 16),
+        _ => FH_MEM_CBBC_20_31 + 4 * (queue - 20),
+    }
+}
