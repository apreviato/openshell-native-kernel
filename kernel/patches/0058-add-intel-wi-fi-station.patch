+// SPDX-License-Identifier: MPL-2.0
+
+//! 802.11's ciphers where this component runs them itself: BIP, 802.11w's
+//! integrity code of broadcast management frames (CMAC and GMAC, 128 and
+//! 256 bits), and CCMP and GCMP on robust unicast management frames for
+//! radios whose chip protects data only (as Linux's mac80211 does for
+//! rtw88: `IEEE80211_KEY_FLAG_SW_MGMT_TX`). The chips run the data path;
+//! these run on the few frames they leave.
+//!
+//! References: IEEE 802.11-2020 12.5.3 (CCMP), 12.5.4 (BIP), 12.5.5
+//! (GCMP); RFC 3610 (CCM), RFC 4493 (CMAC), NIST SP 800-38D (GCM).
+
+use alloc::vec::Vec;
+
+use aes_gcm::{
+    Aes128Gcm, Aes256Gcm,
+    aead::{AeadInPlace, NewAead},
+    aes::{Aes128, Aes256, BlockEncrypt, NewBlockCipher},
+};
+
+use crate::{
+    ieee80211 as wifi,
+    radio::{
+        CIPHER_BIP_CMAC, CIPHER_BIP_GMAC, CIPHER_BIP_GMAC_256, CIPHER_CCMP, CIPHER_CCMP_256, CIPHER_GCMP,
+        CIPHER_GCMP_256,
+    },
+};
+
+/// BIP-CMAC-256 (its suite has no constant elsewhere: no radio runs it).
+pub(crate) const CIPHER_BIP_CMAC_256: u32 = 0x000f_ac0d;
+/// The ciphers of broadcast management frames this component runs.
+pub(crate) const BIP_CIPHERS: [u32; 4] = [CIPHER_BIP_CMAC, CIPHER_BIP_CMAC_256, CIPHER_BIP_GMAC, CIPHER_BIP_GMAC_256];
+/// The management MIC element (MMIE).
+const ELEMENT_MMIE: u8 = 76;
+
+pub(crate) fn is_bip(cipher: u32) -> bool {
+    BIP_CIPHERS.contains(&cipher)
+}
+
+/// AES of either size, one block at a time.
+enum Aes {
+    Bits128(Aes128),
+    Bits256(Aes256),
+}
+
+impl Aes {
+    fn new(key: &[u8]) -> Option<Self> {
+        match key.len() {
+            16 => Some(Self::Bits128(Aes128::new(key.into()))),
+            32 => Some(Self::Bits256(Aes256::new(key.into()))),
+            _ => None,
+        }
+    }
+
+    fn encrypt(&self, block: &mut [u8; 16]) {
+        let block = block.into();
+        match self {
+            Self::Bits128(cipher) => cipher.encrypt_block(block),
+            Self::Bits256(cipher) => cipher.encrypt_block(block),
+        }
+    }
+}
+
+/// AES-CMAC (RFC 4493) of `parts`, one after the other.
+fn cmac(cipher: &Aes, parts: &[&[u8]]) -> [u8; 16] {
+    let double = |block: [u8; 16]| {
+        let mut out = [0u8; 16];
+        for i in 0..16 {
+            out[i] = (block[i] << 1) | block.get(i + 1).map_or(0, |next| next >> 7);
+        }
+        if block[0] & 0x80 != 0 {
+            out[15] ^= 0x87;
+        }
+        out
+    };
+    let mut zero = [0u8; 16];
+    cipher.encrypt(&mut zero);
+    let k1 = double(zero);
+    let k2 = double(k1);
+    let total: usize = parts.iter().map(|part| part.len()).sum();
+    let mut state = [0u8; 16];
+    let mut block = [0u8; 16];
+    let mut filled = 0;
+    let mut seen = 0;
+    for byte in parts.iter().flat_map(|part| part.iter()) {
+        if filled == 16 {
+            for i in 0..16 {
+                state[i] ^= block[i];
+            }
+            cipher.encrypt(&mut state);
+            filled = 0;
+        }
+        block[filled] = *byte;
+        filled += 1;
+        seen += 1;
+    }
+    debug_assert_eq!(seen, total);
+    // The last block: whole, or padded with 10...0.
+    let subkey = if total > 0 && filled == 16 {
+        k1
+    } else {
+        block[filled] = 0x80;
+        block[filled + 1..].fill(0);
+        k2
+    };
+    for i in 0..16 {
+        state[i] ^= block[i] ^ subkey[i];
+    }
+    cipher.encrypt(&mut state);
+    state
+}
+
+/// The masked frame control and addresses BIP covers (12.5.4.4.1).
+fn bip_aad(frame: &[u8]) -> [u8; 20] {
+    let mut aad = [0u8; 20];
+    aad[0] = frame[0];
+    // Retry, Power Management and More Data off.
+    aad[1] = frame[1] & !0x38;
+    aad[2..20].copy_from_slice(&frame[4..22]);
+    aad
+}
+
+/// A group's integrity key (IGTK) and the last packet number it took.
+#[derive(Clone)]
+pub(crate) struct Igtk {
+    pub(crate) index: u8,
+    cipher: u32,
+    key: Vec<u8>,
+    last: u64,
+}
+
+impl Igtk {
+    pub(crate) fn new(index: u8, cipher: u32, key: &[u8], seq: &[u8]) -> Option<Self> {
+        let size = match cipher {
+            CIPHER_BIP_CMAC | CIPHER_BIP_GMAC => 16,
+            CIPHER_BIP_CMAC_256 | CIPHER_BIP_GMAC_256 => 32,
+            _ => return None,
+        };
+        if key.len() != size || !(4..=5).contains(&index) {
+            return None;
+        }
+        Some(Self { index, cipher, key: key.to_vec(), last: little_48(seq) })
+    }
+
+    fn mic_len(&self) -> usize {
+        if self.cipher == CIPHER_BIP_CMAC { 8 } else { 16 }
+    }
+
+    /// Whether a broadcast management frame carries this key's valid MMIE
+    /// with a packet number it has not taken yet; it is taken.
+    pub(crate) fn verify(&mut self, frame: &[u8]) -> bool {
+        let mic_len = self.mic_len();
+        let mmie_len = 2 + 2 + 6 + mic_len;
+        if frame.len() < wifi::HEADER + mmie_len || frame[1] & wifi::PROTECTED != 0 {
+            return false;
+        }
+        let mmie = &frame[frame.len() - mmie_len..];
+        if mmie[0] != ELEMENT_MMIE || mmie[1] as usize != mmie_len - 2 {
+            return false;
+        }
+        if u16::from_le_bytes([mmie[2], mmie[3]]) != u16::from(self.index) {
+            return false;
+        }
+        let ipn = little_48(&mmie[4..10]);
+        if ipn <= self.last {
+            return false;
+        }
+        let aad = bip_aad(frame);
+        // The body with the MIC field zeroed.
+        let mut body = frame[wifi::HEADER..].to_vec();
+        let mic_at = body.len() - mic_len;
+        let received = body[mic_at..].to_vec();
+        body[mic_at..].fill(0);
+        let computed: Vec<u8> = match self.cipher {
+            CIPHER_BIP_CMAC | CIPHER_BIP_CMAC_256 => {
+                let Some(cipher) = Aes::new(&self.key) else { return false };
+                cmac(&cipher, &[&aad, &body])[..mic_len].to_vec()
+            }
+            _ => {
+                // GMAC: GCM over nothing, the frame as associated data;
+                // the nonce is A2 and the IPN, most significant first.
+                let mut nonce = [0u8; 12];
+                nonce[..6].copy_from_slice(&frame[10..16]);
+                for i in 0..6 {
+                    nonce[6 + i] = mmie[9 - i];
+                }
+                let mut associated = aad.to_vec();
+                associated.extend_from_slice(&body);
+                match gcm_tag(&self.key, &nonce, &associated, &mut []) {
+                    Some(tag) => tag.to_vec(),
+                    None => return false,
+                }
+            }
+        };
+        if !equal(&computed, &received) {
+            return false;
+        }
+        self.last = ipn;
+        true
+    }
+}
+
+/// A pairwise key for robust management frames: the next packet number
+/// this side sends and the last one received.
+#[derive(Clone)]
+pub(crate) struct ManagementKey {
+    pub(crate) index: u8,
+    cipher: u32,
+    key: Vec<u8>,
+    next: u64,
+    last_received: Option<u64>,
+}
+
+impl ManagementKey {
+    pub(crate) fn new(index: u8, cipher: u32, key: &[u8]) -> Option<Self> {
+        let size = match cipher {
+            CIPHER_CCMP | CIPHER_GCMP => 16,
+            CIPHER_CCMP_256 | CIPHER_GCMP_256 => 32,
+            _ => return None,
+        };
+        (key.len() == size).then(|| Self { index, cipher, key: key.to_vec(), next: 1, last_received: None })
+    }
+
+    fn mic_len(&self) -> usize {
+        if self.cipher == CIPHER_CCMP { 8 } else { 16 }
+    }
+
+    fn gcm(&self) -> bool {
+        matches!(self.cipher, CIPHER_GCMP | CIPHER_GCMP_256)
+    }
+
+    /// Encrypts a management frame whose Protected bit is set: its body
+    /// gets the cipher's header before it and the MIC after it.
+    pub(crate) fn encrypt(&mut self, frame: &[u8]) -> Option<Vec<u8>> {
+        if frame.len() < wifi::HEADER {
+            return None;
+        }
+        let pn = self.next;
+        self.next += 1;
+        let mut out = frame[..wifi::HEADER].to_vec();
+        out[1] |= wifi::PROTECTED;
+        out.extend_from_slice(&[
+            pn as u8,
+            (pn >> 8) as u8,
+            0,
+            0x20 | (self.index << 6),
+            (pn >> 16) as u8,
+            (pn >> 24) as u8,
+            (pn >> 32) as u8,
+            (pn >> 40) as u8,
+        ]);
+        let mut body = frame[wifi::HEADER..].to_vec();
+        let aad = management_aad(&out);
+        let nonce = self.nonce(&out, pn);
+        let tag = if self.gcm() {
+            gcm_tag(&self.key, &nonce[1..], &aad, &mut body)?.to_vec()
+        } else {
+            ccm_encrypt(&Aes::new(&self.key)?, &nonce, &aad, &mut body, self.mic_len())
+        };
+        out.extend_from_slice(&body);
+        out.extend_from_slice(&tag);
+        Some(out)
+    }
+
+    /// Decrypts a protected unicast management frame: the plain frame,
+    /// without the cipher's header and MIC but with its Protected bit (it
+    /// came protected), or none if it does not check or comes again.
+    pub(crate) fn decrypt(&mut self, frame: &[u8]) -> Option<Vec<u8>> {
+        let mic_len = self.mic_len();
+        if frame.len() < wifi::HEADER + 8 + mic_len || frame[1] & wifi::PROTECTED == 0 {
+            return None;
+        }
+        let header = &frame[wifi::HEADER..wifi::HEADER + 8];
+        if header[3] & 0x20 == 0 || header[3] >> 6 != self.index {
+            return None;
+        }
+        let pn = u64::from(header[0])
+            | u64::from(header[1]) << 8
+            | u64::from(header[4]) << 16
+            | u64::from(header[5]) << 24
+            | u64::from(header[6]) << 32
+            | u64::from(header[7]) << 40;
+        if self.last_received.is_some_and(|last| pn <= last) {
+            return None;
+        }
+        let aad = management_aad(frame);
+        let nonce = self.nonce(frame, pn);
+        let mut body = frame[wifi::HEADER + 8..frame.len() - mic_len].to_vec();
+        let received = &frame[frame.len() - mic_len..];
+        let checks = if self.gcm() {
+            gcm_decrypt(&self.key, &nonce[1..], &aad, &mut body, received)
+        } else {
+            ccm_decrypt(&Aes::new(&self.key)?, &nonce, &aad, &mut body, received)
+        };
+        if !checks {
+            return None;
+        }
+        self.last_received = Some(pn);
+        let mut plain = frame[..wifi::HEADER].to_vec();
+        plain.extend_from_slice(&body);
+        Some(plain)
+    }
+
+    /// CCMP's nonce (flags, A2, the PN most significant first); GCMP's is
+    /// the same without the flags. The flags of a management frame have
+    /// the Management bit and priority 0.
+    fn nonce(&self, frame: &[u8], pn: u64) -> [u8; 13] {
+        let mut nonce = [0u8; 13];
+        nonce[0] = 0x10;
+        nonce[1..7].copy_from_slice(&frame[10..16]);
+        for i in 0..6 {
+            nonce[7 + i] = (pn >> (40 - 8 * i)) as u8;
+        }
+        nonce
+    }
+}
+
+/// The associated data CCMP and GCMP cover of a management frame: the
+/// frame control (its subtype kept, Retry, Power Management and More Data
+/// off, Protected on), the three addresses and the fragment number.
+fn management_aad(frame: &[u8]) -> [u8; 22] {
+    let mut aad = [0u8; 22];
+    aad[0] = frame[0];
+    aad[1] = (frame[1] & !0x38) | wifi::PROTECTED;
+    aad[2..20].copy_from_slice(&frame[4..22]);
+    aad[20] = frame[22] & 0x0f;
+    aad[21] = 0;
+    aad
+}
+
+/// CCM's CBC-MAC and counter blocks (RFC 3610) with a 13-byte nonce
+/// (L = 2): the tag of `aad` and `data`, `data` turned into what the other
+/// side gets.
+fn ccm(cipher: &Aes, nonce: &[u8; 13], aad: &[u8], data: &mut [u8], mic_len: usize, encrypting: bool) -> [u8; 16] {
+    let counter = |i: u16| {
+        let mut block = [0u8; 16];
+        block[0] = 1;
+        block[1..14].copy_from_slice(nonce);
+        block[14..16].copy_from_slice(&i.to_be_bytes());
+        cipher.encrypt(&mut block);
+        block
+    };
+    let mac_over = |plain: &[u8]| {
+        let mut mac = [0u8; 16];
+        mac[0] = 0x40 | (((mic_len as u8 - 2) / 2) << 3) | 1;
+        mac[1..14].copy_from_slice(nonce);
+        mac[14..16].copy_from_slice(&(plain.len() as u16).to_be_bytes());
+        cipher.encrypt(&mut mac);
+        let mut absorb = |chunk: &[u8]| {
+            for (i, byte) in chunk.iter().enumerate() {
+                mac[i] ^= byte;
+            }
+            cipher.encrypt(&mut mac);
+        };
+        let mut associated = Vec::with_capacity(2 + aad.len());
+        associated.extend_from_slice(&(aad.len() as u16).to_be_bytes());
+        associated.extend_from_slice(aad);
+        for chunk in associated.chunks(16) {
+            absorb(chunk);
+        }
+        for chunk in plain.chunks(16) {
+            absorb(chunk);
+        }
+        mac
+    };
+    let crypt = |data: &mut [u8]| {
+        for (index, chunk) in data.chunks_mut(16).enumerate() {
+            let stream = counter(index as u16 + 1);
+            for (byte, key) in chunk.iter_mut().zip(stream.iter()) {
+                *byte ^= key;
+            }
+        }
+    };
+    let mac = if encrypting {
+        let mac = mac_over(data);
+        crypt(data);
+        mac
+    } else {
+        crypt(data);
+        mac_over(data)
+    };
+    let first = counter(0);
+    let mut tag = [0u8; 16];
+    for i in 0..16 {
+        tag[i] = mac[i] ^ first[i];
+    }
+    tag
+}
+
+fn ccm_encrypt(cipher: &Aes, nonce: &[u8; 13], aad: &[u8], data: &mut [u8], mic_len: usize) -> Vec<u8> {
+    ccm(cipher, nonce, aad, data, mic_len, true)[..mic_len].to_vec()
+}
+
+fn ccm_decrypt(cipher: &Aes, nonce: &[u8; 13], aad: &[u8], data: &mut [u8], received: &[u8]) -> bool {
+    let tag = ccm(cipher, nonce, aad, data, received.len(), false);
+    equal(&tag[..received.len()], received)
+}
+
+/// GCM with a 12-byte nonce: `data` encrypted in place, the tag.
+fn gcm_tag(key: &[u8], nonce: &[u8], aad: &[u8], data: &mut [u8]) -> Option<[u8; 16]> {
+    let nonce: [u8; 12] = nonce.try_into().ok()?;
+    let nonce = &aes_gcm::Nonce::from(nonce);
+    let tag = match key.len() {
+        16 => Aes128Gcm::new(key.into()).encrypt_in_place_detached(nonce, aad, data).ok()?,
+        32 => Aes256Gcm::new(key.into()).encrypt_in_place_detached(nonce, aad, data).ok()?,
+        _ => return None,
+    };
+    let mut out = [0u8; 16];
+    out.copy_from_slice(&tag);
+    Some(out)
+}
+
+fn gcm_decrypt(key: &[u8], nonce: &[u8], aad: &[u8], data: &mut [u8], tag: &[u8]) -> bool {
+    if tag.len() != 16 {
+        return false;
+    }
+    let (Ok(nonce), Ok(tag)) = (<[u8; 12]>::try_from(nonce), <[u8; 16]>::try_from(tag)) else { return false };
+    let (nonce, tag) = (&aes_gcm::Nonce::from(nonce), &aes_gcm::Tag::from(tag));
+    match key.len() {
+        16 => Aes128Gcm::new(key.into()).decrypt_in_place_detached(nonce, aad, data, tag).is_ok(),
+        32 => Aes256Gcm::new(key.into()).decrypt_in_place_detached(nonce, aad, data, tag).is_ok(),
+        _ => false,
+    }
+}
+
+/// A packet number of six bytes, least significant first (as keys'
+/// sequence counters and the MMIE carry it).
+fn little_48(bytes: &[u8]) -> u64 {
+    bytes.iter().take(6).rev().fold(0, |value, byte| (value << 8) | u64::from(*byte))
+}
+
+/// Compares in constant time.
+fn equal(a: &[u8], b: &[u8]) -> bool {
+    a.len() == b.len() && a.iter().zip(b).fold(0u8, |acc, (x, y)| acc | (x ^ y)) == 0
+}
