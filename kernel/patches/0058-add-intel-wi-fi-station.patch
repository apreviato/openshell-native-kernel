+// SPDX-License-Identifier: MPL-2.0
+
+//! Block acknowledgment agreements (802.11's ADDBA): a peer's offer to send
+//! aggregates (A-MPDUs) is taken when the radio acknowledges them, and this
+//! side offers its own agreements where the radio sends aggregates once
+//! told. Under a receive agreement a priority's frames come out of order
+//! (an aggregate's lost frames are sent again after the ones that follow
+//! them): where the radio does not put them back in order itself, a reorder
+//! buffer here does, as Linux's mac80211 (`agg-rx.c`, `rx.c`).
+
+use alloc::{collections::BTreeMap, vec, vec::Vec};
+
+use crate::{
+    device::{Device, State},
+    ieee80211::{self as wifi, Address},
+    radio::{self, BlockAck, Reorder, RxInfo},
+};
+
+/// The most frames a window holds here (HT's 64; HE's wider windows are
+/// not asked for).
+pub(crate) const MAX_BUFFER: u16 = 64;
+/// A frame held behind a missing one goes on after this long, the gap
+/// given up on (`HT_RX_REORDER_BUF_TIMEOUT`).
+const REORDER_TIMEOUT_MS: u64 = 100;
+/// How long the answer to an offer is waited for (`ADDBA_RESP_INTERVAL`).
+const ADDBA_TIMEOUT_MS: u64 = 1_000;
+/// A refused or ended agreement to send is offered again after this long.
+const RETRY_MS: u64 = 15_000;
+/// DELBA's reason: the agreement is not used (`WLAN_REASON_QSTA_NOT_USE`).
+const REASON_NOT_USED: u16 = 37;
+/// The status of a request whose parameters do not suit
+/// (`WLAN_STATUS_INVALID_QOS_PARAM`).
+const STATUS_INVALID_PARAMETERS: u16 = 38;
+const STATUS_SUCCESS: u16 = 0;
+/// Sequence numbers are 12 bits.
+const SEQ_MASK: u16 = 0x0fff;
+const SEQ_HALF: u16 = 0x0800;
+/// The TIDs of the user priorities (8 to 15 are traffic streams'),
+/// counted as `ieee80211::tid_of` gives them.
+const TIDS: u8 = 8;
+
+fn seq_sub(a: u16, b: u16) -> u16 {
+    a.wrapping_sub(b) & SEQ_MASK
+}
+
+fn seq_add(a: u16, n: u16) -> u16 {
+    a.wrapping_add(n) & SEQ_MASK
+}
+
+/// `a` comes before `b`.
+fn seq_less(a: u16, b: u16) -> bool {
+    seq_sub(a, b) > SEQ_HALF
+}
+
+// ---- The frames. Bodies start with the category. ----
+
+/// What an ADDBA request asks.
+#[derive(Clone, Copy, Debug)]
+struct AddbaRequest {
+    dialog: u8,
+    amsdu: bool,
+    immediate: bool,
+    tid: u8,
+    buffer: u16,
+    ssn: u16,
+}
+
+fn parse_addba_request(body: &[u8]) -> Option<AddbaRequest> {
+    let b = body.get(..9)?;
+    let parameters = u16::from_le_bytes([b[3], b[4]]);
+    Some(AddbaRequest {
+        dialog: b[2],
+        amsdu: parameters & 1 != 0,
+        immediate: parameters & 2 != 0,
+        tid: ((parameters >> 2) & 0xf) as u8,
+        buffer: parameters >> 6,
+        ssn: u16::from_le_bytes([b[7], b[8]]) >> 4,
+    })
+}
+
+/// The parameter set: A-MSDUs taken, immediate acknowledgment, the TID,
+/// the window.
+fn parameters(amsdu: bool, tid: u8, buffer: u16) -> [u8; 2] {
+    (amsdu as u16 | 1 << 1 | (tid as u16 & 0xf) << 2 | buffer << 6).to_le_bytes()
+}
+
+fn addba_response(dialog: u8, status: u16, amsdu: bool, tid: u8, buffer: u16) -> Vec<u8> {
+    let mut body = vec![wifi::CATEGORY_BLOCK_ACK, wifi::ACTION_ADDBA_RESPONSE, dialog];
+    body.extend_from_slice(&status.to_le_bytes());
+    body.extend_from_slice(&parameters(amsdu, tid, buffer));
+    // No time-out: the agreement holds until a side ends it.
+    body.extend_from_slice(&[0, 0]);
+    body
+}
+
+fn addba_request(dialog: u8, tid: u8, buffer: u16, ssn: u16) -> Vec<u8> {
+    // No A-MSDUs inside: the radios here send each frame alone.
+    let mut body = vec![wifi::CATEGORY_BLOCK_ACK, wifi::ACTION_ADDBA_REQUEST, dialog];
+    body.extend_from_slice(&parameters(false, tid, buffer));
+    body.extend_from_slice(&[0, 0]);
+    body.extend_from_slice(&((ssn & SEQ_MASK) << 4).to_le_bytes());
+    body
+}
+
+/// An ADDBA response: dialog, status, A-MSDUs taken, TID, window.
+fn parse_addba_response(body: &[u8]) -> Option<(u8, u16, bool, u8, u16)> {
+    let b = body.get(..9)?;
+    let status = u16::from_le_bytes([b[3], b[4]]);
+    let parameters = u16::from_le_bytes([b[5], b[6]]);
+    Some((b[2], status, parameters & 1 != 0, ((parameters >> 2) & 0xf) as u8, parameters >> 6))
+}
+
+/// DELBA: the TID, and whether its sender is the agreement's originator.
+fn delba(tid: u8, initiator: bool) -> Vec<u8> {
+    let parameters = (initiator as u16) << 11 | (tid as u16 & 0xf) << 12;
+    let mut body = vec![wifi::CATEGORY_BLOCK_ACK, wifi::ACTION_DELBA];
+    body.extend_from_slice(&parameters.to_le_bytes());
+    body.extend_from_slice(&REASON_NOT_USED.to_le_bytes());
+    body
+}
+
+fn parse_delba(body: &[u8]) -> Option<(u8, bool)> {
+    let b = body.get(..6)?;
+    let parameters = u16::from_le_bytes([b[2], b[3]]);
+    Some(((parameters >> 12) as u8, parameters & 1 << 11 != 0))
+}
+
+/// A block acknowledgment request (a control frame): its transmitter, the
+/// TID and the sequence number the window starts from now.
+fn parse_bar(frame: &[u8]) -> Option<(Address, u8, u16)> {
+    let b = frame.get(..20)?;
+    let transmitter: Address = b[10..16].try_into().ok()?;
+    let control = u16::from_le_bytes([b[16], b[17]]);
+    let ssn = u16::from_le_bytes([b[18], b[19]]) >> 4;
+    Some((transmitter, (control >> 12) as u8, ssn))
+}
+
+// ---- The reorder buffer. ----
+
+/// Frames of one sequence number: one, or an A-MSDU's subframes.
+struct Held {
+    frames: Vec<(Vec<u8>, RxInfo)>,
+    /// Its last subframe came.
+    complete: bool,
+    at: u64,
+}
+
+/// The window of a receive agreement: frames are handed over in the order
+/// of their sequence numbers, each once.
+pub(crate) struct ReorderBuffer {
+    /// The next sequence number to hand over: the window's start.
+    head: u16,
+    /// Where `head`'s frames are kept in `slots`; the window's others
+    /// follow it, round.
+    base: usize,
+    slots: Vec<Option<Held>>,
+    /// Complete slots.
+    stored: usize,
+}
+
+impl ReorderBuffer {
+    fn new(ssn: u16, buffer: u16) -> Self {
+        let size = buffer.clamp(1, MAX_BUFFER) as usize;
+        Self { head: ssn & SEQ_MASK, base: 0, slots: (0..size).map(|_| None).collect(), stored: 0 }
+    }
+
+    fn size(&self) -> u16 {
+        self.slots.len() as u16
+    }
+
+    fn slot(&self, seq: u16) -> usize {
+        (self.base + seq_sub(seq, self.head) as usize) % self.slots.len()
+    }
+
+    /// Hands over the window's first frames, if they all came, and moves
+    /// the window on by one.
+    fn advance(&mut self, out: &mut Vec<(Vec<u8>, RxInfo)>) {
+        if let Some(held) = self.slots[self.base].take()
+            && held.complete
+        {
+            self.stored -= 1;
+            out.extend(held.frames);
+        }
+        self.base = (self.base + 1) % self.slots.len();
+        self.head = seq_add(self.head, 1);
+    }
+
+    fn release_in_order(&mut self, out: &mut Vec<(Vec<u8>, RxInfo)>) {
+        while self.slots[self.base].as_ref().is_some_and(|held| held.complete) {
+            self.advance(out);
+        }
+    }
+
+    /// The window starts at `ssn` now: what came before it goes on.
+    fn release_to(&mut self, ssn: u16, out: &mut Vec<(Vec<u8>, RxInfo)>) {
+        let ssn = ssn & SEQ_MASK;
+        while seq_less(self.head, ssn) {
+            if self.stored == 0 && self.slots.iter().all(Option::is_none) {
+                self.head = ssn;
+                break;
+            }
+            self.advance(out);
+        }
+        self.release_in_order(out);
+    }
+
+    /// Frames held behind a gap for too long: the gap is given up on.
+    fn release(&mut self, now: u64, out: &mut Vec<(Vec<u8>, RxInfo)>) {
+        self.release_in_order(out);
+        while self.stored > 0 {
+            let size = self.slots.len();
+            let Some(offset) = (1..size).find(|&k| self.slots[(self.base + k) % size].as_ref().is_some_and(|held| held.complete)) else {
+                break;
+            };
+            let at = self.slots[(self.base + offset) % size].as_ref().map_or(now, |held| held.at);
+            if now < at + REORDER_TIMEOUT_MS {
+                break;
+            }
+            for _ in 0..offset {
+                self.advance(out);
+            }
+            self.release_in_order(out);
+        }
+    }
+
+    /// A frame of the agreement: it and the frames now in order go to
+    /// `out`; it is held while earlier ones are missing, and dropped when
+    /// its turn passed (a frame sent again whose acknowledgment was lost).
+    fn push(&mut self, seq: u16, frame: Vec<u8>, info: RxInfo, now: u64, out: &mut Vec<(Vec<u8>, RxInfo)>) {
+        let seq = seq & SEQ_MASK;
+        let more = info.amsdu_more;
+        if seq_less(seq, self.head) {
+            return;
+        }
+        let size = self.size();
+        if seq_sub(seq, self.head) >= size {
+            // Beyond the window: it moves on so that this frame ends it.
+            self.release_to(seq_sub(seq, size - 1), out);
+        }
+        let index = self.slot(seq);
+        if let Some(held) = self.slots[index].as_mut() {
+            if !held.complete {
+                held.frames.push((frame, info));
+                if !more {
+                    held.complete = true;
+                    held.at = now;
+                    self.stored += 1;
+                    self.release(now, out);
+                }
+            }
+            return;
+        }
+        if seq == self.head && self.stored == 0 {
+            // In order with nothing held: straight on (the window moves
+            // once an A-MSDU's last subframe came).
+            out.push((frame, info));
+            if !more {
+                self.base = (self.base + 1) % self.slots.len();
+                self.head = seq_add(self.head, 1);
+            }
+            return;
+        }
+        self.slots[index] = Some(Held { frames: vec![(frame, info)], complete: !more, at: now });
+        if !more {
+            self.stored += 1;
+            self.release(now, out);
+        }
+    }
+
+    /// Everything held, in order (the agreement ends).
+    fn drain(&mut self, out: &mut Vec<(Vec<u8>, RxInfo)>) {
+        for _ in 0..self.slots.len() {
+            self.advance(out);
+        }
+    }
+}
+
+// ---- The agreements. ----
+
+/// A receive agreement: its dialog, window and A-MSDUs, and the reorder
+/// buffer when the radio does not reorder.
+pub(crate) struct RxAgreement {
+    dialog: u8,
+    buffer: u16,
+    amsdu: bool,
+    reorder: Option<ReorderBuffer>,
+}
+
+/// An agreement to send.
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum TxAgreement {
+    Offered { dialog: u8, ssn: u16, deadline: u64 },
+    Running,
+    /// Refused, ended, or not for this radio: not offered before `until`.
+    Idle { until: u64 },
+}
+
+pub(crate) type RxAgreements = BTreeMap<(Address, u8), RxAgreement>;
+pub(crate) type TxAgreements = BTreeMap<(Address, u8), TxAgreement>;
+
+impl Device {
+    /// A block acknowledgment action frame from `peer` (the access point,
+    /// or a station of this one's network); `protect`: answers go
+    /// protected (802.11w).
+    pub(crate) fn block_ack_action(&self, state: &mut State, peer: &Address, body: &[u8], protect: bool) {
+        let now = crate::now_ms();
+        match body.get(1).copied() {
+            Some(wifi::ACTION_ADDBA_REQUEST) => {
+                if let Some(request) = parse_addba_request(body) {
+                    let answer = self.take_offer(peer, &request);
+                    self.send_action(peer, &answer, protect);
+                }
+            }
+            Some(wifi::ACTION_ADDBA_RESPONSE) => self.offer_answered(state, peer, body, protect, now),
+            Some(wifi::ACTION_DELBA) => {
+                let Some((tid, initiator)) = parse_delba(body) else { return };
+                if initiator {
+                    self.end_rx(peer, tid);
+                } else if let Some(TxAgreement::Offered { .. } | TxAgreement::Running) = state.tx_ba.get(&(*peer, tid)) {
+                    self.radio.tx_ba_stop(peer, tid);
+                    state.tx_ba.insert((*peer, tid), TxAgreement::Idle { until: now + RETRY_MS });
+                }
+            }
+            _ => {}
+        }
+    }
+
+    fn send_action(&self, peer: &Address, body: &[u8], protect: bool) {
+        // The network's BSSID: the access point's address, or this one's.
+        let bssid = if self.is_ap() { self.info.address } else { *peer };
+        let frame = wifi::action(peer, &self.info.address, &bssid, body, protect);
+        let _ = self.transmit_management(&frame);
+    }
+
+    /// A peer's offer to send aggregates: the answer.
+    fn take_offer(&self, peer: &Address, request: &AddbaRequest) -> Vec<u8> {
+        let (dialog, tid) = (request.dialog, request.tid);
+        let decline = |status| addba_response(dialog, status, false, tid, request.buffer);
+        if tid >= TIDS || !request.immediate {
+            return decline(STATUS_INVALID_PARAMETERS);
+        }
+        // The same request again (the answer was lost): the same answer.
+        if let Some(agreement) = self.rx_ba.lock().get(&(*peer, tid))
+            && agreement.dialog == dialog
+        {
+            return addba_response(dialog, STATUS_SUCCESS, agreement.amsdu, tid, agreement.buffer);
+        }
+        // A new offer for the TID ends the agreement there was.
+        self.end_rx(peer, tid);
+        let buffer = if request.buffer == 0 { MAX_BUFFER } else { request.buffer.min(MAX_BUFFER) };
+        let mut ba = BlockAck { peer: *peer, tid, ssn: request.ssn & SEQ_MASK, buffer, amsdu: request.amsdu };
+        match self.radio.rx_ba_start(&mut ba) {
+            Ok(reorder) => {
+                let buffer = ba.buffer.clamp(1, buffer);
+                let amsdu = ba.amsdu && request.amsdu;
+                let reorder = (reorder == Reorder::Host).then(|| ReorderBuffer::new(ba.ssn, buffer));
+                self.rx_ba.lock().insert((*peer, tid), RxAgreement { dialog, buffer, amsdu, reorder });
+                ostd::info!("{}: aggregates of TID {} from {} ({} frames)", self.name, tid, crate::Mac(peer), buffer);
+                addba_response(dialog, STATUS_SUCCESS, amsdu, tid, buffer)
+            }
+            Err(error) => {
+                if error != radio::Error::Unsupported {
+                    ostd::info!("{}: aggregates of TID {} from {} declined: {:?}", self.name, tid, crate::Mac(peer), error);
+                }
+                decline(wifi::STATUS_REQUEST_DECLINED)
+            }
+        }
+    }
+
+    /// A receive agreement ends: the frames held go on, in order.
+    fn end_rx(&self, peer: &Address, tid: u8) {
+        let Some(mut agreement) = self.rx_ba.lock().remove(&(*peer, tid)) else { return };
+        self.radio.rx_ba_stop(peer, tid);
+        if let Some(reorder) = agreement.reorder.as_mut() {
+            let mut out = Vec::new();
+            reorder.drain(&mut out);
+            self.deliver_in_order(peer, out);
+        }
+    }
+
+    /// The frames a reorder buffer handed over.
+    fn deliver_in_order(&self, from: &Address, frames: Vec<(Vec<u8>, RxInfo)>) {
+        for (frame, info) in frames {
+            if self.is_ap() {
+                self.ap_data(&frame, &info, from);
+            } else {
+                self.station_data(&frame, &info);
+            }
+        }
+    }
+
+    /// A data frame from `from` that passed the checks: `None` when no
+    /// reorder buffer here holds its priority (it goes on as it is), else
+    /// the frames now in order (it among them, or held, or dropped).
+    pub(crate) fn reorder(&self, frame: &[u8], info: &RxInfo, from: &Address) -> Option<Vec<(Vec<u8>, RxInfo)>> {
+        let qos = wifi::qos_control(frame)?;
+        // Not the null frames, not broadcasts, not frames that take no
+        // acknowledgment.
+        let policy = (qos >> wifi::QOS_ACK_POLICY_SHIFT) & 3;
+        if frame[0] & 0x40 != 0 || wifi::is_multicast(&frame[4..10].try_into().ok()?) || matches!(policy, wifi::QOS_ACK_NONE | wifi::QOS_ACK_NO_EXPLICIT) {
+            return None;
+        }
+        let tid = (qos & 0xf) as u8;
+        let seq = wifi::sequence(frame)?;
+        let mut out = Vec::new();
+        let held = {
+            let mut agreements = self.rx_ba.lock();
+            let reorder = agreements.get_mut(&(*from, tid))?.reorder.as_mut()?;
+            reorder.push(seq, frame.to_vec(), *info, crate::now_ms(), &mut out);
+            reorder.stored > 0 || reorder.slots.iter().any(Option::is_some)
+        };
+        if held {
+            crate::wait_for_timer();
+        }
+        Some(out)
+    }
+
+    /// A block acknowledgment request the radio passed on: the window
+    /// moves to its sequence number.
+    pub(crate) fn block_ack_request(&self, frame: &[u8]) {
+        if let Some((from, tid, ssn)) = parse_bar(frame) {
+            self.ba_release(&from, tid, ssn);
+        }
+    }
+
+    /// The radio's firmware says no frames of `peer`'s agreement on `tid`
+    /// before `ssn` will come (a block acknowledgment request it took, or
+    /// its own time-out): the ones held go on.
+    pub fn ba_release(&self, peer: &Address, tid: u8, ssn: u16) {
+        let mut out = Vec::new();
+        {
+            let mut agreements = self.rx_ba.lock();
+            let Some(reorder) = agreements.get_mut(&(*peer, tid)).and_then(|agreement| agreement.reorder.as_mut()) else { return };
+            reorder.release_to(ssn, &mut out);
+        }
+        self.deliver_in_order(peer, out);
+    }
+
+    /// Hands over the frames held too long behind missing ones; whether
+    /// frames are still held.
+    pub(crate) fn ba_expire(&self, now: u64) -> bool {
+        let mut released = Vec::new();
+        let mut waiting = false;
+        {
+            let mut agreements = self.rx_ba.lock();
+            for ((peer, _), agreement) in agreements.iter_mut() {
+                let Some(reorder) = agreement.reorder.as_mut() else { continue };
+                if reorder.stored == 0 {
+                    continue;
+                }
+                let mut out = Vec::new();
+                reorder.release(now, &mut out);
+                if !out.is_empty() {
+                    released.push((*peer, out));
+                }
+                waiting |= reorder.stored > 0;
+            }
+        }
+        for (peer, frames) in released {
+            self.deliver_in_order(&peer, frames);
+        }
+        waiting
+    }
+
+    // ---- Sending aggregates. ----
+
+    /// Before a data frame goes to `peer` (one that takes aggregates):
+    /// the frame's priority is offered an agreement, once.
+    pub(crate) fn ba_offer(&self, state: &mut State, peer: &Address, ethernet: &[u8], protect: bool, now: u64) {
+        if matches!(wifi::ethertype(ethernet), Some(wifi::ETHERTYPE_EAPOL | wifi::ETHERTYPE_PREAUTH)) {
+            return;
+        }
+        let tid = wifi::tid_of(ethernet);
+        if tid >= TIDS {
+            return;
+        }
+        match state.tx_ba.get(&(*peer, tid)) {
+            Some(TxAgreement::Idle { until }) if now < *until => return,
+            Some(TxAgreement::Offered { .. } | TxAgreement::Running) => return,
+            _ => {}
+        }
+        match self.radio.tx_ba_start(peer, tid) {
+            Ok(ssn) => {
+                state.dialog = state.dialog.wrapping_add(1).max(1);
+                let dialog = state.dialog;
+                state.tx_ba.insert((*peer, tid), TxAgreement::Offered { dialog, ssn, deadline: now + ADDBA_TIMEOUT_MS });
+                self.send_action(peer, &addba_request(dialog, tid, MAX_BUFFER, ssn), protect);
+            }
+            Err(radio::Error::Unsupported) => {
+                state.tx_ba.insert((*peer, tid), TxAgreement::Idle { until: u64::MAX });
+            }
+            Err(_) => {
+                state.tx_ba.insert((*peer, tid), TxAgreement::Idle { until: now + RETRY_MS });
+            }
+        }
+    }
+
+    fn offer_answered(&self, state: &mut State, peer: &Address, body: &[u8], protect: bool, now: u64) {
+        let Some((dialog, status, amsdu, tid, buffer)) = parse_addba_response(body) else { return };
+        let key = (*peer, tid);
+        let Some(TxAgreement::Offered { dialog: offered, ssn, .. }) = state.tx_ba.get(&key).copied() else { return };
+        if dialog != offered {
+            return;
+        }
+        if status != STATUS_SUCCESS {
+            self.radio.tx_ba_stop(peer, tid);
+            state.tx_ba.insert(key, TxAgreement::Idle { until: now + RETRY_MS });
+            return;
+        }
+        let buffer = if buffer == 0 { MAX_BUFFER } else { buffer.min(MAX_BUFFER) };
+        let ba = BlockAck { peer: *peer, tid, ssn, buffer, amsdu };
+        match self.radio.tx_ba_operational(&ba) {
+            Ok(()) => {
+                state.tx_ba.insert(key, TxAgreement::Running);
+                ostd::info!("{}: sending aggregates of TID {} to {} ({} frames)", self.name, tid, crate::Mac(peer), buffer);
+            }
+            Err(_) => {
+                self.radio.tx_ba_stop(peer, tid);
+                self.send_action(peer, &delba(tid, true), protect);
+                state.tx_ba.insert(key, TxAgreement::Idle { until: now + RETRY_MS });
+            }
+        }
+    }
+
+    /// Offers left without an answer are given up; whether one still
+    /// waits.
+    pub(crate) fn ba_timeouts(&self, state: &mut State, now: u64) -> bool {
+        let expired: Vec<(Address, u8)> = state
+            .tx_ba
+            .iter()
+            .filter_map(|(key, agreement)| matches!(agreement, TxAgreement::Offered { deadline, .. } if now >= *deadline).then_some(*key))
+            .collect();
+        for (peer, tid) in expired {
+            self.radio.tx_ba_stop(&peer, tid);
+            state.tx_ba.insert((peer, tid), TxAgreement::Idle { until: now + RETRY_MS });
+        }
+        state.tx_ba.values().any(|agreement| matches!(agreement, TxAgreement::Offered { .. }))
+    }
+
+    /// The agreements with `peer` (with every peer, when `None`) end
+    /// without a word to it: the link or the station is going. The radio
+    /// is told before it forgets the peer.
+    pub(crate) fn ba_end_all(&self, state: &mut State, peer: Option<&Address>) {
+        let ours = |address: &Address| peer.is_none_or(|peer| peer == address);
+        let rx: Vec<(Address, u8)> = self.rx_ba.lock().keys().filter(|(address, _)| ours(address)).copied().collect();
+        for (address, tid) in rx {
+            self.rx_ba.lock().remove(&(address, tid));
+            self.radio.rx_ba_stop(&address, tid);
+        }
+        let tx: Vec<(Address, u8)> = state
+            .tx_ba
+            .iter()
+            .filter(|((address, _), agreement)| ours(address) && matches!(agreement, TxAgreement::Offered { .. } | TxAgreement::Running))
+            .map(|(key, _)| *key)
+            .collect();
+        for (address, tid) in tx {
+            self.radio.tx_ba_stop(&address, tid);
+        }
+        state.tx_ba.retain(|(address, _), _| !ours(address));
+    }
+}
+
+#[cfg(ktest)]
+mod test {
+    use super::*;
+
+    fn info(more: bool) -> RxInfo {
+        RxInfo { freq: 2412, signal: -40, decrypted: false, security_header: 0, amsdu_more: more }
+    }
+
+    fn seqs(out: &[(Vec<u8>, RxInfo)]) -> Vec<u8> {
+        out.iter().map(|(frame, _)| frame[0]).collect()
+    }
+
+    #[ostd::ktest]
+    fn reorders_and_gives_up_gaps() {
+        let mut buffer = ReorderBuffer::new(10, 8);
+        let mut out = Vec::new();
+        buffer.push(10, vec![10], info(false), 0, &mut out);
+        buffer.push(12, vec![12], info(false), 0, &mut out);
+        buffer.push(13, vec![13], info(false), 0, &mut out);
+        assert_eq!(seqs(&out), [10]);
+        buffer.push(11, vec![11], info(false), 1, &mut out);
+        assert_eq!(seqs(&out), [10, 11, 12, 13]);
+        // A duplicate, then a gap given up on.
