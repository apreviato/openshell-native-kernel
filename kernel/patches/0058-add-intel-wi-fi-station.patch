+        };
+        for (cipher, size) in [(CIPHER_CCMP, 16), (CIPHER_CCMP_256, 32), (CIPHER_GCMP, 16)] {
+            let key = alloc::vec![7u8; size];
+            let mut sender = ManagementKey::new(0, cipher, &key).unwrap();
+            let mut receiver = ManagementKey::new(0, cipher, &key).unwrap();
+            let sent = sender.encrypt(&frame).unwrap();
+            assert_eq!(receiver.decrypt(&sent).unwrap(), frame);
+            // Once only, and not altered.
+            assert!(receiver.decrypt(&sent).is_none());
+            let mut altered = sender.encrypt(&frame).unwrap();
+            let last = altered.len() - 1;
+            altered[last] ^= 1;
+            assert!(receiver.decrypt(&altered).is_none());
+        }
+    }
+
