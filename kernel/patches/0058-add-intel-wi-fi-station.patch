+    /// The center of the 80 MHz channel the primary is in.
+    pub fn center_80(&self) -> u16 {
+        match self.width {
+            Width::W160 if self.primary_index() < 4 => self.center - 40,
+            Width::W160 => self.center + 40,
+            Width::W80 => self.center,
