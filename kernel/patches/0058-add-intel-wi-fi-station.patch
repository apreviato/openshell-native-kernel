+        let mut frame = hex("c0000000 ffffffffffff 020000000000 020000000000 0000 0200");
+        frame.extend_from_slice(&[ELEMENT_MMIE, 16, 4, 0, 5, 0, 0, 0, 0, 0]);
+        frame.extend_from_slice(&[0; 8]);
+        let cipher = Aes::new(&key).unwrap();
+        let mic = cmac(&cipher, &[&bip_aad(&frame), &frame[wifi::HEADER..]]);
+        let at = frame.len() - 8;
+        frame[at..].copy_from_slice(&mic[..8]);
+        let mut igtk = Igtk::new(4, CIPHER_BIP_CMAC, &key, &[4, 0, 0, 0, 0, 0]).unwrap();
+        assert!(igtk.verify(&frame));
+        // Replayed, or altered.
+        assert!(!igtk.verify(&frame));
+        let mut igtk = Igtk::new(4, CIPHER_BIP_CMAC, &key, &[0; 6]).unwrap();
+        frame[24] ^= 1;
+        assert!(!igtk.verify(&frame));
+    }
+}
