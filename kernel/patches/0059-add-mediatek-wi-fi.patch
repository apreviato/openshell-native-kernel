+impl Mt7921 {
+    pub(crate) fn new(chip: Chip, name: String, tokens: DmaCoherent) -> Self {
+        Self {
+            chip,
+            name,
+            address: [0; 6],
+            nss: 2,
+            wide160: false,
+            device: None,
+            tokens,
+            token_busy: vec![0; TOKENS],
+            next_token: 0,
+            network: None,
+            ap: None,
+            associated: false,
+            aid: 0,
+            qos: false,
+            pairwise: None,
+            scanning: false,
+            scan_started: 0,
+            scan_seq: 0,
+            roc_token: 0,
+            roc_active: false,
+            roc_granted: false,
+            sequence: 0,
+            signal: None,
+            dead: false,
+        }
+    }
+
+    /// Linux's `mt7921_init_hardware` and `__mt7921_start`: the firmware,
+    /// the chip's facts, its calibration, the MAC, and the interface.
+    pub(crate) fn bring_up(&mut self, patch: &str, ram: &str) -> Result<(), String> {
+        let (_, patch_file) = aster_firmware::load_first([patch]).ok_or_else(|| format!("{patch} is not in /lib/firmware"))?;
+        let (_, ram_file) = aster_firmware::load_first([ram]).ok_or_else(|| format!("{ram} is not in /lib/firmware"))?;
+        self.chip.before_firmware();
+        self.chip.load_patch(&patch_file).map_err(|error| format!("ROM patch: {error}"))?;
+        ostd::info!("{}: ROM patch loaded", self.name);
+        self.chip.load_ram(&ram_file).map_err(|error| format!("RAM code: {error}"))?;
+        ostd::notice!("{}: the firmware runs", self.name);
+        // `is_mt7922`.
+        self.wide160 = self.chip.chip_id == 0x7922;
+        self.capabilities()?;
+        self.chip.mcu(Cmd::Ext(EXT_EFUSE_BUFFER_MODE), &[0, 1, 0, 0], true)?;
+        self.chip.mac_init();
+        // The RTS threshold (`mt76_connac_mcu_set_rts_thresh`).
+        let mut rts = vec![1u8, 0, 0, 0];
+        rts.extend_from_slice(&0x92bu32.to_le_bytes());
+        rts.extend_from_slice(&2u32.to_le_bytes());
+        self.chip.mcu(Cmd::Ext(EXT_PROTECT_CTRL), &rts, true)?;
+        // The MAC on, the channels allowed, the receive path.
+        self.chip.mcu(Cmd::Ext(EXT_MAC_INIT_CTRL), &[1, 0, 0, 0], true)?;
+        self.channel_domain()?;
+        self.rx_path()?;
+        let mut filter = vec![0u8; 68];
+        filter[4] = 1;
+        filter[8..12].copy_from_slice(&FILTER_ENABLE.to_le_bytes());
+        self.chip.mcu(Cmd::Ce(CE_SET_RX_FILTER), &filter, false)?;
+        self.add_interface()
+    }
+
+    /// The MAC address and the streams (`mt7921_mcu_get_nic_capability`).
+    fn capabilities(&mut self) -> Result<(), String> {
+        let answer = self.chip.mcu(Cmd::CeQuery(CE_GET_NIC_CAPAB), &[], true)?;
+        let elements = le16(&answer, 0);
+        let mut at = 4;
+        for _ in 0..elements {
+            let (kind, length) = (le32(&answer, at), le32(&answer, at + 4) as usize);
+            let Some(data) = answer.get(at + 8..at + 8 + length) else { break };
+            match kind {
+                NIC_CAP_MAC_ADDR if data.len() >= 6 => self.address.copy_from_slice(&data[..6]),
+                // `struct mt7921_phy_cap`: ht, vht, 5g, max_bw, nss, ...
+                NIC_CAP_PHY if data.len() >= 5 => self.nss = data[4].clamp(1, 2),
+                _ => {}
+            }
+            at += 8 + length;
+        }
+        if self.address == [0; 6] || self.address[0] & 1 != 0 {
+            return Err(String::from("the card gave no MAC address"));
+        }
+        Ok(())
+    }
+
+    /// The channels the firmware may use (`mt76_connac_mcu_set_channel_domain`),
+    /// worldwide ("00").
+    fn channel_domain(&mut self) -> Result<(), String> {
+        let channels: Vec<(u16, u32)> = (1..=13u16)
+            .map(|channel| (channel, 0))
+            .chain(chan::CHANNELS_5GHZ.iter().map(|&channel| (channel as u16, if chan::radar_channel(channel) { IEEE80211_CHAN_NO_IR | IEEE80211_CHAN_RADAR } else { 0 })))
+            .collect();
+        let mut out = vec![b'0', b'0', 0, 0, 0, 3, 3, 0, 13, chan::CHANNELS_5GHZ.len() as u8, 0, 0];
+        for (channel, flags) in channels {
+            out.extend_from_slice(&channel.to_le_bytes());
+            out.extend_from_slice(&[0, 0]);
+            out.extend_from_slice(&flags.to_le_bytes());
+        }
+        self.chip.mcu(Cmd::Ce(CE_SET_CHAN_DOMAIN), &out, false).map(|_| ())
+    }
+
+    /// The receive path on the first channel (`mt7921_mcu_set_chan_info`
+    /// with `SET_RX_PATH`).
+    fn rx_path(&mut self) -> Result<(), String> {
+        self.chan_info(EXT_SET_RX_PATH, &Chandef::simple(chan::freq_of(BandId::Ghz2, 1)))
+    }
+
+    /// `mt7921_mcu_set_chan_info`: the channel, its centre and width, the
+    /// streams (a mask for the receive path, a count when switching).
+    fn chan_info(&mut self, command: u8, chandef: &Chandef) -> Result<(), String> {
+        let mut out = vec![0u8; 76];
+        let mask = (1u8 << self.nss) - 1;
+        out[0] = wifi::channel_of(chandef.control).unwrap_or(1);
+        out[1] = wifi::channel_of(chandef.center).unwrap_or(out[0]);
+        out[2] = cbw(chandef.width);
+        out[3] = self.nss;
+        out[4] = if command == EXT_CHANNEL_SWITCH { self.nss } else { mask };
+        out[10] = if is_2ghz(chandef.control) { 0 } else { 1 };
+        self.chip.mcu(Cmd::Ext(command), &out, true).map(|_| ())
+    }
+
+    /// Linux's `mt76_connac_mcu_uni_add_dev`: the interface's MAC
+    /// (DEV_INFO), then its BSS, a station not connected.
+    fn add_interface(&mut self) -> Result<(), String> {
+        let mut active = vec![1u8, 0];
+        active.extend_from_slice(&self.address);
+        let mut dev = vec![0u8, 0, 0, 0];
+        dev.extend(tlv(DEV_INFO_ACTIVE, &active));
+        self.uni(UNI_DEV_INFO_UPDATE, &dev)?;
+        let basic = self.bss_basic(1, None);
+        let mut out = vec![0u8; 4];
+        out.extend(tlv(UNI_BSS_INFO_BASIC, &basic));
+        self.uni(UNI_BSS_INFO_UPDATE, &out)
+    }
+
+    fn uni(&mut self, id: u16, payload: &[u8]) -> Result<(), String> {
+        let answer = self.chip.mcu(Cmd::Uni(id), payload, true)?;
+        let status = le32(&answer, 4);
+        if status != 0 {
+            return Err(format!("UNI command {id:#x} refused (status {status:#x})"));
+        }
+        Ok(())
+    }
+
+    /// `struct mt76_connac_bss_basic_tlv`'s value: the interface's BSS,
+    /// `conn_state` 1 when not connected, the network when there is one.
+    fn bss_basic(&self, conn_state: u8, network: Option<&Network>) -> Vec<u8> {
+        let bss = network.map(|network| (network.ghz2(), network.join.bssid, network.join.beacon_interval, network.dtim));
+        Self::basic_value(true, CONNECTION_INFRA_STA, conn_state, bss)
+    }
+
+    /// The BSS basics: active, the connection's type and state, the
+    /// network's band, BSSID, beacon interval and DTIM period when there is
+    /// one, with the interface's own modes (`mt76_connac_get_phy_mode` and
+    /// `_v2` without a station: HT and HE on both bands, VHT at 5 GHz).
+    fn basic_value(active: bool, conn_type: u32, conn_state: u8, bss: Option<(bool, Address, u16, u8)>) -> Vec<u8> {
+        let ghz2 = bss.is_none_or(|(ghz2, ..)| ghz2);
+        let phymode = if ghz2 { PHY_MODE_B | PHY_MODE_G | PHY_MODE_GN | PHY_MODE_AX_24G } else { PHY_MODE_A | PHY_MODE_AN | PHY_MODE_AC | PHY_MODE_AX_5G };
+        let basic_phy = if ghz2 { PHY_TYPE_BIT_HR_DSSS | PHY_TYPE_BIT_ERP | PHY_TYPE_BIT_HT | PHY_TYPE_BIT_HE } else { PHY_TYPE_BIT_OFDM | PHY_TYPE_BIT_HT | PHY_TYPE_BIT_VHT | PHY_TYPE_BIT_HE };
+        let (bssid, interval, dtim) = bss.map_or(([0; 6], 0, 0), |(_, bssid, interval, dtim)| (bssid, interval, dtim));
+        let mut value = Vec::with_capacity(28);
+        value.extend_from_slice(&[active as u8, 0, 0, 0]);
+        value.extend_from_slice(&conn_type.to_le_bytes());
+        value.extend_from_slice(&[conn_state, 0]);
+        value.extend_from_slice(&bssid);
+        value.extend_from_slice(&(WCID_OWN as u16).to_le_bytes());
+        value.extend_from_slice(&interval.to_le_bytes());
+        value.extend_from_slice(&[dtim, if bss.is_some() { phymode } else { 0 }]);
+        value.extend_from_slice(&(WCID_OWN as u16).to_le_bytes());
+        value.extend_from_slice(&(if bss.is_some() { basic_phy as u16 } else { 0 }).to_le_bytes());
+        value.extend_from_slice(&[0, 0]);
+        value
+    }
+
+    /// `mt76_connac_mcu_uni_bss_he_tlv` and the BSS colour: the RTS
+    /// threshold of the HE operation (1023: none), the PE duration, this
+    /// radio's highest MCS at 80, 160 and 80+80 MHz; the colour when it is
+    /// on.
+    fn he_bss(&mut self, operation: Option<&[u8]>, ghz2: bool, connected: bool) -> Result<(), String> {
+        let rts = operation.filter(|value| value.len() >= 3).map_or(0, |value| (u16::from_le_bytes([value[0], value[1]]) >> 4) & 0x3ff);
+        let own = self.mcs_map();
+        let mut he = vec![0u8; 4];
+        let mut value = Vec::with_capacity(12);
+        value.extend_from_slice(&(if rts == 0 { 1023 } else { rts }).to_le_bytes());
+        value.extend_from_slice(&[4, 0]);
+        value.extend_from_slice(&own.to_le_bytes());
+        value.extend_from_slice(&(if ghz2 || !self.wide160 { 0xffff } else { own }).to_le_bytes());
+        value.extend_from_slice(&0xffffu16.to_le_bytes());
+        value.extend_from_slice(&[0, 0]);
+        he.extend(tlv(UNI_BSS_INFO_HE_BASIC, &value));
+        let color = operation.and_then(|value| value.get(3).copied()).unwrap_or(0);
+        let enabled = connected && color & 0x80 == 0 && color & 0x3f != 0;
+        he.extend(tlv(UNI_BSS_INFO_BSS_COLOR, &[enabled as u8, if connected { color & 0x3f } else { 0 }, 0, 0]));
+        self.uni(UNI_BSS_INFO_UPDATE, &he)
+    }
+
+    /// `mt76_connac_mcu_uni_set_chctx`: the BSS's channel, centre, width.
+    fn rlm(&mut self, chandef: &Chandef) -> Result<(), String> {
+        let channel = wifi::channel_of(chandef.control).unwrap_or(0);
+        let center = wifi::channel_of(chandef.center).unwrap_or(channel);
+        let bw = cbw(chandef.width);
+        let ht_op = if bw == CMD_CBW_20MHZ { 0 } else { 4 };
+        let mut rlm = vec![0u8; 4];
+        let band = if is_2ghz(chandef.control) { 0 } else { 1 };
+        rlm.extend(tlv(UNI_BSS_INFO_RLM, &[channel, center, 0, bw, self.nss, (1 << self.nss) - 1, 1, ht_op, sco(chandef), band, 0, 0]));
+        self.uni(UNI_BSS_INFO_UPDATE, &rlm)
+    }
+
+    /// The station's own HE MCS map: MCS 0-11 on each stream.
+    fn mcs_map(&self) -> u16 {
+        (0..8).fold(0u16, |map, stream| map | (if stream < self.nss as usize { 2 } else { 3 }) << (stream * 2))
+    }
+
+    /// Linux's `mt76_connac_mcu_uni_add_bss` and `_set_chctx`: the BSS with
+    /// its network (connected or not), its QoS, HE's basics with an HE
+    /// access point, its channel as wide as the link.
+    fn add_bss(&mut self, connected: bool) -> Result<(), String> {
+        let Some(network) = self.network.clone() else { return Ok(()) };
+        let mut out = vec![0u8; 4];
+        out.extend(tlv(UNI_BSS_INFO_BASIC, &self.bss_basic(!connected as u8, Some(&network))));
+        out.extend(tlv(UNI_BSS_INFO_QBSS, &[self.qos as u8, 0, 0, 0]));
+        self.uni(UNI_BSS_INFO_UPDATE, &out)?;
+        if network.peer.he.is_some() {
+            let elements = wifi::Elements(&network.join.elements);
+            self.he_bss(elements.extension(wifi::EXT_HE_OPERATION), network.ghz2(), connected)?;
+        }
+        self.rlm(&network.join.chandef)
+    }
+
+    /// `mt76_connac_mcu_uni_add_bss` for the access point: the BSS active
+    /// (or not any more) with its QoS, HE's basics and its channel.
+    fn add_bss_ap(&mut self, enable: bool) -> Result<(), String> {
+        let Some(ap) = &self.ap else { return Ok(()) };
+        let (ghz2, chandef, qos, he) = (ap.ghz2(), ap.config.chandef, ap.qos, ap.he);
+        let operation = ap.he_operation.clone();
+        let bss = Some((ghz2, self.address, ap.config.beacon_interval, ap.config.dtim_period.max(1)));
+        let mut out = vec![0u8; 4];
+        out.extend(tlv(UNI_BSS_INFO_BASIC, &Self::basic_value(enable, CONNECTION_INFRA_AP, !enable as u8, bss)));
+        out.extend(tlv(UNI_BSS_INFO_QBSS, &[qos as u8, 0, 0, 0]));
+        self.uni(UNI_BSS_INFO_UPDATE, &out)?;
+        if he {
+            self.he_bss(operation.as_deref(), ghz2, enable)?;
+        }
+        self.rlm(&chandef)
+    }
+
+    /// `mt7921_mcu_set_bss_pm`: the firmware's BSS ended, then connected
+    /// with its DTIM period and beacon interval.
+    fn bss_pm(&mut self, enable: bool) -> Result<(), String> {
+        self.chip.mcu(Cmd::Ce(CE_SET_BSS_ABORT), &[0, 0, 0, 0], false)?;
+        let Some(ap) = &self.ap else { return Ok(()) };
+        if !enable {
+            return Ok(());
+        }
+        let mut out = vec![0u8, ap.config.dtim_period.max(1), 0, 0];
+        out.extend_from_slice(&ap.config.beacon_interval.to_le_bytes());
+        out.extend_from_slice(&[0; 6]);
+        self.chip.mcu(Cmd::Ce(CE_SET_BSS_CONNECTED), &out, false).map(|_| ())
+    }
+
+    /// `mt7921_mcu_uni_add_beacon_offload`: the beacon behind its TXD
+    /// (`mt76_connac2_mac_write_txwi` for a beacon: firmware packet, beacon
+    /// queue, the band's lowest rate), where its TIM is.
+    fn beacon_offload(&mut self) -> Result<(), String> {
+        let Some(ap) = &self.ap else { return Ok(()) };
+        let frame = ap.config.beacon.frame(ap.config.dtim_period);
+        if frame.len() < wifi::HEADER || frame.len() > BEACON_ROOM - TXD_SIZE {
+            return Err(format!("a beacon of {} bytes does not fit", frame.len()));
+        }
+        let rate: u32 = if ap.ghz2() { 0 } else { (1 << 6) | 11 };
+        let (kind, subtype) = (((frame[0] >> 2) & 3) as u32, ((frame[0] >> 4) & 0xf) as u32);
+        let mut txd = [0u32; 8];
+        txd[0] = ((frame.len() + TXD_SIZE) as u32 & 0xffff) | (TX_TYPE_FW << 23) | (LMAC_BCN0 << 25);
+        txd[1] = (1 << 31) | WCID_OWN as u32 | (HDR_FORMAT_802_11 << 16) | (((wifi::HEADER / 2) as u32) << 11);
+        txd[2] = (kind << 4) | subtype | TXD2_MULTICAST | TXD2_FIX_RATE | TXD2_HTC_VLD;
+        txd[3] = TXD3_REM_TX_COUNT | TXD3_BA_DISABLE;
+        txd[6] = TXD6_FIXED_BW | (rate << 16);
+        txd[7] = (kind << 20) | (subtype << 16);
+        let mut packet = [0u8; BEACON_ROOM];
+        for (index, word) in txd.iter().enumerate() {
+            packet[4 * index..4 * index + 4].copy_from_slice(&word.to_le_bytes());
+        }
+        packet[TXD_SIZE..TXD_SIZE + frame.len()].copy_from_slice(&frame);
+        let mut value = ((TXD_SIZE + ap.config.beacon.tim_offset()) as u16).to_le_bytes().to_vec();
+        value.extend_from_slice(&[0, 0, 0, 0, 1, 0]);
+        value.extend_from_slice(&((TXD_SIZE + frame.len()) as u16).to_le_bytes());
+        value.extend_from_slice(&packet);
+        let mut out = vec![0u8; 4];
+        out.extend(tlv(UNI_BSS_INFO_BCN_CONTENT, &value));
+        self.uni(UNI_BSS_INFO_UPDATE, &out)
+    }
+
+    /// `struct sta_req_hdr` and its TLVs.
+    fn sta_rec(&mut self, wcid: u8, muar: u8, tlvs: &[Vec<u8>]) -> Result<(), String> {
+        let mut out = vec![0u8, wcid];
+        out.extend_from_slice(&(tlvs.len() as u16).to_le_bytes());
+        out.extend_from_slice(&[1, muar, 0, 0]);
+        for value in tlvs {
+            out.extend_from_slice(value);
+        }
+        self.uni(UNI_STA_REC_UPDATE, &out)
+    }
+
+    /// A WTBL request in its STA_REC TLV.
+    fn wtbl(wcid: u8, tlvs: &[Vec<u8>]) -> Vec<u8> {
+        let mut value = vec![wcid, WTBL_RESET_AND_SET];
+        value.extend_from_slice(&(tlvs.len() as u16).to_le_bytes());
+        value.extend_from_slice(&[0, 0, 0, 0]);
+        for inner in tlvs {
+            value.extend_from_slice(inner);
+        }
+        tlv(STA_REC_WTBL, &value)
+    }
+
+    /// The WTBL's generic, RX and header translation entries: a station's
+    /// frames go to the distribution system, an access point's come from
+    /// it; frames come in as 802.11.
+    fn wtbl_common(peer: &Address, muar: u8, qos: bool, aid: u16, rca1: bool, ap: bool) -> Vec<Vec<u8>> {
+        let mut generic = peer.to_vec();
+        generic.extend_from_slice(&[muar, 0, 0, qos as u8, 0, 0]);
+        generic.extend_from_slice(&aid.to_le_bytes());
+        generic.extend_from_slice(&[0, 0]);
+        vec![tlv(WTBL_GENERIC, &generic), tlv(WTBL_RX, &[0, rca1 as u8, 1, 1, 0, 0, 0, 0]), tlv(WTBL_HDR_TRANS, &[!ap as u8, ap as u8, 1, 0])]
+    }
+
+    /// The access point's station record (`mt7921_mcu_sta_update` for the
+    /// station of the AP), enabled in `state` or disabled.
+    fn station_record(&mut self, enable: bool, state: u8) -> Result<(), String> {
+        let Some(network) = self.network.clone() else { return Ok(()) };
+        // What the AP runs is known once it accepted the station.
+        let peer = if state == STATE_ASSOC { network.peer.clone() } else { radio::Peer::default() };
+        let record = PeerRecord {
+            wcid: WCID_AP,
+            address: network.join.bssid,
+            aid: self.aid,
+            qos: self.qos,
+            peer: &peer,
+            chandef: network.join.chandef,
+            rates: network.rates,
+            basic: network.basic,
+            ap: false,
+        };
+        self.peer_record(&record, enable, state)
+    }
+
+    /// `mt7921_mcu_sta_update` for a peer (`mt76_connac_mcu_sta_cmd`): its
+    /// basics, then once associated its HT, VHT, HE, PHY, rates and state,
+    /// and its WTBL entry; or the entry reset.
+    fn peer_record(&mut self, record: &PeerRecord<'_>, enable: bool, state: u8) -> Result<(), String> {
+        let rcpi = if record.ap { 0 } else { self.signal.map_or(0, |signal| (2 * signal as i16 + 220).clamp(0, 220) as u8) };
+        let ghz2 = is_2ghz(record.chandef.control);
+        let mut tlvs = Vec::new();
+        let conn_state = if enable { CONN_STATE_PORT_SECURE } else { CONN_STATE_DISCONNECT };
+        let newly = state != STATE_ASSOC && enable;
+        let conn_type = if record.ap { CONNECTION_INFRA_STA } else { CONNECTION_INFRA_AP };
+        let mut basic = conn_type.to_le_bytes().to_vec();
+        basic.extend_from_slice(&[conn_state, record.qos as u8]);
+        basic.extend_from_slice(&record.aid.to_le_bytes());
+        basic.extend_from_slice(&record.address);
+        basic.extend_from_slice(&(EXTRA_INFO_VER | if newly { EXTRA_INFO_NEW } else { 0 }).to_le_bytes());
+        tlvs.push(tlv(STA_REC_BASIC, &basic));
+        if !enable {
+            tlvs.push(Self::wtbl(record.wcid, &[]));
+            return self.sta_rec(record.wcid, 0, &tlvs);
+        }
+        let peer = record.peer;
+        let width = record.chandef.width;
+        let ht = peer.ht.map(|ht| {
+            let mut ht = ht;
+            if width < Width::W40 {
+                // 20 MHz: the AP's 40 MHz abilities do not apply.
+                ht.info &= !(chan::HT_CAP_SUP_WIDTH_20_40 | chan::HT_CAP_SGI_40);
+            }
+            ht
+        });
+        if let Some(ht) = &ht {
+            let mut value = ht.info.to_le_bytes().to_vec();
+            value.extend_from_slice(&[0, 0]);
+            tlvs.push(tlv(STA_REC_HT, &value));
+        }
+        if let Some(vht) = &peer.vht {
+            // `struct sta_rec_vht` (the MT7921's has its four last bytes).
+            let mut value = vht.info.to_le_bytes().to_vec();
+            value.extend_from_slice(&vht.mcs[0..2]);
+            value.extend_from_slice(&vht.mcs[4..6]);
+            value.extend_from_slice(&[0; 4]);
+            tlvs.push(tlv(STA_REC_VHT, &value));
+        }
+        // `mt76_connac_mcu_sta_amsdu_tlv`: A-MSDUs of up to eight frames to
+        // an HT or HE access point, long ones when it takes 7991 bytes.
+        if ht.is_some() || peer.he.is_some() {
+            let long = peer.vht.is_some_and(|vht| vht.info & chan::VHT_CAP_MAX_MPDU_MASK != 0);
+            tlvs.push(tlv(STA_REC_HW_AMSDU, &[8, long as u8, 1, 0]));
+        }
+        if let Some(he) = &peer.he {
+            tlvs.push(tlv(STA_REC_HE, &Self::he_record(he, width)));
+            tlvs.push(tlv(STA_REC_HE_V2, &Self::he_record_v2(he, width)));
+        }
+        let mut phy_type = if ghz2 { PHY_TYPE_BIT_HR_DSSS | PHY_TYPE_BIT_ERP } else { PHY_TYPE_BIT_OFDM };
+        let mut ampdu = 0u8;
+        if let Some(ht) = &ht {
+            phy_type |= PHY_TYPE_BIT_HT;
+            ampdu = (ht.ampdu_factor & 3) | ((ht.ampdu_density & 7) << 2);
+        }
+        if peer.vht.is_some() {
+            phy_type |= PHY_TYPE_BIT_VHT;
+        }
+        if peer.he.is_some() {
+            phy_type |= PHY_TYPE_BIT_HE;
+        }
+        let mut phy = record.basic.to_le_bytes().to_vec();
+        phy.extend_from_slice(&[phy_type, ampdu, 0, rcpi, 0, 0]);
+        tlvs.push(tlv(STA_REC_PHY, &phy));
+        let legacy = if ghz2 { ((record.rates >> 4) & 0xff) << 6 | (record.rates & 0xf) } else { (record.rates & 0xff) << 6 };
+        let mut ra = legacy.to_le_bytes().to_vec();
+        let mut mcs = [0u8; 10];
+        if let Some(ht) = &ht {
+            mcs.copy_from_slice(&ht.mcs[..10]);
+            for (stream, byte) in mcs.iter_mut().enumerate().take(4) {
+                if stream >= self.nss as usize {
+                    *byte = 0;
+                }
+            }
+            mcs[4..].fill(0);
+        }
+        ra.extend_from_slice(&mcs);
+        tlvs.push(tlv(STA_REC_RA, &ra));
+        // The state, and VHT's operating mode: the width and the streams.
+        let opmode = if peer.vht.is_some() { cbw(width).min(3) | ((peer.nss.max(1) - 1) << 4) } else { 0 };
+        tlvs.push(tlv(STA_REC_STATE, &[0, 0, 0, 0, state, opmode, 0, 0]));
+        let mut wtbl = Self::wtbl_common(&record.address, 0, record.qos, record.aid, !record.ap, record.ap);
+        if let Some(ht) = &ht {
+            // `mt76_connac_mcu_wtbl_ht_tlv`: the A-MPDU factor the larger of
+            // HT's and VHT's.
+            let ldpc = ht.info & chan::HT_CAP_LDPC != 0;
+            let vht_factor = peer.vht.map_or(0, |vht| ((vht.info >> chan::VHT_CAP_MAX_AMPDU_SHIFT) & 7) as u8);
+            wtbl.push(tlv(WTBL_HT, &[1, ldpc as u8, ht.ampdu_factor.max(vht_factor), ht.ampdu_density & 7, 0, 0, 0, 0]));
+            if let Some(vht) = &peer.vht {
+                let ldpc = vht.info & chan::VHT_CAP_RXLDPC != 0;
+                wtbl.push(tlv(WTBL_VHT, &[ldpc as u8, 0, 1, 0, 0, 0, 0, 0]));
+            }
+            wtbl.push(tlv(WTBL_SMPS, &[0, 0, 0, 0]));
+        }
+        tlvs.push(Self::wtbl(record.wcid, &wtbl));
+        self.sta_rec(record.wcid, 0, &tlvs)
+    }
+
+    /// The access point's highest HE MCS by width (`max_nss_mcs`: 80, 160,
+    /// 80+80 MHz), its receive maps, only those of the link's width.
+    fn he_mcs(he: &HeCap, width: Width) -> [u16; 3] {
+        let map = |at: usize| he.mcs.get(at..at + 2).map_or(0, |b| u16::from_le_bytes([b[0], b[1]]));
+        let mut out = [map(0), 0, 0];
+        if width == Width::W160 {
+            out[1] = map(4);
+            if he.phy[0] & chan::HE_PHY_80P80_IN_5G != 0 {
+                out[2] = map(8);
+            }
+        }
+        out
+    }
+
+    /// `mt76_connac_mcu_sta_he_tlv`: `struct sta_rec_he`'s value.
+    fn he_record(he: &HeCap, width: Width) -> Vec<u8> {
+        let mut cap = 0u32;
+        for (bit, mac, byte, mask) in HE_CAP_MAP {
+            let field = if mac { he.mac[byte] } else { he.phy[byte] };
+            if field & mask != 0 {
+                cap |= bit;
+            }
+        }
+        let bits = |value: u8, mask: u8| (value & mask) >> mask.trailing_zeros();
+        let mut value = cap.to_le_bytes().to_vec();
+        value.extend_from_slice(&[
+            bits(he.mac[1], 0x0c),
+            bits(he.mac[3], 0x18),
+            bits(he.phy[0], 0xfe),
+            bits(he.phy[1], 0x10),
+            bits(he.phy[3], 0x03),
+            bits(he.phy[3], 0x04),
+            bits(he.phy[3], 0x18),
+            // Linux writes the DCM's largest RU where the receive streams go.
+            bits(he.phy[8], 0xc0),
+            0,
+            bits(he.phy[1], 0x0f),
+            2,
+            0,
+        ]);
+        for mcs in Self::he_mcs(he, width) {
+            value.extend_from_slice(&mcs.to_le_bytes());
+        }
+        value.extend_from_slice(&[0, 0]);
+        value
+    }
+
+    /// `mt76_connac_mcu_sta_he_tlv_v2`: the elements' MAC and PHY
+    /// capabilities as they are, the packet extension of 16 µs.
+    fn he_record_v2(he: &HeCap, width: Width) -> Vec<u8> {
+        let mut value = Vec::with_capacity(24);
+        value.extend_from_slice(&he.mac);
+        value.extend_from_slice(&he.phy);
+        value.push(2);
+        for mcs in Self::he_mcs(he, width) {
+            value.extend_from_slice(&mcs.to_le_bytes());
+        }
+        value
+    }
+
+    /// The interface's own WTBL entry, for group frames of the network
+    /// (`mt7921_mcu_sta_update` without a station).
+    fn own_record(&mut self) -> Result<(), String> {
+        // As an access point, its group frames go to everyone.
+        let (peer, ap) = match (&self.ap, &self.network) {
+            (Some(_), _) => (wifi::BROADCAST, true),
+            (None, Some(network)) => (network.join.bssid, false),
+            (None, None) => return Ok(()),
+        };
+        let wtbl = Self::wtbl_common(&peer, MUAR_NONE, false, 0, true, ap);
+        self.sta_rec(WCID_OWN, MUAR_NONE, &[Self::wtbl(WCID_OWN, &wtbl)])
+    }
+
+    /// The EDCA parameters of the network's WMM element, or the standard
+    /// ones (`mt7921_mcu_set_tx`).
+    fn set_tx(&mut self, elements: &[u8]) {
+        // mac80211's queues (VO, VI, BE, BK) to the firmware's order.
+        const TO_ACI: [usize; 4] = [1, 0, 2, 3];
+        // (cw_min, cw_max, aifs, txop) per mac80211 queue.
+        let mut params: [(u16, u16, u16, u16); 4] = [(3, 7, 2, 47), (7, 15, 2, 94), (15, 1023, 3, 0), (15, 1023, 7, 0)];
+        let wmm = wifi::Elements(elements).iter().find(|(id, value)| *id == wifi::IE_VENDOR && value.len() >= 24 && value[..4] == wifi::WMM_OUI_TYPE && value[4] == 1);
+        if let Some((_, value)) = wmm {
+            for record in value[8..24].chunks(4) {
+                // The ACI (BE, BK, VI, VO) to mac80211's queue.
+                let queue = [2usize, 3, 1, 0][((record[0] >> 5) & 3) as usize];
+                let (ecw_min, ecw_max) = (record[1] & 0xf, record[1] >> 4);
+                params[queue] = ((1 << ecw_min) - 1, (1 << ecw_max) - 1, (record[0] & 0xf) as u16, u16::from_le_bytes([record[2], record[3]]));
+            }
+        }
+        let mut edca = [[0u8; 10]; 4];
+        for (queue, (cw_min, cw_max, aifs, txop)) in params.iter().enumerate() {
+            let entry = &mut edca[TO_ACI[queue]];
+            entry[0..2].copy_from_slice(&cw_min.to_le_bytes());
+            entry[2..4].copy_from_slice(&cw_max.to_le_bytes());
+            entry[4..6].copy_from_slice(&txop.to_le_bytes());
+            entry[6..8].copy_from_slice(&aifs.to_le_bytes());
+        }
+        let mut out: Vec<u8> = edca.concat();
+        out.extend_from_slice(&[0, self.qos as u8, 0, 0]);
+        let _ = self.chip.mcu(Cmd::Ce(CE_SET_EDCA_PARMS), &out, false);
+    }
+
+    /// The channel for joining (`mt7921_mcu_set_roc`), waited for.
+    fn roc_acquire(&mut self) {
+        let Some(network) = &self.network else { return };
+        let (channel, band) = channel_band(network.join.freq);
+        self.roc_token = self.roc_token.wrapping_add(1);
+        self.roc_granted = false;
+        let mut value = vec![0u8, self.roc_token, channel, 0, band, 0, channel, 0, 0, channel, 0, ROC_REQ_JOIN];
+        value.extend_from_slice(&ROC_MS.to_le_bytes());
+        value.extend_from_slice(&[0xff, 0, 0, 0]);
+        let mut out = vec![0u8; 4];
+        out.extend(tlv(ROC_ACQUIRE, &value));
+        if let Err(error) = self.chip.mcu(Cmd::Uni(UNI_ROC), &out, false) {
+            ostd::warn!("{}: the channel for joining: {}", self.name, error);
+            return;
+        }
+        self.roc_active = true;
+        let deadline = crate::now_ms() + ROC_GRANT_MS;
+        let waiting = crate::WAKER.waiting();
+        while !self.roc_granted && !self.dead && crate::now_ms() < deadline {
+            self.poll();
+            if !self.roc_granted {
+                crate::sleep();
+            }
+        }
+        drop(waiting);
+        if !self.roc_granted {
+            ostd::warn!("{}: the firmware did not grant the channel; joining anyway", self.name);
+        }
+    }
+
+    fn roc_abort(&mut self) {
+        if !self.roc_active {
+            return;
+        }
+        self.roc_active = false;
+        let mut out = vec![0u8; 4];
+        out.extend(tlv(ROC_ABORT, &[0, self.roc_token, 0xff, 0, 0, 0, 0, 0]));
+        let _ = self.chip.mcu(Cmd::Uni(UNI_ROC), &out, false);
+    }
+
+    // ---- The radio's operations. ----
+
+    pub(crate) fn scan(&mut self, request: &ScanRequest) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if self.scanning || self.ap.is_some() {
+            return Err(radio::Error::Busy);
+        }
+        self.scan_seq = (self.scan_seq + 1) & 0x7f;
+        let active = !request.ssids.is_empty();
+        let ssids: Vec<&Vec<u8>> = request.ssids.iter().filter(|ssid| !ssid.is_empty()).take(4).collect();
+        let freqs: Vec<u16> = request.freqs.iter().copied().filter(|&freq| wifi::channel_of(freq).is_some() && BandId::of(freq) != BandId::Ghz6).collect();
+        let listed = !freqs.is_empty() && freqs.len() <= 64;
+        let mut out = Vec::with_capacity(1186);
+        let ssid_type = if ssids.is_empty() { 1 << 0 } else { 1 << 2 };
+        out.extend_from_slice(&[self.scan_seq, 0, active as u8, ssid_type, ssids.len() as u8, if active { 2 } else { 0 }, 0x20, 1]);
+        for index in 0..4 {
+            let mut entry = [0u8; 36];
+            if let Some(ssid) = ssids.get(index) {
+                let length = ssid.len().min(32);
+                entry[0..4].copy_from_slice(&(length as u32).to_le_bytes());
+                entry[4..4 + length].copy_from_slice(&ssid[..length]);
+            }
+            out.extend_from_slice(&entry);
+        }
+        // Probe delay, dwell time and time-out: the firmware's own.
+        out.extend_from_slice(&[0; 6]);
+        let (first, rest) = if listed { freqs.split_at(freqs.len().min(32)) } else { (&[][..], &[][..]) };
+        out.extend_from_slice(&[if listed { 4 } else { 0 }, first.len() as u8]);
+        let entry = |freq: Option<&u16>| freq.map_or([0, 0], |&freq| {
+            let (channel, band) = channel_band(freq);
+            [band, channel]
+        });
+        for index in 0..32 {
+            out.extend_from_slice(&entry(first.get(index)));
+        }
+        let elements = &request.elements[..request.elements.len().min(600)];
+        out.extend_from_slice(&(elements.len() as u16).to_le_bytes());
+        let mut ies = [0u8; 600];
+        ies[..elements.len()].copy_from_slice(elements);
+        out.extend_from_slice(&ies);
+        out.extend_from_slice(&[rest.len() as u8, 0, 0, 0]);
+        for index in 0..32 {
+            out.extend_from_slice(&entry(rest.get(index)));
+        }
+        out.extend_from_slice(&[0; 6 * 36]);
+        out.extend_from_slice(&wifi::BROADCAST);
+        out.extend_from_slice(&[0; 6]);
+        out.extend_from_slice(&[0; 63]);
+        out.push(if ssids.is_empty() { 0 } else { 1 });
+        debug_assert_eq!(out.len(), 1186);
+        if let Err(error) = self.chip.mcu(Cmd::Ce(CE_START_HW_SCAN), &out, false) {
+            ostd::warn!("{}: scan: {}", self.name, error);
+            return Err(radio::Error::Failed);
+        }
+        self.scanning = true;
+        self.scan_started = crate::now_ms();
+        Ok(())
+    }
+
+    /// Linux's `mt76_connac_mcu_cancel_hw_scan`: the scan ends now.
+    pub(crate) fn abort_scan(&mut self) {
+        if !self.scanning {
+            return;
+        }
+        self.scanning = false;
+        let _ = self.chip.mcu(Cmd::Ce(CE_CANCEL_HW_SCAN), &[self.scan_seq, 0, 0, 0], false);
+        if let Some(device) = &self.device {
+            device.scan_done(true);
+        }
+    }
+
+    /// Linux's `mt7921_mac_sta_add` and `mgd_prepare_tx`: the access
+    /// point's station, then the channel.
+    pub(crate) fn join(&mut self, join: &Join) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if self.ap.is_some() {
+            return Err(radio::Error::Busy);
+        }
+        self.leave();
+        self.network = Some(Network::new(join));
+        self.aid = 0;
+        self.qos = false;
+        if let Err(error) = self.station_record(true, STATE_NONE) {
+            ostd::warn!("{}: joining: {}", self.name, error);
+            self.network = None;
+            return Err(radio::Error::Failed);
+        }
+        self.roc_acquire();
+        Ok(())
+    }
+
+    /// Linux's `mt7921_mac_sta_event` (ASSOC), `bss_info_changed` (ASSOC,
+    /// QOS) and `mgd_complete_tx`.
+    pub(crate) fn associated(&mut self, association: &Association) -> radio::Result<()> {
+        let Some(network) = self.network.as_mut() else { return Err(radio::Error::Invalid) };
+        network.peer = association.peer.clone();
+        network.join.chandef = association.chandef;
+        self.aid = association.aid & 0x3fff;
+        self.qos = association.qos;
+        let result = self.add_bss(true).and_then(|()| self.station_record(true, STATE_ASSOC)).and_then(|()| self.own_record());
+        if let Err(error) = result {
+            ostd::warn!("{}: association: {}", self.name, error);
+            self.roc_abort();
+            return Err(radio::Error::Failed);
+        }
+        self.set_tx(&association.elements);
+        self.roc_abort();
+        self.associated = true;
+        Ok(())
+    }
+
+    /// Linux's `mt7921_mac_sta_remove`: the station's record disabled, the
+    /// BSS not connected any more.
+    pub(crate) fn leave(&mut self) {
+        if self.network.is_none() {
+            return;
+        }
+        if !self.dead {
+            self.roc_abort();
+            let _ = self.station_record(false, STATE_NONE);
+            let _ = self.add_bss(false);
+        }
+        self.network = None;
+        self.associated = false;
+        self.aid = 0;
+        self.pairwise = None;
+        self.signal = None;
+    }
+
+    // ---- As an access point (`mt7921_start_ap`, `_bss_info_changed`,
+    // `_mac_sta_add`, `_mac_sta_assoc`, `_mac_sta_remove`). ----
+
+    /// The channel, the BSS active with its beacon offloaded, the
+    /// interface's entry for group frames, the access classes' parameters.
+    pub(crate) fn start_ap(&mut self, config: &ApConfig) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        self.stop_ap();
+        self.leave();
+        self.abort_scan();
+        self.ap = Some(Ap::new(config));
+        let result = self
+            .chan_info(EXT_CHANNEL_SWITCH, &config.chandef)
+            .and_then(|()| self.add_bss_ap(true))
+            .and_then(|()| self.bss_pm(true))
+            .and_then(|()| self.own_record())
+            .and_then(|()| self.beacon_offload());
+        if let Err(error) = result {
+            ostd::warn!("{}: the access point: {}", self.name, error);
+            self.stop_ap();
+            return Err(radio::Error::Failed);
+        }
+        self.qos = self.ap.as_ref().is_some_and(|ap| ap.qos);
+        let elements = config.beacon.elements();
+        self.set_tx(&elements);
+        Ok(())
+    }
+
+    pub(crate) fn set_beacon(&mut self, beacon: &BeaconTemplate) -> radio::Result<()> {
+        let Some(ap) = &mut self.ap else { return Err(radio::Error::Down) };
+        ap.read_beacon(beacon);
+        self.beacon_offload().map_err(|error| {
+            ostd::warn!("{}: beacon: {}", self.name, error);
+            radio::Error::Failed
+        })
+    }
+
+    /// The stations' entries reset, the firmware's BSS ended and
+    /// inactive, the interface a station's again.
+    pub(crate) fn stop_ap(&mut self) {
+        let Some(ap) = &self.ap else { return };
+        let addresses: Vec<Address> = ap.stations.keys().copied().collect();
+        if !self.dead {
+            for address in &addresses {
+                self.remove_station(address);
+            }
+            let _ = self.bss_pm(false);
+            let _ = self.add_bss_ap(false);
+        }
+        self.ap = None;
+        self.qos = false;
+        if !self.dead {
+            let _ = self.add_interface();
+        }
+    }
+
+    /// A station's entry: its basics first, then everything it runs once
+    /// associated (as mac80211's NONE and ASSOC states).
+    pub(crate) fn add_station(&mut self, station: &StationEntry) -> radio::Result<()> {
+        let Some(ap) = &self.ap else { return Err(radio::Error::Down) };
+        if ap.stations.contains_key(&station.address) {
+            self.remove_station(&station.address);
+        }
+        let Some(ap) = &mut self.ap else { return Err(radio::Error::Down) };
+        let used: Vec<u8> = ap.stations.values().map(|station| station.wcid).collect();
+        let Some(wcid) = (1..=AP_STATIONS).find(|wcid| !used.contains(wcid)) else { return Err(radio::Error::Busy) };
+        ap.stations.insert(station.address, ApStation { wcid, qos: station.peer.qos, key: false });
+        let (rates, _) = rate_bitmaps(ap.ghz2(), station.peer.rates.iter().copied());
+        let record = PeerRecord {
+            wcid,
+            address: station.address,
+            aid: station.aid & 0x3fff,
+            qos: station.peer.qos,
+            peer: &station.peer,
+            chandef: ap.config.chandef,
+            rates,
+            basic: ap.basic,
+            ap: true,
+        };
+        let result = self.peer_record(&record, true, STATE_NONE).and_then(|()| self.peer_record(&record, true, STATE_ASSOC));
+        if let Err(error) = result {
+            ostd::warn!("{}: station {:02x?}: {}", self.name, station.address, error);
+            self.remove_station(&station.address);
+            return Err(radio::Error::Failed);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn remove_station(&mut self, address: &Address) {
+        let Some(ap) = &mut self.ap else { return };
+        let Some(station) = ap.stations.remove(address) else { return };
+        let none = radio::Peer::default();
+        let record = PeerRecord { wcid: station.wcid, address: *address, aid: 0, qos: false, peer: &none, chandef: ap.config.chandef, rates: 0, basic: 0, ap: true };
+        if !self.dead {
+            let _ = self.peer_record(&record, false, STATE_NONE);
+        }
+    }
+
+    /// `mt76_connac_mcu_add_key`: pairwise keys on the AP's entry, group
+    /// keys on the interface's; as an access point, pairwise keys on the
+    /// station's.
+    pub(crate) fn set_key(&mut self, key: &Key, remove: bool) -> radio::Result<()> {
+        let cipher = match key.cipher {
+            radio::CIPHER_CCMP => MCU_CIPHER_AES_CCMP,
+            radio::CIPHER_CCMP_256 => MCU_CIPHER_CCMP_256,
+            radio::CIPHER_GCMP => MCU_CIPHER_GCMP,
+            radio::CIPHER_GCMP_256 => MCU_CIPHER_GCMP_256,
+            _ if remove => MCU_CIPHER_AES_CCMP,
+            _ => return Err(radio::Error::Unsupported),
+        };
+        if key.key.len() > 32 {
+            return Err(radio::Error::Invalid);
+        }
+        let (wcid, muar) = match (&self.ap, key.pairwise) {
+            (_, false) => (WCID_OWN, MUAR_NONE),
+            (None, true) => (WCID_AP, 0),
+            (Some(ap), true) => {
+                // A station's key goes with its entry when it leaves.
+                let Some(station) = key.address.and_then(|address| ap.stations.get(&address)) else {
+                    return if remove { Ok(()) } else { Err(radio::Error::Invalid) };
+                };
+                (station.wcid, 0)
+            }
+        };
+        // `struct sta_rec_sec`: add (0: set, 1: remove), the count, then
+        // two `sec_key`s; the length says how many count.
+        let mut value = vec![remove as u8, !remove as u8, 0, 0];
+        let mut first = [0u8; SEC_KEY];
+        if !remove {
+            first[0] = cipher;
+            first[1] = SEC_KEY as u8;
+            first[2] = key.index;
+            first[3] = key.key.len() as u8;
+            first[4..4 + key.key.len()].copy_from_slice(&key.key);
+        }
+        value.extend_from_slice(&first);
+        value.extend_from_slice(&[0; SEC_KEY]);
+        let length = if remove { 8 } else { 8 + SEC_KEY } as u16;
+        let mut entry = tlv(STA_REC_KEY_V2, &value);
+        entry[2..4].copy_from_slice(&length.to_le_bytes());
+        if let Err(error) = self.sta_rec(wcid, muar, &[entry]) {
+            ostd::warn!("{}: key: {}", self.name, error);
+            return Err(radio::Error::Failed);
+        }
+        if let Some(ap) = &mut self.ap {
+            if let Some(station) = key.address.and_then(|address| ap.stations.get_mut(&address)).filter(|_| key.pairwise) {
+                station.key = !remove;
+            }
+        } else if key.pairwise {
+            self.pairwise = if remove { None } else { Some((key.index, 1)) };
+        }
+        Ok(())
+    }
+
+    // ---- Frames. ----
+
+    fn token(&mut self) -> Option<usize> {
+        let now = crate::now_ms().max(1);
+        for step in 0..TOKENS {
+            let token = (self.next_token + step) % TOKENS;
+            let busy = self.token_busy[token];
+            if busy == 0 || now >= busy + TOKEN_STALE_MS {
+                self.next_token = (token + 1) % TOKENS;
+                self.token_busy[token] = now;
+                return Some(token);
+            }
+        }
+        None
+    }
+
+    /// Sends an 802.11 frame: TXD and TXP on the data ring, the frame in a
+    /// token's buffer (Linux's `mt76_connac2_mac_write_txwi` and
+    /// `mt76_connac_write_hw_txp`). Data frames go without the cipher's
+    /// header (the chip makes it); robust management frames get it here.
+    pub(crate) fn transmit(&mut self, mut frame: Vec<u8>) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if frame.len() < wifi::HEADER {
+            return Err(radio::Error::Invalid);
+        }
+        let data = wifi::is_data(&frame);
+        if frame[1] & wifi::PROTECTED != 0 && self.ap.is_some() {
+            // As an access point: data with the receiver's key, no
+            // protected management frames.
+            if !data {
+                frame[1] &= !wifi::PROTECTED;
+            }
+        } else if frame[1] & wifi::PROTECTED != 0 {
+            match self.pairwise.as_mut() {
+                Some((index, pn)) if !data => {
+                    let value = *pn;
+                    *pn += 1;
+                    let header = [value as u8, (value >> 8) as u8, 0, 0x20 | (*index << 6), (value >> 16) as u8, (value >> 24) as u8, (value >> 32) as u8, (value >> 40) as u8];
+                    drop(frame.splice(wifi::HEADER..wifi::HEADER, header));
+                }
+                Some(_) => {}
+                None => frame[1] &= !wifi::PROTECTED,
+            }
+        }
+        let protected = frame[1] & wifi::PROTECTED != 0;
+        let sequence = self.sequence;
+        self.sequence = (sequence + 1) & 0x0fff;
+        frame[22..24].copy_from_slice(&(sequence << 4).to_le_bytes());
+        let qos_data = data && frame[0] & 0x80 != 0;
+        let header = if qos_data { 26 } else { 24 };
+        let tid = if qos_data { (frame[24] & 7) as u32 } else { 0 };
+        let multicast = frame[4] & 1 != 0;
+        let (kind, subtype) = (((frame[0] >> 2) & 3) as u32, ((frame[0] >> 4) & 0xf) as u32);
+        let wcid = match &self.ap {
+            // A station's entry by the receiver, the interface's for group
+            // frames and stations not yet associated.
+            Some(ap) => frame.get(4..10).and_then(|b| <Address>::try_from(b).ok()).and_then(|address| ap.stations.get(&address)).map_or(WCID_OWN, |station| station.wcid),
+            None if self.network.is_some() => WCID_AP,
+            None => WCID_OWN,
+        } as u32;
+        if frame.len() > BUFFER {
+            return Err(radio::Error::Invalid);
+        }
+        let Some(token) = self.token() else { return Err(radio::Error::Busy) };
+        if self.tokens.write_bytes(token * BUFFER, &frame).is_err() {
+            self.token_busy[token] = 0;
+            return Err(radio::Error::Memory);
+        }
+        // The LMAC queue: the access category of the TID (BK 0, BE 1, VI 2,
+        // VO 3), management on ALTX0.
+        let queue = if data { [1u32, 0, 0, 1, 2, 2, 3, 3][tid as usize] } else { LMAC_ALTX0 };
+        let mut txd = [0u32; 8];
+        txd[0] = ((frame.len() + TXD_SIZE) as u32 & 0xffff) | (queue << 25);
+        txd[1] = (1 << 31) | (wcid & 0x3ff) | (HDR_FORMAT_802_11 << 16) | (((header / 2) as u32) << 11) | (tid << 20);
+        txd[2] = (kind << 4) | subtype | if multicast { TXD2_MULTICAST } else { 0 };
+        txd[3] = (15 << 11) | if protected { TXD3_PROTECT_FRAME } else { 0 };
+        if !data || multicast {
+            // The band's lowest rate: CCK 1 Mbit/s, or OFDM 6 Mbit/s.
+            let ghz2 = match &self.ap {
+                Some(ap) => ap.ghz2(),
+                None => self.network.as_ref().is_none_or(Network::ghz2),
+            };
+            let rate: u32 = if ghz2 { 0 } else { (1 << 6) | 11 };
+            txd[2] |= TXD2_FIX_RATE | TXD2_HTC_VLD;
+            txd[3] |= TXD3_BA_DISABLE;
+            txd[6] = TXD6_FIXED_BW | (rate << 16);
+        }
+        txd[7] = (kind << 20) | (subtype << 16);
+        let mut txwi = Vec::with_capacity(TXD_SIZE + TXP_SIZE);
+        for word in txd {
+            txwi.extend_from_slice(&word.to_le_bytes());
+        }
+        let mut txp = [0u8; TXP_SIZE];
+        txp[0..2].copy_from_slice(&(token as u16 | MSDU_ID_VALID).to_le_bytes());
+        let address = (self.tokens.daddr() + token * BUFFER) as u32;
+        txp[8..12].copy_from_slice(&address.to_le_bytes());
+        txp[12..14].copy_from_slice(&((frame.len() as u16 & 0x0fff) | TXD_LEN_LAST).to_le_bytes());
+        txwi.extend_from_slice(&txp);
+        self.chip.data_send(&txwi).map_err(|()| {
+            self.token_busy[token] = 0;
+            radio::Error::Busy
+        })
+    }
+
+    pub(crate) fn send(&mut self, ethernet: &[u8], plain: bool) -> radio::Result<()> {
+        if let Some(ap) = &self.ap {
+            // To the station the destination names (QoS data when it runs
+            // WMM), or to all of them as plain data with the group's key.
+            let destination: Address = ethernet.get(..6).and_then(|b| b.try_into().ok()).ok_or(radio::Error::Invalid)?;
+            let (tid, keyed) = if wifi::is_multicast(&destination) {
+                (None, true)
+            } else {
+                let station = ap.stations.get(&destination).ok_or(radio::Error::Invalid)?;
+                (station.qos.then(|| wifi::tid_of(ethernet)), station.key)
+            };
+            let frame = wifi::data_from_ethernet_ap(ethernet, &self.address, tid, !plain && keyed).ok_or(radio::Error::Invalid)?;
+            return self.transmit(frame);
+        }
+        let Some(network) = &self.network else { return Err(radio::Error::Down) };
+        let tid = self.qos.then(|| wifi::tid_of(ethernet));
+        let protected = !plain && self.pairwise.is_some();
+        let frame = wifi::data_from_ethernet(ethernet, &network.join.bssid, tid, protected).ok_or(radio::Error::Invalid)?;
+        self.transmit(frame)
+    }
+
+    // ---- What the chip says. ----
+
+    pub(crate) fn poll(&mut self) {
+        if self.dead {
+            return;
+        }
+        let status = self.chip.rr(hw::HOST_INT_STA);
+        if status == u32::MAX {
+            ostd::warn!("{}: the card is gone", self.name);
+            self.died();
+            return;
+        }
+        if status != 0 {
+            self.chip.wr(hw::HOST_INT_STA, status);
+        }
+        if status & hw::INT_MCU_CMD != 0 {
+            let command = self.chip.rr(hw::MCU_CMD);
+            self.chip.wr(hw::MCU_CMD, command);
+            if command & MCU_CMD_STOP_DMA != 0 {
+                ostd::warn!("{}: the firmware stopped ({:#x}); the card stays off until the next boot", self.name, command);
+                self.died();
+                return;
+            }
+        }
+        let mut packets = core::mem::take(&mut self.chip.pending);
+        for which in [hw::RXQ_MCU, hw::RXQ_MCU_WA, hw::RXQ_DATA] {
+            packets.extend(self.chip.ring_receive(which));
+        }
+        for packet in packets {
+            self.handle(&packet);
+        }
+        if self.scanning && crate::now_ms() >= self.scan_started + SCAN_LIMIT_MS {
+            ostd::warn!("{}: the scan did not end; ended here", self.name);
+            self.scanning = false;
+            if let Some(device) = &self.device {
+                device.scan_done(true);
+            }
+        }
+    }
+
+    fn died(&mut self) {
+        self.dead = true;
+        if let Some(device) = &self.device {
+            if self.scanning {
+                device.scan_done(true);
+            }
+            device.connection_lost();
+        }
+        self.scanning = false;
+    }
+
+    fn handle(&mut self, packet: &[u8]) {
+        let rxd0 = le32(packet, 0);
+        let (kind, flag) = (rxd0 >> 27, (rxd0 >> 16) & 0xf);
+        match kind {
+            PKT_TYPE_NORMAL => self.rx_frame(packet),
+            PKT_TYPE_RX_EVENT if flag == 1 => self.rx_frame(packet),
+            PKT_TYPE_TXRX_NOTIFY => self.tx_free(packet),
+            PKT_TYPE_RX_EVENT if packet.len() >= hw::MCU_RXD => self.event(packet),
+            _ => {}
+        }
+    }
+
+    /// `struct mt76_connac_tx_free`, then one word per frame or per
+    /// station ("pair") the frames after it belong to.
+    fn tx_free(&mut self, packet: &[u8]) {
+        let count = (le16(packet, 2) & 0x3ff) as usize;
+        let mut freed = 0;
+        let mut at = 8;
+        while freed < count && at + 4 <= packet.len() {
+            let info = le32(packet, at);
+            at += 4;
+            if info & TX_FREE_PAIR != 0 {
+                continue;
+            }
+            freed += 1;
+            let token = ((info >> 16) & 0x7fff) as usize;
+            if let Some(busy) = self.token_busy.get_mut(token) {
+                *busy = 0;
+            }
+        }
+        if let Some(device) = &self.device {
+            device.ready_to_send();
+        }
+    }
+
+    fn event(&mut self, packet: &[u8]) {
+        let (eid, option) = (packet[28], packet[30]);
+        if option & UNI_UNSOLICITED != 0 {
+            if eid == UNI_EVENT_ROC && le16(packet, hw::MCU_RXD + 4) == 0 {
+                self.roc_granted = true;
+            }
+            return;
+        }
+        match eid {
+            EVENT_SCAN_DONE | EVENT_SCHED_SCAN_DONE => {
+                if self.scanning {
+                    self.scanning = false;
+                    if let Some(device) = &self.device {
+                        device.scan_done(false);
+                    }
+                }
+            }
+            EVENT_BSS_BEACON_LOSS => {
+                if self.associated
+                    && let Some(device) = &self.device
+                {
+                    ostd::info!("{}: the firmware lost the access point's beacons", self.name);
+                    device.connection_lost();
+                }
+            }
+            _ => {}
+        }
+    }
+
+    /// A frame after its RXD (Linux's `mt7921_mac_fill_rx`): six words,
+    /// the groups the RXD says are there, the padding; A-MSDU subframes
+    /// (the chip splits them) carry two bytes more after the header.
+    fn rx_frame(&mut self, packet: &[u8]) {
+        let (rxd0, rxd1, rxd2, rxd3, rxd4) = (le32(packet, 0), le32(packet, 4), le32(packet, 8), le32(packet, 12), le32(packet, 16));
+        let length = (rxd0 & 0xffff) as usize;
+        // Band 1, ICV and MIC errors, a bad FCS, a broken A-MSDU, too long.
+        if rxd1 & ((1 << 28) | (1 << 27) | (1 << 26) | (1 << 25)) != 0 || rxd2 & ((1 << 23) | (1 << 24)) != 0 {
+            return;
+        }
+        // Header translation is off in every WTBL entry: 802.11 only.
+        if rxd2 & (1 << 13) != 0 {
+            return;
+        }
+        let mut at = 24;
+        let mut signal: Option<i16> = None;
+        if rxd1 & (1 << 14) != 0 {
+            at += 16;
+        }
+        if rxd1 & (1 << 11) != 0 {
+            at += 16;
+        }
+        if rxd1 & (1 << 12) != 0 {
+            at += 8;
+        }
+        if rxd1 & (1 << 13) != 0 {
+            let mut v1 = le32(packet, at + 4);
+            at += 8;
+            if rxd1 & (1 << 15) != 0 {
+                v1 = le32(packet, at + 24);
+                at += 72;
+            }
+            for chain in 0..self.nss as u32 {
+                let rssi = (((v1 >> (8 * chain)) & 0xff) as i16 - 220) / 2;
+                if rssi < 0 {
+                    signal = Some(signal.map_or(rssi, |best| best.max(rssi)));
+                }
+            }
+        }
+        at += 2 * ((rxd2 >> 14) & 3) as usize;
+        let Some(frame) = packet.get(at..length.min(packet.len())) else { return };
+        if frame.len() < wifi::HEADER {
+            return;
+        }
+        let mut frame = frame.to_vec();
+        if rxd4 & 3 != 0 {
+            let header = if wifi::is_data(&frame) && frame[0] & 0x80 != 0 { 26 } else { 24 };
+            if frame.len() < header + 2 {
+                return;
+            }
+            drop(frame.drain(header..header + 2));
+        }
+        let channel = ((rxd3 >> 8) & 0xff) as u16;
+        let freq = match channel {
+            1..=13 => 2407 + 5 * channel,
+            14 => 2484,
+            15..=180 => 5000 + 5 * channel,
+            _ => return,
+        };
+        let decrypted = (rxd1 >> 16) & 0x1f != 0 && rxd1 & ((1 << 23) | (1 << 24)) == 0;
+        let signal = signal.unwrap_or(-100).clamp(-127, -1) as i8;
+        if let Some(network) = &self.network
+            && wifi::addresses(&frame).is_some_and(|(_, transmitter, _)| transmitter == network.join.bssid)
+        {
+            self.signal = Some(signal);
+        }
+        if let Some(device) = &self.device {
+            device.received(&frame, RxInfo { freq, signal, decrypted, security_header: 0 });
+        }
+    }
+
+    /// What the radio runs (Linux's mt7921 bands): HT up to 40 MHz on both,
+    /// VHT at 5 GHz up to 80 MHz (160 on the MT7922), HE on both.
+    pub(crate) fn info(&self) -> Info {
+        let mut mcs = [0u8; 16];
+        for stream in 0..self.nss as usize {
+            mcs[stream] = 0xff;
+        }
+        mcs[12] = 1;
+        let mut ht_info = HT_INFO;
+        if self.nss < 2 {
+            ht_info &= !0x0080;
+        }
+        let ht = HtCap { info: ht_info, ampdu_factor: 3, ampdu_density: 5, mcs };
+        let map = self.mcs_map();
+        let mut vht_mcs = [0u8; 8];
+        vht_mcs[0..2].copy_from_slice(&map.to_le_bytes());
+        vht_mcs[4..6].copy_from_slice(&map.to_le_bytes());
+        let mut vht_info = VHT_INFO | if self.wide160 { VHT_INFO_160 } else { 0 };
+        if self.nss < 2 {
+            vht_info &= !chan::VHT_CAP_TXSTBC;
+        }
+        let vht = VhtCap { info: vht_info, mcs: vht_mcs };
+        let he = |id: BandId| {
+            let phy = match (id, self.wide160) {
+                (BandId::Ghz2, false) => HE_PHY_2GHZ,
+                (BandId::Ghz2, true) => HE_PHY_2GHZ_7922,
+                (_, false) => HE_PHY_5GHZ,
+                (_, true) => HE_PHY_5GHZ_7922,
+            };
+            let bytes = map.to_le_bytes();
+            let mut mcs = vec![bytes[0], bytes[1], bytes[0], bytes[1]];
+            if id != BandId::Ghz2 && self.wide160 {
+                mcs.extend_from_slice(&[bytes[0], bytes[1], bytes[0], bytes[1]]);
+            }
+            HeCap { mac: HE_MAC, phy, mcs, ppe: connac_ppe(self.nss, id) }
+        };
+        let band = |id: BandId| Band { id, channels: chan::default_channels(id), ht: Some(ht), vht: (id == BandId::Ghz5).then_some(vht), he: Some(he(id)) };
+        Info {
+            driver: String::from("mt7921"),
+            address: self.address,
+            bands: vec![band(BandId::Ghz2), band(BandId::Ghz5)],
+            ciphers: vec![radio::CIPHER_CCMP, radio::CIPHER_GCMP, radio::CIPHER_GCMP_256, radio::CIPHER_CCMP_256],
+            max_scan_ssids: 4,
+            max_scan_ie_len: 600,
+            ap: true,
+        }
+    }
+}
