+/// The secondary channel's side as the RLM wants it: above (1, "SCA"),
+/// below (3, "SCB"), none.
+pub(crate) fn sco(chandef: &Chandef) -> u8 {
+    match chandef.control.cmp(&chandef.center) {
+        core::cmp::Ordering::Less => 1,
+        core::cmp::Ordering::Greater => 3,
+        core::cmp::Ordering::Equal => 0,
+    }
+}
+
+/// `mt76_connac_gen_ppe_thresh`: the PPE thresholds of `nss` streams on a
+/// band (all RUs up to 996 tones at 5 GHz, 484 at 2.4).
+pub(crate) fn connac_ppe(nss: u8, band: BandId) -> Vec<u8> {
+    const PATTERN: [u8; 3] = [0x1c, 0xc7, 0x71];
+    let ru_mask: u8 = if band == BandId::Ghz2 { 0x3 } else { 0xf };
+    let nss = nss.max(1);
+    let mut out = vec![(nss - 1) | (ru_mask << 3)];
+    let bits = 3 * nss as usize * ru_mask.count_ones() as usize * 2;
+    let size = bits.div_ceil(8);
+    for index in 0..size - 1 {
+        out.push(PATTERN[index % 3]);
+    }
+    out.push(PATTERN[(size - 1) % 3] & (0xff >> (8 - (bits - 1) % 8)));
+    out
+}
+
+/// A TLV: tag, length (with its four bytes), value.
+fn tlv(tag: u16, value: &[u8]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(4 + value.len());
+    out.extend_from_slice(&tag.to_le_bytes());
+    out.extend_from_slice(&((4 + value.len()) as u16).to_le_bytes());
+    out.extend_from_slice(value);
+    out
+}
+
+pub(crate) fn le32(data: &[u8], at: usize) -> u32 {
+    data.get(at..at + 4).map_or(0, |b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+}
+
+fn le16(data: &[u8], at: usize) -> u16 {
+    data.get(at..at + 2).map_or(0, |b| u16::from_le_bytes([b[0], b[1]]))
+}
+
+fn is_2ghz(freq: u16) -> bool {
+    BandId::of(freq) == BandId::Ghz2
+}
+
+/// A channel's number and its band as the firmware's scan and ROC name
+/// them (1: 2.4 GHz, 2: 5 GHz).
+fn channel_band(freq: u16) -> (u8, u8) {
+    (wifi::channel_of(freq).unwrap_or(0), if is_2ghz(freq) { 1 } else { 2 })
+}
+
+/// Rates (in 500 kbit/s, the basic ones flagged) as the band's bitmaps:
+/// all of them and the basic ones, the band's when none is given.
+pub(crate) fn rate_bitmaps(ghz2: bool, rates: impl Iterator<Item = u8>) -> (u16, u16) {
+    let table: &[u8] = if ghz2 { &RATES_2GHZ } else { &RATES_5GHZ };
+    let (mut all, mut basic) = (0u16, 0u16);
+    for rate in rates {
+        if let Some(index) = table.iter().position(|&known| known == rate & 0x7f) {
+            all |= 1 << index;
+            if rate & 0x80 != 0 {
+                basic |= 1 << index;
+            }
+        }
+    }
+    if all == 0 {
+        all = (1 << table.len()) - 1;
+    }
+    if basic == 0 {
+        basic = if ghz2 { 0x000f } else { 0x0015 };
+    }
+    (all, basic)
+}
+
+/// The rates of a frame's elements.
+pub(crate) fn element_rates(elements: &[u8]) -> Vec<u8> {
+    let elements = wifi::Elements(elements);
+    [wifi::IE_RATES, wifi::IE_EXT_RATES].iter().flat_map(|&id| elements.get(id).unwrap_or(&[]).iter().copied()).collect()
+}
+
+/// The network being joined: what the station records need.
+#[derive(Clone)]
+struct Network {
+    join: Join,
+    /// What the access point and this station run (known once it took
+    /// the station: HT, VHT, HE, the width).
+    peer: radio::Peer,
+    /// The access point's rates, as the band's bitmap, and its basic ones.
+    rates: u16,
+    basic: u16,
+    dtim: u8,
+}
+
+impl Network {
+    fn new(join: &Join) -> Self {
+        let elements = wifi::Elements(&join.elements);
+        let (rates, basic) = rate_bitmaps(is_2ghz(join.freq), element_rates(&join.elements).into_iter());
+        // The DTIM period, from the beacon's TIM (a probe response has none).
+        let dtim = elements.get(wifi::IE_TIM).and_then(|value| value.get(1).copied()).filter(|&period| period > 0).unwrap_or(1);
+        Self { join: join.clone(), peer: radio::Peer::default(), rates, basic, dtim }
+    }
+
+    fn ghz2(&self) -> bool {
+        is_2ghz(self.join.freq)
+    }
+}
+
+/// The network this radio runs as an access point.
+struct Ap {
+    config: ApConfig,
+    /// Its beacon's: WMM, HE, the HE operation's first bytes.
+    qos: bool,
+    he: bool,
+    he_operation: Option<Vec<u8>>,
+    basic: u16,
+    stations: BTreeMap<Address, ApStation>,
+}
+
+impl Ap {
+    fn new(config: &ApConfig) -> Self {
+        let mut ap = Self { config: config.clone(), qos: false, he: false, he_operation: None, basic: 0, stations: BTreeMap::new() };
+        ap.read_beacon(&config.beacon);
+        ap
+    }
+
+    fn read_beacon(&mut self, beacon: &BeaconTemplate) {
+        let elements = beacon.elements();
+        let list = wifi::Elements(&elements);
+        self.qos = list.vendor(wifi::WMM_OUI_TYPE).is_some();
+        self.he = list.extension(wifi::EXT_HE_CAP).is_some();
+        self.he_operation = list.extension(wifi::EXT_HE_OPERATION).map(<[u8]>::to_vec);
+        self.basic = rate_bitmaps(self.ghz2(), element_rates(&elements).into_iter()).1;
+        self.config.beacon = beacon.clone();
+    }
+
+    fn ghz2(&self) -> bool {
+        is_2ghz(self.config.chandef.control)
+    }
+}
