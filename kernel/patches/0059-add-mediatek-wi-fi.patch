+// SPDX-License-Identifier: MPL-2.0
+
+//! The station on the MediaTek firmware, as Linux's mt7921 and
+//! mt76_connac drive it: the interface (`DEV_INFO_UPDATE`,
+//! `BSS_INFO_UPDATE`), scans (`START_HW_SCAN`), the access point's station
+//! record and its WTBL entry (`STA_REC_UPDATE`), the channel for joining
+//! (`ROC`), keys (`STA_REC_KEY_V2`); frames out as a TXD and TXP the chip
+//! reads, frames in after their RXD.
+
+use alloc::{format, string::String, sync::Arc, vec, vec::Vec};
+
+use aster_wlan::{
+    Device,
+    ieee80211::{self as wifi, Address},
+    radio::{self, Association, Band, BandId, Channel, HtCap, Info, Join, Key, RxInfo, ScanRequest},
+};
+use ostd::mm::{HasDaddr, VmIo, dma::DmaCoherent};
+
+use crate::hw::{self, BUFFER, Chip, Cmd};
+
+// MCU commands and events (`mt76_connac_mcu.h`, `mt7921/mcu.h`).
+const CE_START_HW_SCAN: u8 = 0x03;
+const CE_SET_RX_FILTER: u8 = 0x0a;
+const CE_SET_CHAN_DOMAIN: u8 = 0x0f;
+const CE_CANCEL_HW_SCAN: u8 = 0x1b;
+const CE_SET_EDCA_PARMS: u8 = 0x1d;
+const CE_GET_NIC_CAPAB: u8 = 0x8a;
+const EXT_EFUSE_BUFFER_MODE: u8 = 0x21;
+const EXT_PROTECT_CTRL: u8 = 0x3e;
+const EXT_MAC_INIT_CTRL: u8 = 0x46;
+const EXT_SET_RX_PATH: u8 = 0x4e;
+const UNI_DEV_INFO_UPDATE: u16 = 0x01;
+const UNI_BSS_INFO_UPDATE: u16 = 0x02;
+const UNI_STA_REC_UPDATE: u16 = 0x03;
+const UNI_ROC: u16 = 0x27;
+const EVENT_SCAN_DONE: u8 = 0x0d;
+const EVENT_BSS_BEACON_LOSS: u8 = 0x13;
+const EVENT_SCHED_SCAN_DONE: u8 = 0x23;
+const UNI_EVENT_ROC: u8 = 0x27;
+/// An event's option: unsolicited, of the UNI set.
+const UNI_UNSOLICITED: u8 = 1 << 2;
+// RXD packet types (`MT_RXD0_PKT_TYPE`) and the flag of frames that came
+// through the MCU.
+const PKT_TYPE_NORMAL: u32 = 2;
+const PKT_TYPE_TXRX_NOTIFY: u32 = 6;
+const PKT_TYPE_RX_EVENT: u32 = 7;
+const NIC_CAP_MAC_ADDR: u32 = 7;
+const NIC_CAP_PHY: u32 = 8;
+// STA_REC and WTBL TLVs.
+const STA_REC_BASIC: u16 = 0x00;
+const STA_REC_RA: u16 = 0x01;
+const STA_REC_STATE: u16 = 0x07;
+const STA_REC_HT: u16 = 0x09;
+const STA_REC_WTBL: u16 = 0x0d;
+const STA_REC_KEY_V2: u16 = 0x11;
+const STA_REC_PHY: u16 = 0x15;
+const WTBL_GENERIC: u16 = 0x00;
+const WTBL_RX: u16 = 0x01;
+const WTBL_HT: u16 = 0x02;
+const WTBL_HDR_TRANS: u16 = 0x06;
+const WTBL_SMPS: u16 = 0x0d;
+const WTBL_RESET_AND_SET: u8 = 1;
+const UNI_BSS_INFO_BASIC: u16 = 0x00;
+const UNI_BSS_INFO_RLM: u16 = 0x02;
+const UNI_BSS_INFO_QBSS: u16 = 0x0f;
+const DEV_INFO_ACTIVE: u16 = 0;
+const ROC_ACQUIRE: u16 = 0;
+const ROC_ABORT: u16 = 1;
+const ROC_REQ_JOIN: u8 = 0;
+const CONNECTION_INFRA_STA: u32 = 0x0001_0001;
+const CONNECTION_INFRA_AP: u32 = 0x0001_0002;
+const CONN_STATE_DISCONNECT: u8 = 0;
+const CONN_STATE_PORT_SECURE: u8 = 2;
+const STATE_NONE: u8 = 0;
+const STATE_ASSOC: u8 = 2;
+const EXTRA_INFO_VER: u16 = 1 << 0;
+const EXTRA_INFO_NEW: u16 = 1 << 1;
+const PHY_MODE_A: u8 = 1 << 0;
+const PHY_MODE_B: u8 = 1 << 1;
+const PHY_MODE_G: u8 = 1 << 2;
+const PHY_MODE_GN: u8 = 1 << 3;
+const PHY_MODE_AN: u8 = 1 << 4;
+const PHY_TYPE_BIT_HR_DSSS: u8 = 1 << 0;
+const PHY_TYPE_BIT_ERP: u8 = 1 << 1;
+const PHY_TYPE_BIT_OFDM: u8 = 1 << 3;
+const PHY_TYPE_BIT_HT: u8 = 1 << 4;
+const MCU_CIPHER_AES_CCMP: u8 = 5;
+const MCU_CIPHER_CCMP_256: u8 = 6;
+const MCU_CIPHER_GCMP: u8 = 7;
+const MCU_CIPHER_GCMP_256: u8 = 8;
+/// `struct sec_key`'s size.
+const SEC_KEY: usize = 36;
+/// The receive filter: on, and nothing more (Linux's `MT7921_FILTER_ENABLE`
+/// with mac80211's flags of a station).
+const FILTER_ENABLE: u32 = 1 << 31;
+/// The MCU's "the firmware asked the DMA to stop" (it wants a recovery,
+/// which this driver does not do).
+const MCU_CMD_STOP_DMA: u32 = 1 << 2;
+/// The WTBL's entries: the access point's station, and the interface's
+/// own (`MT792x_WTBL_RESERVED` less the interface's index), for group keys.
+pub(crate) const WCID_AP: u8 = 1;
+pub(crate) const WCID_OWN: u8 = 19;
+/// The interface's own MAC in the WTBL when an entry has no station.
+const MUAR_NONE: u8 = 0x0e;
+// TXD (`mt76_connac2_mac.h`) and TXP (`struct mt76_connac_hw_txp`).
+const TXD_SIZE: usize = 32;
+const TXP_SIZE: usize = 32;
+const LMAC_ALTX0: u32 = 0x10;
+const HDR_FORMAT_802_11: u32 = 2;
+const TXD2_FIX_RATE: u32 = 1 << 31;
+const TXD2_HTC_VLD: u32 = 1 << 13;
+const TXD2_MULTICAST: u32 = 1 << 10;
+const TXD3_PROTECT_FRAME: u32 = 1 << 1;
+const TXD3_BA_DISABLE: u32 = 1 << 28;
+const TXD6_FIXED_BW: u32 = 1 << 2;
+const MSDU_ID_VALID: u16 = 1 << 15;
+const TXD_LEN_LAST: u16 = 1 << 15;
+const TX_FREE_PAIR: u32 = 1 << 31;
+/// Frame buffers the chip reads through a TXP until a TX-free event gives
+/// them back.
+pub(crate) const TOKENS: usize = 128;
+/// A token the chip never gave back is taken again after this long.
+const TOKEN_STALE_MS: u64 = 2_000;
+/// How long a join keeps the channel (ROC) and how long its grant may take.
+const ROC_MS: u32 = 3_000;
+const ROC_GRANT_MS: u64 = 1_000;
+/// A scan the firmware never ends is ended after this long.
+const SCAN_LIMIT_MS: u64 = 30_000;
+
+/// The rates of each band, in the order of the chip's bitmaps (mt76's
+/// `mt76_rates`: CCK then OFDM; 5 GHz has the OFDM ones), 500 kbit/s each.
+const RATES_2GHZ: [u8; 12] = [2, 4, 11, 22, 12, 18, 24, 36, 48, 72, 96, 108];
+const RATES_5GHZ: [u8; 8] = [12, 18, 24, 36, 48, 72, 96, 108];
+
+/// The 5 GHz channels offered, and the ones that need radar detection
+/// (passive here).
+const CHANNELS_5GHZ: [u16; 25] = [36, 40, 44, 48, 52, 56, 60, 64, 100, 104, 108, 112, 116, 120, 124, 128, 132, 136, 140, 144, 149, 153, 157, 161, 165];
+const IEEE80211_CHAN_NO_IR: u32 = 1 << 1;
+const IEEE80211_CHAN_RADAR: u32 = 1 << 3;
+
+/// The HT capabilities this driver offers: 20 MHz with its short guard
+/// interval, LDPC, one stream of STBC received, no SM power save.
+const HT_INFO: u16 = 0x0001 | 0x000c | 0x0020 | 0x0100;
+
+/// A TLV: tag, length (with its four bytes), value.
+fn tlv(tag: u16, value: &[u8]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(4 + value.len());
+    out.extend_from_slice(&tag.to_le_bytes());
+    out.extend_from_slice(&((4 + value.len()) as u16).to_le_bytes());
+    out.extend_from_slice(value);
+    out
+}
+
+pub(crate) fn le32(data: &[u8], at: usize) -> u32 {
+    data.get(at..at + 4).map_or(0, |b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+}
+
+fn le16(data: &[u8], at: usize) -> u16 {
+    data.get(at..at + 2).map_or(0, |b| u16::from_le_bytes([b[0], b[1]]))
+}
+
+fn is_2ghz(freq: u16) -> bool {
+    BandId::of(freq) == BandId::Ghz2
+}
+
+/// A channel's number and its band as the firmware's scan and ROC name
+/// them (1: 2.4 GHz, 2: 5 GHz).
+fn channel_band(freq: u16) -> (u8, u8) {
+    (wifi::channel_of(freq).unwrap_or(0), if is_2ghz(freq) { 1 } else { 2 })
+}
+
+/// The network being joined: what the station records need.
+#[derive(Clone)]
+struct Network {
+    join: Join,
+    /// The access point's HT capabilities (the element's value).
+    ht: Option<[u8; 26]>,
+    /// The access point's rates, as the band's bitmap, and its basic ones.
+    rates: u16,
+    basic: u16,
+    dtim: u8,
+}
+
+impl Network {
+    fn new(join: &Join) -> Self {
+        let elements = wifi::Elements(&join.elements);
+        let ht = elements.get(wifi::IE_HT_CAP).filter(|value| value.len() >= 26).map(|value| {
+            let mut cap = [0u8; 26];
+            cap.copy_from_slice(&value[..26]);
+            cap
+        });
+        let table: &[u8] = if is_2ghz(join.freq) { &RATES_2GHZ } else { &RATES_5GHZ };
+        let (mut rates, mut basic) = (0u16, 0u16);
+        for id in [wifi::IE_RATES, wifi::IE_EXT_RATES] {
+            for &rate in elements.get(id).unwrap_or(&[]) {
+                if let Some(index) = table.iter().position(|&known| known == rate & 0x7f) {
+                    rates |= 1 << index;
+                    if rate & 0x80 != 0 {
+                        basic |= 1 << index;
+                    }
+                }
+            }
+        }
+        if rates == 0 {
+            rates = (1 << table.len()) - 1;
+        }
+        if basic == 0 {
+            basic = if is_2ghz(join.freq) { 0x000f } else { 0x0015 };
+        }
+        // The DTIM period, from the beacon's TIM (a probe response has none).
+        let dtim = elements.get(5).and_then(|value| value.get(1).copied()).filter(|&period| period > 0).unwrap_or(1);
+        Self { join: join.clone(), ht, rates, basic, dtim }
+    }
+
+    fn ghz2(&self) -> bool {
+        is_2ghz(self.join.freq)
+    }
+}
+
+/// The card's state for its task and the Wi-Fi component.
+pub(crate) struct Mt7921 {
+    pub(crate) chip: Chip,
+    pub(crate) name: String,
+    pub(crate) address: Address,
+    /// Spatial streams (the firmware's PHY capability).
+    nss: u8,
+    pub(crate) device: Option<Arc<Device>>,
+    tokens: DmaCoherent,
+    /// When each token was handed to the chip (0: free).
+    token_busy: Vec<u64>,
+    next_token: usize,
+    network: Option<Network>,
+    associated: bool,
+    aid: u16,
+    qos: bool,
+    /// The pairwise key's index and the PN of the robust management frames
+    /// this driver puts the cipher's header on.
+    pairwise: Option<(u8, u64)>,
+    scanning: bool,
+    scan_started: u64,
+    scan_seq: u8,
+    roc_token: u8,
+    roc_active: bool,
+    roc_granted: bool,
+    sequence: u16,
+    pub(crate) signal: Option<i8>,
+    pub(crate) dead: bool,
+}
+
+impl Mt7921 {
+    pub(crate) fn new(chip: Chip, name: String, tokens: DmaCoherent) -> Self {
+        Self {
+            chip,
+            name,
+            address: [0; 6],
+            nss: 2,
+            device: None,
+            tokens,
+            token_busy: vec![0; TOKENS],
+            next_token: 0,
+            network: None,
+            associated: false,
+            aid: 0,
+            qos: false,
+            pairwise: None,
+            scanning: false,
+            scan_started: 0,
+            scan_seq: 0,
+            roc_token: 0,
+            roc_active: false,
+            roc_granted: false,
+            sequence: 0,
+            signal: None,
+            dead: false,
+        }
+    }
+
+    /// Linux's `mt7921_init_hardware` and `__mt7921_start`: the firmware,
+    /// the chip's facts, its calibration, the MAC, and the interface.
+    pub(crate) fn bring_up(&mut self, patch: &str, ram: &str) -> Result<(), String> {
+        let (_, patch_file) = aster_firmware::load_first([patch]).ok_or_else(|| format!("{patch} is not in /lib/firmware"))?;
+        let (_, ram_file) = aster_firmware::load_first([ram]).ok_or_else(|| format!("{ram} is not in /lib/firmware"))?;
+        self.chip.before_firmware();
+        self.chip.load_patch(&patch_file).map_err(|error| format!("ROM patch: {error}"))?;
+        ostd::info!("{}: ROM patch loaded", self.name);
+        self.chip.load_ram(&ram_file).map_err(|error| format!("RAM code: {error}"))?;
+        ostd::notice!("{}: the firmware runs", self.name);
+        self.capabilities()?;
+        self.chip.mcu(Cmd::Ext(EXT_EFUSE_BUFFER_MODE), &[0, 1, 0, 0], true)?;
+        self.chip.mac_init();
+        // The RTS threshold (`mt76_connac_mcu_set_rts_thresh`).
+        let mut rts = vec![1u8, 0, 0, 0];
+        rts.extend_from_slice(&0x92bu32.to_le_bytes());
+        rts.extend_from_slice(&2u32.to_le_bytes());
+        self.chip.mcu(Cmd::Ext(EXT_PROTECT_CTRL), &rts, true)?;
+        // The MAC on, the channels allowed, the receive path.
+        self.chip.mcu(Cmd::Ext(EXT_MAC_INIT_CTRL), &[1, 0, 0, 0], true)?;
+        self.channel_domain()?;
+        self.rx_path()?;
+        let mut filter = vec![0u8; 68];
+        filter[4] = 1;
+        filter[8..12].copy_from_slice(&FILTER_ENABLE.to_le_bytes());
+        self.chip.mcu(Cmd::Ce(CE_SET_RX_FILTER), &filter, false)?;
+        self.add_interface()
+    }
+
+    /// The MAC address and the streams (`mt7921_mcu_get_nic_capability`).
+    fn capabilities(&mut self) -> Result<(), String> {
+        let answer = self.chip.mcu(Cmd::CeQuery(CE_GET_NIC_CAPAB), &[], true)?;
+        let elements = le16(&answer, 0);
+        let mut at = 4;
+        for _ in 0..elements {
+            let (kind, length) = (le32(&answer, at), le32(&answer, at + 4) as usize);
+            let Some(data) = answer.get(at + 8..at + 8 + length) else { break };
+            match kind {
+                NIC_CAP_MAC_ADDR if data.len() >= 6 => self.address.copy_from_slice(&data[..6]),
+                // `struct mt7921_phy_cap`: ht, vht, 5g, max_bw, nss, ...
+                NIC_CAP_PHY if data.len() >= 5 => self.nss = data[4].clamp(1, 2),
+                _ => {}
+            }
+            at += 8 + length;
+        }
+        if self.address == [0; 6] || self.address[0] & 1 != 0 {
+            return Err(String::from("the card gave no MAC address"));
+        }
+        Ok(())
+    }
+
+    /// The channels the firmware may use (`mt76_connac_mcu_set_channel_domain`),
+    /// worldwide ("00").
+    fn channel_domain(&mut self) -> Result<(), String> {
+        let channels: Vec<(u16, u32)> = (1..=13u16)
+            .map(|channel| (channel, 0))
+            .chain(CHANNELS_5GHZ.iter().map(|&channel| (channel, if (52..=144).contains(&channel) { IEEE80211_CHAN_NO_IR | IEEE80211_CHAN_RADAR } else { 0 })))
+            .collect();
+        let mut out = vec![b'0', b'0', 0, 0, 0, 3, 3, 0, 13, CHANNELS_5GHZ.len() as u8, 0, 0];
+        for (channel, flags) in channels {
+            out.extend_from_slice(&channel.to_le_bytes());
+            out.extend_from_slice(&[0, 0]);
+            out.extend_from_slice(&flags.to_le_bytes());
+        }
+        self.chip.mcu(Cmd::Ce(CE_SET_CHAN_DOMAIN), &out, false).map(|_| ())
+    }
+
+    /// The receive path on the first channel (`mt7921_mcu_set_chan_info`
+    /// with `SET_RX_PATH`).
+    fn rx_path(&mut self) -> Result<(), String> {
+        let mut out = vec![0u8; 76];
+        let mask = (1u8 << self.nss) - 1;
+        out[0] = 1;
+        out[1] = 1;
+        out[3] = self.nss;
+        out[4] = mask;
+        self.chip.mcu(Cmd::Ext(EXT_SET_RX_PATH), &out, true).map(|_| ())
+    }
+
+    /// Linux's `mt76_connac_mcu_uni_add_dev`: the interface's MAC
+    /// (DEV_INFO), then its BSS, a station not connected.
+    fn add_interface(&mut self) -> Result<(), String> {
+        let mut active = vec![1u8, 0];
+        active.extend_from_slice(&self.address);
+        let mut dev = vec![0u8, 0, 0, 0];
+        dev.extend(tlv(DEV_INFO_ACTIVE, &active));
+        self.uni(UNI_DEV_INFO_UPDATE, &dev)?;
+        let basic = self.bss_basic(1, None);
+        let mut out = vec![0u8; 4];
+        out.extend(tlv(UNI_BSS_INFO_BASIC, &basic));
+        self.uni(UNI_BSS_INFO_UPDATE, &out)
+    }
+
+    fn uni(&mut self, id: u16, payload: &[u8]) -> Result<(), String> {
+        let answer = self.chip.mcu(Cmd::Uni(id), payload, true)?;
+        let status = le32(&answer, 4);
+        if status != 0 {
+            return Err(format!("UNI command {id:#x} refused (status {status:#x})"));
+        }
+        Ok(())
+    }
+
+    /// `struct mt76_connac_bss_basic_tlv`'s value: the interface's BSS,
+    /// `conn_state` 1 when not connected, the network when there is one.
+    fn bss_basic(&self, conn_state: u8, network: Option<&Network>) -> Vec<u8> {
+        let ghz2 = network.is_none_or(Network::ghz2);
+        let phymode = if ghz2 { PHY_MODE_B | PHY_MODE_G | PHY_MODE_GN } else { PHY_MODE_A | PHY_MODE_AN };
+        let basic_phy = if ghz2 { PHY_TYPE_BIT_HR_DSSS | PHY_TYPE_BIT_ERP | PHY_TYPE_BIT_HT } else { PHY_TYPE_BIT_OFDM | PHY_TYPE_BIT_HT };
+        let (bssid, interval, dtim) = network.map_or(([0; 6], 0, 0), |network| (network.join.bssid, network.join.beacon_interval, network.dtim));
+        let mut value = Vec::with_capacity(28);
+        value.extend_from_slice(&[1, 0, 0, 0]);
+        value.extend_from_slice(&CONNECTION_INFRA_STA.to_le_bytes());
+        value.extend_from_slice(&[conn_state, 0]);
+        value.extend_from_slice(&bssid);
+        value.extend_from_slice(&(WCID_OWN as u16).to_le_bytes());
+        value.extend_from_slice(&interval.to_le_bytes());
+        value.extend_from_slice(&[dtim, if network.is_some() { phymode } else { 0 }]);
+        value.extend_from_slice(&(WCID_OWN as u16).to_le_bytes());
+        value.extend_from_slice(&(if network.is_some() { basic_phy as u16 } else { 0 }).to_le_bytes());
+        value.extend_from_slice(&[0, 0]);
+        value
+    }
+
+    /// Linux's `mt76_connac_mcu_uni_add_bss` and `_set_chctx`: the BSS with
+    /// its network (connected or not), its QoS, its channel at 20 MHz.
+    fn add_bss(&mut self, connected: bool) -> Result<(), String> {
+        let Some(network) = self.network.clone() else { return Ok(()) };
+        let mut out = vec![0u8; 4];
+        out.extend(tlv(UNI_BSS_INFO_BASIC, &self.bss_basic(!connected as u8, Some(&network))));
+        out.extend(tlv(UNI_BSS_INFO_QBSS, &[self.qos as u8, 0, 0, 0]));
+        self.uni(UNI_BSS_INFO_UPDATE, &out)?;
+        let channel = wifi::channel_of(network.join.freq).unwrap_or(0);
+        let mut rlm = vec![0u8; 4];
+        let band = if network.ghz2() { 0 } else { 1 };
+        rlm.extend(tlv(UNI_BSS_INFO_RLM, &[channel, channel, 0, 0, self.nss, (1 << self.nss) - 1, 1, 0, 0, band, 0, 0]));
+        self.uni(UNI_BSS_INFO_UPDATE, &rlm)
+    }
+
+    /// `struct sta_req_hdr` and its TLVs.
+    fn sta_rec(&mut self, wcid: u8, muar: u8, tlvs: &[Vec<u8>]) -> Result<(), String> {
+        let mut out = vec![0u8, wcid];
+        out.extend_from_slice(&(tlvs.len() as u16).to_le_bytes());
+        out.extend_from_slice(&[1, muar, 0, 0]);
+        for value in tlvs {
+            out.extend_from_slice(value);
+        }
+        self.uni(UNI_STA_REC_UPDATE, &out)
+    }
+
+    /// A WTBL request in its STA_REC TLV.
+    fn wtbl(wcid: u8, tlvs: &[Vec<u8>]) -> Vec<u8> {
+        let mut value = vec![wcid, WTBL_RESET_AND_SET];
+        value.extend_from_slice(&(tlvs.len() as u16).to_le_bytes());
+        value.extend_from_slice(&[0, 0, 0, 0]);
+        for inner in tlvs {
+            value.extend_from_slice(inner);
+        }
+        tlv(STA_REC_WTBL, &value)
+    }
+
+    /// The WTBL's generic, RX and header translation entries.
+    fn wtbl_common(peer: &Address, muar: u8, qos: bool, aid: u16, rca1: bool) -> Vec<Vec<u8>> {
+        let mut generic = peer.to_vec();
+        generic.extend_from_slice(&[muar, 0, 0, qos as u8, 0, 0]);
+        generic.extend_from_slice(&aid.to_le_bytes());
+        generic.extend_from_slice(&[0, 0]);
+        vec![
+            tlv(WTBL_GENERIC, &generic),
+            tlv(WTBL_RX, &[0, rca1 as u8, 1, 1, 0, 0, 0, 0]),
+            // To the distribution system; frames come in as 802.11.
+            tlv(WTBL_HDR_TRANS, &[1, 0, 1, 0]),
+        ]
+    }
+
+    /// The access point's station record (`mt7921_mcu_sta_update` for the
+    /// station of the AP), enabled in `state` or disabled.
+    fn station_record(&mut self, enable: bool, state: u8) -> Result<(), String> {
+        let Some(network) = self.network.clone() else { return Ok(()) };
+        let rcpi = self.signal.map_or(0, |signal| (2 * signal as i16 + 220).clamp(0, 220) as u8);
+        let mut tlvs = Vec::new();
+        let conn_state = if enable { CONN_STATE_PORT_SECURE } else { CONN_STATE_DISCONNECT };
+        let newly = state != STATE_ASSOC && enable;
+        let mut basic = CONNECTION_INFRA_AP.to_le_bytes().to_vec();
+        basic.extend_from_slice(&[conn_state, self.qos as u8]);
+        basic.extend_from_slice(&self.aid.to_le_bytes());
+        basic.extend_from_slice(&network.join.bssid);
+        basic.extend_from_slice(&(EXTRA_INFO_VER | if newly { EXTRA_INFO_NEW } else { 0 }).to_le_bytes());
+        tlvs.push(tlv(STA_REC_BASIC, &basic));
+        // The AP's HT is known once it accepted the station.
+        let ht = network.ht.filter(|_| state == STATE_ASSOC);
+        if !enable {
+            tlvs.push(Self::wtbl(WCID_AP, &[]));
+            return self.sta_rec(WCID_AP, 0, &tlvs);
+        }
+        if let Some(cap) = ht {
+            // 20 MHz: the AP's 40 MHz abilities do not apply.
+            let info = u16::from_le_bytes([cap[0], cap[1]]) & !(0x0002 | 0x0040);
+            let mut value = info.to_le_bytes().to_vec();
+            value.extend_from_slice(&[0, 0]);
+            tlvs.push(tlv(STA_REC_HT, &value));
+        }
+        let mut phy_type = if network.ghz2() { PHY_TYPE_BIT_HR_DSSS | PHY_TYPE_BIT_ERP } else { PHY_TYPE_BIT_OFDM };
+        let mut ampdu = 0u8;
+        if let Some(cap) = ht {
+            phy_type |= PHY_TYPE_BIT_HT;
+            ampdu = cap[2] & 0x1f;
+        }
+        let mut phy = network.basic.to_le_bytes().to_vec();
+        phy.extend_from_slice(&[phy_type, ampdu, 0, rcpi, 0, 0]);
+        tlvs.push(tlv(STA_REC_PHY, &phy));
+        let legacy = if network.ghz2() { ((network.rates >> 4) & 0xff) << 6 | (network.rates & 0xf) } else { (network.rates & 0xff) << 6 };
+        let mut ra = legacy.to_le_bytes().to_vec();
+        let mut mcs = [0u8; 10];
+        if let Some(cap) = ht {
+            mcs.copy_from_slice(&cap[3..13]);
+            for (stream, byte) in mcs.iter_mut().enumerate().take(4) {
+                if stream >= self.nss as usize {
+                    *byte = 0;
+                }
+            }
+            mcs[4..].fill(0);
+        }
+        ra.extend_from_slice(&mcs);
+        tlvs.push(tlv(STA_REC_RA, &ra));
+        tlvs.push(tlv(STA_REC_STATE, &[0, 0, 0, 0, state, 0, 0, 0]));
+        let mut wtbl = Self::wtbl_common(&network.join.bssid, 0, self.qos, self.aid, true);
+        if let Some(cap) = ht {
+            let ldpc = u16::from_le_bytes([cap[0], cap[1]]) & 0x0001 != 0;
+            wtbl.push(tlv(WTBL_HT, &[1, ldpc as u8, cap[2] & 3, (cap[2] >> 2) & 7, 0, 0, 0, 0]));
+            wtbl.push(tlv(WTBL_SMPS, &[0, 0, 0, 0]));
+        }
+        tlvs.push(Self::wtbl(WCID_AP, &wtbl));
+        self.sta_rec(WCID_AP, 0, &tlvs)
+    }
+
+    /// The interface's own WTBL entry, for group frames of the network
+    /// (`mt7921_mcu_sta_update` without a station).
+    fn own_record(&mut self) -> Result<(), String> {
+        let Some(network) = self.network.clone() else { return Ok(()) };
+        let wtbl = Self::wtbl_common(&network.join.bssid, MUAR_NONE, false, 0, true);
+        self.sta_rec(WCID_OWN, MUAR_NONE, &[Self::wtbl(WCID_OWN, &wtbl)])
+    }
+
+    /// The EDCA parameters of the network's WMM element, or the standard
+    /// ones (`mt7921_mcu_set_tx`).
+    fn set_tx(&mut self, elements: &[u8]) {
+        // mac80211's queues (VO, VI, BE, BK) to the firmware's order.
+        const TO_ACI: [usize; 4] = [1, 0, 2, 3];
+        // (cw_min, cw_max, aifs, txop) per mac80211 queue.
+        let mut params: [(u16, u16, u16, u16); 4] = [(3, 7, 2, 47), (7, 15, 2, 94), (15, 1023, 3, 0), (15, 1023, 7, 0)];
+        let wmm = wifi::Elements(elements).iter().find(|(id, value)| *id == wifi::IE_VENDOR && value.len() >= 24 && value[..4] == wifi::WMM_OUI_TYPE && value[4] == 1);
+        if let Some((_, value)) = wmm {
+            for record in value[8..24].chunks(4) {
+                // The ACI (BE, BK, VI, VO) to mac80211's queue.
+                let queue = [2usize, 3, 1, 0][((record[0] >> 5) & 3) as usize];
+                let (ecw_min, ecw_max) = (record[1] & 0xf, record[1] >> 4);
+                params[queue] = ((1 << ecw_min) - 1, (1 << ecw_max) - 1, (record[0] & 0xf) as u16, u16::from_le_bytes([record[2], record[3]]));
+            }
+        }
+        let mut edca = [[0u8; 10]; 4];
+        for (queue, (cw_min, cw_max, aifs, txop)) in params.iter().enumerate() {
+            let entry = &mut edca[TO_ACI[queue]];
+            entry[0..2].copy_from_slice(&cw_min.to_le_bytes());
+            entry[2..4].copy_from_slice(&cw_max.to_le_bytes());
+            entry[4..6].copy_from_slice(&txop.to_le_bytes());
+            entry[6..8].copy_from_slice(&aifs.to_le_bytes());
+        }
+        let mut out: Vec<u8> = edca.concat();
+        out.extend_from_slice(&[0, self.qos as u8, 0, 0]);
+        let _ = self.chip.mcu(Cmd::Ce(CE_SET_EDCA_PARMS), &out, false);
+    }
+
+    /// The channel for joining (`mt7921_mcu_set_roc`), waited for.
+    fn roc_acquire(&mut self) {
+        let Some(network) = &self.network else { return };
+        let (channel, band) = channel_band(network.join.freq);
+        self.roc_token = self.roc_token.wrapping_add(1);
+        self.roc_granted = false;
+        let mut value = vec![0u8, self.roc_token, channel, 0, band, 0, channel, 0, 0, channel, 0, ROC_REQ_JOIN];
+        value.extend_from_slice(&ROC_MS.to_le_bytes());
+        value.extend_from_slice(&[0xff, 0, 0, 0]);
+        let mut out = vec![0u8; 4];
+        out.extend(tlv(ROC_ACQUIRE, &value));
+        if let Err(error) = self.chip.mcu(Cmd::Uni(UNI_ROC), &out, false) {
+            ostd::warn!("{}: the channel for joining: {}", self.name, error);
+            return;
+        }
+        self.roc_active = true;
+        let deadline = crate::now_ms() + ROC_GRANT_MS;
+        let waiting = crate::WAKER.waiting();
+        while !self.roc_granted && !self.dead && crate::now_ms() < deadline {
+            self.poll();
+            if !self.roc_granted {
+                crate::sleep();
+            }
+        }
+        drop(waiting);
+        if !self.roc_granted {
+            ostd::warn!("{}: the firmware did not grant the channel; joining anyway", self.name);
+        }
+    }
+
+    fn roc_abort(&mut self) {
+        if !self.roc_active {
+            return;
+        }
+        self.roc_active = false;
+        let mut out = vec![0u8; 4];
+        out.extend(tlv(ROC_ABORT, &[0, self.roc_token, 0xff, 0, 0, 0, 0, 0]));
+        let _ = self.chip.mcu(Cmd::Uni(UNI_ROC), &out, false);
+    }
+
+    // ---- The radio's operations. ----
+
+    pub(crate) fn scan(&mut self, request: &ScanRequest) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if self.scanning {
+            return Err(radio::Error::Busy);
+        }
+        self.scan_seq = (self.scan_seq + 1) & 0x7f;
+        let active = !request.ssids.is_empty();
+        let ssids: Vec<&Vec<u8>> = request.ssids.iter().filter(|ssid| !ssid.is_empty()).take(4).collect();
+        let freqs: Vec<u16> = request.freqs.iter().copied().filter(|&freq| wifi::channel_of(freq).is_some() && BandId::of(freq) != BandId::Ghz6).collect();
+        let listed = !freqs.is_empty() && freqs.len() <= 64;
+        let mut out = Vec::with_capacity(1186);
+        let ssid_type = if ssids.is_empty() { 1 << 0 } else { 1 << 2 };
+        out.extend_from_slice(&[self.scan_seq, 0, active as u8, ssid_type, ssids.len() as u8, if active { 2 } else { 0 }, 0x20, 1]);
+        for index in 0..4 {
+            let mut entry = [0u8; 36];
+            if let Some(ssid) = ssids.get(index) {
+                let length = ssid.len().min(32);
+                entry[0..4].copy_from_slice(&(length as u32).to_le_bytes());
+                entry[4..4 + length].copy_from_slice(&ssid[..length]);
+            }
+            out.extend_from_slice(&entry);
+        }
+        // Probe delay, dwell time and time-out: the firmware's own.
+        out.extend_from_slice(&[0; 6]);
+        let (first, rest) = if listed { freqs.split_at(freqs.len().min(32)) } else { (&[][..], &[][..]) };
+        out.extend_from_slice(&[if listed { 4 } else { 0 }, first.len() as u8]);
+        let entry = |freq: Option<&u16>| freq.map_or([0, 0], |&freq| {
+            let (channel, band) = channel_band(freq);
+            [band, channel]
+        });
+        for index in 0..32 {
+            out.extend_from_slice(&entry(first.get(index)));
+        }
+        let elements = &request.elements[..request.elements.len().min(600)];
+        out.extend_from_slice(&(elements.len() as u16).to_le_bytes());
+        let mut ies = [0u8; 600];
+        ies[..elements.len()].copy_from_slice(elements);
+        out.extend_from_slice(&ies);
+        out.extend_from_slice(&[rest.len() as u8, 0, 0, 0]);
+        for index in 0..32 {
+            out.extend_from_slice(&entry(rest.get(index)));
+        }
+        out.extend_from_slice(&[0; 6 * 36]);
+        out.extend_from_slice(&wifi::BROADCAST);
+        out.extend_from_slice(&[0; 6]);
+        out.extend_from_slice(&[0; 63]);
+        out.push(if ssids.is_empty() { 0 } else { 1 });
+        debug_assert_eq!(out.len(), 1186);
+        if let Err(error) = self.chip.mcu(Cmd::Ce(CE_START_HW_SCAN), &out, false) {
+            ostd::warn!("{}: scan: {}", self.name, error);
+            return Err(radio::Error::Failed);
+        }
+        self.scanning = true;
+        self.scan_started = crate::now_ms();
+        Ok(())
+    }
+
+    /// Linux's `mt76_connac_mcu_cancel_hw_scan`: the scan ends now.
+    pub(crate) fn abort_scan(&mut self) {
+        if !self.scanning {
+            return;
+        }
+        self.scanning = false;
+        let _ = self.chip.mcu(Cmd::Ce(CE_CANCEL_HW_SCAN), &[self.scan_seq, 0, 0, 0], false);
+        if let Some(device) = &self.device {
+            device.scan_done(true);
+        }
+    }
+
+    /// Linux's `mt7921_mac_sta_add` and `mgd_prepare_tx`: the access
+    /// point's station, then the channel.
+    pub(crate) fn join(&mut self, join: &Join) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        self.leave();
+        self.network = Some(Network::new(join));
+        self.aid = 0;
+        self.qos = false;
+        if let Err(error) = self.station_record(true, STATE_NONE) {
+            ostd::warn!("{}: joining: {}", self.name, error);
+            self.network = None;
+            return Err(radio::Error::Failed);
+        }
+        self.roc_acquire();
+        Ok(())
+    }
+
+    /// Linux's `mt7921_mac_sta_event` (ASSOC), `bss_info_changed` (ASSOC,
+    /// QOS) and `mgd_complete_tx`.
+    pub(crate) fn associated(&mut self, association: &Association) -> radio::Result<()> {
+        if self.network.is_none() {
+            return Err(radio::Error::Invalid);
+        }
+        self.aid = association.aid & 0x3fff;
+        self.qos = association.qos;
+        let result = self.add_bss(true).and_then(|()| self.station_record(true, STATE_ASSOC)).and_then(|()| self.own_record());
+        if let Err(error) = result {
+            ostd::warn!("{}: association: {}", self.name, error);
+            self.roc_abort();
+            return Err(radio::Error::Failed);
+        }
+        self.set_tx(&association.elements);
+        self.roc_abort();
+        self.associated = true;
+        Ok(())
+    }
+
+    /// Linux's `mt7921_mac_sta_remove`: the station's record disabled, the
+    /// BSS not connected any more.
+    pub(crate) fn leave(&mut self) {
+        if self.network.is_none() {
+            return;
+        }
+        if !self.dead {
+            self.roc_abort();
+            let _ = self.station_record(false, STATE_NONE);
+            let _ = self.add_bss(false);
+        }
+        self.network = None;
+        self.associated = false;
+        self.aid = 0;
+        self.pairwise = None;
+        self.signal = None;
+    }
+
+    /// `mt76_connac_mcu_add_key`: pairwise keys on the AP's entry, group
+    /// keys on the interface's.
+    pub(crate) fn set_key(&mut self, key: &Key, remove: bool) -> radio::Result<()> {
+        let cipher = match key.cipher {
+            radio::CIPHER_CCMP => MCU_CIPHER_AES_CCMP,
+            radio::CIPHER_CCMP_256 => MCU_CIPHER_CCMP_256,
+            radio::CIPHER_GCMP => MCU_CIPHER_GCMP,
+            radio::CIPHER_GCMP_256 => MCU_CIPHER_GCMP_256,
+            _ if remove => MCU_CIPHER_AES_CCMP,
+            _ => return Err(radio::Error::Unsupported),
+        };
+        if key.key.len() > 32 {
+            return Err(radio::Error::Invalid);
+        }
+        let (wcid, muar) = if key.pairwise { (WCID_AP, 0) } else { (WCID_OWN, MUAR_NONE) };
+        // `struct sta_rec_sec`: add (0: set, 1: remove), the count, then
+        // two `sec_key`s; the length says how many count.
+        let mut value = vec![remove as u8, !remove as u8, 0, 0];
+        let mut first = [0u8; SEC_KEY];
+        if !remove {
+            first[0] = cipher;
+            first[1] = SEC_KEY as u8;
+            first[2] = key.index;
+            first[3] = key.key.len() as u8;
+            first[4..4 + key.key.len()].copy_from_slice(&key.key);
+        }
+        value.extend_from_slice(&first);
+        value.extend_from_slice(&[0; SEC_KEY]);
+        let length = if remove { 8 } else { 8 + SEC_KEY } as u16;
+        let mut entry = tlv(STA_REC_KEY_V2, &value);
+        entry[2..4].copy_from_slice(&length.to_le_bytes());
+        if let Err(error) = self.sta_rec(wcid, muar, &[entry]) {
+            ostd::warn!("{}: key: {}", self.name, error);
+            return Err(radio::Error::Failed);
+        }
+        if key.pairwise {
+            self.pairwise = if remove { None } else { Some((key.index, 1)) };
+        }
+        Ok(())
+    }
+
+    // ---- Frames. ----
+
+    fn token(&mut self) -> Option<usize> {
+        let now = crate::now_ms().max(1);
+        for step in 0..TOKENS {
+            let token = (self.next_token + step) % TOKENS;
+            let busy = self.token_busy[token];
+            if busy == 0 || now >= busy + TOKEN_STALE_MS {
+                self.next_token = (token + 1) % TOKENS;
+                self.token_busy[token] = now;
+                return Some(token);
+            }
+        }
+        None
+    }
+
+    /// Sends an 802.11 frame: TXD and TXP on the data ring, the frame in a
+    /// token's buffer (Linux's `mt76_connac2_mac_write_txwi` and
+    /// `mt76_connac_write_hw_txp`). Data frames go without the cipher's
+    /// header (the chip makes it); robust management frames get it here.
+    pub(crate) fn transmit(&mut self, mut frame: Vec<u8>) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if frame.len() < wifi::HEADER {
+            return Err(radio::Error::Invalid);
+        }
+        let data = wifi::is_data(&frame);
+        if frame[1] & wifi::PROTECTED != 0 {
+            match self.pairwise.as_mut() {
+                Some((index, pn)) if !data => {
+                    let value = *pn;
+                    *pn += 1;
+                    let header = [value as u8, (value >> 8) as u8, 0, 0x20 | (*index << 6), (value >> 16) as u8, (value >> 24) as u8, (value >> 32) as u8, (value >> 40) as u8];
+                    drop(frame.splice(wifi::HEADER..wifi::HEADER, header));
+                }
+                Some(_) => {}
+                None => frame[1] &= !wifi::PROTECTED,
+            }
+        }
+        let protected = frame[1] & wifi::PROTECTED != 0;
+        let sequence = self.sequence;
+        self.sequence = (sequence + 1) & 0x0fff;
+        frame[22..24].copy_from_slice(&(sequence << 4).to_le_bytes());
+        let qos_data = data && frame[0] & 0x80 != 0;
+        let header = if qos_data { 26 } else { 24 };
+        let tid = if qos_data { (frame[24] & 7) as u32 } else { 0 };
+        let multicast = frame[4] & 1 != 0;
+        let (kind, subtype) = (((frame[0] >> 2) & 3) as u32, ((frame[0] >> 4) & 0xf) as u32);
+        let wcid = if self.network.is_some() { WCID_AP } else { WCID_OWN } as u32;
+        if frame.len() > BUFFER {
+            return Err(radio::Error::Invalid);
+        }
+        let Some(token) = self.token() else { return Err(radio::Error::Busy) };
+        if self.tokens.write_bytes(token * BUFFER, &frame).is_err() {
+            self.token_busy[token] = 0;
+            return Err(radio::Error::Memory);
+        }
+        // The LMAC queue: the access category of the TID (BK 0, BE 1, VI 2,
+        // VO 3), management on ALTX0.
+        let queue = if data { [1u32, 0, 0, 1, 2, 2, 3, 3][tid as usize] } else { LMAC_ALTX0 };
+        let mut txd = [0u32; 8];
+        txd[0] = ((frame.len() + TXD_SIZE) as u32 & 0xffff) | (queue << 25);
+        txd[1] = (1 << 31) | (wcid & 0x3ff) | (HDR_FORMAT_802_11 << 16) | (((header / 2) as u32) << 11) | (tid << 20);
+        txd[2] = (kind << 4) | subtype | if multicast { TXD2_MULTICAST } else { 0 };
+        txd[3] = (15 << 11) | if protected { TXD3_PROTECT_FRAME } else { 0 };
+        if !data || multicast {
+            // The band's lowest rate: CCK 1 Mbit/s, or OFDM 6 Mbit/s.
+            let ghz2 = self.network.as_ref().is_none_or(Network::ghz2);
+            let rate: u32 = if ghz2 { 0 } else { (1 << 6) | 11 };
+            txd[2] |= TXD2_FIX_RATE | TXD2_HTC_VLD;
+            txd[3] |= TXD3_BA_DISABLE;
+            txd[6] = TXD6_FIXED_BW | (rate << 16);
+        }
+        txd[7] = (kind << 20) | (subtype << 16);
+        let mut txwi = Vec::with_capacity(TXD_SIZE + TXP_SIZE);
+        for word in txd {
+            txwi.extend_from_slice(&word.to_le_bytes());
+        }
+        let mut txp = [0u8; TXP_SIZE];
+        txp[0..2].copy_from_slice(&(token as u16 | MSDU_ID_VALID).to_le_bytes());
+        let address = (self.tokens.daddr() + token * BUFFER) as u32;
+        txp[8..12].copy_from_slice(&address.to_le_bytes());
+        txp[12..14].copy_from_slice(&((frame.len() as u16 & 0x0fff) | TXD_LEN_LAST).to_le_bytes());
+        txwi.extend_from_slice(&txp);
+        self.chip.data_send(&txwi).map_err(|()| {
+            self.token_busy[token] = 0;
+            radio::Error::Busy
+        })
+    }
+
+    pub(crate) fn send(&mut self, ethernet: &[u8], plain: bool) -> radio::Result<()> {
+        let Some(network) = &self.network else { return Err(radio::Error::Down) };
+        let tid = self.qos.then(|| wifi::tid_of(ethernet));
+        let protected = !plain && self.pairwise.is_some();
+        let frame = wifi::data_from_ethernet(ethernet, &network.join.bssid, tid, protected).ok_or(radio::Error::Invalid)?;
+        self.transmit(frame)
+    }
+
+    // ---- What the chip says. ----
+
+    pub(crate) fn poll(&mut self) {
+        if self.dead {
+            return;
+        }
+        let status = self.chip.rr(hw::HOST_INT_STA);
+        if status == u32::MAX {
+            ostd::warn!("{}: the card is gone", self.name);
+            self.died();
+            return;
+        }
+        if status != 0 {
+            self.chip.wr(hw::HOST_INT_STA, status);
+        }
+        if status & hw::INT_MCU_CMD != 0 {
+            let command = self.chip.rr(hw::MCU_CMD);
+            self.chip.wr(hw::MCU_CMD, command);
+            if command & MCU_CMD_STOP_DMA != 0 {
+                ostd::warn!("{}: the firmware stopped ({:#x}); the card stays off until the next boot", self.name, command);
+                self.died();
+                return;
+            }
+        }
+        let mut packets = core::mem::take(&mut self.chip.pending);
+        for which in [hw::RXQ_MCU, hw::RXQ_MCU_WA, hw::RXQ_DATA] {
+            packets.extend(self.chip.ring_receive(which));
+        }
+        for packet in packets {
+            self.handle(&packet);
+        }
+        if self.scanning && crate::now_ms() >= self.scan_started + SCAN_LIMIT_MS {
+            ostd::warn!("{}: the scan did not end; ended here", self.name);
+            self.scanning = false;
+            if let Some(device) = &self.device {
+                device.scan_done(true);
+            }
+        }
+    }
+
+    fn died(&mut self) {
+        self.dead = true;
+        if let Some(device) = &self.device {
+            if self.scanning {
+                device.scan_done(true);
+            }
+            device.connection_lost();
+        }
+        self.scanning = false;
+    }
+
+    fn handle(&mut self, packet: &[u8]) {
+        let rxd0 = le32(packet, 0);
+        let (kind, flag) = (rxd0 >> 27, (rxd0 >> 16) & 0xf);
+        match kind {
+            PKT_TYPE_NORMAL => self.rx_frame(packet),
+            PKT_TYPE_RX_EVENT if flag == 1 => self.rx_frame(packet),
+            PKT_TYPE_TXRX_NOTIFY => self.tx_free(packet),
+            PKT_TYPE_RX_EVENT if packet.len() >= hw::MCU_RXD => self.event(packet),
+            _ => {}
+        }
+    }
+
+    /// `struct mt76_connac_tx_free`, then one word per frame or per
+    /// station ("pair") the frames after it belong to.
+    fn tx_free(&mut self, packet: &[u8]) {
+        let count = (le16(packet, 2) & 0x3ff) as usize;
+        let mut freed = 0;
+        let mut at = 8;
+        while freed < count && at + 4 <= packet.len() {
+            let info = le32(packet, at);
+            at += 4;
+            if info & TX_FREE_PAIR != 0 {
+                continue;
+            }
+            freed += 1;
+            let token = ((info >> 16) & 0x7fff) as usize;
+            if let Some(busy) = self.token_busy.get_mut(token) {
+                *busy = 0;
+            }
+        }
+        if let Some(device) = &self.device {
+            device.ready_to_send();
+        }
+    }
+
+    fn event(&mut self, packet: &[u8]) {
+        let (eid, option) = (packet[28], packet[30]);
+        if option & UNI_UNSOLICITED != 0 {
+            if eid == UNI_EVENT_ROC && le16(packet, hw::MCU_RXD + 4) == 0 {
+                self.roc_granted = true;
+            }
+            return;
+        }
+        match eid {
+            EVENT_SCAN_DONE | EVENT_SCHED_SCAN_DONE => {
+                if self.scanning {
+                    self.scanning = false;
+                    if let Some(device) = &self.device {
+                        device.scan_done(false);
+                    }
+                }
+            }
+            EVENT_BSS_BEACON_LOSS => {
+                if self.associated
+                    && let Some(device) = &self.device
+                {
+                    ostd::info!("{}: the firmware lost the access point's beacons", self.name);
+                    device.connection_lost();
+                }
+            }
+            _ => {}
+        }
+    }
+
+    /// A frame after its RXD (Linux's `mt7921_mac_fill_rx`): six words,
+    /// the groups the RXD says are there, the padding; A-MSDU subframes
+    /// (the chip splits them) carry two bytes more after the header.
+    fn rx_frame(&mut self, packet: &[u8]) {
+        let (rxd0, rxd1, rxd2, rxd3, rxd4) = (le32(packet, 0), le32(packet, 4), le32(packet, 8), le32(packet, 12), le32(packet, 16));
+        let length = (rxd0 & 0xffff) as usize;
+        // Band 1, ICV and MIC errors, a bad FCS, a broken A-MSDU, too long.
+        if rxd1 & ((1 << 28) | (1 << 27) | (1 << 26) | (1 << 25)) != 0 || rxd2 & ((1 << 23) | (1 << 24)) != 0 {
+            return;
+        }
+        // Header translation is off in every WTBL entry: 802.11 only.
+        if rxd2 & (1 << 13) != 0 {
+            return;
+        }
+        let mut at = 24;
+        let mut signal: Option<i16> = None;
+        if rxd1 & (1 << 14) != 0 {
+            at += 16;
+        }
+        if rxd1 & (1 << 11) != 0 {
+            at += 16;
+        }
+        if rxd1 & (1 << 12) != 0 {
+            at += 8;
+        }
+        if rxd1 & (1 << 13) != 0 {
+            let mut v1 = le32(packet, at + 4);
+            at += 8;
+            if rxd1 & (1 << 15) != 0 {
+                v1 = le32(packet, at + 24);
+                at += 72;
+            }
+            for chain in 0..self.nss as u32 {
+                let rssi = (((v1 >> (8 * chain)) & 0xff) as i16 - 220) / 2;
+                if rssi < 0 {
+                    signal = Some(signal.map_or(rssi, |best| best.max(rssi)));
+                }
+            }
+        }
+        at += 2 * ((rxd2 >> 14) & 3) as usize;
+        let Some(frame) = packet.get(at..length.min(packet.len())) else { return };
+        if frame.len() < wifi::HEADER {
+            return;
+        }
+        let mut frame = frame.to_vec();
+        if rxd4 & 3 != 0 {
+            let header = if wifi::is_data(&frame) && frame[0] & 0x80 != 0 { 26 } else { 24 };
+            if frame.len() < header + 2 {
+                return;
+            }
+            drop(frame.drain(header..header + 2));
+        }
+        let channel = ((rxd3 >> 8) & 0xff) as u16;
+        let freq = match channel {
+            1..=13 => 2407 + 5 * channel,
+            14 => 2484,
+            15..=180 => 5000 + 5 * channel,
+            _ => return,
+        };
+        let decrypted = (rxd1 >> 16) & 0x1f != 0 && rxd1 & ((1 << 23) | (1 << 24)) == 0;
+        let signal = signal.unwrap_or(-100).clamp(-127, -1) as i8;
+        if let Some(network) = &self.network
+            && wifi::addresses(&frame).is_some_and(|(_, transmitter, _)| transmitter == network.join.bssid)
+        {
+            self.signal = Some(signal);
+        }
+        if let Some(device) = &self.device {
+            device.received(&frame, RxInfo { freq, signal, decrypted, security_header: 0 });
+        }
+    }
+
+    pub(crate) fn info(&self) -> Info {
+        let mut mcs = [0u8; 16];
+        for stream in 0..self.nss as usize {
+            mcs[stream] = 0xff;
+        }
+        mcs[12] = 1;
+        let ht = HtCap { info: HT_INFO, ampdu_factor: 3, ampdu_density: 5, mcs };
+        let band = |id: BandId| {
+            let channels: Vec<Channel> = match id {
+                BandId::Ghz2 => (1..=13u16).map(|channel| Channel::new(2407 + 5 * channel)).collect(),
+                _ => CHANNELS_5GHZ
+                    .iter()
+                    .map(|&channel| {
+                        let mut entry = Channel::new(5000 + 5 * channel);
+                        entry.radar = (52..=144).contains(&channel);
+                        entry.passive = entry.radar;
+                        entry
+                    })
+                    .collect(),
+            };
+            Band { id, channels, ht: Some(ht.clone()), vht: None, he: None }
+        };
+        Info {
+            driver: String::from("mt7921"),
+            address: self.address,
+            bands: vec![band(BandId::Ghz2), band(BandId::Ghz5)],
+            ciphers: vec![radio::CIPHER_CCMP, radio::CIPHER_GCMP, radio::CIPHER_GCMP_256, radio::CIPHER_CCMP_256],
+            max_scan_ssids: 4,
+            max_scan_ie_len: 600,
+        }
+    }
+}
