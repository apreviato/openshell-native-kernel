+// SPDX-License-Identifier: MPL-2.0
+
+//! The MT7925 (Wi-Fi 7, "connac3") as a station or an access point, as
+//! Linux's mt7925 drives it: every command is a unified one with TLVs.
+//! The interface (`DEV_INFO_UPDATE`, `BSS_INFO_UPDATE` with its basic,
+//! security, rate, QoS, MLD, slot time, HE and channel parts, and as an
+//! access point its beacon timing and content), scans (`SCAN_REQ`), the
+//! channel held for joining (`ROC`), the peers' station records
+//! (`STA_REC_UPDATE`: basic, PHY, HT, VHT, HE, rates, state, header
+//! translation off), keys (`STA_REC_KEY_V3`), EDCA (`EDCA_UPDATE`); frames
+//! out with the connac3 TXD and the same TXP as the MT7921's, frames in
+//! after the connac3 RXD. The chip's rings and firmware are [`hw`]'s.
+
+use alloc::{collections::BTreeMap, format, string::String, sync::Arc, vec, vec::Vec};
+
+use aster_wlan::{
+    Device, chan,
+    ieee80211::{self as wifi, Address},
+    radio::{self, ApConfig, Association, Band, BandId, BeaconTemplate, Chandef, HeCap, HtCap, Info, Join, Key, RxInfo, ScanRequest, StationEntry, VhtCap, Width},
+};
+use ostd::mm::{HasDaddr, VmIo, dma::DmaCoherent};
+
+use crate::{
+    hw::{self, BUFFER, Chip, Cmd},
+    mac::{AP_STATIONS, element_rates, rate_bitmaps},
+};
+
+// Unified commands (`mt76_connac_mcu.h`).
+const UNI_DEV_INFO_UPDATE: u16 = 0x01;
+const UNI_BSS_INFO_UPDATE: u16 = 0x02;
+const UNI_STA_REC_UPDATE: u16 = 0x03;
+const UNI_EDCA_UPDATE: u16 = 0x04;
+const UNI_BAND_CONFIG: u16 = 0x08;
+const UNI_CHIP_CONFIG: u16 = 0x0e;
+const UNI_SET_DOMAIN_INFO: u16 = 0x15;
+const UNI_SCAN_REQ: u16 = 0x16;
+const UNI_ROC: u16 = 0x27;
+const UNI_EFUSE_CTRL: u16 = 0x2d;
+// Their TLVs.
+const DEV_INFO_ACTIVE: u16 = 0;
+const UNI_BSS_INFO_BASIC: u16 = 0;
+const UNI_BSS_INFO_RLM: u16 = 2;
+const UNI_BSS_INFO_BSS_COLOR: u16 = 4;
+const UNI_BSS_INFO_HE_BASIC: u16 = 5;
+const UNI_BSS_INFO_BCN_CONTENT: u16 = 7;
+const UNI_BSS_INFO_RATE: u16 = 11;
+const UNI_BSS_INFO_QBSS: u16 = 15;
+const UNI_BSS_INFO_SEC: u16 = 16;
+const UNI_BSS_INFO_BCNFT: u16 = 22;
+const UNI_BSS_INFO_IFS_TIME: u16 = 23;
+const UNI_BSS_INFO_MLD: u16 = 26;
+const UNI_BSS_INFO_PM_DISABLE: u16 = 27;
+/// The beacon's room in `struct bcn_content_tlv`, from its capabilities
+/// on (the firmware's "only cap field IE" format).
+const BEACON_ROOM: usize = 512;
+const UNI_CHIP_CONFIG_NIC_CAPA: u16 = 3;
+const UNI_BAND_CONFIG_RADIO_ENABLE: u16 = 0;
+const UNI_BAND_CONFIG_RTS_THRESHOLD: u16 = 8;
+const UNI_EFUSE_BUFFER_MODE: u16 = 2;
+const UNI_SCAN_REQ_TLV: u16 = 1;
+const UNI_SCAN_CANCEL: u16 = 2;
+const UNI_SCAN_SSID: u16 = 10;
+const UNI_SCAN_BSSID: u16 = 11;
+const UNI_SCAN_CHANNEL: u16 = 12;
+const UNI_SCAN_IE: u16 = 13;
+const UNI_SCAN_MISC: u16 = 14;
+const UNI_ROC_ACQUIRE: u16 = 0;
+const UNI_ROC_ABORT: u16 = 1;
+const STA_REC_BASIC: u16 = 0x00;
+const STA_REC_RA: u16 = 0x01;
+const STA_REC_STATE: u16 = 0x07;
+const STA_REC_HT: u16 = 0x09;
+const STA_REC_VHT: u16 = 0x0a;
+const STA_REC_PHY: u16 = 0x15;
+const STA_REC_HE_V2: u16 = 0x19;
+const STA_REC_MLD_OFF: u16 = 0x23;
+const STA_REC_REMOVE: u16 = 0x25;
+const STA_REC_KEY_V3: u16 = 0x27;
+const STA_REC_HDR_TRANS: u16 = 0x2b;
+const EDCA_AC_PARAM: u16 = 0;
+// Events (`MCU_UNI_EVENT_*`) and their TLVs.
+const UNI_EVENT_BSS_BEACON_LOSS: u8 = 0x0c;
+const UNI_EVENT_SCAN_DONE: u8 = 0x0e;
+const UNI_EVENT_ROC: u8 = 0x27;
+const UNI_EVENT_SCAN_DONE_BASIC: u16 = 0;
+const UNI_EVENT_ROC_GRANT: u16 = 0;
+const UNSOLICITED: u8 = 1 << 2;
+const NIC_CAP_MAC_ADDR: u16 = 7;
+const NIC_CAP_PHY: u16 = 8;
+// RXD packet types and the frames that came through the MCU.
+const PKT_TYPE_NORMAL: u32 = 2;
+const PKT_TYPE_TXRX_NOTIFY: u32 = 6;
+const PKT_TYPE_RX_EVENT: u32 = 7;
+const CONNECTION_INFRA_STA: u32 = 0x0001_0001;
+const CONNECTION_INFRA_AP: u32 = 0x0001_0002;
+const CONNECTION_INFRA_BC: u32 = 0x0001_0020;
+const CONN_STATE_PORT_SECURE: u8 = 2;
+const STATE_NONE: u8 = 0;
+const STATE_ASSOC: u8 = 2;
+const EXTRA_INFO_VER: u16 = 1 << 0;
+const EXTRA_INFO_NEW: u16 = 1 << 1;
+const ROC_REQ_JOIN: u8 = 0;
+/// PHY modes of the BSS (`PHY_MODE_*`) and types of the station
+/// (`PHY_TYPE_BIT_*`).
+const PHY_MODE_A: u8 = 1 << 0;
+const PHY_MODE_B: u8 = 1 << 1;
+const PHY_MODE_G: u8 = 1 << 2;
+const PHY_MODE_GN: u8 = 1 << 3;
+const PHY_MODE_AN: u8 = 1 << 4;
+const PHY_MODE_AC: u8 = 1 << 5;
+const PHY_MODE_AX_24G: u8 = 1 << 6;
+const PHY_MODE_AX_5G: u8 = 1 << 7;
+const PHY_TYPE_BIT_HR_DSSS: u8 = 1 << 0;
+const PHY_TYPE_BIT_ERP: u8 = 1 << 1;
+const PHY_TYPE_BIT_OFDM: u8 = 1 << 3;
+const PHY_TYPE_BIT_HT: u8 = 1 << 4;
+const PHY_TYPE_BIT_VHT: u8 = 1 << 5;
+const PHY_TYPE_BIT_HE: u8 = 1 << 6;
+const PHY_TYPE_ERP_INDEX: u16 = 1;
+const PHY_TYPE_OFDM_INDEX: u16 = 3;
+/// Channel widths of the firmware (`CMD_CBW_*`).
+const CMD_CBW_20MHZ: u8 = 0;
+const CMD_CBW_40MHZ: u8 = 1;
+const CMD_CBW_80MHZ: u8 = 2;
+const CMD_CBW_160MHZ: u8 = 3;
+/// Ciphers (`enum connac3_mcu_cipher_type`).
+const CIPHER_AES_CCMP: u8 = 4;
+const CIPHER_CCMP_256: u8 = 10;
+const CIPHER_GCMP: u8 = 11;
+const CIPHER_GCMP_256: u8 = 12;
+/// BSS security modes (`MODE_*` in mt7925's security TLV).
+const MODE_OPEN: u8 = 0;
+const MODE_WPA2_PSK: u8 = 8;
+const MODE_WPA3_SAE: u8 = 11;
+/// The MCU's "the firmware asked the DMA to stop".
+const MCU_CMD_STOP_DMA: u32 = 1 << 2;
+/// WTBL entries: the access point's station, and the interface's own
+/// (`MT792x_WTBL_RESERVED` less its index).
+const WCID_AP: u16 = 1;
+const WCID_OWN: u16 = 19;
+const MUAR_NONE: u8 = 0x0e;
+// The connac3 TXD and the TXP.
+const TXD_SIZE: usize = 32;
+const TXP_SIZE: usize = 32;
+const LMAC_ALTX0: u32 = 0x10;
+const HDR_FORMAT_802_11: u32 = 2;
+const TXD1_FIXED_RATE: u32 = 1 << 31;
+const TXD3_PROTECT_FRAME: u32 = 1 << 1;
+const TXD3_BCM: u32 = 1 << 4;
+const TXD3_BA_DISABLE: u32 = 1 << 28;
+const TXD6_DAS: u32 = 1 << 2;
+const TXD6_DIS_MAT: u32 = 1 << 3;
+const MSDU_ID_VALID: u16 = 1 << 15;
+const TXD_LEN_LAST: u16 = 1 << 15;
+const TXFREE_INFO_PAIR: u32 = 1 << 31;
+const TXFREE_INFO_HEADER: u32 = 1 << 30;
+const TXFREE_MSDU_NONE: u32 = 0x7fff;
+pub(crate) const TOKENS: usize = 128;
+const TOKEN_STALE_MS: u64 = 2_000;
+const ROC_MS: u32 = 3_000;
+const ROC_GRANT_MS: u64 = 1_000;
+const SCAN_LIMIT_MS: u64 = 30_000;
+const IEEE80211_CHAN_NO_IR: u32 = 1 << 1;
+const IEEE80211_CHAN_RADAR: u32 = 1 << 3;
+/// HE capabilities offered as a station: HTC, OM control, A-MSDU in
+/// A-MPDU; LDPC, NDP and STBC below 80 MHz, SU beamformee; 16 µs of
+/// nominal packet padding (there are no PPE thresholds).
+const HE_MAC: [u8; 6] = [0x01, 0x00, 0x00, 0x02, 0x40, 0x00];
+const HE_PHY: [u8; 11] = [0x00, 0x20, 0x0a, 0x00, 0x0d, 0x00, 0x00, 0x00, 0x00, 0x80, 0x00];
+
+fn tlv(tag: u16, value: &[u8]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(4 + value.len());
+    out.extend_from_slice(&tag.to_le_bytes());
+    out.extend_from_slice(&((4 + value.len()) as u16).to_le_bytes());
+    out.extend_from_slice(value);
+    out
+}
+
+fn le32(data: &[u8], at: usize) -> u32 {
+    data.get(at..at + 4).map_or(0, |b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+}
+
+fn le16(data: &[u8], at: usize) -> u16 {
+    data.get(at..at + 2).map_or(0, |b| u16::from_le_bytes([b[0], b[1]]))
+}
+
+fn is_2ghz(freq: u16) -> bool {
+    BandId::of(freq) == BandId::Ghz2
+}
+
+/// The firmware's band number (1: 2.4 GHz, 2: 5 GHz, 3: 6 GHz).
+fn band_number(freq: u16) -> u8 {
+    match BandId::of(freq) {
+        BandId::Ghz2 => 1,
+        BandId::Ghz5 => 2,
+        BandId::Ghz6 => 3,
+    }
+}
+
+fn cbw(width: Width) -> u8 {
+    match width {
+        Width::NoHt20 | Width::W20 => CMD_CBW_20MHZ,
+        Width::W40 => CMD_CBW_40MHZ,
+        Width::W80 => CMD_CBW_80MHZ,
+        Width::W160 => CMD_CBW_160MHZ,
+    }
+}
+
+/// The secondary channel's side: above (1, "SCA"), below (3, "SCB"), none.
+fn sco(chandef: &Chandef) -> u8 {
+    match chandef.control.cmp(&chandef.center) {
+        core::cmp::Ordering::Less => 1,
+        core::cmp::Ordering::Greater => 3,
+        core::cmp::Ordering::Equal => 0,
+    }
+}
+
+#[derive(Clone)]
+struct Network {
+    join: Join,
+    peer: radio::Peer,
+    /// The access point's rates as the band's bitmap, and its basic ones.
+    rates: u16,
+    basic: u16,
+    dtim: u8,
+    /// The cipher of the pairwise key, for the BSS's security part.
+    cipher: u8,
+}
+
+impl Network {
+    fn new(join: &Join) -> Self {
+        let elements = wifi::Elements(&join.elements);
+        let (rates, basic) = rate_bitmaps(is_2ghz(join.freq), element_rates(&join.elements).into_iter());
+        let dtim = elements.get(wifi::IE_TIM).and_then(|value| value.get(1).copied()).filter(|&period| period > 0).unwrap_or(1);
+        Self { join: join.clone(), peer: radio::Peer::default(), rates, basic, dtim, cipher: 0 }
+    }
+}
+
+/// The network this radio runs as an access point.
+struct Ap {
+    config: ApConfig,
+    /// Its beacon's: WMM, HE, the HE operation, the basic rates.
+    qos: bool,
+    he: bool,
+    he_operation: Option<Vec<u8>>,
+    basic: u16,
+    /// The cipher of its keys, for the BSS's security part.
+    cipher: u8,
+    stations: BTreeMap<Address, ApStation>,
+}
+
+impl Ap {
+    fn new(config: &ApConfig) -> Self {
+        let mut ap = Self { config: config.clone(), qos: false, he: false, he_operation: None, basic: 0, cipher: 0, stations: BTreeMap::new() };
+        ap.read_beacon(&config.beacon);
+        ap
+    }
+
+    fn read_beacon(&mut self, beacon: &BeaconTemplate) {
+        let elements = beacon.elements();
+        let list = wifi::Elements(&elements);
+        self.qos = list.vendor(wifi::WMM_OUI_TYPE).is_some();
+        self.he = list.extension(wifi::EXT_HE_CAP).is_some();
+        self.he_operation = list.extension(wifi::EXT_HE_OPERATION).map(<[u8]>::to_vec);
+        self.basic = rate_bitmaps(is_2ghz(self.config.chandef.control), element_rates(&elements).into_iter()).1;
+        self.config.beacon = beacon.clone();
+    }
+}
+
+struct ApStation {
+    wcid: u16,
+    qos: bool,
+    key: bool,
+}
+
+/// A peer's station record: the access point's, or a station's of this
+/// radio's network.
+struct PeerRecord<'a> {
+    wcid: u16,
+    address: Address,
+    aid: u16,
+    qos: bool,
+    peer: &'a radio::Peer,
+    freq: u16,
+    rates: u16,
+    basic: u16,
+    ap: bool,
+}
+
+/// What the BSS's basic TLV says (`struct mt76_connac_bss_basic_tlv`).
+struct BssBasic {
+    active: bool,
+    conn_type: u32,
+    conn_state: u8,
+    bssid: Address,
+    freq: u16,
+    interval: u16,
+    dtim: u8,
+    phymode: u8,
+    /// The station its frames go through.
+    sta: u16,
+}
+
+pub(crate) struct Mt7925 {
+    pub(crate) chip: Chip,
+    pub(crate) name: String,
+    pub(crate) address: Address,
+    nss: u8,
+    pub(crate) device: Option<Arc<Device>>,
+    tokens: DmaCoherent,
+    token_busy: Vec<u64>,
+    next_token: usize,
+    network: Option<Network>,
+    ap: Option<Ap>,
+    associated: bool,
+    aid: u16,
+    qos: bool,
+    pairwise: Option<(u8, u64)>,
+    scanning: bool,
+    scan_started: u64,
+    scan_seq: u8,
+    roc_token: u8,
+    roc_active: bool,
+    roc_granted: bool,
+    /// The DBDC band the firmware put the interface on.
+    band_idx: u8,
+    sequence: u16,
+    pub(crate) signal: Option<i8>,
+    pub(crate) dead: bool,
+}
+
+impl Mt7925 {
+    pub(crate) fn new(chip: Chip, name: String, tokens: DmaCoherent) -> Self {
+        Self {
+            chip,
+            name,
+            address: [0; 6],
+            nss: 2,
+            device: None,
+            tokens,
+            token_busy: vec![0; TOKENS],
+            next_token: 0,
+            network: None,
+            ap: None,
+            associated: false,
+            aid: 0,
+            qos: false,
+            pairwise: None,
+            scanning: false,
+            scan_started: 0,
+            scan_seq: 0,
+            roc_token: 0,
+            roc_active: false,
+            roc_granted: false,
+            band_idx: 0,
+            sequence: 0,
+            signal: None,
+            dead: false,
+        }
+    }
+
+    fn uni(&mut self, id: u16, payload: &[u8]) -> Result<Vec<u8>, String> {
+        self.chip.mcu(Cmd::Uni(id), payload, true)
+    }
+
+    /// Linux's `mt7925_init_hardware`, `__mt7925_start` and the interface's
+    /// `mt76_connac_mcu_uni_add_dev`.
+    pub(crate) fn bring_up(&mut self, patch: &str, ram: &str) -> Result<(), String> {
+        let (_, patch_file) = aster_firmware::load_first([patch]).ok_or_else(|| format!("{patch} is not in /lib/firmware"))?;
+        let (_, ram_file) = aster_firmware::load_first([ram]).ok_or_else(|| format!("{ram} is not in /lib/firmware"))?;
+        self.chip.before_firmware();
+        self.chip.load_patch(&patch_file).map_err(|error| format!("ROM patch: {error}"))?;
+        ostd::info!("{}: ROM patch loaded", self.name);
+        self.chip.load_ram(&ram_file).map_err(|error| format!("RAM code: {error}"))?;
+        ostd::notice!("{}: the firmware runs", self.name);
+        self.capabilities()?;
+        // The calibration from the chip's eFuse, whole.
+        let mut efuse = vec![0u8; 4];
+        efuse.extend_from_slice(&tlv(UNI_EFUSE_BUFFER_MODE, &[0, 1, 0, 0]));
+        self.uni(UNI_EFUSE_CTRL, &efuse)?;
+        self.chip.mac_init_7925();
+        self.channel_domain()?;
+        // The RTS threshold and the radio on.
+        let mut rts = vec![0u8; 4];
+        let mut value = Vec::with_capacity(8);
+        value.extend_from_slice(&0x92bu32.to_le_bytes());
+        value.extend_from_slice(&2u32.to_le_bytes());
+        rts.extend_from_slice(&tlv(UNI_BAND_CONFIG_RTS_THRESHOLD, &value));
+        self.uni(UNI_BAND_CONFIG, &rts)?;
+        let mut radio_on = vec![0u8; 4];
+        radio_on.extend_from_slice(&tlv(UNI_BAND_CONFIG_RADIO_ENABLE, &[1, 0, 0, 0]));
+        if let Err(error) = self.uni(UNI_BAND_CONFIG, &radio_on) {
+            ostd::info!("{}: radio on: {}", self.name, error);
+        }
+        self.add_interface()
+    }
+
+    /// The chip's facts (`mt7925_mcu_get_nic_capability`): its MAC address
+    /// and spatial streams.
+    fn capabilities(&mut self) -> Result<(), String> {
+        let mut request = vec![0u8; 4];
+        request.extend_from_slice(&tlv(UNI_CHIP_CONFIG_NIC_CAPA, &[]));
+        let answer = self.chip.mcu(Cmd::Uni(UNI_CHIP_CONFIG), &request, true)?;
+        let count = le16(&answer, 0) as usize;
+        let mut at = 4;
+        for _ in 0..count {
+            let (tag, length) = (le16(&answer, at), le16(&answer, at + 2) as usize);
+            if length < 4 || at + length > answer.len() {
+                break;
+            }
+            let value = &answer[at + 4..at + length];
+            match tag {
+                NIC_CAP_MAC_ADDR if value.len() >= 6 => self.address.copy_from_slice(&value[..6]),
+                // `struct mt76_connac_phy_cap`: the streams are its fifth byte.
+                NIC_CAP_PHY if value.len() >= 5 => self.nss = value[4].clamp(1, 2),
+                _ => {}
+            }
+            at += length;
+        }
+        if self.address == [0; 6] || self.address[0] & 1 != 0 {
+            return Err(String::from("the firmware gave no MAC address"));
+        }
+        Ok(())
+    }
+
+    /// `mt7925_mcu_set_channel_domain`: the channels the station may use,
+    /// as the world allows them until a network says where it is.
+    fn channel_domain(&mut self) -> Result<(), String> {
+        let mut channels = Vec::new();
+        let (mut n2, mut n5) = (0u8, 0u8);
+        for number in 1..=13u16 {
+            channels.extend_from_slice(&number.to_le_bytes());
+            channels.extend_from_slice(&[0, 0]);
+            channels.extend_from_slice(&0u32.to_le_bytes());
+            n2 += 1;
+        }
+        for number in chan::CHANNELS_5GHZ {
+            let flags = if chan::radar_channel(number) { IEEE80211_CHAN_RADAR | IEEE80211_CHAN_NO_IR } else { 0 };
+            channels.extend_from_slice(&(number as u16).to_le_bytes());
+            channels.extend_from_slice(&[0, 0]);
+            channels.extend_from_slice(&flags.to_le_bytes());
+            n5 += 1;
+        }
+        // The world's code, 2.4 GHz up to 40 MHz, 5 and 6 GHz up to 160.
+        let mut out = vec![0u8, 0, 0, 0, 0, 3, 3, 0];
+        out.extend_from_slice(&2u16.to_le_bytes());
+        out.extend_from_slice(&((8 + channels.len()) as u16).to_le_bytes());
+        out.extend_from_slice(&[n2, n5, 0, 0]);
+        out.extend_from_slice(&channels);
+        self.uni(UNI_SET_DOMAIN_INFO, &out).map(|_| ())
+    }
+
+    /// The interface: its device entry, then its BSS (not connected).
+    fn add_interface(&mut self) -> Result<(), String> {
+        let mut device = vec![0u8, 0, 0, 0];
+        let mut value = vec![1u8, 0];
+        value.extend_from_slice(&self.address);
+        device.extend_from_slice(&tlv(DEV_INFO_ACTIVE, &value));
+        self.uni(UNI_DEV_INFO_UPDATE, &device)?;
+        let mut bss = vec![0u8; 4];
+        bss.extend_from_slice(&self.bss_basic(true, 1, WCID_OWN));
+        self.uni(UNI_BSS_INFO_UPDATE, &bss).map(|_| ())
+    }
+
+    /// `struct mt76_connac_bss_basic_tlv` (32 bytes) of the station's BSS:
+    /// the network's when there is one, its PHY modes as the access point
+    /// runs them.
+    fn bss_basic(&self, active: bool, conn_state: u8, sta: u16) -> Vec<u8> {
+        let network = self.network.as_ref();
+        let freq = network.map_or(2412, |network| network.join.freq);
+        let peer = network.map(|network| &network.peer);
+        let mut phymode = if is_2ghz(freq) { PHY_MODE_B | PHY_MODE_G } else { PHY_MODE_A };
+        if let Some(peer) = peer {
+            if peer.ht.is_some() {
+                phymode |= if is_2ghz(freq) { PHY_MODE_GN } else { PHY_MODE_AN };
+            }
+            if peer.vht.is_some() && !is_2ghz(freq) {
+                phymode |= PHY_MODE_AC;
+            }
+            if peer.he.is_some() {
+                phymode |= if is_2ghz(freq) { PHY_MODE_AX_24G } else { PHY_MODE_AX_5G };
+            }
+        }
+        self.basic_tlv(&BssBasic {
+            active,
+            conn_type: CONNECTION_INFRA_STA,
+            conn_state,
+            bssid: network.map_or([0; 6], |network| network.join.bssid),
+            freq,
+            interval: network.map_or(0, |network| network.join.beacon_interval),
+            dtim: network.map_or(0, |network| network.dtim),
+            phymode,
+            sta,
+        })
+    }
+
+    fn basic_tlv(&self, basic: &BssBasic) -> Vec<u8> {
+        let mut value = Vec::with_capacity(28);
+        value.extend_from_slice(&[basic.active as u8, 0, 0, self.band_idx]);
+        value.extend_from_slice(&basic.conn_type.to_le_bytes());
+        value.extend_from_slice(&[basic.conn_state, 0]);
+        value.extend_from_slice(&basic.bssid);
+        value.extend_from_slice(&basic.sta.to_le_bytes());
+        value.extend_from_slice(&basic.interval.to_le_bytes());
+        value.push(basic.dtim);
+        value.push(basic.phymode);
+        value.extend_from_slice(&basic.sta.to_le_bytes());
+        value.extend_from_slice(&(if is_2ghz(basic.freq) { PHY_TYPE_ERP_INDEX } else { PHY_TYPE_OFDM_INDEX }).to_le_bytes());
+        value.extend_from_slice(&[0, 0]);
+        tlv(UNI_BSS_INFO_BASIC, &value)
+    }
+
+    /// The BSS's parts after its basics (`mt7925_mcu_add_bss_info`):
+    /// security, broadcast rates, QoS, MLD, slot time, HE with the colour,
+    /// and with `enable` the channel.
+    #[allow(clippy::too_many_arguments)]
+    fn bss_parts(&self, out: &mut Vec<u8>, cipher: u8, qos: bool, short_slot: bool, he_operation: Option<&[u8]>, chandef: Option<Chandef>, freq: u16, enable: bool) {
+        let mode = match cipher {
+            CIPHER_GCMP | CIPHER_GCMP_256 => (MODE_WPA3_SAE, 8),
+            CIPHER_AES_CCMP | CIPHER_CCMP_256 => (MODE_WPA2_PSK, 6),
+            _ => (MODE_OPEN, 1),
+        };
+        out.extend_from_slice(&tlv(UNI_BSS_INFO_SEC, &[mode.0, mode.1, cipher, 0]));
+        // Broadcast and multicast rates: the band's basic ones, the fixed
+        // table's entry for them.
+        let basic_rate: u16 = if is_2ghz(freq) { 0x000f } else { 0x0150 };
+        let rate_index = hw::BASIC_RATES_TBL + if is_2ghz(freq) { 0 } else { 4 };
+        let mut rate = vec![0u8, 0];
+        rate.extend_from_slice(&basic_rate.to_le_bytes());
+        rate.extend_from_slice(&[0, 0, 0, 0, is_2ghz(freq) as u8, rate_index, rate_index, 0]);
+        out.extend_from_slice(&tlv(UNI_BSS_INFO_RATE, &rate));
+        out.extend_from_slice(&tlv(UNI_BSS_INFO_QBSS, &[qos as u8, 0, 0, 0]));
+        // Not a multi-link device: link 0xff, its own index 32.
+        let mut mld = vec![0xffu8, 32];
+        mld.extend_from_slice(&self.address);
+        mld.extend_from_slice(&[0xff, 0xff, 0, 0, 0, 0, 0, 0]);
+        out.extend_from_slice(&tlv(UNI_BSS_INFO_MLD, &mld));
+        let mut ifs = vec![1u8, 0, 0, 0];
+        ifs.extend_from_slice(&(if short_slot { 9u16 } else { 20 }).to_le_bytes());
+        ifs.extend_from_slice(&[0; 10]);
+        out.extend_from_slice(&tlv(UNI_BSS_INFO_IFS_TIME, &ifs));
+        if let Some(operation) = he_operation {
+            let rts = Some(operation).filter(|value| value.len() >= 3).map_or(0, |value| (u16::from_le_bytes([value[0], value[1]]) >> 4) & 0x3ff);
+            let mut value = Vec::with_capacity(12);
+            value.extend_from_slice(&(if rts == 0 { 1023 } else { rts }).to_le_bytes());
+            value.extend_from_slice(&[4, 0]);
+            // The highest MCS each width takes: this radio's own, at 80
+            // and 160 MHz (not 80+80).
+            let own = self.mcs_map();
+            value.extend_from_slice(&own.to_le_bytes());
+            value.extend_from_slice(&(if is_2ghz(freq) { 0xffff } else { own }).to_le_bytes());
+            value.extend_from_slice(&0xffffu16.to_le_bytes());
+            value.extend_from_slice(&[0, 0]);
+            out.extend_from_slice(&tlv(UNI_BSS_INFO_HE_BASIC, &value));
+            let color = operation.get(3).copied().unwrap_or(0);
+            let enabled = enable && color & 0x80 == 0 && color & 0x3f != 0;
+            out.extend_from_slice(&tlv(UNI_BSS_INFO_BSS_COLOR, &[enabled as u8, if enable { color & 0x3f } else { 0 }, 0, 0]));
+        }
+        if let Some(chandef) = chandef.filter(|_| enable) {
+            let center = wifi::channel_of(chandef.center).unwrap_or(0);
+            let streams = self.nss;
+            let ht_op = if chandef.width >= Width::W40 { 4 } else { 0 };
+            out.extend_from_slice(&tlv(
+                UNI_BSS_INFO_RLM,
+                &[wifi::channel_of(chandef.control).unwrap_or(0), center, 0, cbw(chandef.width), streams, streams, ht_op, sco(&chandef), band_number(chandef.control), 0, 0, 0],
+            ));
+        }
+    }
+
+    /// `mt7925_mcu_add_bss_info`: the BSS of the network joined, with its
+    /// channel when `enable`.
+    fn add_bss(&mut self, enable: bool) -> Result<(), String> {
+        let Some(network) = self.network.clone() else { return Ok(()) };
+        let freq = network.join.freq;
+        let mut out = vec![0u8; 4];
+        // Basic first, with the access point's station.
+        out.extend_from_slice(&self.bss_basic(true, !enable as u8, WCID_AP));
+        // The slot time: short except on 2.4 GHz without the AP's bit.
+        let short = !is_2ghz(freq) || network.join.capability & wifi::CAP_SHORT_SLOT != 0;
+        let elements = wifi::Elements(&network.join.elements);
+        let operation = network.peer.he.is_some().then(|| elements.extension(wifi::EXT_HE_OPERATION).unwrap_or(&[]));
+        self.bss_parts(&mut out, network.cipher, self.qos, short, operation, Some(network.join.chandef), freq, enable);
+        self.uni(UNI_BSS_INFO_UPDATE, &out).map(|_| ())
+    }
+
+    /// The access point's BSS: active (or not any more), its own modes,
+    /// beacon timing, the parts of `bss_parts` and its channel.
+    fn add_bss_ap(&mut self, enable: bool) -> Result<(), String> {
+        let Some(ap) = &self.ap else { return Ok(()) };
+        let chandef = ap.config.chandef;
+        let freq = chandef.control;
+        let phymode = if is_2ghz(freq) { PHY_MODE_B | PHY_MODE_G | PHY_MODE_GN | PHY_MODE_AX_24G } else { PHY_MODE_A | PHY_MODE_AN | PHY_MODE_AC | PHY_MODE_AX_5G };
+        let basic = BssBasic {
+            active: enable,
+            conn_type: CONNECTION_INFRA_AP,
+            conn_state: !enable as u8,
+            bssid: self.address,
+            freq,
+            interval: ap.config.beacon_interval,
+            dtim: ap.config.dtim_period.max(1),
+            phymode,
+            sta: WCID_OWN,
+        };
+        let short = !is_2ghz(freq) || ap.config.beacon.capability() & wifi::CAP_SHORT_SLOT != 0;
+        let operation = ap.he.then(|| ap.he_operation.clone().unwrap_or_default());
+        let (cipher, qos) = (ap.cipher, ap.qos);
+        let mut out = vec![0u8; 4];
+        out.extend_from_slice(&self.basic_tlv(&basic));
+        self.bss_parts(&mut out, cipher, qos, short, operation.as_deref(), Some(chandef), freq, enable);
+        self.uni(UNI_BSS_INFO_UPDATE, &out).map(|_| ())
+    }
+
+    /// `mt7925_mcu_set_bss_pm`: power save of the BSS off, then its beacon
+    /// interval and DTIM period.
+    fn bss_pm(&mut self, enable: bool) -> Result<(), String> {
+        let mut out = vec![0u8; 4];
+        out.extend_from_slice(&tlv(UNI_BSS_INFO_PM_DISABLE, &[]));
+        self.uni(UNI_BSS_INFO_UPDATE, &out)?;
+        let Some(ap) = &self.ap else { return Ok(()) };
+        if !enable {
+            return Ok(());
+        }
+        let mut value = ap.config.beacon_interval.to_le_bytes().to_vec();
+        value.extend_from_slice(&[ap.config.dtim_period.max(1), 0, 0, 0, 0, 0]);
+        let mut out = vec![0u8; 4];
+        out.extend_from_slice(&tlv(UNI_BSS_INFO_BCNFT, &value));
+        self.uni(UNI_BSS_INFO_UPDATE, &out).map(|_| ())
+    }
+
+    /// `mt7925_mcu_uni_add_beacon_offload`: the beacon from its
+    /// capabilities on, where its TIM is.
+    fn beacon_offload(&mut self) -> Result<(), String> {
+        let Some(ap) = &self.ap else { return Ok(()) };
+        let frame = ap.config.beacon.frame(ap.config.dtim_period);
+        let tim = ap.config.beacon.tim_offset();
+        let Some(body) = frame.get(wifi::BEACON_CAPABILITY..).filter(|body| body.len() <= BEACON_ROOM && tim >= wifi::BEACON_CAPABILITY) else {
+            return Err(format!("a beacon of {} bytes does not fit", frame.len()));
+        };
+        let mut value = ((tim - wifi::BEACON_CAPABILITY) as u16).to_le_bytes().to_vec();
+        value.extend_from_slice(&[0, 0, 0, 0, 1, 1]);
+        value.extend_from_slice(&(body.len() as u16).to_le_bytes());
+        let mut packet = [0u8; BEACON_ROOM];
+        packet[..body.len()].copy_from_slice(body);
+        value.extend_from_slice(&packet);
+        let mut out = vec![0u8; 4];
+        out.extend_from_slice(&tlv(UNI_BSS_INFO_BCN_CONTENT, &value));
+        self.uni(UNI_BSS_INFO_UPDATE, &out).map(|_| ())
+    }
+
+    /// The interface's entry as an access point (`mt7925_mcu_sta_update`
+    /// without a station): group frames to everyone, from the DS.
+    fn own_record_ap(&mut self) -> Result<(), String> {
+        let mut basic = CONNECTION_INFRA_BC.to_le_bytes().to_vec();
+        basic.extend_from_slice(&[CONN_STATE_PORT_SECURE, 0, 0, 0]);
+        basic.extend_from_slice(&wifi::BROADCAST);
+        basic.extend_from_slice(&(EXTRA_INFO_VER | EXTRA_INFO_NEW).to_le_bytes());
+        self.sta_rec(WCID_OWN, MUAR_NONE, &[tlv(STA_REC_BASIC, &basic), tlv(STA_REC_HDR_TRANS, &[1, 0, 1, 0])])
+    }
+
+    /// A station record (`STA_REC_UPDATE`): the header (`struct
+    /// sta_req_hdr`: BSS, WTBL index, TLV count, MUAR) and TLVs.
+    fn sta_rec(&mut self, wcid: u16, muar: u8, tlvs: &[Vec<u8>]) -> Result<(), String> {
+        let mut out = vec![0u8, (wcid & 0xff) as u8];
+        out.extend_from_slice(&(tlvs.len() as u16).to_le_bytes());
+        out.extend_from_slice(&[1, muar, (wcid >> 8) as u8, 0]);
+        for entry in tlvs {
+            out.extend_from_slice(entry);
+        }
+        self.uni(UNI_STA_REC_UPDATE, &out).map(|_| ())
+    }
+
+    /// `mt7925_mcu_sta_update`: the access point's station, `enable`d at
+    /// `state` (none before association, associated after), or removed.
+    fn station_record(&mut self, enable: bool, state: u8) -> Result<(), String> {
+        let Some(network) = self.network.clone() else { return Ok(()) };
+        let record = PeerRecord {
+            wcid: WCID_AP,
+            address: network.join.bssid,
+            aid: self.aid,
+            qos: self.qos,
+            peer: &network.peer,
+            freq: network.join.freq,
+            rates: network.rates,
+            basic: network.basic,
+            ap: false,
+        };
+        self.peer_record(&record, enable, state)
+    }
+
+    /// A peer's station record: its basics, PHY, HT, VHT, HE, rates and
+    /// state, header translation off; or the entry removed.
+    fn peer_record(&mut self, record: &PeerRecord<'_>, enable: bool, state: u8) -> Result<(), String> {
+        let peer = record.peer;
+        let mut tlvs = Vec::new();
+        if !enable {
+            tlvs.push(tlv(STA_REC_REMOVE, &[0, 0, 0, 0]));
+            tlvs.push(tlv(STA_REC_MLD_OFF, &[]));
+            return self.sta_rec(record.wcid, 0, &tlvs);
+        }
+        let newly = state != STATE_ASSOC;
+        let mut basic = Vec::with_capacity(16);
+        basic.extend_from_slice(&(if record.ap { CONNECTION_INFRA_STA } else { CONNECTION_INFRA_AP }).to_le_bytes());
+        basic.extend_from_slice(&[CONN_STATE_PORT_SECURE, record.qos as u8]);
+        basic.extend_from_slice(&record.aid.to_le_bytes());
+        basic.extend_from_slice(&record.address);
+        basic.extend_from_slice(&(EXTRA_INFO_VER | if newly { EXTRA_INFO_NEW } else { 0 }).to_le_bytes());
+        tlvs.push(tlv(STA_REC_BASIC, &basic));
+        // PHY: its types, the basic rates, A-MPDU factor and spacing.
+        let freq = record.freq;
+        let mut phy_type = if is_2ghz(freq) { PHY_TYPE_BIT_HR_DSSS | PHY_TYPE_BIT_ERP } else { PHY_TYPE_BIT_OFDM };
+        if peer.ht.is_some() {
+            phy_type |= PHY_TYPE_BIT_HT;
+        }
+        if peer.vht.is_some() {
+            phy_type |= PHY_TYPE_BIT_VHT;
+        }
+        if peer.he.is_some() {
+            phy_type |= PHY_TYPE_BIT_HE;
+        }
+        let factor = peer.vht.map_or(peer.ht.map_or(0, |ht| ht.ampdu_factor as u32), |vht| (vht.info >> chan::VHT_CAP_MAX_AMPDU_SHIFT) & 7) as u8;
+        let density = peer.ht.map_or(0, |ht| ht.ampdu_density);
+        let mut phy = Vec::with_capacity(8);
+        phy.extend_from_slice(&record.basic.to_le_bytes());
+        phy.extend_from_slice(&[phy_type, (factor & 3) | ((density & 7) << 2), 0, 0, factor, 0]);
+        tlvs.push(tlv(STA_REC_PHY, &phy));
+        if let Some(ht) = &peer.ht {
+            let mut value = ht.info.to_le_bytes().to_vec();
+            value.extend_from_slice(&[0, 0]);
+            tlvs.push(tlv(STA_REC_HT, &value));
+        }
+        if let Some(vht) = &peer.vht {
+            let mut value = vht.info.to_le_bytes().to_vec();
+            value.extend_from_slice(&vht.mcs[0..2]);
+            value.extend_from_slice(&vht.mcs[4..6]);
+            value.extend_from_slice(&[0; 4]);
+            tlvs.push(tlv(STA_REC_VHT, &value));
+        }
+        if let Some(he) = &peer.he {
+            // `struct sta_rec_he_v2`: its MAC and PHY capabilities, then the
+            // highest MCS at 80, 160 and 80+80 MHz.
+            let mut value = Vec::with_capacity(24);
+            value.extend_from_slice(&he.mac);
+            value.extend_from_slice(&he.phy);
+            // The packet extension: 16 µs.
+            value.push(2);
+            value.extend_from_slice(&le16(&he.mcs, 0).to_le_bytes());
+            value.extend_from_slice(&(if he.mcs.len() >= 6 { le16(&he.mcs, 4) } else { 0xffff }).to_le_bytes());
+            value.extend_from_slice(&0xffffu16.to_le_bytes());
+            tlvs.push(tlv(STA_REC_HE_V2, &value));
+        }
+        // Rates: legacy OFDM and CCK, and HT's MCS.
+        let legacy = if is_2ghz(freq) { ((record.rates >> 4) << 6) | (record.rates & 0xf) } else { (record.rates & 0xff) << 6 };
+        let mut ra = legacy.to_le_bytes().to_vec();
+        let mut mcs = [0u8; 10];
+        if let Some(ht) = &peer.ht {
+            mcs.copy_from_slice(&ht.mcs[..10]);
+        }
+        ra.extend_from_slice(&mcs);
+        tlvs.push(tlv(STA_REC_RA, &ra));
+        // State, and the operating mode VHT announces.
+        let opmode = if peer.vht.is_some() { cbw(peer.width).min(3) | (peer.nss.max(1) << 4) } else { 0 };
+        let mut value = vec![state, 0, 0, 0];
+        value.extend_from_slice(&0u32.to_le_bytes());
+        value.extend_from_slice(&[opmode, 0, 0, 0]);
+        tlvs.push(tlv(STA_REC_STATE, &value));
+        // Header translation off: frames come as 802.11; from the DS to a
+        // station, to it from an access point's stations.
+        tlvs.push(tlv(STA_REC_HDR_TRANS, &[record.ap as u8, !record.ap as u8, 1, 0]));
+        self.sta_rec(record.wcid, 0, &tlvs)
+    }
+
+    /// The network's EDCA parameters (`mt7925_mcu_set_tx`): from its WMM
+    /// element, else the defaults.
+    fn set_tx(&mut self, elements: &[u8]) {
+        let wmm = wifi::Elements(elements).vendor(wifi::WMM_OUI_TYPE).filter(|value| value.len() >= 20 && value[0] == 1);
+        let mut out = vec![0u8; 4];
+        // The firmware's order: BE, BK, VI, VO (mac80211's queue order).
+        let defaults = [(3u8, 4u8, 10u8, 0u16), (7, 4, 10, 0), (2, 3, 4, 94), (2, 2, 3, 47)];
+        let wmm_index = [0usize, 1, 2, 3];
+        for (queue, (aifs, cw_min, cw_max, txop)) in defaults.into_iter().enumerate() {
+            let (aifs, cw_min, cw_max, txop) = match wmm {
+                Some(value) => {
+                    let at = 4 + wmm_index[queue] * 4;
+                    let param = &value[at..at + 4];
+                    (param[0] & 0x0f, param[1] & 0x0f, param[1] >> 4, u16::from_le_bytes([param[2], param[3]]))
+                }
+                None => (aifs, cw_min, cw_max, txop),
+            };
+            let mut value = vec![queue as u8, 0x0f, cw_min, cw_max];
+            value.extend_from_slice(&txop.to_le_bytes());
+            value.extend_from_slice(&[aifs, 0]);
+            out.extend_from_slice(&tlv(EDCA_AC_PARAM, &value));
+        }
+        if let Err(error) = self.uni(UNI_EDCA_UPDATE, &out) {
+            ostd::info!("{}: EDCA: {}", self.name, error);
+        }
+    }
+
+    fn roc_acquire(&mut self) {
+        let Some(network) = &self.network else { return };
+        let freq = network.join.freq;
+        self.roc_token = self.roc_token.wrapping_add(1);
+        let channel = wifi::channel_of(freq).unwrap_or(0);
+        let mut value = vec![0u8, self.roc_token, channel, 0, band_number(freq), CMD_CBW_20MHZ, channel, 0, CMD_CBW_20MHZ, channel, 0, ROC_REQ_JOIN];
+        value.extend_from_slice(&ROC_MS.to_le_bytes());
+        // The DBDC band: the firmware's choice, told in the grant.
+        value.extend_from_slice(&[0xff, 0, 0, 0]);
+        let mut out = vec![0u8; 4];
+        out.extend_from_slice(&tlv(UNI_ROC_ACQUIRE, &value));
+        self.roc_granted = false;
+        if let Err(error) = self.chip.mcu(Cmd::Uni(UNI_ROC), &out, false) {
+            ostd::warn!("{}: channel for joining: {}", self.name, error);
+            return;
+        }
+        self.roc_active = true;
+        // The grant comes as an event: frames to the network wait for it.
+        let deadline = crate::now_ms() + ROC_GRANT_MS;
+        while !self.roc_granted && crate::now_ms() < deadline {
+            self.poll();
+            if !self.roc_granted {
+                crate::sleep();
+            }
+        }
+        if !self.roc_granted {
+            ostd::info!("{}: no grant for the channel; joining anyway", self.name);
+        }
+    }
+
+    fn roc_abort(&mut self) {
+        if !self.roc_active {
+            return;
+        }
+        self.roc_active = false;
+        let mut out = vec![0u8; 4];
+        out.extend_from_slice(&tlv(UNI_ROC_ABORT, &[0, self.roc_token, self.band_idx, 0, 0, 0, 0, 0]));
+        let _ = self.chip.mcu(Cmd::Uni(UNI_ROC), &out, false);
+    }
+
+    // ---- The radio's operations. ----
+
+    /// `mt7925_mcu_hw_scan`: the header, then the request, names, BSSID,
+    /// channels, other settings and the probe requests' elements.
+    pub(crate) fn scan(&mut self, request: &ScanRequest) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if self.scanning || self.ap.is_some() {
+            return Err(radio::Error::Busy);
+        }
+        self.scan_seq = (self.scan_seq + 1) & 0x7f;
+        let active = !request.ssids.is_empty();
+        let ssids: Vec<&Vec<u8>> = request.ssids.iter().filter(|ssid| !ssid.is_empty()).take(10).collect();
+        let freqs: Vec<u16> = request.freqs.iter().copied().filter(|&freq| wifi::channel_of(freq).is_some() && BandId::of(freq) != BandId::Ghz6).take(64).collect();
+        let mut out = vec![self.scan_seq | (self.band_idx << 7), 0, 0, 0];
+        let mut req = vec![active as u8, if active { 2 } else { 0 }, 1 << 5, 0];
+        req.extend_from_slice(&[0; 12]);
+        out.extend_from_slice(&tlv(UNI_SCAN_REQ_TLV, &req));
+        let mut ssid = vec![if ssids.is_empty() { 1 << 0 } else { 1 << 2 }, ssids.len() as u8, 0, 0];
+        for index in 0..10 {
+            let mut entry = [0u8; 36];
+            if let Some(name) = ssids.get(index) {
+                let length = name.len().min(32);
+                entry[0..4].copy_from_slice(&(length as u32).to_le_bytes());
+                entry[4..4 + length].copy_from_slice(&name[..length]);
+            }
+            ssid.extend_from_slice(&entry);
+        }
+        out.extend_from_slice(&tlv(UNI_SCAN_SSID, &ssid));
+        let mut bssid = wifi::BROADCAST.to_vec();
+        bssid.extend_from_slice(&[0; 6]);
+        out.extend_from_slice(&tlv(UNI_SCAN_BSSID, &bssid));
+        let mut channels = vec![if freqs.is_empty() { 0 } else { 4 }, freqs.len() as u8, 0, 0];
+        for index in 0..64 {
+            match freqs.get(index) {
+                Some(&freq) => channels.extend_from_slice(&[band_number(freq), wifi::channel_of(freq).unwrap_or(0)]),
+                None => channels.extend_from_slice(&[0, 0]),
+            }
+        }
+        out.extend_from_slice(&tlv(UNI_SCAN_CHANNEL, &channels));
+        out.extend_from_slice(&tlv(UNI_SCAN_MISC, &[0; 8]));
+        // The elements last, one TLV a band: its rates and capabilities,
+        // then the supplicant's.
+        let info = self.info();
+        let extra = &request.elements[..request.elements.len().min(300)];
+        for band in &info.bands {
+            let mut elements = Vec::new();
+            let rates = band.id.rates();
+            wifi::put_element(&mut elements, wifi::IE_RATES, &rates[..rates.len().min(8)]);
+            if rates.len() > 8 {
+                wifi::put_element(&mut elements, wifi::IE_EXT_RATES, &rates[8..]);
+            }
+            if let Some(ht) = &band.ht {
+                wifi::put_element(&mut elements, wifi::IE_HT_CAP, &ht.element());
+            }
+            if let Some(vht) = &band.vht {
+                wifi::put_element(&mut elements, wifi::IE_VHT_CAP, &vht.element());
+            }
+            if let Some(he) = &band.he {
+                let mut value = vec![wifi::EXT_HE_CAP];
+                value.extend_from_slice(&he.element());
+                wifi::put_element(&mut elements, wifi::IE_EXTENSION, &value);
+            }
+            elements.extend_from_slice(extra);
+            let mut ie = (elements.len() as u16).to_le_bytes().to_vec();
+            ie.extend_from_slice(&[if band.id == BandId::Ghz2 { 1 } else { 2 }, 0]);
+            ie.extend_from_slice(&elements);
+            ie.resize(ie.len().next_multiple_of(4), 0);
+            out.extend_from_slice(&tlv(UNI_SCAN_IE, &ie));
+        }
+        if let Err(error) = self.chip.mcu(Cmd::Uni(UNI_SCAN_REQ), &out, false) {
+            ostd::warn!("{}: scan: {}", self.name, error);
+            return Err(radio::Error::Failed);
+        }
+        self.scanning = true;
+        self.scan_started = crate::now_ms();
+        Ok(())
+    }
+
+    pub(crate) fn abort_scan(&mut self) {
+        if !self.scanning {
+            return;
+        }
+        self.scanning = false;
+        let mut out = vec![self.scan_seq, 0, 0, 0];
+        out.extend_from_slice(&tlv(UNI_SCAN_CANCEL, &[0, 0, 0, 0]));
+        let _ = self.chip.mcu(Cmd::Uni(UNI_SCAN_REQ), &out, false);
+        if let Some(device) = &self.device {
+            device.scan_done(true);
+        }
+    }
+
+    /// Linux's station add (`mt7925_mac_link_sta_add`) and
+    /// `mgd_prepare_tx`: the BSS and the access point's station, then the
+    /// channel.
+    pub(crate) fn join(&mut self, join: &Join) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if self.ap.is_some() {
+            return Err(radio::Error::Busy);
+        }
+        self.leave();
+        self.network = Some(Network::new(join));
+        self.aid = 0;
+        self.qos = false;
+        let result = self.add_bss(true).and_then(|()| self.station_record(true, STATE_NONE));
+        if let Err(error) = result {
+            ostd::warn!("{}: joining: {}", self.name, error);
+            self.network = None;
+            return Err(radio::Error::Failed);
+        }
+        self.roc_acquire();
+        Ok(())
+    }
+
+    pub(crate) fn associated(&mut self, association: &Association) -> radio::Result<()> {
+        let Some(network) = self.network.as_mut() else { return Err(radio::Error::Invalid) };
+        network.peer = association.peer.clone();
+        network.join.chandef = association.chandef;
+        self.aid = association.aid & 0x3fff;
+        self.qos = association.qos;
+        let result = self.add_bss(true).and_then(|()| self.station_record(true, STATE_ASSOC));
+        if let Err(error) = result {
+            ostd::warn!("{}: association: {}", self.name, error);
+            self.roc_abort();
+            return Err(radio::Error::Failed);
+        }
+        self.set_tx(&association.elements);
+        self.roc_abort();
+        self.associated = true;
+        Ok(())
+    }
+
+    pub(crate) fn leave(&mut self) {
+        if self.network.is_none() {
+            return;
+        }
+        if !self.dead {
+            self.roc_abort();
+            let _ = self.station_record(false, STATE_NONE);
+            let _ = self.add_bss(false);
+        }
+        self.network = None;
+        self.associated = false;
+        self.aid = 0;
+        self.pairwise = None;
+        self.signal = None;
+    }
+
+    // ---- As an access point (`mt7925_start_ap`, `_stop_ap`, the beacon
+    // offload, `mt7925_mac_link_sta_add`/`_assoc`/`_remove`). ----
+
+    pub(crate) fn start_ap(&mut self, config: &ApConfig) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        self.stop_ap();
+        self.leave();
+        self.abort_scan();
+        self.ap = Some(Ap::new(config));
+        let result = self.add_bss_ap(true).and_then(|()| self.bss_pm(true)).and_then(|()| self.own_record_ap()).and_then(|()| self.beacon_offload());
+        if let Err(error) = result {
+            ostd::warn!("{}: the access point: {}", self.name, error);
+            self.stop_ap();
+            return Err(radio::Error::Failed);
+        }
+        self.qos = self.ap.as_ref().is_some_and(|ap| ap.qos);
+        let elements = config.beacon.elements();
+        self.set_tx(&elements);
+        Ok(())
+    }
+
+    pub(crate) fn set_beacon(&mut self, beacon: &BeaconTemplate) -> radio::Result<()> {
+        let Some(ap) = &mut self.ap else { return Err(radio::Error::Down) };
+        ap.read_beacon(beacon);
+        self.beacon_offload().map_err(|error| {
+            ostd::warn!("{}: beacon: {}", self.name, error);
+            radio::Error::Failed
+        })
+    }
+
+    pub(crate) fn stop_ap(&mut self) {
+        let Some(ap) = &self.ap else { return };
+        let addresses: Vec<Address> = ap.stations.keys().copied().collect();
+        if !self.dead {
+            for address in &addresses {
+                self.remove_station(address);
+            }
+            let _ = self.bss_pm(false);
+            let _ = self.add_bss_ap(false);
+        }
+        self.ap = None;
+        self.qos = false;
+        if !self.dead {
+            let _ = self.add_interface();
+        }
+    }
+
+    pub(crate) fn add_station(&mut self, station: &StationEntry) -> radio::Result<()> {
+        let Some(ap) = &self.ap else { return Err(radio::Error::Down) };
+        if ap.stations.contains_key(&station.address) {
+            self.remove_station(&station.address);
+        }
+        let Some(ap) = &mut self.ap else { return Err(radio::Error::Down) };
+        let used: Vec<u16> = ap.stations.values().map(|station| station.wcid).collect();
+        let Some(wcid) = (1..=AP_STATIONS as u16).find(|wcid| !used.contains(wcid)) else { return Err(radio::Error::Busy) };
+        ap.stations.insert(station.address, ApStation { wcid, qos: station.peer.qos, key: false });
+        let freq = ap.config.chandef.control;
+        let (rates, _) = rate_bitmaps(is_2ghz(freq), station.peer.rates.iter().copied());
+        let record = PeerRecord { wcid, address: station.address, aid: station.aid & 0x3fff, qos: station.peer.qos, peer: &station.peer, freq, rates, basic: ap.basic, ap: true };
+        let result = self.peer_record(&record, true, STATE_NONE).and_then(|()| self.peer_record(&record, true, STATE_ASSOC));
+        if let Err(error) = result {
+            ostd::warn!("{}: station {:02x?}: {}", self.name, station.address, error);
+            self.remove_station(&station.address);
+            return Err(radio::Error::Failed);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn remove_station(&mut self, address: &Address) {
+        let Some(ap) = &mut self.ap else { return };
+        let Some(station) = ap.stations.remove(address) else { return };
+        let none = radio::Peer::default();
+        let record = PeerRecord { wcid: station.wcid, address: *address, aid: 0, qos: false, peer: &none, freq: ap.config.chandef.control, rates: 0, basic: 0, ap: true };
+        if !self.dead {
+            let _ = self.peer_record(&record, false, STATE_NONE);
+        }
+    }
+
+    /// `mt7925_mcu_add_key`: pairwise keys on the access point's entry (as
+    /// an access point, the station's), group keys on the interface's, both
+    /// naming the network.
+    pub(crate) fn set_key(&mut self, key: &Key, remove: bool) -> radio::Result<()> {
+        let cipher = match key.cipher {
+            radio::CIPHER_CCMP => CIPHER_AES_CCMP,
+            radio::CIPHER_CCMP_256 => CIPHER_CCMP_256,
+            radio::CIPHER_GCMP => CIPHER_GCMP,
+            radio::CIPHER_GCMP_256 => CIPHER_GCMP_256,
+            _ if remove => CIPHER_AES_CCMP,
+            _ => return Err(radio::Error::Unsupported),
+        };
+        if key.key.len() > 32 {
+            return Err(radio::Error::Invalid);
+        }
+        // The peer the key is for, its entry.
+        let (bssid, wcid, muar) = if let Some(ap) = self.ap.as_mut() {
+            if !remove {
+                ap.cipher = cipher;
+            }
+            if key.pairwise {
+                let Some((address, station)) = key.address.and_then(|address| ap.stations.get(&address).map(|station| (address, station))) else {
+                    return if remove { Ok(()) } else { Err(radio::Error::Invalid) };
+                };
+                (address, station.wcid, 0)
+            } else {
+                (self.address, WCID_OWN, MUAR_NONE)
+            }
+        } else {
+            let Some(network) = self.network.as_mut() else { return Err(radio::Error::Down) };
+            if key.pairwise && !remove {
+                network.cipher = cipher;
+            }
+            let (wcid, muar) = if key.pairwise { (WCID_AP, 0) } else { (WCID_OWN, MUAR_NONE) };
+            (network.join.bssid, wcid, muar)
+        };
+        // `struct sta_rec_sec_uni`: add, transmit with it, its kind, not
+        // the authenticator; the peer, BSS, cipher, index, length, entry,
+        // management protection; the key and its counter.
+        let mut value = vec![!remove as u8, key.pairwise as u8, key.pairwise as u8, 0];
+        value.extend_from_slice(&bssid);
+        value.extend_from_slice(&[0, cipher, key.index, key.key.len() as u8, wcid as u8, 1]);
+        let mut material = [0u8; 32];
+        material[..key.key.len()].copy_from_slice(&key.key);
+        value.extend_from_slice(&material);
+        let mut rsc = [0u8; 16];
+        rsc[..key.seq.len().min(16)].copy_from_slice(&key.seq[..key.seq.len().min(16)]);
+        value.extend_from_slice(&rsc);
+        if let Err(error) = self.sta_rec(wcid, muar, &[tlv(STA_REC_KEY_V3, &value)]) {
+            ostd::warn!("{}: key: {}", self.name, error);
+            return Err(radio::Error::Failed);
+        }
+        if let Some(ap) = &mut self.ap {
+            if let Some(station) = ap.stations.get_mut(&bssid).filter(|_| key.pairwise) {
+                station.key = !remove;
+            }
+            // The BSS's security part names the cipher in force.
+            if !remove && !key.pairwise {
+                let _ = self.add_bss_ap(true);
+            }
+        } else if key.pairwise {
+            self.pairwise = if remove { None } else { Some((key.index, 1)) };
+            // The BSS's security part names the cipher now in force.
+            if !remove && self.associated {
+                let _ = self.add_bss(true);
+            }
+        }
+        Ok(())
+    }
+
+    // ---- Frames. ----
+
+    fn token(&mut self) -> Option<usize> {
+        let now = crate::now_ms().max(1);
+        for step in 0..TOKENS {
+            let token = (self.next_token + step) % TOKENS;
+            let busy = self.token_busy[token];
+            if busy == 0 || now >= busy + TOKEN_STALE_MS {
+                self.next_token = (token + 1) % TOKENS;
+                self.token_busy[token] = now;
+                return Some(token);
+            }
+        }
+        None
+    }
+
+    /// An 802.11 frame out (`mt7925_mac_write_txwi`): the connac3 TXD and
+    /// the TXP on the data ring, the frame in a token's buffer.
+    pub(crate) fn transmit(&mut self, mut frame: Vec<u8>) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if frame.len() < wifi::HEADER {
+            return Err(radio::Error::Invalid);
+        }
+        let data = wifi::is_data(&frame);
+        if frame[1] & wifi::PROTECTED != 0 && self.ap.is_some() {
+            // As an access point: data with the receiver's key, no
+            // protected management frames.
+            if !data {
+                frame[1] &= !wifi::PROTECTED;
+            }
+        } else if frame[1] & wifi::PROTECTED != 0 {
+            match self.pairwise.as_mut() {
+                Some((index, pn)) if !data => {
+                    let value = *pn;
+                    *pn += 1;
+                    let header = [value as u8, (value >> 8) as u8, 0, 0x20 | (*index << 6), (value >> 16) as u8, (value >> 24) as u8, (value >> 32) as u8, (value >> 40) as u8];
+                    drop(frame.splice(wifi::HEADER..wifi::HEADER, header));
+                }
+                Some(_) => {}
+                None => frame[1] &= !wifi::PROTECTED,
+            }
+        }
+        let protected = frame[1] & wifi::PROTECTED != 0;
+        let sequence = self.sequence;
+        self.sequence = (sequence + 1) & 0x0fff;
+        frame[22..24].copy_from_slice(&(sequence << 4).to_le_bytes());
+        let qos_data = data && frame[0] & 0x80 != 0;
+        let header = if qos_data { 26 } else { 24 };
+        let tid = if qos_data { (frame[24] & 7) as u32 } else { 0 };
+        let multicast = frame[4] & 1 != 0;
+        let (kind, subtype) = (((frame[0] >> 2) & 3) as u32, ((frame[0] >> 4) & 0xf) as u32);
+        let wcid = match &self.ap {
+            Some(ap) => frame.get(4..10).and_then(|b| <Address>::try_from(b).ok()).and_then(|address| ap.stations.get(&address)).map_or(WCID_OWN, |station| station.wcid),
+            None if self.network.is_some() => WCID_AP,
+            None => WCID_OWN,
+        } as u32;
+        if frame.len() > BUFFER {
+            return Err(radio::Error::Invalid);
+        }
+        let Some(token) = self.token() else { return Err(radio::Error::Busy) };
+        if self.tokens.write_bytes(token * BUFFER, &frame).is_err() {
+            self.token_busy[token] = 0;
+            return Err(radio::Error::Memory);
+        }
+        let queue = if data { [1u32, 0, 0, 1, 2, 2, 3, 3][tid as usize] } else { LMAC_ALTX0 };
+        let mut txd = [0u32; 8];
+        txd[0] = ((frame.len() + TXD_SIZE) as u32 & 0xffff) | (queue << 25);
+        txd[1] = (wcid & 0xfff) | ((self.band_idx as u32) << 12) | (HDR_FORMAT_802_11 << 14) | (((header / 2) as u32) << 16) | (tid << 21);
+        txd[2] = (kind << 4) | subtype;
+        txd[3] = (15 << 11) | if protected { TXD3_PROTECT_FRAME } else { 0 } | if multicast { TXD3_BCM } else { 0 };
+        txd[6] = TXD6_DAS | (1 << 4) | TXD6_DIS_MAT;
+        if !data || multicast {
+            // The band's lowest rate, from the fixed table.
+            let ghz2 = match &self.ap {
+                Some(ap) => is_2ghz(ap.config.chandef.control),
+                None => self.network.as_ref().is_none_or(|network| is_2ghz(network.join.freq)),
+            };
+            let index = hw::BASIC_RATES_TBL as u32 + if ghz2 { 0 } else { 4 };
+            txd[1] |= TXD1_FIXED_RATE;
+            txd[3] |= TXD3_BA_DISABLE;
+            txd[6] |= index << 16;
+        }
+        let mut txwi = Vec::with_capacity(TXD_SIZE + TXP_SIZE);
+        for word in txd {
+            txwi.extend_from_slice(&word.to_le_bytes());
+        }
+        let mut txp = [0u8; TXP_SIZE];
+        txp[0..2].copy_from_slice(&(token as u16 | MSDU_ID_VALID).to_le_bytes());
+        let address = (self.tokens.daddr() + token * BUFFER) as u32;
+        txp[8..12].copy_from_slice(&address.to_le_bytes());
+        txp[12..14].copy_from_slice(&((frame.len() as u16 & 0x0fff) | TXD_LEN_LAST).to_le_bytes());
+        txwi.extend_from_slice(&txp);
+        self.chip.data_send(&txwi).map_err(|()| {
+            self.token_busy[token] = 0;
+            radio::Error::Busy
+        })
+    }
+
+    pub(crate) fn send(&mut self, ethernet: &[u8], plain: bool) -> radio::Result<()> {
+        if let Some(ap) = &self.ap {
+            let destination: Address = ethernet.get(..6).and_then(|b| b.try_into().ok()).ok_or(radio::Error::Invalid)?;
+            let (tid, keyed) = if wifi::is_multicast(&destination) {
+                (None, true)
+            } else {
+                let station = ap.stations.get(&destination).ok_or(radio::Error::Invalid)?;
+                (station.qos.then(|| wifi::tid_of(ethernet)), station.key)
+            };
+            let frame = wifi::data_from_ethernet_ap(ethernet, &self.address, tid, !plain && keyed).ok_or(radio::Error::Invalid)?;
+            return self.transmit(frame);
+        }
+        let Some(network) = &self.network else { return Err(radio::Error::Down) };
+        let tid = self.qos.then(|| wifi::tid_of(ethernet));
+        let protected = !plain && self.pairwise.is_some();
+        let frame = wifi::data_from_ethernet(ethernet, &network.join.bssid, tid, protected).ok_or(radio::Error::Invalid)?;
+        self.transmit(frame)
+    }
+
+    // ---- What the chip says. ----
+
+    pub(crate) fn poll(&mut self) {
+        if self.dead {
+            return;
+        }
+        let status = self.chip.rr(hw::HOST_INT_STA);
+        if status == u32::MAX {
+            ostd::warn!("{}: the card is gone", self.name);
+            self.died();
+            return;
+        }
+        if status != 0 {
+            self.chip.wr(hw::HOST_INT_STA, status);
+        }
+        if status & hw::INT_MCU_CMD != 0 {
+            let command = self.chip.rr(hw::MCU_CMD);
+            self.chip.wr(hw::MCU_CMD, command);
+            if command & MCU_CMD_STOP_DMA != 0 {
+                ostd::warn!("{}: the firmware stopped ({:#x}); the card stays off until the next boot", self.name, command);
+                self.died();
+                return;
+            }
+        }
+        let mut packets = core::mem::take(&mut self.chip.pending);
+        for which in [hw::RXQ_MCU, hw::RXQ_DATA] {
+            packets.extend(self.chip.ring_receive(which));
+        }
+        for packet in packets {
+            self.handle(&packet);
+        }
+        if self.scanning && crate::now_ms() >= self.scan_started + SCAN_LIMIT_MS {
+            ostd::warn!("{}: the scan did not end; ended here", self.name);
+            self.scanning = false;
+            if let Some(device) = &self.device {
+                device.scan_done(true);
+            }
+        }
+    }
+
+    fn died(&mut self) {
+        self.dead = true;
+        if let Some(device) = &self.device {
+            if self.scanning {
+                device.scan_done(true);
+            }
+            device.connection_lost();
+        }
+        self.scanning = false;
+    }
+
+    fn handle(&mut self, packet: &[u8]) {
+        let rxd0 = le32(packet, 0);
+        let (kind, flag) = (rxd0 >> 27, (rxd0 >> 16) & 0xf);
+        // A frame through the MCU (its software type says so).
+        let sw_frame = ((rxd0 >> 16) & 0x380f) == 0x3801;
+        match kind {
+            PKT_TYPE_NORMAL => self.rx_frame(packet),
+            _ if sw_frame => self.rx_frame(packet),
+            PKT_TYPE_RX_EVENT if flag == 1 => self.rx_frame(packet),
+            PKT_TYPE_TXRX_NOTIFY => self.tx_free(packet),
+            PKT_TYPE_RX_EVENT if packet.len() >= hw::MCU_RXD_7925 => self.event(packet),
+            _ => {}
+        }
+    }
+
+    /// The connac3 TX-free report (`mt7925_mac_tx_free`): the count, then
+    /// words of a station ("pair"), of statistics ("header"), or of two
+    /// frames' tokens each.
+    fn tx_free(&mut self, packet: &[u8]) {
+        let count = ((le32(packet, 0) >> 16) & 0x3ff) as usize;
+        let mut freed = 0;
+        let mut at = 8;
+        while freed < count && at + 4 <= packet.len() {
+            let info = le32(packet, at);
+            at += 4;
+            if info & (TXFREE_INFO_PAIR | TXFREE_INFO_HEADER) != 0 {
+                continue;
+            }
+            for half in 0..2 {
+                let token = (info >> (15 * half)) & 0x7fff;
+                if token == TXFREE_MSDU_NONE {
+                    continue;
+                }
+                freed += 1;
+                if let Some(busy) = self.token_busy.get_mut(token as usize) {
+                    *busy = 0;
+                }
+            }
+        }
+        if let Some(device) = &self.device {
+            device.ready_to_send();
+        }
+    }
+
+    /// Unsolicited events (`mt7925_mcu_uni_rx_unsolicited_event`): the
+    /// channel's grant, a scan's end, the access point's beacons lost.
+    fn event(&mut self, packet: &[u8]) {
+        let (eid, option) = (packet[36], packet[38]);
+        if option & UNSOLICITED == 0 {
+            return;
+        }
+        let body = hw::MCU_RXD_7925 + 4;
+        match eid {
+            UNI_EVENT_ROC if le16(packet, body) == UNI_EVENT_ROC_GRANT => {
+                // `struct mt7925_roc_grant_tlv`: the band is its 15th byte.
+                if let Some(&band) = packet.get(body + 14) {
+                    self.band_idx = band & 1;
+                }
+                self.roc_granted = true;
+            }
+            UNI_EVENT_SCAN_DONE => {
+                // The TLVs after the event's header: the basic one ends it.
+                let mut at = body;
+                while at + 4 <= packet.len() {
+                    let (tag, length) = (le16(packet, at), le16(packet, at + 2) as usize);
+                    if tag == UNI_EVENT_SCAN_DONE_BASIC && self.scanning {
+                        self.scanning = false;
+                        if let Some(device) = &self.device {
+                            device.scan_done(false);
+                        }
+                    }
+                    if length < 4 {
+                        break;
+                    }
+                    at += length;
+                }
+            }
+            UNI_EVENT_BSS_BEACON_LOSS => {
+                if self.associated
+                    && let Some(device) = &self.device
+                {
+                    ostd::info!("{}: the firmware lost the access point's beacons", self.name);
+                    device.connection_lost();
+                }
+            }
+            _ => {}
+        }
+    }
+
+    /// A frame after its connac3 RXD (`mt7925_mac_fill_rx`): eight words,
+    /// the groups it says are there (4, 1, 2, 3 and 5), the padding.
+    fn rx_frame(&mut self, packet: &[u8]) {
+        let (rxd0, rxd1, rxd2, rxd3, rxd4) = (le32(packet, 0), le32(packet, 4), le32(packet, 8), le32(packet, 12), le32(packet, 16));
+        let length = (rxd0 & 0xffff) as usize;
+        // A broken A-MSDU, too long, an ICV error, a bad FCS.
+        if rxd2 & ((1 << 23) | (1 << 24)) != 0 || rxd1 & (1 << 25) != 0 || rxd3 & (1 << 24) != 0 {
+            return;
+        }
+        // Header translation is off: 802.11 only.
+        if rxd2 & (1 << 7) != 0 {
+            return;
+        }
+        let mut at = 32;
+        let mut signal: Option<i16> = None;
+        if rxd1 & (1 << 19) != 0 {
+            at += 16;
+        }
+        if rxd1 & (1 << 16) != 0 {
+            at += 16;
+        }
+        if rxd1 & (1 << 17) != 0 {
+            at += 16;
+        }
+        if rxd1 & (1 << 18) != 0 {
+            let v3 = le32(packet, at + 12);
+            at += 16;
+            if rxd1 & (1 << 20) != 0 {
+                at += 96;
+            }
+            for chain in 0..self.nss as u32 {
+                let rssi = (((v3 >> (8 * chain)) & 0xff) as i16 - 220) / 2;
+                if rssi < 0 {
+                    signal = Some(signal.map_or(rssi, |best| best.max(rssi)));
+                }
+            }
+        }
+        at += 2 * ((rxd2 >> 13) & 7) as usize;
+        let Some(frame) = packet.get(at..length.min(packet.len())) else { return };
+        if frame.len() < wifi::HEADER {
+            return;
+        }
+        let mut frame = frame.to_vec();
+        if rxd4 & 3 != 0 {
+            let header = if wifi::is_data(&frame) && frame[0] & 0x80 != 0 { 26 } else { 24 };
+            if frame.len() < header + 2 {
+                return;
+            }
+            drop(frame.drain(header..header + 2));
+        }
+        let channel = ((rxd3 >> 8) & 0xff) as u16;
+        let freq = match channel {
+            1..=13 => 2407 + 5 * channel,
+            14 => 2484,
+            15..=180 => 5000 + 5 * channel,
+            _ => return,
+        };
+        let decrypted = (rxd2 >> 16) & 0x1f != 0 && rxd1 & ((1 << 23) | (1 << 24)) == 0;
+        let signal = signal.unwrap_or(-100).clamp(-127, -1) as i8;
+        if let Some(network) = &self.network
+            && wifi::addresses(&frame).is_some_and(|(_, transmitter, _)| transmitter == network.join.bssid)
+        {
+            self.signal = Some(signal);
+        }
+        if let Some(device) = &self.device {
+            device.received(&frame, RxInfo { freq, signal, decrypted, security_header: 0 });
+        }
+    }
+
+    /// The station's own VHT and HE MCS map: MCS 0-9 (VHT) or 0-11 (HE)
+    /// on each stream it has.
+    fn mcs_map(&self) -> u16 {
+        (0..8).fold(0u16, |map, stream| map | (if stream < self.nss as usize { 2 } else { 3 }) << (stream * 2))
+    }
+
+    pub(crate) fn info(&self) -> Info {
+        let streams = self.nss as usize;
+        let mut mcs = [0u8; 16];
+        for stream in 0..streams {
+            mcs[stream] = 0xff;
+        }
+        mcs[12] = 1;
+        // LDPC, 40 MHz, SM power save off, short GI at 20 and 40 MHz, STBC
+        // both ways.
+        let ht = HtCap {
+            info: chan::HT_CAP_LDPC | chan::HT_CAP_SUP_WIDTH_20_40 | 0x000c | chan::HT_CAP_SGI_20 | chan::HT_CAP_SGI_40 | 0x0080 | 0x0100,
+            ampdu_factor: 3,
+            ampdu_density: 5,
+            mcs,
+        };
+        let map = self.mcs_map();
+        let mut vht_mcs = [0u8; 8];
+        vht_mcs[0..2].copy_from_slice(&map.to_le_bytes());
+        vht_mcs[4..6].copy_from_slice(&map.to_le_bytes());
+        let vht = VhtCap {
+            info: chan::VHT_CAP_RXLDPC
+                | chan::VHT_CAP_SGI_80
+                | chan::VHT_CAP_SGI_160
+                | 0x0000_0004
+                | chan::VHT_CAP_TXSTBC
+                | 0x0100
+                | chan::VHT_CAP_SU_BEAMFORMEE
+                | (3 << 13)
+                | (7 << chan::VHT_CAP_MAX_AMPDU_SHIFT)
+                | 0x3000_0000,
+            mcs: vht_mcs,
+        };
+        let he = |id: BandId| {
+            let mut phy = HE_PHY;
+            phy[0] = if id == BandId::Ghz2 { chan::HE_PHY_40_IN_2G } else { chan::HE_PHY_40_80_IN_5G | chan::HE_PHY_160_IN_5G };
+            let bytes = map.to_le_bytes();
+            let mut mcs = vec![bytes[0], bytes[1], bytes[0], bytes[1]];
+            if id != BandId::Ghz2 {
+                mcs.extend_from_slice(&[bytes[0], bytes[1], bytes[0], bytes[1]]);
+            }
+            HeCap { mac: HE_MAC, phy, mcs, ppe: Vec::new() }
+        };
+        let band = |id: BandId| Band { id, channels: chan::default_channels(id), ht: Some(ht), vht: (id == BandId::Ghz5).then_some(vht), he: Some(he(id)) };
+        Info {
+            driver: String::from("mt7925"),
+            address: self.address,
+            bands: vec![band(BandId::Ghz2), band(BandId::Ghz5)],
+            ciphers: vec![radio::CIPHER_CCMP, radio::CIPHER_GCMP, radio::CIPHER_GCMP_256, radio::CIPHER_CCMP_256],
+            max_scan_ssids: 10,
+            max_scan_ie_len: 600,
+            ap: true,
+        }
+    }
+}
