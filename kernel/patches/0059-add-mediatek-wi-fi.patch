--- /dev/null
+++ b/kernel/comps/mt7921/NOTICE
@@ -0,0 +1,24 @@
+aster-mt7921 is a Rust port of parts of Linux's mt76 driver
+(drivers/net/wireless/mediatek/mt76: mt7921, mt792x and mt76_connac, Linux
+6.18): the WFDMA rings, the firmware download, the MCU commands' sequence,
+layouts and constants, and the TX/RX descriptors. Linux licenses those files
+under the ISC licence, reproduced below. The port's own code is under the
+MPL-2.0, like the rest of this kernel.
+
+Copyright (C) 2020 MediaTek Inc.
+
+Permission to use, copy, modify, and/or distribute this software for any
+purpose with or without fee is hereby granted, provided that the above
+copyright notice and this permission notice appear in all copies.
+
+THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES
+WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
+MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR
+ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
+WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN
+ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF
+OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+
+The firmware the driver loads (mediatek/WIFI_*.bin) is MediaTek's, from
+linux-firmware, redistributed under its LICENCE.mediatek, which the image
+ships beside the files.
diff --git a/kernel/comps/mt7921/src/hw.rs b/kernel/comps/mt7921/src/hw.rs
new file mode 100644
index 0000000..1a2f874
--- /dev/null
+++ b/kernel/comps/mt7921/src/hw.rs
@@ -0,0 +1,731 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The chip as Linux's mt76 drives it over PCIe (`mt7921/pci.c`,
+//! `mt792x_dma.c`, `mt76_connac_mcu.c`): the chip's addresses through the
+//! bus window, the WFDMA rings, the MCU's messages and the firmware's
+//! download (ROM patch, then RAM).
+
+use alloc::{format, string::String, vec, vec::Vec};
+
+use aster_pci::cfg_space::BarAccess;
+use ostd::mm::{HasDaddr, PAGE_SIZE, VmIo, dma::DmaCoherent};
+
+// The WFDMA's registers (bus offsets).
+pub(crate) const HOST_INT_STA: u32 = 0xd4200;
+pub(crate) const HOST_INT_ENA: u32 = 0xd4204;
+const GLO_CFG: u32 = 0xd4208;
+const RST_DTX_PTR: u32 = 0xd420c;
+const PRI_DLY_INT_CFG0: u32 = 0xd42f0;
+const GLO_CFG_EXT0: u32 = 0xd42b0;
+const WFDMA0_RST: u32 = 0xd4100;
+const TX_RING_BASE: u32 = 0xd4300;
+const RX_RING_BASE: u32 = 0xd4500;
+const TX_EXT_CTRL: u32 = 0xd4600;
+const RX_EXT_CTRL: u32 = 0xd4680;
+pub(crate) const MCU_CMD: u32 = 0xd41f0;
+const MCU2HOST_SW_INT_ENA: u32 = 0xd41f4;
+const PCIE_MAC_INT_ENABLE: u32 = 0x10188;
+const HIF_REMAP_L1: u32 = 0xfe24c;
+const HIF_REMAP_BASE_L1: u32 = 0x40000;
+// The chip's own addresses.
+const CONN_ON_LPCTL: u32 = 0x7c06_0010;
+const CONN_ON_MISC: u32 = 0x7c06_00f0;
+const HW_CHIPID: u32 = 0x7001_0200;
+const HW_REV: u32 = 0x7001_0204;
+const WFSYS_RESET: u32 = 0x1800_0140;
+const WFDMA_DUMMY_CR: u32 = 0x5400_0120;
+const DMASHDL_SW_CONTROL: u32 = 0x7c02_6004;
+const SWDEF_MODE: u32 = 0x0041_f23c;
+const SWDEF_NORMAL_MODE: u32 = 0;
+const PCIE_MAC_PM: u32 = 0x10194;
+const PCIE_MAC_PM_L0S_DIS: u32 = 1 << 8;
+// The MAC (`mt7921/regs.h`, `mt792x_regs.h`), per band where it has two.
+const MDP_DCR0: u32 = 0x820c_d000;
+const MDP_DCR0_DAMSDU_EN: u32 = 1 << 15;
+const MDP_DCR1: u32 = 0x820c_d004;
+const MDP_DCR1_MAX_RX_LEN: u32 = 0xfff8;
+const TMAC_CTCR0: [u32; 2] = [0x820e_40f4, 0x820f_40f4];
+const TMAC_CTCR0_INS_DDLMT_REFTIME: u32 = 0x3f;
+const TMAC_CTCR0_INS_DDLMT_EN: u32 = 1 << 17;
+const TMAC_CTCR0_INS_DDLMT_VHT_SMPDU_EN: u32 = 1 << 18;
+const DMA_DCR0: [u32; 2] = [0x820e_7000, 0x820f_7000];
+const DMA_DCR0_MAX_RX_LEN: u32 = 0xfff8;
+const DMA_DCR0_RXD_G5_EN: u32 = 1 << 23;
+const WTBLOFF_TOP_RSCR: [u32; 2] = [0x820e_9008, 0x820f_9008];
+const WTBLOFF_TOP_RSCR_RCPI_MODE: u32 = 0xc000_0000;
+const WTBLOFF_TOP_RSCR_RCPI_PARAM: u32 = 0x0300_0000;
+
+const GLO_TX_DMA_EN: u32 = 1 << 0;
+const GLO_TX_DMA_BUSY: u32 = 1 << 1;
+const GLO_RX_DMA_EN: u32 = 1 << 2;
+const GLO_RX_DMA_BUSY: u32 = 1 << 3;
+const GLO_TX_WB_DDONE: u32 = 1 << 6;
+const GLO_FIFO_DIS_CHECK: u32 = 1 << 11;
+const GLO_FIFO_LITTLE_ENDIAN: u32 = 1 << 12;
+const GLO_RX_WB_DDONE: u32 = 1 << 13;
+const GLO_CSR_DISP_BASE_PTR_CHAIN_EN: u32 = 1 << 15;
+const GLO_OMIT_RX_INFO_PFET2: u32 = 1 << 21;
+const GLO_OMIT_RX_INFO: u32 = 1 << 27;
+const GLO_OMIT_TX_INFO: u32 = 1 << 28;
+const GLO_CLK_GAT_DIS: u32 = 1 << 30;
+const GLO_DMA_SIZE_3: u32 = 3 << 4;
+
+pub(crate) const INT_RX_DONE_WM: u32 = 1 << 0;
+pub(crate) const INT_RX_DONE_DATA: u32 = 1 << 2;
+pub(crate) const INT_RX_DONE_WM2: u32 = 1 << 22;
+pub(crate) const INT_TX_DONE_ALL: u32 = 0x0807_fff0;
+pub(crate) const INT_MCU_CMD: u32 = 1 << 29;
+
+const DMA_CTL_SD_LEN0_SHIFT: u32 = 16;
+const DMA_CTL_LAST_SEC0: u32 = 1 << 30;
+const DMA_CTL_DMA_DONE: u32 = 1 << 31;
+
+/// The rings: data and the MCU's commands and firmware out; the MCU's
+/// events, data, and the MCU's events after the firmware runs, in.
+pub(crate) const TXQ_DATA: u32 = 0;
+pub(crate) const TXQ_FWDL: u32 = 16;
+pub(crate) const TXQ_MCU: u32 = 17;
+pub(crate) const RXQ_MCU: u32 = 0;
+pub(crate) const RXQ_DATA: u32 = 2;
+pub(crate) const RXQ_MCU_WA: u32 = 4;
+
+/// The size of a ring's buffers: a page, so that a frame is never split.
+pub(crate) const BUFFER: usize = PAGE_SIZE;
+
+// MCU commands (`mt76_connac_mcu.h`).
+const MCU_CMD_TARGET_ADDRESS_LEN_REQ: u8 = 0x01;
+const MCU_CMD_FW_START_REQ: u8 = 0x02;
+const MCU_CMD_PATCH_START_REQ: u8 = 0x05;
+const MCU_CMD_PATCH_FINISH_REQ: u8 = 0x07;
+const MCU_CMD_PATCH_SEM_CONTROL: u8 = 0x10;
+const MCU_CMD_EXT_CID: u8 = 0xed;
+const MCU_PKT_ID: u8 = 0xa0;
+const MCU_Q_QUERY: u8 = 0;
+const MCU_Q_SET: u8 = 1;
+const MCU_Q_NA: u8 = 3;
+const MCU_CMD_UNI_EXT_ACK: u8 = 0x07;
+const MCU_PQ_ID: u16 = 0x8000;
+const MT_TX_TYPE_CMD: u32 = 2;
+const MT_TX_MCU_PORT_RX_Q0: u32 = 0x20;
+const MT_HDR_FORMAT_CMD: u32 = 1;
+const TXD1_LONG_FORMAT: u32 = 1 << 31;
+/// An MCU event's header (`struct mt76_connac2_mcu_rxd`).
+pub(crate) const MCU_RXD: usize = 36;
+const PATCH_SEM_RELEASE: u32 = 0;
+const PATCH_SEM_GET: u32 = 1;
+const PATCH_IS_DL: u8 = 1;
+const PATCH_NOT_DL_SEM_SUCCESS: u8 = 2;
+const PATCH_SEC_TYPE_INFO: u32 = 2;
+const PATCH_SEC_NOT_SUPPORT: u32 = 0xffff_ffff;
+const DL_MODE_ENCRYPT: u32 = 1 << 0;
+const DL_MODE_RESET_SEC_IV: u32 = 1 << 3;
+const DL_CONFIG_ENCRY_MODE_SEL: u32 = 1 << 6;
+const DL_MODE_NEED_RSP: u32 = 1 << 31;
+const FW_FEATURE_SET_ENCRYPT: u8 = 1 << 0;
+const FW_FEATURE_ENCRY_MODE: u8 = 1 << 4;
+const FW_FEATURE_OVERRIDE_ADDR: u8 = 1 << 5;
+const FW_FEATURE_NON_DL: u8 = 1 << 6;
+const FW_START_OVERRIDE: u32 = 1 << 0;
+const SCATTER: usize = 4096;
+const MCU_TIMEOUT_MS: u64 = 3_000;
+
+/// How an MCU command is addressed (Linux's `MCU_CMD`, `MCU_CE_CMD`,
+/// `MCU_CE_QUERY`, `MCU_EXT_CMD` and `MCU_UNI_CMD`).
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum Cmd {
+    Legacy(u8),
+    Ce(u8),
+    CeQuery(u8),
+    Ext(u8),
+    Uni(u16),
+}
+
+/// DMA memory the WFDMA can address: its pointers are 32 bits, so the
+/// memory must lie below 4 GiB. Asked for again until it does (ostd has no
+/// 32-bit zone; early in the boot low memory is free).
+pub(crate) use aster_linuxkpi::dma::alloc_coherent32 as dma32;
+
+/// A WFDMA ring: descriptors (`struct mt76_desc`: buf0, ctrl, buf1, info)
+/// and a buffer each.
+pub(crate) struct Ring {
+    regs: u32,
+    descs: DmaCoherent,
+    pub(crate) buffers: DmaCoherent,
+    pub(crate) size: usize,
+    /// TX: the next slot to fill; RX: the next slot to read.
+    head: usize,
+    /// TX: the first slot the DMA has not finished.
+    tail: usize,
+}
+
+impl Ring {
+    pub(crate) fn buffer_address(&self, slot: usize) -> u32 {
+        (self.buffers.daddr() + slot * BUFFER) as u32
+    }
+}
+
+pub(crate) struct Chip {
+    mmio: BarAccess,
+    pub(crate) name: String,
+    pub(crate) chip_id: u32,
+    pub(crate) rev: u32,
+    pub(crate) tx_data: Option<Ring>,
+    tx_mcu: Option<Ring>,
+    tx_fwdl: Option<Ring>,
+    rx_mcu: Option<Ring>,
+    pub(crate) rx_data: Option<Ring>,
+    rx_mcu_wa: Option<Ring>,
+    seq: u8,
+    /// Packets read from the MCU's rings while a command waited.
+    pub(crate) pending: Vec<Vec<u8>>,
+}
+
+impl Chip {
+    pub(crate) fn new(mmio: BarAccess, name: String) -> Self {
+        Self {
+            mmio,
+            name,
+            chip_id: 0,
+            rev: 0,
+            tx_data: None,
+            tx_mcu: None,
+            tx_fwdl: None,
+            rx_mcu: None,
+            rx_data: None,
+            rx_mcu_wa: None,
+            seq: 0,
+            pending: Vec::new(),
+        }
+    }
+
+    // ---- Registers. ----
+
+    /// A chip address as a bus offset: the low megabyte as it is, the fixed
+    /// windows of Linux's `__mt7921_reg_addr`, the rest through the L1
+    /// window.
+    fn map(&self, addr: u32) -> u32 {
+        const FIXED: [(u32, u32, u32); 45] = [
+            (0x820d_0000, 0x30000, 0x10000),
+            (0x820e_d000, 0x24800, 0x00800),
+            (0x820e_4000, 0x21000, 0x00400),
+            (0x820e_7000, 0x21e00, 0x00200),
+            (0x820e_b000, 0x24200, 0x00400),
+            (0x820e_2000, 0x20800, 0x00400),
+            (0x820e_3000, 0x20c00, 0x00400),
+            (0x820e_5000, 0x21400, 0x00800),
+            (0x0040_0000, 0x80000, 0x10000),
+            (0x0041_0000, 0x90000, 0x10000),
+            (0x4000_0000, 0x70000, 0x10000),
+            (0x5400_0000, 0x02000, 0x01000),
+            (0x5500_0000, 0x03000, 0x01000),
+            (0x5800_0000, 0x06000, 0x01000),
+            (0x5900_0000, 0x07000, 0x01000),
+            (0x7c00_0000, 0xf0000, 0x10000),
+            (0x7c02_0000, 0xd0000, 0x10000),
+            (0x7c06_0000, 0xe0000, 0x10000),
+            (0x8002_0000, 0xb0000, 0x10000),
+            (0x8102_0000, 0xc0000, 0x10000),
+            (0x820c_0000, 0x08000, 0x04000),
+            (0x820c_8000, 0x0c000, 0x02000),
+            (0x820c_c000, 0x0e000, 0x01000),
+            (0x820c_d000, 0x0f000, 0x01000),
+            (0x7403_0000, 0x10000, 0x10000),
+            (0x820c_e000, 0x21c00, 0x00200),
+            (0x820c_f000, 0x22000, 0x01000),
+            (0x820e_0000, 0x20000, 0x00400),
+            (0x820e_1000, 0x20400, 0x00200),
+            (0x820e_9000, 0x23400, 0x00200),
+            (0x820e_a000, 0x24000, 0x00200),
+            (0x820e_c000, 0x24600, 0x00200),
+            (0x820f_0000, 0xa0000, 0x00400),
+            (0x820f_1000, 0xa0600, 0x00200),
+            (0x820f_2000, 0xa0800, 0x00400),
+            (0x820f_3000, 0xa0c00, 0x00400),
+            (0x820f_4000, 0xa1000, 0x00400),
+            (0x820f_5000, 0xa1400, 0x00800),
+            (0x820f_7000, 0xa1e00, 0x00200),
+            (0x820f_9000, 0xa3400, 0x00200),
+            (0x820f_a000, 0xa4000, 0x00200),
+            (0x820f_b000, 0xa4200, 0x00400),
+            (0x820f_c000, 0xa4600, 0x00200),
+            (0x820f_d000, 0xa4800, 0x00800),
+            (0x7c06_0000, 0xe0000, 0x10000),
+        ];
+        if addr < 0x10_0000 {
+            return addr;
+        }
+        for (phys, maps, size) in FIXED {
+            if addr >= phys && addr - phys < size {
+                return maps + (addr - phys);
+            }
+        }
+        if (0x1800_0000..0x18c0_0000).contains(&addr) || (0x7000_0000..0x7800_0000).contains(&addr) || (0x7c00_0000..0x7c40_0000).contains(&addr) {
+            self.raw_write(HIF_REMAP_L1, (self.raw_read(HIF_REMAP_L1) & !0xffff) | (addr >> 16));
+            let _ = self.raw_read(HIF_REMAP_L1);
+            return HIF_REMAP_BASE_L1 + (addr & 0xffff);
+        }
+        ostd::warn!("{}: no window for chip address {:#x}", self.name, addr);
+        0
+    }
+
+    fn raw_read(&self, offset: u32) -> u32 {
+        self.mmio.read_once::<u32>(offset as usize).unwrap_or(u32::MAX)
+    }
+
+    fn raw_write(&self, offset: u32, value: u32) {
+        let _ = self.mmio.write_once::<u32>(offset as usize, value);
+    }
+
+    pub(crate) fn rr(&self, addr: u32) -> u32 {
+        self.raw_read(self.map(addr))
+    }
+
+    pub(crate) fn wr(&self, addr: u32, value: u32) {
+        self.raw_write(self.map(addr), value);
+    }
+
+    fn set(&self, addr: u32, bits: u32) {
+        self.wr(addr, self.rr(addr) | bits);
+    }
+
+    fn clear(&self, addr: u32, bits: u32) {
+        self.wr(addr, self.rr(addr) & !bits);
+    }
+
+    fn poll(&self, addr: u32, mask: u32, value: u32, timeout_ms: u64) -> bool {
+        let deadline = crate::now_ms() + timeout_ms;
+        loop {
+            if self.rr(addr) & mask == value {
+                return true;
+            }
+            if crate::now_ms() >= deadline {
+                return false;
+            }
+            crate::delay_ms(1);
+        }
+    }
+
+    // ---- The chip's start. ----
+
+    /// Ownership to the firmware and back to the driver (Linux's
+    /// `mt792xe_mcu_fw_pmctrl`, `__mt792xe_mcu_drv_pmctrl`), the chip's
+    /// identity, and the Wi-Fi system's reset.
+    pub(crate) fn start(&mut self) -> Result<(), String> {
+        for _ in 0..10 {
+            self.wr(CONN_ON_LPCTL, 1);
+            if self.poll(CONN_ON_LPCTL, 4, 4, 50) {
+                break;
+            }
+        }
+        let mut owned = false;
+        for _ in 0..10 {
+            self.wr(CONN_ON_LPCTL, 2);
+            if self.poll(CONN_ON_LPCTL, 4, 0, 50) {
+                owned = true;
+                break;
+            }
+        }
+        if !owned {
+            return Err(String::from("the chip did not give the driver its ownership"));
+        }
+        self.chip_id = self.rr(HW_CHIPID) & 0xffff;
+        self.rev = self.rr(HW_REV) & 0xff;
+        if self.chip_id == 0x7961 && self.rr(0x7001_0020) & (1 << 7) != 0 {
+            self.chip_id = 0x7920;
+        }
+        // The Wi-Fi system's reset.
+        self.clear(WFSYS_RESET, 1);
+        crate::delay_ms(50);
+        self.set(WFSYS_RESET, 1);
+        if !self.poll(WFSYS_RESET, 0x10, 0x10, 500) {
+            return Err(String::from("the Wi-Fi system did not come out of reset"));
+        }
+        self.wr(HOST_INT_ENA, 0);
+        self.wr(PCIE_MAC_INT_ENABLE, 0xff);
+        self.dma_init()
+    }
+
+    fn new_ring(&self, regs: u32, size: usize, rx: bool) -> Result<Ring, String> {
+        let descs = dma32(size * 16).ok_or_else(|| String::from("no DMA memory below 4 GiB"))?;
+        let buffers = dma32(size * BUFFER).ok_or_else(|| String::from("no DMA memory below 4 GiB"))?;
+        let mut ring = Ring { regs, descs, buffers, size, head: 0, tail: 0 };
+        for slot in 0..size {
+            let ctrl = if rx { (BUFFER as u32) << DMA_CTL_SD_LEN0_SHIFT } else { DMA_CTL_DMA_DONE };
+            let address = if rx { ring.buffer_address(slot) } else { 0 };
+            let desc: [u32; 4] = [address, ctrl, 0, 0];
+            for (index, word) in desc.iter().enumerate() {
+                let _ = ring.descs.write_val(slot * 16 + index * 4, word);
+            }
+        }
+        self.wr(regs, ring.descs.daddr() as u32);
+        self.wr(regs + 4, size as u32);
+        if rx {
+            // Every slot but one is the chip's to fill.
+            ring.head = 0;
+            self.wr(regs + 8, (size - 1) as u32);
+        } else {
+            self.wr(regs + 8, 0);
+            let index = self.rr(regs + 12) as usize % size;
+            ring.head = index;
+            ring.tail = index;
+            self.wr(regs + 8, index as u32);
+        }
+        Ok(ring)
+    }
+
+    /// Linux's `mt7921_dma_init`: the WFDMA stopped, its rings, then
+    /// started again (`mt792x_dma_enable`).
+    fn dma_init(&mut self) -> Result<(), String> {
+        self.clear(
+            GLO_CFG,
+            GLO_TX_DMA_EN | GLO_RX_DMA_EN | GLO_CSR_DISP_BASE_PTR_CHAIN_EN | GLO_OMIT_TX_INFO | GLO_OMIT_RX_INFO | GLO_OMIT_RX_INFO_PFET2,
+        );
+        if !self.poll(GLO_CFG, GLO_TX_DMA_BUSY | GLO_RX_DMA_BUSY, 0, 100) {
+            return Err(String::from("the DMA did not stop"));
+        }
+        self.clear(GLO_CFG_EXT0, 1 << 6);
+        self.set(DMASHDL_SW_CONTROL, 1 << 28);
+        self.clear(WFDMA0_RST, 0x30);
+        self.set(WFDMA0_RST, 0x30);
+        self.tx_data = Some(self.new_ring(TX_RING_BASE + TXQ_DATA * 16, 256, false)?);
+        self.wr(TX_EXT_CTRL, 0x4);
+        self.tx_mcu = Some(self.new_ring(TX_RING_BASE + TXQ_MCU * 16, 64, false)?);
+        self.tx_fwdl = Some(self.new_ring(TX_RING_BASE + TXQ_FWDL * 16, 64, false)?);
+        self.rx_mcu = Some(self.new_ring(RX_RING_BASE + RXQ_MCU * 16, 32, true)?);
+        self.rx_mcu_wa = Some(self.new_ring(RX_RING_BASE + RXQ_MCU_WA * 16, 32, true)?);
+        self.rx_data = Some(self.new_ring(RX_RING_BASE + RXQ_DATA * 16, 256, true)?);
+        // Prefetch: each ring's place and depth in the WFDMA's SRAM.
+        let prefetch = |base: u32, depth: u32| (base << 16) | depth;
+        for (ring, base) in [(0u32, 0x0), (2, 0x40), (3, 0x80), (4, 0xc0), (5, 0x100)] {
+            self.wr(RX_EXT_CTRL + ring * 4, prefetch(base, 4));
+        }
+        for (ring, base) in [(0u32, 0x140), (1, 0x180), (2, 0x1c0), (3, 0x200), (4, 0x240), (5, 0x280), (6, 0x2c0), (16, 0x340), (17, 0x380)] {
+            self.wr(TX_EXT_CTRL + ring * 4, prefetch(base, 4));
+        }
+        self.wr(RST_DTX_PTR, !0);
+        self.wr(PRI_DLY_INT_CFG0, 0);
+        self.set(
+            GLO_CFG,
+            GLO_TX_WB_DDONE | GLO_FIFO_LITTLE_ENDIAN | GLO_CLK_GAT_DIS | GLO_OMIT_TX_INFO | GLO_DMA_SIZE_3 | GLO_FIFO_DIS_CHECK | GLO_RX_WB_DDONE | GLO_CSR_DISP_BASE_PTR_CHAIN_EN | GLO_OMIT_RX_INFO_PFET2,
+        );
+        self.set(GLO_CFG, GLO_TX_DMA_EN | GLO_RX_DMA_EN);
+        self.set(WFDMA_DUMMY_CR, 1 << 1);
+        self.wr(HOST_INT_ENA, INT_TX_DONE_ALL | INT_RX_DONE_DATA | INT_RX_DONE_WM | INT_RX_DONE_WM2 | INT_MCU_CMD);
+        self.set(MCU2HOST_SW_INT_ENA, 1);
+        Ok(())
+    }
+
+    /// Before the firmware's download (`__mt7921_init_hardware`,
+    /// `mt7921e_mcu_init`): its normal mode, and no L0s on the link.
+    pub(crate) fn before_firmware(&self) {
+        self.wr(SWDEF_MODE, SWDEF_NORMAL_MODE);
+        self.set(PCIE_MAC_PM, PCIE_MAC_PM_L0S_DIS);
+    }
+
+    /// Linux's `mt7921_mac_init` and `mt792x_mac_init_band`: frames up to
+    /// 1536 bytes, A-MSDUs split by the chip, the RXD's group 5 off, the
+    /// signal of each frame. Header translation stays off (frames come as
+    /// 802.11).
+    pub(crate) fn mac_init(&self) {
+        let field = |addr: u32, mask: u32, value: u32| self.wr(addr, (self.rr(addr) & !mask) | ((value << mask.trailing_zeros()) & mask));
+        field(MDP_DCR1, MDP_DCR1_MAX_RX_LEN, 1536);
+        self.set(MDP_DCR0, MDP_DCR0_DAMSDU_EN);
+        for band in 0..2 {
+            let ctcr0 = TMAC_CTCR0[band];
+            field(ctcr0, TMAC_CTCR0_INS_DDLMT_REFTIME, 0x3f);
+            self.set(ctcr0, TMAC_CTCR0_INS_DDLMT_VHT_SMPDU_EN | TMAC_CTCR0_INS_DDLMT_EN);
+            field(DMA_DCR0[band], DMA_DCR0_MAX_RX_LEN, 1536);
+            self.clear(DMA_DCR0[band], DMA_DCR0_RXD_G5_EN);
+            field(WTBLOFF_TOP_RSCR[band], WTBLOFF_TOP_RSCR_RCPI_MODE, 0);
+            field(WTBLOFF_TOP_RSCR[band], WTBLOFF_TOP_RSCR_RCPI_PARAM, 3);
+        }
+    }
+
+    // ---- Rings. ----
+
+    /// Queues one buffer of `bytes` on a TX ring. Err: full.
+    fn ring_send(&mut self, which: u32, bytes: &[u8]) -> Result<(), ()> {
+        if bytes.len() > BUFFER {
+            return Err(());
+        }
+        // What the DMA finished (the rings' registers are in the low
+        // megabyte: no window).
+        let regs = match which {
+            TXQ_MCU => self.tx_mcu.as_ref(),
+            TXQ_FWDL => self.tx_fwdl.as_ref(),
+            _ => self.tx_data.as_ref(),
+        }
+        .ok_or(())?
+        .regs;
+        let dma_index = self.raw_read(regs + 12) as usize;
+        let ring = match which {
+            TXQ_MCU => self.tx_mcu.as_mut(),
+            TXQ_FWDL => self.tx_fwdl.as_mut(),
+            _ => self.tx_data.as_mut(),
+        }
+        .ok_or(())?;
+        ring.tail = dma_index % ring.size;
+        if (ring.head + 1) % ring.size == ring.tail {
+            return Err(());
+        }
+        let slot = ring.head;
+        ring.buffers.write_bytes(slot * BUFFER, bytes).map_err(|_| ())?;
+        let desc: [u32; 4] = [ring.buffer_address(slot), ((bytes.len() as u32) << DMA_CTL_SD_LEN0_SHIFT) | DMA_CTL_LAST_SEC0, 0, 0];
+        for (index, word) in desc.iter().enumerate() {
+            ring.descs.write_val(slot * 16 + index * 4, word).map_err(|_| ())?;
+        }
+        ring.head = (ring.head + 1) % ring.size;
+        let (regs, head) = (ring.regs, ring.head);
+        self.wr(regs + 8, head as u32);
+        Ok(())
+    }
+
+    /// Waits until a TX ring has room.
+    fn ring_wait(&mut self, which: u32) -> bool {
+        let deadline = crate::now_ms() + MCU_TIMEOUT_MS;
+        loop {
+            let full = {
+                let ring = match which {
+                    TXQ_MCU => self.tx_mcu.as_ref(),
+                    TXQ_FWDL => self.tx_fwdl.as_ref(),
+                    _ => self.tx_data.as_ref(),
+                };
+                let Some(ring) = ring else { return false };
+                let tail = self.rr(ring.regs + 12) as usize % ring.size;
+                (ring.head + 1) % ring.size == tail
+            };
+            if !full {
+                return true;
+            }
+            if crate::now_ms() >= deadline {
+                return false;
+            }
+            crate::delay_ms(1);
+        }
+    }
+
+    /// Sends a frame (TXD, TXP and frame in one buffer) on the data ring:
+    /// only the TXD and TXP go in the descriptor; the chip fetches the
+    /// frame through the TXP. `slot`: where the caller put the bytes.
+    pub(crate) fn data_send(&mut self, txwi: &[u8]) -> Result<(), ()> {
+        self.ring_send(TXQ_DATA, txwi)
+    }
+
+    /// The packets the chip wrote to an RX ring since the last call.
+    pub(crate) fn ring_receive(&mut self, which: u32) -> Vec<Vec<u8>> {
+        let mut out = Vec::new();
+        let ring = match which {
+            RXQ_MCU => self.rx_mcu.as_mut(),
+            RXQ_MCU_WA => self.rx_mcu_wa.as_mut(),
+            _ => self.rx_data.as_mut(),
+        };
+        let Some(ring) = ring else { return out };
+        let mut last = None;
+        for _ in 0..ring.size {
+            let slot = ring.head;
+            let ctrl: u32 = ring.descs.read_val(slot * 16 + 4).unwrap_or(0);
+            if ctrl & DMA_CTL_DMA_DONE == 0 {
+                break;
+            }
+            let length = ((ctrl >> DMA_CTL_SD_LEN0_SHIFT) & 0x3fff) as usize;
+            if ctrl & DMA_CTL_LAST_SEC0 != 0 && length > 0 && length <= BUFFER {
+                let mut bytes = vec![0u8; length];
+                let _ = ring.buffers.read_bytes(slot * BUFFER, &mut bytes);
+                out.push(bytes);
+            }
+            let fresh = (BUFFER as u32) << DMA_CTL_SD_LEN0_SHIFT;
+            let _ = ring.descs.write_val(slot * 16 + 4, &fresh);
+            last = Some(slot);
+            ring.head = (ring.head + 1) % ring.size;
+        }
+        if let Some(slot) = last {
+            let regs = ring.regs;
+            self.wr(regs + 8, slot as u32);
+        }
+        out
+    }
+
+    // ---- The MCU. ----
+
+    /// Sends an MCU command; with `wait`, its answer's payload (after the
+    /// event header; for the patch semaphore, the status byte first).
+    pub(crate) fn mcu(&mut self, cmd: Cmd, payload: &[u8], wait: bool) -> Result<Vec<u8>, String> {
+        self.seq = (self.seq % 15) + 1;
+        let seq = self.seq;
+        let mut out = Vec::with_capacity(64 + payload.len());
+        let uni = matches!(cmd, Cmd::Uni(_));
+        let header = if uni { 48 } else { 64 };
+        let total = header + payload.len();
+        let txd0 = (total as u32 & 0xffff) | (MT_TX_TYPE_CMD << 23) | (MT_TX_MCU_PORT_RX_Q0 << 25);
+        let txd1 = TXD1_LONG_FORMAT | (MT_HDR_FORMAT_CMD << 16);
+        out.extend_from_slice(&txd0.to_le_bytes());
+        out.extend_from_slice(&txd1.to_le_bytes());
+        out.resize(32, 0);
+        let length = (total - 32) as u16;
+        match cmd {
+            Cmd::Uni(id) => {
+                out.extend_from_slice(&length.to_le_bytes());
+                out.extend_from_slice(&id.to_le_bytes());
+                out.extend_from_slice(&[0, MCU_PKT_ID, 0, seq]);
+                out.extend_from_slice(&[0, 0, 0, MCU_CMD_UNI_EXT_ACK]);
+                out.extend_from_slice(&[0; 4]);
+            }
+            _ => {
+                let (cid, ext, query, ack) = match cmd {
+                    Cmd::Legacy(id) => (id, 0, MCU_Q_NA, 0),
+                    Cmd::Ce(id) => (id, 0, MCU_Q_SET, 0),
+                    Cmd::CeQuery(id) => (id, 0, MCU_Q_QUERY, 0),
+                    Cmd::Ext(id) => (MCU_CMD_EXT_CID, id, MCU_Q_SET, 1),
+                    Cmd::Uni(_) => unreachable!(),
+                };
+                out.extend_from_slice(&length.to_le_bytes());
+                out.extend_from_slice(&MCU_PQ_ID.to_le_bytes());
+                out.extend_from_slice(&[cid, MCU_PKT_ID, query, seq, 0, ext, 0, ack]);
+                out.extend_from_slice(&[0; 20]);
+            }
+        }
+        out.extend_from_slice(payload);
+        if !self.ring_wait(TXQ_MCU) {
+            return Err(format!("the MCU's command ring is full ({cmd:?})"));
+        }
+        self.ring_send(TXQ_MCU, &out).map_err(|()| format!("command {cmd:?} not queued"))?;
+        if !wait {
+            return Ok(Vec::new());
+        }
+        let deadline = crate::now_ms() + MCU_TIMEOUT_MS;
+        let waiting = crate::WAKER.waiting();
+        let result = loop {
+            let mut found = None;
+            for which in [RXQ_MCU, RXQ_MCU_WA, RXQ_DATA] {
+                for packet in self.ring_receive(which) {
+                    // An event (type 7) that is not a frame through the MCU
+                    // (flag 1), answering this command.
+                    let rxd0 = u32::from_le_bytes([packet[0], packet[1], packet[2], packet[3]]);
+                    let is_event = packet.len() >= MCU_RXD && rxd0 >> 27 == 7 && (rxd0 >> 16) & 0xf != 1;
+                    if found.is_none() && is_event && packet[29] == seq {
+                        found = Some(packet);
+                    } else {
+                        self.pending.push(packet);
+                    }
+                }
+            }
+            if let Some(packet) = found {
+                break Ok(packet);
+            }
+            if crate::now_ms() >= deadline {
+                break Err(format!("no answer to MCU command {cmd:?}"));
+            }
+            crate::sleep();
+        };
+        drop(waiting);
+        let packet = result?;
+        let skip = if matches!(cmd, Cmd::Legacy(MCU_CMD_PATCH_SEM_CONTROL) | Cmd::Legacy(MCU_CMD_PATCH_FINISH_REQ)) { MCU_RXD - 4 } else { MCU_RXD };
+        Ok(packet.get(skip..).unwrap_or(&[]).to_vec())
+    }
+
+    /// Sends firmware bytes raw on the download ring, in pieces.
+    fn scatter(&mut self, data: &[u8]) -> Result<(), String> {
+        for piece in data.chunks(SCATTER) {
+            if !self.ring_wait(TXQ_FWDL) {
+                return Err(String::from("the firmware's download ring did not drain"));
+            }
+            self.ring_send(TXQ_FWDL, piece).map_err(|()| String::from("a firmware piece did not fit"))?;
+        }
+        Ok(())
+    }
+
+    fn init_download(&mut self, addr: u32, len: u32, mode: u32) -> Result<(), String> {
+        let id = if matches!(addr, 0x0020_0000 | 0x0090_0000 | 0xe000_2800) { MCU_CMD_PATCH_START_REQ } else { MCU_CMD_TARGET_ADDRESS_LEN_REQ };
+        let mut payload = Vec::with_capacity(12);
+        for value in [addr, len, mode] {
+            payload.extend_from_slice(&value.to_le_bytes());
+        }
+        self.mcu(Cmd::Legacy(id), &payload, true).map(|_| ())
+    }
+
+    /// The ROM patch (Linux's `mt76_connac2_load_patch`).
+    pub(crate) fn load_patch(&mut self, file: &[u8]) -> Result<(), String> {
+        let status = self.mcu(Cmd::Legacy(MCU_CMD_PATCH_SEM_CONTROL), &PATCH_SEM_GET.to_le_bytes(), true)?;
+        match status.first().copied() {
+            Some(PATCH_IS_DL) => return Ok(()),
+            Some(PATCH_NOT_DL_SEM_SUCCESS) => {}
+            other => return Err(format!("the patch semaphore said {other:?}")),
+        }
+        let be = |at: usize| file.get(at..at + 4).map_or(0, |b| u32::from_be_bytes([b[0], b[1], b[2], b[3]]));
+        let regions = be(44) as usize;
+        let mut result = Ok(());
+        for index in 0..regions.min(16) {
+            let at = 96 + index * 64;
+            if be(at) & 0xffff != PATCH_SEC_TYPE_INFO {
+                result = Err(String::from("a patch section of an unknown kind"));
+                break;
+            }
+            let (offset, addr, len, info) = (be(at + 4) as usize, be(at + 12), be(at + 16), be(at + 20));
+            let mut mode = DL_MODE_NEED_RSP;
+            if info != PATCH_SEC_NOT_SUPPORT {
+                match info >> 24 {
+                    1 => mode |= DL_MODE_ENCRYPT | (((info & 0xff) << 1) & 0x6) | DL_MODE_RESET_SEC_IV,
+                    2 => mode |= DL_MODE_ENCRYPT | DL_CONFIG_ENCRY_MODE_SEL | DL_MODE_RESET_SEC_IV,
+                    _ => {}
+                }
+            }
+            let Some(data) = file.get(offset..offset + len as usize) else {
+                result = Err(String::from("a patch section beyond the file"));
+                break;
+            };
+            if let Err(error) = self.init_download(addr, len, mode).and_then(|()| self.scatter(data)) {
+                result = Err(error);
+                break;
+            }
+        }
+        if result.is_ok() {
+            result = self.mcu(Cmd::Legacy(MCU_CMD_PATCH_FINISH_REQ), &[0, 0, 0, 0], true).map(|_| ());
+        }
+        let _ = self.mcu(Cmd::Legacy(MCU_CMD_PATCH_SEM_CONTROL), &PATCH_SEM_RELEASE.to_le_bytes(), true);
+        result
+    }
+
+    /// The RAM code (Linux's `mt76_connac_mcu_send_ram_firmware`): its
+    /// regions are described before the trailer at the file's end.
+    pub(crate) fn load_ram(&mut self, file: &[u8]) -> Result<(), String> {
+        const TRAILER: usize = 36;
+        const REGION: usize = 40;
+        if file.len() < TRAILER {
+            return Err(String::from("the RAM code is too short"));
+        }
+        let trailer = file.len() - TRAILER;
+        let regions = file[trailer + 2] as usize;
+        let le = |at: usize| file.get(at..at + 4).map_or(0, |b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]));
+        let (mut offset, mut override_addr) = (0usize, 0u32);
+        for index in 0..regions {
+            let at = trailer.checked_sub((regions - index) * REGION).ok_or_else(|| String::from("RAM regions beyond the file"))?;
+            let (addr, len, features) = (le(at + 16), le(at + 20) as usize, file[at + 24]);
+            if features & FW_FEATURE_NON_DL == 0 {
+                if features & FW_FEATURE_OVERRIDE_ADDR != 0 {
+                    override_addr = addr;
+                }
+                let mut mode = DL_MODE_NEED_RSP;
+                if features & FW_FEATURE_SET_ENCRYPT != 0 {
+                    mode |= DL_MODE_ENCRYPT | DL_MODE_RESET_SEC_IV;
+                }
+                if features & FW_FEATURE_ENCRY_MODE != 0 {
+                    mode |= DL_CONFIG_ENCRY_MODE_SEL;
+                }
+                mode |= (((features & 0x6) >> 1) as u32) << 1;
+                let data = file.get(offset..offset + len).ok_or_else(|| String::from("a RAM region beyond the file"))?;
+                self.init_download(addr, len as u32, mode)?;
+                self.scatter(data)?;
+            }
+            offset += len;
+        }
+        let option = if override_addr != 0 { FW_START_OVERRIDE } else { 0 };
+        let mut payload = Vec::with_capacity(8);
+        payload.extend_from_slice(&option.to_le_bytes());
+        payload.extend_from_slice(&override_addr.to_le_bytes());
+        self.mcu(Cmd::Legacy(MCU_CMD_FW_START_REQ), &payload, true)?;
+        if !self.poll(CONN_ON_MISC, 0x3, 0x3, 1500) {
+            return Err(String::from("the firmware did not say it runs"));
+        }
+        Ok(())
+    }
+}
