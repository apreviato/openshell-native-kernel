diff --git a/kernel/libs/aster-bigtcp/src/iface/dhcp.rs b/kernel/libs/aster-bigtcp/src/iface/dhcp.rs
index 7c11ae4..97cfc43 100755
--- a/kernel/libs/aster-bigtcp/src/iface/dhcp.rs
+++ b/kernel/libs/aster-bigtcp/src/iface/dhcp.rs
@@ -348,9 +348,17 @@ pub(crate) fn dhcp_datagram(ipv4: &[u8]) -> Option<&[u8]> {
 pub fn resolv_conf(leases: &[Lease]) -> Vec<u8> {
     let mut text = Vec::new();
     for lease in leases {
-        if !lease.domain.is_empty() {
+        // A name as dhclient takes option 15: letters, digits, '-' and '.',
+        // without the NUL some servers end it with. Anything else (a line
+        // break, a space, a byte that is not text) and it is left out: the
+        // server cannot add lines of its own.
+        let domain = lease.domain.strip_suffix(&[0]).unwrap_or(&lease.domain);
+        let valid = !domain.is_empty()
+            && domain.len() <= 253
+            && domain.iter().all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'.'));
+        if valid {
             text.extend_from_slice(b"domain ");
-            text.extend_from_slice(&lease.domain);
+            text.extend_from_slice(domain);
             text.push(b'\n');
         }
     }
