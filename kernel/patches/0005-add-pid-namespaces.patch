diff --git a/kernel/core/src/process/namespace/pid_ns.rs b/kernel/core/src/process/namespace/pid_ns.rs
new file mode 100755
--- /dev/null
+++ b/kernel/core/src/process/namespace/pid_ns.rs
@@ -0,0 +1,305 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! PID namespaces.
+//!
+//! The kernel identifies every thread, process, process group and session by one
+//! global ID, which is the ID in the initial PID namespace. A process in another
+//! PID namespace additionally has a local ID in its namespace and in each ancestor
+//! of that namespace.
+//!
+//! Local IDs only exist at the system call boundary: [`pid_from_user`] converts an
+//! ID that user space passes in, and [`pid_to_user`] converts an ID before it is
+//! shown to user space. As a second line of defense, the PID table hides entries
+//! from threads whose namespace does not contain them, so a missing conversion
+//! cannot reach a process outside the namespace.
+
+use spin::Once;
+
+use crate::{
+    fs::pseudofs::{NsCommonOps, NsType, StashedDentry},
+    prelude::*,
+    process::{
+        Pid, UserNamespace, credentials::capabilities::CapSet, posix_thread::{AsPosixThread, PosixThread},
+    },
+    security::lsm::hooks as lsm_hooks,
+};
+
+/// The maximum nesting depth of PID namespaces.
+///
+/// Reference: <https://elixir.bootlin.com/linux/v6.16.5/source/include/linux/pid_namespace.h#L18>
+const MAX_LEVEL: u32 = 32;
+
+/// The largest local ID.
+const MAX_LOCAL_ID: u32 = 4 * 1024 * 1024;
+
+/// The local ID of the first process in a PID namespace.
+const LOCAL_INIT_ID: u32 = 1;
+
+/// A global ID that never identifies anything.
+pub(crate) const NO_SUCH_ID: u32 = u32::MAX;
+
+/// The PID namespace.
+pub(crate) struct PidNamespace {
+    parent: Option<Arc<PidNamespace>>,
+    owner: Arc<UserNamespace>,
+    /// The nesting depth. The initial namespace has level zero.
+    level: u32,
+    ids: Mutex<LocalIds>,
+    stashed_dentry: StashedDentry,
+}
+
+/// The local IDs of a PID namespace.
+struct LocalIds {
+    last_local: u32,
+    to_global: BTreeMap<u32, u32>,
+    to_local: BTreeMap<u32, u32>,
+    /// Whether the first process of the namespace has exited.
+    ///
+    /// No new process can enter such a namespace.
+    is_dead: bool,
+}
+
+impl PidNamespace {
+    /// Returns a reference to the singleton initial PID namespace.
+    pub(crate) fn get_init_singleton() -> &'static Arc<PidNamespace> {
+        static INIT: Once<Arc<PidNamespace>> = Once::new();
+
+        INIT.call_once(|| {
+            Self::new(None, UserNamespace::get_init_singleton().clone(), 0)
+        })
+    }
+
+    fn new(parent: Option<Arc<PidNamespace>>, owner: Arc<UserNamespace>, level: u32) -> Arc<Self> {
+        Arc::new(Self {
+            parent,
+            owner,
+            level,
+            ids: Mutex::new(LocalIds {
+                last_local: 0,
+                to_global: BTreeMap::new(),
+                to_local: BTreeMap::new(),
+                is_dead: false,
+            }),
+            stashed_dentry: StashedDentry::new(),
+        })
+    }
+
+    /// Creates an empty PID namespace as a child of this namespace.
+    pub(crate) fn new_child(
+        self: &Arc<Self>,
+        owner: Arc<UserNamespace>,
+        posix_thread: &PosixThread,
+    ) -> Result<Arc<Self>> {
+        lsm_hooks::on_capable(lsm_hooks::CapableContext::new(
+            owner.as_ref(),
+            posix_thread,
+            CapSet::SYS_ADMIN,
+        ))?;
+        if self.level >= MAX_LEVEL {
+            return_errno_with_message!(Errno::EINVAL, "too many nested PID namespaces");
+        }
+        Ok(Self::new(Some(self.clone()), owner, self.level + 1))
+    }
+
+    /// Returns whether this is the initial PID namespace.
+    pub(crate) fn is_init(&self) -> bool {
+        self.parent.is_none()
+    }
+
+    /// Returns whether this namespace is the same as, or an ancestor of, the other namespace.
+    pub(crate) fn is_same_or_ancestor_of(&self, other: &PidNamespace) -> bool {
+        let mut current = other;
+        loop {
+            if core::ptr::eq(self, current) {
+                return true;
+            }
+            match current.parent.as_deref() {
+                Some(parent) if current.level > self.level => current = parent,
+                _ => return false,
+            }
+        }
+    }
+
+    /// Gives a global ID a local ID in this namespace and in all of its ancestors.
+    ///
+    /// The global ID must belong to a new thread or process of this namespace.
+    pub(crate) fn register(self: &Arc<Self>, global: u32) -> Result<PidRegistration> {
+        let mut registered = 0;
+        let mut result = Ok(());
+
+        let mut current = Some(self.as_ref());
+        while let Some(pid_ns) = current.filter(|pid_ns| !pid_ns.is_init()) {
+            result = pid_ns.ids.lock().insert(global);
+            if result.is_err() {
+                break;
+            }
+            registered += 1;
+            current = pid_ns.parent.as_deref();
+        }
+
+        if let Err(err) = result {
+            // Undo the registrations in the namespaces below the failing one.
+            let mut current = Some(self.as_ref());
+            for _ in 0..registered {
+                let pid_ns = current.unwrap();
+                pid_ns.ids.lock().remove(global);
+                current = pid_ns.parent.as_deref();
+            }
+            return Err(err);
+        }
+
+        Ok(PidRegistration {
+            pid_ns: self.clone(),
+            global,
+            is_committed: false,
+        })
+    }
+
+    /// Removes the local IDs of a global ID in this namespace and in its ancestors.
+    pub(crate) fn unregister(&self, global: u32) {
+        let mut current = Some(self);
+        while let Some(pid_ns) = current.filter(|pid_ns| !pid_ns.is_init()) {
+            pid_ns.ids.lock().remove(global);
+            current = pid_ns.parent.as_deref();
+        }
+    }
+
+    /// Returns the ID in this namespace for a global ID.
+    pub(crate) fn local_of(&self, global: u32) -> Option<u32> {
+        if self.is_init() {
+            return Some(global);
+        }
+        self.ids.lock().to_local.get(&global).copied()
+    }
+
+    /// Returns the global ID for an ID in this namespace.
+    pub(crate) fn global_of(&self, local: u32) -> Option<u32> {
+        if self.is_init() {
+            return Some(local);
+        }
+        self.ids.lock().to_global.get(&local).copied()
+    }
+
+    /// Returns whether the process is the first process of this namespace.
+    pub(crate) fn is_init_process(&self, global: Pid) -> bool {
+        !self.is_init() && self.local_of(global) == Some(LOCAL_INIT_ID)
+    }
+
+    /// Marks the namespace as dead because its first process has exited.
+    pub(crate) fn set_dead(&self) {
+        self.ids.lock().is_dead = true;
+    }
+}
+
+impl LocalIds {
+    fn insert(&mut self, global: u32) -> Result<()> {
+        if self.is_dead {
+            return_errno_with_message!(
+                Errno::ENOMEM,
+                "the init process of the PID namespace has exited"
+            );
+        }
+        debug_assert!(!self.to_local.contains_key(&global));
+
+        // Allocate local IDs in increasing order and wrap around like Linux does.
+        let mut local = self.last_local;
+        for _ in 0..MAX_LOCAL_ID {
+            local = if local >= MAX_LOCAL_ID { LOCAL_INIT_ID } else { local + 1 };
+            // After a wrap, the ID of the first process stays reserved.
+            if (local == LOCAL_INIT_ID && self.last_local != 0)
+                || self.to_global.contains_key(&local)
+            {
+                continue;
+            }
+            self.last_local = local;
+            self.to_global.insert(local, global);
+            self.to_local.insert(global, local);
+            return Ok(());
+        }
+        return_errno_with_message!(Errno::EAGAIN, "the PID namespace has no free IDs");
+    }
+
+    fn remove(&mut self, global: u32) {
+        if let Some(local) = self.to_local.remove(&global) {
+            self.to_global.remove(&local);
+        }
+    }
+}
+
+/// A pending registration of a global ID in a PID namespace.
+///
+/// Dropping the value removes the local IDs again, unless the registration has
+/// been committed because the ID entered the PID table. The PID table then
+/// removes the local IDs together with the table entry.
+pub(crate) struct PidRegistration {
+    pid_ns: Arc<PidNamespace>,
+    global: u32,
+    is_committed: bool,
+}
+
+impl PidRegistration {
+    pub(crate) fn commit(mut self) {
+        self.is_committed = true;
+    }
+}
+
+impl Drop for PidRegistration {
+    fn drop(&mut self) {
+        if !self.is_committed {
+            self.pid_ns.unregister(self.global);
+        }
+    }
+}
+
+impl NsCommonOps for PidNamespace {
+    const TYPE: NsType = NsType::Pid;
+
+    fn owner_user_ns(&self) -> Option<&Arc<UserNamespace>> {
+        Some(&self.owner)
+    }
+
+    fn parent(&self) -> Result<&Arc<Self>> {
+        self.parent.as_ref().ok_or_else(|| {
+            Error::with_message(Errno::EPERM, "the initial PID namespace has no parent")
+        })
+    }
+
+    fn stashed_dentry(&self) -> &StashedDentry {
+        &self.stashed_dentry
+    }
+}
+
+/// Returns the PID namespace of the current thread, unless it is the initial one.
+///
+/// Kernel threads and threads in the initial namespace see all global IDs.
