+///
+/// The first process reaps the orphans of its namespace, so the namespace cannot
+/// continue without it. No new process can enter the namespace afterwards.
+fn kill_pid_ns_members(current_process: &Process) {
+    use crate::process::signal::constants::SIGKILL;
