+    /// Publishes the filesystem events of a completed rename.
+    fn notify_rename(
+        mode: RenameMode,
+        (old_dir_inode, old_name): (&Arc<dyn Inode>, &str),
+        (new_dir_inode, new_name): (&Arc<dyn Inode>, &str),
+        old_inode: &Arc<dyn Inode>,
+        new_inode: Option<&Arc<dyn Inode>>,
+    ) {
+        use fs::vfs::notify::on_move;
+
+        match (mode, new_inode) {
+            (RenameMode::Exchange, Some(new_inode)) => {
+                // An exchange moves both entries, so it reports two moves.
