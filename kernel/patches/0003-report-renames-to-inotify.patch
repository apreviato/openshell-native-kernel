+/// The cookie of the next move.
+static NEXT_MOVE_COOKIE: AtomicU32 = AtomicU32::new(1);
+
+/// Notifies that an entry was moved between two names.
+///
+/// The old and the new directory receive `MOVED_FROM` and `MOVED_TO` events that
+/// share a nonzero cookie. If the move replaced an existing inode, the caller
+/// passes it as `replaced_inode`.
+pub(crate) fn on_move(
+    old_dir_inode: &Arc<dyn Inode>,
+    old_name: &str,
+    new_dir_inode: &Arc<dyn Inode>,
+    new_name: &str,
+    moved_inode: &Arc<dyn Inode>,
+    replaced_inode: Option<&Arc<dyn Inode>>,
+) {
+    if !old_dir_inode
+        .fs()
+        .fs_event_subscriber_stats()
+        .has_any_subscribers()
+    {
+        return;
+    }
+
+    let cookie = loop {
+        let cookie = NEXT_MOVE_COOKIE.fetch_add(1, Ordering::Relaxed);
+        if cookie != 0 {
+            break cookie;
+        }
+    };
+    let is_dir = if moved_inode.type_() == InodeType::Dir {
+        FsEvents::ISDIR
+    } else {
+        FsEvents::empty()
+    };
+
+    if let Some(publisher) = old_dir_inode.fs_event_publisher() {
+        publisher.publish_event(
+            FsEvents::MOVED_FROM | is_dir,
+            Some(old_name.to_string()),
+            cookie,
+        );
+    }
+    if let Some(publisher) = new_dir_inode.fs_event_publisher() {
+        publisher.publish_event(
+            FsEvents::MOVED_TO | is_dir,
+            Some(new_name.to_string()),
+            cookie,
+        );
+    }
+    notify_inode(moved_inode, FsEvents::MOVE_SELF);
+
+    if let Some(replaced_inode) = replaced_inode {
+        notify_inode(replaced_inode, FsEvents::ATTRIB);
+        if replaced_inode
+            .metadata()
+            .is_ok_and(|metadata| metadata.nr_hard_links == 0)
+        {
+            // FIXME: `DELETE_SELF` should be generated after closing the last FD.
+            notify_inode(replaced_inode, FsEvents::DELETE_SELF);
+        }
+    }
+}
