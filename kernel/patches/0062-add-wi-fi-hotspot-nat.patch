index 0000000..8ee37f3
--- /dev/null
+++ b/kernel/libs/aster-bigtcp/src/iface/nat.rs
@@ -0,0 +1,390 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Sharing this computer's connection with the devices of a network it
+//! serves (a Wi-Fi hotspot), as Linux does for NetworkManager's shared
+//! connections: the serving interface gets a fixed address and a DHCP
+//! server (`dhcpd`), and the IPv4 packets its devices send elsewhere leave
+//! through the interface that has the way out, with that interface's
+//! address and a port of its own (source NAT, iptables' MASQUERADE); the
+//! answers come back translated. TCP, UDP and ICMP echo pass.
+//!
+//! A packet changes interface through a queue: the interface that
+//! received it leaves it for the other one's next poll, which it asks for,
+//! so that no poll waits on another interface's locks.
+
+use alloc::{collections::{BTreeMap, VecDeque}, vec::Vec};
+use core::sync::atomic::{AtomicBool, Ordering};
+
+use ostd::sync::{LocalIrqDisabled, SpinLock};
+use spin::Once;
+
+use super::dhcpd::DhcpServer;
+
+const PROTO_ICMP: u8 = 1;
+const PROTO_TCP: u8 = 6;
+const PROTO_UDP: u8 = 17;
+
+/// The ports (and ICMP identifiers) the translations take on the way out:
+/// above the range Linux gives programs.
+const PORT_FIRST: u16 = 61_000;
+const PORT_LAST: u16 = 65_000;
+/// How long a translation lasts unused.
+const TCP_IDLE_MS: u64 = 30 * 60 * 1000;
+const UDP_IDLE_MS: u64 = 3 * 60 * 1000;
+const ICMP_IDLE_MS: u64 = 30 * 1000;
+/// Packets waiting for an interface's poll, at most.
+const QUEUE_LEN: usize = 512;
+
+/// What the kernel does for sharing: the way out for a destination (the
+/// interface's index and its address), waking an interface's poll, and
+/// the DNS servers the devices get.
+#[derive(Clone, Copy)]
+pub struct Hooks {
+    pub route: fn(destination: [u8; 4], inside: u32) -> Option<(u32, [u8; 4])>,
+    pub wake: fn(index: u32),
+    pub dns: fn(inside: u32) -> Vec<[u8; 4]>,
+}
+
+static HOOKS: Once<Hooks> = Once::new();
+
+pub fn set_hooks(hooks: Hooks) {
+    HOOKS.call_once(|| hooks);
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Mapping {
+    inside: ([u8; 4], u16),
+    remote: ([u8; 4], u16),
+    outside: u32,
+    outside_address: [u8; 4],
+    used: u64,
+}
+
+struct Sharing {
+    /// The serving interface and its network.
+    inside: u32,
+    address: [u8; 4],
+    prefix_len: u8,
+    dhcp: DhcpServer,
+    /// Translations by protocol and outside port.
+    by_outside: BTreeMap<(u8, u16), Mapping>,
+    /// The outside port of a flow from a device.
+    by_inside: BTreeMap<(u8, [u8; 4], u16, [u8; 4], u16), u16>,
+    next_port: u16,
+}
+
+static SHARING: SpinLock<Option<Sharing>, LocalIrqDisabled> = SpinLock::new(None);
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+/// IPv4 packets for each interface's next poll, with where they go.
+static QUEUES: SpinLock<BTreeMap<u32, VecDeque<(Vec<u8>, [u8; 4])>>, LocalIrqDisabled> = SpinLock::new(BTreeMap::new());
+
+fn now_ms() -> u64 {
+    super::time::get_network_timestamp().total_millis() as u64
+}
+
+/// Starts sharing through the interface `inside`, whose address is
+/// `address`/`prefix_len`.
+pub fn share(inside: u32, address: [u8; 4], prefix_len: u8) {
+    *SHARING.lock() = Some(Sharing {
+        inside,
+        address,
+        prefix_len,
+        dhcp: DhcpServer::new(address, prefix_len),
+        by_outside: BTreeMap::new(),
+        by_inside: BTreeMap::new(),
+        next_port: PORT_FIRST,
+    });
+    ACTIVE.store(true, Ordering::Release);
+}
+
+pub fn stop_sharing() {
+    ACTIVE.store(false, Ordering::Release);
+    *SHARING.lock() = None;
+    QUEUES.lock().clear();
+}
+
+pub(crate) fn active() -> bool {
+    ACTIVE.load(Ordering::Acquire)
+}
+
+/// What becomes of a packet an interface received.
+pub(crate) enum Ingress {
+    /// The interface takes it as its own.
+    Local,
+    /// It went on to another interface (or was dropped as it should be).
+    Consumed,
+    /// The answer to send back on this interface (DHCP), with where it goes.
+    Reply(Vec<u8>, [u8; 4]),
+}
+
+fn in_network(address: [u8; 4], network: [u8; 4], prefix_len: u8) -> bool {
+    let mask = if prefix_len == 0 { 0 } else { u32::MAX << (32 - prefix_len as u32) };
+    u32::from_be_bytes(address) & mask == u32::from_be_bytes(network) & mask
+}
+
+/// The internet checksum of `bytes`, starting from `sum`.
+fn fold(mut sum: u32, bytes: &[u8]) -> u32 {
+    for pair in bytes.chunks(2) {
+        sum += u32::from(u16::from_be_bytes([pair[0], *pair.get(1).unwrap_or(&0)]));
+    }
+    sum
+}
+
+fn finish(mut sum: u32) -> u16 {
+    while sum >> 16 != 0 {
+        sum = (sum & 0xffff) + (sum >> 16);
+    }
+    !(sum as u16)
+}
+
+/// Writes the checksums of an IPv4 packet anew: the header's, and the TCP,
+/// UDP or ICMP one inside.
+pub(crate) fn fix_checksums(packet: &mut [u8]) {
+    let header = usize::from(packet[0] & 0x0f) * 4;
+    packet[10..12].fill(0);
+    let sum = finish(fold(0, &packet[..header]));
+    packet[10..12].copy_from_slice(&sum.to_be_bytes());
+    let total = usize::from(u16::from_be_bytes([packet[2], packet[3]])).min(packet.len());
+    let (protocol, source, destination) = (packet[9], [packet[12], packet[13], packet[14], packet[15]], [packet[16], packet[17], packet[18], packet[19]]);
+    let body = &mut packet[header..total];
+    let length = body.len() as u16;
+    let pseudo = |sum: u32| {
+        let sum = fold(sum, &source);
+        let sum = fold(sum, &destination);
+        let sum = fold(sum, &[0, protocol]);
+        fold(sum, &length.to_be_bytes())
+    };
+    match protocol {
+        PROTO_TCP if body.len() >= 20 => {
+            body[16..18].fill(0);
+            let sum = finish(fold(pseudo(0), body));
+            body[16..18].copy_from_slice(&sum.to_be_bytes());
+        }
+        PROTO_UDP if body.len() >= 8 => {
+            // A datagram sent without a checksum keeps it so.
+            if body[6..8] == [0, 0] {
+                return;
+            }
+            body[6..8].fill(0);
+            let sum = match finish(fold(pseudo(0), body)) {
+                0 => 0xffff,
+                sum => sum,
+            };
+            body[6..8].copy_from_slice(&sum.to_be_bytes());
+        }
+        PROTO_ICMP if body.len() >= 8 => {
+            body[2..4].fill(0);
+            let sum = finish(fold(0, body));
+            body[2..4].copy_from_slice(&sum.to_be_bytes());
+        }
+        _ => {}
+    }
+}
+
+/// The ports of a packet's flow: TCP and UDP's source and destination, an
+/// ICMP echo's identifier both ways. None for other packets.
+fn ports(packet: &[u8], header: usize) -> Option<(u16, u16)> {
+    let body = packet.get(header..)?;
+    match packet[9] {
+        PROTO_TCP | PROTO_UDP => Some((u16::from_be_bytes([*body.first()?, *body.get(1)?]), u16::from_be_bytes([*body.get(2)?, *body.get(3)?]))),
+        // Echo request (8) and reply (0).
+        PROTO_ICMP if matches!(body.first(), Some(0 | 8)) => {
+            let id = u16::from_be_bytes([*body.get(4)?, *body.get(5)?]);
+            Some((id, id))
+        }
+        _ => None,
+    }
+}
+
+fn set_ports(packet: &mut [u8], header: usize, source: Option<u16>, destination: Option<u16>) {
+    let protocol = packet[9];
+    let body = &mut packet[header..];
+    match protocol {
+        PROTO_TCP | PROTO_UDP => {
+            if let Some(port) = source {
+                body[0..2].copy_from_slice(&port.to_be_bytes());
+            }
+            if let Some(port) = destination {
+                body[2..4].copy_from_slice(&port.to_be_bytes());
+            }
+        }
+        PROTO_ICMP => {
+            if let Some(id) = source.or(destination) {
+                body[4..6].copy_from_slice(&id.to_be_bytes());
+            }
+        }
+        _ => {}
+    }
+}
+
+fn idle_limit(protocol: u8) -> u64 {
+    match protocol {
+        PROTO_TCP => TCP_IDLE_MS,
+        PROTO_UDP => UDP_IDLE_MS,
+        _ => ICMP_IDLE_MS,
+    }
+}
+
+impl Sharing {
+    /// Drops the translations unused for too long.
+    fn expire(&mut self, now: u64) {
+        let stale: Vec<(u8, u16)> = self
+            .by_outside
+            .iter()
+            .filter(|((protocol, _), mapping)| now.saturating_sub(mapping.used) > idle_limit(*protocol))
+            .map(|(key, _)| *key)
+            .collect();
+        for key in stale {
+            if let Some(mapping) = self.by_outside.remove(&key) {
+                self.by_inside.remove(&(key.0, mapping.inside.0, mapping.inside.1, mapping.remote.0, mapping.remote.1));
+            }
+        }
+    }
+
+    /// The outside port of a flow, a new one if it has none.
+    fn outside_port(&mut self, protocol: u8, inside: ([u8; 4], u16), remote: ([u8; 4], u16), outside: u32, outside_address: [u8; 4], now: u64) -> Option<u16> {
+        let key = (protocol, inside.0, inside.1, remote.0, remote.1);
+        if let Some(&port) = self.by_inside.get(&key)
+            && let Some(mapping) = self.by_outside.get_mut(&(protocol, port))
+            && mapping.outside == outside
+        {
+            mapping.used = now;
+            return Some(port);
+        }
+        let span = PORT_LAST - PORT_FIRST;
+        if self.by_outside.len() as u16 >= span / 2 {
+            self.expire(now);
+        }
+        for _ in 0..span {
+            let port = self.next_port;
+            self.next_port = if port >= PORT_LAST { PORT_FIRST } else { port + 1 };
+            if self.by_outside.contains_key(&(protocol, port)) {
+                continue;
+            }
+            self.by_outside.insert((protocol, port), Mapping { inside, remote, outside, outside_address, used: now });
+            self.by_inside.insert(key, port);
+            return Some(port);
+        }
+        None
+    }
+}
+
+/// Leaves a packet for interface `index`'s next poll and asks for it.
+fn queue(index: u32, packet: Vec<u8>, destination: [u8; 4]) {
+    {
+        let mut queues = QUEUES.lock();
+        let queue = queues.entry(index).or_default();
+        if queue.len() >= QUEUE_LEN {
+            return;
+        }
+        queue.push_back((packet, destination));
+    }
+    if let Some(hooks) = HOOKS.get() {
+        (hooks.wake)(index);
+    }
+}
+
+/// The packets waiting for interface `index`.
+pub(crate) fn take(index: u32) -> Vec<(Vec<u8>, [u8; 4])> {
+    if !active() {
+        return Vec::new();
+    }
+    let mut queues = QUEUES.lock();
+    match queues.get_mut(&index) {
+        Some(queue) if !queue.is_empty() => queue.drain(..).collect(),
+        _ => Vec::new(),
+    }
+}
+
+/// Decides what becomes of an IPv4 packet that interface `index`, whose
+/// address is `own`, received.
+pub(crate) fn ingress(index: u32, own: Option<[u8; 4]>, mut packet: Vec<u8>) -> Ingress {
+    if packet.len() < 20 || packet[0] >> 4 != 4 {
+        return Ingress::Local;
+    }
+    let header = usize::from(packet[0] & 0x0f) * 4;
+    let total = usize::from(u16::from_be_bytes([packet[2], packet[3]]));
+    if header < 20 || total < header || total > packet.len() {
+        return Ingress::Local;
+    }
+    packet.truncate(total);
+    let source = [packet[12], packet[13], packet[14], packet[15]];
+    let destination = [packet[16], packet[17], packet[18], packet[19]];
+    let protocol = packet[9];
+    let fragment = u16::from_be_bytes([packet[6], packet[7]]) & 0x1fff != 0;
+    let now = now_ms();
+    let Some(hooks) = HOOKS.get().copied() else { return Ingress::Local };
+
+    let mut guard = SHARING.lock();
+    let Some(sharing) = guard.as_mut() else { return Ingress::Local };
+
+    if index == sharing.inside {
+        let broadcast = destination == [255; 4]
+            || destination[0] >= 224
+            || (in_network(destination, sharing.address, sharing.prefix_len)
+                && u32::from_be_bytes(destination) | (u32::MAX << (32 - sharing.prefix_len as u32)) == u32::MAX);
+        // The devices' DHCP requests are the server's.
+        if protocol == PROTO_UDP && (broadcast || destination == sharing.address) && !fragment {
+            let body = &packet[header..];
+            if body.len() >= 8 && u16::from_be_bytes([body[2], body[3]]) == 67 {
+                let dns = (hooks.dns)(sharing.inside);
+                return match sharing.dhcp.answer(&body[8..], &dns, now) {
+                    Some(reply) => Ingress::Reply(reply, [255; 4]),
+                    None => Ingress::Consumed,
+                };
+            }
+        }
+        if broadcast || Some(destination) == own || destination == sharing.address {
+            return Ingress::Local;
+        }
+        if !in_network(source, sharing.address, sharing.prefix_len) || fragment {
+            return Ingress::Consumed;
+        }
+        // To the network of the serving interface itself: not ours to pass.
+        if in_network(destination, sharing.address, sharing.prefix_len) {
+            return Ingress::Consumed;
+        }
+        let Some((src_port, dst_port)) = ports(&packet, header) else { return Ingress::Consumed };
+        if packet[8] <= 1 {
+            // Its time to live is over.
+            return Ingress::Consumed;
+        }
+        let Some((outside, outside_address)) = (hooks.route)(destination, sharing.inside) else { return Ingress::Consumed };
+        let Some(port) = sharing.outside_port(protocol, (source, src_port), (destination, dst_port), outside, outside_address, now) else {
+            return Ingress::Consumed;
+        };
+        drop(guard);
+        packet[8] -= 1;
+        packet[12..16].copy_from_slice(&outside_address);
+        set_ports(&mut packet, header, Some(port), None);
+        fix_checksums(&mut packet);
+        queue(outside, packet, destination);
+        return Ingress::Consumed;
+    }
+
+    // An answer to a device, on the way back in.
+    if Some(destination) != own || fragment {
+        return Ingress::Local;
+    }
+    let Some((src_port, dst_port)) = ports(&packet, header) else { return Ingress::Local };
+    let Some(mapping) = sharing.by_outside.get_mut(&(protocol, dst_port)) else { return Ingress::Local };
+    if mapping.outside != index || mapping.outside_address != destination || mapping.remote != (source, src_port) {
+        return Ingress::Local;
+    }
+    // An echo reply carries the identifier the request had.
+    if protocol == PROTO_ICMP && packet.get(header) != Some(&0) {
+        return Ingress::Local;
+    }
+    mapping.used = now;
+    let (inside, inside_index) = (mapping.inside, sharing.inside);
+    drop(guard);
+    if packet[8] <= 1 {
+        return Ingress::Consumed;
+    }
+    packet[8] -= 1;
+    packet[16..20].copy_from_slice(&inside.0);
+    set_ports(&mut packet, header, None, Some(inside.1));
+    fix_checksums(&mut packet);
+    queue(inside_index, packet, inside.0);
+    Ingress::Consumed
+}
