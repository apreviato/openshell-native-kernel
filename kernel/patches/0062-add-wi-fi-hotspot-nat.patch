index 0000000..5de0c14
--- /dev/null
+++ b/kernel/libs/aster-bigtcp/src/iface/dhcpd.rs
@@ -0,0 +1,243 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The DHCP server of a shared network (`nat`): each device gets an
+//! address of the network by its hardware address, the serving interface
+//! as its router, and the DNS servers of the connection shared, as
+//! NetworkManager's dnsmasq gives them (RFC 2131: discover, offer,
+//! request, acknowledgement; release; inform).
+
+use alloc::{collections::BTreeMap, vec::Vec};
+
+const COOKIE: [u8; 4] = [99, 130, 83, 99];
+const LEASE_SECONDS: u32 = 3600;
+/// The devices' addresses: from .10 to .254 of the network.
+const FIRST_HOST: u8 = 10;
+const LAST_HOST: u8 = 254;
+
+const DISCOVER: u8 = 1;
+const OFFER: u8 = 2;
+const REQUEST: u8 = 3;
+const DECLINE: u8 = 4;
+const ACK: u8 = 5;
+const NAK: u8 = 6;
+const RELEASE: u8 = 7;
+const INFORM: u8 = 8;
+
+#[derive(Clone, Copy, Debug)]
+struct Lease {
+    address: [u8; 4],
+    expires: u64,
+}
+
+pub(crate) struct DhcpServer {
+    address: [u8; 4],
+    prefix_len: u8,
+    leases: BTreeMap<[u8; 6], Lease>,
+    /// Addresses a device said were taken by another.
+    declined: Vec<[u8; 4]>,
+}
+
+/// What a request carries that matters here.
+struct Request<'a> {
+    kind: u8,
+    xid: [u8; 4],
+    flags: [u8; 2],
+    ciaddr: [u8; 4],
+    chaddr: [u8; 6],
+    raw_chaddr: &'a [u8],
+    requested: Option<[u8; 4]>,
+    server: Option<[u8; 4]>,
+}
+
+fn parse(message: &[u8]) -> Option<Request<'_>> {
+    // A request (op 1) over Ethernet (htype 1, hlen 6) with the cookie.
+    if message.len() < 240 || message[0] != 1 || message[1] != 1 || message[2] != 6 || message[236..240] != COOKIE {
+        return None;
+    }
+    let mut request = Request {
+        kind: 0,
+        xid: message[4..8].try_into().ok()?,
+        flags: message[10..12].try_into().ok()?,
+        ciaddr: message[12..16].try_into().ok()?,
+        chaddr: message[28..34].try_into().ok()?,
+        raw_chaddr: &message[28..44],
+        requested: None,
+        server: None,
+    };
+    let mut options = &message[240..];
+    while let [code, rest @ ..] = options {
+        match *code {
+            0 => options = rest,
+            255 => break,
+            _ => {
+                let length = usize::from(*rest.first()?);
+                let value = rest.get(1..1 + length)?;
+                match (*code, length) {
+                    (53, 1) => request.kind = value[0],
+                    (50, 4) => request.requested = value.try_into().ok(),
+                    (54, 4) => request.server = value.try_into().ok(),
+                    _ => {}
+                }
+                options = &rest[1 + length..];
+            }
+        }
+    }
+    (request.kind != 0).then_some(request)
+}
+
+impl DhcpServer {
+    pub(crate) fn new(address: [u8; 4], prefix_len: u8) -> Self {
+        Self { address, prefix_len, leases: BTreeMap::new(), declined: Vec::new() }
+    }
+
+    fn netmask(&self) -> [u8; 4] {
+        (u32::MAX << (32 - self.prefix_len as u32)).to_be_bytes()
+    }
+
+    fn host(&self, last: u8) -> [u8; 4] {
+        let mut address = self.address;
+        address[3] = last;
+        address
+    }
+
+    fn in_pool(&self, address: [u8; 4]) -> bool {
+        address[..3] == self.address[..3] && (FIRST_HOST..=LAST_HOST).contains(&address[3]) && address != self.address
+    }
+
+    /// The address a device has, or a free one for it.
+    fn address_for(&mut self, chaddr: [u8; 6], wanted: Option<[u8; 4]>, now: u64) -> Option<[u8; 4]> {
+        if let Some(lease) = self.leases.get(&chaddr) {
+            return Some(lease.address);
+        }
+        self.leases.retain(|_, lease| lease.expires > now);
+        let taken = |address: [u8; 4], leases: &BTreeMap<[u8; 6], Lease>| leases.values().any(|lease| lease.address == address);
+        if let Some(wanted) = wanted
+            && self.in_pool(wanted)
+            && !taken(wanted, &self.leases)
+            && !self.declined.contains(&wanted)
+        {
+            return Some(wanted);
+        }
+        // The same device gets the same address each time it comes back
+        // while the address is free: start where its hardware address says.
+        let span = (LAST_HOST - FIRST_HOST) as u32 + 1;
+        let start = chaddr.iter().fold(0u32, |sum, byte| sum.wrapping_mul(31).wrapping_add(*byte as u32)) % span;
+        (0..span)
+            .map(|step| self.host(FIRST_HOST + ((start + step) % span) as u8))
+            .find(|address| *address != self.address && !taken(*address, &self.leases) && !self.declined.contains(address))
+    }
+
+    /// The answer to a DHCP message from a device (the UDP payload), as
+    /// the whole IPv4 packet to send to the network's broadcast address.
+    pub(crate) fn answer(&mut self, message: &[u8], dns: &[[u8; 4]], now: u64) -> Option<Vec<u8>> {
+        let request = parse(message)?;
+        // Messages for another server are not this one's.
+        if request.server.is_some_and(|server| server != self.address) {
+            if request.kind == REQUEST {
+                // The device chose another server's offer.
+                self.leases.remove(&request.chaddr);
+            }
+            return None;
+        }
+        let (kind, yiaddr) = match request.kind {
+            DISCOVER => (OFFER, self.address_for(request.chaddr, request.requested, now)?),
+            REQUEST => {
+                let wanted = request.requested.unwrap_or(request.ciaddr);
+                match self.address_for(request.chaddr, Some(wanted), now) {
+                    Some(address) if address == wanted => {
+                        self.leases.insert(request.chaddr, Lease { address, expires: now + LEASE_SECONDS as u64 * 1000 });
+                        (ACK, address)
+                    }
+                    _ => (NAK, [0; 4]),
+                }
+            }
+            DECLINE => {
+                if let Some(address) = request.requested {
+                    self.declined.push(address);
+                }
+                self.leases.remove(&request.chaddr);
+                return None;
+            }
+            RELEASE => {
+                self.leases.remove(&request.chaddr);
+                return None;
+            }
+            INFORM => (ACK, [0; 4]),
+            _ => return None,
+        };
+        Some(self.reply(&request, kind, yiaddr, dns))
+    }
+
+    fn reply(&self, request: &Request, kind: u8, yiaddr: [u8; 4], dns: &[[u8; 4]]) -> Vec<u8> {
+        let mut message = alloc::vec![0u8; 240];
+        message[0] = 2;
+        message[1] = 1;
+        message[2] = 6;
+        message[4..8].copy_from_slice(&request.xid);
+        message[10..12].copy_from_slice(&request.flags);
+        if kind == ACK && yiaddr == [0; 4] {
+            message[12..16].copy_from_slice(&request.ciaddr);
+        }
+        message[16..20].copy_from_slice(&yiaddr);
+        message[20..24].copy_from_slice(&self.address);
+        message[28..44].copy_from_slice(request.raw_chaddr);
+        message[236..240].copy_from_slice(&COOKIE);
+        message.extend_from_slice(&[53, 1, kind]);
+        message.extend_from_slice(&[54, 4]);
+        message.extend_from_slice(&self.address);
+        if kind != NAK {
+            if yiaddr != [0; 4] {
+                message.extend_from_slice(&[51, 4]);
+                message.extend_from_slice(&LEASE_SECONDS.to_be_bytes());
+                message.extend_from_slice(&[58, 4]);
+                message.extend_from_slice(&(LEASE_SECONDS / 2).to_be_bytes());
+                message.extend_from_slice(&[59, 4]);
+                message.extend_from_slice(&(LEASE_SECONDS / 8 * 7).to_be_bytes());
+            }
+            message.extend_from_slice(&[1, 4]);
+            message.extend_from_slice(&self.netmask());
+            message.extend_from_slice(&[3, 4]);
+            message.extend_from_slice(&self.address);
+            let mut broadcast = self.address;
+            for (byte, mask) in broadcast.iter_mut().zip(self.netmask()) {
+                *byte |= !mask;
+            }
+            message.extend_from_slice(&[28, 4]);
+            message.extend_from_slice(&broadcast);
+            // The connection's own DNS servers; without any, the devices
+            // ask the hotspot, which has none to answer with.
+            let servers: Vec<[u8; 4]> = if dns.is_empty() { alloc::vec![self.address] } else { dns.iter().take(3).copied().collect() };
+            message.push(6);
+            message.push((servers.len() * 4) as u8);
+            for server in servers {
+                message.extend_from_slice(&server);
+            }
+        }
+        message.push(255);
+        // Small messages are padded to the 300 bytes old clients expect.
+        if message.len() < 300 {
+            message.resize(300, 0);
+        }
+        datagram(self.address, [255; 4], &message)
+    }
+}
+
+/// An IPv4 packet with a UDP datagram from the server's port to the
+/// client's.
+fn datagram(source: [u8; 4], destination: [u8; 4], payload: &[u8]) -> Vec<u8> {
+    let udp_length = 8 + payload.len();
+    let total = 20 + udp_length;
+    let mut packet = Vec::with_capacity(total);
+    packet.extend_from_slice(&[0x45, 0x10]);
+    packet.extend_from_slice(&(total as u16).to_be_bytes());
+    packet.extend_from_slice(&[0, 0, 0, 0, 64, 17, 0, 0]);
+    packet.extend_from_slice(&source);
+    packet.extend_from_slice(&destination);
+    packet.extend_from_slice(&67u16.to_be_bytes());
+    packet.extend_from_slice(&68u16.to_be_bytes());
+    packet.extend_from_slice(&(udp_length as u16).to_be_bytes());
+    packet.extend_from_slice(&[0xff, 0xff]);
+    packet.extend_from_slice(payload);
+    super::nat::fix_checksums(&mut packet);
+    packet
+}
