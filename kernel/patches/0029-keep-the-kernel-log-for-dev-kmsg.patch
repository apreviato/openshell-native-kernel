index 0000000..6e53a5e
--- /dev/null
+++ b/kernel/core/comps/logger/src/kmsg.rs
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The kernel's log as `/dev/kmsg` reads it.
+//!
+//! The latest records stay in a ring, whatever the console shows, so that
+//! a computer without a serial console still has its kernel's messages. Each
+//! is kept as Linux formats a `/dev/kmsg` record: `<level>,<seq>,<usec>,-;<text>`.
+
+use core::{fmt, time::Duration};
+
+use ostd::{
+    log::Record,
+    sync::{LocalIrqDisabled, SpinLock},
+};
+
+/// How many records the ring keeps.
+const RECORDS: usize = 1024;
+/// The longest text kept of a record; the rest is cut.
+const TEXT: usize = 224;
+/// The longest record as `read` formats it: the header and the text.
+pub const MAX_RECORD: usize = TEXT + 64;
+/// A text identical to one of this many latest records is not kept again.
+const REPEATS_SEEN: u64 = 16;
+
+#[derive(Clone, Copy)]
+struct Kept {
+    seq: u64,
+    level: u8,
+    usec: u64,
+    len: u16,
+    text: [u8; TEXT],
+}
+
+impl Kept {
+    const EMPTY: Self = Self {
+        seq: 0,
+        level: 0,
+        usec: 0,
+        len: 0,
+        text: [0; TEXT],
+    };
+}
+
+struct Ring {
+    records: [Kept; RECORDS],
+    /// The sequence number of the next record.
+    next: u64,
+}
+
+static RING: SpinLock<Ring, LocalIrqDisabled> = SpinLock::new(Ring {
+    records: [Kept::EMPTY; RECORDS],
+    next: 0,
+});
+
+/// Text cut at a fixed length, with control characters as spaces.
+struct Text {
+    bytes: [u8; TEXT],
+    len: usize,
+}
+
+impl fmt::Write for Text {
+    fn write_str(&mut self, s: &str) -> fmt::Result {
+        for &byte in s.as_bytes() {
+            if self.len == TEXT {
+                break;
+            }
+            self.bytes[self.len] = if byte < 0x20 || byte == 0x7f { b' ' } else { byte };
+            self.len += 1;
+        }
+        Ok(())
+    }
+}
+
+/// Keeps a record.
+pub(super) fn keep(record: &Record, timestamp: Duration) {
+    let mut text = Text { bytes: [0; TEXT], len: 0 };
+    let _ = fmt::write(&mut text, format_args!("{}{}", record.prefix(), record.args()));
+    // A cut UTF-8 character would make the record invalid text.
+    while text.len > 0 && core::str::from_utf8(&text.bytes[..text.len]).is_err() {
+        text.len -= 1;
+    }
+    let mut ring = RING.lock();
+    // A message repeated over and over (an unimplemented system call that
+    // every program makes) would push everything else out: one is enough
+    // among the latest.
+    let recent = ring.next.saturating_sub(REPEATS_SEEN)..ring.next;
+    let repeated = recent.into_iter().any(|seq| {
+        let kept = &ring.records[(seq % RECORDS as u64) as usize];
+        kept.text[..kept.len as usize] == text.bytes[..text.len]
+    });
+    if repeated {
+        return;
+    }
+    let seq = ring.next;
+    ring.next += 1;
+    ring.records[(seq % RECORDS as u64) as usize] = Kept {
+        seq,
+        level: record.level() as u8,
+        usec: timestamp.as_micros() as u64,
+        len: text.len as u16,
+        text: text.bytes,
+    };
+}
+
+/// A buffer filled from the start, never past its end.
+struct Out<'a> {
+    bytes: &'a mut [u8],
+    len: usize,
+}
+
+impl Out<'_> {
+    fn put(&mut self, data: &[u8]) {
+        let room = self.bytes.len() - self.len;
+        let count = data.len().min(room);
+        self.bytes[self.len..self.len + count].copy_from_slice(&data[..count]);
+        self.len += count;
+    }
+}
+
+impl fmt::Write for Out<'_> {
+    fn write_str(&mut self, s: &str) -> fmt::Result {
+        self.put(s.as_bytes());
+        Ok(())
+    }
+}
+
+/// Formats the first record from `seq` on, or the oldest one kept when the
+/// ring no longer has those, into `out` (at least [`MAX_RECORD`] bytes).
+/// Returns its sequence number and length, or `None` when no record that
+/// new exists yet.
+pub fn read(seq: u64, out: &mut [u8]) -> Option<(u64, usize)> {
+    let kept = {
+        let ring = RING.lock();
+        if seq >= ring.next {
+            return None;
+        }
+        let oldest = ring.next.saturating_sub(RECORDS as u64);
+        ring.records[(seq.max(oldest) % RECORDS as u64) as usize]
+    };
+    let mut writer = Out { bytes: out, len: 0 };
+    let _ = fmt::write(
+        &mut writer,
+        format_args!("{},{},{},-;", kept.level, kept.seq, kept.usec),
+    );
+    writer.put(&kept.text[..kept.len as usize]);
+    writer.put(b"\n");
+    Some((kept.seq, writer.len))
+}
