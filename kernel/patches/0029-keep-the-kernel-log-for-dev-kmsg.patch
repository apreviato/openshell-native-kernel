+/// An open `/dev/kmsg`: the kernel's log from its oldest kept record on, one
+/// record per read, as on Linux. Past the newest record a read returns 0.
+/// Writing logs the text as a notice from user space.
+pub(super) struct KmsgFile {
+    next: core::sync::atomic::AtomicU64,
+}
+
+impl KmsgFile {
+    pub(super) fn new() -> Self {
+        Self {
+            next: core::sync::atomic::AtomicU64::new(0),
+        }
+    }
+}
+
+impl Pollable for KmsgFile {
+    fn poll(&self, mask: IoEvents, _poller: Option<&mut PollHandle>) -> IoEvents {
+        (IoEvents::IN | IoEvents::OUT) & mask
+    }
+}
+
+impl FileOps for KmsgFile {
+    fn read_at(
+        &self,
+        _offset: usize,
+        writer: &mut VmWriter,
+        _status_flags: StatusFlags,
+    ) -> Result<usize> {
+        use core::sync::atomic::Ordering;
+
+        let mut record = [0u8; aster_logger::kmsg::MAX_RECORD];
+        let Some((seq, len)) = aster_logger::kmsg::read(self.next.load(Ordering::Relaxed), &mut record)
+        else {
+            return Ok(0);
+        };
+        if writer.avail() < len {
+            return_errno_with_message!(Errno::EINVAL, "the buffer is smaller than the log record");
+        }
+        let written = writer
+            .write_fallible(&mut VmReader::from(&record[..len]))
+            .map_err(|(err, _)| Error::from(err))?;
+        self.next.store(seq + 1, Ordering::Relaxed);
+        Ok(written)
+    }
+
+    fn write_at(
+        &self,
+        _offset: usize,
+        reader: &mut VmReader,
+        _status_flags: StatusFlags,
+    ) -> Result<usize> {
+        const MAX_MESSAGE: usize = 1024;
+
+        let total = reader.remain();
+        let mut message = vec![0u8; total.min(MAX_MESSAGE)];
+        reader.read_fallible(&mut VmWriter::from(message.as_mut_slice()))?;
+        reader.skip(reader.remain());
+        let text = String::from_utf8_lossy(&message);
+        // Linux's optional "<level>" prefix is dropped.
+        let text = match text.strip_prefix('<').and_then(|rest| rest.split_once('>')) {
+            Some((level, rest)) if level.bytes().all(|b| b.is_ascii_digit()) => rest,
+            _ => &text,
+        };
+        ostd::notice!("user: {}", text.trim_end());
+        Ok(total)
+    }
+}
+
+impl PerOpenFileOps for KmsgFile {
+    fn check_seekable(&self) -> Result<()> {
+        Ok(())
+    }
+
+    fn is_offset_aware(&self) -> bool {
+        false
+    }
+}
+
 impl PerOpenFileOps for MemFile {
     fn check_seekable(&self) -> Result<()> {
         Ok(())
