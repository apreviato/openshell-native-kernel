+
+The firmware the driver loads (rtw88/*.bin) is Realtek's, from
+linux-firmware, redistributed under its LICENCE.rtlwifi_firmware.txt, which
+the image ships beside the files.
diff --git a/kernel/comps/rtw88/src/chip.rs b/kernel/comps/rtw88/src/chip.rs
new file mode 100644
index 0000000..545a0c7
--- /dev/null
+++ b/kernel/comps/rtw88/src/chip.rs
@@ -0,0 +1,474 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The chip's registers as Linux's rtw88 reaches them over PCIe (BAR 2) or
+//! USB (vendor requests, [`crate::usb`]), its power sequences, its efuse,
+//! and its RF registers.
+
+use alloc::{string::String, vec, vec::Vec};
+
+use aster_pci::cfg_space::BarAccess;
+
+use crate::{regs::*, usb::UsbRegs};
+
+/// One step of a power sequence (`struct rtw_pwr_seq_cmd`).
+#[derive(Clone, Copy)]
+pub(crate) struct PwrCmd {
+    pub(crate) offset: u16,
+    pub(crate) cut_mask: u8,
+    pub(crate) intf_mask: u8,
+    pub(crate) base: u8,
+    pub(crate) cmd: u8,
+    pub(crate) mask: u8,
+    pub(crate) value: u8,
+}
+
+/// A PCIe PHY parameter (`struct rtw_intf_phy_para`).
+#[derive(Clone, Copy)]
+pub(crate) struct IntfPara {
+    pub(crate) offset: u16,
+    pub(crate) value: u16,
+    pub(crate) ip_sel: u32,
+    pub(crate) cut_mask: u16,
+}
+
+/// The LTE coexistence window's registers (`struct rtw_ltecoex_addr`).
+#[derive(Clone, Copy)]
+pub(crate) struct Ltecoex {
+    pub(crate) ctrl: u32,
+    pub(crate) wdata: u32,
+    pub(crate) rdata: u32,
+}
+
+/// The 11n chips' RF read registers of a path (`struct rtw_rf_sipi_addr`).
+#[derive(Clone, Copy)]
+pub(crate) struct SipiRead {
+    pub(crate) hssi_1: u32,
+    pub(crate) hssi_2: u32,
+    pub(crate) lssi_read: u32,
+    pub(crate) lssi_read_pi: u32,
+}
+
+/// The register's field selected by `mask`, shifted down.
+fn field(value: u32, mask: u32) -> u32 {
+    if mask == 0 { 0 } else { (value & mask) >> mask.trailing_zeros() }
+}
+
+/// Where the registers are.
+pub(crate) enum Bus {
+    Mmio(BarAccess),
+    Usb(UsbRegs),
+}
+
+pub(crate) struct Chip {
+    bus: Bus,
+    pub(crate) name: String,
+    /// `hal.cut_version` and the RF paths (`REG_SYS_CFG1`).
+    pub(crate) cut: u8,
+    pub(crate) rf_paths: u8,
+    /// An 8051 CPU's chip (`RTW_WCPU_8051`) and its LTE window; the
+    /// chip's [`crate::hw::Spec`] sets them.
+    pub(crate) wcpu_8051: bool,
+    pub(crate) ltecoex: Ltecoex,
+}
+
+impl Chip {
+    pub(crate) fn new(bus: Bus, name: String) -> Self {
+        let ltecoex = Ltecoex { ctrl: LTECOEX_ACCESS_CTRL, wdata: LTECOEX_WRITE_DATA, rdata: LTECOEX_READ_DATA };
+        let mut chip = Self { bus, name, cut: 0, rf_paths: 1, wcpu_8051: false, ltecoex };
+        let version = chip.r32(REG_SYS_CFG1);
+        chip.cut = field(version, BITS_CHIP_VER) as u8;
+        chip.rf_paths = if version & BIT_RF_TYPE_ID != 0 { 2 } else { 1 };
+        chip
+    }
+
+    pub(crate) fn present(&self) -> bool {
+        if let Bus::Usb(usb) = &self.bus
+            && usb.gone()
+        {
+            return false;
+        }
+        self.r32(REG_SYS_CFG1) != u32::MAX
+    }
+
+    /// On USB rather than PCIe.
+    pub(crate) fn usb(&self) -> bool {
+        matches!(self.bus, Bus::Usb(_))
+    }
+
+    /// Bytes from `addr` on in one USB request (the 8051's firmware pages);
+    /// false on PCIe.
+    pub(crate) fn write_block(&self, addr: u32, data: &[u8]) -> bool {
+        match &self.bus {
+            Bus::Usb(usb) => usb.write_block(addr, data),
+            Bus::Mmio(_) => false,
+        }
+    }
+
+    // ---- Registers. ----
+
+    pub(crate) fn r8(&self, addr: u32) -> u8 {
+        match &self.bus {
+            Bus::Mmio(mmio) => mmio.read_once::<u8>(addr as usize).unwrap_or(u8::MAX),
+            Bus::Usb(usb) => usb.read(addr, 1) as u8,
+        }
+    }
+
+    pub(crate) fn r16(&self, addr: u32) -> u16 {
+        match &self.bus {
+            Bus::Mmio(mmio) => mmio.read_once::<u16>(addr as usize).unwrap_or(u16::MAX),
+            Bus::Usb(usb) => usb.read(addr, 2) as u16,
+        }
+    }
+
+    pub(crate) fn r32(&self, addr: u32) -> u32 {
+        match &self.bus {
+            Bus::Mmio(mmio) => mmio.read_once::<u32>(addr as usize).unwrap_or(u32::MAX),
+            Bus::Usb(usb) => usb.read(addr, 4),
+        }
+    }
+
+    pub(crate) fn w8(&self, addr: u32, value: u8) {
+        match &self.bus {
+            Bus::Mmio(mmio) => {
+                let _ = mmio.write_once::<u8>(addr as usize, value);
+            }
+            Bus::Usb(usb) => usb.write(addr, value as u32, 1),
+        }
+    }
+
+    pub(crate) fn w16(&self, addr: u32, value: u16) {
+        match &self.bus {
+            Bus::Mmio(mmio) => {
+                let _ = mmio.write_once::<u16>(addr as usize, value);
+            }
+            Bus::Usb(usb) => usb.write(addr, value as u32, 2),
+        }
+    }
+
+    pub(crate) fn w32(&self, addr: u32, value: u32) {
+        match &self.bus {
+            Bus::Mmio(mmio) => {
+                let _ = mmio.write_once::<u32>(addr as usize, value);
+            }
+            Bus::Usb(usb) => usb.write(addr, value, 4),
+        }
+    }
+
+    pub(crate) fn set8(&self, addr: u32, bits: u32) {
+        self.w8(addr, self.r8(addr) | bits as u8);
+    }
+
+    pub(crate) fn clr8(&self, addr: u32, bits: u32) {
+        self.w8(addr, self.r8(addr) & !(bits as u8));
+    }
+
+    pub(crate) fn set16(&self, addr: u32, bits: u32) {
+        self.w16(addr, self.r16(addr) | bits as u16);
+    }
+
+    pub(crate) fn set32(&self, addr: u32, bits: u32) {
+        self.w32(addr, self.r32(addr) | bits);
+    }
+
+    pub(crate) fn clr32(&self, addr: u32, bits: u32) {
+        self.w32(addr, self.r32(addr) & !bits);
+    }
+
+    pub(crate) fn r32_mask(&self, addr: u32, mask: u32) -> u32 {
+        field(self.r32(addr), mask)
+    }
+
+    pub(crate) fn w32_mask(&self, addr: u32, mask: u32, value: u32) {
+        let shift = mask.trailing_zeros();
+        self.w32(addr, (self.r32(addr) & !mask) | ((value << shift) & mask));
+    }
+
+    pub(crate) fn w8_mask(&self, addr: u32, mask: u32, value: u32) {
+        let shift = mask.trailing_zeros();
+        self.w8(addr, ((self.r8(addr) as u32 & !mask) | ((value << shift) & mask)) as u8);
+    }
+
+    /// Linux's `check_hw_ready`: the field reaches `target` within 10 ms.
+    pub(crate) fn ready(&self, addr: u32, mask: u32, target: u32) -> bool {
+        for _ in 0..1000 {
+            if self.r32_mask(addr, mask) == target {
+                return true;
+            }
+            crate::delay_us(10);
+        }
+        false
+    }
+
+    // ---- Power. ----
+
+    /// Linux's `rtw_pwr_seq_parser`: the bus's steps.
+    pub(crate) fn power_sequence(&self, flow: &[&[PwrCmd]]) -> Result<(), String> {
+        let cut_mask = 1u8 << (self.cut + 1);
+        let usb = self.usb();
+        let intf_mask = if usb { crate::usb::RTW_PWR_INTF_USB_MSK } else { RTW_PWR_INTF_PCI_MSK } as u8;
+        for steps in flow {
+            for step in steps.iter() {
+                if step.cmd == RTW_PWR_CMD_END as u8 {
+                    break;
+                }
+                // The bus's steps (an SDIO-local address is not reachable here).
+                if step.intf_mask & intf_mask == 0 || step.cut_mask & cut_mask == 0 || step.base as u32 == RTW_PWR_ADDR_SDIO {
+                    continue;
+                }
+                let offset = step.offset as u32;
+                match step.cmd as u32 {
+                    RTW_PWR_CMD_WRITE => {
+                        let value = (self.r8(offset) & !step.mask) | (step.value & step.mask);
+                        self.w8(offset, value);
+                    }
+                    RTW_PWR_CMD_POLLING => {
+                        if !self.power_poll(offset, step.mask, step.value) {
+                            if usb {
+                                return Err(alloc::format!("power sequence: {offset:#x} & {:#x} did not become {:#x}", step.mask, step.value));
+                            }
+                            // PCIe: toggle BIT_PFM_WOWL and try again.
+                            let value = self.r8(REG_SYS_PW_CTRL);
+                            self.w8(REG_SYS_PW_CTRL, value | BIT_PFM_WOWL as u8);
+                            self.w8(REG_SYS_PW_CTRL, value & !(BIT_PFM_WOWL as u8));
+                            if !self.power_poll(offset, step.mask, step.value) {
+                                return Err(alloc::format!("power sequence: {offset:#x} & {:#x} did not become {:#x}", step.mask, step.value));
+                            }
+                        }
+                    }
+                    RTW_PWR_CMD_DELAY => {
+                        if step.value as u32 == RTW_PWR_DELAY_US {
+                            crate::delay_us(step.offset as u64);
+                        } else {
+                            crate::delay_ms(step.offset as u64);
+                        }
+                    }
+                    _ => {}
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn power_poll(&self, offset: u32, mask: u8, target: u8) -> bool {
+        for _ in 0..RTW_PWR_POLLING_CNT {
+            if self.r8(offset) & mask == target & mask {
+                return true;
+            }
+            crate::delay_us(50);
+        }
+        false
+    }
+
+    /// Linux's `rtw_mac_pre_system_cfg` (PCIe): the 8051 CPU's chips choose
+    /// their regulator only.
+    pub(crate) fn pre_system_cfg(&self) {
+        self.w8(REG_RSV_CTRL, 0);
+        if self.wcpu_8051 {
+            let regulator = if self.r32(REG_SYS_CFG1) & BIT_LDO != 0 { LDO_SEL } else { SPS_SEL };
+            self.w8(REG_LDO_SWR_CTRL, regulator as u8);
+            return;
+        }
+        if !self.usb() {
+            self.set32(REG_HCI_OPT_CTRL, BIT_USB_SUS_DIS);
+        }
+        self.set32(REG_PAD_CTRL1, BIT_PAPE_WLBT_SEL | BIT_LNAON_WLBT_SEL);
+        self.clr32(REG_LED_CFG, BIT_PAPE_SEL_EN | BIT_LNAON_SEL_EN);
+        self.set32(REG_GPIO_MUXCFG, BIT_WLRFE_4_5_EN);
+        // BB and RF off.
+        self.clr8(REG_SYS_FUNC_EN, BIT_FEN_BB_RSTB | BIT_FEN_BB_GLB_RST);
+        self.clr8(REG_RF_CTRL, BIT_RF_SDM_RSTB | BIT_RF_RSTB | BIT_RF_EN);
+        self.clr32(REG_WLRF1, BIT_WLRF1_BBRF_EN);
+    }
+
+    /// Whether the MAC is powered (`rtw_mac_power_switch`'s check), after
+    /// the 3081 firmware's RPWM toggle when one runs.
+    pub(crate) fn powered(&self) -> bool {
+        let usb = self.usb();
+        if !self.wcpu_8051 {
+            let rpwm_addr = if usb { crate::usb::RPWM_ADDR_USB } else { RPWM_ADDR };
+            let rpwm = self.r8(rpwm_addr);
+            if self.r16(REG_MCUFW_CTRL) == 0xc078 {
+                self.w8(rpwm_addr, (rpwm ^ BIT_RPWM_TOGGLE as u8) & BIT_RPWM_TOGGLE as u8);
+            }
+        }
+        if self.r8(REG_CR) == 0xea {
+            return false;
+        }
+        // USB: the chip says it is off (`rtw_mac_power_switch`).
+        !(usb && self.r8(crate::usb::REG_SYS_STATUS1 + 1) & 1 != 0)
+    }
+
+    /// Linux's `__rtw_mac_init_system_cfg`, or `_legacy` on the 8051 CPU's
+    /// chips.
+    pub(crate) fn init_system_cfg(&self, sys_func_en: u8) {
+        if self.wcpu_8051 {
+            self.w8(REG_CR, 0xff);
+            crate::delay_ms(2);
+            self.w8(REG_HWSEQ_CTRL, 0x7f);
+            crate::delay_ms(2);
+            self.set8(REG_SYS_CLKR, BIT_WAKEPAD_EN);
+            self.w16(REG_GPIO_MUXCFG, self.r16(REG_GPIO_MUXCFG) & !(BIT_EN_SIC as u16));
+            self.w16(REG_CR, 0x2ff);
+            return;
+        }
+        self.set32(REG_CPU_DMEM_CON, BIT_WL_PLATFORM_RST | BIT_DDMA_EN);
+        self.set8(REG_SYS_FUNC_EN + 1, sys_func_en as u32);
+        let value = (self.r8(REG_CR_EXT + 3) & 0xf0) | 0x0c;
+        self.w8(REG_CR_EXT + 3, value);
+        let fw = self.r32(REG_MCUFW_CTRL);
+        if fw & BIT_BOOT_FSPI_EN != 0 {
+            self.w32(REG_MCUFW_CTRL, fw & !BIT_BOOT_FSPI_EN);
+            self.clr32(REG_GPIO_MUXCFG, BIT_FSPI_EN);
+        }
+    }
+
+    // ---- Efuse. ----
+
+    /// The physical efuse and its logical map (Linux's
+    /// `rtw_dump_physical_efuse_map`, `rtw_dump_logical_efuse_map`).
+    pub(crate) fn read_efuse(&self, physical: usize, logical: usize, protect: usize, ldo25: impl Fn(&Self, bool)) -> Result<(Vec<u8>, Vec<u8>), String> {
+        self.w32_mask(REG_LDO_EFUSE_CTRL, BIT_MASK_EFUSE_BANK_SEL, 0);
+        ldo25(self, false);
+        let mut map = vec![0u8; physical];
+        let mut control = self.r32(REG_EFUSE_CTRL);
+        for (addr, byte) in map.iter_mut().enumerate() {
+            control &= !(BIT_MASK_EF_DATA | BITS_EF_ADDR);
+            control |= (addr as u32 & BIT_MASK_EF_ADDR) << BIT_SHIFT_EF_ADDR;
+            self.w32(REG_EFUSE_CTRL, control & !BIT_EF_FLAG);
+            let mut tries = 0;
+            loop {
+                crate::delay_us(1);
+                control = self.r32(REG_EFUSE_CTRL);
+                if control & BIT_EF_FLAG != 0 {
+                    break;
+                }
+                tries += 1;
+                if tries > 100_000 {
+                    return Err(String::from("the efuse did not answer"));
+                }
+            }
+            *byte = (control & BIT_MASK_EF_DATA) as u8;
+        }
+        let mut log = vec![0xffu8; logical];
+        let mut at = 0;
+        while at + 1 < physical - protect {
+            let (hdr1, hdr2) = (map[at], map[at + 1]);
+            if hdr1 == 0xff || (hdr1 & 0x1f == 0x0f && hdr2 == 0xff) {
+                break;
+            }
+            let (block, word_en) = if hdr1 & 0x1f == 0x0f {
+                at += 2;
+                ((((hdr2 & 0xf0) >> 1) | ((hdr1 >> 5) & 0x07)) as usize, hdr2 & 0xf)
+            } else {
+                at += 1;
+                (((hdr1 & 0xf0) >> 4) as usize, hdr1 & 0xf)
+            };
+            for word in 0..4 {
+                if word_en & (1 << word) != 0 {
+                    continue;
+                }
+                let index = (block << 3) + (word << 1);
+                if at + 1 > physical - protect || index + 1 > logical {
+                    return Err(String::from("the efuse's map is broken"));
+                }
+                log[index] = map[at];
+                log[index + 1] = map[at + 1];
+                at += 2;
+            }
+        }
+        Ok((map, log))
+    }
+
+    // ---- RF. ----
+
+    /// Linux's `rtw_phy_read_rf`: the RF register through its direct window.
+    pub(crate) fn read_rf(&self, base: u32, addr: u32, mask: u32) -> u32 {
+        self.r32_mask(base + ((addr & 0xff) << 2), mask & RFREG_MASK)
+    }
+
+    /// Linux's `rtw_phy_write_rf_reg_sipi`: a whole RF register (the
+    /// caller merges a masked write with what [`crate::hw::Hw::read_rf_path`]
+    /// reads).
+    pub(crate) fn write_rf_sipi(&self, sipi: u32, addr: u32, data: u32) {
+        self.w32(sipi, (((addr & 0xff) << 20) | (data & 0x000f_ffff)) & 0x0fff_ffff);
+        crate::delay_us(13);
+    }
+
+    /// Linux's `rtw_phy_read_rf_sipi`: the 11n chips' RF read, the address
+    /// through the path's HSSI, path A's read edge toggled, the data from
+    /// the LSSI (or its PI register).
+    pub(crate) fn read_rf_sipi(&self, read: &[SipiRead; 2], path: usize, addr: u32, mask: u32) -> u32 {
+        let (own, a) = (&read[path], &read[0]);
+        let value = (self.r32(own.hssi_2) & !LSSI_READ_ADDR_MASK) | ((addr & 0xff) << 23);
+        self.w32(own.hssi_2, value);
+        let edge = self.r32(a.hssi_2);
+        self.w32(a.hssi_2, edge & !LSSI_READ_EDGE_MASK);
+        self.w32(a.hssi_2, edge | LSSI_READ_EDGE_MASK);
+        crate::delay_us(120);
+        let pi = self.r32(own.hssi_1) & (1 << 8) != 0;
+        let data = self.r32_mask(if pi { own.lssi_read_pi } else { own.lssi_read }, LSSI_READ_DATA_MASK);
+        field(data, mask)
+    }
+
+    // ---- The LTE coexistence window (`ltecoex_read_reg`). ----
+
+    pub(crate) fn ltecoex_read(&self, offset: u16) -> Option<u32> {
+        if !self.ready(self.ltecoex.ctrl, LTECOEX_READY, 1) {
+            return None;
+        }
+        self.w32(self.ltecoex.ctrl, 0x800f_0000 | offset as u32);
+        Some(self.r32(self.ltecoex.rdata))
+    }
+
+    pub(crate) fn ltecoex_write(&self, offset: u16, value: u32) -> bool {
+        if !self.ready(self.ltecoex.ctrl, LTECOEX_READY, 1) {
+            return false;
+        }
+        self.w32(self.ltecoex.wdata, value);
+        self.w32(self.ltecoex.ctrl, 0xc00f_0000 | offset as u32);
+        true
+    }
+
+    /// `rtw_coex_write_indirect_reg`.
+    pub(crate) fn ltecoex_write_mask(&self, offset: u16, mask: u32, value: u32) {
+        let old = self.ltecoex_read(offset).unwrap_or(0);
+        let new = (old & !mask) | ((value << mask.trailing_zeros()) & mask);
+        if !self.ltecoex_write(offset, new) {
+            ostd::warn!("{}: an LTE coexistence register did not take its value", self.name);
+        }
+    }
+
+    // ---- PCIe PHY (`rtw_mdio_write`, `rtw_dbi_write8`). ----
+
+    pub(crate) fn mdio_write(&self, addr: u8, data: u16, g1: bool) {
+        self.w16(REG_MDIO_V1, data);
+        let mut page = if (addr as u32) < RTW_PCI_MDIO_PG_SZ { 0 } else { 1 };
+        page += if g1 { RTW_PCI_MDIO_PG_OFFS_G1 } else { RTW_PCI_MDIO_PG_OFFS_G2 };
+        self.w8(REG_PCIE_MIX_CFG, addr & BITS_MDIO_ADDR_MASK as u8);
+        self.w8(REG_PCIE_MIX_CFG + 3, page as u8);
+        self.w32_mask(REG_PCIE_MIX_CFG, BIT_MDIO_WFLAG_V1, 1);
+        for _ in 0..RTW_PCI_WR_RETRY_CNT {
+            if self.r32_mask(REG_PCIE_MIX_CFG, BIT_MDIO_WFLAG_V1) == 0 {
+                return;
+            }
+            crate::delay_us(10);
+        }
+    }
+
+    pub(crate) fn dbi_write8(&self, addr: u16, data: u8) {
+        let remainder = addr as u32 & !(BITS_DBI_WREN | BITS_DBI_ADDR_MASK);
+        let write = (addr as u32 & BITS_DBI_ADDR_MASK) | (((1u32 << remainder) << BITS_DBI_WREN.trailing_zeros()) & BITS_DBI_WREN);
+        self.w8(REG_DBI_WDATA_V1 + remainder, data);
+        self.w16(REG_DBI_FLAG_V1, write as u16);
+        self.w8(REG_DBI_FLAG_V1 + 2, (BIT_DBI_WFLAG >> 16) as u8);
+        for _ in 0..RTW_PCI_WR_RETRY_CNT {
+            if self.r8(REG_DBI_FLAG_V1 + 2) == 0 {
+                return;
+            }
+            crate::delay_us(10);
+        }
+    }
+}
+
+/// The RPWM register of PCIe (`rtw_chip_parameter_setup`).
+pub(crate) const RPWM_ADDR: u32 = 0x03d9;
diff --git a/kernel/comps/rtw88/src/hci.rs b/kernel/comps/rtw88/src/hci.rs
new file mode 100644
index 0000000..9e26798
--- /dev/null
+++ b/kernel/comps/rtw88/src/hci.rs
@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The bus a chip is on (Linux's `rtw_hci_ops`): PCIe ([`crate::pci`]) or
+//! USB ([`crate::usb`]), behind the same operations.
+
+use alloc::vec::Vec;
+
+use crate::{
+    chip::Chip,
+    pci::{Pci, TxInfo},
+    usb::Usb,
+};
+
+pub(crate) enum Hci {
+    Pci(Pci),
+    Usb(Usb),
+}
+
+impl Hci {
+    pub(crate) fn is_usb(&self) -> bool {
+        matches!(self, Self::Usb(_))
+    }
+
+    /// The bulk OUT endpoints (USB), which choose the queues' tables.
+    pub(crate) fn bulk_out(&self) -> Option<usize> {
+        match self {
+            Self::Pci(_) => None,
+            Self::Usb(usb) => Some(usb.bulk_out()),
+        }
+    }
+
+    /// The USB device's xHCI speed.
+    pub(crate) fn usb_speed(&self) -> Option<u32> {
+        match self {
+            Self::Pci(_) => None,
+            Self::Usb(usb) => Some(usb.speed),
+        }
+    }
+
+    pub(crate) fn tx_desc(&self) -> usize {
+        match self {
+            Self::Pci(pci) => pci.tx_desc(),
+            Self::Usb(usb) => usb.tx_desc(),
+        }
+    }
+
+    pub(crate) fn setup(&mut self, chip: &Chip) {
+        match self {
+            Self::Pci(pci) => pci.setup(chip),
+            Self::Usb(usb) => usb.setup(),
+        }
+    }
+
+    /// The receive path started once the chip is up (USB's reads).
+    pub(crate) fn start_rx(&mut self) {
+        if let Self::Usb(usb) = self {
+            usb.start_rx();
+        }
+    }
+
+    pub(crate) fn enable_interrupts(&self, chip: &Chip) {
+        if let Self::Pci(pci) = self {
+            pci.enable_interrupts(chip);
+        }
+    }
+
+    pub(crate) fn disable_interrupts(&self, chip: &Chip) {
+        if let Self::Pci(pci) = self {
+            pci.disable_interrupts(chip);
+        }
+    }
+
+    /// The PCIe interrupt status, cleared (none on USB).
+    pub(crate) fn interrupts(&self, chip: &Chip) -> [u32; 4] {
+        match self {
+            Self::Pci(pci) => pci.interrupts(chip),
+            Self::Usb(_) => [0; 4],
+        }
+    }
+
+    /// Whether frames went out since the last call (USB: transfers ended).
+    pub(crate) fn tx_progress(&mut self) -> bool {
+        match self {
+            Self::Pci(_) => false,
+            Self::Usb(usb) => usb.tx_progress(),
+        }
+    }
+
+    /// A frame on a TX queue (`queue`: the PCIe ring; USB takes the
+    /// descriptor's queue selector).
+    pub(crate) fn write(&mut self, chip: &Chip, queue: usize, info: &TxInfo, data: &[u8]) -> Result<(), ()> {
+        match self {
+            Self::Pci(pci) => pci.write(chip, queue, info, data),
+            Self::Usb(usb) => usb.write(info, data),
+        }
+    }
+
+    pub(crate) fn write_rsvd_page(&mut self, chip: &Chip, info: &TxInfo, data: &[u8]) -> Result<(), ()> {
+        match self {
+            Self::Pci(pci) => pci.write_rsvd_page(chip, info, data),
+            Self::Usb(usb) => usb.write_now(info, data),
+        }
+    }
+
+    pub(crate) fn write_h2c(&mut self, chip: &Chip, packet: &[u8]) -> Result<(), ()> {
+        match self {
+            Self::Pci(pci) => pci.write_h2c(chip, packet),
+            Self::Usb(usb) => {
+                let info = TxInfo { qsel: crate::regs::TX_DESC_QSEL_H2C as u8, ..TxInfo::default() };
+                usb.write_now(&info, packet)
+            }
+        }
+    }
+
+    pub(crate) fn receive(&mut self, chip: &Chip) -> Vec<Vec<u8>> {
+        match self {
+            Self::Pci(pci) => pci.receive(chip),
+            Self::Usb(usb) => usb.receive(),
+        }
+    }
+
+    /// Ends what the bus has pending (USB's transfers).
+    pub(crate) fn stop(&mut self) {
+        if let Self::Usb(usb) = self {
+            usb.stop();
+        }
+    }
+}
diff --git a/kernel/comps/rtw88/src/hw.rs b/kernel/comps/rtw88/src/hw.rs
new file mode 100644
index 0000000..bce8452
--- /dev/null
+++ b/kernel/comps/rtw88/src/hw.rs
@@ -0,0 +1,1967 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The chip brought up as Linux's rtw88 does it (`rtw_power_on`): MAC
+//! power, firmware download through the reserved pages, the TX/RX FIFOs and
+//! the H2C queue, the MAC's protocol settings, the PHY tables, the channel,
+//! the TX power, the BT coexistence's antenna and the firmware's commands
+//! (H2C). What differs between chips is in each chip's module
+//! ([`crate::rtw8821c`], [`crate::rtw8822b`], [`crate::rtw8822c`],
+//! [`crate::rtw8723d`]) and its [`Spec`], as Linux's `rtw_chip_info` and
+//! `rtw_chip_ops`. The RTL8723D's 8051 CPU takes the older ways Linux keeps
+//! for it (`rtw_chip_wcpu_8051`): its firmware written page by page, the
+//! FIFO's pages without the H2C queue, no general and PHY information.
+
+use alloc::{format, string::String, vec::Vec};
+
+use aster_wlan::{
+    ieee80211 as wifi,
+    radio::{Chandef, Width},
+};
+
+use crate::{
+    chip::{Chip, IntfPara, Ltecoex, PwrCmd, SipiRead},
+    hci::Hci,
+    pci::TxInfo,
+    usb as usbreg,
+    regs::*,
+    tables,
+};
+
+/// RF 0x18's width of the RTL8821C and RTL8822B (`RF18_BW_*`).
+pub(crate) const RF18_BW_40M: u32 = 1 << 11;
+pub(crate) const RF18_BW_80M: u32 = 1 << 10;
+/// How many times leaving power save is checked, 20 ms apart
+/// (`LEAVE_LPS_TRY_CNT`).
+const LEAVE_LPS_TRIES: u32 = 5;
+/// The MAC's beacon interval of port 0, in TU (Realtek's `BCN_INTERVAL`,
+/// the "beacon space" of the 88xx MACs; rtw88 leaves its reset value).
+const REG_BCN_INTERVAL: u32 = 0x0554;
+
+/// A channel as the chips tune to it (`struct rtw_channel_params` and
+/// `rtw_update_channel`): the centre channel (what the chips' code is
+/// given), the primary one, the width, where the primary 20 MHz channel
+/// sits in it (`RTW_SC_*`).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Tune {
+    pub(crate) center: u8,
+    pub(crate) primary: u8,
+    pub(crate) bw: u32,
+    pub(crate) pri_idx: u8,
+}
+
+impl Tune {
+    pub(crate) fn simple(channel: u8) -> Self {
+        Self { center: channel, primary: channel, bw: RTW_CHANNEL_WIDTH_20, pri_idx: RTW_SC_DONT_CARE as u8 }
+    }
+
+    /// `rtw_get_channel_params`: 40 and 80 MHz (wider spans run at 80).
+    pub(crate) fn of(chandef: &Chandef) -> Self {
+        let primary = wifi::channel_of(chandef.control).unwrap_or(1);
+        let (bw, center_freq) = match chandef.width {
+            Width::W40 => (RTW_CHANNEL_WIDTH_40, chandef.center),
+            Width::W80 | Width::W160 => (RTW_CHANNEL_WIDTH_80, chandef.center_80()),
+            _ => return Self::simple(primary),
+        };
+        let center = wifi::channel_of(center_freq).unwrap_or(primary);
+        let (control, center_freq) = (chandef.control as i32, center_freq as i32);
+        let pri_idx = match (bw == RTW_CHANNEL_WIDTH_40, control > center_freq, (control - center_freq).abs() == 10) {
+            (true, true, _) => RTW_SC_20_UPPER,
+            (true, false, _) => RTW_SC_20_LOWER,
+            (false, true, true) => RTW_SC_20_UPPER,
+            (false, true, false) => RTW_SC_20_UPMOST,
+            (false, false, true) => RTW_SC_20_LOWER,
+            (false, false, false) => RTW_SC_20_LOWEST,
+        };
+        Self { center, primary, bw, pri_idx: pri_idx as u8 }
+    }
+}
+
+/// The parts of the efuse the driver uses (`struct rtw_efuse`, from the
+/// chip's `struct rtw88xx_efuse`).
+#[derive(Clone)]
+pub(crate) struct Efuse {
+    pub(crate) address: [u8; 6],
+    pub(crate) rfe_option: u8,
+    pub(crate) rf_board_option: u8,
+    pub(crate) crystal_cap: u8,
+    pub(crate) bt_setting: u8,
+    pub(crate) tx_bb_swing_2g: u8,
+    pub(crate) tx_bb_swing_5g: u8,
+    pub(crate) pkg_type: u8,
+    pub(crate) rfe_btg: bool,
+    pub(crate) share_ant: bool,
+    pub(crate) btcoex: bool,
+    /// The RTL8723D's AFE option (`efuse->afe`).
+    pub(crate) afe: u8,
+    /// Each path's TX power index table (`struct rtw_txpwr_idx`, 42 bytes).
+    pub(crate) txpwr: [[u8; 42]; 2],
+}
+
+impl Default for Efuse {
+    fn default() -> Self {
+        Self {
+            address: [0; 6],
+            rfe_option: 0,
+            rf_board_option: 0,
+            crystal_cap: 0,
+            bt_setting: 0,
+            tx_bb_swing_2g: 0,
+            tx_bb_swing_5g: 0,
+            pkg_type: 0,
+            rfe_btg: false,
+            share_ant: false,
+            btcoex: false,
+            afe: 0,
+            txpwr: [[0; 42]; 2],
+        }
+    }
+}
+
+/// An RFE type's tables (`struct rtw_rfe_def`): the TX power by rate per
+/// path, its worldwide limits (both less each rate section's base), and the
+/// AGC table added for an antenna shared with Bluetooth.
+pub(crate) struct RfeTables {
+    pub(crate) offset_2g: &'static [[i8; 84]; 2],
+    pub(crate) offset_5g: &'static [[i8; 84]; 2],
+    pub(crate) limit_2g: &'static [[i8; 14]; 10],
+    pub(crate) limit_5g: &'static [[i8; 49]; 10],
+    pub(crate) agc_btg: Option<&'static [u32]>,
+}
+
+/// The chip models.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub(crate) enum Model {
+    Rtl8821c,
+    Rtl8822b,
+    Rtl8822c,
+    Rtl8723d,
+}
+
+/// A chip's facts (`struct rtw_chip_info`).
+pub(crate) struct Spec {
+    pub(crate) firmware: &'static str,
+    pub(crate) sys_func_en: u8,
+    /// The efuse's physical, logical and protected sizes.
+    pub(crate) efuse_sizes: (usize, usize, usize),
+    pub(crate) txff_size: u32,
+    pub(crate) rxff_size: u32,
+    /// The PCIe page table: high, normal, low, extra queue, gap.
+    pub(crate) pages: [u32; 5],
+    pub(crate) power_on: &'static [&'static [PwrCmd]],
+    pub(crate) power_off: &'static [&'static [PwrCmd]],
+    pub(crate) pcie_gen1: &'static [IntfPara],
+    pub(crate) pcie_gen2: &'static [IntfPara],
+    pub(crate) mac: &'static [u32],
+    pub(crate) bb: &'static [u32],
+    pub(crate) agc: &'static [u32],
+    pub(crate) rf: [&'static [u32]; 2],
+    pub(crate) rf_base: [u32; 2],
+    pub(crate) rf_sipi: [u32; 2],
+    /// The RFE types Linux supports, and each one's tables.
+    pub(crate) rfes: &'static [u8],
+    pub(crate) rfe_tables: fn(u8) -> Option<RfeTables>,
+    /// The coexistence tables (`table_sant`, `table_nsant`): the cases the
+    /// driver uses, 0 to 2.
+    pub(crate) coex_sant: [(u32, u32); 3],
+    pub(crate) coex_nsant: [(u32, u32); 3],
+    /// The FIFO's pages for the driver and the CSI buffer.
+    pub(crate) rsvd_drv_pages: u32,
+    pub(crate) csi_pages: u32,
+    /// TX power indexes: the largest, and the efuse's step
+    /// (`max_power_index`, `txgi_factor`).
+    pub(crate) max_power_index: i32,
+    pub(crate) txgi_factor: i32,
+    /// Where the PCIe card's MAC address is in the logical efuse, and the
+    /// crystal capacitance's bits.
+    pub(crate) mac_offset: usize,
+    pub(crate) crystal_mask: u8,
+    /// The RF calibrations' initial table (`rfk_init_tbl`).
+    pub(crate) rfk_init: &'static [u32],
+    /// RF writes through the direct window but for register 0
+    /// (`rtw_phy_write_rf_reg_mix`).
+    pub(crate) rf_direct: bool,
+    /// DPD off on every rate (`en_dis_dpd`, `DIS_DPD_RATEALL`): those rates'
+    /// power 6 dB lower (`rtw_phy_get_dis_dpd_by_rate_diff`).
+    pub(crate) dpd_disabled: bool,
+    /// The CPU an 8051 (`RTW_WCPU_8051`) rather than a 3081.
+    pub(crate) wcpu_8051: bool,
+    /// The TX descriptor's size (`tx_pkt_desc_sz`), and its rate fallback
+    /// limit set (`old_datarate_fb_limit`).
+    pub(crate) tx_desc: usize,
+    pub(crate) old_datarate_fb_limit: bool,
+    /// 5 GHz as well as 2.4 GHz (`RTW_BAND_5G`).
+    pub(crate) band_5g: bool,
+    /// The 11n chips' RF reads through the LSSI (`rf_sipi_read_addr`); the
+    /// others read the RF's direct window at `rf_base`.
+    pub(crate) sipi_read: Option<[SipiRead; 2]>,
+    /// The LTE coexistence window (`ltecoex_addr`).
+    pub(crate) ltecoex: Ltecoex,
+    /// The register and bit that give the BT-shared antenna to WLAN with
+    /// the coexistence's control (`btg_reg`).
+    pub(crate) btg_reg: Option<(u32, u32)>,
+    /// The HT capability's A-MPDU spacing (`ampdu_density`).
+    pub(crate) ampdu_density: u8,
+    /// On USB: the MAC address in the logical efuse, the page tables for
+    /// two, three and four bulk OUT endpoints (`page_table[2..=4]`), the
+    /// USB 3 PHY's parameters, the TX descriptor's checksum (its 16-bit
+    /// words, inverted) and the TX aggregates' descriptors
+    /// (`usb_tx_agg_desc_num`).
+    pub(crate) usb_mac_offset: usize,
+    pub(crate) usb_pages: [[u32; 5]; 3],
+    pub(crate) usb3_para: &'static [IntfPara],
+    pub(crate) usb_checksum: (usize, bool),
+    pub(crate) usb_tx_agg_desc_num: u8,
+}
+
+/// The 11ac chips' LTE window, and the 11n chips' (`rtw8723x_common`).
+const LTECOEX_88XX: Ltecoex = Ltecoex { ctrl: LTECOEX_ACCESS_CTRL, wdata: LTECOEX_WRITE_DATA, rdata: LTECOEX_READ_DATA };
+const LTECOEX_8723X: Ltecoex = Ltecoex { ctrl: REG_LTECOEX_CTRL, wdata: REG_LTECOEX_WRITE_DATA, rdata: REG_LTECOEX_READ_DATA };
+/// The 11n chips' RF read registers of paths A and B (`rf_sipi_addr`).
+const SIPI_READ_8723X: [SipiRead; 2] = [
+    SipiRead { hssi_1: 0x820, hssi_2: 0x824, lssi_read: 0x8a0, lssi_read_pi: 0x8b8 },
+    SipiRead { hssi_1: 0x828, hssi_2: 0x82c, lssi_read: 0x8a4, lssi_read_pi: 0x8bc },
+];
+/// `IEEE80211_HT_MPDU_DENSITY_2` and `_16`.
+const MPDU_DENSITY_2US: u8 = 4;
+const MPDU_DENSITY_16US: u8 = 7;
+/// The TX descriptor Linux's `send_firmware_pkt` counts (`TX_DESC_SIZE`).
+const TX_DESC_SIZE_88XX: usize = 48;
+
+static SPEC_8821C: Spec = Spec {
+    firmware: "rtw88/rtw8821c_fw.bin",
+    sys_func_en: 0xd8,
+    efuse_sizes: (512, 512, 96),
+    txff_size: 65536,
+    rxff_size: 16384,
+    pages: [16, 16, 16, 14, 1],
+    power_on: &tables::CARD_ENABLE_FLOW_8821C,
+    power_off: &tables::CARD_DISABLE_FLOW_8821C,
+    pcie_gen1: &tables::PCIE_GEN1_8821C,
+    pcie_gen2: &tables::PCIE_GEN2_8821C,
+    mac: &tables::MAC_8821C,
+    bb: &tables::BB_8821C,
+    agc: &tables::AGC_8821C,
+    rf: [&tables::RF_A_8821C, &[]],
+    rf_base: [0x2800, 0x2c00],
+    rf_sipi: [0xc90, 0xe90],
+    rfes: &tables::RFE_8821C,
+    rfe_tables: tables::rfe_8821c,
+    coex_sant: [(0x5555_5555, 0x5555_5555), (0x5555_5555, 0x5555_5555), (0x6655_5555, 0x6655_5555)],
+    coex_nsant: [(0xffff_ffff, 0xffff_ffff), (0xffff_55ff, 0xfafa_fafa), (0x6655_5555, 0x6655_5555)],
+    rsvd_drv_pages: 8,
+    csi_pages: 0,
+    max_power_index: 0x3f,
+    txgi_factor: 1,
+    mac_offset: 0xd0,
+    crystal_mask: 0xff,
+    rfk_init: &[],
+    rf_direct: false,
+    dpd_disabled: false,
+    wcpu_8051: false,
+    tx_desc: 48,
+    old_datarate_fb_limit: false,
+    band_5g: true,
+    sipi_read: None,
+    ltecoex: LTECOEX_88XX,
+    btg_reg: None,
+    ampdu_density: MPDU_DENSITY_2US,
+    usb_mac_offset: 0x107,
+    usb_pages: [[16, 16, 0, 0, 1], [16, 16, 16, 0, 1], [16, 16, 16, 14, 1]],
+    usb3_para: &[],
+    usb_checksum: (16, false),
+    usb_tx_agg_desc_num: 3,
+};
+
+static SPEC_8822B: Spec = Spec {
+    firmware: "rtw88/rtw8822b_fw.bin",
+    sys_func_en: 0xdc,
+    efuse_sizes: (1024, 768, 96),
+    txff_size: 262144,
+    rxff_size: 24576,
+    pages: [64, 64, 64, 64, 1],
