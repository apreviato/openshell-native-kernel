+// SPDX-License-Identifier: MPL-2.0
+
+//! The interface as mac80211 runs it over rtw88: as a station, a software
+//! scan (the channel, probe requests, a dwell, the next channel) and the
+//! access point's rates for the firmware's rate adaptation; as an access
+//! point, port 0 beaconing from the reserved page and each station's MAC
+//! ID and rates; keys in the security CAM, and frames with their TX and
+//! RX descriptors. The driver puts the CCMP header on data frames
+//! (`IEEE80211_KEY_FLAG_GENERATE_IV`); the chip encrypts.
+
+use alloc::{collections::BTreeMap, string::String, sync::Arc, vec, vec::Vec};
+
+use aster_wlan::{
+    Device,
+    chan,
+    ieee80211::{self as wifi, Address},
+    radio::{self, ApConfig, Association, Band, BandId, BeaconTemplate, BlockAck, HtCap, Info, Join, Key, Peer, Reorder, RxInfo, ScanRequest, StationEntry, VhtCap},
+};
+
+use crate::{
+    hw::{Hw, Model, Tune},
+    pci::{QUEUE_BE, QUEUE_BK, QUEUE_MGMT, QUEUE_VI, QUEUE_VO, TxInfo},
+    regs::*,
+};
+
+/// The RX descriptor's TKIP types (`enum rtw_rx_desc_enc`).
+const RX_DESC_ENC_TKIP_WO_MIC: u32 = 2;
+const RX_DESC_ENC_TKIP_MIC: u32 = 3;
+/// The data frames either way in the watchdog's 2 s above which the
+/// link stays awake (`RTW_LPS_THRESHOLD`).
+const LPS_THRESHOLD: u32 = 50;
+/// The interface's MAC ID and port (the first of each, as Linux takes them).
+const MAC_ID: u8 = 0;
+const PORT: u8 = 0;
+/// The security CAM: group keys at their index (default key search),
+/// pairwise keys from entry 4 (`RTW_SEC_DEFAULT_KEY_NUM`).
+const CAM_PAIRWISE: u8 = 4;
+/// As an access point: its stations' MAC IDs, from 1 (`rtw_acquire_macid`
+/// after the interface's), each with its pairwise key in CAM entry
+/// `CAM_PAIRWISE` + MAC ID - 1.
+const AP_STATIONS: u8 = 16;
+/// Dwell times of a software scan (mac80211's `IEEE80211_CHANNEL_TIME`
+/// after the probe delay, `IEEE80211_PASSIVE_CHANNEL_TIME`).
+const DWELL_ACTIVE_MS: u64 = 60;
+const DWELL_PASSIVE_MS: u64 = 110;
+/// While associated, the operating channel between two scanned ones.
+const HOME_MS: u64 = 100;
+/// 802.11's HT and VHT capability bits (`rtw_init_ht_cap`,
+/// `rtw_init_vht_cap`).
+const HT_CAP_SM_PS_DISABLED: u16 = 3 << 2;
+const HT_CAP_SGI_20: u16 = 1 << 5;
+const HT_CAP_SGI_40: u16 = 1 << 6;
+const HT_CAP_TX_STBC: u16 = 1 << 7;
+const HT_CAP_RX_STBC_1: u16 = 1 << 8;
+const HT_CAP_RX_STBC: u16 = 3 << 8;
+const VHT_CAP_MAX_MPDU_11454: u32 = 2;
+const VHT_CAP_RXSTBC_1: u32 = 1 << 8;
+const VHT_CAP_RXSTBC_MASK: u32 = 7 << 8;
+const VHT_CAP_HTC_VHT: u32 = 1 << 22;
+/// The rate adaptation's masks (Linux's `RA_MASK_*`).
+const RA_MASK_CCK_RATES: u32 = 0x0000f;
+const RA_MASK_OFDM_RATES: u32 = 0x00ff0;
+const RA_MASK_HT_RATES_1SS: u32 = 0xff000;
+const RA_MASK_HT_RATES_2SS: u32 = 0xff000 << 8;
+const RA_MASK_VHT_RATES_1SS: u32 = 0x3ff000;
+const RA_MASK_VHT_RATES_2SS: u32 = 0x3ff000 << 10;
+const RA_MASK_CCK_IN_BG: u32 = 0x00005;
+const RA_MASK_CCK_IN_HT: u32 = 0x00005;
+const RA_MASK_OFDM_IN_VHT: u32 = 0x00010;
+const RA_MASK_OFDM_IN_HT_2G: u32 = 0x00010;
+const RA_MASK_OFDM_IN_HT_5G: u32 = 0x00030;
+/// The phy modes of `get_rate_id` (`WIRELESS_*`).
+const WIRELESS_CCK: u8 = 1;
+const WIRELESS_OFDM: u8 = 2;
+const WIRELESS_HT: u8 = 4;
+const WIRELESS_VHT: u8 = 8;
+
+/// Linux's `get_rate_id` for up to two streams.
+fn rate_id_of(wireless: u8, bw: u32, two: bool) -> u32 {
+    match wireless {
+        WIRELESS_CCK => RTW_RATEID_B_20M,
+        WIRELESS_OFDM => RTW_RATEID_G,
+        w if w == WIRELESS_CCK | WIRELESS_OFDM => RTW_RATEID_BG,
+        w if w == WIRELESS_OFDM | WIRELESS_HT => if two { RTW_RATEID_GN_N2SS } else { RTW_RATEID_GN_N1SS },
+        w if w == WIRELESS_CCK | WIRELESS_OFDM | WIRELESS_HT => match (bw == RTW_CHANNEL_WIDTH_40, two) {
+            (true, true) => RTW_RATEID_BGN_40M_2SS,
+            (true, false) => RTW_RATEID_BGN_40M_1SS,
+            (false, true) => RTW_RATEID_BGN_20M_2SS,
+            (false, false) => RTW_RATEID_BGN_20M_1SS,
+        },
+        w if w == WIRELESS_OFDM | WIRELESS_VHT => if two { RTW_RATEID_ARFR0_AC_2SS } else { RTW_RATEID_ARFR1_AC_1SS },
+        _ => match (bw >= RTW_CHANNEL_WIDTH_80, two) {
+            (true, true) => RTW_RATEID_ARFR0_AC_2SS,
+            (true, false) => RTW_RATEID_ARFR1_AC_1SS,
+            (false, true) => RTW_RATEID_ARFR3_AC_2G_2SS,
+            (false, false) => RTW_RATEID_ARFR2_AC_2G_1SS,
+        },
+    }
+}
+
+/// `get_vht_ra_mask`: MCS 7, 8 or 9 per stream, from bit 12, ten a stream.
+fn vht_ra_mask(map: u16) -> u32 {
+    (0..2).fold(0u32, |mask, stream| {
+        mask | match (map >> (2 * stream)) & 3 {
+            2 => 0x3ff,
+            1 => 0x1ff,
+            0 => 0x0ff,
+            _ => 0,
+        } << (12 + 10 * stream)
+    })
+}
+
+/// The network being joined.
+#[derive(Clone)]
+struct Network {
+    join: Join,
+    channel: u8,
+    /// The channel as the chip tunes to it.
+    tune: Tune,
+    /// What the access point and this station run, known once it took the
+    /// station.
+    peer: Peer,
+    rates: u16,
+    basic: u16,
+}
+
+/// Rates (in 500 kbit/s, basic ones flagged) as bitmaps over the band's
+/// table: all of them (the whole table when none is given) and the basic
+/// ones.
+fn rate_bitmaps(band: BandId, rates: impl Iterator<Item = u8>) -> (u16, u16) {
+    let table = band.rates();
+    let (mut all, mut basic) = (0u16, 0u16);
+    for rate in rates {
+        if let Some(index) = table.iter().position(|&known| known == rate & 0x7f) {
+            all |= 1 << index;
+            if rate & 0x80 != 0 {
+                basic |= 1 << index;
+            }
+        }
+    }
+    if all == 0 {
+        all = (1 << table.len()) - 1;
+    }
+    (all, basic)
+}
+
+/// The supported and extended rates of some elements.
+fn element_rates(elements: &[u8]) -> Vec<u8> {
+    let elements = wifi::Elements(elements);
+    [wifi::IE_RATES, wifi::IE_EXT_RATES].iter().flat_map(|&id| elements.get(id).unwrap_or(&[]).iter().copied()).collect()
+}
+
+impl Network {
+    fn new(join: &Join) -> Self {
+        let (rates, basic) = rate_bitmaps(BandId::of(join.freq), element_rates(&join.elements).into_iter());
+        Self { join: join.clone(), channel: wifi::channel_of(join.freq).unwrap_or(1), tune: Tune::of(&join.chandef), peer: Peer::default(), rates, basic }
+    }
+
+    fn ghz2(&self) -> bool {
+        self.channel <= 14
+    }
+}
+
+/// The network this radio runs as an access point.
+struct Ap {
+    config: ApConfig,
+    tune: Tune,
+    /// Its basic rates, as the band's bitmap.
+    basic: u16,
+    stations: BTreeMap<Address, ApStation>,
+    /// The group key's index and the PN of the next group frame.
+    group: Option<(u8, u64)>,
+}
+
+impl Ap {
+    fn ghz2(&self) -> bool {
+        BandId::of(self.config.chandef.control) == BandId::Ghz2
+    }
+}
+
+/// A station of the access point: its MAC ID, rates for the TX
+/// descriptors, its pairwise key's index and next PN.
+struct ApStation {
+    mac_id: u8,
+    peer: Peer,
+    rates: u16,
+    rate_id: u8,
+    link: (u8, bool, u8),
+    pairwise: Option<(u8, u64)>,
+    /// Its QoS data's sequence numbers per TID, and the TIDs it takes
+    /// aggregates of.
+    tid_seq: [u16; 8],
+    aggregates: u8,
+}
+
+/// `rtw_tx_data_pkt_info_update` under an agreement to send aggregates:
+/// the most frames in one (`get_tx_ampdu_factor`, in twos: the peer's
+/// largest aggregate, from 8 KiB) and the peer's spacing.
+fn ampdu(peer: &Peer) -> (u8, u8) {
+    peer.ht.map_or((0, 0), |ht| (((4u16 << (ht.ampdu_factor & 3)) - 1) as u8, ht.ampdu_density & 7))
+}
+
+/// The CCMP header of a frame with this key index and packet number.
+fn ccmp_header(index: u8, pn: u64) -> [u8; 8] {
+    [pn as u8, (pn >> 8) as u8, 0, 0x20 | (index << 6), (pn >> 16) as u8, (pn >> 24) as u8, (pn >> 32) as u8, (pn >> 40) as u8]
+}
+
+/// A software scan in progress.
+struct Scan {
+    channels: Vec<u8>,
+    next: usize,
+    ssids: Vec<Vec<u8>>,
+    elements: Vec<u8>,
+    deadline: u64,
+    /// On the operating channel between two scanned ones.
+    home: bool,
+    aborted: bool,
+}
+
+pub(crate) struct Rtw88 {
+    pub(crate) hw: Hw,
+    pub(crate) address: Address,
+    pub(crate) device: Option<Arc<Device>>,
+    network: Option<Network>,
+    ap: Option<Ap>,
+    associated: bool,
+    qos: bool,
+    /// The pairwise key's index and the PN of the next protected frame.
+    pairwise: Option<(u8, u64)>,
+    /// The group's TKIP key's receive MIC key: the chip decrypts, the MIC
+    /// is checked here (`IEEE80211_KEY_FLAG_GENERATE_MMIC`).
+    group_mic: Option<[u8; 8]>,
+    scan: Option<Scan>,
+    sequence: u16,
+    /// QoS data's sequence numbers per TID (mac80211's `tid_seq`: under an
+    /// agreement a TID's must follow one another), and the TIDs the access
+    /// point takes aggregates of.
+    tid_seq: [u16; 8],
+    aggregates: u8,
+    /// The rate adaptation's set for the access point (`RTW_RATEID_*`).
+    rate_id: u8,
+    /// The link's width, LDPC and STBC for the TX descriptors.
+    link: (u8, bool, u8),
+    /// When the watchdog runs next (Linux's every 2 s).
+    watchdog: u64,
+    /// Power save asked for the link, the firmware in it (leisure power
+    /// save), the data frames sent and received since the watchdog.
+    power_save: bool,
+    lps: bool,
+    traffic: (u32, u32),
+    pub(crate) signal: Option<i8>,
+    pub(crate) dead: bool,
+}
+
+impl Rtw88 {
+    pub(crate) fn new(hw: Hw) -> Self {
+        let address = hw.efuse.address;
+        Self {
+            hw,
+            address,
+            device: None,
+            network: None,
+            ap: None,
+            associated: false,
+            qos: false,
+            pairwise: None,
+            group_mic: None,
+            scan: None,
+            sequence: 0,
+            tid_seq: [0; 8],
+            aggregates: 0,
+            rate_id: RTW_RATEID_BG as u8,
+            link: (0, false, 0),
+            watchdog: 0,
+            power_save: false,
+            lps: false,
+            traffic: (0, 0),
+            signal: None,
+            dead: false,
+        }
+    }
+
+    /// `rtw_ops_add_interface` for a station on port 0, and the first
+    /// channel.
+    pub(crate) fn add_interface(&mut self) {
+        self.hw.port_address(&self.address);
+        self.hw.port_net_type(false);
+        self.hw.port_bcn_ctrl();
+        self.hw.set_rcr(false);
+        self.hw.set_channel(1, false);
+    }
+
+    // ---- Scans. ----
+
+    pub(crate) fn scan(&mut self, request: &ScanRequest) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        self.leave_lps();
+        if self.scan.is_some() || self.ap.is_some() {
+            return Err(radio::Error::Busy);
+        }
+        let mut channels: Vec<u8> = request.freqs.iter().filter_map(|&freq| wifi::channel_of(freq)).filter(|&channel| self.supports(channel)).collect();
+        if channels.is_empty() {
+            channels = (1..=13).chain(chan::CHANNELS_5GHZ).filter(|&channel| self.supports(channel)).collect();
+        }
+        self.hw.set_rcr(true);
+        self.scan = Some(Scan { channels, next: 0, ssids: request.ssids.clone(), elements: request.elements.clone(), deadline: 0, home: false, aborted: false });
+        self.scan_step();
+        Ok(())
+    }
+
+    /// The channels offered: 2.4 GHz's, and 5 GHz's on the chips that have
+    /// the band.
+    fn supports(&self, channel: u8) -> bool {
+        (1..=13).contains(&channel) || (self.hw.spec.band_5g && chan::CHANNELS_5GHZ.contains(&channel))
+    }
+
+    pub(crate) fn abort_scan(&mut self) {
+        if let Some(scan) = &mut self.scan {
+            scan.aborted = true;
+            scan.deadline = 0;
+        }
+    }
+
+    /// The scan's next step when its time has come: the next channel and
+    /// its probe requests, the operating channel in between while
+    /// associated, or the end.
+    fn scan_step(&mut self) {
+        let now = crate::now_ms();
+        let Some(scan) = &mut self.scan else { return };
+        if now < scan.deadline {
+            return;
+        }
+        let home = self.network.as_ref().filter(|_| self.associated).map(|network| network.tune);
+        if scan.aborted || scan.next >= scan.channels.len() {
+            let aborted = scan.aborted;
+            self.scan = None;
+            let tune = self.network.as_ref().map_or(Tune::simple(self.hw.channel), |network| network.tune);
+            self.hw.set_tune(tune, false);
+            self.hw.set_rcr(false);
+            if let Some(device) = &self.device {
+                device.scan_done(aborted);
+            }
+            return;
+        }
+        if let Some(home) = home
+            && !scan.home
+            && scan.next > 0
+        {
+            scan.home = true;
+            scan.deadline = now + HOME_MS;
+            self.hw.set_tune(home, false);
+            return;
+        }
+        scan.home = false;
+        let channel = scan.channels[scan.next];
+        scan.next += 1;
+        let passive = scan.ssids.is_empty() || chan::radar_channel(channel);
+        scan.deadline = now + if passive { DWELL_PASSIVE_MS } else { DWELL_ACTIVE_MS };
+        let probes: Vec<Vec<u8>> = if passive {
+            Vec::new()
+        } else {
+            let rates = if channel <= 14 { BandId::Ghz2 } else { BandId::Ghz5 }.rates();
+            scan.ssids.iter().map(|ssid| wifi::probe_request(&self.address, ssid, rates, &scan.elements)).collect()
+        };
+        self.hw.set_channel(channel, true);
+        for probe in probes {
+            let _ = self.transmit(probe);
+        }
+    }
+
+    // ---- Joining. ----
+
+    /// The rates and capabilities of the access point for the firmware
+    /// (`rtw_update_sta_info`): HT's or VHT's MCS as far as both sides
+    /// go, the link's width, its guard interval, STBC and LDPC.
+    fn update_ra(&mut self, init: bool) {
+        let Some(network) = &self.network else { return };
+        let peer = if self.associated { network.peer.clone() } else { Peer::default() };
+        let (ghz2, rates, width) = (network.ghz2(), network.rates, network.tune.bw);
+        let (rate_id, link) = self.send_ra(MAC_ID, &peer, ghz2, rates, width, init);
+        self.rate_id = rate_id;
+        self.link = link;
+    }
+
+    /// `rtw_update_sta_info` for a peer by its MAC ID: its rates (the
+    /// band's bitmap) and capabilities, on a channel of `width`; the rate
+    /// set and the TX descriptors' width, LDPC and STBC for it.
+    fn send_ra(&mut self, mac_id: u8, peer: &Peer, ghz2: bool, rates: u16, width: u32, init: bool) -> (u8, (u8, bool, u8)) {
+        let two_paths = self.hw.paths() > 1;
+        let (ht, vht) = (peer.ht, peer.vht.filter(|_| self.hw.spec.band_5g && !ghz2));
+        let mut mask: u32 = 0;
+        let (mut stbc, mut ldpc) = (0u8, false);
+        if let Some(vht) = &vht {
+            mask |= vht_ra_mask(u16::from_le_bytes([vht.mcs[0], vht.mcs[1]]));
+            if vht.info & VHT_CAP_RXSTBC_MASK != 0 {
+                stbc = 2;
+            }
+            ldpc = vht.info & chan::VHT_CAP_RXLDPC != 0;
+        } else if let Some(ht) = &ht {
+            mask |= ((ht.mcs[1] as u32) << 20) | ((ht.mcs[0] as u32) << 12);
+            if ht.info & HT_CAP_RX_STBC != 0 {
+                stbc = 1;
+            }
+            ldpc = ht.info & chan::HT_CAP_LDPC != 0;
+        }
+        mask &= if two_paths { RA_MASK_VHT_RATES_2SS | RA_MASK_HT_RATES_2SS | RA_MASK_VHT_RATES_1SS | RA_MASK_HT_RATES_1SS } else { RA_MASK_VHT_RATES_1SS | RA_MASK_HT_RATES_1SS };
+        let wireless;
+        let backup;
+        if !ghz2 {
+            mask |= (rates as u32) << 4;
+            backup = mask;
+            if vht.is_some() {
+                mask &= RA_MASK_VHT_RATES_1SS | RA_MASK_VHT_RATES_2SS | RA_MASK_OFDM_IN_VHT;
+                wireless = WIRELESS_OFDM | WIRELESS_VHT;
+            } else if ht.is_some() {
+                mask &= RA_MASK_HT_RATES_1SS | RA_MASK_HT_RATES_2SS | RA_MASK_OFDM_IN_HT_5G;
+                wireless = WIRELESS_OFDM | WIRELESS_HT;
+            } else {
+                wireless = WIRELESS_OFDM;
+            }
+        } else {
+            mask |= rates as u32;
+            backup = mask;
+            if ht.is_some() {
+                mask &= RA_MASK_HT_RATES_1SS | RA_MASK_HT_RATES_2SS | RA_MASK_CCK_IN_HT | RA_MASK_OFDM_IN_HT_2G;
+                wireless = WIRELESS_CCK | WIRELESS_OFDM | WIRELESS_HT;
+            } else if rates <= 0xf {
+                wireless = WIRELESS_CCK;
+            } else {
+                mask &= RA_MASK_OFDM_RATES | RA_MASK_CCK_IN_BG;
+                wireless = WIRELESS_CCK | WIRELESS_OFDM;
+            }
+        }
+        let sgi = match width {
+            RTW_CHANNEL_WIDTH_80 => vht.is_some_and(|vht| vht.info & chan::VHT_CAP_SGI_80 != 0),
+            RTW_CHANNEL_WIDTH_40 => ht.is_some_and(|ht| ht.info & HT_CAP_SGI_40 != 0),
+            _ => ht.is_some_and(|ht| ht.info & HT_CAP_SGI_20 != 0),
+        };
+        let two = (vht.is_some() || ht.is_some()) && two_paths;
+        let rate_id = rate_id_of(wireless, width, two);
+        // `rtw_rate_mask_recover`.
+        if mask & !(RA_MASK_CCK_RATES | RA_MASK_OFDM_RATES) == 0 {
+            mask |= backup & !(RA_MASK_CCK_RATES | RA_MASK_OFDM_RATES);
+        }
+        if mask == 0 {
+            mask |= backup & (RA_MASK_CCK_RATES | RA_MASK_OFDM_RATES);
+        }
+        let link = (width as u8, ldpc && self.hw.model != Model::Rtl8821c && self.hw.model != Model::Rtl8723d, stbc);
+        self.hw.ra_info(mac_id, rate_id as u8, mask, if init { 1 } else { 0 }, sgi, width, ldpc, vht.is_some(), true);
+        (rate_id as u8, link)
+    }
+
+    /// mac80211's `prep_connection` (the channel, the BSSID) and rtw88's
+    /// `rtw_sta_add` and `mgd_prepare_tx` (the calibration).
+    pub(crate) fn join(&mut self, join: &Join) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        self.leave_lps();
+        if self.ap.is_some() {
+            return Err(radio::Error::Busy);
+        }
+        self.leave();
+        if self.scan.is_some() {
+            self.abort_scan();
+            self.scan_step();
+        }
+        let network = Network::new(join);
+        if !self.supports(network.channel) {
+            return Err(radio::Error::Invalid);
+        }
+        self.hw.set_tune(network.tune, false);
+        self.hw.port_bssid(&join.bssid);
+        self.network = Some(network);
+        self.tid_seq = [0; 8];
+        self.aggregates = 0;
+        self.update_ra(true);
+        self.hw.media_status(MAC_ID, true);
+        self.hw.prepare_tx(false);
+        Ok(())
+    }
+
+    /// `bss_info_changed` (ASSOC): the link, the AID, the default port,
+    /// the EDCA of the network; the rates with HT.
+    pub(crate) fn associated(&mut self, association: &Association) -> radio::Result<()> {
+        let Some(network) = self.network.as_mut() else { return Err(radio::Error::Invalid) };
+        network.peer = association.peer.clone();
+        let tune = Tune::of(&association.chandef);
+        if tune != network.tune {
+            network.tune = tune;
+            self.hw.set_tune(tune, false);
+        }
+        self.associated = true;
+        self.qos = association.qos;
+        self.hw.port_net_type(true);
+        self.hw.port_aid(association.aid & 0x3fff);
+        self.hw.default_port(PORT, MAC_ID);
+        self.conf_tx(&association.elements);
+        self.update_ra(false);
+        Ok(())
+    }
+
+    /// The access categories' EDCA (`rtw_ops_conf_tx`), from the WMM
+    /// element or the standard values.
+    fn conf_tx(&self, elements: &[u8]) {
+        // (cw_min, cw_max, aifsn, txop) for BE, BK, VI, VO.
+        let mut params: [(u16, u16, u8, u16); 4] = [(15, 1023, 3, 0), (15, 1023, 7, 0), (7, 15, 2, 94), (3, 7, 2, 47)];
+        let wmm = wifi::Elements(elements).iter().find(|(id, value)| *id == wifi::IE_VENDOR && value.len() >= 24 && value[..4] == wifi::WMM_OUI_TYPE && value[4] == 1);
+        if let Some((_, value)) = wmm {
+            for record in value[8..24].chunks(4) {
+                let aci = ((record[0] >> 5) & 3) as usize;
+                let (ecw_min, ecw_max) = (record[1] & 0xf, record[1] >> 4);
+                params[aci] = ((1 << ecw_min) - 1, (1 << ecw_max) - 1, record[0] & 0xf, u16::from_le_bytes([record[2], record[3]]));
+            }
+        }
+        let short_slot = self.network.as_ref().is_some_and(|network| network.join.capability & wifi::CAP_SHORT_SLOT != 0 || !network.ghz2());
+        let registers = [REG_EDCA_BE_PARAM, REG_EDCA_BK_PARAM, REG_EDCA_VI_PARAM, REG_EDCA_VO_PARAM];
+        for (register, (cw_min, cw_max, aifsn, txop)) in registers.iter().zip(params) {
+            self.hw.conf_tx(*register, cw_min, cw_max, aifsn, txop, short_slot);
+        }
+    }
+
+    /// `rtw_sta_remove` and the disassociation.
+    pub(crate) fn leave(&mut self) {
+        if self.network.is_none() {
+            return;
+        }
+        self.leave_lps();
+        self.power_save = false;
+        if !self.dead {
+            self.hw.media_status(MAC_ID, false);
+            self.hw.port_net_type(false);
+            self.hw.port_aid(0);
+            self.hw.port_bssid(&[0; 6]);
+            for entry in 0..=CAM_PAIRWISE {
+                self.hw.clear_cam(entry);
+            }
+        }
+        self.network = None;
+        self.associated = false;
+        self.qos = false;
+        self.pairwise = None;
+        self.signal = None;
+    }
+
+    // ---- As an access point (`rtw_ops_add_interface` for an AP,
+    // `rtw_ops_start_ap`, `bss_info_changed` BEACON, `rtw_sta_add`). ----
+
+    /// Port 0 an access point's on the network's channel, the calibration,
+    /// the beacon in the reserved page and on.
+    pub(crate) fn start_ap(&mut self, config: &ApConfig) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        self.leave_lps();
+        self.stop_ap();
+        self.leave();
+        if self.scan.is_some() {
+            self.abort_scan();
+            self.scan_step();
+        }
+        let channel = wifi::channel_of(config.chandef.control).unwrap_or(0);
+        if !self.supports(channel) {
+            return Err(radio::Error::Invalid);
+        }
+        let tune = Tune::of(&config.chandef);
+        let basic =rate_bitmaps(BandId::of(config.chandef.control), element_rates(&config.beacon.elements()).into_iter()).1;
+        self.ap = Some(Ap { config: config.clone(), tune, basic, stations: BTreeMap::new(), group: None });
+        self.hw.set_tune(tune, false);
+        self.hw.port_bssid(&self.address);
+        self.hw.port_ap(true, config.beacon_interval, config.dtim_period);
+        self.hw.prepare_tx(false);
+        let elements = config.beacon.elements();
+        self.qos = wifi::Elements(&elements).vendor(wifi::WMM_OUI_TYPE).is_some();
+        self.conf_tx(&elements);
+        if let Err(error) = self.hw.beacon(&config.beacon.frame(config.dtim_period)) {
+            ostd::warn!("{}: the beacon: {}", self.hw.name(), error);
+            self.stop_ap();
+            return Err(radio::Error::Failed);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn set_beacon(&mut self, beacon: &BeaconTemplate) -> radio::Result<()> {
+        let Some(ap) = &mut self.ap else { return Err(radio::Error::Down) };
+        ap.config.beacon = beacon.clone();
+        let frame = beacon.frame(ap.config.dtim_period);
+        self.hw.beacon(&frame).map_err(|error| {
+            ostd::warn!("{}: the beacon: {}", self.hw.name(), error);
+            radio::Error::Failed
+        })
+    }
+
+    /// The beacon off, the stations gone, port 0 a station's again.
+    pub(crate) fn stop_ap(&mut self) {
+        let Some(ap) = &self.ap else { return };
+        let addresses: Vec<Address> = ap.stations.keys().copied().collect();
+        for address in &addresses {
+            self.remove_station(address);
+        }
+        if !self.dead {
+            self.hw.port_ap(false, 0, 1);
+            self.hw.port_bssid(&[0; 6]);
+            for entry in 0..CAM_PAIRWISE {
+                self.hw.clear_cam(entry);
+            }
+        }
+        self.ap = None;
+        self.qos = false;
+    }
+
+    /// `rtw_sta_add`: a MAC ID, the station's rates for the firmware, the
+    /// firmware told it is connected.
+    pub(crate) fn add_station(&mut self, station: &StationEntry) -> radio::Result<()> {
+        let Some(ap) = &self.ap else { return Err(radio::Error::Down) };
+        if ap.stations.contains_key(&station.address) {
+            self.remove_station(&station.address);
+        }
+        let Some(ap) = &self.ap else { return Err(radio::Error::Down) };
+        let used: Vec<u8> = ap.stations.values().map(|station| station.mac_id).collect();
+        let Some(mac_id) = (1..=AP_STATIONS).find(|id| !used.contains(id)) else { return Err(radio::Error::Busy) };
+        let (ghz2, width) = (ap.ghz2(), ap.tune.bw);
+        let (rates, _) = rate_bitmaps(BandId::of(ap.config.chandef.control), station.peer.rates.iter().copied());
+        let (rate_id, link) = self.send_ra(mac_id, &station.peer, ghz2, rates, width, true);
+        self.hw.media_status(mac_id, true);
+        if let Some(ap) = &mut self.ap {
+            ap.stations.insert(station.address, ApStation { mac_id, peer: station.peer.clone(), rates, rate_id, link, pairwise: None, tid_seq: [0; 8], aggregates: 0 });
+        }
+        Ok(())
+    }
+
+    pub(crate) fn remove_station(&mut self, address: &Address) {
+        let Some(ap) = &mut self.ap else { return };
+        let Some(station) = ap.stations.remove(address) else { return };
+        if !self.dead {
+            self.hw.media_status(station.mac_id, false);
+            self.hw.clear_cam(CAM_PAIRWISE + station.mac_id - 1);
+        }
+    }
+
+    /// `rtw_ops_set_key`: CCMP only (the chip's AES).
+    pub(crate) fn set_key(&mut self, key: &Key) -> radio::Result<()> {
+        // CCMP, and TKIP for a station's group key (broadcasts of mixed
+        // WPA/WPA2 networks): the chip decrypts, the MIC is checked here.
+        let kind = match key.cipher {
+            radio::CIPHER_CCMP if key.key.len() == 16 => RTW_CAM_AES,
+            radio::CIPHER_TKIP if !key.pairwise && self.ap.is_none() && key.key.len() == 32 => RTW_CAM_TKIP,
+            _ => return Err(radio::Error::Unsupported),
+        };
+        if kind == RTW_CAM_TKIP {
+            if self.network.is_none() {
+                return Err(radio::Error::Invalid);
+            }
+            self.hw.write_cam(key.index & 3, key.index, true, &wifi::BROADCAST, RTW_CAM_TKIP, &key.key[..16]);
+            self.group_mic = aster_wlan::tkip::rx_mic_key(&key.key);
+            return Ok(());
+        }
+        if let Some(ap) = &mut self.ap {
+            // A station's pairwise key in its own entry, the group's at its
+            // index for everyone.
+            if key.pairwise {
+                let address = key.address.ok_or(radio::Error::Invalid)?;
+                let station = ap.stations.get_mut(&address).ok_or(radio::Error::Invalid)?;
+                station.pairwise = Some((key.index, 1));
+                let entry = CAM_PAIRWISE + station.mac_id - 1;
+                self.hw.write_cam(entry, key.index, false, &address, RTW_CAM_AES, &key.key);
+            } else {
+                ap.group = Some((key.index, 1));
+                self.hw.write_cam(key.index & 3, key.index, true, &wifi::BROADCAST, RTW_CAM_AES, &key.key);
+            }
+            return Ok(());
+        }
+        let Some(network) = &self.network else { return Err(radio::Error::Invalid) };
+        if key.pairwise {
+            self.hw.write_cam(CAM_PAIRWISE, key.index, false, &network.join.bssid, RTW_CAM_AES, &key.key);
+            self.pairwise = Some((key.index, 1));
+        } else {
+            self.hw.write_cam(key.index & 3, key.index, true, &wifi::BROADCAST, RTW_CAM_AES, &key.key);
+            self.group_mic = None;
+        }
+        Ok(())
+    }
+
+    pub(crate) fn remove_key(&mut self, index: u8, pairwise: bool) {
+        if let Some(ap) = &mut self.ap {
+            // A station's pairwise key goes with it.
+            if !pairwise {
+                ap.group = None;
+                self.hw.clear_cam(index & 3);
+            }
+            return;
+        }
+        if pairwise {
+            self.hw.clear_cam(CAM_PAIRWISE);
+            self.pairwise = None;
+        } else {
+            self.hw.clear_cam(index & 3);
+            self.group_mic = None;
+        }
+    }
+
+    // ---- Frames. ----
+
+    /// A management frame on the management queue at the lowest basic
+    /// rate, its sequence number the hardware's
+    /// (`rtw_tx_mgmt_pkt_info_update`).
+    pub(crate) fn transmit(&mut self, frame: Vec<u8>) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if frame.len() < wifi::HEADER {
+            return Err(radio::Error::Invalid);
+        }
+        let mut frame = frame;
+        // A protected management frame (802.11w) comes encrypted by the
+        // stack, which runs CCMP on them for these chips: it goes as it
+        // is. As an access point none is protected.
+        if self.ap.is_some() {
+            frame[1] &= !wifi::PROTECTED;
+        }
+        let ghz2 = self.hw.channel <= 14;
+        let lowest = if ghz2 { DESC_RATE1M } else { DESC_RATE6M } as u8;
+        let basic = match &self.ap {
+            Some(ap) => ap.basic,
+            None => self.network.as_ref().map_or(0, |network| network.basic),
+        };
+        let rate = if basic == 0 { lowest } else { lowest + basic.trailing_zeros() as u8 };
+        // As an access point, to a station by its MAC ID.
+        let receiver: Option<Address> = frame.get(4..10).and_then(|b| b.try_into().ok());
+        let mac_id = self.ap.as_ref().and_then(|ap| receiver.and_then(|address| ap.stations.get(&address))).map_or(MAC_ID, |station| station.mac_id);
+        let info = TxInfo {
+            offset: self.hw.hci.tx_desc() as u8,
+            bmc: frame[4] & 1 != 0,
+            ls: true,
+            dis_qselseq: true,
+            en_hwseq: true,
+            mac_id,
+            qsel: TX_DESC_QSEL_MGMT as u8,
+            rate_id: if ghz2 { RTW_RATEID_B_20M } else { RTW_RATEID_G } as u8,
+            rate,
+            use_rate: true,
+            dis_rate_fallback: true,
+            ..TxInfo::default()
+        };
+        self.hw.hci.write(&self.hw.chip, QUEUE_MGMT, &info, &frame).map_err(|()| radio::Error::Busy)
+    }
+
+    /// A data frame: the CCMP header with the next PN when protected, the
+    /// queue and TID of its priority, the firmware's rate adaptation
+    /// (`rtw_tx_data_pkt_info_update`).
+    pub(crate) fn send(&mut self, ethernet: &[u8], plain: bool) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if self.ap.is_some() {
+            return self.send_ap(ethernet, plain);
+        }
+        let Some(network) = &self.network else { return Err(radio::Error::Down) };
+        let tid = self.qos.then(|| wifi::tid_of(ethernet));
+        let protected = !plain && self.pairwise.is_some();
+        let mut frame = wifi::data_from_ethernet(ethernet, &network.join.bssid, tid, protected).ok_or(radio::Error::Invalid)?;
+        let header = if tid.is_some() { 26 } else { 24 };
+        if protected && let Some((index, pn)) = self.pairwise.as_mut() {
+            let value = *pn;
+            *pn += 1;
+            drop(frame.splice(header..header, ccmp_header(*index, value)));
+        }
+        let counter = match tid {
+            Some(tid) => &mut self.tid_seq[tid as usize & 7],
+            None => &mut self.sequence,
+        };
+        let sequence = *counter;
+        *counter = (sequence + 1) & 0x0fff;
+        frame[22..24].copy_from_slice(&(sequence << 4).to_le_bytes());
+        self.traffic.0 = self.traffic.0.saturating_add(1);
+        let ampdu_en = tid.is_some_and(|tid| self.aggregates & (1 << (tid & 7)) != 0);
+        let (ampdu_factor, ampdu_density) = if ampdu_en { ampdu(&network.peer) } else { (0, 0) };
+        let tid = tid.unwrap_or(0);
+        let queue = match tid {
+            1 | 2 => QUEUE_BK,
+            4 | 5 => QUEUE_VI,
+            6 | 7 => QUEUE_VO,
+            _ => QUEUE_BE,
+        };
+        let ghz2 = network.ghz2();
+        let (ht, vht) = (network.peer.ht.is_some() && self.associated, network.peer.vht.is_some() && self.associated);
+        let rate = if vht {
+            DESC_RATEVHT1SS_MCS9
+        } else if ht {
+            DESC_RATEMCS7
+        } else if ghz2 && network.rates <= 0xf {
+            DESC_RATE11M
+        } else {
+            DESC_RATE54M
+        } as u8;
+        // The rate adaptation's set (`update_ra`).
+        let rate_id = self.rate_id;
+        let info = TxInfo {
+            offset: self.hw.hci.tx_desc() as u8,
+            bmc: frame[4] & 1 != 0,
+            ls: true,
+            mac_id: MAC_ID,
+            qsel: tid,
+            rate_id,
+            rate,
+            sec_type: if protected { 3 } else { 0 },
+            seq: sequence,
+            bw: self.link.0,
+            ldpc: self.link.1,
+            stbc: self.link.2,
+            ampdu_en,
+            ampdu_factor,
+            ampdu_density,
+            ..TxInfo::default()
+        };
+        self.hw.hci.write(&self.hw.chip, queue, &info, &frame).map_err(|()| radio::Error::Busy)
+    }
+
+    /// As an access point: to the station the destination names (its MAC
+    /// ID, rate set, pairwise key), or to all of them at the lowest basic
+    /// rate with the group's key.
+    fn send_ap(&mut self, ethernet: &[u8], plain: bool) -> radio::Result<()> {
+        let address = self.address;
+        let Some(ap) = &mut self.ap else { return Err(radio::Error::Down) };
+        let destination: Address = ethernet.get(..6).and_then(|b| b.try_into().ok()).ok_or(radio::Error::Invalid)?;
+        let ghz2 = ap.ghz2();
+        let multicast = wifi::is_multicast(&destination);
+        let next = |key: &mut Option<(u8, u64)>| {
+            key.as_mut().map(|(index, pn)| {
+                let value = *pn;
+                *pn += 1;
+                (*index, value)
+            })
+        };
+        let (mac_id, tid, key, rate_id, rate, link, tid_sequence, ampdu_params) = if multicast {
+            let key = if plain { None } else { next(&mut ap.group) };
+            let lowest = if ghz2 { DESC_RATE1M } else { DESC_RATE6M } as u8;
+            let rate = if ap.basic == 0 { lowest } else { lowest + ap.basic.trailing_zeros() as u8 };
+            (MAC_ID, None, key, if ghz2 { RTW_RATEID_B_20M } else { RTW_RATEID_G } as u8, rate, (0, false, 0), None, None)
+        } else {
+            let station = ap.stations.get_mut(&destination).ok_or(radio::Error::Invalid)?;
+            let key = if plain { None } else { next(&mut station.pairwise) };
+            let tid = station.peer.qos.then(|| wifi::tid_of(ethernet));
+            let rate = if station.peer.vht.is_some() {
+                DESC_RATEVHT1SS_MCS9
+            } else if station.peer.ht.is_some() {
+                DESC_RATEMCS7
+            } else if ghz2 && station.rates <= 0xf {
+                DESC_RATE11M
+            } else {
+                DESC_RATE54M
+            } as u8;
+            // A TID's own sequence numbers, aggregates when agreed.
+            let tid_sequence = tid.map(|tid| {
+                let counter = &mut station.tid_seq[tid as usize & 7];
+                let value = *counter;
+                *counter = (value + 1) & 0x0fff;
+                value
+            });
+            let ampdu_params = tid.filter(|tid| station.aggregates & (1 << (tid & 7)) != 0).map(|_| ampdu(&station.peer));
+            (station.mac_id, tid, key, station.rate_id, rate, station.link, tid_sequence, ampdu_params)
+        };
+        let mut frame = wifi::data_from_ethernet_ap(ethernet, &address, tid, key.is_some()).ok_or(radio::Error::Invalid)?;
+        let header = if tid.is_some() { 26 } else { 24 };
+        if let Some((index, pn)) = key {
+            drop(frame.splice(header..header, ccmp_header(index, pn)));
+        }
+        let sequence = tid_sequence.unwrap_or_else(|| {
+            let value = self.sequence;
+            self.sequence = (value + 1) & 0x0fff;
+            value
+        });
+        frame[22..24].copy_from_slice(&(sequence << 4).to_le_bytes());
+        let (ampdu_factor, ampdu_density) = ampdu_params.unwrap_or((0, 0));
+        let tid = tid.unwrap_or(0);
+        let queue = match tid {
+            1 | 2 => QUEUE_BK,
+            4 | 5 => QUEUE_VI,
+            6 | 7 => QUEUE_VO,
+            _ => QUEUE_BE,
+        };
+        let info = TxInfo {
+            offset: self.hw.hci.tx_desc() as u8,
+            bmc: multicast,
+            ls: true,
+            mac_id,
+            qsel: tid,
+            rate_id,
+            rate,
+            // Group frames at a fixed rate; a station's by the firmware's
+            // rate adaptation.
+            use_rate: multicast,
+            dis_rate_fallback: multicast,
+            sec_type: if key.is_some() { 3 } else { 0 },
+            seq: sequence,
+            bw: link.0,
+            ldpc: link.1,
+            stbc: link.2,
+            ampdu_en: ampdu_params.is_some(),
+            ampdu_factor,
+            ampdu_density,
+            ..TxInfo::default()
+        };
+        self.hw.hci.write(&self.hw.chip, queue, &info, &frame).map_err(|()| radio::Error::Busy)
+    }
+
+    // ---- Block acknowledgment (`rtw_ops_ampdu_action`): the MAC answers
+    // aggregates by itself, the Wi-Fi component puts them back in order;
+    // frames of an agreed TID go out as aggregates (`AGG_EN`). ----
+
+    fn knows(&self, peer: &Address) -> bool {
+        match &self.ap {
+            Some(ap) => ap.stations.contains_key(peer),
+            None => self.network.as_ref().is_some_and(|network| network.join.bssid == *peer),
+        }
+    }
+
+    pub(crate) fn rx_ba_start(&mut self, ba: &mut BlockAck) -> radio::Result<Reorder> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if !self.knows(&ba.peer) {
+            return Err(radio::Error::Invalid);
+        }
+        Ok(Reorder::Host)
+    }
+
+    pub(crate) fn tx_ba_start(&mut self, peer: &Address, tid: u8) -> radio::Result<u16> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        let tid = tid as usize & 7;
+        match &self.ap {
+            Some(ap) => ap.stations.get(peer).map(|station| station.tid_seq[tid]).ok_or(radio::Error::Invalid),
+            None if self.knows(peer) => Ok(self.tid_seq[tid]),
+            None => Err(radio::Error::Invalid),
+        }
+    }
+
+    fn set_aggregates(&mut self, peer: &Address, tid: u8, on: bool) {
+        let bit = 1u8 << (tid & 7);
+        let aggregates = match &mut self.ap {
+            Some(ap) => match ap.stations.get_mut(peer) {
+                Some(station) => &mut station.aggregates,
+                None => return,
+            },
+            None => &mut self.aggregates,
+        };
+        if on {
+            *aggregates |= bit;
+        } else {
+            *aggregates &= !bit;
+        }
+    }
+
+    pub(crate) fn tx_ba_operational(&mut self, ba: &BlockAck) -> radio::Result<()> {
+        if !self.knows(&ba.peer) {
+            return Err(radio::Error::Invalid);
+        }
+        self.set_aggregates(&ba.peer, ba.tid, true);
+        Ok(())
+    }
+
+    pub(crate) fn tx_ba_stop(&mut self, peer: &Address, tid: u8) {
+        self.set_aggregates(peer, tid, false);
+    }
+
+    // ---- Power save (`ps.c`): leisure power save, entered by the
+    // watchdog while the link idles, left for scans, a new link and the
+    // watchdog's own work. ----
+
+    pub(crate) fn set_power_save(&mut self, enabled: bool) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if self.ap.is_some() {
+            return Err(radio::Error::Invalid);
+        }
+        self.power_save = enabled;
+        if !enabled {
+            self.leave_lps();
+        }
+        Ok(())
+    }
+
+    fn enter_lps(&mut self) {
+        if !self.lps && !self.dead {
+            self.hw.set_pwr_mode(true);
+            self.lps = true;
+        }
+    }
+
+    fn leave_lps(&mut self) {
+        if self.lps {
+            self.lps = false;
+            if !self.dead {
+                self.hw.set_pwr_mode(false);
+            }
+        }
+    }
+
+    // ---- What the chip says. ----
+
+    pub(crate) fn poll(&mut self) {
+        if self.dead {
+            return;
+        }
+        if !self.hw.chip.present() {
+            ostd::warn!("{}: the card is gone", self.hw.name());
+            self.dead = true;
+            if let Some(device) = &self.device {
+                device.connection_lost();
+            }
+            return;
+        }
+        let status = self.hw.hci.interrupts(&self.hw.chip);
+        if status[0] & IMR_C2HCMD != 0 && self.hw.chip.r8(REG_MCU_TST_CFG) == VAL_FW_TRIGGER as u8 {
+            ostd::warn!("{}: the firmware asked for a recovery; the card stays off until the next boot", self.hw.name());
+            self.dead = true;
+            if let Some(device) = &self.device {
+                device.connection_lost();
+            }
+            return;
+        }
+        for packet in self.hw.hci.receive(&self.hw.chip) {
+            self.rx(&packet);
+        }
+        let sent = status[0] & (IMR_MGNTDOK | IMR_BEDOK | IMR_BKDOK | IMR_VIDOK | IMR_VODOK) != 0 || self.hw.hci.tx_progress();
+        if sent && let Some(device) = &self.device {
+            device.ready_to_send();
+        }
+        self.scan_step();
+        let now = crate::now_ms();
+        if now >= self.watchdog {
+            self.watchdog = now + 2000;
+            // `rtw_watch_dog_work`: awake for the dynamic mechanisms, back
+            // to leisure power save when the link idled (50 frames at most
+            // either way in the 2 s).
+            let (sent, received) = core::mem::take(&mut self.traffic);
+            self.leave_lps();
+            if self.associated
+                && let Some(signal) = self.signal
+            {
+                self.hw.rssi_info(MAC_ID, signal);
+            }
+            // USB: receive aggregation while the link is busy
+            // (`rtw_hci_dynamic_rx_agg` at 1 Mbit/s either way: some 170
+            // full frames in the 2 s).
+            if self.hw.hci.is_usb() {
+                self.hw.dynamic_rx_agg(sent + received > 170);
+            }
+            if self.power_save && self.associated && self.ap.is_none() && self.scan.is_none() && sent <= LPS_THRESHOLD && received <= LPS_THRESHOLD {
+                self.enter_lps();
+            }
+        }
+    }
+
+    /// A received packet: its RX descriptor (`rtw_rx_query_rx_desc`), the
+    /// PHY status for the signal, the frame without its FCS (and MIC when
+    /// the chip decrypted it).
+    fn rx(&mut self, packet: &[u8]) {
+        if packet.len() < 24 {
+            return;
+        }
+        let word = |at: usize| u32::from_le_bytes([packet[at], packet[at + 1], packet[at + 2], packet[at + 3]]);
+        let (w0, w2) = (word(0), word(8));
+        if w2 & (1 << 28) != 0 {
+            // A C2H from the firmware: nothing the station needs.
+            return;
+        }
+        let length = (w0 & 0x3fff) as usize;
+        let (crc_err, icv_err) = (w0 & (1 << 14) != 0, w0 & (1 << 15) != 0);
+        let drv_info = (((w0 >> 16) & 0xf) * 8) as usize;
+        let enc_type = (w0 >> 20) & 7;
+        let shift = ((w0 >> 24) & 3) as usize;
+        let phy_status = w0 & (1 << 26) != 0;
+        let swdec = w0 & (1 << 27) != 0;
+        if crc_err || icv_err {
+            return;
+        }
+        let at = 24 + shift + drv_info;
+        let Some(frame) = packet.get(at..at + length) else { return };
+        if frame.len() < wifi::HEADER + 4 {
+            return;
+        }
+        let mut frame = frame[..frame.len() - 4].to_vec();
+        if wifi::is_data(&frame) {
+            self.traffic.1 = self.traffic.1.saturating_add(1);
+        }
+        let decrypted = !swdec && enc_type != 0;
+        if decrypted && frame[1] & wifi::PROTECTED != 0 {
+            if frame.len() < wifi::HEADER + 16 {
+                return;
+            }
+            if matches!(enc_type, RX_DESC_ENC_TKIP_WO_MIC | RX_DESC_ENC_TKIP_MIC) {
+                // TKIP: the ICV goes, the MIC is checked here (only the
+                // group's broadcasts come with it).
+                frame.truncate(frame.len() - 4);
+                let Some(key) = self.group_mic else { return };
+                if !aster_wlan::tkip::check_and_strip(&mut frame, 8, &key) {
+                    return;
+                }
+            } else {
+                // CCMP's MIC.
+                frame.truncate(frame.len() - 8);
+            }
+        }
+        let signal = if phy_status && drv_info >= 16 { self.hw.phy_signal(&packet[24 + shift..24 + shift + drv_info]) } else { None };
+        let signal = signal.unwrap_or(-100).clamp(-127, -1) as i8;
+        if let Some(network) = &self.network
+            && wifi::addresses(&frame).is_some_and(|(_, transmitter, _)| transmitter == network.join.bssid)
+        {
+            self.signal = Some(signal);
+        }
+        // The primary channel of the link (the chip tunes to the span's
+        // centre), else the one scanned.
+        let freq = match &self.network {
+            _ if self.ap.is_some() => self.ap.as_ref().map_or(0, |ap| ap.config.chandef.control),
+            Some(network) if self.scan.is_none() => network.join.freq,
+            _ => {
+                let channel = self.hw.channel;
+                chan::freq_of(if channel <= 14 { BandId::Ghz2 } else { BandId::Ghz5 }, channel)
+            }
+        };
+        if let Some(device) = &self.device {
+            device.received(&frame, RxInfo { freq, signal, decrypted, security_header: if decrypted { 8 } else { 0 }, amsdu_more: false });
+        }
+    }
+
+    /// `rtw_init_ht_cap` and `rtw_init_vht_cap` (without beamforming,
+    /// which this driver does not set up): 40 MHz on both bands, VHT up to
+    /// 80 MHz on the 5 GHz chips, LDPC and TX STBC where the chip has them.
+    pub(crate) fn info(&self) -> Info {
+        let two = self.hw.paths() > 1;
+        let rx_ldpc = matches!(self.hw.model, Model::Rtl8822b | Model::Rtl8822c);
+        let tx_stbc = self.hw.model == Model::Rtl8822c;
+        let mut mcs = [0u8; 16];
+        mcs[0] = 0xff;
+        if two {
+            mcs[1] = 0xff;
+        }
+        mcs[4] = 0x01;
+        mcs[12] = 1;
+        let mut info = HT_CAP_SGI_20 | chan::HT_CAP_MAX_AMSDU | HT_CAP_RX_STBC_1 | HT_CAP_SM_PS_DISABLED | chan::HT_CAP_SUP_WIDTH_20_40 | chan::HT_CAP_DSSS_CCK_40 | HT_CAP_SGI_40;
+        if rx_ldpc {
+            info |= chan::HT_CAP_LDPC;
+        }
+        if tx_stbc {
+            info |= HT_CAP_TX_STBC;
+        }
+        let ht = HtCap { info, ampdu_factor: 3, ampdu_density: self.hw.spec.ampdu_density, mcs };
+        let mut vht_info = VHT_CAP_MAX_MPDU_11454 | chan::VHT_CAP_SGI_80 | VHT_CAP_RXSTBC_1 | VHT_CAP_HTC_VHT | (7 << chan::VHT_CAP_MAX_AMPDU_SHIFT);
+        if two {
+            vht_info |= chan::VHT_CAP_TXSTBC;
+        }
+        if rx_ldpc {
+            vht_info |= chan::VHT_CAP_RXLDPC;
+        }
+        let map: u16 = if two { 0xfffa } else { 0xfffe };
+        let mut vht_mcs = [0u8; 8];
+        vht_mcs[0..2].copy_from_slice(&map.to_le_bytes());
+        vht_mcs[2..4].copy_from_slice(&(390 * (1 + two as u16)).to_le_bytes());
+        vht_mcs[4..6].copy_from_slice(&map.to_le_bytes());
+        vht_mcs[6..8].copy_from_slice(&(390 * (1 + two as u16)).to_le_bytes());
+        let vht = VhtCap { info: vht_info, mcs: vht_mcs };
+        let band = |id: BandId| Band { id, channels: chan::default_channels(id), ht: Some(ht), vht: (id == BandId::Ghz5).then_some(vht), he: None, eht: None };
+        let mut bands = vec![band(BandId::Ghz2)];
+        if self.hw.spec.band_5g {
+            bands.push(band(BandId::Ghz5));
+        }
+        Info {
+            driver: String::from("rtw88"),
+            address: self.address,
+            bands,
+            ciphers: vec![radio::CIPHER_CCMP, radio::CIPHER_TKIP],
+            max_scan_ssids: 4,
+            max_scan_ie_len: 512,
+            ap: true,
+            management: radio::ManagementProtection::Software,
+        }
+    }
+}
