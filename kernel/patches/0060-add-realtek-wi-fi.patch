+pub(crate) struct Hw {
+    pub(crate) chip: Chip,
+    pub(crate) hci: Hci,
+    /// The queues' pages for this bus (`page_table`).
+    pages: [u32; 5],
+    pub(crate) model: Model,
+    pub(crate) spec: &'static Spec,
+    pub(crate) efuse: Efuse,
+    /// The physical efuse (the RTL8822C's trims are read from it).
+    pub(crate) physical: Vec<u8>,
+    pub(crate) rfe: Option<RfeTables>,
+    /// The RTL8822C's CCK gain bounds (`cck_gi_l_bnd`, `cck_gi_u_bnd`) and
+    /// its DAC calibration's ADC values (`dack_adck`).
+    pub(crate) cck_gain_bounds: (u8, u8),
+    pub(crate) dack_adck: [u32; 2],
+    firmware: Vec<u8>,
+    h2c_box: u32,
+    h2c_seq: u16,
+    /// The FIFO's reserved pages (`struct rtw_fifo_conf`).
+    rsvd_boundary: u32,
+    rsvd_fw_txbuf_addr: u32,
+    rsvd_h2cq_addr: u32,
+    /// The RX filter (`hal.rcr`).
+    pub(crate) rcr: u32,
+    /// CCK TX filters read after the tables (`hal.ch_param`).
+    pub(crate) ch_param: [u32; 3],
+    pub(crate) channel: u8,
+    pub(crate) need_rfk: bool,
+    pub(crate) default_ofdm_index: u8,
+    bt_disabled: bool,
+    score_board: u16,
+}
+
+impl Hw {
+    pub(crate) fn new(mut chip: Chip, hci: Hci, model: Model, firmware: Vec<u8>) -> Self {
+        let spec = model.spec();
+        chip.wcpu_8051 = spec.wcpu_8051;
+        chip.ltecoex = spec.ltecoex;
+        let pages = match hci.bulk_out() {
+            None => spec.pages,
+            Some(endpoints) => spec.usb_pages[endpoints.clamp(2, 4) - 2],
+        };
+        Self {
+            chip,
+            hci,
+            pages,
+            model,
+            spec,
+            efuse: Efuse::default(),
+            physical: Vec::new(),
+            rfe: None,
+            cck_gain_bounds: (0, 0),
+            dack_adck: [0; 2],
+            firmware,
+            h2c_box: 0,
+            h2c_seq: 0,
+            rsvd_boundary: 0,
+            rsvd_fw_txbuf_addr: 0,
+            rsvd_h2cq_addr: 0,
+            rcr: BIT_APP_FCS | BIT_APP_MIC | BIT_APP_ICV | BIT_PKTCTL_DLEN | BIT_HTC_LOC_CTRL | BIT_APP_PHYSTS | BIT_AB | BIT_AM | BIT_APM | BIT_VHT_DACK,
+            ch_param: [0; 3],
+            channel: 1,
+            need_rfk: true,
+            default_ofdm_index: 24,
+            bt_disabled: true,
+            score_board: 0,
+        }
+    }
+
+    pub(crate) fn name(&self) -> &str {
+        &self.chip.name
+    }
+
+    /// The RF paths in use (the efuse's and the chip's agree).
+    pub(crate) fn paths(&self) -> usize {
+        if self.spec.rf[1].is_empty() { 1 } else { self.chip.rf_paths.clamp(1, 2) as usize }
+    }
+
+    // ---- Power. ----
+
+    /// Linux's `rtw_mac_power_on`.
+    fn mac_power_on(&mut self) -> Result<(), String> {
+        self.chip.pre_system_cfg();
+        if self.chip.powered() {
+            // Already on: off first, then on again.
+            let _ = self.chip.power_sequence(self.spec.power_off);
+            self.chip.pre_system_cfg();
+        }
+        self.chip.power_sequence(self.spec.power_on).map_err(|error| format!("MAC power-on: {error}"))?;
+        if self.chip.usb() && matches!(self.model, Model::Rtl8821c | Model::Rtl8822b | Model::Rtl8822c) {
+            self.chip.clr8(usbreg::REG_SYS_STATUS1 + 1, 1);
+        }
+        self.chip.init_system_cfg(self.spec.sys_func_en);
+        Ok(())
+    }
+
+    pub(crate) fn power_off(&mut self) {
+        self.hci.disable_interrupts(&self.chip);
+        self.chip.w16(REG_WIFI_BT_INFO, BIT_BT_INT_EN as u16);
+        let _ = self.chip.power_sequence(self.spec.power_off);
+    }
+
+    /// Linux's `rtw_chip_efuse_info_setup`: the MAC on, the firmware (it
+    /// reports the hardware's features), the efuse, the MAC off again.
+    pub(crate) fn read_efuse(&mut self) -> Result<(), String> {
+        self.hci.setup(&self.chip);
+        self.mac_power_on()?;
+        self.chip.w8(REG_C2HEVT, C2H_HW_FEATURE_DUMP as u8);
+        self.download_firmware()?;
+        let ldo25 = |chip: &Chip, enable: bool| {
+            let value = chip.r8(REG_LDO_EFUSE_CTRL + 3);
+            chip.w8(REG_LDO_EFUSE_CTRL + 3, if enable { value | BIT_LDO25_EN as u8 } else { value & !(BIT_LDO25_EN as u8) });
+        };
+        let (physical, logical, protect) = self.spec.efuse_sizes;
+        let grant = self.model == Model::Rtl8723d;
+        if grant {
+            self.efuse_grant_8723x(true);
+        }
+        let map = self.chip.read_efuse(physical, logical, protect, ldo25);
+        if grant {
+            self.efuse_grant_8723x(false);
+        }
+        // The hardware's features (`rtw_dump_hw_feature`): only read, to
+        // clear the report.
+        if self.chip.r8(REG_C2HEVT) == C2H_HW_FEATURE_REPORT as u8 {
+            self.chip.w8(REG_C2HEVT, 0);
+        }
+        self.power_off();
+        let (physical, map) = map?;
+        self.physical = physical;
+        let mac_at = self.mac_offset();
+        if map.len() < mac_at + 6 {
+            return Err(String::from("the efuse is too short"));
+        }
+        if self.model == Model::Rtl8723d {
+            self.efuse_8723d(&map);
+        } else {
+            // `struct rtw88xx_efuse`: the TX power tables at 0x10, 42 bytes
+            // a path, the rest after the four paths, the PCIe MAC address
+            // at 0xd0.
+            let e = &mut self.efuse;
+            for (path, table) in e.txpwr.iter_mut().enumerate() {
+                let at = 0x10 + 42 * path;
+                table.copy_from_slice(&map[at..at + 42]);
+            }
+            e.crystal_cap = map[0xb9] & self.spec.crystal_mask;
+            e.rf_board_option = map[0xc1];
+            e.bt_setting = map[0xc3];
+            e.tx_bb_swing_2g = map[0xc6];
+            e.tx_bb_swing_5g = map[0xc7];
+            e.rfe_option = map[0xca];
+            e.address.copy_from_slice(&map[mac_at..mac_at + 6]);
+            for value in [&mut e.crystal_cap, &mut e.rf_board_option, &mut e.tx_bb_swing_2g, &mut e.tx_bb_swing_5g] {
+                if *value == 0xff {
+                    *value = 0;
+                }
+            }
+            e.share_ant = e.bt_setting & 1 != 0;
+            e.btcoex = e.rf_board_option & 0xe0 == 0x20;
+            if self.model == Model::Rtl8821c {
+                self.efuse_8821c();
+            }
+        }
+        let e = &self.efuse;
+        if !self.spec.rfes.contains(&e.rfe_option) {
+            return Err(format!("RFE type {} is not one Linux supports on this chip", e.rfe_option));
+        }
+        self.rfe = (self.spec.rfe_tables)(e.rfe_option);
+        if e.address == [0; 6] || e.address == [0xff; 6] || e.address[0] & 1 != 0 {
+            return Err(String::from("the efuse has no MAC address"));
+        }
+        Ok(())
+    }
+
+    /// Linux's `rtw_power_on` and `rtw_core_start`.
+    pub(crate) fn power_on(&mut self) -> Result<(), String> {
+        self.hci.setup(&self.chip);
+        self.mac_power_on()?;
+        self.download_firmware()?;
+        self.mac_init()?;
+        self.phy_set_param();
+        // `rtw_mac_postinit`.
+        if self.model == Model::Rtl8723d {
+            self.mac_postinit_8723x();
+        }
+        self.hci.enable_interrupts(&self.chip);
+        // The 8051 CPU's firmware takes neither.
+        if !self.spec.wcpu_8051 {
+            self.send_general_info();
+            self.send_phydm_info();
+        }
+        self.coex_power_on_setting();
+        self.coex_init_hw_config(!self.efuse.btcoex);
+        self.enable_sec_engine();
+        self.chip.w32(REG_RCR, self.rcr);
+        Ok(())
+    }
+
+    // ---- Firmware. ----
+
+    /// Linux's `rtw_download_firmware`: the 3081 CPU's, or the 8051's
+    /// (`__rtw_download_firmware_legacy`).
+    fn download_firmware(&mut self) -> Result<(), String> {
+        let firmware = core::mem::take(&mut self.firmware);
+        let result = if self.spec.wcpu_8051 { self.download_legacy(&firmware) } else { self.download(&firmware) };
+        self.firmware = firmware;
+        if self.spec.wcpu_8051 {
+            return result;
+        }
+        if result.is_err() {
+            self.chip.clr8(REG_MCUFW_CTRL, BIT_MCUFWDL_EN);
+            self.chip.set8(REG_SYS_FUNC_EN + 1, BIT_FEN_CPUEN);
+            return result;
+        }
+        // The RTL8821CE's BT device after a firmware download.
+        if self.model == Model::Rtl8821c {
+            let mut h2c = [0u8; 8];
+            h2c[0] = H2C_CMD_RECOVER_BT_DEV as u8;
+            h2c[1] = 1;
+            self.h2c(&h2c);
+        }
+        Ok(())
+    }
+
+    fn download(&mut self, data: &[u8]) -> Result<(), String> {
+        let le = |at: usize| data.get(at..at + 4).map_or(0, |b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]));
+        if data.len() < FW_HDR_SIZE as usize {
+            return Err(String::from("the firmware is too short"));
+        }
+        let mem_usage = data[0x18];
+        let (dmem, imem) = (le(0x24) + FW_HDR_CHKSUM_SIZE, le(0x30) + FW_HDR_CHKSUM_SIZE);
+        let emem = if mem_usage & (1 << 4) != 0 { le(0x34) + FW_HDR_CHKSUM_SIZE } else { 0 };
+        if FW_HDR_SIZE + dmem + imem + emem != data.len() as u32 {
+            return Err(String::from("the firmware's sizes do not add up"));
+        }
+        let lte = self.chip.ltecoex_read(0x38).ok_or_else(|| String::from("the LTE coexistence window is busy"))?;
+        self.wlan_cpu(false);
+        // Backup and the download's settings (`download_firmware_reg_backup`).
+        let c = &self.chip;
+        let backup_pq = c.r8(REG_TXDMA_PQ_MAP + 1);
+        c.w8(REG_TXDMA_PQ_MAP + 1, (RTW_DMA_MAPPING_HIGH << 6) as u8);
+        let backup_cr = c.r8(REG_CR);
+        c.w8(REG_CR, (BIT_HCI_TXDMA_EN | BIT_TXDMA_EN) as u8);
+        c.w32(REG_H2CQ_CSR, BIT_H2CQ_FULL);
+        let backup_fifo1 = c.r16(REG_FIFOPAGE_INFO_1);
+        let backup_rqpn = c.r32(REG_RQPN_CTRL_2) | BIT_LD_RQPN;
+        c.w16(REG_FIFOPAGE_INFO_1, 0x200);
+        c.w32(REG_RQPN_CTRL_2, backup_rqpn);
+        let backup_bcn = c.r8(REG_BCN_CTRL);
+        c.w8(REG_BCN_CTRL, (backup_bcn & !(BIT_EN_BCN_FUNCTION as u8)) | BIT_DIS_TSF_UDT as u8);
+        // The platform's reset.
+        c.clr8(REG_CPU_DMEM_CON + 2, BIT_WL_PLATFORM_RST >> 16);
+        c.clr8(REG_SYS_CLK_CTRL + 1, BIT_CPU_CLK_EN >> 8);
+        c.set8(REG_CPU_DMEM_CON + 2, BIT_WL_PLATFORM_RST >> 16);
+        c.set8(REG_SYS_CLK_CTRL + 1, BIT_CPU_CLK_EN >> 8);
+        // DMEM, IMEM, EMEM.
+        let value = (c.r16(REG_MCUFW_CTRL) & 0x3800) | BIT_MCUFWDL_EN as u16;
+        c.w16(REG_MCUFW_CTRL, value);
+        let mut at = FW_HDR_SIZE as usize;
+        let parts = [(le(0x20) & !(1 << 31), dmem), (le(0x3c) & !(1 << 31), imem), (le(0x38) & !(1 << 31), emem)];
+        for (dst, size) in parts {
+            if size == 0 {
+                continue;
+            }
+            self.download_to_mem(&data[at..at + size as usize], dst)?;
+            at += size as usize;
+        }
+        // Restore, then the end of the download (`download_firmware_end_flow`).
+        let c = &self.chip;
+        c.w8(REG_TXDMA_PQ_MAP + 1, backup_pq);
+        c.w8(REG_CR, backup_cr);
+        c.w32(REG_H2CQ_CSR, BIT_H2CQ_FULL);
+        c.w16(REG_FIFOPAGE_INFO_1, backup_fifo1);
+        c.w32(REG_RQPN_CTRL_2, backup_rqpn);
+        c.w8(REG_BCN_CTRL, backup_bcn);
+        c.w32(REG_TXDMA_STATUS, BTI_PAGE_OVF);
+        let control = c.r16(REG_MCUFW_CTRL);
+        if control as u32 & BIT_CHECK_SUM_OK == BIT_CHECK_SUM_OK {
+            c.w16(REG_MCUFW_CTRL, (control | BIT_FW_DW_RDY as u16) & !(BIT_MCUFWDL_EN as u16));
+        }
+        self.wlan_cpu(true);
+        if !self.chip.ltecoex_write(0x38, lte) {
+            return Err(String::from("the LTE coexistence window is busy"));
+        }
+        if !self.chip.ready(REG_MCUFW_CTRL, FW_READY_MASK, FW_READY) {
+            let key = self.chip.r32(REG_FW_DBG7) & FW_KEY_MASK;
+            return Err(format!("the firmware did not start (key {key:#x})"));
+        }
+        self.hci.setup(&self.chip);
+        self.h2c_box = 0;
+        self.h2c_seq = 0;
+        Ok(())
+    }
+
+    /// The 8051 CPU's download: the code after its header
+    /// (`struct rtw_fw_hdr_legacy`), 4 KiB pages through the window at
+    /// `FW_START_ADDR_LEGACY`, the check report, the CPU restarted on it.
+    fn download_legacy(&mut self, data: &[u8]) -> Result<(), String> {
+        const HEADER: usize = 32;
+        if data.len() <= HEADER {
+            return Err(String::from("the firmware is too short"));
+        }
+        // `en_download_firmware_legacy`.
+        self.wlan_cpu(false);
+        self.wlan_cpu(true);
+        let c = &self.chip;
+        c.set8(REG_MCUFW_CTRL, BIT_MCUFWDL_EN);
+        let mut ready = false;
+        for _ in 0..10 {
+            if c.r8(REG_MCUFW_CTRL) as u32 & BIT_MCUFWDL_EN != 0 {
+                ready = true;
+                break;
+            }
+            c.set8(REG_MCUFW_CTRL, BIT_MCUFWDL_EN);
+            crate::sleep_ms(20);
+        }
+        if !ready {
+            ostd::warn!("{}: the firmware download did not get ready", c.name);
+        }
+        c.clr32(REG_MCUFW_CTRL, BIT_ROM_DLEN);
+        // `download_firmware_legacy`.
+        c.set8(REG_MCUFW_CTRL, BIT_FWDL_CHK_RPT);
+        for (page, chunk) in data[HEADER..].chunks(DLFW_PAGE_SIZE_LEGACY as usize).enumerate() {
+            self.write_firmware_page(page as u32, chunk);
+        }
+        let c = &self.chip;
+        let reported = c.ready(REG_MCUFW_CTRL, BIT_FWDL_CHK_RPT, 1);
+        c.clr8(REG_MCUFW_CTRL, BIT_MCUFWDL_EN);
+        if !reported {
+            return Err(String::from("the firmware's download was not reported"));
+        }
+        // `download_firmware_validate_legacy`.
+        let value = (c.r32(REG_MCUFW_CTRL) | BIT_MCUFWDL_RDY) & !BIT_WINTINI_RDY;
+        c.w32(REG_MCUFW_CTRL, value);
+        self.wlan_cpu(false);
+        self.wlan_cpu(true);
+        let mut started = false;
+        for _ in 0..10 {
+            if self.chip.r32(REG_MCUFW_CTRL) & FW_READY_LEGACY == FW_READY_LEGACY {
+                started = true;
+                break;
+            }
+            crate::sleep_ms(20);
+        }
+        if !started {
+            return Err(format!("the firmware did not start ({:#x})", self.chip.r32(REG_MCUFW_CTRL)));
+        }
+        self.hci.setup(&self.chip);
+        self.h2c_box = 0;
+        self.h2c_seq = 0;
+        Ok(())
+    }
+
+    /// `rtw_write_firmware_page`: the page's number, then its words (on
+    /// USB in blocks of 254 bytes, `rtw_usb_write_firmware_page`).
+    fn write_firmware_page(&self, page: u32, data: &[u8]) {
+        let c = &self.chip;
+        let value = (c.r32(REG_MCUFW_CTRL) & !BIT_ROM_PGE) | ((page << BIT_SHIFT_ROM_PGE) & BIT_ROM_PGE);
+        c.w32(REG_MCUFW_CTRL, value);
+        if c.usb() {
+            let block = if self.model == Model::Rtl8723d { 254 } else { 196 };
+            let (mut at, mut addr) = (0usize, FW_START_ADDR_LEGACY);
+            while at < data.len() {
+                let left = data.len() - at;
+                let n = if left >= block { block } else if left >= 8 { 8 } else { 1 };
+                if !c.write_block(addr, &data[at..at + n]) {
+                    ostd::warn!("{}: a firmware block did not go", c.name);
+                    return;
+                }
+                at += n;
+                addr += n as u32;
+            }
+            return;
+        }
+        for (index, word) in data.chunks(4).enumerate() {
+            let mut bytes = [0u8; 4];
+            bytes[..word.len()].copy_from_slice(word);
+            c.w32(FW_START_ADDR_LEGACY + 4 * index as u32, u32::from_le_bytes(bytes));
+        }
+    }
+
+    fn wlan_cpu(&self, enable: bool) {
+        if enable {
+            self.chip.set8(REG_RSV_CTRL + 1, BIT_WLMCU_IOIF);
+            self.chip.set8(REG_SYS_FUNC_EN + 1, BIT_FEN_CPUEN);
+        } else {
+            self.chip.clr8(REG_SYS_FUNC_EN + 1, BIT_FEN_CPUEN);
+            self.chip.clr8(REG_RSV_CTRL + 1, BIT_WLMCU_IOIF);
+        }
+    }
+
+    /// Linux's `download_firmware_to_mem`: 4 KiB at a time through the
+    /// reserved pages, then the DDMA into the CPU's memory.
+    fn download_to_mem(&mut self, data: &[u8], dst: u32) -> Result<(), String> {
+        self.chip.set32(REG_DDMA_CH0CTRL, BIT_DDMACH0_RESET_CHKSUM_STS);
+        let mut offset = 0usize;
+        let mut first = true;
+        while offset < data.len() {
+            let size = (data.len() - offset).min(0x1000);
+            // On USB a transfer that fills its last packet gets a byte more
+            // (`send_firmware_pkt`); the DDMA takes `size`.
+            if self.chip.usb() && (size + TX_DESC_SIZE_88XX).is_multiple_of(512) {
+                let mut padded = data[offset..offset + size].to_vec();
+                padded.push(0);
+                self.write_rsvd_page(0, &padded)?;
+            } else {
+                self.write_rsvd_page(0, &data[offset..offset + size])?;
+            }
+            if !self.chip.ready(REG_DDMA_CH0CTRL, BIT_DDMACH0_OWN, 0) {
+                return Err(String::from("the DDMA is busy"));
+            }
+            let mut control = BIT_DDMACH0_CHKSUM_EN | BIT_DDMACH0_OWN | (size as u32 & BIT_MASK_DDMACH0_DLEN);
+            if !first {
+                control |= BIT_DDMACH0_CHKSUM_CONT;
+            }
+            self.chip.w32(REG_DDMA_CH0SA, OCPBASE_TXBUF_88XX + self.hci.tx_desc() as u32);
+            self.chip.w32(REG_DDMA_CH0DA, dst + offset as u32);
+            self.chip.w32(REG_DDMA_CH0CTRL, control);
+            if !self.chip.ready(REG_DDMA_CH0CTRL, BIT_DDMACH0_OWN, 0) {
+                return Err(String::from("the DDMA did not finish"));
+            }
+            first = false;
+            offset += size;
+        }
+        // The checksum (`check_fw_checksum`).
+        let mut control = self.chip.r8(REG_MCUFW_CTRL) as u32;
+        let ok = self.chip.r32(REG_DDMA_CH0CTRL) & BIT_DDMACH0_CHKSUM_STS == 0;
+        let (done, good) = if dst < OCPBASE_DMEM_88XX { (BIT_IMEM_DW_OK, BIT_IMEM_CHKSUM_OK) } else { (BIT_DMEM_DW_OK, BIT_DMEM_CHKSUM_OK) };
+        control |= done;
+        if ok {
+            control |= good;
+        } else {
+            control &= !good;
+        }
+        self.chip.w8(REG_MCUFW_CTRL, control as u8);
+        if ok { Ok(()) } else { Err(String::from("the firmware's checksum is wrong")) }
+    }
+
+    /// Linux's `rtw_fw_write_data_rsvd_page` (the 8051 CPU's chips flag
+    /// the beacon's page in `DWBCN0_CTRL`).
+    pub(crate) fn write_rsvd_page(&mut self, page: u32, data: &[u8]) -> Result<(), String> {
+        let legacy = self.spec.wcpu_8051;
+        let c = &self.chip;
+        let backup_bcn = c.r8(REG_BCN_CTRL);
+        if legacy {
+            c.set32(REG_DWBCN0_CTRL, BIT_BCN_VALID);
+        } else {
+            c.w16(REG_FIFOPAGE_CTRL_2, ((page & BIT_MASK_BCN_HEAD_1_V1) | BIT_BCN_VALID_V1) as u16);
+        }
+        let backup_cr = c.r8(REG_CR + 1);
+        c.w8(REG_CR + 1, backup_cr | (BIT_ENSWBCN >> 8) as u8);
+        c.w8(REG_BCN_CTRL, (backup_bcn & !(BIT_EN_BCN_FUNCTION as u8)) | BIT_DIS_TSF_UDT as u8);
+        let usb = c.usb();
+        let backup_txq = c.r8(REG_FWHW_TXQ_CTRL + 2);
+        if !usb {
+            c.w8(REG_FWHW_TXQ_CTRL + 2, backup_txq & !((BIT_EN_BCNQ_DL >> 16) as u8));
+        }
+        // `rtw_tx_rsvd_page_pkt_info_update` for the first (beacon) page.
+        let ghz2 = self.channel <= 14;
+        let info = TxInfo {
+            offset: self.hci.tx_desc() as u8,
+            bmc: data.get(4).is_some_and(|byte| byte & 1 != 0),
+            ls: true,
+            dis_qselseq: true,
+            en_hwseq: true,
+            qsel: TX_DESC_QSEL_BEACON as u8,
+            rate_id: if ghz2 { RTW_RATEID_B_20M } else { RTW_RATEID_G } as u8,
+            rate: if ghz2 { DESC_RATE1M } else { DESC_RATE6M } as u8,
+            use_rate: true,
+            dis_rate_fallback: true,
+            ..TxInfo::default()
+        };
+        let mut result = self.hci.write_rsvd_page(&self.chip, &info, data).map_err(|()| String::from("a reserved page did not fit"));
+        let (valid_at, valid) = if legacy { (REG_DWBCN0_CTRL, BIT_BCN_VALID) } else { (REG_FIFOPAGE_CTRL_2, BIT_BCN_VALID_V1) };
+        if result.is_ok() && !self.chip.ready(valid_at, valid, 1) {
+            result = Err(String::from("the reserved page was not taken"));
+        }
+        let c = &self.chip;
+        c.w16(REG_FIFOPAGE_CTRL_2, (self.rsvd_boundary | BIT_BCN_VALID_V1) as u16);
+        c.w8(REG_BCN_CTRL, backup_bcn);
+        if !usb {
+            c.w8(REG_FWHW_TXQ_CTRL + 2, backup_txq);
+        }
+        c.w8(REG_CR + 1, backup_cr);
+        result
+    }
+
+    // ---- The firmware's commands. ----
+
+    /// Linux's `rtw_fw_send_h2c_command`: the next mailbox.
+    pub(crate) fn h2c(&mut self, command: &[u8; 8]) {
+        let (boxes, extras) = ([REG_HMEBOX0, REG_HMEBOX1, REG_HMEBOX2, REG_HMEBOX3], [REG_HMEBOX0_EX, REG_HMEBOX1_EX, REG_HMEBOX2_EX, REG_HMEBOX3_EX]);
+        let mailbox = self.h2c_box as usize;
+        let mut free = false;
+        for _ in 0..30 {
+            if (self.chip.r8(REG_HMETFR) >> mailbox) & 1 == 0 {
+                free = true;
+                break;
+            }
+            crate::delay_us(100);
+        }
+        if !free {
+            ostd::warn!("{}: the firmware did not take an H2C command ({:#x})", self.chip.name, command[0]);
+            return;
+        }
+        self.chip.w32(extras[mailbox], u32::from_le_bytes([command[4], command[5], command[6], command[7]]));
+        self.chip.w32(boxes[mailbox], u32::from_le_bytes([command[0], command[1], command[2], command[3]]));
+        self.h2c_box = (self.h2c_box + 1) % 4;
+    }
+
+    /// Linux's `rtw_fw_send_h2c_packet`: through the H2C queue.
+    pub(crate) fn h2c_packet(&mut self, sub_id: u8, payload: &[u8]) {
+        let mut packet = [0u8; H2C_PKT_SIZE as usize];
+        let word0 = (H2C_PKT_CATEGORY & 0x7f) | ((H2C_PKT_CMD_ID & 0xff) << 8) | ((sub_id as u32) << 16);
+        packet[0..4].copy_from_slice(&word0.to_le_bytes());
+        let total = (H2C_PKT_HDR_SIZE as usize + payload.len()) as u16;
+        packet[4..6].copy_from_slice(&total.to_le_bytes());
+        packet[6..8].copy_from_slice(&self.h2c_seq.to_le_bytes());
+        packet[8..8 + payload.len()].copy_from_slice(payload);
+        self.h2c_seq = self.h2c_seq.wrapping_add(1);
+        if self.hci.write_h2c(&self.chip, &packet).is_err() {
+            ostd::warn!("{}: the H2C queue is full", self.chip.name);
+        }
+    }
+
+    fn send_general_info(&mut self) {
+        let boundary = (self.rsvd_fw_txbuf_addr.wrapping_sub(self.rsvd_boundary)) as u8;
+        self.h2c_packet(H2C_PKT_GENERAL_INFO as u8, &[0, 0, boundary, 0]);
+    }
+
+    fn send_phydm_info(&mut self) {
+        let two = self.paths() == 2;
+        let rf_type = if two { FW_RF_2T2R } else { FW_RF_1T1R } as u8;
+        let paths = if two { 3u8 } else { 1 };
+        self.h2c_packet(H2C_PKT_PHYDM_INFO as u8, &[self.efuse.rfe_option, rf_type, self.chip.cut, (paths & 0xf) | (paths << 4), 0, 0, 0, 0]);
+    }
+
+    /// The access point's rates for the firmware's rate adaptation
+    /// (`rtw_fw_send_ra_info`).
+    /// `rtw_fw_send_ra_info`: the station's rate set, its width
+    /// (`RTW_CHANNEL_WIDTH_*`) and whether it runs VHT.
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn ra_info(&mut self, mac_id: u8, rate_id: u8, mask: u32, init_level: u8, sgi: bool, bw: u32, ldpc: bool, vht: bool, reset: bool) {
+        let word0 = H2C_CMD_RA_INFO
+            | ((mac_id as u32) << 8)
+            | ((rate_id as u32 & 0x1f) << 16)
+            | ((init_level as u32 & 3) << 21)
+            | ((sgi as u32) << 23)
+            | ((bw & 3) << 24)
+            | ((ldpc as u32) << 26)
+            | ((!reset as u32) << 27)
+            | ((vht as u32) << 28)
+            | (1 << 30);
+        let mut command = [0u8; 8];
+        command[0..4].copy_from_slice(&word0.to_le_bytes());
+        command[4..8].copy_from_slice(&mask.to_le_bytes());
+        self.h2c(&command);
+    }
+
+    /// The link's signal for the rate adaptation (`rtw_fw_send_rssi_info`),
+    /// in Linux's 0..100 scale.
+    /// `rtw_fw_set_pwr_mode`: leisure power save (`rtw_enter_lps_core`: the
+    /// firmware dozes between beacons, the access point told by null
+    /// frames, `smart_ps` 2) on port 0, or awake again
+    /// (`rtw_leave_lps_core`), waiting for the firmware's null frame to be
+    /// acknowledged (`__rtw_fw_leave_lps_check_reg`).
+    pub(crate) fn set_pwr_mode(&mut self, lps: bool) {
+        let (mode, rlbm, smart_ps, state) = if lps { (RTW_MODE_LPS, 1, 2, RTW_RF_OFF) } else { (RTW_MODE_ACTIVE, 0, 0, RTW_ALL_ON) };
+        let word0 = H2C_CMD_SET_PWR_MODE | (mode << 8) | (rlbm << 16) | (smart_ps << 20) | (1 << 24);
+        let word1 = state << 8;
+        let mut command = [0u8; 8];
+        command[0..4].copy_from_slice(&word0.to_le_bytes());
+        command[4..8].copy_from_slice(&word1.to_le_bytes());
+        self.h2c(&command);
+        if lps {
+            return;
+        }
+        for _ in 0..LEAVE_LPS_TRIES {
+            if self.chip.r32(REG_TCR) & BIT_PWRMGT_HWDATA_EN == 0 {
+                return;
+            }
+            crate::sleep_ms(20);
+        }
+        self.chip.clr32(REG_TCR, BIT_PWRMGT_HWDATA_EN);
+        ostd::warn!("{}: the firmware did not leave power save", self.chip.name);
+    }
+
+    pub(crate) fn rssi_info(&mut self, mac_id: u8, signal: i8) {
+        let rssi = (signal as i32 + 100).clamp(0, 100) as u32;
+        let word0 = H2C_CMD_RSSI_MONITOR | ((mac_id as u32) << 8) | (rssi << 24);
+        let mut command = [0u8; 8];
+        command[0..4].copy_from_slice(&word0.to_le_bytes());
+        self.h2c(&command);
+    }
+
+    /// `rtw_fw_media_status_report`.
+    pub(crate) fn media_status(&mut self, mac_id: u8, connected: bool) {
+        let word0 = H2C_CMD_MEDIA_STATUS_RPT | ((connected as u32) << 8) | ((mac_id as u32) << 16);
+        let mut command = [0u8; 8];
+        command[0..4].copy_from_slice(&word0.to_le_bytes());
+        self.h2c(&command);
+    }
+
+    /// `rtw_fw_default_port`.
+    pub(crate) fn default_port(&mut self, port: u8, mac_id: u8) {
+        let word0 = H2C_CMD_DEFAULT_PORT | ((port as u32) << 8) | ((mac_id as u32) << 16);
+        let mut command = [0u8; 8];
+        command[0..4].copy_from_slice(&word0.to_le_bytes());
+        self.h2c(&command);
+    }
+
+    // ---- The MAC. ----
+
+    /// Linux's `rtw_mac_init`.
+    fn mac_init(&mut self) -> Result<(), String> {
+        let c = &self.chip;
+        // `txdma_queue_mapping`: PCIe the chips' `rqpn_table[1]`, USB the
+        // one of its bulk OUT endpoints.
+        let [vo, vi, be, bk, mg, hi] = match self.hci.bulk_out() {
+            None => [RTW_DMA_MAPPING_NORMAL, RTW_DMA_MAPPING_NORMAL, RTW_DMA_MAPPING_LOW, RTW_DMA_MAPPING_LOW, RTW_DMA_MAPPING_EXTRA, RTW_DMA_MAPPING_HIGH],
+            Some(endpoints) => usbreg::rqpn(endpoints.clamp(2, 4)),
+        };
+        let map = (hi << BIT_SHIFT_TXDMA_HIQ_MAP) | (mg << BIT_SHIFT_TXDMA_MGQ_MAP) | (bk << BIT_SHIFT_TXDMA_BKQ_MAP) | (be << BIT_SHIFT_TXDMA_BEQ_MAP) | (vi << BIT_SHIFT_TXDMA_VIQ_MAP) | (vo << BIT_SHIFT_TXDMA_VOQ_MAP);
+        c.w16(REG_TXDMA_PQ_MAP, map as u16);
+        c.w8(REG_CR, 0);
+        c.w8(REG_CR, MAC_TRX_ENABLE as u8);
+        let legacy = self.spec.wcpu_8051;
+        if !legacy {
+            c.w32(REG_H2CQ_CSR, BIT_H2CQ_FULL);
+        }
+        if c.usb() {
+            c.set8(REG_TXDMA_PQ_MAP, usbreg::BIT_RXDMA_ARBBW_EN);
+        }
+        // `rtw_set_trx_fifo_info` and `priority_queue_cfg` (`page_table[1]`):
+        // the 8051 CPU's chips reserve the driver's pages only.
+        let txff_pg_num = self.spec.txff_size / PAGE_SIZE;
+        let rsvd_pg_num = if legacy {
+            self.spec.rsvd_drv_pages
+        } else {
+            self.spec.rsvd_drv_pages + RSVD_PG_H2C_EXTRAINFO_NUM + RSVD_PG_H2C_STATICINFO_NUM + RSVD_PG_H2CQ_NUM + RSVD_PG_CPU_INSTRUCTION_NUM + RSVD_PG_FW_TXBUF_NUM + self.spec.csi_pages
+        };
+        let acq_pg_num = txff_pg_num - rsvd_pg_num;
+        self.rsvd_boundary = txff_pg_num - rsvd_pg_num;
+        let [hq, nq, lq, exq, gapq] = self.pages;
+        let pubq = acq_pg_num - hq - lq - nq - exq - gapq;
+        if legacy {
+            self.priority_queue_cfg_legacy(pubq)?;
+        } else {
+            self.priority_queue_cfg(pubq)?;
+        }
+        match self.model {
+            Model::Rtl8821c => self.mac_init_8821c(),
+            Model::Rtl8822b => self.mac_init_8822b(),
+            Model::Rtl8822c => self.mac_init_8822c(),
+            Model::Rtl8723d => self.mac_init_8723x(),
+        }
+        // `rtw_drv_info_cfg`.
+        let c = &self.chip;
+        c.w8(REG_RX_DRVINFO_SZ, PHY_STATUS_SIZE as u8);
+        if !legacy {
+            c.w8(REG_TRXFF_BNDY + 1, (c.r8(REG_TRXFF_BNDY + 1) & 0xf0) | 0x0f);
+        }
+        c.set32(REG_RCR, BIT_APP_PHYSTS);
+        c.clr32(REG_WMAC_OPTION_FUNCTION + 4, (1 << 8) | (1 << 9));
+        self.usb_interface_cfg();
+        Ok(())
+    }
+
+    /// `__priority_queue_cfg_legacy`: the queues' pages and the FIFO's
+    /// boundaries in the older registers, the link list built.
+    fn priority_queue_cfg_legacy(&self, pubq: u32) -> Result<(), String> {
+        let [hq, nq, lq, exq, _] = self.pages;
+        let boundary = self.rsvd_boundary;
+        let c = &self.chip;
+        c.w32(REG_RQPN_NPQ, ((nq & BIT_MASK_NPQ) << BIT_SHIFT_NPQ) | ((exq & BIT_MASK_EPQ) << BIT_SHIFT_EPQ));
+        c.w32(REG_RQPN, BIT_LD_RQPN | ((hq & BIT_MASK_HPQ) << BIT_SHIFT_HPQ) | ((lq & BIT_MASK_LPQ) << BIT_SHIFT_LPQ) | ((pubq & BIT_MASK_PUBQ) << BIT_SHIFT_PUBQ));
+        c.w8(REG_TRXFF_BNDY, boundary as u8);
+        c.w16(REG_TRXFF_BNDY + 2, (self.spec.rxff_size - REPORT_BUF - 1) as u16);
+        c.w8(REG_DWBCN0_CTRL + 1, boundary as u8);
+        c.w8(REG_BCNQ_BDNY, boundary as u8);
+        c.w8(REG_MGQ_BDNY, boundary as u8);
+        c.w8(REG_WMAC_LBK_BF_HD, boundary as u8);
+        c.set32(REG_AUTO_LLT, BIT_AUTO_INIT_LLT);
+        if !c.ready(REG_AUTO_LLT, BIT_AUTO_INIT_LLT, 0) {
+            return Err(String::from("the FIFO's link list did not initialise"));
+        }
+        Ok(())
+    }
+
+    /// `__priority_queue_cfg` and `init_h2c` (the 3081 CPU's): the
+    /// reserved pages' addresses, the queues' pages, the H2C queue.
+    fn priority_queue_cfg(&mut self, pubq: u32) -> Result<(), String> {
+        let txff_pg_num = self.spec.txff_size / PAGE_SIZE;
+        let mut cur = txff_pg_num;
+        // The 3081 CPU's CSI buffer first (`rsvd_csibuf_addr`).
+        cur -= self.spec.csi_pages;
+        cur -= RSVD_PG_FW_TXBUF_NUM;
+        self.rsvd_fw_txbuf_addr = cur;
+        cur -= RSVD_PG_CPU_INSTRUCTION_NUM;
+        cur -= RSVD_PG_H2CQ_NUM;
+        self.rsvd_h2cq_addr = cur;
+        let [hq, nq, lq, exq, _] = self.pages;
+        let c = &self.chip;
+        c.w16(REG_FIFOPAGE_INFO_1, hq as u16);
+        c.w16(REG_FIFOPAGE_INFO_2, lq as u16);
+        c.w16(REG_FIFOPAGE_INFO_3, nq as u16);
+        c.w16(REG_FIFOPAGE_INFO_4, exq as u16);
+        c.w16(REG_FIFOPAGE_INFO_5, pubq as u16);
+        c.set32(REG_RQPN_CTRL_2, BIT_LD_RQPN);
+        c.w16(REG_FIFOPAGE_CTRL_2, self.rsvd_boundary as u16);
+        c.set8(REG_FWHW_TXQ_CTRL + 2, BIT_EN_WR_FREE_TAIL >> 16);
+        c.w16(REG_BCNQ_BDNY_V1, self.rsvd_boundary as u16);
+        c.w16(REG_FIFOPAGE_CTRL_2 + 2, self.rsvd_boundary as u16);
+        c.w16(REG_BCNQ1_BDNY_V1, self.rsvd_boundary as u16);
+        c.w32(REG_RXFF_BNDY, self.spec.rxff_size - C2H_PKT_BUF - 1);
+        if c.usb() {
+            let descriptors = self.spec.usb_tx_agg_desc_num as u32;
+            c.w8_mask(REG_AUTO_LLT_V1, usbreg::BIT_MASK_BLK_DESC_NUM, descriptors);
+            c.w8(REG_AUTO_LLT_V1 + 3, descriptors as u8);
+            c.set8(REG_TXDMA_OFFSET_CHK + 1, 1 << 1);
+        }
+        c.set8(REG_AUTO_LLT_V1, BIT_AUTO_INIT_LLT_V1);
+        if !c.ready(REG_AUTO_LLT_V1, BIT_AUTO_INIT_LLT_V1, 0) {
+            return Err(String::from("the FIFO's link list did not initialise"));
+        }
+        c.w8(REG_CR + 3, 0);
+        // `init_h2c`.
+        let h2cq_addr = self.rsvd_h2cq_addr << TX_PAGE_SIZE_SHIFT;
+        let h2cq_size = RSVD_PG_H2CQ_NUM << TX_PAGE_SIZE_SHIFT;
+        c.w32(REG_H2C_HEAD, (c.r32(REG_H2C_HEAD) & 0xfffc_0000) | h2cq_addr);
+        c.w32(REG_H2C_READ_ADDR, (c.r32(REG_H2C_READ_ADDR) & 0xfffc_0000) | h2cq_addr);
+        c.w32(REG_H2C_TAIL, (c.r32(REG_H2C_TAIL) & 0xfffc_0000) | (h2cq_addr + h2cq_size));
+        c.w8(REG_H2C_INFO, (c.r8(REG_H2C_INFO) & 0xfc) | 0x01);
+        c.w8(REG_H2C_INFO, (c.r8(REG_H2C_INFO) & 0xfb) | 0x04);
+        c.w8(REG_TXDMA_OFFSET_CHK + 1, (c.r8(REG_TXDMA_OFFSET_CHK + 1) & 0x7f) | 0x80);
+        let (wp, rp) = (c.r32(REG_H2C_PKT_WRITEADDR) & 0x3ffff, c.r32(REG_H2C_PKT_READADDR) & 0x3ffff);
+        let free = if wp >= rp { h2cq_size - (wp - rp) } else { rp - wp };
+        if free != h2cq_size {
+            return Err(String::from("the H2C queue does not match"));
+        }
+        Ok(())
+    }
+
+    /// The MAC settings the chips share (`rtw88xx_mac_init`'s common part).
+    pub(crate) fn mac_init_common(&self) {
+        let c = &self.chip;
+        c.w32(REG_PROT_MODE_CTRL, WLAN_RTS_LEN_TH | (WLAN_RTS_TX_TIME_TH << 8) | (WLAN_MAX_AGG_PKT_LIMIT << 16) | (WLAN_RTS_MAX_AGG_PKT_LIMIT << 24));
+        c.w16(REG_BAR_MODE_CTRL + 2, (WLAN_BAR_RETRY_LIMIT | (WLAN_RA_TRY_RATE_AGG_LIMIT << 8)) as u16);
+        c.w8(REG_FAST_EDCA_VOVI_SETTING, FAST_EDCA_VO_TH as u8);
+        c.w8(REG_FAST_EDCA_VOVI_SETTING + 2, FAST_EDCA_VI_TH as u8);
+        c.w8(REG_FAST_EDCA_BEBK_SETTING, FAST_EDCA_BE_TH as u8);
+        c.w8(REG_FAST_EDCA_BEBK_SETTING + 2, FAST_EDCA_BK_TH as u8);
+    }
+
+    /// EDCA, beacon control and the WMAC (both chips' `mac_init` tail).
+    pub(crate) fn mac_init_edca_wmac(&self) {
+        let c = &self.chip;
+        c.clr8(REG_TIMER0_SRC_SEL, BIT_TSFT_SEL_TIMER0);
+        c.w16(REG_TXPAUSE, 0);
+        c.w8(REG_SLOT, WLAN_SLOT_TIME as u8);
+        c.w8(REG_PIFS, WLAN_PIFS_TIME as u8);
+        c.w32(REG_SIFS, WLAN_SIFS_CFG);
+        c.w16(REG_EDCA_VO_PARAM + 2, WLAN_VO_TXOP_LIMIT as u16);
+        c.w16(REG_EDCA_VI_PARAM + 2, WLAN_VI_TXOP_LIMIT as u16);
+        c.w32(REG_RD_NAV_NXT, WLAN_NAV_CFG);
+        c.w16(REG_RXTSF_OFFSET_CCK, WLAN_RX_TSF_CFG as u16);
+        // Beacon control: TSF and the related functions.
+        c.set8(REG_BCN_CTRL, BIT_EN_BCN_FUNCTION);
+        c.w32(REG_TBTT_PROHIBIT, WLAN_TBTT_TIME);
+        c.w8(REG_DRVERLYINT, WLAN_DRV_EARLY_INT as u8);
+        c.w8(REG_BCNDMATIM, WLAN_BCN_DMA_TIME as u8);
+        c.clr8(REG_TX_PTCL_CTRL + 1, BIT_SIFS_BK_EN >> 8);
+        // WMAC.
+        c.w32(REG_RXFLTMAP0, WLAN_RX_FILTER0);
+        c.w16(REG_RXFLTMAP2, WLAN_RX_FILTER2 as u16);
+        c.w32(REG_RCR, WLAN_RCR_CFG);
+        c.w8(REG_RX_PKT_LIMIT, WLAN_RXPKT_MAX_SZ_512 as u8);
+        c.w8(REG_TCR + 2, WLAN_TX_FUNC_CFG2 as u8);
+        c.w8(REG_TCR + 1, WLAN_TX_FUNC_CFG1 as u8);
+    }
+
+    /// `rtw_sec_enable_sec_engine` (default key search).
+    fn enable_sec_engine(&self) {
+        self.chip.set16(REG_CR, RTW_SEC_ENGINE_EN);
+        let config = self.chip.r16(RTW_SEC_CONFIG) as u32 | RTW_SEC_TX_DEC_EN | RTW_SEC_RX_DEC_EN | RTW_SEC_TX_UNI_USE_DK | RTW_SEC_RX_UNI_USE_DK | RTW_SEC_TX_BC_USE_DK | RTW_SEC_RX_BC_USE_DK;
+        self.chip.w16(RTW_SEC_CONFIG, config as u16);
+    }
+
+    // ---- The PHY. ----
+
+    /// `rtw_write_rf`: through the SIPI of a path, or the direct window
+    /// (`rtw_phy_write_rf_reg_mix`: but for register 0).
+    pub(crate) fn write_rf_path(&self, path: usize, addr: u32, mask: u32, data: u32) {
+        let addr = addr & 0xff;
+        let mask = mask & RFREG_MASK;
+        if self.spec.rf_direct && addr != 0 {
+            self.chip.w32_mask(self.spec.rf_base[path] + (addr << 2), mask, data);
+            crate::delay_us(1);
+            return;
+        }
+        let data = if mask == RFREG_MASK { data } else { (self.read_rf_path(path, addr, RFREG_MASK) & !mask) | (data << mask.trailing_zeros()) };
+        self.chip.write_rf_sipi(self.spec.rf_sipi[path], addr, data);
+    }
+
+    /// `rtw_read_rf`: the direct window, or the 11n chips' LSSI
+    /// (`rtw_phy_read_rf_sipi`).
+    pub(crate) fn read_rf_path(&self, path: usize, addr: u32, mask: u32) -> u32 {
+        match &self.spec.sipi_read {
+            Some(read) => self.chip.read_rf_sipi(read, path, addr, mask),
+            None => self.chip.read_rf(self.spec.rf_base[path], addr, mask),
+        }
+    }
+
+    pub(crate) fn write_rf(&self, addr: u32, mask: u32, data: u32) {
+        self.write_rf_path(0, addr, mask, data);
+    }
+
+    pub(crate) fn read_rf(&self, addr: u32, mask: u32) -> u32 {
+        self.read_rf_path(0, addr, mask)
+    }
+
+    /// `rtw_write32s_mask`: a BB register of path A and its copy for path B
+    /// (0xc00-0xcff and 0xe00-0xeff have the same layout).
+    pub(crate) fn w32s_mask(&self, addr: u32, mask: u32, data: u32) {
+        self.chip.w32_mask(addr, mask, data);
+        self.chip.w32_mask(addr + 0x200, mask, data);
+    }
+
+    /// Linux's `rtw_parse_tbl_phy_cond` over one table.
+    fn load_table(&self, table: &[u32], apply: impl Fn(&Self, u32, u32)) {
+        let cut = if self.chip.cut != 0 { self.chip.cut as u32 } else { 15 };
+        let pkg = if self.efuse.pkg_type != 0 { self.efuse.pkg_type as u32 } else { 15 };
+        let rfe = self.efuse.rfe_option as u32;
+        let (mut matched, mut skipped) = (true, false);
+        let mut condition = 0u32;
+        for pair in table.chunks_exact(2) {
+            let (word, data) = (pair[0], pair[1]);
+            let (pos, neg, branch) = (word >> 31 & 1, word >> 30 & 1, (word >> 28) & 3);
+            if pos != 0 {
+                match branch {
+                    3 => {
+                        matched = true;
+                        skipped = false;
+                    }
+                    2 => matched = !skipped,
+                    _ => condition = word,
+                }
+            } else if neg != 0 {
+                if !skipped {
+                    let (c_rfe, c_intf, c_pkg, c_cut) = (condition & 0xff, (condition >> 8) & 0xf, (condition >> 12) & 0xf, (condition >> 24) & 0xf);
+                    let positive = (c_cut == 0 || c_cut == cut) && (c_pkg == 0 || c_pkg == pkg) && (c_intf == 0 || c_intf == if self.chip.usb() { usbreg::INTF_USB } else { INTF_PCIE }) && c_rfe == rfe;
+                    matched = positive;
+                    skipped = positive;
+                } else {
+                    matched = false;
+                }
+            } else if matched {
+                apply(self, word, data);
+            }
+        }
+    }
+
+    /// `rtw_phy_load_tables`: MAC, BB, AGC (with the BT-shared antenna's
+    /// table), each path's RF.
+    pub(crate) fn load_tables(&self) {
+        let bb = |hw: &Self, addr: u32, data: u32| match addr {
+            0xfe => crate::delay_ms(50),
+            0xfd => crate::delay_ms(5),
+            0xfc => crate::delay_ms(1),
+            0xfb => crate::delay_us(50),
+            0xfa => crate::delay_us(5),
+            0xf9 => crate::delay_us(1),
+            _ => hw.chip.w32(addr, data),
+        };
+        self.load_table(self.spec.mac, |hw, addr, data| hw.chip.w8(addr, data as u8));
+        self.load_table(self.spec.bb, bb);
+        self.load_table(self.spec.agc, bb);
+        if let Some(agc) = self.rfe.as_ref().and_then(|rfe| rfe.agc_btg) {
+            self.load_table(agc, bb);
+        }
+        // `rtw_load_rfk_table`.
+        if !self.spec.rfk_init.is_empty() {
+            let c = &self.chip;
+            c.w32_mask(0x1e24, 1 << 17, 0x1);
+            c.w32_mask(0x1cd0, 1 << 28, 0x1);
+            c.w32_mask(0x1cd0, 1 << 29, 0x1);
+            c.w32_mask(0x1cd0, 1 << 30, 0x1);
+            c.w32_mask(0x1cd0, 1 << 31, 0x0);
+            self.load_table(self.spec.rfk_init, bb);
+        }
+        for path in 0..self.paths() {
+            self.load_table(self.spec.rf[path], |hw, addr, data| match addr {
+                0xffe => crate::delay_ms(50),
+                0xfe => crate::delay_us(100),
+                _ => {
+                    hw.write_rf_path(path, addr, RFREG_MASK, data);
+                    crate::delay_us(1);
+                }
+            });
+        }
+    }
+
+    /// The crystal's capacitance (both chips' `phy_set_param`).
+    pub(crate) fn set_crystal_cap(&self) {
+        let crystal = (self.efuse.crystal_cap & 0x3f) as u32;
+        self.chip.w32_mask(REG_AFE_XTAL_CTRL, 0x7e00_0000, crystal);
+        self.chip.w32_mask(REG_AFE_PLL_CTRL, 0x7e, crystal);
+    }
+
+    /// `rtw_bf_phy_init`.
+    pub(crate) fn phy_bf_init(&self) {
+        let c = &self.chip;
+        let mut mu = c.r32(REG_MU_TX_CTL);
+        mu |= BIT_MU_P1_WAIT_STATE_EN;
+        mu = (mu & !BIT_MASK_R_MU_RL) | ((0xa << BIT_SHIFT_R_MU_RL) & BIT_MASK_R_MU_RL);
+        mu &= !(BIT_EN_MU_MIMO | BIT_MASK_R_MU_TABLE_VALID);
+        c.w32(REG_MU_TX_CTL, mu);
+        c.w8(REG_WMAC_MU_BF_OPTION, ((3 << BIT_SHIFT_WMAC_TXMU_ACKPOLICY) | BIT_WMAC_TXMU_ACKPOLICY_EN) as u8);
+        c.w16(REG_WMAC_MU_BF_CTL, 0);
+        c.set32(REG_TXBF_CTRL, BIT_USE_NDPA_PARAMETER);
+        c.w8(REG_NDPA_OPT_CTRL, 0x10);
+        c.w32_mask(REG_BBPSF_CTRL, BIT_MASK_CSI_RATE, DESC_RATE6M);
+    }
+
+    fn phy_set_param(&mut self) {
+        match self.model {
+            Model::Rtl8821c => self.phy_set_param_8821c(),
+            Model::Rtl8822b => self.phy_set_param_8822b(),
+            Model::Rtl8822c => self.phy_set_param_8822c(),
+            Model::Rtl8723d => self.phy_set_param_8723d(),
+        }
+    }
+
+    /// The chips' `pwrtrack_init`: the OFDM swing in use.
+    pub(crate) fn pwrtrack_init(&mut self) {
+        let swing = self.chip.r32_mask(REG_TXSCALE_A, 0xffe0_0000);
+        self.default_ofdm_index = TXSCALE.iter().position(|&value| value == swing).unwrap_or(24) as u8;
+    }
+
+    // ---- The channel. ----
+
+    /// A channel at 20 MHz.
+    pub(crate) fn set_channel(&mut self, channel: u8, scanning: bool) {
+        self.set_tune(Tune::simple(channel), scanning);
+    }
+
+    /// Linux's `rtw_set_channel`: the chip's `set_channel` on the centre
+    /// channel at the width, the coexistence's band, the TX power.
+    pub(crate) fn set_tune(&mut self, tune: Tune, scanning: bool) {
+        // The RTL8723D has 40 MHz at most, the others 80.
+        let tune = if self.model == Model::Rtl8723d && tune.bw == RTW_CHANNEL_WIDTH_80 { Tune::simple(tune.primary) } else { tune };
+        self.channel = tune.center;
+        match self.model {
+            Model::Rtl8821c => self.set_channel_8821c(tune),
+            Model::Rtl8822b => self.set_channel_8822b(tune),
+            Model::Rtl8822c => self.set_channel_8822c(tune),
+            Model::Rtl8723d => self.set_channel_8723d(tune),
+        }
+        if tune.center > 14 {
+            self.coex_band_5g();
+        } else {
+            self.coex_band_2g();
+        }
+        self.set_tx_power(tune.center);
+        if !scanning {
+            self.need_rfk = true;
+        }
+    }
+
+    /// `rtw_set_channel_mac`: the TX sub-channels, the MAC's width.
+    pub(crate) fn set_channel_mac(&self, tune: Tune) {
+        let c = &self.chip;
+        let txsc20 = tune.pri_idx as u32;
+        let txsc40 = if tune.bw == RTW_CHANNEL_WIDTH_80 {
+            if txsc20 == RTW_SC_20_UPPER || txsc20 == RTW_SC_20_UPMOST { RTW_SC_40_UPPER } else { RTW_SC_40_LOWER }
+        } else {
+            0
+        };
+        // `BIT_TXSC_20M` and `BIT_TXSC_40M`.
+        c.w8(REG_DATA_SC, ((txsc20 & 0xf) | ((txsc40 & 0xf) << 4)) as u8);
+        let mut value = c.r32(REG_WMAC_TRXPTCL_CTL) & !BIT_RFMOD;
+        if tune.bw == RTW_CHANNEL_WIDTH_80 {
+            value |= BIT_RFMOD_80M;
+        } else if tune.bw == RTW_CHANNEL_WIDTH_40 {
+            value |= BIT_RFMOD_40M;
+        }
+        c.w32(REG_WMAC_TRXPTCL_CTL, value);
+        let channel = tune.center;
+        // The 8051 CPU's chips keep their MAC clock.
+        if self.spec.wcpu_8051 {
+            return;
+        }
+        let value = (c.r32(REG_AFE_CTRL1) & !BIT_MAC_CLK_SEL) | (MAC_CLK_HW_DEF_80M << BIT_SHIFT_MAC_CLK_SEL);
+        c.w32(REG_AFE_CTRL1, value);
+        c.w8(REG_USTIME_TSF, MAC_CLK_SPEED as u8);
+        c.w8(REG_USTIME_EDCA, MAC_CLK_SPEED as u8);
+        let mut cck = c.r8(REG_CCK_CHECK) & !(BIT_CHECK_CCK_EN as u8);
+        if channel > 14 {
+            cck |= BIT_CHECK_CCK_EN as u8;
+        }
+        c.w8(REG_CCK_CHECK, cck);
+    }
+
+    /// The calibration before joining (the chips' `do_iqk` through
+    /// `rtw_chip_prepare_tx`): the firmware's IQK, its end in RF_DTXLOK.
+    pub(crate) fn prepare_tx(&mut self, associated: bool) {
+        if !self.need_rfk {
+            return;
+        }
+        self.need_rfk = false;
+        match self.model {
+            Model::Rtl8822c => return self.do_iqk_8822c(),
+            Model::Rtl8723d => return self.do_iqk_8723d(),
+            Model::Rtl8821c | Model::Rtl8822b => {}
+        }
+        self.h2c_packet(H2C_PKT_IQK as u8, &[(associated as u8) << 1]);
+        for _ in 0..300 {
+            if self.read_rf(RF_DTXLOK, RFREG_MASK) == 0xabcde {
+                break;
+            }
+            crate::sleep_ms(20);
+        }
+        self.write_rf(RF_DTXLOK, RFREG_MASK, 0);
+    }
+
+    // ---- TX power. ----
+
+    /// Linux's `rtw_phy_set_tx_power_level` at 20 MHz with the worldwide
+    /// limits, and the chips' `set_tx_power_index`: each path's indexes,
+    /// four rates to a register.
+    fn set_tx_power(&self, channel: u8) {
+        let Some(tables) = &self.rfe else { return };
+        match self.model {
+            Model::Rtl8822c => return self.set_tx_power_8822c(tables, channel),
+            Model::Rtl8723d => return self.set_tx_power_8723d(tables, channel),
+            Model::Rtl8821c | Model::Rtl8822b => {}
+        }
+        let streams = self.paths();
+        for path in 0..streams {
+            let mut word = 0u32;
+            let mut pending = None;
+            for (section, rates) in RATE_SECTIONS {
+                // CCK only at 2.4 GHz; two-stream rates only with two paths.
+                if (channel > 14 && section == 0) || (streams < 2 && (section == 3 || section == 5)) {
+                    continue;
+                }
+                for rate in rates {
+                    let index = self.power_index(tables, path, channel, rate, section);
+                    let shift = rate & 0x3;
+                    word |= (index as u32) << (shift * 8);
+                    pending = Some(rate);
+                    if shift == 0x3 {
+                        self.chip.w32(TXAGC[path] + (rate & 0xfc) as u32, word);
+                        word = 0;
+                        pending = None;
+                    }
+                }
+            }
+            if let Some(rate) = pending {
+                self.chip.w32(TXAGC[path] + (rate & 0xfc) as u32, word);
+            }
+        }
+    }
+
+    /// `rtw_phy_get_tx_power_index` at 20 MHz: the efuse's base and
+    /// differences, plus the rate's offset within its limit.
+    pub(crate) fn power_index(&self, tables: &RfeTables, path: usize, channel: u8, rate: u8, section: usize) -> u8 {
+        let factor = self.spec.txgi_factor;
+        let diff = |byte: u8, high: bool| -> i32 {
+            let nibble = if high { byte >> 4 } else { byte & 0xf };
+            ((nibble << 4) as i8 >> 4) as i32
+        };
+        let t = &self.efuse.txpwr[path];
+        let group = channel_group(channel, rate);
+        let mcs = (0x0c..0x2c).contains(&rate) || (0x2c..0x54).contains(&rate);
+        let two_streams = (0x14..0x2c).contains(&rate) || rate >= 0x36;
+        let (base, offset, limit) = if channel <= 14 {
+            // `struct rtw_2g_txpwr_idx`: cck_base[6], bw40_base[5],
+            // ht_1s_diff (ofdm, bw20), ht_2s_diff (bw20, bw40, cck, ofdm).
+            let mut power = if rate <= 0x03 { t[group.min(5)] as i32 } else { t[6 + group.min(4)] as i32 };
+            if (0x04..=0x0b).contains(&rate) {
+                power += diff(t[11], false) * factor;
+            }
+            if mcs {
+                power += diff(t[11], true) * factor;
+                if two_streams {
+                    power += diff(t[12], false) * factor;
+                }
+            }
+            let row = &tables.limit_2g[section];
+            (power, tables.offset_2g[path][rate as usize] as i32, row[(channel as usize - 1).min(row.len() - 1)] as i32)
+        } else {
+            // `struct rtw_5g_txpwr_idx` at 18: bw40_base[14], ht_1s_diff
+            // (ofdm, bw20), ht_2s_diff (bw20, bw40).
+            let mut power = t[18 + group.min(13)] as i32;
+            if mcs {
+                power += diff(t[18 + 14], true) * factor;
+                if two_streams {
+                    power += diff(t[18 + 15], false) * factor;
+                }
+            } else {
+                power += diff(t[18 + 14], false) * factor;
+            }
+            let row = &tables.limit_5g[section];
+            let index = CH_5G.iter().position(|&known| known == channel).unwrap_or(0);
+            (power, tables.offset_5g[path][rate as usize] as i32, row[index] as i32)
+        };
+        // 6M, 9M, MCS 0, 1, 8, 9 and VHT MCS 0 and 1 without DPD.
+        let dpd = if self.spec.dpd_disabled && matches!(rate, 0x04 | 0x05 | 0x0c | 0x0d | 0x14 | 0x15 | 0x2c | 0x2d | 0x36 | 0x37) { -6 * factor } else { 0 };
+        (base + offset.min(limit) + dpd).clamp(0, self.spec.max_power_index) as u8
+    }
+
+    /// The signal of a frame from its PHY status (the chip's
+    /// `query_phy_status`), in dBm.
+    pub(crate) fn phy_signal(&self, status: &[u8]) -> Option<i32> {
+        if status.len() < 20 {
+            return None;
+        }
+        match self.model {
+            Model::Rtl8821c => self.phy_signal_8821c(status),
+            Model::Rtl8822b => match status[0] & 0xf {
+                // CCK on path A; OFDM the stronger path.
+                0 => Some(status[1] as i32 - 110),
+                1 => Some(status[1].max(status[2]) as i32 - 110),
+                _ => None,
+            },
+            Model::Rtl8822c => self.phy_signal_8822c(status),
+            Model::Rtl8723d => self.phy_signal_8723d(status),
+        }
+    }
+
+    // ---- BT coexistence (`coex.c`). ----
+
+    fn read_scbd(&self) -> u16 {
+        self.chip.r16(REG_WIFI_BT_INFO) & !(BIT_BT_INT_EN as u16)
+    }
+
+    pub(crate) fn write_scbd(&mut self, bits: u16, set: bool) {
+        let mut value = 0x2 | self.score_board;
+        if bits & COEX_SCBD_FIX2M as u16 != 0 {
+            if set {
+                value &= !(COEX_SCBD_FIX2M as u16);
+            } else {
+                value |= COEX_SCBD_FIX2M as u16;
+            }
+        } else if set {
+            value |= bits;
+        } else {
+            value &= !bits;
+        }
+        if value != self.score_board {
+            self.score_board = value;
+            self.chip.w16(REG_WIFI_BT_INFO, value | BIT_BT_INT_EN as u16);
+        }
+    }
+
+    fn gnt(&self, bt: Option<u32>, wl: Option<u32>) {
+        if let Some(state) = bt {
+            self.chip.ltecoex_write_mask(LTE_COEX_CTRL as u16, 0xc000, state);
+            self.chip.ltecoex_write_mask(LTE_COEX_CTRL as u16, 0x0c00, state);
+        }
+        if let Some(state) = wl {
+            self.chip.ltecoex_write_mask(LTE_COEX_CTRL as u16, 0x3000, state);
+            self.chip.ltecoex_write_mask(LTE_COEX_CTRL as u16, 0x0300, state);
+        }
+    }
+
+    /// `rtw_coex_coex_ctrl_owner`.
+    fn ctrl_owner(&self, wifi: bool) {
+        if wifi {
+            self.chip.set8(REG_SYS_SDIO_CTRL + 3, BIT_LTE_MUX_CTRL_PATH >> 24);
+        } else {
+            self.chip.clr8(REG_SYS_SDIO_CTRL + 3, BIT_LTE_MUX_CTRL_PATH >> 24);
+        }
+        if let Some((register, bit)) = self.spec.btg_reg {
+            if wifi {
+                self.chip.set8(register, bit);
+            } else {
+                self.chip.clr8(register, bit);
+            }
+        }
+    }
+
+    /// The chip's `coex_set_ant_switch`.
+    fn ant_switch(&self, ctrl: SwitchCtrl, position: Switch) {
+        match self.model {
+            Model::Rtl8821c => self.ant_switch_8821c(ctrl, position),
+            Model::Rtl8822b => self.ant_switch_8822b(ctrl, position),
+            // No switch of their own (`coex_set_ant_switch` is NULL).
+            Model::Rtl8822c | Model::Rtl8723d => {}
+        }
+    }
+
+    /// A coexistence table case (`rtw_coex_table`): the shared-antenna
+    /// table, or the other where the antennas are apart.
+    fn coex_table(&self, case: usize) {
+        let table = if self.efuse.share_ant { &self.spec.coex_sant } else { &self.spec.coex_nsant };
+        let (bt, wl) = table[case.min(table.len() - 1)];
+        self.chip.w32(REG_BT_COEX_TABLE0, bt);
+        self.chip.w32(REG_BT_COEX_TABLE1, wl);
+        self.chip.w32(REG_BT_COEX_BRK_TABLE, 0xf0ff_ffff);
+    }
+
+    /// TDMA off (the chips' `tdma_sant[0]`).
+    fn coex_tdma_off(&mut self) {
+        let command = [H2C_CMD_COEX_TDMA_TYPE as u8, 0, 0, 0, 0, 0, 0, 0];
+        self.h2c(&command);
+    }
+
+    /// `rtw_coex_power_on_setting`.
+    fn coex_power_on_setting(&mut self) {
+        self.chip.set8(REG_SYS_FUNC_EN, BIT_FEN_BB_GLB_RST | BIT_FEN_BB_RSTB);
+        self.bt_disabled = self.read_scbd() & COEX_SCBD_ONOFF as u16 == 0;
+        // The antenna to BT at power-on.
+        self.ctrl_owner(self.bt_disabled);
+        self.ant_switch(SwitchCtrl::Bbsw, Switch::Bt);
+        self.coex_table(1);
+        self.chip.w8(0xff1a, 0x0);
+        // The chip's `coex_set_gnt_debug`.
+        if self.model == Model::Rtl8723d {
+            self.coex_gnt_debug_8723d();
+            return;
+        }
+        let c = &self.chip;
+        c.clr32(REG_PAD_CTRL1, BIT_BTGP_SPI_EN);
+        c.clr32(REG_PAD_CTRL1, BIT_BTGP_JTAG_EN);
+        c.clr32(REG_GPIO_MUXCFG, BIT_FSPI_EN);
+        c.clr32(REG_PAD_CTRL1, BIT_LED1DIS);
+        if self.model == Model::Rtl8821c {
+            c.clr32(REG_SYS_SDIO_CTRL, BIT_SDIO_INT);
+        }
+        c.clr32(REG_SYS_SDIO_CTRL, BIT_DBG_GNT_WL_BT);
+    }
+
+    /// `__rtw_coex_init_hw_config`.
+    fn coex_init_hw_config(&mut self, wifi_only: bool) {
+        self.score_board = 0;
+        self.bt_disabled = self.read_scbd() & COEX_SCBD_ONOFF as u16 == 0;
+        // The chip's `coex_set_rfe_type`.
+        match self.model {
+            Model::Rtl8821c => {}
+            Model::Rtl8822b => self.coex_rfe_type_8822b(),
+            Model::Rtl8822c => self.coex_rfe_type_8822c(),
+            Model::Rtl8723d => self.coex_rfe_type_8723d(),
+        }
+        // The 5 ms slot extension off (`rtw_coex_wl_slot_extend`).
+        let command = [H2C_CMD_BT_WIFI_CONTROL as u8, COEX_H2C69_WL_LEAKAP as u8, PARA1_H2C69_DIS_5MS as u8, 0, 0, 0, 0, 0];
+        self.h2c(&command);
+        // The chip's `coex_set_init` (the RTL8821C's also puts beacons
+        // first; the RTL8723D's, `rtw8723x_coex_cfg_init`, stops at the
+        // PTA's TX).
+        let c = &self.chip;
+        c.set8(REG_BCN_CTRL, BIT_EN_BCN_FUNCTION);
+        c.w8_mask(REG_BT_TDMA_TIME, BIT_MASK_SAMPLE_RATE, 0x5);
+        c.w8(REG_BT_STAT_CTRL, BT_CNT_ENABLE as u8);
+        c.set32(REG_GPIO_MUXCFG, BIT_BT_PTA_EN);
+        c.set32(REG_GPIO_MUXCFG, BIT_PO_BT_PTA_PINS);
+        c.set8(REG_QUEUE_CTRL, BIT_PTA_WL_TX_EN);
+        if self.model != Model::Rtl8723d {
+            c.clr8(REG_QUEUE_CTRL, BIT_PTA_EDCCA_EN);
+            c.set16(REG_BT_COEX_V2, BIT_GNT_BT_POLARITY);
+        }
+        match self.model {
+            Model::Rtl8821c => c.w8_mask(REG_BT_COEX_TABLE_H + 3, BIT_BCN_QUEUE, BCN_PRI_EN),
+            Model::Rtl8822b | Model::Rtl8723d => {}
+            Model::Rtl8822c => self.coex_cfg_init_8822c(),
+        }
+        let c = &self.chip;
+        // TX responses, beacons and the beacon queue at high priority.
+        for bit in [COEX_WLPRI_TX_RSP, COEX_WLPRI_TX_BEACON, COEX_WLPRI_TX_BEACONQ] {
+            c.w8_mask(REG_BT_COEX_TABLE_H + bit / 8, 1 << (bit % 8), 1);
+        }
+        if wifi_only || self.bt_disabled {
+            self.gnt(Some(COEX_GNT_SET_SW_LOW), Some(COEX_GNT_SET_SW_HIGH));
+            self.ctrl_owner(true);
+            self.ant_switch(SwitchCtrl::Bbsw, Switch::Wlg);
+        } else {
+            self.gnt(Some(COEX_GNT_SET_SW_HIGH), Some(COEX_GNT_SET_SW_LOW));
+            self.ctrl_owner(true);
+            self.ant_switch(SwitchCtrl::Bbsw, Switch::Bt);
+        }
+        self.write_scbd((COEX_SCBD_ACTIVE | COEX_SCBD_ONOFF) as u16, true);
+        self.coex_table(1);
+        self.coex_tdma_off();
+    }
+
+    /// `rtw_coex_action_wl_under5g`.
+    fn coex_band_5g(&mut self) {
+        self.gnt(Some(COEX_GNT_SET_HW_PTA), Some(COEX_GNT_SET_SW_HIGH));
+        self.ctrl_owner(true);
+        self.ant_switch(SwitchCtrl::Bbsw, Switch::Wla);
+        self.write_scbd(COEX_SCBD_FIX2M as u16, false);
+        self.coex_table(0);
+        self.coex_tdma_off();
+    }
+
+    /// `rtw_coex_action_wl_only` (2.4 GHz, the PTA shares the antenna).
+    fn coex_band_2g(&mut self) {
+        self.gnt(Some(COEX_GNT_SET_HW_PTA), Some(COEX_GNT_SET_HW_PTA));
+        self.ctrl_owner(true);
+        self.ant_switch(SwitchCtrl::Pta, Switch::Wlg);
+        self.coex_table(2);
+        self.coex_tdma_off();
+    }
+
+    // ---- The interface's port (`rtw_vif_port_config`, port 0). ----
+
+    pub(crate) fn port_address(&self, address: &[u8; 6]) {
+        for (index, byte) in address.iter().enumerate() {
+            self.chip.w8(0x0610 + index as u32, *byte);
+        }
+    }
+
+    pub(crate) fn port_bssid(&self, bssid: &[u8; 6]) {
+        for (index, byte) in bssid.iter().enumerate() {
+            self.chip.w8(0x0618 + index as u32, *byte);
+        }
+    }
+
+    pub(crate) fn port_net_type(&self, linked: bool) {
+        let net = if linked { RTW_NET_MGD_LINKED } else { RTW_NET_NO_LINK };
+        self.chip.w32_mask(0x0100, 0x30000, net);
+    }
+
+    pub(crate) fn port_aid(&self, aid: u16) {
+        self.chip.w32_mask(0x06a8, 0x7ff, aid as u32);
+    }
+
+    pub(crate) fn port_bcn_ctrl(&self) {
+        self.chip.w8_mask(0x0550, 0xff, BIT_EN_BCN_FUNCTION);
+    }
+
+    /// Port 0 as an access point's (`rtw_ops_add_interface` for an AP):
+    /// its network type, beacons on with the TSF its own; or a station's
+    /// again. The beacon's interval and DTIM period with it.
+    pub(crate) fn port_ap(&self, ap: bool, beacon_interval: u16, dtim_period: u8) {
+        let c = &self.chip;
+        if ap {
+            c.w32_mask(0x0100, 0x30000, RTW_NET_AP_MODE);
+            c.w8_mask(0x0550, 0xff, BIT_EN_BCN_FUNCTION | BIT_DIS_TSF_UDT);
+            // The port's beacon space (the MAC's beacon interval register,
+            // 100 TU after reset).
+            c.w32_mask(REG_BCN_INTERVAL, 0xffff, beacon_interval.max(1) as u32);
+            c.w8(REG_DTIM_COUNTER_ROOT, dtim_period.max(1) - 1);
+            c.set32(REG_TCR, BIT_TCR_UPDATE_HGQMD);
+        } else {
+            c.clr32(REG_FWHW_TXQ_CTRL, BIT_EN_BCNQ_DL);
+            c.clr32(REG_TCR, BIT_TCR_UPDATE_HGQMD);
+            c.w32_mask(0x0100, 0x30000, RTW_NET_NO_LINK);
+            c.w8_mask(0x0550, 0xff, BIT_EN_BCN_FUNCTION);
+        }
+    }
+
+    /// The access point's beacon as the first reserved page, the hardware
+    /// sending it from there at each TBTT (`rtw_fw_download_rsvd_page`,
+    /// `BSS_CHANGED_BEACON_ENABLED`).
+    pub(crate) fn beacon(&mut self, frame: &[u8]) -> Result<(), String> {
+        let page = self.rsvd_boundary;
+        self.write_rsvd_page(page, frame)?;
+        self.chip.set32(REG_FWHW_TXQ_CTRL, BIT_EN_BCNQ_DL);
+        Ok(())
+    }
+
+    pub(crate) fn set_rcr(&mut self, scanning: bool) {
+        if scanning {
+            self.rcr &= !(BIT_CBSSID_BCN | BIT_CBSSID_DATA);
+        } else {
+            self.rcr |= BIT_CBSSID_BCN;
+        }
+        self.chip.w32(REG_RCR, self.rcr);
+    }
+
+    /// The EDCA of an access category (`__rtw_conf_tx`).
+    pub(crate) fn conf_tx(&self, register: u32, cw_min: u16, cw_max: u16, aifsn: u8, txop: u16, short_slot: bool) {
+        let ecw = |cw: u16| (cw as u32 + 1).trailing_zeros().min(15);
+        let slot = if short_slot { 9 } else { 20 };
+        let sifs = if self.channel > 14 { 16 } else { 10 };
+        let aifs = aifsn as u32 * slot + sifs;
+        let c = &self.chip;
+        c.w32_mask(register, BIT_MASK_TXOP_LMT, txop as u32);
+        c.w32_mask(register, BIT_MASK_CWMAX, ecw(cw_max));
+        c.w32_mask(register, BIT_MASK_CWMIN, ecw(cw_min));
+        c.w32_mask(register, BIT_MASK_AIFS, aifs);
+    }
+
+    // ---- Keys (`rtw_sec_write_cam`, `rtw_sec_clear_cam`). ----
+
+    pub(crate) fn write_cam(&self, entry: u8, key_index: u8, group: bool, address: &[u8; 6], kind: u32, key: &[u8]) {
+        let addr = (entry as u32) << RTW_SEC_CAM_ENTRY_SHIFT;
+        let command = RTW_SEC_CMD_WRITE_ENABLE | RTW_SEC_CMD_POLLING;
+        for word in (0..8u32).rev() {
+            let content = match word {
+                0 => (key_index as u32 & 0x3) | ((kind & 0x7) << 2) | ((group as u32) << 6) | (1 << 15) | ((address[0] as u32) << 16) | ((address[1] as u32) << 24),
+                1 => u32::from_le_bytes([address[2], address[3], address[4], address[5]]),
+                6 | 7 => 0,
+                _ => {
+                    let at = ((word - 2) << 2) as usize;
+                    u32::from_le_bytes([key[at], key[at + 1], key[at + 2], key[at + 3]])
+                }
+            };
+            self.chip.w32(RTW_SEC_WRITE_REG, content);
+            self.chip.w32(RTW_SEC_CMD_REG, command | (addr + word));
+        }
+    }
+
+    pub(crate) fn clear_cam(&self, entry: u8) {
+        let addr = (entry as u32) << RTW_SEC_CAM_ENTRY_SHIFT;
+        self.chip.w32(RTW_SEC_WRITE_REG, 0);
+        self.chip.w32(RTW_SEC_CMD_REG, RTW_SEC_CMD_WRITE_ENABLE | RTW_SEC_CMD_POLLING | addr);
+    }
+
+    /// PCIe PHY parameters and link settings (`rtw_pci_phy_cfg`).
+    /// Where the logical efuse has the MAC address on this bus.
+    pub(crate) fn mac_offset(&self) -> usize {
+        if self.chip.usb() { self.spec.usb_mac_offset } else { self.spec.mac_offset }
+    }
+
+    /// `rtw_usb_phy_cfg` for USB 3 (USB 2's tables are empty on these
+    /// chips).
+    pub(crate) fn usb_phy_cfg(&self) {
+        let cut = 1u16 << self.chip.cut;
+        for para in self.spec.usb3_para {
+            if para.offset == 0xffff {
+                break;
+            }
+            if para.cut_mask & cut == 0 {
+                continue;
+            }
+            if para.ip_sel == usbreg::RTW_IP_SEL_MAC {
+                self.chip.w8(para.offset as u32, para.value as u8);
+            } else {
+                self.chip.w8(usbreg::REG_USB3_PHY_DAT_L, para.value as u8);
+                self.chip.w8(usbreg::REG_USB3_PHY_DAT_H, (para.value >> 8) as u8);
+                self.chip.w8(usbreg::REG_USB3_PHY_ADR, (para.offset as u8 & 0xff) | usbreg::BIT_USB3_PHY_ADR_WR as u8);
+            }
+        }
+    }
+
+    /// `rtw_usb_init_burst_pkt_len` (`rtw_hci_interface_cfg`).
+    fn usb_interface_cfg(&self) {
+        let Some(speed) = self.hci.usb_speed() else { return };
+        let burst = match speed {
+            4.. => usbreg::BIT_DMA_BURST_SIZE_1024,
+            3 => usbreg::BIT_DMA_BURST_SIZE_512,
+            _ => usbreg::BIT_DMA_BURST_SIZE_64,
+        };
+        let rxdma = usbreg::BIT_DMA_BURST_CNT | usbreg::BIT_DMA_MODE | (burst << usbreg::BIT_DMA_BURST_SIZE_SHIFT);
+        self.chip.w8(usbreg::REG_RXDMA_MODE, rxdma as u8);
+        self.chip.set16(REG_TXDMA_OFFSET_CHK, usbreg::BIT_DROP_DATA_EN);
+    }
+
+    /// USB's receive aggregation on busy links (`rtw_usb_dynamic_rx_agg_v1`;
+    /// the RTL8723D takes none).
+    pub(crate) fn dynamic_rx_agg(&self, enable: bool) {
+        if !self.chip.usb() || self.model == Model::Rtl8723d {
+            return;
+        }
+        let c = &self.chip;
+        c.set8(REG_TXDMA_PQ_MAP, usbreg::BIT_RXDMA_AGG_EN);
+        c.clr8(usbreg::REG_RXDMA_AGG_PG_TH + 3, 1 << 7);
+        let (size, timeout) = if enable { (0x5u16, 0x20u16) } else { (0, 1) };
+        c.w16(usbreg::REG_RXDMA_AGG_PG_TH, size | (timeout << 8));
+    }
+
+    pub(crate) fn pci_phy_cfg(&self) {
+        let cut = 1u16 << self.chip.cut;
+        for (paras, g1) in [(self.spec.pcie_gen1, true), (self.spec.pcie_gen2, false)] {
+            for para in paras {
+                if para.cut_mask & cut == 0 {
+                    continue;
+                }
+                if para.offset == 0xffff {
+                    break;
+                }
+                if para.ip_sel == RTW_IP_SEL_PHY {
+                    self.chip.mdio_write(para.offset as u8, para.value, g1);
+                } else {
+                    self.chip.dbi_write8(para.offset, para.value as u8);
+                }
+            }
+        }
+    }
+}
+
+/// The 5 GHz channels of Linux's power limit tables (`rtw_channel_idx_5g`).
+const CH_5G: [u8; 49] = [
+    36, 38, 40, 42, 44, 46, 48, 52, 54, 56, 58, 60, 62, 64, 100, 102, 104, 106, 108, 110, 112, 116, 118, 120, 122, 124, 126, 128, 132, 134, 136, 138, 140, 142, 144, 149,
+    151, 153, 155, 157, 159, 161, 165, 167, 169, 171, 173, 175, 177,
+];
+
+/// Linux's `rtw_get_channel_group`.
+fn channel_group(channel: u8, rate: u8) -> usize {
+    match channel {
+        1 | 2 | 36 | 38 | 40 | 42 => 0,
+        3..=5 | 44 | 46 | 48 | 50 => 1,
+        6..=8 | 52 | 54 | 56 | 58 => 2,
+        9..=11 | 60 | 62 | 64 => 3,
+        12 | 13 | 100 | 102 | 104 | 106 => 4,
+        14 => {
+            if rate <= 0x03 { 5 } else { 4 }
+        }
+        108 | 110 | 112 | 114 => 5,
+        116 | 118 | 120 | 122 => 6,
+        124 | 126 | 128 | 130 => 7,
+        132 | 134 | 136 | 138 => 8,
+        140 | 142 | 144 => 9,
+        149 | 151 | 153 | 155 => 10,
+        157 | 159 | 161 => 11,
+        165 | 167 | 169 | 171 => 12,
+        _ => 13,
+    }
+}
