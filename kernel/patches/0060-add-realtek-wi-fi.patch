+// SPDX-License-Identifier: MPL-2.0
+
+//! The USB side as Linux's rtw88 `usb.c` runs it: registers through vendor
+//! control requests (`RTW_USB_CMD_REQ`), each TX queue on the bulk OUT
+//! endpoint the chip's `rqpn_table` maps it to (the TX descriptor first,
+//! with its checksum), frames received in aggregates on the bulk IN
+//! endpoint (each packet its RX descriptor and its body, eight-aligned),
+//! four reads always waiting for them.
+
+use alloc::{collections::VecDeque, format, string::String, sync::Arc, vec::Vec};
+use core::sync::atomic::{AtomicU32, Ordering};
+
+use aster_usb::driver::{Notify, Transfer, UsbInterface};
+
+use crate::{
+    hw::Spec,
+    pci::{TX_DESC_MAX, TxInfo},
+    regs::*,
+};
+
+/// The vendor request and its directions (`RTW_USB_CMD_*`).
+const REQUEST: u8 = 0x05;
+const VENDOR: u8 = 0x40;
+const READ_TIMEOUT_MS: u32 = 1000;
+const WRITE_TIMEOUT_MS: u32 = 500;
+/// An RX transfer (`RTW_USB_MAX_RECVBUF_SZ`) and how many wait at once
+/// (`RTW_USB_RXCB_NUM`).
+const RX_BUF: usize = 32768;
+const RX_TRANSFERS: usize = 4;
+/// The RX descriptor (`rx_pkt_desc_sz`).
+const RX_DESC: usize = 24;
+/// How long a failed read waits to be submitted again.
+const RX_RETRY_MS: u64 = 50;
+/// TX transfers in flight before the queues count as full.
+const TX_IN_FLIGHT: usize = 128;
+/// The register that echoes writes and reads of the always-on section on
+/// the 8822B, 8822C and 8821C (`rtw_usb_reg_sec`).
+const REG_SEC: u16 = 0x4e0;
+
+/// The TX descriptor's per-TID queues (`TX_DESC_QSEL_TID*`).
+const TX_DESC_QSEL_TID0: u32 = 0;
+const TX_DESC_QSEL_TID1: u32 = 1;
+const TX_DESC_QSEL_TID2: u32 = 2;
+const TX_DESC_QSEL_TID3: u32 = 3;
+const TX_DESC_QSEL_TID4: u32 = 4;
+const TX_DESC_QSEL_TID5: u32 = 5;
+const TX_DESC_QSEL_TID6: u32 = 6;
+const TX_DESC_QSEL_TID7: u32 = 7;
+/// Power sequences' USB steps, and the PHY tables' USB condition
+/// (`RTW_PWR_INTF_USB_MSK`, `INTF_USB`).
+pub(crate) const RTW_PWR_INTF_USB_MSK: u32 = 0x2;
+pub(crate) const INTF_USB: u32 = 0x2;
+/// `enum rtw_ip_sel`'s MAC.
+pub(crate) const RTW_IP_SEL_MAC: u32 = 1;
+/// The USB registers Linux's `usb.c`, `mac.c` and `main.c` use (`reg.h`).
+pub(crate) const REG_SYS_STATUS1: u32 = 0x00f4;
+pub(crate) const BIT_RXDMA_ARBBW_EN: u32 = 1 << 0;
+pub(crate) const BIT_RXDMA_AGG_EN: u32 = 1 << 2;
+pub(crate) const BIT_MASK_BLK_DESC_NUM: u32 = 0xf0;
+pub(crate) const BIT_DROP_DATA_EN: u32 = 1 << 9;
