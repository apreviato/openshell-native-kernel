+// SPDX-License-Identifier: MPL-2.0
+
+//! What is the RTL8723D's own (Linux's `rtw8723d.c`, and `rtw8723x.c` it
+//! shares with the RTL8703B): an 802.11n chip with an 8051 CPU, one path
+//! at 2.4 GHz and Bluetooth on the same antenna. Its efuse, MAC and PHY
+//! settings, the channel (the RF's two paths, the spur notch of channels
+//! 13 and 14, the CCK filter), the TX power in the per-rate registers of
+//! the 11n chips, the IQ calibration the driver runs itself (Linux's
+//! `rtw8723d_phy_calibration`, through the RF's S1 and S0 sides), and the
+//! antenna's selection for the BT coexistence.
+
+use crate::{
+    hw::{Hw, RATE_SECTIONS, RfeTables, Tune},
+    regs::*,
+};
+
+// ---- `rtw8723d.c`'s MAC timing. ----
+
+const SLOT_TIME: u8 = 0x09;
+const RETRY_LIMIT: u16 = 0x3030;
+const BAR_MODE: u32 = 0x0201_ffff;
+/// The TBTT's setup and hold fields, and the hold while beacons stop.
+const TBTT_MASK: u32 = (0xfff << 8) | 0xff;
+const TBTT_STOP_BCN: u32 = 0x04 | (0x64 << 8);
+const PIFS_TIME: u8 = 0;
+const AGG_BREAK_TIME: u8 = 0x16;
+const NAV_PROT_LEN: u16 = 0x0040;
+const SPEC_SIFS: u16 = 0x100a;
+const RX_PKT_LIMIT: u8 = 0x17;
+const MAX_AGG_NR: u8 = 0x0a;
+const AMPDU_MAX_TIME: u8 = 0x1c;
+const ANT_SEL: u8 = 0x82;
+const LTR_IDLE_LATENCY: u32 = 0x9003_9003;
+const LTR_ACTIVE_LATENCY: u32 = 0x883c_883c;
+const LTR_CTRL1: u32 = 0xcb00_4010;
+const LTR_CTRL2: u32 = 0x0123_3425;
+
+// ---- `rtw8723x.c`'s TX and RX settings. ----
+
+/// `BIT_CFENDFORM`, `BIT_WMAC_TCR_ERR0`, `BIT_WMAC_TCR_ERR1`.
+const TCR_CFG: u32 = (1 << 9) | (1 << 12) | (1 << 13);
+const RX_FILTER0: u16 = 0xffff;
+const RX_FILTER1: u16 = 0x0400;
+const RX_FILTER2: u16 = 0xffff;
+const RCR_CFG: u32 = 0x7000_60ce;
+
+/// The TX power indexes for an efuse without them
+/// (`rtw8723x_txpwr_idx_table`, path A's CCK and 40 MHz bases and its HT
+/// difference).
+const TXPWR_DEFAULT: [u8; 12] = [0x2d, 0x2d, 0x2d, 0x2d, 0x2d, 0x2d, 0x2d, 0x2d, 0x2d, 0x2d, 0x2d, 0x02];
+
+/// Each rate's TX power register and byte (`rtw8723x_txagc`): CCK, OFDM,
+/// MCS 0 to 7.
+const TXAGC: [(u32, u32); 20] = [
+    (0xe08, 0x0000_ff00),
+    (0x86c, 0x0000_ff00),
+    (0x86c, 0x00ff_0000),
+    (0x86c, 0xff00_0000),
+    (0xe00, 0x0000_00ff),
+    (0xe00, 0x0000_ff00),
+    (0xe00, 0x00ff_0000),
+    (0xe00, 0xff00_0000),
+    (0xe04, 0x0000_00ff),
+    (0xe04, 0x0000_ff00),
+    (0xe04, 0x00ff_0000),
+    (0xe04, 0xff00_0000),
+    (0xe10, 0x0000_00ff),
+    (0xe10, 0x0000_ff00),
+    (0xe10, 0x00ff_0000),
+    (0xe10, 0xff00_0000),
+    (0xe14, 0x0000_00ff),
+    (0xe14, 0x0000_ff00),
+    (0xe14, 0x00ff_0000),
+    (0xe14, 0xff00_0000),
+];
+
+/// The CCK filter of channels 1 to 13 and of channel 14 (`cck_dfir_cfg`).
+const CCK_DFIR: [[(u32, u32); 3]; 2] = [
+    [(0xa24, 0x64b8_0c1c), (0xa28, 0x0000_8810), (0xaac, 0x0123_5667)],
+    [(0xa24, 0x0000_b81c), (0xa28, 0x0000_0000), (0xaac, 0x0000_3667)],
+];
+
+// ---- The IQ calibration (`rtw8723x_common`, `rtw8723d.c`). ----
+
+/// The registers saved before the calibration and put back after it.
+const IQK_ADDA: [u32; 16] = [0x85c, 0xe6c, 0xe70, 0xe74, 0xe78, 0xe7c, 0xe80, 0xe84, 0xe88, 0xe8c, 0xed0, 0xed4, 0xed8, 0xedc, 0xee0, 0xeec];
+const IQK_MAC8: [u32; 3] = [0x522, 0x550, 0x551];
+const IQK_MAC32: [u32; 1] = [0x40];
+const IQK_BB: [u32; 9] = [0xc04, 0xc08, 0x874, 0xb68, 0xb6c, 0x870, 0x860, 0x864, 0xa04];
+/// The ADDA registers' value while calibrating, and the GNT the LTE
+/// window holds then (`ADDA_ON_VAL_8723D`, `IQK_LTE_WRITE_VAL_8723D`).
+const ADDA_ON: u32 = 0x03c0_0016;
+const IQK_LTE_WRITE: u32 = 0x0000_ff00;
+/// The results' order (`enum rtw8723x_iqk_result`): each side's TX X and
+/// Y, then its RX X and Y; S1 first.
+const IQK_NR: usize = 8;
+const IQK_SX_NR: usize = 4;
+const S1_TX_X: usize = 0;
+const S1_RX_X: usize = 2;
+const S0_TX_X: usize = 4;
+const S0_RX_X: usize = 6;
+/// Three rounds and the hybrid of two (`enum rtw8723x_iqk_round`).
+const ROUNDS: usize = 3;
+const ROUND_HYBRID: usize = 3;
+/// `rtw8723x.h`'s limits.
+const PATH_RETRY: usize = 2;
+const TOLERANCE: u32 = 5;
+const TX_X_ERR: u32 = 0x142;
+const TX_Y_ERR: u32 = 0x42;
+const RX_X_UPPER: u32 = 0x11a;
+const RX_X_LOWER: u32 = 0xe6;
+const RX_Y_LIMIT: u32 = 0x1a;
+const TX_OK: u8 = 1 << 0;
+const RX_OK: u8 = 1 << 1;
+
+/// A side's calibration settings (`struct rtw_8723d_iqk_cfg`).
+struct IqkSide {
+    bb_sel_btg: u32,
+    lutwe: u32,
+    txiqk_pi: u32,
+    padlut: u32,
+    gaintx: u32,
+    bspad: u32,
+    wlint: u32,
+    wlsel: u32,
+    iqkpts: u32,
+}
+
+/// S1 and S0 (`iqk_tx_cfg`).
+const IQK_SIDES: [IqkSide; 2] = [
+    IqkSide { bb_sel_btg: 0x9900_0000, lutwe: RF_LUTWE, txiqk_pi: 0x8214_019f, padlut: RF_LUTDBG, gaintx: RF_GAINTX, bspad: RF_BSPAD, wlint: 0xe0d, wlsel: 0x60d, iqkpts: 0xfa00_0000 },
+    IqkSide { bb_sel_btg: 0x9900_0280, lutwe: RF_LUTWE2, txiqk_pi: 0x8214_018a, padlut: RF_TXADBG, gaintx: RF_TRXIQ, bspad: RF_TXATANK, wlint: 0xe6d, wlsel: 0x66d, iqkpts: 0xf900_0000 },
+];
+
+/// What the calibration saves (`struct rtw8723x_iqk_backup_regs`).
+struct IqkBackup {
+    adda: [u32; 16],
+    mac8: [u8; 3],
+    mac32: [u32; 1],
+    bb: [u32; 9],
+    lte_path: u32,
+    lte_gnt: u32,
+    bb_sel_btg: u32,
+    btg_sel: u8,
+    igia: u32,
+    igib: u32,
+}
+
+/// `iqkxy_to_s32`: a 10-bit result, signed.
+fn iqk_signed(value: i32) -> i32 {
+    (value << 22) >> 22
+}
+
+/// `iqk_mult`: two Q10.8 values' product in Q10.8, and its bit below.
+fn iqk_mult(x: i32, y: i32) -> (i32, i32) {
+    let product = x.wrapping_mul(y);
+    (product >> 8, (product >> 7) & 1)
+}
+
+/// `__rtw8723x_iqk_similarity_cmp`: whether rounds `c1` and `c2` agree;
+/// the hybrid takes what they agree on.
+fn iqk_similar(result: &mut [[i32; IQK_NR]; ROUNDS + 1], c1: usize, c2: usize) -> bool {
+    let mut bitmap = 0u32;
+    let mut candidate = [None::<usize>; 2];
+    for i in 0..IQK_NR {
+        let diff = (iqk_signed(result[c1][i]) - iqk_signed(result[c2][i])).unsigned_abs();
+        if diff <= TOLERANCE {
+            continue;
+        }
+        if (i == S1_RX_X || i == S0_RX_X) && bitmap == 0 {
+            if result[c1][i] + result[c1][i + 1] == 0 {
+                candidate[i / IQK_SX_NR] = Some(c2);
+            } else if result[c2][i] + result[c2][i + 1] == 0 {
+                candidate[i / IQK_SX_NR] = Some(c1);
+            } else {
+                bitmap |= 1 << i;
+            }
+        } else {
+            bitmap |= 1 << i;
+        }
+    }
+    if bitmap == 0 {
+        let mut similar = true;
+        for (side, chosen) in candidate.iter().enumerate() {
+            let Some(chosen) = *chosen else { continue };
+            for j in side * IQK_SX_NR..side * IQK_SX_NR + 2 {
+                result[ROUND_HYBRID][j] = result[chosen][j];
+            }
+            similar = false;
+        }
+        return similar;
+    }
+    for i in 0..IQK_NR {
+        let pair = i & !1;
+        if bitmap & (0b11 << pair) != 0 {
+            continue;
+        }
+        result[ROUND_HYBRID][i] = result[c1][i];
+    }
+    false
+}
+
+impl Hw {
+    /// `rtw8723x_read_efuse` (`struct rtw8723x_efuse`, the PCIe card's MAC
+    /// address at 0xd0) and its fixes of an efuse left empty.
+    pub(crate) fn efuse_8723d(&mut self, map: &[u8]) {
+        let mac_at = self.mac_offset();
+        let e = &mut self.efuse;
+        for (path, table) in e.txpwr.iter_mut().enumerate() {
+            let at = 0x10 + 42 * path;
+            table.copy_from_slice(&map[at..at + 42]);
+        }
+        if e.txpwr[0][..TXPWR_DEFAULT.len()].iter().all(|&byte| byte == 0xff) {
+            e.txpwr[0][..TXPWR_DEFAULT.len()].copy_from_slice(&TXPWR_DEFAULT);
+        }
+        e.afe = map[0x04];
+        e.rfe_option = 0;
+        e.crystal_cap = if map[0xb9] == 0xff { 0x20 } else { map[0xb9] };
+        // No board options: the low bits only (a BT-coexistence board).
+        e.rf_board_option = if map[0xc1] == 0xff { 0x3f } else { map[0xc1] };
+        // No antenna setting: shared, on RF path A.
+        e.bt_setting = if map[0xc3] == 0xff { 0xff & !(1 << 6) } else { map[0xc3] };
+        e.tx_bb_swing_2g = if map[0xc6] == 0xff { 0 } else { map[0xc6] };
+        e.address.copy_from_slice(&map[mac_at..mac_at + 6]);
+        e.share_ant = e.bt_setting & 1 != 0;
+        e.btcoex = e.rf_board_option & 0xe0 == 0x20;
+    }
+
+    /// `rtw8723x_efuse_grant`.
+    pub(crate) fn efuse_grant_8723x(&self, on: bool) {
+        let c = &self.chip;
+        if on {
+            c.w8(REG_EFUSE_ACCESS, EFUSE_ACCESS_ON as u8);
+            c.set16(REG_SYS_FUNC_EN, BIT_FEN_ELDR);
+            c.set16(REG_SYS_CLKR, BIT_LOADER_CLK_EN | BIT_ANA8M);
+        } else {
+            c.w8(REG_EFUSE_ACCESS, EFUSE_ACCESS_OFF as u8);
+        }
+    }
+
+    /// `rtw8723x_mac_init`.
+    pub(crate) fn mac_init_8723x(&self) {
+        let c = &self.chip;
+        c.w32(REG_TCR, TCR_CFG);
+        c.w16(REG_RXFLTMAP0, RX_FILTER0);
+        c.w16(REG_RXFLTMAP1, RX_FILTER1);
+        c.w16(REG_RXFLTMAP2, RX_FILTER2);
+        c.w32(REG_RCR, RCR_CFG);
+        c.w32(REG_INT_MIG, 0);
+        c.w32(REG_MCUTST_1, 0);
+        c.w8(REG_MISC_CTRL, BIT_DIS_SECOND_CCA as u8);
+        c.w8(REG_2ND_CCA_CTRL, 0);
+    }
+
+    /// `rtw8723x_mac_postinit`: the TX reports on.
+    pub(crate) fn mac_postinit_8723x(&self) {
+        self.chip.w8(REG_FWHW_TXQ_CTRL + 1, WLAN_TXQ_RPT_EN as u8);
+    }
+
+    /// `rtw8723d_phy_set_param`.
+    pub(crate) fn phy_set_param_8723d(&mut self) {
+        let c = &self.chip;
+        // The BB and RF on.
+        c.set16(REG_SYS_FUNC_EN, BIT_FEN_EN_25_1 | BIT_FEN_BB_GLB_RST | BIT_FEN_BB_RSTB);
+        c.set8(REG_RF_CTRL, BIT_RF_EN | BIT_RF_RSTB | BIT_RF_SDM_RSTB);
+        c.w8(REG_AFE_CTRL1 + 1, 0x80);
+        self.load_tables();
+        let c = &self.chip;
+        c.clr32(REG_RCR, BIT_RCR_ADF);
+        c.set8(REG_HIQ_NO_LMT_EN, BIT_HIQ_NO_LMT_EN_ROOT);
+        c.set16(REG_AFE_CTRL_4, BIT_CK320M_AFE_EN | BIT_EN_SYN);
+        let crystal = (self.efuse.crystal_cap & 0x3f) as u32;
+        c.w32_mask(REG_AFE_CTRL3, BIT_MASK_XTAL, crystal | (crystal << 6));
+        c.set32(REG_FPGA0_RFMOD, BIT_CCKEN | BIT_OFDMEN);
+        if self.efuse.afe >> 4 == 14 {
+            c.set32(REG_AFE_CTRL3, BIT_XTAL_GMP_BIT4);
+            c.clr32(REG_AFE_CTRL1, BITS_PLL);
+            c.set32(REG_LDO_SWR_CTRL, BIT_XTA1);
+            c.clr32(REG_LDO_SWR_CTRL, BIT_XTA0);
+        }
+        c.w8(REG_SLOT, SLOT_TIME);
+        c.w8(REG_FWHW_TXQ_CTRL + 1, WLAN_TXQ_RPT_EN as u8);
+        c.w16(REG_RETRY_LIMIT, RETRY_LIMIT);
+        c.w32(REG_BAR_MODE_CTRL, BAR_MODE);
+        c.w8(REG_ATIMWND, 0x2);
+        c.w8(REG_BCN_CTRL, (BIT_DIS_TSF_UDT | BIT_EN_BCN_FUNCTION | BIT_EN_TXBCN_RPT) as u8);
+        // Linux writes the low byte of the TBTT's fields.
+        let tbtt = (c.r32(REG_TBTT_PROHIBIT) & !TBTT_MASK) | TBTT_STOP_BCN;
+        c.w8(REG_TBTT_PROHIBIT, tbtt as u8);
+        c.w8(REG_PIFS, PIFS_TIME);
+        c.w8(REG_AGGR_BREAK_TIME, AGG_BREAK_TIME);
+        c.w16(REG_NAV_PROT_LEN, NAV_PROT_LEN);
+        c.w16(REG_MAC_SPEC_SIFS, SPEC_SIFS);
+        c.w16(REG_SIFS, SPEC_SIFS);
+        c.w16(REG_SIFS + 2, SPEC_SIFS);
+        c.w8(REG_SINGLE_AMPDU_CTRL, BIT_EN_SINGLE_APMDU as u8);
+        c.w8(REG_RX_PKT_LIMIT, RX_PKT_LIMIT);
+        c.w8(REG_MAX_AGGR_NUM, MAX_AGG_NR);
+        c.w8(REG_AMPDU_MAX_TIME, AMPDU_MAX_TIME);
+        c.w8(REG_LEDCFG2, ANT_SEL);
+        c.w32(REG_LTR_IDLE_LATENCY, LTR_IDLE_LATENCY);
+        c.w32(REG_LTR_ACTIVE_LATENCY, LTR_ACTIVE_LATENCY);
+        c.w32(REG_LTR_CTRL_BASIC, LTR_CTRL1);
+        c.w32(REG_LTR_CTRL_BASIC + 4, LTR_CTRL2);
+        c.set16(REG_TXDMA_OFFSET_CHK, BIT_DROP_DATA_EN);
+        self.lck_8723x();
+        let c = &self.chip;
+        c.w32_mask(REG_OFDM0_XAAGC1, MASKBYTE0, 0x50);
+        c.w32_mask(REG_OFDM0_XAAGC1, MASKBYTE0, 0x20);
+    }
+
+    /// `rtw8723x_lck`: the LC tank's calibration, TX paused.
+    fn lck_8723x(&self) {
+        let c = &self.chip;
+        let context = c.r8(REG_CTX);
+        let busy = context as u32 & BIT_MASK_CTX_TYPE != 0;
+        if busy {
+            c.w8(REG_CTX, context & !(BIT_MASK_CTX_TYPE as u8));
+        } else {
+            c.w8(REG_TXPAUSE, 0xff);
+        }
+        let lc = self.read_rf(RF_CFGCH, RFREG_MASK);
+        self.write_rf(RF_CFGCH, RFREG_MASK, lc | BIT_LCK);
+        // Done when the bit clears: 10 ms steps, a second at most.
+        let mut done = false;
+        for _ in 0..100 {
+            if self.read_rf(RF_CFGCH, BIT_LCK) != 1 {
+                done = true;
+                break;
+            }
+            crate::sleep_ms(10);
+        }
+        if !done {
+            ostd::warn!("{}: the LC calibration did not finish", self.chip.name);
+        }
+        self.write_rf(RF_CFGCH, RFREG_MASK, lc);
+        let c = &self.chip;
+        if busy {
+            c.w8(REG_CTX, context);
+        } else {
+            c.w8(REG_TXPAUSE, 0x00);
+        }
+    }
+
+    /// `query_phy_status`: CCK and OFDM both by path A's power.
+    pub(crate) fn phy_signal_8723d(&self, status: &[u8]) -> Option<i32> {
+        match status[0] & 0xf {
+            0 => Some(status[1] as i32 - 97),
+            1 => Some(status[1] as i32 - 110),
+            _ => None,
+        }
+    }
+
+    // ---- The channel. ----
+
+    /// `rtw8723d_set_channel`: the RF, the MAC, the BB (20 or 40 MHz).
+    pub(crate) fn set_channel_8723d(&mut self, tune: Tune) {
+        let channel = tune.center;
+        let wide = tune.bw == RTW_CHANNEL_WIDTH_40;
+        // The channel on both RF paths, the width on path A's.
+        let mut a = self.read_rf_path(0, RF_CFGCH, RFREG_MASK);
+        let mut b = self.read_rf_path(1, RF_CFGCH, RFREG_MASK);
+        a = (a & !RFCFGCH_CHANNEL_MASK) | (channel as u32 & RFCFGCH_CHANNEL_MASK);
+        b = (b & !RFCFGCH_CHANNEL_MASK) | (channel as u32 & RFCFGCH_CHANNEL_MASK);
+        a = (a & !RFCFGCH_BW_MASK) | if wide { RFCFGCH_BW_40M } else { RFCFGCH_BW_20M };
+        self.write_rf_path(0, RF_CFGCH, RFREG_MASK, a);
+        self.write_rf_path(1, RF_CFGCH, RFREG_MASK, b);
+        self.spur_cal_8723d(channel);
+        self.set_channel_mac(tune);
+        let c = &self.chip;
+        for (register, value) in CCK_DFIR[if channel <= 13 { 0 } else { 1 }] {
+            c.w32(register, value);
+        }
+        if wide {
+            c.w32_mask(REG_FPGA0_RFMOD, BIT_MASK_RFMOD, 0x1);
+            c.w32_mask(REG_FPGA1_RFMOD, BIT_MASK_RFMOD, 0x1);
+            c.w32_mask(REG_BBRX_DFIR, BIT_RXBB_DFIR_EN, 0);
+            c.w32_mask(REG_CCK0_SYS, BIT_CCK_SIDE_BAND, (tune.pri_idx as u32 == RTW_SC_20_UPPER) as u32);
+        } else {
+            c.w32_mask(REG_FPGA0_RFMOD, BIT_MASK_RFMOD, 0x0);
+            c.w32_mask(REG_FPGA1_RFMOD, BIT_MASK_RFMOD, 0x0);
+            c.w32_mask(REG_BBRX_DFIR, BIT_RXBB_DFIR_EN, 1);
+            c.w32_mask(REG_BBRX_DFIR, BIT_MASK_RXBB_DFIR, 0xa);
+        }
+    }
+
+    /// `rtw8723d_spur_cal`: on channels 13 and 14, a notch where the PSD
+    /// finds the spur.
+    fn spur_cal_8723d(&self, channel: u8) {
+        let notch = channel >= 13 && self.spur_over_8723d(channel);
+        self.notch_8723d(channel, notch);
+    }
+
+    /// `rtw8723d_check_spur_ov_thres`.
+    fn spur_over_8723d(&self, channel: u8) -> bool {
+        let freq = match channel {
+            13 => FREQ_CH13,
+            14 => FREQ_CH14,
+            _ => return false,
+        };
+        let c = &self.chip;
+        c.w32(REG_ANALOG_P4, DIS_3WIRE);
+        c.w32(REG_PSDFN, freq);
+        c.w32(REG_PSDFN, START_PSD | freq);
+        crate::sleep_ms(30);
+        let over = c.r32(REG_PSDRPT) >= SPUR_THRES;
+        c.w32(REG_PSDFN, freq);
+        c.w32(REG_ANALOG_P4, EN_3WIRE);
+        over
+    }
+
+    /// `rtw8723d_cfg_notch`.
+    fn notch_8723d(&self, channel: u8, notch: bool) {
+        let c = &self.chip;
+        let (dsp, csi) = match (notch, channel) {
+            (true, 13) => (0xb, [0x0400_0000, 0, 0, 0]),
+            (true, 14) => (0x5, [0, 0, 0, 0x0008_0000]),
+            _ => {
+                c.w32_mask(REG_OFDM0_RXDSP, BIT_MASK_RXDSP, 0x1f);
+                c.w32_mask(REG_OFDM0_RXDSP, BIT_EN_RXDSP, 0x0);
+                for register in [REG_OFDM1_CSI1, REG_OFDM1_CSI2, REG_OFDM1_CSI3, REG_OFDM1_CSI4] {
+                    c.w32(register, 0);
+                }
+                c.w32_mask(REG_OFDM1_CFOTRK, BIT_EN_CFOTRK, 0x0);
+                return;
+            }
+        };
+        c.w32_mask(REG_OFDM0_RXDSP, BIT_MASK_RXDSP, dsp);
+        c.w32_mask(REG_OFDM0_RXDSP, BIT_EN_RXDSP, 0x1);
+        for (register, value) in [REG_OFDM1_CSI1, REG_OFDM1_CSI2, REG_OFDM1_CSI3, REG_OFDM1_CSI4].into_iter().zip(csi) {
+            c.w32(register, value);
+        }
+        c.w32_mask(REG_OFDM1_CFOTRK, BIT_EN_CFOTRK, 0x1);
+    }
+
+    /// `rtw8723x_set_tx_power_index`: CCK, OFDM and one stream's MCS, each
+    /// rate's index in its byte.
+    pub(crate) fn set_tx_power_8723d(&self, tables: &RfeTables, channel: u8) {
+        for path in 0..self.paths() {
+            for (section, rates) in RATE_SECTIONS.into_iter().take(3) {
+                for rate in rates {
+                    let index = self.power_index(tables, path, channel, rate, section);
+                    let (register, mask) = TXAGC[rate as usize];
+                    self.chip.w32_mask(register, mask, index as u32);
+                }
+            }
+        }
+    }
+
+    // ---- The IQ calibration (`rtw8723d_phy_calibration`). ----
+
+    pub(crate) fn do_iqk_8723d(&mut self) {
+        let mut result = [[0i32; IQK_NR]; ROUNDS + 1];
+        let backup = self.iqk_backup();
+        let mut chosen = None;
+        'rounds: for round in 0..ROUNDS {
+            self.iqk_config_path_ctrl();
+            self.iqk_config_lte_path_gnt(IQK_LTE_WRITE);
+            self.iqk_one_round(&mut result, round, &backup);
+            if round > 0 {
+                self.iqk_restore_regs(&backup);
+            }
+            self.iqk_restore_lte_path_gnt(&backup);
+            self.chip.w8(REG_BTG_SEL, backup.btg_sel);
+            for earlier in 0..round {
+                if iqk_similar(&mut result, earlier, round) {
+                    chosen = Some(earlier);
+                    break 'rounds;
+                }
+            }
+        }
+        if chosen.is_none() && result[ROUND_HYBRID].iter().sum::<i32>() != 0 {
+            chosen = Some(ROUND_HYBRID);
+        }
+        match chosen {
+            Some(round) => {
+                let values = result[round];
+                self.iqk_fill_s1(&values);
+                self.iqk_fill_s0(&values);
+            }
+            None => ostd::warn!("{}: the IQ calibration failed", self.chip.name),
+        }
+        self.chip.w32(REG_BB_SEL_BTG, backup.bb_sel_btg);
+    }
+
+    /// `rtw8723x_iqk_backup_path_ctrl`, `_backup_lte_path_gnt` and
+    /// `_backup_regs`.
+    fn iqk_backup(&self) -> IqkBackup {
+        let c = &self.chip;
+        let btg_sel = c.r8(REG_BTG_SEL);
+        let lte_path = c.r32(REG_LTECOEX_PATH_CONTROL);
+        c.w32(REG_LTECOEX_CTRL, 0x800f_0038);
+        crate::delay_ms(1);
+        let lte_gnt = c.r32(REG_LTECOEX_READ_DATA);
+        IqkBackup {
+            adda: IQK_ADDA.map(|register| c.r32(register)),
+            mac8: IQK_MAC8.map(|register| c.r8(register)),
+            mac32: IQK_MAC32.map(|register| c.r32(register)),
+            bb: IQK_BB.map(|register| c.r32(register)),
+            lte_path,
+            lte_gnt,
+            bb_sel_btg: c.r32(REG_BB_SEL_BTG),
+            btg_sel,
+            igia: c.r32_mask(REG_OFDM0_XAAGC1, MASKBYTE0),
+            igib: c.r32_mask(REG_OFDM0_XBAGC1, MASKBYTE0),
+        }
+    }
+
+    /// `rtw8723x_iqk_restore_regs`.
+    fn iqk_restore_regs(&self, backup: &IqkBackup) {
+        let c = &self.chip;
+        for (register, value) in IQK_ADDA.into_iter().zip(backup.adda) {
+            c.w32(register, value);
+        }
+        for (register, value) in IQK_MAC8.into_iter().zip(backup.mac8) {
+            c.w8(register, value);
+        }
+        for (register, value) in IQK_MAC32.into_iter().zip(backup.mac32) {
+            c.w32(register, value);
+        }
+        for (register, value) in IQK_BB.into_iter().zip(backup.bb) {
+            c.w32(register, value);
+        }
+        c.w32_mask(REG_OFDM0_XAAGC1, MASKBYTE0, 0x50);
+        c.w32_mask(REG_OFDM0_XAAGC1, MASKBYTE0, backup.igia);
+        c.w32_mask(REG_OFDM0_XBAGC1, MASKBYTE0, 0x50);
+        c.w32_mask(REG_OFDM0_XBAGC1, MASKBYTE0, backup.igib);
+        c.w32(REG_TXIQK_TONE_A_11N, 0x0100_8c00);
+        c.w32(REG_RXIQK_TONE_A_11N, 0x0100_8c00);
+    }
+
+    /// `rtw8723x_iqk_config_path_ctrl`: the antenna to WLAN's path.
+    fn iqk_config_path_ctrl(&self) {
+        self.chip.w32_mask(REG_PAD_CTRL1, BIT_BT_BTG_SEL, 0x1);
+    }
+
+    /// `rtw8723x_iqk_config_lte_path_gnt`.
+    fn iqk_config_lte_path_gnt(&self, value: u32) {
+        let c = &self.chip;
+        c.w32(REG_LTECOEX_WRITE_DATA, value);
+        c.w32(REG_LTECOEX_CTRL, 0xc002_0038);
+        c.w32_mask(REG_LTECOEX_PATH_CONTROL, BIT_LTE_MUX_CTRL_PATH, 0x1);
+    }
+
+    /// `rtw8723x_iqk_restore_lte_path_gnt`.
+    fn iqk_restore_lte_path_gnt(&self, backup: &IqkBackup) {
+        let c = &self.chip;
+        c.w32(REG_LTECOEX_WRITE_DATA, backup.lte_gnt);
+        c.w32(REG_LTECOEX_CTRL, 0xc00f_0038);
+        c.w32(REG_LTECOEX_PATH_CONTROL, backup.lte_path);
+    }
+
+    /// `rtw8723x_iqk_path_adda_on`.
+    fn iqk_adda_on(&self) {
+        for register in IQK_ADDA {
+            self.chip.w32(register, ADDA_ON);
+        }
+    }
+
+    fn iqk_mode(&self, on: bool) {
+        self.chip.w32_mask(REG_FPGA0_IQK_11N, BIT_MASK_IQK_MOD, if on { EN_IQK } else { RST_IQK });
+    }
+
+    /// `rtw8723d_iqk_one_shot`: LOK and IQK started, then done.
+    fn iqk_one_shot(&self, tx: bool, side: &IqkSide) {
+        let c = &self.chip;
+        self.iqk_mode(true);
+        self.iqk_config_lte_path_gnt(IQK_LTE_WRITE);
+        c.w32(REG_LTECOEX_CTRL, 0x800f_0054);
+        crate::delay_ms(1);
+        c.w32(REG_IQK_AGC_PTS_11N, if tx { side.iqkpts } else { 0xf900_0000 });
+        c.w32(REG_IQK_AGC_PTS_11N, 0xf800_0000);
+        if !c.ready(REG_IQK_RES_RY, BIT_IQK_DONE, 1) {
+            ostd::warn!("{}: an IQ calibration step did not finish", c.name);
+        }
+    }
+
+    /// `rtw8723d_iqk_check_tx_failed`.
+    fn iqk_tx_ok(&self) -> u8 {
+        let c = &self.chip;
+        let failed = c.r32_mask(REG_IQK_RES_RY, BIT_IQK_TX_FAIL) != 0;
+        let (x, y) = (c.r32_mask(REG_IQK_RES_TX, BIT_MASK_RES_TX), c.r32_mask(REG_IQK_RES_TY, BIT_MASK_RES_TY));
+        if !failed && x != TX_X_ERR && y != TX_Y_ERR { TX_OK } else { 0 }
+    }
+
+    /// `rtw8723d_iqk_check_rx_failed`.
+    fn iqk_rx_ok(&self) -> u8 {
+        let c = &self.chip;
+        let failed = c.r32_mask(REG_IQK_RES_RY, BIT_IQK_RX_FAIL) != 0;
+        let x = c.r32_mask(REG_IQK_RES_RX, BIT_MASK_RES_RX);
+        let y = iqk_signed(c.r32_mask(REG_IQK_RES_RY, BIT_MASK_RES_RY) as i32).unsigned_abs();
+        if !failed && x < RX_X_UPPER && x > RX_X_LOWER && y < RX_Y_LIMIT { RX_OK } else { 0 }
+    }
+
+    /// `rtw8723d_iqk_txrx_path_post`: IQK mode left.
+    fn iqk_side_post(&self, side: &IqkSide, backup: &IqkBackup) {
+        self.iqk_restore_lte_path_gnt(backup);
+        self.chip.w32(REG_BB_SEL_BTG, backup.bb_sel_btg);
+        self.iqk_mode(false);
+        crate::delay_ms(1);
+        self.write_rf(side.padlut, 0x800, 0x0);
+        self.write_rf(RF_WLINT, 1 << 0, 0x0);
+        self.write_rf(RF_WLSEL, 1 << 0, 0x0);
+    }
+
+    /// The RF's LUT for an IQK mode: `lutwa`, `lutwd1`, `lutwd0`.
+    fn iqk_lut(&self, side: &IqkSide, lut: [u32; 3]) {
+        self.write_rf(side.lutwe, RFREG_MASK, 0x80000);
+        self.write_rf(RF_LUTWA, RFREG_MASK, lut[0]);
+        self.write_rf(RF_LUTWD1, RFREG_MASK, lut[1]);
+        self.write_rf(RF_LUTWD0, RFREG_MASK, lut[2]);
+        self.write_rf(side.lutwe, RFREG_MASK, 0x00000);
+    }
+
+    /// `rtw8723d_iqk_tx_path`.
+    fn iqk_tx_side(&self, side: &IqkSide, backup: &IqkBackup) -> u8 {
+        let c = &self.chip;
+        c.w32(REG_BB_SEL_BTG, side.bb_sel_btg);
+        self.iqk_mode(false);
+        crate::delay_ms(1);
+        self.iqk_lut(side, [0x00004, 0x0005d, 0xbffe0]);
+        let c = &self.chip;
+        c.w32(REG_TXIQK_TONE_A_11N, 0x0800_8c0c);
+        c.w32(REG_RXIQK_TONE_A_11N, 0x3800_8c1c);
+        c.w32(REG_TXIQK_PI_A_11N, side.txiqk_pi);
+        c.w32(REG_RXIQK_PI_A_11N, 0x2816_0200);
+        c.w32(REG_TXIQK_11N, 0x0100_7c00);
+        c.w32(REG_RXIQK_11N, 0x0100_4800);
+        c.w32(REG_IQK_AGC_RSP_11N, 0x0046_2911);
+        // PA and PAD, then the 8723D's LOK.
+        self.write_rf(side.padlut, 0x800, 0x1);
+        self.write_rf(side.gaintx, 0x600, 0x0);
+        self.write_rf(side.gaintx, 0x1e0, 0x3);
+        self.write_rf(RF_RXIQGEN, 0x1f, 0xf);
+        self.write_rf(side.lutwe, 0x10, 0x1);
+        self.write_rf(side.bspad, 0x1, 0x1);
+        self.write_rf(RF_WLINT, RFREG_MASK, side.wlint);
+        self.write_rf(RF_WLSEL, RFREG_MASK, side.wlsel);
+        self.iqk_one_shot(true, side);
+        let status = self.iqk_tx_ok();
+        self.iqk_side_post(side, backup);
+        status
+    }
+
+    /// `rtw8723d_iqk_rx_path`: its first step a TX IQK, whose result the
+    /// second step's TX takes.
+    fn iqk_rx_side(&self, side: &IqkSide, backup: &IqkBackup) -> u8 {
+        let c = &self.chip;
+        c.w32(REG_BB_SEL_BTG, side.bb_sel_btg);
+        self.iqk_mode(false);
+        c.w32(REG_TXIQK_11N, 0x0100_7c00);
+        c.w32(REG_RXIQK_11N, 0x0100_4800);
+        c.w32(REG_TXIQK_TONE_A_11N, 0x1800_8c1c);
+        c.w32(REG_RXIQK_TONE_A_11N, 0x3800_8c1c);
+        c.w32(REG_TX_IQK_TONE_B, 0x3800_8c1c);
+        c.w32(REG_RX_IQK_TONE_B, 0x3800_8c1c);
+        c.w32(REG_TXIQK_PI_A_11N, 0x8216_0000);
+        c.w32(REG_RXIQK_PI_A_11N, 0x2816_0000);
+        c.w32(REG_IQK_AGC_RSP_11N, 0x0046_a911);
+        self.iqk_lut(side, [0x00006, 0x0005f, 0xa7ffb]);
+        self.write_rf(side.padlut, 0x800, 0x1);
+        self.write_rf(side.gaintx, 0x600, 0x0);
+        self.write_rf(RF_WLINT, RFREG_MASK, side.wlint);
+        self.write_rf(RF_WLSEL, RFREG_MASK, side.wlsel);
+        self.iqk_one_shot(false, side);
+        let mut status = self.iqk_tx_ok();
+        if status != 0 {
+            let c = &self.chip;
+            let (x, y) = (c.r32_mask(REG_IQK_RES_TX, BIT_MASK_RES_TX), c.r32_mask(REG_IQK_RES_TY, BIT_MASK_RES_TY));
+            c.w32(REG_TXIQK_11N, 0x8000_7c00 | (x << 16) | y);
+            c.w32(REG_RXIQK_11N, 0x0100_4800);
+            c.w32(REG_TXIQK_TONE_A_11N, 0x3800_8c1c);
+            c.w32(REG_RXIQK_TONE_A_11N, 0x1800_8c1c);
+            c.w32(REG_TX_IQK_TONE_B, 0x3800_8c1c);
+            c.w32(REG_RX_IQK_TONE_B, 0x3800_8c1c);
+            c.w32(REG_TXIQK_PI_A_11N, 0x8217_0000);
+            c.w32(REG_RXIQK_PI_A_11N, 0x2817_1400);
+            c.w32(REG_IQK_AGC_RSP_11N, 0x0046_a8d1);
+            self.iqk_mode(false);
+            crate::delay_ms(1);
+            self.write_rf(side.lutwe, 0x80000, 0x1);
+            self.write_rf(RF_LUTWA, RFREG_MASK, 0x00007);
+            self.write_rf(RF_LUTWD1, RFREG_MASK, 0x0005f);
+            self.write_rf(RF_LUTWD0, RFREG_MASK, 0xb3fdb);
+            self.write_rf(side.lutwe, RFREG_MASK, 0x00000);
+            self.iqk_one_shot(false, side);
+            status |= self.iqk_rx_ok();
+        }
+        self.iqk_side_post(side, backup);
+        status
+    }
+
+    /// `rtw8723d_iqk_rf_standby`.
+    fn iqk_rf_standby(&self, path: usize) {
+        self.iqk_mode(false);
+        crate::delay_ms(1);
+        self.write_rf_path(path, RF_MODE, RFREG_MASK, 0x10000);
+        self.iqk_mode(true);
+    }
+
+    /// `rtw8723d_iqk_precfg_path`: the other side's RF path in standby.
+    fn iqk_precfg_side(&self, s0: bool) {
+        if s0 {
+            self.iqk_rf_standby(0);
+            self.iqk_adda_on();
+        }
+        self.iqk_mode(true);
+        self.chip.w32(REG_TXIQK_11N, 0x0100_7c00);
+        self.chip.w32(REG_RXIQK_11N, 0x0100_4800);
+        if !s0 {
+            self.iqk_rf_standby(1);
+            self.iqk_adda_on();
+        }
+    }
+
+    /// `rtw8723d_iqk_one_round`: S1, then S0, each its TX and its RX.
+    fn iqk_one_round(&self, result: &mut [[i32; IQK_NR]; ROUNDS + 1], round: usize, backup: &IqkBackup) {
+        self.iqk_adda_on();
+        let c = &self.chip;
+        c.w8(REG_TXPAUSE, 0xff);
+        c.w32_mask(REG_CCK_ANT_SEL_11N, 0x0f00_0000, 0xf);
+        c.w32(REG_BB_RX_PATH_11N, 0x03a0_5611);
+        c.w32(REG_TRMUX_11N, 0x0008_00e4);
+        c.w32(REG_BB_PWR_SAV1_11N, 0x2520_4200);
+        for (index, side) in IQK_SIDES.iter().enumerate() {
+            let s0 = index == 1;
+            let tx_at = if s0 { S0_TX_X } else { S1_TX_X };
+            let rx_at = tx_at + 2;
+            self.iqk_precfg_side(s0);
+            for _ in 0..PATH_RETRY {
+                if self.iqk_tx_side(side, backup) == TX_OK {
+                    result[round][tx_at] = self.chip.r32_mask(REG_IQK_RES_TX, BIT_MASK_RES_TX) as i32;
+                    result[round][tx_at + 1] = self.chip.r32_mask(REG_IQK_RES_TY, BIT_MASK_RES_TY) as i32;
+                    break;
+                }
+                result[round][tx_at] = 0x100;
+                result[round][tx_at + 1] = 0;
+            }
+            for _ in 0..PATH_RETRY {
+                if self.iqk_rx_side(side, backup) == TX_OK | RX_OK {
+                    result[round][rx_at] = self.chip.r32_mask(REG_IQK_RES_RX, BIT_MASK_RES_RX) as i32;
+                    result[round][rx_at + 1] = self.chip.r32_mask(REG_IQK_RES_RY, BIT_MASK_RES_RY) as i32;
+                    break;
+                }
+                result[round][rx_at] = 0x100;
+                result[round][rx_at + 1] = 0;
+            }
+        }
+        self.iqk_mode(false);
+        crate::delay_ms(1);
+    }
+
+    /// `rtw8723d_iqk_fill_s1_matrix`.
+    fn iqk_fill_s1(&self, result: &[i32; IQK_NR]) {
+        if result[S1_TX_X] == 0 {
+            return;
+        }
+        let c = &self.chip;
+        let old = c.r32_mask(REG_OFDM_0_XA_TX_IQ_IMBALANCE, BIT_MASK_TXIQ_ELM_D) as i32;
+        let (a, a_ext) = iqk_mult(iqk_signed(result[S1_TX_X]), old);
+        c.w32_mask(REG_OFDM_0_XA_TX_IQ_IMBALANCE, BIT_MASK_TXIQ_ELM_A, a as u32);
+        c.w32_mask(REG_OFDM_0_ECCA_THRESHOLD, BIT_MASK_OFDM0_EXT_A, a_ext as u32);
+        let (cc, c_ext) = iqk_mult(iqk_signed(result[S1_TX_X + 1]), old);
+        c.w32_mask(REG_TXIQK_MATRIXA_LSB2_11N, MASKH4BITS, ((cc as u32) & 0x3c0) >> 6);
+        c.w32_mask(REG_OFDM_0_XA_TX_IQ_IMBALANCE, BIT_MASK_TXIQ_ELM_C, (cc as u32) & 0x3f);
+        c.w32_mask(REG_OFDM_0_ECCA_THRESHOLD, BIT_MASK_OFDM0_EXT_C, c_ext as u32);
+        if result[S1_RX_X] == 0 {
+            return;
+        }
+        let y = result[S1_RX_X + 1] as u32;
+        c.w32_mask(REG_A_RXIQI, BIT_MASK_RXIQ_S1_X, result[S1_RX_X] as u32);
+        c.w32_mask(REG_A_RXIQI, BIT_MASK_RXIQ_S1_Y1, y & 0x3f);
+        c.w32_mask(REG_RXIQK_MATRIX_LSB_11N, BIT_MASK_RXIQ_S1_Y2, (y >> 6) & 0xf);
+    }
+
+    /// `rtw8723d_iqk_fill_s0_matrix`.
+    fn iqk_fill_s0(&self, result: &[i32; IQK_NR]) {
+        if result[S0_TX_X] == 0 {
+            return;
+        }
+        let c = &self.chip;
+        let old = c.r32_mask(REG_TXIQ_CD_S0, BIT_MASK_TXIQ_D_S0) as i32;
+        let (a, a_ext) = iqk_mult(iqk_signed(result[S0_TX_X]), old);
+        c.w32_mask(REG_TXIQ_AB_S0, BIT_MASK_TXIQ_A_S0, a as u32);
+        c.w32_mask(REG_TXIQ_AB_S0, BIT_MASK_TXIQ_A_EXT_S0, a_ext as u32);
+        let (cc, c_ext) = iqk_mult(iqk_signed(result[S0_TX_X + 1]), old);
+        c.w32_mask(REG_TXIQ_CD_S0, BIT_MASK_TXIQ_C_S0, cc as u32);
+        c.w32_mask(REG_TXIQ_CD_S0, BIT_MASK_TXIQ_C_EXT_S0, c_ext as u32);
+        if result[S0_RX_X] == 0 {
+            return;
+        }
+        c.w32_mask(REG_RXIQ_AB_S0, BIT_MASK_RXIQ_X_S0, result[S0_RX_X] as u32);
+        c.w32_mask(REG_RXIQ_AB_S0, BIT_MASK_RXIQ_Y_S0, result[S0_RX_X + 1] as u32);
+    }
+
+    // ---- BT coexistence. ----
+
+    /// `rtw8723d_coex_cfg_gnt_debug`: the GNT debug pins off.
+    pub(crate) fn coex_gnt_debug_8723d(&self) {
+        let c = &self.chip;
+        c.w8_mask(REG_LEDCFG2, 1 << 6, 0);
+        c.w8_mask(REG_PAD_CTRL1 + 3, 1 << 0, 0);
+        c.w8_mask(REG_GPIO_INTM + 2, 1 << 4, 0);
+        c.w8_mask(REG_GPIO_MUXCFG + 2, 1 << 1, 0);
+        c.w8_mask(REG_PAD_CTRL1 + 3, 1 << 1, 0);
+        c.w8_mask(REG_PAD_CTRL1 + 2, 1 << 7, 0);
+        c.w8_mask(REG_SYS_CLKR + 1, 1 << 1, 0);
+        c.w8_mask(REG_SYS_SDIO_CTRL + 3, 1 << 3, 0);
+    }
+
+    /// `rtw8723d_coex_cfg_rfe_type`: the antenna, main or aux, shared or
+    /// not; the LTE coexistence off on the WLAN side.
+    pub(crate) fn coex_rfe_type_8723d(&self) {
+        let aux = self.efuse.bt_setting & (1 << 6) != 0;
+        let select = match (self.efuse.share_ant, aux) {
+            (true, true) => 0x80,
+            (true, false) => 0x200,
+            (false, true) => 0x280,
+            (false, false) => 0x0,
+        };
+        let c = &self.chip;
+        c.w16(REG_BB_SEL_BTG, select);
+        c.ltecoex_write_mask(LTE_COEX_CTRL as u16, BIT_LTE_COEX_EN, 0);
+        c.ltecoex_write_mask(LTE_WL_TRX_CTRL as u16, MASKLWORD, 0xffff);
+        c.ltecoex_write_mask(LTE_BT_TRX_CTRL as u16, MASKLWORD, 0xffff);
+    }
+}
diff --git a/kernel/comps/rtw88/src/rtw8821c.rs b/kernel/comps/rtw88/src/rtw8821c.rs
new file mode 100644
index 0000000..90a3bb8
--- /dev/null
+++ b/kernel/comps/rtw88/src/rtw8821c.rs
@@ -0,0 +1,284 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! What is the RTL8821C's own (Linux's `rtw8821c.c`): its efuse fields, MAC
+//! and PHY settings, the channel (BB, RF, the RF front end's set, the BB
+//! swing, the RX DFIR) and the antenna it shares with Bluetooth.
+
+use crate::{
+    hw::{Hw, RF18_BW_40M, RF18_BW_80M, Switch, SwitchCtrl, Tune},
+    regs::*,
+};
+
+/// The DIG register of path A (`rtw8821c_dig`).
+const DIG_ADDR: u32 = 0x0c50;
+/// The CCK LNA gains (`lna_gain_table_0`, `_1`).
+const LNA_GAIN_0: [i8; 8] = [22, 8, -6, -22, -31, -40, -46, -52];
+const LNA_GAIN_1: [i8; 16] = [10, 6, 2, -2, -6, -10, -14, -17, -20, -24, -28, -31, -34, -37, -40, -44];
+
+/// The RF front end's set (`enum rtw8821ce_rf_set`).
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum RfSet {
+    Btg,
+    Wlg,
+    Wla,
+}
+
+impl Hw {
+    /// `rtw8821c_read_efuse`'s own fields: the package type beside the RFE
+    /// option, the BT-shared front end; boards whose 2.4 GHz power is
+    /// path B's (`txpwr_idx_table[1].pwr_idx_2g`).
+    pub(crate) fn efuse_8821c(&mut self) {
+        let e = &mut self.efuse;
+        let raw = e.rfe_option;
+        e.rfe_option = raw & 0x1f;
+        e.pkg_type = (raw >> 5) & 1;
+        e.rfe_btg = matches!(e.rfe_option, 0x2 | 0x4 | 0x7 | 0xa | 0xc | 0xf);
+        if e.rfe_option == 2 || e.rfe_option == 4 {
+            let path_b = e.txpwr[1];
+            e.txpwr[0][..18].copy_from_slice(&path_b[..18]);
+        }
+    }
+
+    /// `rtw8821c_query_phy_status`: CCK by the LNA and VGA indexes, OFDM by
+    /// path A's power.
+    pub(crate) fn phy_signal_8821c(&self, status: &[u8]) -> Option<i32> {
+        match status[0] & 0xf {
+            0 => {
+                let w3 = u32::from_le_bytes([status[12], status[13], status[14], status[15]]);
+                let vga = ((w3 >> 8) & 0x1f) as i32;
+                let lna = ((((w3 >> 23) & 1) << 3) | ((w3 >> 13) & 7)) as usize;
+                let table: &[i8] = if self.efuse.rfe_option == 0 { &LNA_GAIN_0 } else { &LNA_GAIN_1 };
+                table.get(lna).map(|&gain| gain as i32 - 2 * vga)
+            }
+            1 => Some(status[1] as i32 - 110),
+            _ => None,
+        }
+    }
+
+    /// `rtw8821c_mac_init`.
+    pub(crate) fn mac_init_8821c(&self) {
+        let c = &self.chip;
+        c.w8(REG_AMPDU_MAX_TIME_V1, WLAN_AMPDU_MAX_TIME as u8);
+        c.set8(REG_TX_HANG_CTRL, BIT_EN_EOF_V1);
+        let pre_txcnt = WLAN_PRE_TXCNT_TIME_TH | BIT_EN_PRECNT;
+        c.w8(REG_PRECNT_CTRL, pre_txcnt as u8);
+        c.w8(REG_PRECNT_CTRL + 1, (pre_txcnt >> 8) as u8);
+        self.mac_init_common();
+        c.set8(REG_INIRTS_RATE_SEL, 1 << 5);
+        self.mac_init_edca_wmac();
+        c.w8(REG_ACKTO_CCK, 0x40);
+        c.set8(REG_WMAC_TRXPTCL_CTL_H, 1 << 1);
+        c.set8(REG_SND_PTCL_CTRL, BIT_DIS_CHK_VHTSIGB_CRC);
+        c.w32(REG_WMAC_OPTION_FUNCTION + 8, WLAN_MAC_OPT_FUNC2);
+        c.w8(REG_WMAC_OPTION_FUNCTION + 4, WLAN_MAC_OPT_NORM_FUNC1 as u8);
+    }
+
+    /// `rtw8821c_phy_set_param`.
+    pub(crate) fn phy_set_param_8821c(&mut self) {
+        let c = &self.chip;
+        let mut value = c.r8(REG_SYS_FUNC_EN) | BIT_FEN_PCIEA as u8;
+        c.w8(REG_SYS_FUNC_EN, value);
+        let reset = (BIT_FEN_BB_RSTB | BIT_FEN_BB_GLB_RST) as u8;
+        value |= reset;
+        c.w8(REG_SYS_FUNC_EN, value);
+        value &= !reset;
+        c.w8(REG_SYS_FUNC_EN, value);
+        value |= reset;
+        c.w8(REG_SYS_FUNC_EN, value);
+        c.w8(REG_RF_CTRL, (BIT_RF_EN | BIT_RF_RSTB | BIT_RF_SDM_RSTB) as u8);
+        crate::delay_us(10);
+        c.w8(REG_WLRF1 + 3, (BIT_RF_EN | BIT_RF_RSTB | BIT_RF_SDM_RSTB) as u8);
+        crate::delay_us(10);
+        c.clr32(REG_RXPSEL, BIT_RX_PSEL_RST);
+        self.load_tables();
+        self.set_crystal_cap();
+        let c = &self.chip;
+        c.w32_mask(REG_CCK0_FAREPORT, (1 << 18) | (1 << 22), 0);
+        c.set32(REG_RXPSEL, BIT_RX_PSEL_RST);
+        self.ch_param = [c.r32(REG_TXSF2), c.r32(REG_TXSF6), c.r32(REG_TXFILTER)];
+        let _ = c.r32_mask(DIG_ADDR, 0x7f);
+        self.pwrtrack_init();
+        // `rtw8821c_phy_bf_init`.
+        self.phy_bf_init();
+        self.chip.w32(0x1c94, 0xafff_afff);
+    }
+
+    /// `rtw8821c_set_channel`, with the BB swing of the band.
+    pub(crate) fn set_channel_8821c(&mut self, tune: Tune) {
+        let channel = tune.center;
+        self.set_channel_bb_8821c(tune);
+        // BB swing (`rtw8821c_set_channel_bb_swing`).
+        let swing = if channel <= 14 { self.efuse.tx_bb_swing_2g } else { self.efuse.tx_bb_swing_5g };
+        let swing = if swing > 9 { 0 } else { swing };
+        self.chip.w32_mask(REG_TXSCALE_A, 0xffe0_0000, [0x200, 0x16a, 0x101, 0x0b6][(swing / 3) as usize]);
+        self.pwrtrack_init();
+        self.set_channel_mac(tune);
+        self.set_channel_rf_8821c(tune);
+        // `rtw8821c_set_channel_rxdfir`.
+        let (acbb0, rxfir, txdfir, chfir) = match tune.bw {
+            RTW_CHANNEL_WIDTH_40 => (0x2, 0x2, 0x0, 0x0),
+            RTW_CHANNEL_WIDTH_80 => (0x2, 0x1, 0x0, 0x1),
+            _ => (0x2, 0x2, 0x1, 0x0),
+        };
+        let c = &self.chip;
+        c.w32_mask(REG_ACBB0, (1 << 29) | (1 << 28), acbb0);
+        c.w32_mask(REG_ACBBRXFIR, (1 << 29) | (1 << 28), rxfir);
+        c.w32_mask(REG_TXDFIR, 1 << 31, txdfir);
+        c.w32_mask(REG_CHFIR, 1 << 31, chfir);
+    }
+
+    fn set_channel_bb_8821c(&self, tune: Tune) {
+        let channel = tune.center;
+        let c = &self.chip;
+        if channel <= 14 {
+            c.w32_mask(REG_RXPSEL, 1 << 28, 0x1);
+            c.w32_mask(REG_CCK_CHECK, 1 << 7, 0x0);
+            c.w32_mask(REG_ENTXCCK, 1 << 18, 0x0);
+            c.w32_mask(REG_RXCCAMSK, 0x0000_fc00, 15);
+            c.w32_mask(REG_TXSCALE_A, 0xf00, 0x0);
+            c.w32_mask(REG_CLKTRK, 0x1ffe_0000, 0x96a);
+            if channel == 14 {
+                c.w32(REG_TXSF2, 0x0000_b81c);
+                c.w32_mask(REG_TXSF6, MASKLWORD, 0x0000);
+                c.w32(REG_TXFILTER, 0x0000_3667);
+            } else {
+                c.w32(REG_TXSF2, self.ch_param[0]);
+                c.w32_mask(REG_TXSF6, MASKLWORD, self.ch_param[1] & MASKLWORD);
+                c.w32(REG_TXFILTER, self.ch_param[2]);
+            }
+        } else {
+            c.w32_mask(REG_ENTXCCK, 1 << 18, 0x1);
+            c.w32_mask(REG_CCK_CHECK, 1 << 7, 0x1);
+            c.w32_mask(REG_RXPSEL, 1 << 28, 0x0);
+            c.w32_mask(REG_RXCCAMSK, 0x0000_fc00, 15);
+            let scale = match channel {
+                36..=64 => 0x1,
+                100..=144 => 0x2,
+                _ => 0x3,
+            };
+            c.w32_mask(REG_TXSCALE_A, 0xf00, scale);
+            let track = match channel {
+                36..=48 => 0x494,
+                52..=64 => 0x453,
+                100..=116 => 0x452,
+                _ => 0x412,
+            };
+            c.w32_mask(REG_CLKTRK, 0x1ffe_0000, track);
+        }
+        let pri = tune.pri_idx as u32 & 0xf;
+        let value = match tune.bw {
+            RTW_CHANNEL_WIDTH_40 => {
+                if pri == RTW_SC_20_UPPER {
+                    c.set32(REG_RXSB, 1 << 4);
+                } else {
+                    c.clr32(REG_RXSB, 1 << 4);
+                }
+                (c.r32(REG_ADCCLK) & 0xff3f_f300) | 0x2002_0000 | (pri << 2) | RTW_CHANNEL_WIDTH_40
+            }
+            RTW_CHANNEL_WIDTH_80 => (c.r32(REG_ADCCLK) & 0xfcff_cf00) | 0x4004_0000 | (pri << 2) | RTW_CHANNEL_WIDTH_80,
+            _ => (c.r32(REG_ADCCLK) & 0xffcf_fc00) | 0x1001_0000,
+        };
+        c.w32(REG_ADCCLK, value);
+        c.w32_mask(REG_ADC160, 1 << 30, 0x1);
+    }
+
+    /// `rtw8821c_set_channel_rf`.
+    fn set_channel_rf_8821c(&self, tune: Tune) {
+        let channel = tune.center;
+        let mut reg18 = self.read_rf(0x18, RFREG_MASK);
+        reg18 &= !(RF18_BAND_MASK | RF18_CHANNEL_MASK | RF18_RFSI_MASK | RF18_BW_MASK);
+        reg18 |= if channel <= 14 { RF18_BAND_2G } else { RF18_BAND_5G };
+        reg18 |= channel as u32 & RF18_CHANNEL_MASK;
+        if (100..=140).contains(&channel) {
+            reg18 |= RF18_RFSI_GE;
+        } else if channel > 140 {
+            reg18 |= RF18_RFSI_GT;
+        }
+        reg18 |= match tune.bw {
+            RTW_CHANNEL_WIDTH_40 => RF18_BW_40M,
+            RTW_CHANNEL_WIDTH_80 => RF18_BW_80M,
+            _ => RF18_BW_20M,
+        };
+        if channel <= 14 {
+            self.switch_rf_set(if self.efuse.rfe_btg { RfSet::Btg } else { RfSet::Wlg });
+            self.write_rf(RF_LUTDBG, 1 << 6, 0x1);
+            self.write_rf(0x64, 0xf, 0xf);
+        } else {
+            self.switch_rf_set(RfSet::Wla);
+            self.write_rf(RF_LUTDBG, 1 << 6, 0x0);
+        }
+        self.write_rf(0x18, RFREG_MASK, reg18);
+        self.write_rf(RF_XTALX2, 1 << 19, 0);
+        self.write_rf(RF_XTALX2, 1 << 19, 1);
+    }
+
+    /// `rtw8821c_switch_rf_set`.
+    fn switch_rf_set(&self, set: RfSet) {
+        let c = &self.chip;
+        c.set32(REG_DMEM_CTRL, BIT_WL_RST);
+        c.set32(REG_SYS_CTRL, BIT_FEN_EN);
+        let mut reg = c.r32(REG_RFECTL);
+        match set {
+            RfSet::Btg => {
+                reg |= B_BTG_SWITCH;
+                reg &= !(B_CTRL_SWITCH | B_WL_SWITCH | B_WLG_SWITCH | B_WLA_SWITCH);
+                c.w32_mask(REG_ENRXCCA, MASKBYTE2, BTG_CCA);
+                c.w32_mask(REG_ENTXCCK, MASKLWORD, BTG_LNA);
+            }
+            RfSet::Wlg => {
+                reg |= B_WL_SWITCH | B_WLG_SWITCH;
+                reg &= !(B_BTG_SWITCH | B_CTRL_SWITCH | B_WLA_SWITCH);
+                c.w32_mask(REG_ENRXCCA, MASKBYTE2, WLG_CCA);
+                c.w32_mask(REG_ENTXCCK, MASKLWORD, WLG_LNA);
+            }
+            RfSet::Wla => {
+                reg |= B_WL_SWITCH | B_WLA_SWITCH;
+                reg &= !(B_BTG_SWITCH | B_CTRL_SWITCH | B_WLG_SWITCH);
+            }
+        }
+        c.w32(REG_RFECTL, reg);
+    }
+
+    /// `rtw8821c_coex_cfg_rfe_type`: polarity and the BTG switch.
+    fn coex_rfe_8821c(&self) -> (bool, bool, bool) {
+        let rfe = self.efuse.rfe_option;
+        let wlg_at_btg = matches!(rfe, 2 | 10 | 7 | 15 | 4 | 12);
+        let polarity = matches!(rfe, 3 | 11 | 4 | 12);
+        let exists = !matches!(rfe, 5 | 13 | 6 | 14);
+        (wlg_at_btg, polarity, exists)
+    }
+
+    /// `rtw8821c_coex_cfg_ant_switch`.
+    pub(crate) fn ant_switch_8821c(&self, ctrl: SwitchCtrl, position: Switch) {
+        let (wlg_at_btg, polarity, exists) = self.coex_rfe_8821c();
+        if !exists {
+            return;
+        }
+        let (mut ctrl, mut position) = (ctrl, position);
+        if wlg_at_btg {
+            ctrl = SwitchCtrl::Bbsw;
+            position = if polarity { Switch::Wla } else { Switch::WlgBt };
+        }
+        let c = &self.chip;
+        c.clr32(REG_LED_CFG, BIT_DPDT_SEL_EN);
+        c.set32(REG_LED_CFG, BIT_DPDT_WL_SEL);
+        let value = match ctrl {
+            SwitchCtrl::Bbsw => {
+                c.w8_mask(REG_RFE_CTRL8, BIT_MASK_RFE_SEL89, DPDT_CTRL_PIN);
+                match position {
+                    // WLG and BT together: the shared position, where there is one.
+                    Switch::WlgBt if !matches!(self.efuse.rfe_option, 4 | 2) => 0x3,
+                    Switch::WlgBt | Switch::Wlg => if polarity { 0x1 } else { 0x2 },
+                    Switch::Wla | Switch::Bt => if polarity { 0x2 } else { 0x1 },
+                }
+            }
+            SwitchCtrl::Pta => {
+                c.w8_mask(REG_RFE_CTRL8, BIT_MASK_RFE_SEL89, PTA_CTRL_PIN);
+                if polarity { 0x1 } else { 0x2 }
+            }
+        };
+        c.w32_mask(REG_RFE_CTRL8, BIT_MASK_R_RFE_SEL_15, value);
+        c.set8(REG_CTRL_TYPE, BIT_CTRL_TYPE1);
+        c.set8(REG_CTRL_TYPE, BIT_CTRL_TYPE2);
+    }
+}
diff --git a/kernel/comps/rtw88/src/rtw8822b.rs b/kernel/comps/rtw88/src/rtw8822b.rs
new file mode 100644
index 0000000..3d0b259
--- /dev/null
+++ b/kernel/comps/rtw88/src/rtw8822b.rs
@@ -0,0 +1,376 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! What is the RTL8822B's own (Linux's `rtw8822b.c`): two paths (both used
+//! for TX and RX), its MAC and PHY settings, the TRX mode, the channel (BB,
+//! RF of both paths, the RX DFIR, the CCA of its front end, the RFE pins)
+//! and the coexistence's antenna switch and RFE type.
+
+use crate::{
+    hw::{Hw, RF18_BW_40M, RF18_BW_80M, Switch, SwitchCtrl, Tune},
+    regs::*,
+};
+
+/// The paths in use: A and B for TX and RX (`BB_PATH_AB`).
+const PATHS_AB: u32 = 0x3;
+/// RF 0x18's RFSI bits above channel 80 and above 144 (`rtw8822b.c`'s own).
+const RF18_RFSI_GE_CH80: u32 = 1 << 17;
+const RF18_RFSI_GT_CH144: u32 = 1 << 18;
+/// RF 0xbe's band bits, by 5 GHz channel pair (`low_band`, `middle_band`,
+/// `high_band`).
+const RFBE_MASK: u32 = (1 << 17) | (1 << 16) | (1 << 15);
+const RFBE_LOW: [u8; 15] = [0x7, 0x6, 0x6, 0x5, 0x0, 0x0, 0x7, 0xff, 0x6, 0x5, 0x0, 0x0, 0x7, 0x6, 0x6];
+const RFBE_MIDDLE: [u8; 23] = [0x6, 0x5, 0x0, 0x0, 0x7, 0x6, 0x6, 0xff, 0x0, 0x0, 0x7, 0x6, 0x6, 0x5, 0x0, 0xff, 0x7, 0x6, 0x6, 0x5, 0x0, 0x0, 0x7];
+const RFBE_HIGH: [u8; 15] = [0x5, 0x5, 0x0, 0x7, 0x7, 0x6, 0x5, 0xff, 0x0, 0x7, 0x7, 0x6, 0x5, 0x5, 0x0];
+
+/// The CCA thresholds of a front end (`struct cca_ccut`): 0x82c, 0x830,
+/// 0x838 for one or two RX paths at 2.4 and 5 GHz.
+struct Cca {
+    reg82c: [u32; 4],
+    reg830: [u32; 4],
+    reg838: [u32; 4],
+}
+
+const CCA_IFEM: Cca = Cca {
+    reg82c: [0x75c9_7010, 0x75c9_7010, 0x75c9_7010, 0x75c9_7010],
+    reg830: [0x79a0_eaaa, 0x79a0_eaac, 0x79a0_eaaa, 0x79a0_eaaa],
+    reg838: [0x8776_5541, 0x8774_6341, 0x8776_5541, 0x8774_6341],
+};
+const CCA_EFEM: Cca = Cca {
+    reg82c: [0x75b8_6010, 0x75b7_6010, 0x75b8_6010, 0x75b7_6010],
+    reg830: [0x79a0_eaa8, 0x79a0_eaac, 0x79a0_eaa8, 0x79a0_eaaa],
+    reg838: [0x8776_6451, 0x8776_6431, 0x8776_6451, 0x8776_6431],
+};
+const CCA_IFEM_EXT: Cca = Cca {
+    reg82c: [0x75da_8010, 0x75da_8010, 0x75da_8010, 0x75da_8010],
+    reg830: [0x79a0_eaaa, 0x97a0_eaac, 0x79a0_eaaa, 0x79a0_eaaa],
+    reg838: [0x8776_5541, 0x8666_6341, 0x8776_5561, 0x8666_6361],
+};
+/// The CCA columns for two RX paths (`CCUT_IDX_2R_2G`, `CCUT_IDX_2R_5G`).
+const CCA_2R_2G: usize = 1;
+const CCA_2R_5G: usize = 3;
+
+/// An RFE type's front end (`struct rtw8822b_rfe_info`).
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Fem {
+    /// Internal at 2.4 GHz, external at 5 GHz (RFE 2).
+    Ifem2gEfem5g,
+    /// Internal with the extended CCA (RFE 3 and 5).
+    IfemExt,
+}
+
+impl Hw {
+    fn fem_8822b(&self) -> Fem {
+        if self.efuse.rfe_option == 2 { Fem::Ifem2gEfem5g } else { Fem::IfemExt }
+    }
+
+    /// `rtw8822b_mac_init`.
+    pub(crate) fn mac_init_8822b(&self) {
+        let c = &self.chip;
+        c.clr8(REG_SW_AMPDU_BURST_MODE_CTRL, BIT_PRE_TX_CMD);
+        c.w8(REG_AMPDU_MAX_TIME_V1, WLAN_AMPDU_MAX_TIME as u8);
+        c.set8(REG_TX_HANG_CTRL, BIT_EN_EOF_V1);
+        self.mac_init_common();
+        self.mac_init_edca_wmac();
+        c.w32(REG_WMAC_OPTION_FUNCTION + 8, WLAN_MAC_OPT_FUNC2);
+        c.w8(REG_WMAC_OPTION_FUNCTION + 4, WLAN_MAC_OPT_NORM_FUNC1 as u8);
+        c.set8(REG_SND_PTCL_CTRL, BIT_DIS_CHK_VHTSIGB_CRC);
+    }
+
+    /// `rtw8822b_phy_set_param`.
+    pub(crate) fn phy_set_param_8822b(&mut self) {
+        let c = &self.chip;
+        c.set8(REG_SYS_FUNC_EN, BIT_FEN_BB_RSTB | BIT_FEN_BB_GLB_RST);
+        c.set8(REG_RF_CTRL, BIT_RF_EN | BIT_RF_RSTB | BIT_RF_SDM_RSTB);
+        c.set32(REG_WLRF1, BIT_WLRF1_BBRF_EN);
+        c.clr32(REG_RXPSEL, BIT_RX_PSEL_RST);
+        self.load_tables();
+        self.set_crystal_cap();
+        self.chip.set32(REG_RXPSEL, BIT_RX_PSEL_RST);
+        self.config_trx_mode_8822b(1);
+        // `rtw8822b_phy_rfe_init`.
+        let c = &self.chip;
+        c.w32_mask(0x64, (1 << 29) | (1 << 28), 0x3);
+        c.w32_mask(0x4c, (1 << 26) | (1 << 25), 0x0);
+        c.w32_mask(0x40, 1 << 2, 0x1);
+        c.w32_mask(0x1990, 0x3f, 0x30);
+        c.w32_mask(0x1990, (1 << 11) | (1 << 10), 0x3);
+        c.w32_mask(0x974, 0x3f, 0x3f);
+        c.w32_mask(0x974, (1 << 11) | (1 << 10), 0x3);
+        self.pwrtrack_init();
+        // `rtw8822b_phy_bf_init`.
+        self.phy_bf_init();
+        self.chip.w32(0x1c94, 0xafff_afff);
+    }
+
+    /// `rtw8822b_config_trx_mode` for TX and RX on both paths, then the
+    /// channel's CCA and RFE pins.
+    fn config_trx_mode_8822b(&self, channel: u8) {
+        let c = &self.chip;
+        c.w32_mask(REG_AGCTR_A, MASKLWORD, 0x3231);
+        c.w32_mask(REG_AGCTR_B, MASKLWORD, 0x3231);
+        c.w32_mask(REG_CDDTXP, (1 << 19) | (1 << 18), 0x3);
+        c.w32_mask(REG_TXPSEL, (1 << 29) | (1 << 28), 0x1);
+        c.w32_mask(REG_TXPSEL, 1 << 30, 0x1);
+        c.w32_mask(REG_CDDTXP, 0xfff0_0000, 0x001);
+        c.w32_mask(REG_ADCINI, 0xf000_0000, 0x8);
+        c.w32_mask(REG_TXPSEL1, 0xfff0, 0x43);
+        c.w32_mask(REG_TXPSEL, MASKBYTE0, (PATHS_AB << 4) | PATHS_AB);
+        c.w32_mask(REG_RXDESC, 1 << 22, 0x0);
+        c.w32_mask(REG_RXDESC, 1 << 18, 0x0);
+        c.w32_mask(REG_ADCINI, 0x0f00_0000, 0x0);
+        c.w32_mask(REG_RXPSEL, MASKBYTE0, (PATHS_AB << 4) | PATHS_AB);
+        c.w32_mask(REG_ANTWT, 1 << 16, 0x1);
+        c.w32_mask(REG_HTSTFWT, 1 << 28, 0x1);
+        c.w32_mask(REG_MRC, 1 << 23, 0x1);
+        // The RF mode table of path A.
+        let mut written = false;
+        for _ in 0..100 {
+            self.write_rf(RF_LUTWE, RFREG_MASK, 0x80000);
+            self.write_rf(RF_LUTWA, RFREG_MASK, 0x00001);
+            crate::delay_us(2);
+            if self.read_rf(0x33, RFREG_MASK) == 0x00001 {
+                written = true;
+                break;
+            }
+        }
+        if !written {
+            ostd::warn!("{}: the RF mode table did not take", self.chip.name);
+            return;
+        }
+        self.write_rf(RF_LUTWE, RFREG_MASK, 0x80000);
+        self.write_rf(RF_LUTWA, RFREG_MASK, 0x00001);
+        self.write_rf(RF_LUTWD1, RFREG_MASK, 0x00034);
+        self.write_rf(RF_LUTWD0, RFREG_MASK, 0x4080c);
+        self.write_rf(RF_LUTWE, RFREG_MASK, 0x00000);
+        self.write_rf(RF_LUTWE, RFREG_MASK, 0x00000);
+        self.toggle_igi_8822b();
+        self.set_channel_cca_8822b(channel);
+        self.set_channel_rfe_8822b(channel);
+    }
+
+    /// `rtw8822b_set_channel`.
+    pub(crate) fn set_channel_8822b(&mut self, tune: Tune) {
+        let channel = tune.center;
+        self.set_channel_bb_8822b(tune);
+        self.set_channel_mac(tune);
+        self.set_channel_rf_8822b(tune);
+        // `rtw8822b_set_channel_rxdfir`.
+        let (acbb0, rxfir, txdfir) = match tune.bw {
+            RTW_CHANNEL_WIDTH_40 => (0x1, 0x0, 0x0),
+            RTW_CHANNEL_WIDTH_80 => (0x2, 0x1, 0x0),
+            _ => (0x2, 0x2, 0x1),
+        };
+        let c = &self.chip;
+        c.w32_mask(REG_ACBB0, (1 << 29) | (1 << 28), acbb0);
+        c.w32_mask(REG_ACBBRXFIR, (1 << 29) | (1 << 28), rxfir);
+        self.w32s_mask(REG_TXDFIR, 1 << 31, txdfir);
+        self.toggle_igi_8822b();
+        self.set_channel_cca_8822b(channel);
+        self.set_channel_rfe_8822b(channel);
+    }
+
+    fn set_channel_bb_8822b(&self, tune: Tune) {
+        let channel = tune.center;
+        let c = &self.chip;
+        if channel <= 14 {
+            c.w32_mask(REG_RXPSEL, 1 << 28, 0x1);
+            c.w32_mask(REG_CCK_CHECK, 1 << 7, 0x0);
+            c.w32_mask(REG_ENTXCCK, 1 << 18, 0x0);
+            c.w32_mask(REG_RXCCAMSK, 0x0000_fc00, 15);
+            c.w32_mask(REG_ACGG2TBL, 0x1f, 0x0);
+            c.w32_mask(REG_CLKTRK, 0x1ffe_0000, 0x96a);
+            if channel == 14 {
+                c.w32(REG_TXSF2, 0x0000_6577);
+                c.w32_mask(REG_TXSF6, MASKLWORD, 0x0000);
+            } else {
+                c.w32(REG_TXSF2, 0x384f_6577);
+                c.w32_mask(REG_TXSF6, MASKLWORD, 0x1525);
+            }
+            c.w32_mask(REG_RFEINV, 0x300, 0x2);
+        } else {
+            c.w32_mask(REG_ENTXCCK, 1 << 18, 0x1);
+            c.w32_mask(REG_CCK_CHECK, 1 << 7, 0x1);
+            c.w32_mask(REG_RXPSEL, 1 << 28, 0x0);
+            c.w32_mask(REG_RXCCAMSK, 0x0000_fc00, 34);
+            let table = match channel {
+                36..=64 => 0x1,
+                100..=144 => 0x2,
+                _ => 0x3,
+            };
+            c.w32_mask(REG_ACGG2TBL, 0x1f, table);
+            let track = match channel {
+                36..=48 => 0x494,
+                52..=64 => 0x453,
+                100..=116 => 0x452,
+                _ => 0x412,
+            };
+            c.w32_mask(REG_CLKTRK, 0x1ffe_0000, track);
+            c.w32_mask(0xcbc, 0x300, 0x1);
+        }
+        let pri = tune.pri_idx as u32 & 0xf;
+        let value = match tune.bw {
+            RTW_CHANNEL_WIDTH_40 => {
+                if pri == RTW_SC_20_UPPER {
+                    c.set32(REG_RXSB, 1 << 4);
+                } else {
+                    c.clr32(REG_RXSB, 1 << 4);
+                }
+                (c.r32(REG_ADCCLK) & 0xff3f_f300) | (pri << 2) | RTW_CHANNEL_WIDTH_40
+            }
+            RTW_CHANNEL_WIDTH_80 => (c.r32(REG_ADCCLK) & 0xfcef_cf00) | (pri << 2) | RTW_CHANNEL_WIDTH_80,
+            _ => (c.r32(REG_ADCCLK) & 0xffcf_fc00) | RTW_CHANNEL_WIDTH_20,
+        };
+        c.w32(REG_ADCCLK, value);
+        c.w32_mask(REG_ADC160, 1 << 30, 0x1);
+        if tune.bw == RTW_CHANNEL_WIDTH_80 && matches!(self.efuse.rfe_option, 2 | 3) {
+            c.w32_mask(REG_L1PKWT, 0x0000_f000, 0x6);
+            c.w32_mask(REG_ADC40, 1 << 10, 0x1);
+        }
+    }
+
+    /// `rtw8822b_set_channel_rf`: RF 0x18 of both paths, the band's RF 0xbe.
+    fn set_channel_rf_8822b(&self, tune: Tune) {
+        let channel = tune.center;
+        let mut reg18 = self.read_rf(0x18, RFREG_MASK);
+        reg18 &= !(RF18_BAND_MASK | RF18_CHANNEL_MASK | RF18_RFSI_MASK | RF18_BW_MASK);
+        reg18 |= if channel <= 14 { RF18_BAND_2G } else { RF18_BAND_5G };
+        reg18 |= channel as u32 & RF18_CHANNEL_MASK;
+        if channel > 144 {
+            reg18 |= RF18_RFSI_GT_CH144;
+        } else if channel >= 80 {
+            reg18 |= RF18_RFSI_GE_CH80;
+        }
+        reg18 |= match tune.bw {
+            RTW_CHANNEL_WIDTH_40 => RF18_BW_40M,
+            RTW_CHANNEL_WIDTH_80 => RF18_BW_80M,
+            _ => RF18_BW_20M,
+        };
+        let index = |first: u8| ((channel - first) >> 1) as usize;
+        let reg_be = match channel {
+            ..=14 => 0,
+            36..=64 => RFBE_LOW.get(index(36)).copied().unwrap_or(0) as u32,
+            100..=144 => RFBE_MIDDLE.get(index(100)).copied().unwrap_or(0) as u32,
+            149..=177 => RFBE_HIGH.get(index(149)).copied().unwrap_or(0) as u32,
+            _ => return,
+        };
+        self.write_rf(RF_MALSEL, RFBE_MASK, reg_be);
+        self.write_rf(RF_LUTDBG, 1 << 18, (channel == 144) as u32);
+        self.write_rf(0x18, RFREG_MASK, reg18);
+        if self.paths() > 1 {
+            self.write_rf_path(1, 0x18, RFREG_MASK, reg18);
+        }
+        self.write_rf(RF_XTALX2, 1 << 19, 0);
+        self.write_rf(RF_XTALX2, 1 << 19, 1);
+    }
+
+    /// `rtw8822b_toggle_igi`: the gain nudged and back, the RX paths again.
+    fn toggle_igi_8822b(&self) {
+        let c = &self.chip;
+        let igi = c.r32_mask(REG_RXIGI_A, 0x7f);
+        c.w32_mask(REG_RXIGI_A, 0x7f, igi.wrapping_sub(2) & 0x7f);
+        c.w32_mask(REG_RXIGI_A, 0x7f, igi);
+        c.w32_mask(REG_RXIGI_B, 0x7f, igi.wrapping_sub(2) & 0x7f);
+        c.w32_mask(REG_RXIGI_B, 0x7f, igi);
+        c.w32_mask(REG_RXPSEL, MASKBYTE0, 0x0);
+        c.w32_mask(REG_RXPSEL, MASKBYTE0, PATHS_AB | (PATHS_AB << 4));
+    }
+
+    /// `rtw8822b_set_channel_cca` at 20 MHz with two RX paths.
+    fn set_channel_cca_8822b(&self, channel: u8) {
+        let ghz2 = channel <= 14;
+        let column = if ghz2 { CCA_2R_2G } else { CCA_2R_5G };
+        let fem = self.fem_8822b();
+        let (cca, efem) = match (fem, ghz2) {
+            (Fem::Ifem2gEfem5g, true) => (&CCA_IFEM, false),
+            (Fem::Ifem2gEfem5g, false) => (&CCA_EFEM, true),
+            (Fem::IfemExt, _) => (&CCA_IFEM_EXT, false),
+        };
+        let mut reg830 = cca.reg830[column];
+        if !efem && self.efuse.rfe_option == 5 && column == CCA_2R_5G {
+            reg830 = 0x79a0_ea28;
+        }
+        let c = &self.chip;
+        c.w32(REG_CCASEL, cca.reg82c[column]);
+        c.w32(REG_PDMFTH, reg830);
+        c.w32(REG_CCA2ND, cca.reg838[column]);
+        // The cut B's own threshold stays for an external front end.
+        if efem && self.chip.cut != 1 {
+            c.w32(REG_L1WT, 0x9194_b2b9);
+        }
+        if (52..=144).contains(&channel) {
+            c.w32_mask(REG_CCA2ND, 0xf0, 0x4);
+        }
+    }
+
+    /// The RFE pins of the band (`rtw8822b_set_channel_rfe_efem` and
+    /// `_ifem`), TX and RX on both paths.
+    fn set_channel_rfe_8822b(&self, channel: u8) {
+        let ghz2 = channel <= 14;
+        match self.fem_8822b() {
+            Fem::Ifem2gEfem5g => {
+                if ghz2 {
+                    self.w32s_mask(REG_RFESEL0, 0x00ff_ffff, 0x705770);
+                    self.w32s_mask(REG_RFESEL8, MASKBYTE1, 0x57);
+                    self.w32s_mask(REG_RFECTL, 1 << 4, 0);
+                } else {
+                    self.w32s_mask(REG_RFESEL0, 0x00ff_ffff, 0x177517);
+                    self.w32s_mask(REG_RFESEL8, MASKBYTE1, 0x75);
+                    self.w32s_mask(REG_RFECTL, 1 << 5, 0);
+                }
+                self.w32s_mask(REG_RFEINV, (1 << 11) | (1 << 10) | 0x3f, 0x0);
+                self.w32s_mask(REG_TRSW, MASKLWORD, 0xa501);
+            }
+            Fem::IfemExt => {
+                if ghz2 {
+                    self.w32s_mask(REG_RFESEL0, 0x00ff_ffff, 0x745774);
+                    self.w32s_mask(REG_RFESEL8, MASKBYTE1, 0x57);
+                } else {
+                    self.w32s_mask(REG_RFESEL0, 0x00ff_ffff, 0x477547);
+                    self.w32s_mask(REG_RFESEL8, MASKBYTE1, 0x75);
+                }
+                self.w32s_mask(REG_RFEINV, (1 << 11) | (1 << 10) | 0x3f, 0x0);
+                self.w32s_mask(REG_TRSW, MASKLWORD, if ghz2 { 0xa501 } else { 0xa5a5 });
+            }
+        }
+    }
+
+    /// `rtw8822b_coex_cfg_rfe_type`: the external front end on the score
+    /// board, the RFE control pins to the WLAN.
+    pub(crate) fn coex_rfe_type_8822b(&mut self) {
+        let ext_fem = matches!(self.efuse.rfe_option, 2 | 4);
+        self.write_scbd(COEX_SCBD_EXTFEM as u16, ext_fem);
+        let c = &self.chip;
+        c.w8(REG_RFE_CTRL_E, 0xff);
+        c.w8_mask(REG_RFESEL_CTRL + 1, 0x3, 0x0);
+        c.w8_mask(REG_RFE_INV16, BIT_RFE_BUF_EN, 0x0);
+        c.ltecoex_write_mask(LTE_COEX_CTRL as u16, BIT_LTE_COEX_EN, 0);
+        c.ltecoex_write_mask(LTE_WL_TRX_CTRL as u16, MASKLWORD, 0xffff);
+        c.ltecoex_write_mask(LTE_BT_TRX_CTRL as u16, MASKLWORD, 0xffff);
+    }
+
+    /// `rtw8822b_coex_cfg_ant_switch` (the switch's polarity is normal on
+    /// the RFE types Linux supports).
+    pub(crate) fn ant_switch_8822b(&self, ctrl: SwitchCtrl, position: Switch) {
+        if matches!(self.efuse.rfe_option, 0x12 | 0x15 | 0x16) {
+            return;
+        }
+        let c = &self.chip;
+        c.w8_mask(REG_LED_CFG + 2, BIT_DPDT_SEL_EN >> 16, 0x0);
+        c.w8_mask(REG_LED_CFG + 3, BIT_DPDT_WL_SEL >> 24, 0x1);
+        match ctrl {
+            SwitchCtrl::Bbsw => {
+                c.w8_mask(REG_RFE_CTRL8, BIT_MASK_RFE_SEL89, 0x77);
+                let value = match position {
+                    Switch::WlgBt if !matches!(self.efuse.rfe_option, 4 | 2) => 0x3,
+                    Switch::WlgBt | Switch::Wlg => 0x2,
+                    Switch::Wla | Switch::Bt => 0x1,
+                };
+                c.w8_mask(REG_RFE_INV8, BIT_MASK_RFE_INV89, value);
+            }
+            SwitchCtrl::Pta => {
+                c.w8_mask(REG_RFE_CTRL8, BIT_MASK_RFE_SEL89, 0x66);
+                c.w8_mask(REG_RFE_INV8, BIT_MASK_RFE_INV89, 0x2);
+            }
+        }
+    }
+}
diff --git a/kernel/comps/rtw88/src/rtw8822c.rs b/kernel/comps/rtw88/src/rtw8822c.rs
new file mode 100644
index 0000000..4d1e7a0
--- /dev/null
+++ b/kernel/comps/rtw88/src/rtw8822c.rs
@@ -0,0 +1,943 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! What is the RTL8822C's own (Linux's `rtw8822c.c`): its MAC settings,
+//! the PHY with the DAC calibration (DACK) and the efuse's trims at power
+//! on, the TX and RX paths, the channel, TX power as a reference per path
+//! and differences per rate, the firmware's IQK, the coexistence's setup
+//! and its PHY status.
+
+use alloc::vec::Vec;
+
+use crate::{
+    hw::{Hw, RATE_SECTIONS, RfeTables, Tune},
+    regs::*,
+};
+
+// The MAC's settings (`rtw8822c.c`'s own WLAN_* values).
+const FAST_EDCA_BE_TH: u32 = 0x6;
+const FAST_EDCA_BK_TH: u32 = 0x6;
+const FAST_EDCA_VI_TH: u32 = 0x6;
+const FAST_EDCA_VO_TH: u32 = 0x6;
+const WLAN_ACK_TO: u32 = 0x21;
+const WLAN_ACK_TO_CCK: u32 = 0x6a;
+const WLAN_AMPDU_MAX_TIME: u32 = 0x70;
+const WLAN_BAR_ACK_TYPE: u32 = 0x5;
+const WLAN_BAR_RETRY_LIMIT: u32 = 0x1;
+const WLAN_BCN_CTRL_CLT0: u32 = 0x10;
+const WLAN_BCN_DMA_TIME: u32 = 0x2;
+const WLAN_BCN_MAX_ERR: u32 = 0xff;
+const WLAN_DATA_RATE_FB_CNT_1_4: u32 = 0x0100_0000;
+const WLAN_DATA_RATE_FB_CNT_5_8: u32 = 0x0807_0504;
+const WLAN_DATA_RATE_FB_RATE0: u32 = 0xfe01_f010;
+const WLAN_DATA_RATE_FB_RATE0_H: u32 = 0x4000_0000;
+const WLAN_DRV_EARLY_INT: u32 = 0x4;
+const WLAN_EDCA_BE_PARAM: u32 = 0x005e_a42b;
+const WLAN_EDCA_BK_PARAM: u32 = 0x0000_a44f;
+const WLAN_EDCA_VI_PARAM: u32 = 0x005e_a328;
+const WLAN_EDCA_VO_PARAM: u32 = 0x002f_a226;
+const WLAN_EIFS_DUR_TUNE: u32 = 0x40;
+const WLAN_MAC_INT_MIG_CFG: u32 = 0x3333_0000;
+const WLAN_MAC_OPT_FUNC2: u32 = 0xb081_0041;
+const WLAN_MAC_OPT_NORM_FUNC1: u32 = 0x98;
+const WLAN_MAX_AGG_PKT_LIMIT: u32 = 0x3f;
+const WLAN_MULTI_ADDR: u32 = 0xffff_ffff;
+const WLAN_NAV_CFG: u32 = 0x001b_0005;
+const WLAN_NAV_MAX: u32 = 0xc8;
+const WLAN_PIFS_TIME: u32 = 0x1c;
+const WLAN_PRE_TXCNT_TIME_TH: u32 = 0x1e0;
+const WLAN_RA_TRY_RATE_AGG_LIMIT: u32 = 0x8;
+const WLAN_RCR_CFG: u32 = 0xe400_220e;
+const WLAN_RESP_TXRATE: u32 = 0x84;
+const WLAN_RTS_LEN_TH: u32 = 0xff;
+const WLAN_RTS_MAX_AGG_PKT_LIMIT: u32 = 0x3f;
+const WLAN_RTS_RATE_FB_CNT_5_8: u32 = 0x0807_0504;
+const WLAN_RTS_RATE_FB_RATE1: u32 = 0x003f_f010;
+const WLAN_RTS_RATE_FB_RATE1_H: u32 = 0x4000_0000;
+const WLAN_RTS_RATE_FB_RATE4: u32 = 0x0600_f010;
+const WLAN_RTS_RATE_FB_RATE4_H: u32 = 0x4000_03e0;
+const WLAN_RTS_RATE_FB_RATE5: u32 = 0x0600_f015;
+const WLAN_RTS_RATE_FB_RATE5_H: u32 = 0x0000_00e0;
+const WLAN_RTS_TX_TIME_TH: u32 = 0x8;
+const WLAN_RXPKT_MAX_SZ_512: u32 = 0x18;
+const WLAN_RX_FILTER0: u32 = 0xffff_ffff;
+const WLAN_RX_FILTER2: u32 = 0xffff;
+const WLAN_RX_TSF_CFG: u32 = 0x3030;
+const WLAN_SIFS_CCK_CTX: u32 = 0xa;
+const WLAN_SIFS_CCK_IRX: u32 = 0xa;
+const WLAN_SIFS_CFG: u32 = 0x100a_0e0a;
+const WLAN_SIFS_DUR_TUNE: u32 = 0x100a;
+const WLAN_SIFS_OFDM_CTX: u32 = 0xe;
+const WLAN_SIFS_OFDM_IRX: u32 = 0xe;
+const WLAN_SLOT_TIME: u32 = 0x9;
+const WLAN_TBTT_TIME: u32 = 0x6404;
+const WLAN_TXQ_RPT_EN: u32 = 0x1f;
+const WLAN_TX_FUNC_CFG1: u32 = 0x30;
+const WLAN_TX_FUNC_CFG2: u32 = 0x30;
+/// The RX packet filter's FIFO thresholds, one each for VHT, HT, OFDM and
+/// CCK (`BIT_RXGCK_*_FIFOTHR(1)`), in the register's upper half.
+const RXGCK_FIFOTHR_1: u16 = 0x0550;
+/// `BIT_SET_RXPSF_PKTLENTHR(0, 1)` and the error threshold of 7.
+const RXPSF_PKTLENTHR_1: u16 = 1 << 13;
+const RXPSF_ERRTHR_7: u16 = 0x7;
+
+/// RF 0x18 of this chip (`rtw8822c_set_channel_rf`'s own).
+const RF18_BAND_MASK: u32 = (1 << 16) | (1 << 9) | (1 << 8);
+const RF18_BAND_5G: u32 = (1 << 16) | (1 << 8);
+const RF18_CHANNEL_MASK: u32 = 0xff;
+const RF18_RFSI_MASK: u32 = (1 << 18) | (1 << 17);
+const RF18_RFSI_GE_CH80: u32 = 1 << 17;
+const RF18_RFSI_GT_CH140: u32 = 1 << 18;
+const RF18_BW_MASK: u32 = (1 << 13) | (1 << 12);
+const RF18_BW_20M: u32 = (1 << 13) | (1 << 12);
+const RF18_BW_40M: u32 = 1 << 13;
+const RF18_BW_80M: u32 = 1 << 12;
+/// The RX baseband filter by width.
+const RXBB_20M: u32 = 0x18;
+const RXBB_40M: u32 = 0x10;
+const RXBB_80M: u32 = 0x8;
+/// The firmware's IQK is done (`IQK_DONE_8822C` in `REG_RPT_CIP`).
+const IQK_DONE: u8 = 0xaa;
+/// Where each path's TX power references are (`txref_cck`, `txref_ofdm`).
+const TXREF_CCK: [u32; 2] = [0x18a0, 0x41a0];
+const TXREF_OFDM: [u32; 2] = [0x18e8, 0x41e8];
+/// The TX power differences (`offset_txagc`).
+const TXAGC_DIFF: u32 = 0x3a00;
+/// The DAC calibration: the samples, the registers it changes, each
+/// path's write and read windows.
+const DACK_SAMPLES: usize = 100;
+const DACK_REGS: [u32; 16] = [0x180c, 0x1810, 0x410c, 0x4110, 0x1c3c, 0x1c24, 0x1d70, 0x9b4, 0x1a00, 0x1a14, 0x1d58, 0x1c38, 0x1e24, 0x1e28, 0x1860, 0x4160];
+const DACK_WRITE: [u32; 2] = [0x1800, 0x4100];
+const DACK_READ: [u32; 2] = [0x2800, 0x4500];
+/// The efuse can't be read there (`EFUSE_READ_FAIL`).
+const EFUSE_EMPTY: u8 = 0xff;
+
+/// Whether an IQ sample is close enough to zero to count.
+fn dack_sample_ok(value: u32) -> bool {
+    !((value >= 0x200 && 0x400 - value > 0x64) || (value < 0x200 && value > 0x64))
+}
+
+/// The smallest and largest of 10-bit two's complement values
+/// (`rtw8822c_rf_minmax_cmp`).
+fn dack_minmax(value: u32, min: &mut u32, max: &mut u32) {
+    if value >= 0x200 {
+        if *min >= 0x200 {
+            if *min > value {
+                *min = value;
+            }
+        } else {
+            *min = value;
+        }
+        if *max >= 0x200 && *max < value {
+            *max = value;
+        }
+    } else {
+        if *min < 0x200 && *min > value {
+            *min = value;
+        }
+        if *max >= 0x200 || *max < value {
+            *max = value;
+        }
+    }
+}
+
+/// The span between the smallest and largest.
+fn dack_delta(min: u32, max: u32) -> u32 {
+    if (max < 0x200 && min < 0x200) || (max >= 0x200 && min >= 0x200) { max.wrapping_sub(min) } else { max + (0x400 - min) }
+}
+
+/// Sorted as 10-bit two's complement values (`rtw8822c_dac_iq_sort`).
+fn dack_sort(values: &mut [u32]) {
+    let n = values.len();
+    for i in 0..n.saturating_sub(1) {
+        for j in 0..n - 1 - i {
+            let (a, b) = (values[j], values[j + 1]);
+            let swap = if (a >= 0x200) == (b >= 0x200) { a > b } else { a < 0x200 && b >= 0x200 };
+            if swap {
+                values.swap(j, j + 1);
+            }
+        }
+    }
+}
+
+/// The mean of the middle samples as a 10-bit offset
+/// (`rtw8822c_dac_iq_offset`).
+fn dack_offset(values: &[u32]) -> u32 {
+    let (mut plus, mut minus) = (0u32, 0u32);
+    for &value in &values[10..DACK_SAMPLES - 10] {
+        if value > 0x200 {
+            minus += 0x400 - value;
+        } else {
+            plus += value;
+        }
+    }
+    let count = (DACK_SAMPLES - 20) as u32;
+    if plus > minus {
+        (plus - minus) / count
+    } else {
+        let t = (minus - plus) / count;
+        if t != 0 { 0x400 - t } else { 0 }
+    }
+}
+
+impl Hw {
+    /// `rtw8822c_mac_init`.
+    pub(crate) fn mac_init_8822c(&self) {
+        let c = &self.chip;
+        // Protocol settings.
+        let txq = (c.r8(REG_FWHW_TXQ_CTRL) | 0x80) & !0x06;
+        c.w8(REG_FWHW_TXQ_CTRL, txq);
+        c.w8(REG_FWHW_TXQ_CTRL + 1, WLAN_TXQ_RPT_EN as u8);
+        c.w16(REG_SPEC_SIFS, WLAN_SIFS_DUR_TUNE as u16);
+        c.w32(REG_SIFS, WLAN_SIFS_CFG);
+        c.w16(REG_RESP_SIFS_CCK, (WLAN_SIFS_CCK_CTX | (WLAN_SIFS_CCK_IRX << 8)) as u16);
+        c.w16(REG_RESP_SIFS_OFDM, (WLAN_SIFS_OFDM_CTX | (WLAN_SIFS_OFDM_IRX << 8)) as u16);
+        c.w32(REG_DARFRC, WLAN_DATA_RATE_FB_CNT_1_4);
+        c.w32(REG_DARFRCH, WLAN_DATA_RATE_FB_CNT_5_8);
+        c.w32(REG_RARFRCH, WLAN_RTS_RATE_FB_CNT_5_8);
+        c.w32(REG_ARFR0, WLAN_DATA_RATE_FB_RATE0);
+        c.w32(REG_ARFRH0, WLAN_DATA_RATE_FB_RATE0_H);
+        c.w32(REG_ARFR1_V1, WLAN_RTS_RATE_FB_RATE1);
+        c.w32(REG_ARFRH1_V1, WLAN_RTS_RATE_FB_RATE1_H);
+        c.w32(REG_ARFR4, WLAN_RTS_RATE_FB_RATE4);
+        c.w32(REG_ARFRH4, WLAN_RTS_RATE_FB_RATE4_H);
+        c.w32(REG_ARFR5, WLAN_RTS_RATE_FB_RATE5);
+        c.w32(REG_ARFRH5, WLAN_RTS_RATE_FB_RATE5_H);
+        c.w8(REG_AMPDU_MAX_TIME_V1, WLAN_AMPDU_MAX_TIME as u8);
+        c.set8(REG_TX_HANG_CTRL, BIT_EN_EOF_V1);
+        let pre_txcnt = WLAN_PRE_TXCNT_TIME_TH | BIT_EN_PRECNT;
+        c.w8(REG_PRECNT_CTRL, pre_txcnt as u8);
+        c.w8(REG_PRECNT_CTRL + 1, (pre_txcnt >> 8) as u8);
+        c.w32(REG_PROT_MODE_CTRL, WLAN_RTS_LEN_TH | (WLAN_RTS_TX_TIME_TH << 8) | (WLAN_MAX_AGG_PKT_LIMIT << 16) | (WLAN_RTS_MAX_AGG_PKT_LIMIT << 24));
+        c.w16(REG_BAR_MODE_CTRL + 2, (WLAN_BAR_RETRY_LIMIT | (WLAN_RA_TRY_RATE_AGG_LIMIT << 8)) as u16);
+        c.w8(REG_FAST_EDCA_VOVI_SETTING, FAST_EDCA_VO_TH as u8);
+        c.w8(REG_FAST_EDCA_VOVI_SETTING + 2, FAST_EDCA_VI_TH as u8);
+        c.w8(REG_FAST_EDCA_BEBK_SETTING, FAST_EDCA_BE_TH as u8);
+        c.w8(REG_FAST_EDCA_BEBK_SETTING + 2, FAST_EDCA_BK_TH as u8);
+        c.clr8(REG_LIFETIME_EN, BIT_BA_PARSER_EN);
+        c.clr32(REG_RRSR, BITS_RRSR_RSC);
+        // EDCA.
+        c.w32(REG_EDCA_VO_PARAM, WLAN_EDCA_VO_PARAM);
+        c.w32(REG_EDCA_VI_PARAM, WLAN_EDCA_VI_PARAM);
+        c.w32(REG_EDCA_BE_PARAM, WLAN_EDCA_BE_PARAM);
+        c.w32(REG_EDCA_BK_PARAM, WLAN_EDCA_BK_PARAM);
+        c.w8(REG_PIFS, WLAN_PIFS_TIME as u8);
+        c.clr8(REG_TX_PTCL_CTRL + 1, BIT_SIFS_BK_EN >> 8);
+        c.set8(REG_RD_CTRL + 1, (BIT_DIS_TXOP_CFE | BIT_DIS_LSIG_CFE | BIT_DIS_STBC_CFE) >> 8);
+        c.clr32(REG_AFE_CTRL1, BIT_MAC_CLK_SEL);
+        c.w8(REG_USTIME_TSF, MAC_CLK_SPEED as u8);
+        c.w8(REG_USTIME_EDCA, MAC_CLK_SPEED as u8);
+        c.set8(REG_MISC_CTRL, BIT_EN_FREE_CNT | BIT_DIS_SECOND_CCA);
+        c.clr8(REG_TIMER0_SRC_SEL, BIT_TSFT_SEL_TIMER0);
+        c.w16(REG_TXPAUSE, 0);
+        c.w8(REG_SLOT, WLAN_SLOT_TIME as u8);
+        c.w32(REG_RD_NAV_NXT, WLAN_NAV_CFG);
+        c.w16(REG_RXTSF_OFFSET_CCK, WLAN_RX_TSF_CFG as u16);
+        // Beacons.
+        c.set8(REG_BCN_CTRL, BIT_EN_BCN_FUNCTION);
+        c.w32(REG_TBTT_PROHIBIT, WLAN_TBTT_TIME);
+        c.w8(REG_DRVERLYINT, WLAN_DRV_EARLY_INT as u8);
+        c.w8(REG_BCN_CTRL_CLINT0, WLAN_BCN_CTRL_CLT0 as u8);
+        c.w8(REG_BCNDMATIM, WLAN_BCN_DMA_TIME as u8);
+        c.w8(REG_BCN_MAX_ERR, WLAN_BCN_MAX_ERR as u8);
+        // The WMAC.
+        c.w32(REG_MAR, WLAN_MULTI_ADDR);
+        c.w32(REG_MAR + 4, WLAN_MULTI_ADDR);
+        c.w8(REG_BBPSF_CTRL + 2, WLAN_RESP_TXRATE as u8);
+        c.w8(REG_ACKTO, WLAN_ACK_TO as u8);
+        c.w8(REG_ACKTO_CCK, WLAN_ACK_TO_CCK as u8);
+        c.w16(REG_EIFS, WLAN_EIFS_DUR_TUNE as u16);
+        c.w8(REG_NAV_CTRL + 2, WLAN_NAV_MAX as u8);
+        c.w8(REG_WMAC_TRXPTCL_CTL_H + 2, WLAN_BAR_ACK_TYPE as u8);
+        c.w32(REG_RXFLTMAP0, WLAN_RX_FILTER0);
+        c.w16(REG_RXFLTMAP2, WLAN_RX_FILTER2 as u16);
+        c.w32(REG_RCR, WLAN_RCR_CFG);
+        c.w8(REG_RX_PKT_LIMIT, WLAN_RXPKT_MAX_SZ_512 as u8);
+        c.w8(REG_TCR + 2, WLAN_TX_FUNC_CFG2 as u8);
+        c.w8(REG_TCR + 1, WLAN_TX_FUNC_CFG1 as u8);
+        c.set32(REG_GENERAL_OPTION, BIT_DUMMY_FCS_READY_MASK_EN);
+        c.w32(REG_WMAC_OPTION_FUNCTION + 8, WLAN_MAC_OPT_FUNC2);
+        c.w8(REG_WMAC_OPTION_FUNCTION_1, WLAN_MAC_OPT_NORM_FUNC1 as u8);
+        // The RX packet filter.
+        let value = (c.r16(REG_RXPSF_CTRL + 2) & 0xf00f) | RXGCK_FIFOTHR_1;
+        c.w16(REG_RXPSF_CTRL + 2, value);
+        let value = RXPSF_PKTLENTHR_1 | (BIT_RXPSF_CTRLEN | BIT_RXPSF_VHTCHKEN | BIT_RXPSF_HTCHKEN | BIT_RXPSF_OFDMCHKEN | BIT_RXPSF_CCKCHKEN | BIT_RXPSF_OFDMRST) as u16;
+        c.w16(REG_RXPSF_CTRL, value);
+        c.w32(REG_RXPSF_TYPE_CTRL, 0xffff_ffff);
+        let value = c.r16(REG_RXPSF_CTRL) & !((BIT_RXPSF_MHCHKEN | BIT_RXPSF_CCKRST | BIT_RXPSF_CONT_ERRCHKEN) as u16);
+        c.w16(REG_RXPSF_CTRL, (value & !0x7) | RXPSF_ERRTHR_7);
+        c.set8(REG_SND_PTCL_CTRL, BIT_DIS_CHK_VHTSIGB_CRC);
+        c.w32(REG_INT_MIG, WLAN_MAC_INT_MIG_CFG);
+    }
+
+    /// `rtw8822c_header_file_init`: the 3-wire interfaces on, CCK and OFDM
+    /// blocks off around the tables.
+    fn header_file_init_8822c(&self, pre: bool) {
+        let c = &self.chip;
+        c.set32(REG_3WIRE, BIT_3WIRE_TX_EN | BIT_3WIRE_RX_EN);
+        c.set32(REG_3WIRE, BIT_3WIRE_PI_ON);
+        c.set32(REG_3WIRE2, BIT_3WIRE_TX_EN | BIT_3WIRE_RX_EN);
+        c.set32(REG_3WIRE2, BIT_3WIRE_PI_ON);
+        if pre {
+            c.clr32(REG_ENCCK, BIT_CCK_OFDM_BLK_EN);
+        } else {
+            c.set32(REG_ENCCK, BIT_CCK_OFDM_BLK_EN);
+        }
+    }
+
+    /// `rtw8822c_bb_reset`.
+    fn bb_reset_8822c(&self) {
+        let c = &self.chip;
+        c.set16(REG_SYS_FUNC_EN, BIT_FEN_BB_RSTB);
+        c.w16(REG_SYS_FUNC_EN, c.r16(REG_SYS_FUNC_EN) & !(BIT_FEN_BB_RSTB as u16));
+        c.set16(REG_SYS_FUNC_EN, BIT_FEN_BB_RSTB);
+    }
+
+    /// `rtw8822c_phy_set_param`.
+    pub(crate) fn phy_set_param_8822c(&mut self) {
+        let c = &self.chip;
+        c.set8(REG_SYS_FUNC_EN, BIT_FEN_BB_GLB_RST | BIT_FEN_BB_RSTB);
+        c.set8(REG_RF_CTRL, BIT_RF_EN | BIT_RF_RSTB | BIT_RF_SDM_RSTB);
+        c.set32(REG_WLRF1, BIT_WLRF1_BBRF_EN);
+        c.w32_mask(REG_DIS_DPD, DIS_DPD_MASK, DIS_DPD_RATEALL);
+        self.header_file_init_8822c(true);
+        self.load_tables();
+        let crystal = (self.efuse.crystal_cap & 0x7f) as u32;
+        self.chip.w32_mask(REG_ANAPAR_XTAL_0, 0x00ff_fc00, crystal | (crystal << 7));
+        self.header_file_init_8822c(false);
+        self.config_trx_mode_8822c();
+        // The CCK gain's bounds for the PHY status (`cck_gi_u_bnd`, `_l_bnd`).
+        let c = &self.chip;
+        let upper = ((c.r32_mask(0x1a98, 0xc000) as u8) << 4) | c.r32_mask(0x1aa8, 0xf0000) as u8;
+        let lower = ((c.r32_mask(0x1a98, 0xc0) as u8) << 4) | c.r32_mask(0x1a70, 0x0f00_0000) as u8;
+        self.cck_gain_bounds = (lower, upper);
+        // `rtw8822c_rf_init`.
+        self.dac_cal_8822c();
+        self.rf_x2_check_8822c();
+        self.thermal_trim_8822c();
+        self.power_trim_8822c();
+        self.pa_bias_8822c();
+        self.phy_bf_init();
+    }
+
+    /// `rtw8822c_config_trx_mode` for TX and RX on both paths, one-stream
+    /// and CCK TX on path A.
+    fn config_trx_mode_8822c(&self) {
+        let c = &self.chip;
+        c.w32_mask(REG_ORITXCODE, MASK20BITS, 0x33312);
+        c.w32_mask(REG_ORITXCODE2, MASK20BITS, 0x33312);
+        // RX on A and B: CCK, then OFDM.
+        c.w32_mask(REG_CCANRX, 0x0060_0000, 0x1);
+        c.w32_mask(REG_CCANRX, 0x0006_0000, 0x1);
+        c.w32_mask(REG_RXCCKSEL, 0x0f00_0000, 0x1);
+        c.w32_mask(REG_RXFNCTL, 0x300, 0x1);
+        c.w32_mask(REG_RXFNCTL, 0x60_0000, 0x1);
+        c.w32_mask(REG_AGCSWSH, 1 << 17, 0x1);
+        c.w32_mask(REG_ANTWTPD, 1 << 20, 0x1);
+        c.w32_mask(REG_MRCM, 1 << 24, 0x1);
+        c.w32_mask(0x824, 0x0f00_0000, 0x3);
+        c.w32_mask(0x824, 0x000f_0000, 0x3);
+        // TX: CCK on A, OFDM on both with one stream on A.
+        c.w32_mask(REG_RXCCKSEL, 0xf000_0000, 0x8);
+        self.bb_reset_8822c();
+        c.w32_mask(REG_ANTMAP0, 0xff, 0x31);
+        c.w32_mask(REG_TXLGMAP, 0xffff, 0x0400);
+        self.bb_reset_8822c();
+        self.bb_reset_8822c();
+        self.toggle_igi_8822c();
+    }
+
+    /// `rtw8822c_toggle_igi`.
+    fn toggle_igi_8822c(&self) {
+        let c = &self.chip;
+        let igi = c.r32_mask(REG_RXIGI, 0x7f);
+        let lower = igi.wrapping_sub(2) & 0x7f;
+        c.w32_mask(REG_RXIGI, 0x7f, lower);
+        c.w32_mask(REG_RXIGI, 0x7f00, lower);
+        c.w32_mask(REG_RXIGI, 0x7f, igi);
+        c.w32_mask(REG_RXIGI, 0x7f00, igi);
+    }
+
+    /// `rtw8822c_set_channel`.
+    pub(crate) fn set_channel_8822c(&mut self, tune: Tune) {
+        self.set_channel_bb_8822c(tune);
+        self.set_channel_mac(tune);
+        self.set_channel_rf_8822c(tune);
+        self.toggle_igi_8822c();
+    }
+
+    fn set_channel_bb_8822c(&self, tune: Tune) {
+        let channel = tune.center;
+        let c = &self.chip;
+        if channel <= 14 {
+            c.clr32(REG_BGCTRL, BITS_RX_IQ_WEIGHT);
+            c.set32(REG_TXF4, 1 << 20);
+            c.clr32(REG_CCK_CHECK, BIT_CHECK_CCK_EN);
+            c.clr32(REG_CCKTXONLY, BIT_BB_CCK_CHECK_EN);
+            c.w32_mask(REG_CCAMSK, 0x3f00_0000, 0xf);
+            c.w32_mask(REG_RXAGCCTL0, BITS_RXAGC_CCK, 0x5);
+            c.w32_mask(REG_RXAGCCTL, BITS_RXAGC_CCK, 0x5);
+            c.w32_mask(REG_RXAGCCTL0, BITS_RXAGC_OFDM, 0x6);
+            c.w32_mask(REG_RXAGCCTL, BITS_RXAGC_OFDM, 0x6);
+            let track = match channel {
+                13 | 14 => 0x969,
+                11 | 12 => 0x96a,
+                _ => 0x9aa,
+            };
+            c.w32_mask(REG_SCOTRK, 0xfff, track);
+            // The CCK TX filter; channel 14 (Japan) has its own.
+            let filter: [u32; 8] = if channel == 14 {
+                [0x3da0, 0x4962_c931, 0x6aa3, 0xaa7b, 0xf3d7, 0x0, 0xff01_2455, 0xffff]
+            } else {
+                [0x5284, 0x3e18_fec8, 0x0a88, 0xacc4, 0xc8b2, 0x00fa_f0de, 0x0012_2344, 0x0fff_ffff]
+            };
+            c.w32_mask(REG_TXF0, MASKHWORD, filter[0]);
+            c.w32(REG_TXF1, filter[1]);
+            c.w32_mask(REG_TXF2, MASKLWORD, filter[2]);
+            c.w32_mask(REG_TXF3, MASKHWORD, filter[3]);
+            c.w32_mask(REG_TXF4, MASKLWORD, filter[4]);
+            c.w32(REG_TXF5, filter[5]);
+            c.w32(REG_TXF6, filter[6]);
+            c.w32(REG_TXF7, filter[7]);
+            c.w32_mask(REG_TXDFIR0, 0x70, if channel == 13 { 0x3 } else { 0x1 });
+        } else {
+            c.set32(REG_CCKTXONLY, BIT_BB_CCK_CHECK_EN);
+            c.set32(REG_CCK_CHECK, BIT_CHECK_CCK_EN);
+            c.set32(REG_BGCTRL, BITS_RX_IQ_WEIGHT);
+            c.clr32(REG_TXF4, 1 << 20);
+            c.w32_mask(REG_CCAMSK, 0x3f00_0000, 0x22);
+            c.w32_mask(REG_TXDFIR0, 0x70, 0x3);
+            let agc = match channel {
+                36..=64 => 0x1,
+                100..=144 => 0x2,
+                _ => 0x3,
+            };
+            c.w32_mask(REG_RXAGCCTL0, BITS_RXAGC_OFDM, agc);
+            c.w32_mask(REG_RXAGCCTL, BITS_RXAGC_OFDM, agc);
+            let track = match channel {
+                36..=51 => 0x494,
+                52..=55 => 0x493,
+                56..=111 => 0x453,
+                112..=119 => 0x452,
+                120..=172 => 0x412,
+                _ => 0x411,
+            };
+            c.w32_mask(REG_SCOTRK, 0xfff, track);
+        }
+        let pri = tune.pri_idx as u32;
+        match tune.bw {
+            RTW_CHANNEL_WIDTH_40 => {
+                c.w32_mask(REG_CCKSB, 1 << 4, (pri == RTW_SC_20_UPPER) as u32);
+                c.w32_mask(REG_TXBWCTL, 0xf, 0x5);
+                c.w32_mask(REG_TXBWCTL, 0xc0, 0x0);
+                c.w32_mask(REG_TXBWCTL, 0xff00, pri | (pri << 4));
+                c.w32_mask(REG_CCK_SOURCE, BIT_NBI_EN, 0x1);
+                c.w32_mask(REG_SBD, BITS_SUBTUNE, 0x1);
+                c.w32_mask(REG_PT_CHSMO, BIT_PT_OPT, 0x1);
+            }
+            RTW_CHANNEL_WIDTH_80 => {
+                c.w32_mask(REG_TXBWCTL, 0xf, 0xa);
+                c.w32_mask(REG_TXBWCTL, 0xc0, 0x0);
+                c.w32_mask(REG_TXBWCTL, 0xff00, pri | (pri << 4));
+                c.w32_mask(REG_SBD, BITS_SUBTUNE, 0x6);
+                c.w32_mask(REG_PT_CHSMO, BIT_PT_OPT, 0x1);
+            }
+            _ => {
+                c.w32_mask(REG_DFIRBW, 0x3ff0, 0x19b);
+                c.w32_mask(REG_TXBWCTL, 0xf, 0x0);
+                c.w32_mask(REG_TXBWCTL, 0xffc0, 0x0);
+                c.w32_mask(REG_TXCLK, 0x700, 0x7);
+                c.w32_mask(REG_TXCLK, 0x70_0000, 0x6);
+                c.w32_mask(REG_CCK_SOURCE, BIT_NBI_EN, 0x0);
+                c.w32_mask(REG_SBD, BITS_SUBTUNE, 0x1);
+                c.w32_mask(REG_PT_CHSMO, BIT_PT_OPT, 0x0);
+            }
+        }
+    }
+
+    /// `rtw8822c_rstb_3wire`.
+    fn rstb_3wire_8822c(&self, enable: bool) {
+        let c = &self.chip;
+        c.w32_mask(REG_RSTB, BIT_RSTB_3WIRE, enable as u32);
+        if enable {
+            c.w32_mask(REG_ANAPAR_A, BIT_ANAPAR_UPDATE, 0x1);
+            c.w32_mask(REG_ANAPAR_B, BIT_ANAPAR_UPDATE, 0x1);
+        }
+    }
+
+    /// `rtw8822c_set_channel_rf`: both paths' RX filter and RF 0x18.
+    fn set_channel_rf_8822c(&self, tune: Tune) {
+        let channel = tune.center;
+        let mut reg18 = self.read_rf(0x18, RFREG_MASK);
+        reg18 &= !(RF18_BAND_MASK | RF18_CHANNEL_MASK | RF18_RFSI_MASK | RF18_BW_MASK);
+        if channel > 14 {
+            reg18 |= RF18_BAND_5G;
+        }
+        reg18 |= channel as u32 & RF18_CHANNEL_MASK;
+        if (149..=177).contains(&channel) {
+            reg18 |= RF18_RFSI_GT_CH140;
+        } else if (100..=144).contains(&channel) {
+            reg18 |= RF18_RFSI_GE_CH80;
+        }
+        let (bw, rxbb) = match tune.bw {
+            RTW_CHANNEL_WIDTH_40 => (RF18_BW_40M, RXBB_40M),
+            RTW_CHANNEL_WIDTH_80 => (RF18_BW_80M, RXBB_80M),
+            _ => (RF18_BW_20M, RXBB_20M),
+        };
+        reg18 |= bw;
+        self.rstb_3wire_8822c(false);
+        for path in 0..2 {
+            self.write_rf_path(path, RF_LUTWE2, 0x04, 0x01);
+            self.write_rf_path(path, RF_LUTWA, 0x1f, 0x12);
+            self.write_rf_path(path, RF_LUTWD0, 0xfffff, rxbb);
+            self.write_rf_path(path, RF_LUTWE2, 0x04, 0x00);
+        }
+        self.write_rf_path(0, RF_CFGCH, RFREG_MASK, reg18);
+        self.write_rf_path(1, RF_CFGCH, RFREG_MASK, reg18);
+        self.rstb_3wire_8822c(true);
+    }
+
+    /// `rtw8822c_set_tx_power_index`: each path's reference for CCK (11M)
+    /// and OFDM (MCS 7), then per rate the smaller of the two paths'
+    /// differences from it.
+    pub(crate) fn set_tx_power_8822c(&self, tables: &RfeTables, channel: u8) {
+        let c = &self.chip;
+        let index = |path: usize, rate: u8, section: usize| self.power_index(tables, path, channel, rate, section) as i32;
+        let cck = [index(0, 0x03, 0), index(1, 0x03, 0)];
+        let ofdm = [index(0, 0x13, 2), index(1, 0x13, 2)];
+        for path in 0..2 {
+            c.w32_mask(0x1c90, 1 << 15, 0);
+            c.w32_mask(TXREF_CCK[path], 0x7f_0000, cck[path] as u32);
+        }
+        for path in 0..2 {
+            c.w32_mask(0x1c90, 1 << 15, 0);
+            c.w32_mask(TXREF_OFDM[path], 0x1_fc00, ofdm[path] as u32);
+        }
+        for (section, rates) in RATE_SECTIONS {
+            if channel > 14 && section == 0 {
+                continue;
+            }
+            let reference = if section == 0 { cck } else { ofdm };
+            let mut word = 0u32;
+            for rate in rates {
+                let diff = (index(0, rate, section) - reference[0]).min(index(1, rate, section) - reference[1]);
+                word |= ((diff as u32) & 0x7f) << ((rate % 4) * 8);
+                if rate % 4 == 3 {
+                    c.w32_mask(0x1c90, 1 << 15, 0);
+                    c.w32(TXAGC_DIFF + (rate & 0xfc) as u32, word);
+                    word = 0;
+                }
+            }
+        }
+    }
+
+    /// `rtw8822c_do_iqk` by the firmware, with the calibrations' power
+    /// saving off around it (`rtw8822c_rfk_power_save`).
+    pub(crate) fn do_iqk_8822c(&mut self) {
+        self.rfk_power_save_8822c(false);
+        // `rtw_fw_do_iqk` with `clear`.
+        self.h2c_packet(H2C_PKT_IQK as u8, &[0x01]);
+        let mut done = false;
+        for _ in 0..16 {
+            if self.chip.r8(REG_RPT_CIP) == IQK_DONE {
+                done = true;
+                break;
+            }
+            crate::sleep_ms(20);
+        }
+        if !done {
+            ostd::warn!("{}: the firmware's IQK did not end", self.chip.name);
+        }
+        self.chip.w8(REG_IQKSTAT, 0);
+        self.rfk_power_save_8822c(true);
+    }
+
+    fn rfk_power_save_8822c(&self, save: bool) {
+        for path in 0..2u32 {
+            self.chip.w32_mask(REG_NCTL0, BIT_SEL_PATH, path);
+            self.chip.w32_mask(REG_DPD_CTL1_S0, BIT_PS_EN, !save as u32);
+        }
+    }
+
+    /// `rtw8822c_coex_cfg_rfe_type`: the LTE coexistence off.
+    pub(crate) fn coex_rfe_type_8822c(&self) {
+        let c = &self.chip;
+        c.ltecoex_write_mask(LTE_COEX_CTRL as u16, BIT_LTE_COEX_EN, 0);
+        c.ltecoex_write_mask(LTE_WL_TRX_CTRL as u16, MASKLWORD, 0xffff);
+        c.ltecoex_write_mask(LTE_BT_TRX_CTRL as u16, MASKLWORD, 0xffff);
+    }
+
+    /// The end of `rtw8822c_coex_cfg_init`: BT CCA off, path B's RF mode.
+    pub(crate) fn coex_cfg_init_8822c(&self) {
+        self.chip.clr8(REG_DUMMY_PAGE4_V1, BIT_BTCCA_CTRL);
+        self.write_rf_path(1, RF_MODOPT, 0xfffff, 0x40000);
+    }
+
+    /// `query_phy_status_page0/1`: CCK with the gain's correction, OFDM
+    /// from both paths' power; the stronger path.
+    pub(crate) fn phy_signal_8822c(&self, status: &[u8]) -> Option<i32> {
+        match status[0] & 0xf {
+            0 => {
+                let (lower, upper) = self.cck_gain_bounds;
+                let corrected = |power: u8, gain: u8| {
+                    let mut power = power as i32;
+                    if gain < lower {
+                        power += ((lower - gain) as i32) << 1;
+                    } else if gain > upper {
+                        power -= ((gain - upper) as i32) << 1;
+                    }
+                    power - 110
+                };
+                let a = corrected(status[1], status[2] & 0x3f);
+                let b = corrected(status[16], status[19] & 0x3f);
+                Some(a.max(b).max(-120))
+            }
+            1 => Some((status[1].max(status[2]) as i32 - 110).max(-120)),
+            _ => None,
+        }
+    }
+
+    // ---- The DAC calibration (`rtw8822c_rf_dac_cal`). ----
+
+    /// IQ samples of the ADC until each settles near zero, then their
+    /// offsets (`rtw8822c_dac_cal_rf_mode`).
+    fn dack_iq_8822c(&self) -> (u32, u32) {
+        let c = &self.chip;
+        let read = || {
+            let value = c.r32_mask(0x2dbc, 0x3f_ffff);
+            ((value & 0x3f_f000) >> 12, value & 0x3ff)
+        };
+        let (mut iv, mut qv) = (Vec::with_capacity(DACK_SAMPLES), Vec::with_capacity(DACK_SAMPLES));
+        let mut reads = 0;
+        while iv.len() < DACK_SAMPLES && reads < 10_000 {
+            reads += 1;
+            let (i, q) = read();
+            if dack_sample_ok(i) && dack_sample_ok(q) {
+                iv.push(i);
+                qv.push(q);
+            }
+        }
+        iv.resize(DACK_SAMPLES, 0);
+        qv.resize(DACK_SAMPLES, 0);
+        for _ in 0..=100 {
+            let (mut i_min, mut i_max, mut q_min, mut q_max) = (iv[0], iv[0], qv[0], qv[0]);
+            for k in 0..DACK_SAMPLES {
+                dack_minmax(iv[k], &mut i_min, &mut i_max);
+                dack_minmax(qv[k], &mut q_min, &mut q_max);
+            }
+            let (i_delta, q_delta) = (dack_delta(i_min, i_max), dack_delta(q_min, q_max));
+            dack_sort(&mut iv);
+            dack_sort(&mut qv);
+            if i_delta <= 5 && q_delta <= 5 {
+                break;
+            }
+            let (i, q) = read();
+            iv[0] = i;
+            qv[0] = q;
+            let (i, q) = read();
+            iv[DACK_SAMPLES - 1] = i;
+            qv[DACK_SAMPLES - 1] = q;
+        }
+        (dack_offset(&iv), dack_offset(&qv))
+    }
+
+    /// `rtw8822c_dac_bb_setting`.
+    fn dack_bb_setting_8822c(&self) {
+        let c = &self.chip;
+        c.w32_mask(0x1d58, 0xff8, 0x1ff);
+        c.w32_mask(0x1a00, 0x3, 0x2);
+        c.w32_mask(0x1a14, 0x300, 0x3);
+        c.w32(0x1d70, 0x7e7e_7e7e);
+        c.w32_mask(0x180c, 0x3, 0x0);
+        c.w32_mask(0x410c, 0x3, 0x0);
+        c.w32(0x1b00, 0x0000_0008);
+        c.w8(0x1bcc, 0x3f);
+        c.w32(0x1b00, 0x0000_000a);
+        c.w8(0x1bcc, 0x3f);
+        c.w32_mask(0x1e24, 1 << 31, 0x0);
+        c.w32_mask(0x1e28, 0xf, 0x3);
+    }
+
+    /// `rtw8822c_dac_cal_adc`: the ADC's DC offset of a path.
+    fn dack_adc_8822c(&mut self, path: usize) -> (u32, u32) {
+        let base = DACK_WRITE[path];
+        let select = if path == 0 { 0xa0000 } else { 0x80000 };
+        let c = &self.chip;
+        c.w32_mask(base + 0x30, 1 << 30, 0x0);
+        if path == 1 {
+            c.w32(base + 0x30, 0x30db_8041);
+        }
+        c.w32(base + 0x60, 0xf004_0ff0);
+        c.w32(base + 0x0c, 0xdff0_0220);
+        c.w32(base + 0x10, 0x02dd_08c4);
+        c.w32(base + 0x0c, 0x1000_0260);
+        self.write_rf_path(0, 0x0, RFREG_MASK, 0x10000);
+        self.write_rf_path(1, 0x0, RFREG_MASK, 0x10000);
+        let (mut adc_ic, mut adc_qc) = (0, 0);
+        for _ in 0..10 {
+            self.chip.w32(0x1c3c, select + 0x8003);
+            self.chip.w32(0x1c24, 0x0001_0002);
+            let (mut ic, mut qc) = self.dack_iq_8822c();
+            if ic != 0 {
+                ic = 0x400 - ic;
+                adc_ic = ic;
+            }
+            if qc != 0 {
+                qc = 0x400 - qc;
+                adc_qc = qc;
+            }
+            let value = (ic & 0x3ff) | ((qc & 0x3ff) << 10);
+            self.chip.w32(base + 0x68, value);
+            self.dack_adck[path] = value;
+            self.chip.w32(0x1c3c, select + 0x8103);
+            let (mut ic, mut qc) = self.dack_iq_8822c();
+            if ic >= 0x200 {
+                ic = 0x400 - ic;
+            }
+            if qc >= 0x200 {
+                qc = 0x400 - qc;
+            }
+            if ic < 5 && qc < 5 {
+                break;
+            }
+        }
+        let c = &self.chip;
+        c.w32(0x1c3c, 0x0000_0003);
+        c.w32(base + 0x0c, 0x1000_0260);
+        c.w32(base + 0x10, 0x02d5_08c4);
+        self.write_rf_path(path, 0x8f, 1 << 13, 0x1);
+        (adc_ic, adc_qc)
+    }
+
+    /// `rtw8822c_dac_cal_step1`: the DAC's own calibration.
+    fn dack_step1_8822c(&self, path: usize) {
+        let (base, read) = (DACK_WRITE[path], DACK_READ[path]);
+        let c = &self.chip;
+        c.w32(base + 0x68, self.dack_adck[path]);
+        c.w32(base + 0x0c, 0xdff0_0220);
+        if path == 0 {
+            c.w32(base + 0x60, 0xf004_0ff0);
+            c.w32(0x1c38, 0xffff_ffff);
+        }
+        c.w32(base + 0x10, 0x02d5_08c5);
+        c.w32(0x9b4, 0xdb66_db00);
+        c.w32(base + 0xb0, 0x0a11_fb88);
+        c.w32(base + 0xbc, 0x0008_ff81);
+        c.w32(base + 0xc0, 0x0003_d208);
+        c.w32(base + 0xcc, 0x0a11_fb88);
+        c.w32(base + 0xd8, 0x0008_ff81);
+        c.w32(base + 0xdc, 0x0003_d208);
+        c.w32(base + 0xb8, 0x6000_0000);
+        crate::delay_ms(2);
+        c.w32(base + 0xbc, 0x000a_ff8d);
+        crate::delay_ms(2);
+        c.w32(base + 0xb0, 0x0a11_fb89);
+        c.w32(base + 0xcc, 0x0a11_fb89);
+        crate::delay_ms(1);
+        c.w32(base + 0xb8, 0x6200_0000);
+        c.w32(base + 0xd4, 0x6200_0000);
+        crate::delay_ms(20);
+        if !c.ready(read + 0x08, 0x7f_ff80, 0xffff) || !c.ready(read + 0x34, 0x7f_ff80, 0xffff) {
+            ostd::warn!("{}: the DAC calibration did not get ready", c.name);
+        }
+        c.w32(base + 0xb8, 0x0200_0000);
+        crate::delay_ms(1);
+        c.w32(base + 0xbc, 0x0008_ff87);
+        c.w32(0x9b4, 0xdb6d_b600);
+        c.w32(base + 0x10, 0x02d5_08c5);
+        c.w32(base + 0xbc, 0x0008_ff87);
+        c.w32(base + 0x60, 0xf000_0000);
+    }
+
+    /// `rtw8822c_dac_cal_step2`: the IQ vector to write.
+    fn dack_step2_8822c(&self, path: usize) -> (u32, u32) {
+        let base = DACK_WRITE[path];
+        let c = &self.chip;
+        c.w32_mask(base + 0xbc, 0xf000_0000, 0x0);
+        c.w32_mask(base + 0xc0, 0xf, 0x8);
+        c.w32_mask(base + 0xd8, 0xf000_0000, 0x0);
+        c.w32_mask(base + 0xdc, 0xf, 0x8);
+        c.w32(0x1b00, 0x0000_0008);
+        c.w8(0x1bcc, 0x03f);
+        c.w32(base + 0x0c, 0xdff0_0220);
+        c.w32(base + 0x10, 0x02d5_08c5);
+        c.w32(0x1c3c, 0x0008_8103);
+        let (mut ic, mut qc) = self.dack_iq_8822c();
+        if ic != 0 {
+            ic = 0x400 - ic;
+        }
+        if qc != 0 {
+            qc = 0x400 - qc;
+        }
+        let scale = |value: u32| if value < 0x300 { value * 2 * 6 / 5 + 0x80 } else { 0x7f - (0x400 - value) * 2 * 6 / 5 };
+        (scale(ic), scale(qc))
+    }
+
+    /// `rtw8822c_dac_cal_step3`: the vector written and measured again;
+    /// how far from zero it still is.
+    fn dack_step3_8822c(&self, path: usize, adc: (u32, u32), vector: (u32, u32)) -> (u32, u32) {
+        let (base, read) = (DACK_WRITE[path], DACK_READ[path]);
+        let (ic, qc) = vector;
+        let c = &self.chip;
+        c.w32(base + 0x0c, 0xdff0_0220);
+        c.w32(base + 0x10, 0x02d5_08c5);
+        c.w32(0x9b4, 0xdb66_db00);
+        c.w32(base + 0xb0, 0x0a11_fb88);
+        c.w32(base + 0xbc, 0xc008_ff81);
+        c.w32(base + 0xc0, 0x0003_d208);
+        c.w32_mask(base + 0xbc, 0xf000_0000, ic & 0xf);
+        c.w32_mask(base + 0xc0, 0xf, (ic & 0xf0) >> 4);
+        c.w32(base + 0xcc, 0x0a11_fb88);
+        c.w32(base + 0xd8, 0xe008_ff81);
+        c.w32(base + 0xdc, 0x0003_d208);
+        c.w32_mask(base + 0xd8, 0xf000_0000, qc & 0xf);
+        c.w32_mask(base + 0xdc, 0xf, (qc & 0xf0) >> 4);
+        c.w32(base + 0xb8, 0x6000_0000);
+        crate::delay_ms(2);
+        c.w32_mask(base + 0xbc, 0xe, 0x6);
+        crate::delay_ms(2);
+        c.w32(base + 0xb0, 0x0a11_fb89);
+        c.w32(base + 0xcc, 0x0a11_fb89);
+        crate::delay_ms(1);
+        c.w32(base + 0xb8, 0x6200_0000);
+        c.w32(base + 0xd4, 0x6200_0000);
+        crate::delay_ms(20);
+        if !c.ready(read + 0x24, 0x07f8_0000, ic) || !c.ready(read + 0x50, 0x07f8_0000, qc) {
+            ostd::warn!("{}: the DAC's IQ vector did not take", c.name);
+        }
+        c.w32(base + 0xb8, 0x0200_0000);
+        crate::delay_ms(1);
+        c.w32_mask(base + 0xbc, 0xe, 0x3);
+        c.w32(0x9b4, 0xdb6d_b600);
+        let value = ((adc.0 + 0x10) & 0x3ff) | (((adc.1 + 0x10) & 0x3ff) << 10);
+        c.w32(base + 0x68, value);
+        c.w32(base + 0x10, 0x02d5_08c5);
+        c.w32(base + 0x60, 0xf000_0000);
+        let (ic, qc) = self.dack_iq_8822c();
+        let shift = |value: u32| if value >= 0x10 { value - 0x10 } else { 0x400 - (0x10 - value) };
+        let magnitude = |value: u32| if value >= 0x200 { 0x400 - value } else { value };
+        (magnitude(shift(ic)), magnitude(shift(qc)))
+    }
+
+    /// `rtw8822c_dac_cal_step4`.
+    fn dack_step4_8822c(&self, path: usize) {
+        let base = DACK_WRITE[path];
+        let c = &self.chip;
+        c.w32(base + 0x68, 0x0);
+        c.w32(base + 0x10, 0x02d5_08c4);
+        c.w32_mask(base + 0xbc, 0x1, 0x0);
+        c.w32_mask(base + 0x30, 1 << 30, 0x1);
+    }
+
+    /// `rtw8822c_rf_dac_cal`: both paths' ADC and DAC offsets, the
+    /// registers it touched restored.
+    fn dac_cal_8822c(&mut self) {
+        let saved: Vec<(u32, u32)> = DACK_REGS.iter().map(|&reg| (reg, self.chip.r32(reg))).collect();
+        let saved_rf = [self.read_rf_path(0, 0x8f, RFREG_MASK), self.read_rf_path(1, 0x8f, RFREG_MASK)];
+        self.dack_bb_setting_8822c();
+        for path in 0..2 {
+            let adc = self.dack_adc_8822c(path);
+            for _ in 0..10 {
+                self.dack_step1_8822c(path);
+                let vector = self.dack_step2_8822c(path);
+                let (ic, qc) = self.dack_step3_8822c(path, adc, vector);
+                if ic < 5 && qc < 5 {
+                    break;
+                }
+            }
+            self.dack_step4_8822c(path);
+        }
+        let c = &self.chip;
+        c.w32(0x1b00, 0x0000_0008);
+        c.w32_mask(0x4130, 1 << 30, 0x1);
+        c.w8(0x1bcc, 0x0);
+        c.w32(0x1b00, 0x0000_000a);
+        c.w8(0x1bcc, 0x0);
+        for (reg, value) in saved {
+            c.w32(reg, value);
+        }
+        for (path, value) in saved_rf.iter().enumerate() {
+            self.write_rf_path(path, 0x8f, RFREG_MASK, *value);
+        }
+    }
+
+    /// `rtw8822c_rf_x2_check`: the RF's clock doubler unstuck.
+    fn rf_x2_check_8822c(&self) {
+        crate::delay_ms(1);
+        if self.read_rf(0xb8, 1 << 15) == 1 {
+            self.write_rf(0xb8, RFREG_MASK, 0xc4440);
+            self.write_rf(0xba, RFREG_MASK, 0x6840d);
+            self.write_rf(0xb8, RFREG_MASK, 0x80440);
+            crate::delay_ms(1);
+        }
+    }
+
+    fn physical(&self, at: u32) -> u8 {
+        self.physical.get(at as usize).copied().unwrap_or(EFUSE_EMPTY)
+    }
+
+    /// `rtw8822c_thermal_trim`: each path's thermal meter offset.
+    fn thermal_trim_8822c(&self) {
+        for (path, at) in [PPG_THERMAL_A, PPG_THERMAL_B].into_iter().enumerate() {
+            let value = self.physical(at);
+            if value == EFUSE_EMPTY {
+                return;
+            }
+            let trim = ((value as u32 >> 1) & 0x7) | ((value as u32 & 1) << 3);
+            self.write_rf_path(path, 0x43, RF_THEMAL_MASK, trim);
+        }
+    }
+
+    /// `rtw8822c_power_trim`: the BB gains of each band group and path.
+    fn power_trim_8822c(&self) {
+        let mut gains = [[0u32; 8]; 2];
+        let mut set = false;
+        for (i, at) in [PPG_2GL_TXAB, PPG_2GM_TXAB, PPG_2GH_TXAB].into_iter().enumerate() {
+            let value = self.physical(at);
+            if value == EFUSE_EMPTY {
+                continue;
+            }
+            set = true;
+            gains[0][i] = value as u32 & 0xf;
+            gains[1][i] = (value as u32 >> 4) & 0xf;
+        }
+        let ghz5 = [[PPG_5GL1_TXA, PPG_5GL2_TXA, PPG_5GM1_TXA, PPG_5GM2_TXA, PPG_5GH1_TXA], [PPG_5GL1_TXB, PPG_5GL2_TXB, PPG_5GM1_TXB, PPG_5GM2_TXB, PPG_5GH1_TXB]];
+        for (path, addresses) in ghz5.iter().enumerate() {
+            for (i, &at) in addresses.iter().enumerate() {
+                let value = self.physical(at);
+                if value == EFUSE_EMPTY {
+                    continue;
+                }
+                set = true;
+                gains[path][3 + i] = value as u32 & 0x1f;
+            }
+        }
+        if set {
+            // The RF's gain sequence and which group each step takes.
+            const STEPS: [usize; 15] = [0, 1, 2, 2, 3, 4, 5, 6, 7, 3, 4, 5, 6, 7, 7];
+            for (path, gain) in gains.iter().enumerate() {
+                self.write_rf_path(path, 0xee, 1 << 19, 1);
+                for (sequence, &group) in STEPS.iter().enumerate() {
+                    self.write_rf_path(path, 0x33, RFREG_MASK, sequence as u32);
+                    self.write_rf_path(path, 0x3f, RFREG_MASK, gain[group]);
+                }
+                self.write_rf_path(path, 0xee, 1 << 19, 0);
+            }
+        }
+        self.chip.w32_mask(REG_DIS_DPD, DIS_DPD_MASK, DIS_DPD_RATEALL);
+    }
+
+    /// `rtw8822c_pa_bias`: each path's PA bias at 2.4 and 5 GHz.
+    fn pa_bias_8822c(&self) {
+        for (path, at) in [PPG_PABIAS_2GA, PPG_PABIAS_2GB].into_iter().enumerate() {
+            let value = self.physical(at);
+            if value == EFUSE_EMPTY {
+                return;
+            }
+            self.write_rf_path(path, RF_PA, RF_PABIAS_2G_MASK, value as u32 & 0xf);
+        }
+        for (path, at) in [PPG_PABIAS_5GA, PPG_PABIAS_5GB].into_iter().enumerate() {
+            let value = self.physical(at);
+            self.write_rf_path(path, RF_PA, RF_PABIAS_5G_MASK, value as u32 & 0xf);
+        }
+    }
+}
