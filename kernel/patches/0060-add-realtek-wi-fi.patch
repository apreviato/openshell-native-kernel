+// SPDX-License-Identifier: MPL-2.0
+
+//! Realtek Wi-Fi of Linux's rtw88 family on PCIe, as Linux's `rtw88_pci`
+//! runs them: the RTL8821CE (10ec:b821, 10ec:c821; one path, Bluetooth on
+//! the same antenna), the RTL8822BE (10ec:b822; two paths), the RTL8822CE
+//! (10ec:c822, 10ec:c82f; two paths, its DAC calibrated at power on) and
+//! the RTL8723DE (10ec:d723; 802.11n at 2.4 GHz, one path, an 8051 CPU,
+//! Bluetooth on the same antenna); and the same chips on USB adapters, as
+//! Linux's `rtw88_usb` runs them: the RTL8821CU and RTL8811CU, the
+//! RTL8822BU, the RTL8822CU and the RTL8723DU ([`usb`], the IDs of Linux's
+//! `rtw8821cu.c`, `rtw8822bu.c`, `rtw8822cu.c` and `rtw8723du.c`).
+//!
+//! The chip ([`chip`], [`hci`]: [`pci`] or [`usb`]) is brought up by the host ([`hw`], with
+//! each chip's own part in [`rtw8821c`], [`rtw8822b`], [`rtw8822c`] and
+//! [`rtw8723d`]): power sequences, the firmware (linux-firmware's
+//! `rtw88/rtw8821c_fw.bin` and the others) through the reserved pages or,
+//! on the RTL8723DE, page by page, the MAC, the PHY tables ([`tables`],
+//! generated from Linux's), the channel, the TX power, the calibrations,
+//! the antenna shared with Bluetooth. The station on it is [`sta`]: a
+//! software scan, the firmware's rate adaptation, keys in the security CAM.
+//!
+//! TKIP serves the group's key (its MIC checked here); 802.11w's robust
+//! management frames are encrypted by the Wi-Fi component, the chips
+//! protecting data only. Not yet: the RTL8822CE's TX gain gap calibration
+//! and DPK (its DPD stays off), the thermal power tracking, the dynamic
+//! sensitivity (DIG), the BT coexistence's run-time decisions beyond the
+//! band, USB 3 mode switching. `dmesg | grep rtw88` says how far a card
+//! gets; `rtw88.off` leaves the cards alone.
+
+#![no_std]
+#![deny(unsafe_code)]
+
+extern crate alloc;
+
+macro_rules! __log_prefix {
+    () => {
+        "rtw88: "
+    };
+}
+
+mod chip;
+mod hci;
+mod hw;
+mod pci;
+#[allow(clippy::all)]
+mod regs;
+mod rtw8723d;
+mod rtw8821c;
+mod rtw8822b;
+mod rtw8822c;
+mod sta;
+mod tables;
+mod usb;
+
+use alloc::{format, string::String, sync::Arc};
+use core::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+use aster_linuxkpi::{
+    pci::{self as kpi_pci, Devices},
+    wait::Waker,
+};
+pub(crate) use aster_linuxkpi::delay::{mdelay as delay_ms, now_ms, udelay as delay_us};
+use aster_pci::common_device::PciCommonDevice;
+use aster_wlan::{
+    ieee80211::Address,
+    radio::{self, ApConfig, Association, BeaconTemplate, BlockAck, Join, Key, LinkStats, Radio, Reorder, ScanRequest, StationEntry},
+};
+use component::{ComponentInitError, init_component};
+use ostd::sync::Mutex;
+
+use crate::{
+    chip::{Bus, Chip},
+    hci::Hci,
+    hw::{Hw, Model},
+    pci::Pci,
+    sta::Rtw88,
+    usb::{Usb, UsbRegs},
+};
+
+/// The cards' tasks sleep here: woken by their interrupt, and by the timer
+/// every 5 ms (scans step on time, interrupts that do not arrive are made
+/// up for).
+static WAKER: Waker = Waker::new(5);
+static DEVICES: Devices = Devices::new();
+
+/// `msleep`.
+pub(crate) fn sleep_ms(ms: u64) {
+    WAKER.msleep(ms);
+}
+
+const VENDOR_REALTEK: u16 = 0x10ec;
+
+fn model_of(vendor: u16, device: u16) -> Option<Model> {
+    match (vendor, device) {
+        (VENDOR_REALTEK, 0xb821 | 0xc821) => Some(Model::Rtl8821c),
+        (VENDOR_REALTEK, 0xb822) => Some(Model::Rtl8822b),
+        (VENDOR_REALTEK, 0xc822 | 0xc82f) => Some(Model::Rtl8822c),
+        (VENDOR_REALTEK, 0xd723) => Some(Model::Rtl8723d),
+        _ => None,
+    }
+}
+
+/// The device table (`rtw_8821ce_id_table` and the others).
+fn claims(vendor: u16, device: u16) -> bool {
+    model_of(vendor, device).is_some()
+}
+
+/// The USB adapters (`rtw_8821cu_id_table`, `rtw_8822bu_id_table`,
+/// `rtw_8822cu_id_table`, `rtw_8723du_id_table`), their vendor-specific
+/// interface.
+fn usb_model_of(vendor: u16, product: u16) -> Option<Model> {
+    const REALTEK: u16 = 0x0bda;
+    match (vendor, product) {
+        (REALTEK, 0x2006 | 0x8731 | 0x8811 | 0xb820 | 0xb82b | 0xc80c | 0xc811 | 0xc820 | 0xc821 | 0xc82a | 0xc82b)
+        | (0x2001, 0x331d)
+        | (0x7392, 0xc811 | 0xd811)
+        | (0x2c4e, 0x0105) => Some(Model::Rtl8821c),
+        (REALTEK, 0xb812 | 0xb82c | 0x2102 | 0xb81a)
+        | (0x7392, 0xb822 | 0xc822 | 0xd822 | 0xe822 | 0xf822)
+        | (0x0b05, 0x1841 | 0x184c | 0x19aa | 0x1870 | 0x1874)
+        | (0x2001, 0x331e | 0x331c | 0x331f | 0x3322)
+        | (0x13b1, 0x0045)
+        | (0x2357, 0x012d | 0x0138 | 0x0115 | 0x012e | 0x0116 | 0x0117)
+        | (0x0846, 0x9055)
+        | (0x0e66, 0x0025)
+        | (0x04ca, 0x8602)
+        | (0x20f4, 0x808a | 0x805a)
+        | (0x056e, 0x4011)
+        | (0x2c4e, 0x0107 | 0x010a)
+        | (0x0411, 0x03d1) => Some(Model::Rtl8822b),
+        (REALTEK, 0xc82c | 0xc812 | 0xc82e | 0xd820 | 0xd82b) | (0x2001, 0x3329) => Some(Model::Rtl8822c),
+        // Linux lists 13b1:0043 under both the 8822BU and the 8822CU; the
+        // 8822B's table comes first.
+        (0x13b1, 0x0043) => Some(Model::Rtl8822b),
+        (REALTEK, 0xd723) | (0x7392, 0xd611) => Some(Model::Rtl8723d),
+        _ => None,
+    }
+}
+
+/// The USB adapters' driver, for aster-usb.
+struct UsbDriver;
+
+impl aster_usb::driver::UsbDriver for UsbDriver {
+    fn name(&self) -> &'static str {
+        "rtw88_usb"
+    }
+
+    fn matches(&self, info: &aster_usb::driver::InterfaceInfo) -> bool {
+        info.class == 0xff && usb_model_of(info.vendor, info.product).is_some()
+    }
+
+    fn probe(&self, interface: aster_usb::driver::UsbInterface) {
+        run_usb(interface);
+    }
+}
+
+static USB_ADAPTERS: AtomicUsize = AtomicUsize::new(0);
+static TIMER_STARTED: AtomicBool = AtomicBool::new(false);
+
+fn start_timer_once() {
+    if !TIMER_STARTED.swap(true, Ordering::AcqRel) {
+        WAKER.start_timer();
+    }
+}
+
+static DISABLED: AtomicBool = AtomicBool::new(false);
+aster_cmdline::define_flag_param!("rtw88.off", DISABLED);
+
+#[init_component]
+fn init() -> Result<(), ComponentInitError> {
+    if DISABLED.load(Ordering::Relaxed) {
+        return Ok(());
+    }
+    if DEVICES.register(claims) {
+        start_timer_once();
+    }
+    aster_usb::driver::register_driver(Arc::new(UsbDriver));
+    Ok(())
+}
+
+#[init_component(kthread)]
+fn start() -> Result<(), ComponentInitError> {
+    DEVICES.spawn(run);
+    Ok(())
+}
+
+struct Card {
+    state: Mutex<Rtw88>,
+}
+
+struct RealtekRadio {
+    card: Arc<Card>,
+}
+
+impl Radio for RealtekRadio {
+    fn start(&self) -> radio::Result<()> {
+        if self.card.state.lock().dead { Err(radio::Error::Down) } else { Ok(()) }
+    }
+
+    fn stop(&self) {
+        let mut state = self.card.state.lock();
+        state.abort_scan();
+        state.stop_ap();
+        state.leave();
+    }
+
+    fn scan(&self, request: &ScanRequest) -> radio::Result<()> {
+        self.card.state.lock().scan(request)
+    }
+
+    fn abort_scan(&self) {
+        self.card.state.lock().abort_scan();
+        WAKER.wake();
+    }
+
+    fn join(&self, network: &Join) -> radio::Result<()> {
+        self.card.state.lock().join(network)
+    }
+
+    fn associated(&self, association: &Association) -> radio::Result<()> {
+        self.card.state.lock().associated(association)
+    }
+
+    fn leave(&self) {
+        self.card.state.lock().leave();
+    }
+
+    fn set_key(&self, key: &Key) -> radio::Result<()> {
+        self.card.state.lock().set_key(key)
+    }
+
+    fn remove_key(&self, index: u8, pairwise: bool) {
+        self.card.state.lock().remove_key(index, pairwise);
+    }
+
+    fn authorize(&self, _authorized: bool) {}
+
+    fn send_management(&self, frame: &[u8]) -> radio::Result<()> {
+        self.card.state.lock().transmit(frame.to_vec())
+    }
+
+    fn send(&self, ethernet: &[u8], plain: bool) -> radio::Result<()> {
+        self.card.state.lock().send(ethernet, plain)
+    }
+
+    fn link_stats(&self) -> LinkStats {
+        LinkStats { signal: self.card.state.lock().signal, tx_rate: None }
+    }
+
+    fn start_ap(&self, config: &ApConfig) -> radio::Result<()> {
+        self.card.state.lock().start_ap(config)
+    }
+
+    fn set_beacon(&self, beacon: &BeaconTemplate) -> radio::Result<()> {
+        self.card.state.lock().set_beacon(beacon)
+    }
+
+    fn stop_ap(&self) {
+        self.card.state.lock().stop_ap();
+    }
+
+    fn add_station(&self, station: &StationEntry) -> radio::Result<()> {
+        self.card.state.lock().add_station(station)
+    }
+
+    fn remove_station(&self, address: &Address) {
+        self.card.state.lock().remove_station(address);
+    }
+
+    // The keys decide what the chip lets through (as `authorize` above).
+    fn authorize_station(&self, _address: &Address, _authorized: bool) {}
+
+    fn set_power_save(&self, enabled: bool) -> radio::Result<()> {
+        self.card.state.lock().set_power_save(enabled)
+    }
+
+    fn rx_ba_start(&self, ba: &mut BlockAck) -> radio::Result<Reorder> {
+        self.card.state.lock().rx_ba_start(ba)
+    }
+
+    fn tx_ba_start(&self, peer: &Address, tid: u8) -> radio::Result<u16> {
+        self.card.state.lock().tx_ba_start(peer, tid)
+    }
+
+    fn tx_ba_operational(&self, ba: &BlockAck) -> radio::Result<()> {
+        self.card.state.lock().tx_ba_operational(ba)
+    }
+
+    fn tx_ba_stop(&self, peer: &Address, tid: u8) {
+        self.card.state.lock().tx_ba_stop(peer, tid);
+    }
+}
+
+/// A card's task: the chip up, the station registered, then what the chip
+/// says.
+fn run(index: usize, mut device: PciCommonDevice) {
+    let id = *device.device_id();
+    let Some(model) = model_of(id.vendor_id, id.device_id) else { return };
+    let location = *device.location();
+    let name = kpi_pci::device_name("rtw88", index, &location);
+    kpi_pci::enable_device(&location);
+    // MSI (as Linux's rtw88), or none (the timer looks).
+    let vectors = kpi_pci::alloc_irq_vector(&mut device, false, &name, || WAKER.wake());
+    // Linux maps BAR 2.
+    let Some(mmio) = kpi_pci::iomap(&mut device, 2) else {
+        ostd::warn!("{}: no registers in BAR 2", name);
+        return;
+    };
+    let chip = Chip::new(Bus::Mmio(mmio), name.clone());
+    if !chip.present() {
+        ostd::warn!("{}: the card does not answer", name);
+        return;
+    }
+    ostd::notice!("{}: Realtek {:04x} ({:?}, cut {}, {} RF path(s))", name, id.device_id, model, chip.cut, chip.rf_paths);
+    let Some((_, firmware)) = aster_firmware::load_first([model.firmware()]) else {
+        ostd::warn!("{}: {} is not in /lib/firmware", name, model.firmware());
+        return;
+    };
+    let Some(pci) = Pci::new(model.spec()) else {
+        ostd::warn!("{}: no DMA memory below 4 GiB", name);
+        return;
+    };
+    let mut hw = Hw::new(chip, Hci::Pci(pci), model, firmware.to_vec());
+    if let Err(error) = hw.read_efuse() {
+        ostd::warn!("{}: {}", name, error);
+        return;
+    }
+    hw.pci_phy_cfg();
+    // Linux disables the RTL8821CE's completion time-out.
+    if model == Model::Rtl8821c {
+        kpi_pci::disable_completion_timeout(&location);
+    }
+    if let Err(error) = hw.power_on() {
+        ostd::warn!("{}: {}", name, error);
+        return;
+    }
+    serve(hw, &name);
+    drop((vectors, device));
+}
+
+/// A chip that is up: the station registered, then what the chip says,
+/// until it is gone.
+fn serve(hw: Hw, name: &str) {
+    let mut state = Rtw88::new(hw);
+    state.add_interface();
+    let info = state.info();
+    ostd::notice!("{}: ready, MAC {:02x?}, RFE {}", name, state.address, state.hw.efuse.rfe_option);
+    let card = Arc::new(Card { state: Mutex::new(state) });
+    let wlan = aster_wlan::register(info, Arc::new(RealtekRadio { card: card.clone() }));
+    card.state.lock().device = Some(wlan);
+    loop {
+        WAKER.sleep();
+        let mut state = card.state.lock();
+        state.poll();
+        if state.dead {
+            state.hw.hci.stop();
+            break;
+        }
+    }
+}
+
+/// A USB adapter's task (`rtw_usb_probe`): the registers through vendor
+/// requests, the queues on its bulk endpoints, then the chip up as on PCIe.
+fn run_usb(interface: aster_usb::driver::UsbInterface) {
+    let (vendor, product) = (interface.info.vendor, interface.info.product);
+    let Some(model) = usb_model_of(vendor, product) else { return };
+    let index = USB_ADAPTERS.fetch_add(1, Ordering::Relaxed);
+    let name: String = format!("rtw88_usb {} ({:04x}:{:04x})", index, vendor, product);
+    start_timer_once();
+    let interface = Arc::new(interface);
+    // The 8822B, 8822C and 8821C echo their always-on registers' accesses.
+    let reg_sec = matches!(model, Model::Rtl8821c | Model::Rtl8822b | Model::Rtl8822c);
+    let chip = Chip::new(Bus::Usb(UsbRegs::new(interface.clone(), reg_sec)), name.clone());
+    if !chip.present() {
+        ostd::warn!("{}: the adapter does not answer", name);
+        return;
+    }
+    ostd::notice!("{}: Realtek {:?} on USB (speed {}), cut {}, {} RF path(s)", name, model, interface.speed, chip.cut, chip.rf_paths);
+    let Some((_, firmware)) = aster_firmware::load_first([model.firmware()]) else {
+        ostd::warn!("{}: {} is not in /lib/firmware", name, model.firmware());
+        return;
+    };
+    let usb = match Usb::new(interface.clone(), model.spec(), Arc::new(|| WAKER.wake())) {
+        Ok(usb) => usb,
+        Err(error) => {
+            ostd::warn!("{}: {}", name, error);
+            return;
+        }
+    };
+    let mut hw = Hw::new(chip, Hci::Usb(usb), model, firmware.to_vec());
+    if let Err(error) = hw.read_efuse() {
+        ostd::warn!("{}: {}", name, error);
+        return;
+    }
+    hw.usb_phy_cfg();
+    if let Err(error) = hw.power_on() {
+        ostd::warn!("{}: {}", name, error);
+        return;
+    }
+    hw.dynamic_rx_agg(false);
+    hw.hci.start_rx();
+    serve(hw, &name);
+}
diff --git a/kernel/comps/rtw88/src/pci.rs b/kernel/comps/rtw88/src/pci.rs
new file mode 100644
index 0000000..ce6a297
--- /dev/null
+++ b/kernel/comps/rtw88/src/pci.rs
@@ -0,0 +1,338 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The PCIe side as Linux's rtw88 `pci.c` runs it: a ring of buffer
+//! descriptors per TX queue (each frame its TX descriptor and itself, one
+//! buffer), one RX ring, the interrupt status registers.
+
+use alloc::{vec, vec::Vec};
+
+use ostd::mm::{HasDaddr, PAGE_SIZE, VmIo, dma::DmaCoherent};
+
+use crate::{chip::Chip, hw::Spec, regs::*};
+
+/// The queues, in Linux's order (`enum rtw_tx_queue_type`).
+pub(crate) const QUEUE_BK: usize = 0;
+pub(crate) const QUEUE_BE: usize = 1;
+pub(crate) const QUEUE_VI: usize = 2;
+pub(crate) const QUEUE_VO: usize = 3;
+pub(crate) const QUEUE_BCN: usize = 4;
+pub(crate) const QUEUE_MGMT: usize = 5;
+pub(crate) const QUEUE_HI0: usize = 6;
+pub(crate) const QUEUE_H2C: usize = 7;
+const QUEUES: usize = 8;
+
+/// The largest TX descriptor (`tx_pkt_desc_sz`: the 8821C's, 8822B's and
+/// 8822C's; the RTL8723D's is its first 40 bytes) and the buffer
+/// descriptors (`tx_buf_desc_sz`, `rx_buf_desc_sz`).
+pub(crate) const TX_DESC_MAX: usize = 48;
+const TX_BD: usize = 16;
+const RX_BD: usize = 8;
+/// A TX slot: a page (the beacon queue two, for 4 KiB of firmware).
+const TX_SLOT: usize = PAGE_SIZE;
+const BCN_SLOT: usize = 2 * PAGE_SIZE;
+/// An RX buffer (`RTK_PCI_RX_BUF_SIZE`: 11 KiB and the RX descriptor).
+pub(crate) const RX_BUF: usize = 11454 + 24;
+const RX_SLOT: usize = RX_BUF.div_ceil(PAGE_SIZE) * PAGE_SIZE;
+const RX_SLOTS: usize = 128;
+const RX_TAG_MAX: u16 = 8192;
+
+/// The ring's registers: base address, depth, index (`rtw_pci.h`).
+fn registers(queue: usize) -> (u32, u32, u32) {
+    match queue {
+        QUEUE_BK => (RTK_PCI_TXBD_DESA_BKQ, RTK_PCI_TXBD_NUM_BKQ, RTK_PCI_TXBD_IDX_BKQ),
+        QUEUE_BE => (RTK_PCI_TXBD_DESA_BEQ, RTK_PCI_TXBD_NUM_BEQ, RTK_PCI_TXBD_IDX_BEQ),
+        QUEUE_VI => (RTK_PCI_TXBD_DESA_VIQ, RTK_PCI_TXBD_NUM_VIQ, RTK_PCI_TXBD_IDX_VIQ),
+        QUEUE_VO => (RTK_PCI_TXBD_DESA_VOQ, RTK_PCI_TXBD_NUM_VOQ, RTK_PCI_TXBD_IDX_VOQ),
+        QUEUE_MGMT => (RTK_PCI_TXBD_DESA_MGMTQ, RTK_PCI_TXBD_NUM_MGMTQ, RTK_PCI_TXBD_IDX_MGMTQ),
+        QUEUE_HI0 => (RTK_PCI_TXBD_DESA_HI0Q, RTK_PCI_TXBD_NUM_HI0Q, RTK_PCI_TXBD_IDX_HI0Q),
+        QUEUE_H2C => (RTK_PCI_TXBD_DESA_H2CQ, RTK_PCI_TXBD_NUM_H2CQ, RTK_PCI_TXBD_IDX_H2CQ),
+        _ => (RTK_PCI_TXBD_DESA_BCNQ, 0, 0),
+    }
+}
+
+/// DMA memory the buffer descriptors can name: their addresses are 32 bits.
+/// Asked for again until it lies below 4 GiB.
+pub(crate) use aster_linuxkpi::dma::alloc_coherent32 as dma32;
+
+struct TxRing {
+    bds: DmaCoherent,
+    buffers: DmaCoherent,
+    slot: usize,
+    len: usize,
+    wp: usize,
+}
+
+struct RxRing {
+    bds: DmaCoherent,
+    buffers: DmaCoherent,
+    rp: usize,
+    tag: u16,
+}
+
+/// What a TX descriptor says (Linux's `struct rtw_tx_pkt_info`, the fields
+/// this driver uses).
+#[derive(Clone, Copy, Default)]
+pub(crate) struct TxInfo {
+    pub(crate) offset: u8,
+    pub(crate) bmc: bool,
+    pub(crate) ls: bool,
+    pub(crate) dis_qselseq: bool,
+    pub(crate) mac_id: u8,
+    pub(crate) qsel: u8,
+    pub(crate) rate_id: u8,
+    pub(crate) sec_type: u8,
+    pub(crate) use_rate: bool,
+    pub(crate) dis_rate_fallback: bool,
+    pub(crate) rate: u8,
+    pub(crate) en_hwseq: bool,
+    pub(crate) seq: u16,
+    pub(crate) sn: u16,
+    /// The station's width (`RTW_CHANNEL_WIDTH_*`), its LDPC and STBC.
+    pub(crate) bw: u8,
+    pub(crate) ldpc: bool,
+    pub(crate) stbc: u8,
+    /// In an aggregate (`RTW_TX_DESC_W2_AGG_EN`): the most frames in one
+    /// (`W3_MAX_AGG_NUM`, in twos) and their spacing (`W2_AMPDU_DEN`).
+    pub(crate) ampdu_en: bool,
+    pub(crate) ampdu_factor: u8,
+    pub(crate) ampdu_density: u8,
+}
+
+impl TxInfo {
+    /// `rtw_tx_fill_tx_desc`; with `fb_limit`, the rate fallback's limit at
+    /// its widest (`old_datarate_fb_limit`).
+    pub(crate) fn descriptor(&self, size: usize, fb_limit: bool) -> [u8; TX_DESC_MAX] {
+        let mut w = [0u32; 12];
+        let more_data = self.qsel == TX_DESC_QSEL_HIGH as u8;
+        w[0] = (size as u32 & 0xffff) | ((self.offset as u32) << 16) | ((self.bmc as u32) << 24) | ((self.ls as u32) << 26) | ((self.dis_qselseq as u32) << 31);
+        w[1] = (self.mac_id as u32 & 0x7f) | ((self.qsel as u32 & 0x1f) << 8) | ((self.rate_id as u32 & 0x1f) << 16) | ((self.sec_type as u32 & 3) << 22) | ((more_data as u32) << 29);
+        w[2] = ((self.ampdu_en as u32) << 12) | ((self.ampdu_density as u32 & 7) << 20);
+        w[3] = ((self.use_rate as u32) << 8) | ((self.dis_rate_fallback as u32) << 10) | ((self.ampdu_factor as u32 & 0x1f) << 17);
+        w[4] = self.rate as u32 & 0x7f;
+        if fb_limit {
+            w[4] |= 0x1f << 8;
+        }
+        // `RTW_TX_DESC_W5_DATA_BW`, `_LDPC`, `_STBC`.
+        w[5] = ((self.bw as u32 & 3) << 5) | ((self.ldpc as u32) << 7) | ((self.stbc as u32 & 3) << 8);
+        w[6] = self.sn as u32 & 0xfff;
+        w[8] = (self.en_hwseq as u32) << 15;
+        w[9] = (self.seq as u32 & 0xfff) << 12;
+        let mut out = [0u8; TX_DESC_MAX];
+        for (index, word) in w.iter().enumerate() {
+            out[index * 4..index * 4 + 4].copy_from_slice(&word.to_le_bytes());
+        }
+        out
+    }
+}
+
+pub(crate) struct Pci {
+    tx: Vec<TxRing>,
+    rx: RxRing,
+    /// Interrupts to take (`irq_mask`).
+    mask: [u32; 4],
+    /// The chip's TX descriptor and its rate fallback limit, and whether it
+    /// has the H2C queue and its interrupts (the 3081 CPU's chips, not the
+    /// 8051's).
+    tx_desc: usize,
+    fb_limit: bool,
+    h2c_queue: bool,
+}
+
+impl Pci {
+    /// Linux's `rtw_pci_init`: the rings, for the chip of `spec`.
+    pub(crate) fn new(spec: &Spec) -> Option<Self> {
+        let mut tx = Vec::with_capacity(QUEUES);
+        for queue in 0..QUEUES {
+            let (len, slot) = match queue {
+                QUEUE_BCN => (1, BCN_SLOT),
+                QUEUE_BE => (128, TX_SLOT),
+                _ => (64, TX_SLOT),
+            };
+            tx.push(TxRing { bds: dma32(len * TX_BD)?, buffers: dma32(len * slot)?, slot, len, wp: 0 });
+        }
+        let rx = RxRing { bds: dma32(RX_SLOTS * RX_BD)?, buffers: dma32(RX_SLOTS * RX_SLOT)?, rp: 0, tag: 0 };
+        let mask = [
+            IMR_HIGHDOK | IMR_MGNTDOK | IMR_BKDOK | IMR_BEDOK | IMR_VIDOK | IMR_VODOK | IMR_ROK | IMR_BCNDMAINT_E | IMR_C2HCMD,
+            IMR_TXFOVW,
+            0,
+            IMR_H2CDOK,
+        ];
+        Some(Self { tx, rx, mask, tx_desc: spec.tx_desc.min(TX_DESC_MAX), fb_limit: spec.old_datarate_fb_limit, h2c_queue: !spec.wcpu_8051 })
+    }
+
+    /// The TX descriptor's size (its `offset` field).
+    pub(crate) fn tx_desc(&self) -> usize {
+        self.tx_desc
+    }
+
+    /// Linux's `rtw_pci_setup` (`rtw_pci_reset_buf_desc`, `rtw_pci_dma_reset`).
+    pub(crate) fn setup(&mut self, chip: &Chip) {
+        let value = chip.r8(RTK_PCI_CTRL + 3);
+        chip.w8(RTK_PCI_CTRL + 3, value | 0xf7);
+        for (queue, ring) in self.tx.iter_mut().enumerate() {
+            if queue == QUEUE_H2C && !self.h2c_queue {
+                continue;
+            }
+            let (desa, num, _) = registers(queue);
+            ring.wp = 0;
+            for slot in 0..ring.len {
+                let _ = ring.bds.write_bytes(slot * TX_BD, &[0u8; TX_BD]);
+            }
+            if queue != QUEUE_BCN {
+                chip.w16(num, (ring.len as u32 & TRX_BD_IDX_MASK) as u16);
+            }
+            chip.w32(desa, ring.bds.daddr() as u32);
+        }
+        for slot in 0..RX_SLOTS {
+            self.reset_rx(slot);
+        }
+        self.rx.rp = 0;
+        chip.w16(RTK_PCI_RXBD_NUM_MPDUQ, (RX_SLOTS as u32 & TRX_BD_IDX_MASK) as u16);
+        chip.w32(RTK_PCI_RXBD_DESA_MPDUQ, self.rx.bds.daddr() as u32);
+        chip.w32(RTK_PCI_TXBD_RWPTR_CLR, 0xffff_ffff);
+        if self.h2c_queue {
+            chip.set32(RTK_PCI_TXBD_H2CQ_CSR, BIT_CLR_H2CQ_HOST_IDX | BIT_CLR_H2CQ_HW_IDX);
+        }
+        // The DMA's reset and the RX tag.
+        chip.set32(RTK_PCI_CTRL, BIT_RST_TRXDMA_INTF | BIT_RX_TAG_EN);
+        self.rx.tag = 0;
+    }
+
+    fn reset_rx(&mut self, slot: usize) {
+        let mut bd = [0u8; RX_BD];
+        bd[0..2].copy_from_slice(&(RX_BUF as u16).to_le_bytes());
+        let address = (self.rx.buffers.daddr() + slot * RX_SLOT) as u32;
+        bd[4..8].copy_from_slice(&address.to_le_bytes());
+        let _ = self.rx.bds.write_bytes(slot * RX_BD, &bd);
+    }
+
+    pub(crate) fn enable_interrupts(&self, chip: &Chip) {
+        chip.w32(RTK_PCI_HIMR0, self.mask[0]);
+        chip.w32(RTK_PCI_HIMR1, self.mask[1]);
+        if self.h2c_queue {
+            chip.w32(RTK_PCI_HIMR3, self.mask[3]);
+        }
+    }
+
+    pub(crate) fn disable_interrupts(&self, chip: &Chip) {
+        chip.w32(RTK_PCI_HIMR0, 0);
+        chip.w32(RTK_PCI_HIMR1, 0);
+        if self.h2c_queue {
+            chip.w32(RTK_PCI_HIMR3, 0);
+        }
+    }
+
+    /// The interrupt status, cleared (`rtw_pci_irq_recognized`).
+    pub(crate) fn interrupts(&self, chip: &Chip) -> [u32; 4] {
+        let status = [
+            chip.r32(RTK_PCI_HISR0) & self.mask[0],
+            chip.r32(RTK_PCI_HISR1) & self.mask[1],
+            0,
+            if self.h2c_queue { chip.r32(RTK_PCI_HISR3) & self.mask[3] } else { 0 },
+        ];
+        chip.w32(RTK_PCI_HISR0, status[0]);
+        chip.w32(RTK_PCI_HISR1, status[1]);
+        if self.h2c_queue {
+            chip.w32(RTK_PCI_HISR3, status[3]);
+        }
+        status
+    }
+
+    /// The slots of a TX ring the DMA has not taken yet.
+    fn free_slots(&self, chip: &Chip, queue: usize) -> usize {
+        let ring = &self.tx[queue];
+        let (_, _, index) = registers(queue);
+        let rp = ((chip.r32(index) >> 16) & TRX_BD_IDX_MASK) as usize % ring.len;
+        if rp > ring.wp { rp - ring.wp - 1 } else { ring.len - ring.wp + rp - 1 }
+    }
+
+    /// Linux's `rtw_pci_tx_write_data`: the TX descriptor and the frame in
+    /// the slot, the two buffer descriptors, the write index (except the
+    /// beacon queue, which the caller starts).
+    pub(crate) fn write(&mut self, chip: &Chip, queue: usize, info: &TxInfo, data: &[u8]) -> Result<(), ()> {
+        if queue != QUEUE_BCN && self.free_slots(chip, queue) == 0 {
+            return Err(());
+        }
+        let (desc, fb_limit) = (self.tx_desc, self.fb_limit);
+        let ring = &mut self.tx[queue];
+        if desc + data.len() > ring.slot {
+            return Err(());
+        }
+        let slot = ring.wp;
+        let at = slot * ring.slot;
+        ring.buffers.write_bytes(at, &info.descriptor(data.len(), fb_limit)[..desc]).map_err(|_| ())?;
+        ring.buffers.write_bytes(at + desc, data).map_err(|_| ())?;
+        let address = (ring.buffers.daddr() + at) as u32;
+        let total = desc + data.len();
+        let mut psb = ((total - 1) / 128 + 1) as u16;
+        if queue == QUEUE_BCN {
+            psb |= 1 << RTK_PCI_TXBD_OWN_OFFSET;
+        }
+        let mut bd = [0u8; TX_BD];
+        bd[0..2].copy_from_slice(&(desc as u16).to_le_bytes());
+        bd[2..4].copy_from_slice(&psb.to_le_bytes());
+        bd[4..8].copy_from_slice(&address.to_le_bytes());
+        bd[8..10].copy_from_slice(&(data.len() as u16).to_le_bytes());
+        bd[12..16].copy_from_slice(&(address + desc as u32).to_le_bytes());
+        ring.bds.write_bytes(slot * TX_BD, &bd).map_err(|_| ())?;
+        if queue == QUEUE_BCN {
+            return Ok(());
+        }
+        ring.wp = (ring.wp + 1) % ring.len;
+        let (_, _, index) = registers(queue);
+        chip.w16(index, (ring.wp as u32 & TRX_BD_IDX_MASK) as u16);
+        Ok(())
+    }
+
+    /// Linux's `rtw_pci_write_data_rsvd_page`: through the beacon queue.
+    pub(crate) fn write_rsvd_page(&mut self, chip: &Chip, info: &TxInfo, data: &[u8]) -> Result<(), ()> {
+        self.write(chip, QUEUE_BCN, info, data)?;
+        let work = chip.r8(RTK_PCI_TXBD_BCN_WORK);
+        chip.w8(RTK_PCI_TXBD_BCN_WORK, work | BIT_PCI_BCNQ_FLAG as u8);
+        Ok(())
+    }
+
+    /// Linux's `rtw_pci_write_data_h2c` (the 3081 CPU's chips only).
+    pub(crate) fn write_h2c(&mut self, chip: &Chip, packet: &[u8]) -> Result<(), ()> {
+        if !self.h2c_queue {
+            return Err(());
+        }
+        let info = TxInfo { qsel: TX_DESC_QSEL_H2C as u8, ..TxInfo::default() };
+        self.write(chip, QUEUE_H2C, &info, packet)
+    }
+
+    /// The RX ring's packets since the last call (Linux's
+    /// `rtw_pci_rx_napi`): each from its RX descriptor on.
+    pub(crate) fn receive(&mut self, chip: &Chip) -> Vec<Vec<u8>> {
+        let mut out = Vec::new();
+        let hw = ((chip.r32(RTK_PCI_RXBD_IDX_MPDUQ) & TRX_BD_HW_IDX_MASK) >> 16) as usize % RX_SLOTS;
+        let count = if hw >= self.rx.rp { hw - self.rx.rp } else { RX_SLOTS - (self.rx.rp - hw) };
+        for _ in 0..count {
+            let slot = self.rx.rp;
+            // The RX tag says whether the bus delivered every buffer.
+            let mut bd = [0u8; RX_BD];
+            let _ = self.rx.bds.read_bytes(slot * RX_BD, &mut bd);
+            let tag = u16::from_le_bytes([bd[2], bd[3]]);
+            if tag != self.rx.tag {
+                ostd::warn!("{}: PCI bus time-out (RX tag {} instead of {})", chip.name, tag, self.rx.tag);
+            }
+            self.rx.tag = (self.rx.tag + 1) % RX_TAG_MAX;
+            let mut head = [0u8; 24];
+            let _ = self.rx.buffers.read_bytes(slot * RX_SLOT, &mut head);
+            let w0 = u32::from_le_bytes([head[0], head[1], head[2], head[3]]);
+            let length = (w0 & 0x3fff) as usize;
+            let drv_info = (((w0 >> 16) & 0xf) * 8) as usize;
+            let shift = ((w0 >> 24) & 3) as usize;
+            let total = (24 + drv_info + shift + length).min(RX_BUF);
+            let mut packet = vec![0u8; total];
+            let _ = self.rx.buffers.read_bytes(slot * RX_SLOT, &mut packet);
+            out.push(packet);
+            self.reset_rx(slot);
+            self.rx.rp = (self.rx.rp + 1) % RX_SLOTS;
+        }
+        if count > 0 {
+            chip.w16(RTK_PCI_RXBD_IDX_MPDUQ, self.rx.rp as u16);
+        }
+        out
+    }
+}
