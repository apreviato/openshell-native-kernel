+impl Model {
+    pub(crate) fn spec(self) -> &'static Spec {
+        match self {
+            Model::Rtl8821c => &SPEC_8821C,
+            Model::Rtl8822b => &SPEC_8822B,
+            Model::Rtl8822c => &SPEC_8822C,
+            Model::Rtl8723d => &SPEC_8723D,
+        }
+    }
+
+    pub(crate) fn firmware(self) -> &'static str {
+        self.spec().firmware
+    }
+}
