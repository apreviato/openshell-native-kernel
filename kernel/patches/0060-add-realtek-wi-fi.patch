+pub(crate) const REG_RXDMA_MODE: u32 = 0x0290;
+pub(crate) const BIT_DMA_MODE: u32 = 1 << 1;
+pub(crate) const BIT_DMA_BURST_CNT: u32 = 0x3 << 2;
+pub(crate) const BIT_DMA_BURST_SIZE_SHIFT: u32 = 4;
+pub(crate) const BIT_DMA_BURST_SIZE_64: u32 = 2;
+pub(crate) const BIT_DMA_BURST_SIZE_512: u32 = 1;
+pub(crate) const BIT_DMA_BURST_SIZE_1024: u32 = 0;
+pub(crate) const REG_USB3_PHY_ADR: u32 = 0xff0c;
+pub(crate) const REG_USB3_PHY_DAT_L: u32 = 0xff0d;
+pub(crate) const REG_USB3_PHY_DAT_H: u32 = 0xff0e;
+pub(crate) const BIT_USB3_PHY_ADR_WR: u32 = 1 << 7;
+/// The RPWM register on USB (`hci.rpwm_addr`).
+pub(crate) const RPWM_ADDR_USB: u32 = 0xfe58;
+
+/// The chip's registers over USB.
+pub(crate) struct UsbRegs {
+    interface: Arc<UsbInterface>,
+    /// `rtw_usb_reg_sec` applies (the 8822B, 8822C and 8821C).
+    reg_sec: bool,
+    errors: AtomicU32,
+}
+
+impl UsbRegs {
+    pub(crate) fn new(interface: Arc<UsbInterface>, reg_sec: bool) -> Self {
+        Self { interface, reg_sec, errors: AtomicU32::new(0) }
+    }
+
+    /// `rtw_usb_read`: all ones when the device does not answer.
+    pub(crate) fn read(&self, addr: u32, len: usize) -> u32 {
+        match self.interface.control_in(VENDOR, REQUEST, addr as u16, 0, len, READ_TIMEOUT_MS) {
+            Ok(data) if data.len() >= len => {
+                let mut bytes = [0u8; 4];
+                bytes[..len].copy_from_slice(&data[..len]);
+                let value = u32::from_le_bytes(bytes);
+                self.reg_sec(addr, value);
+                value
+            }
+            _ => {
+                self.failed();
+                u32::MAX >> (32 - 8 * len as u32)
+            }
+        }
+    }
+
+    /// `rtw_usb_write`.
+    pub(crate) fn write(&self, addr: u32, value: u32, len: usize) {
+        if self.interface.control_out(VENDOR, REQUEST, addr as u16, 0, &value.to_le_bytes()[..len], WRITE_TIMEOUT_MS).is_err() {
+            self.failed();
+        }
+        self.reg_sec(addr, value);
+    }
+
+    /// Bytes at once from `addr` on (`rtw_usb_write_firmware_page`'s
+    /// blocks).
+    pub(crate) fn write_block(&self, addr: u32, data: &[u8]) -> bool {
+        self.interface.control_out(VENDOR, REQUEST, addr as u16, 0, data, WRITE_TIMEOUT_MS).is_ok()
+    }
+
+    /// The always-on section's accesses echoed to 0x4e0.
+    fn reg_sec(&self, addr: u32, value: u32) {
+        if self.reg_sec && (addr <= 0xff || (0x1000..=0x10ff).contains(&addr)) {
+            let _ = self.interface.control_out(VENDOR, REQUEST, REG_SEC, 0, &[value as u8], WRITE_TIMEOUT_MS);
+        }
+    }
+
+    fn failed(&self) {
+        if self.errors.fetch_add(1, Ordering::Relaxed) < 4 && !self.interface.is_gone() {
+            ostd::warn!("a register access over USB failed");
+        }
+    }
+
+    pub(crate) fn gone(&self) -> bool {
+        self.interface.is_gone()
+    }
+}
+
+/// `rtw_dma_mapping` to the index of the bulk OUT endpoint
+/// (`dma_mapping_to_ep`): high 0, normal 1, low 2, extra 3.
+fn endpoint_index(mapping: u32) -> usize {
+    match mapping {
+        RTW_DMA_MAPPING_HIGH => 0,
+        RTW_DMA_MAPPING_NORMAL => 1,
+        RTW_DMA_MAPPING_LOW => 2,
+        _ => 3,
+    }
+}
+
+/// The queues' DMA mapping by the number of bulk OUT endpoints
+/// (`rqpn_table[2..=4]`, the same on every rtw88 chip): VO, VI, BE, BK,
+/// management, high.
+pub(crate) fn rqpn(bulk_out: usize) -> [u32; 6] {
+    use crate::regs::{
+        RTW_DMA_MAPPING_EXTRA as EXTRA, RTW_DMA_MAPPING_HIGH as HIGH, RTW_DMA_MAPPING_LOW as LOW, RTW_DMA_MAPPING_NORMAL as NORMAL,
+    };
+    match bulk_out {
+        2 => [NORMAL, NORMAL, NORMAL, HIGH, HIGH, HIGH],
+        3 => [NORMAL, NORMAL, LOW, LOW, HIGH, HIGH],
+        _ => [NORMAL, NORMAL, LOW, LOW, EXTRA, HIGH],
+    }
+}
+
+/// The USB side of a chip.
+pub(crate) struct Usb {
+    interface: Arc<UsbInterface>,
+    bulk_in: u8,
+    bulk_out: Vec<u8>,
+    /// Each TX queue's endpoint (`qsel_to_ep`).
+    qsel_endpoint: [Option<u8>; TX_DESC_QSEL_H2C as usize + 1],
+    rx: VecDeque<Transfer>,
+    tx: VecDeque<Transfer>,
+    /// A TX transfer ended since the last look.
+    tx_progress: bool,
+    /// The reads wait for frames (after the chip is up), and when one that
+    /// failed is submitted again.
+    receiving: bool,
+    rx_retry_at: u64,
+    notify: Notify,
+    tx_desc: usize,
+    fb_limit: bool,
+    /// The descriptor's checksum: the 16-bit words it covers, and whether
+    /// it is inverted (the 8723D's).
+    checksum: (usize, bool),
+    pub(crate) speed: u32,
+}
+
+impl Usb {
+    /// `rtw_usb_parse`: the bulk IN endpoint and the OUT ones in order.
+    pub(crate) fn new(interface: Arc<UsbInterface>, spec: &Spec, notify: Notify) -> Result<Self, String> {
+        let mut bulk_in = None;
+        let mut bulk_out = Vec::new();
+        for endpoint in interface.endpoints.iter().filter(|endpoint| !endpoint.interrupt) {
+            if endpoint.is_in() {
+                bulk_in.get_or_insert(endpoint.address);
+            } else {
+                bulk_out.push(endpoint.address);
+            }
+        }
+        let bulk_in = bulk_in.ok_or_else(|| String::from("no bulk IN endpoint"))?;
+        if !(1..=4).contains(&bulk_out.len()) {
+            return Err(format!("{} bulk OUT endpoints", bulk_out.len()));
+        }
+        let [vo, vi, be, bk, mg, hi] = rqpn(bulk_out.len());
+        let endpoint = |mapping: u32| bulk_out.get(endpoint_index(mapping)).or(bulk_out.last()).copied();
+        let mut qsel_endpoint = [None; TX_DESC_QSEL_H2C as usize + 1];
+        for (qsel, mapping) in [
+            (TX_DESC_QSEL_TID0, be),
+            (TX_DESC_QSEL_TID1, bk),
+            (TX_DESC_QSEL_TID2, bk),
+            (TX_DESC_QSEL_TID3, be),
+            (TX_DESC_QSEL_TID4, vi),
+            (TX_DESC_QSEL_TID5, vi),
+            (TX_DESC_QSEL_TID6, vo),
+            (TX_DESC_QSEL_TID7, vo),
+            (TX_DESC_QSEL_BEACON, hi),
+            (TX_DESC_QSEL_HIGH, hi),
+            (TX_DESC_QSEL_MGMT, mg),
+            (TX_DESC_QSEL_H2C, hi),
+        ] {
+            qsel_endpoint[qsel as usize] = endpoint(mapping);
+        }
+        let speed = interface.speed;
+        Ok(Self {
+            interface,
+            bulk_in,
+            bulk_out,
+            qsel_endpoint,
+            rx: VecDeque::new(),
+            tx: VecDeque::new(),
+            tx_progress: false,
+            receiving: false,
+            rx_retry_at: 0,
+            notify,
+            tx_desc: spec.tx_desc.min(TX_DESC_MAX),
+            fb_limit: spec.old_datarate_fb_limit,
+            checksum: spec.usb_checksum,
+            speed,
+        })
+    }
+
+    pub(crate) fn bulk_out(&self) -> usize {
+        self.bulk_out.len()
+    }
+
+    pub(crate) fn tx_desc(&self) -> usize {
+        self.tx_desc
+    }
+
+    /// Nothing to reset on USB (PCIe's rings are).
+    pub(crate) fn setup(&mut self) {}
+
+    /// The reads that wait for frames, once the chip is up
+    /// (`rtw_usb_setup_rx`).
+    pub(crate) fn start_rx(&mut self) {
+        self.receiving = true;
+        self.top_up();
+    }
+
+    fn top_up(&mut self) {
+        if !self.receiving || crate::now_ms() < self.rx_retry_at || self.interface.is_gone() {
+            return;
+        }
+        while self.rx.len() < RX_TRANSFERS {
+            match self.interface.submit_read(self.bulk_in, RX_BUF, Some(self.notify.clone())) {
+                Ok(transfer) => self.rx.push_back(transfer),
+                Err(_) => break,
+            }
+        }
+    }
+
+    /// The descriptor and the frame, the descriptor's checksum filled
+    /// (`rtw_usb_write_data`, `rtw_tx_fill_txdesc_checksum`).
+    fn packet(&self, info: &TxInfo, data: &[u8]) -> Vec<u8> {
+        let mut packet = Vec::with_capacity(self.tx_desc + data.len() + 1);
+        packet.extend_from_slice(&info.descriptor(data.len(), self.fb_limit)[..self.tx_desc]);
+        let (words, invert) = self.checksum;
+        packet[28..30].fill(0);
+        let mut sum = 0u16;
+        for word in packet[..(2 * words).min(self.tx_desc)].chunks(2) {
+            sum ^= u16::from_le_bytes([word[0], word[1]]);
+        }
+        if invert {
+            sum = !sum;
+        }
+        packet[28..30].copy_from_slice(&sum.to_le_bytes());
+        packet.extend_from_slice(data);
+        packet
+    }
+
+    fn endpoint_of(&self, qsel: u8) -> Result<u8, ()> {
+        self.qsel_endpoint.get(qsel as usize).copied().flatten().ok_or(())
+    }
+
+    /// Forgets the TX transfers that ended.
+    fn reap(&mut self) {
+        while self.tx.front().is_some_and(|transfer| transfer.result().is_some()) {
+            self.tx.pop_front();
+            self.tx_progress = true;
+        }
+    }
+
+    /// A frame on its queue's endpoint (`rtw_usb_tx_write`); `Err` when too
+    /// many are in flight.
+    pub(crate) fn write(&mut self, info: &TxInfo, data: &[u8]) -> Result<(), ()> {
+        self.reap();
+        if self.tx.len() >= TX_IN_FLIGHT {
+            return Err(());
+        }
+        let endpoint = self.endpoint_of(info.qsel)?;
+        let packet = self.packet(info, data);
+        let transfer = self.interface.submit_write(endpoint, &packet, true, Some(self.notify.clone())).map_err(|_| ())?;
+        self.tx.push_back(transfer);
+        Ok(())
+    }
+
+    /// Sends and waits: the reserved pages and the H2C packets, whose
+    /// effect the driver checks next (`rtw_usb_write_data_rsvd_page`,
+    /// `rtw_usb_write_data_h2c`).
+    pub(crate) fn write_now(&mut self, info: &TxInfo, data: &[u8]) -> Result<(), ()> {
+        let endpoint = self.endpoint_of(info.qsel)?;
+        let packet = self.packet(info, data);
+        self.interface.write(endpoint, &packet, true, WRITE_TIMEOUT_MS).map(|_| ()).map_err(|_| ())
+    }
+
+    /// Whether a TX transfer ended since the last call.
+    pub(crate) fn tx_progress(&mut self) -> bool {
+        self.reap();
+        core::mem::take(&mut self.tx_progress)
+    }
+
+    /// The packets the reads brought, each from its RX descriptor on, as
+    /// the PCIe ring gives them (`rtw_usb_rx_handler`); each read that ended
+    /// is submitted again.
+    pub(crate) fn receive(&mut self) -> Vec<Vec<u8>> {
+        let mut out = Vec::new();
+        while self.rx.front().is_some_and(|transfer| transfer.result().is_some()) {
+            let Some(transfer) = self.rx.pop_front() else { break };
+            let Some((status, _)) = transfer.result() else { break };
+            if status >= 0 {
+                split(&transfer.data(), &mut out);
+            } else {
+                // A read that failed is not submitted again at once.
+                self.rx_retry_at = crate::now_ms() + RX_RETRY_MS;
+            }
+        }
+        self.top_up();
+        out
+    }
+
+    /// Cancels what is pending (`rtw_usb_cancel_rx_bufs`).
+    pub(crate) fn stop(&mut self) {
+        for transfer in self.rx.drain(..).chain(self.tx.drain(..)) {
+            transfer.cancel();
+        }
+    }
+}
+
+/// An aggregate's packets: each its RX descriptor, driver info, shift and
+/// body, the next at the following eight-byte boundary.
+fn split(buffer: &[u8], out: &mut Vec<Vec<u8>>) {
+    let mut at = 0;
+    while at + RX_DESC <= buffer.len() {
+        let w0 = u32::from_le_bytes([buffer[at], buffer[at + 1], buffer[at + 2], buffer[at + 3]]);
+        let length = (w0 & 0x3fff) as usize;
+        let drv_info = (((w0 >> 16) & 0xf) * 8) as usize;
+        let shift = ((w0 >> 24) & 3) as usize;
+        let total = RX_DESC + drv_info + shift + length;
+        if length == 0 || at + total > buffer.len() {
+            break;
+        }
+        out.push(buffer[at..at + total].to_vec());
+        at += total.next_multiple_of(8);
+    }
+}
diff --git a/kernel/comps/usb/src/driver.rs b/kernel/comps/usb/src/driver.rs
new file mode 100755
index 0000000..dc9f605
--- /dev/null
+++ b/kernel/comps/usb/src/driver.rs
@@ -0,0 +1,264 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! USB functions driven by other components (Wi-Fi adapters): a driver
+//! registers the devices it takes; each interface of theirs no driver of
+//! this component took and no program claimed goes to it, in a kernel
+//! thread of its own, as a [`UsbInterface`]. It then moves data as
+//! programs do (`crate::usbfs`): control transfers on the default
+//! endpoint, bulk and interrupt ones on the interface's endpoints, waited
+//! for or submitted and collected later, on the controller's task. The
+//! interface is the kernel's from then on: programs may not claim it.
+//!
+//! Devices that come later are offered as they come; those already there
+//! when a driver registers, at once.
+
+use alloc::{
+    sync::{Arc, Weak},
+    vec::Vec,
+};
+
+use ostd::sync::SpinLock;
+
+use crate::{
+    desc::{Endpoint, TRANSFER_BULK, TRANSFER_INTERRUPT},
+    usbfs::{Request, URB_ZERO_PACKET, Urb, UsbDevice, errno, urb_type},
+};
+
+/// What a driver sees of an interface before taking it.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct InterfaceInfo {
+    pub vendor: u16,
+    pub product: u16,
+    pub number: u8,
+    pub class: u8,
+    pub subclass: u8,
+    pub protocol: u8,
+}
+
+/// A driver of USB functions in another component.
+pub trait UsbDriver: Send + Sync {
+    /// For the log, and as the interface's driver for programs.
+    fn name(&self) -> &'static str;
+    /// Whether it drives this interface.
+    fn matches(&self, info: &InterfaceInfo) -> bool;
+    /// Takes the interface; called in a kernel thread of its own, which the
+    /// driver may keep.
+    fn probe(&self, interface: UsbInterface);
+}
+
+/// A transfer's direction and kind, as an endpoint has them.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct EndpointInfo {
+    /// Number and direction (bit 7: IN).
+    pub address: u8,
+    /// Bulk or interrupt.
+    pub interrupt: bool,
+    pub max_packet: u16,
+}
+
+impl EndpointInfo {
+    pub fn is_in(&self) -> bool {
+        self.address & 0x80 != 0
+    }
+}
+
+/// Why a transfer did not complete: the negative errno usbfs gives
+/// programs (-ENODEV and -ESHUTDOWN: the device is gone; -EPIPE: the
+/// endpoint halted; -ETIMEDOUT; -ENOENT: cancelled).
+pub type Status = i32;
+
+/// The device is gone (or never was).
+pub const GONE: Status = -(errno::ENODEV);
+
+/// An interface a driver took.
+pub struct UsbInterface {
+    device: Arc<UsbDevice>,
+    pub info: InterfaceInfo,
+    /// The endpoints of its first alternate setting.
+    pub endpoints: Vec<EndpointInfo>,
+    /// The device's xHCI speed (1 full, 2 low, 3 high, 4 and up
+    /// SuperSpeed).
+    pub speed: u32,
+}
+
+impl UsbInterface {
+    /// The device was unplugged.
+    pub fn is_gone(&self) -> bool {
+        self.device.is_gone()
+    }
+
+    /// A control transfer that reads up to `length` bytes.
+    pub fn control_in(&self, request_type: u8, request: u8, value: u16, index: u16, length: usize, timeout_ms: u32) -> Result<Vec<u8>, Status> {
+        let setup = setup(request_type | 0x80, request, value, index, length);
+        let urb = Urb::kernel(&self.device, urb_type::CONTROL, self.device.ep0(), 0, setup, length, None, timeout_ms, None)?;
+        let (status, actual) = urb.run();
+        if status < 0 {
+            return Err(status);
+        }
+        Ok(urb.read_data(actual))
+    }
+
+    /// A control transfer that writes `data`.
+    pub fn control_out(&self, request_type: u8, request: u8, value: u16, index: u16, data: &[u8], timeout_ms: u32) -> Result<(), Status> {
+        let setup = setup(request_type & 0x7f, request, value, index, data.len());
+        let urb = Urb::kernel(&self.device, urb_type::CONTROL, self.device.ep0(), 0, setup, data.len(), Some(data), timeout_ms, None)?;
+        let (status, _) = urb.run();
+        if status < 0 { Err(status) } else { Ok(()) }
+    }
+
+    fn endpoint(&self, address: u8) -> Result<(u8, Endpoint), Status> {
+        let (_, endpoint) = self.device.find_endpoint(address).ok_or(-(errno::ENOENT))?;
+        let kind = match endpoint.transfer_type() {
+            TRANSFER_BULK => urb_type::BULK,
+            TRANSFER_INTERRUPT => urb_type::INTERRUPT,
+            _ => return Err(-(errno::EINVAL)),
+        };
+        Ok((kind, endpoint))
+    }
+
+    /// Writes `data` to an OUT endpoint, waited for; with `zero_packet`, a
+    /// transfer that fills its last packet ends with an empty one.
+    pub fn write(&self, address: u8, data: &[u8], zero_packet: bool, timeout_ms: u32) -> Result<usize, Status> {
+        let (kind, endpoint) = self.endpoint(address)?;
+        let flags = if zero_packet { URB_ZERO_PACKET } else { 0 };
+        let urb = Urb::kernel(&self.device, kind, endpoint, flags, [0; 8], data.len(), Some(data), timeout_ms, None)?;
+        let (status, actual) = urb.run();
+        if status < 0 { Err(status) } else { Ok(actual) }
+    }
+
+    /// Reads up to `length` bytes from an IN endpoint, waited for.
+    pub fn read(&self, address: u8, length: usize, timeout_ms: u32) -> Result<Vec<u8>, Status> {
+        let (kind, endpoint) = self.endpoint(address)?;
+        let urb = Urb::kernel(&self.device, kind, endpoint, 0, [0; 8], length, None, timeout_ms, None)?;
+        let (status, actual) = urb.run();
+        if status < 0 {
+            return Err(status);
+        }
+        Ok(urb.read_data(actual))
+    }
+
+    /// Submits a read of up to `length` bytes from an IN endpoint;
+    /// `notify` is called (from the controller's task: briefly, without
+    /// sleeping) when it completes.
+    pub fn submit_read(&self, address: u8, length: usize, notify: Option<Notify>) -> Result<Transfer, Status> {
+        let (kind, endpoint) = self.endpoint(address)?;
+        let urb = Urb::kernel(&self.device, kind, endpoint, 0, [0; 8], length, None, 0, notify)?;
+        self.device.host.ask(Request::Submit(urb.clone()));
+        Ok(Transfer(urb))
+    }
+
+    /// Submits a write of `data` to an OUT endpoint; as `submit_read`.
+    pub fn submit_write(&self, address: u8, data: &[u8], zero_packet: bool, notify: Option<Notify>) -> Result<Transfer, Status> {
+        let (kind, endpoint) = self.endpoint(address)?;
+        let flags = if zero_packet { URB_ZERO_PACKET } else { 0 };
+        let urb = Urb::kernel(&self.device, kind, endpoint, flags, [0; 8], data.len(), Some(data), 0, notify)?;
+        self.device.host.ask(Request::Submit(urb.clone()));
+        Ok(Transfer(urb))
+    }
+}
+
+/// Called when a submitted transfer completes.
+pub type Notify = Arc<dyn Fn() + Send + Sync>;
+
+/// A transfer submitted and not yet collected.
+pub struct Transfer(Arc<Urb>);
+
+impl Transfer {
+    /// Its end, once it ended: the status (0 or a negative errno) and the
+    /// bytes moved.
+    pub fn result(&self) -> Option<(Status, usize)> {
+        self.0.result()
+    }
+
+    /// Waits for its end.
+    pub fn wait(&self) -> (Status, usize) {
+        self.0.wait()
+    }
+
+    /// What a read brought, once ended.
+    pub fn data(&self) -> Vec<u8> {
+        match self.0.result() {
+            Some((status, actual)) if status >= 0 => self.0.read_data(actual),
+            _ => Vec::new(),
+        }
+    }
+
+    /// Ends it early (it completes with -ENOENT).
+    pub fn cancel(&self) {
+        if self.0.result().is_none() {
+            self.0.device.host.ask(Request::Cancel(self.0.clone()));
+        }
+    }
+}
+
+fn setup(request_type: u8, request: u8, value: u16, index: u16, length: usize) -> [u8; 8] {
+    let mut setup = [0u8; 8];
+    setup[0] = request_type;
+    setup[1] = request;
+    setup[2..4].copy_from_slice(&value.to_le_bytes());
+    setup[4..6].copy_from_slice(&index.to_le_bytes());
+    setup[6..8].copy_from_slice(&(length.min(0xffff) as u16).to_le_bytes());
+    setup
+}
+
+static DRIVERS: SpinLock<Vec<Arc<dyn UsbDriver>>> = SpinLock::new(Vec::new());
+/// The devices given to programs (and drivers), for drivers that register
+/// later.
+static DEVICES: SpinLock<Vec<Weak<UsbDevice>>> = SpinLock::new(Vec::new());
+
+/// Registers a driver: the interfaces it matches are offered to it, those
+/// of devices already there at once.
+pub fn register_driver(driver: Arc<dyn UsbDriver>) {
+    DRIVERS.lock().push(driver.clone());
+    let devices: Vec<Arc<UsbDevice>> = {
+        let mut devices = DEVICES.lock();
+        devices.retain(|device| device.strong_count() > 0);
+        devices.iter().filter_map(Weak::upgrade).collect()
+    };
+    for device in devices {
+        offer(&device, core::slice::from_ref(&driver));
+    }
+}
+
+/// A device was given to programs: its free interfaces go to the drivers
+/// that match them.
+pub(crate) fn published(device: &Arc<UsbDevice>) {
+    DEVICES.lock().push(Arc::downgrade(device));
+    let drivers = DRIVERS.lock().clone();
+    offer(device, &drivers);
+}
+
+fn offer(device: &Arc<UsbDevice>, drivers: &[Arc<dyn UsbDriver>]) {
+    if drivers.is_empty() || device.slot_id == 0 || device.is_gone() {
+        return;
+    }
+    let (vendor, product) = device.ids();
+    for interface in device.free_interfaces() {
+        let info = InterfaceInfo {
+            vendor,
+            product,
+            number: interface.number,
+            class: interface.class,
+            subclass: interface.subclass,
+            protocol: interface.protocol,
+        };
+        let Some(driver) = drivers.iter().find(|driver| driver.matches(&info)) else { continue };
+        if !device.take_interface(interface.number, driver.name()) {
+            continue;
+        }
+        ostd::notice!("{}: interface {} goes to {}", device.name, interface.number, driver.name());
+        let endpoints = interface
+            .endpoints
