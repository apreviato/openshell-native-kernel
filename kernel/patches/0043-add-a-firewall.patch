@@ -2,6 +2,7 @@
 
 mod common;
 mod dhcp;
+pub mod firewall;
 #[expect(clippy::module_inception)]
 mod iface;
 mod packet_slice;
@@ -49,6 +50,69 @@ pub(crate) fn frame_tap() -> Option<fn(u32, &[u8])> {
 static FRAME_TAP: spin::Once<fn(u32, &[u8])> = spin::Once::new();
 static TAPPING: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
 
+/// The firewall in force, if it is on (`firewall`).
+static FIREWALL: ostd::sync::SpinLock<Option<firewall::Firewall>, ostd::sync::LocalIrqDisabled> = ostd::sync::SpinLock::new(None);
+/// Whether it is on: read before every judgement, without the lock.
+static FIREWALL_ON: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
+
+/// Puts the rules of `text` in force (an empty text: the firewall off).
+/// Nothing changes if the text is not a set of rules.
+pub fn set_firewall(text: &str) -> Result<(), ()> {
+    let ruleset = firewall::Ruleset::parse(text)?;
+    let mut current = FIREWALL.lock();
+    FIREWALL_ON.store(ruleset.is_some(), core::sync::atomic::Ordering::Release);
+    *current = ruleset.map(firewall::Firewall::new);
+    Ok(())
+}
+
+/// The rules in force, as their text (empty: the firewall is off).
+pub fn firewall_text() -> alloc::string::String {
+    FIREWALL.lock().as_ref().map(|firewall| firewall.ruleset().text()).unwrap_or_default()
+}
+
+fn firewall_address(address: smoltcp::wire::IpAddress) -> firewall::Address {
+    match address {
+        smoltcp::wire::IpAddress::Ipv4(address) => firewall::Address::V4(address.octets()),
+        smoltcp::wire::IpAddress::Ipv6(address) => firewall::Address::V6(address.octets()),
+    }
+}
+
+fn firewall_now() -> u64 {
+    time::get_network_timestamp().total_millis() as u64
+}
+
+/// What becomes of a request for a new TCP connection from elsewhere.
+pub(crate) fn firewall_tcp(source: smoltcp::wire::IpAddress, port: u16) -> firewall::Verdict {
+    if !FIREWALL_ON.load(core::sync::atomic::Ordering::Acquire) {
+        return firewall::Verdict::Accept;
+    }
+    match FIREWALL.lock().as_mut() {
+        Some(firewall) => firewall.tcp_connection(&firewall_address(source), port, firewall_now()),
+        None => firewall::Verdict::Accept,
+    }
+}
+
+/// What becomes of a UDP datagram from elsewhere.
+pub(crate) fn firewall_udp(source: smoltcp::wire::IpAddress, source_port: u16, port: u16) -> firewall::Verdict {
+    if !FIREWALL_ON.load(core::sync::atomic::Ordering::Acquire) {
+        return firewall::Verdict::Accept;
+    }
+    match FIREWALL.lock().as_mut() {
+        Some(firewall) => firewall.udp_datagram(&firewall_address(source), source_port, port, firewall_now()),
+        None => firewall::Verdict::Accept,
+    }
+}
+
+/// The host sent a UDP datagram to elsewhere: the answers pass.
+pub(crate) fn firewall_udp_sent(port: u16, remote: smoltcp::wire::IpAddress, remote_port: u16) {
+    if !FIREWALL_ON.load(core::sync::atomic::Ordering::Acquire) {
+        return;
+    }
+    if let Some(firewall) = FIREWALL.lock().as_mut() {
+        firewall.udp_sent(port, &firewall_address(remote), remote_port, firewall_now());
+    }
+}
+
 pub(crate) fn bump_config_generation() {
     CONFIG_GENERATION.fetch_add(1, core::sync::atomic::Ordering::AcqRel);
 }
