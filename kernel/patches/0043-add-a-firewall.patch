+    /// One write is the whole set of rules, which replaces the one in
+    /// force; a text that is not one changes nothing.
+    fn write_at(&self, offset: usize, reader: &mut VmReader) -> Result<usize> {
+        let length = reader.remain();
+        if offset != 0 || length > MAX_FIREWALL_TEXT {
+            return_errno_with_message!(Errno::EINVAL, "the firewall's rules are written whole, in one write");
+        }
+        let mut bytes = vec![0u8; length];
+        reader.read_fallible(&mut VmWriter::from(bytes.as_mut_slice()))?;
+        let text = core::str::from_utf8(&bytes).map_err(|_| Error::with_message(Errno::EINVAL, "the rules are not text"))?;
