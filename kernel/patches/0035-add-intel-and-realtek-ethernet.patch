@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! A ring of 16-byte DMA descriptors with a 2 KiB buffer each, the shape
+//! both families use (their descriptors' fields differ).
+
+use alloc::sync::Arc;
+use core::sync::atomic::{AtomicUsize, Ordering};
+
+use ostd::mm::{HasDaddr, PAGE_SIZE, VmIo, dma::DmaCoherent};
+
+pub(crate) const DESCRIPTOR: usize = 16;
+pub(crate) const BUFFER: usize = 2048;
+
+pub(crate) struct Ring {
+    pub(crate) descriptors: Arc<DmaCoherent>,
+    buffers: DmaCoherent,
+    pub(crate) count: usize,
+    /// The next descriptor to look at (shared with the timer for receive rings).
+    pub(crate) next: Arc<AtomicUsize>,
+}
+
+impl Ring {
+    pub(crate) fn new(count: usize) -> Option<Self> {
+        let descriptor_pages = (count * DESCRIPTOR).div_ceil(PAGE_SIZE);
+        let buffer_pages = (count * BUFFER).div_ceil(PAGE_SIZE);
+        Some(Self {
+            descriptors: Arc::new(DmaCoherent::alloc(descriptor_pages, true).ok()?),
+            buffers: DmaCoherent::alloc(buffer_pages, true).ok()?,
+            count,
+            next: Arc::new(AtomicUsize::new(0)),
+        })
+    }
+
+    pub(crate) fn base(&self) -> u64 {
+        self.descriptors.daddr() as u64
+    }
+
+    pub(crate) fn bytes(&self) -> usize {
+        self.count * DESCRIPTOR
+    }
+
+    pub(crate) fn buffer_address(&self, index: usize) -> u64 {
+        (self.buffers.daddr() + index * BUFFER) as u64
+    }
+
+    pub(crate) fn read32(&self, index: usize, offset: usize) -> u32 {
+        self.descriptors.read_val(index * DESCRIPTOR + offset).unwrap_or(0)
+    }
+
+    pub(crate) fn read8(&self, index: usize, offset: usize) -> u8 {
+        self.descriptors.read_val(index * DESCRIPTOR + offset).unwrap_or(0)
+    }
+
+    pub(crate) fn read16(&self, index: usize, offset: usize) -> u16 {
+        self.descriptors.read_val(index * DESCRIPTOR + offset).unwrap_or(0)
+    }
+
+    pub(crate) fn write32(&self, index: usize, offset: usize, value: u32) {
+        let _ = self.descriptors.write_val(index * DESCRIPTOR + offset, &value);
+    }
+
+    pub(crate) fn write64(&self, index: usize, offset: usize, value: u64) {
+        let _ = self.descriptors.write_val(index * DESCRIPTOR + offset, &value);
+    }
+
+    pub(crate) fn write8(&self, index: usize, offset: usize, value: u8) {
+        let _ = self.descriptors.write_val(index * DESCRIPTOR + offset, &value);
+    }
+
+    pub(crate) fn write16(&self, index: usize, offset: usize, value: u16) {
+        let _ = self.descriptors.write_val(index * DESCRIPTOR + offset, &value);
+    }
+
+    pub(crate) fn read_buffer(&self, index: usize, length: usize) -> alloc::vec::Vec<u8> {
+        let mut data = alloc::vec![0u8; length.min(BUFFER)];
+        let _ = self.buffers.read_bytes(index * BUFFER, &mut data);
+        data
+    }
+
+    pub(crate) fn write_buffer(&self, index: usize, data: &[u8]) {
+        let _ = self.buffers.write_bytes(index * BUFFER, &data[..data.len().min(BUFFER)]);
+    }
+
+    pub(crate) fn next(&self) -> usize {
+        self.next.load(Ordering::Acquire)
+    }
+
+    pub(crate) fn advance(&self) {
+        self.next.store((self.next() + 1) % self.count, Ordering::Release);
+    }
+}
