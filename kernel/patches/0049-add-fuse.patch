+/// The options a FUSE mount needs, as libfuse writes them (`fd=`,
+/// `rootmode=`, `user_id=`, `group_id=`); the others are accepted.
+struct FuseMountOptions {
+    fd: i32,
+    root_mode: u32,
+    user_id: u32,
+    group_id: u32,
+}
+
+impl FuseMountOptions {
+    fn parse(args: &str) -> Result<Self> {
+        let (mut fd, mut root_mode, mut user_id, mut group_id) = (None, None, None, None);
+        for option in args.split(',') {
+            let Some((key, value)) = option.split_once('=') else {
+                continue;
+            };
+            let invalid = || Error::with_message(Errno::EINVAL, "a FUSE mount option is invalid");
+            match key {
+                "fd" => fd = Some(value.parse::<i32>().map_err(|_| invalid())?),
+                "rootmode" => root_mode = Some(u32::from_str_radix(value, 8).map_err(|_| invalid())?),
+                "user_id" => user_id = Some(value.parse::<u32>().map_err(|_| invalid())?),
+                "group_id" => group_id = Some(value.parse::<u32>().map_err(|_| invalid())?),
+                _ => {}
+            }
+        }
+        match (fd, root_mode, user_id, group_id) {
+            (Some(fd), Some(root_mode), Some(user_id), Some(group_id)) => Ok(Self {
+                fd,
+                root_mode,
+                user_id,
+                group_id,
+            }),
+            _ => return_errno_with_message!(
+                Errno::EINVAL,
+                "a FUSE mount needs fd, rootmode, user_id and group_id"
+            ),
+        }
+    }
+}
