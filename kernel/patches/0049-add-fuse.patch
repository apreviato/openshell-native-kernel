+    put(40 + 64, &2u32.to_ne_bytes()); // nlink
+    put(40 + 68, &options.user_id.to_ne_bytes()); // uid
+    put(40 + 72, &options.group_id.to_ne_bytes()); // gid
+    put(40 + 80, &(BLOCK_SIZE as u32).to_ne_bytes()); // blksize
