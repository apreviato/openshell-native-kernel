new file mode 100755
index 0000000..09bb3bf
--- /dev/null
+++ b/kernel/core/comps/virtio/src/device/filesystem/device/channel.rs
@@ -0,0 +1,235 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! A FUSE connection whose server runs in user space (`/dev/fuse`).
+//!
+//! The server's file is the device the requests go to: the server reads
+//! each request whole and writes each reply whole, in any order; a request
+//! that has no reply (`FUSE_FORGET`) ends once it is read. When the file is
+//! closed, the requests still waiting end with `ENOTCONN`, as do the later
+//! ones, and the mount answers so until it is taken away.
+
+use alloc::{
+    boxed::Box,
+    collections::{BTreeMap, VecDeque},
+    vec,
+    vec::Vec,
+};
+
+use aster_fuse::{FuseError, ReplyHeader};
+use ostd::{
+    mm::{Fallible, FallibleVmRead, FallibleVmWrite, VmReader, VmWriter},
+    sync::{LocalIrqDisabled, SpinLock},
+};
+use spin::Once;
+
+use super::request::FuseRequest;
+
+/// `ENOTCONN`, as FUSE replies carry errors (negated).
+const ENOTCONN: i32 = 107;
+/// `EIO`.
+const EIO: i32 = 5;
+
+/// The longest reply a server may write (a `FUSE_READ` of the largest size
+/// this side asks for, with room to spare).
+const MAX_REPLY_LEN: usize = 4 << 20;
+
+/// A connection to a FUSE server in user space.
+pub struct FuseChannel {
+    state: SpinLock<ChannelState, LocalIrqDisabled>,
+    /// Told when a request waits to be read, or the connection ends (the
+    /// file's readers wake).
+    on_change: Once<Box<dyn Fn() + Send + Sync>>,
+}
+
+struct ChannelState {
+    /// Requests the server has not read yet, oldest first.
+    pending: VecDeque<FuseRequest>,
+    /// Requests read and waiting for their reply, by their unique ID.
+    in_flight: BTreeMap<u64, FuseRequest>,
+    aborted: bool,
+}
+
+/// Why a read or a write of the server's file failed.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ChannelError {
+    /// No request is waiting (`EAGAIN`).
+    Empty,
+    /// The connection ended (`ENODEV`).
+    Aborted,
+    /// The buffer cannot hold the request (`EINVAL`); the request failed.
+    TooSmall,
+    /// The reply is malformed or too long (`EINVAL`).
+    Invalid,
+    /// No request waits for this reply (`ENOENT`).
+    UnknownRequest,
+    /// The user buffer could not be accessed (`EFAULT`).
+    Fault,
+}
+
+impl FuseChannel {
+    pub(super) fn new() -> Self {
+        Self {
+            state: SpinLock::new(ChannelState {
+                pending: VecDeque::new(),
+                in_flight: BTreeMap::new(),
+                aborted: false,
+            }),
+            on_change: Once::new(),
+        }
+    }
+
+    /// Sets what is told when a request waits or the connection ends.
+    pub fn set_on_change(&self, notify: Box<dyn Fn() + Send + Sync>) {
+        self.on_change.call_once(|| notify);
+    }
+
+    fn notify(&self) {
+        if let Some(notify) = self.on_change.get() {
+            notify();
+        }
+    }
+
+    /// Queues a request for the server.
+    pub(super) fn push(&self, request: FuseRequest) -> Result<(), FuseError> {
+        {
+            let mut state = self.state.lock();
+            if state.aborted {
+                drop(state);
+                request.fail(-ENOTCONN);
+                return Err(FuseError::RemoteError(-ENOTCONN));
+            }
+            state.pending.push_back(request);
+        }
+        self.notify();
+        Ok(())
+    }
+
+    /// Whether a request waits to be read.
+    pub fn has_request(&self) -> bool {
+        !self.state.lock().pending.is_empty()
+    }
+
+    /// Whether the connection ended.
+    pub fn is_aborted(&self) -> bool {
+        self.state.lock().aborted
+    }
+
+    /// Writes the oldest request into `writer`, whole.
+    pub fn read_request(&self, writer: &mut VmWriter<'_, Fallible>) -> Result<usize, ChannelError> {
+        let request = {
+            let mut state = self.state.lock();
+            if state.aborted {
+                return Err(ChannelError::Aborted);
+            }
+            let Some(request) = state.pending.pop_front() else {
+                return Err(ChannelError::Empty);
+            };
+            request
+        };
+
+        // The request's bytes: its header and arguments, then the data of a
+        // write.
+        let mut bytes = vec![0u8; request.request_len()];
+        let mut at = 0;
+        for buf in request.request_bufs() {
+            at += buf
+                .device_reader()
+                .read(&mut VmWriter::from(&mut bytes[at..]));
+        }
+        bytes.truncate(at);
+
+        // As Linux: a buffer too small fails the request.
+        if writer.avail() < bytes.len() {
+            request.fail(-EIO);
+            return Err(ChannelError::TooSmall);
+        }
+        if writer.write_fallible(&mut VmReader::from(&bytes[..])).is_err() {
+            request.fail(-EIO);
+            return Err(ChannelError::Fault);
+        }
+
+        if request.expects_reply() {
+            let mut state = self.state.lock();
+            if state.aborted {
+                drop(state);
+                request.fail(-ENOTCONN);
+            } else {
+                state.in_flight.insert(request.unique().as_u64(), request);
+            }
+        } else {
+            request.finish_reply(0);
+        }
+        Ok(bytes.len())
+    }
+
+    /// Takes a reply from `reader` (a header, then the payload) and ends its
+    /// request with it.
+    pub fn write_reply(&self, reader: &mut VmReader<'_, Fallible>) -> Result<usize, ChannelError> {
+        let total = reader.remain();
+        if total < size_of::<ReplyHeader>() || total > MAX_REPLY_LEN {
+            return Err(ChannelError::Invalid);
+        }
+        let mut bytes = vec![0u8; total];
+        reader
+            .read_fallible(&mut VmWriter::from(&mut bytes[..]))
+            .map_err(|_| ChannelError::Fault)?;
+        let header: ReplyHeader = VmReader::from(&bytes[..])
+            .read_val()
+            .map_err(|_| ChannelError::Invalid)?;
+        if header.len() as usize != total {
+            return Err(ChannelError::Invalid);
+        }
+        // A notification (unique 0): none is asked for, so it is let pass.
+        let unique = header.unique().as_u64();
+        if unique == 0 {
+            return Ok(total);
+        }
+
+        let Some(request) = self.state.lock().in_flight.remove(&unique) else {
+            return Err(ChannelError::UnknownRequest);
+        };
+
+        let reply_bufs = request.waiter().reply_bufs();
+        let Ok(header_buf) = reply_bufs.reply_header_buf() else {
+            request.fail(-EIO);
+            return Err(ChannelError::Invalid);
+        };
+        header_buf
+            .device_writer()
+            .write(&mut VmReader::from(&bytes[..size_of::<ReplyHeader>()]));
+        let mut payload = &bytes[size_of::<ReplyHeader>()..];
+        for buf in reply_bufs.payload_bufs() {
+            if payload.is_empty() {
+                break;
+            }
+            let written = buf.device_writer().write(&mut VmReader::from(payload));
+            payload = &payload[written..];
+        }
+        if !payload.is_empty() {
+            // Longer than what the request has room for.
+            request.fail(-EIO);
+            return Err(ChannelError::Invalid);
+        }
+
+        request.finish_reply(total);
+        Ok(total)
+    }
+
+    /// Ends the connection (the server's file closed): every request that
+    /// waits, and every later one, fails with `ENOTCONN`.
+    pub fn abort(&self) {
+        let (pending, in_flight) = {
+            let mut state = self.state.lock();
+            state.aborted = true;
+            (
+                core::mem::take(&mut state.pending),
+                core::mem::take(&mut state.in_flight),
+            )
+        };
+        let failed: Vec<FuseRequest> = pending.into_iter().chain(in_flight.into_values()).collect();
+        for request in failed {
+            request.fail(-ENOTCONN);
+        }
+        self.notify();
+    }
+}
