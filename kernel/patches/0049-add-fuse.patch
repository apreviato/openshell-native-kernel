+fn fuse_root_entry(options: &FuseMountOptions) -> EntryReply {
+    let mut bytes = [0u8; size_of::<EntryReply>()];
+    let mut put = |at: usize, value: &[u8]| bytes[at..at + value.len()].copy_from_slice(value);
