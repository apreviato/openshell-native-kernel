+// SPDX-License-Identifier: MPL-2.0
+
+//! `/dev/fuse`: file systems served by a program (FUSE).
+//!
+//! Each open of the device is a connection: the program mounts a `fuse`
+//! (or `fuseblk`) file system naming the open file (`fd=N`), then reads the
+//! kernel's requests from it and writes its replies, as with Linux's FUSE
+//! (libfuse 2 and 3: ntfs-3g, sshfs, rclone, AppImages...). The protocol
+//! and the inodes are virtio-fs's; only the transport differs.
+
+use aster_virtio::device::filesystem::device::{ChannelError, FileSystemDevice};
+use alloc::collections::BTreeMap;
+
+use device_id::{DeviceId, MinorId};
+use ostd::mm::FallibleVmRead;
+
+use crate::{
+    device::{Device, DeviceType, registry::char},
+    events::IoEvents,
+    fs::{
+        devtmpfs::DevtmpfsNodeMeta,
+        file::{InodeHandle, PerOpenFileOps, StatusFlags, mkmod},
+        vfs::inode::FileOps,
+    },
+    prelude::*,
+    process::{
+        posix_thread::AsPosixThread,
+        signal::{PollHandle, Pollable, Pollee},
+    },
+};
+
+/// `/dev/fuse`'s minor number (misc devices, major 10), as on Linux.
+const FUSE_MINOR: u32 = 229;
+
+#[derive(Debug)]
+struct FuseDevice {
+    id: DeviceId,
+}
+
+impl Device for FuseDevice {
+    fn type_(&self) -> DeviceType {
+        DeviceType::Char
+    }
+
+    fn id(&self) -> DeviceId {
+        self.id
+    }
+
+    fn devtmpfs_meta(&self) -> Option<DevtmpfsNodeMeta> {
+        // Everyone's, as on Linux: mounting stays root's (or fusermount's).
+        Some(DevtmpfsNodeMeta::with_mode("fuse", mkmod!(a+rw)).unwrap())
+    }
+
+    fn open(&self) -> Result<Box<dyn PerOpenFileOps>> {
+        Ok(Box::new(FuseConnectionFile::new()))
+    }
+}
+
+/// One open of `/dev/fuse`: a connection to the program serving a mount.
+pub(crate) struct FuseConnectionFile {
+    device: Arc<FileSystemDevice>,
+    pollee: Pollee,
+    /// Replies that arrive in pieces, by thread: `writev` hands the file
+    /// one buffer at a time, and libfuse writes a reply's header and its
+    /// payload in separate ones. Linux's device takes the whole array as one
+    /// message; here a thread's pieces are joined until the reply's length
+    /// (in its header) is complete.
+    partial_replies: Mutex<BTreeMap<u32, Vec<u8>>>,
+}
+
+impl FuseConnectionFile {
+    fn new() -> Self {
+        let device = FileSystemDevice::new_channel();
+        let pollee = Pollee::new();
+        let notified = pollee.clone();
+        device
+            .channel()
+            .unwrap()
+            .set_on_change(Box::new(move || notified.notify(IoEvents::IN)));
+        Self {
+            device,
+            pollee,
+            partial_replies: Mutex::new(BTreeMap::new()),
+        }
+    }
+
+    fn check_io_events(&self) -> IoEvents {
+        let channel = self.device.channel().unwrap();
+        let mut events = IoEvents::OUT;
+        if channel.has_request() {
+            events |= IoEvents::IN;
+        }
+        if channel.is_aborted() {
+            events |= IoEvents::IN | IoEvents::ERR;
+        }
+        events
+    }
+}
+
+impl Pollable for FuseConnectionFile {
+    fn poll(&self, mask: IoEvents, poller: Option<&mut PollHandle>) -> IoEvents {
+        self.pollee
+            .poll_with(mask, poller, || self.check_io_events())
+    }
+}
+
+fn channel_error(error: ChannelError) -> Error {
+    match error {
+        ChannelError::Empty => Error::with_message(Errno::EAGAIN, "no FUSE request waits"),
+        ChannelError::Aborted => Error::with_message(Errno::ENODEV, "the FUSE connection ended"),
+        ChannelError::TooSmall => {
+            Error::with_message(Errno::EINVAL, "the buffer cannot hold the FUSE request")
+        }
+        ChannelError::Invalid => Error::with_message(Errno::EINVAL, "the FUSE reply is malformed"),
+        ChannelError::UnknownRequest => {
+            Error::with_message(Errno::ENOENT, "no FUSE request waits for this reply")
+        }
+        ChannelError::Fault => Error::with_message(Errno::EFAULT, "the buffer cannot be accessed"),
+    }
+}
+
+impl FileOps for FuseConnectionFile {
+    fn read_at(
+        &self,
+        _offset: usize,
+        writer: &mut VmWriter,
+        status_flags: StatusFlags,
+    ) -> Result<usize> {
+        let channel = self.device.channel().unwrap();
+        let mut try_read = || {
+            let result = channel.read_request(writer).map_err(channel_error);
+            self.pollee.invalidate();
+            result
+        };
+        if status_flags.contains(StatusFlags::O_NONBLOCK) {
+            try_read()
+        } else {
+            self.wait_events(IoEvents::IN, None, try_read)
+        }
+    }
+
+    fn write_at(
+        &self,
+        _offset: usize,
+        reader: &mut VmReader,
+        _status_flags: StatusFlags,
+    ) -> Result<usize> {
+        /// The longest reply taken (as the channel's own limit).
+        const MAX_REPLY_LEN: usize = 4 << 20;
+        /// The bytes of `fuse_out_header`.
+        const HEADER_LEN: usize = 16;
+
+        let piece_len = reader.remain();
+        let tid = current_thread!().as_posix_thread().unwrap().tid();
+        let message = {
+            let mut partial_replies = self.partial_replies.lock();
+            let pending = partial_replies.entry(tid).or_default();
+            if pending.len() + piece_len > MAX_REPLY_LEN {
+                partial_replies.remove(&tid);
+                return_errno_with_message!(Errno::EINVAL, "the FUSE reply is too long");
+            }
+            let start = pending.len();
+            pending.resize(start + piece_len, 0);
+            if reader
+                .read_fallible(&mut VmWriter::from(&mut pending[start..]))
+                .is_err()
+            {
+                partial_replies.remove(&tid);
+                return_errno_with_message!(Errno::EFAULT, "the reply cannot be read");
+            }
+            if pending.len() < HEADER_LEN {
+                return Ok(piece_len);
+            }
+            let declared = u32::from_ne_bytes(pending[..4].try_into().unwrap()) as usize;
+            if pending.len() < declared {
+                return Ok(piece_len);
+            }
+            partial_replies.remove(&tid).unwrap()
+        };
+
+        self.device
+            .channel()
+            .unwrap()
+            .write_reply(&mut VmReader::from(&message[..]).to_fallible())
+            .map_err(channel_error)?;
+        Ok(piece_len)
+    }
+}
+
+impl PerOpenFileOps for FuseConnectionFile {
+    fn check_seekable(&self) -> Result<()> {
+        return_errno_with_message!(Errno::ESPIPE, "/dev/fuse is not seekable")
+    }
+
+    fn is_offset_aware(&self) -> bool {
+        false
+    }
+}
+
+impl Drop for FuseConnectionFile {
+    /// The program closed its connection: the mount's requests fail with
+    /// `ENOTCONN` from now on, as on Linux.
+    fn drop(&mut self) {
+        self.device.channel().unwrap().abort();
+    }
+}
+
+/// The FUSE connection that the file descriptor `fd` (from a mount's
+/// `fd=` option) opened.
+pub(crate) fn connection_of_fd(fd: i32, ctx: &crate::context::Context) -> Result<Arc<FileSystemDevice>> {
+    let file = {
+        let file_table = ctx.thread_local.borrow_file_table();
+        let file_table = file_table.unwrap().read();
+        file_table.get_file(fd.try_into()?)?.clone()
+    };
+    file.downcast_ref::<InodeHandle>()
+        .and_then(|handle| handle.downcast_open_file::<FuseConnectionFile>().ok().flatten())
+        .map(|connection| connection.device.clone())
+        .ok_or_else(|| Error::with_message(Errno::EINVAL, "the file is not a /dev/fuse connection"))
+}
+
+pub(super) fn init_in_first_kthread() {
+    let major = super::MISC_MAJOR.get().unwrap().get();
+    let id = DeviceId::new(major, MinorId::new(FUSE_MINOR));
+    char::register(Arc::new(FuseDevice { id })).unwrap();
+}
