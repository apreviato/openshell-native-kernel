--- /dev/null
+++ b/kernel/core/src/net/net_ns.rs
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Network namespaces.
+//!
+//! A network namespace owns its interfaces, its routing tables and the abstract
+//! names of its UNIX sockets. The initial namespace holds the interfaces that the
+//! kernel found at boot. A new namespace starts with a loopback interface only,
+//! so processes in it can talk to each other but cannot reach other namespaces.
+
+use core::sync::atomic::{AtomicU64, Ordering};
+
+use ostd::task::Task;
+use spin::Once;
+
+use super::{
+    iface::{self, Iface},
+    route::RouteTables,
+};
+use crate::{
+    fs::pseudofs::{NsCommonOps, NsType, StashedDentry},
+    prelude::*,
+    process::{UserNamespace, credentials::capabilities::CapSet, posix_thread::PosixThread},
+    security::lsm::hooks as lsm_hooks,
+};
+
+/// The network namespace.
+pub(crate) struct NetNamespace {
+    id: u64,
+    ifaces: Vec<Arc<Iface>>,
+    routes: RouteTables,
+    owner: Arc<UserNamespace>,
+    stashed_dentry: StashedDentry,
+}
+
+static NEXT_ID: AtomicU64 = AtomicU64::new(0);
+
+impl NetNamespace {
+    /// Returns a reference to the singleton initial network namespace.
+    pub(crate) fn get_init_singleton() -> &'static Arc<NetNamespace> {
+        static INIT: Once<Arc<NetNamespace>> = Once::new();
+
+        INIT.call_once(|| {
+            Self::new(
+                iface::iter_init_ifaces().cloned().collect(),
+                UserNamespace::get_init_singleton().clone(),
+            )
+        })
+    }
+
+    fn new(ifaces: Vec<Arc<Iface>>, owner: Arc<UserNamespace>) -> Arc<Self> {
+        let routes = RouteTables::new(&ifaces);
+        Arc::new(Self {
+            id: NEXT_ID.fetch_add(1, Ordering::Relaxed),
+            ifaces,
+            routes,
+            owner,
+            stashed_dentry: StashedDentry::new(),
+        })
+    }
+
+    /// Creates a network namespace with a new loopback interface.
+    pub(crate) fn new_clone(
+        &self,
+        owner: Arc<UserNamespace>,
+        posix_thread: &PosixThread,
+    ) -> Result<Arc<Self>> {
+        lsm_hooks::on_capable(lsm_hooks::CapableContext::new(
+            owner.as_ref(),
+            posix_thread,
+            CapSet::SYS_ADMIN,
+        ))?;
+
+        let loopback = iface::new_loopback();
+        // FIXME: The polling thread keeps the interface alive after the last process
+        // of the namespace has exited. Stop the thread when the namespace is dropped.
+        iface::spawn_background_poll_thread(loopback.clone());
+        Ok(Self::new(vec![loopback], owner))
+    }
+
+    /// Returns the identifier that tells namespaces apart.
+    pub(in crate::net) fn id(&self) -> u64 {
+        self.id
+    }
+
+    /// Returns the interfaces of the namespace.
+    pub(in crate::net) fn ifaces(&self) -> &[Arc<Iface>] {
+        &self.ifaces
+    }
+
+    /// Returns the routing tables of the namespace.
+    pub(in crate::net) fn routes(&self) -> &RouteTables {
+        &self.routes
+    }
+}
+
+impl NsCommonOps for NetNamespace {
+    const TYPE: NsType = NsType::Net;
+
+    fn owner_user_ns(&self) -> Option<&Arc<UserNamespace>> {
+        Some(&self.owner)
+    }
+
+    fn parent(&self) -> Result<&Arc<Self>> {
+        return_errno_with_message!(Errno::EINVAL, "network namespaces do not have a parent")
+    }
+
+    fn stashed_dentry(&self) -> &StashedDentry {
+        &self.stashed_dentry
+    }
+}
+
+/// Returns the network namespace of the current thread.
+///
+/// Kernel threads, and threads that are exiting, use the initial namespace.
+//
+// TODO: Linux binds a socket to the namespace of its creator. Here the namespace
+// of the thread that operates the socket applies. The two differ only if a socket
+// is passed to a process in another network namespace.
+pub(in crate::net) fn current_net_ns() -> Arc<NetNamespace> {
+    let Some(task) = Task::current() else {
+        return NetNamespace::get_init_singleton().clone();
+    };
+    let Some(thread_local) = task.as_thread_local() else {
+        return NetNamespace::get_init_singleton().clone();
+    };
+    let Ok(ns_proxy) = thread_local.try_borrow_ns_proxy() else {
+        return NetNamespace::get_init_singleton().clone();
+    };
+    match ns_proxy {
+        Some(ns_proxy) => ns_proxy.net_ns().clone(),
+        None => NetNamespace::get_init_singleton().clone(),
+    }
+}
