 // SPDX-License-Identifier: MPL-2.0
 
+/// The EFI stub's progress lines, on the firmware's console. Release builds
+/// keep them off the screen, which then shows what the boot loader drew (a
+/// splash); warnings and panics still print. `OPENSHELL_EFI_STUB_VERBOSE` at
+/// build time keeps them.
+macro_rules! stub_progress {
+    ($($argument:tt)*) => {
+        if cfg!(debug_assertions) || option_env!("OPENSHELL_EFI_STUB_VERBOSE").is_some() {
+            uefi::println!($($argument)*);
+        }
+    };
+}
+pub(crate) use stub_progress;
+
+
 pub(super) mod alloc;
 mod decoder;
 mod efi;
