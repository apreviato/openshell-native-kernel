+pub(crate) const HBUS_TARG_WRPTR_Q_SHIFT: u32 = 16;
+/// The free receive buffers' write index, queue 0 (22000 family).
+pub(crate) const RFH_Q0_FRBDCB_WIDX_TRG: usize = 0x1c80;
+
+/// MSI-X: the causes, their masks and which vector each goes to.
+pub(crate) const MSIX_FH_INT_CAUSES_AD: usize = 0x2800;
+pub(crate) const MSIX_FH_INT_MASK_AD: usize = 0x2804;
