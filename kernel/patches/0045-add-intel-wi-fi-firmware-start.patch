+pub(crate) const GP_CNTRL_RFKILL_WAKE_L1A_EN: u32 = 0x0400_0000;
+/// Clear: the radio's switch is off.
+pub(crate) const GP_CNTRL_HW_RF_KILL_SW: u32 = 0x0800_0000;
+
+pub(crate) const RESET_FORCE_NMI: u32 = 0x0000_0002;
+pub(crate) const RESET_SW_RESET: u32 = 0x0000_0080;
+
+pub(crate) const GIO_L0S_DISABLED: u32 = 0x0000_0002;
