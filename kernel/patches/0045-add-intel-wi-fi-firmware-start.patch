+//! reads and writes directly, and the addresses of the "periphery"
+//! registers behind them, which take the chip awake to reach.
+
+#![allow(dead_code)]
+
+pub(crate) const HW_IF_CONFIG: usize = 0x000;
+pub(crate) const INT: usize = 0x008;
+pub(crate) const INT_MASK: usize = 0x00c;
+pub(crate) const FH_INT_STATUS: usize = 0x010;
+pub(crate) const RESET: usize = 0x020;
+pub(crate) const GP_CNTRL: usize = 0x024;
