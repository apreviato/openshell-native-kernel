+pub(crate) const LTR_LAST_MSG: usize = 0x0dc;
+pub(crate) const GIO_CHICKEN_BITS: usize = 0x100;
+pub(crate) const DBG_HPET_MEM: usize = 0x240;
+pub(crate) const DBG_LINK_PWR_MGMT: usize = 0x250;
+/// The second context format (AX210 on).
+pub(crate) const CTXT_INFO_BOOT_CTRL: usize = 0x000;
+pub(crate) const CTXT_INFO_ADDR: usize = 0x118;
