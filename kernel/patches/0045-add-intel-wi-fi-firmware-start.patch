diff --git a/kernel/comps/iwlwifi/src/fw.rs b/kernel/comps/iwlwifi/src/fw.rs
new file mode 100755
index 0000000..2555ee4
--- /dev/null
+++ b/kernel/comps/iwlwifi/src/fw.rs
@@ -0,0 +1,231 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Intel's firmware files (`iwlwifi-*.ucode`, in linux-firmware): a header
+//! and a list of typed blocks (TLVs). What this driver takes from one:
+//! the program's sections, in the order the chip loads them, what the
+//! program says it can do (API and capability bits) and the version of
+//! each command it speaks, which is how one driver talks to the firmware
+//! of several chips.
+
+use alloc::{string::String, vec::Vec};
+use core::ops::Range;
+
+/// Every file since the 7000 series starts with a zero and this.
+const MAGIC: u32 = 0x0a4c_5749;
+/// The header: zero, magic, a name of 64 bytes, version, build, 8 unused.
+const HEADER: usize = 88;
+
+/// Between the sections of the first processor (LMAC) and the second's
+/// (UMAC), and before the pages the firmware takes on demand.
+pub(crate) const CPU1_CPU2_SEPARATOR: u32 = 0xffff_cccc;
+pub(crate) const PAGING_SEPARATOR: u32 = 0xaaaa_bbbb;
+
+const TLV_PROBE_MAX_LEN: u32 = 6;
+const TLV_FLAGS: u32 = 18;
+const TLV_SEC_RT: u32 = 19;
+const TLV_PHY_SKU: u32 = 23;
+const TLV_SECURE_SEC_RT: u32 = 24;
+const TLV_API_CHANGES_SET: u32 = 29;
+const TLV_ENABLED_CAPABILITIES: u32 = 30;
+const TLV_N_SCAN_CHANNELS: u32 = 31;
+const TLV_PAGING: u32 = 32;
+const TLV_FW_VERSION: u32 = 36;
+const TLV_CMD_VERSIONS: u32 = 48;
+const TLV_IML: u32 = 52;
+const TLV_FW_NUM_STATIONS: u32 = 0x48;
+
+/// The bit sets a file may fill: 32 bits a block, a few blocks.
+const BIT_WORDS: usize = 8;
+/// More sections than any file has: a bound for a damaged one.
+const MAX_SECTIONS: usize = 128;
+
+/// "No version stated" (the firmware's own mark is 99 for commands it
+/// keeps to itself).
+pub(crate) const VERSION_UNKNOWN: u8 = 0xff;
+
+/// Why a file is not a firmware this driver loads.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Error {
+    /// Not a TLV firmware file.
+    Magic,
+    /// A block runs past the end of the file, or is too short for its type.
+    Truncated,
+    /// No runtime program in it.
+    NoSections,
+}
+
+/// A piece of the program: where the chip wants it, and its bytes in the
+/// file.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct Section {
+    pub(crate) offset: u32,
+    pub(crate) data: Range<usize>,
+}
+
+impl Section {
+    pub(crate) fn is_separator(&self) -> bool {
+        self.offset == CPU1_CPU2_SEPARATOR || self.offset == PAGING_SEPARATOR
+    }
+}
+
+/// A command's version, as the firmware states it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct CommandVersion {
+    pub(crate) group: u8,
+    pub(crate) command: u8,
+    pub(crate) version: u8,
+    /// Of the notification with the same number.
+    pub(crate) notification: u8,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct Firmware {
+    /// "release/core74::f39cc7f9".
+    pub(crate) name: String,
+    /// The API number in the file's name (77).
+    pub(crate) major: u32,
+    pub(crate) minor: u32,
+    /// The runtime program's sections, separators included.
+    pub(crate) sections: Vec<Section>,
+    /// The memory the firmware pages into, in bytes; 0: none.
+    pub(crate) paging_size: u32,
+    /// The image loader the newer chips run first (AX210 on).
+    pub(crate) iml: Option<Range<usize>>,
+    pub(crate) flags: u32,
+    api: [u32; BIT_WORDS],
+    capabilities: [u32; BIT_WORDS],
+    pub(crate) command_versions: Vec<CommandVersion>,
+    /// The radio's configuration, with the antennas the board has.
+    pub(crate) phy_config: u32,
+    pub(crate) scan_channels: u32,
+    pub(crate) max_probe_length: u32,
+    pub(crate) stations: u32,
+}
+
+fn le32(bytes: &[u8], at: usize) -> Option<u32> {
+    Some(u32::from_le_bytes(bytes.get(at..at + 4)?.try_into().ok()?))
+}
+
+impl Firmware {
+    pub(crate) fn parse(file: &[u8]) -> Result<Self, Error> {
+        if file.len() < HEADER || le32(file, 0) != Some(0) || le32(file, 4) != Some(MAGIC) {
+            return Err(Error::Magic);
+        }
+        let name_bytes = &file[8..72];
+        let name_end = name_bytes.iter().position(|byte| *byte == 0).unwrap_or(name_bytes.len());
+        let name: String = name_bytes[..name_end].iter().map(|byte| if byte.is_ascii_graphic() || *byte == b' ' { *byte as char } else { '?' }).collect();
+        let version = le32(file, 72).ok_or(Error::Truncated)?;
+        let mut firmware = Firmware {
+            name,
+            // The header has the API number; the version block, when
+            // there is one, repeats it with the build.
+            major: version,
+            minor: 0,
+            sections: Vec::new(),
+            paging_size: 0,
+            iml: None,
+            flags: 0,
+            api: [0; BIT_WORDS],
+            capabilities: [0; BIT_WORDS],
+            command_versions: Vec::new(),
+            phy_config: 0,
+            scan_channels: 0,
+            max_probe_length: 0,
+            stations: 0,
+        };
+        let mut at = HEADER;
+        while at < file.len() {
+            let (Some(kind), Some(length)) = (le32(file, at), le32(file, at + 4)) else {
+                return Err(Error::Truncated);
+            };
+            let start = at + 8;
+            let end = start.checked_add(length as usize).filter(|end| *end <= file.len()).ok_or(Error::Truncated)?;
+            let body = &file[start..end];
+            let word = |index: usize| le32(body, index * 4).ok_or(Error::Truncated);
+            match kind {
+                TLV_SEC_RT | TLV_SECURE_SEC_RT => {
+                    if firmware.sections.len() >= MAX_SECTIONS {
+                        return Err(Error::Truncated);
+                    }
+                    firmware.sections.push(Section { offset: word(0)?, data: start + 4..end });
+                }
+                TLV_PAGING => firmware.paging_size = word(0)?,
+                TLV_IML => firmware.iml = Some(start..end),
+                TLV_FLAGS => firmware.flags = word(0)?,
+                TLV_API_CHANGES_SET | TLV_ENABLED_CAPABILITIES => {
+                    let (index, bits) = (word(0)? as usize, word(1)?);
+                    let set = if kind == TLV_API_CHANGES_SET { &mut firmware.api } else { &mut firmware.capabilities };
+                    // Blocks past what this driver knows of are a newer
+                    // firmware's: nothing it asks about.
+                    if let Some(slot) = set.get_mut(index) {
+                        *slot = bits;
+                    }
+                }
+                TLV_CMD_VERSIONS => {
+                    for entry in body.chunks_exact(4) {
+                        firmware.command_versions.push(CommandVersion { command: entry[0], group: entry[1], version: entry[2], notification: entry[3] });
+                    }
+                }
+                TLV_PHY_SKU => firmware.phy_config = word(0)?,
+                TLV_N_SCAN_CHANNELS => firmware.scan_channels = word(0)?,
+                TLV_PROBE_MAX_LEN => firmware.max_probe_length = word(0)?,
+                TLV_FW_NUM_STATIONS => firmware.stations = word(0)?,
+                TLV_FW_VERSION => {
+                    firmware.major = word(0)?;
+                    firmware.minor = word(1)?;
+                }
+                _ => {}
+            }
+            // Blocks are padded to four bytes.
+            at = start + ((length as usize + 3) & !3);
+        }
+        if firmware.sections.iter().all(Section::is_separator) {
+            return Err(Error::NoSections);
+        }
+        Ok(firmware)
+    }
+
+    /// The firmware has API change `bit` (`IWL_UCODE_TLV_API_*`).
+    // For the commands that follow the firmware's start, as the two below.
+    #[allow(dead_code)]
+    pub(crate) fn has_api(&self, bit: u32) -> bool {
+        self.api.get((bit / 32) as usize).is_some_and(|word| word >> (bit % 32) & 1 == 1)
+    }
+
+    /// The firmware has capability `bit` (`IWL_UCODE_TLV_CAPA_*`).
+    #[allow(dead_code)]
+    pub(crate) fn has_capability(&self, bit: u32) -> bool {
+        self.capabilities.get((bit / 32) as usize).is_some_and(|word| word >> (bit % 32) & 1 == 1)
+    }
+
+    /// The version of a command, or `VERSION_UNKNOWN` when the file does
+    /// not state it.
+    pub(crate) fn command_version(&self, group: u8, command: u8) -> u8 {
+        self.command_versions.iter().find(|entry| entry.group == group && entry.command == command).map_or(VERSION_UNKNOWN, |entry| entry.version)
+    }
+
+    #[allow(dead_code)]
+    pub(crate) fn notification_version(&self, group: u8, command: u8) -> u8 {
+        self.command_versions.iter().find(|entry| entry.group == group && entry.command == command).map_or(VERSION_UNKNOWN, |entry| entry.notification)
+    }
+
+    /// The antennas the board has, a bit each (A, B, C): to send, to
+    /// receive.
+    pub(crate) fn antennas(&self) -> (u8, u8) {
+        (((self.phy_config >> 16) & 0xf) as u8, ((self.phy_config >> 20) & 0xf) as u8)
+    }
+
+    /// The sections as the chip's loader takes them: the first
+    /// processor's, the second's, and the pages.
+    pub(crate) fn groups(&self) -> (&[Section], &[Section], &[Section]) {
+        fn run(sections: &[Section]) -> (&[Section], &[Section]) {
+            let count = sections.iter().position(Section::is_separator).unwrap_or(sections.len());
+            // What follows starts after the separator.
+            (&sections[..count], sections.get(count + 1..).unwrap_or(&[]))
+        }
+        let (lmac, rest) = run(&self.sections);
+        let (umac, rest) = run(rest);
+        let (paging, _) = run(rest);
+        (lmac, umac, paging)
+    }
+}
