+pub(crate) const WFPM_OTP_CFG1: u32 = 0x00a0_3098;
+pub(crate) const WFPM_OTP_CFG1_IS_CDB: u32 = 1 << 4;
+/// The companion radio's identity (22000 family; AX210 family).
+pub(crate) const SD_REG_VER: u32 = 0x00a2_9600;
+pub(crate) const SD_REG_VER_GEN2: u32 = 0x00a2_b800;
