+// SPDX-License-Identifier: MPL-2.0
+
+//! WMI, the firmware's command interface, as Linux's ath11k `wmi.c` writes
+//! it: a command id, then TLVs (a tag and a length in a word, the value
+//! padded to words); the commands a station needs and the events it
+//! reads.
+
+use alloc::{collections::BTreeSet, vec, vec::Vec};
+
+use crate::{
+    hal::{field, get},
+    hw::HwParams,
+    regs::*,
+};
+
+/// A TLV's header word (`WMI_TLV_TAG`, `WMI_TLV_LEN`).
+fn header(tag: u32, len: usize) -> u32 {
+    (tag << 16) | (len as u32 & 0xffff)
+}
+
+/// A command being written: its id, then its TLVs.
+pub(crate) struct Cmd {
+    pub(crate) buf: Vec<u8>,
+}
+
+impl Cmd {
+    pub(crate) fn new(id: u32) -> Self {
+        let mut buf = Vec::with_capacity(128);
+        buf.extend_from_slice(&field(WMI_CMD_HDR_CMD_ID, id).to_le_bytes());
+        Self { buf }
+    }
+
+    /// A fixed structure: its tag, then its words (after the header).
+    pub(crate) fn tlv(&mut self, tag: u32, words: &[u32]) -> &mut Self {
+        self.buf.extend_from_slice(&header(tag, words.len() * 4).to_le_bytes());
+        for word in words {
+            self.buf.extend_from_slice(&word.to_le_bytes());
+        }
+        self
+    }
+
+    /// A TLV of raw bytes, padded to a word (the length says the padded
+    /// one, as Linux writes it).
+    pub(crate) fn bytes(&mut self, tag: u32, data: &[u8]) -> &mut Self {
+        let padded = data.len().next_multiple_of(4);
+        self.buf.extend_from_slice(&header(tag, padded).to_le_bytes());
+        self.buf.extend_from_slice(data);
+        self.buf.resize(self.buf.len() + (padded - data.len()), 0);
+        self
+    }
+
+    /// An array of fixed structures (`WMI_TAG_ARRAY_STRUCT`), each with
+    /// its own header.
+    pub(crate) fn array_struct(&mut self, items: &[(u32, Vec<u32>)]) -> &mut Self {
+        let len: usize = items.iter().map(|(_, words)| 4 + words.len() * 4).sum();
+        self.buf.extend_from_slice(&header(WMI_TAG_ARRAY_STRUCT, len).to_le_bytes());
+        for (tag, words) in items {
+            self.buf.extend_from_slice(&header(*tag, words.len() * 4).to_le_bytes());
+            for word in words {
+                self.buf.extend_from_slice(&word.to_le_bytes());
+            }
+        }
+        self
+    }
+
+    pub(crate) fn array_u32(&mut self, values: &[u32]) -> &mut Self {
+        self.buf.extend_from_slice(&header(WMI_TAG_ARRAY_UINT32, values.len() * 4).to_le_bytes());
+        for value in values {
+            self.buf.extend_from_slice(&value.to_le_bytes());
+        }
+        self
+    }
+}
+
+/// `struct wmi_mac_addr`: the address in two words.
+pub(crate) fn mac(address: &[u8; 6]) -> [u32; 2] {
+    [u32::from_le_bytes([address[0], address[1], address[2], address[3]]), u32::from_le_bytes([address[4], address[5], 0, 0])]
+}
+
+/// An event: its id and its TLVs, in order.
+pub(crate) struct Event {
+    pub(crate) id: u32,
+    tlvs: Vec<(u32, Vec<u8>)>,
+}
+
+impl Event {
+    pub(crate) fn parse(payload: &[u8]) -> Option<Self> {
+        let id = get(WMI_CMD_HDR_CMD_ID, word(payload, 0));
+        let tlvs = nested(payload.get(4..)?).into_iter().map(|(tag, value)| (tag, value.to_vec())).collect();
+        Some(Self { id, tlvs })
+    }
+
+    /// The first TLV of a tag.
+    pub(crate) fn get(&self, tag: u32) -> Option<&[u8]> {
+        self.nth(tag, 0)
+    }
+
+    /// The `n`th TLV of a tag.
+    pub(crate) fn nth(&self, tag: u32, n: usize) -> Option<&[u8]> {
+        self.tlvs.iter().filter(|(found, _)| *found == tag).nth(n).map(|(_, value)| value.as_slice())
+    }
+}
+
+pub(crate) fn word(value: &[u8], index: usize) -> u32 {
+    value.get(index * 4..index * 4 + 4).map_or(0, |bytes| u32::from_le_bytes(bytes.try_into().unwrap()))
+}
