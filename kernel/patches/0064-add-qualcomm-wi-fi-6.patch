diff --git a/kernel/comps/ath11k/src/ce.rs b/kernel/comps/ath11k/src/ce.rs
new file mode 100644
index 0000000..727292b
--- /dev/null
+++ b/kernel/comps/ath11k/src/ce.rs
@@ -0,0 +1,207 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The copy engines as Linux's ath11k `ce.c` runs them on the HAL's rings:
+//! a source ring per host-to-target pipe, a destination ring with buffers
+//! posted and a status ring per target-to-host pipe; HTC's messages go
+//! through them (WMI, HTT's control messages).
+
+use alloc::vec::Vec;
+
+use aster_linuxkpi::{bits::put_le32, dma::alloc_coherent32};
+use ostd::mm::{HasDaddr, VmIo, dma::DmaCoherent};
+
+use crate::{
+    hal::{self, Hal, Params, RingType, Srng},
+    hw_tables::CeAttr,
+    pci::Bus,
+    regs::*,
+};
+
+/// `CE_ATTR_FLAGS` on a little-endian host: no byte swapping (`ce.h`
+/// defines it twice, by endianness; the tables use this one).
+pub(crate) const CE_ATTR_FLAGS: u32 = 0;
+
+/// A ring of a pipe and the buffers behind its entries.
+struct CeRing {
+    srng: Srng,
+    buffers: Vec<DmaCoherent>,
+    buf_len: usize,
+    nentries: usize,
+    write_index: usize,
+    sw_index: usize,
+}
+
+impl CeRing {
+    fn new(hal: &Hal, bus: &Bus, ty: RingType, ce: u32, nentries: u32, buf_len: usize, params: Params) -> Result<Self, &'static str> {
+        let nentries = nentries.next_power_of_two();
+        let srng = hal.setup(bus, ty, ce, 0, nentries, params)?;
+        let mut buffers = Vec::new();
+        if buf_len > 0 {
+            for _ in 0..nentries {
+                buffers.push(alloc_coherent32(buf_len).ok_or("no memory for copy engine buffers")?);
+            }
+        }
+        Ok(Self { srng, buffers, buf_len, nentries: nentries as usize, write_index: 0, sw_index: 0 })
+    }
+}
+
+struct Pipe {
+    attr: CeAttr,
+    src: Option<CeRing>,
+    dst: Option<CeRing>,
+    status: Option<CeRing>,
+    /// Destination entries without a buffer.
+    rx_buf_needed: usize,
+}
+
+pub(crate) struct Ce {
+    pipes: Vec<Pipe>,
+}
+
+impl Ce {
+    /// `ath11k_ce_alloc_pipes` and `ath11k_ce_init_pipes`: every pipe's
+    /// rings, the destination rings' buffers posted.
+    pub(crate) fn new(hal: &Hal, bus: &Bus) -> Result<Self, &'static str> {
+        let mut pipes = Vec::new();
+        for (index, attr) in bus.hw.host_ce.iter().enumerate() {
+            let ce = index as u32;
+            let interrupts = attr.flags & CE_ATTR_DIS_INTR == 0;
+            let msi = if interrupts { bus.msi } else { None };
+            let src = if attr.src_nentries != 0 {
+                let params = Params { msi, intr_batch_cntr_thres_entries: if interrupts { 1 } else { 0 }, ..Params::default() };
+                Some(CeRing::new(hal, bus, RingType::CeSrc, ce, attr.src_nentries, attr.src_sz_max as usize, params)?)
+            } else {
+                None
+            };
+            let (dst, status) = if attr.dest_nentries != 0 {
+                let entries = attr.dest_nentries.next_power_of_two();
+                let mut params = Params { msi, max_buffer_len: attr.src_sz_max, ..Params::default() };
+                if interrupts {
+                    params.intr_timer_thres_us = 1024;
+                    params.low_threshold = entries - 3;
+                }
+                let dst = CeRing::new(hal, bus, RingType::CeDst, ce, entries, attr.src_sz_max as usize, params)?;
+                let mut params = Params { msi, ..Params::default() };
+                if interrupts {
+                    params.intr_batch_cntr_thres_entries = 1;
+                    params.intr_timer_thres_us = 0x1000;
+                }
+                let status = CeRing::new(hal, bus, RingType::CeDstStatus, ce, entries, 0, params)?;
+                (Some(dst), Some(status))
+            } else {
+                (None, None)
+            };
+            let rx_buf_needed = dst.as_ref().map_or(0, |ring| ring.nentries - 2);
+            pipes.push(Pipe { attr: *attr, src, dst, status, rx_buf_needed });
+        }
+        let mut ce = Self { pipes };
+        for index in 0..ce.pipes.len() {
+            ce.post_rx(hal, bus, index);
+        }
+        Ok(ce)
+    }
+
+    /// `ath11k_ce_rx_post_pipe`: empty buffers into a destination ring.
+    fn post_rx(&mut self, hal: &Hal, bus: &Bus, index: usize) {
+        let pipe = &mut self.pipes[index];
+        let Some(ring) = &mut pipe.dst else { return };
+        hal.access_begin(&mut ring.srng);
+        while pipe.rx_buf_needed > 0 && ring.srng.src_num_free() >= 1 {
+            let Some(at) = ring.srng.src_get_next_entry() else { break };
+            let address = ring.buffers[ring.write_index].daddr() as u64;
+            let mut desc = [0u8; 8];
+            put_le32(&mut desc, 0, address as u32);
+            put_le32(&mut desc, 4, hal::field(HAL_CE_DEST_DESC_ADDR_INFO_ADDR_HI, (address >> 32) as u32));
+            ring.srng.write(at, &desc);
+            ring.write_index = (ring.write_index + 1) & (ring.nentries - 1);
+            pipe.rx_buf_needed -= 1;
+        }
+        hal.access_end(bus, &ring.srng);
+    }
+
+    /// `ath11k_ce_send`: a message on a source pipe. `Err`: no room.
+    pub(crate) fn send(&mut self, hal: &Hal, bus: &Bus, index: usize, data: &[u8], transfer_id: u16) -> Result<(), ()> {
+        self.reap(hal, index);
+        let pipe = self.pipes.get_mut(index).ok_or(())?;
+        let ring = pipe.src.as_mut().ok_or(())?;
+        if data.len() > ring.buf_len {
+            return Err(());
+        }
+        hal.access_begin(&mut ring.srng);
+        if ring.srng.src_num_free() < 1 {
+            hal.access_end(bus, &ring.srng);
+            return Err(());
+        }
+        let Some(at) = ring.srng.src_get_next_reaped() else {
+            hal.access_end(bus, &ring.srng);
+            return Err(());
+        };
+        let buffer = &ring.buffers[ring.write_index];
+        buffer.write_bytes(0, data).map_err(|_| ())?;
+        let address = buffer.daddr() as u64;
+        let mut desc = [0u8; 16];
+        put_le32(&mut desc, 0, address as u32);
+        put_le32(
+            &mut desc,
+            4,
+            hal::field(HAL_CE_SRC_DESC_ADDR_INFO_ADDR_HI, (address >> 32) as u32) | hal::field(HAL_CE_SRC_DESC_ADDR_INFO_LEN, data.len() as u32),
+        );
+        put_le32(&mut desc, 8, hal::field(HAL_CE_SRC_DESC_META_INFO_DATA, transfer_id as u32));
+        ring.srng.write(at, &desc);
+        ring.write_index = (ring.write_index + 1) & (ring.nentries - 1);
+        hal.access_end(bus, &ring.srng);
+        let _ = pipe.attr;
+        Ok(())
+    }
+
+    /// `ath11k_ce_completed_send_next`: the source entries the hardware is
+    /// done with, their buffers free again.
+    fn reap(&mut self, hal: &Hal, index: usize) {
+        let Some(pipe) = self.pipes.get_mut(index) else { return };
+        let Some(ring) = &mut pipe.src else { return };
+        hal.access_begin(&mut ring.srng);
+        while ring.srng.src_reap_next().is_some() {
+            ring.sw_index = (ring.sw_index + 1) & (ring.nentries - 1);
+        }
+    }
+
+    /// `ath11k_ce_recv_process_cb`: the messages a destination pipe holds,
+    /// its buffers posted again.
+    pub(crate) fn receive(&mut self, hal: &Hal, bus: &Bus, index: usize) -> Vec<Vec<u8>> {
+        let mut out = Vec::new();
+        {
+            let Some(pipe) = self.pipes.get_mut(index) else { return out };
+            let (Some(dst), Some(status)) = (&mut pipe.dst, &mut pipe.status) else { return out };
+            hal.access_begin(&mut status.srng);
+            while let Some(at) = status.srng.dst_get_next_entry() {
+                let desc = status.srng.read(at);
+                let flags = u32::from_le_bytes(desc[0..4].try_into().unwrap());
+                let len = hal::get(HAL_CE_DST_STATUS_DESC_FLAGS_LEN, flags) as usize;
+                // The length read, the field is cleared as Linux does.
+                status.srng.write(at, &(flags & !HAL_CE_DST_STATUS_DESC_FLAGS_LEN).to_le_bytes());
+                let slot = dst.sw_index;
+                dst.sw_index = (dst.sw_index + 1) & (dst.nentries - 1);
+                pipe.rx_buf_needed += 1;
+                if len == 0 || len > dst.buf_len {
+                    continue;
+                }
+                let mut data = alloc::vec![0u8; len];
+                if dst.buffers[slot].read_bytes(0, &mut data).is_ok() {
+                    out.push(data);
+                }
+            }
+            hal.access_end(bus, &status.srng);
+        }
+        self.post_rx(hal, bus, index);
+        out
+    }
+
+    pub(crate) fn pipes(&self) -> usize {
+        self.pipes.len()
+    }
+
+    /// Whether a pipe takes messages from the target.
+    pub(crate) fn is_rx(&self, index: usize) -> bool {
+        self.pipes.get(index).is_some_and(|pipe| pipe.attr.recv)
+    }
+}
diff --git a/kernel/comps/ath11k/src/dp.rs b/kernel/comps/ath11k/src/dp.rs
new file mode 100644
index 0000000..03b1633
--- /dev/null
+++ b/kernel/comps/ath11k/src/dp.rs
@@ -0,0 +1,944 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The data path as Linux's ath11k `dp.c`, `dp_rx.c`, `dp_tx.c`,
+//! `hal_rx.c` and `hal_tx.c` run it, for one interface: the rings the host
+//! shares with the hardware (frames to send on TCL, their completions on
+//! WBM, received frames from REO, the errors), the idle list of link
+//! descriptors the hardware strings frames on, the receive buffers, the
+//! reorder queues of each peer's TIDs (the access point's, or as an
+//! access point its stations'), and HTT, the firmware's data-path
+//! messages.
+
+use alloc::{collections::BTreeMap, vec, vec::Vec};
+
+use aster_linuxkpi::dma::alloc_coherent32;
+use ostd::mm::{HasDaddr, VmIo, dma::DmaCoherent};
+
+use crate::{
+    hal::{Hal, Params, RingType, Srng, field, get},
+    hw::{HwParams, RxDesc},
+    pci::Bus,
+    regs::*,
+};
+
+/// The most bytes of one chunk of buffers' memory.
+const CHUNK: usize = 64 * 1024;
+/// Ring sizes: smaller than Linux's (a station's traffic), entries.
+const REFILL_ENTRIES: u32 = 512;
+const REO_DST_ENTRIES: u32 = 512;
+const TCL_DATA_ENTRIES: u32 = 512;
+const TX_COMP_ENTRIES: u32 = 1024;
+const TX_SLOTS: usize = 256;
+const ERR_ENTRIES: u32 = 256;
+const MON_ENTRIES: u32 = 64;
+/// Link descriptors: four banks of 2048.
+const LINK_BANKS: usize = 4;
+const LINK_PER_BANK: u32 = 2048;
+/// A REO queue descriptor with its three extensions (the most a QoS TID
+/// takes, `ath11k_hal_reo_qdesc_size` with a 256-frame window).
+const QDESC_SIZE: usize = 512;
+const TIDS: u32 = HAL_DESC_REO_NON_QOS_TID + 1;
+/// `struct hal_rx_msdu_link`: the MSDUs' buffer addresses start at word 8,
+/// four words each.
+const MSDU_LINK_FIRST: usize = 8;
+const MSDU_LINK_STRIDE: usize = 4;
+/// `enum wme_ac` of Linux's ath11k `core.h`.
+const AC_BE: u32 = 0;
+const AC_BK: u32 = 1;
+const AC_VI: u32 = 2;
+const AC_VO: u32 = 3;
+
+/// Where a family's receive descriptor (`struct hal_rx_desc`, `rx_desc.h`)
+/// keeps what the host reads: its size (the frame follows), the MSDU end's
+/// word with the padding before the frame, the attention block and the
+/// MSDU start (offsets from the packed structures).
+struct Layout {
+    size: usize,
+    end: usize,
+    l3pad: u32,
+    attention: usize,
+    msdu_start: usize,
+}
+
+fn layout(kind: RxDesc) -> Layout {
+    match kind {
+        RxDesc::Ipq8074 => Layout { size: 384, end: 24, l3pad: RX_MSDU_END_INFO2_L3_HDR_PADDING, attention: 76, msdu_start: 92 },
+        RxDesc::Qcn9074 => Layout { size: 384, end: 46, l3pad: RX_MSDU_END_INFO4_L3_HDR_PADDING, attention: 76, msdu_start: 92 },
+        RxDesc::Wcn6855 => Layout { size: 392, end: 44, l3pad: RX_MSDU_END_INFO2_L3_HDR_PADDING, attention: 84, msdu_start: 100 },
+    }
+}
+
+fn word_at(bytes: &[u8], offset: usize) -> u32 {
+    bytes.get(offset..offset + 4).map_or(0, |b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+}
+
+fn words_of(entry: &[u8]) -> Vec<u32> {
+    entry.chunks_exact(4).map(|b| u32::from_le_bytes([b[0], b[1], b[2], b[3]])).collect()
+}
+
+fn bytes_of(words: &[u32]) -> Vec<u8> {
+    words.iter().flat_map(|word| word.to_le_bytes()).collect()
+}
+
+/// `ath11k_tid_to_ac`.
+fn tid_to_ac(tid: u32) -> u32 {
+    match tid {
+        0 | 3 => AC_BE,
+        1 | 2 => AC_BK,
+        4 | 5 => AC_VI,
+        _ => AC_VO,
+    }
+}
+
+/// Buffers the hardware reads or writes, in chunks of contiguous memory.
+struct Slots {
+    chunks: Vec<DmaCoherent>,
+    per_chunk: usize,
+    size: usize,
+    free: Vec<u32>,
+    used: Vec<bool>,
+}
+
+impl Slots {
+    fn new(count: usize, size: usize) -> Result<Self, &'static str> {
+        let per_chunk = (CHUNK / size).max(1);
+        let mut chunks = Vec::new();
+        let mut made = 0;
+        while made < count {
+            let n = per_chunk.min(count - made);
+            chunks.push(alloc_coherent32(n * size).ok_or("no memory for the data path's buffers")?);
+            made += n;
+        }
+        Ok(Self { chunks, per_chunk, size, free: (0..count as u32).rev().collect(), used: vec![false; count] })
+    }
+
+    fn alloc(&mut self) -> Option<u32> {
+        let slot = self.free.pop()?;
+        self.used[slot as usize] = true;
+        Some(slot)
+    }
+
+    fn release(&mut self, slot: u32) {
+        if let Some(used) = self.used.get_mut(slot as usize)
+            && *used
+        {
+            *used = false;
+            self.free.push(slot);
+        }
+    }
+
+    fn in_use(&self, slot: u32) -> bool {
+        self.used.get(slot as usize).copied().unwrap_or(false)
+    }
+
+    fn locate(&self, slot: u32) -> (&DmaCoherent, usize) {
+        let slot = slot as usize;
+        (&self.chunks[slot / self.per_chunk], (slot % self.per_chunk) * self.size)
+    }
+
+    fn paddr(&self, slot: u32) -> u64 {
+        let (chunk, offset) = self.locate(slot);
+        chunk.daddr() as u64 + offset as u64
+    }
+
+    fn write(&self, slot: u32, data: &[u8]) {
+        let (chunk, offset) = self.locate(slot);
+        let _ = chunk.write_bytes(offset, &data[..data.len().min(self.size)]);
+    }
+
+    fn read(&self, slot: u32, at: usize, len: usize) -> Vec<u8> {
+        let (chunk, offset) = self.locate(slot);
+        let len = len.min(self.size.saturating_sub(at));
+        let mut out = vec![0u8; len];
+        let _ = chunk.read_bytes(offset + at, &mut out);
+        out
+    }
+}
+
+/// A frame the data path received: as the hardware's decapsulation left
+/// it, whether the hardware says it decrypted it (its security header and
+/// MIC gone), whether it was group-addressed. Whether a key was in place
+/// for it is the interface's to say.
+pub(crate) struct Received {
+    pub(crate) frame: Vec<u8>,
+    /// 802.11's header without QoS control, then the payload ("native
+    /// Wi-Fi"); otherwise an Ethernet frame.
+    pub(crate) native: bool,
+    pub(crate) decrypted: bool,
+    pub(crate) group: bool,
+}
+
+/// A peer as the firmware mapped it (HTT's PEER_MAP).
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct PeerMap {
+    pub(crate) peer_id: u32,
+    pub(crate) address: [u8; 6],
+    pub(crate) ast_hash: u32,
+    pub(crate) hw_peer_id: u32,
+}
+
+/// What a message from HTT said.
+pub(crate) enum HttEvent {
+    Version(u32, u32),
+    PeerMap(PeerMap),
+    PeerUnmap(u32),
+}
+
+pub(crate) struct Dp {
+    hw: &'static HwParams,
+    layout: Layout,
+    // ---- The SoC's rings (`ath11k_dp_alloc`). ----
+    _wbm_idle: Srng,
+    link_banks: Vec<DmaCoherent>,
+    wbm_desc_rel: Srng,
+    _tcl_cmd: Srng,
+    _tcl_status: Srng,
+    tcl_data: Srng,
+    tcl_comp: Srng,
+    _reo_reinject: Srng,
+    rx_rel: Srng,
+    reo_except: Srng,
+    reo_cmd: Srng,
+    reo_status: Srng,
+    reo_dst: Vec<Srng>,
+    // ---- The radio's (`ath11k_dp_rx_pdev_alloc`). ----
+    refill: Option<Srng>,
+    mac_buf: Vec<Srng>,
+    rxdma_err: Vec<Srng>,
+    mon_status: Vec<Srng>,
+    monitor: Vec<(Srng, RingType)>,
+    rx_bufs: Slots,
+    tx_bufs: Slots,
+    /// Each peer's reorder queues, one per TID.
+    queues: BTreeMap<[u8; 6], DmaCoherent>,
+    /// A received MSDU spread over several buffers, being put together.
+    pending: Option<Vec<u8>>,
+    /// The TX descriptor's metadata and address search
+    /// (`ath11k_dp_vdev_tx_attach`).
+    tcl_metadata: u32,
+    search: (u32, u32, u32, u32),
+    /// The return buffer manager of TX ring 0.
+    tx_rbm: u32,
+}
+
+/// The rings' entries of a type, as `ath11k_dp_srng_setup` clamps them.
+fn setup(hal: &Hal, bus: &Bus, ty: RingType, ring_num: u32, mac_id: u32, entries: u32) -> Result<Srng, &'static str> {
+    hal.setup(bus, ty, ring_num, mac_id, entries, Params::default())
+}
+
+impl Dp {
+    /// `ath11k_dp_alloc`: the idle link descriptors and the SoC's rings.
+    pub(crate) fn new(hw: &'static HwParams, hal: &Hal, bus: &Bus) -> Result<Self, &'static str> {
+        let n_link = LINK_BANKS as u32 * LINK_PER_BANK;
+        let mut wbm_idle = setup(hal, bus, RingType::WbmIdleLink, 0, 0, n_link)?;
+        let mut link_banks = Vec::with_capacity(LINK_BANKS);
+        for _ in 0..LINK_BANKS {
+            link_banks.push(alloc_coherent32(LINK_PER_BANK as usize * HAL_LINK_DESC_SIZE as usize).ok_or("no memory for link descriptors")?);
+        }
+        // `ath11k_dp_link_desc_setup`: every descriptor on the idle list,
+        // its bank in the cookie.
+        hal.access_begin(&mut wbm_idle);
+        'fill: for (bank, mem) in link_banks.iter().enumerate() {
+            for index in 0..LINK_PER_BANK as u64 {
+                let Some(at) = wbm_idle.src_get_next_entry() else { break 'fill };
+                let paddr = mem.daddr() as u64 + index * HAL_LINK_DESC_SIZE as u64;
+                wbm_idle.write(at, &bytes_of(&[
+                    field(BUFFER_ADDR_INFO0_ADDR, paddr as u32),
+                    field(BUFFER_ADDR_INFO1_ADDR, (paddr >> HAL_ADDR_MSB_REG_SHIFT) as u32)
+                        | field(BUFFER_ADDR_INFO1_RET_BUF_MGR, 1)
+                        | field(BUFFER_ADDR_INFO1_SW_COOKIE, bank as u32),
+                ]));
+            }
+        }
+        hal.access_end(bus, &wbm_idle);
+
+        // `ath11k_dp_srng_common_setup`.
+        let wbm_desc_rel = setup(hal, bus, RingType::Sw2WbmRelease, 0, 0, DP_WBM_RELEASE_RING_SIZE)?;
+        let tcl_cmd = setup(hal, bus, RingType::TclCmd, 0, 0, DP_TCL_CMD_RING_SIZE)?;
+        let tcl_status = setup(hal, bus, RingType::TclStatus, 0, 0, DP_TCL_STATUS_RING_SIZE)?;
+        // TX ring 0: TCL ring 0, its completions on WBM2SW ring 0 (every
+        // family's first entry of `tcl2wbm_rbm_map`).
+        let tcl_data = setup(hal, bus, RingType::TclData, 0, 0, TCL_DATA_ENTRIES)?;
+        let tcl_comp = setup(hal, bus, RingType::Wbm2SwRelease, 0, 0, TX_COMP_ENTRIES)?;
+        // `ath11k_hal_tx_init_data_ring`: each entry's TLV header.
+        let header = field(HAL_TLV_HDR_TAG, HAL_TCL_DATA_CMD) | field(HAL_TLV_HDR_LEN, 28);
+        for index in 0..tcl_data.num_entries {
+            tcl_data.write(index * tcl_data.entry_size, &header.to_le_bytes());
+        }
+        let reo_reinject = setup(hal, bus, RingType::ReoReinject, 0, 0, DP_REO_REINJECT_RING_SIZE)?;
+        let rx_rel = setup(hal, bus, RingType::Wbm2SwRelease, DP_RX_RELEASE_RING_NUM, 0, ERR_ENTRIES)?;
+        let reo_except = setup(hal, bus, RingType::ReoException, 0, 0, DP_REO_EXCEPTION_RING_SIZE)?;
+        let reo_cmd = setup(hal, bus, RingType::ReoCmd, 0, 0, 64)?;
+        // `ath11k_hal_reo_init_cmd_ring`: the commands' numbers.
+        for index in 0..reo_cmd.num_entries {
+            reo_cmd.write(index * reo_cmd.entry_size + 1, &field(HAL_REO_CMD_HDR_INFO0_CMD_NUMBER, index + 1).to_le_bytes());
+        }
+        let reo_status = setup(hal, bus, RingType::ReoStatus, 0, 0, ERR_ENTRIES)?;
+        let dp = Self {
+            hw,
+            layout: layout(hw.rx_desc),
+            _wbm_idle: wbm_idle,
+            link_banks,
+            wbm_desc_rel,
+            _tcl_cmd: tcl_cmd,
+            _tcl_status: tcl_status,
+            tcl_data,
+            tcl_comp,
+            _reo_reinject: reo_reinject,
+            rx_rel,
+            reo_except,
+            reo_cmd,
+            reo_status,
+            reo_dst: Vec::new(),
+            refill: None,
+            mac_buf: Vec::new(),
+            rxdma_err: Vec::new(),
+            mon_status: Vec::new(),
+            monitor: Vec::new(),
+            rx_bufs: Slots::new(REFILL_ENTRIES as usize - 1, DP_RX_BUFFER_SIZE as usize)?,
+            tx_bufs: Slots::new(TX_SLOTS, DP_RX_BUFFER_SIZE as usize)?,
+            queues: BTreeMap::new(),
+            pending: None,
+            tcl_metadata: 0,
+            search: (0, 0, 0, 0),
+            tx_rbm: HAL_RX_BUF_RBM_SW0_BM,
+        };
+        dp.reo_setup(bus);
+        dp.dscp_tid_maps(bus);
+        Ok(dp)
+    }
+
+    /// The families' `reo_setup`: aging, the fragments' ring, hash
+    /// routing over the four REO rings.
+    fn reo_setup(&self, bus: &Bus) {
+        let reo = HAL_SEQ_WCSS_UMAC_REO_REG;
+        let r = self.hw.regs;
+        let wcn6855 = self.hw.rx_desc == RxDesc::Wcn6855;
+        let rings = [HAL_HASH_ROUTING_RING_SW1, HAL_HASH_ROUTING_RING_SW2, HAL_HASH_ROUTING_RING_SW3, HAL_HASH_ROUTING_RING_SW4];
+        let bits = if wcn6855 { 4 } else { 3 };
+        let map = (0..8).fold(0u32, |map, index| map | rings[index % 4] << (index as u32 * bits));
+        let mut value = bus.read32(reo + HAL_REO1_GEN_ENABLE);
+        if !wcn6855 {
+            value = (value & !HAL_REO1_GEN_ENABLE_FRAG_DST_RING) | field(HAL_REO1_GEN_ENABLE_FRAG_DST_RING, HAL_SRNG_RING_ID_REO2SW1);
+        }
+        value |= field(HAL_REO1_GEN_ENABLE_AGING_LIST_ENABLE, 1) | field(HAL_REO1_GEN_ENABLE_AGING_FLUSH_ENABLE, 1);
+        bus.write32(reo + HAL_REO1_GEN_ENABLE, value);
+        if wcn6855 {
+            let misc = reo + r.hal_reo1_misc_ctl;
+            let value = (bus.read32(misc) & !HAL_REO1_MISC_CTL_FRAGMENT_DST_RING) | field(HAL_REO1_MISC_CTL_FRAGMENT_DST_RING, HAL_SRNG_RING_ID_REO2SW1);
+            bus.write32(misc, value);
+        }
+        for at in [r.hal_reo1_aging_thresh_ix_0, r.hal_reo1_aging_thresh_ix_1, r.hal_reo1_aging_thresh_ix_2, r.hal_reo1_aging_thresh_ix_3] {
+            bus.write32(reo + at, HAL_DEFAULT_REO_TIMEOUT_USEC);
+        }
+        if wcn6855 {
+            bus.write32(reo + HAL_REO1_DEST_RING_CTRL_IX_2, map);
+            bus.write32(reo + HAL_REO1_DEST_RING_CTRL_IX_3, map);
+        } else {
+            for at in [HAL_REO1_DEST_RING_CTRL_IX_0, HAL_REO1_DEST_RING_CTRL_IX_1, HAL_REO1_DEST_RING_CTRL_IX_2, HAL_REO1_DEST_RING_CTRL_IX_3] {
+                bus.write32(reo + at, field(HAL_REO_DEST_RING_CTRL_HASH_RING_MAP, map));
+            }
+        }
+    }
+
+    /// `ath11k_hal_tx_set_dscp_tid_map` for every table: DSCP's top three
+    /// bits are the TID.
+    fn dscp_tid_maps(&self, bus: &Bus) {
+        let tcl = HAL_SEQ_WCSS_UMAC_TCL_REG;
+        let masks = [
+            HAL_TCL1_RING_FIELD_DSCP_TID_MAP0,
+            HAL_TCL1_RING_FIELD_DSCP_TID_MAP1,
+            HAL_TCL1_RING_FIELD_DSCP_TID_MAP2,
+            HAL_TCL1_RING_FIELD_DSCP_TID_MAP3,
+            HAL_TCL1_RING_FIELD_DSCP_TID_MAP4,
+            HAL_TCL1_RING_FIELD_DSCP_TID_MAP5,
+            HAL_TCL1_RING_FIELD_DSCP_TID_MAP6,
+            HAL_TCL1_RING_FIELD_DSCP_TID_MAP7,
+        ];
+        let mut table = Vec::with_capacity(HAL_DSCP_TID_TBL_SIZE as usize);
+        for dscp in (0..64u32).step_by(8) {
+            let value = masks.iter().fold(0, |value, mask| value | field(*mask, dscp >> 3));
+            table.extend_from_slice(&value.to_le_bytes()[..3]);
+        }
+        table.resize(HAL_DSCP_TID_TBL_SIZE as usize, 0);
+        let ctrl = tcl + HAL_TCL1_RING_CMN_CTRL_REG;
+        for id in 0..HAL_DSCP_TID_MAP_TBL_NUM_ENTRIES_MAX {
+            bus.write32(ctrl, bus.read32(ctrl) | HAL_TCL1_RING_CMN_CTRL_DSCP_TID_MAP_PROG_EN);
+            let mut at = tcl + HAL_TCL1_RING_DSCP_TID_MAP + 4 * id * (HAL_DSCP_TID_TBL_SIZE / 4);
+            for chunk in table.chunks_exact(4) {
+                bus.write32(at, u32::from_le_bytes([chunk[0], chunk[1], chunk[2], chunk[3]]));
+                at += 4;
+            }
+            bus.write32(ctrl, bus.read32(ctrl) & !HAL_TCL1_RING_CMN_CTRL_DSCP_TID_MAP_PROG_EN);
+        }
+    }
+
+    /// `ath11k_dp_pdev_reo_setup`: the four REO destination rings.
+    pub(crate) fn reo_dst_setup(&mut self, hal: &Hal, bus: &Bus) -> Result<(), &'static str> {
+        for ring in 0..DP_REO_DST_RING_MAX {
+            self.reo_dst.push(setup(hal, bus, RingType::ReoDst, ring, 0, REO_DST_ENTRIES)?);
+        }
+        Ok(())
+    }
+
+    /// `ath11k_dp_rx_pdev_alloc` for radio 0: its rings, the receive
+    /// buffers, and HTT's messages telling the firmware of the rings.
+    pub(crate) fn pdev_setup(&mut self, hal: &Hal, bus: &Bus) -> Result<Vec<Vec<u8>>, &'static str> {
+        let hw = self.hw;
+        let mut refill = setup(hal, bus, RingType::RxdmaBuf, 0, 0, REFILL_ENTRIES)?;
+        let mut messages = Vec::new();
+        if hw.rx_mac_buf_ring {
+            for mac in 0..hw.num_rxdma_per_pdev {
+                self.mac_buf.push(setup(hal, bus, RingType::RxdmaBuf, 1, mac, 1024)?);
+            }
+        }
+        for mac in 0..hw.num_rxdma_per_pdev {
+            self.rxdma_err.push(setup(hal, bus, RingType::RxdmaDst, 0, mac, ERR_ENTRIES)?);
+            self.mon_status.push(setup(hal, bus, RingType::RxdmaMonitorStatus, 0, mac, MON_ENTRIES)?);
+        }
+        if hw.rxdma1_enable {
+            for ty in [RingType::RxdmaMonitorBuf, RingType::RxdmaMonitorDst, RingType::RxdmaMonitorDesc] {
+                self.monitor.push((setup(hal, bus, ty, 0, 0, MON_ENTRIES)?, ty));
+            }
+        }
+        self.replenish(hal, bus, &mut refill);
+        messages.push(self.srng_setup_message(hal, &refill, 0, RingType::RxdmaBuf));
+        for (mac, ring) in self.mac_buf.iter().enumerate() {
+            messages.push(self.srng_setup_message(hal, ring, mac as u32, RingType::RxdmaBuf));
+        }
+        for (mac, ring) in self.rxdma_err.iter().enumerate() {
+            messages.push(self.srng_setup_message(hal, ring, mac as u32, RingType::RxdmaDst));
+        }
+        for (ring, ty) in &self.monitor {
+            messages.push(self.srng_setup_message(hal, ring, 0, *ty));
+        }
+        for (mac, ring) in self.mon_status.iter().enumerate() {
+            messages.push(self.srng_setup_message(hal, ring, mac as u32, RingType::RxdmaMonitorStatus));
+        }
+        self.refill = Some(refill);
+        Ok(messages)
+    }
+
+    /// `ath11k_dp_tx_get_ring_id_type`: HTT's ring type and id.
+    fn htt_ring(&self, ring_id: u32, ty: RingType) -> (u32, u32) {
+        match ty {
+            // The QCA6390 family's host fills the firmware's ring; the
+            // firmware fills each RXDMA's.
+            RingType::RxdmaBuf if self.hw.rx_mac_buf_ring && ring_id == HAL_SRNG_RING_ID_WMAC1_SW2RXDMA0_BUF => (HTT_SW_TO_SW_RING, HTT_HOST1_TO_FW_RXBUF_RING),
+            RingType::RxdmaBuf => (HTT_SW_TO_HW_RING, HTT_RXDMA_HOST_BUF_RING),
+            RingType::RxdmaDst => (HTT_HW_TO_SW_RING, HTT_RXDMA_NON_MONITOR_DEST_RING),
+            RingType::RxdmaMonitorBuf => (HTT_SW_TO_HW_RING, HTT_RXDMA_MONITOR_BUF_RING),
+            RingType::RxdmaMonitorStatus => (HTT_SW_TO_HW_RING, HTT_RXDMA_MONITOR_STATUS_RING),
+            RingType::RxdmaMonitorDst => (HTT_HW_TO_SW_RING, HTT_RXDMA_MONITOR_DEST_RING),
+            _ => (HTT_SW_TO_HW_RING, HTT_RXDMA_MONITOR_DESC_RING),
+        }
+    }
+
+    /// `ath11k_dp_tx_htt_srng_setup`: an LMAC ring for the firmware (no
+    /// MSI: the host polls).
+    fn srng_setup_message(&self, hal: &Hal, srng: &Srng, mac_id: u32, ty: RingType) -> Vec<u8> {
+        let (ring_type, ring_id) = self.htt_ring(srng.ring_id, ty);
+        let pdev = if ring_type == HTT_SW_TO_HW_RING || ring_type == HTT_HW_TO_SW_RING { mac_id + 1 } else { mac_id };
+        let (hp, tp) = hal.lmac_pointers(srng);
+        let paddr = srng.paddr();
+        let mut info1 = field(HTT_SRNG_SETUP_CMD_INFO1_RING_ENTRY_SIZE, srng.entry_size) | field(HTT_SRNG_SETUP_CMD_INFO1_RING_SIZE, srng.num_entries * srng.entry_size);
+        if ring_type == HTT_SW_TO_HW_RING {
+            info1 |= HTT_SRNG_SETUP_CMD_INFO1_RING_LOOP_CNT_DIS;
+        }
+        bytes_of(&[
+            field(HTT_SRNG_SETUP_CMD_INFO0_MSG_TYPE, HTT_H2T_MSG_TYPE_SRING_SETUP)
+                | field(HTT_SRNG_SETUP_CMD_INFO0_PDEV_ID, pdev)
+                | field(HTT_SRNG_SETUP_CMD_INFO0_RING_TYPE, ring_type)
+                | field(HTT_SRNG_SETUP_CMD_INFO0_RING_ID, ring_id),
+            paddr as u32,
+            (paddr >> HAL_ADDR_MSB_REG_SHIFT) as u32,
+            info1,
+            hp as u32,
+            (hp >> HAL_ADDR_MSB_REG_SHIFT) as u32,
+            tp as u32,
+            (tp >> HAL_ADDR_MSB_REG_SHIFT) as u32,
+            0,
+            0,
+            0,
+            0,
+            0,
+        ])
+    }
+
+    /// `ath11k_dp_tx_htt_h2t_ver_req_msg`'s message.
+    pub(crate) fn version_request() -> Vec<u8> {
+        field(HTT_VER_REQ_INFO_MSG_ID, HTT_H2T_MSG_TYPE_VERSION_REQ).to_le_bytes().to_vec()
+    }
+
+    /// `ath11k_dp_htt_htc_t2h_msg_handler`.
+    pub(crate) fn htt_message(payload: &[u8]) -> Option<HttEvent> {
+        let words = words_of(payload);
+        let first = *words.first()?;
+        match get(HTT_T2H_MSG_TYPE, first) {
+            HTT_T2H_MSG_TYPE_VERSION_CONF => Some(HttEvent::Version(get(HTT_T2H_VERSION_CONF_MAJOR, first), get(HTT_T2H_VERSION_CONF_MINOR, first))),
+            kind @ (HTT_T2H_MSG_TYPE_PEER_MAP | HTT_T2H_MSG_TYPE_PEER_MAP2) => {
+                let (low, info1, info2) = (*words.get(1)?, *words.get(2)?, words.get(3).copied().unwrap_or(0));
+                let high = get(HTT_T2H_PEER_MAP_INFO1_MAC_ADDR_H16, info1) as u16;
+                let mut address = [0u8; 6];
+                address[..4].copy_from_slice(&low.to_le_bytes());
+                address[4..].copy_from_slice(&high.to_le_bytes());
+                let v2 = kind == HTT_T2H_MSG_TYPE_PEER_MAP2;
+                Some(HttEvent::PeerMap(PeerMap {
+                    peer_id: get(HTT_T2H_PEER_MAP_INFO_PEER_ID, first),
+                    address,
+                    ast_hash: if v2 { get(HTT_T2H_PEER_MAP_INFO2_AST_HASH_VAL, info2) } else { 0 },
+                    hw_peer_id: if v2 { get(HTT_T2H_PEER_MAP_INFO1_HW_PEER_ID, info1) } else { 0 },
+                }))
+            }
+            HTT_T2H_MSG_TYPE_PEER_UNMAP | HTT_T2H_MSG_TYPE_PEER_UNMAP2 => Some(HttEvent::PeerUnmap(get(HTT_T2H_PEER_UNMAP_INFO_PEER_ID, first))),
+            _ => None,
+        }
+    }
+
+    /// `ath11k_dp_rxbufs_replenish`: every free buffer on the refill ring,
+    /// its index (from 1) in the cookie.
+    fn replenish(&mut self, hal: &Hal, bus: &Bus, refill: &mut Srng) {
+        hal.access_begin(refill);
+        let mut filled = false;
+        while refill.src_num_free() > 0 {
+            let Some(slot) = self.rx_bufs.alloc() else { break };
+            let Some(at) = refill.src_get_next_entry() else {
+                self.rx_bufs.release(slot);
+                break;
+            };
+            let paddr = self.rx_bufs.paddr(slot);
+            let cookie = field(DP_RXDMA_BUF_COOKIE_PDEV_ID, 0) | field(DP_RXDMA_BUF_COOKIE_BUF_ID, slot + 1);
+            refill.write(at, &bytes_of(&[
+                field(BUFFER_ADDR_INFO0_ADDR, paddr as u32),
+                field(BUFFER_ADDR_INFO1_ADDR, (paddr >> HAL_ADDR_MSB_REG_SHIFT) as u32)
+                    | field(BUFFER_ADDR_INFO1_SW_COOKIE, cookie)
+                    | field(BUFFER_ADDR_INFO1_RET_BUF_MGR, self.hw.rx_buf_rbm),
+            ]));
+            filled = true;
+        }
+        if filled {
+            hal.access_end(bus, refill);
+        }
+    }
+
+    fn refill(&mut self, hal: &Hal, bus: &Bus) {
+        if let Some(mut refill) = self.refill.take() {
+            self.replenish(hal, bus, &mut refill);
+            self.refill = Some(refill);
+        }
+    }
+
+    /// A buffer the hardware handed back, by its cookie: its bytes (the
+    /// receive descriptor, then the frame), the buffer freed.
+    fn take_buffer(&mut self, cookie: u32) -> Option<Vec<u8>> {
+        let id = get(DP_RXDMA_BUF_COOKIE_BUF_ID, cookie);
+        if id == 0 || !self.rx_bufs.in_use(id - 1) {
+            return None;
+        }
+        let bytes = self.rx_bufs.read(id - 1, 0, DP_RX_BUFFER_SIZE as usize);
+        self.rx_bufs.release(id - 1);
+        Some(bytes)
+    }
+
+    /// `ath11k_dp_process_rx` over the four REO rings, then
+    /// `ath11k_dp_rx_process_msdu` on each frame (a frame over several
+    /// buffers put together as `ath11k_dp_rx_msdu_coalesce` does).
+    pub(crate) fn receive(&mut self, hal: &Hal, bus: &Bus) -> Vec<Received> {
+        let mut out = Vec::new();
+        let mut rings = core::mem::take(&mut self.reo_dst);
+        for ring in rings.iter_mut() {
+            hal.access_begin(ring);
+            let mut reaped = false;
+            while let Some(at) = ring.dst_get_next_entry() {
+                reaped = true;
+                let entry = words_of(&ring.read(at));
+                let cookie = get(BUFFER_ADDR_INFO1_SW_COOKIE, entry[1]);
+                let Some(buffer) = self.take_buffer(cookie) else { continue };
+                if get(HAL_REO_DEST_RING_INFO0_PUSH_REASON, entry[7]) != HAL_REO_DEST_RING_PUSH_REASON_ROUTING_INSTRUCTION {
+                    self.pending = None;
+                    continue;
+                }
+                let continuation = entry[4] & RX_MSDU_DESC_INFO0_MSDU_CONTINUATION != 0;
+                if let Some(frame) = self.msdu(buffer, continuation) {
+                    out.push(frame);
+                }
+            }
+            if reaped {
+                hal.access_end(bus, ring);
+            }
+        }
+        self.reo_dst = rings;
+        self.refill(hal, bus);
+        out
+    }
+
+    /// One buffer of an MSDU: the frame when it is whole.
+    fn msdu(&mut self, buffer: Vec<u8>, continuation: bool) -> Option<Received> {
+        let l = &self.layout;
+        let size = l.size;
+        if let Some(mut pending) = self.pending.take() {
+            // A later buffer: its own descriptor first (the last one's
+            // attention and MSDU end are the frame's).
+            pending.extend_from_slice(buffer.get(size..)?);
+            if continuation {
+                self.pending = Some(pending);
+                return None;
+            }
+            return self.finish(&buffer, pending);
+        }
+        let msdu_len = get(RX_MSDU_START_INFO1_MSDU_LENGTH, word_at(&buffer, l.msdu_start + 4)) as usize;
+        let l3pad = get(l.l3pad, word_at(&buffer, l.end)) as usize;
+        let start = size + l3pad;
+        if continuation {
+            let mut pending = buffer.get(start..)?.to_vec();
+            pending.reserve(msdu_len.saturating_sub(pending.len()));
+            // The total length rides in front until the frame is whole.
+            let mut head = (msdu_len as u32).to_le_bytes().to_vec();
+            head.append(&mut pending);
+            self.pending = Some(head);
+            return None;
+        }
+        if start + msdu_len > buffer.len() {
+            return None;
+        }
+        let frame = buffer[start..start + msdu_len].to_vec();
+        self.deliver(&buffer, frame)
+    }
+
+    fn finish(&mut self, last: &[u8], pending: Vec<u8>) -> Option<Received> {
+        let len = u32::from_le_bytes(pending.get(..4)?.try_into().ok()?) as usize;
+        let body = pending.get(4..4 + len)?.to_vec();
+        self.deliver(last, body)
+    }
+
+    /// `ath11k_dp_rx_h_mpdu`'s checks: done, no error; what the hardware
+    /// says of its decryption.
+    fn deliver(&self, desc: &[u8], frame: Vec<u8>) -> Option<Received> {
+        let l = &self.layout;
+        let info1 = word_at(desc, l.attention + 4);
+        let info2 = word_at(desc, l.attention + 8);
+        if info2 & RX_ATTENTION_INFO2_MSDU_DONE == 0 {
+            return None;
+        }
+        let errors = RX_ATTENTION_INFO1_FCS_ERR
+            | RX_ATTENTION_INFO1_DECRYPT_ERR
+            | RX_ATTENTION_INFO1_TKIP_MIC_ERR
+            | RX_ATTENTION_INFO1_A_MSDU_ERROR
+            | RX_ATTENTION_INFO1_OVERFLOW_ERR
+            | RX_ATTENTION_INFO1_MSDU_LEN_ERR
+            | RX_ATTENTION_INFO1_MPDU_LEN_ERR;
+        if info1 & errors != 0 {
+            return None;
+        }
+        let group = info1 & RX_ATTENTION_INFO1_MCAST_BCAST != 0;
+        let decrypted = get(RX_ATTENTION_INFO2_DCRYPT_STATUS_CODE, info2) == RX_DESC_DECRYPT_STATUS_CODE_OK;
+        let native = match get(RX_MSDU_START_INFO2_DECAP_FORMAT, word_at(desc, l.msdu_start + 8)) {
+            DP_RX_DECAP_TYPE_NATIVE_WIFI => true,
+            DP_RX_DECAP_TYPE_ETHERNET2_DIX => false,
+            _ => return None,
+        };
+        if frame.len() < if native { 24 } else { 14 } {
+            return None;
+        }
+        Some(Received { frame, native, decrypted, group })
+    }
+
+    /// The error rings: REO's exceptions and the RXDMA errors (their link
+    /// descriptors' buffers freed, the descriptors back on the idle list),
+    /// WBM's released buffers; REO's status ring drained
+    /// (`ath11k_dp_process_rx_err`, `_rxdma_err`, `_rx_process_wbm_err`,
+    /// `_process_reo_status`).
+    pub(crate) fn errors(&mut self, hal: &Hal, bus: &Bus) {
+        let Self { reo_except, rxdma_err, rx_rel, reo_status, rx_bufs, link_banks, wbm_desc_rel, .. } = self;
+        let mut freed = link_ring(hal, bus, reo_except, rx_bufs, link_banks, wbm_desc_rel);
+        for ring in rxdma_err.iter_mut() {
+            freed |= link_ring(hal, bus, ring, rx_bufs, link_banks, wbm_desc_rel);
+        }
+        hal.access_begin(rx_rel);
+        let mut reaped = false;
+        while let Some(at) = rx_rel.dst_get_next_entry() {
+            reaped = true;
+            let entry = words_of(&rx_rel.read(at));
+            if get(HAL_WBM_RELEASE_INFO0_DESC_TYPE, entry[2]) == HAL_WBM_REL_DESC_TYPE_REL_MSDU {
+                drop_cookie(rx_bufs, get(BUFFER_ADDR_INFO1_SW_COOKIE, entry[1]));
+                freed = true;
+            }
+        }
+        if reaped {
+            hal.access_end(bus, rx_rel);
+        }
+        hal.access_begin(reo_status);
+        let mut drained = false;
+        while reo_status.dst_get_next_entry().is_some() {
+            drained = true;
+        }
+        if drained {
+            hal.access_end(bus, reo_status);
+        }
+        if freed {
+            self.refill(hal, bus);
+        }
+    }
+
+    /// `ath11k_dp_tx_completion_handler`: the sent frames' buffers back.
+    /// `true`: some were.
+    pub(crate) fn tx_completions(&mut self, hal: &Hal, bus: &Bus) -> bool {
+        let ring = &mut self.tcl_comp;
+        hal.access_begin(ring);
+        let mut done = Vec::new();
+        while let Some(at) = ring.dst_get_next_entry() {
+            let entry = words_of(&ring.read(at));
+            let desc_id = get(BUFFER_ADDR_INFO1_SW_COOKIE, entry[1]);
+            done.push(get(DP_TX_DESC_ID_MSDU_ID, desc_id));
+        }
+        if !done.is_empty() {
+            hal.access_end(bus, ring);
+        }
+        for slot in &done {
+            self.tx_bufs.release(*slot);
+        }
+        !done.is_empty()
+    }
+
+    /// `ath11k_dp_vdev_tx_attach`, `ath11k_dp_update_vdev_search` and a
+    /// station's peer map: what every TX descriptor carries. An access
+    /// point's frames find their station by the receiver's address.
+    pub(crate) fn attach(&mut self, vdev_id: u32, pdev_id: u32, peer: Option<PeerMap>, ap: bool) {
+        self.tcl_metadata = field(HTT_TCL_META_DATA_TYPE, 1) | field(HTT_TCL_META_DATA_VDEV_ID, vdev_id) | field(HTT_TCL_META_DATA_PDEV_ID, pdev_id);
+        let (ast_hash, ast_idx) = peer.map_or((0, 0), |peer| (peer.ast_hash, peer.hw_peer_id));
+        self.search = if ap {
+            (HAL_TX_ADDRX_EN, HAL_TX_ADDR_SEARCH_DEFAULT, 0, 0)
+        } else if self.hw.htt_peer_map_v2 {
+            (HAL_TX_ADDRX_EN, HAL_TX_ADDR_SEARCH_INDEX, ast_idx, ast_hash)
+        } else {
+            (HAL_TX_ADDRY_EN, HAL_TX_ADDR_SEARCH_DEFAULT, 0, 0)
+        };
+    }
+
+    /// `ath11k_dp_tx` with native Wi-Fi encapsulation: the frame (802.11's
+    /// header without QoS control, then the payload) on TCL ring 0, its
+    /// TID in the descriptor. `Err`: no room now.
+    pub(crate) fn send(&mut self, hal: &Hal, bus: &Bus, frame: &[u8], tid: u32) -> Result<(), ()> {
+        if frame.len() > DP_RX_BUFFER_SIZE as usize {
+            return Ok(());
+        }
+        let slot = self.tx_bufs.alloc().ok_or(())?;
+        self.tx_bufs.write(slot, frame);
+        let paddr = self.tx_bufs.paddr(slot);
+        let desc_id = field(DP_TX_DESC_ID_MAC_ID, 0) | field(DP_TX_DESC_ID_MSDU_ID, slot) | field(DP_TX_DESC_ID_POOL_ID, 0);
+        let (addr_en, search_type, ast_idx, ast_hash) = self.search;
+        let words = [
+            field(HAL_TLV_HDR_TAG, HAL_TCL_DATA_CMD) | field(HAL_TLV_HDR_LEN, 28),
+            field(BUFFER_ADDR_INFO0_ADDR, paddr as u32),
+            field(BUFFER_ADDR_INFO1_ADDR, (paddr >> HAL_ADDR_MSB_REG_SHIFT) as u32) | field(BUFFER_ADDR_INFO1_RET_BUF_MGR, self.tx_rbm) | field(BUFFER_ADDR_INFO1_SW_COOKIE, desc_id),
+            field(HAL_TCL_DATA_CMD_INFO0_DESC_TYPE, HAL_TCL_DESC_TYPE_BUFFER)
+                | field(HAL_TCL_DATA_CMD_INFO0_ENCAP_TYPE, HAL_TCL_ENCAP_TYPE_NATIVE_WIFI)
+                | field(HAL_TCL_DATA_CMD_INFO0_SEARCH_TYPE, search_type)
+                | field(HAL_TCL_DATA_CMD_INFO0_ADDR_EN, addr_en)
+                | field(HAL_TCL_DATA_CMD_INFO0_CMD_NUM, self.tcl_metadata),
+            field(HAL_TCL_DATA_CMD_INFO1_DATA_LEN, frame.len() as u32),
+            field(HAL_TCL_DATA_CMD_INFO2_TID_OVERWRITE, 1) | field(HAL_TCL_DATA_CMD_INFO2_TID, tid) | field(HAL_TCL_DATA_CMD_INFO2_LMAC_ID, 0),
+            field(HAL_TCL_DATA_CMD_INFO3_SEARCH_INDEX, ast_idx) | field(HAL_TCL_DATA_CMD_INFO3_CACHE_SET_NUM, ast_hash),
+            0,
+        ];
+        let ring = &mut self.tcl_data;
+        hal.access_begin(ring);
+        let Some(at) = ring.src_get_next_entry() else {
+            self.tx_bufs.release(slot);
+            return Err(());
+        };
+        ring.write(at, &bytes_of(&words));
+        hal.access_end(bus, ring);
+        Ok(())
+    }
+
+    /// `ath11k_peer_rx_tid_setup` for every TID of a peer with a window of
+    /// one (`ath11k_dp_peer_setup`): the queue descriptors written; their
+    /// addresses, for WMI's reorder-queue commands.
+    pub(crate) fn tid_queues(&mut self, peer: [u8; 6]) -> Result<Vec<(u32, u64)>, &'static str> {
+        let mem = alloc_coherent32(QDESC_SIZE * TIDS as usize).ok_or("no memory for the reorder queues")?;
+        let mut out = Vec::new();
+        for tid in 0..TIDS {
+            let at = tid as usize * QDESC_SIZE;
+            let _ = mem.write_bytes(at, &bytes_of(&qdesc(tid, 1, false)));
+            out.push((tid, mem.daddr() as u64 + at as u64));
+        }
+        self.queues.insert(peer, mem);
+        Ok(out)
+    }
+
+    /// A peer's queues (every peer's, with `None`) freed; the firmware
+    /// forgot the peer first.
+    pub(crate) fn drop_queues(&mut self, peer: Option<[u8; 6]>) {
+        match peer {
+            Some(peer) => {
+                self.queues.remove(&peer);
+            }
+            None => self.queues.clear(),
+        }
+    }
+
+    /// `ath11k_peer_rx_tid_reo_update`: the window of a peer's TID queue,
+    /// and its first sequence number when one is given (REO puts the
+    /// frames back in order itself); the queue's address, for WMI's
+    /// reorder-queue command.
+    pub(crate) fn reo_window(&mut self, hal: &Hal, bus: &Bus, peer: [u8; 6], tid: u32, window: u32, ssn: Option<u16>) -> Option<u64> {
+        let mem = self.queues.get(&peer)?;
+        let paddr = mem.daddr() as u64 + (tid as usize * QDESC_SIZE) as u64;
+        let ring = &mut self.reo_cmd;
+        hal.access_begin(ring);
+        let Some(at) = ring.src_get_next_entry() else {
+            hal.access_end(bus, ring);
+            return None;
+        };
+        let header = word_at(&ring.read(at), 4) & HAL_REO_CMD_HDR_INFO0_CMD_NUMBER;
+        let mut info0 = field(HAL_REO_UPD_RX_QUEUE_INFO0_QUEUE_ADDR_HI, (paddr >> 32) as u32) | HAL_REO_UPD_RX_QUEUE_INFO0_UPD_BA_WINDOW_SIZE;
+        // The hardware takes no window of one.
+        let window = if window <= 1 { 2 } else { window };
+        let mut info2 = field(HAL_REO_UPD_RX_QUEUE_INFO2_BA_WINDOW_SIZE, window - 1);
+        if let Some(ssn) = ssn {
+            info0 |= HAL_REO_UPD_RX_QUEUE_INFO0_UPD_SSN;
+            info2 |= field(HAL_REO_UPD_RX_QUEUE_INFO2_SSN, ssn as u32 & 0xfff);
+        }
+        let words = [
+            field(HAL_TLV_HDR_TAG, HAL_REO_UPDATE_RX_REO_QUEUE) | field(HAL_TLV_HDR_LEN, 36),
+            header | HAL_REO_CMD_HDR_INFO0_STATUS_REQUIRED,
+            paddr as u32,
+            info0,
+            0,
+            info2,
+            0,
+            0,
+            0,
+            0,
+        ];
+        ring.write(at, &bytes_of(&words));
+        hal.access_end(bus, ring);
+        Some(paddr)
+    }
+
+    /// `ath11k_dp_peer_rx_pn_replay_config`: REO checks the packet numbers
+    /// of every TID's queue of a peer once its pairwise key is in place
+    /// (or not).
+    pub(crate) fn pn_check(&mut self, hal: &Hal, bus: &Bus, peer: [u8; 6], enable: bool) {
+        let Some(mem) = self.queues.get(&peer) else { return };
+        let base = mem.daddr() as u64;
+        let ring = &mut self.reo_cmd;
+        hal.access_begin(ring);
+        for tid in 0..TIDS {
+            let Some(at) = ring.src_get_next_entry() else { break };
+            let paddr = base + (tid as usize * QDESC_SIZE) as u64;
+            // The command's number stays (`memset_startat`).
+            let header = word_at(&ring.read(at), 4) & HAL_REO_CMD_HDR_INFO0_CMD_NUMBER;
+            let info0 = field(HAL_REO_UPD_RX_QUEUE_INFO0_QUEUE_ADDR_HI, (paddr >> 32) as u32)
+                | HAL_REO_UPD_RX_QUEUE_INFO0_UPD_PN_CHECK
+                | HAL_REO_UPD_RX_QUEUE_INFO0_UPD_PN_SIZE
+                | HAL_REO_UPD_RX_QUEUE_INFO0_UPD_SVLD
+                | HAL_REO_UPD_RX_QUEUE_INFO0_UPD_PN_VALID
+                | HAL_REO_UPD_RX_QUEUE_INFO0_UPD_PN;
+            let info1 = if enable { HAL_REO_UPD_RX_QUEUE_INFO1_PN_CHECK } else { 0 };
+            let pn_size = if enable { HAL_RX_REO_QUEUE_PN_SIZE_48 } else { 0 };
+            let info2 = field(HAL_REO_UPD_RX_QUEUE_INFO2_BA_WINDOW_SIZE, 1) | field(HAL_REO_UPD_RX_QUEUE_INFO2_PN_SIZE, pn_size);
+            let words = [
+                field(HAL_TLV_HDR_TAG, HAL_REO_UPDATE_RX_REO_QUEUE) | field(HAL_TLV_HDR_LEN, 36),
+                header | HAL_REO_CMD_HDR_INFO0_STATUS_REQUIRED,
+                paddr as u32,
+                info0,
+                info1,
+                info2,
+                0,
+                0,
+                0,
+                0,
+            ];
+            ring.write(at, &bytes_of(&words));
+        }
+        hal.access_end(bus, ring);
+    }
+}
+
+/// A receive buffer the hardware gave back without a frame for the host.
+fn drop_cookie(slots: &mut Slots, cookie: u32) {
+    let id = get(DP_RXDMA_BUF_COOKIE_BUF_ID, cookie);
+    if id != 0 {
+        slots.release(id - 1);
+    }
+}
+
+/// A ring of entries naming link descriptors: their MSDUs' buffers
+/// freed, each descriptor returned to WBM's idle list
+/// (`ath11k_dp_rx_link_desc_return`).
+fn link_ring(hal: &Hal, bus: &Bus, ring: &mut Srng, slots: &mut Slots, banks: &[DmaCoherent], release: &mut Srng) -> bool {
+    hal.access_begin(ring);
+    let mut reaped = false;
+    let mut freed = false;
+    while let Some(at) = ring.dst_get_next_entry() {
+        reaped = true;
+        let entry = words_of(&ring.read(at));
+        let paddr = ((get(BUFFER_ADDR_INFO1_ADDR, entry[1]) as u64) << 32) | get(BUFFER_ADDR_INFO0_ADDR, entry[0]) as u64;
+        let bank = get(BUFFER_ADDR_INFO1_SW_COOKIE, entry[1]) as usize;
+        if let Some(mem) = banks.get(bank) {
+            let offset = paddr.wrapping_sub(mem.daddr() as u64) as usize;
+            if offset + HAL_LINK_DESC_SIZE as usize <= LINK_PER_BANK as usize * HAL_LINK_DESC_SIZE as usize {
+                let mut link = vec![0u8; HAL_LINK_DESC_SIZE as usize];
+                let _ = mem.read_bytes(offset, &mut link);
+                let link = words_of(&link);
+                for index in 0..HAL_NUM_RX_MSDUS_PER_LINK_DESC as usize {
+                    let base = MSDU_LINK_FIRST + index * MSDU_LINK_STRIDE;
+                    if get(BUFFER_ADDR_INFO0_ADDR, link[base]) == 0 {
+                        break;
+                    }
+                    drop_cookie(slots, get(BUFFER_ADDR_INFO1_SW_COOKIE, link[base + 1]));
+                    freed = true;
+                }
+            }
+        }
+        hal.access_begin(release);
+        if let Some(at) = release.src_get_next_entry() {
+            let mut words = [0u32; 8];
+            words[0] = entry[0];
+            words[1] = entry[1];
+            words[2] = field(HAL_WBM_RELEASE_INFO0_REL_SRC_MODULE, HAL_WBM_REL_SRC_MODULE_SW)
+                | field(HAL_WBM_RELEASE_INFO0_BM_ACTION, HAL_WBM_REL_BM_ACT_PUT_IN_IDLE)
+                | field(HAL_WBM_RELEASE_INFO0_DESC_TYPE, HAL_WBM_REL_DESC_TYPE_MSDU_LINK);
+            release.write(at, &bytes_of(&words));
+            hal.access_end(bus, release);
+        }
+    }
+    if reaped {
+        hal.access_end(bus, ring);
+    }
+    freed
+}
+
+/// `ath11k_hal_reo_qdesc_setup`: a TID's queue descriptor, its three
+/// extensions for a QoS TID.
+fn qdesc(tid: u32, ba_window: u32, pn_check: bool) -> Vec<u32> {
+    let header = |kind: u32, magic: u32| field(HAL_DESC_HDR_INFO0_OWNER, HAL_DESC_REO_OWNED) | field(HAL_DESC_HDR_INFO0_BUF_TYPE, kind) | field(HAL_DESC_HDR_INFO0_DBG_RESERVED, magic);
+    let mut words = vec![0u32; QDESC_SIZE / 4];
+    words[0] = header(HAL_DESC_REO_QUEUE_DESC, REO_QUEUE_DESC_MAGIC_DEBUG_PATTERN_0);
+    words[1] = field(HAL_RX_REO_QUEUE_RX_QUEUE_NUMBER, tid);
+    let mut window = ba_window.max(1);
+    if window == 1 && tid != HAL_DESC_REO_NON_QOS_TID {
+        window += 1;
+    }
+    let mut info0 = field(HAL_RX_REO_QUEUE_INFO0_VLD, 1) | field(HAL_RX_REO_QUEUE_INFO0_ASSOC_LNK_DESC_COUNTER, 1) | field(HAL_RX_REO_QUEUE_INFO0_AC, tid_to_ac(tid));
+    if window == 1 {
+        info0 |= field(HAL_RX_REO_QUEUE_INFO0_RETRY, 1);
+    }
+    info0 |= field(HAL_RX_REO_QUEUE_INFO0_BA_WINDOW_SIZE, window - 1);
+    if pn_check {
+        info0 |= field(HAL_RX_REO_QUEUE_INFO0_PN_CHECK, 1) | field(HAL_RX_REO_QUEUE_INFO0_PN_SIZE, HAL_RX_REO_QUEUE_PN_SIZE_48);
+    }
+    info0 |= field(HAL_RX_REO_QUEUE_INFO0_IGNORE_AMPDU_FLG, 1);
+    words[2] = info0;
+    words[3] = field(HAL_RX_REO_QUEUE_INFO1_SSN, 0);
+    if tid == HAL_DESC_REO_NON_QOS_TID {
+        words.truncate(32);
+        return words;
+    }
+    for (index, magic) in [REO_QUEUE_DESC_MAGIC_DEBUG_PATTERN_1, REO_QUEUE_DESC_MAGIC_DEBUG_PATTERN_2, REO_QUEUE_DESC_MAGIC_DEBUG_PATTERN_3].into_iter().enumerate() {
+        words[32 * (index + 1)] = header(HAL_DESC_REO_QUEUE_EXT_DESC, magic);
+    }
+    words
+}
diff --git a/kernel/comps/ath11k/src/hal.rs b/kernel/comps/ath11k/src/hal.rs
new file mode 100644
index 0000000..c4e5b17
--- /dev/null
+++ b/kernel/comps/ath11k/src/hal.rs
@@ -0,0 +1,572 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The HAL's rings as Linux's ath11k `hal.c` runs them ("SRNG": a ring of
+//! descriptors in host memory, the producer's head and the consumer's tail
+//! in registers or in memory): the ring types and their register blocks,
+//! the rings' hardware set-up, the shadow registers the QCA6390 family's
+//! host writes instead of the real ones (they wake nothing), and the
+//! producer and consumer steps.
+
+use alloc::vec::Vec;
+
+use aster_linuxkpi::dma::alloc_coherent32;
+use ostd::mm::{HasDaddr, VmIo, dma::DmaCoherent};
+
+use crate::{hw::HwParams, pci::Bus, regs::*};
+
+/// `enum hal_ring_type`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub(crate) enum RingType {
+    ReoDst,
+    ReoException,
+    ReoReinject,
+    ReoCmd,
+    ReoStatus,
+    TclData,
+    TclCmd,
+    TclStatus,
+    CeSrc,
+    CeDst,
+    CeDstStatus,
+    WbmIdleLink,
+    Sw2WbmRelease,
+    Wbm2SwRelease,
+    RxdmaBuf,
+    RxdmaDst,
+    RxdmaMonitorBuf,
+    RxdmaMonitorStatus,
+    RxdmaMonitorDst,
+    RxdmaMonitorDesc,
+}
+
+const RING_TYPES: [RingType; 20] = [
+    RingType::ReoDst,
+    RingType::ReoException,
+    RingType::ReoReinject,
+    RingType::ReoCmd,
+    RingType::ReoStatus,
+    RingType::TclData,
+    RingType::TclCmd,
+    RingType::TclStatus,
+    RingType::CeSrc,
+    RingType::CeDst,
+    RingType::CeDstStatus,
+    RingType::WbmIdleLink,
+    RingType::Sw2WbmRelease,
+    RingType::Wbm2SwRelease,
+    RingType::RxdmaBuf,
+    RingType::RxdmaDst,
+    RingType::RxdmaMonitorBuf,
+    RingType::RxdmaMonitorStatus,
+    RingType::RxdmaMonitorDst,
+    RingType::RxdmaMonitorDesc,
+];
+
+/// `struct hal_srng_config`.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Config {
+    pub(crate) start_ring_id: u32,
+    pub(crate) max_rings: u32,
+    /// In 32-bit words.
+    pub(crate) entry_size: u32,
+    pub(crate) lmac: bool,
+    pub(crate) dst: bool,
+    pub(crate) max_size: u32,
+    pub(crate) reg_start: [u32; 2],
+    pub(crate) reg_size: [u32; 2],
+}
+
+/// `hw_srng_config_template` and `ath11k_hal_srng_create_config`: the
+/// entry sizes are the descriptors' (`hal_desc.h`) in words.
+pub(crate) fn config(hw: &HwParams, ty: RingType) -> Config {
+    let r = hw.regs;
+    let reo = HAL_SEQ_WCSS_UMAC_REO_REG;
+    let tcl = HAL_SEQ_WCSS_UMAC_TCL_REG;
+    let wbm = HAL_SEQ_WCSS_UMAC_WBM_REG;
+    let ce_src = [r.hal_seq_wcss_umac_ce0_src_reg + HAL_CE_DST_RING_BASE_LSB, r.hal_seq_wcss_umac_ce0_src_reg + HAL_CE_DST_RING_HP];
+    let ce_dst = [r.hal_seq_wcss_umac_ce0_dst_reg + HAL_CE_DST_RING_BASE_LSB, r.hal_seq_wcss_umac_ce0_dst_reg + HAL_CE_DST_RING_HP];
+    let ce_src_step = r.hal_seq_wcss_umac_ce1_src_reg - r.hal_seq_wcss_umac_ce0_src_reg;
+    let ce_dst_step = r.hal_seq_wcss_umac_ce1_dst_reg - r.hal_seq_wcss_umac_ce0_dst_reg;
+    let c = |start, max, words, lmac, dst, max_size, reg_start, reg_size| Config {
+        start_ring_id: start,
+        max_rings: max,
+        entry_size: words,
+        lmac,
+        dst,
+        max_size,
+        reg_start,
+        reg_size,
+    };
+    match ty {
+        RingType::ReoDst => c(
+            HAL_SRNG_RING_ID_REO2SW1,
+            4,
+            16,
+            false,
+            true,
+            HAL_REO_REO2SW1_RING_BASE_MSB_RING_SIZE,
