+// SPDX-License-Identifier: MPL-2.0
+
+//! Qualcomm's Wi-Fi 6 chips on PCIe, as Linux's ath11k runs them: the
+//! QCA6390, the WCN6855 (hw2.0 and 2.1) and the chips built like it (the
+//! QCA2066 and QCA6698AQ), and the QCN9074.
+//!
+//! The chip is reset through BAR 0 ([`pci`]) and its firmware loaded and
+//! started over MHI ([`mhi`]); the firmware's WLFW service, reached
+//! through QRTR and QMI ([`qrtr`], [`wlfw`]), takes the board data, the M3
+//! image and its memory, then starts the WLAN side. The host and the
+//! firmware then share rings ([`hal`]): the copy engines ([`ce`]) carry
+//! HTC ([`htc`]) with WMI's commands and events ([`wmi`]) and HTT's
+//! data-path messages; the data path ([`dp`]) has its own rings for
+//! frames. The interface ([`sta`]), a station or an access point, is what
+//! Linux's mac80211 asks of it.
+//!
+//! MHI, QRTR and QMI are this driver's own implementations of those
+//! interfaces; the rest follows Linux's ath11k (BSD-3-Clause-Clear, see
+//! NOTICE). linux-firmware's `ath11k/` has the firmware (`amss.bin`,
+//! `m3.bin`, `board-2.bin`, `regdb.bin`). Block-ack sessions, power save
+//! and the 6 GHz band run, and 802.11w (the BIP in the Wi-Fi component).
+//! `dmesg | grep ath11k` says
+//! how far a card gets; `ath11k.off`
+//! leaves the cards alone.
+
+#![no_std]
+#![deny(unsafe_code)]
+
+extern crate alloc;
+
+macro_rules! __log_prefix {
+    () => {
+        "ath11k: "
+    };
+}
+
+mod ce;
+mod dp;
+mod hal;
+mod htc;
+mod hw;
+mod hw_tables;
+mod mhi;
+mod pci;
+mod qrtr;
+mod regs;
+mod sta;
+mod wlfw;
+mod wmi;
+
+use alloc::{format, string::String, sync::Arc};
+use core::sync::atomic::{AtomicBool, Ordering};
+
+pub(crate) use aster_linuxkpi::delay::now_ms;
+use aster_linuxkpi::{
+    firmware::request_firmware,
+    io::Mmio,
+    pci::{self as kpi_pci, Devices},
+    wait::Waker,
+};
+use aster_pci::common_device::PciCommonDevice;
+use aster_wlan::{
+    ieee80211::Address,
+    radio::{self, ApConfig, Association, BeaconTemplate, BlockAck, Join, Key, LinkStats, Radio, Reorder, ScanRequest, StationEntry},
+};
+use component::{ComponentInitError, init_component};
+use ostd::sync::Mutex;
+
+use crate::{hal::Hal, hw::HwParams, mhi::Mhi, pci::Bus, regs::*, sta::Ath11k, wlfw::Wlfw};
+
+/// The cards' tasks sleep here: woken by their interrupt, and by the timer
+/// every 5 ms (the rings are polled then).
+pub(crate) static WAKER: Waker = Waker::new(5);
+static DEVICES: Devices = Devices::new();
+
+const VENDOR_QUALCOMM: u16 = 0x17cb;
+/// `QCA6390_DEVICE_ID`, `WCN6855_DEVICE_ID`, `QCN9074_DEVICE_ID`.
+const QCA6390: u16 = 0x1101;
+const WCN6855: u16 = 0x1103;
+const QCN9074: u16 = 0x1104;
+
+fn claims(vendor: u16, device: u16) -> bool {
+    vendor == VENDOR_QUALCOMM && matches!(device, QCA6390 | WCN6855 | QCN9074)
+}
+
+static DISABLED: AtomicBool = AtomicBool::new(false);
+aster_cmdline::define_flag_param!("ath11k.off", DISABLED);
+
+#[init_component]
+fn init() -> Result<(), ComponentInitError> {
+    if !DISABLED.load(Ordering::Relaxed) && DEVICES.register(claims) {
+        WAKER.start_timer();
+    }
+    Ok(())
+}
+
+#[init_component(kthread)]
+fn start() -> Result<(), ComponentInitError> {
+    DEVICES.spawn(run);
+    Ok(())
+}
+
+/// `ath11k_pci_probe`'s choice of the chip's parameters: by the device
+/// and the SoC's version (and, on the WCN6855's 2.1, its sub-version).
+fn hw_of(bus: &Bus, device: u16) -> Result<&'static HwParams, String> {
+    if device == QCN9074 {
+        return Ok(&hw::QCN9074_HW10);
+    }
+    let (major, minor) = bus.hw_version();
+    match (device, major, minor) {
+        (QCA6390, 2, _) => Ok(&hw::QCA6390_HW20),
+        (WCN6855, 2, 0x00 | 0x01) => Ok(&hw::WCN6855_HW20),
+        (WCN6855, 2, 0x10 | 0x11) => Ok(match bus.read32(TCSR_SOC_HW_SUB_VER) {
+            0x1019_a0e1 | 0x1019_b0e1 | 0x1019_c0e1 | 0x1019_d0e1 => &hw::QCA2066_HW21,
+            0x001e_60e1 => &hw::QCA6698AQ_HW21,
+            _ => &hw::WCN6855_HW21,
+        }),
+        _ => Err(format!("SoC version {}.{} is not supported", major, minor)),
+    }
+}
+
+struct Card {
+    state: Mutex<Ath11k>,
+}
+
+struct QualcommRadio {
+    card: Arc<Card>,
+}
+
+impl Radio for QualcommRadio {
+    fn start(&self) -> radio::Result<()> {
+        if self.card.state.lock().dead { Err(radio::Error::Down) } else { Ok(()) }
+    }
+
+    fn stop(&self) {
+        let mut state = self.card.state.lock();
+        state.abort_scan();
+        state.stop_ap();
+        state.leave();
+    }
+
+    fn scan(&self, request: &ScanRequest) -> radio::Result<()> {
+        self.card.state.lock().scan(request)
+    }
+
+    fn abort_scan(&self) {
+        self.card.state.lock().abort_scan();
+    }
+
+    fn join(&self, network: &Join) -> radio::Result<()> {
+        self.card.state.lock().join(network)
+    }
+
+    fn associated(&self, association: &Association) -> radio::Result<()> {
+        self.card.state.lock().associated(association)
+    }
+
+    fn leave(&self) {
+        self.card.state.lock().leave();
+    }
+
+    fn set_key(&self, key: &Key) -> radio::Result<()> {
+        self.card.state.lock().set_key(key)
+    }
+
+    fn remove_key(&self, index: u8, pairwise: bool) {
+        self.card.state.lock().remove_key(index, pairwise);
+    }
+
+    fn authorize(&self, authorized: bool) {
+        self.card.state.lock().authorize(authorized);
+    }
+
+    fn send_management(&self, frame: &[u8]) -> radio::Result<()> {
+        self.card.state.lock().send_management(frame)
+    }
+
+    fn send(&self, ethernet: &[u8], plain: bool) -> radio::Result<()> {
+        self.card.state.lock().send(ethernet, plain)
+    }
+
+    fn link_stats(&self) -> LinkStats {
+        self.card.state.lock().link_stats()
+    }
+
+    fn start_ap(&self, config: &ApConfig) -> radio::Result<()> {
+        self.card.state.lock().start_ap(config)
+    }
+
+    fn set_beacon(&self, beacon: &BeaconTemplate) -> radio::Result<()> {
+        self.card.state.lock().set_beacon(beacon)
+    }
+
+    fn stop_ap(&self) {
+        self.card.state.lock().stop_ap();
+    }
+
+    fn add_station(&self, station: &StationEntry) -> radio::Result<()> {
+        self.card.state.lock().add_station(station)
+    }
+
+    fn remove_station(&self, address: &Address) {
+        self.card.state.lock().remove_station(address);
+    }
+
+    fn authorize_station(&self, address: &Address, authorized: bool) {
+        self.card.state.lock().authorize_station(address, authorized);
+    }
+
+    fn rx_ba_start(&self, ba: &mut BlockAck) -> radio::Result<Reorder> {
+        self.card.state.lock().rx_ba_start(ba)
+    }
+
+    fn rx_ba_stop(&self, peer: &Address, tid: u8) {
+        self.card.state.lock().rx_ba_stop(peer, tid);
+    }
+
+    fn set_power_save(&self, enabled: bool) -> radio::Result<()> {
+        self.card.state.lock().set_power_save(enabled)
+    }
+}
+
+/// A card's task: the chip reset and its firmware booted over MHI, WLFW's
+/// set-up through QMI, the WLAN side up, the station registered; then the
+/// rings polled.
+fn run(index: usize, mut device: PciCommonDevice) {
+    let id = *device.device_id();
+    if !claims(id.vendor_id, id.device_id) {
+        return;
+    }
+    let location = *device.location();
+    let name = kpi_pci::device_name("ath11k", index, &location);
+    kpi_pci::enable_device(&location);
+    let vectors = kpi_pci::alloc_irq_vector(&mut device, false, &name, || WAKER.wake());
+    let Some(bar0) = kpi_pci::iomap(&mut device, 0) else {
+        ostd::warn!("{}: BAR 0 is not mapped", name);
+        return;
+    };
+    // The QCA6390's parameters until the SoC's version is read (the
+    // QCN9074's need no version).
+    let provisional = if id.device_id == QCN9074 { &hw::QCN9074_HW10 } else { &hw::QCA6390_HW20 };
+    let mut bus = Bus::new(location, Mmio::new(bar0), provisional);
+    let hw = match hw_of(&bus, id.device_id) {
+        Ok(hw) => hw,
+        Err(error) => {
+            ostd::warn!("{}: {}", name, error);
+            return;
+        }
+    };
+    bus.hw = hw;
+    bus.read_msi();
+    ostd::notice!("{}: Qualcomm {} ({:04x})", name, hw.name, id.device_id);
+    let firmware = format!("ath11k/{}/amss.bin", hw.fw_dir);
+    let Some(amss) = request_firmware(&firmware) else {
+        ostd::warn!("{}: {} is missing", name, firmware);
+        return;
+    };
+    // `ath11k_pci_power_up`.
+    bus.sw_reset();
+    bus.aspm_disable();
+    let mut mhi = match Mhi::new(&bus) {
+        Ok(mhi) => mhi,
+        Err(error) => {
+            ostd::warn!("{}: {}", name, error);
+            return;
+        }
+    };
+    if let Err(error) = mhi.power_up(&bus, &amss) {
+        ostd::warn!("{}: the firmware did not start: {}", name, error);
+        return;
+    }
+    drop(amss);
+    if hw.static_window_map {
+        bus.select_static_window();
+    }
+    let hal = match Hal::new(hw) {
+        Ok(hal) => hal,
+        Err(error) => {
+            ostd::warn!("{}: {}", name, error);
+            return;
+        }
+    };
+    let (subsystem_vendor, subsystem_device) = kpi_pci::subsystem_ids(&location);
+    let ids = wlfw::Ids { vendor: id.vendor_id, device: id.device_id, subsystem_vendor, subsystem_device };
+    let mut wlfw = Wlfw::new(hw.ins_id);
+    let booted = wlfw.find_server(&bus, &mut mhi).and_then(|()| wlfw.boot(&bus, &mut mhi, ids)).and_then(|()| wlfw.start(&bus, &mut mhi, &hal.shadow));
+    if let Err(error) = booted {
+        ostd::warn!("{}: {}", name, error);
+        return;
+    }
+    let target = &wlfw.target;
+    ostd::info!("{}: firmware {} (chip {:#x}, board {:#x})", name, target.build, target.chip_id, target.board_id);
+    let state = match Ath11k::start(bus, mhi, wlfw, hal, name.clone()) {
+        Ok(state) => state,
+        Err(error) => {
+            ostd::warn!("{}: the firmware's set-up failed: {}", name, error);
+            return;
+        }
+    };
+    let Some(info) = state.info() else {
+        ostd::warn!("{}: the firmware gave no capabilities", name);
+        return;
+    };
+    ostd::notice!("{}: ready, MAC {:02x?}", name, state.address);
+    let card = Arc::new(Card { state: Mutex::new(state) });
+    let wlan = aster_wlan::register(info, Arc::new(QualcommRadio { card: card.clone() }));
+    card.state.lock().device = Some(wlan);
+    loop {
+        WAKER.sleep();
+        let mut state = card.state.lock();
+        state.poll();
+        if state.dead {
+            break;
+        }
+    }
+    drop((vectors, device));
+}
