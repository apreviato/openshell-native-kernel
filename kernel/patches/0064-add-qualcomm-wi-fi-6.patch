+
+/// Which receive descriptor the chip writes (`hal_rx_desc_*`).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum RxDesc {
+    Ipq8074,
+    Qcn9074,
+    Wcn6855,
+}
+
+#[derive(Debug)]
+pub(crate) struct HwParams {
+    pub(crate) name: &'static str,
+    /// Under linux-firmware's `ath11k/`.
+    pub(crate) fw_dir: &'static str,
+    pub(crate) board_size: usize,
+    pub(crate) regs: &'static HwRegs,
+    /// The WLFW service's instance.
+    pub(crate) ins_id: u32,
+    pub(crate) host_ce: &'static [CeAttr],
+    pub(crate) target_ce: &'static [PipeConfig],
+    pub(crate) svc_map: &'static [ServicePipe],
