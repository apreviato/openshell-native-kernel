+/// A value put under a mask (`FIELD_PREP`).
+pub(crate) fn field(mask: u32, value: u32) -> u32 {
+    (value << mask.trailing_zeros()) & mask
+}
+
+/// A field read (`FIELD_GET`).
+pub(crate) fn get(mask: u32, value: u32) -> u32 {
+    (value & mask) >> mask.trailing_zeros()
+}
+
+/// Where the host writes its own pointer.
+#[derive(Clone, Copy, Debug)]
+enum HostPtr {
+    /// A register (or shadow register) of BAR 0.
+    Reg(u32),
+    /// Its word in the memory the firmware reads (LMAC rings).
+    Wrp(usize),
+}
+
+/// What a ring is set up with (`struct hal_srng_params`).
+#[derive(Clone, Copy, Debug, Default)]
+pub(crate) struct Params {
+    pub(crate) msi: Option<(u64, u32)>,
+    pub(crate) intr_timer_thres_us: u32,
+    pub(crate) intr_batch_cntr_thres_entries: u32,
+    pub(crate) low_threshold: u32,
+    pub(crate) max_buffer_len: u32,
+}
+
+/// A ring (`struct hal_srng`): positions in words, as the hardware counts.
+pub(crate) struct Srng {
+    pub(crate) ring_id: u32,
+    dst: bool,
+    pub(crate) mem: DmaCoherent,
+    pub(crate) entry_size: u32,
+    pub(crate) num_entries: u32,
+    ring_size: u32,
+    /// Source rings: the host's head, the cached tail, the reaped head.
+    hp: u32,
+    cached_tp: u32,
+    reap_hp: u32,
+    /// Destination rings: the host's tail and the cached head.
+    tp: u32,
+    cached_hp: u32,
+    host_ptr: HostPtr,
+}
+
+impl Srng {
+    pub(crate) fn paddr(&self) -> u64 {
+        self.mem.daddr() as u64
+    }
+
+    /// The bytes of the entry at a word offset.
+    pub(crate) fn read(&self, offset: u32) -> Vec<u8> {
+        let mut entry = alloc::vec![0u8; self.entry_size as usize * 4];
+        let _ = self.mem.read_bytes(offset as usize * 4, &mut entry);
+        entry
+    }
+
+    pub(crate) fn write(&self, offset: u32, entry: &[u8]) {
+        let _ = self.mem.write_bytes(offset as usize * 4, entry);
+    }
+
+    /// `ath11k_hal_srng_src_num_free` with the cached tail.
+    pub(crate) fn src_num_free(&self) -> u32 {
+        let (tp, hp) = (self.cached_tp, self.hp);
+        if tp > hp { (tp - hp) / self.entry_size - 1 } else { (self.ring_size - hp + tp) / self.entry_size - 1 }
+    }
+
+    /// `ath11k_hal_srng_src_get_next_entry`: the next entry to fill.
+    pub(crate) fn src_get_next_entry(&mut self) -> Option<u32> {
+        let next = (self.hp + self.entry_size) % self.ring_size;
+        if next == self.cached_tp {
+            return None;
+        }
+        let at = self.hp;
+        self.hp = next;
+        self.reap_hp = next;
+        Some(at)
+    }
+
+    /// `ath11k_hal_srng_src_reap_next`: an entry the hardware is done with.
+    pub(crate) fn src_reap_next(&mut self) -> Option<u32> {
+        let next = (self.reap_hp + self.entry_size) % self.ring_size;
+        if next == self.cached_tp {
+            return None;
+        }
+        self.reap_hp = next;
+        Some(next)
+    }
+
+    /// `ath11k_hal_srng_src_get_next_reaped`: a reaped entry to fill.
+    pub(crate) fn src_get_next_reaped(&mut self) -> Option<u32> {
+        if self.hp == self.reap_hp {
+            return None;
+        }
+        let at = self.hp;
+        self.hp = (self.hp + self.entry_size) % self.ring_size;
+        Some(at)
+    }
+
+    /// `ath11k_hal_srng_dst_get_next_entry`.
+    pub(crate) fn dst_get_next_entry(&mut self) -> Option<u32> {
+        if self.tp == self.cached_hp {
+            return None;
+        }
+        let at = self.tp;
+        self.tp += self.entry_size;
+        if self.tp == self.ring_size {
+            self.tp = 0;
+        }
+        Some(at)
+    }
+}
+
+/// `struct ath11k_hal`: the memory the hardware writes its pointers to
+/// (`rdp`) and the one the firmware reads the host's from (`wrp`, LMAC
+/// rings), and the shadow registers' targets.
+pub(crate) struct Hal {
+    hw: &'static HwParams,
+    rdp: DmaCoherent,
+    wrp: DmaCoherent,
+    /// The real registers the shadow ones stand for, by shadow index.
+    pub(crate) shadow: Vec<u32>,
+    /// Ring id → shadow index.
+    shadow_of: Vec<(u32, usize)>,
+}
+
+impl Hal {
+    pub(crate) fn new(hw: &'static HwParams) -> Result<Self, &'static str> {
+        let rdp = alloc_coherent32(HAL_SRNG_RING_ID_MAX as usize * 4).ok_or("no memory for the ring pointers")?;
+        let wrp = alloc_coherent32(HAL_SRNG_NUM_LMAC_RINGS as usize * 4).ok_or("no memory for the ring pointers")?;
+        let mut hal = Self { hw, rdp, wrp, shadow: Vec::new(), shadow_of: Vec::new() };
+        if hw.shadow_regs {
+            hal.shadow_config();
+        }
+        Ok(hal)
+    }
+
+    fn add_shadow(&mut self, ty: RingType, ring_num: u32) {
+        if self.shadow.len() >= HAL_SHADOW_NUM_REGS as usize {
+            return;
+        }
+        let config = config(self.hw, ty);
+        let mut target = config.reg_start[1] + config.reg_size[1] * ring_num;
+        if config.dst {
+            target += HAL_OFFSET_FROM_HP_TO_TP;
+        }
+        self.shadow_of.push((config.start_ring_id + ring_num, self.shadow.len()));
+        self.shadow.push(target);
+    }
+
+    /// `ath11k_hal_srng_shadow_config` then `ath11k_ce_shadow_config`: the
+    /// data path's rings, then the copy engines'.
+    fn shadow_config(&mut self) {
+        for ty in RING_TYPES {
+            let config = config(self.hw, ty);
+            if matches!(ty, RingType::CeSrc | RingType::CeDst | RingType::CeDstStatus) || config.lmac {
+                continue;
+            }
+            for ring_num in 0..config.max_rings {
+                self.add_shadow(ty, ring_num);
+            }
+        }
+        for (index, ce) in self.hw.host_ce.iter().enumerate() {
+            if ce.src_nentries != 0 {
+                self.add_shadow(RingType::CeSrc, index as u32);
+            }
+            if ce.dest_nentries != 0 {
+                self.add_shadow(RingType::CeDst, index as u32);
+                self.add_shadow(RingType::CeDstStatus, index as u32);
+            }
+        }
+    }
+
+    fn rdp_read(&self, ring_id: u32) -> u32 {
+        let mut word = [0u8; 4];
+        let _ = self.rdp.read_bytes(ring_id as usize * 4, &mut word);
+        u32::from_le_bytes(word)
+    }
+
+    fn rdp_write(&self, ring_id: u32, value: u32) {
+        let _ = self.rdp.write_bytes(ring_id as usize * 4, &value.to_le_bytes());
+    }
+
+    /// The device address of a ring's word in `rdp`.
+    pub(crate) fn rdp_addr(&self, ring_id: u32) -> u64 {
+        self.rdp.daddr() as u64 + ring_id as u64 * 4
+    }
+
+    pub(crate) fn wrp_addr(&self, index: usize) -> u64 {
+        self.wrp.daddr() as u64 + index as u64 * 4
+    }
+
+    /// An LMAC ring's head and tail pointers' addresses as HTT gives them
+    /// to the firmware (`ath11k_hal_srng_get_hp_addr`, `_get_tp_addr`):
+    /// the host's in `wrp`, the hardware's in `rdp`.
+    pub(crate) fn lmac_pointers(&self, srng: &Srng) -> (u64, u64) {
+        let wrp = self.wrp_addr((srng.ring_id - HAL_SRNG_RING_ID_LMAC1_ID_START) as usize);
+        let rdp = self.rdp_addr(srng.ring_id);
+        if srng.dst { (rdp, wrp) } else { (wrp, rdp) }
+    }
+
+    /// `ath11k_hal_srng_setup`: a ring of `entries` set up (LMAC rings: in
+    /// memory only; the firmware is told of them through HTT).
+    pub(crate) fn setup(&self, bus: &Bus, ty: RingType, ring_num: u32, mac_id: u32, entries: u32, params: Params) -> Result<Srng, &'static str> {
+        let config = config(self.hw, ty);
+        if ring_num >= config.max_rings {
+            return Err("no such ring");
+        }
+        let mut ring_id = config.start_ring_id + ring_num;
+        if config.lmac {
+            ring_id += mac_id * HAL_SRNG_RINGS_PER_LMAC;
+        }
+        let entries = entries.min(config.max_size / config.entry_size).max(2);
+        let mem = alloc_coherent32((config.entry_size * entries * 4) as usize).ok_or("no memory for a ring")?;
+        let hwreg = [config.reg_start[0] + ring_num * config.reg_size[0], config.reg_start[1] + ring_num * config.reg_size[1]];
+        let shadow = self.shadow_of.iter().find(|(id, _)| *id == ring_id).map(|(_, index)| self.hw.regs.hal_shadow_base_addr + 4 * *index as u32);
+        let host_ptr = if config.lmac {
+            HostPtr::Wrp((ring_id - HAL_SRNG_RING_ID_LMAC1_ID_START) as usize)
+        } else if let Some(shadow) = shadow {
+            HostPtr::Reg(shadow)
+        } else if config.dst {
+            HostPtr::Reg(hwreg[1] + (self.hw.regs.hal_reo1_ring_tp - self.hw.regs.hal_reo1_ring_hp))
+        } else {
+            HostPtr::Reg(hwreg[1])
+        };
+        let ring_size = config.entry_size * entries;
+        let srng = Srng {
+            ring_id,
+            dst: config.dst,
+            mem,
+            entry_size: config.entry_size,
+            num_entries: entries,
+            ring_size,
+            hp: 0,
+            cached_tp: 0,
+            reap_hp: ring_size - config.entry_size,
+            tp: 0,
+            cached_hp: 0,
+            host_ptr,
+        };
+        self.rdp_write(ring_id, 0);
+        if let HostPtr::Wrp(index) = host_ptr {
+            let _ = self.wrp.write_bytes(index * 4, &0u32.to_le_bytes());
+        }
+        if !config.lmac {
+            if config.dst {
+                self.dst_hw_init(bus, &srng, hwreg, params);
+            } else {
+                self.src_hw_init(bus, &srng, hwreg, params);
+            }
+            if ty == RingType::CeDst {
+                let at = HAL_CE_DST_RING_CTRL + config.reg_start[0] + ring_num * config.reg_size[0];
+                let value = (bus.read32(at) & !HAL_CE_DST_R0_DEST_CTRL_MAX_LEN) | field(HAL_CE_DST_R0_DEST_CTRL_MAX_LEN, params.max_buffer_len);
+                bus.write32(at, value);
+            }
+        }
+        Ok(srng)
+    }
+
+    /// `ath11k_hal_srng_dst_hw_init`.
+    fn dst_hw_init(&self, bus: &Bus, srng: &Srng, hwreg: [u32; 2], params: Params) {
+        let r = self.hw.regs;
+        let lsb = r.hal_reo1_ring_base_lsb;
+        let base = hwreg[0];
+        if let Some((addr, data)) = params.msi {
+            bus.write32(base + (r.hal_reo1_ring_msi1_base_lsb - lsb), addr as u32);
+            bus.write32(base + (r.hal_reo1_ring_msi1_base_msb - lsb), field(HAL_REO1_RING_MSI1_BASE_MSB_ADDR, (addr >> 32) as u32) | HAL_REO1_RING_MSI1_BASE_MSB_MSI1_ENABLE);
+            bus.write32(base + (r.hal_reo1_ring_msi1_data - lsb), data);
+        }
+        bus.write32(base, srng.paddr() as u32);
+        bus.write32(
+            base + (r.hal_reo1_ring_base_msb - lsb),
+            field(HAL_REO1_RING_BASE_MSB_RING_BASE_ADDR_MSB, (srng.paddr() >> 32) as u32)
+                | field(HAL_REO1_RING_BASE_MSB_RING_SIZE, srng.entry_size * srng.num_entries),
+        );
+        bus.write32(base + (r.hal_reo1_ring_id - lsb), field(HAL_REO1_RING_ID_RING_ID, srng.ring_id) | field(HAL_REO1_RING_ID_ENTRY_SIZE, srng.entry_size));
+        let setup = field(HAL_REO1_RING_PRDR_INT_SETUP_INTR_TMR_THOLD, params.intr_timer_thres_us >> 3)
+            | field(HAL_REO1_RING_PRDR_INT_SETUP_BATCH_COUNTER_THOLD, params.intr_batch_cntr_thres_entries * srng.entry_size);
+        bus.write32(base + (r.hal_reo1_ring_producer_int_setup - lsb), setup);
+        let hp = self.rdp_addr(srng.ring_id);
+        bus.write32(base + (r.hal_reo1_ring_hp_addr_lsb - lsb), hp as u32);
+        bus.write32(base + (r.hal_reo1_ring_hp_addr_msb - lsb), (hp >> 32) as u32);
+        bus.write32(hwreg[1], 0);
+        bus.write32(hwreg[1] + (r.hal_reo1_ring_tp - r.hal_reo1_ring_hp), 0);
+        bus.write32(base + (r.hal_reo1_ring_misc - lsb), HAL_REO1_RING_MISC_SRNG_ENABLE);
+    }
+
+    /// `ath11k_hal_srng_src_hw_init`.
+    fn src_hw_init(&self, bus: &Bus, srng: &Srng, hwreg: [u32; 2], params: Params) {
+        let r = self.hw.regs;
+        let lsb = r.hal_tcl1_ring_base_lsb;
+        let base = hwreg[0];
+        if let Some((addr, data)) = params.msi {
+            bus.write32(base + (r.hal_tcl1_ring_msi1_base_lsb - lsb), addr as u32);
+            bus.write32(base + (r.hal_tcl1_ring_msi1_base_msb - lsb), field(HAL_TCL1_RING_MSI1_BASE_MSB_ADDR, (addr >> 32) as u32) | HAL_TCL1_RING_MSI1_BASE_MSB_MSI1_ENABLE);
+            bus.write32(base + (r.hal_tcl1_ring_msi1_data - lsb), data);
+        }
+        bus.write32(base, srng.paddr() as u32);
+        bus.write32(
+            base + (r.hal_tcl1_ring_base_msb - lsb),
+            field(HAL_TCL1_RING_BASE_MSB_RING_BASE_ADDR_MSB, (srng.paddr() >> 32) as u32)
+                | field(HAL_TCL1_RING_BASE_MSB_RING_SIZE, srng.entry_size * srng.num_entries),
+        );
+        bus.write32(base + (r.hal_tcl1_ring_id - lsb), field(HAL_REO1_RING_ID_ENTRY_SIZE, srng.entry_size));
+        let ix0 = field(HAL_TCL1_RING_CONSR_INT_SETUP_IX0_INTR_TMR_THOLD, params.intr_timer_thres_us)
+            | field(HAL_TCL1_RING_CONSR_INT_SETUP_IX0_BATCH_COUNTER_THOLD, params.intr_batch_cntr_thres_entries * srng.entry_size);
+        bus.write32(base + (r.hal_tcl1_ring_consumer_int_setup_ix0 - lsb), ix0);
+        let ix1 = if params.low_threshold != 0 { field(HAL_TCL1_RING_CONSR_INT_SETUP_IX1_LOW_THOLD, params.low_threshold * srng.entry_size) } else { 0 };
+        bus.write32(base + (r.hal_tcl1_ring_consumer_int_setup_ix1 - lsb), ix1);
+        if srng.ring_id != HAL_SRNG_RING_ID_WBM_IDLE_LINK {
+            let tp = self.rdp_addr(srng.ring_id);
+            bus.write32(base + (r.hal_tcl1_ring_tp_addr_lsb - lsb), tp as u32);
+            bus.write32(base + (r.hal_tcl1_ring_tp_addr_msb - lsb), (tp >> 32) as u32);
+        }
+        bus.write32(hwreg[1], 0);
+        bus.write32(hwreg[1] + HAL_TCL1_RING_TP_OFFSET, 0);
+        bus.write32(base + (r.hal_tcl1_ring_misc - lsb), HAL_TCL1_RING_MISC_MSI_LOOPCNT_DISABLE | HAL_TCL1_RING_MISC_SRNG_ENABLE);
+    }
+
+    /// `ath11k_hal_srng_access_begin`: the hardware's pointer read.
+    pub(crate) fn access_begin(&self, srng: &mut Srng) {
+        if srng.dst {
+            srng.cached_hp = self.rdp_read(srng.ring_id);
+        } else {
+            srng.cached_tp = self.rdp_read(srng.ring_id);
+        }
+    }
+
+    /// `ath11k_hal_srng_access_end`: the host's pointer written.
+    pub(crate) fn access_end(&self, bus: &Bus, srng: &Srng) {
+        let value = if srng.dst { srng.tp } else { srng.hp };
+        match srng.host_ptr {
+            HostPtr::Reg(at) => bus.write32(at, value),
+            HostPtr::Wrp(index) => {
+                let _ = self.wrp.write_bytes(index * 4, &value.to_le_bytes());
+            }
+        }
+    }
+}
diff --git a/kernel/comps/ath11k/src/htc.rs b/kernel/comps/ath11k/src/htc.rs
new file mode 100644
index 0000000..c98e20d
--- /dev/null
+++ b/kernel/comps/ath11k/src/htc.rs
@@ -0,0 +1,222 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! HTC as Linux's ath11k `htc.c` runs it over the copy engines: an 8-byte
+//! header with the endpoint, the target's READY with its credits, the
+//! services (WMI's control, HTT's data) connected to endpoints, credit
+//! reports in the trailers.
+
+use alloc::{string::String, vec::Vec};
+
+use crate::{ce::Ce, hal::Hal, pci::Bus, regs::*};
+
+const HEADER: usize = 8;
+const ENDPOINTS: usize = 8;
+const WAIT_MS: u64 = 3000;
+const FLAG_NEED_CREDIT_UPDATE: u8 = 0x01;
+const FLAG_TRAILER_PRESENT: u8 = 0x02;
+const RECORD_CREDITS: u8 = 1;
+
+#[derive(Clone, Copy, Default)]
+struct Endpoint {
+    /// The pipe its messages go out on (they come in on any).
+    ul_pipe: usize,
+    credits: u32,
+    credit_flow: bool,
+    seq: u8,
+}
+
+pub(crate) struct Htc {
+    endpoints: [Endpoint; ENDPOINTS],
+    credit_size: u32,
+    total_credits: u32,
+}
+
+/// A message HTC delivered: its endpoint and payload.
+pub(crate) struct Message {
+    pub(crate) endpoint: usize,
+    pub(crate) payload: Vec<u8>,
+}
+
+/// The pipe carrying a service to the target
+/// (`ath11k_pcic_map_service_to_pipe`'s UL pipe).
+fn pipe_of(bus: &Bus, service: u32) -> usize {
+    bus.hw
+        .svc_map
+        .iter()
+        .find(|map| map.service_id == service && matches!(map.pipedir, PIPEDIR_OUT | PIPEDIR_INOUT))
+        .map_or(0, |map| map.pipenum as usize)
+}
+
+impl Htc {
+    /// `ath11k_htc_init`: endpoint 0 is the control service.
+    pub(crate) fn new(bus: &Bus) -> Self {
+        let mut endpoints = [Endpoint::default(); ENDPOINTS];
+        let ul = pipe_of(bus, ATH11K_HTC_SVC_ID_RSVD_CTRL);
+        endpoints[0] = Endpoint { ul_pipe: ul, credits: 0, credit_flow: false, seq: 0 };
+        Self { endpoints, credit_size: 0, total_credits: 0 }
+    }
+
+    /// `ath11k_htc_send`: the header, credits when the endpoint counts
+    /// them, the payload on the endpoint's pipe. `Err`: no credit or room.
+    pub(crate) fn send(&mut self, bus: &Bus, hal: &Hal, ce: &mut Ce, endpoint: usize, payload: &[u8]) -> Result<(), ()> {
+        let credit_size = self.credit_size.max(1);
+        let ep = &mut self.endpoints[endpoint];
+        let len = HEADER + payload.len();
+        let needed = (len as u32).div_ceil(credit_size);
+        if ep.credit_flow && ep.credits < needed {
+            return Err(());
+        }
+        let mut message = Vec::with_capacity(len);
+        message.push(endpoint as u8);
+        message.push(if ep.credit_flow { FLAG_NEED_CREDIT_UPDATE } else { 0 });
+        message.extend_from_slice(&(payload.len() as u16).to_le_bytes());
+        message.push(0);
+        message.push(ep.seq);
+        message.extend_from_slice(&[0, 0]);
+        message.extend_from_slice(payload);
+        ce.send(hal, bus, ep.ul_pipe, &message, endpoint as u16)?;
+        if ep.credit_flow {
+            ep.credits -= needed;
+        }
+        ep.seq = ep.seq.wrapping_add(1);
+        Ok(())
+    }
+
+    /// The header gone, the trailer's credit reports taken
+    /// (`ath11k_htc_rx_completion_handler`).
+    pub(crate) fn receive(&mut self, raw: &[u8]) -> Option<Message> {
+        if raw.len() < HEADER {
+            return None;
+        }
+        let endpoint = raw[0] as usize;
+        let flags = raw[1];
+        let len = u16::from_le_bytes([raw[2], raw[3]]) as usize;
+        if endpoint >= ENDPOINTS || HEADER + len > raw.len() {
+            return None;
+        }
+        let mut payload = &raw[HEADER..HEADER + len];
+        if flags & FLAG_TRAILER_PRESENT != 0 {
+            let trailer_len = raw[4] as usize;
+            if trailer_len < 2 || trailer_len > len {
+                return None;
+            }
+            let (body, trailer) = payload.split_at(len - trailer_len);
+            self.trailer(trailer);
+            payload = body;
+        }
+        if payload.is_empty() {
+            return None;
+        }
+        Some(Message { endpoint, payload: payload.to_vec() })
+    }
+
+    fn trailer(&mut self, mut trailer: &[u8]) {
+        while trailer.len() >= 2 {
+            let (id, len) = (trailer[0], trailer[1] as usize);
+            let Some(record) = trailer.get(2..2 + len) else { return };
+            if id == RECORD_CREDITS {
+                for report in record.chunks_exact(4) {
+                    if let Some(ep) = self.endpoints.get_mut(report[0] as usize) {
+                        ep.credits += report[1] as u32;
+                    }
+                }
+            }
+            trailer = &trailer[2 + len..];
+        }
+    }
+
+    /// The messages of every target-to-host pipe.
+    pub(crate) fn poll(&mut self, bus: &Bus, hal: &Hal, ce: &mut Ce) -> Vec<Message> {
+        let mut out = Vec::new();
+        for pipe in 0..ce.pipes() {
+            if !ce.is_rx(pipe) {
+                continue;
+            }
+            for raw in ce.receive(hal, bus, pipe) {
+                if let Some(message) = self.receive(&raw) {
+                    out.push(message);
+                }
+            }
+        }
+        out
+    }
+
+    /// A control message on endpoint 0, the others handed to `other`.
+    fn control(&mut self, bus: &Bus, hal: &Hal, ce: &mut Ce, other: &mut impl FnMut(Message)) -> Result<Vec<u8>, String> {
+        let deadline = crate::now_ms() + WAIT_MS;
+        loop {
+            let mut found = None;
+            for message in self.poll(bus, hal, ce) {
+                if message.endpoint == 0 && found.is_none() {
+                    found = Some(message.payload);
+                } else {
+                    other(message);
+                }
+            }
+            if let Some(payload) = found {
+                return Ok(payload);
+            }
+            if crate::now_ms() >= deadline {
+                return Err(String::from("the target did not answer HTC"));
+            }
+            crate::WAKER.msleep(1);
+        }
+    }
+
+    /// `ath11k_htc_wait_target`: the READY message and its credits.
+    pub(crate) fn wait_target(&mut self, bus: &Bus, hal: &Hal, ce: &mut Ce) -> Result<(), String> {
+        let message = self.control(bus, hal, ce, &mut |_| {})?;
+        if message.len() < 8 || u16::from_le_bytes([message[0], message[1]]) as u32 != ATH11K_HTC_MSG_READY_ID {
+            return Err(String::from("the target's first HTC message is not READY"));
+        }
+        self.total_credits = u16::from_le_bytes([message[2], message[3]]) as u32;
+        self.credit_size = u16::from_le_bytes([message[4], message[5]]) as u32;
+        if self.total_credits == 0 || self.credit_size == 0 {
+            return Err(String::from("the target gave no HTC credits"));
+        }
+        if !bus.hw.credit_flow {
+            self.total_credits = 1;
+        }
+        Ok(())
+    }
+
+    /// `ath11k_htc_connect_service`: WMI's control service gets every
+    /// credit and counts them (where the chip does); the others none.
+    pub(crate) fn connect(&mut self, bus: &Bus, hal: &Hal, ce: &mut Ce, service: u32, other: &mut impl FnMut(Message)) -> Result<usize, String> {
+        let wmi = service == ATH11K_HTC_SVC_ID_WMI_CONTROL;
+        let allocation = if wmi { self.total_credits.min(0xff) } else { 0 };
+        let mut flags = (allocation << 8) & ATH11K_HTC_CONN_FLAGS_RECV_ALLOC;
+        let credit_flow = wmi && bus.hw.credit_flow;
+        if !credit_flow {
+            flags |= ATH11K_HTC_CONN_FLAGS_DISABLE_CREDIT_FLOW_CTRL;
+        }
+        let mut request = Vec::with_capacity(8);
+        request.extend_from_slice(&(ATH11K_HTC_MSG_CONNECT_SERVICE_ID as u16).to_le_bytes());
+        request.extend_from_slice(&(service as u16).to_le_bytes());
+        request.extend_from_slice(&(flags as u16).to_le_bytes());
+        request.extend_from_slice(&[0, 0]);
+        self.send(bus, hal, ce, 0, &request).map_err(|()| String::from("HTC's control pipe is full"))?;
+        let answer = self.control(bus, hal, ce, other)?;
+        if answer.len() < 8 || u16::from_le_bytes([answer[0], answer[1]]) as u32 != ATH11K_HTC_MSG_CONNECT_SERVICE_RESP_ID {
+            return Err(String::from("no answer to an HTC service's connection"));
+        }
+        let (status, endpoint) = (answer[4], answer[5] as usize);
+        if status as u32 != ATH11K_HTC_CONN_SVC_STATUS_SUCCESS || endpoint >= ENDPOINTS {
+            return Err(alloc::format!("HTC refused service {service:#x} (status {status})"));
+        }
+        let ul = pipe_of(bus, service);
+        self.endpoints[endpoint] = Endpoint { ul_pipe: ul, credits: allocation, credit_flow, seq: 0 };
+        Ok(endpoint)
+    }
+
+    /// `ath11k_htc_start`: setup complete (credit flow off for the whole
+    /// target where the chip has none).
+    pub(crate) fn start(&mut self, bus: &Bus, hal: &Hal, ce: &mut Ce) -> Result<(), String> {
+        let mut message = Vec::with_capacity(12);
+        message.extend_from_slice(&ATH11K_HTC_MSG_SETUP_COMPLETE_EX_ID.to_le_bytes());
+        let flags: u32 = if bus.hw.credit_flow { 0 } else { ATH11K_GLOBAL_DISABLE_CREDIT_FLOW };
+        message.extend_from_slice(&flags.to_le_bytes());
+        message.extend_from_slice(&0u32.to_le_bytes());
+        self.send(bus, hal, ce, 0, &message).map_err(|()| String::from("HTC's control pipe is full"))
+    }
+}
