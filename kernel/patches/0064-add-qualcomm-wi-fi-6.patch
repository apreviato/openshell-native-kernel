+/// The resource configuration of `ath11k_init_wmi_config_qca6390` (and
+/// `_ipq8074`'s for the QCN9074), with this driver's choices.
+pub(crate) fn init_cmd(hw: &HwParams, num_rf_chains: u32) -> Cmd {
+    let mut cfg = vec![0u32; RESOURCE_FIELDS.len()];
+    let mut set = |name: &str, value: u32| {
+        if let Some(index) = RESOURCE_FIELDS.iter().position(|field| *field == name) {
+            cfg[index] = value;
+        }
+    };
+    let chains = (1u32 << num_rf_chains.clamp(1, 4)) - 1;
+    set("num_peer_keys", TARGET_NUM_PEER_KEYS);
+    set("ast_skid_limit", TARGET_AST_SKID_LIMIT);
+    set("tx_chain_mask", chains);
+    set("rx_chain_mask", chains);
+    set("rx_timeout_pri0", TARGET_RX_TIMEOUT_LO_PRI);
+    set("rx_timeout_pri1", TARGET_RX_TIMEOUT_LO_PRI);
+    set("rx_timeout_pri2", TARGET_RX_TIMEOUT_LO_PRI);
+    set("rx_timeout_pri3", TARGET_RX_TIMEOUT_HI_PRI);
+    set("rx_decap_mode", TARGET_DECAP_MODE_NATIVE_WIFI);
+    set("scan_max_pending_req", TARGET_SCAN_MAX_PENDING_REQS);
+    set("bmiss_offload_max_vdev", TARGET_BMISS_OFFLOAD_MAX_VDEV);
+    set("roam_offload_max_vdev", TARGET_ROAM_OFFLOAD_MAX_VDEV);
+    set("roam_offload_max_ap_profiles", TARGET_ROAM_OFFLOAD_MAX_AP_PROFILES);
+    set("tx_dbg_log_size", TARGET_TX_DBG_LOG_SIZE);
+    set("vow_config", TARGET_VOW_CONFIG);
+    set("flag1", WMI_RSRC_CFG_FLAG1_BSS_CHANNEL_INFO_64);
+    if hw.single_pdev_only {
+        // `ath11k_init_wmi_config_qca6390`.
+        set("num_vdevs", hw.num_vdevs);
+        set("num_peers", 16);
+        set("num_tids", 32);
+        set("num_offload_peers", 3);
+        set("num_offload_reorder_buffs", 3);
+        set("gtk_offload_max_vdev", 2);
+        set("num_msdu_desc", 0x400);
+        set("beacon_tx_offload_max_vdev", 2);
+        set("use_pdev_id", 1);
+        set("max_frag_entries", 0xa);
+        set("num_tdls_vdevs", 1);
+        set("num_tdls_conn_table_entries", 8);
+        set("num_multicast_filter_entries", 0x20);
+        set("num_wow_filters", 0x16);
+    } else {
+        // `ath11k_init_wmi_config_ipq8074` for one radio.
+        let peers = hw.num_peers + hw.num_vdevs;
+        set("num_vdevs", hw.num_vdevs);
+        set("num_peers", peers);
+        set("num_tids", 2 * peers + 4 * hw.num_vdevs + 8);
+        set("num_offload_peers", TARGET_NUM_OFFLD_PEERS);
+        set("num_offload_reorder_buffs", TARGET_NUM_OFFLD_REORDER_BUFFS);
+        set("num_mcast_groups", TARGET_NUM_MCAST_GROUPS);
+        set("num_mcast_table_elems", TARGET_NUM_MCAST_TABLE_ELEMS);
+        set("mcast2ucast_mode", TARGET_MCAST2UCAST_MODE);
+        set("num_wds_entries", TARGET_NUM_WDS_ENTRIES);
+        set("dma_burst_size", TARGET_DMA_BURST_SIZE);
+        set("rx_skip_defrag_timeout_dup_detection_check", TARGET_RX_SKIP_DEFRAG_TIMEOUT_DUP_DETECTION_CHECK);
+        set("gtk_offload_max_vdev", TARGET_GTK_OFFLOAD_MAX_VDEV);
+        set("num_msdu_desc", TARGET_NUM_MSDU_DESC);
+        set("beacon_tx_offload_max_vdev", TARGET_MAX_BCN_OFFLD + 1);
+        set("peer_map_unmap_v2_support", 1);
+        set("twt_ap_pdev_count", 1);
+        set("twt_ap_sta_count", 1000);
+        set("flag1", WMI_RSRC_CFG_FLAG1_BSS_CHANNEL_INFO_64 | WMI_RSRC_CFG_FLAG1_ACK_RSSI);
+        set("ema_max_vap_cnt", 1);
+        set("ema_max_profile_period", TARGET_EMA_MAX_PROFILE_PERIOD);
+    }
+    set("flags2", WMI_RSRC_CFG_FLAG2_CALC_NEXT_DTIM_COUNT_SET);
+    let mut cmd = Cmd::new(WMI_INIT_CMDID);
+    // `struct wmi_init_cmd`: the host's ABI version (left zero, as Linux
+    // does) and no host memory chunks.
+    cmd.tlv(WMI_TAG_INIT_CMD, &[0, 0, 0, 0, 0, 0, 0]);
+    cmd.tlv(WMI_TAG_RESOURCE_CONFIG, &cfg);
+    cmd.array_struct(&[]);
+    cmd
+}
