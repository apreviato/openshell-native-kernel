+/// `ath11k_wmi_vdev_start`: the vdev on its channel (a restart when
+/// `restart`), with the streams it prefers.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn vdev_start(vdev_id: u32, channel: &Channel, beacon_interval: u32, dtim: u32, ssid: &[u8], hidden: bool, streams: u32, restart: bool) -> Cmd {
+    let mut ssid_words = [0u32; 9];
+    ssid_words[0] = ssid.len().min(32) as u32;
+    for (index, chunk) in ssid[..ssid.len().min(32)].chunks(4).enumerate() {
+        let mut bytes = [0u8; 4];
+        bytes[..chunk.len()].copy_from_slice(chunk);
+        ssid_words[1 + index] = u32::from_le_bytes(bytes);
+    }
+    let flags = if hidden { WMI_VDEV_START_HIDDEN_SSID } else { 0 };
+    let mut words = vec![vdev_id, 0, beacon_interval, dtim, flags];
+    words.extend_from_slice(&ssid_words);
+    // bcn_tx_rate, bcn_txpower, num_noa_descriptors, disable_hw_ack,
+    // preferred tx/rx streams, he_ops, cac, regdomain, min rate, mbssid.
+    words.extend_from_slice(&[0, 0, 0, 0, streams, streams, 0, 0, 0, 0, 0, 0]);
+    let mut cmd = Cmd::new(if restart { WMI_VDEV_RESTART_REQUEST_CMDID } else { WMI_VDEV_START_REQUEST_CMDID });
+    cmd.tlv(WMI_TAG_VDEV_START_REQUEST_CMD, &words);
+    cmd.tlv(WMI_TAG_CHANNEL, &channel.words());
+    // No NoA descriptors.
+    cmd.array_struct(&[]);
+    cmd
+}
