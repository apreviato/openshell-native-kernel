+pub(crate) fn vdev_create(vdev_id: u32, pdev_id: u32, address: &[u8; 6], vdev_type: u32, streams: u32) -> Cmd {
+    let [w0, w1] = mac(address);
+    let mut cmd = Cmd::new(WMI_VDEV_CREATE_CMDID);
+    cmd.tlv(WMI_TAG_VDEV_CREATE_CMD, &[vdev_id, vdev_type, 0, w0, w1, 2, pdev_id, 0, 0]);
+    cmd.array_struct(&[
+        (WMI_TAG_VDEV_TXRX_STREAMS, vec![WMI_TPC_CHAINMASK_CONFIG_BAND_2G, streams, streams]),
+        (WMI_TAG_VDEV_TXRX_STREAMS, vec![WMI_TPC_CHAINMASK_CONFIG_BAND_5G, streams, streams]),
+    ]);
+    cmd
