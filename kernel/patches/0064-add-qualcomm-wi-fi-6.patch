+/// A channel as `ath11k_wmi_put_wmi_channel` writes it.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Channel {
+    pub(crate) freq: u32,
+    pub(crate) center1: u32,
+    pub(crate) center2: u32,
+    pub(crate) mode: u32,
+    pub(crate) passive: bool,
+    pub(crate) dfs: bool,
+    pub(crate) max_power: u32,
+}
+
+impl Channel {
+    /// `ath11k_wmi_put_wmi_channel` (the power as the channel's, in dBm,
+    /// as `ath11k_mac_vdev_start_restart` passes it).
+    pub(crate) fn words(&self) -> Vec<u32> {
+        let mut info = field(WMI_CHAN_INFO_MODE, self.mode);
+        if self.passive {
+            info |= WMI_CHAN_INFO_PASSIVE;
+        }
+        if self.dfs {
+            info |= WMI_CHAN_INFO_DFS;
+        }
+        let reg_info_1 = field(WMI_CHAN_REG_INFO1_MAX_PWR, self.max_power) | field(WMI_CHAN_REG_INFO1_MAX_REG_PWR, self.max_power);
+        vec![self.freq, self.center1, self.center2, info, reg_info_1, 0]
+    }
+}
