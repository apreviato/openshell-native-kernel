index 0000000..7dd26b2
--- /dev/null
+++ b/kernel/comps/ath11k/src/mhi.rs
@@ -0,0 +1,674 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! A host for MHI, the modem-host interface Qualcomm's PCIe chips boot and
+//! talk through: the boot loader takes its first image through BHI, the
+//! rest of the firmware through a vector table (BHIe), and the running
+//! firmware exchanges messages over channels whose rings, and the event
+//! rings that complete them, live in host memory. This driver uses one
+//! pair of channels, 20 and 21 (IPCR: QRTR's packets), and the control
+//! and data event rings.
+//!
+//! This is this kernel's own implementation of the protocol; the register
+//! offsets, context and ring element formats are the interface's.
+
+use alloc::{collections::VecDeque, vec, vec::Vec};
+
+use aster_linuxkpi::{
+    bits::{get_le32, get_le64, put_le32, put_le64},
+    dma::alloc_coherent32,
+};
+use ostd::mm::{HasDaddr, VmIo, dma::DmaCoherent};
+
+use crate::{WAKER, now_ms, pci::Bus};
+
+// ---- The MHI register space at BAR 0's start. ----
+pub(crate) const MHICFG: u32 = 0x10;
+const CHDBOFF: u32 = 0x18;
+const ERDBOFF: u32 = 0x20;
+const BHIOFF: u32 = 0x28;
+const BHIEOFF: u32 = 0x2c;
+pub(crate) const MHICTRL: u32 = 0x38;
+pub(crate) const MHISTATUS: u32 = 0x48;
+const CCABAP_LOWER: u32 = 0x58;
+const ECABAP_LOWER: u32 = 0x60;
+const CRCBAP_LOWER: u32 = 0x68;
+const CRDB_LOWER: u32 = 0x70;
+const MHICTRLBASE_LOWER: u32 = 0x80;
+const MHICTRLLIMIT_LOWER: u32 = 0x88;
+const MHIDATABASE_LOWER: u32 = 0x98;
+const MHIDATALIMIT_LOWER: u32 = 0xa0;
+pub(crate) const MHICTRL_RESET: u32 = 1 << 1;
+const MHICTRL_STATE_SHIFT: u32 = 8;
+const MHISTATUS_READY: u32 = 1 << 0;
+/// The number of event rings, and of hardware ones, in `MHICFG`.
+const MHICFG_NER_SHIFT: u32 = 16;
+const MHICFG_NHWER_SHIFT: u32 = 24;
+/// The doorbell that keeps the device awake (out of M1/M2).
+const DEV_WAKE_DB: u32 = 127;
+
+// ---- BHI and BHIe, at the offsets the MHI registers give. ----
+const BHI_IMGADDR_LOW: u32 = 0x08;
+const BHI_IMGADDR_HIGH: u32 = 0x0c;
+const BHI_IMGSIZE: u32 = 0x10;
+const BHI_IMGTXDB: u32 = 0x18;
+const BHI_INTVEC: u32 = 0x20;
+const BHI_EXECENV: u32 = 0x28;
+const BHI_STATUS: u32 = 0x2c;
+const BHI_ERRCODE: u32 = 0x30;
+const BHI_STATUS_SUCCESS: u32 = 2;
+const BHI_STATUS_ERROR: u32 = 3;
+const BHIE_TXVECADDR_LOW: u32 = 0x2c;
+const BHIE_TXVECADDR_HIGH: u32 = 0x30;
+const BHIE_TXVECSIZE: u32 = 0x34;
+const BHIE_TXVECDB: u32 = 0x3c;
+const BHIE_TXVECSTATUS: u32 = 0x44;
+const SEQ_MASK: u32 = (1 << 30) - 1;
+
+// ---- States and execution environments. ----
+const STATE_RESET: u32 = 0;
+const STATE_M0: u32 = 2;
+const STATE_SYS_ERR: u32 = 0xff;
+const EE_PBL: u32 = 0;
+const EE_SBL: u32 = 1;
+const EE_AMSS: u32 = 2;
+const EE_RDDM: u32 = 3;
+const EE_WFW: u32 = 4;
+const EE_PTHRU: u32 = 5;
+const EE_EDL: u32 = 6;
+
+// ---- Ring elements: a 64-bit pointer and two words. ----
+const ELEMENT: usize = 16;
+const PKT_TRANSFER: u32 = 2;
+const PKT_START_CHAN_CMD: u32 = 0x12;
+const PKT_STATE_CHANGE_EVENT: u32 = 0x20;
+const PKT_CMD_COMPLETION_EVENT: u32 = 0x21;
+const PKT_TX_EVENT: u32 = 0x22;
+const PKT_EE_EVENT: u32 = 0x40;
+const CC_SUCCESS: u32 = 1;
+const CC_EOT: u32 = 2;
+const CC_OVERFLOW: u32 = 3;
+const CC_EOB: u32 = 4;
+/// A transfer element's "interrupt on end of transfer".
+const TRE_IEOT: u32 = 1 << 9;
+
+// ---- Contexts: 44 bytes each. ----
+const CTXT: usize = 44;
+const CTXT_RBASE: usize = 12;
+const CTXT_RLEN: usize = 20;
+const CTXT_RP: usize = 28;
+const CTXT_WP: usize = 36;
+const CH_STATE_ENABLED: u32 = 1;
+/// Burst mode disabled (`MHI_DB_BRST_DISABLE`), in the context's bits 9:8.
+const CH_BRSTMODE_DISABLE: u32 = 2 << 8;
+const CH_TYPE_OUTBOUND: u32 = 1;
+const CH_TYPE_INBOUND: u32 = 2;
+const ER_TYPE_VALID: u32 = 1;
+
+/// The IPCR channels and the event ring their completions go to.
+pub(crate) const CH_IPCR_UL: u32 = 20;
+pub(crate) const CH_IPCR_DL: u32 = 21;
+const EVENT_RINGS: usize = 2;
+const ER_CTRL: usize = 0;
+const ER_DATA: usize = 1;
+const CMD_ELEMENTS: usize = 128;
+/// The boot loader's image is the firmware file's first 512 KiB; the
+/// vector table cuts the whole file in pieces of the same size.
+const SBL_SIZE: usize = 512 * 1024;
+const SEG_LEN: usize = 512 * 1024;
+const TIMEOUT_MS: u64 = 20_000;
+/// A buffer of the receiving channel.
+const BUF_LEN: usize = 8192;
+/// The device addresses the host gives it: all of a 36-bit DMA space.
+const IOVA_STOP: u64 = (1 << 36) - 1;
+
+/// A ring in host memory: its elements, the host's place in it, and its
+/// doorbell register.
+struct Ring {
+    mem: DmaCoherent,
+    elements: usize,
+    rp: usize,
+    wp: usize,
+    db: u32,
+}
+
+impl Ring {
+    fn new(elements: usize) -> Option<Self> {
+        Some(Self { mem: alloc_coherent32(elements * ELEMENT)?, elements, rp: 0, wp: 0, db: 0 })
+    }
+
+    fn base(&self) -> u64 {
+        self.mem.daddr() as u64
+    }
+
+    fn addr(&self, index: usize) -> u64 {
+        self.base() + (index * ELEMENT) as u64
+    }
+
+    /// The element a device address points at.
+    fn index_of(&self, addr: u64) -> Option<usize> {
+        let offset = addr.checked_sub(self.base())? as usize;
+        (offset < self.elements * ELEMENT && offset % ELEMENT == 0).then_some(offset / ELEMENT)
+    }
+
+    fn read(&self, index: usize) -> [u8; ELEMENT] {
+        let mut element = [0u8; ELEMENT];
+        let _ = self.mem.read_bytes(index * ELEMENT, &mut element);
+        element
+    }
+
+    fn write(&self, index: usize, ptr: u64, dword0: u32, dword1: u32) {
+        let mut element = [0u8; ELEMENT];
+        put_le64(&mut element, 0, ptr);
+        put_le32(&mut element, 8, dword0);
+        put_le32(&mut element, 12, dword1);
+        let _ = self.mem.write_bytes(index * ELEMENT, &element);
+    }
+}
+
+/// A channel's buffers, one per ring element.
+struct Channel {
+    ring: Ring,
+    buffers: Vec<DmaCoherent>,
+    /// The elements handed to the device, oldest first.
+    pending: usize,
+}
+
+pub(crate) struct Mhi {
+    ctx: DmaCoherent,
+    ev_ctx: usize,
+    cmd_ctx: usize,
+    events: Vec<Ring>,
+    cmd: Ring,
+    ul: Option<Channel>,
+    dl: Option<Channel>,
+    bhi: u32,
+    bhie: u32,
+    chdb: u32,
+    pub(crate) ee: u32,
+    state: u32,
+    /// The vector table and its segments, for the firmware's second part.
+    image: Option<(DmaCoherent, Vec<DmaCoherent>)>,
+    command_done: Option<u32>,
+    /// What came on the receiving channel.
+    pub(crate) received: VecDeque<Vec<u8>>,
+    pub(crate) error: bool,
+}
+
+fn random_seq() -> u32 {
+    let seed = ostd::arch::read_random().unwrap_or(now_ms() ^ 0x5bd1_e995) as u32;
+    (seed & SEQ_MASK).max(1)
+}
+
+impl Mhi {
+    /// `mhi_prepare_for_power_up`: the contexts and the event and command
+    /// rings, the BHI registers' places.
+    pub(crate) fn new(bus: &Bus) -> Result<Self, &'static str> {
+        let max_chan = bus.hw.mhi_max_channels;
+        let ev_ctx = max_chan * CTXT;
+        let cmd_ctx = ev_ctx + EVENT_RINGS * CTXT;
+        let ctx = alloc_coherent32(cmd_ctx + CTXT).ok_or("no memory for the MHI contexts")?;
+        let mut events = Vec::new();
+        for (index, elements) in [(ER_CTRL, 32usize), (ER_DATA, 256)] {
+            let ring = Ring::new(elements).ok_or("no memory for the MHI event rings")?;
+            let at = ev_ctx + index * CTXT;
+            let mut context = [0u8; CTXT];
+            // Interrupt moderation (ms) in bits 31:16: none on the control
+            // ring, 1 ms on the data ring.
+            put_le32(&mut context, 0, if index == ER_DATA { 1 << 16 } else { 0 });
+            put_le32(&mut context, 4, ER_TYPE_VALID);
+            put_le32(&mut context, 8, index as u32 + 1);
+            put_le64(&mut context, CTXT_RBASE, ring.base());
+            put_le64(&mut context, CTXT_RLEN, (elements * ELEMENT) as u64);
+            put_le64(&mut context, CTXT_RP, ring.base());
+            put_le64(&mut context, CTXT_WP, ring.base());
+            let _ = ctx.write_bytes(at, &context);
+            events.push(ring);
+        }
+        let cmd = Ring::new(CMD_ELEMENTS).ok_or("no memory for the MHI command ring")?;
+        let mut context = [0u8; CTXT];
+        put_le64(&mut context, CTXT_RBASE, cmd.base());
+        put_le64(&mut context, CTXT_RLEN, (CMD_ELEMENTS * ELEMENT) as u64);
+        put_le64(&mut context, CTXT_RP, cmd.base());
+        put_le64(&mut context, CTXT_WP, cmd.base());
+        let _ = ctx.write_bytes(cmd_ctx, &context);
+        let mhi = Self {
+            ctx,
+            ev_ctx,
+            cmd_ctx,
+            events,
+            cmd,
+            ul: None,
+            dl: None,
+            bhi: bus.mhi_read(BHIOFF),
+            bhie: bus.mhi_read(BHIEOFF),
+            chdb: 0,
+            ee: EE_PBL,
+            state: STATE_RESET,
+            image: None,
+            command_done: None,
+            received: VecDeque::new(),
+            error: false,
+        };
+        // The IPCR channels' contexts: disabled until started.
+        for (channel, kind) in [(CH_IPCR_UL, CH_TYPE_OUTBOUND), (CH_IPCR_DL, CH_TYPE_INBOUND)] {
+            let mut context = [0u8; CTXT];
+            put_le32(&mut context, 0, CH_BRSTMODE_DISABLE);
+            put_le32(&mut context, 4, kind);
+            put_le32(&mut context, 8, ER_DATA as u32);
+            mhi.write_ctx(channel as usize * CTXT, &context);
+        }
+        Ok(mhi)
+    }
+
+    fn write_ctx(&self, at: usize, bytes: &[u8]) {
+        let _ = self.ctx.write_bytes(at, bytes);
+    }
+
+    fn ctx_u64(&self, at: usize) -> u64 {
+        let mut bytes = [0u8; 8];
+        let _ = self.ctx.read_bytes(at, &mut bytes);
+        u64::from_le_bytes(bytes)
+    }
+
+    fn set_ctx_u64(&self, at: usize, value: u64) {
+        let _ = self.ctx.write_bytes(at, &value.to_le_bytes());
+    }
+
+    /// A doorbell: the 64-bit address, high word first.
+    fn ring_db(bus: &Bus, db: u32, value: u64) {
+        bus.mhi_write(db + 4, (value >> 32) as u32);
+        bus.mhi_write(db, value as u32);
+    }
+
+    fn set_state(bus: &Bus, state: u32) {
+        let control = bus.mhi_read(MHICTRL) & !(0xff << MHICTRL_STATE_SHIFT);
+        bus.mhi_write(MHICTRL, control | (state << MHICTRL_STATE_SHIFT));
+    }
+
+    fn poll(bus: &Bus, offset: u32, mask: u32, value: u32) -> bool {
+        let deadline = now_ms() + TIMEOUT_MS;
+        while now_ms() < deadline {
+            if bus.mhi_read(offset) & mask == value {
+                return true;
+            }
+            WAKER.msleep(25);
+        }
+        false
+    }
+
+    // ---- Power-up (`mhi_async_power_up` and what follows it). ----
+
+    /// The firmware loaded and running in mission mode, the IPCR channels
+    /// started.
+    pub(crate) fn power_up(&mut self, bus: &Bus, firmware: &[u8]) -> Result<(), &'static str> {
+        bus.mhi_write(self.bhi + BHI_INTVEC, 0);
+        self.ee = bus.mhi_read(self.bhi + BHI_EXECENV);
+        let state = (bus.mhi_read(MHISTATUS) >> 8) & 0xff;
+        if state == STATE_SYS_ERR {
+            bus.mhi_write(MHICTRL, MHICTRL_RESET);
+            if !Self::poll(bus, MHICTRL, MHICTRL_RESET, 0) {
+                return Err("MHI stays in its system error");
+            }
+            bus.mhi_write(self.bhi + BHI_INTVEC, 0);
+        }
+        if matches!(self.ee, EE_PBL | EE_EDL | EE_PTHRU) {
+            if self.ee != EE_PTHRU {
+                self.load_sbl(bus, firmware)?;
+                self.prepare_image(firmware)?;
+            }
+        } else if !matches!(self.ee, EE_AMSS | EE_WFW) {
+            return Err("the device is in an execution environment MHI cannot start from");
+        }
+        self.ready(bus)?;
+        // The boot loader asks for the rest (an SBL event), then the
+        // firmware says it runs (an AMSS or WLAN firmware event).
+        let deadline = now_ms() + TIMEOUT_MS;
+        let mut amss_sent = false;
+        while !matches!(self.ee, EE_AMSS | EE_WFW) {
+            self.process(bus);
+            if self.error {
+                return Err("the device reported a system error");
+            }
+            if self.ee == EE_SBL && !amss_sent {
+                self.load_amss(bus)?;
+                amss_sent = true;
+            }
+            if now_ms() >= deadline {
+                return Err("the firmware did not reach mission mode");
+            }
+            WAKER.msleep(5);
+        }
+        self.mission_mode(bus);
+        self.start_channels(bus)?;
+        Ok(())
+    }
+
+    /// `mhi_fw_load_bhi`: the boot loader's image.
+    fn load_sbl(&mut self, bus: &Bus, firmware: &[u8]) -> Result<(), &'static str> {
+        let size = firmware.len().min(SBL_SIZE);
+        let image = alloc_coherent32(size).ok_or("no memory for the boot image")?;
+        image.write_bytes(0, &firmware[..size]).map_err(|_| "boot image")?;
+        let address = image.daddr() as u64;
+        bus.mhi_write(self.bhi + BHI_STATUS, 0);
+        bus.mhi_write(self.bhi + BHI_IMGADDR_HIGH, (address >> 32) as u32);
+        bus.mhi_write(self.bhi + BHI_IMGADDR_LOW, address as u32);
+        bus.mhi_write(self.bhi + BHI_IMGSIZE, size as u32);
+        bus.mhi_write(self.bhi + BHI_IMGTXDB, random_seq());
+        let deadline = now_ms() + TIMEOUT_MS;
+        loop {
+            match bus.mhi_read(self.bhi + BHI_STATUS) >> 30 {
+                BHI_STATUS_SUCCESS => break,
+                BHI_STATUS_ERROR => {
+                    ostd::warn!("ath11k: BHI error {:#x}", bus.mhi_read(self.bhi + BHI_ERRCODE));
+                    return Err("the boot loader refused its image");
+                }
+                _ => {}
+            }
+            if now_ms() >= deadline {
+                return Err("the boot loader did not take its image");
+            }
+            WAKER.msleep(10);
+        }
+        drop(image);
+        Ok(())
+    }
+
+    /// The vector table of the whole firmware file (or of the second ELF
+    /// image after the boot loader's, when the file holds two).
+    fn prepare_image(&mut self, firmware: &[u8]) -> Result<(), &'static str> {
+        let data = match firmware.get(SBL_SIZE..SBL_SIZE + 4) {
+            Some(magic) if magic == b"\x7fELF" => &firmware[SBL_SIZE..],
+            _ => firmware,
+        };
+        let mut segments = Vec::new();
+        let table = alloc_coherent32(data.len().div_ceil(SEG_LEN) * 16).ok_or("no memory for the vector table")?;
+        for (index, chunk) in data.chunks(SEG_LEN).enumerate() {
+            let segment = alloc_coherent32(SEG_LEN).ok_or("no memory for the firmware's segments")?;
+            segment.write_bytes(0, chunk).map_err(|_| "firmware segment")?;
+            let mut entry = [0u8; 16];
+            put_le64(&mut entry, 0, segment.daddr() as u64);
+            put_le64(&mut entry, 8, chunk.len() as u64);
+            table.write_bytes(index * 16, &entry).map_err(|_| "vector table")?;
+            segments.push(segment);
+        }
+        self.image = Some((table, segments));
+        Ok(())
+    }
+
+    /// `mhi_download_amss_image` through BHIe.
+    fn load_amss(&mut self, bus: &Bus) -> Result<(), &'static str> {
+        let Some((table, segments)) = &self.image else { return Err("no firmware image for the boot loader") };
+        let address = table.daddr() as u64;
+        bus.mhi_write(self.bhie + BHIE_TXVECADDR_HIGH, (address >> 32) as u32);
+        bus.mhi_write(self.bhie + BHIE_TXVECADDR_LOW, address as u32);
+        bus.mhi_write(self.bhie + BHIE_TXVECSIZE, (segments.len() * 16) as u32);
+        let seq = random_seq();
+        let doorbell = bus.mhi_read(self.bhie + BHIE_TXVECDB) & !SEQ_MASK;
+        bus.mhi_write(self.bhie + BHIE_TXVECDB, doorbell | seq);
+        let deadline = now_ms() + TIMEOUT_MS;
+        loop {
+            match bus.mhi_read(self.bhie + BHIE_TXVECSTATUS) >> 30 {
+                BHI_STATUS_SUCCESS => return Ok(()),
+                BHI_STATUS_ERROR => return Err("the boot loader refused the firmware"),
+                _ => {}
+            }
+            if now_ms() >= deadline {
+                return Err("the boot loader did not take the firmware");
+            }
+            WAKER.msleep(10);
+        }
+    }
+
+    /// `mhi_ready_state_transition`: the device out of reset and ready,
+    /// the contexts given to it, the event rings full of room, M0.
+    fn ready(&mut self, bus: &Bus) -> Result<(), &'static str> {
+        if !Self::poll(bus, MHICTRL, MHICTRL_RESET, 0) {
+            return Err("MHI did not leave reset");
+        }
+        if !Self::poll(bus, MHISTATUS, MHISTATUS_READY, MHISTATUS_READY) {
+            return Err("MHI did not become ready");
+        }
+        self.chdb = bus.mhi_read(CHDBOFF);
+        let erdb = bus.mhi_read(ERDBOFF);
+        for (index, ring) in self.events.iter_mut().enumerate() {
+            ring.db = erdb + 8 * index as u32;
+        }
+        self.cmd.db = CRDB_LOWER;
+        let ctx = self.ctx.daddr() as u64;
+        for (offset, value) in [
+            (CCABAP_LOWER, ctx),
+            (ECABAP_LOWER, ctx + self.ev_ctx as u64),
+            (CRCBAP_LOWER, ctx + self.cmd_ctx as u64),
+            (MHICTRLBASE_LOWER, 0),
+            (MHIDATABASE_LOWER, 0),
+            (MHICTRLLIMIT_LOWER, IOVA_STOP),
+            (MHIDATALIMIT_LOWER, IOVA_STOP),
+        ] {
+            bus.mhi_write(offset + 4, (value >> 32) as u32);
+            bus.mhi_write(offset, value as u32);
+        }
+        let config = bus.mhi_read(MHICFG) & !((0xff << MHICFG_NER_SHIFT) | (0xff << MHICFG_NHWER_SHIFT));
+        bus.mhi_write(MHICFG, config | ((EVENT_RINGS as u32) << MHICFG_NER_SHIFT));
+        for index in 0..EVENT_RINGS {
+            self.give_all_events(bus, index);
+        }
+        Self::set_state(bus, STATE_M0);
+        Ok(())
+    }
+
+    /// An event ring's write pointer at its last element: all of it is
+    /// the device's to write.
+    fn give_all_events(&mut self, bus: &Bus, index: usize) {
+        let ring = &mut self.events[index];
+        ring.wp = ring.elements - 1;
+        let wp = ring.addr(ring.wp);
+        let db = ring.db;
+        self.set_ctx_u64(self.ev_ctx + index * CTXT + CTXT_WP, wp);
+        Self::ring_db(bus, db, wp);
+    }
+
+    /// `mhi_pm_mission_mode_transition`: the device kept awake.
+    fn mission_mode(&mut self, bus: &Bus) {
+        let wake = self.chdb + 8 * DEV_WAKE_DB;
+        Self::ring_db(bus, wake, 1);
+        for index in 0..EVENT_RINGS {
+            let wp = self.events[index].addr(self.events[index].wp);
+            Self::ring_db(bus, self.events[index].db, wp);
+        }
+    }
+
+    // ---- Channels. ----
+
+    fn start_channels(&mut self, bus: &Bus) -> Result<(), &'static str> {
+        for (channel, inbound) in [(CH_IPCR_UL, false), (CH_IPCR_DL, true)] {
+            let elements = bus.hw.mhi_elements;
+            let ring = Ring::new(elements).ok_or("no memory for an MHI channel")?;
+            let mut buffers = Vec::with_capacity(elements);
+            for _ in 0..elements {
+                buffers.push(alloc_coherent32(BUF_LEN).ok_or("no memory for MHI buffers")?);
+            }
+            let at = channel as usize * CTXT;
+            let mut context = [0u8; CTXT];
+            put_le32(&mut context, 0, CH_STATE_ENABLED | CH_BRSTMODE_DISABLE);
+            put_le32(&mut context, 4, if inbound { CH_TYPE_INBOUND } else { CH_TYPE_OUTBOUND });
+            put_le32(&mut context, 8, ER_DATA as u32);
+            put_le64(&mut context, CTXT_RBASE, ring.base());
+            put_le64(&mut context, CTXT_RLEN, (elements * ELEMENT) as u64);
+            put_le64(&mut context, CTXT_RP, ring.base());
+            put_le64(&mut context, CTXT_WP, ring.base());
+            self.write_ctx(at, &context);
+            let mut chan = Channel { ring, buffers, pending: 0 };
+            chan.ring.db = self.chdb + 8 * channel;
+            if inbound {
+                self.dl = Some(chan);
+            } else {
+                self.ul = Some(chan);
+            }
+            self.command(bus, (channel << 24) | (PKT_START_CHAN_CMD << 16))?;
+            if inbound {
+                // All but one element hold an empty buffer.
+                for _ in 0..elements - 1 {
+                    self.queue_rx();
+                }
+                self.chan_db(bus, true);
+            }
+        }
+        Ok(())
+    }
+
+    /// A command and its completion.
+    fn command(&mut self, bus: &Bus, dword1: u32) -> Result<(), &'static str> {
+        let ring = &mut self.cmd;
+        ring.write(ring.wp, 0, 0, dword1);
+        ring.wp = (ring.wp + 1) % ring.elements;
+        let wp = ring.addr(ring.wp);
+        let db = ring.db;
+        self.set_ctx_u64(self.cmd_ctx + CTXT_WP, wp);
+        self.command_done = None;
+        Self::ring_db(bus, db, wp);
+        let deadline = now_ms() + TIMEOUT_MS;
+        while self.command_done.is_none() {
+            self.process(bus);
+            if now_ms() >= deadline {
+                return Err("MHI did not complete a command");
+            }
+            WAKER.msleep(1);
+        }
+        if self.command_done == Some(CC_SUCCESS) { Ok(()) } else { Err("MHI refused a command") }
+    }
+
+    fn chan_db(&mut self, bus: &Bus, inbound: bool) {
+        let (channel, chan) = if inbound { (CH_IPCR_DL, &self.dl) } else { (CH_IPCR_UL, &self.ul) };
+        let Some(chan) = chan else { return };
+        let wp = chan.ring.addr(chan.ring.wp);
+        let db = chan.ring.db;
+        self.set_ctx_u64(channel as usize * CTXT + CTXT_WP, wp);
+        Self::ring_db(bus, db, wp);
+    }
+
+    /// An empty buffer on the receiving channel (`mhi_gen_tre`).
+    fn queue_rx(&mut self) {
+        let Some(chan) = &mut self.dl else { return };
+        let index = chan.ring.wp;
+        let address = chan.buffers[index].daddr() as u64;
+        chan.ring.write(index, address, BUF_LEN as u32, (PKT_TRANSFER << 16) | TRE_IEOT);
+        chan.ring.wp = (index + 1) % chan.ring.elements;
+        chan.pending += 1;
+    }
+
+    /// A packet on the sending channel. `Err`: no room now.
+    pub(crate) fn send(&mut self, bus: &Bus, data: &[u8]) -> Result<(), ()> {
+        let Some(chan) = &mut self.ul else { return Err(()) };
+        if data.len() > BUF_LEN || chan.pending + 1 >= chan.ring.elements {
+            return Err(());
+        }
+        let index = chan.ring.wp;
+        chan.buffers[index].write_bytes(0, data).map_err(|_| ())?;
+        let address = chan.buffers[index].daddr() as u64;
+        chan.ring.write(index, address, data.len() as u32, (PKT_TRANSFER << 16) | TRE_IEOT);
+        chan.ring.wp = (index + 1) % chan.ring.elements;
+        chan.pending += 1;
+        self.chan_db(bus, false);
+        Ok(())
+    }
+
+    // ---- Events (`mhi_process_ctrl_ev_ring`, `parse_xfer_event`). ----
+
+    /// The event rings read. Whether anything came.
+    pub(crate) fn process(&mut self, bus: &Bus) -> bool {
+        let mut any = false;
+        for index in 0..EVENT_RINGS {
+            let device_rp = self.ctx_u64(self.ev_ctx + index * CTXT + CTXT_RP);
+            let Some(stop) = self.events[index].index_of(device_rp) else {
+                self.error = true;
+                continue;
+            };
+            let mut count = 0;
+            while self.events[index].rp != stop && count < self.events[index].elements {
+                let element = self.events[index].read(self.events[index].rp);
+                self.event(bus, &element);
+                let ring = &mut self.events[index];
+                ring.rp = (ring.rp + 1) % ring.elements;
+                ring.wp = (ring.wp + 1) % ring.elements;
+                count += 1;
+            }
+            if count > 0 {
+                any = true;
+                let wp = self.events[index].addr(self.events[index].wp);
+                self.set_ctx_u64(self.ev_ctx + index * CTXT + CTXT_WP, wp);
+                Self::ring_db(bus, self.events[index].db, wp);
+            }
+        }
+        any
+    }
+
+    fn event(&mut self, bus: &Bus, element: &[u8; ELEMENT]) {
+        let ptr = get_le64(element, 0);
+        let dword0 = get_le32(element, 8);
+        let dword1 = get_le32(element, 12);
+        match (dword1 >> 16) & 0xff {
+            PKT_STATE_CHANGE_EVENT => {
+                self.state = dword0 >> 24;
+                if self.state == STATE_SYS_ERR {
+                    ostd::warn!("ath11k: MHI system error");
+                    self.error = true;
+                }
+            }
+            PKT_EE_EVENT => {
+                let ee = dword0 >> 24;
+                if ee == EE_RDDM {
+                    ostd::warn!("ath11k: the firmware crashed (RAM dump mode)");
+                    self.error = true;
+                }
+                self.ee = ee;
+            }
+            PKT_CMD_COMPLETION_EVENT => self.command_done = Some(dword0 >> 24),
+            PKT_TX_EVENT => {
+                let code = dword0 >> 24;
+                let len = (dword0 & 0xffff) as usize;
+                match dword1 >> 24 {
+                    CH_IPCR_UL => {
+                        if let Some(chan) = &mut self.ul
+                            && let Some(done) = chan.ring.index_of(ptr)
+                        {
+                            // Everything up to the element completed.
+                            while chan.pending > 0 {
+                                let index = chan.ring.rp;
+                                chan.ring.rp = (index + 1) % chan.ring.elements;
+                                chan.pending -= 1;
+                                if index == done {
+                                    break;
+                                }
+                            }
+                        }
+                    }
+                    CH_IPCR_DL if matches!(code, CC_EOT | CC_EOB | CC_OVERFLOW) => {
+                        let Some(chan) = &mut self.dl else { return };
+                        let Some(done) = chan.ring.index_of(ptr) else { return };
+                        while chan.pending > 0 {
+                            let index = chan.ring.rp;
+                            chan.ring.rp = (index + 1) % chan.ring.elements;
+                            chan.pending -= 1;
+                            if index == done {
+                                let mut data = vec![0u8; len.min(BUF_LEN)];
+                                if code != CC_OVERFLOW && chan.buffers[index].read_bytes(0, &mut data).is_ok() {
+                                    self.received.push_back(data);
+                                }
+                                break;
+                            }
+                        }
+                        // Its buffers go back to the device.
+                        let Some(chan) = &self.dl else { return };
+                        let missing = chan.ring.elements - 1 - chan.pending;
+                        for _ in 0..missing {
+                            self.queue_rx();
+                        }
+                        self.chan_db(bus, true);
+                    }
+                    _ => {}
+                }
+            }
+            _ => {}
+        }
+    }
+}
diff --git a/kernel/comps/ath11k/src/pci.rs b/kernel/comps/ath11k/src/pci.rs
new file mode 100644
index 0000000..d95e81a
--- /dev/null
+++ b/kernel/comps/ath11k/src/pci.rs
@@ -0,0 +1,239 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The PCI side as Linux's ath11k `pci.c` and `pcic.c` run it: BAR 0's
+//! first 512 KiB straight, the rest through a window register (or, on the
+//! QCN9074, three fixed windows over the CE and data-path blocks), the
+//! chip's reset before the firmware is loaded, and the MSI message the
+//! rings raise.
+
+use core::sync::atomic::{AtomicU32, Ordering};
+
+use aster_linuxkpi::{delay::mdelay, io::Mmio, pci};
+use aster_pci::PciDeviceLocation;
+
+use crate::{
+    hw::HwParams,
+    mhi::{MHICTRL, MHICTRL_RESET, MHISTATUS},
+    regs::*,
+};
+
+/// The PCI capability of MSI and its registers (`linux/pci_regs.h`).
+const PCI_CAP_ID_MSI: u8 = 0x05;
+const PCI_MSI_FLAGS: u16 = 2;
+const PCI_MSI_FLAGS_64BIT: u16 = 0x0080;
+const PCI_MSI_ADDRESS_LO: u16 = 4;
+const PCI_MSI_ADDRESS_HI: u16 = 8;
+const PCI_MSI_DATA_32: u16 = 8;
+const PCI_MSI_DATA_64: u16 = 12;
+/// The link control register of the PCIe capability.
+const PCI_EXP_LNKCTL: u16 = 0x10;
+
+pub(crate) struct Bus {
+    pub(crate) location: PciDeviceLocation,
+    pub(crate) mem: Mmio,
+    pub(crate) hw: &'static HwParams,
+    /// The window BAR 0's upper part shows (`register_window`).
+    window: AtomicU32,
+    /// The MSI message the rings may raise: its address and data.
+    pub(crate) msi: Option<(u64, u32)>,
+}
+
+impl Bus {
+    pub(crate) fn new(location: PciDeviceLocation, mem: Mmio, hw: &'static HwParams) -> Self {
+        Self { location, mem, hw, window: AtomicU32::new(0), msi: None }
+    }
+
+    /// The MSI message the bus driver programmed (`ath11k_pci_alloc_msi`
+    /// reads the same back).
+    pub(crate) fn read_msi(&mut self) {
+        let Some(cap) = pci::find_capability(&self.location, PCI_CAP_ID_MSI) else { return };
+        let flags = self.location.read16(cap + PCI_MSI_FLAGS);
+        let lo = self.location.read32(cap + PCI_MSI_ADDRESS_LO) as u64;
+        let (hi, data) = if flags & PCI_MSI_FLAGS_64BIT != 0 {
+            (self.location.read32(cap + PCI_MSI_ADDRESS_HI) as u64, self.location.read16(cap + PCI_MSI_DATA_64))
+        } else {
+            (0, self.location.read16(cap + PCI_MSI_DATA_32))
+        };
+        if lo != 0 {
+            self.msi = Some((lo | (hi << 32), data as u32));
+        }
+    }
+
+    fn window_start(&self, offset: u32) -> u32 {
+        if !self.hw.static_window_map {
+            return ATH11K_PCI_WINDOW_START;
+        }
+        if (offset ^ HAL_SEQ_WCSS_UMAC_OFFSET) < ATH11K_PCI_WINDOW_RANGE_MASK {
+            3 * ATH11K_PCI_WINDOW_START
+        } else if (offset ^ self.hw.regs.hal_seq_wcss_umac_ce0_src_reg) < ATH11K_PCI_WINDOW_RANGE_MASK {
+            2 * ATH11K_PCI_WINDOW_START
+        } else {
+            ATH11K_PCI_WINDOW_START
+        }
+    }
+
+    fn select_window(&self, offset: u32) {
+        let window = (offset & ATH11K_PCI_WINDOW_VALUE_MASK) >> 19;
+        if window != self.window.load(Ordering::Relaxed) {
+            self.mem.iowrite32(ATH11K_PCI_WINDOW_REG_ADDRESS as usize, ATH11K_PCI_WINDOW_ENABLE_BIT | window);
+            self.mem.ioread32(ATH11K_PCI_WINDOW_REG_ADDRESS as usize);
+            self.window.store(window, Ordering::Relaxed);
+        }
+    }
+
+    /// `ath11k_pcic_read32`.
+    pub(crate) fn read32(&self, offset: u32) -> u32 {
+        if offset < ATH11K_PCI_WINDOW_START {
+            return self.mem.ioread32(offset as usize);
+        }
+        let start = self.window_start(offset);
+        if start == ATH11K_PCI_WINDOW_START {
+            self.select_window(offset);
+        }
+        self.mem.ioread32((start + (offset & ATH11K_PCI_WINDOW_RANGE_MASK)) as usize)
+    }
+
+    /// `ath11k_pcic_write32`.
+    pub(crate) fn write32(&self, offset: u32, value: u32) {
+        if offset < ATH11K_PCI_WINDOW_START {
+            self.mem.iowrite32(offset as usize, value);
+            return;
+        }
+        let start = self.window_start(offset);
+        if start == ATH11K_PCI_WINDOW_START {
+            self.select_window(offset);
+        }
+        self.mem.iowrite32((start + (offset & ATH11K_PCI_WINDOW_RANGE_MASK)) as usize, value);
+    }
+
+    /// `ath11k_pci_select_static_window` (QCN9074, once the firmware runs).
+    pub(crate) fn select_static_window(&self) {
+        let umac = (HAL_SEQ_WCSS_UMAC_OFFSET & ATH11K_PCI_WINDOW_VALUE_MASK) >> 19;
+        let ce = (HAL_CE_WFSS_CE_REG_BASE & ATH11K_PCI_WINDOW_VALUE_MASK) >> 19;
+        self.mem.iowrite32(ATH11K_PCI_WINDOW_REG_ADDRESS as usize, ATH11K_PCI_WINDOW_ENABLE_BIT | (umac << 12) | (ce << 6));
+    }
+
+    fn restore_window(&self) {
+        self.mem.iowrite32(ATH11K_PCI_WINDOW_REG_ADDRESS as usize, ATH11K_PCI_WINDOW_ENABLE_BIT | self.window.load(Ordering::Relaxed));
+        self.mem.ioread32(ATH11K_PCI_WINDOW_REG_ADDRESS as usize);
+    }
+
+    /// The SoC's version (`ath11k_pci_read_hw_version`): major, minor.
+    pub(crate) fn hw_version(&self) -> (u32, u32) {
+        let version = self.read32(TCSR_SOC_HW_VERSION);
+        ((version >> 8) & 0xf, version & 0xff)
+    }
+
+    // ---- The reset before the firmware (`ath11k_pci_sw_reset`). ----
+
+    fn soc_global_reset(&self) {
+        let value = self.read32(PCIE_SOC_GLOBAL_RESET) | PCIE_SOC_GLOBAL_RESET_V;
+        self.write32(PCIE_SOC_GLOBAL_RESET, value);
+        self.read32(PCIE_SOC_GLOBAL_RESET);
+        mdelay(10);
+        self.write32(PCIE_SOC_GLOBAL_RESET, value & !PCIE_SOC_GLOBAL_RESET_V);
+        self.read32(PCIE_SOC_GLOBAL_RESET);
+        mdelay(10);
+        if self.read32(PCIE_SOC_GLOBAL_RESET) == u32::MAX {
+            ostd::warn!("ath11k: the link went down in the global reset");
+        }
+        // The reset cleared the window register.
+        self.restore_window();
+    }
+
+    fn clear_dbg_registers(&self) {
+        self.read32(PCIE_Q6_COOKIE_ADDR);
+        self.read32(WLAON_WARM_SW_ENTRY);
+        mdelay(10);
+        // The Q6 must not go on along its warm path into a loop.
+        self.write32(WLAON_WARM_SW_ENTRY, 0);
+        mdelay(10);
+        self.read32(WLAON_WARM_SW_ENTRY);
+        // Read to clear.
+        self.read32(WLAON_SOC_RESET_CAUSE_REG);
+    }
+
+    fn set_link_reg(&self, offset: u32, value: u32, mask: u32) {
+        let mut current = self.read32(offset);
+        for _ in 0..10 {
+            if current & mask == value {
+                return;
+            }
+            self.write32(offset, (current & !mask) | value);
+            current = self.read32(offset);
+            mdelay(2);
+        }
+        if current & mask != value {
+            ostd::warn!("ath11k: PCIe link register {:#x} stays {:#x}", offset, current & mask);
+        }
+    }
+
+    /// `ath11k_pci_fix_l1ss`.
+    fn fix_l1ss(&self) {
+        let base = self.hw.regs.pcie_pcs_osc_dtct_config_base;
+        self.set_link_reg(self.hw.regs.pcie_qserdes_sysclk_en_sel, PCIE_QSERDES_COM_SYSCLK_EN_SEL_VAL, PCIE_QSERDES_COM_SYSCLK_EN_SEL_MSK);
+        self.set_link_reg(base, PCIE_PCS_OSC_DTCT_CONFIG1_VAL, PCIE_PCS_OSC_DTCT_CONFIG_MSK);
+        self.set_link_reg(base + 4, PCIE_PCS_OSC_DTCT_CONFIG2_VAL, PCIE_PCS_OSC_DTCT_CONFIG_MSK);
+        self.set_link_reg(base + 0xc, PCIE_PCS_OSC_DTCT_CONFIG4_VAL, PCIE_PCS_OSC_DTCT_CONFIG_MSK);
+    }
+
+    fn enable_ltssm(&self) {
+        let mut value = self.read32(PCIE_PCIE_PARF_LTSSM);
+        for _ in 0..5 {
+            if value == PARM_LTSSM_VALUE {
+                break;
+            }
+            if value == u32::MAX {
+                mdelay(5);
+            }
+            self.write32(PCIE_PCIE_PARF_LTSSM, PARM_LTSSM_VALUE);
+            value = self.read32(PCIE_PCIE_PARF_LTSSM);
+        }
+        let reset = self.read32(GCC_GCC_PCIE_HOT_RST) | GCC_GCC_PCIE_HOT_RST_VAL;
+        self.write32(GCC_GCC_PCIE_HOT_RST, reset);
+        self.read32(GCC_GCC_PCIE_HOT_RST);
+        mdelay(5);
+    }
+
+    /// `ath11k_pci_sw_reset`, at power-on.
+    pub(crate) fn sw_reset(&self) {
+        mdelay(100);
+        self.enable_ltssm();
+        // A hot reset leaves interrupts the bootloader would take.
+        self.write32(PCIE_PCIE_INT_ALL_CLEAR, PCIE_INT_CLEAR_ALL);
+        let power = self.read32(WLAON_QFPROM_PWR_CTRL_REG) & !QFPROM_PWR_CTRL_VDD4BLOW_MASK;
+        self.write32(WLAON_QFPROM_PWR_CTRL_REG, power);
+        if self.hw.fix_l1ss {
+            self.fix_l1ss();
+        }
+        // `ath11k_mhi_clear_vector`.
+        for offset in [PCIE_TXVECDB, PCIE_TXVECSTATUS, PCIE_RXVECDB, PCIE_RXVECSTATUS] {
+            self.write32(offset, 0);
+        }
+        self.clear_dbg_registers();
+        self.soc_global_reset();
+        // `ath11k_mhi_set_mhictrl_reset`: a system error left set clears.
+        self.read32(MHISTATUS);
+        self.write32(MHICTRL, MHICTRL_RESET);
+        mdelay(10);
+    }
+
+    /// `ath11k_pci_aspm_disable`: ASPM off while the firmware loads (the
+    /// AMSS state change fails with it, and Linux keeps it off with one
+    /// MSI vector).
+    pub(crate) fn aspm_disable(&self) {
+        if let Some(cap) = pci::find_capability(&self.location, pci::PCI_CAP_ID_EXP) {
+            let control = self.location.read16(cap + PCI_EXP_LNKCTL);
+            self.location.write16(cap + PCI_EXP_LNKCTL, control & !0x3);
+        }
+    }
+
+    /// MHI's registers are BAR 0's own, below the window.
+    pub(crate) fn mhi_read(&self, offset: u32) -> u32 {
+        self.mem.ioread32(offset as usize)
+    }
+
+    pub(crate) fn mhi_write(&self, offset: u32, value: u32) {
+        self.mem.iowrite32(offset as usize, value);
+    }
+}
diff --git a/kernel/comps/ath11k/src/qrtr.rs b/kernel/comps/ath11k/src/qrtr.rs
new file mode 100644
index 0000000..61c4885
--- /dev/null
+++ b/kernel/comps/ath11k/src/qrtr.rs
@@ -0,0 +1,226 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! QRTR (Qualcomm's IPC router) over the MHI IPCR channels, and QMI, the
+//! request/response/indication messages carried in its data packets, as
+//! far as a client of one service needs them: the router's hello, the
+//! remote's server announcements, data to and from one port, the
+//! receiver's flow-control answer; QMI's 7-byte header and TLVs.
+//!
+//! This is this kernel's own implementation of the protocols; the packet
+//! header (version 1), control commands and QMI framing are the
+//! interface's.
+
+use alloc::{collections::BTreeMap, vec::Vec};
+
+use crate::{mhi::Mhi, pci::Bus};
+
+// ---- QRTR. ----
+const VERSION_1: u32 = 1;
+const HEADER: usize = 32;
+const TYPE_DATA: u32 = 1;
+const TYPE_HELLO: u32 = 2;
+const TYPE_BYE: u32 = 3;
+const TYPE_NEW_SERVER: u32 = 4;
+const TYPE_DEL_SERVER: u32 = 5;
+const TYPE_RESUME_TX: u32 = 7;
+const PORT_CTRL: u32 = 0xffff_fffe;
+const NODE_BCAST: u32 = 0xffff_ffff;
+/// This host's node and the port its one client uses.
+const LOCAL_NODE: u32 = 1;
+const CLIENT_PORT: u32 = 0x4000;
+
+// ---- QMI. ----
+pub(crate) const QMI_REQUEST: u8 = 0;
+pub(crate) const QMI_RESPONSE: u8 = 2;
+pub(crate) const QMI_INDICATION: u8 = 4;
+const QMI_HEADER: usize = 7;
+/// The response TLV every answer carries: result and error.
+const TLV_RESULT: u8 = 0x02;
+
+/// A QMI message received.
+#[derive(Debug)]
+pub(crate) struct QmiMessage {
+    pub(crate) kind: u8,
+    pub(crate) txn: u16,
+    pub(crate) id: u16,
+    pub(crate) tlvs: BTreeMap<u8, Vec<u8>>,
+}
+
+impl QmiMessage {
+    /// Whether the answer says success (`QMI_RESULT_SUCCESS_V01`), and the
+    /// error code otherwise.
+    pub(crate) fn result(&self) -> Result<(), u16> {
+        match self.tlvs.get(&TLV_RESULT) {
+            Some(value) if value.len() >= 4 => {
+                let result = u16::from_le_bytes([value[0], value[1]]);
+                let error = u16::from_le_bytes([value[2], value[3]]);
+                if result == 0 { Ok(()) } else { Err(error) }
+            }
+            _ => Err(u16::MAX),
+        }
+    }
+
+    pub(crate) fn u32(&self, tlv: u8) -> Option<u32> {
+        let value = self.tlvs.get(&tlv)?;
+        Some(u32::from_le_bytes(value.get(..4)?.try_into().ok()?))
+    }
+}
+
+/// A QMI request or response's TLVs, in the order written.
+#[derive(Default)]
+pub(crate) struct Tlvs(Vec<u8>);
+
+impl Tlvs {
+    pub(crate) fn new() -> Self {
+        Self(Vec::new())
+    }
+
+    pub(crate) fn bytes(&mut self, tlv: u8, value: &[u8]) -> &mut Self {
+        self.0.push(tlv);
+        self.0.extend_from_slice(&(value.len() as u16).to_le_bytes());
+        self.0.extend_from_slice(value);
+        self
+    }
+
+    pub(crate) fn u8(&mut self, tlv: u8, value: u8) -> &mut Self {
+        self.bytes(tlv, &[value])
+    }
+
+    pub(crate) fn u32(&mut self, tlv: u8, value: u32) -> &mut Self {
+        self.bytes(tlv, &value.to_le_bytes())
+    }
+
+    pub(crate) fn u64(&mut self, tlv: u8, value: u64) -> &mut Self {
+        self.bytes(tlv, &value.to_le_bytes())
+    }
+}
+
+/// The router on this host and the one service's client.
+pub(crate) struct Qrtr {
+    remote_node: u32,
+    hello_sent: bool,
+    /// The service looked for: its id and instance (version | instance
+    /// << 8, as servers announce it).
+    service: u32,
+    instance: u32,
+    /// Where it runs, once announced.
+    pub(crate) server: Option<(u32, u32)>,
+    txn: u16,
+    pub(crate) gone: bool,
+}
+
+impl Qrtr {
+    pub(crate) fn new(service: u32, version: u32, instance: u32) -> Self {
+        Self {
+            remote_node: NODE_BCAST,
+            hello_sent: false,
+            service,
+            instance: version | (instance << 8),
+            server: None,
+            txn: 0,
+            gone: false,
+        }
+    }
+
+    fn packet(kind: u32, src: (u32, u32), dst: (u32, u32), payload: &[u8]) -> Vec<u8> {
+        let mut packet = Vec::with_capacity(HEADER + payload.len().next_multiple_of(4));
+        for word in [VERSION_1, kind, src.0, src.1, 0, payload.len() as u32, dst.0, dst.1] {
+            packet.extend_from_slice(&word.to_le_bytes());
+        }
+        packet.extend_from_slice(payload);
+        packet.resize(HEADER + payload.len().next_multiple_of(4), 0);
+        packet
+    }
+
+    /// The router's hello to the remote one: it answers with its own and
+    /// announces its servers.
+    pub(crate) fn hello(&mut self, bus: &Bus, mhi: &mut Mhi) -> Result<(), ()> {
+        let packet = Self::packet(TYPE_HELLO, (LOCAL_NODE, PORT_CTRL), (self.remote_node, PORT_CTRL), &TYPE_HELLO.to_le_bytes());
+        mhi.send(bus, &packet)?;
+        self.hello_sent = true;
+        Ok(())
+    }
+
+    /// A QMI request to the server; its transaction number.
+    pub(crate) fn request(&mut self, bus: &Bus, mhi: &mut Mhi, id: u16, tlvs: &Tlvs) -> Result<u16, ()> {
+        let Some(server) = self.server else { return Err(()) };
+        self.txn = self.txn.wrapping_add(1).max(1);
+        let mut message = Vec::with_capacity(QMI_HEADER + tlvs.0.len());
+        message.push(QMI_REQUEST);
+        message.extend_from_slice(&self.txn.to_le_bytes());
+        message.extend_from_slice(&id.to_le_bytes());
+        message.extend_from_slice(&(tlvs.0.len() as u16).to_le_bytes());
+        message.extend_from_slice(&tlvs.0);
+        let packet = Self::packet(TYPE_DATA, (LOCAL_NODE, CLIENT_PORT), server, &message);
+        mhi.send(bus, &packet)?;
+        Ok(self.txn)
+    }
+
+    /// A packet from the remote router: control handled here, a QMI
+    /// message for the client returned.
+    pub(crate) fn receive(&mut self, bus: &Bus, mhi: &mut Mhi, packet: &[u8]) -> Option<QmiMessage> {
+        if packet.len() < HEADER {
+            return None;
+        }
+        let word = |at: usize| u32::from_le_bytes(packet[at..at + 4].try_into().unwrap());
+        if word(0) != VERSION_1 {
+            return None;
+        }
+        let (kind, src_node, src_port, confirm, size) = (word(4), word(8), word(12), word(16), word(20) as usize);
+        let payload = packet.get(HEADER..HEADER + size)?;
+        let ctrl = |at: usize| payload.get(at..at + 4).map(|b| u32::from_le_bytes(b.try_into().unwrap()));
+        match kind {
+            TYPE_HELLO => {
+                self.remote_node = src_node;
+                if !self.hello_sent {
+                    let _ = self.hello(bus, mhi);
+                }
+                None
+            }
+            TYPE_NEW_SERVER => {
+                let (service, instance, node, port) = (ctrl(4)?, ctrl(8)?, ctrl(12)?, ctrl(16)?);
+                if service == self.service && instance == self.instance {
+                    self.server = Some((node, port));
+                }
+                None
+            }
+            TYPE_DEL_SERVER | TYPE_BYE => {
+                if kind == TYPE_BYE || self.server.is_some_and(|(node, port)| Some(node) == ctrl(12) && Some(port) == ctrl(16)) {
+                    self.server = None;
+                    self.gone = true;
+                }
+                None
+            }
+            TYPE_DATA => {
+                if confirm != 0 {
+                    // The sender waits for word that its packets were taken.
+                    let mut resume = Vec::with_capacity(12);
+                    for value in [TYPE_RESUME_TX, LOCAL_NODE, CLIENT_PORT] {
+                        resume.extend_from_slice(&value.to_le_bytes());
+                    }
+                    let answer = Self::packet(TYPE_RESUME_TX, (LOCAL_NODE, CLIENT_PORT), (src_node, src_port), &resume);
+                    let _ = mhi.send(bus, &answer);
+                }
+                if word(28) != CLIENT_PORT || payload.len() < QMI_HEADER {
+                    return None;
+                }
+                let len = u16::from_le_bytes([payload[5], payload[6]]) as usize;
+                let mut tlvs = BTreeMap::new();
+                let mut body = payload.get(QMI_HEADER..QMI_HEADER + len)?;
+                while body.len() >= 3 {
+                    let (tlv, length) = (body[0], u16::from_le_bytes([body[1], body[2]]) as usize);
+                    let value = body.get(3..3 + length)?;
+                    tlvs.insert(tlv, value.to_vec());
+                    body = &body[3 + length..];
+                }
+                Some(QmiMessage {
+                    kind: payload[0],
+                    txn: u16::from_le_bytes([payload[1], payload[2]]),
+                    id: u16::from_le_bytes([payload[3], payload[4]]),
+                    tlvs,
+                })
+            }
+            _ => None,
+        }
+    }
+}
