+/// The services a SERVICE_READY's bitmap (bits below 128) and the
+/// SERVICE_AVAILABLE events' segments (the rest) name.
+#[derive(Default)]
+pub(crate) struct Services(BTreeSet<u32>);
+
+impl Services {
+    pub(crate) fn add_words(&mut self, first: u32, words: &[u8]) {
+        for (index, chunk) in words.chunks_exact(4).enumerate() {
+            let value = u32::from_le_bytes([chunk[0], chunk[1], chunk[2], chunk[3]]);
+            for bit in 0..32 {
+                if value & (1 << bit) != 0 {
+                    self.0.insert(first + index as u32 * 32 + bit);
+                }
+            }
+        }
+    }
+
+    pub(crate) fn has(&self, service: u32) -> bool {
+        self.0.contains(&service)
+    }
+}
+
+/// `ath11k_wmi_tlv_iter` over an array's TLVs (an ARRAY_STRUCT's).
+pub(crate) fn nested(value: &[u8]) -> Vec<(u32, &[u8])> {
+    let mut out = Vec::new();
+    let mut rest = value;
+    while rest.len() >= 4 {
+        let word = u32::from_le_bytes([rest[0], rest[1], rest[2], rest[3]]);
+        let (tag, len) = (word >> 16, (word & 0xffff) as usize);
+        let Some(item) = rest.get(4..4 + len) else { break };
+        out.push((tag, item));
+        rest = &rest[(4 + len).next_multiple_of(4).min(rest.len())..];
+    }
+    out
+}
