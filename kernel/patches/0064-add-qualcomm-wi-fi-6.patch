+        static_window_map: false,
+        wmi_diag_event: true,
+        rx_desc: RxDesc::Wcn6855,
+        bdf_bus_and_board: true,
+        supports_sta_ps: true,
+        mhi_max_channels: MHI_QCA6390.0,
+        mhi_elements: MHI_QCA6390.1,
+        rx_buf_rbm: HAL_RX_BUF_RBM_SW1_BM,
+    }
+}
+
+pub(crate) static WCN6855_HW20: HwParams = wcn6855("WCN6855 hw2.0", "WCN6855/hw2.0");
+pub(crate) static WCN6855_HW21: HwParams = wcn6855("WCN6855 hw2.1", "WCN6855/hw2.1");
+pub(crate) static QCA2066_HW21: HwParams = wcn6855("QCA2066 hw2.1", "QCA2066/hw2.1");
