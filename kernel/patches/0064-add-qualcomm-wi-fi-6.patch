+/// `ath11k_wmi_mgmt_send`: a management frame by its DMA address, its
+/// first bytes copied in the command.
+pub(crate) fn mgmt_send(vdev_id: u32, desc_id: u32, paddr: u64, frame: &[u8]) -> Cmd {
+    let mut cmd = Cmd::new(WMI_MGMT_TX_SEND_CMDID);
+    let buf_len = frame.len().min(WMI_MGMT_SEND_DOWNLD_LEN as usize);
+    cmd.tlv(WMI_TAG_MGMT_TX_SEND_CMD, &[vdev_id, desc_id, 0, paddr as u32, (paddr >> 32) as u32, frame.len() as u32, buf_len as u32, 0]);
+    cmd.bytes(WMI_TAG_ARRAY_BYTE, &frame[..buf_len]);
+    cmd
+}
+
+/// `ath11k_wmi_send_wmm_update_cmd_tlv`: the four access classes' EDCA
+/// parameters (BE, BK, VI, VO): cwmin, cwmax, aifs, txop.
+pub(crate) fn wmm_params(vdev_id: u32, params: &[[u32; 4]; 4]) -> Cmd {
+    let mut words = vec![vdev_id];
+    for [cwmin, cwmax, aifs, txop] in params {
+        // Each record carries the command's own tag, as Linux writes it.
+        words.push(header(WMI_TAG_VDEV_SET_WMM_PARAMS_CMD, 24));
+        words.extend_from_slice(&[*cwmin, *cwmax, *aifs, *txop, 0, 0]);
+    }
+    words.push(0);
+    let mut cmd = Cmd::new(WMI_VDEV_SET_WMM_PARAMS_CMDID);
+    cmd.tlv(WMI_TAG_VDEV_SET_WMM_PARAMS_CMD, &words);
+    cmd
+}
