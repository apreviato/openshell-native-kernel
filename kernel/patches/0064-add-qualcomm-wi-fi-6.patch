+/// What `ath11k_wmi_send_peer_assoc_cmd` needs of the access point.
+#[derive(Clone, Debug, Default)]
+pub(crate) struct PeerAssoc {
+    pub(crate) address: [u8; 6],
+    pub(crate) aid: u32,
+    pub(crate) flags: u32,
+    pub(crate) caps: u32,
+    pub(crate) listen_interval: u32,
+    pub(crate) ht_caps: u32,
+    pub(crate) max_mpdu: u32,
+    pub(crate) mpdu_density: u32,
+    pub(crate) rate_caps: u32,
+    pub(crate) nss: u32,
+    pub(crate) vht_caps: u32,
+    pub(crate) phymode: u32,
+    pub(crate) legacy_rates: Vec<u8>,
+    pub(crate) ht_rates: Vec<u8>,
+    /// The access point's VHT rates: (highest, map) to it and from it.
+    pub(crate) vht_rx: (u32, u32),
+    pub(crate) vht_tx: (u32, u32),
+    pub(crate) bw_rxnss_override: u32,
+    /// Its HE MAC capabilities (two words), PHY ones (three), operation
+    /// parameters, PPE thresholds (`struct wmi_ppe_threshold`).
+    pub(crate) he_mac: [u32; 2],
+    pub(crate) he_phy: [u32; 3],
+    pub(crate) he_ops: u32,
+    pub(crate) ppet: [u32; 10],
+    /// The HE rate sets (80, 160, 80+80 MHz): to it, from it.
+    pub(crate) he_mcs: Vec<(u32, u32)>,
+    /// Its HE 6 GHz band capabilities (on 6 GHz).
+    pub(crate) he_6ghz: u32,
+}
+
+/// `ath11k_wmi_send_peer_assoc_cmd` (the firmware reads the VHT set's
+/// "tx" as the peer's receive set: Linux swaps them).
+pub(crate) fn peer_assoc(vdev_id: u32, assoc: &PeerAssoc) -> Cmd {
+    let [w0, w1] = mac(&assoc.address);
+    let mut words = vec![
+        w0,
+        w1,
+        vdev_id,
+        1,
+        assoc.aid,
+        assoc.flags,
+        assoc.caps,
+        assoc.listen_interval,
+        assoc.ht_caps,
+        assoc.max_mpdu,
+        assoc.mpdu_density,
+        assoc.rate_caps,
+        assoc.nss,
+        assoc.vht_caps,
+        assoc.phymode,
+        0,
+        0,
+        assoc.legacy_rates.len() as u32,
+        assoc.ht_rates.len() as u32,
+        assoc.bw_rxnss_override,
+    ];
+    words.extend_from_slice(&assoc.ppet);
+    words.push(assoc.he_mac[0]);
+    words.push(assoc.he_ops);
+    words.extend_from_slice(&assoc.he_phy);
+    words.push(assoc.he_mcs.len() as u32);
+    // The extended MAC capabilities, the internal ones, the lowest data
+    // rate, the 6 GHz capabilities.
+    words.extend_from_slice(&[assoc.he_mac[1], 0, 0, assoc.he_6ghz]);
+    let mut cmd = Cmd::new(WMI_PEER_ASSOC_CMDID);
+    cmd.tlv(WMI_TAG_PEER_ASSOC_COMPLETE_CMD, &words);
+    cmd.bytes(WMI_TAG_ARRAY_BYTE, &assoc.legacy_rates);
+    cmd.bytes(WMI_TAG_ARRAY_BYTE, &assoc.ht_rates);
+    cmd.tlv(WMI_TAG_VHT_RATE_SET, &[assoc.vht_tx.0, assoc.vht_tx.1, assoc.vht_rx.0, assoc.vht_rx.1, 0]);
+    let he: Vec<(u32, Vec<u32>)> = assoc.he_mcs.iter().map(|(rx, tx)| (WMI_TAG_HE_RATE_SET, vec![*rx, *tx])).collect();
+    cmd.array_struct(&he);
+    cmd
+}
+
+/// `ath11k_wmi_vdev_install_key` (TKIP's: its two 8-byte MIC keys after
+/// the key).
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn install_key(vdev_id: u32, address: &[u8; 6], index: u32, flags: u32, cipher: u32, key: &[u8], rsc: u64, mic: bool) -> Cmd {
+    let [w0, w1] = mac(address);
+    let mut words = vec![vdev_id, w0, w1, index, flags, cipher];
+    // `struct wmi_key_seq_counter` ×3: low and high words.
+    words.extend_from_slice(&[rsc as u32, (rsc >> 32) as u32, 0, 0, 0, 0]);
+    // The WPI counters.
+    words.extend_from_slice(&[0; 8]);
+    let mic_len = if mic { 8 } else { 0 };
+    words.extend_from_slice(&[key.len() as u32, mic_len, mic_len, 0, 0]);
+    let mut cmd = Cmd::new(WMI_VDEV_INSTALL_KEY_CMDID);
+    cmd.tlv(WMI_TAG_VDEV_INSTALL_KEY_CMD, &words);
+    cmd.bytes(WMI_TAG_ARRAY_BYTE, key);
+    cmd
+}
+
+/// `ath11k_wmi_send_scan_start_cmd` with `ath11k_wmi_start_scan_init`'s
+/// values: one BSSID, the broadcast one (or the probe requests carry a
+/// zero one); passive when no name is asked for.
+pub(crate) fn scan_start(vdev_id: u32, scan_id: u32, freqs: &[u32], ssids: &[Vec<u8>], ie: &[u8], filter_probe_requests: bool) -> Cmd {
+    let mut flags = WMI_SCAN_CHAN_STAT_EVENT;
+    if ssids.is_empty() {
+        flags |= WMI_SCAN_FLAG_PASSIVE;
+    }
+    if filter_probe_requests {
+        flags |= WMI_SCAN_FILTER_PROBE_REQ;
+    }
+    let events = WMI_SCAN_EVENT_STARTED | WMI_SCAN_EVENT_COMPLETED | WMI_SCAN_EVENT_BSS_CHANNEL | WMI_SCAN_EVENT_FOREIGN_CHAN | WMI_SCAN_EVENT_DEQUEUED;
+    let ssids = &ssids[..ssids.len().min(WLAN_SCAN_PARAMS_MAX_SSID as usize)];
+    let mut words = vec![
+        scan_id,
+        WMI_HOST_SCAN_REQ_ID_PREFIX | 1,
+        vdev_id,
+        WMI_SCAN_PRIORITY_LOW,
+        events,
+        50,  // dwell time active
+        150, // dwell time passive
+        50,  // min rest time
+        500, // max rest time
+        0,   // repeat probe time
+        0,   // probe spacing
+        0,   // idle time
+        20_000,
+        5, // probe delay
+        flags,
+        0, // burst duration
+        freqs.len() as u32,
+        1,
+        ssids.len() as u32,
+        ie.len() as u32,
+        0, // n_probes
+        0,
+        0,
+        0,
+        0,
+    ];
+    words.extend_from_slice(&[0; WMI_IE_BITMAP_SIZE as usize]);
+    // Vendor OUIs, extended flags, the 2 GHz active dwell time (the
+    // general one), the 6 GHz active and passive ones, the start offset.
+    words.extend_from_slice(&[0, 0, 0, 40, 30, 0]);
+    let mut cmd = Cmd::new(WMI_START_SCAN_CMDID);
+    cmd.tlv(WMI_TAG_START_SCAN_CMD, &words);
+    cmd.array_u32(freqs);
+    // `struct wmi_ssid` each: length and 32 bytes.
+    let mut ssid_bytes = Vec::new();
+    for ssid in ssids {
+        let len = ssid.len().min(32);
+        ssid_bytes.extend_from_slice(&(len as u32).to_le_bytes());
+        let mut bytes = [0u8; 32];
+        bytes[..len].copy_from_slice(&ssid[..len]);
+        ssid_bytes.extend_from_slice(&bytes);
+    }
+    cmd.bytes(WMI_TAG_ARRAY_FIXED_STRUCT, &ssid_bytes);
+    // `struct wmi_mac_addr`: the broadcast address.
+    cmd.bytes(WMI_TAG_ARRAY_FIXED_STRUCT, &[0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0, 0]);
+    cmd.bytes(WMI_TAG_ARRAY_BYTE, ie);
+    cmd
+}
