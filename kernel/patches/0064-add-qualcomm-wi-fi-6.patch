+    pub(crate) static_window_map: bool,
+    pub(crate) wmi_diag_event: bool,
+    pub(crate) rx_desc: RxDesc,
+    /// The board file is looked up by the PCI ids too (WCN6855).
+    pub(crate) bdf_bus_and_board: bool,
+    /// The firmware runs a station's power save (`supports_sta_ps`).
+    pub(crate) supports_sta_ps: bool,
+    pub(crate) mhi_max_channels: usize,
+    pub(crate) mhi_elements: usize,
+    /// The TCL rings' return buffer manager for frames sent
+    /// (`hal_params->rx_buf_rbm` and the TCL→WBM map).
+    pub(crate) rx_buf_rbm: u32,
+}
+
+const MHI_QCA6390: (usize, usize) = (128, 64);
+const MHI_QCN9074: (usize, usize) = (30, 32);
+
+pub(crate) static QCA6390_HW20: HwParams = HwParams {
