+// SPDX-License-Identifier: MPL-2.0
+
+//! The interface, as Linux's ath11k `core.c` brings the firmware up
+//! (`ath11k_core_start`: HTC, HTT and WMI connected, WMI's service ready
+//! and INIT, the data path's rings given to the firmware) and `mac.c` runs
+//! mac80211's requests: one vdev, a station's or an access point's; scans
+//! by the firmware; the peers (the access point, or the stations that
+//! joined this one) with their reorder queues, rates and capabilities
+//! (HT, VHT, HE, up to 160 MHz); the access point's beacon as the
+//! firmware's template; keys in the firmware; management frames over WMI;
+//! data over the data path as native Wi-Fi frames (the chip encrypts and
+//! decrypts).
+
+use alloc::{collections::BTreeMap, format, string::String, sync::Arc, vec, vec::Vec};
+
+use aster_linuxkpi::dma::alloc_coherent32;
+use aster_wlan::{
+    Device,
+    chan as wchan,
+    ieee80211::{self as wifi, Address, Elements},
+    radio::{
+        self, ApConfig, Association, Band, BandId, BeaconTemplate, BlockAck, Channel, Chandef, HeCap, HtCap, Info, Join, Key, LinkStats, Peer, Reorder, RxInfo, ScanRequest, StationEntry, VhtCap, Width,
+    },
+};
+use ostd::mm::{HasDaddr, VmIo, dma::DmaCoherent};
+
+use crate::{
+    WAKER,
+    ce::Ce,
+    dp::{Dp, HttEvent, PeerMap, Received},
+    hal::{Hal, field, get},
+    htc::Htc,
+    hw::HwParams,
+    mhi::Mhi,
+    now_ms,
+    pci::Bus,
+    regs::*,
+    wlfw::Wlfw,
+    wmi::{self, Cmd, Event, Services, nested, word},
+};
+
+/// The quiet before the firmware dozes under power save (mac80211's
+/// dynamic power save time-out), in milliseconds.
+const PS_INACTIVITY_MS: u32 = 100;
+
+const VDEV: u32 = 0;
+/// How long the firmware gets for an answer.
+const WAIT_MS: u64 = 3000;
+/// How long a scan may run before it is taken for ended.
+const SCAN_TIMEOUT_MS: u64 = 30_000;
+/// `ATH11K_SCAN_ID`.
+const SCAN_ID: u32 = 0xa000;
+/// `ATH11K_DEFAULT_NOISE_FLOOR`.
+const NOISE_FLOOR: i32 = -95;
+/// `ATH11K_MAX_HW_LISTEN_INTERVAL`, what mac80211 gives the peer.
+const LISTEN_INTERVAL: u32 = 5;
+/// Management frames waiting for their completion.
+const MGMT_PENDING: usize = 16;
+const WPA_OUI_TYPE: [u8; 4] = [0x00, 0x50, 0xf2, 0x01];
+const CCK_RATES: [u8; 4] = [2, 4, 11, 22];
+/// 802.11's HT capability bits this driver sets or reads.
+const HT_CAP_SM_PS_DISABLED: u16 = 3 << 2;
+const HT_CAP_SGI_20: u16 = 1 << 5;
+const HT_CAP_SGI_40: u16 = 1 << 6;
+const HT_CAP_TX_STBC: u16 = 1 << 7;
+const HT_CAP_RX_STBC_SHIFT: u16 = 8;
+const HT_CAP_RX_STBC: u16 = 3 << HT_CAP_RX_STBC_SHIFT;
+const HT_CAP_LSIG_TXOP: u16 = 1 << 15;
+/// `IEEE80211_HT_MAX_AMPDU_FACTOR`, `IEEE80211_HE_VHT_MAX_AMPDU_FACTOR`,
+/// `IEEE80211_HE_HT_MAX_AMPDU_FACTOR`.
+const HT_AMPDU_FACTOR: u32 = 13;
+const HE_VHT_AMPDU_FACTOR: u32 = 20;
+const HE_HT_AMPDU_FACTOR: u32 = 16;
+/// `IEEE80211_HE_6GHZ_MAX_AMPDU_FACTOR`.
+const HE_6GHZ_AMPDU_FACTOR: u32 = 13;
+/// 802.11's VHT capability fields.
+const VHT_CAP_AMPDU_EXP_SHIFT: u32 = 23;
+const VHT_CAP_AMPDU_EXP_MASK: u32 = 7 << VHT_CAP_AMPDU_EXP_SHIFT;
+const VHT_CAP_SU_BEAMFORMER: u32 = 1 << 11;
+const VHT_CAP_SU_BEAMFORMEE: u32 = 1 << 12;
+const VHT_CAP_SOUNDING_SHIFT: u32 = 16;
+const VHT_CAP_SOUNDING_MASK: u32 = 7 << VHT_CAP_SOUNDING_SHIFT;
+const VHT_CAP_BEAMFORMEE_STS_SHIFT: u32 = 13;
+const VHT_CAP_BEAMFORMEE_STS_MASK: u32 = 7 << VHT_CAP_BEAMFORMEE_STS_SHIFT;
+const VHT_CAP_MU_BEAMFORMER: u32 = 1 << 19;
+const VHT_CAP_MU_BEAMFORMEE: u32 = 1 << 20;
+const VHT_CAP_SUPP_WIDTH_160: u32 = 1 << 2;
+const VHT_CAP_SUPP_WIDTH_160_80P80: u32 = 2 << 2;
+/// 802.11ax's capability bits (Linux's `ieee80211-he.h`).
+const HE_MAC0_TWT_REQ: u8 = 0x02;
+const HE_MAC0_TWT_RES: u8 = 0x04;
+const HE_MAC1_TF_MAC_PAD_DUR_MASK: u8 = 0x0c;
+const HE_MAC3_AMPDU_EXP_MASK: u8 = 0x18;
+const HE_PHY5_SND_DIM_UNDER_80_MASK: u8 = 0x07;
+const HE_PHY6_PPE_THRESHOLD_PRESENT: u8 = 0x80;
+const HE_PHY9_TX_1024_QAM_UNDER_242_RU: u8 = 0x04;
+/// The two-bit MCS-map values.
+const MCS_NONE: u16 = 3;
+const VHT_MCS_0_9: u16 = 2;
+const HE_MCS_0_11: u16 = 2;
+/// The HE operation's parameters (`he_oper_params`, little-endian): the
+/// BSS color's bits.
+const HE_OPERATION_BSS_COLOR_MASK: u32 = 0x3f00_0000;
+const HE_OPERATION_BSS_COLOR_DISABLED: u32 = 0x8000_0000;
+
+/// `ath11k_parse_mpdudensity`: 802.11's code in microseconds.
+fn mpdu_density(code: u8) -> u32 {
+    match code & 7 {
+        0 => 0,
+        1..=3 => 1,
+        4 => 2,
+        5 => 4,
+        6 => 8,
+        _ => 16,
+    }
+}
+
+fn mac_of(words: &[u8], at: usize) -> Address {
+    let mut address = [0u8; 6];
+    address.copy_from_slice(&words[at..at + 6]);
+    address
+}
+
+/// The streams an MCS map (two bits a stream) says are there.
+fn map_streams(map: u16) -> u32 {
+    (0..8).rev().find(|stream| (map >> (2 * stream)) & 3 != MCS_NONE).map_or(0, |stream| stream + 1)
+}
+
+/// A map with `streams` streams at `value` and the others absent.
+fn mcs_map(streams: u32, value: u16) -> u16 {
+    (0..8).fold(0, |map, stream| map | (if stream < streams { value } else { MCS_NONE }) << (2 * stream))
+}
+
+/// What the firmware said a band can do (`struct ath11k_band_cap`, from
+/// SERVICE_READY_EXT's MAC/PHY capabilities).
+#[derive(Clone, Copy, Debug, Default)]
+struct BandCaps {
+    present: bool,
+    ht_cap_info: u32,
+    he_mac: [u32; 2],
+    he_phy: [u32; 3],
+}
+
+/// The radio's capabilities (`struct ath11k_pdev_cap`).
+#[derive(Clone, Copy, Debug, Default)]
+struct Caps {
+    /// 2.4 GHz's; 5 GHz's (6 GHz's too: the same PHY).
+    bands: [BandCaps; 2],
+    /// The 6 GHz band (`ar->supports_6ghz`): the radio's range reaches
+    /// past 5925 MHz.
+    band_6: bool,
+    /// The ranges the PHYs tune to (`struct ath11k_hal_reg_capabilities_ext`):
+    /// 2.4 GHz's, 5 and 6 GHz's, `(low, high)` in MHz, zero for none told.
+    ranges: [(u32, u32); 2],
+    vht_cap: u32,
+    tx_chains: u32,
+    rx_chains: u32,
+    tx_chain_mask: u32,
+    rx_chain_mask: u32,
+    nss_ratio: Option<u32>,
+}
+
+/// A regulatory rule (`struct wmi_regulatory_rule_struct`).
+#[derive(Clone, Copy, Debug)]
+struct Rule {
+    start: u32,
+    end: u32,
+    power: u32,
+    flags: u32,
+}
+
+/// A scan: one band at a time, each with its probe requests' rates.
+struct Scan {
+    parts: Vec<(Vec<u32>, Vec<u8>)>,
+    ssids: Vec<Vec<u8>>,
+    running: bool,
+    aborted: bool,
+    deadline: u64,
+}
+
+/// The network being joined.
+struct Network {
+    join: Join,
+    peer: bool,
+    started: bool,
+    up: bool,
+}
+
+/// The network this radio runs as an access point, and what its beacon
+/// says of it.
+struct Ap {
+    config: ApConfig,
+    /// WMM: stations' frames carry their TID.
+    qos: bool,
+    he: bool,
+    /// The HE operation's parameters (`bss_conf.he_oper.params`).
+    he_ops: u32,
+    rsn: bool,
+    wpa: bool,
+    started: bool,
+    up: bool,
+    stations: BTreeMap<Address, ApStation>,
+    group_key: bool,
+}
+
+impl Ap {
+    fn new(config: &ApConfig) -> Self {
+        let mut ap = Self { config: config.clone(), qos: false, he: false, he_ops: 0, rsn: false, wpa: false, started: false, up: false, stations: BTreeMap::new(), group_key: false };
+        ap.read_beacon(&config.beacon);
+        ap
+    }
+
+    fn read_beacon(&mut self, beacon: &BeaconTemplate) {
+        let elements = beacon.elements();
+        let elements = Elements(&elements);
+        self.qos = elements.vendor(wifi::WMM_OUI_TYPE).is_some();
+        self.he = elements.extension(wifi::EXT_HE_CAP).is_some();
+        self.he_ops = he_ops_of(&elements);
+        self.rsn = elements.get(wifi::IE_RSN).is_some();
+        self.wpa = elements.vendor(WPA_OUI_TYPE).is_some();
+        self.config.beacon = beacon.clone();
+    }
+}
+
+/// A station that joined the access point.
+struct ApStation {
+    qos: bool,
+    /// Its pairwise key is in place.
+    key: bool,
+}
+
+/// `bss_conf.he_oper.params`: the first four bytes of the HE operation.
+fn he_ops_of(elements: &Elements<'_>) -> u32 {
+    elements.extension(wifi::EXT_HE_OPERATION).and_then(|value| value.get(..4)).map_or(0, |b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+}
+
+/// What `ath11k_peer_assoc_prepare` knows of a peer, as a station of its
+/// access point or as an access point of its station.
+struct PeerParams<'a> {
+    address: Address,
+    aid: u16,
+    capability: u16,
+    listen_interval: u32,
+    peer: &'a Peer,
+    chandef: Chandef,
+    he_ops: u32,
+    /// The network encrypts (WPA: group keys by their own handshake).
+    rsn: bool,
+    wpa: bool,
+}
+
+pub(crate) struct Ath11k {
+    pub(crate) bus: Bus,
+    pub(crate) mhi: Mhi,
+    pub(crate) wlfw: Wlfw,
+    pub(crate) hal: Hal,
+    ce: Ce,
+    htc: Htc,
+    dp: Dp,
+    hw: &'static HwParams,
+    pub(crate) name: String,
+    wmi_ep: usize,
+    htt_ep: usize,
+    services: Services,
+    service_ready: bool,
+    ext_ready: bool,
+    ext2_ready: bool,
+    ready: bool,
+    num_rf_chains: u32,
+    pdev_id: u32,
+    caps: Caps,
+    rules: Vec<Rule>,
+    htt_version: Option<(u32, u32)>,
+    pub(crate) address: Address,
+    pub(crate) device: Option<Arc<Device>>,
+    info: Option<Info>,
+    peers: Vec<PeerMap>,
+    vdev_response: Option<u32>,
+    vdev_stopped: bool,
+    vdev_deleted: bool,
+    /// The vdev is an access point's.
+    ap_vdev: bool,
+    ap: Option<Ap>,
+    peer_assoc_done: bool,
+    peer_deleted: bool,
+    key_status: Option<u32>,
+    network: Option<Network>,
+    associated: bool,
+    /// The network takes QoS data (WMM): frames carry their TID.
+    qos: bool,
+    /// The pairwise and group keys are in place.
+    keys: (bool, bool),
+    /// The MIC length of the pairwise key's cipher: CCMP's 8, GCMP's and
+    /// CCMP-256's 16.
+    pairwise_mic: usize,
+    scan: Option<Scan>,
+    scan_freq: u16,
+    mgmt: BTreeMap<u32, DmaCoherent>,
+    mgmt_next: u32,
+    sequence: u16,
+    signal: Option<i8>,
+    pub(crate) dead: bool,
+}
+
+impl Ath11k {
+    /// `ath11k_core_qmi_firmware_ready` and `ath11k_core_start` after QMI:
+    /// the copy engines, the data path, HTC and its services, WMI's
+    /// service ready and INIT, HTT's version, the radio's rings and
+    /// settings, the station's vdev.
+    pub(crate) fn start(bus: Bus, mut mhi: Mhi, wlfw: Wlfw, hal: Hal, name: String) -> Result<Self, String> {
+        let hw = bus.hw;
+        let ce = Ce::new(&hal, &bus).map_err(String::from)?;
+        let dp = Dp::new(hw, &hal, &bus).map_err(String::from)?;
+        let htc = Htc::new(&bus);
+        // The firmware's QMI answers keep flowing while it starts.
+        mhi.process(&bus);
+        let mut card = Self {
+            bus,
+            mhi,
+            wlfw,
+            hal,
+            ce,
+            htc,
+            dp,
+            hw,
+            name,
+            wmi_ep: 0,
+            htt_ep: 0,
+            services: Services::default(),
+            service_ready: false,
+            ext_ready: false,
+            ext2_ready: false,
+            ready: false,
+            num_rf_chains: 1,
+            pdev_id: 0,
+            caps: Caps::default(),
+            rules: Vec::new(),
+            htt_version: None,
+            address: [0; 6],
+            device: None,
+            info: None,
+            peers: Vec::new(),
+            vdev_response: None,
+            vdev_stopped: false,
+            vdev_deleted: false,
+            ap_vdev: false,
+            ap: None,
+            peer_assoc_done: false,
+            peer_deleted: false,
+            key_status: None,
+            network: None,
+            associated: false,
+            qos: false,
+            keys: (false, false),
+            pairwise_mic: 8,
+            scan: None,
+            scan_freq: 0,
+            mgmt: BTreeMap::new(),
+            mgmt_next: 0,
+            sequence: 0,
+            signal: None,
+            dead: false,
+        };
+        card.core_start()?;
+        Ok(card)
+    }
+
+    fn core_start(&mut self) -> Result<(), String> {
+        let Self { bus, hal, ce, htc, .. } = self;
+        htc.wait_target(bus, hal, ce)?;
+        let mut early = Vec::new();
+        self.htt_ep = self.htc.connect(&self.bus, &self.hal, &mut self.ce, ATH11K_HTC_SVC_ID_HTT_DATA_MSG, &mut |message| early.push(message))?;
+        self.wmi_ep = self.htc.connect(&self.bus, &self.hal, &mut self.ce, ATH11K_HTC_SVC_ID_WMI_CONTROL, &mut |message| early.push(message))?;
+        self.htc.start(&self.bus, &self.hal, &mut self.ce)?;
+        for message in early {
+            self.dispatch(message.endpoint, &message.payload);
+        }
+        // `ath11k_wmi_wait_for_service_ready`: SERVICE_READY, then its
+        // extensions when the firmware has them.
+        if !self.wait(WAIT_MS, |card| card.service_ready) {
+            return Err(String::from("no WMI service ready event"));
+        }
+        if self.services.has(WMI_TLV_SERVICE_EXT_MSG) && !self.wait(WAIT_MS, |card| card.ext_ready) {
+            return Err(String::from("no WMI service ready extension"));
+        }
+        if self.services.has(WMI_TLV_SERVICE_EXT2_MSG) && !self.wait(WAIT_MS, |card| card.ext2_ready) {
+            ostd::info!("{}: no second service ready extension; going on", self.name);
+        }
+        self.dp.reo_dst_setup(&self.hal, &self.bus).map_err(String::from)?;
+        self.wmi(wmi::init_cmd(self.hw, self.num_rf_chains)).map_err(String::from)?;
+        if !self.wait(WAIT_MS, |card| card.ready) {
+            return Err(String::from("no WMI ready event"));
+        }
+        // The QCA6390 family's two MACs run at once (DBS).
+        if self.hw.single_pdev_only && self.hw.num_rxdma_per_pdev > 1 {
+            self.wmi(wmi::set_hw_mode(WMI_HOST_HW_MODE_DBS)).map_err(String::from)?;
+        }
+        self.htt(&Dp::version_request())?;
+        if !self.wait(WAIT_MS, |card| card.htt_version.is_some()) {
+            return Err(String::from("no HTT version"));
+        }
+        if let Some((major, minor)) = self.htt_version
+            && major != HTT_TARGET_VERSION_MAJOR
+        {
+            return Err(format!("HTT {}.{} is not supported", major, minor));
+        }
+        // `ath11k_core_pdev_create`: the radio's rings.
+        for message in self.dp.pdev_setup(&self.hal, &self.bus).map_err(String::from)? {
+            self.htt(&message)?;
+        }
+        self.mac_start()?;
+        self.add_interface(false)?;
+        Ok(())
+    }
+
+    /// `ath11k_mac_op_start`: the radio's parameters and channels.
+    fn mac_start(&mut self) -> Result<(), String> {
+        let pdev = self.pdev_id;
+        for (param, value) in [
+            (WMI_PDEV_PARAM_PMF_QOS, 1),
+            (WMI_PDEV_PARAM_DYNAMIC_BW, 1),
+            (WMI_PDEV_PARAM_ARP_AC_OVERRIDE, 0),
+            (WMI_PDEV_PARAM_TX_CHAIN_MASK, self.caps.tx_chain_mask),
+            (WMI_PDEV_PARAM_RX_CHAIN_MASK, self.caps.rx_chain_mask),
+        ] {
+            if param == WMI_PDEV_PARAM_TX_CHAIN_MASK && value == 0 || param == WMI_PDEV_PARAM_RX_CHAIN_MASK && value == 0 {
+                continue;
+            }
+            self.wmi(wmi::pdev_set_param(pdev, param, value)).map_err(String::from)?;
+        }
+        let info = self.build_info();
+        // `ath11k_reg_update_chan_list`.
+        let channels: Vec<wmi::ChanListEntry> = info
+            .bands
+            .iter()
+            .flat_map(|band| {
+                let mode = if band.id == BandId::Ghz2 { MODE_11G } else { MODE_11A };
+                band.channels.iter().filter(|channel| !channel.disabled).map(move |channel| wmi::ChanListEntry {
+                    freq: channel.freq as u32,
+                    passive: channel.passive,
+                    dfs: channel.radar,
+                    mode,
+                    power: channel.max_power as u32,
+                    psc: wchan::is_psc(channel.freq),
+                })
+            })
+            .collect();
+        self.wmi(wmi::scan_chan_list(pdev, &channels)).map_err(String::from)?;
+        self.info = Some(info);
+        Ok(())
+    }
+
+    /// `ath11k_mac_op_add_interface`: the vdev and its streams; a
+    /// station's power-save parameters (power save off), or an access
+    /// point's own peer and when its stations count as gone
+    /// (`ath11k_mac_set_kickout`).
+    fn add_interface(&mut self, ap: bool) -> Result<(), String> {
+        let streams = self.caps.tx_chains.max(1);
+        let address = self.address;
+        let vdev_type = if ap { WMI_VDEV_TYPE_AP } else { WMI_VDEV_TYPE_STA };
+        self.wmi(wmi::vdev_create(VDEV, self.pdev_id, &address, vdev_type, streams)).map_err(String::from)?;
+        self.ap_vdev = ap;
+        self.wmi(wmi::vdev_set_param(VDEV, WMI_VDEV_PARAM_NSS, streams)).map_err(String::from)?;
+        if ap {
+            self.create_peer(address).map_err(|_| String::from("the firmware did not map the access point's own peer"))?;
+            self.wmi(wmi::pdev_set_param(self.pdev_id, WMI_PDEV_PARAM_STA_KICKOUT_TH, ATH11K_KICKOUT_THRESHOLD)).map_err(String::from)?;
+            for (param, value) in [
+                (WMI_VDEV_PARAM_AP_KEEPALIVE_MIN_IDLE_INACTIVE_TIME_SECS, ATH11K_KEEPALIVE_MIN_IDLE),
+                (WMI_VDEV_PARAM_AP_KEEPALIVE_MAX_IDLE_INACTIVE_TIME_SECS, ATH11K_KEEPALIVE_MAX_IDLE),
+                (WMI_VDEV_PARAM_AP_KEEPALIVE_MAX_UNRESPONSIVE_TIME_SECS, ATH11K_KEEPALIVE_MAX_UNRESPONSIVE),
+            ] {
+                self.wmi(wmi::vdev_set_param(VDEV, param, value)).map_err(String::from)?;
+            }
+        } else {
+            for (param, value) in [
+                (WMI_STA_PS_PARAM_RX_WAKE_POLICY, WMI_STA_PS_RX_WAKE_POLICY_WAKE),
+                (WMI_STA_PS_PARAM_TX_WAKE_THRESHOLD, WMI_STA_PS_TX_WAKE_THRESHOLD_ALWAYS),
+                (WMI_STA_PS_PARAM_PSPOLL_COUNT, WMI_STA_PS_PSPOLL_COUNT_NO_MAX),
+            ] {
+                self.wmi(wmi::sta_ps_param(VDEV, param, value)).map_err(String::from)?;
+            }
+            self.wmi(wmi::sta_powersave_mode(VDEV, WMI_STA_PS_MODE_DISABLED)).map_err(String::from)?;
+        }
+        self.dp.attach(VDEV, self.pdev_id, None, ap);
+        Ok(())
+    }
+
+    /// `ath11k_mac_op_remove_interface`: an access point's own peer gone,
+    /// then the vdev (`ath11k_mac_vdev_delete`).
+    fn remove_interface(&mut self) {
+        if self.ap_vdev {
+            let address = self.address;
+            self.delete_peer(address);
+        }
+        self.vdev_deleted = false;
+        if self.wmi(wmi::vdev_delete(VDEV)).is_ok() && !self.wait(WAIT_MS, |card| card.vdev_deleted) {
+            ostd::warn!("{}: no answer to the vdev's deletion", self.name);
+        }
+    }
+
+    /// The vdev made again as a station's or an access point's.
+    fn change_interface(&mut self, ap: bool) -> radio::Result<()> {
+        if self.ap_vdev == ap {
+            return Ok(());
+        }
+        self.remove_interface();
+        if let Err(why) = self.add_interface(ap) {
+            ostd::warn!("{}: {}", self.name, why);
+            // Back to a station, the way the radio started.
+            if ap {
+                self.remove_interface();
+                let _ = self.add_interface(false);
+            }
+            return Err(radio::Error::Failed);
+        }
+        Ok(())
+    }
+
+    // ---- Talking to the firmware. ----
+
+    /// A WMI command, waiting for room (credits) when there is none.
+    fn wmi(&mut self, cmd: Cmd) -> Result<(), &'static str> {
+        let deadline = now_ms() + WAIT_MS;
+        loop {
+            if self.htc.send(&self.bus, &self.hal, &mut self.ce, self.wmi_ep, &cmd.buf).is_ok() {
+                return Ok(());
+            }
+            if now_ms() >= deadline {
+                return Err("WMI's pipe stays full");
+            }
+            self.service();
+            WAKER.msleep(1);
+        }
+    }
+
+    fn htt(&mut self, message: &[u8]) -> Result<(), String> {
+        let deadline = now_ms() + WAIT_MS;
+        loop {
+            if self.htc.send(&self.bus, &self.hal, &mut self.ce, self.htt_ep, message).is_ok() {
+                return Ok(());
+            }
+            if now_ms() >= deadline {
+                return Err(String::from("HTT's pipe stays full"));
+            }
+            self.service();
+            WAKER.msleep(1);
+        }
+    }
+
+    /// Polls until `done` holds or `ms` pass.
+    fn wait(&mut self, ms: u64, done: impl Fn(&Self) -> bool) -> bool {
+        let deadline = now_ms() + ms;
+        loop {
+            self.service();
+            if done(self) {
+                return true;
+            }
+            if self.dead || now_ms() >= deadline {
+                return false;
+            }
+            WAKER.msleep(1);
+        }
+    }
+
+    /// Everything the chip has for the host: MHI's (QMI's indications,
+    /// answered as QRTR wants), HTC's messages, the data path's rings.
+    fn service(&mut self) {
+        self.mhi.process(&self.bus);
+        while let Some(packet) = self.mhi.received.pop_front() {
+            let _ = self.wlfw.qrtr.receive(&self.bus, &mut self.mhi, &packet);
+        }
+        if self.mhi.error && !self.dead {
+            self.died("the firmware stopped (MHI error)");
+            return;
+        }
+        for message in self.htc.poll(&self.bus, &self.hal, &mut self.ce) {
+            self.dispatch(message.endpoint, &message.payload);
+        }
+        for frame in self.dp.receive(&self.hal, &self.bus) {
+            self.deliver(frame);
+        }
+        self.dp.errors(&self.hal, &self.bus);
+        if self.dp.tx_completions(&self.hal, &self.bus)
+            && let Some(device) = &self.device
+        {
+            device.ready_to_send();
+        }
+    }
+
+    fn dispatch(&mut self, endpoint: usize, payload: &[u8]) {
+        if endpoint == self.wmi_ep && endpoint != 0 {
+            self.wmi_event(payload);
+        } else if endpoint == self.htt_ep && endpoint != 0 {
+            match Dp::htt_message(payload) {
+                Some(HttEvent::Version(major, minor)) => self.htt_version = Some((major, minor)),
+                Some(HttEvent::PeerMap(peer)) => {
+                    self.peers.retain(|known| known.address != peer.address);
+                    self.peers.push(peer);
+                }
+                Some(HttEvent::PeerUnmap(id)) => self.peers.retain(|known| known.peer_id != id),
+                None => {}
+            }
+        }
+    }
+
+    /// `ath11k_wmi_tlv_op_rx`.
+    fn wmi_event(&mut self, payload: &[u8]) {
+        let Some(event) = Event::parse(payload) else { return };
+        match event.id {
+            WMI_SERVICE_READY_EVENTID => {
+                if let Some(fixed) = event.get(WMI_TAG_SERVICE_READY_EVENT) {
+                    self.num_rf_chains = word(fixed, 9).max(1);
+                }
+                if let Some(bitmap) = event.get(WMI_TAG_ARRAY_UINT32) {
+                    self.services.add_words(0, bitmap);
+                }
+                self.service_ready = true;
+            }
+            WMI_SERVICE_AVAILABLE_EVENTID => {
+                if let Some(fixed) = event.get(WMI_TAG_SERVICE_AVAILABLE_EVENT) {
+                    self.services.add_words(word(fixed, 0), &fixed[4..]);
+                }
+            }
+            WMI_SERVICE_READY_EXT_EVENTID => {
+                self.service_ready_ext(&event);
+                self.ext_ready = true;
+            }
+            WMI_SERVICE_READY_EXT2_EVENTID => self.ext2_ready = true,
+            WMI_READY_EVENTID => {
+                if let Some(fixed) = event.get(WMI_TAG_READY_EVENT)
+                    && fixed.len() >= 32
+                {
+                    // `struct wmi_ready_event_min`: the ABI version, then the
+                    // address.
+                    self.address = mac_of(fixed, 24);
+                }
+                self.ready = true;
+            }
+            WMI_REG_CHAN_LIST_CC_EVENTID => self.regulatory(&event),
+            WMI_SCAN_EVENTID => {
+                if let Some(fixed) = event.get(WMI_TAG_SCAN_EVENT) {
+                    self.scan_event(word(fixed, 0), word(fixed, 1), word(fixed, 2));
+                }
+            }
+            WMI_MGMT_RX_EVENTID => {
+                if let (Some(header), Some(frame)) = (event.get(WMI_TAG_MGMT_RX_HDR), event.get(WMI_TAG_ARRAY_BYTE)) {
+                    self.management_rx(header, frame);
+                }
+            }
+            WMI_MGMT_TX_COMPLETION_EVENTID => {
+                if let Some(fixed) = event.get(WMI_TAG_MGMT_TX_COMPL_EVENT) {
+                    self.mgmt.remove(&word(fixed, 0));
+                }
+            }
+            WMI_VDEV_START_RESP_EVENTID => {
+                if let Some(fixed) = event.get(WMI_TAG_VDEV_START_RESPONSE_EVENT) {
+                    self.vdev_response = Some(word(fixed, 3));
+                }
+            }
+            WMI_VDEV_STOPPED_EVENTID => self.vdev_stopped = true,
+            WMI_VDEV_DELETE_RESP_EVENTID => self.vdev_deleted = true,
+            WMI_PEER_ASSOC_CONF_EVENTID => self.peer_assoc_done = true,
+            WMI_PEER_DELETE_RESP_EVENTID => self.peer_deleted = true,
+            WMI_VDEV_INSTALL_KEY_COMPLETE_EVENTID => {
+                if let Some(fixed) = event.get(WMI_TAG_VDEV_INSTALL_KEY_COMPLETE_EVENT) {
+                    self.key_status = Some(word(fixed, 5));
+                }
+            }
+            WMI_PEER_STA_KICKOUT_EVENTID => {
+                if let Some(fixed) = event.get(WMI_TAG_PEER_STA_KICKOUT_EVENT)
+                    && fixed.len() >= 6
+                    && self.network.as_ref().is_some_and(|network| network.join.bssid == mac_of(fixed, 0))
+                {
+                    self.lost("the firmware lost the access point");
+                }
+            }
+            WMI_ROAM_EVENTID => {
+                if let Some(fixed) = event.get(WMI_TAG_ROAM_EVENT)
+                    && word(fixed, 1) == WMI_ROAM_REASON_BEACON_MISS
+                {
+                    self.lost("beacons from the access point stopped");
+                }
+            }
+            _ => {}
+        }
+    }
+
+    /// `ath11k_wmi_tlv_svc_rdy_ext_parse`: the preferred hardware mode's
+    /// MAC/PHY capabilities, all in one radio (the QCA6390 family's single
+    /// pdev) or the first.
+    fn service_ready_ext(&mut self, event: &Event) {
+        const PRIORITY: [u32; 6] = [5, 1, 4, 3, 0, 2];
+        let modes: Vec<(u32, u32)> = event
+            .nth(WMI_TAG_ARRAY_STRUCT, 0)
+            .map(|value| nested(value).into_iter().filter(|(tag, _)| *tag == WMI_TAG_HW_MODE_CAPABILITIES).map(|(_, value)| (word(value, 0), word(value, 1))).collect())
+            .unwrap_or_default();
+        let Some(&(mode, phy_map)) = modes.iter().filter(|(mode, _)| (*mode as usize) < PRIORITY.len()).min_by_key(|(mode, _)| PRIORITY[*mode as usize]) else { return };
+        let phys: Vec<Vec<u8>> = event
+            .nth(WMI_TAG_ARRAY_STRUCT, 1)
+            .map(|value| nested(value).into_iter().filter(|(tag, _)| *tag == WMI_TAG_MAC_PHY_CAPABILITIES).map(|(_, value)| value.to_vec()).collect())
+            .unwrap_or_default();
+        // The PHYs of the modes before this one come first.
+        let mut index = 0usize;
+        for &(other, map) in &modes {
+            if other == mode {
+                break;
+            }
+            index += (32 - map.leading_zeros()) as usize;
+        }
+        let mut caps = Caps::default();
+        let mut map = phy_map;
+        let mut pdev_id = 0;
+        // Each band's PHY (`ath11k_get_phy_id`).
+        let (mut phy_2g, mut phy_5g) = (0, 0);
+        while map != 0 {
+            let Some(phy) = phys.get(index) else { break };
+            pdev_id = word(phy, 1);
+            let bands = word(phy, 4);
+            if bands & WMI_HOST_WLAN_2G_CAP != 0 {
+                phy_2g = word(phy, 2);
+                caps.tx_chain_mask = word(phy, 12);
+                caps.rx_chain_mask = word(phy, 13);
+                caps.bands[0] = BandCaps { present: true, ht_cap_info: word(phy, 7), he_mac: [word(phy, 10), word(phy, 50)], he_phy: [word(phy, 22), word(phy, 23), word(phy, 24)] };
+            }
+            if bands & WMI_HOST_WLAN_5G_CAP != 0 {
+                phy_5g = word(phy, 2);
+                caps.vht_cap = word(phy, 16);
+                caps.tx_chain_mask = word(phy, 20);
+                caps.rx_chain_mask = word(phy, 21);
+                let ratio = word(phy, 58);
+                caps.nss_ratio = (ratio & WMI_NSS_RATIO_ENABLE_DISABLE_BITPOS != 0).then_some((ratio & WMI_NSS_RATIO_INFO_BITPOS) >> WMI_NSS_RATIO_INFO_BITPOS.trailing_zeros());
+                caps.bands[1] = BandCaps { present: true, ht_cap_info: word(phy, 15), he_mac: [word(phy, 18), word(phy, 51)], he_phy: [word(phy, 25), word(phy, 26), word(phy, 27)] };
+            }
+            index += 1;
+            map >>= 1;
+            if !self.hw.single_pdev_only {
+                break;
+            }
+        }
+        // `ath11k_wmi_tlv_ext_hal_reg_caps`: each PHY's ranges (phy, low
+        // and high 2.4 GHz, low and high 5 GHz).
+        let ranges: Vec<[u32; 5]> = event
+            .nth(WMI_TAG_ARRAY_STRUCT, 2)
+            .map(|value| {
+                nested(value)
+                    .into_iter()
+                    .filter(|(tag, _)| *tag == WMI_TAG_HAL_REG_CAPABILITIES_EXT)
+                    .map(|(_, value)| [word(value, 0), word(value, 6), word(value, 7), word(value, 8), word(value, 9)])
+                    .collect()
+            })
+            .unwrap_or_default();
+        let range = |phy: u32| ranges.iter().find(|range| range[0] == phy);
+        // `ath11k_mac_setup_channels_rates`: 6 GHz when the first PHY's
+        // range reaches it; the limits of each band's PHY.
+        caps.band_6 = caps.bands[1].present && range(0).is_some_and(|own| own[4] >= ATH11K_MIN_6G_FREQ);
+        if let Some(range) = range(phy_2g) {
+            caps.ranges[0] = (range[1], range[2]);
+        }
+        if let Some(range) = range(phy_5g) {
+            caps.ranges[1] = (range[3], range[4]);
+        }
+        caps.tx_chains = caps.tx_chain_mask.count_ones().max(1);
+        caps.rx_chains = caps.rx_chain_mask.count_ones().max(1);
+        self.caps = caps;
+        self.pdev_id = if self.hw.single_pdev_only { 0 } else { pdev_id };
+    }
+
+    /// `ath11k_reg_chan_list_event`: the rules of the firmware's country.
+    fn regulatory(&mut self, event: &Event) {
+        let Some(rules) = event.get(WMI_TAG_ARRAY_STRUCT) else { return };
+        let rules: Vec<Rule> = nested(rules)
+            .into_iter()
+            .filter(|(tag, _)| *tag == WMI_TAG_REGULATORY_RULE_STRUCT)
+            .map(|(_, value)| {
+                let (freq, power, flags) = (word(value, 0), word(value, 1), word(value, 2));
+                Rule { start: get(REG_RULE_START_FREQ, freq), end: get(REG_RULE_END_FREQ, freq), power: get(REG_RULE_REG_PWR, power), flags: get(REG_RULE_FLAGS, flags) }
+            })
+            .collect();
+        if !rules.is_empty() {
+            self.rules = rules;
+        }
+    }
+
+    // ---- What the radio offers. ----
+
+    /// `ath11k_mac_setup_channels_rates` and the HT/VHT/HE capabilities
+    /// (`ath11k_create_ht_cap`, `_vht_cap`, `ath11k_mac_copy_he_cap`).
+    fn build_info(&self) -> Info {
+        let caps = &self.caps;
+        let (tx, rx) = (caps.tx_chains.min(8), caps.rx_chains.min(8));
+        let mut bands = Vec::new();
+        // 6 GHz runs on the 5 GHz PHY, HE alone; a radio whose range
+        // starts at 6 GHz has no 5 GHz band.
+        let only_6 = caps.ranges[1].0 >= ATH11K_MIN_6G_FREQ;
+        for (index, id, present) in [(0, BandId::Ghz2, true), (1, BandId::Ghz5, !only_6), (1, BandId::Ghz6, caps.band_6)] {
+            let band = &caps.bands[index];
+            if !band.present || !present {
+                continue;
+            }
+            let mut channels = wchan::default_channels(id);
+            if !self.rules.is_empty() {
+                for channel in channels.iter_mut() {
+                    let (low, high) = (channel.freq as u32 - 10, channel.freq as u32 + 10);
+                    match self.rules.iter().find(|rule| rule.start <= low && high <= rule.end) {
+                        Some(rule) => {
+                            channel.disabled = rule.flags & REGULATORY_CHAN_DISABLED != 0;
+                            channel.radar = rule.flags & REGULATORY_CHAN_RADAR != 0;
+                            channel.passive = channel.radar || rule.flags & REGULATORY_CHAN_NO_IR != 0;
+                            if rule.power != 0 {
+                                channel.max_power = rule.power as u8;
+                            }
+                        }
+                        // 6 GHz without a rule of the country's (the older
+                        // event's 2.4 and 5 GHz ones): listened to only.
+                        None if id == BandId::Ghz6 => channel.passive = true,
+                        None => channel.disabled = true,
+                    }
+                }
+            }
+            // `ath11k_mac_update_ch_list`: what the PHY tunes to.
+            let (low, high) = caps.ranges[index];
+            if low != 0 && high != 0 {
+                for channel in channels.iter_mut() {
+                    if (channel.freq as u32) < low || channel.freq as u32 > high {
+                        channel.disabled = true;
+                    }
+                }
+            }
+            channels.retain(|channel| !channel.disabled);
+            let ht = if id == BandId::Ghz6 { None } else { self.ht_cap(band.ht_cap_info, rx) };
+            let vht = (id == BandId::Ghz5 && ht.is_some()).then(|| self.vht_cap(tx, rx));
+            let he = (band.he_mac[0] != 0 || band.he_phy[0] != 0).then(|| self.he_cap(band, tx, rx));
+            if id == BandId::Ghz6 && he.is_none() {
+                continue;
+            }
+            bands.push(Band { id, channels, ht, vht, he, eht: None });
+        }
+        Info {
+            driver: String::from("ath11k"),
+            address: self.address,
+            bands,
+            ciphers: vec![radio::CIPHER_TKIP, radio::CIPHER_CCMP, radio::CIPHER_CCMP_256, radio::CIPHER_GCMP, radio::CIPHER_GCMP_256],
+            max_scan_ssids: WLAN_SCAN_PARAMS_MAX_SSID as u8,
+            max_scan_ie_len: (WLAN_SCAN_PARAMS_MAX_IE_LEN as u16).saturating_sub(16),
+            ap: true,
+            management: radio::ManagementProtection::Unicast,
+        }
+    }
+
+    /// `ath11k_create_ht_cap` (SM power save off: both chains listen).
+    fn ht_cap(&self, wmi_ht: u32, rx: u32) -> Option<HtCap> {
+        if wmi_ht & WMI_HT_CAP_ENABLED == 0 {
+            return None;
+        }
+        let mut info = wchan::HT_CAP_SUP_WIDTH_20_40 | wchan::HT_CAP_DSSS_CCK_40 | HT_CAP_SM_PS_DISABLED;
+        if wmi_ht & WMI_HT_CAP_HT20_SGI != 0 {
+            info |= HT_CAP_SGI_20;
+        }
+        if wmi_ht & WMI_HT_CAP_HT40_SGI != 0 {
+            info |= HT_CAP_SGI_40;
+        }
+        if wmi_ht & WMI_HT_CAP_TX_STBC != 0 {
+            info |= HT_CAP_TX_STBC;
+        }
+        if wmi_ht & WMI_HT_CAP_RX_STBC != 0 {
+            info |= ((((wmi_ht & WMI_HT_CAP_RX_STBC) >> WMI_HT_CAP_RX_STBC_MASK_SHIFT) as u16) << HT_CAP_RX_STBC_SHIFT) & HT_CAP_RX_STBC;
+        }
+        if wmi_ht & WMI_HT_CAP_RX_LDPC != 0 {
+            info |= wchan::HT_CAP_LDPC;
+        }
+        if wmi_ht & WMI_HT_CAP_L_SIG_TXOP_PROT != 0 {
+            info |= HT_CAP_LSIG_TXOP;
+        }
+        if self.caps.vht_cap & WMI_VHT_CAP_MAX_MPDU_LEN_MASK != 0 {
+            info |= wchan::HT_CAP_MAX_AMSDU;
+        }
+        let mut mcs = [0u8; 16];
+        for stream in 0..rx.min(4) as usize {
+            mcs[stream] = 0xff;
+        }
+        // TX MCS set defined.
+        mcs[12] = 1;
+        Some(HtCap { info, ampdu_factor: 3, ampdu_density: 0, mcs })
+    }
+
+    /// `ath11k_create_vht_cap` with `ath11k_set_vht_txbf_cap`.
+    fn vht_cap(&self, tx: u32, rx: u32) -> VhtCap {
+        let mut info = self.caps.vht_cap;
+        let subfer = tx >= 2 && info & VHT_CAP_SU_BEAMFORMER != 0;
+        let subfee = rx >= 2 && info & VHT_CAP_SU_BEAMFORMEE != 0;
+        if !subfer {
+            info &= !(VHT_CAP_SU_BEAMFORMER | VHT_CAP_MU_BEAMFORMER);
+        }
+        if !subfee {
+            info &= !(VHT_CAP_SU_BEAMFORMEE | VHT_CAP_MU_BEAMFORMEE);
+        }
+        let sound = ((info & VHT_CAP_SOUNDING_MASK) >> VHT_CAP_SOUNDING_SHIFT).min(tx.saturating_sub(1));
+        let nsts = (info & VHT_CAP_BEAMFORMEE_STS_MASK) >> VHT_CAP_BEAMFORMEE_STS_SHIFT;
+        info &= !(VHT_CAP_SOUNDING_MASK | VHT_CAP_BEAMFORMEE_STS_MASK);
+        if subfer {
+            info |= sound << VHT_CAP_SOUNDING_SHIFT;
+        }
+        if subfee {
+            info |= nsts << VHT_CAP_BEAMFORMEE_STS_SHIFT;
+        }
+        if tx <= 1 {
+            info &= !wchan::VHT_CAP_TXSTBC;
+        }
+        let (rx_map, tx_map) = (mcs_map(rx, VHT_MCS_0_9), mcs_map(tx, VHT_MCS_0_9));
+        let mut mcs = [0u8; 8];
+        mcs[0..2].copy_from_slice(&rx_map.to_le_bytes());
+        mcs[4..6].copy_from_slice(&tx_map.to_le_bytes());
+        VhtCap { info, mcs }
+    }
+
+    /// `ath11k_mac_copy_he_cap` for a station, with `ath11k_mac_set_hemcsmap`.
+    fn he_cap(&self, band: &BandCaps, tx: u32, rx: u32) -> HeCap {
+        let mac_bytes: Vec<u8> = band.he_mac.iter().flat_map(|word| word.to_le_bytes()).collect();
+        let phy_bytes: Vec<u8> = band.he_phy.iter().flat_map(|word| word.to_le_bytes()).collect();
+        let mut mac = [0u8; 6];
+        mac.copy_from_slice(&mac_bytes[..6]);
+        let mut phy = [0u8; 11];
+        phy.copy_from_slice(&phy_bytes[..11]);
+        mac[1] &= HE_MAC1_TF_MAC_PAD_DUR_MASK;
+        mac[0] = (mac[0] & !HE_MAC0_TWT_RES) | HE_MAC0_TWT_REQ;
+        phy[5] = (phy[5] & !HE_PHY5_SND_DIM_UNDER_80_MASK) | (tx.saturating_sub(1) as u8 & HE_PHY5_SND_DIM_UNDER_80_MASK);
+        phy[9] |= HE_PHY9_TX_1024_QAM_UNDER_242_RU;
+        // No PPE thresholds of this driver's: the nominal padding applies.
+        phy[6] &= !HE_PHY6_PPE_THRESHOLD_PRESENT;
+        let (rx_map, tx_map) = (mcs_map(rx, HE_MCS_0_11), mcs_map(tx, HE_MCS_0_11));
+        let mut mcs = Vec::new();
+        let sets = 1 + (phy[0] & wchan::HE_PHY_160_IN_5G != 0) as usize + (phy[0] & wchan::HE_PHY_80P80_IN_5G != 0) as usize;
+        for _ in 0..sets {
+            mcs.extend_from_slice(&rx_map.to_le_bytes());
+            mcs.extend_from_slice(&tx_map.to_le_bytes());
+        }
+        HeCap { mac, phy, mcs, ppe: Vec::new() }
+    }
+
+    pub(crate) fn info(&self) -> Option<Info> {
+        self.info.clone()
+    }
+
+    // ---- What the chip received. ----
+
+    fn lost(&mut self, why: &str) {
+        if self.associated {
+            ostd::info!("{}: {}", self.name, why);
+            if let Some(device) = &self.device {
+                device.connection_lost();
+            }
+        }
+    }
+
+    /// `ath11k_mgmt_rx_event`: the frame, its channel and signal.
+    fn management_rx(&mut self, header: &[u8], frame: &[u8]) {
+        let (channel, snr, length, status, freq) = (word(header, 0), word(header, 1), word(header, 4) as usize, word(header, 5), word(header, 16));
+        if status & (WMI_RX_STATUS_ERR_DECRYPT | WMI_RX_STATUS_ERR_KEY_CACHE_MISS | WMI_RX_STATUS_ERR_CRC) != 0 || length < wifi::HEADER || length > frame.len() {
+            return;
+        }
+        let mut frame = frame[..length].to_vec();
+        let freq = if freq != 0 {
+            freq as u16
+        } else {
+            match channel {
+                1..=14 => wchan::freq_of(BandId::Ghz2, channel as u8),
+                36..=177 => wchan::freq_of(BandId::Ghz5, channel as u8),
+                _ => self.current_freq(),
+            }
+        };
+        let signal = (NOISE_FLOOR + snr as i32).clamp(-127, -1) as i8;
+        // Protected management frames arrive decrypted; robust ones (action,
+        // deauthentication, disassociation) keep the cipher's header and
+        // MIC (`ath11k_mgmt_rx_event`), the others lose their protection.
+        let (mut decrypted, mut security_header) = (false, 0);
+        let subtype = frame[0] & 0xfc;
+        if frame[1] & wifi::PROTECTED != 0 && subtype != wifi::AUTH {
+            decrypted = true;
+            if matches!(subtype, wifi::ACTION | wifi::DEAUTH | wifi::DISASSOC) {
+                security_header = 8;
+                let mic = self.pairwise_mic;
+                frame.truncate(frame.len().saturating_sub(mic));
+            } else {
+                frame[1] &= !wifi::PROTECTED;
+            }
+        }
+        if let Some(network) = &self.network
+            && wifi::addresses(&frame).is_some_and(|(_, transmitter, _)| transmitter == network.join.bssid)
+        {
+            self.signal = Some(signal);
+        }
+        if let Some(device) = &self.device {
+            device.received(&frame, RxInfo { freq, signal, decrypted, security_header, amsdu_more: false });
+        }
+    }
+
+    fn current_freq(&self) -> u16 {
+        if let Some(ap) = &self.ap {
+            ap.config.chandef.control
+        } else if self.scan.is_some() && self.scan_freq != 0 {
+            self.scan_freq
+        } else {
+            self.network.as_ref().map_or(self.scan_freq, |network| network.join.freq)
+        }
+    }
+
+    /// A frame from the data path, taken for decrypted when the hardware
+    /// says so and a key of its kind is in place (the transmitter's, as an
+    /// access point): the Protected bit says which, the security header
+    /// and the MIC are gone.
+    fn deliver(&mut self, received: Received) {
+        let Some(device) = &self.device else { return };
+        let Received { mut frame, native, decrypted, group } = received;
+        let transmitter = if native { wifi::addresses(&frame).map(|(_, transmitter, _)| transmitter) } else { frame.get(6..12).and_then(|b| b.try_into().ok()) };
+        let keyed = match &self.ap {
+            Some(ap) => transmitter.and_then(|address| ap.stations.get(&address)).is_some_and(|station| station.key),
+            None if group => self.keys.1,
+            None => self.keys.0,
+        };
+        let decrypted = decrypted && keyed;
+        if native {
+            if decrypted {
+                frame[1] |= wifi::PROTECTED;
+            } else {
+                frame[1] &= !wifi::PROTECTED;
+            }
+            let freq = self.current_freq();
+            device.received(&frame, RxInfo { freq, signal: self.signal.unwrap_or(-60), decrypted, security_header: 0, amsdu_more: false });
+        } else {
+            device.received_ethernet(frame, decrypted);
+        }
+    }
+
+    // ---- Scans (`ath11k_mac_op_hw_scan`). ----
+
+    pub(crate) fn scan(&mut self, request: &ScanRequest) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if self.scan.is_some() {
+            return Err(radio::Error::Busy);
+        }
+        let Some(info) = &self.info else { return Err(radio::Error::Down) };
+        let known: Vec<u16> = info.bands.iter().flat_map(|band| band.channels.iter().map(|channel| channel.freq)).collect();
+        let mut freqs: Vec<u16> = request.freqs.iter().copied().filter(|freq| known.contains(freq)).collect();
+        if freqs.is_empty() {
+            freqs = known;
+        }
+        let mut parts = Vec::new();
+        for band in [BandId::Ghz2, BandId::Ghz5, BandId::Ghz6] {
+            let band_freqs: Vec<u32> = freqs.iter().copied().filter(|&freq| BandId::of(freq) == band).map(u32::from).collect();
+            if band_freqs.is_empty() {
+                continue;
+            }
+            let mut ies = Vec::new();
+            wifi::put_rates(&mut ies, band.rates());
+            ies.extend_from_slice(&request.elements);
+            parts.push((band_freqs, ies));
+        }
+        self.scan = Some(Scan { parts, ssids: request.ssids.clone(), running: false, aborted: false, deadline: 0 });
+        self.scan_step();
+        Ok(())
+    }
+
+    pub(crate) fn abort_scan(&mut self) {
+        let Some(scan) = &mut self.scan else { return };
+        scan.aborted = true;
+        scan.parts.clear();
+        if scan.running {
+            let _ = self.wmi(wmi::scan_stop(VDEV, self.pdev_id, SCAN_ID));
+        } else {
+            self.scan_step();
+        }
+    }
+
+    /// The scan's next band, or its end.
+    fn scan_step(&mut self) {
+        loop {
+            let Some(scan) = &mut self.scan else { return };
+            if scan.running {
+                if now_ms() < scan.deadline {
+                    return;
+                }
+                ostd::warn!("{}: the scan did not end; taking it for done", self.name);
+                scan.running = false;
+            }
+            if scan.parts.is_empty() {
+                let aborted = scan.aborted;
+                self.scan = None;
+                if let Some(device) = &self.device {
+                    device.scan_done(aborted);
+                }
+                return;
+            }
+            let (freqs, ies) = scan.parts.remove(0);
+            // An empty name asks every network (a wildcard probe).
+            let cmd = wmi::scan_start(VDEV, SCAN_ID, &freqs, &scan.ssids, &ies, self.hw.single_pdev_only);
+            if self.wmi(cmd).is_ok() {
+                if let Some(scan) = &mut self.scan {
+                    scan.running = true;
+                    scan.deadline = now_ms() + SCAN_TIMEOUT_MS;
+                }
+                return;
+            }
+        }
+    }
+
+    /// `ath11k_scan_event`: the band done (or refused) moves the scan on.
+    fn scan_event(&mut self, kind: u32, _reason: u32, freq: u32) {
+        match kind {
+            WMI_SCAN_EVENT_BSS_CHANNEL | WMI_SCAN_EVENT_FOREIGN_CHAN => self.scan_freq = freq as u16,
+            WMI_SCAN_EVENT_COMPLETED | WMI_SCAN_EVENT_DEQUEUED | WMI_SCAN_EVENT_START_FAILED => {
+                if let Some(scan) = &mut self.scan {
+                    scan.running = false;
+                    if kind != WMI_SCAN_EVENT_COMPLETED {
+                        scan.aborted = true;
+                    }
+                }
+                self.scan_step();
+            }
+            _ => {}
+        }
+    }
+
+    fn end_scan(&mut self) {
+        if self.scan.is_some() {
+            self.abort_scan();
+            let _ = self.wait(1000, |card| card.scan.is_none());
+            if self.scan.is_some() {
+                self.scan = None;
+                if let Some(device) = &self.device {
+                    device.scan_done(true);
+                }
+            }
+        }
+    }
+
+    // ---- Joining. ----
+
+    /// `ath11k_mac_vdev_start` on the network's channel: HE's mode for the
+    /// band and width (`ath11k_phymodes`), the centres as
+    /// `ath11k_wmi_put_wmi_channel` gives them; an access point's name, and
+    /// its channel passive when radar may be on it.
+    fn vdev_start(&mut self, chandef: Chandef, beacon_interval: u16, dtim_period: u8, ssid: &[u8], hidden: bool) -> radio::Result<()> {
+        let ghz2 = BandId::of(chandef.control) == BandId::Ghz2;
+        let mode = match (ghz2, chandef.width) {
+            (true, Width::W40) => MODE_11AX_HE40_2G,
+            (true, _) => MODE_11AX_HE20_2G,
+            (false, Width::W40) => MODE_11AX_HE40,
+            (false, Width::W80) => MODE_11AX_HE80,
+            (false, Width::W160) => MODE_11AX_HE160,
+            (false, _) => MODE_11AX_HE20,
+        };
+        let (center1, center2) = if chandef.width == Width::W160 { (chandef.center_80() as u32, chandef.center as u32) } else { (chandef.center as u32, 0) };
+        let channel = self.info.as_ref().and_then(|info| info.channel(chandef.control)).map(|(_, channel)| *channel).unwrap_or(Channel::new(chandef.control));
+        let ap = self.ap_vdev;
+        let passive = if ap { channel.radar } else { channel.passive };
+        let channel = wmi::Channel { freq: chandef.control as u32, center1, center2, mode, passive, dfs: channel.radar, max_power: channel.max_power as u32 };
+        self.vdev_response = None;
+        let streams = self.caps.tx_chains.max(1);
+        let ssid = if ap { ssid } else { &[] };
+        self.wmi(wmi::vdev_start(VDEV, &channel, beacon_interval.max(1) as u32, dtim_period.max(1) as u32, ssid, ap && hidden, streams, false)).map_err(|_| radio::Error::Failed)?;
+        if !self.wait(WAIT_MS, |card| card.vdev_response.is_some()) || self.vdev_response != Some(0) {
+            ostd::warn!("{}: the firmware did not start the vdev on {} MHz ({:?})", self.name, chandef.control, self.vdev_response);
+            return Err(radio::Error::Failed);
+        }
+        Ok(())
+    }
+
+    /// `ath11k_peer_create`: the peer, its map awaited.
+    fn create_peer(&mut self, address: Address) -> radio::Result<()> {
+        self.wmi(wmi::peer_create(VDEV, &address)).map_err(|_| radio::Error::Failed)?;
+        if !self.wait(WAIT_MS, |card| card.peers.iter().any(|peer| peer.address == address)) {
+            ostd::warn!("{}: the firmware did not map the peer {:02x?}", self.name, address);
+            return Err(radio::Error::Failed);
+        }
+        Ok(())
+    }
+
+    /// `ath11k_dp_peer_setup`: a peer's default route and its TIDs'
+    /// queues.
+    fn peer_setup(&mut self, address: Address) -> radio::Result<()> {
+        // The REO ring is the MAC's (from 1), the hash spreads the rest.
+        self.wmi(wmi::peer_set_param(VDEV, &address, WMI_PEER_SET_DEFAULT_ROUTING, DP_RX_HASH_ENABLE | (1 << 1))).map_err(|_| radio::Error::Failed)?;
+        for (tid, queue) in self.dp.tid_queues(address).map_err(|_| radio::Error::Failed)? {
+            self.wmi(wmi::reorder_queue_setup(VDEV, &address, tid, queue, 1)).map_err(|_| radio::Error::Failed)?;
+        }
+        Ok(())
+    }
+
+    /// `ath11k_mac_vif_setup_ps`: the firmware's power save, dozing after
+    /// 100 ms of quiet (mac80211's dynamic power save time-out), where the
+    /// chip runs it.
+    pub(crate) fn set_power_save(&mut self, enabled: bool) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if !self.hw.supports_sta_ps {
+            return Err(radio::Error::Unsupported);
+        }
+        if self.ap_vdev {
+            return Err(radio::Error::Invalid);
+        }
+        let result = if enabled {
+            self.wmi(wmi::sta_ps_param(VDEV, WMI_STA_PS_PARAM_INACTIVITY_TIME, PS_INACTIVITY_MS)).and_then(|()| self.wmi(wmi::sta_powersave_mode(VDEV, WMI_STA_PS_MODE_ENABLED)))
+        } else {
+            self.wmi(wmi::sta_powersave_mode(VDEV, WMI_STA_PS_MODE_DISABLED))
+        };
+        result.map_err(|error| {
+            ostd::info!("{}: power save: {}", self.name, error);
+            radio::Error::Failed
+        })
+    }
+
+    // ---- Block acknowledgment (`ath11k_dp_rx_ampdu_start`/`_stop`): the
+    // peer's TID queue takes the window from its first sequence number and
+    // REO puts the frames in order; the firmware makes its own agreements
+    // to send (Linux's `TX_AMPDU_SETUP_IN_HW`). ----
+
+    pub(crate) fn rx_ba_start(&mut self, ba: &mut BlockAck) -> radio::Result<Reorder> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        let paddr = self.dp.reo_window(&self.hal, &self.bus, ba.peer, ba.tid as u32, ba.buffer as u32, Some(ba.ssn)).ok_or(radio::Error::Invalid)?;
+        self.wmi(wmi::reorder_queue_setup(VDEV, &ba.peer, ba.tid as u32, paddr, ba.buffer as u32)).map_err(|_| radio::Error::Failed)?;
+        Ok(Reorder::Radio)
+    }
+
+    pub(crate) fn rx_ba_stop(&mut self, peer: &Address, tid: u8) {
+        if self.dead {
+            return;
+        }
+        if let Some(paddr) = self.dp.reo_window(&self.hal, &self.bus, *peer, tid as u32, 1, None) {
+            let _ = self.wmi(wmi::reorder_queue_setup(VDEV, peer, tid as u32, paddr, 1));
+        }
+    }
+
+    /// `ath11k_peer_delete`: the firmware's answer and the unmap awaited,
+    /// the peer's queues freed.
+    fn delete_peer(&mut self, address: Address) {
+        if !self.dead {
+            self.peer_deleted = false;
+            if self.wmi(wmi::peer_delete(VDEV, &address)).is_ok() {
+                let _ = self.wait(1000, |card| card.peer_deleted && !card.peers.iter().any(|peer| peer.address == address));
+            }
+        }
+        self.peers.retain(|peer| peer.address != address);
+        self.dp.drop_queues(Some(address));
+    }
+
+    /// The access point's peer: the TX descriptors find it by its index.
+    fn peer_create(&mut self, bssid: Address) -> radio::Result<()> {
+        if let Some(network) = &mut self.network {
+            network.peer = true;
+        }
+        self.create_peer(bssid)?;
+        let peer = self.peers.iter().find(|peer| peer.address == bssid).copied();
+        self.dp.attach(VDEV, self.pdev_id, peer, false);
+        self.peer_setup(bssid)
+    }
+
+    fn start_station_vdev(&mut self, join: &Join) -> radio::Result<()> {
+        self.vdev_start(join.chandef, join.beacon_interval, 1, &[], false)?;
+        if let Some(network) = &mut self.network {
+            network.started = true;
+        }
+        Ok(())
+    }
+
+    /// The vdev on the network's channel and the access point's peer, in
+    /// the order the chip wants (`vdev_start_delay`: peer first).
+    pub(crate) fn join(&mut self, join: &Join) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if self.ap.is_some() {
+            return Err(radio::Error::Busy);
+        }
+        self.leave();
+        self.end_scan();
+        self.change_interface(false)?;
+        self.network = Some(Network { join: join.clone(), peer: false, started: false, up: false });
+        let result = if self.hw.vdev_start_delay {
+            self.peer_create(join.bssid).and_then(|()| self.start_station_vdev(join))
+        } else {
+            self.start_station_vdev(join).and_then(|()| self.peer_create(join.bssid))
+        };
+        if result.is_err() {
+            self.leave();
+        }
+        result
+    }
+
+    /// `ath11k_bss_assoc`: the access point's capabilities
+    /// (`ath11k_peer_assoc_prepare`), the vdev up with the AID, the ERP
+    /// settings and the access classes' parameters.
+    pub(crate) fn associated(&mut self, association: &Association) -> radio::Result<()> {
+        let Some(network) = &self.network else { return Err(radio::Error::Invalid) };
+        let bssid = network.join.bssid;
+        let beacon = Elements(&network.join.elements);
+        let request = Elements(&association.request_elements);
+        let he_ops = match he_ops_of(&Elements(&association.elements)) {
+            0 => he_ops_of(&beacon),
+            ops => ops,
+        };
+        let params = PeerParams {
+            address: bssid,
+            aid: association.aid,
+            capability: association.capability,
+            listen_interval: LISTEN_INTERVAL,
+            peer: &association.peer,
+            chandef: association.chandef,
+            he_ops,
+            rsn: beacon.get(wifi::IE_RSN).is_some() || request.get(wifi::IE_RSN).is_some(),
+            wpa: beacon.vendor(WPA_OUI_TYPE).is_some(),
+        };
+        let assoc = self.peer_assoc(&params);
+        self.send_peer_assoc(&assoc)?;
+        let ghz2 = BandId::of(association.chandef.control) == BandId::Ghz2;
+        let short_slot = !ghz2 || association.capability & wifi::CAP_SHORT_SLOT != 0;
+        let short_preamble = association.capability & wifi::CAP_SHORT_PREAMBLE != 0;
+        let _ = self.wmi(wmi::vdev_set_param(VDEV, WMI_VDEV_PARAM_SLOT_TIME, if short_slot { WMI_VDEV_SLOT_TIME_SHORT } else { WMI_VDEV_SLOT_TIME_LONG }));
+        let _ = self.wmi(wmi::vdev_set_param(VDEV, WMI_VDEV_PARAM_PREAMBLE, if short_preamble { WMI_VDEV_PREAMBLE_SHORT } else { WMI_VDEV_PREAMBLE_LONG }));
+        if let Some(params) = wmm_params(&association.elements) {
+            let _ = self.wmi(wmi::wmm_params(VDEV, &params));
+        }
+        self.wmi(wmi::vdev_up(VDEV, (association.aid & 0x3fff) as u32, &bssid)).map_err(|_| radio::Error::Failed)?;
+        let _ = self.wmi(wmi::vdev_set_param(VDEV, WMI_VDEV_PARAM_DTIM_POLICY, WMI_DTIM_POLICY_STICK));
+        if let Some(network) = &mut self.network {
+            network.up = true;
+        }
+        self.associated = true;
+        self.qos = association.qos;
+        Ok(())
+    }
+
+    /// WMI's PEER_ASSOC, its confirmation awaited.
+    fn send_peer_assoc(&mut self, assoc: &wmi::PeerAssoc) -> radio::Result<()> {
+        self.peer_assoc_done = false;
+        self.wmi(wmi::peer_assoc(VDEV, assoc)).map_err(|_| radio::Error::Failed)?;
+        if !self.wait(1000, |card| card.peer_assoc_done) {
+            ostd::warn!("{}: no peer-assoc confirmation for {:02x?}", self.name, assoc.address);
+        }
+        Ok(())
+    }
+
+    /// `ath11k_peer_assoc_prepare`'s helpers (basic, crypto, rates, HT,
+    /// VHT, HE, QoS, phymode) and `ath11k_wmi_copy_peer_flags`.
+    fn peer_assoc(&self, params: &PeerParams<'_>) -> wmi::PeerAssoc {
+        let peer = params.peer;
+        let width = params.chandef.width;
+        let ghz2 = BandId::of(params.chandef.control) == BandId::Ghz2;
+        let mut assoc = wmi::PeerAssoc {
+            address: params.address,
+            aid: (params.aid & 0x3fff) as u32,
+            caps: params.capability as u32,
+            listen_interval: params.listen_interval,
+            nss: 1,
+            ..Default::default()
+        };
+        // Legacy rates: CCK ones flagged, none at 5 GHz.
+        for &rate in &peer.rates {
+            let rate = rate & 0x7f;
+            let cck = CCK_RATES.contains(&rate);
+            if (ghz2 || !cck) && !assoc.legacy_rates.iter().any(|&known| known & 0x7f == rate) {
+                assoc.legacy_rates.push(if cck { rate | 0x80 } else { rate });
+            }
+        }
+        let (mut ht_flag, mut vht_flag, mut he_flag, mut bw40, mut bw80, mut bw160, mut stbc, mut ldpc) = (false, false, false, false, false, false, false, false);
+        if let Some(ht) = &peer.ht {
+            ht_flag = true;
+            assoc.max_mpdu = (1 << (HT_AMPDU_FACTOR + ht.ampdu_factor as u32)) - 1;
+            assoc.mpdu_density = mpdu_density(ht.ampdu_density);
+            // Linux's default guard interval: SGI from the rate caps only.
+            assoc.ht_caps = (ht.info & !(HT_CAP_SGI_20 | HT_CAP_SGI_40)) as u32;
+            assoc.rate_caps |= WMI_HOST_RC_HT_FLAG;
+            if ht.info & wchan::HT_CAP_LDPC != 0 {
+                ldpc = true;
+            }
+            if width >= Width::W40 {
+                bw40 = true;
+                assoc.rate_caps |= WMI_HOST_RC_CW40_FLAG;
+            }
+            if ht.info & (HT_CAP_SGI_20 | HT_CAP_SGI_40) != 0 {
+                assoc.rate_caps |= WMI_HOST_RC_SGI_FLAG;
+            }
+            if ht.info & HT_CAP_TX_STBC != 0 {
+                assoc.rate_caps |= WMI_HOST_RC_TX_STBC_FLAG;
+                stbc = true;
+            }
+            if ht.info & HT_CAP_RX_STBC != 0 {
+                assoc.rate_caps |= (((ht.info & HT_CAP_RX_STBC) >> HT_CAP_RX_STBC_SHIFT) as u32) << WMI_HOST_RC_RX_STBC_FLAG_S;
+                stbc = true;
+            }
+            if ht.mcs[1] != 0 && ht.mcs[2] != 0 {
+                assoc.rate_caps |= WMI_HOST_RC_TS_FLAG;
+            } else if ht.mcs[1] != 0 {
+                assoc.rate_caps |= WMI_HOST_RC_DS_FLAG;
+            }
+            let mut max_nss = 0;
+            for index in 0..80u32 {
+                if ht.mcs[(index / 8) as usize] & (1 << (index % 8)) != 0 {
+                    max_nss = index / 8 + 1;
+                    assoc.ht_rates.push(index as u8);
+                }
+            }
+            if assoc.ht_rates.is_empty() {
+                assoc.ht_rates = (0..8).collect();
+            } else {
+                assoc.nss = (peer.nss as u32).min(max_nss).max(1);
+            }
+        }
+        let max_nss_160 = |max_nss: u32| match self.caps.nss_ratio {
+            Some(ratio) if ratio == WMI_NSS_RATIO_1BY2_NSS => max_nss >> 1,
+            Some(ratio) if ratio == WMI_NSS_RATIO_1_NSS => max_nss,
+            Some(_) => 0,
+            None => max_nss >> 1,
+        };
+        assoc.phymode = phymode(ghz2, width, peer);
+        if let Some(vht) = &peer.vht {
+            vht_flag = true;
+            assoc.vht_caps = vht.info;
+            let factor = (vht.info & VHT_CAP_AMPDU_EXP_MASK) >> VHT_CAP_AMPDU_EXP_SHIFT;
+            assoc.max_mpdu = assoc.max_mpdu.max((1 << (HT_AMPDU_FACTOR + factor)) - 1);
+            bw80 = width == Width::W80;
+            bw160 = width == Width::W160;
+            let rx_map = u16::from_le_bytes([vht.mcs[0], vht.mcs[1]]);
+            let rx_high = u16::from_le_bytes([vht.mcs[2], vht.mcs[3]]) & 0x1fff;
+            let tx_map = u16::from_le_bytes([vht.mcs[4], vht.mcs[5]]);
+            let tx_high = u16::from_le_bytes([vht.mcs[6], vht.mcs[7]]) & 0x1fff;
+            let max_nss = map_streams(rx_map);
+            assoc.nss = (peer.nss as u32).min(max_nss).max(1);
+            assoc.vht_rx = (rx_high as u32, rx_map as u32);
+            assoc.vht_tx = (tx_high as u32, (tx_map as u32 & !IEEE80211_VHT_MCS_SUPPORT_0_11_MASK) | IEEE80211_DISABLE_VHT_MCS_SUPPORT_0_11);
+            if matches!(assoc.phymode, MODE_11AC_VHT160 | MODE_11AC_VHT80_80) {
+                let rx_nss = assoc.nss.min(max_nss_160(max_nss));
+                if rx_nss > 0 {
+                    let field_160 = if assoc.phymode == MODE_11AC_VHT160 { ATH11K_PEER_RX_NSS_160MHZ } else { ATH11K_PEER_RX_NSS_80_80MHZ };
+                    assoc.bw_rxnss_override = ATH11K_BW_NSS_MAP_ENABLE | field(field_160, rx_nss - 1);
+                }
+            }
+        }
+        if let Some(he) = &peer.he {
+            he_flag = true;
+            let map_at = |at: usize| he.mcs.get(at..at + 2).map_or(0xffff, |b| u16::from_le_bytes([b[0], b[1]]));
+            let support_160 = he.phy[0] & wchan::HE_PHY_160_IN_5G != 0;
+            let mut mac = [0u8; 8];
+            mac[..6].copy_from_slice(&he.mac);
+            assoc.he_mac = [u32::from_le_bytes([mac[0], mac[1], mac[2], mac[3]]), u32::from_le_bytes([mac[4], mac[5], 0, 0])];
+            let mut phy = [0u8; 12];
+            phy[..11].copy_from_slice(&he.phy);
+            assoc.he_phy = [u32::from_le_bytes([phy[0], phy[1], phy[2], phy[3]]), u32::from_le_bytes([phy[4], phy[5], phy[6], phy[7]]), u32::from_le_bytes([phy[8], phy[9], phy[10], phy[11]])];
+            assoc.he_ops = params.he_ops;
+            let factor = ((he.mac[3] & HE_MAC3_AMPDU_EXP_MASK) >> HE_MAC3_AMPDU_EXP_MASK.trailing_zeros()) as u32;
+            if factor != 0 {
+                if peer.vht.is_some() {
+                    assoc.max_mpdu = (1 << (HE_VHT_AMPDU_FACTOR + factor)) - 1;
+                } else if peer.ht.is_some() {
+                    assoc.max_mpdu = (1 << (HE_HT_AMPDU_FACTOR + factor)) - 1;
+                }
+            }
+            if he.phy[6] & HE_PHY6_PPE_THRESHOLD_PRESENT != 0
+                && let Some(&first) = he.ppe.first()
+            {
+                let numss_m1 = (first & 0x07) as u32;
+                let ru_mask = ((first & 0x78) >> 3) as u32;
+                assoc.ppet[0] = numss_m1;
+                assoc.ppet[1] = ru_mask;
+                let mut bit = 7usize;
+                for nss in 0..=numss_m1.min(7) as usize {
+                    for ru in 0..4 {
+                        if ru_mask & (1 << ru) == 0 {
+                            continue;
+                        }
+                        let mut value = 0u32;
+                        for _ in 0..6 {
+                            value >>= 1;
+                            value |= ((he.ppe.get(bit / 8).copied().unwrap_or(0) as u32 >> (bit % 8)) & 1) << 5;
+                            bit += 1;
+                        }
+                        assoc.ppet[2 + nss] |= value << (ru * 6);
+                    }
+                }
+            }
+            // The sets by width: 80 MHz always, 160 and 80+80 when wide.
+            assoc.he_mcs.push((map_at(0) as u32, map_at(2) as u32));
+            let mut tx_for_nss = map_at(2);
+            if width == Width::W160 {
+                assoc.he_mcs.push((map_at(4) as u32, map_at(6) as u32));
+                tx_for_nss = map_at(6);
+                if he.phy[0] & wchan::HE_PHY_80P80_IN_5G != 0 {
+                    assoc.he_mcs.push((map_at(8) as u32, map_at(10) as u32));
+                    tx_for_nss = map_at(10);
+                }
+            }
+            let rx_80 = map_streams(map_at(0));
+            let max_rx = if support_160 { rx_80.min(map_streams(map_at(4))) } else { rx_80 };
+            let max_nss = map_streams(tx_for_nss).max(1);
+            assoc.nss = (peer.nss as u32).min(max_rx.max(1)).min(max_nss).max(1);
+            if matches!(assoc.phymode, MODE_11AX_HE160 | MODE_11AX_HE80_80) {
+                let rx_nss = assoc.nss.min(max_nss_160(max_nss));
+                if rx_nss > 0 {
+                    let field_160 = if assoc.phymode == MODE_11AX_HE160 { ATH11K_PEER_RX_NSS_160MHZ } else { ATH11K_PEER_RX_NSS_80_80MHZ };
+                    assoc.bw_rxnss_override = ATH11K_BW_NSS_MAP_ENABLE | field(field_160, rx_nss - 1);
+                }
+            }
+            if he.mac[0] & HE_MAC0_TWT_RES != 0 {
+                assoc.flags |= WMI_PEER_TWT_RESP;
+            }
+        }
+        // `ath11k_peer_assoc_h_he_6ghz`: on 6 GHz the width is HE's and
+        // the aggregates HE's band capabilities'.
+        if he_flag
+            && BandId::of(params.chandef.control) == BandId::Ghz6
+            && let Some(capa) = peer.he_6ghz
+        {
+            bw40 |= width == Width::W40;
+            bw80 |= width == Width::W80;
+            bw160 |= width == Width::W160;
+            assoc.he_6ghz = capa as u32;
+            assoc.mpdu_density = mpdu_density((capa & 7) as u8);
+            let he_exponent = peer.he.as_ref().map_or(0, |he| ((he.mac[3] & HE_MAC3_AMPDU_EXP_MASK) >> HE_MAC3_AMPDU_EXP_MASK.trailing_zeros()) as u32);
+            let exponent = ((capa >> wchan::HE_6GHZ_CAP_MAX_AMPDU_SHIFT) & 7) as u32;
+            assoc.max_mpdu = (1 << (HE_6GHZ_AMPDU_FACTOR + he_exponent + exponent)) - 1;
+        }
+        // `ath11k_wmi_copy_peer_flags`: the rate flags only with WMM.
+        if peer.qos {
+            assoc.flags |= WMI_PEER_QOS;
+            for (on, flag) in [(ht_flag, WMI_PEER_HT), (bw40, WMI_PEER_40MHZ), (bw80, WMI_PEER_80MHZ), (bw160, WMI_PEER_160MHZ), (stbc, WMI_PEER_STBC), (ldpc, WMI_PEER_LDPC), (vht_flag, WMI_PEER_VHT), (he_flag, WMI_PEER_HE)] {
+                if on {
+                    assoc.flags |= flag;
+                }
+            }
+        } else {
+            assoc.flags &= !WMI_PEER_TWT_RESP;
+        }
+        if params.rsn || params.wpa {
+            // Authorized once the keys are in place.
+            assoc.flags |= WMI_PEER_NEED_PTK_4_WAY;
+        } else {
+            assoc.flags |= WMI_PEER_AUTH;
+        }
+        if params.wpa {
+            assoc.flags |= WMI_PEER_NEED_GTK_2_WAY;
+        }
+        if assoc.ht_rates.is_empty() {
+            assoc.flags &= !WMI_PEER_HT;
+        }
+        assoc
+    }
+
+    /// `ath11k_mac_vdev_stop`: the firmware's word awaited.
+    fn stop_vdev(&mut self) {
+        self.vdev_stopped = false;
+        if self.wmi(wmi::vdev_stop(VDEV)).is_ok() {
+            let _ = self.wait(1000, |card| card.vdev_stopped);
+        }
+    }
+
+    /// The vdev down, the peer gone, the vdev stopped
+    /// (`ath11k_bss_disassoc`, `ath11k_peer_delete`, `ath11k_mac_vdev_stop`).
+    pub(crate) fn leave(&mut self) {
+        let Some(network) = self.network.take() else { return };
+        let bssid = network.join.bssid;
+        if !self.dead && network.up {
+            let _ = self.wmi(wmi::vdev_down(VDEV));
+        }
+        if network.peer {
+            self.delete_peer(bssid);
+        }
+        if !self.dead && network.started {
+            self.stop_vdev();
+        }
+        self.dp.drop_queues(None);
+        self.dp.attach(VDEV, self.pdev_id, None, false);
+        self.qos = false;
+        self.associated = false;
+        self.keys = (false, false);
+        self.signal = None;
+    }
+
+    /// `ath11k_install_key`, the replay check of the pairwise key's
+    /// packet numbers (`ath11k_dp_peer_rx_pn_replay_config`).
+    pub(crate) fn set_key(&mut self, key: &Key) -> radio::Result<()> {
+        let (cipher, mic) = match key.cipher {
+            radio::CIPHER_CCMP | radio::CIPHER_CCMP_256 => (WMI_CIPHER_AES_CCM, false),
+            radio::CIPHER_GCMP | radio::CIPHER_GCMP_256 => (WMI_CIPHER_AES_GCM, false),
+            radio::CIPHER_TKIP => (WMI_CIPHER_TKIP, true),
+            _ => return Err(radio::Error::Unsupported),
+        };
+        // `ath11k_mac_op_set_key`'s peer: the station's, the access
+        // point's, or as an access point its own for the group's key.
+        let address = if self.ap.is_some() {
+            if key.pairwise { key.address.ok_or(radio::Error::Invalid)? } else { self.address }
+        } else {
+            self.network.as_ref().ok_or(radio::Error::Invalid)?.join.bssid
+        };
+        let flags = if key.pairwise { WMI_KEY_PAIRWISE } else { WMI_KEY_GROUP };
+        let mut seq = [0u8; 8];
+        let len = key.seq.len().min(8);
+        seq[..len].copy_from_slice(&key.seq[..len]);
+        self.install(&address, key.index as u32, flags, cipher, &key.key, u64::from_le_bytes(seq), mic)?;
+        if key.pairwise {
+            self.dp.pn_check(&self.hal, &self.bus, address, true);
+        }
+        match &mut self.ap {
+            Some(ap) if key.pairwise => {
+                if let Some(station) = ap.stations.get_mut(&address) {
+                    station.key = true;
+                }
+            }
+            Some(ap) => ap.group_key = true,
+            None if key.pairwise => {
+                self.keys.0 = true;
+                self.pairwise_mic = if matches!(key.cipher, radio::CIPHER_CCMP | radio::CIPHER_TKIP) { 8 } else { 16 };
+            }
+            None => self.keys.1 = true,
+        }
+        Ok(())
+    }
+
+    fn install(&mut self, address: &Address, index: u32, flags: u32, cipher: u32, key: &[u8], rsc: u64, mic: bool) -> radio::Result<()> {
+        self.key_status = None;
+        self.wmi(wmi::install_key(VDEV, address, index, flags, cipher, key, rsc, mic)).map_err(|_| radio::Error::Failed)?;
+        if !self.wait(1000, |card| card.key_status.is_some()) || self.key_status != Some(0) {
+            ostd::warn!("{}: the firmware did not take the key ({:?})", self.name, self.key_status);
+            return Err(radio::Error::Failed);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn remove_key(&mut self, index: u8, pairwise: bool) {
+        if self.ap.is_some() {
+            // A station's pairwise key goes with its peer; the group's is
+            // on the access point's own.
+            if !pairwise {
+                if let Some(ap) = &mut self.ap {
+                    ap.group_key = false;
+                }
+                let address = self.address;
+                let _ = self.install(&address, index as u32, WMI_KEY_GROUP, WMI_CIPHER_NONE, &[], 0, false);
+            }
+            return;
+        }
+        let Some(network) = &self.network else { return };
+        let bssid = network.join.bssid;
+        let flags = if pairwise { WMI_KEY_PAIRWISE } else { WMI_KEY_GROUP };
+        let _ = self.install(&bssid, index as u32, flags, WMI_CIPHER_NONE, &[], 0, false);
+        if pairwise {
+            self.keys.0 = false;
+            self.dp.pn_check(&self.hal, &self.bus, bssid, false);
+        } else {
+            self.keys.1 = false;
+        }
+    }
+
+    /// The access point's peer may pass data (`WMI_PEER_AUTHORIZE`).
+    pub(crate) fn authorize(&mut self, authorized: bool) {
+        let Some(network) = &self.network else { return };
+        let bssid = network.join.bssid;
+        let _ = self.wmi(wmi::peer_set_param(VDEV, &bssid, WMI_PEER_AUTHORIZE, authorized as u32));
+    }
+
+    // ---- As an access point (`ath11k_mac_op_add_interface` for an AP,
+    // `ath11k_mac_op_bss_info_changed`, `ath11k_mac_op_sta_state`). ----
+
+    /// The vdev made an access point's, its beacon's settings and template,
+    /// started on the channel, up (`ath11k_control_beaconing`).
+    pub(crate) fn start_ap(&mut self, config: &ApConfig) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        self.stop_ap();
+        self.leave();
+        self.end_scan();
+        self.change_interface(true)?;
+        self.ap = Some(Ap::new(config));
+        let result = self.ap_up(config);
+        if result.is_err() {
+            self.stop_ap();
+        }
+        result
+    }
+
+    /// mac80211's order: the channel (the vdev started), then the beacon's
+    /// interval, DTIM and template, then beaconing.
+    fn ap_up(&mut self, config: &ApConfig) -> radio::Result<()> {
+        let fail = |_| radio::Error::Failed;
+        self.vdev_start(config.chandef, config.beacon_interval, config.dtim_period, &config.ssid, config.hidden)?;
+        if let Some(ap) = &mut self.ap {
+            ap.started = true;
+        }
+        self.wmi(wmi::vdev_set_param(VDEV, WMI_VDEV_PARAM_BEACON_INTERVAL, config.beacon_interval.max(1) as u32)).map_err(fail)?;
+        self.wmi(wmi::vdev_set_param(VDEV, WMI_VDEV_PARAM_DTIM_PERIOD, config.dtim_period.max(1) as u32)).map_err(fail)?;
+        self.beacon_settings(&config.beacon)?;
+        let (he, he_ops) = self.ap.as_ref().map_or((false, 0), |ap| (ap.he, ap.he_ops));
+        if he {
+            let _ = self.wmi(wmi::vdev_set_param(VDEV, WMI_VDEV_PARAM_BA_MODE, WMI_BA_MODE_BUFFER_SIZE_256));
+            let color = if he_ops & HE_OPERATION_BSS_COLOR_DISABLED != 0 { HE_OPERATION_BSS_COLOR_DISABLED } else { he_ops & HE_OPERATION_BSS_COLOR_MASK };
+            let _ = self.wmi(wmi::vdev_set_param(VDEV, WMI_VDEV_PARAM_BSS_COLOR, color));
+        }
+        let address = self.address;
+        self.wmi(wmi::vdev_up(VDEV, 0, &address)).map_err(fail)?;
+        if let Some(ap) = &mut self.ap {
+            ap.up = true;
+        }
+        if he && he_ops != 0 {
+            let _ = self.wmi(wmi::vdev_set_param(VDEV, WMI_VDEV_PARAM_HEOPS_0_31, he_ops));
+        }
+        Ok(())
+    }
+
+    /// The beacon's template and what follows from its capabilities: the
+    /// slot and the preamble.
+    fn beacon_settings(&mut self, beacon: &BeaconTemplate) -> radio::Result<()> {
+        let Some(ap) = &self.ap else { return Err(radio::Error::Down) };
+        let ghz2 = BandId::of(ap.config.chandef.control) == BandId::Ghz2;
+        let frame = beacon.frame(ap.config.dtim_period);
+        let capability = beacon.capability();
+        let short_slot = !ghz2 || capability & wifi::CAP_SHORT_SLOT != 0;
+        let short_preamble = capability & wifi::CAP_SHORT_PREAMBLE != 0;
+        let _ = self.wmi(wmi::vdev_set_param(VDEV, WMI_VDEV_PARAM_SLOT_TIME, if short_slot { WMI_VDEV_SLOT_TIME_SHORT } else { WMI_VDEV_SLOT_TIME_LONG }));
+        let _ = self.wmi(wmi::vdev_set_param(VDEV, WMI_VDEV_PARAM_PREAMBLE, if short_preamble { WMI_VDEV_PREAMBLE_SHORT } else { WMI_VDEV_PREAMBLE_LONG }));
+        self.wmi(wmi::pdev_set_param(self.pdev_id, WMI_PDEV_PARAM_BEACON_TX_MODE, WMI_BEACON_STAGGERED_MODE)).map_err(|_| radio::Error::Failed)?;
+        self.wmi(wmi::bcn_tmpl(VDEV, beacon.tim_offset() as u32, &frame)).map_err(|_| radio::Error::Failed)
+    }
+
+    pub(crate) fn set_beacon(&mut self, beacon: &BeaconTemplate) -> radio::Result<()> {
+        let Some(ap) = &mut self.ap else { return Err(radio::Error::Down) };
+        ap.read_beacon(beacon);
+        self.beacon_settings(beacon)
+    }
+
+    /// The stations' peers gone, the vdev down and stopped, then a
+    /// station's again.
+    pub(crate) fn stop_ap(&mut self) {
+        let Some(ap) = self.ap.take() else { return };
+        if !self.dead && ap.up {
+            let _ = self.wmi(wmi::vdev_down(VDEV));
+        }
+        for address in ap.stations.keys() {
+            self.delete_peer(*address);
+        }
+        if !self.dead && ap.started {
+            self.stop_vdev();
+        }
+        if !self.dead {
+            let _ = self.change_interface(false);
+        }
+    }
+
+    /// `ath11k_mac_station_add` and `ath11k_station_assoc`: the station's
+    /// peer, its queues, its capabilities.
+    pub(crate) fn add_station(&mut self, station: &StationEntry) -> radio::Result<()> {
+        let Some(ap) = &self.ap else { return Err(radio::Error::Down) };
+        let (chandef, he_ops, rsn, wpa) = (ap.config.chandef, ap.he_ops, ap.rsn, ap.wpa);
+        let address = station.address;
+        if ap.stations.contains_key(&address) {
+            self.remove_station(&address);
+        }
+        self.create_peer(address)?;
+        if let Some(ap) = &mut self.ap {
+            ap.stations.insert(address, ApStation { qos: station.peer.qos, key: false });
+        }
+        let params = PeerParams {
+            address,
+            aid: station.aid,
+            capability: station.capability,
+            listen_interval: station.listen_interval as u32,
+            peer: &station.peer,
+            chandef,
+            he_ops,
+            rsn,
+            wpa,
+        };
+        let assoc = self.peer_assoc(&params);
+        let result = self.peer_setup(address).and_then(|()| self.send_peer_assoc(&assoc));
+        if result.is_err() {
+            self.remove_station(&address);
+        }
+        result
+    }
+
+    pub(crate) fn remove_station(&mut self, address: &Address) {
+        let Some(ap) = &mut self.ap else { return };
+        if ap.stations.remove(address).is_some() {
+            self.delete_peer(*address);
+        }
+    }
+
+    pub(crate) fn authorize_station(&mut self, address: &Address, authorized: bool) {
+        if self.ap.as_ref().is_some_and(|ap| ap.stations.contains_key(address)) {
+            let _ = self.wmi(wmi::peer_set_param(VDEV, address, WMI_PEER_AUTHORIZE, authorized as u32));
+        }
+    }
+
+    // ---- Frames. ----
+
+    /// `ath11k_mac_mgmt_tx_wmi`: the frame in DMA memory until the firmware
+    /// says it went, its sequence number set; unprotected (no 802.11w).
+    pub(crate) fn send_management(&mut self, frame: &[u8]) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if frame.len() < wifi::HEADER || frame.len() > 2048 {
+            return Err(radio::Error::Invalid);
+        }
+        if self.mgmt.len() >= MGMT_PENDING {
+            self.service();
+            if self.mgmt.len() >= MGMT_PENDING {
+                return Err(radio::Error::Busy);
+            }
+        }
+        let mut frame = frame.to_vec();
+        frame[1] &= !wifi::PROTECTED;
+        let sequence = self.sequence;
+        self.sequence = (sequence + 1) & 0x0fff;
+        frame[22..24].copy_from_slice(&(sequence << 4).to_le_bytes());
+        let mem = alloc_coherent32(frame.len()).ok_or(radio::Error::Failed)?;
+        let _ = mem.write_bytes(0, &frame);
+        let id = self.mgmt_next;
+        self.mgmt_next = self.mgmt_next.wrapping_add(1);
+        let paddr = mem.daddr() as u64;
+        self.mgmt.insert(id, mem);
+        if self.wmi(wmi::mgmt_send(VDEV, id, paddr, &frame)).is_err() {
+            self.mgmt.remove(&id);
+            return Err(radio::Error::Busy);
+        }
+        Ok(())
+    }
+
+    /// A data frame as native Wi-Fi (no QoS control; its TID in the
+    /// descriptor); the chip encrypts with the pairwise key when it has
+    /// one.
+    pub(crate) fn send(&mut self, ethernet: &[u8], plain: bool) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        let (frame, qos) = if let Some(ap) = &self.ap {
+            // From the access point (FromDS) to the station the
+            // destination names, or to all of them with the group's key.
+            let destination: Address = ethernet.get(..6).and_then(|b| b.try_into().ok()).ok_or(radio::Error::Invalid)?;
+            let (keyed, qos) = if wifi::is_multicast(&destination) {
+                (ap.group_key, ap.qos)
+            } else {
+                let station = ap.stations.get(&destination).ok_or(radio::Error::Invalid)?;
+                (station.key, station.qos)
+            };
+            (wifi::data_from_ethernet_ap(ethernet, &self.address, None, !plain && keyed).ok_or(radio::Error::Invalid)?, qos)
+        } else {
+            let Some(network) = &self.network else { return Err(radio::Error::Down) };
+            let protected = !plain && self.keys.0;
+            (wifi::data_from_ethernet(ethernet, &network.join.bssid, None, protected).ok_or(radio::Error::Invalid)?, self.qos)
+        };
+        let tid = if qos { wifi::tid_of(ethernet) as u32 } else { HAL_DESC_REO_NON_QOS_TID };
+        self.dp.send(&self.hal, &self.bus, &frame, tid).map_err(|()| radio::Error::Busy)
+    }
+
+    pub(crate) fn link_stats(&self) -> LinkStats {
+        LinkStats { signal: self.signal, tx_rate: None }
+    }
+
+    // ---- What the chip says. ----
+
+    pub(crate) fn poll(&mut self) {
+        if self.dead {
+            return;
+        }
+        self.service();
+        if self.scan.as_ref().is_some_and(|scan| scan.running) {
+            self.scan_step();
+        }
+    }
+
+    fn died(&mut self, why: &str) {
+        ostd::warn!("{}: {}", self.name, why);
+        self.dead = true;
+        if let Some(device) = &self.device {
+            if self.scan.take().is_some() {
+                device.scan_done(true);
+            }
+            device.connection_lost();
+        }
+    }
+}
+
+/// `ath11k_peer_assoc_h_phymode`.
+fn phymode(ghz2: bool, width: Width, peer: &Peer) -> u32 {
+    if ghz2 {
+        if peer.he.is_some() {
+            match width {
+                Width::W40 => MODE_11AX_HE40_2G,
+                _ => MODE_11AX_HE20_2G,
+            }
+        } else if peer.vht.is_some() {
+            if width == Width::W40 { MODE_11AC_VHT40 } else { MODE_11AC_VHT20 }
+        } else if peer.ht.is_some() {
+            if width == Width::W40 { MODE_11NG_HT40 } else { MODE_11NG_HT20 }
+        } else if peer.rates.iter().any(|&rate| !CCK_RATES.contains(&(rate & 0x7f))) {
+            MODE_11G
+        } else {
+            MODE_11B
+        }
+    } else if let Some(he) = &peer.he {
+        match width {
+            Width::W160 if he.phy[0] & wchan::HE_PHY_160_IN_5G != 0 => MODE_11AX_HE160,
+            Width::W160 if he.phy[0] & wchan::HE_PHY_80P80_IN_5G != 0 => MODE_11AX_HE80_80,
+            Width::W160 => MODE_11AX_HE160,
+            Width::W80 => MODE_11AX_HE80,
+            Width::W40 => MODE_11AX_HE40,
+            _ => MODE_11AX_HE20,
+        }
+    } else if let Some(vht) = &peer.vht {
+        match width {
+            Width::W160 if vht.info & (VHT_CAP_SUPP_WIDTH_160 | VHT_CAP_SUPP_WIDTH_160_80P80) == VHT_CAP_SUPP_WIDTH_160_80P80 => MODE_11AC_VHT80_80,
+            Width::W160 => MODE_11AC_VHT160,
+            Width::W80 => MODE_11AC_VHT80,
+            Width::W40 => MODE_11AC_VHT40,
+            _ => MODE_11AC_VHT20,
+        }
+    } else if peer.ht.is_some() {
+        if width >= Width::W40 { MODE_11NA_HT40 } else { MODE_11NA_HT20 }
+    } else {
+        MODE_11A
+    }
+}
+
+/// The access classes' EDCA parameters (BE, BK, VI, VO: CWmin, CWmax,
+/// AIFSN, TXOP) from a WMM parameter element.
+fn wmm_params(elements: &[u8]) -> Option<[[u32; 4]; 4]> {
+    let value = Elements(elements).vendor(wifi::WMM_OUI_TYPE)?;
+    // Subtype 1 (parameters), version, QoS info, reserved, then four
+    // records of ACI/AIFSN, ECWmin/ECWmax, TXOP.
+    if value.len() < 4 + 16 || value[0] != 1 {
+        return None;
+    }
+    let mut out = [[0u32; 4]; 4];
+    for record in value[4..20].chunks_exact(4) {
+        let aci = ((record[0] >> 5) & 3) as usize;
+        let aifsn = (record[0] & 0x0f) as u32;
+        let (ecw_min, ecw_max) = ((record[1] & 0x0f) as u32, (record[1] >> 4) as u32);
+        let txop = u16::from_le_bytes([record[2], record[3]]) as u32;
+        out[aci] = [(1 << ecw_min) - 1, (1 << ecw_max) - 1, aifsn, txop];
+    }
+    Some(out)
+}
diff --git a/kernel/comps/ath11k/src/wlfw.rs b/kernel/comps/ath11k/src/wlfw.rs
new file mode 100644
index 0000000..c55c303
--- /dev/null
+++ b/kernel/comps/ath11k/src/wlfw.rs
@@ -0,0 +1,461 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The WLAN firmware's QMI service (WLFW) as Linux's ath11k `qmi.c` drives
+//! it to boot the firmware: indications registered, the host's
+//! capabilities, the memory the firmware asks for, the board data
+//! (`board-2.bin`) and regulatory database, the M3 image, then once the
+//! firmware is ready its copy engines' configuration and mission mode.
+
+use alloc::{collections::VecDeque, format, string::String, vec::Vec};
+
+use aster_linuxkpi::{
+    bits::{get_le32, put_le32, put_le64},
+    dma::alloc_coherent32,
+    firmware::request_firmware_nowarn,
+};
+use ostd::mm::{HasDaddr, VmIo, dma::DmaCoherent};
+
+use crate::{
+    WAKER,
+    mhi::Mhi,
+    now_ms,
+    pci::Bus,
+    qrtr::{QMI_INDICATION, QMI_RESPONSE, QmiMessage, Qrtr, Tlvs},
+    regs::*,
+};
+
+/// The WLFW service's id and version (`ATH11K_QMI_WLFW_SERVICE_*`).
+const SERVICE_ID: u32 = 0x45;
+const SERVICE_VERSION: u32 = 1;
+const TIMEOUT_MS: u64 = ATH11K_QMI_WLANFW_TIMEOUT_MS as u64;
+/// The firmware takes at most this many memory segments before it gives
+/// up on the large ones (Linux's "delayed" answer).
+const FEW_SEGMENTS: usize = ATH11K_QMI_FW_MEM_REQ_SEGMENT_CNT as usize;
+const MODE_NORMAL: u32 = 0;
+/// `nm_modem`'s bits (`qmi.c`).
+const SLEEP_CLOCK_SELECT_INTERNAL_BIT: u8 = 0x02;
+const HOST_CSTATE_BIT: u8 = 0x04;
+const PLATFORM_CAP_PCIE_GLOBAL_RESET: u8 = 0x08;
+const PLATFORM_CAP_PCIE_PME_D3COLD: u8 = 0x10;
+/// The board file's elements (`hw.h`).
+const BOARD_MAGIC: &[u8] = b"QCA-ATH11K-BOARD";
+const BD_IE_BOARD: u32 = 0;
+const BD_IE_REGDB: u32 = 1;
+const BD_IE_NAME: u32 = 0;
+const BD_IE_DATA: u32 = 1;
+
+/// The PCI ids the board name is made of.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Ids {
+    pub(crate) vendor: u16,
+    pub(crate) device: u16,
+    pub(crate) subsystem_vendor: u16,
+    pub(crate) subsystem_device: u16,
+}
+
+/// What the firmware said of itself (`struct ath11k_qmi_target_info`).
+#[derive(Clone, Debug, Default)]
+pub(crate) struct Target {
+    pub(crate) chip_id: u32,
+    pub(crate) board_id: u32,
+    pub(crate) soc_id: u32,
+    pub(crate) fw_version: u32,
+    pub(crate) build: String,
+    pub(crate) eeprom_caldata: bool,
+}
+
+pub(crate) struct Wlfw {
+    pub(crate) qrtr: Qrtr,
+    /// The memory given to the firmware, and its M3 image: kept while it
+    /// runs.
+    memory: Vec<DmaCoherent>,
+    m3: Option<DmaCoherent>,
+    pending: VecDeque<QmiMessage>,
+    pub(crate) target: Target,
+}
+
+/// `{id, len, data aligned to 4}` after the magic and its NUL.
+fn elements(data: &[u8]) -> Option<Vec<(u32, &[u8])>> {
+    if data.len() <= BOARD_MAGIC.len() || &data[..BOARD_MAGIC.len()] != BOARD_MAGIC || data[BOARD_MAGIC.len()] != 0 {
+        return None;
+    }
+    let mut at = (BOARD_MAGIC.len() + 1).next_multiple_of(4);
+    let mut out = Vec::new();
+    while at + 8 <= data.len() {
+        let (id, len) = (get_le32(data, at), get_le32(data, at + 4) as usize);
+        at += 8;
+        out.push((id, data.get(at..at + len)?));
+        at += len.next_multiple_of(4);
+    }
+    Some(out)
+}
+
+/// `ath11k_core_fetch_board_data_api_n`: the data under a name, in the
+/// board (or regulatory database) elements.
+fn board_data(file: &[u8], ie: u32, name: &str) -> Option<Vec<u8>> {
+    for (id, container) in elements(file)? {
+        if id != ie {
+            continue;
+        }
+        let mut at = 0;
+        let mut matched = false;
+        while at + 8 <= container.len() {
+            let (sub, len) = (get_le32(container, at), get_le32(container, at + 4) as usize);
+            let value = container.get(at + 8..at + 8 + len)?;
+            match sub {
+                BD_IE_NAME => matched = value == name.as_bytes(),
+                BD_IE_DATA if matched => return Some(value.to_vec()),
+                _ => {}
+            }
+            at += 8 + len.next_multiple_of(4);
+        }
+    }
+    None
+}
+
+impl Wlfw {
+    pub(crate) fn new(instance: u32) -> Self {
+        Self { qrtr: Qrtr::new(SERVICE_ID, SERVICE_VERSION, instance), memory: Vec::new(), m3: None, pending: VecDeque::new(), target: Target::default() }
+    }
+
+    /// QRTR's packets read until a QMI message comes (or the time is up).
+    fn pump(&mut self, bus: &Bus, mhi: &mut Mhi) -> Option<QmiMessage> {
+        mhi.process(bus);
+        while let Some(packet) = mhi.received.pop_front() {
+            if let Some(message) = self.qrtr.receive(bus, mhi, &packet) {
+                return Some(message);
+            }
+        }
+        None
+    }
+
+    /// The service announced (`ath11k_qmi_ops_new_server`).
+    pub(crate) fn find_server(&mut self, bus: &Bus, mhi: &mut Mhi) -> Result<(), &'static str> {
+        self.qrtr.hello(bus, mhi).map_err(|()| "QRTR's hello did not go out")?;
+        let deadline = now_ms() + TIMEOUT_MS;
+        while self.qrtr.server.is_none() {
+            if let Some(message) = self.pump(bus, mhi) {
+                self.pending.push_back(message);
+            }
+            if mhi.error {
+                return Err("the firmware crashed");
+            }
+            if now_ms() >= deadline {
+                return Err("the firmware's WLFW service did not appear");
+            }
+            WAKER.msleep(5);
+        }
+        Ok(())
+    }
+
+    /// A request and its response; indications that come meanwhile wait.
+    fn call(&mut self, bus: &Bus, mhi: &mut Mhi, id: u16, tlvs: &Tlvs) -> Result<QmiMessage, &'static str> {
+        let txn = self.qrtr.request(bus, mhi, id, tlvs).map_err(|()| "a QMI request did not go out")?;
+        let deadline = now_ms() + TIMEOUT_MS;
+        loop {
+            while let Some(message) = self.pump(bus, mhi) {
+                if message.kind == QMI_RESPONSE && message.txn == txn && message.id == id {
+                    return Ok(message);
+                }
+                if message.kind == QMI_INDICATION {
+                    self.pending.push_back(message);
+                }
+            }
+            if mhi.error || self.qrtr.gone {
+                return Err("the firmware went away");
+            }
+            if now_ms() >= deadline {
+                return Err("the firmware did not answer a QMI request");
+            }
+            WAKER.msleep(2);
+        }
+    }
+
+    fn call_ok(&mut self, bus: &Bus, mhi: &mut Mhi, id: u16, tlvs: &Tlvs, what: &'static str) -> Result<QmiMessage, &'static str> {
+        let answer = self.call(bus, mhi, id, tlvs)?;
+        if let Err(error) = answer.result() {
+            ostd::warn!("ath11k: {}: QMI error {}", what, error);
+            return Err(what);
+        }
+        Ok(answer)
+    }
+
+    /// The next indication of one of `ids`.
+    fn indication(&mut self, bus: &Bus, mhi: &mut Mhi, ids: &[u16], timeout_ms: u64) -> Result<QmiMessage, &'static str> {
+        let deadline = now_ms() + timeout_ms;
+        loop {
+            if let Some(index) = self.pending.iter().position(|message| ids.contains(&message.id)) {
+                return Ok(self.pending.remove(index).unwrap());
+            }
+            if let Some(message) = self.pump(bus, mhi) {
+                if message.kind == QMI_INDICATION {
+                    self.pending.push_back(message);
+                }
+                continue;
+            }
+            if mhi.error || self.qrtr.gone {
+                return Err("the firmware went away");
+            }
+            if now_ms() >= deadline {
+                return Err("the firmware did not send the indication waited for");
+            }
+            WAKER.msleep(5);
+        }
+    }
+
+    // ---- The boot (`ath11k_qmi_event_server_arrive` and what follows). ----
+
+    pub(crate) fn boot(&mut self, bus: &Bus, mhi: &mut Mhi, ids: Ids) -> Result<(), &'static str> {
+        let hw = bus.hw;
+        // `ath11k_qmi_fw_ind_register_send`.
+        let mut tlvs = Tlvs::new();
+        tlvs.u8(0x10, 1).u32(0x15, QMI_WLANFW_CLIENT_ID).u8(0x16, 1).u8(0x17, 1).u8(0x18, 1).u8(0x1b, 1);
+        self.call_ok(bus, mhi, QMI_WLANFW_IND_REGISTER_REQ_V01 as u16, &tlvs, "indication register")?;
+        // `ath11k_qmi_host_cap_send`.
+        let mut nm_modem = PLATFORM_CAP_PCIE_PME_D3COLD;
+        if hw.internal_sleep_clock {
+            nm_modem |= HOST_CSTATE_BIT | SLEEP_CLOCK_SELECT_INTERNAL_BIT;
+        }
+        if hw.global_reset {
+            nm_modem |= PLATFORM_CAP_PCIE_GLOBAL_RESET;
+        }
+        let mut tlvs = Tlvs::new();
+        tlvs.u32(0x10, 1);
+        if hw.internal_sleep_clock {
+            tlvs.u8(0x13, nm_modem);
+        }
+        tlvs.u8(0x14, 1).u8(0x16, 1).u8(0x17, 1).u8(0x1a, 0).u8(0x1c, hw.fw_mem_mode);
+        self.call_ok(bus, mhi, QMI_WLANFW_HOST_CAP_REQ_V01 as u16, &tlvs, "host capabilities")?;
+        // The firmware asks for memory (perhaps twice: the large blocks
+        // refused, it asks for smaller ones), then says it holds it.
+        loop {
+            let message = self.indication(bus, mhi, &[QMI_WLFW_REQUEST_MEM_IND_V01 as u16, QMI_WLFW_FW_MEM_READY_IND_V01 as u16], TIMEOUT_MS)?;
+            if message.id == QMI_WLFW_FW_MEM_READY_IND_V01 as u16 {
+                break;
+            }
+            self.respond_memory(bus, mhi, &message)?;
+        }
+        self.request_target_cap(bus, mhi)?;
+        if hw.supports_regdb {
+            // Optional: the firmware has a built-in database.
+            if let Err(error) = self.load_regdb(bus, mhi, ids) {
+                ostd::info!("ath11k: no regulatory database loaded ({})", error);
+            }
+        }
+        self.load_bdf(bus, mhi, ids)?;
+        self.load_m3(bus, mhi)?;
+        // The firmware runs (`ath11k_qmi_msg_fw_ready_cb`).
+        self.indication(bus, mhi, &[QMI_WLFW_FW_READY_IND_V01 as u16, QMI_WLFW_FW_INIT_DONE_IND_V01 as u16], 2 * TIMEOUT_MS)?;
+        Ok(())
+    }
+
+    /// `ath11k_qmi_respond_fw_mem_request` after
+    /// `ath11k_qmi_alloc_target_mem_chunk`.
+    fn respond_memory(&mut self, bus: &Bus, mhi: &mut Mhi, message: &QmiMessage) -> Result<(), &'static str> {
+        let value = message.tlvs.get(&0x01).ok_or("a memory request without segments")?;
+        let count = *value.first().unwrap_or(&0) as usize;
+        let mut segments = Vec::new();
+        let mut at = 1;
+        for _ in 0..count {
+            let (size, kind) = (get_le32(value.get(at..at + 4).ok_or("memory request")?, 0), get_le32(value.get(at + 4..at + 8).ok_or("memory request")?, 0));
+            let cfg = *value.get(at + 8).ok_or("memory request")? as usize;
+            at += 9 + cfg * 13;
+            segments.push((size, kind));
+        }
+        self.memory.clear();
+        let mut delayed = false;
+        for (size, _) in &segments {
+            match alloc_coherent32(*size as usize) {
+                Some(block) => self.memory.push(block),
+                None if segments.len() <= FEW_SEGMENTS => {
+                    delayed = true;
+                    break;
+                }
+                None => return Err("no memory for the firmware"),
+            }
+        }
+        let mut list = Vec::new();
+        if delayed {
+            self.memory.clear();
+            list.push(0u8);
+        } else {
+            list.push(segments.len() as u8);
+            for ((size, kind), block) in segments.iter().zip(&self.memory) {
+                let mut entry = [0u8; 17];
+                put_le64(&mut entry, 0, block.daddr() as u64);
+                put_le32(&mut entry, 8, *size);
+                put_le32(&mut entry, 12, *kind);
+                list.extend_from_slice(&entry);
+            }
+        }
+        let mut tlvs = Tlvs::new();
+        tlvs.bytes(0x01, &list);
+        let answer = self.call(bus, mhi, QMI_WLANFW_RESPOND_MEM_REQ_V01 as u16, &tlvs)?;
+        // A refusal is what a delayed answer gets.
+        if !delayed && answer.result().is_err() {
+            return Err("the firmware refused the memory given");
+        }
+        Ok(())
+    }
+
+    /// `ath11k_qmi_request_target_cap`.
+    fn request_target_cap(&mut self, bus: &Bus, mhi: &mut Mhi) -> Result<(), &'static str> {
+        let answer = self.call_ok(bus, mhi, QMI_WLANFW_CAP_REQ_V01 as u16, &Tlvs::new(), "capabilities")?;
+        let mut target = Target { board_id: 0xff, ..Target::default() };
+        if let Some(chip) = answer.u32(0x10) {
+            target.chip_id = chip;
+        }
+        if let Some(board) = answer.u32(0x11) {
+            target.board_id = board;
+        }
+        if let Some(soc) = answer.u32(0x12) {
+            target.soc_id = soc;
+        }
+        if let Some(version) = answer.u32(0x13) {
+            target.fw_version = version;
+        }
+        if let Some(build) = answer.tlvs.get(&0x14) {
+            target.build = String::from_utf8_lossy(build).trim_end_matches('\0').into();
+        }
+        target.eeprom_caldata = answer.u32(0x19).is_some_and(|timeout| timeout != 0);
+        self.target = target;
+        Ok(())
+    }
+
+    /// The board names tried in order (`ath11k_core_fetch_bdf`).
+    fn board_names(&self, bus: &Bus, ids: Ids) -> Vec<String> {
+        let t = &self.target;
+        let full = if bus.hw.bdf_bus_and_board {
+            format!(
+                "bus=pci,vendor={:04x},device={:04x},subsystem-vendor={:04x},subsystem-device={:04x},qmi-chip-id={},qmi-board-id={}",
+                ids.vendor, ids.device, ids.subsystem_vendor, ids.subsystem_device, t.chip_id, t.board_id
+            )
+        } else {
+            format!("bus=pci,qmi-chip-id={},qmi-board-id={}", t.chip_id, t.board_id)
+        };
+        alloc::vec![full, format!("bus=pci,qmi-chip-id={}", t.chip_id)]
+    }
+
+    fn file(bus: &Bus, name: &str) -> Option<alloc::sync::Arc<[u8]>> {
+        request_firmware_nowarn(&format!("ath11k/{}/{}", bus.hw.fw_dir, name))
+    }
+
+    /// `ath11k_qmi_load_bdf_qmi(ab, false)`.
+    fn load_bdf(&mut self, bus: &Bus, mhi: &mut Mhi, ids: Ids) -> Result<(), &'static str> {
+        let names = self.board_names(bus, ids);
+        let data = Self::file(bus, "board-2.bin")
+            .and_then(|file| names.iter().find_map(|name| board_data(&file, BD_IE_BOARD, name)))
+            .or_else(|| Self::file(bus, "board.bin").map(|file| file.to_vec()));
+        let Some(data) = data else {
+            ostd::warn!("ath11k: no board data for {} in ath11k/{}/board-2.bin", names[0], bus.hw.fw_dir);
+            return Err("no board data");
+        };
+        let elf = data.starts_with(b"\x7fELF");
+        let size = data.len().min(bus.hw.board_size);
+        let kind = if elf { ATH11K_QMI_BDF_TYPE_ELF } else { ATH11K_QMI_BDF_TYPE_BIN };
+        self.download(bus, mhi, &data[..size], kind, true)?;
+        // The QCA6390 family's ELF board data holds its calibration.
+        if elf {
+            return Ok(());
+        }
+        if self.target.eeprom_caldata {
+            return self.download(bus, mhi, &[], ATH11K_QMI_FILE_TYPE_EEPROM, false);
+        }
+        let cal = Self::file(bus, "caldata.bin").ok_or("no calibration data (caldata.bin)")?;
+        let size = cal.len().min(bus.hw.board_size);
+        self.download(bus, mhi, &cal[..size], ATH11K_QMI_FILE_TYPE_CALDATA, true)
+    }
+
+    /// `ath11k_qmi_load_bdf_qmi(ab, true)`: the regulatory database.
+    fn load_regdb(&mut self, bus: &Bus, mhi: &mut Mhi, ids: Ids) -> Result<(), &'static str> {
+        let names = self.board_names(bus, ids);
+        let data = Self::file(bus, "board-2.bin")
+            .and_then(|file| names.iter().chain(core::iter::once(&String::from("bus=pci"))).find_map(|name| board_data(&file, BD_IE_REGDB, name)))
+            .or_else(|| Self::file(bus, "regdb.bin").map(|file| file.to_vec()))
+            .ok_or("no regdb.bin")?;
+        self.download(bus, mhi, &data, ATH11K_QMI_BDF_TYPE_REGDB, true)
+    }
+
+    /// `ath11k_qmi_load_file_target_mem`: a file in 6 KiB segments (or
+    /// only its type, for data the firmware reads from its EEPROM).
+    fn download(&mut self, bus: &Bus, mhi: &mut Mhi, data: &[u8], kind: u32, with_data: bool) -> Result<(), &'static str> {
+        let mut remaining = data.len();
+        let mut seg_id = 0u32;
+        let mut offset = 0;
+        loop {
+            let chunk = remaining.min(QMI_WLANFW_MAX_DATA_SIZE_V01 as usize);
+            let end = !with_data || chunk == remaining;
+            let mut tlvs = Tlvs::new();
+            tlvs.u8(0x01, 1).u32(0x10, self.target.board_id).u32(0x11, remaining as u32).u32(0x12, seg_id);
+            if with_data {
+                let mut value = Vec::with_capacity(2 + chunk);
+                value.extend_from_slice(&(chunk as u16).to_le_bytes());
+                value.extend_from_slice(&data[offset..offset + chunk]);
+                tlvs.bytes(0x13, &value);
+            }
+            tlvs.u8(0x14, end as u8).u8(0x15, kind as u8);
+            self.call_ok(bus, mhi, QMI_WLANFW_BDF_DOWNLOAD_REQ_V01 as u16, &tlvs, "board data download")?;
+            if end {
+                return Ok(());
+            }
+            remaining -= chunk;
+            offset += chunk;
+            seg_id += 1;
+        }
+    }
+
+    /// `ath11k_qmi_wlanfw_m3_info_send` with `ath11k_qmi_m3_load`.
+    fn load_m3(&mut self, bus: &Bus, mhi: &mut Mhi) -> Result<(), &'static str> {
+        let file = Self::file(bus, "m3.bin").ok_or("m3.bin is missing")?;
+        let m3 = alloc_coherent32(file.len()).ok_or("no memory for the M3 image")?;
+        m3.write_bytes(0, &file).map_err(|_| "M3 image")?;
+        let mut tlvs = Tlvs::new();
+        tlvs.u64(0x01, m3.daddr() as u64).u32(0x02, file.len() as u32);
+        self.m3 = Some(m3);
+        self.call_ok(bus, mhi, QMI_WLANFW_M3_INFO_REQ_V01 as u16, &tlvs, "M3 information")?;
+        Ok(())
+    }
+
+    /// `ath11k_qmi_firmware_start`: the log enabled, the copy engines'
+    /// configuration (and the shadow registers'), mission mode.
+    pub(crate) fn start(&mut self, bus: &Bus, mhi: &mut Mhi, shadow: &[u32]) -> Result<(), &'static str> {
+        let hw = bus.hw;
+        if hw.wmi_diag_event {
+            let mut tlvs = Tlvs::new();
+            tlvs.u8(0x10, 1);
+            self.call_ok(bus, mhi, QMI_WLANFW_WLAN_INI_REQ_V01 as u16, &tlvs, "firmware log")?;
+        }
+        let mut tlvs = Tlvs::new();
+        tlvs.bytes(0x10, ATH11K_HOST_VERSION_STRING.as_bytes());
+        let mut ce = alloc::vec![hw.target_ce.len() as u8];
+        for pipe in hw.target_ce {
+            for value in [pipe.pipenum, pipe.pipedir, pipe.nentries, pipe.nbytes_max, pipe.flags] {
+                ce.extend_from_slice(&value.to_le_bytes());
+            }
+        }
+        tlvs.bytes(0x11, &ce);
+        let mut svc = alloc::vec![hw.svc_map.len() as u8];
+        for map in hw.svc_map {
+            for value in [map.service_id, map.pipedir, map.pipenum] {
+                svc.extend_from_slice(&value.to_le_bytes());
+            }
+        }
+        tlvs.bytes(0x12, &svc);
+        if hw.shadow_regs {
+            let count = shadow.len().min(QMI_WLANFW_MAX_NUM_SHADOW_REG_V2_V01 as usize);
+            let mut list = alloc::vec![count as u8];
+            for addr in &shadow[..count] {
+                list.extend_from_slice(&addr.to_le_bytes());
+            }
+            tlvs.bytes(0x14, &list);
+        }
+        self.call_ok(bus, mhi, QMI_WLANFW_WLAN_CFG_REQ_V01 as u16, &tlvs, "copy engine configuration")?;
+        let mut tlvs = Tlvs::new();
+        tlvs.u32(0x01, MODE_NORMAL).u8(0x10, 0);
+        self.call_ok(bus, mhi, QMI_WLANFW_WLAN_MODE_REQ_V01 as u16, &tlvs, "mission mode")?;
+        Ok(())
+    }
+}
