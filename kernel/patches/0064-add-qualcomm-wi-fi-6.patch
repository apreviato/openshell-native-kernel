+/// A channel the firmware may use (`struct channel_param`): listened to
+/// only, shared with radars, its legacy mode, its power limit in dBm, a
+/// 6 GHz preferred scanning channel.
+pub(crate) struct ChanListEntry {
+    pub(crate) freq: u32,
+    pub(crate) passive: bool,
+    pub(crate) dfs: bool,
+    pub(crate) mode: u32,
+    pub(crate) power: u32,
+    pub(crate) psc: bool,
+}
+
+/// `ath11k_wmi_send_scan_chan_list_cmd`: the channels the firmware may use.
+pub(crate) fn scan_chan_list(pdev_id: u32, channels: &[ChanListEntry]) -> Cmd {
+    let mut cmd = Cmd::new(WMI_SCAN_CHAN_LIST_CMDID);
+    cmd.tlv(WMI_TAG_SCAN_CHAN_LIST_CMD, &[channels.len() as u32, pdev_id, 0]);
+    let items: Vec<(u32, Vec<u32>)> = channels
+        .iter()
+        .map(|&ChanListEntry { freq, passive, dfs, mode, power, psc }| {
+            let mut info = WMI_CHAN_INFO_ALLOW_HE | field(WMI_CHAN_INFO_MODE, mode);
+            if passive || dfs {
+                info |= WMI_CHAN_INFO_PASSIVE;
+            }
+            if dfs {
+                info |= WMI_CHAN_INFO_DFS;
+            }
+            if psc {
+                info |= WMI_CHAN_INFO_PSC;
+            }
+            let reg_1 = field(WMI_CHAN_REG_INFO1_MAX_PWR, power * 2) | field(WMI_CHAN_REG_INFO1_MAX_REG_PWR, power * 2);
+            let reg_2 = field(WMI_CHAN_REG_INFO2_MAX_TX_PWR, power * 2);
+            (WMI_TAG_CHANNEL, vec![freq, freq, 0, info, reg_1, reg_2])
+        })
+        .collect();
+    cmd.array_struct(&items);
+    cmd
+}
