+/// `__rtw8852bx_bb_cfg_txrx_path`: both paths for RX (two streams) and
+/// for TX.
+pub(crate) fn cfg_txrx_path(hal: &Hal, two_g: bool) {
+    hal.phy_w32_mask(R_CHBW_MOD_V1, B_ANT_RX_SEG0, 3);
+    hal.phy_w32_mask(R_FC0_BW_V1, B_ANT_RX_1RCCA_SEG0, 3);
+    hal.phy_w32_mask(R_FC0_BW_V1, B_ANT_RX_1RCCA_SEG1, 3);
+    hal.phy_w32_mask(R_RXHT_MCS_LIMIT, B_RXHT_MCS_LIMIT, 1);
+    hal.phy_w32_mask(R_RXVHT_MCS_LIMIT, B_RXVHT_MCS_LIMIT, 1);
+    hal.phy_w32_mask(R_RXHE, B_RXHE_USER_MAX, 4);
+    hal.phy_w32_mask(R_RXHE, B_RXHE_MAX_NSS, 1);
+    hal.phy_w32_mask(R_RXHE, B_RXHETB_MAX_NSS, 1);
+    ctrl_btg_bt_rx(hal, two_g);
+    hal.phy_w32_mask(R_P1_TXPW_RSTB, B_P1_TXPW_RSTB_MANON | B_P1_TXPW_RSTB_TSSI, 1);
+    hal.phy_w32_mask(R_P1_TXPW_RSTB, B_P1_TXPW_RSTB_MANON | B_P1_TXPW_RSTB_TSSI, 3);
+    hal.phy_w32_mask(R_P0_RFMODE, B_P0_RFMODE_ORI_TXRX_FTM_TX, 0x123_3312);
+    hal.phy_w32_mask(R_P0_RFMODE_FTM_RX, B_P0_RFMODE_FTM_RX, 0x333);
+    hal.phy_w32_mask(R_P1_RFMODE, B_P1_RFMODE_ORI_TXRX_FTM_TX, 0x123_3312);
+    hal.phy_w32_mask(R_P1_RFMODE_FTM_RX, B_P1_RFMODE_FTM_RX, 0x333);
+    hal.phy_w32_idx(R_MAC_SEL, B_MAC_SEL_MOD, 0);
+    // `__rtw8852bx_bb_cfg_tx_path` for both.
+    hal.phy_w32_idx(R_MAC_SEL, B_MAC_SEL_MOD, 7);
+    hal.phy_w32_mask(R_TXPATH_SEL, B_TXPATH_SEL_MSK, 3);
+    hal.phy_w32_mask(R_TXNSS_MAP, B_TXNSS_MAP_MSK, 4);
+}
+
+/// `__rtw8852bx_bb_sethw`.
+pub(crate) fn bb_sethw(hal: &Hal) {
+    hal.phy_clr(R_P0_EN_SOUND_WO_NDP, B_P0_EN_SOUND_WO_NDP);
+    hal.phy_clr(R_P1_EN_SOUND_WO_NDP, B_P1_EN_SOUND_WO_NDP);
+    let mut addr = R_AX_PWR_MACID_LMT_TABLE0;
+    while addr <= R_AX_PWR_MACID_LMT_TABLE127 {
+        hal.w32(addr, 0);
+        addr += 4;
+    }
+}
