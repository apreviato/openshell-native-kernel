+/// The DE registers of each path (`_tssi_de_*`) and the DE's field.
+pub(crate) const TSSI_DE_CCK: [[u32; 2]; 2] = [[0x5858, 0x5860], [0x7858, 0x7860]];
+pub(crate) const TSSI_DE_MCS: [[u32; 6]; 2] = [[0x5838, 0x5840, 0x5848, 0x5850, 0x5828, 0x5830], [0x7838, 0x7840, 0x7848, 0x7850, 0x7828, 0x7830]];
+pub(crate) const TSSI_DE_MASK: u32 = 0x003f_f000;
+/// The thermal meter's midpoint when the eFuse has no value.
+const TSSI_THERMAL_DEFAULT: u32 = 32;
+
+/// `_tssi_get_trim_group`: eight groups, none between two.
+fn trim_group(ch: u8) -> usize {
+    match ch {
+        9..=14 => 1,
+        36..=48 => 2,
+        52..=64 => 3,
+        100..=112 => 4,
+        116..=128 => 5,
+        132..=144 => 6,
+        149..=177 => 7,
+        _ => 0,
+    }
+}
