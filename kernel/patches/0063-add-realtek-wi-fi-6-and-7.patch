+// ---- Calibrations. ----
+
+/// `_rck`: the RC calibration of a path.
+fn rck(hal: &Hal, path: u8) {
+    let reg5 = hal.read_rf(path, RR_RSV1, RFREG_MASK);
+    hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 0);
+    hal.write_rf(path, RR_MOD, RR_MOD_MASK, RR_MOD_V_RX);
+    hal.write_rf(path, RR_RCKC, RFREG_MASK, 0x00240);
+    let _ = aster_linuxkpi::delay::read_poll_timeout(|| hal.read_rf(path, RR_RCKS, 1 << 3), |value| *value != 0, 2, 30);
+    let value = hal.read_rf(path, RR_RCKC, RR_RCKC_CA);
+    hal.write_rf(path, RR_RCKC, RFREG_MASK, value);
+    hal.write_rf(path, RR_RSV1, RFREG_MASK, reg5);
+}
+
+fn drck(hal: &Hal) {
+    hal.phy_w32_mask(R_DRCK_V1, B_DRCK_V1_KICK, 1);
+    let _ = aster_linuxkpi::delay::read_poll_timeout(|| hal.phy_r32_mask(R_DRCK_RS, B_DRCK_RS_DONE), |value| *value != 0, 1, 10_000);
+    hal.phy_w32_mask(R_DRCK_V1, B_DRCK_V1_KICK, 0);
+    hal.phy_w32_mask(R_DRCK_FH, B_DRCK_LAT, 1);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_DRCK_FH, B_DRCK_LAT, 0);
+    let value = hal.phy_r32_mask(R_DRCK_RS, B_DRCK_RS_LPS);
+    hal.phy_w32_mask(R_DRCK_V1, B_DRCK_V1_SEL, 0);
+    hal.phy_w32_mask(R_DRCK_V1, B_DRCK_V1_CV, value);
+}
+
+fn check_addc(hal: &Hal, path: u8) {
+    rfk_by(hal, path == 0, RTW8852B_CHECK_ADDC_DEFS_A, RTW8852B_CHECK_ADDC_DEFS_B);
+    for _ in 0..100 {
+        let _ = hal.phy_r32(R_DBG32_D);
+    }
+}
+
+/// `_addck`: the ADC's DC offsets of both paths.
+fn addck(hal: &Hal) -> [[u32; 2]; 2] {
+    let one = |path: u8, ck: u32, trg: u32, en: u32, result: u32, dly: u32, dbg_on: bool| {
+        hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_ADCCLK, 0);
+        hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_FLTRST, 0);
+        hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_FLTRST, 1);
+        hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15_H, 0xf);
+        hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_EN, 0);
+        hal.phy_w32_mask(dly, 1 << 1, 1);
+        hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15_H, 0x3);
+        check_addc(hal, path);
+        hal.phy_w32_mask(ck, trg, 1);
+        hal.phy_w32_mask(ck, trg, 0);
+        crate::delay_us(1);
+        hal.phy_w32_mask(ck, en, 1);
+        let _ = aster_linuxkpi::delay::read_poll_timeout(|| hal.phy_r32_mask(result, 1 << 0), |value| *value != 0, 1, 10_000);
+        check_addc(hal, path);
+        hal.phy_w32_mask(dly, 1 << 1, 0);
+        hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_EN, 1);
+        hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15_H, 0xc);
+        hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_ADCCLK, 1);
+        let _ = dbg_on;
+    };
+    hal.phy_w32_mask(R_ADDCK0, B_ADDCK0_MAN, 0);
+    hal.phy_w32_mask(R_PATH1_SAMPL_DLY_T_V1, 0x30, 0);
+    hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_DBG, 1);
+    one(0, R_ADDCK0, B_ADDCK0_TRG, B_ADDCK0, R_ADDCKR0, R_PATH0_SAMPL_DLY_T_V1, false);
+    hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_DBG, 0);
+    hal.phy_w32_mask(R_P1_DBGMOD, B_P1_DBGMOD_ON, 1);
+    one(1, R_ADDCK1, B_ADDCK1_TRG, B_ADDCK1, R_ADDCKR1, R_PATH1_SAMPL_DLY_T_V1, true);
+    hal.phy_w32_mask(R_P1_DBGMOD, B_P1_DBGMOD_ON, 0);
+    // `_addck_backup`.
+    hal.phy_w32_mask(R_ADDCK0, B_ADDCK0, 0);
+    let a = [hal.phy_r32_mask(R_ADDCKR0, B_ADDCKR0_A0), hal.phy_r32_mask(R_ADDCKR0, B_ADDCKR0_A1)];
+    hal.phy_w32_mask(R_ADDCK1, B_ADDCK1, 0);
+    let b = [hal.phy_r32_mask(R_ADDCKR1, B_ADDCKR1_A0), hal.phy_r32_mask(R_ADDCKR1, B_ADDCKR1_A1)];
+    [a, b]
+}
+
+fn addck_reload(hal: &Hal, d: &[[u32; 2]; 2]) {
+    hal.phy_w32_mask(R_ADDCK0D, B_ADDCK0D_VAL, d[0][0]);
+    hal.phy_w32_mask(R_ADDCK0, B_ADDCK0_VAL, d[0][1] >> 6);
+    hal.phy_w32_mask(R_ADDCK0D, B_ADDCK0D_VAL2, d[0][1] & 0x3f);
+    hal.phy_w32_mask(R_ADDCK0, B_ADDCK0_MAN, 0x3);
+    hal.phy_w32_mask(R_ADDCK1D, B_ADDCK1D_VAL, d[1][0]);
+    hal.phy_w32_mask(R_ADDCK1, B_ADDCK0_VAL, d[1][1] >> 6);
+    hal.phy_w32_mask(R_ADDCK1D, B_ADDCK1D_VAL2, d[1][1] & 0x3f);
+    hal.phy_w32_mask(R_ADDCK1, B_ADDCK1_MAN, 0x3);
+}
+
+fn dack_done(hal: &Hal, path: u8, part1: bool) -> bool {
+    let ok = |reg, mask| hal.phy_r32_mask(reg, mask) != 0;
+    match (path, part1) {
+        (0, true) => ok(R_DACK_S0P0, B_DACK_S0P0_OK) && ok(R_DACK_S0P1, B_DACK_S0P1_OK),
+        (0, false) => ok(R_DACK_S0P2, B_DACK_S0P2_OK) && ok(R_DACK_S0P3, B_DACK_S0P3_OK),
+        (_, true) => ok(R_DACK_S1P0, B_DACK_S1P0_OK) || ok(R_DACK_S1P1, B_DACK_S1P1_OK),
+        (_, false) => ok(R_DACK10S, B_DACK_S1P2_OK) || ok(R_DACK11S, B_DACK_S1P3_OK),
+    }
+}
+
+/// `_dac_cal` of the RTL8852B: the AFE's settings, the RC clock, the ADC's
+/// offsets, then each path's DAC (MSB, the DC and its bias).
+fn dac_cal(hal: &Hal) {
+    let rf0 = hal.read_rf(0, RR_MOD, RFREG_MASK);
+    let rf1 = hal.read_rf(1, RR_MOD, RFREG_MASK);
+    hal.w32(R_AX_PHYREG_SET, 0xf);
+    rfk(hal, RTW8852B_AFE_INIT_DEFS);
+    drck(hal);
+    for path in 0..2u8 {
+        hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 0);
+        hal.write_rf(path, RR_MOD, RFREG_MASK, 0x337e1);
+    }
+    let d = addck(hal);
+    addck_reload(hal, &d);
+    hal.write_rf(0, RR_MODOPT, RFREG_MASK, 0);
+    hal.write_rf(1, RR_MODOPT, RFREG_MASK, 0);
+    // `_dack_s0`, `_dack_s1`.
+    let wait = |path: u8, part1: bool| {
+        let _ = aster_linuxkpi::delay::read_poll_timeout(|| dack_done(hal, path, part1), |done| *done, 1, 10_000);
+    };
+    rfk(hal, RTW8852B_DACK_S0_1_DEFS);
+    wait(0, true);
+    rfk(hal, RTW8852B_DACK_S0_2_DEFS);
+    wait(0, false);
+    rfk(hal, RTW8852B_DACK_S0_3_DEFS);
+    hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_DBG, 0);
+    rfk(hal, RTW8852B_DACK_S1_1_DEFS);
+    wait(1, true);
+    rfk(hal, RTW8852B_DACK_S1_2_DEFS);
+    wait(1, false);
+    rfk(hal, RTW8852B_DACK_S1_3_DEFS);
+    rfk_by(hal, false, RTW8852B_CHECK_DADC_EN_DEFS_A, RTW8852B_CHECK_DADC_EN_DEFS_B);
+    check_addc(hal, 1);
+    rfk_by(hal, false, RTW8852B_CHECK_DADC_DIS_DEFS_A, RTW8852B_CHECK_DADC_DIS_DEFS_B);
+    hal.phy_w32_mask(R_P1_DBGMOD, B_P1_DBGMOD_ON, 0);
+    hal.write_rf(0, RR_MOD, RFREG_MASK, rf0);
+    hal.write_rf(1, RR_MOD, RFREG_MASK, rf1);
+    hal.write_rf(0, RR_RSV1, RR_RSV1_RST, 1);
+    hal.write_rf(1, RR_RSV1, RR_RSV1_RST, 1);
+}
+
+/// `rtw8852b_rx_dck` (TX held, the paths out of TX first).
+pub(crate) fn rx_dck(hal: &Hal, tssi_mode: &[bool; 2]) {
+    crate::sta::stop_sch_tx(hal, true);
+    rtw8852b_rfk::wait_rx_mode(hal);
+    for path in 0..2u8 {
+        let reg5 = hal.read_rf(path, RR_RSV1, RFREG_MASK);
+        let tune = hal.read_rf(path, RR_DCK, RR_DCK_FINE);
+        // The TSSI's tracking held while the RX path is calibrated.
+        let trk = R_P0_TSSI_TRK + ((path as u32) << 13);
+        if tssi_mode[path as usize] {
+            hal.phy_w32_mask(trk, B_P0_TSSI_TRK_EN, 1);
+        }
+        hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 0);
+        hal.write_rf(path, RR_DCK, RR_DCK_FINE, 0);
+        hal.write_rf(path, RR_MOD, RR_MOD_MASK, RR_MOD_V_RX);
+        rtw8852b_rfk::set_rx_dck(hal, path);
+        hal.write_rf(path, RR_DCK, RR_DCK_FINE, tune);
+        hal.write_rf(path, RR_RSV1, RFREG_MASK, reg5);
+        if tssi_mode[path as usize] {
+            hal.phy_w32_mask(trk, B_P0_TSSI_TRK_EN, 0);
+        }
+    }
+    crate::sta::stop_sch_tx(hal, false);
+}
+
+/// `rtw8852b_rfk_init` and `rtw8852bt_rfk_init` (the TSSI off at power
+/// on): the RC, each chip's DAC calibration, the RX DC offset.
+pub(crate) fn rfk_init(hal: &Hal) {
+    for path in 0..2u8 {
+        rck(hal, path);
+    }
+    match hal.id() {
+        ChipId::Rtl8852b => dac_cal(hal),
+        ChipId::Rtl8852bt => rtw8852bt_rfk::dac_cal(hal),
+        _ => {}
+    }
+    rx_dck(hal, &[false; 2]);
+}
diff --git a/kernel/comps/rtw89/src/rtw8852b_rfk.rs b/kernel/comps/rtw89/src/rtw8852b_rfk.rs
new file mode 100644
index 0000000..5b66f84
--- /dev/null
+++ b/kernel/comps/rtw89/src/rtw8852b_rfk.rs
@@ -0,0 +1,1346 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The RTL8852B's calibrations on each channel, as Linux's
+//! `rtw8852b_rfk.c` runs them on the host (the chip's firmware does not):
+//! the IQ imbalance (IQK: the LO leakage, then TX and RX by gain groups),
+//! the digital predistortion (DPK) and the TX power's closed loop (TSSI:
+//! the eFuse's offsets, the thermal tracking table, the alignment of the
+//! power detector). One channel context (table 0), both paths, no DBCC.
+
+use crate::{
+    chan::Chan,
+    fw::TxPowerTrack,
+    hal::{Hal, MASKBYTE0, MASKBYTE2, MASKBYTE3, MASKDWORD, MASKHWORD, MASKLWORD, RFREG_MASK, get},
+    mac::Tssi,
+    phy::{self, Rfk, rfk},
+    regs::*,
+    rfk_tables::*,
+};
+
+/// `RTW8852B_IQK_VER`, `RTW8852B_RXK_GROUP_NR`.
+const IQK_VER: u32 = 0x2a;
+const RXK_GROUPS: usize = 4;
+/// The NCTL's one-shot report: done.
+pub(crate) const NCTL_DONE: u32 = 0x55;
+/// The CFIR values Linux keeps when a group failed (narrow band, failed)
+/// or passed (wide band).
+pub(crate) const CFIR_FAILED: u32 = 0x4000_0002;
+pub(crate) const CFIR_WIDE: u32 = 0x4000_0000;
+
+/// `enum rtw8852b_iqk_type`.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Iqk {
+    FlokCoarse,
+    FlokFine,
+    FlokVbuffer,
+    Txk,
+    Rxk,
+}
+
+/// The RX gain groups' RF settings and the TX ones (`_a_*`, `_g_*`).
+const A_IDXRXGAIN: [u32; RXK_GROUPS] = [0x190, 0x198, 0x350, 0x352];
+const A_IDXATTC2: [u32; RXK_GROUPS] = [0x0f, 0x0f, 0x3f, 0x7f];
+const A_IDXATTC1: [u32; RXK_GROUPS] = [0x3, 0x1, 0x0, 0x0];
+const G_IDXRXGAIN: [u32; RXK_GROUPS] = [0x212, 0x21c, 0x350, 0x360];
+const G_IDXATTC2: [u32; RXK_GROUPS] = [0x00, 0x00, 0x28, 0x5f];
+const G_IDXATTC1: [u32; RXK_GROUPS] = [0x3, 0x3, 0x2, 0x1];
+const A_POWER_RANGE: [u32; RXK_GROUPS] = [0x0, 0x0, 0x0, 0x0];
+const A_TRACK_RANGE: [u32; RXK_GROUPS] = [0x3, 0x3, 0x6, 0x6];
+const A_GAIN_BB: [u32; RXK_GROUPS] = [0x08, 0x0e, 0x06, 0x0e];
+const A_ITQT: [u32; RXK_GROUPS] = [0x12, 0x12, 0x12, 0x1b];
+const G_POWER_RANGE: [u32; RXK_GROUPS] = [0x0, 0x0, 0x0, 0x0];
+const G_TRACK_RANGE: [u32; RXK_GROUPS] = [0x4, 0x4, 0x6, 0x6];
+const G_GAIN_BB: [u32; RXK_GROUPS] = [0x08, 0x0e, 0x06, 0x0e];
+const G_ITQT: [u32; RXK_GROUPS] = [0x09, 0x12, 0x1b, 0x24];
+
+/// The registers the calibrations keep and put back
+/// (`rtw8852b_backup_bb_regs`, `_rf_regs`).
+const BACKUP_BB_REGS: [u32; 3] = [0x2344, 0x5800, 0x7800];
+const BACKUP_RF_REGS: [u32; 11] = [0xde, 0xdf, 0x8b, 0x90, 0x97, 0x85, 0x1e, 0x0, 0x2, 0x5, 0x10005];
+
+/// `rtw8852b_set_nondbcc_path01` and `_restore_`: the MAC and baseband
+/// around a calibration of both paths.
+const SET_NONDBCC_PATH01: [(u32, u32, u32); 32] = [
+    (0x20fc, 0xffff0000, 0x0303),
+    (0x5864, 0x18000000, 0x3),
+    (0x7864, 0x18000000, 0x3),
+    (0x12b8, 0x40000000, 0x1),
+    (0x32b8, 0x40000000, 0x1),
+    (0x030c, 0xff000000, 0x13),
+    (0x032c, 0xffff0000, 0x0041),
+    (0x12b8, 0x10000000, 0x1),
+    (0x58c8, 0x01000000, 0x1),
+    (0x78c8, 0x01000000, 0x1),
+    (0x5864, 0xc0000000, 0x3),
+    (0x7864, 0xc0000000, 0x3),
+    (0x2008, 0x01ffffff, 0x1ffffff),
+    (0x0c1c, 0x00000004, 0x1),
+    (0x0700, 0x08000000, 0x1),
+    (0x0c70, 0x000003ff, 0x3ff),
+    (0x0c60, 0x00000003, 0x3),
+    (0x0c6c, 0x00000001, 0x1),
+    (0x58ac, 0x08000000, 0x1),
+    (0x78ac, 0x08000000, 0x1),
+    (0x0c3c, 0x00000200, 0x1),
+    (0x2344, 0x80000000, 0x1),
+    (0x4490, 0x80000000, 0x1),
+    (0x12a0, 0x00007000, 0x7),
+    (0x12a0, 0x00008000, 0x1),
+    (0x12a0, 0x00070000, 0x3),
+    (0x12a0, 0x00080000, 0x1),
+    (0x32a0, 0x00070000, 0x3),
+    (0x32a0, 0x00080000, 0x1),
+    (0x0700, 0x01000000, 0x1),
+    (0x0700, 0x06000000, 0x2),
+    (0x20fc, 0xffff0000, 0x3333),
+];
+const RESTORE_NONDBCC_PATH01: [(u32, u32, u32); 18] = [
+    (0x20fc, 0xffff0000, 0x0303),
+    (0x12b8, 0x40000000, 0x0),
+    (0x32b8, 0x40000000, 0x0),
+    (0x5864, 0xc0000000, 0x0),
+    (0x7864, 0xc0000000, 0x0),
+    (0x2008, 0x01ffffff, 0x0000000),
+    (0x0c1c, 0x00000004, 0x0),
+    (0x0700, 0x08000000, 0x0),
+    (0x0c70, 0x0000001f, 0x03),
+    (0x0c70, 0x000003e0, 0x03),
+    (0x12a0, 0x000ff000, 0x00),
+    (0x32a0, 0x000ff000, 0x00),
+    (0x0700, 0x07000000, 0x0),
+    (0x20fc, 0xffff0000, 0x0000),
+    (0x58c8, 0x01000000, 0x0),
+    (0x78c8, 0x01000000, 0x0),
+    (0x0c3c, 0x00000200, 0x0),
+    (0x2344, 0x80000000, 0x0),
+];
+
+fn write_defs(hal: &Hal, defs: &[(u32, u32, u32)]) {
+    for &(addr, mask, value) in defs {
+        hal.phy_w32_mask(addr, mask, value);
+    }
+}
+
+fn backup_bb(hal: &Hal) -> [u32; 3] {
+    BACKUP_BB_REGS.map(|reg| hal.phy_r32_mask(reg, MASKDWORD))
+}
+
+fn restore_bb(hal: &Hal, values: &[u32; 3]) {
+    for (&reg, &value) in BACKUP_BB_REGS.iter().zip(values) {
+        hal.phy_w32_mask(reg, MASKDWORD, value);
+    }
+}
+
+fn backup_rf(hal: &Hal, path: u8) -> [u32; 11] {
+    BACKUP_RF_REGS.map(|reg| hal.read_rf(path, reg, RFREG_MASK))
+}
+
+fn restore_rf(hal: &Hal, path: u8, values: &[u32; 11]) {
+    for (&reg, &value) in BACKUP_RF_REGS.iter().zip(values) {
+        hal.write_rf(path, reg, RFREG_MASK, value);
+    }
+}
+
+/// `_wait_rx_mode`: each path out of TX.
+pub(crate) fn wait_rx_mode(hal: &Hal) {
+    for path in 0..2u8 {
+        let _ = aster_linuxkpi::delay::read_poll_timeout(|| hal.read_rf(path, RR_MOD, RR_MOD_MASK), |mode| *mode != 2, 2, 5000);
+    }
+}
+
+/// What a path's IQK keeps (`struct rtw89_iqk_info`, the parts used).
+#[derive(Clone, Copy, Default)]
+struct IqkPath {
+    band: u8,
+    bw: u8,
+    nb_txcfir: u32,
+    nb_rxcfir: u32,
+    lok_cor_fail: bool,
+    lok_fin_fail: bool,
+    tx_fail: bool,
+    rx_fail: bool,
+}
+
+/// The IQK's state across channels.
+#[derive(Default)]
+pub(crate) struct IqkInfo {
+    path: [IqkPath; 2],
+    times: u32,
+    fail_count: u32,
+}
+
+/// `_iqk_check_cal`: the NCTL done (or 8.2 ms gone), whether it failed.
+fn iqk_check_cal(hal: &Hal) -> bool {
+    let done = aster_linuxkpi::delay::read_poll_timeout(|| hal.phy_r32_mask(0xbff8, MASKBYTE0), |value| *value == NCTL_DONE, 1, 8200).is_ok();
+    crate::delay_us(200);
+    let fail = if done { hal.phy_r32_mask(R_NCTL_RPT, B_NCTL_RPT_FLG) != 0 } else { true };
+    hal.phy_w32_mask(R_NCTL_N1, MASKBYTE0, 0);
+    fail
+}
+
+/// `_iqk_one_shot`.
+fn iqk_one_shot(hal: &Hal, info: &IqkInfo, path: u8, kind: Iqk) -> bool {
+    let p = path as u32;
+    let bw = info.path[path as usize].bw as u32;
+    let cmd = match kind {
+        Iqk::FlokCoarse => {
+            hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 1);
+            0x108 | (1 << (4 + p))
+        }
+        Iqk::FlokFine => {
+            hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 1);
+            0x208 | (1 << (4 + p))
+        }
+        Iqk::FlokVbuffer => {
+            hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 1);
+            0x308 | (1 << (4 + p))
+        }
+        Iqk::Txk => {
+            hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 0);
+            0x008 | (1 << (p + 4)) | (((0x8 + bw) & 0xf) << 8)
+        }
+        Iqk::Rxk => {
+            hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 1);
+            0x008 | (1 << (p + 4)) | (((0xb + bw) & 0xf) << 8)
+        }
+    };
+    hal.phy_w32_mask(R_NCTL_CFG, MASKDWORD, cmd + 1);
+    crate::delay_us(1);
+    let fail = iqk_check_cal(hal);
+    hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 0);
+    fail
+}
+
+fn two_g(info: &IqkInfo, path: u8) -> bool {
+    info.path[path as usize].band == phy::BAND_2G
+}
+
+/// `_iqk_rxk_setting`.
+fn iqk_rxk_setting(hal: &Hal, info: &IqkInfo, path: u8) {
+    hal.write_rf(path, RR_MOD, RR_MOD_MASK, 0xc);
+    hal.write_rf(path, RR_RXK, if two_g(info, path) { RR_RXK_SEL2G } else { RR_RXK_SEL5G }, 1);
+    let value = hal.read_rf(path, RR_CFGCH, RFREG_MASK);
+    hal.write_rf(path, RR_RSV4, RFREG_MASK, value);
+}
+
+/// `_rxk_group_sel`: RX at each of the four gains.
+fn rxk_group_sel(hal: &Hal, info: &mut IqkInfo, path: u8) -> bool {
+    let mut failed = false;
+    let lut = R_CFIR_LUT + ((path as u32) << 8);
+    for group in 0..RXK_GROUPS {
+        if two_g(info, path) {
+            hal.write_rf(path, RR_MOD, RR_MOD_RGM, G_IDXRXGAIN[group]);
+            hal.write_rf(path, RR_RXBB, RR_RXBB_C2G, G_IDXATTC2[group]);
+            hal.write_rf(path, RR_RXBB, RR_RXBB_C1G, G_IDXATTC1[group]);
+        } else {
+            hal.write_rf(path, RR_MOD, RR_MOD_RGM, A_IDXRXGAIN[group]);
+            hal.write_rf(path, RR_RXA2, RR_RXA2_HATT, A_IDXATTC2[group]);
+            hal.write_rf(path, RR_RXA2, RR_RXA2_CC2, A_IDXATTC1[group]);
+        }
+        hal.phy_w32_mask(lut, B_CFIR_LUT_SEL, 1);
+        hal.phy_w32_mask(lut, B_CFIR_LUT_SET, 0);
+        hal.phy_w32_mask(lut, B_CFIR_LUT_GP_V1, group as u32);
+        let fail = iqk_one_shot(hal, info, path, Iqk::Rxk);
+        hal.phy_w32_mask(R_IQKINF, 1 << (16 + group as u32 + path as u32 * 4), fail as u32);
+        failed |= fail;
+    }
+    hal.write_rf(path, RR_RXK, RR_RXK_SEL5G, 0);
+    let res = R_IQK_RES + ((path as u32) << 8);
+    if failed {
+        info.path[path as usize].nb_rxcfir = CFIR_FAILED;
+        hal.phy_w32_mask(res, B_IQK_RES_RXCFIR, 0);
+    } else {
+        info.path[path as usize].nb_rxcfir = CFIR_WIDE;
+        hal.phy_w32_mask(res, B_IQK_RES_RXCFIR, 0x5);
+    }
+    failed
+}
+
+/// `_iqk_rxclk_setting`: the ADC's clock for the width.
+fn iqk_rxclk_setting(hal: &Hal, info: &IqkInfo, path: u8) {
+    let eighty = info.path[path as usize].bw == 2;
+    hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_DBG, 1);
+    hal.phy_w32_mask(R_P1_DBGMOD, B_P1_DBGMOD_ON, 1);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15, 0x0f);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15, 0x03);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_15, 0xa001);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_15, 0xa041);
+    let clock = if eighty { 0x2 } else { 0x1 };
+    hal.phy_w32_mask(R_P0_RXCK, B_P0_RXCK_VAL, clock);
+    hal.phy_w32_mask(R_P0_RXCK, B_P0_RXCK_ON, 1);
+    hal.phy_w32_mask(R_P1_RXCK, B_P1_RXCK_VAL, clock);
+    hal.phy_w32_mask(R_P1_RXCK, B_P1_RXCK_ON, 1);
+    hal.phy_w32_mask(R_UPD_CLK_ADC, B_UPD_CLK_ADC_ON, 1);
+    hal.phy_w32_mask(R_UPD_CLK_ADC, B_UPD_CLK_ADC_VAL, eighty as u32);
+}
+
+/// `_txk_group_sel`: TX at each of the four gains.
+fn txk_group_sel(hal: &Hal, info: &mut IqkInfo, path: u8) -> bool {
+    let mut failed = false;
+    let lut = R_CFIR_LUT + ((path as u32) << 8);
+    for group in 0..RXK_GROUPS {
+        let (power, track, gain, itqt) = if two_g(info, path) {
+            (G_POWER_RANGE[group], G_TRACK_RANGE[group], G_GAIN_BB[group], G_ITQT[group])
+        } else {
+            (A_POWER_RANGE[group], A_TRACK_RANGE[group], A_GAIN_BB[group], A_ITQT[group])
+        };
+        hal.write_rf(path, RR_TXIG, RR_TXIG_GR0, power);
+        hal.write_rf(path, RR_TXIG, RR_TXIG_GR1, track);
+        hal.write_rf(path, RR_TXIG, RR_TXIG_TG, gain);
+        hal.phy_w32_mask(R_KIP_IQP + ((path as u32) << 8), MASKDWORD, itqt);
+        hal.phy_w32_mask(lut, B_CFIR_LUT_SEL, 1);
+        hal.phy_w32_mask(lut, B_CFIR_LUT_SET, 1);
+        hal.phy_w32_mask(lut, B_CFIR_LUT_G2, 0);
+        hal.phy_w32_mask(lut, B_CFIR_LUT_GP, group as u32);
+        hal.phy_w32_mask(R_NCTL_N1, B_NCTL_N1_CIP, 0);
+        let fail = iqk_one_shot(hal, info, path, Iqk::Txk);
+        hal.phy_w32_mask(R_IQKINF, 1 << (8 + group as u32 + path as u32 * 4), fail as u32);
+        failed |= fail;
+    }
+    let res = R_IQK_RES + ((path as u32) << 8);
+    if failed {
+        info.path[path as usize].nb_txcfir = CFIR_FAILED;
+        hal.phy_w32_mask(res, B_IQK_RES_TXCFIR, 0);
+    } else {
+        info.path[path as usize].nb_txcfir = CFIR_WIDE;
+        hal.phy_w32_mask(res, B_IQK_RES_TXCFIR, 0x5);
+    }
+    failed
+}
+
+/// `_lok_res_table`.
+fn lok_res_table(hal: &Hal, info: &IqkInfo, path: u8, ibias: u32) {
+    hal.write_rf(path, RR_LUTWE, RFREG_MASK, 0x2);
+    hal.write_rf(path, RR_LUTWA, RFREG_MASK, if two_g(info, path) { 0 } else { 1 });
+    hal.write_rf(path, RR_LUTWD0, RFREG_MASK, ibias);
+    hal.write_rf(path, RR_LUTWE, RFREG_MASK, 0);
+    hal.write_rf(path, RR_TXVBUF, RR_TXVBUF_DACEN, 1);
+}
+
+/// `_lok_finetune_check`: the LO's core and buffer codes within range.
+fn lok_finetune_check(hal: &Hal, path: u8) -> bool {
+    let core = hal.read_rf(path, RR_TXMO, RFREG_MASK);
+    let (core_i, core_q) = (get(RR_TXMO_COI, core), get(RR_TXMO_COQ, core));
+    let fail1 = !(0x2..=0x1d).contains(&core_i) || !(0x2..=0x1d).contains(&core_q);
+    let vbuf = hal.read_rf(path, RR_LOKVB, RFREG_MASK);
+    let (vbuf_i, vbuf_q) = (get(RR_LOKVB_COI, vbuf), get(RR_LOKVB_COQ, vbuf));
+    let fail2 = !(0x2..=0x3d).contains(&vbuf_i) || !(0x2..=0x3d).contains(&vbuf_q);
+    fail1 | fail2
+}
+
+/// `_iqk_lok`: the LO leakage, coarse then fine, each with its buffer.
+fn iqk_lok(hal: &Hal, info: &mut IqkInfo, path: u8) -> bool {
+    let iqp = R_KIP_IQP + ((path as u32) << 8);
+    hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_TXT, 0x021);
+    hal.write_rf(path, RR_TXIG, RR_TXIG_GR0, 0);
+    hal.write_rf(path, RR_TXIG, RR_TXIG_GR1, if two_g(info, path) { 0x6 } else { 0x4 });
+    hal.write_rf(path, RR_TXIG, RR_TXIG_TG, 0);
+    hal.phy_w32_mask(iqp, MASKDWORD, 0x9);
+    info.path[path as usize].lok_cor_fail = iqk_one_shot(hal, info, path, Iqk::FlokCoarse);
+    hal.write_rf(path, RR_TXIG, RR_TXIG_TG, 0x12);
+    hal.phy_w32_mask(iqp, MASKDWORD, 0x24);
+    iqk_one_shot(hal, info, path, Iqk::FlokVbuffer);
+    hal.write_rf(path, RR_TXIG, RR_TXIG_TG, 0);
+    hal.phy_w32_mask(iqp, MASKDWORD, 0x9);
+    hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_TXT, 0x021);
+    info.path[path as usize].lok_fin_fail = iqk_one_shot(hal, info, path, Iqk::FlokFine);
+    hal.write_rf(path, RR_TXIG, RR_TXIG_TG, 0x12);
+    hal.phy_w32_mask(iqp, MASKDWORD, 0x24);
+    iqk_one_shot(hal, info, path, Iqk::FlokVbuffer);
+    lok_finetune_check(hal, path)
+}
+
+/// `_iqk_txk_setting`.
+fn iqk_txk_setting(hal: &Hal, info: &IqkInfo, path: u8) {
+    if two_g(info, path) {
+        hal.write_rf(path, RR_XALNA2, RR_XALNA2_SW2, 0);
+        hal.write_rf(path, RR_TXG1, RR_TXG1_ATT2, 0);
+        hal.write_rf(path, RR_TXG1, RR_TXG1_ATT1, 0);
+        hal.write_rf(path, RR_TXG2, RR_TXG2_ATT0, 1);
+        hal.write_rf(path, RR_TXGA, RR_TXGA_LOK_EXT, 0);
+        hal.write_rf(path, RR_LUTWE, RR_LUTWE_LOK, 1);
+        hal.write_rf(path, RR_LUTWA, RR_LUTWA_M1, 0x00);
+    } else {
+        hal.write_rf(path, RR_XGLNA2, RR_XGLNA2_SW, 0);
+        hal.write_rf(path, RR_BIASA, RR_BIASA_A, 1);
+        hal.write_rf(path, RR_TXGA, RR_TXGA_LOK_EXT, 0);
+        hal.write_rf(path, RR_LUTWE, RR_LUTWE_LOK, 1);
+        hal.write_rf(path, RR_LUTWA, RR_LUTWA_M1, 0x80);
+    }
+    hal.write_rf(path, RR_MOD, RR_MOD_IQK, 0x403e);
+    crate::delay_us(1);
+}
+
+/// `_iqk_txclk_setting`.
+fn iqk_txclk_setting(hal: &Hal) {
+    hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_DBG, 1);
+    hal.phy_w32_mask(R_P1_DBGMOD, B_P1_DBGMOD_ON, 1);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15, 0x1f);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15, 0x13);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_15, 0x0001);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_15, 0x0041);
+}
+
+/// `_iqk_info_iqk`: the results in the IQK information registers.
+fn iqk_info_iqk(hal: &Hal, info: &mut IqkInfo, path: u8) {
+    let state = info.path[path as usize];
+    let shift = path as u32 * 4;
+    hal.phy_w32_mask(R_IQKINF, B_IQKINF_FCOR << shift, state.lok_cor_fail as u32);
+    hal.phy_w32_mask(R_IQKINF, B_IQKINF_FFIN << shift, state.lok_fin_fail as u32);
+    hal.phy_w32_mask(R_IQKINF, B_IQKINF_FTX << shift, state.tx_fail as u32);
+    hal.phy_w32_mask(R_IQKINF, B_IQKINF_F_RX << shift, state.rx_fail as u32);
+    hal.phy_w32_mask(R_IQKINF2, B_IQKINF2_KCNT, info.times);
+    if hal.phy_r32_mask(R_IQKINF, B_IQKINF_FAIL << shift) != 0 {
+        info.fail_count += 1;
+    }
+    hal.phy_w32_mask(R_IQKINF2, B_IQKINF2_FCNT << shift, info.fail_count);
+}
+
+/// `_iqk_by_path`: LOK (three tries), TX by groups, RX by groups.
+fn iqk_by_path(hal: &Hal, info: &mut IqkInfo, path: u8) {
+    iqk_txclk_setting(hal);
+    for ibias in 1..=3 {
+        lok_res_table(hal, info, path, ibias);
+        iqk_txk_setting(hal, info, path);
+        if !iqk_lok(hal, info, path) {
+            break;
+        }
+    }
+    info.path[path as usize].tx_fail = txk_group_sel(hal, info, path);
+    iqk_rxclk_setting(hal, info, path);
+    iqk_rxk_setting(hal, info, path);
+    info.path[path as usize].rx_fail = rxk_group_sel(hal, info, path);
+    iqk_info_iqk(hal, info, path);
+}
+
+/// `_iqk_get_ch_info`.
+fn iqk_get_ch_info(hal: &Hal, info: &mut IqkInfo, path: u8, chan: &Chan) {
+    info.path[path as usize].band = chan.band;
+    info.path[path as usize].bw = chan.bw;
+    let shift = path as u32 * 16;
+    hal.phy_w32_mask(R_IQKINF, B_IQKINF_VER, IQK_VER);
+    hal.phy_w32_mask(R_IQKCH, B_IQKCH_BAND << shift, chan.band as u32);
+    hal.phy_w32_mask(R_IQKCH, B_IQKCH_BW << shift, chan.bw as u32);
+    hal.phy_w32_mask(R_IQKCH, B_IQKCH_CH << shift, chan.channel as u32);
+}
+
+/// `_iqk_restore`: the narrow-band results back, the NCTL and RF modes
+/// left as they were.
+fn iqk_restore(hal: &Hal, info: &IqkInfo, path: u8) {
+    let state = info.path[path as usize];
+    let p = (path as u32) << 8;
+    hal.phy_w32_mask(R_TXIQC + p, MASKDWORD, state.nb_txcfir);
+    hal.phy_w32_mask(R_RXIQC + p, MASKDWORD, state.nb_rxcfir);
+    hal.phy_w32_mask(R_NCTL_CFG, MASKDWORD, 0x0000_0e19 + ((path as u32) << 4));
+    let _ = iqk_check_cal(hal);
+    hal.phy_w32_mask(R_NCTL_N1, B_NCTL_N1_CIP, 0);
+    hal.phy_w32_mask(R_NCTL_RPT, MASKDWORD, 0);
+    hal.phy_w32_mask(R_KIP_SYSCFG, MASKDWORD, 0x8000_0000);
+    hal.phy_w32_mask(R_CFIR_SYS, B_IQK_RES_K, 0);
+    hal.phy_w32_mask(R_IQRSN, B_IQRSN_K1, 0);
+    hal.phy_w32_mask(R_IQRSN, B_IQRSN_K2, 0);
+    hal.write_rf(path, RR_LUTWE, RR_LUTWE_LOK, 0);
+    hal.write_rf(path, RR_LUTWE, RR_LUTWE_LOK, 0);
+    hal.write_rf(path, RR_MOD, RR_MOD_MASK, 0x3);
+    hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 1);
+    hal.write_rf(path, RR_BBDC, RR_BBDC_SEL, 1);
+}
+
+/// `_iqk_preset`: table 0.
+fn iqk_preset(hal: &Hal, path: u8) {
+    let p = (path as u32) << 8;
+    hal.phy_w32_mask(R_COEF_SEL + p, B_COEF_SEL_IQC, 0);
+    hal.phy_w32_mask(R_CFIR_LUT + p, B_CFIR_LUT_G3, 0);
+    hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 0);
+    hal.write_rf(path, RR_BBDC, RR_BBDC_SEL, 0);
+    hal.phy_w32_mask(R_NCTL_RPT, MASKDWORD, 0x0000_0080);
+    hal.phy_w32_mask(R_KIP_SYSCFG, MASKDWORD, 0x81ff_010a);
+}
+
+/// `_doiqk` of a path.
+fn doiqk(hal: &Hal, info: &mut IqkInfo, path: u8, chan: &Chan) {
+    info.times += 1;
+    iqk_get_ch_info(hal, info, path, chan);
+    let bb = backup_bb(hal);
+    let rf = backup_rf(hal, path);
+    write_defs(hal, &SET_NONDBCC_PATH01);
+    iqk_preset(hal, path);
+    iqk_by_path(hal, info, path);
+    iqk_restore(hal, info, path);
+    write_defs(hal, &RESTORE_NONDBCC_PATH01);
+    restore_bb(hal, &bb);
+    restore_rf(hal, path, &rf);
+}
+
+/// `rtw8852b_iqk`: TX held, both paths out of TX, each path calibrated.
+pub(crate) fn iqk(hal: &Hal, info: &mut IqkInfo, chan: &Chan) {
+    crate::sta::stop_sch_tx(hal, true);
+    wait_rx_mode(hal);
+    hal.phy_w32_mask(R_IQKINF, MASKDWORD, 0);
+    for path in 0..2u8 {
+        doiqk(hal, info, path, chan);
+    }
+    crate::sta::stop_sch_tx(hal, false);
+}
+
+// ---- DPK: the digital predistortion. ----
+
+/// `enum rtw8852b_dpk_id`: the one-shots.
+pub(crate) const DPK_LBK_RXIQK: u32 = 0x06;
+pub(crate) const DPK_SYNC: u32 = 0x10;
+pub(crate) const DPK_MDPK_IDL: u32 = 0x11;
+pub(crate) const DPK_GAIN_LOSS: u32 = 0x13;
+pub(crate) const DPK_RXAGC: u32 = 0x15;
+pub(crate) const DPK_KIP_PRESET: u32 = 0x16;
+pub(crate) const DPK_TXAGC: u32 = 0x19;
+/// The TX gains the AGC keeps to, an invalid one.
+pub(crate) const DPK_TXAGC_LOWER: u32 = 0x2e;
+pub(crate) const DPK_TXAGC_UPPER: u32 = 0x3f;
+pub(crate) const DPK_TXAGC_INVAL: u32 = 0xff;
+/// The RX baseband gain and the mode in RF register 0.
+pub(crate) const RFREG_MASKRXBB: u32 = 0x003e0;
+pub(crate) const RFREG_MASKMODE: u32 = 0xf0000;
+/// The KIP registers kept across a DPK (`kip_reg`).
+const DPK_KIP_REGS: [u32; 3] = [0x813c, 0x8124, 0x8120];
+/// The sync's limits (`DPK_SYNC_TH_*`).
+const DPK_SYNC_TH_DC: u32 = 200;
+const DPK_SYNC_TH_CORR: u32 = 170;
+/// The power scaling factor a result starts from.
+pub(crate) const DPK_PWSF: u32 = 0x78;
+/// The backoff the DPD keeps (`dpk_gs`): none (all in the baseband) or the
+/// default.
+pub(crate) const DPK_GS_BB: u32 = 0x7f;
+pub(crate) const DPK_GS_DEFAULT: u32 = 0x5b;
+
+/// A path's DPK result (`struct rtw89_dpk_bkup_para`, the first only:
+/// no reload between channels).
+#[derive(Clone, Copy, Default)]
+struct DpkPath {
+    band: u8,
+    ch: u8,
+    bw: u8,
+    ok: bool,
+    ther_dpk: u32,
+    pwsf: u32,
+}
+
+/// The DPK's state (`struct rtw89_dpk_info`) and what tracking needs.
+#[derive(Default)]
+pub(crate) struct DpkInfo {
+    enabled: bool,
+    path: [DpkPath; 2],
+    gs: u32,
+}
+
+/// Everything the RTL8852B's calibrations keep.
+#[derive(Default)]
+pub(crate) struct State {
+    pub(crate) iqk: IqkInfo,
+    pub(crate) dpk: DpkInfo,
+    /// The TX power's closed loop is on per path (`is_tssi_mode`).
+    pub(crate) tssi_mode: [bool; 2],
+    /// Each path's averaged thermal value.
+    pub(crate) thermal: Thermal,
+}
+
+/// Each path's averaged thermal value (`phystat.avg_thermal`, an EWMA with
+/// a weight of 1/4), in sixteenths.
+#[derive(Default)]
+pub(crate) struct Thermal([Option<u32>; 2]);
+
+impl Thermal {
+    /// `rtw89_phy_stat_thermal_update`.
+    pub(crate) fn update(&mut self, hal: &Hal, tssi_mode: &[bool; 2]) {
+        for path in 0..2u8 {
+            self.add(path, thermal(hal, tssi_mode, path));
+        }
+    }
+
+    /// `ewma_thermal_add` of a reading (none when 0).
+    pub(crate) fn add(&mut self, path: u8, value: u32) {
+        if value != 0 {
+            let sample = value << 4;
+            let average = &mut self.0[path as usize];
+            *average = Some(match *average {
+                Some(old) => old - (old >> 2) + (sample >> 2),
+                None => sample,
+            });
+        }
+    }
+
+    /// `ewma_thermal_read`: 0 before the first value.
+    pub(crate) fn read(&self, path: u8) -> u32 {
+        self.0[path as usize].map_or(0, |average| average >> 4)
+    }
+}
+
+pub(crate) fn sign_extend12(value: u32) -> i32 {
+    ((value << 20) as i32) >> 20
+}
+
+/// `_dpk_order_convert`.
+fn dpk_order_convert(hal: &Hal) -> u32 {
+    0x3 >> hal.phy_r32_mask(R_LDL_NORM, B_LDL_NORM_OP)
+}
+
+/// `_dpk_onoff`: table 0.
+fn dpk_onoff(hal: &Hal, dpk: &DpkInfo, path: u8, off: bool) {
+    let on = dpk.enabled && !off && dpk.path[path as usize].ok;
+    hal.phy_w32_mask(R_DPD_CH0A + ((path as u32) << 8), MASKBYTE3, (dpk_order_convert(hal) << 1) | on as u32);
+}
+
+
+/// `_dpk_one_shot`: the NCTL's command, then the KIP's report.
+fn dpk_one_shot(hal: &Hal, path: u8, id: u32) {
+    let cmd = (id << 8) | (0x19 + ((path as u32) << 4));
+    hal.phy_w32_mask(R_NCTL_CFG, MASKDWORD, cmd);
+    let _ = aster_linuxkpi::delay::read_poll_timeout(|| hal.phy_r32_mask(0xbff8, MASKBYTE0), |value| *value == NCTL_DONE, 1, 20_000);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_KIP_RPT1, MASKDWORD, 0x0003_0000);
+    let _ = aster_linuxkpi::delay::read_poll_timeout(|| hal.phy_r32_mask(0x80fc, MASKLWORD), |value| *value == 0x8000, 1, 2000);
+    hal.phy_w32_mask(R_NCTL_N1, MASKBYTE0, 0);
+}
+
+/// `_set_rx_dck`.
+pub(crate) fn set_rx_dck(hal: &Hal, path: u8) {
+    hal.write_rf(path, RR_DCK1, RR_DCK1_CLR, 0);
+    hal.write_rf(path, RR_DCK, RR_DCK_LV, 0);
+    hal.write_rf(path, RR_DCK, RR_DCK_LV, 1);
+    crate::delay_ms(1);
+}
+
+/// `_dpk_lbk_rxiqk`: RX IQ through the loopback, at the RX gain the AGC
+/// left.
+fn dpk_lbk_rxiqk(hal: &Hal, path: u8) {
+    let p = (path as u32) << 8;
+    let rxbb = hal.read_rf(path, RR_MOD, RFREG_MASKRXBB);
+    hal.phy_w32_mask(R_MDPK_RX_DCK, B_MDPK_RX_DCK_EN, 1);
+    hal.phy_w32_mask(R_IQK_RES + p, B_IQK_RES_RXCFIR, 0);
+    let value = hal.read_rf(path, RR_CFGCH, RFREG_MASK);
+    hal.write_rf(path, RR_RSV4, RFREG_MASK, value);
+    hal.write_rf(path, RR_MOD, RFREG_MASKMODE, 0xd);
+    hal.write_rf(path, RR_RXK, RR_RXK_PLLEN, 1);
+    let att = if rxbb >= 0x11 {
+        0x13
+    } else if rxbb <= 0xa {
+        0x00
+    } else {
+        0x05
+    };
+    hal.write_rf(path, RR_TXIQK, RR_TXIQK_ATT1, att);
+    hal.write_rf(path, RR_XGLNA2, RR_XGLNA2_SW, 0);
+    hal.write_rf(path, RR_RXKPLL, RR_RXKPLL_POW, 0);
+    hal.write_rf(path, RR_RXKPLL, RFREG_MASK, 0x80014);
+    crate::delay_us(70);
+    hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 1);
+    hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_RXT, 0x025);
+    dpk_one_shot(hal, path, DPK_LBK_RXIQK);
+    hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 0);
+    hal.write_rf(path, RR_RXK, RR_RXK_PLLEN, 0);
+    hal.phy_w32_mask(R_MDPK_RX_DCK, B_MDPK_RX_DCK_EN, 0);
+    hal.phy_w32_mask(R_KPATH_CFG, B_KPATH_CFG_ED, 0);
+    hal.phy_w32_mask(R_LOAD_COEF + p, B_LOAD_COEF_DI, 1);
+    hal.write_rf(path, RR_MOD, RFREG_MASKMODE, 0x5);
+}
+
+/// `__THM_MASK_SIGN`, `__THM_MASK_3BITS`, `__THM_MASK_VAL8`: the eFuse's
+/// thermal trim.
+pub(crate) const THM_MASK_SIGN: u8 = 1 << 0;
+pub(crate) const THM_MASK_3BITS: u8 = 0x0e;
+pub(crate) const THM_MASK_VAL8: u8 = 1 << 4;
+
+/// `rtw89_chip_power_trim` of the AX chips (`rtw8852bx_power_trim`,
+/// `rtw8852c_power_trim` and the others, alike): the thermal meter's and
+/// the PA's bias trims the eFuse programmed, per path.
+pub(crate) fn power_trim(hal: &Hal, efuse: &crate::mac::Efuse, paths: u8) {
+    if let Some(trim) = efuse.thermal_trim {
+        for path in 0..paths.min(2) {
+            let raw = trim[path as usize];
+            let value = ((raw & THM_MASK_SIGN) << 3) | ((raw & THM_MASK_3BITS) >> 1);
+            hal.write_rf(path, RR_TM2, RR_TM2_OFF, value as u32);
+        }
+    }
+    if let Some(bias) = efuse.pa_bias_trim {
+        for path in 0..paths.min(2) {
+            let raw = bias[path as usize] as u32;
+            hal.write_rf(path, RR_BIASA, RR_BIASA_TXG, raw & 0xf);
+            hal.write_rf(path, RR_BIASA, RR_BIASA_TXA, raw >> 4);
+        }
+    }
+}
+
+/// `_dpk_get_thermal`.
+pub(crate) fn rf_thermal(hal: &Hal, path: u8) -> u32 {
+    hal.write_rf(path, RR_TM, RR_TM_TRI, 1);
+    hal.write_rf(path, RR_TM, RR_TM_TRI, 0);
+    hal.write_rf(path, RR_TM, RR_TM_TRI, 1);
+    crate::delay_us(200);
+    hal.read_rf(path, RR_TM, RR_TM_VAL)
+}
+
+/// `_dpk_rf_setting`.
+fn dpk_rf_setting(hal: &Hal, path: u8, band: u8, bw: u8) {
+    hal.write_rf(path, RR_MOD, RFREG_MASK, 0x50220);
+    if band == phy::BAND_2G {
+        hal.write_rf(path, RR_RXBB, RR_RXBB_FATT, 0xf2);
+        hal.write_rf(path, RR_LUTDBG, RR_LUTDBG_TIA, 1);
+        hal.write_rf(path, RR_TIA, RR_TIA_N6, 1);
+    } else {
+        hal.write_rf(path, RR_RXA2, RR_RAA2_SWATT, 0x5);
+        hal.write_rf(path, RR_LUTDBG, RR_LUTDBG_TIA, 1);
+        hal.write_rf(path, RR_TIA, RR_TIA_N6, 1);
+        hal.write_rf(path, RR_RXA_LNA, RFREG_MASK, 0x920FC);
+        hal.write_rf(path, RR_XALNA2, RFREG_MASK, 0x002C0);
+        hal.write_rf(path, RR_IQGEN, RFREG_MASK, 0x38800);
+    }
+    hal.write_rf(path, RR_RCKD, RR_RCKD_BW, 1);
+    hal.write_rf(path, RR_BTC, RR_BTC_TXBB, bw as u32 + 1);
+    hal.write_rf(path, RR_BTC, RR_BTC_RXBB, 0);
+}
+
+/// `_dpk_bypass_rxcfir`.
+pub(crate) fn dpk_bypass_rxcfir(hal: &Hal, path: u8, bypass: bool) {
+    let reg = R_RXIQC + ((path as u32) << 8);
+    if bypass {
+        hal.phy_w32_mask(reg, B_RXIQC_BYPASS2, 1);
+        hal.phy_w32_mask(reg, B_RXIQC_BYPASS, 1);
+    } else {
+        hal.phy_clr(reg, B_RXIQC_BYPASS2);
+        hal.phy_clr(reg, B_RXIQC_BYPASS);
+    }
+}
+
+/// `_dpk_tpg_sel`: the test pattern for the width.
+pub(crate) fn dpk_tpg_sel(hal: &Hal, bw: u8) {
+    match bw {
+        2 => hal.phy_clr(R_TPG_MOD, B_TPG_MOD_F),
+        1 => hal.phy_w32_mask(R_TPG_MOD, B_TPG_MOD_F, 0x2),
+        _ => hal.phy_w32_mask(R_TPG_MOD, B_TPG_MOD_F, 0x1),
+    }
+}
+
+/// `_dpk_table_select` (table 0).
+fn dpk_table_select(hal: &Hal, path: u8, gain: u32) {
+    hal.phy_w32_mask(R_DPD_CH0 + ((path as u32) << 8), MASKBYTE3, 0x80 + gain * 0x10);
+}
+
+/// `_dpk_sync_check`: whether the sync failed (DC too high, too little
+/// correlation).
+pub(crate) fn dpk_sync_check(hal: &Hal) -> bool {
+    hal.phy_clr(R_KIP_RPT1, B_KIP_RPT1_SEL);
+    let corr = hal.phy_r32_mask(R_RPT_COM, B_PRT_COM_CORV);
+    hal.phy_w32_mask(R_KIP_RPT1, B_KIP_RPT1_SEL, 0x9);
+    let dc_i = sign_extend12(hal.phy_r32_mask(R_RPT_COM, B_PRT_COM_DCI)).unsigned_abs();
+    let dc_q = sign_extend12(hal.phy_r32_mask(R_RPT_COM, B_PRT_COM_DCQ)).unsigned_abs();
+    dc_i > DPK_SYNC_TH_DC || dc_q > DPK_SYNC_TH_DC || corr < DPK_SYNC_TH_CORR
+}
+
+/// `_dpk_dgain_mapping`: the RX gain step a digital gain asks for.
+pub(crate) fn dpk_dgain_mapping(dgain: u32) -> i32 {
+    const BOUNDS: [u32; 15] = [0xbf1, 0xaa5, 0x97d, 0x875, 0x789, 0x6b7, 0x5fc, 0x556, 0x4c1, 0x43d, 0x3c7, 0x35e, 0x2ac, 0x262, 0x220];
+    if dgain >= BOUNDS[1] {
+        return 6;
+    }
+    match BOUNDS.iter().position(|&bound| dgain >= bound) {
+        // From the third bound down: 5 to -7.
+        Some(index) => 7 - index as i32,
+        None => -8,
+    }
+}
+
+/// `_dpk_gainloss_read`.
+pub(crate) fn dpk_gainloss_read(hal: &Hal) -> u32 {
+    hal.phy_w32_mask(R_KIP_RPT1, B_KIP_RPT1_SEL, 0x6);
+    hal.phy_w32_mask(R_DPK_CFG2, B_DPK_CFG2_ST, 1);
+    hal.phy_r32_mask(R_RPT_COM, B_PRT_COM_GL)
+}
+
+/// `_dpk_kip_set_txagc`.
+fn dpk_kip_set_txagc(hal: &Hal, path: u8, txagc: u32) {
+    hal.write_rf(path, RR_TXAGC, RFREG_MASK, txagc);
+    hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 1);
+    dpk_one_shot(hal, path, DPK_TXAGC);
+    hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 0);
+}
+
+/// `_dpk_set_offset`: the TX gain moved down by an offset, kept within
+/// the AGC's range.
+fn dpk_set_offset(hal: &Hal, path: u8, offset: i32) -> u32 {
+    let txagc = hal.read_rf(path, RR_TXAGC, RFREG_MASK) as i32;
+    let txagc = (txagc - offset).clamp(DPK_TXAGC_LOWER as i32, DPK_TXAGC_UPPER as i32) as u32;
+    dpk_kip_set_txagc(hal, path, txagc);
+    txagc
+}
+
+/// `_dpk_pas_read` checking the gain compression: the first sample's power
+/// against the last's.
+pub(crate) fn dpk_pas_compressed(hal: &Hal) -> bool {
+    hal.phy_w32_mask(R_KIP_RPT1, MASKBYTE2, 0x06);
+    hal.phy_w32_mask(R_DPK_CFG2, B_DPK_CFG2_ST, 0);
+    hal.phy_w32_mask(R_DPK_CFG3, MASKBYTE2, 0x08);
+    let sample = |index: u32| {
+        hal.phy_w32_mask(R_DPK_CFG3, MASKBYTE3, index);
+        let i = sign_extend12(hal.phy_r32_mask(R_RPT_COM, MASKHWORD)).unsigned_abs();
+        let q = sign_extend12(hal.phy_r32_mask(R_RPT_COM, MASKLWORD)).unsigned_abs();
+        i * i + q * q
+    };
+    let (first, last) = (sample(0x00), sample(0x1f));
+    first >= last * 8 / 5
+}
+
+/// `_dpk_agc`: the RX gain for the sync's digital gain, then the TX gain
+/// by the gain loss (`enum dpk_agc_step`); `DPK_TXAGC_INVAL` when the
+/// sync failed.
+fn dpk_agc(hal: &Hal, path: u8, init_txagc: u32, bw: u8) -> u32 {
+    #[derive(Clone, Copy, PartialEq)]
+    enum Step {
+        SyncDgain,
+        GainAdj,
+        GainLossIdx,
+        GlGtCriterion,
+        GlLtCriterion,
+        SetTxGain,
+    }
+    let mut step = Step::SyncDgain;
+    let (mut txagc, mut gl_idx, mut dgain) = (init_txagc, 0u32, 0u32);
+    let (mut count, mut limited_rxbb, mut limit) = (0u32, false, 200);
+    loop {
+        let mut out = false;
+        match step {
+            Step::SyncDgain => {
+                dpk_one_shot(hal, path, DPK_SYNC);
+                if dpk_sync_check(hal) {
+                    txagc = DPK_TXAGC_INVAL;
+                    out = true;
+                } else {
+                    hal.phy_w32_mask(R_KIP_RPT1, B_KIP_RPT1_SEL, 0);
+                    dgain = hal.phy_r32_mask(R_RPT_COM, B_PRT_COM_DCI);
+                    step = if limited_rxbb { Step::GainLossIdx } else { Step::GainAdj };
+                }
+            }
+            Step::GainAdj => {
+                let rxbb = hal.read_rf(path, RR_MOD, RFREG_MASKRXBB) as i32;
+                let offset = dpk_dgain_mapping(dgain);
+                let wanted = rxbb + offset;
+                let rxbb = if wanted > 0x1f {
+                    limited_rxbb = true;
+                    0x1f
+                } else if wanted < 0 {
+                    limited_rxbb = true;
+                    0
+                } else {
+                    wanted
+                };
+                hal.write_rf(path, RR_MOD, RFREG_MASKRXBB, rxbb as u32);
+                if offset != 0 || count == 0 {
+                    if bw < 2 {
+                        dpk_bypass_rxcfir(hal, path, true);
+                    } else {
+                        dpk_lbk_rxiqk(hal, path);
+                    }
+                }
+                step = if !(342..=1922).contains(&dgain) { Step::SyncDgain } else { Step::GainLossIdx };
+                count += 1;
+            }
+            Step::GainLossIdx => {
+                dpk_table_select(hal, path, 1);
+                dpk_one_shot(hal, path, DPK_GAIN_LOSS);
+                gl_idx = dpk_gainloss_read(hal);
+                step = if (gl_idx == 0 && dpk_pas_compressed(hal)) || gl_idx >= 7 {
+                    Step::GlGtCriterion
+                } else if gl_idx == 0 {
+                    Step::GlLtCriterion
+                } else {
+                    Step::SetTxGain
+                };
+            }
+            Step::GlGtCriterion => {
+                if txagc == DPK_TXAGC_LOWER {
+                    out = true;
+                } else {
+                    txagc = dpk_set_offset(hal, path, 3);
+                }
+                step = Step::GainLossIdx;
+                count += 1;
+            }
+            Step::GlLtCriterion => {
+                if txagc == DPK_TXAGC_UPPER {
+                    out = true;
+                } else {
+                    txagc = dpk_set_offset(hal, path, -2);
+                }
+                step = Step::GainLossIdx;
+                count += 1;
+            }
+            Step::SetTxGain => {
+                txagc = dpk_set_offset(hal, path, gl_idx as i32);
+                out = true;
+                count += 1;
+            }
+        }
+        limit -= 1;
+        if out || count >= 6 || limit <= 0 {
+            break;
+        }
+    }
+    txagc
+}
+
+/// `_dpk_set_mdpd_para`.
+fn dpk_set_mdpd_para(hal: &Hal, order: u32) {
+    hal.phy_w32_mask(R_LDL_NORM, B_LDL_NORM_OP, order);
+    if order == 0 {
+        hal.phy_w32_mask(R_LDL_NORM, B_LDL_NORM_PN, 0x3);
+        hal.phy_w32_mask(R_MDPK_SYNC, B_MDPK_SYNC_MAN, 1);
+    } else {
+        hal.phy_clr(R_LDL_NORM, B_LDL_NORM_PN);
+        hal.phy_clr(R_MDPK_SYNC, B_MDPK_SYNC_MAN);
+    }
+}
+
+/// `_dpk_fill_result` (table 0, gain 1).
+fn dpk_fill_result(hal: &Hal, dpk: &mut DpkInfo, path: u8, gain: u32, txagc: u32) {
+    let p = (path as u32) << 8;
+    hal.phy_w32_mask(R_COEF_SEL + p, B_COEF_SEL_MDPD, 0);
+    hal.phy_w32_mask(R_TXAGC_RFK + p, 0x3f << (gain << 3), txagc);
+    dpk.path[path as usize].pwsf = DPK_PWSF;
+    hal.phy_w32_mask(R_DPD_BND + p, 0x1ff << (gain << 4), DPK_PWSF);
+    hal.phy_w32_mask(R_LOAD_COEF + p, B_LOAD_COEF_MDPD, 1);
+    hal.phy_w32_mask(R_LOAD_COEF + p, B_LOAD_COEF_MDPD, 0);
+    hal.phy_w32_mask(R_DPD_CH0A + p, MASKDWORD, if dpk.gs == DPK_GS_BB { 0x007f_7f7f } else { 0x005b_5b5b });
+    hal.phy_w32_mask(R_DPD_CH0A + p, B_DPD_ORDER_V1, dpk_order_convert(hal));
+    hal.phy_w32_mask(R_DPD_V1 + p, MASKDWORD, 0);
+    hal.phy_w32_mask(R_MDPK_SYNC, B_MDPK_SYNC_SEL, 0);
+}
+
+/// `_dpk_main` of a path: whether it failed.
+fn dpk_main(hal: &Hal, dpk: &mut DpkInfo, path: u8, gain: u32) -> bool {
+    let p = (path as u32) << 8;
+    let (band, bw) = (dpk.path[path as usize].band, dpk.path[path as usize].bw);
+    hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 0);
+    hal.write_rf(path, RR_BBDC, RR_BBDC_SEL, 0);
+    // `_dpk_kip_pwr_clk_on`.
+    hal.phy_w32_mask(R_NCTL_RPT, MASKDWORD, 0x0000_0080);
+    hal.phy_w32_mask(R_KIP_SYSCFG, MASKDWORD, 0x807f_030a);
+    hal.phy_w32_mask(R_CFIR_SYS + p, MASKDWORD, 0xce00_0a08);
+    let txagc = 0x38;
+    dpk_kip_set_txagc(hal, path, txagc);
+    dpk_rf_setting(hal, path, band, bw);
+    // `_dpk_rx_dck`.
+    hal.write_rf(path, RR_RXBB2, RR_EN_TIA_IDA, 0x3);
+    set_rx_dck(hal, path);
+    // `_dpk_kip_preset`.
+    dpk_tpg_sel(hal, bw);
+    dpk_one_shot(hal, path, DPK_KIP_PRESET);
+    // `_dpk_kip_set_rxagc`.
+    let mode = hal.read_rf(path, RR_MOD, RFREG_MASK);
+    hal.phy_w32_mask(R_KIP_MOD, B_KIP_MOD, mode);
+    hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 1);
+    dpk_one_shot(hal, path, DPK_RXAGC);
+    hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 0);
+    hal.phy_w32_mask(R_KIP_RPT1, B_KIP_RPT1_SEL_V1, 0x8);
+    dpk_table_select(hal, path, gain);
+    let txagc = dpk_agc(hal, path, txagc, bw);
+    let failed = txagc == DPK_TXAGC_INVAL;
+    if !failed {
+        dpk.path[path as usize].ther_dpk = rf_thermal(hal, path);
+        // `_dpk_idl_mpa`.
+        dpk_set_mdpd_para(hal, if bw < 2 && band != phy::BAND_2G { 0x2 } else { 0x0 });
+        dpk_one_shot(hal, path, DPK_MDPK_IDL);
+        hal.write_rf(path, RR_MOD, RR_MOD_MASK, RR_MOD_V_RX);
+        dpk_fill_result(hal, dpk, path, gain, txagc);
+    }
+    dpk.path[path as usize].ok = !failed;
+    failed
+}
+
+/// `rtw8852b_dpk` (`_dpk_cal_select`, no reload): the KIP, baseband and RF
+/// registers kept, TSSI paused, both paths calibrated, all put back.
+pub(crate) fn dpk(hal: &Hal, state: &mut State, chan: &Chan) {
+    crate::sta::stop_sch_tx(hal, true);
+    wait_rx_mode(hal);
+    state.dpk.enabled = true;
+    let bb = backup_bb(hal);
+    let mut kip = [[0u32; 3]; 2];
+    let mut rf = [[0u32; 11]; 2];
+    for path in 0..2u8 {
+        kip[path as usize] = DPK_KIP_REGS.map(|reg| hal.phy_r32_mask(reg + ((path as u32) << 8), MASKDWORD));
+        rf[path as usize] = backup_rf(hal, path);
+        state.dpk.path[path as usize].band = chan.band;
+        state.dpk.path[path as usize].ch = chan.channel;
+        state.dpk.path[path as usize].bw = chan.bw;
+        if state.tssi_mode[path as usize] {
+            hal.phy_w32_mask(R_P0_TSSI_TRK + ((path as u32) << 13), B_P0_TSSI_TRK_EN, 1);
+        }
+    }
+    // `_dpk_bb_afe_setting`.
+    rfk(hal, RTW8852B_DPK_AFE_DEFS);
+    if chan.bw == 2 {
+        hal.phy_w32_mask(R_P0_CFCH_BW1, B_P0_CFCH_EX, 1);
+        hal.phy_w32_mask(R_PATH1_BW_SEL_V1, B_PATH1_BW_SEL_EX, 1);
+    }
+    for path in 0..2u8 {
+        let failed = dpk_main(hal, &mut state.dpk, path, 1);
+        dpk_onoff(hal, &state.dpk, path, failed);
+    }
+    // `_dpk_bb_afe_restore`.
+    rfk(hal, RTW8852B_DPK_AFE_RESTORE_DEFS);
+    if chan.bw == 2 {
+        hal.phy_w32_mask(R_P0_CFCH_BW1, B_P0_CFCH_EX, 0);
+        hal.phy_w32_mask(R_PATH1_BW_SEL_V1, B_PATH1_BW_SEL_EX, 0);
+    }
+    restore_bb(hal, &bb);
+    for path in 0..2u8 {
+        // `_dpk_kip_restore`.
+        rfk(hal, RTW8852B_DPK_KIP_DEFS);
+        if hal.cv > CHIP_CAV as u8 {
+            hal.phy_w32_mask(R_DPD_COM + ((path as u32) << 8), B_DPD_COM_OF, 1);
+        }
+        for (reg, value) in DPK_KIP_REGS.iter().zip(kip[path as usize]) {
+            hal.phy_w32_mask(reg + ((path as u32) << 8), MASKDWORD, value);
+        }
+        restore_rf(hal, path, &rf[path as usize]);
+        if state.tssi_mode[path as usize] {
+            hal.phy_w32_mask(R_P0_TSSI_TRK + ((path as u32) << 13), B_P0_TSSI_TRK_EN, 0);
+        }
+    }
+    crate::sta::stop_sch_tx(hal, false);
+}
+
+/// `_set_dpd_backoff` (`rtw8852b_dpk_init`): a large OFDM backoff and TX
+/// scale goes to the baseband.
+pub(crate) fn dpk_init(hal: &Hal, state: &mut State) {
+    let backoff = hal.phy_r32_mask(R_DPD_BF, B_DPD_BF_OFDM);
+    let scale = hal.phy_r32_mask(R_DPD_BF, B_DPD_BF_SCA);
+    if backoff + scale >= 44 {
+        state.dpk.gs = DPK_GS_BB;
+        for path in 0..2u32 {
+            hal.phy_w32_mask(R_DPD_CH0A + (path << 8), B_DPD_CFG, 0x7f7f7f);
+        }
+    } else {
+        state.dpk.gs = DPK_GS_DEFAULT;
+    }
+    state.tssi_mode = [false; 2];
+}
+
+/// `__rtw8852bx_get_thermal`: from the TSSI's report in its mode, else
+/// the RF's meter.
+pub(crate) fn thermal(hal: &Hal, tssi_mode: &[bool; 2], path: u8) -> u32 {
+    if tssi_mode[path as usize] {
+        return hal.phy_r32_mask(0x1c10 + ((path as u32) << 13), 0x3f00_0000);
+    }
+    rf_thermal(hal, path)
+}
+
+/// `rtw89_phy_stat_thermal_update` and `rtw8852b_dpk_track` (`_dpk_track`):
+/// the averaged thermal values, then the DPD's power scaling factor moved
+/// with the temperature (and the TSSI's gains in its mode). Every 2 s,
+/// awake.
+pub(crate) fn track(hal: &Hal, state: &mut State) {
+    if !state.dpk.enabled {
+        return;
+    }
+    state.thermal.update(hal, &state.tssi_mode);
+    let mut ini_diff: i32 = 0;
+    for path in 0..2u8 {
+        let result = state.dpk.path[path as usize];
+        let current = state.thermal.read(path);
+        let mut delta: i32 = 0;
+        if result.ch != 0 && current != 0 {
+            delta = (result.ther_dpk as i32 - current as i32) as i8 as i32;
+        }
+        delta = if result.band == phy::BAND_2G { (delta * 3 / 2) as i8 as i32 } else { (delta * 5 / 2) as i8 as i32 };
+        let txagc_rf = hal.phy_r32_mask(R_TXAGC_BB + ((path as u32) << 13), 0x3f);
+        let pwsf = if state.tssi_mode[path as usize] {
+            let txagc_bb = hal.phy_r32_mask(R_TXAGC_BB + ((path as u32) << 13), MASKBYTE2) as u8 as i8 as i32;
+            let txagc_bb_tp = hal.phy_r32_mask(R_TXAGC_TP + ((path as u32) << 13), B_TXAGC_TP) as u8 as i8 as i32;
+            let mut offset = hal.phy_r32_mask(R_TXAGC_BB + ((path as u32) << 13), MASKBYTE3) as u8 as i8 as i32;
+            if hal.phy_r32_mask(R_DPD_COM + ((path as u32) << 8), B_DPD_COM_OF) == 1 {
+                offset = 0;
+            }
+            if txagc_rf != 0 && current != 0 {
+                ini_diff = (offset + delta) as i8 as i32;
+            }
+            if hal.phy_r32_mask(R_P0_TXDPD + ((path as u32) << 13), B_P0_TXDPD) == 0 {
+                (result.pwsf as i32 + txagc_bb_tp - txagc_bb + ini_diff) as u16 as u32
+            } else {
+                (result.pwsf as i32 + ini_diff) as u16 as u32
+            }
+        } else {
+            ((result.pwsf as i32 + delta) as u32) & 0x1ff
+        };
+        if hal.phy_r32_mask(R_DPK_TRK, B_DPK_TRK_DIS) == 0 && txagc_rf != 0 {
+            let reg = R_DPD_BND + ((path as u32) << 8);
+            hal.phy_w32_mask(reg, B_DPD_BND_0, pwsf);
+            hal.phy_w32_mask(reg, B_DPD_BND_1, pwsf);
+        }
+    }
+}
