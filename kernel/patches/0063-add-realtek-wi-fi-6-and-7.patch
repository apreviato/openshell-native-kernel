+// ---- Paths and the antenna shared with Bluetooth. ----
+
+/// `rtw8852bx_ctrl_btg_bt_rx`.
+fn ctrl_btg_bt_rx(hal: &Hal, enable: bool) {
+    hal.phy_w32_mask(R_PATH0_BT_SHARE_V1, B_PATH0_BT_SHARE_V1, enable as u32);
+    hal.phy_w32_mask(R_PATH0_BTG_PATH_V1, B_PATH0_BTG_PATH_V1, 0);
+    hal.phy_w32_mask(R_PATH1_G_LNA6_OP1DB_V1, B_PATH1_G_LNA6_OP1DB_V1, if enable { 0x20 } else { 0x1a });
+    hal.phy_w32_mask(R_PATH1_G_TIA0_LNA6_OP1DB_V1, B_PATH1_G_TIA0_LNA6_OP1DB_V1, if enable { 0x30 } else { 0x2a });
+    hal.phy_w32_mask(R_PATH1_BT_SHARE_V1, B_PATH1_BT_SHARE_V1, enable as u32);
+    hal.phy_w32_mask(R_PATH1_BTG_PATH_V1, B_PATH1_BTG_PATH_V1, enable as u32);
+    hal.phy_w32_mask(R_PMAC_GNT, B_PMAC_GNT_P1, if enable { 0 } else { 0xc });
+    hal.phy_w32_mask(R_CHBW_MOD_V1, B_BT_SHARE, enable as u32);
+    hal.phy_w32_mask(R_FC0_BW_V1, B_ANT_RX_BT_SEG0, if enable { 2 } else { 0 });
+    hal.phy_w32_mask(R_BT_DYN_DC_EST_EN_V1, B_BT_DYN_DC_EST_EN_MSK, 1);
+    hal.phy_w32_mask(R_GNT_BT_WGT_EN, B_GNT_BT_WGT_EN, enable as u32);
+}
