+// ---- The gains of the board's table (`rtw89_phy_config_bb_gain_be`). ----
+
+const GAIN_BANDS: usize = 12;
+const LNA_GAINS: usize = 7;
+const TIA_GAINS: usize = 2;
+const TIA_LNA_OP1DB: usize = 8;
+
+/// `struct rtw89_phy_bb_gain_info_be` for two paths: [gain band][bandwidth
+/// class][path][index].
+#[derive(Clone, Default)]
+pub(crate) struct BbGain {
+    lna: [[[[i8; LNA_GAINS]; 2]; 2]; GAIN_BANDS],
+    tia: [[[[i8; TIA_GAINS]; 2]; 2]; GAIN_BANDS],
+    lna_op1db: [[[[i8; LNA_GAINS]; 2]; 2]; GAIN_BANDS],
+    tia_lna_op1db: [[[[i8; TIA_LNA_OP1DB]; 2]; 2]; GAIN_BANDS],
+    rpl20: [[[i8; 1]; 2]; GAIN_BANDS],
+    rpl40: [[[i8; 2]; 2]; GAIN_BANDS],
+    rpl80: [[[i8; 4]; 2]; GAIN_BANDS],
+    rpl160: [[[i8; 8]; 2]; GAIN_BANDS],
+}
+
+/// The firmware's BB gain table: each entry's address names its kind
+/// (configuration type, gain band, path and bandwidth, sub type), its data
+/// up to four gains.
+pub(crate) fn bb_gain(hal: &Hal, fw: &Firmware) -> BbGain {
+    let mut g = BbGain::default();
+    let Some(table) = &fw.elements.bb_gain else { return g };
+    phy::walk(hal, table, |addr, data| {
+        let (kind, path_bw, band, cfg) = (addr as u8, (addr >> 8) as u8, (addr >> 16) as u8 as usize, (addr >> 24) as u8);
+        let (path, bw) = ((path_bw & 0xf) as usize, (path_bw >> 4) as usize);
+        if bw >= 2 || band >= GAIN_BANDS || path >= 2 || (0xf9..=0xfe).contains(&addr) {
+            return;
+        }
+        let bytes = data.to_le_bytes().map(|byte| byte as i8);
+        match (cfg, kind) {
+            (0, 0) => g.lna[band][bw][path][0..4].copy_from_slice(&bytes),
+            (0, 1) => g.lna[band][bw][path][4..7].copy_from_slice(&bytes[0..3]),
+            (0, 2) => g.tia[band][bw][path].copy_from_slice(&bytes[0..2]),
+            (1, _) => match kind >> 4 {
+                0 => g.rpl20[band][path][0] = bytes[0],
+                1 => g.rpl40[band][path].copy_from_slice(&bytes[0..2]),
+                2 => g.rpl80[band][path].copy_from_slice(&bytes),
+                3 => {
+                    let at = if kind & 0xf == 0 { 0 } else { 4 };
+                    g.rpl160[band][path][at..at + 4].copy_from_slice(&bytes);
+                }
+                _ => {}
+            },
+            (3, 0) => g.lna_op1db[band][bw][path][0..4].copy_from_slice(&bytes),
+            (3, 1) => g.lna_op1db[band][bw][path][4..7].copy_from_slice(&bytes[0..3]),
+            (3, 2) => g.tia_lna_op1db[band][bw][path][0..4].copy_from_slice(&bytes),
+            (3, 3) => g.tia_lna_op1db[band][bw][path][4..8].copy_from_slice(&bytes),
+            (15, _) => hal.phy_w32(addr & 0xfffff, data),
+            _ => {}
+        }
+    });
+    g
+}
