+// SPDX-License-Identifier: MPL-2.0
+
+//! The other 802.11ax chips' own parts, as Linux's `rtw8852a.c`,
+//! `rtw8851b.c`, `rtw8852c.c` and their `_rfk.c` have them. The RTL8851B
+//! is the RTL8852B with one path: its code is [`rtw8852b`]'s on path A.
+//! The RTL8852A sets the RF's channel from the baseband's code and has no
+//! MAC band bit; the RTL8852C names the channel by its frequency and has
+//! its own RF settings, 6 GHz and 160 MHz among them.
+
+use crate::{
+    chan::Chan,
+    fw::Firmware,
+    hal::{ChipId, Hal, INV_RF_DATA, RFREG_MASK, field},
+    phy,
+    regs::*,
+    rtw8852b,
+};
+
+const SCO_BARKER_8852A: [u32; 14] = [0x1cfea, 0x1d0e1, 0x1d1d7, 0x1d2cd, 0x1d3c3, 0x1d4b9, 0x1d5b0, 0x1d6a6, 0x1d79c, 0x1d892, 0x1d988, 0x1da7f, 0x1db75, 0x1ddc4];
+const SCO_CCK_8852A: [u32; 14] = [0x27de3, 0x27f35, 0x28088, 0x281da, 0x2832d, 0x2847f, 0x285d2, 0x28724, 0x28877, 0x289c9, 0x28b1c, 0x28c6e, 0x28dc1, 0x290ed];
+/// The RTL8852C's CCK thresholds (`rtw8852c_sco_barker_threshold`; the
+/// RTL8922A's are the same).
+pub(crate) const SCO_BARKER_8852C: [u32; 14] = [0x1fe4f, 0x1ff5e, 0x2006c, 0x2017b, 0x2028a, 0x20399, 0x204a8, 0x205b6, 0x206c5, 0x207d4, 0x208e3, 0x209f2, 0x20b00, 0x20d8a];
+pub(crate) const SCO_CCK_8852C: [u32; 14] = [0x2bdac, 0x2bf21, 0x2c095, 0x2c209, 0x2c37e, 0x2c4f2, 0x2c666, 0x2c7db, 0x2c94f, 0x2cac3, 0x2cc38, 0x2cdac, 0x2cf21, 0x2d29e];
+
+fn sco_mapping(central: u8) -> u32 {
+    match central {
+        1 => 109,
+        2..=6 => 108,
+        7..=10 => 107,
+        11..=14 => 106,
+        36 | 38 => 51,
+        40..=58 => 50,
+        60..=64 => 49,
+        100 | 102 => 48,
+        104..=126 => 47,
+        128..=151 => 46,
+        153..=177 => 45,
+        _ => 0,
+    }
+}
+
+/// The CCK thresholds' entry (`rtw8852a_ctrl_sco_cck`).
+fn sco_element(chan: &Chan) -> Option<usize> {
+    let central = chan.channel as usize;
+    let element = match chan.bw {
+        0 => central.checked_sub(1)?,
+        1 if chan.primary == 1 => central + 1,
+        1 => central.checked_sub(3)?,
+        _ => return None,
+    };
+    (element < 14).then_some(element)
+}
+
+pub(crate) fn bb_reset(hal: &Hal) {
+    match hal.id() {
+        ChipId::Rtl8852a => {
+            hal.phy_set(R_P0_TXPW_RSTB, B_P0_TXPW_RSTB_MANON);
+            hal.phy_set(R_P0_TSSI_TRK, B_P0_TSSI_TRK_EN);
+            hal.phy_set(R_P1_TXPW_RSTB, B_P1_TXPW_RSTB_MANON);
+            hal.phy_set(R_P1_TSSI_TRK, B_P1_TSSI_TRK_EN);
+            reset_all_8852a(hal);
+            hal.phy_clr(R_P0_TXPW_RSTB, B_P0_TXPW_RSTB_MANON);
+            hal.phy_clr(R_P0_TSSI_TRK, B_P0_TSSI_TRK_EN);
+            hal.phy_clr(R_P1_TXPW_RSTB, B_P1_TXPW_RSTB_MANON);
+            hal.phy_clr(R_P1_TSSI_TRK, B_P1_TSSI_TRK_EN);
+        }
+        ChipId::Rtl8852c => reset_all_8852c(hal),
+        _ => {
+            hal.phy_w32_mask(R_P0_TXPW_RSTB, B_P0_TXPW_RSTB_MANON | B_P0_TXPW_RSTB_TSSI, 1);
+            hal.phy_set(R_P0_TSSI_TRK, B_P0_TSSI_TRK_EN);
+            hal.phy_w32_idx(R_S0_HW_SI_DIS, B_S0_HW_SI_DIS_W_R_TRIG, 0x7);
+            crate::delay_us(1);
+            hal.phy_w32_idx(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 1);
+            hal.phy_w32_idx(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 0);
+            hal.phy_w32_idx(R_S0_HW_SI_DIS, B_S0_HW_SI_DIS_W_R_TRIG, 0);
+            hal.phy_w32_idx(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 1);
+            hal.phy_w32_mask(R_P0_TXPW_RSTB, B_P0_TXPW_RSTB_MANON | B_P0_TXPW_RSTB_TSSI, 3);
+            hal.phy_clr(R_P0_TSSI_TRK, B_P0_TSSI_TRK_EN);
+        }
+    }
+}
+
+fn reset_all_8852a(hal: &Hal) {
+    hal.phy_w32_idx(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 1);
+    hal.phy_w32_idx(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 0);
+    hal.phy_w32_idx(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 1);
+}
+
+fn reset_all_8852c(hal: &Hal) {
+    hal.phy_w32_mask(R_S0_HW_SI_DIS, B_S0_HW_SI_DIS_W_R_TRIG, 0x7);
+    hal.phy_w32_mask(R_S1_HW_SI_DIS, B_S1_HW_SI_DIS_W_R_TRIG, 0x7);
+    crate::delay_us(1);
+    hal.phy_w32_idx(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 1);
+    hal.phy_w32_idx(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 0);
+    hal.phy_w32_mask(R_S0_HW_SI_DIS, B_S0_HW_SI_DIS_W_R_TRIG, 0);
+    hal.phy_w32_mask(R_S1_HW_SI_DIS, B_S1_HW_SI_DIS_W_R_TRIG, 0);
+    hal.phy_w32_idx(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 1);
+}
+
+pub(crate) fn btc_init(hal: &Hal) {
+    if hal.id() == ChipId::Rtl8851b {
+        rtw8852b::btc_init(hal);
+        return;
+    }
+    crate::coex::init(hal);
+    hal.set32(R_AX_WL_PRI_MSK, B_AX_PTA_WL_PRI_MASK_BCNQ);
+    hal.w32(R_BTC_BREAK_TABLE, BTC_BREAK_PARAM);
+    crate::coex::wlan_owns(hal);
+}
+
+pub(crate) fn bb_sethw(hal: &Hal) {
+    match hal.id() {
+        ChipId::Rtl8851b => {
+            hal.phy_clr(R_P0_EN_SOUND_WO_NDP, B_P0_EN_SOUND_WO_NDP);
+            let mut addr = R_AX_PWR_MACID_LMT_TABLE0;
+            while addr <= R_AX_PWR_MACID_LMT_TABLE127 {
+                hal.w32(addr, 0);
+                addr += 4;
+            }
+            hal.clr32(R_AX_PWR_NORM_FORCE1, B_AX_FORCE_NTX_VALUE);
+            hal.set32(R_AX_PWR_NORM_FORCE1, B_AX_FORCE_NTX_EN);
+        }
+        ChipId::Rtl8852a => {
+            hal.phy_clr(R_P0_EN_SOUND_WO_NDP, B_P0_EN_SOUND_WO_NDP);
+            hal.phy_clr(R_P1_EN_SOUND_WO_NDP, B_P1_EN_SOUND_WO_NDP);
+            if hal.cv <= CHIP_CCV as u8 {
+                hal.phy_set(R_RSTB_WATCH_DOG, B_P0_RSTB_WATCH_DOG);
+                hal.phy_w32(R_BRK_ASYNC_RST_EN_1, 0x864f_a000);
+                hal.phy_w32(R_BRK_ASYNC_RST_EN_2, 0x43f);
+                hal.phy_w32(R_BRK_ASYNC_RST_EN_3, 0x7fff);
+                hal.phy_set(R_SPOOF_ASYNC_RST, B_SPOOF_ASYNC_RST);
+                hal.phy_set(R_P0_TXPW_RSTB, B_P0_TXPW_RSTB_MANON);
+                hal.phy_set(R_P1_TXPW_RSTB, B_P1_TXPW_RSTB_MANON);
+                hal.phy_set(R_PLCP_HISTOGRAM, B_STS_PARSING_TIME);
+            }
+            hal.phy_w32_mask(R_CFO_TRK0, B_CFO_TRK_MSK, 0x1f);
+            hal.phy_w32_mask(R_CFO_TRK1, B_CFO_TRK_MSK, 0x0c);
+            hal.phy_w32_idx(R_MAC_SEL, B_MAC_SEL_MOD, 0);
+            hal.phy_clr(R_NDP_BRK0, B_NDP_RU_BRK);
+            hal.phy_set(R_NDP_BRK1, B_NDP_RU_BRK);
+            let mut addr = R_AX_PWR_MACID_LMT_TABLE0;
+            while addr <= R_AX_PWR_MACID_LMT_TABLE127 {
+                hal.w32(addr, 0);
+                addr += 4;
+            }
+        }
+        _ => {
+            hal.phy_clr(R_P0_EN_SOUND_WO_NDP, B_P0_EN_SOUND_WO_NDP);
+            hal.phy_clr(R_P1_EN_SOUND_WO_NDP, B_P1_EN_SOUND_WO_NDP);
+        }
+    }
+}
+
+/// The RX and TX paths: the RTL8851B's one, the others' two.
+pub(crate) fn cfg_txrx_path(hal: &Hal, two_g: bool) {
+    if hal.id() == ChipId::Rtl8851b {
+        hal.phy_w32_mask(R_CHBW_MOD_V1, B_ANT_RX_SEG0, 1);
+        hal.phy_w32_mask(R_FC0_BW_V1, B_ANT_RX_1RCCA_SEG0, 1);
+        hal.phy_w32_mask(R_FC0_BW_V1, B_ANT_RX_1RCCA_SEG1, 1);
+        hal.phy_w32_mask(R_RXHT_MCS_LIMIT, B_RXHT_MCS_LIMIT, 0);
+        hal.phy_w32_mask(R_RXVHT_MCS_LIMIT, B_RXVHT_MCS_LIMIT, 0);
+        hal.phy_w32_mask(R_RXHE, B_RXHE_USER_MAX, 4);
+        hal.phy_w32_mask(R_RXHE, B_RXHE_MAX_NSS, 0);
+        hal.phy_w32_mask(R_RXHE, B_RXHETB_MAX_NSS, 0);
+        hal.phy_w32_mask(R_P0_TXPW_RSTB, B_P0_TXPW_RSTB_MANON | B_P0_TXPW_RSTB_TSSI, 1);
+        hal.phy_w32_mask(R_P0_TXPW_RSTB, B_P0_TXPW_RSTB_MANON | B_P0_TXPW_RSTB_TSSI, 3);
+        hal.phy_w32_idx(R_MAC_SEL, B_MAC_SEL_MOD, 0);
+        return;
+    }
+    if hal.id() == ChipId::Rtl8852c {
+        rtw8852b::cfg_txrx_path(hal, two_g);
+        return;
+    }
+    // The RTL8852A: both paths on (its tables leave them so), TX on both.
+    hal.phy_w32_idx(R_MAC_SEL, B_MAC_SEL_MOD, 0);
+}
+
+fn channel_help(hal: &Hal, chan: &Chan, enter: bool) {
+    let id = hal.id();
+    let two_g = chan.band == phy::BAND_2G;
+    if id == ChipId::Rtl8851b {
+        rtw8852b::channel_help(hal, enter, two_g);
+        return;
+    }
+    let tssi = |enable: bool| {
+        for path in 0..2u32 {
+            hal.phy_w32_mask(0x5818 + path * 0x2000, 1 << 30, !enable as u32);
+            let other = if id == ChipId::Rtl8852c { 0x5820 + path * 0x2000 } else { 0x58dc + path * 0x2000 };
+            let bit = if id == ChipId::Rtl8852c { 1 << 31 } else { 1 << 30 };
+            hal.phy_w32_mask(other, bit, !enable as u32);
+        }
+    };
+    let (rxcca, rxcca_bit) = if id == ChipId::Rtl8852c { (R_RXCCA_V1, B_RXCCA_DIS_V1) } else { (R_RXCCA, B_RXCCA_DIS) };
+    if enter {
+        crate::sta::stop_sch_tx(hal, true);
+        crate::sta::ppdu_status(hal, false);
+        hal.phy_w32_mask(R_UPD_P0, B_UPD_P0_EN, 0);
+        tssi(false);
+        hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RST, 0xf);
+        crate::delay_us(40);
+        if id == ChipId::Rtl8852a {
+            hal.phy_w32_idx(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 0);
+        } else {
+            hal.phy_w32_mask(rxcca, rxcca_bit, 1);
+            hal.phy_w32_mask(R_PD_CTRL, B_PD_HIT_DIS, 1);
+            hal.phy_w32_idx(R_S0_HW_SI_DIS, B_S0_HW_SI_DIS_W_R_TRIG, 0x7);
+            hal.phy_w32_idx(R_S1_HW_SI_DIS, B_S1_HW_SI_DIS_W_R_TRIG, 0x7);
+            crate::delay_us(1);
+            hal.phy_w32_idx(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 0);
+        }
+    } else {
+        crate::sta::ppdu_status(hal, true);
+        hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RST, 0);
+        hal.phy_w32_mask(R_UPD_P0, B_UPD_P0_EN, 1);
+        tssi(true);
+        if id == ChipId::Rtl8852a {
+            hal.phy_w32_idx(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 1);
+        } else {
+            hal.phy_w32_idx(R_S0_HW_SI_DIS, B_S0_HW_SI_DIS_W_R_TRIG, 0);
+            hal.phy_w32_idx(R_S1_HW_SI_DIS, B_S1_HW_SI_DIS_W_R_TRIG, 0);
+            hal.phy_w32_idx(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 1);
+            if two_g {
+                hal.phy_w32_mask(rxcca, rxcca_bit, 0);
+            }
+            hal.phy_w32_mask(R_PD_CTRL, B_PD_HIT_DIS, 0);
+        }
+        crate::sta::stop_sch_tx(hal, false);
+    }
+}
+
+/// The chip's `set_channel` inside its help, with the band's TX power.
+pub(crate) fn set_channel(hal: &Hal, fw: &Firmware, chan: &Chan) {
+    channel_help(hal, chan, true);
+    match hal.id() {
+        ChipId::Rtl8851b => {
+            rtw8852b::set_channel_mac(hal, chan);
+            rtw8852b::set_channel_bb(hal, chan);
+            rtw8852b::set_channel_rf(hal, chan);
+        }
+        ChipId::Rtl8852a => set_channel_8852a(hal, chan),
+        _ => set_channel_8852c(hal, chan),
+    }
+    phy::set_txpwr(hal, fw, chan.band);
+    channel_help(hal, chan, false);
+}
+
+fn txsc_mac(hal: &Hal, chan: &Chan) {
+    let (txsc20, txsc40) = (chan.txsc(0), chan.txsc(1));
+    match chan.bw {
+        3 => {
+            hal.w8_mask(R_AX_WMAC_RFMOD, B_AX_WMAC_RFMOD_MASK, AX_WMAC_RFMOD_160M);
+            hal.w32(R_AX_TX_SUB_CARRIER_VALUE, field(B_AX_TXSC_20M_MASK, txsc20) | field(B_AX_TXSC_40M_MASK, txsc40) | field(B_AX_TXSC_80M_MASK, chan.txsc(2)));
+        }
+        2 => {
+            hal.w8_mask(R_AX_WMAC_RFMOD, B_AX_WMAC_RFMOD_MASK, 1 << 1);
+            hal.w32(R_AX_TX_SUB_CARRIER_VALUE, txsc20 | (txsc40 << 4));
+        }
+        1 => {
+            hal.w8_mask(R_AX_WMAC_RFMOD, B_AX_WMAC_RFMOD_MASK, 1 << 0);
+            hal.w32(R_AX_TX_SUB_CARRIER_VALUE, txsc20);
+        }
+        _ => {
+            hal.clr8(R_AX_WMAC_RFMOD, B_AX_WMAC_RFMOD_MASK);
+            hal.w32(R_AX_TX_SUB_CARRIER_VALUE, 0);
+        }
+    }
+}
+
+/// `rtw8852a_set_channel` (the RF's channel and width set by the
+/// baseband's code).
+fn set_channel_8852a(hal: &Hal, chan: &Chan) {
+    txsc_mac(hal, chan);
+    if chan.channel > 14 {
+        hal.set8(R_AX_TXRATE_CHK, B_AX_CHECK_CCK_EN | B_AX_RTS_LIMIT_IN_OFDM6);
+    } else {
+        hal.clr8(R_AX_TXRATE_CHK, B_AX_CHECK_CCK_EN | B_AX_RTS_LIMIT_IN_OFDM6);
+    }
+    let cck = chan.channel <= 14;
+    if cck && let Some(element) = sco_element(chan) {
+        hal.phy_w32_mask(R_RXSCOBC, B_RXSCOBC_TH, SCO_BARKER_8852A[element]);
+        hal.phy_w32_mask(R_RXSCOCCK, B_RXSCOCCK_TH, SCO_CCK_8852A[element]);
+    }
+    // `rtw8852a_ctrl_ch`.
+    for path in 0..2u8 {
+        let mut value = hal.read_rf(path, RR_CFGCH, RFREG_MASK);
+        if value == INV_RF_DATA {
+            continue;
+        }
+        value = (value & !0x303ff) | chan.channel as u32;
+        if chan.channel > 14 {
+            value |= (1 << 16) | (1 << 8);
+        }
+        hal.write_rf(path, RR_CFGCH, RFREG_MASK, value);
+    }
+    hal.phy_w32_idx(R_PATH0_TIA_ERR_G1, B_PATH0_TIA_ERR_G1_SEL, cck as u32);
+    hal.phy_w32_idx(R_P1_MODE, B_P1_MODE_SEL, cck as u32);
+    hal.phy_w32_idx(R_FC0_BW, B_FC0_BW_INV, sco_mapping(chan.channel));
+    hal.phy_w32_idx(R_BANDEDGE, B_BANDEDGE_EN, cck as u32);
+    txfir(hal, chan.channel == 14, false);
+    // `rtw8852a_ctrl_bw`.
+    let (set, prich) = match chan.bw {
+        1 => (1, chan.pri_ch_idx as u32),
+        2 => (2, chan.pri_ch_idx as u32),
+        _ => (0, 0),
+    };
+    hal.phy_w32_idx(R_FC0_BW, B_FC0_BW_SET, set);
+    hal.phy_w32_idx(R_CHBW_MOD, B_CHBW_MOD_SBW, 0);
+    hal.phy_w32_idx(R_CHBW_MOD, B_CHBW_MOD_PRICH, prich);
+    if chan.bw == 1 {
+        hal.phy_w32_mask(R_RXSC, B_RXSC_EN, (chan.pri_ch_idx as u32 == RTW89_SC_20_UPPER) as u32);
+    }
+    for path in 0..2u32 {
+        let mut value = hal.read_rf(path as u8, RR_CFGCH, RFREG_MASK);
+        if value == INV_RF_DATA {
+            continue;
+        }
+        hal.phy_w32_mask([0x12d0, 0x32d0][path as usize], 0x6000, 0);
+        hal.phy_w32_mask([0x12ec, 0x32ec][path as usize], 0x30, 2);
+        value &= !((1 << 11) | (1 << 10));
+        value |= match chan.bw {
+            1 => 1 << 11,
+            2 => 1 << 10,
+            _ => (1 << 11) | (1 << 10),
+        };
+        hal.write_rf(path as u8, RR_CFGCH, RFREG_MASK, value);
+    }
+    if cck {
+        hal.phy_w32_mask(R_RXCCA, B_RXCCA_DIS, 0);
+    } else {
+        hal.phy_w32_mask(R_RXCCA, B_RXCCA_DIS, 1);
+        hal.phy_set(R_P0_TSSI_TRK, B_P0_TSSI_TRK_EN);
+        hal.phy_set(R_P1_TSSI_TRK, B_P1_TSSI_TRK_EN);
+        reset_all_8852a(hal);
+        hal.phy_clr(R_P0_TSSI_TRK, B_P0_TSSI_TRK_EN);
+        hal.phy_clr(R_P1_TSSI_TRK, B_P1_TSSI_TRK_EN);
+        crate::delay_us(1);
+    }
+    // `rtw8852a_spur_elimination`.
+    let notch = match chan.channel {
+        153 => Some((0x210, 0x7c0)),
+        151 => Some((0x210, 0x40)),
+        155 => Some((0x2d0, 0x740)),
+        _ => None,
+    };
+    match notch {
+        Some((nbi, csi)) => {
+            hal.phy_w32_mask(R_P0_NBIIDX, B_P0_NBIIDX_VAL, nbi);
+            hal.phy_w32_mask(R_P1_NBIIDX, B_P1_NBIIDX_VAL, nbi);
+            hal.phy_w32_mask(R_SEG0CSI, B_SEG0CSI_IDX, csi);
+            hal.phy_w32_mask(R_P0_NBIIDX, B_P0_NBIIDX_NOTCH_EN, 1);
+            hal.phy_w32_mask(R_P1_NBIIDX, B_P1_NBIIDX_NOTCH_EN, 1);
+            hal.phy_w32_mask(R_SEG0CSI_EN, B_SEG0CSI_EN, 1);
+        }
+        None => {
+            hal.phy_w32_mask(R_P0_NBIIDX, B_P0_NBIIDX_NOTCH_EN, 0);
+            hal.phy_w32_mask(R_P1_NBIIDX, B_P1_NBIIDX_NOTCH_EN, 0);
+            hal.phy_w32_mask(R_SEG0CSI_EN, B_SEG0CSI_EN, 0);
+        }
+    }
+    hal.phy_w32_mask(R_MAC_PIN_SEL, B_CH_IDX_SEG0, chan.primary as u32);
+    reset_all_8852a(hal);
+}
+
+fn txfir(hal: &Hal, ch14: bool, v1: bool) {
+    let values: [u32; 8] = if ch14 {
+        [0x3b13ff, 0x1c42de, 0xfdb0ad, 0xf60f6e, 0xfd8f92, 0x2d011, 0x1c02c, 0xfff00a]
+    } else {
+        [0x3d23ff, 0x29b354, 0xfc1c8, 0xfdb053, 0xf86f9a, 0xfaef92, 0xfe5fcc, 0xffdff5]
+    };
+    let regs = if v1 {
+        [(R_PCOEFF0_V1, B_PCOEFF01_MSK_V1), (R_PCOEFF2_V1, B_PCOEFF23_MSK_V1), (R_PCOEFF4_V1, B_PCOEFF45_MSK_V1), (R_PCOEFF6_V1, B_PCOEFF67_MSK_V1), (R_PCOEFF8_V1, B_PCOEFF89_MSK_V1), (R_PCOEFFA_V1, B_PCOEFFAB_MSK_V1), (R_PCOEFFC_V1, B_PCOEFFCD_MSK_V1), (R_PCOEFFE_V1, B_PCOEFFEF_MSK_V1)]
+    } else {
+        [(R_TXFIR0, B_TXFIR_C01), (R_TXFIR2, B_TXFIR_C23), (R_TXFIR4, B_TXFIR_C45), (R_TXFIR6, B_TXFIR_C67), (R_TXFIR8, B_TXFIR_C89), (R_TXFIRA, B_TXFIR_CAB), (R_TXFIRC, B_TXFIR_CCD), (R_TXFIRE, B_TXFIR_CEF)]
+    };
+    for ((reg, mask), value) in regs.iter().zip(values) {
+        hal.phy_w32_mask(*reg, *mask, value);
+    }
+}
+
+/// `rtw8852c_ctrl_tx_path_tmac`: the MAC's TX paths (6 GHz sends on path
+/// B alone), no per-station antennas.
+fn tx_path_tmac_8852c(hal: &Hal, six: bool) {
+    hal.phy_w32_idx(R_MAC_SEL, B_MAC_SEL_MOD, 0);
+    for addr in (R_AX_MACID_ANT_TABLE..=R_AX_MACID_ANT_TABLE_LAST).step_by(4) {
+        hal.w32(addr, 0);
+    }
+    let (com0, com1, com2, com7, com8) = if six {
+        (AX_PATH_COM0_PATHB, AX_PATH_COM1_PATHB, AX_PATH_COM2_PATHB, AX_PATH_COM7_PATHB, AX_PATH_COM8_PATHB)
+    } else {
+        (AX_PATH_COM0_PATHAB, AX_PATH_COM1_PATHAB, AX_PATH_COM2_PATHAB, AX_PATH_COM7_PATHAB, AX_PATH_COM8_PATHAB)
+    };
+    for (reg, value) in [
+        (R_AX_PATH_COM0, com0),
+        (R_AX_PATH_COM1, com1),
+        (R_AX_PATH_COM2, com2),
+        (R_AX_PATH_COM3, AX_PATH_COM3_DFVAL),
+        (R_AX_PATH_COM4, AX_PATH_COM4_DFVAL),
+        (R_AX_PATH_COM5, AX_PATH_COM5_DFVAL),
+        (R_AX_PATH_COM6, AX_PATH_COM6_DFVAL),
+        (R_AX_PATH_COM7, com7),
+        (R_AX_PATH_COM8, com8),
+        (R_AX_PATH_COM9, AX_PATH_COM9_DFVAL),
+        (R_AX_PATH_COM10, AX_PATH_COM10_DFVAL),
+        (R_AX_PATH_COM11, AX_PATH_COM11_DFVAL),
+    ] {
+        hal.w32(reg, value);
+    }
+}
+
+/// `rtw8852c_set_channel` (one PHY, both paths).
+fn set_channel_8852c(hal: &Hal, chan: &Chan) {
+    // `rtw8852c_set_channel_mac`.
+    txsc_mac(hal, chan);
+    hal.clr8(R_AX_TXRATE_CHK, B_AX_BAND_MODE | B_AX_CHECK_CCK_EN | B_AX_RTS_LIMIT_IN_OFDM6);
+    hal.set8(R_AX_TXRATE_CHK, if chan.band == phy::BAND_2G { B_AX_BAND_MODE } else { B_AX_CHECK_CCK_EN | B_AX_RTS_LIMIT_IN_OFDM6 });
+    // `rtw8852c_set_channel_bb`.
+    let cck = chan.band == phy::BAND_2G;
+    if cck && let Some(element) = sco_element(chan) {
+        hal.phy_w32_mask(R_BK_FC0_INV_V1, B_BK_FC0_INV_MSK_V1, SCO_BARKER_8852C[element]);
+        hal.phy_w32_mask(R_CCK_FC0_INV_V1, B_CCK_FC0_INV_MSK_V1, SCO_CCK_8852C[element]);
+    }
+    let six = chan.band == phy::BAND_6G;
+    let freq = chan.center_freq();
+    hal.phy_w32_idx(R_PATH0_BAND_SEL_V1, B_PATH0_BAND_SEL_MSK_V1, cck as u32);
+    hal.phy_w32_idx(R_PATH1_BAND_SEL_V1, B_PATH1_BAND_SEL_MSK_V1, cck as u32);
+    hal.phy_clr(R_2P4G_BAND, B_2P4G_BAND_SEL);
+    hal.phy_w32_idx(R_FC0_V1, B_FC0_MSK_V1, freq);
+    hal.phy_w32_idx(R_FC0_BW, B_FC0_BW_INV, ((1u32 << 18) + freq / 2) / freq);
+    if cck {
+        txfir(hal, chan.channel == 14, true);
+    }
+    hal.phy_w32_idx(R_MAC_PIN_SEL, B_CH_IDX_SEG0, chan.encoded_index() as u32);
+    let (set, prich, dly, sel) = match chan.bw {
+        1 => (1, chan.pri_ch_idx as u32, 3, 0xf),
+        2 => (2, chan.pri_ch_idx as u32, 2, 0xd),
+        3 => (3, chan.pri_ch_idx as u32, 1, 0xb),
+        _ => (0, 0, 3, 0xf),
+    };
+    hal.phy_w32_idx(R_FC0_BW, B_FC0_BW_SET, set);
+    hal.phy_w32_idx(R_CHBW_MOD, B_CHBW_MOD_SBW, 0);
+    hal.phy_w32_idx(R_CHBW_MOD, B_CHBW_MOD_PRICH, prich);
+    hal.phy_w32_mask(R_PATH0_SAMPL_DLY_T_V1, B_PATH0_SAMPL_DLY_T_MSK_V1, dly);
+    hal.phy_w32_mask(R_PATH1_SAMPL_DLY_T_V1, B_PATH1_SAMPL_DLY_T_MSK_V1, dly);
+    hal.phy_w32_mask(R_PATH0_BW_SEL_V1, B_PATH0_BW_SEL_MSK_V1, sel);
+    hal.phy_w32_mask(R_PATH1_BW_SEL_V1, B_PATH1_BW_SEL_MSK_V1, sel);
+    hal.phy_w32_idx(R_RX_BW40_2XFFT_EN_V1, B_RX_BW40_2XFFT_EN_MSK_V1, (chan.bw == 1) as u32);
+    hal.phy_w32_idx(R_T2F_GI_COMB, B_T2F_GI_COMB_EN, (chan.bw == 1) as u32);
+    for path in 0..2u32 {
+        hal.phy_w32_mask(0xc0ec + path * 0x100, 0x6000, 0);
+        hal.phy_w32_mask(0xc0e4 + path * 0x100, 0x30, 2);
+    }
+    // `rtw8852c_edcca_per20_bitmap_sifs`.
+    hal.phy_w32_idx(R_SNDCCA_A1, B_SNDCCA_A1_EN, if chan.bw == 0 { 0xff } else { 0 });
+    hal.phy_w32_idx(R_SNDCCA_A2, B_SNDCCA_A2_VAL, 0);
+    hal.phy_w32_mask(R_UPD_CLK_ADC, B_ENABLE_CCK, cck as u32);
+    hal.phy_w32_mask(R_RXCCA_V1, B_RXCCA_DIS_V1, !cck as u32);
+    hal.phy_w32_idx(R_PD_ARBITER_OFF, B_PD_ARBITER_OFF, !cck as u32);
+    // 160 MHz: which 80 MHz the primary channel is in (not on the first cut).
+    if chan.bw == 3 && hal.cv != CHIP_CAV as u8 {
+        hal.phy_w32_idx(R_P80_AT_HIGH_FREQ, B_P80_AT_HIGH_FREQ, 0);
+        let high = (chan.primary > chan.channel) as u32;
+        hal.phy_w32_mask(R_P80_AT_HIGH_FREQ_RU_ALLOC, B_P80_AT_HIGH_FREQ_RU_ALLOC_PHY0, high);
+        hal.w32_mask(R_P80_AT_HIGH_FREQ_BB_WRP, B_P80_AT_HIGH_FREQ_BB_WRP, high);
+    }
+    hal.phy_w32_idx(R_CDD_EVM_CHK_EN, B_CDD_EVM_CHK_EN, !(six && chan.bw == 3) as u32);
+    for (reg, mask) in [(R_P0_TXPW_RSTB, B_P0_TXPW_RSTB_TSSI | B_P0_TXPW_RSTB_MANON), (R_P1_TXPW_RSTB, B_P1_TXPW_RSTB_TSSI | B_P1_TXPW_RSTB_MANON)] {
+        hal.phy_w32_mask(reg, mask, 1);
+        hal.phy_w32_mask(reg, mask, 3);
+    }
+    if six {
+        hal.phy_set(R_MUIC, B_MUIC_EN);
+    } else {
+        hal.phy_clr(R_MUIC, B_MUIC_EN);
+    }
+    tx_path_tmac_8852c(hal, six);
+    reset_all_8852c(hal);
+    // `rtw8852c_set_channel_rf`: the channel (`_ctrl_ch`), then each path's
+    // width.
+    ctrl_ch_8852c(hal, chan.channel, chan.band);
+    for path in 0..2u8 {
+        for reg in [RR_CFGCH, RR_CFGCH_V1] {
+            let mut value = hal.read_rf(path, reg, RFREG_MASK) & !RR_CFGCH_BW;
+            let (bw, b0, b1) = match chan.bw {
+                1 => (CFGCH_BW_40M, 0x3, 0xf),
+                2 => (CFGCH_BW_80M, 0x2, 0xd),
+                3 => (CFGCH_BW_160M, 0x1, 0xb),
+                _ => (CFGCH_BW_20M, 0x3, 0xf),
+            };
+            value |= field(RR_CFGCH_BW, bw);
+            hal.phy_w32_mask(R_P0_CFCH_BW0 | ((path as u32) << 8), B_P0_CFCH_BW0, b0);
+            hal.phy_w32_mask(R_P0_CFCH_BW1 | ((path as u32) << 8), B_P0_CFCH_BW1, b1);
+            hal.write_rf(path, reg, RFREG_MASK, value);
+        }
+        hal.write_rf(path, RR_LUTWE2, RR_LUTWE2_RTXBW, 1);
+        hal.write_rf(path, RR_LUTWA, RR_LUTWA_M2, 0xa);
+        hal.write_rf(path, RR_LUTWD0, RR_LUTWD0_LB, match chan.bw {
+            0 => 0x1b,
+            1 => 0x13,
+            2 => 0xb,
+            _ => 0x3,
+        });
+        hal.write_rf(path, RR_LUTWE2, RR_LUTWE2_RTXBW, 0);
+        hal.write_rf(path, RR_RXBB2, RR_RXBB2_EBW, if chan.bw == 3 { 0 } else { 0x2 });
+    }
+}
+
+/// `_ctrl_ch` of the RTL8852C: both paths' channel and band in RF register
+/// 0x18 and its copy; nothing for a channel outside the band's.
+pub(crate) fn ctrl_ch_8852c(hal: &Hal, central: u8, band: u8) {
+    let valid = if band == phy::BAND_6G { central <= 253 && central != 2 } else { !matches!(central, 0 | 15..=35 | 65..=99 | 145..=148 | 178..) };
+    if !valid {
+        return;
+    }
+    let field_of = |value: u32, mask: u32| field(mask, value);
+    for path in 0..2u8 {
+        for reg in [RR_CFGCH, RR_CFGCH_V1] {
+            let mut value = hal.read_rf(path, reg, RFREG_MASK);
+            value &= !(RR_CFGCH_BAND1 | RR_CFGCH_BAND0 | RR_CFGCH_CH);
+            value |= field(RR_CFGCH_CH, central as u32);
+            value |= match band {
+                phy::BAND_2G => field_of(CFGCH_BAND1_2G, RR_CFGCH_BAND1) | field_of(CFGCH_BAND0_2G, RR_CFGCH_BAND0),
+                phy::BAND_6G => field_of(CFGCH_BAND1_6G, RR_CFGCH_BAND1) | field_of(CFGCH_BAND0_6G, RR_CFGCH_BAND0),
+                _ => field_of(CFGCH_BAND1_5G, RR_CFGCH_BAND1) | field_of(CFGCH_BAND0_5G, RR_CFGCH_BAND0),
+            };
+            hal.write_rf(path, reg, RFREG_MASK, value);
+            crate::delay_us(100);
+        }
+    }
+}
+
+/// The RC calibration (`_rck`; the RTL8852A's sets its offset after).
+pub(crate) fn rck(hal: &Hal, path: u8) {
+    let reg5 = hal.read_rf(path, RR_RSV1, RFREG_MASK);
+    hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 0);
+    hal.write_rf(path, RR_MOD, RR_MOD_MASK, RR_MOD_V_RX);
+    hal.write_rf(path, RR_RCKC, RFREG_MASK, 0x00240);
+    let _ = aster_linuxkpi::delay::read_poll_timeout(|| hal.read_rf(path, 0x1c, 1 << 3), |value| *value != 0, 2, 20);
+    let value = hal.read_rf(path, RR_RCKC, RR_RCKC_CA);
+    hal.write_rf(path, RR_RCKC, RFREG_MASK, value);
+    if hal.id() == ChipId::Rtl8852a {
+        hal.write_rf(path, RR_RCKO, RR_RCKO_OFF, 0x4);
+        hal.write_rf(path, RR_RFC, RR_RFC_CKEN, 1);
+        hal.write_rf(path, RR_RFC, RR_RFC_CKEN, 0);
+    }
+    hal.write_rf(path, RR_RSV1, RFREG_MASK, reg5);
+}
+
+/// The RX DC offset (`_rx_dck` of the RTL8852A and RTL8852C, without the
+/// AFE's part).
+fn rx_dck(hal: &Hal) {
+    crate::sta::stop_sch_tx(hal, true);
+    for path in 0..hal.chip.rf_paths {
+        let _ = aster_linuxkpi::delay::read_poll_timeout(|| hal.read_rf(path, RR_MOD, RR_MOD_MASK), |mode| *mode != 2, 2, 5000);
+        let reg5 = hal.read_rf(path, RR_RSV1, RFREG_MASK);
+        hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 0);
+        hal.write_rf(path, RR_MOD, RR_MOD_MASK, RR_MOD_V_RX);
+        if hal.id() == ChipId::Rtl8852a {
+            let tune = hal.read_rf(path, RR_DCK, RR_DCK_FINE);
+            hal.write_rf(path, RR_DCK, RR_DCK_FINE, 0);
+            hal.write_rf(path, RR_DCK2, RR_DCK2_CYCLE, 0x3f);
+            hal.write_rf(path, RR_DCK1, RR_DCK1_SEL, 0);
+            hal.write_rf(path, RR_DCK, RR_DCK_LV, 0);
+            hal.write_rf(path, RR_DCK, RR_DCK_LV, 1);
+            crate::delay_us(600);
+            hal.write_rf(path, RR_DCK, RR_DCK_LV, 0);
+            hal.write_rf(path, RR_DCK, RR_DCK_FINE, tune);
+        } else {
+            hal.write_rf(path, RR_MOD, RR_MOD_LO_SEL, 0);
+            hal.write_rf(path, RR_DCK1, RR_DCK1_CLR, 0);
+            hal.write_rf(path, RR_DCK, RR_DCK_LV, 0);
+            hal.write_rf(path, RR_DCK, RR_DCK_LV, 1);
+            crate::delay_us(1000);
+        }
+        hal.write_rf(path, RR_RSV1, RFREG_MASK, reg5);
+    }
+    crate::sta::stop_sch_tx(hal, false);
+}
+
+pub(crate) fn rfk_init(hal: &Hal) {
+    // `rtw8851b_rfk_init`'s hardware.
+    if hal.id() == ChipId::Rtl8851b {
+        crate::rtw8851b_rfk::power_on(hal);
+        return;
+    }
+    for path in 0..hal.chip.rf_paths {
+        rck(hal, path);
+    }
+    // `rtw8852c_dack`, `rtw8852a_dack`, then the RX DC offset (the
+    // RTL8852A's by the AFE).
+    match hal.id() {
+        ChipId::Rtl8852c => crate::rtw8852c_rfk::dac_cal(hal),
+        ChipId::Rtl8852a => crate::rtw8852a_rfk::dac_cal(hal),
+        _ => {}
+    }
+    if hal.id() == ChipId::Rtl8852a {
+        crate::rtw8852a_rfk::rx_dck(hal, &[false; 2]);
+    } else {
+        rx_dck(hal);
+    }
+}
+
+pub(crate) fn rfk_channel(hal: &Hal) {
+    match hal.id() {
+        ChipId::Rtl8851b => crate::rtw8851b_rfk::rx_dck(hal, false),
+        ChipId::Rtl8852a => crate::rtw8852a_rfk::rx_dck(hal, &[false; 2]),
+        _ => rx_dck(hal),
+    }
+}
diff --git a/kernel/comps/rtw89/src/rtw8922a.rs b/kernel/comps/rtw89/src/rtw8922a.rs
new file mode 100644
index 0000000..9490a19
--- /dev/null
+++ b/kernel/comps/rtw89/src/rtw8922a.rs
@@ -0,0 +1,1074 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The RTL8922A's own parts, as Linux's `rtw8922a.c`, `rtw8922a_rfk.c`
+//! and the BE generation's `phy_be.c` have them: the baseband before and
+//! after its tables (its MCU's registers), the gains of the board's
+//! table, the channel (MAC, baseband, RF), the paths, the TX power (by
+//! rate from the firmware's table, the limits a cap; the closed loop's set
+//! up sent to the firmware, [`tssi_command`]),
+//! Bluetooth's share of the antennas, the bias trims of the eFuse. The
+//! calibrations are the firmware's: H2C commands ask for them
+//! ([`RfkMcc`] the channel each table of results is for).
+//!
+//! The chip runs as one 2x2 radio (`MLO_2_PLUS_0_1RF`: both paths on the
+//! first baseband), not Linux's default of two bands.
+
+use alloc::vec::Vec;
+
+use crate::{
+    be,
+    chan::Chan,
+    fw::{Firmware, TxPowerTrack},
+    hal::{Hal, INV_RF_DATA, RFREG_MASK, field},
+    mac::{Tssi, xtal},
+    phy, rtw88xx,
+    regs::*,
+};
+
+/// `MLO_2_PLUS_0_1RF` (`MLO_MODE_FOR_BB0_BB1_RF(2, 0, 1)`).
+pub(crate) const MLO_2_PLUS_0_1RF: u32 = 0x1002;
+const HE_N_USER_MAX_8922A: u32 = 4;
+/// `RTW89_FW_VER_CODE`.
+const fn ver(major: u8, minor: u8, sub: u8, idx: u8) -> u32 {
+    u32::from_be_bytes([major, minor, sub, idx])
+}
+
+/// What the firmware's version says of the commands it takes (Linux's
+/// `fw_feat_tbl` for the RTL8922A).
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Features {
+    /// `RFK_PRE_NOTIFY_V0`..`V2`, none from 0.35.84 on.
+    pub(crate) pre_ntfy: Option<u8>,
+    /// `RFK_PRE_NOTIFY_MCC_V0`, `_V1`.
+    pub(crate) pre_ntfy_mcc: Option<u8>,
+    pub(crate) iqk_v0: bool,
+    pub(crate) rxdck_v0: bool,
+    pub(crate) addr_cam_v0: bool,
+    pub(crate) macid_pause_sleep: bool,
+    /// Power save takes the channel as `LPS_CH_INFO` (before 0.35.31),
+    /// else as `LPS_ML_CMN_INFO`.
+    pub(crate) lps_ch_info: bool,
+}
+
+impl Features {
+    pub(crate) fn of(version: (u8, u8, u8, u8)) -> Self {
+        let code = ver(version.0, version.1, version.2, version.3);
+        let ge = |minor, sub| code >= ver(0, minor, sub, 0);
+        let pre_ntfy = if ge(35, 84) {
+            None
+        } else if ge(35, 49) {
+            Some(2)
+        } else if ge(35, 31) {
+            Some(1)
+        } else {
+            Some(0)
+        };
+        let pre_ntfy_mcc = if ge(35, 84) {
+            Some(1)
+        } else if ge(35, 49) {
+            Some(0)
+        } else {
+            None
+        };
+        Self {
+            pre_ntfy,
+            pre_ntfy_mcc,
+            iqk_v0: !ge(35, 28),
+            rxdck_v0: !ge(35, 42),
+            addr_cam_v0: !ge(35, 84),
+            macid_pause_sleep: ge(34, 11),
+            lps_ch_info: !ge(35, 31),
+        }
+    }
+}
+
+// ---- The baseband around its tables. ----
+
+/// `bb_mcu0_init_reg`.
+const BB_MCU0_INIT: [(u32, u32); 10] = [
+    (0x6990, 0),
+    (0x6994, 0),
+    (0x6998, 0),
+    (0x6820, 0xffff_fffe),
+    (0x6800, 0xc000_0ffe),
+    (0x6808, 0x7654_3210),
+    (0x6814, 0xbfbf_b000),
+    (0x6818, 0x0478_c009),
+    (0x6800, 0xc000_0fff),
+    (0x6820, 0xffff_ffff),
+];
+
+/// `rtw8922a_bb_preinit` for the first baseband (before the download:
+/// its MCU's firmware goes with the WLAN CPU's).
+pub(crate) fn bb_preinit(hal: &Hal) {
+    hal.w32_mask(R_BE_DMAC_SYS_CR32B, B_BE_DMAC_BB_PHY0_MASK, 0x7ff9);
+    hal.w32_mask(R_BE_FEN_RST_ENABLE, B_BE_FEN_BB_IP_RSTN, 0);
+    hal.w32_mask(R_BE_FEN_RST_ENABLE, B_BE_FEN_BBPLAT_RSTB, 0);
+    hal.w32_mask(R_BE_FEN_RST_ENABLE, B_BE_FEN_BB_IP_RSTN, 1);
+    hal.w32_mask(R_BE_FEN_RST_ENABLE, B_BE_BOOT_RDY0, 0);
+    hal.w32_mask(R_BE_MEM_PWR_CTRL, B_BE_MEM_BBMCU0_DS_V1, 0);
+    crate::delay_us(1);
+    for (addr, data) in BB_MCU0_INIT {
+        hal.w32(addr + RTW89_BBMCU_ADDR_OFFSET, data);
+    }
+}
+
+/// `rtw8922a_bb_postinit`.
+pub(crate) fn bb_postinit(hal: &Hal) {
+    hal.set32(R_BE_FEN_RST_ENABLE, B_BE_BOOT_RDY0);
+    hal.set32(R_BE_FEN_RST_ENABLE, B_BE_FEN_BBPLAT_RSTB);
+    hal.phy_set(R_BBCLK, B_CLK_640M);
+    hal.phy_clr(R_TXSCALE, B_TXFCTR_EN);
+    for (addr, mask, value) in [
+        (R_TXFCTR, B_TXFCTR_THD, 0x200),
+        (R_SLOPE, B_EHT_RATE_TH, 0xa),
+        (R_BEDGE, B_HE_RATE_TH, 0xa),
+        (R_BEDGE2, B_HT_VHT_TH, 0xaaa),
+        (R_BEDGE, B_EHT_MCS14, 0x1),
+        (R_BEDGE2, B_EHT_MCS15, 0x1),
+        (R_BEDGE3, B_EHTTB_EN, 0x0),
+        (R_BEDGE3, B_HEERSU_EN, 0x0),
+        (R_BEDGE3, B_HEMU_EN, 0x0),
+        (R_BEDGE3, B_TB_EN, 0x0),
+        (R_SU_PUNC, B_SU_PUNC_EN, 0x1),
+        (R_BEDGE5, B_HWGEN_EN, 0x1),
+        (R_BEDGE5, B_PWROFST_COMP, 0x1),
+        (R_MAG_AB, B_BY_SLOPE, 0x1),
+        (R_MAG_A, B_MGA_AEND, 0xe0),
+        (R_MAG_AB, B_MAG_AB, 0xe0c000),
+        (R_SLOPE, B_SLOPE_A, 0x3fe0),
+        (R_SLOPE, B_SLOPE_B, 0x3fe0),
+        (R_SC_CORNER, B_SC_CORNER, 0x200),
+        (R_UDP_COEEF, B_UDP_COEEF, 0x0),
+        (R_UDP_COEEF, B_UDP_COEEF, 0x1),
+    ] {
+        hal.phy_w32_mask(addr, mask, value);
+    }
+}
