+/// `rtw89_phy_bb_wrap_init_be` for MAC 0: no per-MAC-ID power or path,
+/// the TX power unit's tables cleared and nothing forced, FTM's, uplink
+/// power's limits.
+pub(crate) fn bb_wrap_init(hal: &Hal) {
+    const MACIDS: u32 = 32;
+    for index in 0..MACIDS {
+        hal.w32(R_BE_PWR_MACID_PATH_BASE + index * 4, 0);
+    }
+    for index in 0..MACIDS {
+        hal.w32(R_BE_PWR_MACID_LMT_BASE + index * 4, 0);
+    }
+    hal.w32_mask(R_BE_PWR_FTM_SS, B_BE_PWR_BY_RATE_DBW_ON, 0x3);
+    for (first, last) in [(R_BE_PWR_BY_RATE, R_BE_PWR_BY_RATE_END), (R_BE_PWR_RULMT_START, R_BE_PWR_RULMT_END), (R_BE_PWR_RATE_OFST_CTRL, R_BE_PWR_RATE_OFST_END)] {
+        for addr in (first..=last).step_by(4) {
+            hal.w32(addr, 0);
+        }
+    }
+    hal.w32_mask(R_BE_PWR_REF_CTRL, B_BE_PWR_OFST_LMT_DB, 0);
+    hal.w32_mask(R_BE_PWR_OFST_LMTBF, B_BE_PWR_OFST_LMTBF_DB, 0);
+    hal.w32_mask(R_BE_PWR_RATE_CTRL, B_BE_PWR_OFST_BYRATE_DB, 0);
+    hal.w32_mask(R_BE_PWR_OFST_RULMT, B_BE_PWR_OFST_RULMT_DB, 0);
+    hal.w32_mask(R_BE_PWR_OFST_SW, B_BE_PWR_OFST_SW_DB, 0);
+    hal.w32_mask(R_BE_PWR_FORCE_LMT, B_BE_PWR_FORCE_LMT_ON, 0);
+    hal.w32_mask(R_BE_PWR_RATE_CTRL, B_BE_FORCE_PWR_BY_RATE_EN, 0);
+    hal.w32_mask(R_BE_PWR_OFST_RULMT, B_BE_PWR_FORCE_RU_ENON, 0);
+    hal.w32_mask(R_BE_PWR_OFST_RULMT, B_BE_PWR_FORCE_RU_ON, 0);
+    hal.w32_mask(R_BE_PWR_FORCE_MACID, B_BE_PWR_FORCE_MACID_ALL, 0);
+    hal.w32_mask(R_BE_PWR_COEX_CTRL, B_BE_PWR_FORCE_COEX_ON, 0);
+    hal.w32_mask(R_BE_PWR_BOOST, B_BE_PWR_FORCE_RATE_ON, 0);
+    hal.w32(R_BE_PWR_FTM, 0x00e4_e431);
+    hal.w32_mask(R_BE_PWR_FTM_SS, 0x7, 0);
+    hal.w32(R_BE_PWR_RSSI_TARGET_LMT, 0x0201_fe00);
+    hal.w32(R_BE_PWR_TH, 0x00ff_ec7e);
+}
