+    Wm(0x7834, 0x3ffff, 0x115f2), Wm(0x7834, 0x3ffc0000, 0x0), Wm(0x7838, 0xfff, 0x121), Wm(0x7838, 0x3ff000, 0x0),
+    Wm(0x7854, 0x3ffff, 0x115f2), Wm(0x7854, 0x3ffc0000, 0x0), Wm(0x7858, 0xfff, 0x121), Wm(0x7858, 0x3ff000, 0x0),
+    Wm(0x7824, 0x3ffff, 0x115f2), Wm(0x7824, 0x3ffc0000, 0x0), Wm(0x7828, 0xfff, 0x121), Wm(0x7828, 0x3ff000, 0x0),
