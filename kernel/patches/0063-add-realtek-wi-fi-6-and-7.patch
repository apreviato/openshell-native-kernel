+// SPDX-License-Identifier: MPL-2.0
+
+//! The interface as mac80211 runs it over rtw89 on the 802.11ax chips: the
+//! chip brought up (`rtw89_core_start`), the interface on port 0 with MAC
+//! ID 0 (role, join information, address CAM, CMAC table); as a station,
+//! a software scan and the access point joined (its station on the same
+//! MAC ID, its rates for the firmware's rate adaptation); as an access
+//! point, the port beaconing (the beacon given to the firmware) and each
+//! station on a MAC ID and address CAM entry of its own; keys in the
+//! security CAM, frames with their WD pages, frames and PPDU reports
+//! (their signal) in. The driver puts the CCMP header on protected frames
+//! (the chips other than the RTL8852C leave it to the host); the chip
+//! encrypts.
+
+use alloc::{
+    collections::{BTreeMap, VecDeque},
+    string::String,
+    sync::Arc,
+    vec,
+    vec::Vec,
+};
+use core::sync::atomic::{AtomicU32, Ordering};
+
+use aster_linuxkpi::bits::get_le32;
+use aster_wlan::{
+    Device, chan as wchan,
+    ieee80211::{self as wifi, Address},
+    radio::{self, ApConfig, Association, Band, BandId, BeaconTemplate, BlockAck, Chandef, EhtCap, HeCap, HtCap, Info, Join, Key, Peer, Reorder, RxInfo, ScanRequest, StationEntry, VhtCap, Width},
+};
+
+use crate::{
+    be,
+    chan::Chan,
+    fw::{Firmware, H2c, Secure, TxPowerTrack, words},
+    hal::{ChipId, Hal, field, get},
+    mac::{self, Efuse, Tssi},
+    pci::{Pci, TX_FRAME_MAX, TXCH_ACH0, TXCH_CH8, TxDesc},
+    phy,
+    regs::*,
+    rtw8851b_rfk, rtw8852a_rfk, rtw8852b, rtw8852b_rfk, rtw8852bt_rfk, rtw8852c_rfk, rtw88xx,
+    rtw8922a::{self, BbGain, Features, Rfk, RfkMcc},
+};
+
+/// The data frames either way in the watchdog's 2 s above which the
+/// link stays awake.
+const LPS_THRESHOLD: u32 = 50;
+const MAC_ID: u32 = 0;
+const DWELL_ACTIVE_MS: u64 = 60;
+const DWELL_PASSIVE_MS: u64 = 110;
+const HOME_MS: u64 = 100;
+const H2C_CMC_TBL_LEN: usize = 68;
+/// The BE chips' CMAC and DMAC tables (`struct rtw89_h2c_cctlinfo_ud_g7`,
+/// `_dctlinfo_ud_v2`): the control word, sixteen values, sixteen masks.
+const H2C_TBL_G7_WORDS: usize = 33;
+/// As an access point: its stations' MAC IDs and address CAM entries,
+/// from 1; each one's pairwise key in the security CAM from
+/// `SEC_CAM_STATIONS`, two entries a station.
+const AP_STATIONS: u32 = 16;
+const SEC_CAM_STATIONS: u32 = 4;
+/// The rate adaptation's modes (`RTW89_RA_MODE_*`).
+const RA_CCK: u32 = 1 << 0;
+const RA_OFDM: u32 = 1 << 1;
+const RA_HT: u32 = 1 << 2;
+const RA_VHT: u32 = 1 << 3;
+const RA_HE: u32 = 1 << 4;
+const RA_EHT: u32 = 1 << 5;
+/// `IEEE80211_EHT_MAC_CAP0_MAX_MPDU_LEN_7991` in its field.
+const EHT_MAC0_MAX_MPDU_7991: u8 = 1 << 6;
+/// The PPE thresholds' fields (HE: present in PHY byte 6, the header's RU
+/// bitmap, its length in bits, the nominal padding in PHY byte 9; EHT: the
+/// header's 16-bit RU bitmap and length, the common nominal padding in PHY
+/// byte 5); three bits a threshold.
+const HE_PHY6_PPE_THRESHOLD_PRESENT: u8 = 0x80;
+const HE_PPE_RU_MASK: u8 = 0x78;
+const HE_PPE_HEADER_BITS: usize = 7;
+const EHT_PPE_RU_MASK: u16 = 0x01f0;
+const EHT_PPE_HEADER_BITS: usize = 9;
+const PPET_BITS: usize = 3;
+/// The widths a padding is given for: 20 to 320 MHz.
+const PPE_WIDTHS: usize = RTW89_PPE_BW_NUM as usize;
+/// Hardware rates (`RTW89_HW_RATE_CCK1`, `_OFDM6`).
+const HW_RATE_CCK1: u32 = 0;
+const HW_RATE_OFDM6: u32 = 4;
+/// Security CAM types (`RTW89_SEC_KEY_TYPE_*`) as the TX descriptor and
+/// the CAM name them.
+const SEC_TKIP: u32 = 3;
+const SEC_CCMP128: u32 = 6;
+const SEC_CCMP256: u32 = 7;
+const SEC_GCMP128: u32 = 8;
+const SEC_GCMP256: u32 = 9;
+/// `RTW89_ADDR_CAM_SEC_NORMAL`, the CAM entry each key has, the address
+/// CAM's own entries.
+const SEC_CAM_PAIRWISE: u32 = 0;
+const SEC_CAM_GROUP: u32 = 2;
+const ADDR_CAM_SEC_NORMAL: u32 = 1;
+
+/// `IEEE80211_EML_CAP_EMLSR_PADDING_DELAY_256US`,
+/// `_EMLSR_TRANSITION_DELAY_256US` (EMLSR's delays the join names; this
+/// driver links once).
+const EML_PADDING_DELAY_256US: u32 = 4;
+const EMLSR_TRANSITION_DELAY_256US: u32 = 5;
+
+/// TX scheduling of MAC 0 before it was stopped.
+static TX_EN: AtomicU32 = AtomicU32::new(0xffff);
+
+/// `rtw89_chip_stop_sch_tx` / `resume_sch_tx` on MAC 0.
+pub(crate) fn stop_sch_tx(hal: &Hal, stop: bool) {
+    if hal.chip.be {
+        if stop {
+            TX_EN.store(be::sch_tx(hal, None), Ordering::Relaxed);
+        } else {
+            be::sch_tx(hal, Some(TX_EN.load(Ordering::Relaxed)));
+        }
+        return;
+    }
+    if stop {
+        TX_EN.store(hal.r16(R_AX_CTN_TXEN) as u32, Ordering::Relaxed);
+        hal.w16_mask(R_AX_CTN_TXEN, B_AX_CTN_TXEN_ALL_MASK, 0);
+    } else {
+        hal.w16_mask(R_AX_CTN_TXEN, B_AX_CTN_TXEN_ALL_MASK, TX_EN.load(Ordering::Relaxed));
+    }
+}
+
+/// `rtw89_mac_cfg_ppdu_status_ax`: a report (its PHY status) per PPDU.
+pub(crate) fn ppdu_status(hal: &Hal, enable: bool) {
+    if hal.chip.be {
+        return be::ppdu_status(hal, enable);
+    }
+    if !enable {
+        hal.clr32(R_AX_PPDU_STAT, B_AX_PPDU_STAT_RPT_EN);
+        return;
+    }
+    hal.w32(R_AX_PPDU_STAT, B_AX_PPDU_STAT_RPT_EN | B_AX_APP_MAC_INFO_RPT | B_AX_APP_PLCP_HDR_RPT | B_AX_PPDU_STAT_RPT_CRC32);
+    hal.w32_mask(R_AX_HW_RPT_FWD, B_AX_FWD_PPDU_STAT_MASK, RTW89_PRPT_DEST_HOST);
+}
+
+/// An RX descriptor (`rtw89_core_query_rxdesc`).
+struct RxDesc {
+    pkt_size: usize,
+    pkt_type: u32,
+    long: bool,
+    ppdu_cnt: u32,
+    frame_type: u32,
+    hw_dec: bool,
+    icv_err: bool,
+    crc_err: bool,
+    /// The payload's offset after the descriptor.
+    offset: usize,
+}
+
+fn rx_desc(be: bool, data: &[u8]) -> Option<RxDesc> {
+    if be {
+        return rx_desc_v2(data);
+    }
+    if data.len() < 16 {
+        return None;
+    }
+    let (w0, w1, w3) = (get_le32(data, 0), get_le32(data, 4), get_le32(data, 12));
+    let long = w0 & AX_RXD_LONG_RXD != 0;
+    let rxd_len = if long { 32 } else { 16 };
+    let shift = get(AX_RXD_SHIFT_MASK, w0) as usize * 2;
+    let drv_info = get(AX_RXD_DRV_INFO_SIZE_MASK, w0) as usize * 8;
+    Some(RxDesc {
+        pkt_size: get(AX_RXD_RPKT_LEN_MASK, w0) as usize,
+        pkt_type: get(AX_RXD_RPKT_TYPE_MASK, w0),
+        long,
+        ppdu_cnt: get(AX_RXD_PPDU_CNT_MASK, w1),
+        frame_type: if long && data.len() >= 20 { get(AX_RXD_TYPE_MASK, get_le32(data, 16)) } else { 0xff },
+        hw_dec: w3 & AX_RXD_HW_DEC != 0,
+        icv_err: w3 & AX_RXD_ICV_ERR != 0,
+        crc_err: w3 & AX_RXD_CRC32_ERR != 0,
+        offset: shift + drv_info + rxd_len,
+    })
+}
+
+/// `rtw89_core_query_rxdesc_v2`: the BE chips' descriptor (six words, ten
+/// when long), the PHY report and converted header after it.
+fn rx_desc_v2(data: &[u8]) -> Option<RxDesc> {
+    if data.len() < 24 {
+        return None;
+    }
+    let (w0, w2, w3, w4) = (get_le32(data, 0), get_le32(data, 8), get_le32(data, 12), get_le32(data, 16));
+    let long = w0 & BE_RXD_LONG_RXD != 0;
+    let rxd_len = if long { 40 } else { 24 };
+    let shift = get(BE_RXD_SHIFT_MASK, w0) as usize * 2;
+    let drv_info = get(BE_RXD_DRV_INFO_SZ_MASK, w0) as usize * 8;
+    let phy_rpt = get(BE_RXD_PHY_RPT_SZ_MASK, w0) as usize * 8;
+    let hdr_cnv = get(BE_RXD_HDR_CNV_SZ_MASK, w0) as usize * 16;
+    Some(RxDesc {
+        pkt_size: get(BE_RXD_RPKT_LEN_MASK, w0) as usize,
+        pkt_type: get(BE_RXD_RPKT_TYPE_MASK, w0),
+        long,
+        ppdu_cnt: get(BE_RXD_PPDU_CNT_MASK, w4),
+        frame_type: get(BE_RXD_TYPE_MASK, w2),
+        hw_dec: w3 & BE_RXD_HW_DEC != 0,
+        icv_err: w3 & BE_RXD_ICV_ERR != 0,
+        crc_err: w3 & BE_RXD_CRC32_ERR != 0,
+        offset: shift + drv_info + phy_rpt + hdr_cnv + rxd_len,
+    })
+}
+
+/// Where a report's entries start after its RX descriptor (for the
+/// release reports' ring).
+pub(crate) fn rx_payload_offset(be: bool, data: &[u8]) -> Option<usize> {
+    rx_desc(be, data).map(|desc| desc.offset)
+}
+
+#[derive(Clone)]
+struct Network {
+    join: Join,
+    chan: Chan,
+    peer: Peer,
+    rates: u16,
+}
+
+/// Rates (in 500 kbit/s) as a bitmap over the band's table (all of them
+/// when none is given).
+/// The nominal packet padding a peer asks for at each width, 20 to 320 MHz
+/// (`__get_sta_eht_pkt_padding`, `__get_sta_he_pkt_padding`): from its
+/// PPE thresholds for the streams both ends run, else its nominal padding.
+fn pkt_padding(peer: &Peer, tx_nss: u8) -> [u32; PPE_WIDTHS] {
+    let nss = peer.nss.min(tx_nss).max(1) as usize - 1;
+    let (present, nominal, ru_bitmap, header, ppe, eht) = if let Some(eht) = &peer.eht {
+        let header = u16::from_le_bytes([eht.ppe.first().copied().unwrap_or(0), eht.ppe.get(1).copied().unwrap_or(0)]);
+        (eht.phy[5] & wchan::EHT_PHY5_PPE_THRESHOLD_PRESENT != 0, ((eht.phy[5] & 0x30) >> 4) as u32, ((header & EHT_PPE_RU_MASK) >> EHT_PPE_RU_MASK.trailing_zeros()) as u8, EHT_PPE_HEADER_BITS, &eht.ppe, true)
+    } else if let Some(he) = &peer.he {
+        let header = he.ppe.first().copied().unwrap_or(0);
+        (he.phy[6] & HE_PHY6_PPE_THRESHOLD_PRESENT != 0, (he.phy[9] >> 6) as u32 & 3, (header & HE_PPE_RU_MASK) >> HE_PPE_RU_MASK.trailing_zeros(), HE_PPE_HEADER_BITS, &he.ppe, false)
+    } else {
+        return [0; PPE_WIDTHS];
+    };
+    if !present {
+        return [nominal; PPE_WIDTHS];
+    }
+    let value = |bit: usize| -> u32 {
+        let low = ppe.get(bit / 8).copied().unwrap_or(0) as u32;
+        let high = ppe.get(bit / 8 + 1).copied().unwrap_or(0) as u32;
+        (((high << 8) | low) >> (bit % 8)) & 7
+    };
+    let mut pads = [0; PPE_WIDTHS];
+    let mut bit = header + ru_bitmap.count_ones() as usize * PPET_BITS * 2 * nss;
+    for (width, pad) in pads.iter_mut().enumerate() {
+        if ru_bitmap & (1 << width) == 0 {
+            *pad = RTW89_PE_DURATION_8;
+            continue;
+        }
+        let (ppe16, ppe8) = (value(bit), value(bit + PPET_BITS));
+        bit += PPET_BITS * 2;
+        *pad = if ppe16 != 7 && ppe8 == 7 {
+            if eht { RTW89_PE_DURATION_16_20 } else { RTW89_PE_DURATION_16 }
+        } else if ppe8 != 7 {
+            RTW89_PE_DURATION_8
+        } else {
+            RTW89_PE_DURATION_0
+        };
+    }
+    pads
+}
+
+fn rate_bitmap(band: BandId, rates: impl Iterator<Item = u8>) -> u16 {
+    let table = band.rates();
+    let mut bitmap = 0u16;
+    for rate in rates {
+        if let Some(index) = table.iter().position(|&known| known == rate & 0x7f) {
+            bitmap |= 1 << index;
+        }
+    }
+    if bitmap == 0 { (1 << table.len()) - 1 } else { bitmap }
+}
+
+impl Network {
+    fn new(join: &Join) -> Self {
+        let elements = wifi::Elements(&join.elements);
+        let rates = [wifi::IE_RATES, wifi::IE_EXT_RATES].iter().flat_map(|&id| elements.get(id).unwrap_or(&[]).iter().copied());
+        Self { join: join.clone(), chan: Chan::new(&join.chandef), peer: Peer::default(), rates: rate_bitmap(BandId::of(join.freq), rates) }
+    }
+}
+
+/// The network this radio runs as an access point.
+struct Ap {
+    config: ApConfig,
+    chan: Chan,
+    stations: BTreeMap<Address, ApStation>,
+    /// The group key: index, CAM entry, cipher, the next PN.
+    group: Option<(u8, u32, u32, u64)>,
+}
+
+/// A station of the access point: its MAC ID (and address CAM entry), what
+/// it runs, its pairwise key (index, CAM entry, cipher, next PN).
+struct ApStation {
+    mac_id: u32,
+    aid: u16,
+    peer: Peer,
+    pairwise: Option<(u8, u32, u32, u64)>,
+    aggregates: Aggregates,
+}
+
+/// QoS data to one peer: its sequence numbers per TID (mac80211's
+/// `tid_seq`: under an agreement a TID's follow one another), and the
+/// window of each TID agreed to go in aggregates (`ampdu_params`), 0 for
+/// none.
+#[derive(Clone, Copy, Default)]
+struct Aggregates {
+    tid_seq: [u16; 8],
+    window: [u16; 8],
+}
+
+impl Aggregates {
+    fn next_seq(&mut self, tid: u8) -> u16 {
+        let counter = &mut self.tid_seq[tid as usize & 7];
+        let value = *counter;
+        *counter = (value + 1) & 0x0fff;
+        value
+    }
+
+    /// `rtw89_core_tx_update_ampdu_info`: a frame of an agreed TID goes in
+    /// an aggregate of the window's frames at most, at the peer's spacing.
+    fn fill(&self, desc: &mut TxDesc, tid: u8, peer: &Peer) {
+        let window = self.window[tid as usize & 7];
+        if window != 0 && !desc.bmc {
+            desc.agg_en = true;
+            desc.ampdu_num = window as u32 - 1;
+            desc.ampdu_density = peer.ht.map_or(0, |ht| ht.ampdu_density as u32 & 7);
+        }
+    }
+
+    /// `rtw89_fw_h2c_ampdu_cmac_tbl_g7`'s bitmap size for the smallest
+    /// window agreed.
+    fn ba_bmap(&self) -> u32 {
+        let smallest = self.window.iter().copied().filter(|&window| window != 0).min().unwrap_or(0);
+        match smallest {
+            0..=0x20 => 3,
+            0x21..=0x40 => 0,
+            0x41..=0x80 => 1,
+            0x81..=0x100 => 2,
+            0x101..=0x200 => 4,
+            _ => 5,
+        }
+    }
+}
+
+/// A receive agreement's static BA CAM entry (`struct rtw89_ba_cam_entry`).
+struct BaCam {
+    peer: Address,
+    tid: u8,
+    mac_id: u32,
+    entry: u8,
+}
+
+/// The BA CAM of a chip (`bacam_num`, `bacam_dynamic_num`, `bacam_ver`):
+/// its static entries, the dynamic ones before them, the H2C's layout.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum BaCamVersion {
+    V0,
+    V0Ext,
+    V1,
+}
+
+fn ba_cam_layout(id: ChipId) -> (u8, u8, BaCamVersion) {
+    match id {
+        ChipId::Rtl8852c => (8, 8, BaCamVersion::V0Ext),
+        ChipId::Rtl8922a => (24, 8, BaCamVersion::V1),
+        _ => (2, 4, BaCamVersion::V0),
+    }
+}
+
+/// The BA CAM H2C's functions (`H2C_FUNC_MAC_BA_CAM`, `_V1`).
+const H2C_FUNC_MAC_BA_CAM: u32 = 0x0;
+const H2C_FUNC_MAC_BA_CAM_V1: u32 = 0x1;
+
+/// An address CAM entry (`rtw89_cam_fill_addr_cam_info`): its index and
+/// MAC ID, the addresses (ours, the peer's, the BSS's), the network type,
+/// the AID, the keys' CAM entries (key index, entry).
+struct AddrCam {
+    idx: u32,
+    mac_id: u32,
+    sma: Address,
+    tma: Address,
+    bssid: Address,
+    net_type: u32,
+    aid: u16,
+    pairwise: Option<(u8, u32)>,
+    group: Option<(u8, u32)>,
+    /// `enum rtw89_upd_mode` of the change.
+    mode: u32,
+}
+
+/// The CCMP header of a frame with this key index and packet number.
+fn ccmp_header(index: u8, pn: u64) -> [u8; 8] {
+    [pn as u8, (pn >> 8) as u8, 0, 0x20 | (index << 6), (pn >> 16) as u8, (pn >> 24) as u8, (pn >> 32) as u8, (pn >> 40) as u8]
+}
+
+struct Scan {
+    /// Each channel and whether it is only listened to.
+    channels: Vec<(u16, bool)>,
+    next: usize,
+    ssids: Vec<Vec<u8>>,
+    elements: Vec<u8>,
+    deadline: u64,
+    home: bool,
+}
+
+/// A frame waiting for its PPDU's report (its signal).
+struct Held {
+    ppdu_cnt: u32,
+    frame: Vec<u8>,
+    freq: u16,
+    decrypted: bool,
+}
+
+pub(crate) struct Rtw89 {
+    pub(crate) hal: Hal,
+    pci: Pci,
+    fw: Firmware,
+    h2c: H2c,
+    secure: Secure,
+    efuse: Efuse,
+    pub(crate) address: Address,
+    pub(crate) device: Option<Arc<Device>>,
+    chan: Option<Chan>,
+    network: Option<Network>,
+    ap: Option<Ap>,
+    associated: bool,
+    aid: u16,
+    qos: bool,
+    /// The pairwise key: index, CAM entry, cipher, the next PN.
+    pairwise: Option<(u8, u32, u32, u64)>,
+    group: Option<(u8, u32, u32)>,
+    /// The group's TKIP key's receive MIC key: the chip decrypts, the MIC
+    /// is checked here (`IEEE80211_KEY_FLAG_GENERATE_MMIC`).
+    group_mic: Option<[u8; 8]>,
+    scan: Option<Scan>,
+    sequence: u16,
+    /// QoS data to the access point (as a station), and the receive
+    /// agreements' BA CAM entries.
+    aggregates: Aggregates,
+    ba_cam: Vec<BaCam>,
+    /// Power save asked for the link, the firmware in it (leisure power
+    /// save), the data frames sent and received since the watchdog, and
+    /// when it runs next (every 2 s, as `rtw89_track_work`).
+    power_save: bool,
+    lps: bool,
+    traffic: (u32, u32),
+    watchdog: u64,
+    held: VecDeque<Held>,
+    last_rssi: i8,
+    pub(crate) signal: Option<i8>,
+    pub(crate) dead: bool,
+    /// The BE chips: the board's gains, what the firmware takes, the
+    /// channel of the calibrations' table.
+    bb_gain: BbGain,
+    features: Features,
+    rfk_mcc: RfkMcc,
+    /// The AX chips' calibrations on the host.
+    host_rfk: HostRfk,
+}
+
+/// The calibrations of a channel the host runs on an AX chip (Linux's
+/// `rtw8852a_rfk.c`, `rtw8852b_rfk.c`, `rtw8852bt_rfk.c`,
+/// `rtw8852c_rfk.c`, `rtw8851b_rfk.c`), each chip's state; none with
+/// `rtw89.nocal`.
+enum HostRfk {
+    None,
+    Rtl8852a(rtw8852a_rfk::State),
+    Rtl8851b(rtw8851b_rfk::State),
+    Rtl8852b(rtw8852b_rfk::State),
+    Rtl8852bt(rtw8852bt_rfk::State),
+    Rtl8852c(rtw8852c_rfk::State),
+}
+
+impl HostRfk {
+    fn of(id: ChipId) -> Self {
+        if crate::NO_HOST_CAL.load(Ordering::Relaxed) {
+            return Self::None;
+        }
+        match id {
+            ChipId::Rtl8852b => Self::Rtl8852b(Default::default()),
+            ChipId::Rtl8852bt => Self::Rtl8852bt(Default::default()),
+            ChipId::Rtl8852c => Self::Rtl8852c(Default::default()),
+            ChipId::Rtl8851b => Self::Rtl8851b(Default::default()),
+            ChipId::Rtl8852a => Self::Rtl8852a(Default::default()),
+            _ => Self::None,
+        }
+    }
+
+    /// The paths whose TX power the TSSI holds (`is_tssi_mode`).
+    fn tssi_mode(&self) -> [bool; 2] {
+        match self {
+            Self::None => [false; 2],
+            Self::Rtl8852b(state) => state.tssi_mode,
+            Self::Rtl8852bt(state) => state.tssi_mode,
+            Self::Rtl8852c(state) => state.tssi_mode,
+            Self::Rtl8851b(state) => [state.tssi_mode, false],
+            Self::Rtl8852a(state) => state.tssi_mode,
+        }
+    }
+
+    /// `rtw8852b_dpk_init`, `rtw8852bt_dpk_init`, the RTL8852C's state.
+    fn init(&mut self, hal: &Hal, efuse: &Efuse) {
+        match self {
+            Self::None => {}
+            Self::Rtl8852b(state) => rtw8852b_rfk::dpk_init(hal, state),
+            Self::Rtl8852bt(state) => rtw8852bt_rfk::dpk_init(hal, state),
+            Self::Rtl8852c(state) => rtw8852c_rfk::init(state, efuse),
+            Self::Rtl8851b(state) => rtw8851b_rfk::init(state),
+            Self::Rtl8852a(state) => rtw8852a_rfk::init(state),
+        }
+    }
+
+    /// The RX DC offset of a channel the chip's own way (the RTL8852C's
+    /// checked against its baseline); whether it had one.
+    fn rx_dck(&mut self, hal: &Hal) -> bool {
+        match self {
+            Self::Rtl8852c(state) => {
+                rtw8852c_rfk::rx_dck(hal, state);
+                true
+            }
+            Self::Rtl8851b(state) => {
+                rtw8851b_rfk::rx_dck(hal, state.tssi_mode);
+                true
+            }
+            Self::Rtl8852a(state) => {
+                rtw8852a_rfk::rx_dck(hal, &state.tssi_mode);
+                true
+            }
+            _ => false,
+        }
+    }
+
+    /// The channel's IQK, TSSI and DPK.
+    fn channel(&mut self, hal: &Hal, tssi: Option<&Tssi>, track: Option<&TxPowerTrack>, chan: &Chan) {
+        match self {
+            Self::None => {}
+            Self::Rtl8852b(state) => rtw8852b_rfk::channel(hal, state, tssi, track, chan),
+            Self::Rtl8852bt(state) => rtw8852bt_rfk::channel(hal, state, tssi, track, chan),
+            Self::Rtl8852c(state) => rtw8852c_rfk::channel(hal, state, tssi, track, chan),
+            Self::Rtl8851b(state) => rtw8851b_rfk::channel(hal, state, tssi, track, chan),
+            Self::Rtl8852a(state) => rtw8852a_rfk::channel(hal, state, tssi, track, chan),
+        }
+    }
+
+    /// The TSSI on a new band, as a scan wants it (`_tssi_scan`).
+    fn band_changed(&mut self, hal: &Hal, tssi: Option<&Tssi>, track: Option<&TxPowerTrack>, chan: &Chan) {
+        let Some(tssi) = tssi else {
+            return;
+        };
+        match self {
+            Self::None => {}
+            Self::Rtl8852b(state) => rtw8852b_rfk::tssi(hal, &mut state.tssi_mode, &rtw8852b_rfk::TSSI_8852B, tssi, track, chan, true),
+            Self::Rtl8852bt(state) => rtw8852bt_rfk::tssi_scan(hal, state, tssi, track, chan),
+            Self::Rtl8852c(state) => rtw8852c_rfk::tssi_scan(hal, state, tssi, track, chan),
+            Self::Rtl8851b(state) => rtw8851b_rfk::tssi_scan(hal, state, tssi, track, chan),
+            Self::Rtl8852a(state) => rtw8852a_rfk::tssi_scan(hal, state, tssi, track, chan),
+        }
+    }
+
+    /// `rtw89_chip_rfk_track`: the DPD with the temperature (the
+    /// RTL8852C's LO and RX DC offset too).
+    fn track(&mut self, hal: &Hal, chan: Option<&Chan>, scanning: bool) {
+        match self {
+            Self::None => {}
+            Self::Rtl8852b(state) => rtw8852b_rfk::track(hal, state),
+            Self::Rtl8852bt(state) => rtw8852bt_rfk::track(hal, state),
+            Self::Rtl8852c(state) => rtw8852c_rfk::track(hal, state, chan, scanning),
+            Self::Rtl8851b(state) => rtw8851b_rfk::track(hal, state),
+            Self::Rtl8852a(state) => rtw8852a_rfk::track(hal, state),
+        }
+    }
+}
+
+impl Rtw89 {
+    pub(crate) fn new(hal: Hal, pci: Pci, fw: Firmware, secure: Secure, efuse: Efuse) -> Self {
+        let address = efuse.address;
+        let host_rfk = HostRfk::of(hal.id());
+        Self {
+            hal,
+            pci,
+            fw,
+            h2c: H2c::new(),
+            secure,
+            efuse,
+            address,
+            device: None,
+            chan: None,
+            network: None,
+            ap: None,
+            associated: false,
+            aid: 0,
+            qos: false,
+            pairwise: None,
+            group: None,
+            group_mic: None,
+            scan: None,
+            sequence: 0,
+            aggregates: Aggregates::default(),
+            ba_cam: Vec::new(),
+            power_save: false,
+            lps: false,
+            traffic: (0, 0),
+            watchdog: 0,
+            held: VecDeque::new(),
+            last_rssi: -100,
+            signal: None,
+            dead: false,
+            bb_gain: BbGain::default(),
+            features: Features::of((0, 0, 0, 0)),
+            rfk_mcc: RfkMcc::default(),
+            host_rfk,
+        }
+    }
+
+    pub(crate) fn h2c_send(&mut self, cat: u32, class: u32, func: u32, rack: bool, dack: bool, payload: &[u8]) -> Result<(), String> {
+        let packet = self.h2c.packet(cat, class, func, rack, dack, payload);
+        let deadline = crate::now_ms() + 200;
+        loop {
+            match self.pci.send_h2c(&self.hal, &packet, false) {
+                Ok(()) => return Ok(()),
+                Err(error) if crate::now_ms() >= deadline => return Err(String::from(error)),
+                Err(_) => crate::delay_us(50),
+            }
+        }
+    }
+
+    /// `rtw89_core_start` and the interface's `rtw89_mac_vif_init`.
+    pub(crate) fn bring_up(&mut self) -> Result<(), String> {
+        if self.hal.chip.be {
+            return self.bring_up_be();
+        }
+        let id = self.hal.id();
+        // `rtw89_mac_partial_init`: the DMA's TX and RX, the download's
+        // memory, the rings, the firmware.
+        mac::dmac_pre_init(&self.hal)?;
+        self.pci.mac_pre_init(&self.hal).map_err(String::from)?;
+        let mut tries = 0;
+        loop {
+            match self.fw.download(&self.hal, &mut self.pci, &mut self.h2c, &self.secure) {
+                Ok(()) => break,
+                Err(error) if tries >= 4 => return Err(error),
+                Err(_) => tries += 1,
+            }
+        }
+        let v = self.fw.version;
+        ostd::info!("rtw89: {} firmware {}.{}.{}.{} runs{}", self.fw.name, v.0, v.1, v.2, v.3, if self.secure.secure_boot { " (secure boot)" } else { "" });
+        mac::enable_bb_rf(&self.hal)?;
+        mac::sys_init(&self.hal);
+        mac::trx_init(&self.hal, DEFAULT_AX_RX_FLTR)?;
+        self.pci.mac_post_init(&self.hal);
+        // `rtw89_fw_h2c_set_ofld_cfg`.
+        self.h2c_send(H2C_CAT_MAC, H2C_CL_MAC_FW_OFLD, H2C_FUNC_OFLD_CFG, false, true, &[0x09, 0, 0, 0, 0x5e, 0, 0, 0])?;
+        // The PHY: tables, then the dynamic part (`rtw89_phy_dm_init`).
+        phy::init_bb(&self.hal, &self.fw);
+        self.bb_reset();
+        phy::init_rf(&self.hal, &self.fw, &mut self.pci, &mut self.h2c);
+        self.btc_init();
+        self.bb_sethw();
+        phy::init_nctl(&self.hal, &self.fw);
+        self.rfk_init();
+        phy::set_txpwr_ref(&self.hal);
+        // `rtw89_chip_power_trim`.
+        rtw8852b_rfk::power_trim(&self.hal, &self.efuse, self.hal.chip.rf_paths);
+        self.cfg_txrx_path(true);
+        ppdu_status(&self.hal, true);
+        self.pci.enable_interrupts(&self.hal);
+        // The interface (`rtw89_mac_vif_init`).
+        mac::port_update(&self.hal, RTW89_NET_TYPE_NO_LINK, 100, 1);
+        mac::tables_init(&self.hal, MAC_ID);
+        self.macid_pause(false)?;
+        self.role_maintain(RTW89_ROLE_CREATE)?;
+        self.join_info(true)?;
+        self.addr_cam(RTW89_ROLE_CREATE)?;
+        self.default_cmac_tbl(MAC_ID)?;
+        self.set_channel(&Chan::new(&Chandef::simple(2412)));
+        let _ = id;
+        Ok(())
+    }
+
+    fn download(&mut self) -> Result<(), String> {
+        let mut tries = 0;
+        loop {
+            match self.fw.download(&self.hal, &mut self.pci, &mut self.h2c, &self.secure) {
+                Ok(()) => break,
+                Err(error) if tries >= 4 => return Err(error),
+                Err(_) => tries += 1,
+            }
+        }
+        let v = self.fw.version;
+        ostd::info!("rtw89: {} firmware {}.{}.{}.{} runs{}", self.fw.name, v.0, v.1, v.2, v.3, if self.secure.secure_boot { " (secure boot)" } else { "" });
+        Ok(())
+    }
+
+    /// `rtw89_core_start` on the BE chips: the baseband's MCU before the
+    /// download (both firmwares), the MAC, BA CAM users, the PHY's tables
+    /// (gains too), the dynamic part, then the interface, the channel and
+    /// the firmware's first calibrations (`rtw8922a_rfk_init_late`).
+    fn bring_up_be(&mut self) -> Result<(), String> {
+        rtw8922a::bb_preinit(&self.hal);
+        be::dmac_pre_init(&self.hal)?;
+        self.pci.mac_pre_init(&self.hal).map_err(String::from)?;
+        be::fwdl_preconfig(&self.hal);
+        self.download()?;
+        self.features = Features::of(self.fw.version);
+        be::enable_bb_rf(&self.hal);
+        be::sys_init(&self.hal);
+        be::trx_init(&self.hal, DEFAULT_BE_RX_FLTR)?;
+        // `rtw89_mac_setup_phycap`: 802.11be at all, and 4096-QAM (MCS 12
+        // and 13), as the firmware says.
+        let mut counters = (0u8, 0u8);
+        if let Some(cap) = be::phycap(&self.hal, &mut counters, 0) {
+            self.hal.no_eht = get(RTW89_C2HREG_PHYCAP_W1_PROT, cap[1]) < RTW89_C2HREG_PHYCAP_W1_PROT_11BE;
+        }
+        if let Some(cap) = be::phycap(&self.hal, &mut counters, 1) {
+            let qam = match get(RTW89_C2HREG_PHYCAP_P1_W2_QAM, cap[2]) {
+                qam @ (RTW89_C2HREG_PHYCAP_P1_W2_QAM_256 | RTW89_C2HREG_PHYCAP_P1_W2_QAM_1024 | RTW89_C2HREG_PHYCAP_P1_W2_QAM_4096) => qam,
+                _ => RTW89_C2HREG_PHYCAP_P1_W2_QAM_4096,
+            };
+            self.hal.no_mcs_12_13 |= qam <= RTW89_C2HREG_PHYCAP_P1_W2_QAM_1024;
+        }
+        // `rtw89_mac_feat_init`: one BA CAM user a band (1024-bit maps take
+        // four entries).
+        for (users, offset, band) in [(1, 0, 0), (1, 4, 1)] {
+            let w0 = field(RTW89_H2C_BA_CAM_INIT_USERS_MASK, users) | field(RTW89_H2C_BA_CAM_INIT_OFFSET_MASK, offset) | field(RTW89_H2C_BA_CAM_INIT_BAND_SEL, band);
+            self.h2c_send(H2C_CAT_MAC, H2C_CL_BA_CAM, H2C_FUNC_MAC_BA_CAM_INIT, false, true, &words(&[w0]))?;
+        }
+        self.pci.mac_post_init(&self.hal);
+        self.h2c_send(H2C_CAT_MAC, H2C_CL_MAC_FW_OFLD, H2C_FUNC_OFLD_CFG, false, true, &[0x09, 0, 0, 0, 0x5e, 0, 0, 0])?;
+        rtw8922a::reset_bb_rf(&self.hal);
+        phy::init_bb(&self.hal, &self.fw);
+        self.bb_gain = rtw8922a::bb_gain(&self.hal, &self.fw);
+        rtw8922a::bb_postinit(&self.hal);
+        phy::init_rf(&self.hal, &self.fw, &mut self.pci, &mut self.h2c);
+        rtw8922a::btc_init(&self.hal);
+        // `rtw89_phy_dm_init`.
+        rtw8922a::bb_sethw(&self.hal, 0);
+        rtw8922a::bb_wrap_init(&self.hal);
+        rtw8922a::rfk_hw_init(&self.hal);
+        rtw8922a::init_nctl(&self.hal, &self.fw);
+        rtw8922a::set_txpwr_ref(&self.hal);
+        rtw8922a::power_trim(&self.hal, self.efuse.bias);
+        rtw8922a::cfg_txrx_path(&self.hal, true);
+        ppdu_status(&self.hal, true);
+        // `rtw89_mac_cfg_phy_rpt_be`: an 8-byte PHY report with each frame.
+        self.hal.w32_mask(R_BE_RCR, B_BE_PHY_RPT_SZ_MASK, MAC_AX_PHY_RPT_SIZE_8);
+        self.hal.w32_mask(R_BE_RCR, B_BE_HDR_CNV_SZ_MASK, MAC_AX_HDR_CNV_SIZE_0);
+        self.hal.w32_mask(R_BE_DRV_INFO_OPTION, B_BE_DRV_INFO_PHYRPT_EN, 1);
+        self.pci.enable_interrupts(&self.hal);
+        mac::port_update(&self.hal, RTW89_NET_TYPE_NO_LINK, 100, 1);
+        self.macid_pause(false)?;
+        self.role_maintain(RTW89_ROLE_CREATE)?;
+        self.join_info(true)?;
+        self.addr_cam(RTW89_ROLE_CREATE)?;
+        self.default_cmac_tbl(MAC_ID)?;
+        self.default_dmac_tbl(MAC_ID)?;
+        let chan = Chan::new(&Chandef::simple(2412));
+        self.set_channel(&chan);
+        self.rfk_pre_ntfy();
+        for rfk in [Rfk::Dack, Rfk::RxDck { channel: false }] {
+            self.rfk_be(rfk, &chan);
+        }
+        Ok(())
+    }
+
+    /// `rtw89_phy_rfk_pre_ntfy_and_wait` (and `_mcc`): the calibrations'
+    /// table and channel to the firmware.
+    fn rfk_pre_ntfy(&mut self) {
+        let (features, mcc) = (self.features, self.rfk_mcc);
+        if let Some(version) = features.pre_ntfy {
+            let payload = words(&rtw8922a::pre_ntfy(&self.hal, version, &mcc, self.hal.rfe_type));
+            if self.h2c_send(H2C_CAT_OUTSRC, H2C_CL_OUTSRC_RF_FW_RFK, H2C_FUNC_RFK_PRE_NOTIFY, false, false, &payload).is_ok() {
+                crate::delay_ms(5);
+            }
+        }
+        if let Some(version) = features.pre_ntfy_mcc {
+            let payload = rtw8922a::pre_ntfy_mcc(version, &mcc);
+            let _ = self.h2c_send(H2C_CAT_OUTSRC, H2C_CL_OUTSRC_RF_FW_NOTIFY, H2C_FUNC_OUTSRC_RF_MCC_INFO, false, false, &payload);
+        }
+    }
+
+    /// A calibration the firmware runs, the time Linux gives it.
+    fn rfk_be(&mut self, rfk: Rfk, chan: &Chan) {
+        let (func, payload, ms) = rfk.command(&self.hal, &self.features, chan);
+        if self.h2c_send(H2C_CAT_OUTSRC, H2C_CL_OUTSRC_RF_FW_RFK, func, false, false, &payload).is_ok() {
+            crate::delay_ms(ms);
+        }
+    }
+
+    /// `rtw8922a_rfk_channel`: TX stopped, both paths out of TX, then the
+    /// firmware's calibrations of the channel (TX gap, IQ, TSSI, DPD, RX
+    /// DC).
+    fn rfk_channel_be(&mut self) {
+        let Some(chan) = self.chan else { return };
+        stop_sch_tx(&self.hal, true);
+        for path in 0..2 {
+            let _ = aster_linuxkpi::delay::read_poll_timeout(|| self.hal.read_rf(path, 0x00, RR_MOD_MASK), |mode| *mode != 2, 2, 5000);
+        }
+        self.rfk_pre_ntfy();
+        for rfk in [Rfk::TxGapK, Rfk::Iqk] {
+            self.rfk_be(rfk, &chan);
+        }
+        self.tssi_be(&chan, rtw8922a::TSSI_NORMAL);
+        for rfk in [Rfk::Dpk, Rfk::RxDck { channel: true }] {
+            self.rfk_be(rfk, &chan);
+        }
+        stop_sch_tx(&self.hal, false);
+    }
+
+    /// `rtw89_phy_rfk_tssi_and_wait`: the firmware's TSSI calibration (20
+    /// ms; 6 in a scan's mode), when the eFuse and the firmware file have
+    /// what it takes.
+    fn tssi_be(&mut self, chan: &Chan, mode: u8) {
+        let (Some(tssi), Some(track)) = (self.efuse.tssi.as_ref(), self.fw.elements.txpwr_trk.as_ref()) else { return };
+        let Some(payload) = rtw8922a::tssi_command(&self.hal, tssi, track, chan, mode) else { return };
+        if self.h2c_send(H2C_CAT_OUTSRC, H2C_CL_OUTSRC_RF_FW_RFK, H2C_FUNC_RFK_TSSI_OFFLOAD, false, false, &payload).is_ok() {
+            crate::delay_ms(if mode == rtw8922a::TSSI_SCAN { 6 } else { 20 });
+        }
+    }
+
+    /// The RX filter: while scanning, beacons of every network.
+    fn rx_filter(&self, scanning: bool) -> u32 {
+        match (self.hal.chip.be, scanning) {
+            (true, true) => DEFAULT_BE_RX_FLTR & !(B_BE_A_BCN_CHK_EN | B_BE_A_BC | B_BE_A_A1_MATCH),
+            (true, false) => DEFAULT_BE_RX_FLTR,
+            (false, true) => DEFAULT_AX_RX_FLTR & !(B_AX_A_BCN_CHK_EN | B_AX_A_BC | B_AX_A_A1_MATCH),
+            (false, false) => DEFAULT_AX_RX_FLTR,
+        }
+    }
+
+    // ---- The chip's own parts. ----
+
+    fn bb_reset(&self) {
+        match self.hal.id() {
+            ChipId::Rtl8852b | ChipId::Rtl8852bt => rtw8852b::bb_reset(&self.hal),
+            _ => rtw88xx::bb_reset(&self.hal),
+        }
+    }
+
+    fn btc_init(&self) {
+        match self.hal.id() {
+            ChipId::Rtl8852b | ChipId::Rtl8852bt => rtw8852b::btc_init(&self.hal),
+            _ => rtw88xx::btc_init(&self.hal),
+        }
+    }
+
+    fn bb_sethw(&self) {
+        match self.hal.id() {
+            ChipId::Rtl8852b | ChipId::Rtl8852bt => rtw8852b::bb_sethw(&self.hal),
+            _ => rtw88xx::bb_sethw(&self.hal),
+        }
+    }
+
+    fn rfk_init(&mut self) {
+        match self.hal.id() {
+            ChipId::Rtl8852b | ChipId::Rtl8852bt => {
+                self.host_rfk.init(&self.hal, &self.efuse);
+                rtw8852b::rfk_init(&self.hal);
+            }
+            _ => {
+                rtw88xx::rfk_init(&self.hal);
+                self.host_rfk.init(&self.hal, &self.efuse);
+            }
+        }
+    }
+
+    fn cfg_txrx_path(&self, two_g: bool) {
+        match self.hal.id() {
+            ChipId::Rtl8922a => rtw8922a::cfg_txrx_path(&self.hal, two_g),
+            ChipId::Rtl8852b | ChipId::Rtl8852bt => rtw8852b::cfg_txrx_path(&self.hal, two_g),
+            _ => rtw88xx::cfg_txrx_path(&self.hal, two_g),
+        }
+    }
+
+    /// `__rtw89_set_channel`: the chip's channel (its help around it), the
+    /// TX power for the band, the RX DC offset again on a new band.
+    fn set_channel(&mut self, chan: &Chan) {
+        if self.chan.as_ref() == Some(chan) {
+            return;
+        }
+        let band_changed = self.chan.is_none_or(|old| old.band != chan.band);
+        let hal = &self.hal;
+        let two_g = chan.band == phy::BAND_2G;
+        match hal.id() {
+            ChipId::Rtl8852b | ChipId::Rtl8852bt => {
+                rtw8852b::channel_help(hal, true, two_g);
+                rtw8852b::set_channel_mac(hal, chan);
+                rtw8852b::set_channel_bb(hal, chan);
+                rtw8852b::set_channel_rf(hal, chan);
+                phy::set_txpwr(hal, &self.fw, chan.band);
+                rtw8852b::channel_help(hal, false, two_g);
+            }
+            ChipId::Rtl8922a => {
+                let mut tx_en = 0;
+                rtw8922a::channel_help(hal, true, two_g, &mut tx_en);
+                rtw8922a::set_channel_mac(hal, chan);
+                rtw8922a::set_channel_bb(hal, &self.bb_gain, chan);
+                rtw8922a::set_channel_rf(hal, chan);
+                rtw8922a::set_txpwr(hal, &self.fw, chan);
+                rtw8922a::channel_help(hal, false, two_g, &mut tx_en);
+                self.rfk_mcc = RfkMcc::of(chan);
+            }
+            _ => rtw88xx::set_channel(hal, &self.fw, chan),
+        }
+        if band_changed {
+            self.cfg_txrx_path(two_g);
+        }
+        self.chan = Some(*chan);
+        // `rtw8922a_rfk_band_changed`: TSSI again, as a scan wants it (the
+        // RTL8852B's `_tssi_scan` likewise).
+        if band_changed && self.hal.id() == ChipId::Rtl8922a {
+            self.tssi_be(chan, rtw8922a::TSSI_SCAN);
+        }
+        if band_changed {
+            self.host_rfk.band_changed(&self.hal, self.efuse.tssi.as_ref(), self.fw.elements.txpwr_trk.as_ref(), chan);
+        }
+    }
+
+    fn rfk_channel(&mut self) {
+        match self.hal.id() {
+            ChipId::Rtl8922a => self.rfk_channel_be(),
+            ChipId::Rtl8852b | ChipId::Rtl8852bt => {
+                // `rtw8852b_rfk_channel`, `rtw8852bt_rfk_channel`: the RX DC
+                // offset, then IQK, TSSI, DPK.
+                rtw8852b::rx_dck(&self.hal, &self.host_rfk.tssi_mode());
+                if let Some(chan) = self.chan {
+                    self.host_rfk.channel(&self.hal, self.efuse.tssi.as_ref(), self.fw.elements.txpwr_trk.as_ref(), &chan);
+                }
+            }
+            _ => {
+                if !self.host_rfk.rx_dck(&self.hal) {
+                    rtw88xx::rfk_channel(&self.hal);
+                }
+                if let Some(chan) = self.chan {
+                    self.host_rfk.channel(&self.hal, self.efuse.tssi.as_ref(), self.fw.elements.txpwr_trk.as_ref(), &chan);
+                }
+            }
+        }
+    }
+
+    // ---- H2C commands of the interface and its station. ----
+
+    /// `rtw89_fw_h2c_macid_pause` (the older format every firmware takes).
+    fn macid_pause(&mut self, pause: bool) -> Result<(), String> {
+        if self.hal.chip.be && self.features.macid_pause_sleep {
+            // `struct rtw89_fw_macid_pause_sleep_grp`: pause, its mask, sleep,
+            // its mask (four groups each), for four links.
+            let mut values = [0u32; 64];
+            values[4] = 1 << MAC_ID;
+            values[12] = 1 << MAC_ID;
+            if pause {
+                values[0] = 1 << MAC_ID;
+                values[8] = 1 << MAC_ID;
+            }
+            return self.h2c_send(H2C_CAT_MAC, H2C_CL_MAC_FW_OFLD, H2C_FUNC_MAC_MACID_PAUSE_SLEEP, true, false, &words(&values));
+        }
+        let mut values = [0u32; 8];
+        values[4] = 1 << MAC_ID;
+        if pause {
+            values[0] = 1 << MAC_ID;
+        }
+        self.h2c_send(H2C_CAT_MAC, H2C_CL_MAC_FW_OFLD, H2C_FUNC_MAC_MACID_PAUSE, true, false, &words(&values))
+    }
+
+    fn net_type(&self) -> u32 {
+        if self.ap.is_some() {
+            RTW89_NET_TYPE_AP_MODE
+        } else if self.associated {
+            RTW89_NET_TYPE_INFRA
+        } else {
+            RTW89_NET_TYPE_NO_LINK
+        }
+    }
+
+    /// The interface's own roles: a client's, or an access point's.
+    fn roles(&self) -> (u32, u32) {
+        if self.ap.is_some() { (RTW89_SELF_ROLE_AP, RTW89_WIFI_ROLE_AP) } else { (RTW89_SELF_ROLE_CLIENT, RTW89_WIFI_ROLE_STATION) }
+    }
+
+    /// `rtw89_fw_h2c_role_maintain` for the interface.
+    fn role_maintain(&mut self, mode: u32) -> Result<(), String> {
+        let (self_role, wifi_role) = self.roles();
+        self.role_maintain_for(MAC_ID, self_role, wifi_role, mode)
+    }
+
+    /// `rtw89_fw_h2c_role_maintain` for a MAC ID (an access point's
+    /// stations are its clients).
+    fn role_maintain_for(&mut self, mac_id: u32, self_role: u32, wifi_role: u32, mode: u32) -> Result<(), String> {
+        let w0 = field(RTW89_H2C_ROLE_MAINTAIN_W0_MACID, mac_id) | field(RTW89_H2C_ROLE_MAINTAIN_W0_SELF_ROLE, self_role) | field(RTW89_H2C_ROLE_MAINTAIN_W0_UPD_MODE, mode) | field(RTW89_H2C_ROLE_MAINTAIN_W0_WIFI_ROLE, wifi_role);
+        self.h2c_send(H2C_CAT_MAC, H2C_CL_MAC_MEDIA_RPT, H2C_FUNC_MAC_FWROLE_MAINTAIN, false, true, &words(&[w0]))
+    }
+
+    /// `rtw89_fw_h2c_join_info` for the interface.
+    fn join_info(&mut self, disconnect: bool) -> Result<(), String> {
+        let trigger = !disconnect && self.network.as_ref().is_some_and(|network| network.peer.he.is_some());
+        let net_type = if disconnect { RTW89_NET_TYPE_NO_LINK } else { self.net_type() };
+        let (self_role, wifi_role) = self.roles();
+        self.join_info_for(MAC_ID, disconnect, net_type, self_role, wifi_role, trigger)
+    }
+
+    fn join_info_for(&mut self, mac_id: u32, disconnect: bool, net_type: u32, self_role: u32, wifi_role: u32, trigger: bool) -> Result<(), String> {
+        let w0 = field(RTW89_H2C_JOININFO_W0_MACID, mac_id)
+            | field(RTW89_H2C_JOININFO_W0_OP, disconnect as u32)
+            | field(RTW89_H2C_JOININFO_W0_WMM, 0)
+            | field(RTW89_H2C_JOININFO_W0_TGR, trigger as u32)
+            | field(RTW89_H2C_JOININFO_W0_NET_TYPE, net_type)
+            | field(RTW89_H2C_JOININFO_W0_WIFI_ROLE, wifi_role)
+            | field(RTW89_H2C_JOININFO_W0_SELF_ROLE, self_role);
+        if !self.hal.chip.be {
+            return self.h2c_send(H2C_CAT_MAC, H2C_CL_MAC_MEDIA_RPT, H2C_FUNC_MAC_JOININFO, false, true, &words(&[w0]));
+        }
+        // `struct rtw89_h2c_join_v1`: the station's generation, its own
+        // MAC ID as the main one, single-link (MLSR), the EMLSR delays.
+        let he = if mac_id == MAC_ID {
+            self.network.as_ref().is_some_and(|network| network.peer.he.is_some()) || self.ap.is_some()
+        } else {
+            self.ap.as_ref().is_some_and(|ap| ap.stations.values().any(|station| station.mac_id == mac_id && station.peer.he.is_some()))
+        };
+        let sta_type = if he { RTW89_FW_AX_STA } else { RTW89_FW_N_AC_STA };
+        let w1 = field(RTW89_H2C_JOININFO_W1_STA_TYPE, sta_type)
+            | field(RTW89_H2C_JOININFO_W1_MAIN_MACID, mac_id)
+            | field(RTW89_H2C_JOININFO_W1_MLO_MODE, RTW89_H2C_JOININFO_MLO_MODE_MLSR)
+            | field(RTW89_H2C_JOININFO_W1_EMLSR_PADDING, EML_PADDING_DELAY_256US)
+            | field(RTW89_H2C_JOININFO_W1_EMLSR_TRANS_DELAY, EMLSR_TRANSITION_DELAY_256US);
+        self.h2c_send(H2C_CAT_MAC, H2C_CL_MAC_MEDIA_RPT, H2C_FUNC_MAC_JOININFO, false, true, &words(&[w0, w1, 0]))
+    }
+
+    /// `rtw89_fw_h2c_cam` for the interface: the address CAM's entry 0
+    /// (our address, the access point's, or as an access point our own,
+    /// the keys' CAM entries) and the BSSID CAM's entry 0.
+    fn addr_cam(&mut self, mode: u32) -> Result<(), String> {
+        let entry = match &self.ap {
+            Some(ap) => AddrCam {
+                idx: 0,
+                mac_id: MAC_ID,
+                sma: self.address,
+                tma: self.address,
+                bssid: self.address,
+                net_type: RTW89_NET_TYPE_AP_MODE,
+                aid: 0,
+                pairwise: None,
+                group: ap.group.map(|(index, cam, _, _)| (index, cam)),
+                mode,
+            },
+            None => {
+                let bssid = self.network.as_ref().map_or([0; 6], |network| network.join.bssid);
+                AddrCam {
+                    idx: 0,
+                    mac_id: MAC_ID,
+                    sma: self.address,
+                    tma: bssid,
+                    bssid,
+                    net_type: self.net_type(),
+                    aid: if self.associated { self.aid } else { 0 },
+                    pairwise: self.pairwise.map(|(index, cam, _, _)| (index, cam)),
+                    group: self.group.map(|(index, cam, _)| (index, cam)),
+                    mode,
+                }
+            }
+        };
+        self.addr_cam_entry(&entry, true)
+    }
+
+    /// `rtw89_fw_h2c_cam` (format 0): an address CAM entry (made valid or
+    /// not) and the BSSID CAM's entry 0.
+    fn addr_cam_entry(&mut self, entry: &AddrCam, valid: bool) -> Result<(), String> {
+        let (sma, tma, bssid) = (entry.sma, entry.tma, entry.bssid);
+        let hash = |addr: &[u8; 6]| addr.iter().fold(0u32, |hash, byte| hash ^ *byte as u32);
+        let len = if matches!(self.hal.id(), ChipId::Rtl8852c | ChipId::Rtl8922a) { ADDR_CAM_ENT_SHORT_SIZE } else { ADDR_CAM_ENT_SIZE };
+        let mut w = [0u32; 16];
+        w[1] = field(ADDR_CAM_W1_IDX, entry.idx) | field(ADDR_CAM_W1_OFFSET, 0) | field(ADDR_CAM_W1_LEN, len);
+        w[2] = field(ADDR_CAM_W2_VALID, valid as u32)
+            | field(ADDR_CAM_W2_NET_TYPE, entry.net_type)
+            | field(ADDR_CAM_W2_BCN_HIT_COND, 0)
+            | field(ADDR_CAM_W2_HIT_RULE, 0)
+            | field(ADDR_CAM_W2_MASK_SEL, RTW89_NO_MSK)
+            | field(ADDR_CAM_W2_SMA_HASH, hash(&sma))
+            | field(ADDR_CAM_W2_TMA_HASH, hash(&tma));
+        w[3] = field(ADDR_CAM_W3_BSSID_CAM_IDX, 0);
+        w[4] = u32::from_le_bytes([sma[0], sma[1], sma[2], sma[3]]);
+        w[5] = sma[4] as u32 | (sma[5] as u32) << 8 | (tma[0] as u32) << 16 | (tma[1] as u32) << 24;
+        w[6] = u32::from_le_bytes([tma[2], tma[3], tma[4], tma[5]]);
+        w[8] = field(ADDR_CAM_W8_MACID, entry.mac_id);
+        w[9] = field(ADDR_CAM_W9_AID12, entry.aid as u32 & 0xfff) | field(ADDR_CAM_W9_SEC_ENT_MODE, ADDR_CAM_SEC_NORMAL);
+        // The keys: the pairwise one in slot 0, the group one in slot 1.
+        let mut keys = 0u32;
+        if let Some((index, cam)) = entry.pairwise {
+            keys |= 1 << 0;
+            w[9] |= field(ADDR_CAM_W9_SEC_ENT0_KEYID, index as u32);
+            w[10] |= field(ADDR_CAM_W10_SEC_ENT0, cam);
+        }
+        if let Some((index, cam)) = entry.group {
+            keys |= 1 << 1;
+            w[9] |= field(ADDR_CAM_W9_SEC_ENT1_KEYID, index as u32);
+            w[10] |= field(ADDR_CAM_W10_SEC_ENT1, cam);
+        }
+        w[10] |= field(ADDR_CAM_W10_SEC_ENT_VALID, keys);
+        w[12] = field(ADDR_CAM_W12_BSSID_IDX, 0) | field(ADDR_CAM_W12_BSSID_OFFSET, 0) | field(ADDR_CAM_W12_BSSID_LEN, BSSID_CAM_ENT_SIZE);
+        w[13] = field(ADDR_CAM_W13_BSSID_VALID, 1) | field(ADDR_CAM_W13_BSSID_MASK, RTW89_BSSID_MATCH_ALL) | field(ADDR_CAM_W13_BSSID_BSSID0, bssid[0] as u32) | field(ADDR_CAM_W13_BSSID_BSSID1, bssid[1] as u32);
+        w[14] = u32::from_le_bytes([bssid[2], bssid[3], bssid[4], bssid[5]]);
+        // The BE chips' newer firmware takes the update's mode too.
+        let count = if self.hal.chip.be && !self.features.addr_cam_v0 {
+            w[15] = field(ADDR_CAM_W15_UPD_MODE, entry.mode);
+            16
+        } else {
+            15
+        };
+        self.h2c_send(H2C_CAT_MAC, H2C_CL_MAC_ADDR_CAM_UPDATE, H2C_FUNC_MAC_ADDR_CAM_UPD, false, true, &words(&w[..count]))
+    }
+
+    fn cctl_func(&self) -> u32 {
+        match self.hal.id() {
+            ChipId::Rtl8852c => H2C_FUNC_MAC_CCTLINFO_UD_V1,
+            ChipId::Rtl8922a => H2C_FUNC_MAC_CCTLINFO_UD_G7,
+            _ => H2C_FUNC_MAC_CCTLINFO_UD,
+        }
+    }
+
+    /// A G7 CMAC or v2 DMAC table's field: its value in word `w` (after the
+    /// control word), its mask sixteen words on.
+    fn g7(table: &mut [u32; H2C_TBL_G7_WORDS], w: usize, mask: u32, value: u32) {
+        table[1 + w] = (table[1 + w] & !mask) | field(mask, value);
+        table[17 + w] |= mask;
+    }
+
+    /// `rtw89_fw_h2c_default_cmac_tbl_g7`: every field set (most to zero),
+    /// OFDM 6 Mbit/s and its RTS, CSI's defaults.
+    fn default_cmac_tbl_g7(&mut self, mac_id: u32) -> Result<(), String> {
+        let mut t = [0u32; H2C_TBL_G7_WORDS];
+        t[0] = field(CCTLINFO_G7_C0_MACID, mac_id) | field(CCTLINFO_G7_C0_OP, 1);
+        t[1] = field(CCTLINFO_G7_W0_DATARATE, 4);
+        t[2] = field(CCTLINFO_G7_W1_DATA_RTY_LOWEST_RATE, 4) | field(CCTLINFO_G7_W1_RTSRATE, 0xa) | field(CCTLINFO_G7_W1_RTS_RTY_LOWEST_RATE, 4);
+        t[5] = field(CCTLINFO_G7_W4_ACT_SUBCH_CBW, 0xffff);
+        t[6] = field(CCTLINFO_G7_W5_NOMINAL_PKT_PADDING0, 2) | field(CCTLINFO_G7_W5_NOMINAL_PKT_PADDING1, 2) | field(CCTLINFO_G7_W5_NOMINAL_PKT_PADDING2, 2) | field(CCTLINFO_G7_W5_NOMINAL_PKT_PADDING3, 2) | field(CCTLINFO_G7_W5_NOMINAL_PKT_PADDING4, 2);
+        t[7] = field(CCTLINFO_G7_W6_RESP_REF_RATE, 0xb);
+        t[8] = field(CCTLINFO_G7_W7_NC, 1) | field(CCTLINFO_G7_W7_NR, 1) | field(CCTLINFO_G7_W7_CB, 1) | field(CCTLINFO_G7_W7_CSI_PARA_EN, 1) | field(CCTLINFO_G7_W7_CSI_FIX_RATE, 0xb);
+        let masks = [CCTLINFO_G7_W0_ALL, CCTLINFO_G7_W1_ALL, CCTLINFO_G7_W2_ALL, CCTLINFO_G7_W3_ALL, CCTLINFO_G7_W4_ALL, CCTLINFO_G7_W5_ALL, CCTLINFO_G7_W6_ALL, CCTLINFO_G7_W7_ALL, CCTLINFO_G7_W8_ALL];
+        for (index, mask) in masks.iter().enumerate() {
+            t[17 + index] = *mask;
+        }
+        t[17 + 14] = CCTLINFO_G7_W14_ALL;
+        t[17 + 15] = CCTLINFO_G7_W15_ALL;
+        self.h2c_send(H2C_CAT_MAC, H2C_CL_MAC_FR_EXCHG, H2C_FUNC_MAC_CCTLINFO_UD_G7, false, true, &words(&t))
+    }
+
+    /// `rtw89_fw_h2c_assoc_cmac_tbl_g7`: no fallback for RTS and data, the
+    /// band's lowest rate for RTS retries, port 0, every 20 MHz subchannel
+    /// on with 802.11be, the packet extension the peer asks for at each
+    /// width, the AID, uplink as a station, BSR's format for HE.
+    fn assoc_cmac_tbl_g7(&mut self, mac_id: u32, he: bool) -> Result<(), String> {
+        let peer = match &self.ap {
+            Some(ap) => ap.stations.values().find(|station| station.mac_id == mac_id).map(|station| station.peer.clone()),
+            None => self.network.as_ref().map(|network| network.peer.clone()),
+        }
+        .unwrap_or_default();
+        let pads = pkt_padding(&peer, self.hal.chip.rf_paths);
+        let two_g = self.chan.is_some_and(|chan| chan.band == phy::BAND_2G);
+        let lowest = if two_g { HW_RATE_CCK1 } else { HW_RATE_OFDM6 };
+        let (aid, station) = match &self.ap {
+            Some(ap) => (ap.stations.values().find(|station| station.mac_id == mac_id).map_or(0, |station| station.aid), false),
+            None => (self.aid, true),
+        };
+        let mut t = [0u32; H2C_TBL_G7_WORDS];
+        t[0] = field(CCTLINFO_G7_C0_MACID, mac_id) | field(CCTLINFO_G7_C0_OP, 1);
+        Self::g7(&mut t, 0, CCTLINFO_G7_W0_DISRTSFB, 1);
+        Self::g7(&mut t, 0, CCTLINFO_G7_W0_DISDATAFB, 1);
+        Self::g7(&mut t, 1, CCTLINFO_G7_W1_RTS_RTY_LOWEST_RATE, lowest);
+        Self::g7(&mut t, 2, CCTLINFO_G7_W2_DATA_TXCNT_LMT_SEL, 0);
+        Self::g7(&mut t, 3, CCTLINFO_G7_W3_RTS_TXCNT_LMT_SEL, 0);
+        Self::g7(&mut t, 4, CCTLINFO_G7_W4_MULTI_PORT_ID, 0);
+        if self.ap.is_some() {
+            Self::g7(&mut t, 4, CCTLINFO_G7_W4_DATA_DCM, 0);
+        }
+        if peer.eht.is_some() {
+            Self::g7(&mut t, 4, CCTLINFO_G7_W4_ACT_SUBCH_CBW, 0xffff);
+        }
+        for (padding, value) in [CCTLINFO_G7_W5_NOMINAL_PKT_PADDING0, CCTLINFO_G7_W5_NOMINAL_PKT_PADDING1, CCTLINFO_G7_W5_NOMINAL_PKT_PADDING2, CCTLINFO_G7_W5_NOMINAL_PKT_PADDING3, CCTLINFO_G7_W5_NOMINAL_PKT_PADDING4].into_iter().zip(pads) {
+            Self::g7(&mut t, 5, padding, value);
+        }
+        Self::g7(&mut t, 6, CCTLINFO_G7_W6_AID12_PAID, aid as u32 & 0xfff);
+        Self::g7(&mut t, 6, CCTLINFO_G7_W6_ULDL, station as u32);
+        if mac_id != MAC_ID || station {
+            Self::g7(&mut t, 8, CCTLINFO_G7_W8_BSR_QUEUE_SIZE_FORMAT, he as u32);
+        }
+        self.h2c_send(H2C_CAT_MAC, H2C_CL_MAC_FR_EXCHG, H2C_FUNC_MAC_CCTLINFO_UD_G7, false, true, &words(&t))
+    }
+
+    /// `rtw89_fw_h2c_default_dmac_tbl_v2`: every field to zero (the BE
+    /// chips; the others' DMAC table is set through the registers).
+    fn default_dmac_tbl(&mut self, mac_id: u32) -> Result<(), String> {
+        if !self.hal.chip.be {
+            return Ok(());
+        }
+        let mut t = [0u32; H2C_TBL_G7_WORDS];
+        t[0] = field(DCTLINFO_V2_C0_MACID, mac_id) | field(DCTLINFO_V2_C0_OP, 1);
+        let masks = [DCTLINFO_V2_W0_ALL, DCTLINFO_V2_W1_ALL, DCTLINFO_V2_W2_ALL, DCTLINFO_V2_W3_ALL, DCTLINFO_V2_W4_ALL, DCTLINFO_V2_W5_ALL, DCTLINFO_V2_W6_ALL, DCTLINFO_V2_W7_ALL, DCTLINFO_V2_W8_ALL, DCTLINFO_V2_W9_ALL, DCTLINFO_V2_W10_ALL, DCTLINFO_V2_W11_ALL, DCTLINFO_V2_W12_ALL];
+        for (index, mask) in masks.iter().enumerate() {
+            t[17 + index] = *mask;
+        }
+        self.h2c_send(H2C_CAT_MAC, H2C_CL_MAC_FR_EXCHG, H2C_FUNC_MAC_DCTLINFO_UD_V2, false, false, &words(&t))
+    }
+
+    /// A CMAC table field: its value in word `w`, its mask eight words on.
+    fn cmc(table: &mut [u32; 17], w: usize, mask: u32, value: u32) {
+        table[w] = (table[w] & !mask) | field(mask, value);
+        table[w + 8] |= mask;
+    }
+
+    /// `rtw89_fw_h2c_default_cmac_tbl`: both paths for TX, no antenna
+    /// selection, reports of the management queue off.
+    fn default_cmac_tbl(&mut self, mac_id: u32) -> Result<(), String> {
+        if self.hal.chip.be {
+            return self.default_cmac_tbl_g7(mac_id);
+        }
+        let mut t = [0u32; 17];
+        t[0] = (mac_id & 0x7f) | (1 << 7);
+        if self.cctl_func() == H2C_FUNC_MAC_CCTLINFO_UD {
+            Self::cmc(&mut t, 5, 0x7 << 9, 0);
+            let two = self.hal.chip.rf_paths > 1;
+            Self::cmc(&mut t, 6, 0xf << 16, if two { RF_AB } else { RF_A });
+            Self::cmc(&mut t, 6, 0x3 << 20, 0);
+            Self::cmc(&mut t, 6, 0x3 << 22, two as u32);
+            Self::cmc(&mut t, 6, 1 << 28, 0);
+            Self::cmc(&mut t, 6, 1 << 29, 0);
+        }
+        Self::cmc(&mut t, 1, 1 << 21, 0);
+        Self::cmc(&mut t, 7, 0x3 << 18, 0);
+        Self::cmc(&mut t, 7, 0xf << 24, 0);
+        let func = self.cctl_func();
+        self.h2c_send(H2C_CAT_MAC, H2C_CL_MAC_FR_EXCHG, func, false, true, &words(&t)[..H2C_CMC_TBL_LEN])
+    }
+
+    /// `rtw89_fw_h2c_assoc_cmac_tbl`: no fallback for RTS and data, the
+    /// lowest rate of the band, uplink and downlink, port 0.
+    fn assoc_cmac_tbl(&mut self, mac_id: u32, he: bool) -> Result<(), String> {
+        if self.hal.chip.be {
+            return self.assoc_cmac_tbl_g7(mac_id, he);
+        }
+        let two_g = self.chan.is_some_and(|chan| chan.band == phy::BAND_2G);
+        let lowest = if two_g { HW_RATE_CCK1 } else { HW_RATE_OFDM6 };
+        let mut t = [0u32; 17];
+        t[0] = (mac_id & 0x7f) | (1 << 7);
+        Self::cmc(&mut t, 1, 1 << 25, 1);
+        Self::cmc(&mut t, 1, 1 << 26, 1);
+        Self::cmc(&mut t, 2, 0xf << 28, lowest);
+        Self::cmc(&mut t, 2, 1 << 11, 0);
+        Self::cmc(&mut t, 3, 1 << 6, 0);
+        Self::cmc(&mut t, 7, 1 << 17, 1);
+        Self::cmc(&mut t, 5, 0x7, 0);
+        if he {
+            Self::cmc(&mut t, 6, 1 << 13, 1);
+        }
+        let func = self.cctl_func();
+        self.h2c_send(H2C_CAT_MAC, H2C_CL_MAC_FR_EXCHG, func, false, true, &words(&t)[..H2C_CMC_TBL_LEN])
+    }
+
+    /// `rtw89_phy_ra_sta_update` and `rtw89_fw_h2c_ra`: the modes, width,
+    /// streams and rates the access point and the chip share.
+    fn ra_update(&mut self) -> Result<(), String> {
+        let Some(network) = self.network.clone() else { return Ok(()) };
+        self.ra_for(MAC_ID, &network.peer, network.rates, network.chan)
+    }
+
+    /// The rate adaptation's view of a peer by its MAC ID.
+    fn ra_for(&mut self, mac_id: u32, peer: &Peer, rates: u16, chan: Chan) -> Result<(), String> {
+        let two_g = chan.band == phy::BAND_2G;
+        let mut mode = RA_OFDM;
+        let mut mask: u64 = if two_g { (rates & 0xf) as u64 | (((rates >> 4) as u64 & 0xff) << 4) } else { (rates as u64 & 0xff) << 4 };
+        if two_g && mask & 0xf != 0 {
+            mode |= RA_CCK;
+        }
+        let nss = peer.nss.clamp(1, self.hal.chip.rf_paths) as u32;
+        let map_mask = |map: u16, per: u32, stride: u32| -> u64 {
+            let mut out = 0u64;
+            for stream in 0..nss {
+                let level = (map >> (stream * 2)) & 3;
+                let count = match level {
+                    0 => per - 4,
+                    1 => per - 2,
+                    2 => per,
+                    _ => 0,
+                };
+                out |= ((1u64 << count) - 1) << (12 + stream * stride);
+            }
+            out
+        };
+        let mut sgi = false;
+        let mut ldpc = false;
+        let mut stbc = false;
+        // HE and EHT: the guard interval and LTF fixed (`rtw89_phy_ra_gi_ltf`).
+        let fixed_giltf = peer.he.is_some();
+        if let (Some(eht), Some(he), false) = (&peer.eht, &peer.he, self.hal.no_eht) {
+            // `get_eht_ra_mask`: MCS 0-9, 0-11, 0-13 by the streams each
+            // group has at the link's width, 16 bits a stream; none past
+            // MCS 11 without 4096-QAM.
+            mode = (mode & (RA_CCK | RA_OFDM)) | RA_EHT;
+            let slot = match peer.width {
+                Width::W320 => 2,
+                Width::W160 => 1,
+                _ => 0,
+            };
+            let set = eht.mcs_set(he, true, slot).unwrap_or([0; 3]);
+            let mut eht_mask = 0u64;
+            for (index, &group) in set.iter().enumerate() {
+                if index == 2 && self.hal.no_mcs_12_13 {
+                    continue;
+                }
+                let streams = ((group & wchan::EHT_MCS_NSS_RX) as u32).min(nss);
+                let mcs = (1u64 << (9 + 2 * index as u32 + 1)) - 1;
+                for stream in 0..streams {
+                    eht_mask |= mcs << (12 + 16 * stream);
+                }
+            }
+            mask = (mask & 0xfff) | eht_mask;
+        } else if let Some(he) = &peer.he {
+            mode |= RA_HE;
+            mask = (mask & 0xfff) | map_mask(u16::from_le_bytes([he.mcs[0], he.mcs[1]]), 12, 12);
+            ldpc = he.phy[1] & (1 << 5) != 0;
+            stbc = he.phy[2] & (1 << 3) != 0;
+        } else if let Some(vht) = &peer.vht {
+            mode |= RA_VHT;
+            mask = (mask & 0xfff) | map_mask(u16::from_le_bytes([vht.mcs[0], vht.mcs[1]]), 10, 12);
+            sgi = vht.info & (wchan::VHT_CAP_SGI_80 | wchan::VHT_CAP_SGI_160) != 0;
+            ldpc = vht.info & wchan::VHT_CAP_RXLDPC != 0;
+            stbc = vht.info & (0x7 << 8) != 0;
+        } else if let Some(ht) = &peer.ht {
+            mode |= RA_HT;
+            let mut ht_mask = 0u64;
+            for stream in 0..nss as usize {
+                ht_mask |= (ht.mcs[stream] as u64) << (12 + stream * 12);
+            }
+            mask = (mask & 0xfff) | ht_mask;
+            sgi = ht.info & (wchan::HT_CAP_SGI_20 | wchan::HT_CAP_SGI_40) != 0;
+            ldpc = ht.info & wchan::HT_CAP_LDPC != 0;
+            stbc = ht.info & (0x3 << 8) != 0;
+        }
+        let bw = match peer.width {
+            Width::W40 => 1,
+            Width::W80 => 2,
+            Width::W160 => 3,
+            _ => 0,
+        }
+        .min(chan.bw as u32);
+        let w0 = field(RTW89_H2C_RA_W0_MODE, mode)
+            | field(RTW89_H2C_RA_W0_BW_CAP, bw)
+            | field(RTW89_H2C_RA_W0_MACID, mac_id)
+            | field(RTW89_H2C_RA_W0_UPD_ALL, 1)
+            | field(RTW89_H2C_RA_W0_SGI, sgi as u32)
+            | field(RTW89_H2C_RA_W0_LDPC, ldpc as u32)
+            | field(RTW89_H2C_RA_W0_STBC, stbc as u32)
+            | field(RTW89_H2C_RA_W0_SS_NUM, nss - 1);
+        let giltf = field(RTW89_H2C_RA_W3_FIX_GILTF_EN, fixed_giltf as u32) | field(RTW89_H2C_RA_W3_FIX_GILTF, if fixed_giltf { RTW89_GILTF_2XHE08 } else { 0 });
+        let payload = if self.hal.chip.be {
+            // `struct rtw89_h2c_ra_v1`: the band, the EHT mode's copy of the
+            // modes and width.
+            let w3 = giltf | field(RTW89_H2C_RA_V1_W3_BAND, chan.band as u32);
+            let w4 = field(RTW89_H2C_RA_V1_W4_MODE_EHT, mode) | field(RTW89_H2C_RA_V1_W4_BW_EHT, bw);
+            words(&[w0, mask as u32, (mask >> 32) as u32, w3, w4, 0])
+        } else {
+            words(&[w0, mask as u32, (mask >> 32) as u32, giltf])
+        };
+        self.h2c_send(H2C_CAT_OUTSRC, H2C_CL_OUTSRC_RA, H2C_FUNC_OUTSRC_RA_MACIDCFG, false, false, &payload)
+    }
+
+    /// The security CAM's entry (`rtw89_cam_get_sec_key_cmd`, the key's
+    /// second half in the next entry when longer than 16 bytes).
+    fn sec_cam(&mut self, cam: u32, kind: u32, key: &[u8]) -> Result<(), String> {
+        let ext = key.len() > 16;
+        for half in 0..=(ext as usize) {
+            let mut k = [0u8; 16];
+            let part = &key[half * 16..key.len().min(half * 16 + 16)];
+            k[..part.len()].copy_from_slice(part);
+            let w0 = field(0xff, cam + half as u32) | field(0xff00, 0) | field(0xff_0000, RTW89_SEC_CAM_LEN);
+            let w1 = field(0xf, kind) | if half == 1 { 1 << 4 } else { 0 };
+            let mut values = [w0, w1, 0, 0, 0, 0];
+            for i in 0..4 {
+                values[2 + i] = u32::from_le_bytes([k[i * 4], k[i * 4 + 1], k[i * 4 + 2], k[i * 4 + 3]]);
+            }
+            self.h2c_send(H2C_CAT_MAC, H2C_CL_MAC_SEC_CAM, H2C_FUNC_MAC_SEC_UPD, true, false, &words(&values))?;
+        }
+        Ok(())
+    }
+
+    /// The 8852C's DCTL table names the keys too
+    /// (`rtw89_fw_h2c_dctl_sec_cam_v1`).
+    fn dctl_sec_cam(&mut self) -> Result<(), String> {
+        let pairwise = self.pairwise.map(|(index, cam, _, _)| (index, cam));
+        let group = self.group.map(|(index, cam, _)| (index, cam));
+        self.dctl_sec_cam_for(MAC_ID, pairwise, group)
+    }
+
+    fn dctl_sec_cam_for(&mut self, mac_id: u32, pairwise: Option<(u8, u32)>, group: Option<(u8, u32)>) -> Result<(), String> {
+        if self.hal.chip.be {
+            // `rtw89_cam_fill_dctl_sec_cam_info_v2`.
+            let mut t = [0u32; H2C_TBL_G7_WORDS];
+            t[0] = field(DCTLINFO_V2_C0_MACID, mac_id) | field(DCTLINFO_V2_C0_OP, 1);
+            Self::g7(&mut t, 2, DCTLINFO_V2_W2_IS_MLD, 0);
+            let (k0, c0) = pairwise.map_or((0, 0), |(index, cam)| (index as u32, cam));
+            let (k1, c1) = group.map_or((0, 0), |(index, cam)| (index as u32, cam));
+            let valid = pairwise.is_some() as u32 | (group.is_some() as u32) << 1;
+            Self::g7(&mut t, 4, DCTLINFO_V2_W4_SEC_ENT0_KEYID, k0);
+            Self::g7(&mut t, 4, DCTLINFO_V2_W4_SEC_ENT1_KEYID, k1);
+            for keyid in [DCTLINFO_V2_W4_SEC_ENT2_KEYID, DCTLINFO_V2_W4_SEC_ENT3_KEYID, DCTLINFO_V2_W4_SEC_ENT4_KEYID, DCTLINFO_V2_W4_SEC_ENT5_KEYID, DCTLINFO_V2_W4_SEC_ENT6_KEYID] {
+                Self::g7(&mut t, 4, keyid, 0);
+            }
+            Self::g7(&mut t, 5, DCTLINFO_V2_W5_SEC_ENT_VALID_V1, valid);
+            Self::g7(&mut t, 5, DCTLINFO_V2_W5_SEC_ENT0_V1, c0);
+            Self::g7(&mut t, 6, DCTLINFO_V2_W6_SEC_ENT1_V1, c1);
+            for entry in [DCTLINFO_V2_W6_SEC_ENT2_V1, DCTLINFO_V2_W6_SEC_ENT3_V1, DCTLINFO_V2_W6_SEC_ENT4_V1] {
+                Self::g7(&mut t, 6, entry, 0);
+            }
+            return self.h2c_send(H2C_CAT_MAC, H2C_CL_MAC_FR_EXCHG, H2C_FUNC_MAC_DCTLINFO_UD_V2, false, false, &words(&t));
+        }
+        if self.hal.id() != ChipId::Rtl8852c {
+            return Ok(());
+        }
+        let mut w = [0u32; 32];
+        w[0] = field(DCTLINFO_V1_C0_MACID, mac_id) | field(DCTLINFO_V1_C0_OP, 1);
+        let mut valid = 0;
+        if let Some((index, cam)) = pairwise {
+            valid |= 1;
+            w[5] |= field(DCTLINFO_V1_W4_SEC_ENT0_KEYID, index as u32);
+            w[6] |= field(DCTLINFO_V1_W5_SEC_ENT0, cam);
+        }
+        if let Some((index, cam)) = group {
+            valid |= 2;
+            w[5] |= field(DCTLINFO_V1_W4_SEC_ENT1_KEYID, index as u32);
+            w[6] |= field(DCTLINFO_V1_W5_SEC_ENT1, cam);
+        }
+        w[6] |= field(DCTLINFO_V1_W5_SEC_ENT_VALID, valid);
+        // The masks after the values (`struct rtw89_h2c_dctlinfo_ud_v1`:
+        // the control word, eight values, eight masks).
+        w[9 + 4] = 0x00ff_ffff & (DCTLINFO_V1_W4_SEC_ENT0_KEYID | DCTLINFO_V1_W4_SEC_ENT1_KEYID);
+        w[9 + 5] = DCTLINFO_V1_W5_SEC_ENT_VALID | DCTLINFO_V1_W5_SEC_ENT0 | DCTLINFO_V1_W5_SEC_ENT1;
+        self.h2c_send(H2C_CAT_MAC, H2C_CL_MAC_FR_EXCHG, H2C_FUNC_MAC_DCTLINFO_UD_V1, false, false, &words(&w[..17]))
+    }
+
+    // ---- The radio's operations. ----
+
+    pub(crate) fn scan(&mut self, request: &ScanRequest) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        self.leave_lps();
+        if self.scan.is_some() || self.ap.is_some() {
+            return Err(radio::Error::Busy);
+        }
+        // The radio's channels (the asked ones among them): radar and
+        // 6 GHz ones listened to only.
+        let channels: Vec<(u16, bool)> = self
+            .info()
+            .bands
+            .iter()
+            .flat_map(|band| band.channels.iter())
+            .filter(|channel| !channel.disabled && (request.freqs.is_empty() || request.freqs.contains(&channel.freq)))
+            .map(|channel| (channel.freq, channel.passive || channel.radar))
+            .collect();
+        mac::set_rx_filter(&self.hal, self.rx_filter(true));
+        if self.associated {
+            self.hal.clr32(R_AX_PORT_CFG_P0, B_AX_RX_BSSID_FIT_EN);
+        }
+        self.scan = Some(Scan { channels, next: 0, ssids: request.ssids.clone(), elements: request.elements.clone(), deadline: 0, home: false });
+        self.step_scan();
+        Ok(())
+    }
+
+    fn finish_scan(&mut self, aborted: bool) {
+        if self.scan.take().is_none() {
+            return;
+        }
+        mac::set_rx_filter(&self.hal, self.rx_filter(false));
+        if let Some(network) = self.network.clone() {
+            self.set_channel(&network.chan);
+            if self.associated {
+                self.hal.set32(R_AX_PORT_CFG_P0, B_AX_RX_BSSID_FIT_EN);
+            }
+        }
+        if let Some(device) = &self.device {
+            device.scan_done(aborted);
+        }
+    }
+
+    pub(crate) fn abort_scan(&mut self) {
+        self.finish_scan(true);
+    }
+
+    /// The scan's next channel when its dwell is over (with the operating
+    /// channel between two while associated).
+    fn step_scan(&mut self) {
+        let now = crate::now_ms();
+        let Some(scan) = self.scan.as_mut() else { return };
+        if now < scan.deadline {
+            return;
+        }
+        if self.associated && !scan.home && scan.next > 0 {
+            scan.home = true;
+            scan.deadline = now + HOME_MS;
+            if let Some(network) = self.network.clone() {
+                self.set_channel(&network.chan);
+            }
+            return;
+        }
+        let Some(&(freq, listen_only)) = scan.channels.get(scan.next) else {
+            self.finish_scan(false);
+            return;
+        };
+        scan.home = false;
+        scan.next += 1;
+        let passive = scan.ssids.is_empty() || listen_only;
+        scan.deadline = now + if passive { DWELL_PASSIVE_MS } else { DWELL_ACTIVE_MS };
+        let ssids = scan.ssids.clone();
+        let elements = scan.elements.clone();
+        self.set_channel(&Chan::new(&Chandef::simple(freq)));
+        if !passive {
+            for ssid in &ssids {
+                let probe = wifi::probe_request(&self.address, ssid, BandId::of(freq).rates(), &elements);
+                let _ = self.transmit(probe);
+            }
+        }
+    }
+
+    /// `rtw89_ops_sta_state` to NONE: the channel, the BSSID in the CAM.
+    pub(crate) fn join(&mut self, join: &Join) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        self.leave_lps();
+        if self.ap.is_some() {
+            return Err(radio::Error::Busy);
+        }
+        self.finish_scan(true);
+        self.leave();
+        let network = Network::new(join);
+        let chan = network.chan;
+        self.network = Some(network);
+        self.aggregates = Aggregates::default();
+        self.ba_cam.clear();
+        self.set_channel(&chan);
+        self.rfk_channel();
+        if let Err(error) = self.addr_cam(RTW89_ROLE_INFO_CHANGE) {
+            ostd::warn!("rtw89: joining: {}", error);
+            return Err(radio::Error::Failed);
+        }
+        Ok(())
+    }
+
+    /// Associated (`rtw89_core_sta_assoc`): the port and its BSSID filter,
+    /// the join information, the CAM, the CMAC table, the rates.
+    pub(crate) fn associated(&mut self, association: &Association) -> radio::Result<()> {
+        let Some(network) = self.network.as_mut() else { return Err(radio::Error::Invalid) };
+        network.peer = association.peer.clone();
+        network.join.chandef = association.chandef;
+        network.chan = Chan::new(&association.chandef);
+        let (beacon_interval, chan) = (network.join.beacon_interval, network.chan);
+        let dtim = wifi::Elements(&network.join.elements).get(wifi::IE_TIM).and_then(|value| value.get(1).copied()).unwrap_or(1);
+        self.aid = association.aid & 0x3fff;
+        self.qos = association.qos;
+        self.associated = true;
+        self.set_channel(&chan);
+        mac::port_update(&self.hal, RTW89_NET_TYPE_INFRA, beacon_interval, dtim);
+        let he = association.peer.he.is_some();
+        let result = self.join_info(false).and_then(|()| self.addr_cam(RTW89_ROLE_INFO_CHANGE)).and_then(|()| self.assoc_cmac_tbl(MAC_ID, he)).and_then(|()| self.ra_update());
+        if let Err(error) = result {
+            ostd::warn!("rtw89: association: {}", error);
+            return Err(radio::Error::Failed);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn leave(&mut self) {
+        if self.network.is_none() {
+            return;
+        }
+        self.leave_lps();
+        self.power_save = false;
+        self.associated = false;
+        self.aid = 0;
+        self.pairwise = None;
+        self.group = None;
+        self.signal = None;
+        self.aggregates = Aggregates::default();
+        self.ba_cam.retain(|cam| cam.mac_id != MAC_ID);
+        if !self.dead {
+            mac::port_update(&self.hal, RTW89_NET_TYPE_NO_LINK, 100, 1);
+            let _ = self.join_info(true);
+        }
+        self.network = None;
+        if !self.dead {
+            let _ = self.addr_cam(RTW89_ROLE_INFO_CHANGE);
+        }
+    }
+
+    // ---- As an access point (`rtw89_ops_start_ap`,
+    // `rtw89_fw_h2c_update_beacon`, `rtw89_core_sta_add`/`_assoc`/
+    // `_disconnect`/`_remove`). ----
+
+    /// Port 0 an access point's on the network's channel: the CMAC table,
+    /// role, join information and CAM of the interface, the beacon.
+    pub(crate) fn start_ap(&mut self, config: &ApConfig) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        self.leave_lps();
+        self.stop_ap();
+        self.finish_scan(true);
+        self.leave();
+        let chan = Chan::new(&config.chandef);
+        self.ap = Some(Ap { config: config.clone(), chan, stations: BTreeMap::new(), group: None });
+        self.set_channel(&chan);
+        self.rfk_channel();
+        mac::port_update(&self.hal, RTW89_NET_TYPE_AP_MODE, config.beacon_interval, config.dtim_period.max(1));
+        let result = self
+            .assoc_cmac_tbl(MAC_ID, false)
+            .and_then(|()| self.role_maintain(RTW89_ROLE_TYPE_CHANGE))
+            .and_then(|()| self.join_info_for(MAC_ID, true, RTW89_NET_TYPE_AP_MODE, RTW89_SELF_ROLE_AP, RTW89_WIFI_ROLE_AP, false))
+            .and_then(|()| self.addr_cam(RTW89_ROLE_INFO_CHANGE))
+            .and_then(|()| self.update_beacon());
+        if let Err(error) = result {
+            ostd::warn!("rtw89: the access point: {}", error);
+            self.stop_ap();
+            return Err(radio::Error::Failed);
+        }
+        Ok(())
+    }
+
+    /// `rtw89_fw_h2c_update_beacon`: the beacon for port 0 at the band's
+    /// lowest rate, the hardware's sequence numbers, where its TIM is
+    /// after the header.
+    fn update_beacon(&mut self) -> Result<(), String> {
+        let Some(ap) = &self.ap else { return Ok(()) };
+        let frame = ap.config.beacon.frame(ap.config.dtim_period);
+        let tim = ap.config.beacon.tim_offset().saturating_sub(wifi::HEADER) as u32;
+        let rate = if ap.chan.band == phy::BAND_2G { HW_RATE_CCK1 } else { HW_RATE_OFDM6 };
+        let w0 = field(RTW89_H2C_BCN_UPD_W0_PORT, 0) | field(RTW89_H2C_BCN_UPD_W0_MBSSID, 0) | field(RTW89_H2C_BCN_UPD_W0_BAND, 0) | field(RTW89_H2C_BCN_UPD_W0_GRP_IE_OFST, tim | (1 << 7));
+        let w1 = field(RTW89_H2C_BCN_UPD_W1_MACID, MAC_ID)
+            | field(RTW89_H2C_BCN_UPD_W1_SSN_SEL, RTW89_MGMT_HW_SSN_SEL)
+            | field(RTW89_H2C_BCN_UPD_W1_SSN_MODE, RTW89_MGMT_HW_SEQ_MODE)
+            | field(RTW89_H2C_BCN_UPD_W1_RATE, rate);
+        if self.hal.chip.be {
+            // `struct rtw89_h2c_bcn_upd_be`: eight words, then the frame.
+            let w0 = field(RTW89_H2C_BCN_UPD_BE_W0_PORT, 0) | field(RTW89_H2C_BCN_UPD_BE_W0_MBSSID, 0) | field(RTW89_H2C_BCN_UPD_BE_W0_BAND, 0) | field(RTW89_H2C_BCN_UPD_BE_W0_GRP_IE_OFST, tim | (1 << 7));
+            let w1 = field(RTW89_H2C_BCN_UPD_BE_W1_MACID, MAC_ID)
+                | field(RTW89_H2C_BCN_UPD_BE_W1_SSN_SEL, RTW89_MGMT_HW_SSN_SEL)
+                | field(RTW89_H2C_BCN_UPD_BE_W1_SSN_MODE, RTW89_MGMT_HW_SEQ_MODE)
+                | field(RTW89_H2C_BCN_UPD_BE_W1_RATE, rate);
+            let mut payload = words(&[w0, w1, 0, 0, 0, 0, 0, 0]);
+            payload.extend_from_slice(&frame);
+            return self.h2c_send(H2C_CAT_MAC, H2C_CL_MAC_FR_EXCHG, H2C_FUNC_MAC_BCN_UPD_BE, false, true, &payload);
+        }
+        let mut payload = words(&[w0, w1, 0]);
+        payload.extend_from_slice(&frame);
+        self.h2c_send(H2C_CAT_MAC, H2C_CL_MAC_FR_EXCHG, H2C_FUNC_MAC_BCN_UPD, false, true, &payload)
+    }
+
+    pub(crate) fn set_beacon(&mut self, beacon: &BeaconTemplate) -> radio::Result<()> {
+        let Some(ap) = &mut self.ap else { return Err(radio::Error::Down) };
+        ap.config.beacon = beacon.clone();
+        self.update_beacon().map_err(|error| {
+            ostd::warn!("rtw89: beacon: {}", error);
+            radio::Error::Failed
+        })
+    }
+
+    /// The stations gone, port 0 a station's again.
+    pub(crate) fn stop_ap(&mut self) {
+        let Some(ap) = &self.ap else { return };
+        let addresses: Vec<Address> = ap.stations.keys().copied().collect();
+        for address in &addresses {
+            self.remove_station(address);
+        }
+        self.ap = None;
+        if !self.dead {
+            mac::port_update(&self.hal, RTW89_NET_TYPE_NO_LINK, 100, 1);
+            let _ = self.role_maintain(RTW89_ROLE_TYPE_CHANGE);
+            let _ = self.join_info(true);
+            let _ = self.addr_cam(RTW89_ROLE_INFO_CHANGE);
+        }
+    }
+
+    /// The address CAM entry of a station of the access point.
+    fn station_cam(&self, address: &Address, station: &ApStation) -> AddrCam {
+        let group = self.ap.as_ref().and_then(|ap| ap.group).map(|(index, cam, _, _)| (index, cam));
+        AddrCam {
+            idx: station.mac_id,
+            mac_id: station.mac_id,
+            sma: self.address,
+            tma: *address,
+            bssid: self.address,
+            net_type: RTW89_NET_TYPE_AP_MODE,
+            aid: station.aid,
+            pairwise: station.pairwise.map(|(index, cam, _, _)| (index, cam)),
+            group,
+            mode: RTW89_ROLE_INFO_CHANGE,
+        }
+    }
+
+    /// A station on a MAC ID of its own: its role and tables, then (as
+    /// once associated) its join information, CAM entry, CMAC table and
+    /// rates.
+    pub(crate) fn add_station(&mut self, entry: &StationEntry) -> radio::Result<()> {
+        let Some(ap) = &self.ap else { return Err(radio::Error::Down) };
+        if ap.stations.contains_key(&entry.address) {
+            self.remove_station(&entry.address);
+        }
+        let Some(ap) = &self.ap else { return Err(radio::Error::Down) };
+        let used: Vec<u32> = ap.stations.values().map(|station| station.mac_id).collect();
+        let Some(mac_id) = (1..=AP_STATIONS).find(|id| !used.contains(id)) else { return Err(radio::Error::Busy) };
+        let chan = ap.chan;
+        let rates = rate_bitmap(BandId::of(ap.config.chandef.control), entry.peer.rates.iter().copied());
+        let station = ApStation { mac_id, aid: entry.aid & 0x3fff, peer: entry.peer.clone(), pairwise: None, aggregates: Aggregates::default() };
+        let he = entry.peer.he.is_some();
+        let cam = self.station_cam(&entry.address, &station);
+        mac::tables_init(&self.hal, mac_id);
+        let result = self
+            .role_maintain_for(mac_id, RTW89_SELF_ROLE_AP_CLIENT, RTW89_WIFI_ROLE_AP, RTW89_ROLE_CREATE)
+            .and_then(|()| self.default_cmac_tbl(mac_id))
+            .and_then(|()| self.default_dmac_tbl(mac_id))
+            .and_then(|()| self.join_info_for(mac_id, false, RTW89_NET_TYPE_AP_MODE, RTW89_SELF_ROLE_AP_CLIENT, RTW89_WIFI_ROLE_AP, false))
+            .and_then(|()| self.addr_cam_entry(&cam, true))
+            .and_then(|()| self.assoc_cmac_tbl(mac_id, he))
+            .and_then(|()| self.ra_for(mac_id, &entry.peer, rates, chan));
+        if let Some(ap) = &mut self.ap {
+            ap.stations.insert(entry.address, station);
+        }
+        if let Err(error) = result {
+            ostd::warn!("rtw89: station {:02x?}: {}", entry.address, error);
+            self.remove_station(&entry.address);
+            return Err(radio::Error::Failed);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn remove_station(&mut self, address: &Address) {
+        let Some(ap) = &mut self.ap else { return };
+        let Some(station) = ap.stations.remove(address) else { return };
+        if self.dead {
+            return;
+        }
+        let cam = self.station_cam(address, &station);
+        let mac_id = station.mac_id;
+        let _ = self.join_info_for(mac_id, true, RTW89_NET_TYPE_NO_LINK, RTW89_SELF_ROLE_AP_CLIENT, RTW89_WIFI_ROLE_AP, false);
+        let _ = self.addr_cam_entry(&cam, false);
+        let _ = self.role_maintain_for(mac_id, RTW89_SELF_ROLE_AP_CLIENT, RTW89_WIFI_ROLE_AP, RTW89_ROLE_REMOVE);
+    }
+
+    /// As an access point: a station's pairwise key in its own pair of
+    /// CAM entries, the group's for the interface; each entry naming them.
+    fn set_key_ap(&mut self, key: &Key, kind: u32, remove: bool) -> radio::Result<()> {
+        if key.pairwise {
+            let Some(address) = key.address else { return if remove { Ok(()) } else { Err(radio::Error::Invalid) } };
+            let Some(mac_id) = self.ap.as_ref().and_then(|ap| ap.stations.get(&address)).map(|station| station.mac_id) else {
+                return if remove { Ok(()) } else { Err(radio::Error::Invalid) };
+            };
+            let cam = SEC_CAM_STATIONS + 2 * (mac_id - 1);
+            if !remove {
+                self.sec_cam(cam, kind, &key.key).map_err(|_| radio::Error::Failed)?;
+            }
+            let group = self.ap.as_ref().and_then(|ap| ap.group).map(|(index, cam, _, _)| (index, cam));
+            if let Some(station) = self.ap.as_mut().and_then(|ap| ap.stations.get_mut(&address)) {
+                station.pairwise = (!remove).then_some((key.index, cam, kind, 1));
+            }
+            let Some(station) = self.ap.as_ref().and_then(|ap| ap.stations.get(&address)) else { return Ok(()) };
+            let pairwise = station.pairwise.map(|(index, cam, _, _)| (index, cam));
+            let cam_entry = self.station_cam(&address, station);
+            return self.dctl_sec_cam_for(mac_id, pairwise, group).and_then(|()| self.addr_cam_entry(&cam_entry, true)).map_err(|_| radio::Error::Failed);
+        }
+        if !remove {
+            self.sec_cam(SEC_CAM_GROUP, kind, &key.key).map_err(|_| radio::Error::Failed)?;
+        }
+        if let Some(ap) = &mut self.ap {
+            ap.group = (!remove).then_some((key.index, SEC_CAM_GROUP, kind, 1));
+        }
+        let group = self.ap.as_ref().and_then(|ap| ap.group).map(|(index, cam, _, _)| (index, cam));
+        let entries: Vec<AddrCam> = self.ap.as_ref().map(|ap| ap.stations.iter().map(|(address, station)| self.station_cam(address, station)).collect()).unwrap_or_default();
+        let result = self.dctl_sec_cam_for(MAC_ID, None, group).and_then(|()| self.addr_cam(RTW89_ROLE_INFO_CHANGE));
+        for entry in &entries {
+            let _ = self.addr_cam_entry(entry, true);
+        }
+        result.map_err(|_| radio::Error::Failed)
+    }
+
+    pub(crate) fn set_key(&mut self, key: &Key, remove: bool) -> radio::Result<()> {
+        let kind = match key.cipher {
+            radio::CIPHER_CCMP => SEC_CCMP128,
+            radio::CIPHER_CCMP_256 => SEC_CCMP256,
+            radio::CIPHER_GCMP => SEC_GCMP128,
+            radio::CIPHER_GCMP_256 => SEC_GCMP256,
+            // A station's group key of a mixed WPA/WPA2 network.
+            radio::CIPHER_TKIP if !key.pairwise && self.ap.is_none() => SEC_TKIP,
+            _ if remove => SEC_CCMP128,
+            _ => return Err(radio::Error::Unsupported),
+        };
+        if key.key.len() > 32 {
+            return Err(radio::Error::Invalid);
+        }
+        // TKIP's temporal key goes to the chip, its MIC keys stay here.
+        let material = if kind == SEC_TKIP && !remove {
+            if key.key.len() != 32 {
+                return Err(radio::Error::Invalid);
+            }
+            &key.key[..16]
+        } else {
+            &key.key[..]
+        };
+        if self.ap.is_some() {
+            return self.set_key_ap(key, kind, remove);
+        }
+        let cam = if key.pairwise { SEC_CAM_PAIRWISE } else { SEC_CAM_GROUP };
+        if remove {
+            if key.pairwise {
+                self.pairwise = None;
+            } else {
+                self.group = None;
+                self.group_mic = None;
+            }
+        } else {
+            if !key.pairwise {
+                self.group_mic = if kind == SEC_TKIP { aster_wlan::tkip::rx_mic_key(&key.key) } else { None };
+            }
+            if let Err(error) = self.sec_cam(cam, kind, material) {
+                ostd::warn!("rtw89: key: {}", error);
+                return Err(radio::Error::Failed);
+            }
+            if key.pairwise {
+                self.pairwise = Some((key.index, cam, kind, 1));
+            } else {
+                self.group = Some((key.index, cam, kind));
+            }
+        }
+        if self.dctl_sec_cam().and_then(|()| self.addr_cam(RTW89_ROLE_INFO_CHANGE)).is_err() {
+            return Err(radio::Error::Failed);
+        }
+        Ok(())
+    }
+
+    // ---- Frames. ----
+
+    /// An 802.11 frame out: management on CH8 at the band's lowest rate
+    /// (hardware sequence numbers), data on its access category's channel;
+    /// protected ones with their CCMP header and the CAM entry named.
+    pub(crate) fn transmit(&mut self, mut frame: Vec<u8>) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if frame.len() < wifi::HEADER {
+            return Err(radio::Error::Invalid);
+        }
+        let data = wifi::is_data(&frame);
+        // As an access point, to a station by its MAC ID; no protected
+        // management frames.
+        let receiver: Option<Address> = frame.get(4..10).and_then(|b| b.try_into().ok());
+        let mac_id = self.ap.as_ref().and_then(|ap| receiver.and_then(|address| ap.stations.get(&address))).map_or(MAC_ID, |station| station.mac_id);
+        let mut desc = TxDesc { mac_id, ..TxDesc::default() };
+        if self.ap.is_some() {
+            frame[1] &= !wifi::PROTECTED;
+        } else if frame[1] & wifi::PROTECTED != 0 {
+            match self.pairwise.as_mut() {
+                Some((index, cam, kind, pn)) => {
+                    let value = *pn;
+                    *pn += 1;
+                    let header_len = if data && frame[0] & 0x80 != 0 { 26 } else { 24 };
+                    if self.hal.chip.be {
+                        // `hw_sec_hdr`: the chip writes the header, the PN
+                        // in the descriptor (`rtw89_core_tx_update_sec_key`).
+                        desc.pn = Some(value);
+                        desc.wp_offset = 1;
+                    } else {
+                        drop(frame.splice(header_len..header_len, ccmp_header(*index, value)));
+                    }
+                    desc.sec_type = *kind;
+                    desc.sec_cam = *cam;
+                    desc.key_id = *index as u32;
+                }
+                None => frame[1] &= !wifi::PROTECTED,
+            }
+        }
+        let qos_data = data && frame[0] & 0x80 != 0;
+        if data {
+            self.traffic.0 = self.traffic.0.saturating_add(1);
+        }
+        let sequence = if qos_data && self.ap.is_none() {
+            self.aggregates.next_seq(frame[24] & 7)
+        } else {
+            let value = self.sequence;
+            self.sequence = (value + 1) & 0x0fff;
+            value
+        };
+        frame[22..24].copy_from_slice(&(sequence << 4).to_le_bytes());
+        desc.seq = sequence as u32;
+        desc.bmc = frame[4] & 1 != 0;
+        if qos_data
+            && self.ap.is_none()
+            && let Some(network) = &self.network
+        {
+            self.aggregates.fill(&mut desc, frame[24] & 7, &network.peer);
+        }
+        desc.hdr_llc_len = if qos_data { 13 } else { 12 };
+        desc.lowest_rate = self.lowest_rate();
+        if data {
+            let tid = if qos_data { frame[24] & 7 } else { 0 };
+            desc.qsel = match tid {
+                1 | 2 => RTW89_TX_QSEL_BK_0,
+                4 | 5 => RTW89_TX_QSEL_VI_0,
+                6 | 7 => RTW89_TX_QSEL_VO_0,
+                _ => RTW89_TX_QSEL_BE_0,
+            };
+            desc.channel = match desc.qsel {
+                RTW89_TX_QSEL_BK_0 => TXCH_ACH0 + 1,
+                RTW89_TX_QSEL_VI_0 => TXCH_ACH0 + 2,
+                RTW89_TX_QSEL_VO_0 => TXCH_ACH0 + 3,
+                _ => TXCH_ACH0,
+            };
+            desc.tid_indicate = matches!(tid, 2 | 3 | 5 | 7);
+            if desc.bmc || !self.associated {
+                desc.use_rate = true;
+                desc.rate = self.lowest_rate();
+            }
+        } else {
+            desc.qsel = RTW89_TX_QSEL_B0_MGMT;
+            desc.channel = TXCH_CH8;
+            desc.use_rate = true;
+            desc.rate = self.lowest_rate();
+            desc.hw_seq = true;
+        }
+        if frame.len() > TX_FRAME_MAX {
+            return Err(radio::Error::Invalid);
+        }
+        self.pci.send_frame(&self.hal, &desc, &frame).map_err(|_| radio::Error::Busy)
+    }
+
+    fn lowest_rate(&self) -> u32 {
+        if self.chan.is_none_or(|chan| chan.band == phy::BAND_2G) { HW_RATE_CCK1 } else { HW_RATE_OFDM6 }
+    }
+
+    pub(crate) fn send(&mut self, ethernet: &[u8], plain: bool) -> radio::Result<()> {
+        if self.ap.is_some() {
+            return self.send_ap(ethernet, plain);
+        }
+        let Some(network) = &self.network else { return Err(radio::Error::Down) };
+        let tid = self.qos.then(|| wifi::tid_of(ethernet));
+        let protected = !plain && self.pairwise.is_some();
+        let frame = wifi::data_from_ethernet(ethernet, &network.join.bssid, tid, protected).ok_or(radio::Error::Invalid)?;
+        self.transmit(frame)
+    }
+
+    // ---- Block acknowledgment (`rtw89_ops_ampdu_action`): a receive
+    // agreement gets a static BA CAM entry (the hardware makes dynamic
+    // ones by itself when they run out), the Wi-Fi component puts the
+    // frames back in order; frames of a TID agreed to go out go in
+    // aggregates, the BE chips' CMAC table sized for the windows. ----
+
+    /// The peer's MAC ID: the access point's, or a station's.
+    fn peer_mac_id(&self, peer: &Address) -> Option<u32> {
+        match &self.ap {
+            Some(ap) => ap.stations.get(peer).map(|station| station.mac_id),
+            None => self.network.as_ref().filter(|network| network.join.bssid == *peer).map(|_| MAC_ID),
+        }
+    }
+
+    /// `rtw89_fw_h2c_ba_cam` and `_v1`: the entry for the peer's TID, from
+    /// `ssn`, or freed.
+    fn ba_cam_h2c(&mut self, mac_id: u32, tid: u8, entry: u8, start: Option<(u16, u16)>) -> Result<(), String> {
+        let (_, dynamic, version) = ba_cam_layout(self.hal.id());
+        let (ssn, window) = start.unwrap_or((0, 0));
+        // The bitmap: 64 frames, 256, 512 or 1024 (`BMAP_SIZE`).
+        let bmap = match window {
+            0..=64 => 0,
+            65..=256 => 4,
+            257..=512 => 8,
+            _ => 10,
+        };
+        let valid = start.is_some() as u32;
+        let (w0, w1, func) = match version {
+            BaCamVersion::V1 => (
+                valid | 1 << 1 | (tid as u32 & 0xf) << 4 | (mac_id & 0xff) << 8 | bmap << 16 | (ssn as u32 & 0xfff) << 20,
+                ((entry + dynamic) as u32) << 24 | 1 << 8,
+                H2C_FUNC_MAC_BA_CAM_V1,
+            ),
+            _ if start.is_none() => {
+                let (w0, w1) = if version == BaCamVersion::V0Ext { (mac_id << 8, (entry as u32) << 28) } else { ((mac_id & 0xff) << 8 | (entry as u32 & 3) << 2, 0) };
+                (w0, w1, H2C_FUNC_MAC_BA_CAM)
+            }
+            _ => {
+                let mut w0 = 1 | 1 << 1 | (tid as u32 & 0xf) << 4 | (mac_id & 0xff) << 8 | bmap.min(4) << 16 | (ssn as u32 & 0xfff) << 20;
+                let mut w1 = 0;
+                if version == BaCamVersion::V0Ext {
+                    w1 = (entry as u32) << 28 | 1 << 8;
+                } else {
+                    w0 |= (entry as u32 & 3) << 2;
+                }
+                (w0, w1, H2C_FUNC_MAC_BA_CAM)
+            }
+        };
+        self.h2c_send(H2C_CAT_MAC, H2C_CL_BA_CAM, func, false, true, &words(&[w0, w1]))
+    }
+
+    pub(crate) fn rx_ba_start(&mut self, ba: &mut BlockAck) -> radio::Result<Reorder> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        let mac_id = self.peer_mac_id(&ba.peer).ok_or(radio::Error::Invalid)?;
+        self.rx_ba_stop(&ba.peer, ba.tid);
+        let (count, _, _) = ba_cam_layout(self.hal.id());
+        // No static entry left: the hardware's dynamic ones answer.
+        let Some(entry) = (0..count).find(|entry| !self.ba_cam.iter().any(|cam| cam.entry == *entry)) else {
+            return Ok(Reorder::Host);
+        };
+        if let Err(error) = self.ba_cam_h2c(mac_id, ba.tid, entry, Some((ba.ssn, ba.buffer))) {
+            ostd::info!("rtw89: BA CAM: {}", error);
+            return Ok(Reorder::Host);
+        }
+        self.ba_cam.push(BaCam { peer: ba.peer, tid: ba.tid, mac_id, entry });
+        Ok(Reorder::Host)
+    }
+
+    pub(crate) fn rx_ba_stop(&mut self, peer: &Address, tid: u8) {
+        let Some(at) = self.ba_cam.iter().position(|cam| cam.peer == *peer && cam.tid == tid) else { return };
+        let cam = self.ba_cam.remove(at);
+        if !self.dead {
+            let _ = self.ba_cam_h2c(cam.mac_id, tid, cam.entry, None);
+        }
+    }
+
+    fn aggregates_of(&mut self, peer: &Address) -> Option<&mut Aggregates> {
+        match &mut self.ap {
+            Some(ap) => ap.stations.get_mut(peer).map(|station| &mut station.aggregates),
+            None if self.network.as_ref().is_some_and(|network| network.join.bssid == *peer) => Some(&mut self.aggregates),
+            None => None,
+        }
+    }
+
+    pub(crate) fn tx_ba_start(&mut self, peer: &Address, tid: u8) -> radio::Result<u16> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        self.aggregates_of(peer).map(|aggregates| aggregates.tid_seq[tid as usize & 7]).ok_or(radio::Error::Invalid)
+    }
+
+    /// The window of `tid` (0: none), and on the BE chips the CMAC table's
+    /// bitmap for the windows.
+    fn set_window(&mut self, peer: &Address, tid: u8, window: u16) -> radio::Result<()> {
+        let mac_id = self.peer_mac_id(peer).ok_or(radio::Error::Invalid)?;
+        let aggregates = self.aggregates_of(peer).ok_or(radio::Error::Invalid)?;
+        aggregates.window[tid as usize & 7] = window;
+        let bmap = aggregates.ba_bmap();
+        if self.hal.chip.be && !self.dead {
+            let mut t = [0u32; H2C_TBL_G7_WORDS];
+            t[0] = field(CCTLINFO_G7_C0_MACID, mac_id) | field(CCTLINFO_G7_C0_OP, 1);
+            Self::g7(&mut t, 3, CCTLINFO_G7_W3_BA_BMAP, bmap);
+            if let Err(error) = self.h2c_send(H2C_CAT_MAC, H2C_CL_MAC_FR_EXCHG, H2C_FUNC_MAC_CCTLINFO_UD_G7, false, true, &words(&t)) {
+                ostd::info!("rtw89: aggregates' CMAC table: {}", error);
+                return Err(radio::Error::Failed);
+            }
+        }
+        Ok(())
+    }
+
+    pub(crate) fn tx_ba_operational(&mut self, ba: &BlockAck) -> radio::Result<()> {
+        self.set_window(&ba.peer, ba.tid, ba.buffer.max(1))
+    }
+
+    pub(crate) fn tx_ba_stop(&mut self, peer: &Address, tid: u8) {
+        let _ = self.set_window(peer, tid, 0);
+    }
+
+    /// As an access point: to the station the destination names (its MAC
+    /// ID, the firmware's rate adaptation, its pairwise key), or to all of
+    /// them at the lowest rate with the group's key.
+    fn send_ap(&mut self, ethernet: &[u8], plain: bool) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        let address = self.address;
+        let lowest = self.lowest_rate();
+        let Some(ap) = &mut self.ap else { return Err(radio::Error::Down) };
+        let destination: Address = ethernet.get(..6).and_then(|b| b.try_into().ok()).ok_or(radio::Error::Invalid)?;
+        let next = |key: &mut Option<(u8, u32, u32, u64)>| {
+            key.as_mut().map(|(index, cam, kind, pn)| {
+                let value = *pn;
+                *pn += 1;
+                (*index, *cam, *kind, value)
+            })
+        };
+        let multicast = wifi::is_multicast(&destination);
+        let mut desc = TxDesc::default();
+        let (mac_id, tid, key, tid_sequence) = if multicast {
+            (MAC_ID, None, if plain { None } else { next(&mut ap.group) }, None)
+        } else {
+            let station = ap.stations.get_mut(&destination).ok_or(radio::Error::Invalid)?;
+            let tid = station.peer.qos.then(|| wifi::tid_of(ethernet));
+            let tid_sequence = tid.map(|tid| station.aggregates.next_seq(tid));
+            if let Some(tid) = tid {
+                station.aggregates.fill(&mut desc, tid, &station.peer);
+            }
+            (station.mac_id, tid, if plain { None } else { next(&mut station.pairwise) }, tid_sequence)
+        };
+        let mut frame = wifi::data_from_ethernet_ap(ethernet, &address, tid, key.is_some()).ok_or(radio::Error::Invalid)?;
+        desc.mac_id = mac_id;
+        let header_len = if tid.is_some() { 26 } else { 24 };
+        if let Some((index, cam, kind, pn)) = key {
+            if self.hal.chip.be {
+                desc.pn = Some(pn);
+                desc.wp_offset = 1;
+            } else {
+                drop(frame.splice(header_len..header_len, ccmp_header(index, pn)));
+            }
+            desc.sec_type = kind;
+            desc.sec_cam = cam;
+            desc.key_id = index as u32;
+        }
+        let sequence = tid_sequence.unwrap_or_else(|| {
+            let value = self.sequence;
+            self.sequence = (value + 1) & 0x0fff;
+            value
+        });
+        frame[22..24].copy_from_slice(&(sequence << 4).to_le_bytes());
+        desc.seq = sequence as u32;
+        desc.bmc = multicast;
+        if multicast {
+            desc.agg_en = false;
+        }
+        desc.hdr_llc_len = if tid.is_some() { 13 } else { 12 };
+        let tid = tid.unwrap_or(0);
+        desc.qsel = match tid {
+            1 | 2 => RTW89_TX_QSEL_BK_0,
+            4 | 5 => RTW89_TX_QSEL_VI_0,
+            6 | 7 => RTW89_TX_QSEL_VO_0,
+            _ => RTW89_TX_QSEL_BE_0,
+        };
+        desc.channel = match desc.qsel {
+            RTW89_TX_QSEL_BK_0 => TXCH_ACH0 + 1,
+            RTW89_TX_QSEL_VI_0 => TXCH_ACH0 + 2,
+            RTW89_TX_QSEL_VO_0 => TXCH_ACH0 + 3,
+            _ => TXCH_ACH0,
+        };
+        desc.tid_indicate = matches!(tid, 2 | 3 | 5 | 7);
+        desc.lowest_rate = lowest;
+        if multicast {
+            desc.use_rate = true;
+            desc.rate = lowest;
+        }
+        if frame.len() > TX_FRAME_MAX {
+            return Err(radio::Error::Invalid);
+        }
+        self.pci.send_frame(&self.hal, &desc, &frame).map_err(|_| radio::Error::Busy)
+    }
+
+    // ---- What the chip says. ----
+
+    pub(crate) fn poll(&mut self) {
+        if self.dead {
+            return;
+        }
+        if !self.hal.present() {
+            ostd::warn!("rtw89: the card is gone");
+            self.died();
+            return;
+        }
+        if self.pci.acknowledge(&self.hal) {
+            ostd::warn!("rtw89: the firmware halted ({:#x}); the card stays off until the next boot", self.hal.r32(R_AX_HALT_C2H));
+            self.died();
+            return;
+        }
+        for packet in self.pci.receive(&self.hal) {
+            self.handle(&packet);
+        }
+        self.flush_held(None, None);
+        self.step_scan();
+        // `rtw89_track_work`: leisure power save while the link idles (50
+        // data frames at most either way in the 2 s), awake when it is
+        // busy.
+        let now = crate::now_ms();
+        if now >= self.watchdog {
+            self.watchdog = now + 2000;
+            // `rtw89_chip_rfk_track`: the DPD with the temperature, awake.
+            if !self.lps {
+                self.host_rfk.track(&self.hal, self.chan.as_ref(), self.scan.is_some());
+            }
+            let (sent, received) = core::mem::take(&mut self.traffic);
+            if sent > LPS_THRESHOLD || received > LPS_THRESHOLD {
+                self.leave_lps();
+            } else if self.power_save && self.associated && self.ap.is_none() && self.scan.is_none() {
+                self.enter_lps();
+            }
+        }
+        if let Some(device) = &self.device {
+            device.ready_to_send();
+        }
+    }
+
+    // ---- Power save (`ps.c`): leisure power save, the firmware dozing
+    // between beacons (`RTW89_MAC_AX_PS_MODE_LEGACY`); not the deeper
+    // low power mode of the bus. ----
+
+    pub(crate) fn set_power_save(&mut self, enabled: bool) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if self.ap.is_some() {
+            return Err(radio::Error::Invalid);
+        }
+        self.power_save = enabled;
+        if !enabled {
+            self.leave_lps();
+        }
+        Ok(())
+    }
+
+    /// `rtw89_fw_h2c_lps_parm`: the MAC ID's power save mode, its last
+    /// RPWM, PS-Poll's smart power save and an awake interval of one.
+    fn lps_parm(&mut self, enter: bool) -> Result<(), String> {
+        let (mode, rpwm) = if enter { (RTW89_MAC_AX_PS_MODE_LEGACY, RTW89_LAST_RPWM_PS) } else { (RTW89_MAC_AX_PS_MODE_ACTIVE, RTW89_LAST_RPWM_ACTIVE) };
+        let w0 = MAC_ID | mode << 8 | 1 << 16 | 1 << 20 | 1 << 24;
+        self.h2c_send(H2C_CAT_MAC, H2C_CL_MAC_PS, H2C_FUNC_MAC_LPS_PARM, false, false, &words(&[w0, rpwm << 8]))
+    }
+
+    /// `rtw89_enter_lps`: the BE chips also tell the RF's and the channel's
+    /// state (`rtw89_fw_h2c_rf_ps_info`, `_lps_ml_cmn_info` or before
+    /// firmware 0.35.31 `_lps_ch_info`), the last acknowledged through a
+    /// BB register.
+    fn enter_lps(&mut self) {
+        if self.lps || self.dead {
+            return;
+        }
+        let Some(chan) = self.chan else { return };
+        if let Err(error) = self.lps_parm(true) {
+            ostd::info!("rtw89: power save: {}", error);
+            return;
+        }
+        if self.hal.chip.be {
+            let _ = self.h2c_send(H2C_CAT_OUTSRC, H2C_CL_OUTSRC_RF_FW_NOTIFY, H2C_FUNC_OUTSRC_RF_PS_INFO, false, false, &rtw8922a::rf_ps_info(&chan));
+            let (func, payload) = if self.features.lps_ch_info {
+                (H2C_FUNC_FW_LPS_CH_INFO, rtw8922a::lps_ch_info(&chan))
+            } else {
+                (H2C_FUNC_FW_LPS_ML_CMN_INFO, rtw8922a::lps_ml_cmn_info(&self.bb_gain, &chan, self.hal.rfe_type))
+            };
+            self.hal.phy_w32_mask(R_CHK_LPS_STAT, B_CHK_LPS_STAT, 0);
+            if self.h2c_send(H2C_CAT_OUTSRC, H2C_CL_OUTSRC_DM, func, false, false, &payload).is_ok() {
+                let hal = &self.hal;
+                if aster_linuxkpi::delay::read_poll_timeout(|| hal.phy_r32_mask(R_CHK_LPS_STAT, B_CHK_LPS_STAT), |done| *done != 0, 50, 5000).is_err() {
+                    ostd::info!("rtw89: the firmware did not take the channel for power save");
+                }
+            }
+        }
+        self.lps = true;
+    }
+
+    /// `__rtw89_leave_lps`: awake, then the MAC ID's power bits cleared
+    /// (`rtw89_fw_leave_lps_check`).
+    fn leave_lps(&mut self) {
+        if !self.lps {
+            return;
+        }
+        self.lps = false;
+        if self.dead {
+            return;
+        }
+        if let Err(error) = self.lps_parm(false) {
+            ostd::info!("rtw89: leaving power save: {}", error);
+        }
+        let status = if self.hal.chip.be { R_BE_WMTX_POWER_BE_BIT_CTL } else { R_AX_PPWRBIT_SETTING };
+        let mask = 0xe << (4 * MAC_ID);
+        let hal = &self.hal;
+        if aster_linuxkpi::delay::read_poll_timeout(|| hal.r32_mask(status, mask), |bits| *bits == 0, 1000, 50_000).is_err() {
+            ostd::info!("rtw89: the firmware did not leave power save");
+        }
+    }
+
+    fn died(&mut self) {
+        self.dead = true;
+        self.pci.disable_interrupts(&self.hal);
+        if let Some(device) = &self.device {
+            if self.scan.take().is_some() {
+                device.scan_done(true);
+            }
+            device.connection_lost();
+        }
+    }
+
+    fn handle(&mut self, packet: &[u8]) {
+        let Some(desc) = rx_desc(self.hal.chip.be, packet) else { return };
+        let Some(payload) = packet.get(desc.offset..(desc.offset + desc.pkt_size).min(packet.len())) else { return };
+        match desc.pkt_type {
+            RTW89_CORE_RX_TYPE_WIFI => {
+                if wifi::is_data(payload) {
+                    self.traffic.1 = self.traffic.1.saturating_add(1);
+                }
+                if desc.crc_err || desc.icv_err || payload.len() < wifi::HEADER {
+                    return;
+                }
+                let freq = self.chan.map_or(2412, |chan| chan.freq);
+                // Frames whose PPDU reports a signal wait for that report.
+                let reported = desc.long && desc.frame_type != 1;
+                let held = Held { ppdu_cnt: desc.ppdu_cnt, frame: payload.to_vec(), freq, decrypted: desc.hw_dec };
+                if reported {
+                    if self.held.front().is_some_and(|first| first.ppdu_cnt != desc.ppdu_cnt) {
+                        self.flush_held(None, None);
+                    }
+                    self.held.push_back(held);
+                    if self.held.len() > 32 {
+                        self.flush_held(None, None);
+                    }
+                } else {
+                    self.deliver(held, self.last_rssi);
+                }
+            }
+            RTW89_CORE_RX_TYPE_PPDU_STAT => {
+                if let Some(rssi) = ppdu_rssi(self.hal.chip.be, payload) {
+                    self.last_rssi = rssi;
+                    self.flush_held(Some(desc.ppdu_cnt), Some(rssi));
+                }
+            }
+            RTW89_CORE_RX_TYPE_C2H => {}
+            _ => {}
+        }
+    }
+
+    /// Delivers the frames held (those of PPDU `cnt` with its signal).
+    fn flush_held(&mut self, cnt: Option<u32>, rssi: Option<i8>) {
+        while let Some(first) = self.held.front() {
+            if let Some(cnt) = cnt
+                && first.ppdu_cnt != cnt
+            {
+                // An older PPDU without a report: its frames go anyway.
+            }
+            let held = self.held.pop_front().unwrap();
+            let signal = if cnt == Some(held.ppdu_cnt) { rssi.unwrap_or(self.last_rssi) } else { self.last_rssi };
+            self.deliver(held, signal);
+        }
+    }
+
+    fn deliver(&mut self, held: Held, signal: i8) {
+        let mut frame = held.frame;
+        let decrypted = held.decrypted && frame[1] & wifi::PROTECTED != 0;
+        if let Some(network) = &self.network
+            && wifi::addresses(&frame).is_some_and(|(_, transmitter, _)| transmitter == network.join.bssid)
+        {
+            self.signal = Some(signal);
+        }
+        // The FCS the MPDU processing appends, and the MIC a decrypted
+        // frame keeps (`RX_FLAG_DECRYPTED` alone).
+        frame.truncate(frame.len().saturating_sub(4));
+        if decrypted {
+            let multicast = frame[4] & 1 != 0;
+            let kind = match &self.ap {
+                // A station's frames come with its pairwise key.
+                Some(ap) => wifi::addresses(&frame).and_then(|(_, transmitter, _)| ap.stations.get(&transmitter)).and_then(|station| station.pairwise).map(|(_, _, kind, _)| kind),
+                None if multicast => self.group.map(|(_, _, kind)| kind),
+                None => self.pairwise.map(|(_, _, kind, _)| kind),
+            };
+            if kind == Some(SEC_TKIP) {
+                // TKIP: the ICV goes, the MIC is checked here.
+                frame.truncate(frame.len().saturating_sub(4));
+                let Some(key) = self.group_mic else { return };
+                if !aster_wlan::tkip::check_and_strip(&mut frame, 8, &key) {
+                    return;
+                }
+            } else {
+                let mic = if kind == Some(SEC_CCMP128) { 8 } else { 16 };
+                frame.truncate(frame.len().saturating_sub(mic));
+            }
+        }
+        if let Some(device) = &self.device {
+            device.received(&frame, RxInfo { freq: held.freq, signal, decrypted, security_header: if decrypted { 8 } else { 0 }, amsdu_more: false });
+        }
+    }
+
+    pub(crate) fn info(&self) -> Info {
+        let streams = self.hal.chip.rf_paths as usize;
+        let mut mcs = [0u8; 16];
+        for stream in 0..streams {
+            mcs[stream] = 0xff;
+        }
+        mcs[12] = 1;
+        let ht = HtCap {
+            info: wchan::HT_CAP_LDPC | wchan::HT_CAP_SUP_WIDTH_20_40 | 0x000c | wchan::HT_CAP_SGI_20 | wchan::HT_CAP_SGI_40 | 0x0100 | if streams > 1 { 0x0080 } else { 0 },
+            ampdu_factor: 3,
+            ampdu_density: 0,
+            mcs,
+        };
+        let map = (0..8).fold(0u16, |map, stream| map | (if stream < streams { 2 } else { 3 }) << (stream * 2));
+        let mut vht_mcs = [0u8; 8];
+        vht_mcs[0..2].copy_from_slice(&map.to_le_bytes());
+        vht_mcs[4..6].copy_from_slice(&map.to_le_bytes());
+        let vht = VhtCap {
+            info: wchan::VHT_CAP_RXLDPC | wchan::VHT_CAP_SGI_80 | 0x0000_0100 | wchan::VHT_CAP_SU_BEAMFORMEE | (3 << 13) | (7 << wchan::VHT_CAP_MAX_AMPDU_SHIFT) | if streams > 1 { wchan::VHT_CAP_TXSTBC } else { 0 },
+            mcs: vht_mcs,
+        };
+        let he = |id: BandId| {
+            let mut phy = [0x00u8, 0x20, 0x0a, 0x00, 0x0d, 0x00, 0x00, 0x00, 0x00, 0x80, 0x00];
+            phy[0] = if id == BandId::Ghz2 { wchan::HE_PHY_40_IN_2G } else { wchan::HE_PHY_40_80_IN_5G };
+            let bytes = map.to_le_bytes();
+            HeCap { mac: [0x01, 0x00, 0x00, 0x02, 0x40, 0x00], phy, mcs: vec![bytes[0], bytes[1], bytes[0], bytes[1]], ppe: Vec::new() }
+        };
+        // 802.11be (`rtw89_init_eht_cap`), the RTL8922A's: 7991-byte MPDUs;
+        // NDP with 4x LTF and 3.2 µs GI, SU beamformee of eight streams at
+        // 80 MHz, the feedback codebooks and triggered feedback, power
+        // boost, two columns, 20 µs of padding; MCS 0 to 13 (to 11 without
+        // 4096-QAM) on each stream at 80 MHz and below (no 160 MHz here).
+        let eht = |_: BandId| {
+            (self.hal.chip.be && !self.hal.no_eht).then(|| {
+                let set = (streams as u8 & wchan::EHT_MCS_NSS_RX) | ((streams as u8) << 4);
+                EhtCap {
+                    mac: [EHT_MAC0_MAX_MPDU_7991, 0],
+                    phy: [0x08 | 0x40 | 0x80, 0x03, 0, 0x78, 0x04 | 0x10, 0x30, 0, 0, 0],
+                    mcs: vec![set, set, if self.hal.no_mcs_12_13 { 0 } else { set }],
+                    ppe: Vec::new(),
+                }
+            })
+        };
+        let band = |id: BandId| Band { id, channels: wchan::default_channels(id), ht: Some(ht), vht: (id == BandId::Ghz5).then_some(vht), he: Some(he(id)), eht: eht(id) };
+        let mut bands = vec![band(BandId::Ghz2), band(BandId::Ghz5)];
+        // 6 GHz: HE alone.
+        if self.hal.chip.band_6 {
+            bands.push(Band { id: BandId::Ghz6, channels: wchan::default_channels(BandId::Ghz6), ht: None, vht: None, he: Some(he(BandId::Ghz6)), eht: eht(BandId::Ghz6) });
+        }
+        Info {
+            driver: String::from("rtw89"),
+            address: self.address,
+            bands,
+            ciphers: vec![radio::CIPHER_CCMP, radio::CIPHER_CCMP_256, radio::CIPHER_GCMP, radio::CIPHER_GCMP_256, radio::CIPHER_TKIP],
+            max_scan_ssids: 4,
+            max_scan_ie_len: 512,
+            ap: true,
+            management: radio::ManagementProtection::Unicast,
+        }
+    }
+
+    #[allow(dead_code)]
+    pub(crate) fn efuse(&self) -> &Efuse {
+        &self.efuse
+    }
+}
+
+/// The signal of a PPDU report (`rtw89_core_rx_process_mac_ppdu` and the
+/// PHY status's header): its average RSSI in dBm.
+fn ppdu_rssi(be: bool, data: &[u8]) -> Option<i8> {
+    if data.len() < 8 {
+        return None;
+    }
+    let (w0, w1) = (get_le32(data, 0), get_le32(data, 4));
+    // The BE chips' MAC information: its own fields, a longer RX count.
+    if be && w0 & RTW89_RXINFO_W0_INVALID_V1 != 0 {
+        return None;
+    }
+    let (users, plcp, rx_cnt) = if be {
+        (get(RTW89_RXINFO_W0_USR_NUM_V1, w0) as usize, get(RTW89_RXINFO_W0_PLCP_LEN_V1, w0) as usize * 8, RTW89_PPDU_MAC_RX_CNT_SIZE_V1 as usize)
+    } else {
+        (get(RTW89_RXINFO_W0_USR_NUM, w0) as usize, get(RTW89_RXINFO_W1_PLCP_LEN, w1) as usize * 8, RTW89_PPDU_MAC_RX_CNT_SIZE as usize)
+    };
+    let mut at = 8 + users * 4;
+    if users & 1 != 0 {
+        at += 4;
+    }
+    if w0 & RTW89_RXINFO_W0_RX_CNT_VLD != 0 {
+        at += rx_cnt;
+    }
+    at += plcp;
+    let hdr = get_le32(data, at);
+    if data.len() < at + 8 || hdr & RTW89_PHY_STS_HDR_W0_VALID == 0 {
+        return None;
+    }
+    let raw = get(RTW89_PHY_STS_HDR_W0_RSSI_AVG, hdr) as i32;
+    Some(((raw >> 1) - 110).clamp(-110, -1) as i8)
+}
