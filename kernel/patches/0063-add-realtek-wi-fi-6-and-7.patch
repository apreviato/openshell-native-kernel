+// ---- The MAC's blocks after the download. ----
+
+/// `rtw89_mac_fwdl_preconfig_be`: the firmware's calibration delay off.
+pub(crate) fn fwdl_preconfig(hal: &Hal) {
+    hal.clr32(R_BE_FW_AUTO_CAL_DELAY, B_BE_WCPU_FW_DELAY_COUNT_VALID);
+    hal.w32_mask(R_BE_FW_AUTO_CAL_DELAY, B_BE_WCPU_FW_DELAY_COUNT_MASK, 0);
+}
+
+/// `sys_init_be` on the RTL8922A (its DMAC and shared CMAC already on from
+/// power on): CMAC 0's power and functions.
+pub(crate) fn sys_init(hal: &Hal) {
+    hal.set32(R_BE_AFE_CTRL1, B_BE_R_SYM_WLCMAC0_ALL_EN);
+    hal.clr32(R_BE_FEN_RST_ENABLE, B_BE_R_SYM_ISO_CMAC02PP);
+    hal.set32(R_BE_FEN_RST_ENABLE, B_BE_CMAC0_FEN);
+    hal.set32(R_BE_CK_EN, B_BE_CK_EN_SET);
+    hal.set32(R_BE_CMAC_FUNC_EN, B_BE_CMAC_FUNC_EN_SET);
+}
+
+/// `rtw89_mac_size.ple_rsvd_qt0`'s MPDU information table and band 0's
+/// CSI pages: reserved after the PLE's linked pages.
+const RSVD_MPDU_INFO_PAGES: u32 = 2;
+const RSVD_B0_CSI_PAGES: u32 = 107;
+
+fn replace(value: u32, mask: u32, new: u32) -> u32 {
+    (value & !mask) | field(mask, new)
+}
+
+/// `trx_init_be`: the DMAC (`dmac_init_be`), CMAC 0 (`cmac_init_be`), the
+/// error interrupts, release reports to the host.
+pub(crate) fn trx_init(hal: &Hal, rx_filter: u32) -> Result<(), String> {
+    let scc = &hal.chip.scc;
+    dle_init(hal, scc, None)?;
+    // `preload_init_be` for band 0.
+    let cfg1 = replace(replace(hal.r32(R_BE_TXPKTCTL_B0_PRELD_CFG1), B_BE_B0_PRELD_NXT_TXENDWIN_MASK, PRELD_NEXT_WND), B_BE_B0_PRELD_NXT_RSVMINSZ_MASK, PRELD_NEXT_MIN_SIZE);
+    hal.w32(R_BE_TXPKTCTL_B0_PRELD_CFG1, cfg1);
+    let mut cfg0 = hal.r32(R_BE_TXPKTCTL_B0_PRELD_CFG0);
+    cfg0 = replace(cfg0, B_BE_B0_PRELD_CAM_G0ENTNUM_MASK, PRELD_B0_ACQ_ENT_NUM_8922A);
+    cfg0 = replace(cfg0, B_BE_B0_PRELD_CAM_G1ENTNUM_MASK, PRELD_MISCQ_ENT_NUM_8922A);
+    cfg0 = replace(cfg0, B_BE_B0_PRELD_USEMAXSZ_MASK, PRELD_B0_ENT_NUM * PRELD_AMSDU_SIZE);
+    hal.w32(R_BE_TXPKTCTL_B0_PRELD_CFG0, cfg0 | B_BE_B0_PRELD_FEN);
+    hfc_init(hal, false)?;
+    // `sta_sch_init_be`.
+    hal.set8(R_BE_SS_CTRL, B_BE_SS_EN);
+    if hal.poll32(R_BE_SS_CTRL, |value| value & B_BE_SS_INIT_DONE != 0, 1, TRXCFG_WAIT_CNT as u64).is_err() {
+        return Err(String::from("the station scheduler did not start"));
+    }
+    hal.set32(R_BE_SS_CTRL, B_BE_WARM_INIT);
+    hal.clr32(R_BE_SS_CTRL, B_BE_BAND_TRIG_EN | B_BE_BAND1_TRIG_EN);
+    // `mpdu_proc_init_be`.
+    hal.set32(R_BE_MPDU_PROC, B_BE_APPEND_FCS);
+    hal.w32(R_BE_CUT_AMSDU_CTRL, TRXCFG_MPDU_PROC_CUT_CTRL | B_BE_CA_CHK_ADDRCAM_EN);
+    let shcut = (hal.r32(R_BE_HDR_SHCUT_SETTING) | B_BE_TX_HW_SEQ_EN | B_BE_TX_HW_ACK_POLICY_EN | B_BE_TX_MAC_MPDU_PROC_EN) & !B_BE_TX_ADDR_MLD_TO_LIK;
+    hal.set32(R_BE_HDR_SHCUT_SETTING, shcut);
+    hal.w32(R_BE_RX_HDRTRNS, TRXCFG_MPDU_PROC_RX_HDR_CONV | B_BE_HC_ADDR_HIT_EN);
+    let mut fwd = hal.r32(R_BE_DISP_FWD_WLAN_0);
+    for mask in [B_BE_FWD_WLAN_CPU_TYPE_0_DATA_MASK, B_BE_FWD_WLAN_CPU_TYPE_0_MNG_MASK, B_BE_FWD_WLAN_CPU_TYPE_0_CTL_MASK, B_BE_FWD_WLAN_CPU_TYPE_1_MASK] {
+        fwd = replace(fwd, mask, 1);
+    }
+    hal.w32(R_BE_DISP_FWD_WLAN_0, fwd);
+    // `sec_eng_init_be`.
+    let sec = hal.r32(R_BE_SEC_ENG_CTRL) | B_BE_CLK_EN_CGCMP | B_BE_CLK_EN_WAPI | B_BE_CLK_EN_WEP_TKIP | B_BE_SEC_TX_ENC | B_BE_SEC_RX_DEC | B_BE_MC_DEC | B_BE_BC_DEC | B_BE_BMC_MGNT_DEC | B_BE_UC_MGNT_DEC | B_BE_SEC_PRE_ENQUE_TX;
+    hal.w32(R_BE_SEC_ENG_CTRL, sec);
+    hal.set32(R_BE_SEC_MPDU_PROC, B_BE_APPEND_ICV | B_BE_APPEND_MIC);
+    // `txpktctrl_init_be`: the MPDU information table's reserved pages.
+    let mut info = hal.r32(R_BE_TXPKTCTL_MPDUINFO_CFG);
+    info = replace(info, B_BE_MPDUINFO_PKTID_MASK, scc.ple.linked);
+    info = replace(info, B_BE_MPDUINFO_B1_BADDR_MASK, MPDU_INFO_B1_OFST);
+    hal.w32(R_BE_TXPKTCTL_MPDUINFO_CFG, info | B_BE_MPDUINFO_FEN);
+    // `mlo_init_be`.
+    let mlo = hal.r32(R_BE_MLO_INIT_CTL) | B_BE_MLO_TABLE_REINIT;
+    hal.w32(R_BE_MLO_INIT_CTL, mlo);
+    hal.w32(R_BE_MLO_INIT_CTL, mlo & !B_BE_MLO_TABLE_REINIT);
+    let _ = hal.poll32(R_BE_MLO_INIT_CTL, |value| value & B_BE_MLO_TABLE_INIT_DONE != 0, 1, 1000);
+    hal.set32(R_BE_SS_CTRL, B_BE_MLO_HW_CHGLINK_EN);
+    hal.set32(R_BE_CMAC_SHARE_ACQCHK_CFG_0, B_BE_R_MACID_ACQ_CHK_EN);
+    cmac_init(hal, rx_filter)?;
+    // `enable_imr_be` for the DMAC and CMAC 0, `err_imr_ctrl_be`.
+    for &(reg, clear, set) in IMR_DMAC.iter().chain(IMR_CMAC.iter()) {
+        hal.w32(reg, (hal.r32(reg) & !clear) | set);
+    }
+    hal.w32(R_BE_DMAC_ERR_IMR, DMAC_ERR_IMR_EN & !B_BE_DMAC_NOTX_ERR_INT_EN);
+    hal.w32(R_BE_CMAC_ERR_IMR, CMAC0_ERR_IMR_EN);
+    // `set_host_rpr_be` for PCIe.
+    hal.w32_mask(R_BE_WDRLS_CFG, B_BE_WDRLS_MODE_MASK, RTW89_RPR_MODE_POH);
+    hal.w32_mask(R_BE_RLSRPT0_CFG0, B_BE_RLSRPT0_QID_MASK, WDRLS_DEST_QID_POH);
+    let mut rpt = hal.r32(R_BE_RLSRPT0_CFG1);
+    rpt = replace(rpt, B_BE_RLSRPT0_FLTR_MAP_MASK, S_BE_WDRLS_FLTR_TXOK | S_BE_WDRLS_FLTR_RTYLMT | S_BE_WDRLS_FLTR_LIFTIM | S_BE_WDRLS_FLTR_MACID);
+    rpt = replace(rpt, B_BE_RLSRPT0_AGGNUM_MASK, 30);
+    rpt = replace(rpt, B_BE_RLSRPT0_TO_MASK, 255);
+    hal.w32(R_BE_RLSRPT0_CFG1, rpt);
+    hal.clr32(R_BE_RSP_CHK_SIG, B_BE_RSP_STATIC_RTS_CHK_SERV_BW_EN);
+    Ok(())
+}
+
+/// `cmac_init_be` for CMAC 0.
+fn cmac_init(hal: &Hal, rx_filter: u32) -> Result<(), String> {
+    // `scheduler_init_be`.
+    hal.set32(R_BE_MISC_1, B_BE_EN_TX_FINISH_PRD_RESP);
+    hal.w32(
+        R_BE_HE_CTN_CHK_CCA_NAV,
+        B_BE_HE_CTN_CHK_CCA_P20 | B_BE_HE_CTN_CHK_EDCCA_P20 | B_BE_HE_CTN_CHK_CCA_BITMAP | B_BE_HE_CTN_CHK_EDCCA_BITMAP | B_BE_HE_CTN_CHK_NO_GNT_WL | B_BE_HE_CTN_CHK_BASIC_NAV | B_BE_HE_CTN_CHK_INTRA_NAV | B_BE_HE_CTN_CHK_TX_NAV,
+    );
+    hal.w32(R_BE_HE_SIFS_CHK_CCA_NAV, B_BE_HE_SIFS_CHK_EDCCA_P20 | B_BE_HE_SIFS_CHK_EDCCA_BITMAP | B_BE_HE_SIFS_CHK_NO_GNT_WL);
+    hal.w32(R_BE_TB_CHK_CCA_NAV, B_BE_TB_CHK_EDCCA_BITMAP | B_BE_TB_CHK_NO_GNT_WL | B_BE_TB_CHK_BASIC_NAV);
+    hal.clr32(R_BE_CCA_CFG_0, B_BE_NO_GNT_WL_EN);
+    hal.w32_mask(R_BE_PREBKF_CFG_0, B_BE_PREBKF_TIME_MASK, SCH_PREBKF_24US);
+    hal.w32_mask(R_BE_CTN_CFG_0, B_BE_PREBKF_TIME_NONAC_MASK, SCH_PREBKF_24US);
+    hal.w32_mask(R_BE_EDCA_BCNQ_PARAM, B_BE_BCNQ_CW_MASK, 0x32);
+    hal.w32_mask(R_BE_EDCA_BCNQ_PARAM, B_BE_BCNQ_AIFS_MASK, BCN_IFS_25US);
+    // `addr_cam_init_be`.
+    let cam = replace(hal.r32(R_BE_ADDR_CAM_CTRL), B_BE_ADDR_CAM_RANGE_MASK, ADDR_CAM_SERCH_RANGE) | B_BE_ADDR_CAM_EN | B_BE_ADDR_CAM_CLR;
+    hal.w32(R_BE_ADDR_CAM_CTRL, cam);
+    if aster_linuxkpi::delay::read_poll_timeout(|| hal.r16(R_BE_ADDR_CAM_CTRL), |value| *value as u32 & B_BE_ADDR_CAM_CLR == 0, 1, TRXCFG_WAIT_CNT as u64).is_err() {
+        return Err(String::from("the address CAM did not clear"));
+    }
+    // `rx_fltr_init_be`.
+    for reg in [R_BE_MGNT_FLTR, R_BE_CTRL_FLTR, R_BE_DATA_FLTR] {
+        hal.w32(reg, RX_FLTR_FRAME_ACCEPT_BE);
+    }
+    hal.w32(R_BE_RX_FLTR_OPT, rx_filter);
+    hal.w16(R_BE_PLCP_HDR_FLTR, (B_BE_HE_SIGB_CRC_CHK | B_BE_VHT_MU_SIGB_CRC_CHK | B_BE_VHT_SU_SIGB_CRC_CHK | B_BE_SIGA_CRC_CHK | B_BE_LSIG_PARITY_CHK_EN | B_BE_CCK_SIG_CHK | B_BE_CCK_CRC_CHK) as u16);
+    // `nav_ctrl_init_be`.
+    let nav = replace((hal.r32(R_BE_WMAC_NAV_CTL) & !B_BE_WMAC_PLCP_UP_NAV_EN) | B_BE_WMAC_TF_UP_NAV_EN | B_BE_WMAC_NAV_UPPER_EN, B_BE_WMAC_NAV_UPPER_MASK, NAV_25MS);
+    hal.w32(R_BE_WMAC_NAV_CTL, nav);
+    hal.clr32(R_BE_SPECIAL_TX_SETTING, B_BE_BMC_NAV_PROTECT);
+    hal.set32(R_BE_TRXPTCL_RESP_0, B_BE_WMAC_MBA_DUR_FORCE);
+    // `spatial_reuse_init_be`, `tmac_init_be`.
+    hal.clr8(R_BE_RX_SR_CTRL, B_BE_SR_EN | B_BE_SR_CTRL_PLCP_EN);
+    hal.set8(R_BE_BSSID_SRC_CTRL, B_BE_PLCP_SRC_EN);
+    hal.clr32(R_BE_TB_PPDU_CTRL, B_BE_QOSNULL_UPD_MUEDCA_EN);
+    hal.w32_mask(R_BE_WMTX_TCR_BE_4, B_BE_EHT_HE_PPDU_4XLTF_ZLD_USTIMER_MASK, 0x12);
+    hal.w32_mask(R_BE_WMTX_TCR_BE_4, B_BE_EHT_HE_PPDU_2XLTF_ZLD_USTIMER_MASK, 0xe);
+    // `trxptcl_init_be`.
+    let lbk = replace(hal.r32(R_BE_MAC_LOOPBACK), B_BE_MACLBK_PLCP_DLY_MASK, S_BE_MACLBK_PLCP_DLY_DEF) & !B_BE_MACLBK_EN;
+    hal.w32(R_BE_MAC_LOOPBACK, lbk);
+    hal.set32(R_BE_CMAC_FUNC_EN, B_BE_PHYINTF_EN);
+    let resp = replace(replace(hal.r32(R_BE_TRXPTCL_RESP_0), B_BE_WMAC_SPEC_SIFS_CCK_MASK, WMAC_SPEC_SIFS_CCK), B_BE_WMAC_SPEC_SIFS_OFDM_MASK, WMAC_SPEC_SIFS_OFDM_1115E);
+    hal.w32(R_BE_TRXPTCL_RESP_0, resp);
+    hal.clr32(R_BE_WMAC_ACK_BA_RESP_LEGACY, B_BE_ACK_BA_RESP_LEGACY_CHK_EDCCA);
+    hal.clr32(R_BE_WMAC_ACK_BA_RESP_HE, B_BE_ACK_BA_RESP_HE_CHK_EDCCA);
+    hal.clr32(R_BE_WMAC_ACK_BA_RESP_EHT_LEG_PUNC, B_BE_ACK_BA_EHT_LEG_PUNC_CHK_EDCCA);
+    hal.set32(R_BE_RXTRIG_TEST_USER_2, B_BE_RXTRIG_FCSCHK_EN);
+    let resp1 = hal.r32(R_BE_TRXPTCL_RESP_1) & (B_BE_FTM_RRSR_RATE_EN_MASK | B_BE_WMAC_RESP_DOPPLEB_BE_EN | B_BE_WMAC_RESP_DCM_EN | B_BE_WMAC_RESP_REF_RATE_MASK);
+    hal.w32(R_BE_TRXPTCL_RESP_1, resp1);
+    hal.w32_mask(R_BE_TRXPTCL_RESP_1, B_BE_WMAC_RESP_REF_RATE_SEL, 0);
+    hal.w32(R_BE_PTCL_RRSR1, hal.r32(R_BE_PTCL_RRSR1) & (B_BE_RRSR_RATE_EN_MASK | B_BE_RRSR_CCK_MASK | B_BE_RSC_MASK));
+    hal.w32(R_BE_PTCL_RRSR0, hal.r32(R_BE_PTCL_RRSR0) & (B_BE_RRSR_OFDM_MASK | B_BE_RRSR_HT_MASK | B_BE_RRSR_VHT_MASK | B_BE_RRSR_HE_MASK));
+    if hal.cv == CHIP_CAV as u8 {
+        hal.w32_mask(R_BE_PTCL_RRSR1, B_BE_RSC_MASK, 1);
+    }
+    // `rmac_init_be`: the BA CAM reset, the deadlock guard, the largest
+    // MPDU (band 0's RX quota in pages).
+    hal.w32_mask(R_BE_RESPBA_CAM_CTRL, B_BE_BACAM_RST_MASK, S_BE_BACAM_RST_ALL);
+    let _ = aster_linuxkpi::delay::read_poll_timeout(|| hal.r32_mask(R_BE_RESPBA_CAM_CTRL, B_BE_BACAM_RST_MASK), |value| *value == S_BE_BACAM_RST_DONE, 1, 1000);
+    let mut dlk = hal.r16(R_BE_DLK_PROTECT_CTL) as u32;
+    dlk = replace(replace(dlk, B_BE_RX_DLK_DATA_TIME_MASK, TRXCFG_RMAC_DATA_TO), B_BE_RX_DLK_CCA_TIME_MASK, TRXCFG_RMAC_CCA_TO) | B_BE_RX_DLK_RST_EN;
+    hal.w16(R_BE_DLK_PROTECT_CTL, dlk as u16);
+    let scc = &hal.chip.scc;
+    let max_len = ((scc.ple_min.0[6] as u32).min(127) * scc.ple.page).min(11454 + 512) / 512;
+    hal.w32_mask(R_BE_RX_FLTR_OPT, B_BE_RX_MPDU_MAX_LEN_MASK, max_len);
+    hal.clr8(R_BE_PLCP_HDR_FLTR, B_BE_VHT_SU_SIGB_CRC_CHK);
+    hal.set16(R_BE_RCR, B_BE_BUSY_CHKSN);
+    hal.set16(R_BE_RX_PLCP_EXT_OPTION_1, B_BE_PLCP_SU_PSDU_LEN_SRC);
+    // `resp_pktctl_init_be`: band 0's CSI pages.
+    let csi_start = scc.ple.linked + RSVD_MPDU_INFO_PAGES;
+    hal.w32_mask(R_BE_RESP_CSI_RESERVED_PAGE, B_BE_CSI_RESERVED_START_PAGE_MASK, csi_start);
+    hal.w32_mask(R_BE_RESP_CSI_RESERVED_PAGE, B_BE_CSI_RESERVED_PAGE_NUM_MASK, RSVD_B0_CSI_PAGES + 1);
+    // `cmac_com_init_be`.
+    let mut sb = hal.r32(R_BE_TX_SUB_BAND_VALUE);
+    sb = replace(sb, B_BE_TXSB_20M_MASK, S_BE_TXSB_20M_8);
+    sb = replace(sb, B_BE_TXSB_40M_MASK, S_BE_TXSB_40M_4);
+    sb = replace(sb, B_BE_TXSB_80M_MASK, S_BE_TXSB_80M_2);
+    sb = replace(sb, B_BE_TXSB_160M_MASK, S_BE_TXSB_160M_1);
+    hal.w32(R_BE_TX_SUB_BAND_VALUE, sb);
+    // `ptcl_init_be`.
+    let sifs = replace(replace(hal.r32(R_BE_SIFS_SETTING), B_BE_HW_CTS2SELF_PKT_LEN_TH_MASK, S_AX_CTS2S_TH_1K), B_BE_HW_CTS2SELF_PKT_LEN_TH_TWW_MASK, S_AX_CTS2S_TH_SEC_256B);
+    hal.w32(R_BE_SIFS_SETTING, sifs | B_BE_HW_CTS2SELF_EN);
+    let fsm = replace(hal.r32(R_BE_PTCL_FSM_MON), B_BE_PTCL_TX_ARB_TO_THR_MASK, S_AX_PTCL_TO_2MS) & !B_BE_PTCL_TX_ARB_TO_MODE;
+    hal.w32(R_BE_PTCL_FSM_MON, fsm);
+    let common = (hal.r8(R_BE_PTCL_COMMON_SETTING_0) as u32 | B_BE_CMAC_TX_MODE_0 | B_BE_CMAC_TX_MODE_1) & !(B_BE_PTCL_TRIGGER_SS_EN_0 | B_BE_PTCL_TRIGGER_SS_EN_1 | B_BE_PTCL_TRIGGER_SS_EN_UL);
+    hal.w8(R_BE_PTCL_COMMON_SETTING_0, common as u8);
+    hal.w32_mask(R_BE_AMPDU_AGG_LIMIT, B_BE_AMPDU_MAX_TIME_MASK, AMPDU_MAX_TIME);
+    hal.set32(
+        R_BE_AGG_BK_0,
+        B_BE_PRELD_MGQ0_EN
+            | B_BE_PRELD_HIQ_P4_EN
+            | B_BE_PRELD_HIQ_P3_EN
+            | B_BE_PRELD_HIQ_P2_EN
+            | B_BE_PRELD_HIQ_P1_EN
+            | B_BE_PRELD_HIQ_P0MB15_EN
+            | B_BE_PRELD_HIQ_P0MB14_EN
+            | B_BE_PRELD_HIQ_P0MB13_EN
+            | B_BE_PRELD_HIQ_P0MB12_EN
+            | B_BE_PRELD_HIQ_P0MB11_EN
+            | B_BE_PRELD_HIQ_P0MB10_EN
+            | B_BE_PRELD_HIQ_P0MB9_EN
+            | B_BE_PRELD_HIQ_P0MB8_EN
+            | B_BE_PRELD_HIQ_P0MB7_EN
+            | B_BE_PRELD_HIQ_P0MB6_EN
+            | B_BE_PRELD_HIQ_P0MB5_EN
+            | B_BE_PRELD_HIQ_P0MB4_EN
+            | B_BE_PRELD_HIQ_P0MB3_EN
+            | B_BE_PRELD_HIQ_P0MB2_EN
+            | B_BE_PRELD_HIQ_P0MB1_EN
+            | B_BE_PRELD_HIQ_P0_EN,
+    );
+    // `cmac_dma_init_be`.
+    let rx = replace(replace(hal.r32(R_BE_RX_CTRL_1), B_BE_RXDMA_TXRPT_QUEUE_ID_SW_MASK, WLCPU_RXCH2_QID), B_BE_RXDMA_F2PCMDRPT_QUEUE_ID_SW_MASK, WLCPU_RXCH2_QID);
+    hal.w32(R_BE_RX_CTRL_1, rx);
+    Ok(())
+}
+
+/// `rtw8922a_imr_dmac_regs`, `rtw8922a_imr_cmac_regs`: register, bits
+/// cleared, bits set.
+const IMR_DMAC: &[(u32, u32, u32)] = &[
+    (R_BE_DISP_HOST_IMR, B_BE_DISP_HOST_IMR_CLR, B_BE_DISP_HOST_IMR_SET),
+    (R_BE_DISP_CPU_IMR, B_BE_DISP_CPU_IMR_CLR, B_BE_DISP_CPU_IMR_SET),
+    (R_BE_DISP_OTHER_IMR, B_BE_DISP_OTHER_IMR_CLR, B_BE_DISP_OTHER_IMR_SET),
+    (R_BE_PKTIN_ERR_IMR, B_BE_PKTIN_ERR_IMR_CLR, B_BE_PKTIN_ERR_IMR_SET),
+    (R_BE_INTERRUPT_MASK_REG, B_BE_INTERRUPT_MASK_REG_CLR, B_BE_INTERRUPT_MASK_REG_SET),
+    (R_BE_MLO_ERR_IDCT_IMR, B_BE_MLO_ERR_IDCT_IMR_CLR, B_BE_MLO_ERR_IDCT_IMR_SET),
+    (R_BE_MPDU_TX_ERR_IMR, B_BE_MPDU_TX_ERR_IMR_CLR, B_BE_MPDU_TX_ERR_IMR_SET),
+    (R_BE_MPDU_RX_ERR_IMR, B_BE_MPDU_RX_ERR_IMR_CLR, B_BE_MPDU_RX_ERR_IMR_SET),
+    (R_BE_SEC_ERROR_IMR, B_BE_SEC_ERROR_IMR_CLR, B_BE_SEC_ERROR_IMR_SET),
+    (R_BE_CPUIO_ERR_IMR, B_BE_CPUIO_ERR_IMR_CLR, B_BE_CPUIO_ERR_IMR_SET),
+    (R_BE_WDE_ERR_IMR, B_BE_WDE_ERR_IMR_CLR, B_BE_WDE_ERR_IMR_SET),
+    (R_BE_WDE_ERR1_IMR, B_BE_WDE_ERR1_IMR_CLR, B_BE_WDE_ERR1_IMR_SET),
+    (R_BE_PLE_ERR_IMR, B_BE_PLE_ERR_IMR_CLR, B_BE_PLE_ERR_IMR_SET),
+    (R_BE_PLE_ERRFLAG1_IMR, B_BE_PLE_ERRFLAG1_IMR_CLR, B_BE_PLE_ERRFLAG1_IMR_SET),
+    (R_BE_WDRLS_ERR_IMR, B_BE_WDRLS_ERR_IMR_CLR, B_BE_WDRLS_ERR_IMR_SET),
+    (R_BE_TXPKTCTL_B0_ERRFLAG_IMR, B_BE_TXPKTCTL_B0_ERRFLAG_IMR_CLR, B_BE_TXPKTCTL_B0_ERRFLAG_IMR_SET),
+    (R_BE_TXPKTCTL_B1_ERRFLAG_IMR, B_BE_TXPKTCTL_B1_ERRFLAG_IMR_CLR, B_BE_TXPKTCTL_B1_ERRFLAG_IMR_SET),
+    (R_BE_BBRPT_COM_ERR_IMR, B_BE_BBRPT_COM_ERR_IMR_CLR, B_BE_BBRPT_COM_ERR_IMR_SET),
+    (R_BE_BBRPT_CHINFO_ERR_IMR, B_BE_BBRPT_CHINFO_ERR_IMR_CLR, B_BE_BBRPT_CHINFO_ERR_IMR_SET),
+    (R_BE_BBRPT_DFS_ERR_IMR, B_BE_BBRPT_DFS_ERR_IMR_CLR, B_BE_BBRPT_DFS_ERR_IMR_SET),
+    (R_BE_LA_ERRFLAG_IMR, B_BE_LA_ERRFLAG_IMR_CLR, B_BE_LA_ERRFLAG_IMR_SET),
+    (R_BE_CH_INFO_DBGFLAG_IMR, B_BE_CH_INFO_DBGFLAG_IMR_CLR, B_BE_CH_INFO_DBGFLAG_IMR_SET),
+    (R_BE_PLRLS_ERR_IMR, B_BE_PLRLS_ERR_IMR_CLR, B_BE_PLRLS_ERR_IMR_SET),
+    (R_BE_HAXI_IDCT_MSK, B_BE_HAXI_IDCT_MSK_CLR, B_BE_HAXI_IDCT_MSK_SET),
+];
+const IMR_CMAC: &[(u32, u32, u32)] = &[
+    (R_BE_RESP_IMR, B_BE_RESP_IMR_CLR, B_BE_RESP_IMR_SET),
+    (R_BE_RX_ERROR_FLAG_IMR, B_BE_RX_ERROR_FLAG_IMR_CLR, B_BE_RX_ERROR_FLAG_IMR_SET),
+    (R_BE_TX_ERROR_FLAG_IMR, B_BE_TX_ERROR_FLAG_IMR_CLR, B_BE_TX_ERROR_FLAG_IMR_SET),
+    (R_BE_RX_ERROR_FLAG_IMR_1, B_BE_TX_ERROR_FLAG_IMR_1_CLR, B_BE_TX_ERROR_FLAG_IMR_1_SET),
+    (R_BE_PTCL_IMR1, B_BE_PTCL_IMR1_CLR, B_BE_PTCL_IMR1_SET),
+    (R_BE_PTCL_IMR0, B_BE_PTCL_IMR0_CLR, B_BE_PTCL_IMR0_SET),
+    (R_BE_PTCL_IMR_2, B_BE_PTCL_IMR_2_CLR, B_BE_PTCL_IMR_2_SET),
+    (R_BE_SCHEDULE_ERR_IMR, B_BE_SCHEDULE_ERR_IMR_CLR, B_BE_SCHEDULE_ERR_IMR_SET),
+    (R_BE_C0_TXPWR_IMR, B_BE_C0_TXPWR_IMR_CLR, B_BE_C0_TXPWR_IMR_SET),
+    (R_BE_TRXPTCL_ERROR_INDICA_MASK, B_BE_TRXPTCL_ERROR_INDICA_MASK_CLR, B_BE_TRXPTCL_ERROR_INDICA_MASK_SET),
+    (R_BE_RX_ERR_IMR, B_BE_RX_ERR_IMR_CLR, B_BE_RX_ERR_IMR_SET),
+    (R_BE_PHYINFO_ERR_IMR_V1, B_BE_PHYINFO_ERR_IMR_V1_CLR, B_BE_PHYINFO_ERR_IMR_V1_SET),
+];
+
+/// `rtw89_mac_stop_sch_tx_v2` (no `resume`) and `_resume_sch_tx_v2` on
+/// MAC 0; the scheduler's TX before.
+pub(crate) fn sch_tx(hal: &Hal, resume: Option<u32>) -> u32 {
+    let before = hal.r32(R_BE_CTN_DRV_TXEN);
+    let value = match resume {
+        Some(tx_en) => (before & !B_BE_CTN_TXEN_ALL_MASK) | (tx_en & B_BE_CTN_TXEN_ALL_MASK),
+        None => before & !B_BE_CTN_TXEN_ALL_MASK,
+    };
+    hal.w32(R_BE_CTN_DRV_TXEN, value);
+    before
+}
+
+/// `rtw89_mac_cfg_ppdu_status_be`.
+pub(crate) fn ppdu_status(hal: &Hal, enable: bool) {
+    if !enable {
+        hal.clr32(R_BE_PPDU_STAT, B_BE_PPDU_STAT_RPT_EN);
+        return;
+    }
+    hal.w32_mask(R_BE_HW_PPDU_STATUS, B_BE_FWD_PPDU_STAT_MASK, 3);
+    hal.w32(R_BE_PPDU_STAT, B_BE_PPDU_STAT_RPT_EN | B_BE_APP_RX_CNT_RPT | B_BE_APP_PLCP_HDR_RPT | B_BE_PPDU_STAT_RPT_CRC32 | B_BE_PPDU_STAT_RPT_DMA);
+}
+
+/// The RX filter's options, the largest MPDU kept (as `set_rx_filter`).
+pub(crate) fn set_rx_filter(hal: &Hal, value: u32) {
+    hal.w32(R_BE_RX_FLTR_OPT, (hal.r32(R_BE_RX_FLTR_OPT) & B_BE_RX_MPDU_MAX_LEN_MASK) | (value & !B_BE_RX_MPDU_MAX_LEN_MASK));
+}
diff --git a/kernel/comps/rtw89/src/chan.rs b/kernel/comps/rtw89/src/chan.rs
new file mode 100644
index 0000000..6c2612e
--- /dev/null
+++ b/kernel/comps/rtw89/src/chan.rs
@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! A channel as the chip's code wants it (Linux's `struct rtw89_chan`):
+//! the band, the center and primary channels' numbers, the width, the
+//! primary 20 MHz channel's place in it.
+
+use aster_wlan::{
+    chan as wchan,
+    ieee80211 as wifi,
+    radio::{BandId, Chandef, Width},
+};
+
+use crate::regs::*;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Chan {
+    /// `enum rtw89_band`: 0 (2.4 GHz), 1 (5 GHz), 2 (6 GHz).
+    pub(crate) band: u8,
+    /// The center channel's number (`chan->channel`).
+    pub(crate) channel: u8,
+    pub(crate) primary: u8,
+    /// `enum rtw89_bandwidth`: 0, 1, 2, 3 for 20, 40, 80, 160 MHz.
+    pub(crate) bw: u8,
+    /// `enum rtw89_sc_offset`.
+    pub(crate) pri_ch_idx: u8,
+    pub(crate) freq: u16,
+}
+
+impl Chan {
+    pub(crate) fn new(chandef: &Chandef) -> Self {
+        let band = match BandId::of(chandef.control) {
+            BandId::Ghz2 => 0,
+            BandId::Ghz5 => 1,
+            BandId::Ghz6 => 2,
+        };
+        let bw = match chandef.width {
+            Width::NoHt20 | Width::W20 => 0,
+            Width::W40 => 1,
+            Width::W80 => 2,
+            // No rtw89 chip runs 320 MHz (none offers it).
+            Width::W160 | Width::W320 => 3,
+        };
+        let primary = wifi::channel_of(chandef.control).unwrap_or(1);
+        let center_freq = if bw == 0 { chandef.control } else { chandef.center };
+        let channel = wifi::channel_of(center_freq).unwrap_or(primary);
+        let (center, control) = (center_freq as u32, chandef.control as u32);
+        let pri_ch_idx = match bw {
+            0 => RTW89_SC_DONT_CARE,
+            1 => {
+                if control > center {
+                    RTW89_SC_20_UPPER
+                } else {
+                    RTW89_SC_20_LOWER
+                }
+            }
+            _ => {
+                if control > center {
+                    RTW89_SC_20_UPPER + ((control - center - 10) / 20) * 2
+                } else {
+                    RTW89_SC_20_LOWER + ((center - control - 10) / 20) * 2
+                }
+            }
+        } as u8;
+        Self { band, channel, primary, bw, pri_ch_idx, freq: chandef.control }
+    }
+
+    /// `rtw89_phy_get_txsc`: the sub-channel a narrower PPDU (`dbw`) goes
+    /// on within this one.
+    pub(crate) fn txsc(&self, dbw: u8) -> u32 {
+        let (pri, center) = (self.primary as u32, self.channel as u32);
+        if self.bw == dbw || self.bw == 0 {
+            return 0;
+        }
+        match self.bw {
+            1 => {
+                if pri > center { 1 } else { 2 }
+            }
+            2 => {
+                if dbw == 0 {
+                    if pri > center { (pri - center) >> 1 } else { ((center - pri) >> 1) + 1 }
+                } else if pri > center {
+                    9
+                } else {
+                    10
+                }
+            }
+            3 => {
+                let at = if pri > center { (pri - center) >> 1 } else { ((center - pri) >> 1) + 1 };
+                match dbw {
+                    0 => at,
+                    1 => match at {
+                        1 | 3 => 9,
+                        5 | 7 => 11,
+                        2 | 4 => 10,
+                        6 | 8 => 12,
+                        _ => 0xff,
+                    },
+                    _ => {
+                        if pri > center {
+                            13
+                        } else {
+                            14
+                        }
+                    }
+                }
+            }
+            _ => 0,
+        }
+    }
+
+    /// `rtw89_encode_chan_idx`: the channel as the baseband numbers it.
+    /// The band as the common code names it.
+    pub(crate) fn band_id(&self) -> BandId {
+        match self.band {
+            0 => BandId::Ghz2,
+            1 => BandId::Ghz5,
+            _ => BandId::Ghz6,
+        }
+    }
+
+    /// The whole channel's center frequency (`chan->freq`).
+    pub(crate) fn center_freq(&self) -> u32 {
+        wchan::freq_of(self.band_id(), self.channel) as u32
+    }
+
+    pub(crate) fn encoded_index(&self) -> u8 {
+        const BASE: [u8; 16] = [1, 0xff, 36, 100, 132, 149, 0xff, 1, 33, 65, 97, 129, 161, 193, 225, 0xff];
+        let channel = self.primary;
+        let (first, last) = match self.band {
+            0 => return channel & 0x0f,
+            1 => (2usize, 5usize),
+            _ => (7, 14),
+        };
+        let Some(index) = (first..=last).rev().find(|&index| channel >= BASE[index]) else { return 0 };
+        ((index as u8) << 4) | (((channel - BASE[index]) >> 1) & 0x0f)
+    }
+}
diff --git a/kernel/comps/rtw89/src/coex.rs b/kernel/comps/rtw89/src/coex.rs
new file mode 100644
index 0000000..f0fcd01
--- /dev/null
+++ b/kernel/comps/rtw89/src/coex.rs
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The antenna shared with Bluetooth, as Linux's rtw89 `mac.c` sets the
+//! packet traffic arbitration up (`rtw89_mac_coex_init` and `_v1`): the
+//! PTA in Realtek's mode, both radios' grants left to it (Linux's
+//! coexistence then tunes the time each gets; here the hardware's own
+//! arbitration decides), the WLAN's control of the antenna path.
+
+use crate::{
+    hal::{ChipId, Hal, field},
+    regs::*,
+};
+
+fn lte_ready(hal: &Hal) {
+    let _ = hal.poll8(R_AX_LTE_CTRL + 3, |value| value & (1 << 5) != 0, 50, 50_000);
+}
+
+/// `rtw89_mac_read_lte` and `rtw89_mac_write_lte`.
+fn read_lte(hal: &Hal, offset: u32) -> u32 {
+    lte_ready(hal);
+    hal.w32(R_AX_LTE_CTRL, 0x800f_0000 | offset);
+    hal.r32(R_AX_LTE_RDATA)
+}
+
+fn write_lte(hal: &Hal, offset: u32, value: u32) {
+    lte_ready(hal);
+    hal.w32(R_AX_LTE_WDATA, value);
+    hal.w32(R_AX_LTE_CTRL, 0xc00f_0000 | offset);
+}
+
+/// `rtw89_mac_coex_init` (Realtek's mode, the PTA inside), or `_v1` on
+/// the RTL8852C.
+pub(crate) fn init(hal: &Hal) {
+    let id = hal.id();
+    if id == ChipId::Rtl8852c {
+        hal.set32(R_AX_BTC_CFG, B_AX_BTC_EN | B_AX_BTG_LNA1_GAIN_SEL);
+        hal.set32(R_AX_BT_CNT_CFG, B_AX_BT_CNT_EN);
+        hal.set16(R_AX_CCA_CFG_0, B_AX_BTCCA_EN);
+        hal.clr16(R_AX_CCA_CFG_0, B_AX_BTCCA_BRK_TXOP_EN);
+        hal.w32_mask(R_AX_BTC_CFG, B_AX_BTC_MODE_MASK, MAC_AX_RTK_MODE);
+        hal.w32_mask(R_AX_RTK_MODE_CFG_V1, B_AX_SAMPLE_CLK_MASK, MAC_AX_RTK_RATE);
+        return;
+    }
+    hal.set8(R_AX_GPIO_MUXCFG, B_AX_ENBT);
+    if !matches!(id, ChipId::Rtl8851b | ChipId::Rtl8852bt) {
+        hal.set8(R_AX_BTC_FUNC_EN, B_AX_PTA_WL_TX_EN);
+    }
+    hal.set8(R_AX_BT_COEX_CFG_2 + 1, B_AX_GNT_BT_POLARITY >> 8);
+    hal.set8(R_AX_CSR_MODE, B_AX_STATIS_BT_EN | B_AX_WL_ACT_MSK);
+    hal.set8(R_AX_CSR_MODE + 2, B_AX_BT_CNT_RST >> 16);
+    if !matches!(id, ChipId::Rtl8851b | ChipId::Rtl8852bt) {
+        hal.clr8(R_AX_TRXPTCL_RESP_0 + 3, B_AX_RSP_CHK_BTCCA >> 24);
+    }
+    let cca = (hal.r16(R_AX_CCA_CFG_0) as u32 | B_AX_BTCCA_EN) & !B_AX_BTCCA_BRK_TXOP_EN;
+    hal.w16(R_AX_CCA_CFG_0, cca as u16);
+    let value = read_lte(hal, R_AX_LTE_SW_CFG_2) & B_AX_WL_RX_CTRL;
+    write_lte(hal, R_AX_LTE_SW_CFG_2, value);
+    let mux = (hal.r8(R_AX_GPIO_MUXCFG) as u32 & !B_AX_BTMODE_MASK) | field(B_AX_BTMODE_MASK, MAC_AX_BT_MODE_0_3);
+    hal.w8(R_AX_GPIO_MUXCFG, mux as u8);
+    hal.w8(R_AX_TDMA_MODE, hal.r8(R_AX_TDMA_MODE) | B_AX_RTK_BT_ENABLE as u8);
+    let rate = (hal.r8(R_AX_BT_COEX_CFG_5) as u32 & !B_AX_BT_RPT_SAMPLE_RATE_MASK) | field(B_AX_BT_RPT_SAMPLE_RATE_MASK, MAC_AX_RTK_RATE);
+    hal.w8(R_AX_BT_COEX_CFG_5, rate as u8);
+    let dir = (hal.r8(R_AX_GPIO_MUXCFG + 1) & !(1 << 2)) | (1 << 1);
+    hal.w8(R_AX_GPIO_MUXCFG + 1, dir);
+}
+
+/// The WLAN controls the antenna path (`cfg_ctrl_path`), both radios'
+/// grants to the hardware's arbitration (no software override).
+pub(crate) fn wlan_owns(hal: &Hal) {
+    if hal.id() == ChipId::Rtl8852c {
+        hal.w32(R_AX_GNT_SW_CTRL, 0);
+        return;
+    }
+    let value = hal.r8(R_AX_SYS_SDIO_CTRL + 3) | (1 << 2);
+    hal.w8(R_AX_SYS_SDIO_CTRL + 3, value);
+    write_lte(hal, R_AX_LTE_SW_CFG_1, 0);
+}
diff --git a/kernel/comps/rtw89/src/fw.rs b/kernel/comps/rtw89/src/fw.rs
new file mode 100644
index 0000000..fba93bc
--- /dev/null
+++ b/kernel/comps/rtw89/src/fw.rs
@@ -0,0 +1,696 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The firmware as Linux's rtw89 `fw.c` reads and downloads it: the file
+//! (`rtw89/rtw8852b_fw-2.bin`, older formats after it) holds several
+//! firmwares behind a "MFW" header, the one for the chip's cut chosen;
+//! after them, elements with the PHY's tables (baseband, gains, radios,
+//! NCTL) and the TX power's. The firmware goes to the chip's CPU through
+//! the H2C ring: its header, then each section in 2020-byte pieces, the
+//! secure-boot signature of the chip's key where it has one.
+//!
+//! H2C commands are an 8-byte header (`struct fwcmd_hdr`: type, category,
+//! class, function, sequence; length, acknowledgements) and their payload.
+
+use alloc::{format, string::String, sync::Arc, vec, vec::Vec};
+
+use aster_linuxkpi::bits::{get_le16, get_le32};
+
+use crate::{
+    hal::{ChipId, Hal, field, get},
+    pci::Pci,
+    regs::*,
+};
+
+const MFW_SIG: u8 = 0xff;
+const ELEMENT_ALIGN: usize = 16;
+/// `struct rtw89_fw_element_hdr`: 24 bytes, then its union's 8.
+const ELEMENT_HDR: usize = 32;
+const PART_SIZE: usize = 2020;
+const SECTION_CHKSUM_LEN: usize = 8;
+const SECURITY_SECTION: u32 = 9;
+const SECURITY_SIGLEN: usize = 512;
+const SECURITY_CHKSUM_LEN: usize = 8;
+const FORMATTED_MSSC: u32 = 0xff;
+const MSS_SIGNATURE: [u8; 8] = *b"MSSKPOOL";
+const MSS_POOL_DEFKEYSETS_SIZE: usize = 8;
+const MSS_DEV_TYPE_DEF: u8 = 0x0f;
+/// `RTW89_FWDL_WCPU_FW_INIT_RDY` and the failures before it.
+const FWDL_INIT_RDY: u8 = 7;
+const FWDL_CHECKSUM_FAIL: u8 = 2;
+const FWDL_SECURITY_FAIL: u8 = 3;
+const FWDL_CV_NOT_MATCH: u8 = 4;
+pub(crate) const H2C_HEADER: usize = 8;
+
+/// The firmware's types in the MFW header (`enum rtw89_fw_type`).
+const FW_NORMAL: u8 = 1;
+const FW_NORMAL_CE: u8 = 5;
+
+/// A PHY table from an element: address and value pairs.
+pub(crate) type Table = Vec<(u32, u32)>;
+
+/// A TX power table from an element (`struct __rtw89_fw_txpwr_element`):
+/// its entries, each `entry_size` bytes.
+#[derive(Clone, Default)]
+pub(crate) struct PowerTable {
+    pub(crate) rfe_type: u8,
+    pub(crate) entry_size: usize,
+    pub(crate) data: Vec<u8>,
+}
+
+impl PowerTable {
+    pub(crate) fn entries(&self) -> impl Iterator<Item = &[u8]> {
+        self.data.chunks_exact(self.entry_size.max(1))
+    }
+}
+
+/// The secure-boot key the chip's eFuse names (`struct rtw89_fw_secure`).
+#[derive(Clone, Copy, Default)]
+pub(crate) struct Secure {
+    pub(crate) secure_boot: bool,
+    pub(crate) mss_idx: u8,
+    pub(crate) can_v1: bool,
+    pub(crate) dev_type: u8,
+    pub(crate) cust_idx: u8,
+    pub(crate) key_num: u8,
+    /// The BE chips' secure-boot selection (`sb_sel_mgn`): a signature
+    /// section for another one is not ours.
+    pub(crate) sb_sel_mgn: u32,
+}
+
+/// The TX power's thermal tracking (`RTW89_FW_ELEMENT_ID_TXPWR_TRK`,
+/// `struct rtw89_fw_txpwr_track_cfg`): for each kind (`enum
+/// rtw89_fw_txpwr_trk_type`: band, path, up or down), its subbands' rows of
+/// `DELTA_SWINGIDX_SIZE` steps.
+pub(crate) struct TxPowerTrack {
+    rows: Vec<i8>,
+    first: [Option<usize>; RTW89_FW_TXPWR_TRK_TYPE_NR as usize],
+}
+
+impl TxPowerTrack {
+    /// `rtw89_build_txpwr_trk_tbl_from_elm`: the bitmap names the kinds
+    /// present, in order, 6 GHz's with four subbands, 5 GHz's three, 2.4
+    /// GHz's one.
+    fn parse(body: &[u8]) -> Option<Self> {
+        let bitmap = get_le32(body.get(..4)?, 0);
+        let contents = body.get(8..)?;
+        let mut first = [None; RTW89_FW_TXPWR_TRK_TYPE_NR as usize];
+        let mut row = 0usize;
+        for (kind, slot) in first.iter_mut().enumerate() {
+            if bitmap & (1 << kind) == 0 {
+                continue;
+            }
+            let kind = kind as u32;
+            let subbands = if kind <= RTW89_FW_TXPWR_TRK_TYPE_6GA_P {
+                4
+            } else if kind <= RTW89_FW_TXPWR_TRK_TYPE_5GA_P {
+                3
+            } else {
+                1
+            };
+            *slot = Some(row);
+            row += subbands;
+        }
+        let size = DELTA_SWINGIDX_SIZE as usize;
+        let rows = contents.get(..row * size)?.iter().map(|&byte| byte as i8).collect();
+        Some(Self { rows, first })
+    }
+
+    /// The steps of a kind's subband, if the file has them.
+    pub(crate) fn delta(&self, kind: u32, subband: usize) -> Option<&[i8]> {
+        let size = DELTA_SWINGIDX_SIZE as usize;
+        let row = self.first.get(kind as usize).copied().flatten()? + subband;
+        self.rows.get(row * size..(row + 1) * size)
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct Elements {
+    pub(crate) bb: Option<Table>,
+    pub(crate) bb_gain: Option<Table>,
+    pub(crate) radio: [Option<Table>; 2],
+    pub(crate) nctl: Option<Table>,
+    pub(crate) byrate: Option<PowerTable>,
+    pub(crate) limit_2g: Option<PowerTable>,
+    pub(crate) limit_5g: Option<PowerTable>,
+    pub(crate) limit_6g: Option<PowerTable>,
+    pub(crate) limit_ru_2g: Option<PowerTable>,
+    pub(crate) limit_ru_5g: Option<PowerTable>,
+    pub(crate) limit_ru_6g: Option<PowerTable>,
+    pub(crate) txpwr_trk: Option<TxPowerTrack>,
+}
+
+pub(crate) struct Firmware {
+    pub(crate) name: String,
+    file: Arc<[u8]>,
+    /// The normal firmware in the file.
+    start: usize,
+    len: usize,
+    /// The BE chips' baseband MCU's firmware in the file.
+    bbmcu: Option<(usize, usize)>,
+    pub(crate) version: (u8, u8, u8, u8),
+    pub(crate) elements: Elements,
+}
+
+/// A section to download (`struct rtw89_fw_hdr_section_info`).
+struct Section {
+    start: usize,
+    len: usize,
+    /// Where the chip's signature goes over the last bytes of the section.
+    key: Option<(usize, usize)>,
+    ignore: bool,
+}
+
+impl Firmware {
+    /// `rtw89_load_firmware_req` and `rtw89_fw_recognize`: the newest file
+    /// there is, the firmware of the chip's cut in it.
+    pub(crate) fn load(hal: &Hal) -> Result<Self, String> {
+        let chip = hal.chip;
+        let names: Vec<String> = (0..=chip.fw_format_max)
+            .rev()
+            .map(|format| if format == 0 { format!("{}.bin", chip.fw_basename) } else { format!("{}-{}.bin", chip.fw_basename, format) })
+            .collect();
+        let (name, file) = aster_linuxkpi::firmware::request_firmware_first(names.iter().map(String::as_str)).ok_or_else(|| format!("{}.bin (or a newer format) is not in /lib/firmware", chip.fw_basename))?;
+        let name = String::from(name);
+        let ((start, len), bbmcu): ((usize, usize), Option<(usize, usize)>) = if file.first() == Some(&MFW_SIG) {
+            let count = *file.get(1).ok_or("the firmware is truncated")? as usize;
+            if count == 0 || 16 + count * 16 > file.len() {
+                return Err(format!("{name}: a broken MFW header"));
+            }
+            let pick = |kind: u8| {
+                let mut best: Option<(u8, usize, usize)> = None;
+                for index in 0..count {
+                    let at = 16 + index * 16;
+                    let (cv, ty, mp) = (file[at], file[at + 1], file[at + 2]);
+                    if ty != kind || mp != 0 || cv > hal.cv {
+                        continue;
+                    }
+                    if best.is_none_or(|(best_cv, _, _)| best_cv < cv) {
+                        best = Some((cv, get_le32(&file, at + 4) as usize, get_le32(&file, at + 8) as usize));
+                    }
+                }
+                best.map(|(_, shift, size)| (shift, size))
+            };
+            let found = if chip.try_ce_fw { pick(FW_NORMAL_CE).or_else(|| pick(FW_NORMAL)) } else { pick(FW_NORMAL) };
+            (found.ok_or_else(|| format!("{name}: no firmware for cut {}", hal.cv))?, None)
+        } else {
+            ((0, file.len()), None)
+        };
+        if start + len > file.len() || len < 32 || bbmcu.is_some_and(|(at, size)| at + size > file.len() || size < 32) {
+            return Err(format!("{name}: the firmware is truncated"));
+        }
+        let w = |word: usize| get_le32(&file, start + word * 4);
+        let version = (get(FW_HDR_W1_MAJOR_VERSION, w(1)) as u8, get(FW_HDR_W1_MINOR_VERSION, w(1)) as u8, get(FW_HDR_W1_SUBVERSION, w(1)) as u8, get(FW_HDR_W1_SUBINDEX, w(1)) as u8);
+        let mut firmware = Self { name, file, start, len, bbmcu, version, elements: Elements::default() };
+        firmware.recognize_elements(hal);
+        if chip.be && firmware.bbmcu.is_none() {
+            return Err(format!("{}: no baseband MCU firmware for cut {}", firmware.name, hal.cv));
+        }
+        Ok(firmware)
+    }
+
+    fn data(&self) -> &[u8] {
+        &self.file[self.start..self.start + self.len]
+    }
+
+    /// `rtw89_fw_recognize_elements`: from the end of the last firmware, on
+    /// 16-byte boundaries.
+    fn recognize_elements(&mut self, hal: &Hal) {
+        let file = self.file.clone();
+        let mut offset = if file.first() == Some(&MFW_SIG) {
+            let count = file[1] as usize;
+            let at = 16 + (count - 1) * 16;
+            (get_le32(&file, at + 4) + get_le32(&file, at + 8)) as usize
+        } else {
+            return;
+        };
+        offset = offset.next_multiple_of(ELEMENT_ALIGN);
+        while offset + ELEMENT_HDR < file.len() {
+            let id = get_le32(&file, offset);
+            let size = get_le32(&file, offset + 4) as usize;
+            if offset + size >= file.len() {
+                break;
+            }
+            let aid = get_le16(&file, offset + 12);
+            let Some(body) = file.get(offset + 24..offset + ELEMENT_HDR + size) else { break };
+            // Elements for another chip of the family (`aid`): not ours.
+            if aid == 0 || aid == hal.aid {
+                // The BE chips' baseband MCU firmware (`__rtw89_fw_recognize_from_elm`):
+                // the first for a cut up to the chip's.
+                if id == RTW89_FW_ELEMENT_ID_BBMCU0 {
+                    if self.bbmcu.is_none() && body[0] <= hal.cv {
+                        self.bbmcu = Some((offset + ELEMENT_HDR, size));
+                    }
+                } else {
+                    self.element(hal, id, body);
+                }
+            }
+            offset = (offset + ELEMENT_HDR + size).next_multiple_of(ELEMENT_ALIGN);
+        }
+    }
+
+    fn element(&mut self, hal: &Hal, id: u32, body: &[u8]) {
+        let table = |body: &[u8]| -> Table { body.get(8..).unwrap_or(&[]).chunks_exact(8).map(|pair| (get_le32(pair, 0), get_le32(pair, 4))).collect() };
+        let power = |body: &[u8], slot: &mut Option<PowerTable>| {
+            if body.len() < 8 {
+                return;
+            }
+            let (rfe_type, entry_size, count) = (body[2], body[3] as usize, get_le32(body, 4) as usize);
+            let data = body[8..].get(..count * entry_size).unwrap_or(&body[8..]).to_vec();
+            // The board's own table, else the default one (RFE type 0,
+            // `RTW89_TXPWR_CONF_DFLT_RFE_TYPE`) until the board's comes.
+            let take = rfe_type == hal.rfe_type || (rfe_type == 0 && slot.as_ref().is_none_or(|old| old.rfe_type == 0));
+            if take {
+                *slot = Some(PowerTable { rfe_type, entry_size, data });
+            }
+        };
+        let e = &mut self.elements;
+        match id {
+            RTW89_FW_ELEMENT_ID_BB_REG if e.bb.is_none() => e.bb = Some(table(body)),
+            RTW89_FW_ELEMENT_ID_BB_GAIN if e.bb_gain.is_none() => e.bb_gain = Some(table(body)),
+            RTW89_FW_ELEMENT_ID_RADIO_A | RTW89_FW_ELEMENT_ID_RADIO_B => {
+                let path = body.first().copied().unwrap_or(0) as usize & 1;
+                if e.radio[path].is_none() {
+                    e.radio[path] = Some(table(body));
+                }
+            }
+            RTW89_FW_ELEMENT_ID_RF_NCTL if e.nctl.is_none() => e.nctl = Some(table(body)),
+            RTW89_FW_ELEMENT_ID_TXPWR_BYRATE => power(body, &mut e.byrate),
+            RTW89_FW_ELEMENT_ID_TXPWR_LMT_2GHZ => power(body, &mut e.limit_2g),
+            RTW89_FW_ELEMENT_ID_TXPWR_LMT_5GHZ => power(body, &mut e.limit_5g),
+            RTW89_FW_ELEMENT_ID_TXPWR_LMT_6GHZ => power(body, &mut e.limit_6g),
+            RTW89_FW_ELEMENT_ID_TXPWR_LMT_RU_2GHZ => power(body, &mut e.limit_ru_2g),
+            RTW89_FW_ELEMENT_ID_TXPWR_LMT_RU_5GHZ => power(body, &mut e.limit_ru_5g),
+            RTW89_FW_ELEMENT_ID_TXPWR_LMT_RU_6GHZ => power(body, &mut e.limit_ru_6g),
+            RTW89_FW_ELEMENT_ID_TXPWR_TRK if e.txpwr_trk.is_none() => e.txpwr_trk = TxPowerTrack::parse(body),
+            _ => {}
+        }
+    }
+
+    /// The tables the chip needs (`needed_fw_elms`): without them this
+    /// file is too old.
+    pub(crate) fn check_elements(&self, hal: &Hal) -> Result<(), String> {
+        let e = &self.elements;
+        let mut missing = Vec::new();
+        if e.bb.is_none() {
+            missing.push("BB");
+        }
+        if e.radio[0].is_none() || (hal.chip.rf_paths > 1 && e.radio[1].is_none()) {
+            missing.push("RF");
+        }
+        if e.nctl.is_none() {
+            missing.push("NCTL");
+        }
+        if hal.chip.be && self.bbmcu.is_none() {
+            missing.push("BB MCU");
+        }
+        if missing.is_empty() {
+            Ok(())
+        } else {
+            Err(format!("{} has no {} tables (linux-firmware's newer one has them)", self.name, missing.join("/")))
+        }
+    }
+
+    /// `rtw89_fw_hdr_parser` (formats 0 and 1): the header's length and the
+    /// sections after it.
+    fn sections(&self, fw: &[u8], secure: &Secure) -> Result<(usize, Vec<Section>), String> {
+        let w = |word: usize| get_le32(fw, word * 4);
+        let hdr_ver = get(FW_HDR_W3_HDR_VER, w(3));
+        let v1 = match hdr_ver {
+            0 => false,
+            1 => true,
+            other => return Err(format!("{}: firmware header format {other}", self.name)),
+        };
+        let (base, count) = if v1 { (48, get(FW_HDR_V1_W6_SEC_NUM, w(6)) as usize) } else { (32, get(FW_HDR_W6_SEC_NUM, w(6)) as usize) };
+        if count == 0 || count > 8 {
+            return Err(format!("{}: {count} sections", self.name));
+        }
+        let base_len = base + count * 16;
+        let dynamic = if v1 { get(FW_HDR_V1_W7_DYN_HDR, w(7)) } else { get(FW_HDR_W7_DYN_HDR, w(7)) } != 0;
+        let hdr_len = if dynamic { if v1 { get(FW_HDR_V1_W5_HDR_SIZE, w(5)) as usize } else { get(FW_HDR_W3_LEN, w(3)) as usize } } else { base_len };
+        let dsp_checksum = v1 && get(FW_HDR_V1_W6_DSP_CHKSUM, w(6)) != 0;
+        let mut bin = hdr_len;
+        let mut sections = Vec::with_capacity(count);
+        let mut secure_seen = false;
+        for index in 0..count {
+            let at = base + index * 16;
+            let (w0, w1, w2) = (get_le32(fw, at), get_le32(fw, at + 4), get_le32(fw, at + 8));
+            let kind = if v1 { get(FWSECTION_HDR_V1_W1_SECTIONTYPE, w1) } else { get(FWSECTION_HDR_W1_SECTIONTYPE, w1) };
+            let mut len = if v1 { get(FWSECTION_HDR_V1_W1_SEC_SIZE, w1) } else { get(FWSECTION_HDR_W1_SEC_SIZE, w1) } as usize;
+            if if v1 { get(FWSECTION_HDR_V1_W1_CHECKSUM, w1) } else { get(FWSECTION_HDR_W1_CHECKSUM, w1) } != 0 {
+                len += SECTION_CHKSUM_LEN;
+            }
+            let _ = w0;
+            let mut section = Section { start: bin, len, key: None, ignore: false };
+            let mut mssc_len = 0;
+            if kind == SECURITY_SECTION {
+                let mssc = if v1 { get(FWSECTION_HDR_V1_W2_MSSC, w2) } else { get(FWSECTION_HDR_W2_MSSC, w2) };
+                if mssc & 0xff == FORMATTED_MSSC {
+                    let (length, key) = self.formatted_mssc(fw, bin, len, dsp_checksum, secure)?;
+                    mssc_len = length;
+                    if secure.secure_boot {
+                        match key {
+                            Some(key) => section.key = Some(key),
+                            None => section.ignore = true,
+                        }
+                    }
+                    if secure_seen {
+                        section.ignore = true;
+                    }
+                } else {
+                    mssc_len = mssc as usize * SECURITY_SIGLEN;
+                    if dsp_checksum {
+                        mssc_len += mssc as usize * SECURITY_CHKSUM_LEN;
+                    }
+                    if secure.secure_boot {
+                        if secure.mss_idx as u32 >= mssc {
+                            return Err(format!("{}: no signature for key {}", self.name, secure.mss_idx));
+                        }
+                        section.key = Some((bin + len + secure.mss_idx as usize * SECURITY_SIGLEN, SECURITY_SIGLEN));
+                    }
+                }
+                secure_seen = true;
+            }
+            bin += len + mssc_len;
+            sections.push(section);
+        }
+        if bin != fw.len() {
+            return Err(format!("{}: the sections do not add up ({bin} of {})", self.name, fw.len()));
+        }
+        Ok((hdr_len - if dynamic { hdr_len - base_len } else { 0 }, sections))
+    }
+
+    /// `__parse_formatted_mssc`: the key pool after the section; its length
+    /// and, on a secure-boot chip, where its key's signature is.
+    fn formatted_mssc(&self, fw: &[u8], content: usize, len: usize, dsp_checksum: bool, secure: &Secure) -> Result<(usize, Option<(usize, usize)>), String> {
+        let pool = content + len;
+        let header = fw.get(pool..pool + 32).ok_or_else(|| format!("{}: a truncated key pool", self.name))?;
+        if header[0..8] != MSS_SIGNATURE {
+            return Err(format!("{}: a key pool without its signature", self.name));
+        }
+        let key_raw_offset = get_le32(header, 12) as usize;
+        let defen = header[16] != 0;
+        let (rmpfmt, dev_max) = (header[20], header[21] as usize);
+        let keypair_num = get_le16(header, 22) as usize;
+        let cust_max = get_le16(header, 24) as usize;
+        let key_max = get_le16(header, 26) as usize;
+        if rmpfmt != 0 {
+            return Err(format!("{}: key pool format {rmpfmt}", self.name));
+        }
+        let mut table = (key_max * cust_max * dev_max) >> 3;
+        if defen {
+            table += MSS_POOL_DEFKEYSETS_SIZE;
+        }
+        let mut sign_len = (get_le16(fw, content + 60) >> 2) as usize;
+        if sign_len == 0 {
+            sign_len = SECURITY_SIGLEN;
+        }
+        if dsp_checksum {
+            sign_len += SECURITY_CHKSUM_LEN;
+        }
+        let length = 32 + table + keypair_num * sign_len;
+        if !secure.secure_boot || !secure.can_v1 {
+            return Ok((length, None));
+        }
+        let sb_sel_ver = get_le32(fw, content + 58);
+        if sb_sel_ver != 0 && sb_sel_ver != secure.sb_sel_mgn {
+            return Ok((length, None));
+        }
+        // `__get_mssc_key_idx`: the key's bit in the table, its rank.
+        let index = if secure.dev_type == MSS_DEV_TYPE_DEF {
+            if !defen {
+                return Ok((length, None));
+            }
+            secure.cust_idx as usize * key_max + secure.key_num as usize
+        } else {
+            let base = if defen { MSS_POOL_DEFKEYSETS_SIZE << 3 } else { 0 };
+            base + secure.dev_type as usize * key_max * cust_max + secure.cust_idx as usize * key_max + secure.key_num as usize
+        };
+        let rmp = fw.get(pool + 32..pool + 32 + table).unwrap_or(&[]);
+        let (byte, bit) = (index >> 3, index & 7);
+        if byte >= rmp.len() || rmp[byte] & (1 << bit) == 0 {
+            return Ok((length, None));
+        }
+        let rank = (rmp[byte] & ((1 << bit) - 1)).count_ones() as usize + rmp[..byte].iter().map(|b| b.count_ones() as usize).sum::<usize>();
+        Ok((length, Some((pool + key_raw_offset + sign_len * rank, sign_len))))
+    }
+
+    /// `__rtw89_fw_download` on the 802.11ax chips.
+    pub(crate) fn download(&self, hal: &Hal, pci: &mut Pci, h2c: &mut H2c, secure: &Secure) -> Result<(), String> {
+        if hal.chip.be {
+            return self.download_be(hal, pci, h2c, secure);
+        }
+        let fw = self.data();
+        let (hdr_len, sections) = self.sections(fw, secure)?;
+        // `rtw89_mac_disable_cpu_ax`.
+        hal.clr32(R_AX_PLATFORM_ENABLE, B_AX_WCPU_EN);
+        hal.clr32(R_AX_WCPU_FW_CTRL, B_AX_WCPU_FWDL_EN | B_AX_H2C_PATH_RDY | B_AX_FWDL_PATH_RDY);
+        hal.clr32(R_AX_SYS_CLK_CTRL, B_AX_CPU_CLK_EN);
+        if hal.is_885xb() {
+            hal.clr32(R_AX_PLATFORM_ENABLE, B_AX_APB_WRAP_EN);
+            hal.set32(R_AX_PLATFORM_ENABLE, B_AX_APB_WRAP_EN);
+        } else {
+            let mem = |offset: u32, value: u32| {
+                hal.w32(R_AX_FILTER_MODEL_ADDR, CPU_LOCAL_BASE_ADDR + offset);
+                hal.w32(R_AX_INDIR_ACCESS_ENTRY, value);
+            };
+            mem(R_AX_WDT_CTRL, WDT_CTRL_ALL_DIS);
+            hal.w32(R_AX_FILTER_MODEL_ADDR, CPU_LOCAL_BASE_ADDR + R_AX_WDT_STATUS);
+            let status = (hal.r32(R_AX_INDIR_ACCESS_ENTRY) | B_AX_FS_WDT_INT) & !B_AX_FS_WDT_INT_MSK;
+            mem(R_AX_WDT_STATUS, status);
+        }
+        hal.clr32(R_AX_PLATFORM_ENABLE, B_AX_PLATFORM_EN);
+        hal.set32(R_AX_PLATFORM_ENABLE, B_AX_PLATFORM_EN);
+        // `rtw89_mac_enable_cpu_ax` for a download.
+        if hal.r32(R_AX_PLATFORM_ENABLE) & B_AX_WCPU_EN != 0 {
+            return Err(String::from("the chip's CPU is already on"));
+        }
+        for reg in [R_AX_UDM1, R_AX_UDM2, R_AX_HALT_H2C_CTRL, R_AX_HALT_C2H_CTRL, R_AX_HALT_H2C, R_AX_HALT_C2H] {
+            hal.w32(reg, 0);
+        }
+        hal.set32(R_AX_SYS_CLK_CTRL, B_AX_CPU_CLK_EN);
+        let mut ctrl = hal.r32(R_AX_WCPU_FW_CTRL) & !(B_AX_WCPU_FWDL_EN | B_AX_H2C_PATH_RDY | B_AX_FWDL_PATH_RDY);
+        ctrl = (ctrl & !B_AX_WCPU_FWDL_STS_MASK) | field(B_AX_WCPU_FWDL_STS_MASK, RTW89_FWDL_INITIAL_STATE) | B_AX_WCPU_FWDL_EN;
+        hal.w32(R_AX_WCPU_FW_CTRL, ctrl);
+        if hal.is_885xb() {
+            hal.w32_mask(R_AX_SEC_CTRL, B_AX_SEC_IDMEM_SIZE_CONFIG_MASK, 0x2);
+        }
+        hal.w16_mask(R_AX_BOOT_REASON, B_AX_BOOT_REASON_MASK, 0);
+        hal.set32(R_AX_PLATFORM_ENABLE, B_AX_WCPU_EN);
+        // The H2C path, then the header (its part size set).
+        if hal.poll8(R_AX_WCPU_FW_CTRL, |value| value as u32 & B_AX_H2C_PATH_RDY != 0, 1, 400_000).is_err() {
+            return Err(String::from("the H2C path did not get ready"));
+        }
+        self.send_suit(hal, pci, h2c, fw, hdr_len, &sections, || hal.poll8(R_AX_WCPU_FW_CTRL, |value| value as u32 & B_AX_FWDL_PATH_RDY != 0, 1, 400_000).is_ok())?;
+        crate::delay_ms(5);
+        h2c.reset();
+        match hal.poll8(R_AX_WCPU_FW_CTRL, |value| get(B_AX_WCPU_FWDL_STS_MASK, value as u32) as u8 == FWDL_INIT_RDY, 1, 400_000) {
+            Ok(_) => Ok(()),
+            Err(value) => Err(match get(B_AX_WCPU_FWDL_STS_MASK, value as u32) as u8 {
+                FWDL_CHECKSUM_FAIL => String::from("the firmware's checksum failed"),
+                FWDL_SECURITY_FAIL => String::from("the firmware's signature was refused (secure boot)"),
+                FWDL_CV_NOT_MATCH => String::from("the firmware is for another cut of the chip"),
+                other => format!("the firmware did not start (state {other})"),
+            }),
+        }
+    }
+
+    /// A firmware's header (its part size set, the ignored sections left
+    /// out) and its sections (`rtw89_fw_download_hdr`, `_main`); the
+    /// download's path ready after the header.
+    #[allow(clippy::too_many_arguments)]
+    fn send_suit(&self, hal: &Hal, pci: &mut Pci, h2c: &mut H2c, fw: &[u8], hdr_len: usize, sections: &[Section], header_taken: impl Fn() -> bool) -> Result<(), String> {
+        let mut header = fw[..hdr_len].to_vec();
+        let v1 = get(FW_HDR_W3_HDR_VER, get_le32(fw, 12)) == 1;
+        let w7 = get_le32(&header, 28);
+        let mask = if v1 { FW_HDR_V1_W7_PART_SIZE } else { FW_HDR_W7_PART_SIZE };
+        header[28..32].copy_from_slice(&((w7 & !mask) | field(mask, PART_SIZE as u32)).to_le_bytes());
+        if v1 {
+            // Ignored sections leave the header.
+            let base = 48;
+            let mut kept = 0;
+            for (index, section) in sections.iter().enumerate() {
+                if section.ignore {
+                    continue;
+                }
+                if kept != index {
+                    let (from, to) = (base + index * 16, base + kept * 16);
+                    let entry: Vec<u8> = header[from..from + 16].to_vec();
+                    header[to..to + 16].copy_from_slice(&entry);
+                }
+                kept += 1;
+            }
+            let w6 = get_le32(&header, 24);
+            header[24..28].copy_from_slice(&((w6 & !FW_HDR_V1_W6_SEC_NUM) | field(FW_HDR_V1_W6_SEC_NUM, kept as u32)).to_le_bytes());
+            header.truncate(hdr_len - (sections.len() - kept) * 16);
+        }
+        let packet = h2c.packet_fwdl(H2C_CAT_MAC, H2C_CL_MAC_FWDL, H2C_FUNC_MAC_FWHDR_DL, &header);
+        pci.send_h2c(hal, &packet, false).map_err(String::from)?;
+        if !header_taken() {
+            return Err(String::from("the firmware's header was not taken"));
+        }
+        hal.w32(R_AX_HALT_H2C_CTRL, 0);
+        hal.w32(R_AX_HALT_C2H_CTRL, 0);
+        // The sections.
+        for section in sections.iter().filter(|section| !section.ignore) {
+            let mut data = fw[section.start..section.start + section.len].to_vec();
+            if let Some((key, key_len)) = section.key
+                && data.len() >= key_len
+                && key_len <= PART_SIZE
+            {
+                let at = data.len() - key_len;
+                data[at..].copy_from_slice(&fw[key..key + key_len]);
+            }
+            for piece in data.chunks(PART_SIZE) {
+                let deadline = crate::now_ms() + 500;
+                loop {
+                    match pci.send_h2c(hal, piece, true) {
+                        Ok(()) => break,
+                        Err(error) if crate::now_ms() >= deadline => return Err(String::from(error)),
+                        Err(_) => crate::delay_us(50),
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+
+    /// `__rtw89_fw_download` on the 802.11be chips: the CPU stopped, the
+    /// WLAN CPU's and baseband MCU's download on, each firmware (the
+    /// normal one with the RTL8922A's secure-boot memory set), then the
+    /// firmware's start awaited.
+    fn download_be(&self, hal: &Hal, pci: &mut Pci, h2c: &mut H2c, secure: &Secure) -> Result<(), String> {
+        crate::be::disable_cpu(hal);
+        crate::be::enable_wcpu(hal, true);
+        let normal = self.data();
+        let bbmcu = self.bbmcu.map(|(start, len)| &self.file[start..start + len]);
+        // Each suit's download done: its CPU's download-enable bit down.
+        for (index, (fw, done)) in [(Some(normal), B_BE_WLANCPU_FWDL_EN), (bbmcu, B_BE_BBMCU0_FWDL_EN)].into_iter().filter_map(|(fw, done)| fw.map(|fw| (fw, done))).enumerate() {
+            let (hdr_len, sections) = self.sections(fw, secure)?;
+            if index == 0 && hal.id() == ChipId::Rtl8922a {
+                hal.w32(R_BE_SECURE_BOOT_MALLOC_INFO, 0x2024_8000);
+            }
+            if !crate::be::path_ready(hal, true) {
+                return Err(String::from("the H2C path did not get ready"));
+            }
+            self.send_suit(hal, pci, h2c, fw, hdr_len, &sections, || crate::be::path_ready(hal, false))?;
+            fw_ready(hal, Some(done))?;
+        }
+        crate::delay_ms(5);
+        h2c.reset();
+        fw_ready(hal, None)
+    }
+}
+
+/// `rtw89_fw_check_rdy` on the BE chips.
+fn fw_ready(hal: &Hal, done: Option<u32>) -> Result<(), String> {
+    let deadline = crate::now_ms() + 400;
+    loop {
+        let state = crate::be::fwdl_status(hal, done);
+        if state == crate::be::FWDL_INIT_RDY {
+            return Ok(());
+        }
+        if crate::now_ms() >= deadline {
+            return Err(match state {
+                FWDL_CHECKSUM_FAIL => String::from("the firmware's checksum failed"),
+                FWDL_SECURITY_FAIL => String::from("the firmware's signature was refused (secure boot)"),
+                FWDL_CV_NOT_MATCH => String::from("the firmware is for another cut of the chip"),
+                other => format!("the firmware did not start (state {other})"),
+            });
+        }
+        crate::delay_us(1);
+    }
+}
+
+/// `rtw89_efuse_read_fw_secure_ax`'s decoding of the two eFuse bytes.
+pub(crate) fn secure_from_efuse(id: ChipId, b1: u8, b2: u8) -> Secure {
+    let mut secure = Secure::default();
+    if b1 == 0xff && b2 == 0xff {
+        return secure;
+    }
+    // Version 0: the external part number, customer and serial.
+    let external = 0xff - b1;
+    let customer = 0x0f - (b2 & 0x0f);
+    let serial = 0x07 - ((b2 >> 4) & 0x07);
+    let v0 = [(0u8, 0u8, 0u8), (0, 1, 1)].iter().position(|&(e, c, s)| e == external && c == customer && s == serial);
+    if let Some(index) = v0 {
+        secure.mss_idx = index as u8;
+    }
+    secure_v1(id, b1, b2, &mut secure);
+    secure.secure_boot = v0.is_some() || secure.can_v1;
+    secure
+}
+
+/// `rtw89_efuse_recognize_mss_info_v1`: the device type, customer and key
+/// the two eFuse bytes name, if the type is known.
+pub(crate) fn secure_v1(id: ChipId, b1: u8, b2: u8, secure: &mut Secure) -> bool {
+    // Version 1: device type, customer and key.
+    let (raw_type, cust, key) = if id == ChipId::Rtl8852b && b1 == 0xff && b2 == 0x6e {
+        (0x0a, 0, 0)
+    } else {
+        (b1 & 0x0f, 0x1f - (((b1 >> 4) & 0x0f) | (((b2 >> 6) & 1) << 4)), 0x0f - (b2 & 0x0f))
+    };
+    let dev_type = match raw_type {
+        0x0c => Some(0),
+        0x0a => Some(1),
+        0x09 => Some(2),
+        0x06 => Some(3),
+        0x0f => Some(MSS_DEV_TYPE_DEF),
+        _ => None,
+    };
+    if let Some(dev_type) = dev_type {
+        secure.can_v1 = true;
+        secure.dev_type = dev_type;
+        secure.cust_idx = cust;
+        secure.key_num = key;
+    }
+    secure.can_v1
+}
+
+/// The H2C commands' headers and sequence numbers.
+pub(crate) struct H2c {
+    seq: u8,
+}
+
+impl H2c {
+    pub(crate) fn new() -> Self {
+        Self { seq: 0 }
+    }
+
+    pub(crate) fn reset(&mut self) {
+        self.seq = 0;
+    }
+
+    /// `rtw89_h2c_pkt_set_hdr`: the 802.11ax chips ask for a receive
+    /// acknowledgement every fourth command.
+    pub(crate) fn packet(&mut self, cat: u32, class: u32, func: u32, rack: bool, dack: bool, payload: &[u8]) -> Vec<u8> {
+        let rack = rack || self.seq % 4 == 0;
+        let hdr0 = field(H2C_HDR_DEL_TYPE, FWCMD_TYPE_H2C) | field(H2C_HDR_CAT, cat) | field(H2C_HDR_CLASS, class) | field(H2C_HDR_FUNC, func) | field(H2C_HDR_H2C_SEQ, self.seq as u32);
+        let hdr1 = field(H2C_HDR_TOTAL_LEN, (payload.len() + H2C_HEADER) as u32) | if rack { H2C_HDR_REC_ACK } else { 0 } | if dack { H2C_HDR_DONE_ACK } else { 0 };
+        self.seq = self.seq.wrapping_add(1);
+        let mut out = Vec::with_capacity(H2C_HEADER + payload.len());
+        out.extend_from_slice(&hdr0.to_le_bytes());
+        out.extend_from_slice(&hdr1.to_le_bytes());
+        out.extend_from_slice(payload);
+        out
+    }
+
+    /// `rtw89_h2c_pkt_set_hdr_fwdl`: no sequence counted, no acks.
+    fn packet_fwdl(&mut self, cat: u32, class: u32, func: u32, payload: &[u8]) -> Vec<u8> {
+        let hdr0 = field(H2C_HDR_DEL_TYPE, FWCMD_TYPE_H2C) | field(H2C_HDR_CAT, cat) | field(H2C_HDR_CLASS, class) | field(H2C_HDR_FUNC, func) | field(H2C_HDR_H2C_SEQ, self.seq as u32);
+        let hdr1 = field(H2C_HDR_TOTAL_LEN, (payload.len() + H2C_HEADER) as u32);
+        let mut out = vec![0u8; H2C_HEADER];
+        out[0..4].copy_from_slice(&hdr0.to_le_bytes());
+        out[4..8].copy_from_slice(&hdr1.to_le_bytes());
+        out.extend_from_slice(payload);
+        out
+    }
+}
+
+/// A command's payload as little-endian words.
+pub(crate) fn words(values: &[u32]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(values.len() * 4);
+    for value in values {
+        out.extend_from_slice(&value.to_le_bytes());
+    }
+    out
+}
