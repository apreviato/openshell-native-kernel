+/// `rtw89_phy_preinit_rf_nctl_be` and the NCTL's table
+/// (`rtw89_phy_init_rf_nctl`).
+pub(crate) fn init_nctl(hal: &Hal, fw: &Firmware) {
+    for (addr, mask, value) in [
+        (R_GOTX_IQKDPK_C0, B_GOTX_IQKDPK, 0x3),
+        (R_GOTX_IQKDPK_C1, B_GOTX_IQKDPK, 0x3),
+        (R_IQKDPK_HC, B_IQKDPK_HC, 0x1),
+        (R_CLK_GCK, B_CLK_GCK, 0x00f_ffff),
+        (R_IOQ_IQK_DPK, B_IOQ_IQK_DPK_CLKEN, 0x3),
+        (R_IQK_DPK_RST, B_IQK_DPK_RST, 0x1),
+        (R_IQK_DPK_PRST, B_IQK_DPK_PRST, 0x1),
+        (R_IQK_DPK_PRST_C1, B_IQK_DPK_PRST, 0x1),
+        (R_TXRFC, B_TXRFC_RST, 0x1),
+        (R_TX_COLLISION_T2R_ST, B_RX_CFIR_PATH_EN, 0x1),
+        (R_TX_COLLISION_T2R_ST, B_RX_CFIR_PATH, 0x3),
+    ] {
+        hal.phy_w32_mask(addr, mask, value);
+    }
+    hal.phy_w32(R_NCTL_CFG, B_NCTL_CHK_EN);
+    let ready = (0..10_000).any(|_| {
+        hal.phy_w32(R_NCTL_RW, B_NCTL_CHECK);
+        crate::delay_us(10);
+        hal.phy_r32(R_NCTL_RW) == B_NCTL_CHECK
+    });
+    if !ready {
+        ostd::warn!("rtw89: the NCTL did not get ready");
+    }
+    phy::init_nctl_table(hal, fw);
+}
