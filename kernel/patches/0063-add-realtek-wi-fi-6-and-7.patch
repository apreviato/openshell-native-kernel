+// SPDX-License-Identifier: MPL-2.0
+
+//! The MAC of the 802.11ax chips as Linux's rtw89 `mac.c` brings it up:
+//! power (each chip's sequence), the eFuse (MAC address, RFE type,
+//! crystal, the secure-boot key), the data-link engine's memory and the
+//! host's flow control (first for the download, then for running), the
+//! DMAC's and the CMAC's blocks, the baseband and RF switched on, the
+//! port and the interface.
+
+use alloc::{format, string::String, vec, vec::Vec};
+
+use crate::{
+    fw::{Secure, secure_from_efuse},
+    hal::{ChipId, DleMem, HFC_PREC_PCIE, Hal, field, get},
+    regs::*,
+};
+
+/// `struct rtw89_efuse`: what the logical map says.
+#[derive(Clone, Copy, Default)]
+pub(crate) struct Efuse {
+    pub(crate) address: [u8; 6],
+    pub(crate) rfe_type: u8,
+    pub(crate) xtal_cap: u8,
+    pub(crate) country: [u8; 2],
+    /// The BE chips' PA and PAD bias trims per path (the eFuse's PHY
+    /// capabilities), if programmed.
+    pub(crate) bias: Option<[[u8; 2]; 2]>,
+    /// The TSSI offsets and thermal values per path (the RTL8922A's, the
+    /// AX chips' the host calibrates).
+    pub(crate) tssi: Option<Tssi>,
+    /// The thermal meter's and the PA bias' trims per path (the PHY
+    /// capabilities' `thermal_trim`, `pa_bias_trim`), if programmed.
+    pub(crate) thermal_trim: Option<[u8; 2]>,
+    pub(crate) pa_bias_trim: Option<[u8; 2]>,
+}
+
+/// `struct rtw89_tssi_info` as the eFuse gives it: each path's thermal
+/// value when calibrated (0xff: none), its offsets by CCK channel group, by
+/// OFDM group (2.4 GHz's five, then 5 GHz's fourteen), by 6 GHz group.
+#[derive(Clone, Copy, Default)]
+pub(crate) struct Tssi {
+    pub(crate) thermal: [u8; 2],
+    pub(crate) cck: [[i8; TSSI_CCK_GROUPS]; 2],
+    pub(crate) mcs: [[i8; TSSI_MCS_GROUPS]; 2],
+    pub(crate) mcs_6g: [[i8; TSSI_MCS_6G_GROUPS]; 2],
+    /// The trims by OFDM group (`tssi_trim`, the PHY capabilities'): none
+    /// on the RTL8922A; 6 GHz's (`tssi_trim_6g`, the RTL8852C's).
+    pub(crate) trim: [[i8; TSSI_TRIM_GROUPS]; 2],
+    pub(crate) trim_6g: [[i8; TSSI_TRIM_6G_GROUPS]; 2],
+}
+
+/// The eFuse's TSSI channel groups: CCK's, OFDM's (2.4 GHz's first, then
+/// 5 GHz's), 6 GHz's.
+pub(crate) const TSSI_CCK_GROUPS: usize = TSSI_CCK_CH_GROUP_NUM as usize;
+pub(crate) const TSSI_MCS_2G_GROUPS: usize = TSSI_MCS_2G_CH_GROUP_NUM as usize;
+pub(crate) const TSSI_MCS_GROUPS: usize = TSSI_MCS_CH_GROUP_NUM as usize;
+pub(crate) const TSSI_MCS_6G_GROUPS: usize = TSSI_MCS_6G_CH_GROUP_NUM as usize;
+pub(crate) const TSSI_TRIM_GROUPS: usize = TSSI_TRIM_CH_GROUP_NUM as usize;
+pub(crate) const TSSI_TRIM_6G_GROUPS: usize = TSSI_TRIM_CH_GROUP_NUM_6G as usize;
+
+/// `struct rtw8852bx_efuse`: each path's TSSI offsets (`struct
+/// rtw8852bx_tssi_offset`: CCK's, 2.4 GHz's at 40 MHz, after seven
+/// reserved bytes 5 GHz's), the thermal values; the PHY capabilities'
+/// TSSI trims, each path's eight downwards from its address.
+const EFUSE_8852BX_TSSI: [usize; 2] = [0x210, 0x23a];
+const EFUSE_8852BX_TSSI_MCS_2G: usize = 6;
+const EFUSE_8852BX_TSSI_MCS_5G: usize = 0x12;
+const EFUSE_8852BX_THERMAL: usize = 0x2d0;
+const PHYCAP_8852BX_ADDR: u32 = 0x580;
+const PHYCAP_8852BX_SIZE: u32 = 128;
+const PHYCAP_8852BX_TSSI_TRIM: [u32; 2] = [0x5d6, 0x5ab];
+/// `struct rtw8852c_efuse`: the 8852BX's layout, then each path's 6 GHz
+/// offsets; its PHY capabilities (a window of its own) with the 6 GHz
+/// trims, the thermal meter's and the PA bias' trims.
+const EFUSE_8852C_TSSI_6G: [usize; 2] = [0x300, 0x32a];
+const PHYCAP_8852C_ADDR: u32 = 0x590;
+const PHYCAP_8852C_SIZE: u32 = 0x60;
+const PHYCAP_8852C_TSSI_TRIM_6G: [u32; 2] = [0x5ce, 0x5a3];
+/// Every AX chip's thermal meter and PA bias trims per path.
+const PHYCAP_AX_THERMAL_TRIM: [u32; 2] = [0x5df, 0x5dc];
+const PHYCAP_AX_PA_BIAS_TRIM: [u32; 2] = [0x5de, 0x5db];
+
+/// Logical eFuse offsets (`struct rtw8852bx_efuse` and the others'): the
+/// same on every 802.11ax chip on PCIe.
+const EFUSE_MAC_ADDR_PCIE: usize = 0x400;
+const EFUSE_RFE_TYPE: usize = 0x2ca;
+const EFUSE_XTAL_K: usize = 0x2b9;
+const EFUSE_COUNTRY: usize = 0x2cb;
+const EFUSE_EXTERNALPN_ADDR: u32 = 0x5ec;
+
+fn poll(hal: &Hal, addr: u32, done: impl Fn(u32) -> bool, what: &str) -> Result<(), String> {
+    hal.poll32(addr, done, 1000, 20_000).map(|_| ()).map_err(|_| format!("{what} did not settle"))
+}
+
+pub(crate) fn xtal(hal: &Hal, offset: u32, value: u32, mask: u32) -> Result<(), String> {
+    hal.write_xtal_si(offset as u8, value as u8, mask as u8).map_err(|()| format!("the crystal's register {offset:#x}"))
+}
+
+/// The steps of `rtw89_mac_pwr_seq` for the RTL8852A (its PCIe and common
+/// ones): address, cuts (a bit each), poll or write, mask, value.
+const RTL8852A_PWR_ON: &[(u32, u8, bool, u8, u8)] = &[
+    (0x00c6, 1 << 1, false, 1 << 6, 1 << 6),
+    (0x0005, 0xff, false, (1 << 4) | (1 << 3), 0),
+    (0x0005, 0xff, false, 1 << 7, 0),
+    (0x0005, 0xff, false, 1 << 2, 0),
+    (0x0006, 0xff, true, 1 << 1, 1 << 1),
+    (0x0006, 0xff, false, 1 << 0, 1 << 0),
+    (0x0005, 0xff, false, 1 << 0, 1 << 0),
+    (0x0005, 0xff, true, 1 << 0, 0),
+    (0x0088, 0xff, false, 1 << 0, 1 << 0),
+    (0x0088, 0xff, false, 1 << 0, 0),
+    (0x0088, 0xff, false, 1 << 0, 1 << 0),
+    (0x0088, 0xff, false, 1 << 0, 0),
+    (0x0088, 0xff, false, 1 << 0, 1 << 0),
+    (0x0083, 0xff, false, 1 << 6, 0),
+    (0x0080, 0xff, false, 1 << 5, 1 << 5),
+    (0x0024, 0xff, false, 0x1f, 0),
+    (0x02a0, 0xff, false, 1 << 1, 1 << 1),
+    (0x02a2, 0xff, false, 0xe0, 0),
+    (0x0071, 0xff, false, 1 << 4, 0),
+    (0x0010, 1 << 0, false, 1 << 2, 1 << 2),
+    (0x02a0, 1 << 0, false, 0xc0, 0),
+];
+
+/// `rtw89_mac_pwr_on`: each chip's power-on (`pwr_on_func`, or the
+/// RTL8852A's sequence).
+pub(crate) fn power_on(hal: &mut Hal) -> Result<(), String> {
+    if hal.chip.be {
+        // `rtw89_mac_pwr_on`: off and on again if it fails.
+        if crate::be::power_on(hal).is_ok() {
+            return Ok(());
+        }
+        let _ = crate::be::power_off(hal);
+        return crate::be::power_on(hal);
+    }
+    if get(B_AX_WLMAC_PWR_STE_MASK, hal.r32(R_AX_IC_PWR_STATE)) == MAC_AX_MAC_ON {
+        // Still on from before (a warm reboot): off first, as Linux retries.
+        power_off(hal);
+    }
+    let id = hal.id();
+    if id == ChipId::Rtl8852a {
+        for &(addr, cuts, is_poll, mask, value) in RTL8852A_PWR_ON {
+            if cuts != 0xff && cuts & (1 << hal.cv) == 0 {
+                continue;
+            }
+            if is_poll {
+                if hal.poll8(addr, |read| read & mask == value, 10, 20_000).is_err() {
+                    return Err(format!("power-on step {addr:#x}"));
+                }
+            } else {
+                let read = hal.r8(addr);
+                hal.w8(addr, (read & !mask) | (value & mask));
+            }
+        }
+    } else {
+        power_on_func(hal)?;
+    }
+    Ok(())
+}
+
+fn power_on_func(hal: &mut Hal) -> Result<(), String> {
+    let id = hal.id();
+    match id {
+        ChipId::Rtl8852b => hal.w16(R_AX_SPS_ANA_ON_CTRL2, RTL8852B_DEFAULT_SPS_ANA as u16),
+        ChipId::Rtl8852bt => hal.set32(R_AX_LDO_AON_CTRL0, B_AX_PD_REGU_L),
+        ChipId::Rtl8852c => {
+            if get(B_AX_PAD_HCI_SEL_V2_MASK, hal.r32(R_AX_SYS_STATUS1)) == MAC_AX_HCI_SEL_PCIE_USB {
+                hal.set32(R_AX_LDO_AON_CTRL0, B_AX_PD_REGU_L);
+            }
+        }
+        _ => {}
+    }
+    hal.clr32(R_AX_SYS_PW_CTRL, B_AX_AFSM_WLSUS_EN | B_AX_AFSM_PCIE_SUS_EN);
+    hal.set32(R_AX_SYS_PW_CTRL, B_AX_DIS_WLBT_PDNSUSEN_SOPC);
+    hal.set32(R_AX_WLLPS_CTRL, B_AX_DIS_WLBT_LPSEN_LOPC);
+    hal.clr32(R_AX_SYS_PW_CTRL, B_AX_APDM_HPDN);
+    hal.clr32(R_AX_SYS_PW_CTRL, B_AX_APFM_SWLPS);
+    if matches!(id, ChipId::Rtl8852bt | ChipId::Rtl8852c) {
+        hal.w32_mask(R_AX_SPS_DIG_ON_CTRL0, B_AX_OCP_L1_MASK, 7);
+    }
+    poll(hal, R_AX_SYS_PW_CTRL, |value| value & B_AX_RDY_SYSPWR != 0, "the system's power")?;
+    if id == ChipId::Rtl8852b {
+        hal.set32(R_AX_AFE_LDO_CTRL, B_AX_AON_OFF_PC_EN);
+        poll(hal, R_AX_AFE_LDO_CTRL, |value| value & B_AX_AON_OFF_PC_EN != 0, "the AON power cut")?;
+        // `rtw8852b_pwr_sps_dig_off`.
+        hal.w32_mask(R_AX_SPS_DIG_OFF_CTRL0, B_AX_C1_L1_MASK, 1);
+        if hal.rfe_type == 5 {
+            hal.w32_mask(R_AX_SPS_DIG_OFF_CTRL0, B_AX_C2_L1_MASK, 1);
+            hal.w32_mask(R_AX_SPS_DIG_OFF_CTRL0, B_AX_C3_L1_MASK, 2);
+            hal.w32_mask(R_AX_SPS_DIG_OFF_CTRL0, B_AX_R1_L1_MASK, 1);
+        } else {
+            hal.w32_mask(R_AX_SPS_DIG_OFF_CTRL0, B_AX_C3_L1_MASK, 3);
+        }
+    }
+    hal.set32(R_AX_SYS_PW_CTRL, B_AX_EN_WLON);
+    hal.set32(R_AX_SYS_PW_CTRL, B_AX_APFN_ONMAC);
+    poll(hal, R_AX_SYS_PW_CTRL, |value| value & B_AX_APFN_ONMAC == 0, "the MAC's power")?;
+    for set in [true, false, true, false, true] {
+        if set {
+            hal.set8(R_AX_PLATFORM_ENABLE, B_AX_PLATFORM_EN);
+        } else {
+            hal.clr8(R_AX_PLATFORM_ENABLE, B_AX_PLATFORM_EN);
+        }
+    }
+    hal.clr32(R_AX_SYS_SDIO_CTRL, B_AX_PCIE_CALIB_EN_V1);
+    if id == ChipId::Rtl8852c {
+        hal.clr32(R_AX_SYS_ISO_CTRL_EXTEND, B_AX_CMAC1_FEN);
+        hal.set32(R_AX_SYS_ISO_CTRL_EXTEND, B_AX_R_SYM_ISO_CMAC12PP);
+        hal.clr32(R_AX_AFE_CTRL1, B_AX_R_SYM_WLCMAC1_P4_PC_EN | B_AX_R_SYM_WLCMAC1_P3_PC_EN | B_AX_R_SYM_WLCMAC1_P2_PC_EN | B_AX_R_SYM_WLCMAC1_P1_PC_EN | B_AX_R_SYM_WLCMAC1_PC_EN);
+    }
+    if id != ChipId::Rtl8851b {
+        hal.set32(R_AX_SYS_ADIE_PAD_PWR_CTRL, B_AX_SYM_PADPDN_WL_PTA_1P3);
+        xtal(hal, XTAL_SI_ANAPAR_WL, XTAL_SI_GND_SHDN_WL, XTAL_SI_GND_SHDN_WL)?;
+        hal.set32(R_AX_SYS_ADIE_PAD_PWR_CTRL, B_AX_SYM_PADPDN_WL_RFC_1P3);
+        xtal(hal, XTAL_SI_ANAPAR_WL, XTAL_SI_SHDN_WL, XTAL_SI_SHDN_WL)?;
+    }
+    xtal(hal, XTAL_SI_ANAPAR_WL, XTAL_SI_OFF_WEI, XTAL_SI_OFF_WEI)?;
+    xtal(hal, XTAL_SI_ANAPAR_WL, XTAL_SI_OFF_EI, XTAL_SI_OFF_EI)?;
+    xtal(hal, XTAL_SI_ANAPAR_WL, 0, XTAL_SI_RFC2RF)?;
+    xtal(hal, XTAL_SI_ANAPAR_WL, XTAL_SI_PON_WEI, XTAL_SI_PON_WEI)?;
+    xtal(hal, XTAL_SI_ANAPAR_WL, XTAL_SI_PON_EI, XTAL_SI_PON_EI)?;
+    xtal(hal, XTAL_SI_ANAPAR_WL, 0, XTAL_SI_SRAM2RFC)?;
+    if id != ChipId::Rtl8852c {
+        xtal(hal, XTAL_SI_SRAM_CTRL, 0, XTAL_SI_SRAM_DIS)?;
+        xtal(hal, XTAL_SI_XTAL_XMD_2, 0, XTAL_SI_LDO_LPS)?;
+    } else {
+        xtal(hal, XTAL_SI_XTAL_XMD_2, 0x10, XTAL_SI_LDO_LPS)?;
+    }
+    xtal(hal, XTAL_SI_XTAL_XMD_4, 0, XTAL_SI_LPS_CAP)?;
+    if id == ChipId::Rtl8851b {
+        xtal(hal, XTAL_SI_XTAL_DRV, 0, XTAL_SI_DRV_LATCH)?;
+    }
+    hal.set32(R_AX_PMC_DBG_CTRL2, B_AX_SYSON_DIS_PMCR_AX_WRMSK);
+    hal.set32(R_AX_SYS_ISO_CTRL, B_AX_ISO_EB2CORE);
+    hal.clr32(R_AX_SYS_ISO_CTRL, B_AX_PWC_EV2EF_B15);
+    crate::delay_ms(1);
+    hal.clr32(R_AX_SYS_ISO_CTRL, B_AX_PWC_EV2EF_B14);
+    hal.clr32(R_AX_PMC_DBG_CTRL2, B_AX_SYSON_DIS_PMCR_AX_WRMSK);
+    match id {
+        ChipId::Rtl8851b => {
+            hal.set32(R_AX_GPIO0_16_EECS_EESK_LED1_PULL_LOW_EN, B_AX_GPIO10_PULL_LOW_EN | B_AX_GPIO16_PULL_LOW_EN_V1);
+            if hal.cv == CHIP_CAV as u8
+                && let Ok(cv) = efuse_version(hal)
+            {
+                hal.cv = cv;
+            }
+            hal.clr32(R_AX_WLAN_XTAL_SI_CONFIG, B_AX_XTAL_SI_ADDR_NOT_CHK);
+            if hal.cv != CHIP_CAV as u8 {
+                hal.set32(R_AX_SPSLDO_ON_CTRL1, B_AX_FPWMDELAY);
+                hal.set32(R_AX_SPSANA_ON_CTRL1, B_AX_FPWMDELAY);
+            }
+        }
+        ChipId::Rtl8852c => hal.set32(R_AX_GPIO0_15_EECS_EESK_LED1_PULL_LOW_EN, B_AX_EECS_PULL_LOW_EN | B_AX_EESK_PULL_LOW_EN | B_AX_LED1_PULL_LOW_EN),
+        ChipId::Rtl8852b | ChipId::Rtl8852bt if hal.efuse_valid => {
+            hal.w32_mask(R_AX_SPS_DIG_ON_CTRL0, B_AX_VOL_L1_MASK, 0x9);
+            hal.w32_mask(R_AX_SPS_DIG_ON_CTRL0, B_AX_VREFPFM_L_MASK, 0xa);
+            if id == ChipId::Rtl8852b && hal.cv == CHIP_CBV as u8 {
+                hal.set32(R_AX_PMC_DBG_CTRL2, B_AX_SYSON_DIS_PMCR_AX_WRMSK);
+                hal.w16_mask(R_AX_HCI_LDO_CTRL, B_AX_R_AX_VADJ_MASK, 0xa);
+                hal.clr32(R_AX_PMC_DBG_CTRL2, B_AX_SYSON_DIS_PMCR_AX_WRMSK);
+            }
+        }
+        _ => {}
+    }
+    let mut dmac = B_AX_MAC_FUNC_EN | B_AX_DMAC_FUNC_EN | B_AX_MPDU_PROC_EN | B_AX_WD_RLS_EN | B_AX_DLE_WDE_EN | B_AX_TXPKT_CTRL_EN | B_AX_STA_SCH_EN | B_AX_DLE_PLE_EN | B_AX_PKT_BUF_EN | B_AX_DMAC_TBL_EN | B_AX_PKT_IN_EN | B_AX_DLE_CPUIO_EN | B_AX_DISPATCHER_EN | B_AX_BBRPT_EN | B_AX_MAC_SEC_EN;
+    dmac |= if id == ChipId::Rtl8852c { B_AX_MAC_UN_EN | B_AX_H_AXIDMA_EN } else { B_AX_DMACREG_GCKEN };
+    hal.set32(R_AX_DMAC_FUNC_EN, dmac);
+    hal.set32(R_AX_CMAC_FUNC_EN, B_AX_CMAC_EN | B_AX_CMAC_TXEN | B_AX_CMAC_RXEN | B_AX_FORCE_CMACREG_GCKEN | B_AX_PHYINTF_EN | B_AX_CMAC_DMA_EN | B_AX_PTCLTOP_EN | B_AX_SCHEDULER_EN | B_AX_TMAC_EN | B_AX_RMAC_EN);
+    match id {
+        ChipId::Rtl8852c => hal.w32_mask(R_AX_LED1_FUNC_SEL, B_AX_PINMUX_EESK_FUNC_SEL_V1_MASK, PINMUX_EESK_FUNC_SEL_BT_LOG),
+        ChipId::Rtl8852bt => hal.w32_mask(R_AX_EECS_EESK_FUNC_SEL, B_AX_PINMUX_EESK_FUNC_SEL_MASK, 1),
+        _ => hal.w32_mask(R_AX_EECS_EESK_FUNC_SEL, B_AX_PINMUX_EESK_FUNC_SEL_MASK, PINMUX_EESK_FUNC_SEL_BT_LOG),
+    }
+    Ok(())
+}
+
+/// Power off (`pwr_off_func`'s essentials): the MAC off, the radio's
+/// supplies down.
+pub(crate) fn power_off(hal: &Hal) {
+    if hal.chip.be {
+        let _ = crate::be::power_off(hal);
+        return;
+    }
+    let _ = hal.write_xtal_si(XTAL_SI_ANAPAR_WL as u8, XTAL_SI_RFC2RF as u8, XTAL_SI_RFC2RF as u8);
+    let _ = hal.write_xtal_si(XTAL_SI_ANAPAR_WL as u8, 0, XTAL_SI_OFF_EI as u8);
+    let _ = hal.write_xtal_si(XTAL_SI_ANAPAR_WL as u8, 0, XTAL_SI_OFF_WEI as u8);
+    hal.set32(R_AX_SYS_PW_CTRL, B_AX_EN_WLON);
+    hal.clr32(R_AX_WLRF_CTRL, B_AX_AFC_AFEDIG);
+    hal.clr8(R_AX_SYS_FUNC_EN, B_AX_FEN_BB_GLB_RSTN | B_AX_FEN_BBRSTB);
+    hal.set32(R_AX_SYS_PW_CTRL, B_AX_APFM_OFFMAC);
+    let _ = hal.poll32(R_AX_SYS_PW_CTRL, |value| value & B_AX_APFM_OFFMAC == 0, 1000, 20_000);
+    hal.w32(R_AX_WLLPS_CTRL, SW_LPS_OPTION);
+    hal.set32(R_AX_SYS_PW_CTRL, B_AX_APFM_SWLPS);
+}
+
+// ---- The eFuse. ----
+
+fn efuse_power_cut(hal: &Hal, on: bool) {
+    if hal.id() == ChipId::Rtl8852a {
+        return;
+    }
+    if on {
+        hal.set8(R_AX_PMC_DBG_CTRL2, B_AX_SYSON_DIS_PMCR_AX_WRMSK);
+        hal.set16(R_AX_SYS_ISO_CTRL, B_AX_PWC_EV2EF_B14);
+        crate::delay_ms(1);
+        hal.set16(R_AX_SYS_ISO_CTRL, B_AX_PWC_EV2EF_B15);
+        hal.clr16(R_AX_SYS_ISO_CTRL, B_AX_ISO_EB2CORE);
+    } else {
+        hal.set16(R_AX_SYS_ISO_CTRL, B_AX_ISO_EB2CORE);
+        hal.clr16(R_AX_SYS_ISO_CTRL, B_AX_PWC_EV2EF_B15);
+        crate::delay_ms(1);
+        hal.clr16(R_AX_SYS_ISO_CTRL, B_AX_PWC_EV2EF_B14);
+        hal.clr8(R_AX_PMC_DBG_CTRL2, B_AX_SYSON_DIS_PMCR_AX_WRMSK);
+    }
+}
+
+/// `rtw89_dump_physical_efuse_map_ddv`.
+fn physical(hal: &Hal, addr: u32, size: u32) -> Result<Vec<u8>, String> {
+    if hal.id() == ChipId::Rtl8852a {
+        hal.w32_mask(R_AX_EFUSE_CTRL_1, B_AX_EF_CELL_SEL_MASK, RTW89_EFUSE_BANK_WIFI);
+    }
+    efuse_power_cut(hal, true);
+    let mut out = Vec::with_capacity(size as usize);
+    for at in addr..addr + size {
+        hal.w32(R_AX_EFUSE_CTRL, field(B_AX_EF_ADDR_MASK, at) & !B_AX_EF_RDY);
+        match hal.poll32(R_AX_EFUSE_CTRL, |value| value & B_AX_EF_RDY != 0, 1, 1_000_000) {
+            Ok(value) => out.push(value as u8),
+            Err(_) => {
+                efuse_power_cut(hal, false);
+                return Err(format!("eFuse byte {at:#x}"));
+            }
+        }
+    }
+    efuse_power_cut(hal, false);
+    Ok(out)
+}
+
+/// `rtw89_dump_physical_efuse_map_dav`: through the crystal's interface.
+fn physical_dav(hal: &Hal, size: u32) -> Result<Vec<u8>, String> {
+    let mut out = Vec::with_capacity(size as usize);
+    for at in 0..size {
+        xtal(hal, XTAL_SI_CTRL, 0x40, FULL_BIT_MASK)?;
+        xtal(hal, XTAL_SI_LOW_ADDR, at & 0xff, XTAL_SI_LOW_ADDR_MASK)?;
+        xtal(hal, XTAL_SI_CTRL, at >> 8, XTAL_SI_HIGH_ADDR_MASK)?;
+        xtal(hal, XTAL_SI_CTRL, 0, XTAL_SI_MODE_SEL_MASK)?;
+        let deadline = crate::now_ms() + 10;
+        loop {
+            if hal.read_xtal_si(XTAL_SI_CTRL as u8).is_ok_and(|value| value as u32 & XTAL_SI_RDY != 0) {
+                break;
+            }
+            if crate::now_ms() > deadline {
+                return Err(format!("DAV eFuse byte {at:#x}"));
+            }
+        }
+        out.push(hal.read_xtal_si(XTAL_SI_READ_VAL as u8).map_err(|()| String::from("DAV eFuse"))?);
+    }
+    Ok(out)
+}
+
+fn efuse_version(hal: &Hal) -> Result<u8, String> {
+    let value = physical(hal, EF_FV_OFSET, 1)?[0];
+    let cv = get(EF_CV_MASK, value as u32) as u8;
+    if cv == EF_CV_INV as u8 { Err(String::from("no eFuse version")) } else { Ok(cv) }
+}
+
+/// `rtw89_dump_logical_efuse_map`: the blocks of the physical map, each a
+/// header (block index, which words follow) and its words.
+fn logical(physical: &[u8], logical_size: usize, sec_ctrl: usize, log: &mut [u8]) {
+    let mut at = sec_ctrl;
+    while at + 1 < physical.len().saturating_sub(sec_ctrl) {
+        let (hdr1, hdr2) = (physical[at], physical[at + 1]);
+        if hdr1 == 0xff || hdr2 == 0xff {
+            break;
+        }
+        let block = (((hdr2 & 0xf0) >> 4) as usize) | (((hdr1 & 0x0f) as usize) << 4);
+        let word_en = hdr2 & 0x0f;
+        at += 2;
+        for word in 0..4 {
+            if word_en & (1 << word) != 0 {
+                continue;
+            }
+            let index = (block << 3) + (word << 1);
+            if at + 1 >= physical.len() || index + 1 >= logical_size {
+                return;
+            }
+            log[index] = physical[at];
+            log[index + 1] = physical[at + 1];
+            at += 2;
+        }
+    }
+}
+
+/// `rtw89_parse_efuse_map_ax` and the chip's `read_efuse`, with the
+/// secure-boot bytes (`rtw89_efuse_read_fw_secure_ax`).
+pub(crate) fn read_efuse(hal: &mut Hal) -> Result<(Efuse, Secure), String> {
+    if hal.chip.be {
+        return crate::be::read_efuse(hal);
+    }
+    hal.efuse_valid = hal.r16(R_AX_SYS_WL_EFUSE_CTRL) as u32 & B_AX_AUTOLOAD_SUS != 0;
+    let chip = hal.chip;
+    let phy = physical(hal, 0, chip.physical_efuse)?;
+    let mut log = vec![0xffu8; (chip.logical_efuse + chip.dav_logical_efuse) as usize];
+    logical(&phy, chip.logical_efuse as usize, 4, &mut log[..chip.logical_efuse as usize]);
+    if chip.dav_physical_efuse > 0
+        && let Ok(dav) = physical_dav(hal, chip.dav_physical_efuse)
+    {
+        let start = chip.logical_efuse as usize;
+        logical(&dav, chip.dav_logical_efuse as usize, 4, &mut log[start..]);
+    }
+    let mut efuse = Efuse::default();
+    efuse.address.copy_from_slice(&log[EFUSE_MAC_ADDR_PCIE..EFUSE_MAC_ADDR_PCIE + 6]);
+    efuse.rfe_type = log[EFUSE_RFE_TYPE];
+    efuse.xtal_cap = log[EFUSE_XTAL_K];
+    efuse.country = [log[EFUSE_COUNTRY], log[EFUSE_COUNTRY + 1]];
+    hal.rfe_type = efuse.rfe_type;
+    hal.xtal_cap = efuse.xtal_cap;
+    // `rtw8852bx_efuse_parsing_tssi`, `rtw8852bx_phycap_parsing_tssi` (and
+    // the RTL8852C's, the same with 6 GHz).
+    let c = hal.id() == ChipId::Rtl8852c;
+    if matches!(hal.id(), ChipId::Rtl8852a | ChipId::Rtl8852b | ChipId::Rtl8852bt | ChipId::Rtl8851b | ChipId::Rtl8852c) {
+        let mut tssi = Tssi::default();
+        for path in 0..2 {
+            let base = EFUSE_8852BX_TSSI[path];
+            tssi.thermal[path] = log[EFUSE_8852BX_THERMAL + path];
+            for (group, value) in tssi.cck[path].iter_mut().enumerate() {
+                *value = log[base + group] as i8;
+            }
+            for (group, value) in tssi.mcs[path].iter_mut().enumerate() {
+                let at = if group < TSSI_MCS_2G_GROUPS { base + EFUSE_8852BX_TSSI_MCS_2G + group } else { base + EFUSE_8852BX_TSSI_MCS_5G + group - TSSI_MCS_2G_GROUPS };
+                *value = log[at] as i8;
+            }
+            if c {
+                for (group, value) in tssi.mcs_6g[path].iter_mut().enumerate() {
+                    *value = log.get(EFUSE_8852C_TSSI_6G[path] + group).copied().unwrap_or(0xff) as i8;
+                }
+            }
+        }
+        let (cap_addr, cap_size) = if c { (PHYCAP_8852C_ADDR, PHYCAP_8852C_SIZE) } else { (PHYCAP_8852BX_ADDR, PHYCAP_8852BX_SIZE) };
+        if let Ok(cap) = physical(hal, cap_addr, cap_size) {
+            let byte_at = |addr: u32| cap.get((addr - cap_addr) as usize).copied().unwrap_or(0xff);
+            let mut programmed = false;
+            for path in 0..2 {
+                for (group, value) in tssi.trim[path].iter_mut().enumerate() {
+                    let byte = byte_at(PHYCAP_8852BX_TSSI_TRIM[path] - group as u32);
+                    programmed |= byte != 0xff;
+                    *value = byte as i8;
+                }
+                if c {
+                    for (group, value) in tssi.trim_6g[path].iter_mut().enumerate() {
+                        let byte = byte_at(PHYCAP_8852C_TSSI_TRIM_6G[path] - group as u32);
+                        programmed |= byte != 0xff;
+                        *value = byte as i8;
+                    }
+                }
+            }
+            if !programmed {
+                tssi.trim = [[0; TSSI_TRIM_GROUPS]; 2];
+                tssi.trim_6g = [[0; TSSI_TRIM_6G_GROUPS]; 2];
+            }
+            // `*_phycap_parsing_thermal_trim`, `*_pa_bias_trim` (the same
+            // addresses on every AX chip).
+            let paths = hal.chip.rf_paths as usize;
+            let thermal = PHYCAP_AX_THERMAL_TRIM.map(byte_at);
+            efuse.thermal_trim = thermal[..paths].iter().any(|&byte| byte != 0xff).then_some(thermal);
+            let bias = PHYCAP_AX_PA_BIAS_TRIM.map(byte_at);
+            efuse.pa_bias_trim = bias[..paths].iter().any(|&byte| byte != 0xff).then_some(bias);
+        }
+        efuse.tssi = Some(tssi);
+    }
+    let sec = physical(hal, EFUSE_EXTERNALPN_ADDR, 2)?;
+    let secure = secure_from_efuse(hal.id(), sec[0], sec[1]);
+    hal.secure_boot = secure.secure_boot;
+    hal.mss_idx = secure.mss_idx;
+    Ok((efuse, secure))
+}
+
+// ---- The data-link engine and the host's flow control. ----
+
+fn check_dmac(hal: &Hal) -> Result<(), String> {
+    let value = hal.r32(R_AX_DMAC_FUNC_EN);
+    if value == u32::MAX || value == 0xeaea_eaea || value == 0xdead_beef || value & (B_AX_MAC_FUNC_EN | B_AX_DMAC_FUNC_EN) != B_AX_MAC_FUNC_EN | B_AX_DMAC_FUNC_EN {
+        return Err(String::from("the DMAC is off"));
+    }
+    Ok(())
+}
+
+/// `rtw89_mac_dle_init`: page sizes and counts, quotas, both engines ready.
+fn dle_init(hal: &Hal, mem: &DleMem, ext_wcpu: Option<u16>) -> Result<(), String> {
+    check_dmac(hal)?;
+    hal.clr32(R_AX_DMAC_FUNC_EN, B_AX_DLE_WDE_EN | B_AX_DLE_PLE_EN);
+    let mut clk = B_AX_DLE_WDE_CLK_EN | B_AX_DLE_PLE_CLK_EN;
+    if hal.id() == ChipId::Rtl8851b {
+        clk |= B_AX_AXIDMA_CLK_EN;
+    }
+    hal.set32(R_AX_DMAC_CLK_EN, clk);
+    // `dle_mix_cfg_ax`.
+    let mut wde = hal.r32(R_AX_WDE_PKTBUF_CFG);
+    let sel = if mem.wde.page == 128 { S_AX_WDE_PAGE_SEL_128 } else { S_AX_WDE_PAGE_SEL_64 };
+    wde = (wde & !B_AX_WDE_PAGE_SEL_MASK) | field(B_AX_WDE_PAGE_SEL_MASK, sel);
+    wde &= !B_AX_WDE_START_BOUND_MASK;
+    wde = (wde & !B_AX_WDE_FREE_PAGE_NUM_MASK) | field(B_AX_WDE_FREE_PAGE_NUM_MASK, mem.wde.linked);
+    hal.w32(R_AX_WDE_PKTBUF_CFG, wde);
+    let bound = (mem.wde.linked + mem.wde.unlinked) * mem.wde.page / DLE_BOUND_UNIT;
+    let mut ple = hal.r32(R_AX_PLE_PKTBUF_CFG);
+    let sel = if mem.ple.page == 256 { S_AX_PLE_PAGE_SEL_256 } else { S_AX_PLE_PAGE_SEL_128 };
+    ple = (ple & !B_AX_PLE_PAGE_SEL_MASK) | field(B_AX_PLE_PAGE_SEL_MASK, sel);
+    ple = (ple & !B_AX_PLE_START_BOUND_MASK) | field(B_AX_PLE_START_BOUND_MASK, bound);
+    ple = (ple & !B_AX_PLE_FREE_PAGE_NUM_MASK) | field(B_AX_PLE_FREE_PAGE_NUM_MASK, mem.ple.linked);
+    hal.w32(R_AX_PLE_PKTBUF_CFG, ple);
+    // The quotas, least and most each (`wde_quota_cfg_ax`, `ple_quota_cfg_ax`).
+    let quota = |reg: u32, min: u16, max: u16, min_mask: u32, max_mask: u32| hal.w32(reg, field(min_mask, min as u32) | field(max_mask, max as u32));
+    let (min, max) = (mem.wde_min, mem.wde_max);
+    let wde_q = |reg, a, b| quota(reg, a, b, B_AX_WDE_MIN_SIZE_MASK, B_AX_WDE_MAX_SIZE_MASK);
+    wde_q(R_AX_WDE_QTA0_CFG, min.hif, max.hif);
+    wde_q(R_AX_WDE_QTA1_CFG, ext_wcpu.unwrap_or(min.wcpu), max.wcpu);
+    wde_q(R_AX_WDE_QTA3_CFG, min.pkt_in, max.pkt_in);
+    wde_q(R_AX_WDE_QTA4_CFG, min.cpu_io, max.cpu_io);
+    let ple_regs = [R_AX_PLE_QTA0_CFG, R_AX_PLE_QTA1_CFG, R_AX_PLE_QTA2_CFG, R_AX_PLE_QTA3_CFG, R_AX_PLE_QTA4_CFG, R_AX_PLE_QTA5_CFG, R_AX_PLE_QTA6_CFG, R_AX_PLE_QTA7_CFG, R_AX_PLE_QTA8_CFG, R_AX_PLE_QTA9_CFG, R_AX_PLE_QTA10_CFG, R_AX_PLE_QTA11_CFG];
+    let count = if hal.id() == ChipId::Rtl8852c { 12 } else { 11 };
+    for (index, reg) in ple_regs.iter().take(count).enumerate() {
+        quota(*reg, mem.ple_min.0[index], mem.ple_max.0[index], B_AX_PLE_MIN_SIZE_MASK, B_AX_PLE_MAX_SIZE_MASK);
+    }
+    hal.set32(R_AX_DMAC_FUNC_EN, B_AX_DLE_WDE_EN | B_AX_DLE_PLE_EN);
+    for (reg, mask, what) in [(R_AX_WDE_INI_STATUS, WDE_MGN_INI_RDY, "WDE"), (R_AX_PLE_INI_STATUS, PLE_MGN_INI_RDY, "PLE")] {
+        if hal.poll32(reg, |value| value & mask == mask, 1, 2000).is_err() {
+            return Err(format!("the {what} did not get ready"));
+        }
+    }
+    Ok(())
+}
+
+/// `rtw89_mac_hfc_init`: for the download only the H2C channel, else each
+/// DMA channel's pages, the public pages, then flow control on.
+fn hfc_init(hal: &Hal, download: bool) -> Result<(), String> {
+    check_dmac(hal)?;
+    let (ch011, h2c, wp07, wp811, ch011_full, h2c_full, wp07_full, wp811_full) = HFC_PREC_PCIE;
+    let page = (R_AX_HCI_FC_CTRL, R_AX_CH_PAGE_CTRL, R_AX_ACH0_PAGE_CTRL, R_AX_PUB_PAGE_CTRL1, R_AX_PUB_PAGE_CTRL2, R_AX_WP_PAGE_CTRL1, R_AX_WP_PAGE_CTRL2);
+    let (fc_ctrl, ch_page, ach_page, pub1, pub2, wp1, wp2) = page;
+    hal.clr32(fc_ctrl, B_AX_HCI_FC_EN | B_AX_HCI_FC_CH12_EN);
+    if download {
+        hal.w32(ch_page, field(B_AX_PREC_PAGE_CH12_MASK, h2c as u32));
+        hal.w32_mask(fc_ctrl, B_AX_HCI_FC_CH12_FULL_COND_MASK, h2c_full as u32);
+        hal.set32(fc_ctrl, B_AX_HCI_FC_CH12_EN);
+        return Ok(());
+    }
+    let hfc = &hal.chip.hfc;
+    for (channel, &(min, max, group)) in hfc.channels.iter().enumerate() {
+        if hal.chip.dma_ch_mask & (1 << channel) != 0 {
+            continue;
+        }
+        hal.w32(ach_page + channel as u32 * 4, field(B_AX_MIN_PG_MASK, min as u32) | field(B_AX_MAX_PG_MASK, max as u32) | if group { B_AX_GRP } else { 0 });
+    }
+    let (g0, g1, pub_max, wp_thrd) = hfc.public;
+    hal.w32(pub1, field(B_AX_PUBPG_G0_MASK, g0 as u32) | field(B_AX_PUBPG_G1_MASK, g1 as u32));
+    hal.w32(wp2, field(B_AX_WP_THRD_MASK, wp_thrd as u32));
+    // `hfc_mix_cfg_ax`.
+    hal.w32(ch_page, field(B_AX_PREC_PAGE_CH011_MASK, ch011 as u32) | field(B_AX_PREC_PAGE_CH12_MASK, h2c as u32));
+    hal.w32(pub2, field(B_AX_PUBPG_ALL_MASK, pub_max as u32));
+    hal.w32(wp1, field(B_AX_PREC_PAGE_WP_CH07_MASK, wp07 as u32) | field(B_AX_PREC_PAGE_WP_CH811_MASK, wp811 as u32));
+    let mut ctrl = hal.r32(fc_ctrl);
+    let replace = |value: u32, mask: u32, new: u32| (value & !mask) | field(mask, new);
+    ctrl = replace(ctrl, B_AX_HCI_FC_MODE_MASK, RTW89_HCIFC_POH);
+    ctrl = replace(ctrl, B_AX_HCI_FC_WD_FULL_COND_MASK, ch011_full as u32);
+    ctrl = replace(ctrl, B_AX_HCI_FC_CH12_FULL_COND_MASK, h2c_full as u32);
+    ctrl = replace(ctrl, B_AX_HCI_FC_WP_CH07_FULL_COND_MASK, wp07_full as u32);
+    ctrl = replace(ctrl, B_AX_HCI_FC_WP_CH811_FULL_COND_MASK, wp811_full as u32);
+    hal.w32(fc_ctrl, ctrl);
+    hal.set32(fc_ctrl, B_AX_HCI_FC_EN | B_AX_HCI_FC_CH12_EN);
+    crate::delay_us(10);
+    Ok(())
+}
+
+/// `rtw89_mac_dmac_pre_init`: what the download needs.
+pub(crate) fn dmac_pre_init(hal: &Hal) -> Result<(), String> {
+    let id = hal.id();
+    let mut func = B_AX_MAC_FUNC_EN | B_AX_DMAC_FUNC_EN | B_AX_DISPATCHER_EN | B_AX_PKT_BUF_EN;
+    if id == ChipId::Rtl8852c {
+        func |= B_AX_H_AXIDMA_EN;
+    }
+    hal.w32(R_AX_DMAC_FUNC_EN, func);
+    let clk = if matches!(id, ChipId::Rtl8851b | ChipId::Rtl8852bt) { B_AX_DISPATCHER_CLK_EN | B_AX_AXIDMA_CLK_EN } else { B_AX_DISPATCHER_CLK_EN };
+    hal.w32(R_AX_DMAC_CLK_EN, clk);
+    if id == ChipId::Rtl8852c {
+        let mut value = hal.r32(R_AX_HAXI_INIT_CFG1) & !(B_AX_DMA_MODE_MASK | B_AX_STOP_AXI_MST);
+        value |= B_AX_TXHCI_EN_V1 | B_AX_RXHCI_EN_V1 | field(B_AX_DMA_MODE_MASK, DMA_MOD_PCIE_1B);
+        hal.w32(R_AX_HAXI_INIT_CFG1, value);
+        hal.clr32(R_AX_HAXI_DMA_STOP1, B_AX_STOP_ACH0 | B_AX_STOP_ACH1 | B_AX_STOP_ACH3 | B_AX_STOP_ACH4 | B_AX_STOP_ACH5 | B_AX_STOP_ACH6 | B_AX_STOP_ACH7 | B_AX_STOP_CH8 | B_AX_STOP_CH9 | B_AX_STOP_CH12 | B_AX_STOP_ACH2);
+        hal.clr32(R_AX_HAXI_DMA_STOP2, B_AX_STOP_CH10 | B_AX_STOP_CH11);
+        hal.set32(R_AX_PLATFORM_ENABLE, B_AX_AXIDMA_EN);
+    }
+    dle_init(hal, &hal.chip.dlfw, Some(hal.chip.scc.wde_min.wcpu))?;
+    hfc_init(hal, true)
+}
+
+/// `sys_init_ax`: the DMAC's and CMAC's functions and clocks.
+pub(crate) fn sys_init(hal: &Hal) {
+    let id = hal.id();
+    let mut func = B_AX_MAC_FUNC_EN | B_AX_DMAC_FUNC_EN | B_AX_MAC_SEC_EN | B_AX_DISPATCHER_EN | B_AX_DLE_CPUIO_EN | B_AX_PKT_IN_EN | B_AX_DMAC_TBL_EN | B_AX_PKT_BUF_EN | B_AX_STA_SCH_EN | B_AX_TXPKT_CTRL_EN | B_AX_WD_RLS_EN | B_AX_MPDU_PROC_EN | B_AX_DMAC_CRPRT;
+    if id == ChipId::Rtl8852c {
+        func |= B_AX_H_AXIDMA_EN;
+    }
+    hal.w32(R_AX_DMAC_FUNC_EN, func);
+    let mut clk = B_AX_MAC_SEC_CLK_EN | B_AX_DISPATCHER_CLK_EN | B_AX_DLE_CPUIO_CLK_EN | B_AX_PKT_IN_CLK_EN | B_AX_STA_SCH_CLK_EN | B_AX_TXPKT_CTRL_CLK_EN | B_AX_WD_RLS_CLK_EN | B_AX_BBRPT_CLK_EN;
+    if id == ChipId::Rtl8852bt {
+        clk |= B_AX_AXIDMA_CLK_EN;
+    }
+    hal.w32(R_AX_DMAC_CLK_EN, clk);
+    hal.set32(R_AX_CK_EN, B_AX_CMAC_CKEN | B_AX_PHYINTF_CKEN | B_AX_CMAC_DMA_CKEN | B_AX_PTCLTOP_CKEN | B_AX_SCHEDULER_CKEN | B_AX_TMAC_CKEN | B_AX_RMAC_CKEN);
+    hal.set32(R_AX_CMAC_FUNC_EN, B_AX_CMAC_EN | B_AX_CMAC_TXEN | B_AX_CMAC_RXEN | B_AX_PHYINTF_EN | B_AX_CMAC_DMA_EN | B_AX_PTCLTOP_EN | B_AX_SCHEDULER_EN | B_AX_TMAC_EN | B_AX_RMAC_EN | B_AX_CMAC_CRPRT);
+    if id == ChipId::Rtl8852a || hal.is_885xb() {
+        hal.set32(R_AX_SPS_DIG_ON_CTRL0, B_AX_OCP_L1_MASK);
+    }
+}
+
+/// `trx_init_ax`: the DMAC (engines, flow control, scheduler, MPDU
+/// processing, security) and the CMAC (scheduler, address CAM, filters,
+/// CCA, NAV, TMAC, protocol, RMAC), release reports to the host.
+pub(crate) fn trx_init(hal: &Hal, rx_filter: u32) -> Result<(), String> {
+    let id = hal.id();
+    let xb = hal.is_885xb();
+    let scc = &hal.chip.scc;
+    dle_init(hal, scc, None)?;
+    // `preload_init_set_ax` (the RTL8852C only).
+    if id == ChipId::Rtl8852c {
+        hal.w32_mask(R_AX_TXPKTCTL_B0_PRELD_CFG0, B_AX_B0_PRELD_USEMAXSZ_MASK, PRELD_B0_ENT_NUM * PRELD_AMSDU_SIZE);
+        hal.set32(R_AX_TXPKTCTL_B0_PRELD_CFG0, B_AX_B0_PRELD_FEN);
+        hal.w32_mask(R_AX_TXPKTCTL_B0_PRELD_CFG1, B_AX_B0_PRELD_NXT_TXENDWIN_MASK, PRELD_NEXT_WND);
+        hal.w32_mask(R_AX_TXPKTCTL_B0_PRELD_CFG1, B_AX_B0_PRELD_NXT_RSVMINSZ_MASK, PRELD_AMSDU_SIZE);
+    }
+    hfc_init(hal, false)?;
+    // `sta_sch_init_ax`.
+    hal.set8(R_AX_SS_CTRL, B_AX_SS_EN);
+    if hal.poll32(R_AX_SS_CTRL, |value| value & B_AX_SS_INIT_DONE_1 != 0, 1, TRXCFG_WAIT_CNT as u64).is_err() {
+        return Err(String::from("the station scheduler did not start"));
+    }
+    hal.set32(R_AX_SS_CTRL, B_AX_SS_WARM_INIT_FLG);
+    hal.clr32(R_AX_SS_CTRL, B_AX_SS_NONEMPTY_SS2FINFO_EN);
+    if !(id == ChipId::Rtl8852a || xb) {
+        hal.w32_mask(R_AX_SS2FINFO_PATH, B_AX_SS_DEST_QUEUE_MASK, SS2F_PATH_WLCPU);
+    }
+    // `mpdu_proc_init_ax`.
+    hal.w32(R_AX_ACTION_FWD0, TRXCFG_MPDU_PROC_ACT_FRWD);
+    hal.w32(R_AX_TF_FWD, TRXCFG_MPDU_PROC_TF_FRWD);
+    hal.set32(R_AX_MPDU_PROC, B_AX_APPEND_FCS | B_AX_A_ICV_ERR);
+    hal.w32(R_AX_CUT_AMSDU_CTRL, TRXCFG_MPDU_PROC_CUT_CTRL);
+    // `sec_eng_init_ax`.
+    let mut sec = hal.r32(R_AX_SEC_ENG_CTRL) | B_AX_CLK_EN_CGCMP | B_AX_CLK_EN_WAPI | B_AX_CLK_EN_WEP_TKIP | B_AX_SEC_TX_ENC | B_AX_SEC_RX_DEC | B_AX_MC_DEC | B_AX_BC_DEC;
+    if id == ChipId::Rtl8852c {
+        sec |= B_AX_UC_MGNT_DEC;
+    }
+    if matches!(id, ChipId::Rtl8852a | ChipId::Rtl8852b | ChipId::Rtl8851b) {
+        sec &= !B_AX_TX_PARTIAL_MODE;
+    }
+    hal.w32(R_AX_SEC_ENG_CTRL, sec);
+    hal.set32(R_AX_SEC_MPDU_PROC, B_AX_APPEND_ICV | B_AX_APPEND_MIC);
+    if id == ChipId::Rtl8852c {
+        hal.w32_mask(R_AX_SEC_DEBUG1, B_AX_TX_TIMEOUT_SEL_MASK, AX_TX_TO_VAL);
+    }
+    cmac_init(hal, rx_filter, scc)?;
+    // `set_host_rpr_ax` for PCIe: release reports to the host.
+    hal.w32_mask(R_AX_WDRLS_CFG, B_AX_WDRLS_MODE_MASK, RTW89_RPR_MODE_POH);
+    hal.set32(R_AX_RLSRPT0_CFG0, B_AX_RLSRPT0_FLTR_MAP_MASK);
+    hal.w32_mask(R_AX_RLSRPT0_CFG1, B_AX_RLSRPT0_AGGNUM_MASK, 30);
+    hal.w32_mask(R_AX_RLSRPT0_CFG1, B_AX_RLSRPT0_TO_MASK, 255);
+    if id == ChipId::Rtl8852c {
+        hal.clr32(R_AX_RSP_CHK_SIG, B_AX_RSP_STATIC_RTS_CHK_SERV_BW_EN);
+    }
+    Ok(())
+}
+
+fn cmac_init(hal: &Hal, rx_filter: u32, scc: &DleMem) -> Result<(), String> {
+    let id = hal.id();
+    let xb = hal.is_885xb();
+    if hal.r32(R_AX_CMAC_FUNC_EN) & B_AX_CMAC_EN == 0 {
+        return Err(String::from("the CMAC is off"));
+    }
+    // `scheduler_init_ax`.
+    hal.w32_mask(R_AX_PREBKF_CFG_1, B_AX_SIFS_MACTXEN_T1_MASK, if id == ChipId::Rtl8852c { SIFS_MACTXEN_T1_V1 } else { SIFS_MACTXEN_T1 });
+    if xb {
+        hal.set32(R_AX_SCH_EXT_CTRL, B_AX_PORT_RST_TSF_ADV);
+    }
+    hal.clr32(R_AX_CCA_CFG_0, B_AX_BTCCA_EN);
+    if id != ChipId::Rtl8852c || hal.r32(R_AX_SEC_ENG_CTRL) & B_AX_TX_PARTIAL_MODE == 0 {
+        hal.w32_mask(R_AX_PREBKF_CFG_0, B_AX_PREBKF_TIME_MASK, SCH_PREBKF_24US);
+    }
+    // `addr_cam_init_ax`.
+    let cam = hal.r32(R_AX_ADDR_CAM_CTRL) | field(B_AX_ADDR_CAM_RANGE_MASK, 0x7f) | B_AX_ADDR_CAM_CLR | B_AX_ADDR_CAM_EN;
+    hal.w32(R_AX_ADDR_CAM_CTRL, cam);
+    if aster_linuxkpi::delay::read_poll_timeout(|| hal.r16(R_AX_ADDR_CAM_CTRL), |value| *value as u32 & B_AX_ADDR_CAM_CLR == 0, 1, TRXCFG_WAIT_CNT as u64).is_err() {
+        return Err(String::from("the address CAM did not clear"));
+    }
+    // `rx_fltr_init_ax`: every frame type to the host.
+    for reg in [R_AX_MGNT_FLTR, R_AX_CTRL_FLTR, R_AX_DATA_FLTR] {
+        hal.w32(reg, RX_FLTR_FRAME_TO_HOST);
+    }
+    hal.w32(R_AX_RX_FLTR_OPT, rx_filter);
+    hal.w16(R_AX_PLCP_HDR_FLTR, (B_AX_CCK_CRC_CHK | B_AX_CCK_SIG_CHK | B_AX_LSIG_PARITY_CHK_EN | B_AX_SIGA_CRC_CHK | B_AX_VHT_SU_SIGB_CRC_CHK | B_AX_VHT_MU_SIGB_CRC_CHK | B_AX_HE_SIGB_CRC_CHK) as u16);
+    // `cca_ctrl_init_ax` and `_patch_dis_resp_chk`.
+    let mut cca = hal.r32(R_AX_CCA_CONTROL);
+    cca |= B_AX_TB_CHK_BASIC_NAV | B_AX_TB_CHK_BTCCA | B_AX_TB_CHK_EDCCA | B_AX_TB_CHK_CCA_P20 | B_AX_SIFS_CHK_BTCCA | B_AX_SIFS_CHK_CCA_P20 | B_AX_CTN_CHK_INTRA_NAV | B_AX_CTN_CHK_BASIC_NAV | B_AX_CTN_CHK_BTCCA | B_AX_CTN_CHK_EDCCA | B_AX_CTN_CHK_CCA_S80 | B_AX_CTN_CHK_CCA_S40 | B_AX_CTN_CHK_CCA_S20 | B_AX_CTN_CHK_CCA_P20;
+    cca &= !(B_AX_TB_CHK_TX_NAV | B_AX_TB_CHK_CCA_S80 | B_AX_TB_CHK_CCA_S40 | B_AX_TB_CHK_CCA_S20 | B_AX_SIFS_CHK_CCA_S80 | B_AX_SIFS_CHK_CCA_S40 | B_AX_SIFS_CHK_CCA_S20 | B_AX_CTN_CHK_TXNAV | B_AX_SIFS_CHK_EDCCA);
+    hal.w32(R_AX_CCA_CONTROL, cca);
+    let nav = B_AX_RSP_CHK_TXNAV | B_AX_RSP_CHK_INTRA_NAV | B_AX_RSP_CHK_BASIC_NAV;
+    let rsp_cca = B_AX_RSP_CHK_SEC_CCA_80 | B_AX_RSP_CHK_SEC_CCA_40 | B_AX_RSP_CHK_SEC_CCA_20 | B_AX_RSP_CHK_BTCCA | B_AX_RSP_CHK_EDCCA | B_AX_RSP_CHK_CCA;
+    if matches!(id, ChipId::Rtl8852a | ChipId::Rtl8852b) {
+        hal.clr32(R_AX_RSP_CHK_SIG, nav);
+        hal.clr32(R_AX_TRXPTCL_RESP_0, rsp_cca);
+    } else {
+        hal.set32(R_AX_RSP_CHK_SIG, nav);
+        hal.set32(R_AX_TRXPTCL_RESP_0, rsp_cca);
+    }
+    // `nav_ctrl_init_ax`, `spatial_reuse_init_ax`, `tmac_init_ax`.
+    hal.set32(R_AX_WMAC_NAV_CTL, B_AX_WMAC_PLCP_UP_NAV_EN | B_AX_WMAC_TF_UP_NAV_EN | B_AX_WMAC_NAV_UPPER_EN);
+    hal.w32_mask(R_AX_WMAC_NAV_CTL, B_AX_WMAC_NAV_UPPER_MASK, NAV_25MS);
+    hal.clr8(R_AX_RX_SR_CTRL, B_AX_SR_EN);
+    hal.set8(R_AX_BSSID_SRC_CTRL, B_AX_PLCP_SRC_EN);
+    hal.clr32(R_AX_MAC_LOOPBACK, B_AX_MACLBK_EN);
+    hal.w32_mask(R_AX_TCR0, B_AX_TCR_UDF_THSD_MASK, TCR_UDF_THSD);
+    hal.w32_mask(R_AX_TXD_FIFO_CTRL, B_AX_TXDFIFO_HIGH_MCS_THRE_MASK, TXDFIFO_HIGH_MCS_THRE);
+    hal.w32_mask(R_AX_TXD_FIFO_CTRL, B_AX_TXDFIFO_LOW_MCS_THRE_MASK, TXDFIFO_LOW_MCS_THRE);
+    // `trxptcl_init_ax`.
+    let mut resp = hal.r32(R_AX_TRXPTCL_RESP_0);
+    resp = (resp & !B_AX_WMAC_SPEC_SIFS_CCK_MASK) | field(B_AX_WMAC_SPEC_SIFS_CCK_MASK, WMAC_SPEC_SIFS_CCK);
+    let sifs = match id {
+        ChipId::Rtl8852a => WMAC_SPEC_SIFS_OFDM_52A,
+        ChipId::Rtl8852c => WMAC_SPEC_SIFS_OFDM_52C,
+        _ => WMAC_SPEC_SIFS_OFDM_52B,
+    };
+    resp = (resp & !B_AX_WMAC_SPEC_SIFS_OFDM_MASK) | field(B_AX_WMAC_SPEC_SIFS_OFDM_MASK, sifs);
+    hal.w32(R_AX_TRXPTCL_RESP_0, resp);
+    hal.set32(R_AX_RXTRIG_TEST_USER_2, B_AX_RXTRIG_FCSCHK_EN);
+    if id == ChipId::Rtl8852c {
+        hal.w32_mask(R_AX_TRXPTCL_RRSR_CTL_0, B_AX_WMAC_RESP_REF_RATE_SEL, 0);
+        hal.w32_mask(R_AX_TRXPTCL_RRSR_CTL_0, B_AX_WMAC_RESP_RSC_MASK, 2);
+    } else {
+        hal.w32_mask(R_AX_TRXPTCL_RRSR_CTL_0, B_AX_WMAC_RESP_REF_RATE_SEL, 0);
+        hal.w32_mask(R_AX_TRXPTCL_RRSR_CTL_0, B_AX_WMAC_RESP_RSC_MASK, 2);
+    }
+    // `rmac_init_ax`.
+    hal.w32_mask(R_AX_RESPBA_CAM_CTRL, B_AX_BACAM_RST_MASK, S_AX_BACAM_RST_ALL);
+    let _ = aster_linuxkpi::delay::read_poll_timeout(|| hal.r32_mask(R_AX_RESPBA_CAM_CTRL, B_AX_BACAM_RST_MASK), |value| *value == 0, 1, 1000);
+    hal.set8(R_AX_RESPBA_CAM_CTRL, B_AX_SSN_SEL);
+    let mut dlk = hal.r16(R_AX_DLK_PROTECT_CTL) as u32;
+    dlk = (dlk & !B_AX_RX_DLK_DATA_TIME_MASK) | field(B_AX_RX_DLK_DATA_TIME_MASK, 15);
+    dlk = (dlk & !B_AX_RX_DLK_CCA_TIME_MASK) | field(B_AX_RX_DLK_CCA_TIME_MASK, 32);
+    if id == ChipId::Rtl8852bt {
+        dlk |= B_AX_RX_DLK_RST_EN;
+    }
+    hal.w16(R_AX_DLK_PROTECT_CTL, dlk as u16);
+    hal.w8_mask(R_AX_RCR, B_AX_CH_EN_MASK, 1);
+    let rx_quota = (scc.ple_min.0[6] as u32).min(127);
+    let max_len = (rx_quota * scc.ple.page).min(11454 + 512) / 512;
+    hal.w32_mask(R_AX_RX_FLTR_OPT, B_AX_RX_MPDU_MAX_LEN_MASK, max_len);
+    if id == ChipId::Rtl8852a && hal.cv == CHIP_CBV as u8 {
+        hal.w16_mask(R_AX_DLK_PROTECT_CTL, B_AX_RX_DLK_CCA_TIME_MASK, 0);
+        hal.set16(R_AX_RCR, 1 << 12);
+    }
+    hal.clr8(R_AX_PLCP_HDR_FLTR, B_AX_VHT_SU_SIGB_CRC_CHK);
+    // `cmac_com_init_ax`.
+    let mut sc = hal.r32(R_AX_TX_SUB_CARRIER_VALUE);
+    sc &= !(B_AX_TXSC_20M_MASK | B_AX_TXSC_40M_MASK | B_AX_TXSC_80M_MASK);
+    hal.w32(R_AX_TX_SUB_CARRIER_VALUE, sc);
+    if id == ChipId::Rtl8852a || xb {
+        hal.w32_mask(R_AX_PTCL_RRSR1, B_AX_RRSR_RATE_EN_MASK, RRSR_OFDM_CCK_EN);
+    }
+    // `ptcl_init_ax`.
+    let mut sifs_set = hal.r32(R_AX_SIFS_SETTING);
+    sifs_set = (sifs_set & !B_AX_HW_CTS2SELF_PKT_LEN_TH_MASK) | field(B_AX_HW_CTS2SELF_PKT_LEN_TH_MASK, S_AX_CTS2S_TH_1K);
+    sifs_set = (sifs_set & !B_AX_HW_CTS2SELF_PKT_LEN_TH_TWW_MASK) | field(B_AX_HW_CTS2SELF_PKT_LEN_TH_TWW_MASK, S_AX_CTS2S_TH_SEC_256B);
+    hal.w32(R_AX_SIFS_SETTING, sifs_set | B_AX_HW_CTS2SELF_EN);
+    let mut fsm = hal.r32(R_AX_PTCL_FSM_MON);
+    fsm = (fsm & !B_AX_PTCL_TX_ARB_TO_THR_MASK) | field(B_AX_PTCL_TX_ARB_TO_THR_MASK, S_AX_PTCL_TO_2MS);
+    hal.w32(R_AX_PTCL_FSM_MON, fsm & !B_AX_PTCL_TX_ARB_TO_MODE);
+    hal.set8(R_AX_PTCL_COMMON_SETTING_0, B_AX_CMAC_TX_MODE_0 | B_AX_CMAC_TX_MODE_1);
+    hal.clr8(R_AX_PTCL_COMMON_SETTING_0, B_AX_PTCL_TRIGGER_SS_EN_0 | B_AX_PTCL_TRIGGER_SS_EN_1 | B_AX_PTCL_TRIGGER_SS_EN_UL);
+    hal.w8_mask(R_AX_PTCLRPT_FULL_HDL, B_AX_SPE_RPT_PATH_MASK, FWD_TO_WLCPU);
+    if id == ChipId::Rtl8852a || xb {
+        hal.w32_mask(R_AX_AGG_LEN_VHT_0, B_AX_AMPDU_MAX_LEN_VHT_MASK, 0x3ff80);
+    }
+    // `cmac_dma_init_ax`.
+    if xb {
+        hal.clr8(R_AX_RXDMA_CTRL_0, RX_FULL_MODE);
+    }
+    Ok(())
+}
+
+/// The chip's `enable_bb_rf`: the baseband out of reset, the RF on.
+pub(crate) fn enable_bb_rf(hal: &Hal) -> Result<(), String> {
+    hal.set8(R_AX_SYS_FUNC_EN, B_AX_FEN_BBRSTB | B_AX_FEN_BB_GLB_RSTN);
+    match hal.id() {
+        ChipId::Rtl8852a => {
+            hal.set32(R_AX_WLRF_CTRL, B_AX_WLRF1_CTRL_7 | B_AX_WLRF1_CTRL_1 | B_AX_WLRF_CTRL_7 | B_AX_WLRF_CTRL_1);
+            hal.set8(R_AX_PHYREG_SET, PHYREG_SET_ALL_CYCLE);
+        }
+        id => {
+            if matches!(id, ChipId::Rtl8852b | ChipId::Rtl8852bt) {
+                hal.w32_mask(R_AX_SPS_DIG_ON_CTRL0, B_AX_REG_ZCDC_H_MASK, 1);
+            }
+            hal.set32(R_AX_WLRF_CTRL, B_AX_AFC_AFEDIG);
+            hal.clr32(R_AX_WLRF_CTRL, B_AX_AFC_AFEDIG);
+            hal.set32(R_AX_WLRF_CTRL, B_AX_AFC_AFEDIG);
+            if matches!(id, ChipId::Rtl8852bt | ChipId::Rtl8852c) {
+                hal.w32_mask(R_AX_AFE_OFF_CTRL1, B_AX_S0_LDO_VSEL_F_MASK, 1);
+                hal.w32_mask(R_AX_AFE_OFF_CTRL1, B_AX_S1_LDO_VSEL_F_MASK, 1);
+            }
+            if id == ChipId::Rtl8852c {
+                xtal(hal, XTAL0, 0x7, FULL_BIT_MASK)?;
+                xtal(hal, XTAL_SI_ANAPAR_WL, 0x6c, FULL_BIT_MASK)?;
+            }
+            xtal(hal, XTAL_SI_WL_RFC_S0, 0xc7, FULL_BIT_MASK)?;
+            xtal(hal, XTAL_SI_WL_RFC_S1, 0xc7, FULL_BIT_MASK)?;
+            if id == ChipId::Rtl8852c {
+                xtal(hal, XTAL3, 0xd, FULL_BIT_MASK)?;
+            } else {
+                hal.w8(R_AX_PHYREG_SET, PHYREG_SET_XYN_CYCLE as u8);
+            }
+        }
+    }
+    Ok(())
+}
