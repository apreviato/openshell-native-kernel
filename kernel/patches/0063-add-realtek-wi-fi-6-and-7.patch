+/// `rtw8922a_rfk_pll_init` (`rtw8922a_rfk_hw_init` on one band).
+pub(crate) fn rfk_hw_init(hal: &Hal) {
+    for (offset, set, clear) in [(XTAL_SI_PLL_1, 0xf8, 0), (XTAL_SI_APBT, 0, 0x60), (XTAL_SI_XTAL_PLL, 0x38, 0)] {
+        let Ok(value) = hal.read_xtal_si(offset as u8) else { return };
+        if xtal(hal, offset, ((value as u32) | set) & !clear, 0xff).is_err() {
+            return;
+        }
+    }
+}
