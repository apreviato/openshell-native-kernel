+++ b/kernel/comps/rtw89/src/rtw8851b_rfk.rs
@@ -0,0 +1,1103 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The RTL8851B's calibrations on the host, as Linux's `rtw8851b_rfk.c`
+//! runs them on its one path: the ADC's (AACK) and the DAC's (DACK, with
+//! the new DADCK) at power on, the RX DC offset (its result swapped into
+//! the RX baseband's table), the IQ imbalance (IQK: the LO leakage over
+//! ten gains, TX and RX by gain groups), the digital predistortion (DPK
+//! and its thermal tracking), the TX power's closed loop (TSSI) and the
+//! LO's calibration again with the temperature (LCK).
+
+use crate::{
+    chan::Chan,
+    fw::TxPowerTrack,
+    hal::{Hal, MASKBYTE0, MASKBYTE2, MASKBYTE3, MASKDWORD, MASKHWORD, MASKLWORD, RFREG_MASK},
+    mac::Tssi,
+    phy::{self, rfk},
+    regs::*,
+    rfk_tables::*,
+    rtw8852b_rfk::{self, CFIR_FAILED, CFIR_WIDE, NCTL_DONE, Thermal, sign_extend12},
+};
+
+/// `rtw8851b_backup_bb_regs`, `_rf_regs`; the DPK's (`dpk_kip_reg`,
+/// `dpk_rf_reg`).
+const BACKUP_BB_REGS: [u32; 7] = [0xc0d4, 0xc0d8, 0xc0c4, 0xc0ec, 0xc0e8, 0x12a0, 0xc0f0];
+const BACKUP_RF_REGS: [u32; 8] = [0xef, 0xde, 0x0, 0x1e, 0x2, 0x85, 0x90, 0x5];
+const DPK_KIP_REGS: [u32; 8] = [0x813c, 0x8124, 0xc0ec, 0xc0e8, 0xc0c4, 0xc0d4, 0xc0d8, 0x12a0];
+const DPK_RF_REGS: [u32; 4] = [0xde, 0x8f, 0x5, 0x10005];
+
+/// The RX gain groups by band (`g_idx*`, `a_idx*`), the TX ones (one on
+/// 2.4 GHz, two on 5 GHz with their mixer attenuation and table index).
+const G_RXGAIN: [u32; 4] = [0x10e, 0x116, 0x28e, 0x296];
+const G_ATTC2: [u32; 4] = [0x0, 0xf, 0x0, 0xf];
+const G_RXAGC: [u32; 4] = [0x0, 0x1, 0x2, 0x3];
+const A_RXGAIN: [u32; 4] = [0x10c, 0x112, 0x28c, 0x292];
+const A_ATTC2: [u32; 4] = [0xf, 0xf, 0xf, 0xf];
+const A_RXAGC: [u32; 4] = [0x4, 0x5, 0x6, 0x7];
+const A_TRACK_RANGE: [u32; 2] = [0x7, 0x7];
+const A_GAIN_BB: [u32; 2] = [0x08, 0x0d];
+const A_ITQT: [u32; 2] = [0x12, 0x12];
+const A_ATT_SMXR: [u32; 2] = [0x0, 0x2];
+const A_IDX: [u32; 2] = [2, 3];
+const G_TRACK_RANGE: u32 = 0x6;
+const G_GAIN_BB: u32 = 0x10;
+const G_ITQT: u32 = 0x12;
+/// The LO leakage's ten gains (`RTW8851B_LOK_GRAM`): TX baseband gain,
+/// tone, table address by band.
+const LOK_TXBB: [u32; 10] = [0x02, 0x06, 0x0a, 0x0c, 0x0e, 0x10, 0x12, 0x14, 0x16, 0x17];
+const G_LOK_ITQT: [u32; 10] = [0x09, 0x09, 0x09, 0x09, 0x09, 0x09, 0x12, 0x12, 0x12, 0x1b];
+const A_LOK_ITQT: [u32; 10] = [0x09, 0x09, 0x09, 0x12, 0x12, 0x12, 0x1b, 0x1b, 0x1b, 0x1b];
+const G_LOK_WA: [u32; 10] = [0x00, 0x04, 0x08, 0x0c, 0x0e, 0x10, 0x12, 0x14, 0x16, 0x17];
+const A_LOK_WA: [u32; 10] = [0x80, 0x84, 0x88, 0x8c, 0x8e, 0x90, 0x92, 0x94, 0x96, 0x97];
+
+/// The NCTL report's readiness.
+const REPORT_READY: u32 = 0x8000;
+/// `enum rf_mode`: RX, DPK.
+const RF_RX: u32 = 0x3;
+const RF_DPK: u32 = 0x5;
+/// `enum dac_ck`, `enum adc_ck`.
+const DAC_960M: u32 = 7;
+const ADC_960M: u32 = 2;
+const ADC_1920M: u32 = 3;
+/// `RR_RXA2`'s bit for the RX IQK on 5 GHz.
+const RR_RXA2_IQK_SW: u32 = 0x20;
+
+fn poll(done: impl Fn() -> bool, step_us: u64, timeout_us: u64) -> bool {
+    aster_linuxkpi::delay::read_poll_timeout(&done, |ok| *ok, step_us, timeout_us).is_ok()
+}
+
+/// `_wait_rx_mode` of path A.
+fn wait_rx_mode(hal: &Hal) {
+    let _ = aster_linuxkpi::delay::read_poll_timeout(|| hal.read_rf(0, RR_MOD, RR_MOD_MASK), |mode| *mode != 2, 2, 5000);
+}
+
+/// `_txck_force`.
+fn txck_force(hal: &Hal, force: bool, ck: u32) {
+    hal.phy_w32_mask(R_P0_RXCK, B_P0_TXCK_ON, 0);
+    if force {
+        hal.phy_w32_mask(R_P0_RXCK, B_P0_TXCK_VAL, ck);
+        hal.phy_w32_mask(R_P0_RXCK, B_P0_TXCK_ON, 1);
+    }
+}
+
+/// `_rxck_force`: the ADC's clock with its filter, multiplier, power and
+/// adjustment (`ck960_8851b`, `ck1920_8851b`).
+fn rxck_force(hal: &Hal, force: bool, ck: u32) {
+    const CK960: [u32; 7] = [0x8, 0x2, 0x2, 0x4, 0xf, 0xa, 0x92];
+    const CK1920: [u32; 7] = [0x9, 0x0, 0x0, 0x3, 0xf, 0xa, 0x49];
+    hal.phy_w32_mask(R_P0_RXCK, B_P0_RXCK_ON, 0);
+    if !force {
+        return;
+    }
+    hal.phy_w32_mask(R_P0_RXCK, B_P0_RXCK_VAL, ck);
+    hal.phy_w32_mask(R_P0_RXCK, B_P0_RXCK_ON, 1);
+    let data = if ck == ADC_960M { CK960 } else { CK1920 };
+    hal.phy_w32_mask(R_P0_CFCH_BW0, B_P0_CFCH_CTL, data[0]);
+    hal.phy_w32_mask(R_P0_CFCH_BW0, B_P0_CFCH_EN, data[1]);
+    hal.phy_w32_mask(R_P0_CFCH_BW0, B_P0_CFCH_BW0, data[2]);
+    hal.phy_w32_mask(R_P0_CFCH_BW1, B_P0_CFCH_BW1, data[3]);
+    hal.phy_w32_mask(R_DRCK, B_DRCK_MUL, data[4]);
+    hal.phy_w32_mask(R_ADCMOD, B_ADCMOD_LP, data[5]);
+    hal.phy_w32_mask(R_P0_RXCK, B_P0_RXCK_ADJ, data[6]);
+}
+
+// ---- DACK. ----
+
+/// `_drck`.
+fn drck(hal: &Hal) {
+    hal.phy_w32_mask(R_DRCK, B_DRCK_IDLE, 1);
+    hal.phy_w32_mask(R_DRCK, B_DRCK_EN, 1);
+    poll(|| hal.phy_r32_mask(R_DRCK_RES, B_DRCK_POL) != 0, 1, 10_000);
+    hal.phy_w32_mask(R_DRCK, B_DRCK_EN, 0);
+    hal.phy_w32_mask(R_DRCK_FH, B_DRCK_LAT, 1);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_DRCK_FH, B_DRCK_LAT, 0);
+    let rck_d = hal.phy_r32_mask(R_DRCK_RES, 0x7c00);
+    hal.phy_w32_mask(R_DRCK, B_DRCK_IDLE, 0);
+    hal.phy_w32_mask(R_DRCK, B_DRCK_VAL, rck_d);
+}
+
+/// `_dack_s0`: the DAC, its MSB codes, bias and DC (24 above what it
+/// read) kept and reloaded (`_dack_backup_s0`, `_dack_reload`).
+fn dack_s0(hal: &Hal) {
+    rfk(hal, RTW8851B_DACK_S0_1_DEFS);
+    hal.phy_w32_mask(R_DCOF0, B_DCOF0_RST, 0);
+    hal.phy_w32_mask(R_DCOF0, B_DCOF0_RST, 1);
+    hal.phy_w32_mask(R_DCOF1, B_DCOF1_S, 1);
+    let ok = |reg, mask| hal.phy_r32_mask(reg, mask) != 0;
+    poll(|| ok(R_DACK_S0P0, B_DACK_S0P0_OK) && ok(R_DACK_S0P1, B_DACK_S0P1_OK) && ok(R_DACK_S0P2, B_DACK_S0P2_OK) && ok(R_DACK_S0P3, B_DACK_S0P3_OK), 1, 10_000);
+    rfk(hal, RTW8851B_DACK_S0_2_DEFS);
+    hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_DBG, 1);
+    let mut msbk = [[0u32; 16]; 2];
+    for i in 0..16u32 {
+        hal.phy_w32_mask(R_DCOF0, B_DCOF0_V, i);
+        msbk[0][i as usize] = hal.phy_r32_mask(R_DACK_S0P2, B_DACK_S0M0);
+        hal.phy_w32_mask(R_DCOF8, B_DCOF8_V, i);
+        msbk[1][i as usize] = hal.phy_r32_mask(R_DACK_S0P3, B_DACK_S0M1);
+    }
+    let biask = [hal.phy_r32_mask(R_DACK_BIAS00, B_DACK_BIAS00), hal.phy_r32_mask(R_DACK_BIAS01, B_DACK_BIAS01)];
+    let dadck = [hal.phy_r32_mask(R_DACK_DADCK00, B_DACK_DADCK00) + 24, hal.phy_r32_mask(R_DACK_DADCK01, B_DACK_DADCK01) + 24];
+    for index in 0..2usize {
+        let offset = if index == 0 { 0 } else { 0x14 };
+        hal.phy_w32_mask(R_DCOF1, B_DCOF1_RST, 1);
+        hal.phy_w32_mask(R_DCOF9, B_DCOF9_RST, 1);
+        for (word, first) in [12usize, 8, 4, 0].into_iter().enumerate() {
+            let value = (0..4).fold(0u32, |value, i| value | (msbk[index][first + i] << (i * 8)));
+            hal.phy_w32(0xc200 + offset + 4 * word as u32, value);
+        }
+        hal.phy_w32(0xc210 + offset, (biask[index] << 22) | (dadck[index] << 14));
+        hal.phy_w32_mask(R_DACKN0_CTL + offset, B_DACKN0_EN, 1);
+    }
+    hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_DBG, 0);
+}
+
+/// `_new_dadck`: the DAC's DC from the ADC's reading of it.
+fn new_dadck(hal: &Hal) {
+    rfk(hal, RTW8851B_DADCK_SETUP_DEFS);
+    poll(|| hal.phy_r32_mask(R_ADDCKR0, 1 << 0) != 0, 1, 10_000);
+    hal.phy_w32_mask(R_ADDCK0, B_ADDCK0_IQ, 0);
+    let i_dc = hal.phy_r32_mask(R_ADDCKR0, B_ADDCKR0_DC);
+    hal.phy_w32_mask(R_ADDCK0, B_ADDCK0_IQ, 1);
+    let q_dc = hal.phy_r32_mask(R_ADDCKR0, B_ADDCKR0_DC);
+    let ic = (0x80 - sign_extend12(i_dc) * 6) as u32;
+    let qc = (0x80 - sign_extend12(q_dc) * 6) as u32;
+    hal.phy_w32_mask(R_DACKN0_CTL, B_DACKN0_V, ic);
+    hal.phy_w32_mask(R_DACKN1_CTL, B_DACKN1_V, qc);
+    rfk(hal, RTW8851B_DADCK_POST_DEFS);
+}
+
+/// `rtw8851b_dack` (`_dac_cal`): the RC clock, the ADC's offsets, the DAC.
+pub(crate) fn dac_cal(hal: &Hal) {
+    drck(hal);
+    rfk(hal, RTW8851B_DACK_MANUAL_OFF_DEFS);
+    hal.write_rf(0, RR_MOD, RFREG_MASK, 0x337e1);
+    hal.write_rf(0, RR_RSV1, RR_RSV1_RST, 0);
+    // `_addck`, `_addck_backup`, `_addck_reload`.
+    hal.phy_w32_mask(R_ADDCK0, B_ADDCK0_RST, 1);
+    hal.phy_w32_mask(R_ADDCK0, B_ADDCK0_EN, 1);
+    hal.phy_w32_mask(R_ADDCK0, B_ADDCK0_EN, 0);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_ADDCK0, B_ADDCK0, 1);
+    poll(|| hal.phy_r32_mask(R_ADDCKR0, 1 << 0) != 0, 1, 10_000);
+    hal.phy_w32_mask(R_ADDCK0, B_ADDCK0_RST, 0);
+    hal.phy_w32_mask(R_ADDCK0, B_ADDCK0, 0);
+    let a = [hal.phy_r32_mask(R_ADDCKR0, B_ADDCKR0_A0), hal.phy_r32_mask(R_ADDCKR0, B_ADDCKR0_A1)];
+    hal.phy_w32_mask(R_ADDCK0_RL, B_ADDCK0_RL1, a[0]);
+    hal.phy_w32_mask(R_ADDCK0_RL, B_ADDCK0_RL0, a[1]);
+    hal.phy_w32_mask(R_ADDCK0_RL, B_ADDCK0_RLS, 0x3);
+    hal.write_rf(0, RR_MOD, RFREG_MASK, 0x40001);
+    dack_s0(hal);
+    new_dadck(hal);
+    hal.write_rf(0, RR_RSV1, RR_RSV1_RST, 1);
+}
+
+// ---- The RX DC offset. ----
+
+/// `_set_rx_dck` with `_rxbb_ofst_swap`: the offsets into the RX
+/// baseband's table at the mode.
+fn set_rx_dck(hal: &Hal, rf_mode: u32) {
+    hal.write_rf(0, RR_DCK, RR_DCK_LV, 0);
+    hal.write_rf(0, RR_DCK, RR_DCK_LV, 1);
+    poll(|| hal.read_rf(0, RR_DCK, 1 << 8) != 0, 2, 2000);
+    hal.write_rf(0, RR_DCK, RR_DCK_LV, 0);
+    let val_i = hal.read_rf(0, RR_DCK, RR_DCK_S1);
+    let val_q = hal.read_rf(0, RR_DCK1, RR_DCK1_S1);
+    hal.write_rf(0, RR_LUTWE2, RR_LUTWE2_DIS, 1);
+    hal.write_rf(0, RR_LUTWA, RFREG_MASK, rf_mode);
+    hal.write_rf(0, RR_LUTWD0, RFREG_MASK, (val_q << 4) | val_i);
+    hal.write_rf(0, RR_LUTWE2, RR_LUTWE2_DIS, 0);
+}
+
+/// `rtw8851b_rx_dck` (`_rx_dck`): TX held, the TSSI's tracking paused.
+pub(crate) fn rx_dck(hal: &Hal, tssi_mode: bool) {
+    crate::sta::stop_sch_tx(hal, true);
+    wait_rx_mode(hal);
+    let reg5 = hal.read_rf(0, RR_RSV1, RFREG_MASK);
+    if tssi_mode {
+        hal.phy_w32_mask(R_P0_TSSI_TRK, B_P0_TSSI_TRK_EN, 1);
+    }
+    hal.write_rf(0, RR_RSV1, RR_RSV1_RST, 0);
+    hal.write_rf(0, RR_MOD, RR_MOD_MASK, RF_RX);
+    set_rx_dck(hal, RF_RX);
+    hal.write_rf(0, RR_RSV1, RFREG_MASK, reg5);
+    if tssi_mode {
+        hal.phy_w32_mask(R_P0_TSSI_TRK, B_P0_TSSI_TRK_EN, 0);
+    }
+    crate::sta::stop_sch_tx(hal, false);
+}
+
+// ---- IQK. ----
+
+/// `enum rtw8851b_iqk_type`: the one-shots the host starts.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Iqk {
+    Txk,
+    Rxagc,
+    Rxk,
+    Nbtxk,
+    Nbrxk,
+}
+
+/// `_iqk_check_cal`: whether the NCTL or its report did not come.
+fn iqk_check_cal(hal: &Hal) -> bool {
+    let done = poll(|| hal.phy_r32_mask(R_RFK_ST, MASKBYTE0) == NCTL_DONE, 10, 8200);
+    crate::delay_us(10);
+    let ready = poll(|| hal.phy_r32_mask(R_RPT_COM, B_RPT_COM_RDY) == REPORT_READY, 10, 200);
+    crate::delay_us(10);
+    hal.phy_w32_mask(R_NCTL_N1, MASKBYTE0, 0);
+    !(done && ready)
+}
+
+/// `_iqk_one_shot`: whether it was not ready.
+fn iqk_one_shot(hal: &Hal, kind: Iqk, bw: u8) -> bool {
+    let bw = bw as u32;
+    let (by_kip, cmd) = match kind {
+        Iqk::Txk => (0, 0x008 | (1 << 4) | (((0x8 + bw) & 0xf) << 8)),
+        Iqk::Rxagc => (1, 0x708 | (1 << 4)),
+        Iqk::Rxk => (1, 0x008 | (1 << 4) | (((0xc + bw) & 0xf) << 8)),
+        Iqk::Nbtxk => {
+            hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_TXT, 0x11);
+            (0, 0x408 | (1 << 4))
+        }
+        Iqk::Nbrxk => {
+            hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_RXT, 0x011);
+            (1, 0x608 | (1 << 4))
+        }
+    };
+    hal.phy_w32_mask(R_UPD_CLK, B_IQK_RFC_ON, by_kip);
+    hal.phy_w32_mask(R_NCTL_CFG, MASKDWORD, cmd + 1);
+    let not_ready = iqk_check_cal(hal);
+    hal.phy_w32_mask(R_UPD_CLK, B_IQK_RFC_ON, 0);
+    not_ready
+}
+
+/// The RX IQK's settings on 5 GHz around it (`RR_LUTWD0` entries 4 and 5).
+fn rxk_5g_lut(hal: &Hal, entry4: u32) {
+    hal.write_rf(0, RR_LUTWE, RFREG_MASK, 0x1000);
+    hal.write_rf(0, RR_LUTWA, RFREG_MASK, 0x4);
+    hal.write_rf(0, RR_LUTWD0, RFREG_MASK, entry4);
+    hal.write_rf(0, RR_LUTWA, RFREG_MASK, 0x5);
+    hal.write_rf(0, RR_LUTWD0, RFREG_MASK, 0x27);
+    hal.write_rf(0, RR_LUTWE, RFREG_MASK, 0);
+}
+
+/// `_rxk_2g_group_sel`, `_rxk_5g_group_sel`: the four RX groups, wide band.
+fn rxk_group_sel(hal: &Hal, band: u8, bw: u8) -> bool {
+    let two_g = band == phy::BAND_2G;
+    let mut sw = 0;
+    if !two_g {
+        rxk_5g_lut(hal, 0x17);
+        sw = hal.read_rf(0, RR_RXA2, RR_RXA2_IQK_SW);
+        hal.write_rf(0, RR_MOD, RR_MOD_MASK, 0xc);
+    }
+    let mut not_ready = false;
+    let mut nb_rxcfir = 0;
+    for group in 0..4usize {
+        if two_g {
+            hal.write_rf(0, RR_MOD, RR_MOD_RGM, G_RXGAIN[group]);
+            hal.write_rf(0, RR_RXBB, RR_RXBB_C2, G_ATTC2[group]);
+        } else {
+            hal.write_rf(0, RR_MOD, RR_MOD_RGM, A_RXGAIN[group]);
+            hal.write_rf(0, RR_RXA2, RR_RXA2_ATT, A_ATTC2[group]);
+            hal.write_rf(0, RR_RXA2, RR_RXA2_IQK_SW, 1);
+        }
+        hal.phy_w32_mask(R_CFIR_LUT, B_CFIR_LUT_SEL, 1);
+        hal.phy_w32_mask(R_CFIR_LUT, B_CFIR_LUT_G3, 0);
+        hal.phy_w32_mask(R_CFIR_LUT, B_CFIR_LUT_GP_V1, group as u32);
+        hal.write_rf(0, RR_RXKPLL, RFREG_MASK, 0x80013);
+        crate::delay_us(if two_g { 10 } else { 100 });
+        let rf0 = hal.read_rf(0, RR_MOD, RFREG_MASK);
+        hal.phy_w32_mask(R_IQK_DIF2, B_IQK_DIF2_RXPI, rf0);
+        hal.phy_w32_mask(R_IQK_RXA, B_IQK_RXAGC, if two_g { G_RXAGC[group] } else { A_RXAGC[group] });
+        hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_RXT, 0x11);
+        let _ = iqk_one_shot(hal, Iqk::Rxagc, bw);
+        hal.write_rf(0, RR_RXKPLL, RR_RXKPLL_OFF, 0x13);
+        hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_RXT, 0x011);
+        let _ = iqk_one_shot(hal, Iqk::Nbrxk, bw);
+        nb_rxcfir = hal.phy_r32_mask(R_RXIQC, MASKDWORD) | 0x2;
+        not_ready = iqk_one_shot(hal, Iqk::Rxk, bw);
+    }
+    let failed = !not_ready && hal.phy_r32_mask(R_NCTL_RPT, B_NCTL_RPT_FLG) != 0;
+    if failed {
+        // `_iqk_sram`: Linux dumps the RX SRAM; what it leaves set.
+        hal.phy_w32_mask(R_KIP_RPT1, MASKDWORD, 0x0002_0000);
+        hal.phy_w32_mask(R_MDPK_RX_DCK, MASKDWORD, 0x8000_0000);
+        hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_TXT, 0x009);
+        hal.phy_w32_mask(R_SRAM_IQRX2, MASKDWORD, 0);
+        hal.phy_w32_mask(R_SRAM_IQRX, MASKDWORD, 0);
+        if !two_g {
+            hal.phy_w32_mask(R_IQK_RES, B_IQK_RES_RXCFIR, 0);
+        }
+        hal.phy_w32_mask(R_RXIQC, MASKDWORD, nb_rxcfir | 0x2);
+    } else {
+        hal.phy_w32_mask(R_RXIQC, MASKDWORD, CFIR_WIDE);
+    }
+    if !two_g {
+        hal.write_rf(0, RR_RXA2, RR_RXA2_IQK_SW, sw);
+        rxk_5g_lut(hal, 0x37);
+    }
+    failed
+}
+
+/// `_txk_2g_group_sel`, `_txk_5g_group_sel`: the TX groups, wide band.
+fn txk_group_sel(hal: &Hal, band: u8, bw: u8) -> bool {
+    let two_g = band == phy::BAND_2G;
+    hal.phy_w32_mask(R_CFIR_COEF, MASKDWORD, if two_g { 0 } else { 0x3333_2222 });
+    let groups = if two_g { 1 } else { 2 };
+    let mut not_ready = false;
+    let mut nb_txcfir = 0;
+    for group in 0..groups {
+        let (track, gain, itqt) = if two_g { (G_TRACK_RANGE, G_GAIN_BB, G_ITQT) } else { (A_TRACK_RANGE[group], A_GAIN_BB[group], A_ITQT[group]) };
+        hal.write_rf(0, RR_TXIG, RR_TXIG_GR0, 0);
+        hal.write_rf(0, RR_TXIG, RR_TXIG_GR1, track);
+        hal.write_rf(0, RR_TXIG, RR_TXIG_TG, gain);
+        if two_g {
+            hal.phy_w32_mask(R_KIP_IQP, MASKDWORD, itqt);
+        } else {
+            hal.write_rf(0, RR_BIASA, RR_BIASA_A, A_ATT_SMXR[group]);
+        }
+        hal.phy_w32_mask(R_CFIR_LUT, B_CFIR_LUT_SEL, 1);
+        hal.phy_w32_mask(R_CFIR_LUT, B_CFIR_LUT_G3, 1);
+        hal.phy_w32_mask(R_CFIR_LUT, B_CFIR_LUT_G2, 0);
+        hal.phy_w32_mask(R_CFIR_LUT, B_CFIR_LUT_GP, if two_g { group as u32 } else { A_IDX[group] });
+        hal.phy_w32_mask(R_NCTL_N1, B_NCTL_N1_CIP, 0);
+        if !two_g {
+            hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_TXT, 0x11);
+            hal.phy_w32_mask(R_KIP_IQP, MASKDWORD, itqt);
+        }
+        let _ = iqk_one_shot(hal, Iqk::Nbtxk, bw);
+        nb_txcfir = hal.phy_r32_mask(R_TXIQC, MASKDWORD) | 0x2;
+        hal.phy_w32_mask(R_KIP_IQP, MASKDWORD, itqt);
+        not_ready = iqk_one_shot(hal, Iqk::Txk, bw);
+    }
+    let failed = !not_ready && hal.phy_r32_mask(R_NCTL_RPT, B_NCTL_RPT_FLG) != 0;
+    hal.phy_w32_mask(R_TXIQC, MASKDWORD, if failed { nb_txcfir | 0x2 } else { CFIR_WIDE });
+    failed
+}
+
+/// `_iqk_2g_lok`, `_iqk_5g_lok`: coarse and fine at each of the ten gains.
+fn iqk_lok(hal: &Hal, band: u8) -> bool {
+    let two_g = band == phy::BAND_2G;
+    let (itqt, wa) = if two_g { (&G_LOK_ITQT, &G_LOK_WA) } else { (&A_LOK_ITQT, &A_LOK_WA) };
+    hal.write_rf(0, RR_LUTDBG, RR_LUTDBG_LOK, 0);
+    hal.write_rf(0, RR_TXIG, RR_TXIG_GR0, 0);
+    hal.write_rf(0, RR_TXIG, RR_TXIG_GR1, if two_g { 0x6 } else { 0x7 });
+    let mut failed = false;
+    for i in 0..LOK_TXBB.len() {
+        hal.write_rf(0, RR_TXIG, RR_TXIG_TG, LOK_TXBB[i]);
+        hal.write_rf(0, RR_LUTWA, RR_LUTWA_M1, wa[i]);
+        hal.phy_w32_mask(R_UPD_CLK, B_IQK_RFC_ON, 1);
+        hal.phy_w32_mask(R_KIP_IQP, B_KIP_IQP_IQSW, itqt[i]);
+        hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_TXT, 0x021);
+        hal.phy_w32_mask(R_NCTL_CFG, MASKDWORD, 0x0000_0109 | (1 << 4));
+        failed |= iqk_check_cal(hal);
+        hal.phy_w32_mask(R_NCTL_N1, B_NCTL_N1_CIP, 0);
+        hal.phy_w32_mask(R_KIP_IQP, B_KIP_IQP_IQSW, itqt[i]);
+        if !two_g {
+            hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_TXT, 0x021);
+        }
+        hal.phy_w32_mask(R_NCTL_CFG, MASKDWORD, 0x0000_0309 | (1 << 4));
+        failed |= iqk_check_cal(hal);
+        hal.phy_w32_mask(R_NCTL_N1, B_NCTL_N1_CIP, 0);
+        hal.phy_w32_mask(R_UPD_CLK, B_IQK_RFC_ON, 0);
+    }
+    failed
+}
+
+/// `rtw8851b_iqk` (`_doiqk` of path A).
+fn iqk(hal: &Hal, chan: &Chan) {
+    crate::sta::stop_sch_tx(hal, true);
+    wait_rx_mode(hal);
+    let bb = BACKUP_BB_REGS.map(|reg| hal.phy_r32_mask(reg, MASKDWORD));
+    let rf = BACKUP_RF_REGS.map(|reg| hal.read_rf(0, reg, RFREG_MASK));
+    // `_iqk_macbb_setting`.
+    rfk(hal, RTW8851B_IQK_MACBB_DEFS);
+    txck_force(hal, true, DAC_960M);
+    hal.phy_w32_mask(R_UPD_CLK, B_DPD_GDIS, 1);
+    rxck_force(hal, true, ADC_1920M);
+    rfk(hal, RTW8851B_IQK_MACBB_BH_DEFS);
+    // `_iqk_preset`.
+    hal.write_rf(0, RR_RSV1, RR_RSV1_RST, 0);
+    hal.phy_w32_mask(R_NCTL_RPT, MASKDWORD, 0x0000_0080);
+    hal.phy_w32_mask(R_KIP_SYSCFG, MASKDWORD, 0x81ff_010a);
+    // `_iqk_by_path` (one LO try).
+    rfk(hal, if chan.band == phy::BAND_2G { RTW8851B_IQK_TXK_2GHZ_DEFS } else { RTW8851B_IQK_TXK_5GHZ_DEFS });
+    let _ = iqk_lok(hal, chan.band);
+    let _ = txk_group_sel(hal, chan.band, chan.bw);
+    // `_iqk_rxclk_setting`.
+    hal.write_rf(0, RR_RXBB2, RR_RXBB2_CKT, 1);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RXK, 0x0101);
+    hal.phy_w32_mask(R_UPD_CLK, B_DPD_GDIS, 1);
+    rxck_force(hal, true, ADC_960M);
+    rfk(hal, if chan.bw == 2 { RTW8851B_IQK_RXCLK_80_DEFS } else { RTW8851B_IQK_RXCLK_OTHERS_DEFS });
+    // `_iqk_rxk_setting`, `_adc_fifo_rst`.
+    hal.write_rf(0, RR_MOD, RR_MOD_MASK, 0xc);
+    hal.write_rf(0, RR_RXKPLL, RR_RXKPLL_POW, 0);
+    hal.write_rf(0, RR_RXKPLL, RR_RXKPLL_POW, 1);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RXK, 0x0101);
+    crate::delay_us(10);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RXK, 0x1111);
+    let _ = rxk_group_sel(hal, chan.band, chan.bw);
+    // `_iqk_restore`.
+    hal.phy_w32_mask(R_NCTL_CFG, MASKDWORD, 0x0000_1219);
+    crate::delay_us(10);
+    let _ = iqk_check_cal(hal);
+    hal.write_rf(0, RR_LUTWE, RR_LUTWE_LOK, 0);
+    hal.write_rf(0, RR_LUTDBG, RR_LUTDBG_TIA, 0);
+    hal.phy_w32_mask(R_NCTL_N1, B_NCTL_N1_CIP, 0);
+    hal.phy_w32_mask(R_NCTL_RPT, MASKDWORD, 0);
+    hal.phy_w32_mask(R_KIP_SYSCFG, MASKDWORD, 0x8000_0000);
+    rfk(hal, RTW8851B_IQK_AFEBB_RESTORE_DEFS);
+    for (&reg, &value) in BACKUP_BB_REGS.iter().zip(&bb) {
+        hal.phy_w32_mask(reg, MASKDWORD, value);
+    }
+    for (&reg, &value) in BACKUP_RF_REGS.iter().zip(&rf) {
+        hal.write_rf(0, reg, RFREG_MASK, value);
+    }
+    crate::sta::stop_sch_tx(hal, false);
+}
+
+// ---- DPK. ----
+
+/// `enum dpk_id`: the one-shots the host starts.
+const D_KIP_PRESET: u32 = 0x28;
+const D_TXAGC: u32 = 0x29;
+const D_RXAGC: u32 = 0x2a;
+const D_SYNC: u32 = 0x2b;
+const D_GAIN_LOSS: u32 = 0x2c;
+const D_MDPK_IDL: u32 = 0x2d;
+const D_KIP_RESTORE: u32 = 0x31;
+const LBK_RXIQK: u32 = 0x06;
+/// The TX power the AGC starts from and keeps to, in dBm.
+const DPK_INIT_DBM: u32 = 17;
+const DPK_DBM_MIN: u32 = 7;
+const DPK_DBM_MAX: u32 = 24;
+/// Table 0's parameters by K set (`reg[kidx][cur_k_set]`), what Linux
+/// takes when the K set is out of range.
+const DPK_PAR_REGS: [u32; 4] = [0x8190, 0x8194, 0x8198, 0x81a4];
+const DPK_KSET_FALLBACK: usize = 2;
+const DPK_GS_DEFAULT: u32 = 0x5b;
+const DPK_PARA_GS: u32 = 0x0000_007f;
+const DPK_PWSF: i32 = 0x78;
+
+/// What the DPK keeps of path A's table 0.
+#[derive(Clone, Copy, Default)]
+struct Dpk {
+    band: u8,
+    bw: u8,
+    path_ok: u32,
+    txagc: u32,
+    ther_dpk: u32,
+    gs: u32,
+    cur_k_set: u32,
+}
+
+/// `_dpk_one_shot`.
+fn dpk_one_shot(hal: &Hal, id: u32) {
+    hal.phy_w32_mask(R_NCTL_CFG, MASKDWORD, (id << 8) | 0x19);
+    poll(|| hal.phy_r32_mask(R_RFK_ST, MASKBYTE0) == NCTL_DONE, 10, 20_000);
+    crate::delay_us(1);
+    poll(|| hal.phy_r32_mask(R_RPT_COM, MASKLWORD) == REPORT_READY, 1, 2000);
+    hal.phy_w32_mask(R_NCTL_N1, MASKBYTE0, 0);
+}
+
+/// `_dpk_kip_control_rfc`.
+fn dpk_kip_control_rfc(hal: &Hal, by_kip: bool) {
+    hal.phy_w32_mask(R_UPD_CLK, B_IQK_RFC_ON, by_kip as u32);
+}
+
+/// `_dpk_txpwr_bb_force`.
+fn dpk_txpwr_bb_force(hal: &Hal, force: bool) {
+    hal.phy_w32_mask(R_TXPWRB, B_TXPWRB_ON, force as u32);
+    hal.phy_w32_mask(R_TXPWRB_H, B_TXPWRB_RDY, force as u32);
+}
+
+/// `_dpk_onoff`: the DPD's enable of table 0 (by the K sets that passed).
+fn dpk_onoff(hal: &Hal, dpk: &Dpk, off: bool) {
+    let value = if off { 0 } else { dpk.path_ok };
+    hal.phy_w32_mask(R_DPD_CH0A, 0xf000_0000, value);
+}
+
+/// `_dpk_bb_afe_setting`.
+fn dpk_bb_afe_setting(hal: &Hal) {
+    hal.phy_w32_mask(R_ADC_FIFO, 1 << 16, 1);
+    hal.phy_w32_mask(R_ADC_FIFO, 1 << 20, 0);
+    hal.phy_w32_mask(R_ADC_FIFO, 1 << 24, 1);
+    hal.phy_w32_mask(R_ADC_FIFO, 1 << 28, 0);
+    hal.phy_w32_mask(R_UPD_CLK, MASKDWORD, 0xd801_dffd);
+    txck_force(hal, true, DAC_960M);
+    rxck_force(hal, true, ADC_1920M);
+    hal.phy_w32_mask(R_DCIM, B_DCIM_FR, 0);
+    hal.phy_w32_mask(R_ADCMOD, B_ADCMOD_AUTO_RST, 1);
+    hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_DBG, 1);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15, 0x1f);
+    crate::delay_us(10);
+    hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15, 0x13);
+    crate::delay_us(2);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_15, 0x0001);
+    crate::delay_us(2);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_15, 0x0041);
+    crate::delay_us(10);
+    hal.phy_w32_mask(R_ADC_FIFO, 1 << 20, 1);
+    hal.phy_w32_mask(R_ADC_FIFO, 1 << 28, 1);
+}
+
+/// `_dpk_bb_afe_restore`.
+fn dpk_bb_afe_restore(hal: &Hal) {
+    hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_DBG, 0);
+    hal.phy_w32_mask(R_ADC_FIFO, 1 << 16, 1);
+    hal.phy_w32_mask(R_ADC_FIFO, 1 << 20, 0);
+    hal.phy_w32_mask(R_ADC_FIFO, 1 << 24, 1);
+    hal.phy_w32_mask(R_ADC_FIFO, 1 << 28, 0);
+    hal.phy_w32_mask(R_UPD_CLK, MASKDWORD, 0);
+    hal.phy_w32_mask(R_P0_RXCK, B_P0_TXCK_ALL, 0);
+    hal.phy_w32_mask(R_ADC_FIFO, 1 << 16, 0);
+    hal.phy_w32_mask(R_ADC_FIFO, 1 << 24, 0);
+}
+
+/// `_dpk_kset_query`.
+fn dpk_kset_query(hal: &Hal, dpk: &mut Dpk) {
+    hal.phy_w32_mask(R_KIP_RPT, B_KIP_RPT_SEL, 0x10);
+    dpk.cur_k_set = hal.phy_r32_mask(R_RPT_PER, B_RPT_PER_KSET).wrapping_sub(1);
+}
+
+/// The parameter register of the K set in use (`DPK_KSET_FALLBACK` past
+/// the four).
+fn dpk_par_reg(dpk: &Dpk) -> u32 {
+    let set = dpk.cur_k_set as usize;
+    DPK_PAR_REGS[if set < DPK_PAR_REGS.len() { set } else { DPK_KSET_FALLBACK }]
+}
+
+/// `_dpk_kip_set_txagc`.
+fn dpk_kip_set_txagc(hal: &Hal, dpk: &mut Dpk, dbm: Option<u32>) {
+    if let Some(dbm) = dbm {
+        hal.phy_w32_mask(R_TXPWRB, B_TXPWRB_VAL, dbm.clamp(DPK_DBM_MIN, DPK_DBM_MAX) << 2);
+    }
+    dpk_one_shot(hal, D_TXAGC);
+    dpk_kset_query(hal, dpk);
+}
+
+/// `_dpk_sync_check`.
+fn dpk_sync_check(hal: &Hal) -> bool {
+    hal.phy_w32_mask(R_KIP_RPT1, B_KIP_RPT1_SEL, 0);
+    let corr = hal.phy_r32_mask(R_RPT_COM, B_PRT_COM_CORV);
+    hal.phy_w32_mask(R_KIP_RPT1, B_KIP_RPT1_SEL, 0x9);
+    let dc_i = sign_extend12(hal.phy_r32_mask(R_RPT_COM, B_PRT_COM_DCI)).unsigned_abs();
+    let dc_q = sign_extend12(hal.phy_r32_mask(R_RPT_COM, B_PRT_COM_DCQ)).unsigned_abs();
+    // The RX gain's reports Linux reads after (their selections stay).
+    hal.phy_w32_mask(R_KIP_RPT1, B_KIP_RPT1_SEL, 0x8);
+    hal.phy_w32_mask(R_KIP_RPT1, B_KIP_RPT1_SEL, 0x31);
+    dc_i > 200 || dc_q > 200 || corr < 170
+}
+
+/// `_dpk_kip_set_rxagc`: whether the sync failed.
+fn dpk_kip_set_rxagc(hal: &Hal) -> bool {
+    dpk_kip_control_rfc(hal, false);
+    let mode = hal.read_rf(0, RR_MOD, RFREG_MASK);
+    hal.phy_w32_mask(R_KIP_MOD, B_KIP_MOD, mode);
+    dpk_kip_control_rfc(hal, true);
+    dpk_one_shot(hal, D_RXAGC);
+    dpk_sync_check(hal)
+}
+
+/// `_dpk_lbk_rxiqk`.
+fn dpk_lbk_rxiqk(hal: &Hal) {
+    hal.phy_w32_mask(R_DPD_V1, B_DPD_LBK, 1);
+    hal.phy_w32_mask(R_MDPK_RX_DCK, B_MDPK_RX_DCK_EN, 1);
+    dpk_kip_control_rfc(hal, false);
+    let rxbb = hal.read_rf(0, RR_MOD, RR_MOD_RXB);
+    let rf11 = hal.read_rf(0, RR_TXIG, RFREG_MASK);
+    let sw = hal.phy_r32_mask(R_KIP_IQP, B_KIP_IQP_SW);
+    hal.write_rf(0, RR_TXIG, RR_TXIG_GR0, 0);
+    hal.write_rf(0, RR_TXIG, RR_TXIG_GR1, 0x3);
+    hal.write_rf(0, RR_TXIG, RR_TXIG_TG, 0xd);
+    hal.write_rf(0, RR_MOD, RR_MOD_RXB, 0x1f);
+    hal.phy_w32_mask(R_KIP_IQP, B_KIP_IQP_IQSW, 0x12);
+    hal.phy_w32_mask(R_KIP_IQP, B_KIP_IQP_SW, 0x3);
+    dpk_kip_control_rfc(hal, true);
+    hal.phy_w32_mask(R_IQK_DIF4, MASKDWORD, 0x0025_0025);
+    dpk_one_shot(hal, LBK_RXIQK);
+    dpk_kip_control_rfc(hal, false);
+    hal.write_rf(0, RR_TXIG, RFREG_MASK, rf11);
+    hal.write_rf(0, RR_MOD, RR_MOD_RXB, rxbb);
+    hal.phy_w32_mask(R_KIP_IQP, B_KIP_IQP_SW, sw);
+    hal.phy_w32_mask(R_MDPK_RX_DCK, B_MDPK_RX_DCK_EN, 0);
+    hal.phy_w32_mask(R_KPATH_CFG, B_KPATH_CFG_ED, 0);
+    hal.phy_w32_mask(R_LOAD_COEF, B_LOAD_COEF_DI, 1);
+    dpk_kip_control_rfc(hal, true);
+}
+
+/// `_dpk_pas_read`: 2 when the first sample is weaker, 1 when compressed.
+fn dpk_pas_read(hal: &Hal) -> u32 {
+    hal.phy_w32_mask(R_KIP_RPT1, MASKBYTE2, 0x06);
+    hal.phy_w32_mask(R_DPK_CFG2, B_DPK_CFG2_ST, 0);
+    hal.phy_w32_mask(R_DPK_CFG3, MASKBYTE2, 0x08);
+    let sample = |index: u32| {
+        hal.phy_w32_mask(R_DPK_CFG3, MASKBYTE3, index);
+        let i = sign_extend12(hal.phy_r32_mask(R_RPT_COM, MASKHWORD)).unsigned_abs();
+        let q = sign_extend12(hal.phy_r32_mask(R_RPT_COM, MASKLWORD)).unsigned_abs();
+        i * i + q * q
+    };
+    let (first, last) = (sample(0x00), sample(0x1f));
+    if first < last {
+        2
+    } else if first >= last * 8 / 5 {
+        1
+    } else {
+        0
+    }
+}
+
+/// `_dpk_agc`: whether the sync failed.
+fn dpk_agc(hal: &Hal, dpk: &mut Dpk) -> bool {
+    #[derive(Clone, Copy)]
+    enum Step {
+        SyncDgain,
+        GainLossIdx,
+        GlGt,
+        GlLt,
+        SetTxGain,
+    }
+    let (mut step, mut dbm, mut gl_idx, mut count, mut limit) = (Step::SyncDgain, DPK_INIT_DBM, 0u32, 0u32, 200);
+    let mut failed = false;
+    loop {
+        let mut out = false;
+        match step {
+            Step::SyncDgain => {
+                failed = dpk_kip_set_rxagc(hal);
+                if failed {
+                    out = true;
+                } else {
+                    hal.phy_w32_mask(R_KIP_RPT1, B_KIP_RPT1_SEL, 0);
+                    let dgain = hal.phy_r32_mask(R_RPT_COM, B_PRT_COM_DCI);
+                    if !(0x556..=0x5fc).contains(&dgain) {
+                        dpk_one_shot(hal, D_SYNC);
+                        hal.phy_w32_mask(R_KIP_RPT1, B_KIP_RPT1_SEL, 0);
+                    }
+                    if count == 0 {
+                        if dpk.band == phy::BAND_2G {
+                            // `_dpk_bypass_rxiqc`.
+                            hal.phy_w32_mask(R_DPD_V1, B_DPD_LBK, 1);
+                            hal.phy_w32_mask(R_RXIQC, MASKDWORD, CFIR_FAILED);
+                        } else {
+                            dpk_lbk_rxiqk(hal);
+                        }
+                    }
+                    step = Step::GainLossIdx;
+                }
+            }
+            Step::GainLossIdx => {
+                // `_dpk_gainloss`.
+                dpk_one_shot(hal, D_GAIN_LOSS);
+                dpk_kip_set_txagc(hal, dpk, None);
+                hal.phy_w32_mask(R_DPK_GL, B_DPK_GL_A1, 0xf078);
+                hal.phy_w32_mask(R_DPK_GL, B_DPK_GL_A0, 0);
+                gl_idx = rtw8852b_rfk::dpk_gainloss_read(hal);
+                step = if dpk_pas_read(hal) == 2 && gl_idx > 0 {
+                    Step::GlLt
+                } else if (gl_idx == 0 && dpk_pas_read(hal) == 1) || gl_idx >= 7 {
+                    Step::GlGt
+                } else if gl_idx == 0 {
+                    Step::GlLt
+                } else {
+                    Step::SetTxGain
+                };
+            }
+            Step::GlGt => {
+                if dbm <= DPK_DBM_MIN {
+                    out = true;
+                } else {
+                    dbm = dbm.saturating_sub(3).max(DPK_DBM_MIN);
+                    dpk_kip_set_txagc(hal, dpk, Some(dbm));
+                }
+                step = Step::SyncDgain;
+                count += 1;
+            }
+            Step::GlLt => {
+                if dbm >= DPK_DBM_MAX {
+                    out = true;
+                } else {
+                    dbm = (dbm + 2).min(DPK_DBM_MAX);
+                    dpk_kip_set_txagc(hal, dpk, Some(dbm));
+                }
+                step = Step::SyncDgain;
+                count += 1;
+            }
+            Step::SetTxGain => {
+                dpk_kip_control_rfc(hal, false);
+                let rxbb = (hal.read_rf(0, RR_MOD, RR_MOD_RXB) + gl_idx).min(0x1f);
+                hal.write_rf(0, RR_MOD, RR_MOD_RXB, rxbb);
+                dpk_kip_control_rfc(hal, true);
+                out = true;
+            }
+        }
+        if out || count >= 6 || limit <= 0 {
+            break;
+        }
+        limit -= 1;
+    }
+    failed
+}
+
+/// `_dpk_set_mdpd_para`: `(5,3,1)`, `(5,3,0)`, `(5,0,0)`.
+fn dpk_set_mdpd_para(hal: &Hal, order: u32) {
+    let (sel, pn, man) = match order {
+        0 => (0x2, 0x3, 1),
+        1 => (0x1, 0x0, 0),
+        _ => (0x0, 0x0, 0),
+    };
+    hal.phy_w32_mask(R_LDL_NORM, B_LDL_NORM_OP, order);
+    hal.phy_w32_mask(R_DPK_IDL, B_DPK_IDL_SEL, sel);
+    hal.phy_w32_mask(R_LDL_NORM, B_LDL_NORM_PN, pn);
+    hal.phy_w32_mask(R_MDPK_SYNC, B_MDPK_SYNC_DMAN, man);
+}
+
+/// `_dpk_main`: whether it failed.
+fn dpk_main(hal: &Hal, dpk: &mut Dpk) -> bool {
+    dpk_kip_control_rfc(hal, false);
+    hal.write_rf(0, RR_RSV1, RR_RSV1_RST, 0);
+    hal.write_rf(0, RR_BBDC, RFREG_MASK, 0x03ffd);
+    // `_dpk_rf_setting`.
+    hal.write_rf(0, RR_MOD, RFREG_MASK, 0x50521);
+    hal.write_rf(0, RR_MOD_V1, RR_MOD_MASK, RF_DPK);
+    if dpk.band == phy::BAND_2G {
+        hal.write_rf(0, RR_RXBB, RR_RXBB_ATTC, 0);
+        hal.write_rf(0, RR_RXBB, RR_RXBB_ATTR, 0x7);
+    } else {
+        hal.write_rf(0, RR_RXA2, RR_RAA2_SATT, 0x3);
+    }
+    hal.write_rf(0, RR_RCKD, RR_RCKD_BW, 1);
+    hal.write_rf(0, RR_BTC, RR_BTC_TXBB, dpk.bw as u32 + 1);
+    hal.write_rf(0, RR_BTC, RR_BTC_RXBB, 0);
+    hal.write_rf(0, RR_RXBB2, RR_RXBB2_EBW, 0);
+    set_rx_dck(hal, RF_DPK);
+    // `_dpk_kip_pwr_clk_onoff` (on), `_dpk_kip_preset`.
+    hal.phy_w32_mask(R_NCTL_RPT, MASKDWORD, 0x0000_0080);
+    hal.phy_w32_mask(R_KIP_SYSCFG, MASKDWORD, 0x807f_030a);
+    let mode = hal.read_rf(0, RR_MOD, RFREG_MASK);
+    hal.phy_w32_mask(R_KIP_MOD, B_KIP_MOD, mode);
+    hal.phy_w32_mask(R_DPD_CH0A, B_DPD_SEL, 0x01);
+    dpk_kip_control_rfc(hal, true);
+    dpk_one_shot(hal, D_KIP_PRESET);
+    dpk_txpwr_bb_force(hal, true);
+    dpk_kip_set_txagc(hal, dpk, Some(DPK_INIT_DBM));
+    // `_dpk_tpg_sel`.
+    let (mode, sel) = match dpk.bw {
+        2 => (0x0, 0xffe0_fa00),
+        1 => (0x2, 0xff40_09e0),
+        _ => (0x1, 0xf9f0_07d0),
+    };
+    hal.phy_w32_mask(R_TPG_MOD, B_TPG_MOD_F, mode);
+    hal.phy_w32_mask(R_TPG_SEL, MASKDWORD, sel);
+    let failed = dpk_agc(hal, dpk);
+    if !failed {
+        // `_dpk_idl_mpa`.
+        let order = if hal.phy_r32_mask(R_IDL_MPA, B_IDL_MD500) == 1 {
+            2
+        } else if hal.phy_r32_mask(R_IDL_MPA, B_IDL_MD530) == 1 {
+            1
+        } else {
+            0
+        };
+        dpk_set_mdpd_para(hal, order);
+        hal.phy_w32_mask(R_DPK_IDL, B_DPK_IDL, 0);
+        crate::delay_ms(1);
+        dpk_one_shot(hal, D_MDPK_IDL);
+        // `_dpk_para_query`.
+        let par = dpk_par_reg(dpk);
+        let para = hal.phy_r32_mask(par, MASKDWORD);
+        dpk.txagc = (para >> 10) & 0x3f;
+        dpk.ther_dpk = (para >> 26) & 0x3f;
+        // `_dpk_on`.
+        hal.phy_w32_mask(R_LOAD_COEF, B_LOAD_COEF_MDPD, 1);
+        hal.phy_w32_mask(R_LOAD_COEF, B_LOAD_COEF_MDPD, 0);
+        let convert = match hal.phy_r32_mask(R_LDL_NORM, B_LDL_NORM_OP) {
+            0 => 0x6,
+            1 => 0x2,
+            2 => 0x0,
+            _ => 0xff,
+        };
+        hal.phy_w32_mask(R_DPD_CH0A, B_DPD_ORDER, convert);
+        dpk.path_ok |= 1u32.checked_shl(dpk.cur_k_set).unwrap_or(0);
+        hal.phy_w32_mask(R_DPD_CH0A, B_DPD_MEN, dpk.path_ok);
+        // `_dpk_gain_normalize` (not executed).
+        hal.phy_w32_mask(par, DPK_PARA_GS, DPK_GS_DEFAULT);
+        dpk.gs = hal.phy_r32_mask(par, DPK_PARA_GS);
+    }
+    dpk_kip_control_rfc(hal, false);
+    hal.write_rf(0, RR_MOD, RR_MOD_MASK, RF_RX);
+    failed
+}
+
+/// `rtw8851b_dpk` (`_dpk_cal_select`).
+fn dpk(hal: &Hal, state: &mut State, chan: &Chan) {
+    crate::sta::stop_sch_tx(hal, true);
+    wait_rx_mode(hal);
+    let kip = DPK_KIP_REGS.map(|reg| hal.phy_r32_mask(reg, MASKDWORD));
+    let rf = DPK_RF_REGS.map(|reg| hal.read_rf(0, reg, RFREG_MASK));
+    state.dpk = Dpk { band: chan.band, bw: chan.bw, ..Default::default() };
+    if state.tssi_mode {
+        hal.phy_w32_mask(R_P0_TSSI_TRK, B_P0_TSSI_TRK_EN, 1);
+    }
+    hal.phy_w32_mask(R_P0_TSSI_SLOPE_CAL, B_P0_TSSI_SLOPE_CAL_EN, 0);
+    hal.phy_w32_mask(R_P0_AGC_CTL, B_P0_AGC_EN, 0);
+    hal.write_rf(0, RR_BBDC, RR_BBDC_SEL, 0);
+    dpk_bb_afe_setting(hal);
+    let failed = dpk_main(hal, &mut state.dpk);
+    dpk_onoff(hal, &state.dpk, failed);
+    // `_dpk_kip_restore`.
+    dpk_one_shot(hal, D_KIP_RESTORE);
+    dpk_kip_control_rfc(hal, false);
+    dpk_txpwr_bb_force(hal, false);
+    for (&reg, &value) in DPK_KIP_REGS.iter().zip(&kip) {
+        hal.phy_w32_mask(reg, MASKDWORD, value);
+    }
+    for (&reg, &value) in DPK_RF_REGS.iter().zip(&rf) {
+        hal.write_rf(0, reg, RFREG_MASK, value);
+    }
+    dpk_bb_afe_restore(hal);
+    hal.phy_w32_mask(R_P0_AGC_CTL, B_P0_AGC_EN, 1);
+    hal.phy_w32_mask(R_P0_TSSI_SLOPE_CAL, B_P0_TSSI_SLOPE_CAL_EN, 1);
+    if state.tssi_mode {
+        hal.phy_w32_mask(R_P0_TSSI_TRK, B_P0_TSSI_TRK_EN, 0);
+    }
+    // `_dpk_kip_pwr_clk_onoff` (off).
+    hal.phy_w32_mask(R_NCTL_RPT, MASKDWORD, 0);
+    hal.phy_w32_mask(R_KIP_SYSCFG, MASKDWORD, 0x8000_0000);
+    hal.phy_w32_mask(R_DPK_WR, 1 << 18, 1);
+    crate::sta::stop_sch_tx(hal, false);
+}
+
+/// `_dpk_track`: the power scaling factor moved by two thirds of the
+/// KIP's thermal change since the calibration.
+fn dpk_track(hal: &Hal, state: &State) {
+    let txagc_rf = hal.phy_r32_mask(R_TXAGC_BB, B_TXAGC_RF);
+    hal.phy_w32_mask(R_KIP_RPT, B_KIP_RPT_SEL, 0xf);
+    let current = hal.phy_r32_mask(R_RPT_PER, B_RPT_PER_TH);
+    let delta = (current as i32 - state.dpk.ther_dpk as i32) as i8 as i32;
+    let delta = (delta * 2 / 3) as i8 as i32;
+    if hal.phy_r32_mask(R_IDL_MPA, B_IDL_DN) == 0 && txagc_rf != 0 {
+        hal.phy_w32_mask(R_DPD_BND, 0x07fc_0000, (DPK_PWSF - delta) as u32);
+    }
+}
