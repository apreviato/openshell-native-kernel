diff --git a/kernel/comps/rtw89/src/be.rs b/kernel/comps/rtw89/src/be.rs
new file mode 100644
index 0000000..14d3d00
--- /dev/null
+++ b/kernel/comps/rtw89/src/be.rs
@@ -0,0 +1,889 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The 802.11be generation's MAC (the RTL8922A), as Linux's rtw89
+//! `mac_be.c` and the BE branches of `mac.c` run it: the chip's power,
+//! the crystal's serial interface, the DMAC before the download (its DMA
+//! mode, the DLE's pages and quotas, the H2C channel's flow control), the
+//! CPU's start for a download and the firmware's states, then the DMAC's
+//! and CMAC's functions; the eFuse (`efuse_be.c`: four-byte reads, the
+//! logical blocks' three-byte headers, the secure-boot selection).
+
+use alloc::{format, string::String, vec, vec::Vec};
+
+use crate::{
+    fw::{Secure, secure_v1},
+    hal::{ChipId, DleMem, Hal, field, get},
+    mac::{Efuse, TSSI_MCS_2G_GROUPS, Tssi, xtal},
+    regs::*,
+};
+
+/// `enum rtw89_fwdl_status`'s ready state, and `fwdl_status_map`: the BE
+/// firmware's own numbers to the common ones (initial, ongoing, WCPU
+/// download ready, firmware ready, checksum, security twice, cut, reserved
+/// twice).
+pub(crate) const FWDL_INIT_RDY: u8 = 7;
+const FWDL_STATUS_MAP: [u8; 10] = [0, 1, 6, 7, 2, 3, 3, 4, 5, 5];
+
+fn poll(hal: &Hal, addr: u32, done: impl Fn(u32) -> bool, what: &str) -> Result<(), String> {
+    hal.poll32(addr, done, 1000, 3_000_000).map(|_| ()).map_err(|_| format!("{what} did not happen"))
+}
+
+/// `rtw8922a_pwr_on_func`: the system's power, the MAC's, the AXI DMA,
+/// the analog parts through the crystal's interface, then the DMAC's and
+/// CMAC's functions and the baseband out of reset.
+pub(crate) fn power_on_8922a(hal: &Hal) -> Result<(), String> {
+    hal.clr32(R_BE_SYS_PW_CTRL, B_BE_AFSM_WLSUS_EN | B_BE_AFSM_PCIE_SUS_EN);
+    hal.set32(R_BE_SYS_PW_CTRL, B_BE_DIS_WLBT_PDNSUSEN_SOPC);
+    hal.set32(R_BE_WLLPS_CTRL, B_BE_DIS_WLBT_LPSEN_LOPC);
+    hal.clr32(R_BE_SYS_PW_CTRL, B_BE_APDM_HPDN);
+    hal.clr32(R_BE_SYS_PW_CTRL, B_BE_APFM_SWLPS);
+    poll(hal, R_BE_SYS_PW_CTRL, |value| value & B_BE_RDY_SYSPWR != 0, "the system's power")?;
+    hal.set32(R_BE_SYS_PW_CTRL, B_BE_EN_WLON);
+    hal.set32(R_BE_WLRESUME_CTRL, B_BE_LPSROP_CMAC0 | B_BE_LPSROP_CMAC1);
+    hal.set32(R_BE_SYS_PW_CTRL, B_BE_APFN_ONMAC);
+    poll(hal, R_BE_SYS_PW_CTRL, |value| value & B_BE_APFN_ONMAC == 0, "the MAC's power")?;
+    hal.clr32(R_BE_AFE_ON_CTRL1, B_BE_REG_CK_MON_CK960M_EN);
+    hal.set8(R_BE_ANAPAR_POW_MAC, B_BE_POW_PC_LDO_PORT0 | B_BE_POW_PC_LDO_PORT1);
+    hal.clr32(R_BE_FEN_RST_ENABLE, B_BE_R_SYM_ISO_ADDA_P02PP | B_BE_R_SYM_ISO_ADDA_P12PP);
+    hal.set8(R_BE_PLATFORM_ENABLE, B_BE_PLATFORM_EN);
+    hal.set32(R_BE_HCI_OPT_CTRL, B_BE_HAXIDMA_IO_EN);
+    poll(hal, R_BE_HCI_OPT_CTRL, |value| value & B_BE_HAXIDMA_IO_ST != 0, "the AXI DMA's I/O")?;
+    poll(hal, R_BE_HCI_OPT_CTRL, |value| value & B_BE_HAXIDMA_BACKUP_RESTORE_ST == 0, "the AXI DMA's restore")?;
+    hal.set32(R_BE_HCI_OPT_CTRL, B_BE_HCI_WLAN_IO_EN);
+    poll(hal, R_BE_HCI_OPT_CTRL, |value| value & B_BE_HCI_WLAN_IO_ST != 0, "the WLAN's I/O")?;
+    hal.clr32(R_BE_SYS_SDIO_CTRL, B_BE_PCIE_FORCE_IBX_EN);
+    xtal(hal, XTAL_SI_PLL, 0x02, 0x02)?;
+    xtal(hal, XTAL_SI_PLL, 0x01, 0x01)?;
+    hal.set32(R_BE_SYS_ADIE_PAD_PWR_CTRL, B_BE_SYM_PADPDN_WL_RFC1_1P3);
+    xtal(hal, XTAL_SI_ANAPAR_WL, 0x40, 0x40)?;
+    hal.set32(R_BE_SYS_ADIE_PAD_PWR_CTRL, B_BE_SYM_PADPDN_WL_RFC0_1P3);
+    for (offset, value, mask) in [
+        (XTAL_SI_ANAPAR_WL, 0x20, 0x20),
+        (XTAL_SI_ANAPAR_WL, 0x04, 0x04),
+        (XTAL_SI_ANAPAR_WL, 0x08, 0x08),
+        (XTAL_SI_ANAPAR_WL, 0, 0x10),
+        (XTAL_SI_WL_RFC_S0, 0xeb, 0xff),
+        (XTAL_SI_WL_RFC_S1, 0xeb, 0xff),
+        (XTAL_SI_ANAPAR_WL, 0x01, 0x01),
+        (XTAL_SI_ANAPAR_WL, 0x02, 0x02),
+        (XTAL_SI_ANAPAR_WL, 0, 0x80),
+        (XTAL_SI_XREF_RF1, 0, 0x40),
+        (XTAL_SI_XREF_RF2, 0, 0x40),
+        (XTAL_SI_PLL_1, 0x40, 0x60),
+        (XTAL_SI_SRAM_CTRL, 0, XTAL_SI_SRAM_DIS),
+    ] {
+        xtal(hal, offset, value, mask)?;
+    }
+    if hal.cv != CHIP_CAV as u8 {
+        hal.set32(R_BE_PMC_DBG_CTRL2, B_BE_SYSON_DIS_PMCR_BE_WRMSK);
+        hal.set32(R_BE_SYS_ISO_CTRL, B_BE_ISO_EB2CORE);
+        hal.clr32(R_BE_SYS_ISO_CTRL, B_BE_PWC_EV2EF_B);
+        crate::delay_ms(1);
+        hal.clr32(R_BE_SYS_ISO_CTRL, B_BE_PWC_EV2EF_S);
+        hal.clr32(R_BE_PMC_DBG_CTRL2, B_BE_SYSON_DIS_PMCR_BE_WRMSK);
+    }
+    hal.set32(
+        R_BE_DMAC_FUNC_EN,
+        B_BE_MAC_FUNC_EN
+            | B_BE_DMAC_FUNC_EN
+            | B_BE_MPDU_PROC_EN
+            | B_BE_WD_RLS_EN
+            | B_BE_DLE_WDE_EN
+            | B_BE_TXPKT_CTRL_EN
+            | B_BE_STA_SCH_EN
+            | B_BE_DLE_PLE_EN
+            | B_BE_PKT_BUF_EN
+            | B_BE_DMAC_TBL_EN
+            | B_BE_PKT_IN_EN
+            | B_BE_DLE_CPUIO_EN
+            | B_BE_DISPATCHER_EN
+            | B_BE_BBRPT_EN
+            | B_BE_MAC_SEC_EN
+            | B_BE_H_AXIDMA_EN
+            | B_BE_DMAC_MLO_EN
+            | B_BE_PLRLS_EN
+            | B_BE_P_AXIDMA_EN
+            | B_BE_DLE_DATACPUIO_EN
+            | B_BE_LTR_CTL_EN,
+    );
+    hal.set32(R_BE_CMAC_SHARE_FUNC_EN, B_BE_CMAC_SHARE_EN | B_BE_RESPBA_EN | B_BE_ADDRSRCH_EN | B_BE_BTCOEX_EN);
+    hal.set32(
+        R_BE_CMAC_FUNC_EN,
+        B_BE_CMAC_EN | B_BE_CMAC_TXEN | B_BE_CMAC_RXEN | B_BE_SIGB_EN | B_BE_PHYINTF_EN | B_BE_CMAC_DMA_EN | B_BE_PTCLTOP_EN | B_BE_SCHEDULER_EN | B_BE_TMAC_EN | B_BE_RMAC_EN | B_BE_TXTIME_EN | B_BE_RESP_PKTCTL_EN,
+    );
+    hal.set32(R_BE_FEN_RST_ENABLE, B_BE_FEN_BB_IP_RSTN | B_BE_FEN_BBPLAT_RSTB);
+    Ok(())
+}
+
+/// `rtw89_mac_dle_init` with the BE generation's registers: the pages
+/// (their start bound given), the quotas, both engines ready.
+fn dle_init(hal: &Hal, mem: &DleMem, ext_wcpu: Option<u16>) -> Result<(), String> {
+    hal.clr32(R_BE_DMAC_FUNC_EN, B_BE_DLE_WDE_EN | B_BE_DLE_PLE_EN);
+    hal.set32(R_BE_DMAC_CLK_EN, B_BE_DLE_WDE_CLK_EN | B_BE_DLE_PLE_CLK_EN);
+    let replace = |value: u32, mask: u32, new: u32| (value & !mask) | field(mask, new);
+    // `dle_mix_cfg_be`.
+    let mut wde = hal.r32(R_BE_WDE_PKTBUF_CFG);
+    wde = replace(wde, B_BE_WDE_PAGE_SEL_MASK, if mem.wde.page == 128 { S_AX_WDE_PAGE_SEL_128 } else { S_AX_WDE_PAGE_SEL_64 });
+    wde = replace(wde, B_BE_WDE_START_BOUND_MASK, mem.wde.start / DLE_BOUND_UNIT);
+    wde = replace(wde, B_BE_WDE_FREE_PAGE_NUM_MASK, mem.wde.linked);
+    hal.w32(R_BE_WDE_PKTBUF_CFG, wde);
+    let mut ple = hal.r32(R_BE_PLE_PKTBUF_CFG);
+    ple = replace(ple, B_BE_PLE_PAGE_SEL_MASK, if mem.ple.page == 256 { S_AX_PLE_PAGE_SEL_256 } else { S_AX_PLE_PAGE_SEL_128 });
+    ple = replace(ple, B_BE_PLE_START_BOUND_MASK, mem.ple.start / DLE_BOUND_UNIT);
+    ple = replace(ple, B_BE_PLE_FREE_PAGE_NUM_MASK, mem.ple.linked);
+    hal.w32(R_BE_PLE_PKTBUF_CFG, ple);
+    // `wde_quota_cfg_be`, `ple_quota_cfg_be` (the RTL8922A's thirteen).
+    let quota = |reg: u32, min: u16, max: u16, min_mask: u32, max_mask: u32| hal.w32(reg, field(min_mask, min as u32) | field(max_mask, max as u32));
+    let (min, max) = (mem.wde_min, mem.wde_max);
+    let wcpu_min = ext_wcpu.unwrap_or(min.wcpu);
+    let wde_regs = [R_BE_WDE_QTA0_CFG, R_BE_WDE_QTA1_CFG, R_BE_WDE_QTA2_CFG, R_BE_WDE_QTA3_CFG, R_BE_WDE_QTA4_CFG];
+    let wde_values = [(min.hif, max.hif), (wcpu_min, max.wcpu.max(wcpu_min)), (0, 0), (min.pkt_in, max.pkt_in), (min.cpu_io, max.cpu_io)];
+    for (reg, (low, high)) in wde_regs.iter().zip(wde_values) {
+        quota(*reg, low, high, B_BE_WDE_Q0_MIN_SIZE_MASK, B_BE_WDE_Q0_MAX_SIZE_MASK);
+    }
+    let ple_regs = [
+        R_BE_PLE_QTA0_CFG,
+        R_BE_PLE_QTA1_CFG,
+        R_BE_PLE_QTA2_CFG,
+        R_BE_PLE_QTA3_CFG,
+        R_BE_PLE_QTA4_CFG,
+        R_BE_PLE_QTA5_CFG,
+        R_BE_PLE_QTA6_CFG,
+        R_BE_PLE_QTA7_CFG,
+        R_BE_PLE_QTA8_CFG,
+        R_BE_PLE_QTA9_CFG,
+        R_BE_PLE_QTA10_CFG,
+        R_BE_PLE_QTA11_CFG,
+        R_BE_PLE_QTA12_CFG,
+    ];
+    for (index, reg) in ple_regs.iter().enumerate() {
+        let (low, high) = if index < 12 { (mem.ple_min.0[index], mem.ple_max.0[index]) } else { (mem.ple_h2d.0, mem.ple_h2d.1) };
+        quota(*reg, low, high, B_BE_PLE_Q0_MIN_SIZE_MASK, B_BE_PLE_Q0_MAX_SIZE_MASK);
+    }
+    hal.set32(R_BE_DMAC_FUNC_EN, B_BE_DLE_WDE_EN | B_BE_DLE_PLE_EN);
+    for (reg, mask, what) in [(R_AX_WDE_INI_STATUS, WDE_MGN_INI_RDY, "WDE"), (R_AX_PLE_INI_STATUS, PLE_MGN_INI_RDY, "PLE")] {
+        if hal.poll32(reg, |value| value & mask == mask, 1, 2000).is_err() {
+            return Err(format!("the {what} did not get ready"));
+        }
+    }
+    Ok(())
+}
+
+/// `rtw89_mac_hfc_init` with the BE registers: for the download only the
+/// H2C channel's pages, else each DMA channel's, the public ones, the
+/// mix, then flow control on.
+pub(crate) fn hfc_init(hal: &Hal, download: bool) -> Result<(), String> {
+    let (ch011, h2c, wp07, wp811, ch011_full, h2c_full, wp07_full, wp811_full) = if download { HFC_PREC_C2 } else { HFC_PREC_C0 };
+    hal.clr32(R_BE_HCI_FC_CTRL, B_BE_HCI_FC_EN | B_BE_HCI_FC_CH12_EN);
+    if download {
+        hal.w32(R_BE_CH_PAGE_CTRL, field(B_BE_PREC_PAGE_CH12_V1_MASK, h2c as u32));
+        hal.set32(R_BE_HCI_FC_CTRL, B_BE_HCI_FC_CH12_EN);
+        return Ok(());
+    }
+    let hfc = &hal.chip.hfc;
+    for (channel, &(min, max, group)) in hfc.channels.iter().enumerate() {
+        if hal.chip.dma_ch_mask & (1 << channel) != 0 {
+            continue;
+        }
+        hal.w32(R_BE_CH0_PAGE_CTRL + channel as u32 * 4, field(B_AX_MIN_PG_MASK, min as u32) | field(B_AX_MAX_PG_MASK, max as u32) | if group { B_AX_GRP } else { 0 });
+    }
+    let (g0, g1, pub_max, wp_thrd) = hfc.public;
+    hal.w32(R_BE_PUB_PAGE_CTRL1, field(B_AX_PUBPG_G0_MASK, g0 as u32) | field(B_AX_PUBPG_G1_MASK, g1 as u32));
+    hal.w32(R_BE_WP_PAGE_CTRL2, field(B_AX_WP_THRD_MASK, wp_thrd as u32));
+    // `hfc_mix_cfg_be`.
+    hal.w32(R_BE_CH_PAGE_CTRL, field(B_BE_PREC_PAGE_CH011_V1_MASK, ch011 as u32) | field(B_BE_PREC_PAGE_CH12_V1_MASK, h2c as u32));
+    hal.w32(R_BE_PUB_PAGE_CTRL2, field(B_BE_PUBPG_ALL_MASK, pub_max as u32));
+    hal.w32(R_BE_WP_PAGE_CTRL1, field(B_BE_PREC_PAGE_WP_CH07_MASK, wp07 as u32) | field(B_BE_PREC_PAGE_WP_CH811_MASK, wp811 as u32));
+    let replace = |value: u32, mask: u32, new: u32| (value & !mask) | field(mask, new);
+    let mut ctrl = hal.r32(R_BE_HCI_FC_CTRL);
+    ctrl = replace(ctrl, B_BE_HCI_FC_MODE_MASK, RTW89_HCIFC_POH);
+    ctrl = replace(ctrl, B_BE_HCI_FC_WD_FULL_COND_MASK, ch011_full as u32);
+    ctrl = replace(ctrl, B_BE_HCI_FC_CH12_FULL_COND_MASK, h2c_full as u32);
+    ctrl = replace(ctrl, B_BE_HCI_FC_WP_CH07_FULL_COND_MASK, wp07_full as u32);
+    ctrl = replace(ctrl, B_BE_HCI_FC_WP_CH811_FULL_COND_MASK, wp811_full as u32);
+    hal.w32(R_BE_HCI_FC_CTRL, ctrl);
+    hal.set32(R_BE_HCI_FC_CTRL, B_BE_HCI_FC_EN | B_BE_HCI_FC_CH12_EN);
+    crate::delay_us(10);
+    Ok(())
+}
+
+/// `rtw89_mac_size.hfc_prec_cfg_c0` and `_c2` (PCIe and the download).
+const HFC_PREC_C0: (u16, u16, u16, u16, u8, u8, u8, u8) = (2, 32, 0, 0, 0, 0, 0, 0);
+const HFC_PREC_C2: (u16, u16, u16, u16, u8, u8, u8, u8) = (0, 256, 0, 0, 0, 0, 0, 0);
+
+/// `rtw89_mac_dmac_pre_init` on the BE chips: the HCI's DMA, the DMA mode
+/// (PCIe without a data CPU), TX of channel group 1 not stopped, the
+/// DMAC's tables by address, the download's DLE and flow control.
+pub(crate) fn dmac_pre_init(hal: &Hal) -> Result<(), String> {
+    hal.set32(R_BE_HCI_FUNC_EN, B_BE_HCI_TXDMA_EN | B_BE_HCI_RXDMA_EN);
+    let value = hal.r32(R_BE_HAXI_INIT_CFG1);
+    hal.w32(R_BE_HAXI_INIT_CFG1, (value & !B_BE_DMA_MODE_MASK) | field(B_BE_DMA_MODE_MASK, S_BE_DMA_MOD_PCIE_NO_DATA_CPU));
+    hal.clr32(R_BE_HAXI_DMA_STOP1, B_BE_TX_STOP1_MASK);
+    hal.set32(R_BE_DMAC_TABLE_CTRL, B_BE_DMAC_ADDR_MODE);
+    dle_init(hal, &hal.chip.dlfw, Some(hal.chip.scc.wde_min.wcpu))?;
+    hfc_init(hal, true)
+}
+
+/// `rtw89_mac_disable_cpu_be`.
+pub(crate) fn disable_cpu(hal: &Hal) {
+    hal.clr32(R_BE_PLATFORM_ENABLE, B_BE_WCPU_EN);
+    hal.set32(R_BE_PLATFORM_ENABLE, B_BE_HOLD_AFTER_RESET);
+    hal.set32(R_BE_PLATFORM_ENABLE, B_BE_WCPU_EN);
+    let run_env = hal.r32(R_BE_WCPU_FW_CTRL) & B_BE_RUN_ENV_MASK;
+    hal.w32(R_BE_WCPU_FW_CTRL, run_env);
+    hal.set32(R_BE_DCPU_PLATFORM_ENABLE, B_BE_DCPU_PLATFORM_EN);
+    hal.w32(R_BE_UDM0, 0);
+    hal.w32(R_BE_HALT_C2H, 0);
+    hal.w32(R_BE_UDM2, 0);
+}
+
+/// `rtw89_mac_fwdl_enable_wcpu_be` for a download (`set_cpu_en`,
+/// `wcpu_on`): the WLAN CPU's (and the BB MCU's) download on, the
+/// firmware's debug registers cleared, the CPU's clock and cut, then the
+/// CPU out of reset.
+pub(crate) fn enable_wcpu(hal: &Hal, include_bb: bool) {
+    let mut set = B_BE_WLANCPU_FWDL_EN;
+    if include_bb {
+        set |= B_BE_BBMCU0_FWDL_EN;
+    }
+    hal.set32(R_BE_WCPU_FW_CTRL, set);
+    for reg in [R_BE_UDM1, R_BE_UDM2, R_BE_BOOT_DBG, R_BE_HALT_H2C, R_BE_HALT_C2H, R_BE_HALT_H2C_CTRL, R_BE_HALT_C2H_CTRL] {
+        hal.w32(reg, 0);
+    }
+    let _ = hal.r32(R_BE_HISR0);
+    hal.w32(R_BE_HISR0, B_BE_HALT_C2H_INT);
+    hal.set32(R_BE_SYS_CLK_CTRL, B_BE_CPU_CLK_EN);
+    hal.clr32(R_BE_SYS_CFG5, B_BE_WDT_WAKE_PCIE_EN | B_BE_WDT_WAKE_USB_EN);
+    hal.clr32(R_BE_WCPU_FW_CTRL, B_BE_WDT_PLT_RST_EN | B_BE_WCPU_ROM_CUT_GET);
+    hal.w32(R_BE_SECURE_BOOT_MALLOC_INFO, 0);
+    hal.clr32(R_BE_GPIO_MUXCFG, B_BE_BOOT_MODE);
+    hal.w32_mask(R_BE_WCPU_FW_CTRL, B_BE_WCPU_ROM_CUT_VAL_MASK, hal.cv as u32 + 1);
+    hal.w16_mask(R_BE_BOOT_REASON, B_BE_BOOT_REASON_MASK, 0);
+    hal.clr32(R_BE_PLATFORM_ENABLE, B_BE_WCPU_EN);
+    hal.clr32(R_BE_PLATFORM_ENABLE, B_BE_HOLD_AFTER_RESET);
+    hal.set32(R_BE_PLATFORM_ENABLE, B_BE_WCPU_EN);
+}
+
+/// `rtw89_fwdl_check_path_ready_be`: the H2C path, or the download's.
+pub(crate) fn path_ready(hal: &Hal, h2c: bool) -> bool {
+    let check = if h2c { B_BE_H2C_PATH_RDY } else { B_BE_DLFW_PATH_RDY };
+    hal.poll32(R_BE_WCPU_FW_CTRL, |value| value & check != 0, 1, 1_000_000).is_ok()
+}
+
+/// `fwdl_get_status_be`: with `done` (a CPU's download-enable bit), ready
+/// once that bit is down; else (the firmware's own start) its state.
+pub(crate) fn fwdl_status(hal: &Hal, done: Option<u32>) -> u8 {
+    let value = hal.r32(R_BE_WCPU_FW_CTRL);
+    if done.is_some_and(|bit| value & bit == 0) {
+        return FWDL_INIT_RDY;
+    }
+    let state = get(B_BE_WCPU_FWDL_STATUS_MASK, value) as usize;
+    FWDL_STATUS_MAP.get(state).copied().unwrap_or(state as u8)
+}
+
+/// `rtw8922a_mac_enable_bb_rf`.
+pub(crate) fn enable_bb_rf(hal: &Hal) {
+    hal.set8(R_BE_FEN_RST_ENABLE, B_BE_FEN_BBPLAT_RSTB | B_BE_FEN_BB_IP_RSTN);
+    hal.w32(R_BE_DMAC_SYS_CR32B, 0x7ff9_7ff9);
+}
+
+/// `rtw89_mac_power_switch` on: the power state reset, the chip's power
+/// on, its eFuse cut, the always-on interrupt cleared, Bluetooth told.
+pub(crate) fn power_on(hal: &mut Hal) -> Result<(), String> {
+    reset_pwr_state(hal)?;
+    power_on_8922a(hal)?;
+    // `rtw89_efuse_read_ecv_be`: the cut the eFuse names.
+    let at = EF_FV_OFSET_BE_V1 & !3;
+    if let Ok(word) = physical(hal, at, 4) {
+        let cv = get(EF_CV_MASK, word[(EF_FV_OFSET_BE_V1 & 3) as usize] as u32) as u8;
+        if cv != EF_CV_INV as u8 {
+            hal.cv = cv;
+        }
+    }
+    // `clr_aon_intr_be`, `rtw89_mac_update_scoreboard`.
+    hal.clr32(R_BE_FWS0IMR, B_BE_FS_GPIOA_INT_EN);
+    hal.set32(R_BE_FWS0ISR, B_BE_FS_GPIOA_INT);
+    hal.w8(R_BE_SCOREBOARD + 3, MAC_AX_NOTIFY_TP_MAJOR as u8);
+    Ok(())
+}
+
+/// `rtw89_mac_reset_pwr_state_be`: the power FSM idle, then the MAC off
+/// from whatever state it was left in (on, or in low power).
+fn reset_pwr_state(hal: &Hal) -> Result<(), String> {
+    let fsm = (hal.r32(R_BE_SYSON_FSM_MON) & WLAN_FSM_MASK) | WLAN_FSM_SET;
+    hal.w32(R_BE_SYSON_FSM_MON, fsm);
+    poll(hal, R_BE_SYSON_FSM_MON, |value| get(WLAN_FSM_STATE_MASK, value) == WLAN_FSM_IDLE, "the power FSM's idle")?;
+    let state = hal.r32_mask(R_BE_IC_PWR_STATE, B_BE_WLMAC_PWR_STE_MASK);
+    if ![MAC_AX_MAC_OFF, MAC_AX_MAC_ON, MAC_AX_MAC_LPS].contains(&state) {
+        return Ok(());
+    }
+    hal.clr32(R_BE_HCI_OPT_CTRL, B_BE_HAXIDMA_IO_EN);
+    poll(hal, R_BE_HCI_OPT_CTRL, |value| value & (B_BE_HAXIDMA_IO_ST | B_BE_HAXIDMA_BACKUP_RESTORE_ST) == 0, "the AXI DMA's I/O off")?;
+    hal.clr32(R_BE_HCI_OPT_CTRL, B_BE_HCI_WLAN_IO_EN);
+    poll(hal, R_BE_HCI_OPT_CTRL, |value| value & B_BE_HCI_WLAN_IO_ST == 0, "the WLAN's I/O off")?;
+    if state == MAC_AX_MAC_LPS {
+        hal.set32(R_BE_WLLPS_CTRL, B_BE_FORCE_LEAVE_LPS);
+        poll(hal, R_BE_IC_PWR_STATE, |value| get(B_BE_WLMAC_PWR_STE_MASK, value) == MAC_AX_MAC_ON, "leaving low power")?;
+    }
+    if state != MAC_AX_MAC_OFF {
+        hal.set32(R_BE_SYS_PW_CTRL, B_BE_EN_WLON);
+        hal.set32(R_BE_SYS_PW_CTRL, B_BE_APFM_OFFMAC);
+        poll(hal, R_BE_SYS_PW_CTRL, |value| value & B_BE_APFM_OFFMAC == 0, "the MAC's power off")?;
+        if state == MAC_AX_MAC_LPS {
+            hal.clr32(R_BE_WLLPS_CTRL, B_BE_FORCE_LEAVE_LPS);
+        }
+    }
+    hal.clr32(R_BE_SYS_PW_CTRL, B_BE_EN_WLON);
+    hal.clr32(R_BE_SYS_PW_CTRL, B_BE_APFM_SWLPS);
+    Ok(())
+}
+
+/// `rtw8922a_pwr_off_func`.
+pub(crate) fn power_off(hal: &Hal) -> Result<(), String> {
+    for (offset, value, mask) in [
+        (XTAL_SI_ANAPAR_WL, 0x10, 0x10),
+        (XTAL_SI_ANAPAR_WL, 0, 0x08),
+        (XTAL_SI_ANAPAR_WL, 0, 0x04),
+        (XTAL_SI_WL_RFC_S0, 0xc6, 0xff),
+        (XTAL_SI_WL_RFC_S1, 0xc6, 0xff),
+        (XTAL_SI_ANAPAR_WL, 0x80, 0x80),
+        (XTAL_SI_ANAPAR_WL, 0, 0x02),
+        (XTAL_SI_ANAPAR_WL, 0, 0x01),
+        (XTAL_SI_PLL, 0x02, 0xff),
+        (XTAL_SI_PLL, 0, 0xff),
+    ] {
+        xtal(hal, offset, value, mask)?;
+    }
+    hal.set32(R_BE_FEN_RST_ENABLE, B_BE_R_SYM_ISO_ADDA_P02PP | B_BE_R_SYM_ISO_ADDA_P12PP);
+    hal.clr8(R_BE_ANAPAR_POW_MAC, B_BE_POW_PC_LDO_PORT0 | B_BE_POW_PC_LDO_PORT1);
+    hal.set32(R_BE_SYS_PW_CTRL, B_BE_EN_WLON);
+    hal.clr8(R_BE_FEN_RST_ENABLE, B_BE_FEN_BB_IP_RSTN | B_BE_FEN_BBPLAT_RSTB);
+    hal.clr32(R_BE_SYS_ADIE_PAD_PWR_CTRL, B_BE_SYM_PADPDN_WL_RFC0_1P3);
+    xtal(hal, XTAL_SI_ANAPAR_WL, 0, 0x20)?;
+    hal.clr32(R_BE_SYS_ADIE_PAD_PWR_CTRL, B_BE_SYM_PADPDN_WL_RFC1_1P3);
+    xtal(hal, XTAL_SI_ANAPAR_WL, 0, 0x40)?;
+    hal.clr32(R_BE_HCI_OPT_CTRL, B_BE_HAXIDMA_IO_EN);
+    poll(hal, R_BE_HCI_OPT_CTRL, |value| value & B_BE_HAXIDMA_IO_ST == 0, "the AXI DMA's I/O off")?;
+    poll(hal, R_BE_HCI_OPT_CTRL, |value| value & B_BE_HAXIDMA_BACKUP_RESTORE_ST == 0, "the AXI DMA's backup")?;
+    hal.clr32(R_BE_HCI_OPT_CTRL, B_BE_HCI_WLAN_IO_EN);
+    poll(hal, R_BE_HCI_OPT_CTRL, |value| value & B_BE_HCI_WLAN_IO_ST == 0, "the WLAN's I/O off")?;
+    hal.set32(R_BE_SYS_PW_CTRL, B_BE_APFM_OFFMAC);
+    poll(hal, R_BE_SYS_PW_CTRL, |value| value & B_BE_APFM_OFFMAC == 0, "the MAC's power off")?;
+    hal.w32(R_BE_WLLPS_CTRL, 0x0000_a1b2);
+    hal.clr32(R_BE_SYS_PW_CTRL, B_BE_XTAL_OFF_A_DIE);
+    hal.set32(R_BE_SYS_PW_CTRL, B_BE_APFM_SWLPS);
+    hal.w32(R_BE_UDM1, 0);
+    Ok(())
+}
+
+// ---- The eFuse. ----
+
+/// The RTL8922A's logical RF block (`rtw8922a_efuse_blocks`,
+/// `struct rtw8922a_efuse`): its page and size, the fields' offsets.
+const EFUSE_RF_PAGE: u32 = 1;
+const EFUSE_RF_SIZE: usize = 0x240;
+const EFUSE_RF_COUNTRY: usize = 0x00;
+const EFUSE_RF_XTAL_K: usize = 0xb9;
+const EFUSE_RF_RFE_TYPE: usize = 0xca;
+/// `struct rtw8922a_efuse`: each path's TSSI offsets (`struct
+/// rtw8922a_tssi_offset`: CCK's, 2.4 GHz's at 40 MHz, then after seven
+/// reserved bytes 5 GHz's), its thermal value, its 6 GHz offsets.
+const EFUSE_RF_TSSI: [usize; 2] = [0x10, 0x3a];
+const EFUSE_RF_TSSI_MCS_2G: usize = 6;
+const EFUSE_RF_TSSI_MCS_5G: usize = 0x12;
+const EFUSE_RF_THERMAL: usize = 0xd0;
+const EFUSE_RF_TSSI_6G: [usize; 2] = [0x100, 0x12a];
+/// Where the chip put its PCIe MAC address on autoload
+/// (`rtw8922a_read_efuse_pci_sdio`).
+const MAC_ADDR_PCIE_8922A: u32 = 0x3104;
+/// The physical map's security-control bytes before the first header.
+const SEC_CTRL_EFUSE_SIZE: usize = 4;
+/// `EFUSE_SEC_BE_START`, its size, `sb_sel_mgn`.
+const EFUSE_SEC_BE_START: u32 = 0x1580;
+const EFUSE_SEC_BE_SIZE: u32 = 4;
+const SB_SEL_MGN: [u32; 2] = [0x0800_0100, 0x0c00_0180];
+/// The RTL8922A's PHY capabilities in the eFuse (`phycap_addr`, `_size`).
+const PHYCAP_ADDR: u32 = 0x1700;
+const PHYCAP_SIZE: u32 = 0x38;
+
+/// `rtw89_cnv_efuse_state_be`.
+fn efuse_state(hal: &Hal, idle: bool) {
+    if idle {
+        hal.set32(R_BE_WL_BT_PWR_CTRL, B_BE_BT_DISN_EN);
+    } else {
+        hal.clr32(R_BE_WL_BT_PWR_CTRL, B_BE_BT_DISN_EN);
+        let _ = hal.poll32(R_BE_IC_PWR_STATE, |value| get(B_BE_WHOLE_SYS_PWR_STE_MASK, value) == MAC_AX_SYS_ACT, 50, 5000);
+    }
+}
+
+/// The firmware's register mailbox (`rtw89_fw_msg_reg`): a request in the
+/// four H2C registers once the last is taken, its answer from the four C2H
+/// ones; `counters` (H2C, C2H) start over with each download.
+fn msg_reg(hal: &Hal, counters: &mut (u8, u8), function: u32, mut request: [u32; 4], content_len: u32) -> Result<[u32; 4], String> {
+    hal.poll8(R_BE_H2CREG_CTRL, |value| value == 0, 1000, 5000).map_err(|_| String::from("the firmware does not take register requests"))?;
+    let words = (content_len + RTW89_H2CREG_HDR_LEN).div_ceil(4);
+    request[0] = (request[0] & !(RTW89_H2CREG_HDR_FUNC_MASK | RTW89_H2CREG_HDR_LEN_MASK)) | field(RTW89_H2CREG_HDR_FUNC_MASK, function) | field(RTW89_H2CREG_HDR_LEN_MASK, words);
+    for (reg, word) in [R_BE_H2CREG_DATA0, R_BE_H2CREG_DATA1, R_BE_H2CREG_DATA2, R_BE_H2CREG_DATA3].into_iter().zip(request) {
+        hal.w32(reg, word);
+    }
+    counters.0 = counters.0.wrapping_add(1);
+    hal.w8_mask(R_BE_UDM1 + 1, B_BE_UDM1_HALMAC_H2C_DEQ_CNT_MASK >> 8, counters.0 as u32);
+    hal.w8(R_BE_H2CREG_CTRL, B_AX_H2CREG_TRIGGER as u8);
+    hal.poll8(R_BE_C2HREG_CTRL, |value| value != 0, 1, RTW89_C2H_TIMEOUT as u64).map_err(|_| String::from("no register answer from the firmware"))?;
+    let answer = [R_BE_C2HREG_DATA0, R_BE_C2HREG_DATA1, R_BE_C2HREG_DATA2, R_BE_C2HREG_DATA3].map(|reg| hal.r32(reg));
+    hal.w8(R_BE_C2HREG_CTRL, 0);
+    counters.1 = counters.1.wrapping_add(1);
+    hal.w8_mask(R_BE_UDM1 + 1, B_BE_UDM1_HALMAC_C2H_ENQ_CNT_MASK >> 8, counters.1 as u32);
+    Ok(answer)
+}
+
+/// `rtw89_mac_read_phycap`: a part of the firmware's PHY capabilities (0:
+/// streams and protocol; 1: the constellations), the eFuse awake meanwhile.
+pub(crate) fn phycap(hal: &Hal, counters: &mut (u8, u8), part: u32) -> Option<[u32; 4]> {
+    efuse_state(hal, false);
+    let answer = msg_reg(hal, counters, RTW89_FWCMD_H2CREG_FUNC_GET_FEATURE, [field(RTW89_H2CREG_GET_FEATURE_PART_NUM, part), 0, 0, 0], 2);
+    efuse_state(hal, true);
+    let answer = answer.map_err(|error| ostd::warn!("rtw89: PHY capabilities: {}", error)).ok()?;
+    let expected = if part == 0 { RTW89_FWCMD_C2HREG_FUNC_PHY_CAP } else { RTW89_FWCMD_C2HREG_FUNC_PHY_CAP_PART1 };
+    (get(RTW89_C2HREG_HDR_FUNC_MASK, answer[0]) == expected).then_some(answer)
+}
+
+/// `rtw89_dump_physical_efuse_map_be` (the digital part): four bytes a
+/// read, the eFuse's power cut released around it (not on the RTL8922A's
+/// first cut).
+fn physical(hal: &Hal, addr: u32, size: u32) -> Result<Vec<u8>, String> {
+    efuse_state(hal, false);
+    let aphy_patch = !(hal.id() == ChipId::Rtl8922a && hal.cv == CHIP_CAV as u8);
+    hal.set8(R_BE_PMC_DBG_CTRL2, B_BE_SYSON_DIS_PMCR_BE_WRMSK);
+    if aphy_patch {
+        hal.set16(R_BE_SYS_ISO_CTRL, B_BE_PWC_EV2EF_S);
+        crate::delay_ms(1);
+        hal.set16(R_BE_SYS_ISO_CTRL, B_BE_PWC_EV2EF_B);
+        hal.clr16(R_BE_SYS_ISO_CTRL, B_BE_ISO_EB2CORE);
+    }
+    hal.set32(R_BE_EFUSE_CTRL_2_V1, B_BE_EF_BURST);
+    let mut out = Vec::with_capacity(size as usize);
+    let mut result = Ok(());
+    for at in (addr..addr + size).step_by(4) {
+        hal.w32(R_BE_EFUSE_CTRL, field(B_BE_EF_ADDR_MASK, at) & !B_BE_EF_RDY);
+        if hal.poll32(R_BE_EFUSE_CTRL, |value| value & B_BE_EF_RDY != 0, 1, 1_000_000).is_err() {
+            result = Err(format!("eFuse word {at:#x}"));
+            break;
+        }
+        out.extend_from_slice(&hal.r32(R_BE_EFUSE_CTRL_1_V1).to_le_bytes());
+    }
+    if aphy_patch {
+        hal.set16(R_BE_SYS_ISO_CTRL, B_BE_ISO_EB2CORE);
+        hal.clr16(R_BE_SYS_ISO_CTRL, B_BE_PWC_EV2EF_B);
+        crate::delay_ms(1);
+        hal.clr16(R_BE_SYS_ISO_CTRL, B_BE_PWC_EV2EF_S);
+    }
+    hal.clr8(R_BE_PMC_DBG_CTRL2, B_BE_SYSON_DIS_PMCR_BE_WRMSK);
+    hal.clr32(R_BE_EFUSE_CTRL_2_V1, B_BE_EF_BURST);
+    efuse_state(hal, true);
+    result.map(|()| out)
+}
+
+/// `rtw89_eeprom_parser_be`: a logical block (its page, from its start)
+/// out of the physical map's blocks, each a three-byte header (page,
+/// block index, which of its four words follow) and its words.
+fn logical_block(physical: &[u8], page: u32, size: usize) -> Vec<u8> {
+    let mut log = vec![0xffu8; size];
+    let max = (size + 1) & !1;
+    let mut at = SEC_CTRL_EFUSE_SIZE;
+    while at + 3 <= physical.len() {
+        let (h1, h2, h3) = (physical[at], physical[at + 1], physical[at + 2]);
+        if h1 == 0xff || h2 == 0xff || h3 == 0xff {
+            break;
+        }
+        at += 3;
+        let header = ((h1 as u32) << 16) | ((h2 as u32) << 8) | h3 as u32;
+        let block_page = get(EFUSE_HDR_PAGE_MASK, header);
+        let block = get(EFUSE_HDR_OFFSET_MASK, header) as usize;
+        let word_en = get(EFUSE_HDR_WORD_EN_MASK, header);
+        if block >= RTW89_EFUSE_MAX_BLOCK_SIZE as usize >> 3 {
+            break;
+        }
+        for word in 0..4 {
+            if word_en & (1 << word) != 0 {
+                continue;
+            }
+            if at + 1 >= physical.len() {
+                return log;
+            }
+            let index = (block << 3) + (word << 1);
+            if block_page == page && index < max {
+                log[index] = physical[at];
+                if index + 1 < size {
+                    log[index + 1] = physical[at + 1];
+                }
+            }
+            at += 2;
+        }
+    }
+    log
+}
+
+/// `get_sb_cryp_sel_idx`: the secure-boot selection's index, if its two
+/// bytes are well formed.
+fn sb_cryp_sel_index(sel: u16) -> Option<usize> {
+    let (form, index) = (sel as u8, (sel >> 8) as u8);
+    let (mut value, mut zeros) = (0usize, 0);
+    for bit in 0..4 {
+        let low = form & (1 << bit) != 0;
+        if low != (form & (1 << (7 - bit)) != 0) {
+            return None;
+        }
+        if low {
+            continue;
+        }
+        zeros += 1;
+        if zeros > 1 {
+            return None;
+        }
+        value = bit * 16;
+    }
+    let (low, high) = (index & 0x0f, index >> 4);
+    if low ^ high != 0x0f {
+        return None;
+    }
+    Some(value + low as usize)
+}
+
+/// `rtw89_parse_efuse_map_be` and `rtw8922a_read_efuse`, with
+/// `rtw89_efuse_read_fw_secure_be`.
+pub(crate) fn read_efuse(hal: &mut Hal) -> Result<(Efuse, Secure), String> {
+    hal.efuse_valid = hal.r16(R_BE_SYS_WL_EFUSE_CTRL) as u32 & B_BE_AUTOLOAD_SUS != 0;
+    let phy = physical(hal, 0, hal.chip.physical_efuse)?;
+    let mut efuse = Efuse::default();
+    for at in (0..6).step_by(2) {
+        let value = hal.r16(MAC_ADDR_PCIE_8922A + at as u32);
+        efuse.address[at] = value as u8;
+        efuse.address[at + 1] = (value >> 8) as u8;
+    }
+    let rf = logical_block(&phy, EFUSE_RF_PAGE, EFUSE_RF_SIZE);
+    efuse.rfe_type = rf[EFUSE_RF_RFE_TYPE];
+    efuse.xtal_cap = rf[EFUSE_RF_XTAL_K];
+    efuse.country = [rf[EFUSE_RF_COUNTRY], rf[EFUSE_RF_COUNTRY + 1]];
+    hal.rfe_type = efuse.rfe_type;
+    hal.xtal_cap = efuse.xtal_cap;
+    // `rtw8922a_efuse_parsing_tssi`.
+    let mut tssi = Tssi::default();
+    for path in 0..2 {
+        let (base, base_6g) = (EFUSE_RF_TSSI[path], EFUSE_RF_TSSI_6G[path]);
+        tssi.thermal[path] = rf[EFUSE_RF_THERMAL + path];
+        for (group, value) in tssi.cck[path].iter_mut().enumerate() {
+            *value = rf[base + group] as i8;
+        }
+        for (group, value) in tssi.mcs[path].iter_mut().enumerate() {
+            let at = if group < TSSI_MCS_2G_GROUPS { base + EFUSE_RF_TSSI_MCS_2G + group } else { base + EFUSE_RF_TSSI_MCS_5G + group - TSSI_MCS_2G_GROUPS };
+            *value = rf[at] as i8;
+        }
+        for (group, value) in tssi.mcs_6g[path].iter_mut().enumerate() {
+            *value = rf[base_6g + group] as i8;
+        }
+    }
+    efuse.tssi = Some(tssi);
+    // `rtw8922a_read_phycap`: the bias trims (programmed when 0x1700 is).
+    if let Ok(cap) = physical(hal, PHYCAP_ADDR, PHYCAP_SIZE) {
+        let at = |addr: u32| cap[(addr - PHYCAP_ADDR) as usize];
+        if at(PHYCAP_ADDR) != 0xff {
+            efuse.bias = Some([[at(0x1707), at(0x1734)], [at(0x1708), at(0x1735)]]);
+        }
+    }
+    let mut secure = Secure::default();
+    let sec = physical(hal, EFUSE_SEC_BE_START, EFUSE_SEC_BE_SIZE)?;
+    let sel = u16::from_le_bytes([sec[2], sec[3]]);
+    if sel != 0xffff
+        && let Some(index) = sb_cryp_sel_index(sel).filter(|&index| index < SB_SEL_MGN.len())
+        && secure_v1(hal.id(), sec[0], sec[1], &mut secure)
+    {
+        secure.sb_sel_mgn = SB_SEL_MGN[index];
+        secure.secure_boot = true;
+    }
+    hal.secure_boot = secure.secure_boot;
+    hal.mss_idx = secure.mss_idx;
+    Ok((efuse, secure))
+}
