+/// `__rtw8852bx_btc_init_cfg`: the PTA in Realtek's mode, inside; the
+/// WLAN's responses and beacons first; the shared antenna's masks.
+pub(crate) fn btc_init(hal: &Hal) {
+    crate::coex::init(hal);
+    hal.set32(R_BTC_BT_COEX_MSK_TABLE, B_BTC_PRI_MASK_TX_RESP_V1);
+    hal.set32(R_AX_WL_PRI_MSK, B_AX_PTA_WL_PRI_MASK_BCNQ);
+    hal.write_rf(0, RR_WLSEL, RFREG_MASK, 0);
+    hal.write_rf(1, RR_WLSEL, RFREG_MASK, 0);
+    set_trx_mask(hal, 0, BTC_BT_SS_GROUP, 0x5ff);
+    set_trx_mask(hal, 1, BTC_BT_SS_GROUP, 0x5ff);
+    set_trx_mask(hal, 0, BTC_BT_TX_GROUP, 0x5ff);
+    set_trx_mask(hal, 1, BTC_BT_TX_GROUP, 0x55f);
+    if hal.id() == ChipId::Rtl8852bt {
+        set_trx_mask(hal, 0, BTC_BT_RX_GROUP, 0x5df);
+        set_trx_mask(hal, 1, BTC_BT_RX_GROUP, 0x5df);
+    }
+    hal.w32(R_BTC_BREAK_TABLE, BTC_BREAK_PARAM);
+    hal.set32(R_AX_CSR_MODE, B_AX_BT_CNT_RST | B_AX_STATIS_BT_EN);
+    crate::coex::wlan_owns(hal);
+}
