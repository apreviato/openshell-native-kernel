+// ---- TSSI. ----
+
+/// `_tssi_get_trim_group`: eight groups, none between two.
+fn trim_group(ch: u8) -> usize {
+    match ch {
+        9..=14 => 1,
+        36..=48 => 2,
+        52..=64 => 3,
+        100..=112 => 4,
+        116..=128 => 5,
+        132..=144 => 6,
+        149..=177 => 7,
+        _ => 0,
+    }
+}
+
+/// `rtw8851b_tssi` and `rtw8851b_tssi_scan` (`scan`: the band's parts
+/// again): path A's closed loop set up and turned on with the eFuse's
+/// offsets; the alignment the tables give.
+fn tssi(hal: &Hal, state: &mut State, efuse: &Tssi, track: Option<&TxPowerTrack>, chan: &Chan, scan: bool) {
+    let two_g = chan.band == phy::BAND_2G;
+    // `_tssi_disable`.
+    hal.phy_w32_mask(R_P0_TSSI_AVG, B_P0_TSSI_EN, 0);
+    hal.phy_w32_mask(R_P0_TSSI_TRK, B_P0_TSSI_OFT_EN, 0);
+    hal.phy_w32_mask(R_P0_TSSI_TRK, B_P0_TSSI_OFT_EN, 1);
+    hal.phy_w32_mask(R_P0_TSSI_TRK, B_P0_TSSI_OFT_EN, 0);
+    hal.phy_w32_mask(R_P0_TSSI_MV_AVG, B_P0_TSSI_MV_CLR, 1);
+    state.tssi_mode = false;
+    rfk(hal, RTW8851B_TSSI_SYS_DEFS);
+    rfk(hal, if two_g { RTW8851B_TSSI_SYS_A_DEFS_2G } else { RTW8851B_TSSI_SYS_A_DEFS_5G });
+    if !scan {
+        rfk(hal, RTW8851B_TSSI_INIT_TXPWR_DEFS_A);
+        rfk(hal, RTW8851B_TSSI_INIT_TXPWR_HE_TB_DEFS_A);
+        rfk(hal, RTW8851B_TSSI_DCK_DEFS_A);
+    }
+    rtw8852b_rfk::tssi_set_tmeter_tbl(hal, 0, chan, efuse, track);
+    if !scan {
+        rfk(hal, RTW8851B_TSSI_DAC_GAIN_DEFS_A);
+    }
+    rfk(hal, if two_g { RTW8851B_TSSI_SLOPE_A_DEFS_2G } else { RTW8851B_TSSI_SLOPE_A_DEFS_5G });
+    rfk(hal, if two_g { RTW8851B_TSSI_ALIGN_A_2G_DEFS } else { RTW8851B_TSSI_ALIGN_A_5G_DEFS });
+    if !scan {
+        rfk(hal, RTW8851B_TSSI_SLOPE_DEFS_A);
+    }
+    // `_tssi_enable`.
+    rfk(hal, RTW8851B_TSSI_TRACK_DEFS_A);
+    rfk(hal, RTW8851B_TSSI_MV_AVG_DEFS_A);
+    hal.phy_w32_mask(R_P0_TSSI_MV_AVG, B_P0_TSSI_MV_CLR, 0);
+    hal.phy_w32_mask(R_P0_TSSI_AVG, B_P0_TSSI_EN, 0);
+    hal.phy_w32_mask(R_P0_TSSI_AVG, B_P0_TSSI_EN, 1);
+    hal.write_rf(0, RR_TXGA_V1, RR_TXGA_V1_TRK_EN, 1);
+    hal.phy_w32_mask(R_P0_TSSI_TRK, B_P0_TSSI_OFT_EN, 0);
+    hal.phy_w32_mask(R_P0_TSSI_TRK, B_P0_TSSI_RFC, 0x3);
+    hal.phy_w32_mask(R_P0_TSSI_TRK, B_P0_TSSI_OFT, 0xc0);
+    hal.phy_w32_mask(R_P0_TSSI_TRK, B_P0_TSSI_OFT_EN, 0);
+    hal.phy_w32_mask(R_P0_TSSI_TRK, B_P0_TSSI_OFT_EN, 1);
+    state.tssi_mode = true;
+    // `_tssi_set_efuse_to_de`.
+    let trim = efuse.trim[0][trim_group(chan.channel)] as i32;
+    let cck = (efuse.cck[0][phy::cck_group(chan.channel)] as i32 + trim) as u32;
+    for reg in rtw8852b_rfk::TSSI_DE_CCK[0] {
+        hal.phy_w32_mask(reg, rtw8852b_rfk::TSSI_DE_MASK, cck);
+    }
+    let ofdm = (phy::group_value(&efuse.mcs[0], phy::ofdm_group(chan.channel)) as i32 + trim) as u32;
+    for reg in rtw8852b_rfk::TSSI_DE_MCS[0] {
+        hal.phy_w32_mask(reg, rtw8852b_rfk::TSSI_DE_MASK, ofdm);
+    }
+}
+
+// ---- AACK, LCK. ----
+
+/// `rtw8851b_aack`: the VCO's amplitude, again (up to four times) until
+/// every band's current is set.
+fn aack(hal: &Hal) {
+    let reg5 = hal.read_rf(0, RR_RSV1, RFREG_MASK);
+    let regd3 = hal.read_rf(0, RR_LCK_TRG, RFREG_MASK);
+    hal.write_rf(0, RR_MOD, RR_MOD_MASK, 0x3);
+    hal.write_rf(0, RR_RSV1, RFREG_MASK, 0);
+    hal.write_rf(0, RR_LCK_TRG, RR_LCK_ST, 0);
+    for _ in 0..4 {
+        hal.write_rf(0, RR_AACK, RFREG_MASK, 0x8201e);
+        hal.write_rf(0, RR_AACK, RFREG_MASK, 0x8201f);
+        crate::delay_us(100);
+        poll(|| hal.read_rf(0, 0xd0, 1 << 16) != 0, 1, 1000);
+        hal.write_rf(0, RR_VCI, RR_VCI_ON, 1);
+        let mut ib = [0u32; 4];
+        for (i, value) in ib.iter_mut().enumerate() {
+            hal.write_rf(0, RR_VCO, RR_VCO_SEL, i as u32);
+            *value = hal.read_rf(0, RR_IBD, RR_IBD_VAL);
+        }
+        hal.write_rf(0, RR_VCI, RR_VCI_ON, 0);
+        if ib.iter().all(|&value| value != 0) {
+            break;
+        }
+    }
+    hal.write_rf(0, RR_RSV1, RFREG_MASK, reg5);
+    hal.write_rf(0, RR_LCK_TRG, RFREG_MASK, regd3);
+}
+
+/// `_set_s0_arfc18`: RF register 0x18 with the LDO selected, whether the
+/// synthesizer stayed busy.
+fn set_s0_arfc18(hal: &Hal, value: u32) -> bool {
+    let ldo = hal.read_rf(0, RR_LDO, RFREG_MASK);
+    hal.write_rf(0, RR_LDO, RR_LDO_SEL, 1);
+    hal.write_rf(0, RR_CFGCH, RFREG_MASK, value);
+    let idle = poll(|| hal.read_rf(0, RR_LPF, RR_LPF_BUSY) == 0, 1, 1000);
+    hal.write_rf(0, RR_LDO, RFREG_MASK, ldo);
+    !idle
+}
+
+/// `_lck_check`: the synthesizer locked, else its divider reset, the
+/// channel again, it off and on.
+fn lck_check(hal: &Hal) {
+    let locked = || hal.read_rf(0, RR_SYNFB, RR_SYNFB_LK) != 0;
+    if !locked() {
+        hal.write_rf(0, RR_MMD, RR_MMD_RST_EN, 1);
+        hal.write_rf(0, RR_MMD, RR_MMD_RST_SYN, 0);
+        hal.write_rf(0, RR_MMD, RR_MMD_RST_SYN, 1);
+        hal.write_rf(0, RR_MMD, RR_MMD_RST_EN, 0);
+    }
+    crate::delay_us(10);
+    let channel_again = || {
+        hal.write_rf(0, RR_LCK_TRG, RR_LCK_TRGSEL, 1);
+        let value = hal.read_rf(0, RR_CFGCH, RFREG_MASK);
+        set_s0_arfc18(hal, value);
+        hal.write_rf(0, RR_LCK_TRG, RR_LCK_TRGSEL, 0);
+    };
+    if !locked() {
+        channel_again();
+    }
+    if !locked() {
+        let value = hal.read_rf(0, RR_POW, RFREG_MASK);
+        hal.write_rf(0, RR_POW, RFREG_MASK, value);
+        let value = hal.read_rf(0, RR_SX, RFREG_MASK);
+        hal.write_rf(0, RR_SX, RFREG_MASK, value);
+        hal.write_rf(0, RR_SYNLUT, RR_SYNLUT_MOD, 1);
+        hal.write_rf(0, RR_POW, RR_POW_SYN, 0);
+        hal.write_rf(0, RR_POW, RR_POW_SYN, 0x3);
+        hal.write_rf(0, RR_SYNLUT, RR_SYNLUT_MOD, 0);
+        channel_again();
+    }
+}
+
+/// `_set_ch` of the RTL8851B: RF register 0x18, the lock checked.
+pub(crate) fn set_ch(hal: &Hal, value: u32) {
+    if !set_s0_arfc18(hal, value) {
+        lck_check(hal);
+    }
+}
+
+/// `rtw8851b_lck`.
+fn lck(hal: &Hal, state: &mut State) {
+    let reg5 = hal.read_rf(0, RR_RSV1, RFREG_MASK);
+    let rf18 = hal.read_rf(0, RR_CFGCH, RFREG_MASK);
+    let regd3 = hal.read_rf(0, RR_LCK_TRG, RFREG_MASK);
+    hal.write_rf(0, RR_MOD, RR_MOD_MASK, 0x3);
+    hal.write_rf(0, RR_RSV1, RFREG_MASK, 0);
+    hal.write_rf(0, RR_LCK_TRG, RR_LCK_TRGSEL, 1);
+    set_ch(hal, rf18);
+    hal.write_rf(0, RR_LCK_TRG, RFREG_MASK, regd3);
+    hal.write_rf(0, RR_RSV1, RFREG_MASK, reg5);
+    state.lck_thermal = state.thermal.read(0);
+}
+
+/// `RTW8851B_LCK_TH`.
+const LCK_TH: i32 = 8;
+
+// ---- The state, the entry points. ----
+
+/// What the RTL8851B's calibrations keep.
+#[derive(Default)]
+pub(crate) struct State {
+    pub(crate) tssi_mode: bool,
+    thermal: Thermal,
+    dpk: Dpk,
+    lck_thermal: u32,
+}
+
+/// `rtw8851b_rfk_init`'s hardware: `rtw8851b_dpk_init` (the CFIR by
+/// rate), the VCO's amplitude, the RC, the DAC, the RX DC offset.
+pub(crate) fn power_on(hal: &Hal) {
+    hal.w32_mask(R_AX_PWR_SWING_OTHER_CTRL0, B_AX_CFIR_BY_RATE_OFF_MASK, 0x21861);
+    aack(hal);
+    crate::rtw88xx::rck(hal, 0);
+    dac_cal(hal);
+    rx_dck(hal, false);
+}
+
+/// `rtw8851b_rfk_init`'s state: the TSSI off, `rtw8851b_lck_init`.
+pub(crate) fn init(state: &mut State) {
+    state.tssi_mode = false;
+    state.lck_thermal = state.thermal.read(0);
+}
+
+/// `rtw8851b_rfk_channel` after the RX DC offset: IQK, TSSI, DPK.
+pub(crate) fn channel(hal: &Hal, state: &mut State, tssi_efuse: Option<&Tssi>, track: Option<&TxPowerTrack>, chan: &Chan) {
+    iqk(hal, chan);
+    if let Some(efuse) = tssi_efuse {
+        tssi(hal, state, efuse, track, chan, false);
+    }
+    dpk(hal, state, chan);
+}
+
+/// `rtw8851b_tssi_scan` on a band change.
+pub(crate) fn tssi_scan(hal: &Hal, state: &mut State, tssi_efuse: &Tssi, track: Option<&TxPowerTrack>, chan: &Chan) {
+    tssi(hal, state, tssi_efuse, track, chan, true);
+}
+
+/// `rtw89_phy_stat_thermal_update` and `rtw8851b_rfk_track`: the DPD with
+/// the temperature, the VCO and the LO again when it moved.
+pub(crate) fn track(hal: &Hal, state: &mut State) {
+    let value = rtw8852b_rfk::thermal(hal, &[state.tssi_mode, false], 0);
+    state.thermal.add(0, value);
+    dpk_track(hal, state);
+    if (state.thermal.read(0) as i32 - state.lck_thermal as i32).abs() >= LCK_TH {
+        aack(hal);
+        lck(hal, state);
+    }
+}
diff --git a/kernel/comps/rtw89/src/rtw8852a_rfk.rs b/kernel/comps/rtw89/src/rtw8852a_rfk.rs
new file mode 100644
index 0000000..f7c9ddf
--- /dev/null
+++ b/kernel/comps/rtw89/src/rtw8852a_rfk.rs
@@ -0,0 +1,1137 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The RTL8852A's calibrations on the host, as Linux's `rtw8852a_rfk.c`
+//! runs them: the ADC's and the DAC's offsets (DACK, at power on), the RX
+//! DC offset (by the AFE), the IQ imbalance (IQK: the LO leakage with its
+//! bias retried, TX by four gain groups, RX by groups on 5 GHz and narrow
+//! band on 2.4 GHz), the digital predistortion (DPK, its thermal tracking)
+//! and the TX power's closed loop (TSSI, its PA tables by band and its
+//! tracking of the TX power's average). One channel context, both paths,
+//! no DBCC.
+
+use crate::{
+    chan::Chan,
+    fw::TxPowerTrack,
+    hal::{Hal, MASKBYTE0, MASKBYTE2, MASKBYTE3, MASKDWORD, MASKHWORD, MASKLWORD, RFREG_MASK, get},
+    mac::Tssi,
+    phy::{self, rfk, rfk_by},
+    regs::*,
+    rfk_tables::*,
+    rtw8852b_rfk::{self, CFIR_WIDE, NCTL_DONE, Thermal, sign_extend12, wait_rx_mode},
+};
+
+/// `rtw8852a_backup_bb_regs`, `_rf_regs`.
+const BACKUP_BB_REGS: [u32; 3] = [0x2344, 0x58f0, 0x78f0];
+const BACKUP_RF_REGS: [u32; 8] = [0xef, 0xde, 0x0, 0x1e, 0x2, 0x85, 0x90, 0x5];
+
+fn poll(done: impl Fn() -> bool, step_us: u64, timeout_us: u64) -> bool {
+    aster_linuxkpi::delay::read_poll_timeout(&done, |ok| *ok, step_us, timeout_us).is_ok()
+}
+
+// ---- DACK. ----
+
+/// `_dack_s0`, `_dack_s1`: a path's DAC (MSB, then DADC), what it found
+/// kept (`_dack_backup_s0`/`_s1`: the DC 8 below the reading) and
+/// reloaded (`_dack_reload`).
+fn dack_path(hal: &Hal, path: u8) {
+    let a = path == 0;
+    let base = if a { 0x5e00 } else { 0x7e00 };
+    rfk(hal, if a { RTW8852A_RFK_DACK_DEFS_F_A } else { RTW8852A_RFK_DACK_DEFS_F_B });
+    poll(|| hal.phy_r32_mask(base + 0x28, 1 << 15) != 0, 1, 10_000);
+    poll(|| hal.phy_r32_mask(base + 0x78, 1 << 15) != 0, 1, 10_000);
+    rfk(hal, if a { RTW8852A_RFK_DACK_DEFS_M_A } else { RTW8852A_RFK_DACK_DEFS_M_B });
+    poll(|| hal.phy_r32_mask(base + 0x48, 1 << 17) != 0, 1, 10_000);
+    poll(|| hal.phy_r32_mask(base + 0x98, 1 << 17) != 0, 1, 10_000);
+    rfk(hal, if a { RTW8852A_RFK_DACK_DEFS_R_A } else { RTW8852A_RFK_DACK_DEFS_R_B });
+    // `_check_dadc` (its readings are Linux's debug).
+    rfk(hal, if a { RTW8852A_RFK_CHECK_DADC_DEFS_F_A } else { RTW8852A_RFK_CHECK_DADC_DEFS_F_B });
+    rfk(hal, if a { RTW8852A_RFK_CHECK_ADDC_DEFS_A } else { RTW8852A_RFK_CHECK_ADDC_DEFS_B });
+    rfk(hal, if a { RTW8852A_RFK_CHECK_DADC_DEFS_R_A } else { RTW8852A_RFK_CHECK_DADC_DEFS_R_B });
+    let (daci, dacq, dbg, dbg_bit) = if a { (R_S0_DACKI, R_S0_DACKQ, R_P0_NRBW, B_P0_NRBW_DBG) } else { (R_S1_DACKI, R_S1_DACKQ, R_P1_DBGMOD, B_P1_DBGMOD_ON) };
+    hal.phy_set(daci, if a { B_S0_DACKI_EN } else { B_S1_DACKI_EN });
+    hal.phy_set(dacq, if a { B_S0_DACKQ_EN } else { B_S1_DACKQ_EN });
+    hal.phy_set(dbg, dbg_bit);
+    let mut msbk = [[0u32; 16]; 2];
+    for i in 0..16u32 {
+        if a {
+            hal.phy_w32_mask(R_S0_DACKI, B_S0_DACKI_AR, i);
+            msbk[0][i as usize] = hal.phy_r32_mask(R_S0_DACKI7, B_S0_DACKI7_K) & 0xff;
+            hal.phy_w32_mask(R_S0_DACKQ, B_S0_DACKQ_AR, i);
+            msbk[1][i as usize] = hal.phy_r32_mask(R_S0_DACKQ7, B_S0_DACKQ7_K) & 0xff;
+        } else {
+            hal.phy_w32_mask(R_S1_DACKI, B_S1_DACKI_AR, i);
+            msbk[0][i as usize] = hal.phy_r32_mask(R_S1_DACKI7, B_S1_DACKI_K) & 0xff;
+            hal.phy_w32_mask(R_S1_DACKQ, B_S1_DACKQ_AR, i);
+            msbk[1][i as usize] = hal.phy_r32_mask(R_S1_DACKQ7, B_S1_DACKQ7_K) & 0xff;
+        }
+    }
+    let (biask, dadck) = if a {
+        (
+            [hal.phy_r32_mask(R_S0_DACKI2, B_S0_DACKI2_K) & 0xffff, hal.phy_r32_mask(R_S0_DACKQ2, B_S0_DACKQ2_K) & 0xffff],
+            [(hal.phy_r32_mask(R_S0_DACKI8, B_S0_DACKI8_K) as u8).wrapping_sub(8) as u32, (hal.phy_r32_mask(R_S0_DACKQ8, B_S0_DACKQ8_K) as u8).wrapping_sub(8) as u32],
+        )
+    } else {
+        (
+            [hal.phy_r32_mask(R_S1_DACKI2, B_S1_DACKI2_K) & 0xffff, hal.phy_r32_mask(R_S1_DACKQ2, B_S1_DACKQ2_K) & 0xffff],
+            [(hal.phy_r32_mask(R_S1_DACKI8, B_S1_DACKI8_K) as u8).wrapping_sub(8) as u32, (hal.phy_r32_mask(R_S1_DACKQ8, B_S1_DACKQ8_K) as u8).wrapping_sub(8) as u32],
+        )
+    };
+    for index in 0..2usize {
+        let offset = if index == 0 { 0 } else { 0x50 } + if a { 0 } else { 0x2000 };
+        for (word, first) in [12usize, 8, 4, 0].into_iter().enumerate() {
+            let value = (0..4).fold(0u32, |value, i| value | (msbk[index][first + i] << (i * 8)));
+            hal.phy_w32(0x5e14 + offset + 4 * word as u32, value);
+        }
+        hal.phy_w32(0x5e24 + offset, (biask[index] << 22) | (dadck[index] << 14));
+    }
+    rfk_by(hal, a, RTW8852A_RFK_DACK_RELOAD_DEFS_A, RTW8852A_RFK_DACK_RELOAD_DEFS_B);
+    hal.phy_clr(dbg, dbg_bit);
+}
+
+/// `rtw8852a_dack` (`_dac_cal`): the AFE, both ADCs' offsets (`_addck`,
+/// kept and reloaded), both DACs; RF register 0 kept around it.
+pub(crate) fn dac_cal(hal: &Hal) {
+    let rf0 = [hal.read_rf(0, RR_MOD, RFREG_MASK), hal.read_rf(1, RR_MOD, RFREG_MASK)];
+    rfk(hal, RTW8852A_RFK_AFE_INIT_DEFS);
+    for path in 0..2u8 {
+        hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 0);
+    }
+    for path in 0..2u8 {
+        hal.write_rf(path, RR_MOD, RFREG_MASK, 0x30001);
+    }
+    for (path, done) in [(0u8, 0x1e00), (1, 0x3e00)] {
+        let a = path == 0;
+        rfk(hal, if a { RTW8852A_RFK_ADDCK_RESET_DEFS_A } else { RTW8852A_RFK_ADDCK_RESET_DEFS_B });
+        rfk(hal, if a { RTW8852A_RFK_CHECK_ADDC_DEFS_A } else { RTW8852A_RFK_CHECK_ADDC_DEFS_B });
+        rfk(hal, if a { RTW8852A_RFK_ADDCK_TRIGGER_DEFS_A } else { RTW8852A_RFK_ADDCK_TRIGGER_DEFS_B });
+        poll(|| hal.phy_r32_mask(done, 1 << 0) != 0, 1, 10_000);
+        rfk(hal, if a { RTW8852A_RFK_CHECK_ADDC_DEFS_A } else { RTW8852A_RFK_CHECK_ADDC_DEFS_B });
+        rfk(hal, if a { RTW8852A_RFK_ADDCK_RESTORE_DEFS_A } else { RTW8852A_RFK_ADDCK_RESTORE_DEFS_B });
+    }
+    // `_addck_backup`, `_addck_reload`.
+    hal.phy_clr(R_S0_RXDC2, B_S0_RXDC2_SEL);
+    let a = [hal.phy_r32_mask(R_S0_ADDCK, B_S0_ADDCK_Q) & 0xffff, hal.phy_r32_mask(R_S0_ADDCK, B_S0_ADDCK_I) & 0xffff];
+    hal.phy_clr(R_S1_RXDC2, B_S1_RXDC2_SEL);
+    let b = [hal.phy_r32_mask(R_S1_ADDCK, B_S1_ADDCK_Q) & 0xffff, hal.phy_r32_mask(R_S1_ADDCK, B_S1_ADDCK_I) & 0xffff];
+    hal.phy_w32_mask(R_S0_RXDC, B_S0_RXDC_I, a[0]);
+    hal.phy_w32_mask(R_S0_RXDC2, B_S0_RXDC2_Q2, a[1] >> 6);
+    hal.phy_w32_mask(R_S0_RXDC, B_S0_RXDC_Q, a[1] & 0x3f);
+    hal.phy_set(R_S0_RXDC2, B_S0_RXDC2_MEN);
+    hal.phy_w32_mask(R_S1_RXDC, B_S1_RXDC_I, b[0]);
+    hal.phy_w32_mask(R_S1_RXDC2, B_S1_RXDC2_Q2, b[1] >> 6);
+    hal.phy_w32_mask(R_S1_RXDC, B_S1_RXDC_Q, b[1] & 0x3f);
+    hal.phy_set(R_S1_RXDC2, B_S1_RXDC2_EN);
+    for path in 0..2u8 {
+        hal.write_rf(path, RR_MOD, RFREG_MASK, 0x40001);
+    }
+    for path in 0..2u8 {
+        hal.write_rf(path, RR_MODOPT, RFREG_MASK, 0);
+    }
+    dack_path(hal, 0);
+    dack_path(hal, 1);
+    for path in 0..2u8 {
+        hal.write_rf(path, RR_MOD, RFREG_MASK, rf0[path as usize]);
+    }
+    for path in 0..2u8 {
+        hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 1);
+    }
+}
+
+// ---- IQK. ----
+
+/// `enum rtw8852a_iqk_type`: the one-shots the host starts.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Iqk {
+    FlokCoarse,
+    FlokFine,
+    Txk,
+    Rxk,
+    Nbrxk,
+}
+
+/// `_iqk_check_cal`: the NCTL done (or 8.2 ms gone); Linux takes none as
+/// failed.
+fn iqk_check_cal(hal: &Hal) {
+    poll(|| hal.phy_r32_mask(R_RFK_ST, MASKBYTE0) == NCTL_DONE, 1, 8200);
+    hal.phy_clr(R_NCTL_N1, MASKBYTE0);
+}
+
+/// `_iqk_one_shot`: the RF by the KIP for the kind (bit 29 of 0x5864,
+/// 0x7864), the tone, the NCTL's command.
+fn iqk_one_shot(hal: &Hal, path: u8, kind: Iqk, bw: u8) {
+    let rfc_ctl = if path == 0 { 0x5864 } else { 0x7864 };
+    const BY_KIP: u32 = 0x2000_0000;
+    let (p, bw) = (path as u32, bw as u32);
+    let cmd = match kind {
+        Iqk::FlokCoarse | Iqk::FlokFine => {
+            hal.phy_set(rfc_ctl, BY_KIP);
+            hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_TXT, 0x009);
+            (if kind == Iqk::FlokCoarse { 0x108 } else { 0x208 }) | (1 << (4 + p))
+        }
+        Iqk::Txk => {
+            hal.phy_clr(rfc_ctl, BY_KIP);
+            hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_TXT, 0x025);
+            0x008 | (1 << (p + 4)) | (((0x8 + bw) & 0xf) << 8)
+        }
+        Iqk::Rxk | Iqk::Nbrxk => {
+            hal.phy_set(rfc_ctl, BY_KIP);
+            hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_RXT, 0x011);
+            if kind == Iqk::Rxk { 0x008 | (1 << (p + 4)) | (((0xb + bw) & 0xf) << 8) } else { 0x608 | (1 << (4 + p)) }
+        }
+    };
+    hal.phy_w32_mask(R_NCTL_CFG, MASKDWORD, cmd + 1);
+    hal.phy_set(R_DPK_CTL, B_DPK_CTL_EN);
+    crate::delay_us(1);
+    iqk_check_cal(hal);
+    hal.phy_clr(rfc_ctl, BY_KIP);
+}
+
+/// What a path's IQK keeps.
+#[derive(Clone, Copy, Default)]
+struct IqkPath {
+    band: u8,
+    bw: u8,
+    nb_txcfir: u32,
+    nb_rxcfir: u32,
+}
+
+#[derive(Default)]
+struct IqkInfo {
+    path: [IqkPath; 2],
+    times: u32,
+    fail_count: u32,
+    /// `syn1to2`: the synthesizer's mode from 0x35c.
+    syn1to2: u32,
+}
+
+/// `_iqk_rxk_setting`.
+fn iqk_rxk_setting(hal: &Hal, path: u8, band: u8) {
+    hal.phy_set(R_P0_NRBW + ((path as u32) << 13), B_P0_NRBW_DBG);
+    hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15, 0x3);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_15, 0xa041);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15_H2, 0x3);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_FLTRST, 0);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_FLTRST, 1);
+    hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15_H2, 0);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RXK, 0x0303);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RXK, 0x0000);
+    hal.write_rf(path, RR_MOD, RR_MOD_MASK, RR_MOD_V_RXK2);
+    if band == phy::BAND_2G {
+        hal.write_rf(path, RR_RXK, RR_RXK_SEL2G, 1);
+    } else {
+        hal.write_rf(path, RR_WLSEL, RR_WLSEL_AG, 0x5);
+        hal.write_rf(path, RR_RXK, RR_RXK_SEL5G, 1);
+    }
+    let rf18 = hal.read_rf(path, RR_CFGCH, RFREG_MASK);
+    hal.write_rf(path, RR_RSV4, RFREG_MASK, rf18);
+    hal.write_rf(path, RR_RXKPLL, RR_RXKPLL_OFF, 0x13);
+    hal.write_rf(path, RR_RXKPLL, RR_RXKPLL_POW, 0);
+    hal.write_rf(path, RR_RXKPLL, RR_RXKPLL_POW, 1);
+    crate::delay_us(128);
+}
+
+/// The RX gains of a group (`rxgn_*`, `attc2_*`, `attc1_*`).
+fn rx_gain(hal: &Hal, path: u8, band: u8, gain: u32, attc2: u32, attc1: u32) {
+    hal.write_rf(path, RR_MOD, RR_MOD_M_RXG, gain);
+    if band == phy::BAND_2G {
+        hal.write_rf(path, RR_RXBB, RR_RXBB_C2G, attc2);
+        hal.write_rf(path, RR_RXBB, RR_RXBB_C1G, attc1);
+    } else {
+        hal.write_rf(path, RR_RXA2, RR_RXA2_C2, attc2);
+        hal.write_rf(path, RR_RXA2, RR_RXA2_C1, attc1);
+    }
+}
+
+/// The RX one-shot's settings around a group (`_rxk_group_sel`'s and
+/// `_iqk_nbrxk`'s), the KIP on the group's CFIR.
+fn rxk_one(hal: &Hal, info: &IqkInfo, path: u8, group: u32, kind: Iqk) {
+    let p = (path as u32) << 8;
+    hal.phy_set(R_IQK_CFG, B_IQK_CFG_SET);
+    let rf0 = hal.read_rf(path, RR_MOD, RFREG_MASK);
+    hal.phy_w32_mask(R_IQK_DIF2, B_IQK_DIF2_RXPI, rf0 | info.syn1to2);
+    hal.phy_w32_mask(R_IQK_COM, MASKDWORD, 0x4001_0100);
+    hal.phy_clr(R_IQK_RES + p, B_IQK_RES_RXCFIR);
+    hal.phy_set(R_CFIR_LUT + p, B_CFIR_LUT_SEL);
+    hal.phy_clr(R_CFIR_LUT + p, B_CFIR_LUT_G3);
+    hal.phy_w32_mask(R_CFIR_LUT + p, B_CFIR_LUT_GP, group);
+    hal.phy_w32_mask(R_IOQ_IQK_DPK, B_IOQ_IQK_DPK_EN, 1);
+    hal.phy_clr(R_NCTL_N1, B_NCTL_N1_CIP);
+    iqk_one_shot(hal, path, kind, info.path[path as usize].bw);
+}
+
+/// The RX IQK's end: the band's selections off.
+fn rxk_end(hal: &Hal, path: u8, band: u8) {
+    if band == phy::BAND_2G {
+        hal.write_rf(path, RR_RXK, RR_RXK_SEL2G, 0);
+        hal.write_rf(path, RR_RXKPLL, RR_RXKPLL_POW, 0);
+    } else {
+        hal.write_rf(path, RR_RXK, RR_RXK_SEL5G, 0);
+        hal.write_rf(path, RR_RXKPLL, RR_RXKPLL_POW, 0);
+        hal.write_rf(path, RR_WLSEL, RR_WLSEL_AG, 0);
+    }
+}
+
+/// `_rxk_group_sel` (5 GHz): four groups, wide band.
+fn rxk_group_sel(hal: &Hal, info: &mut IqkInfo, path: u8) {
+    const RXGN_A: [u32; 4] = [0x18c, 0x1a0, 0x28c, 0x2a0];
+    const ATTC2_A: [u32; 4] = [0x0, 0x0, 0x07, 0x30];
+    const ATTC1_A: [u32; 4] = [0x7, 0x5, 0x1, 0x1];
+    const RXGN_G: [u32; 4] = [0x1cc, 0x1e0, 0x2cc, 0x2e0];
+    const ATTC2_G: [u32; 4] = [0x0, 0x15, 0x3, 0x1a];
+    const ATTC1_G: [u32; 4] = [0x1, 0x0, 0x1, 0x0];
+    let band = info.path[path as usize].band;
+    for group in 0..4usize {
+        if band == phy::BAND_2G {
+            rx_gain(hal, path, band, RXGN_G[group], ATTC2_G[group], ATTC1_G[group]);
+        } else {
+            rx_gain(hal, path, band, RXGN_A[group], ATTC2_A[group], ATTC1_A[group]);
+        }
+        rxk_one(hal, info, path, group as u32, Iqk::Rxk);
+        hal.phy_w32_mask(R_IQKINF, 1 << (16 + group as u32 + path as u32 * 4), 0);
+    }
+    rxk_end(hal, path, band);
+    info.path[path as usize].nb_rxcfir = CFIR_WIDE;
+    hal.phy_w32_mask(R_IQK_RES + ((path as u32) << 8), B_IQK_RES_RXCFIR, 0x5);
+}
+
+/// `_iqk_nbrxk` (2.4 GHz): narrow band at one gain.
+fn iqk_nbrxk(hal: &Hal, info: &mut IqkInfo, path: u8) {
+    let band = info.path[path as usize].band;
+    if band == phy::BAND_2G {
+        rx_gain(hal, path, band, 0x1e0, 0x15, 0x0);
+    } else {
+        rx_gain(hal, path, band, 0x1a0, 0x00, 0x5);
+    }
+    rxk_one(hal, info, path, 0, Iqk::Nbrxk);
+    rxk_end(hal, path, band);
+    let value = hal.phy_r32_mask(R_RXIQC + ((path as u32) << 8), MASKDWORD);
+    info.path[path as usize].nb_rxcfir = value | 0x2;
+}
+
+/// `_iqk_rxclk_setting`.
+fn iqk_rxclk_setting(hal: &Hal, path: u8, bw: u8) {
+    let eighty = bw == 2;
+    hal.phy_w32_mask(R_CFIR_SYS + ((path as u32) << 8), MASKDWORD, if eighty { 0x4d00_0a08 } else { 0x4400_0a08 });
+    hal.phy_w32_mask(R_P0_RXCK + ((path as u32) << 13), B_P0_RXCK_VAL, if eighty { 0x2 } else { 0x1 });
+    hal.phy_set(R_P0_RXCK + ((path as u32) << 13), B_P0_RXCK_ON);
+    hal.phy_set(R_UPD_CLK_ADC, B_UPD_CLK_ADC_ON);
+    hal.phy_w32_mask(R_UPD_CLK_ADC, B_UPD_CLK_ADC_VAL, eighty as u32);
+}
+
+/// `_txk_group_sel`: four TX groups, wide band.
+fn txk_group_sel(hal: &Hal, info: &mut IqkInfo, path: u8) {
+    const A_TXGAIN: [u32; 4] = [0xe466, 0x646d, 0xe4e2, 0x64ed];
+    const G_TXGAIN: [u32; 4] = [0x60e8, 0x60f0, 0x61e8, 0x61ed];
+    const A_ITQT: [u32; 4] = [0x12, 0x12, 0x12, 0x1b];
+    const G_ITQT: [u32; 4] = [0x09, 0x12, 0x12, 0x12];
+    const G_ATTSMXR: [u32; 4] = [0x0, 0x1, 0x1, 0x1];
+    let p = (path as u32) << 8;
+    let state = info.path[path as usize];
+    for group in 0..4usize {
+        if state.band == phy::BAND_2G {
+            hal.phy_w32_mask(R_RFGAIN_BND + p, B_RFGAIN_BND, 0x08);
+            hal.write_rf(path, RR_GAINTX, RR_GAINTX_ALL, G_TXGAIN[group]);
+            hal.write_rf(path, RR_TXG1, RR_TXG1_ATT1, G_ATTSMXR[group]);
+            hal.write_rf(path, RR_TXG2, RR_TXG2_ATT0, G_ATTSMXR[group]);
+            hal.phy_w32_mask(R_KIP_IQP + p, MASKDWORD, G_ITQT[group]);
+        } else {
+            hal.phy_w32_mask(R_RFGAIN_BND + p, B_RFGAIN_BND, 0x04);
+            hal.write_rf(path, RR_GAINTX, RR_GAINTX_ALL, A_TXGAIN[group]);
+            hal.phy_w32_mask(R_KIP_IQP + p, MASKDWORD, A_ITQT[group]);
+        }
+        hal.phy_clr(R_IQK_RES + p, B_IQK_RES_TXCFIR);
+        hal.phy_set(R_CFIR_LUT + p, B_CFIR_LUT_SEL);
+        hal.phy_set(R_CFIR_LUT + p, B_CFIR_LUT_G3);
+        hal.phy_w32_mask(R_CFIR_LUT + p, B_CFIR_LUT_GP, group as u32);
+        hal.phy_clr(R_NCTL_N1, B_NCTL_N1_CIP);
+        iqk_one_shot(hal, path, Iqk::Txk, state.bw);
+        hal.phy_w32_mask(R_IQKINF, 1 << (8 + group as u32 + path as u32 * 4), 0);
+    }
+    info.path[path as usize].nb_txcfir = CFIR_WIDE;
+    hal.phy_w32_mask(R_IQK_RES + p, B_IQK_RES_TXCFIR, 0x5);
+}
+
+/// `_iqk_lok`: coarse and fine; whether the codes are out of range.
+fn iqk_lok(hal: &Hal, info: &IqkInfo, path: u8) -> bool {
+    let p = (path as u32) << 8;
+    let state = info.path[path as usize];
+    let itqt = if state.band == phy::BAND_2G {
+        hal.write_rf(path, RR_GAINTX, RR_GAINTX_ALL, 0xe5e0);
+        0x09
+    } else {
+        hal.write_rf(path, RR_GAINTX, RR_GAINTX_ALL, 0xe4e0);
+        0x12
+    };
+    hal.phy_set(R_IQK_CFG, B_IQK_CFG_SET);
+    let rf0 = hal.read_rf(path, RR_MOD, RFREG_MASK);
+    hal.phy_w32_mask(R_IQK_DIF1, B_IQK_DIF1_TXPI, rf0 | info.syn1to2);
+    hal.phy_clr(R_IQK_RES + p, B_IQK_RES_TXCFIR);
+    hal.phy_w32_mask(R_CFIR_LUT + p, B_CFIR_LUT_SEL, 1);
+    hal.phy_w32_mask(R_CFIR_LUT + p, B_CFIR_LUT_G3, 1);
+    hal.phy_w32_mask(R_CFIR_LUT + p, B_CFIR_LUT_GP, 0);
+    hal.phy_set(R_IOQ_IQK_DPK, B_IOQ_IQK_DPK_EN);
+    hal.phy_clr(R_NCTL_N1, B_NCTL_N1_CIP);
+    hal.phy_w32_mask(R_KIP_IQP + p, MASKDWORD, itqt);
+    iqk_one_shot(hal, path, Iqk::FlokCoarse, state.bw);
+    crate::delay_us(10);
+    hal.phy_w32_mask(R_KIP_IQP + p, MASKDWORD, itqt);
+    iqk_one_shot(hal, path, Iqk::FlokFine, state.bw);
+    // `_lok_finetune_check`.
+    let core = hal.read_rf(path, RR_TXMO, RFREG_MASK);
+    let (core_i, core_q) = (get(RR_TXMO_COI, core), get(RR_TXMO_COQ, core));
+    !(0x2..=0x1d).contains(&core_i) || !(0x2..=0x1d).contains(&core_q)
+}
+
+/// `_iqk_txk_setting`.
+fn iqk_txk_setting(hal: &Hal, info: &IqkInfo, path: u8) {
+    hal.phy_set(R_P0_NRBW + ((path as u32) << 13), B_P0_NRBW_DBG);
+    hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15, 0x1f);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15, 0x13);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_15, 0x0001);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_15, 0x0041);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RXK, 0x0303);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RXK, 0x0000);
+    if info.path[path as usize].band == phy::BAND_2G {
+        hal.write_rf(path, RR_XALNA2, RR_XALNA2_SW, 0);
+        hal.write_rf(path, RR_RCKD, RR_RCKD_POW, 0x3f);
+        hal.write_rf(path, RR_TXG1, RR_TXG1_ATT2, 0);
+        hal.write_rf(path, RR_TXG1, RR_TXG1_ATT1, 1);
+        hal.write_rf(path, RR_TXG2, RR_TXG2_ATT0, 1);
+        hal.write_rf(path, RR_TXGA, RR_TXGA_LOK_EN, 0);
+        hal.write_rf(path, RR_LUTWE, RR_LUTWE_LOK, 1);
+        hal.write_rf(path, RR_LUTDBG, RR_LUTDBG_LOK, 0);
+        hal.write_rf(path, RR_LUTWA, RR_LUTWA_MASK, 0x000);
+        hal.write_rf(path, RR_RSV2, RFREG_MASK, 0x80200);
+        hal.write_rf(path, RR_DTXLOK, RFREG_MASK, 0x80200);
+    } else {
+        hal.write_rf(path, RR_XGLNA2, RR_XGLNA2_SW, 0);
+        hal.write_rf(path, RR_RCKD, RR_RCKD_POW, 0x3f);
+        hal.write_rf(path, RR_BIASA, RR_BIASA_A, 0x7);
+        hal.write_rf(path, RR_TXGA, RR_TXGA_LOK_EN, 0);
+        hal.write_rf(path, RR_LUTWE, RR_LUTWE_LOK, 1);
+        hal.write_rf(path, RR_LUTDBG, RR_LUTDBG_LOK, 0);
+        hal.write_rf(path, RR_LUTWA, RR_LUTWA_MASK, 0x100);
+        hal.write_rf(path, RR_RSV2, RFREG_MASK, 0x80200);
+        hal.write_rf(path, RR_DTXLOK, RFREG_MASK, 0x80200);
+        hal.write_rf(path, RR_LUTWD0, RFREG_MASK, 0x1);
+        hal.write_rf(path, RR_LUTWD0, RFREG_MASK, 0x0);
+    }
+    hal.write_rf(path, RR_MOD, RFREG_MASK, 0x403e0 | info.syn1to2);
+    crate::delay_us(1);
+}
+
+/// `_doiqk` of a path.
+fn doiqk(hal: &Hal, info: &mut IqkInfo, path: u8, chan: &Chan) {
+    info.times += 1;
+    let p = (path as u32) << 8;
+    // `_iqk_get_ch_info`: table 0 (no other channel kept).
+    info.path[path as usize].band = chan.band;
+    info.path[path as usize].bw = chan.bw;
+    info.syn1to2 = (hal.phy_r32_mask(0x35c, 0x0000_0c00) == 0x01) as u32;
+    hal.phy_w32_mask(R_IQKINF, B_IQKINF_VER, 0x2a);
+    let shift = path as u32 * 16;
+    hal.phy_w32_mask(R_IQKCH, 0x000f << shift, chan.band as u32);
+    hal.phy_w32_mask(R_IQKCH, 0x00f0 << shift, chan.bw as u32);
+    hal.phy_w32_mask(R_IQKCH, 0xff00 << shift, chan.channel as u32);
+    hal.phy_w32_mask(R_IQKINF2, 0x0000_00ff, 0xd);
+    let bb = BACKUP_BB_REGS.map(|reg| hal.phy_r32_mask(reg, MASKDWORD));
+    let rf = BACKUP_RF_REGS.map(|reg| hal.read_rf(path, reg, RFREG_MASK));
+    rfk(hal, RTW8852A_RFK_IQK_SET_DEFS_NONDBCC_PATH01);
+    // `_iqk_preset`.
+    hal.phy_w32_mask(R_COEF_SEL + p, B_COEF_SEL_IQC, 0);
+    hal.phy_w32_mask(R_CFIR_LUT + p, B_CFIR_LUT_G2, 0);
+    hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 0);
+    hal.phy_w32_mask(R_NCTL_RPT, MASKDWORD, 0x0000_0080);
+    hal.phy_clr(R_NCTL_RW, MASKDWORD);
+    hal.phy_w32_mask(R_KIP_SYSCFG, MASKDWORD, 0x81ff_010a);
+    hal.phy_w32_mask(R_KPATH_CFG, MASKDWORD, 0x0020_0000);
+    hal.phy_w32_mask(R_MDPK_RX_DCK, MASKDWORD, 0x8000_0000);
+    hal.phy_clr(R_LOAD_COEF + p, MASKDWORD);
+    // `_iqk_by_path`: the LO with its bias tried up to three times.
+    hal.phy_w32_mask(R_CFIR_SYS + p, MASKDWORD, 0xce00_0a08);
+    let band = chan.band;
+    let mut lok_failed = false;
+    for ibias in 1..=3u32 {
+        // `_lok_res_table`.
+        hal.write_rf(path, RR_LUTWE, RFREG_MASK, 0x2);
+        hal.write_rf(path, RR_LUTWA, RFREG_MASK, if band == phy::BAND_2G { 0x0 } else { 0x1 });
+        hal.write_rf(path, RR_LUTWD0, RFREG_MASK, ibias);
+        hal.write_rf(path, RR_LUTWE, RFREG_MASK, 0x0);
+        iqk_txk_setting(hal, info, path);
+        lok_failed = iqk_lok(hal, info, path);
+        if !lok_failed {
+            break;
+        }
+    }
+    txk_group_sel(hal, info, path);
+    iqk_rxclk_setting(hal, path, chan.bw);
+    iqk_rxk_setting(hal, path, band);
+    if band == phy::BAND_2G {
+        iqk_nbrxk(hal, info, path);
+    } else {
+        rxk_group_sel(hal, info, path);
+    }
+    // `_iqk_info_iqk`.
+    let shift = path as u32 * 4;
+    hal.phy_w32_mask(R_IQKINF, (1 << 0) << shift, 0);
+    hal.phy_w32_mask(R_IQKINF, (1 << 1) << shift, 0);
+    hal.phy_w32_mask(R_IQKINF, (1 << 2) << shift, 0);
+    hal.phy_w32_mask(R_IQKINF, (1 << 3) << shift, 0);
+    hal.phy_w32_mask(R_IQKINF2, B_IQKINF2_KCNT, info.times & 0xff);
+    if hal.phy_r32_mask(R_IQKINF, 0x0000_000f << shift) != 0 {
+        info.fail_count += 1;
+    }
+    hal.phy_w32_mask(R_IQKINF2, 0x00ff_0000 << shift, info.fail_count);
+    let _ = lok_failed;
+    // `_iqk_restore`.
+    let state = info.path[path as usize];
+    hal.phy_w32_mask(R_TXIQC + p, MASKDWORD, state.nb_txcfir);
+    hal.phy_w32_mask(R_RXIQC + p, MASKDWORD, state.nb_rxcfir);
+    hal.phy_clr(R_NCTL_RPT, MASKDWORD);
+    hal.phy_clr(R_MDPK_RX_DCK, MASKDWORD);
+    hal.phy_w32_mask(R_KIP_SYSCFG, MASKDWORD, 0x8000_0000);
+    hal.phy_clr(R_KPATH_CFG, MASKDWORD);
+    hal.phy_clr(R_GAPK, B_GAPK_ADR);
+    hal.phy_w32_mask(R_CFIR_SYS + p, MASKDWORD, 0x1001_0000);
+    hal.phy_clr(R_KIP + p, B_KIP_RFGAIN);
+    hal.phy_w32_mask(R_CFIR_MAP + p, MASKDWORD, 0xe4e4_e4e4);
+    hal.phy_clr(R_CFIR_LUT + p, B_CFIR_LUT_SEL);
+    hal.phy_clr(R_KIP_IQP + p, B_KIP_IQP_IQSW);
+    hal.phy_w32_mask(R_LOAD_COEF + p, MASKDWORD, 0x0000_0002);
+    hal.write_rf(path, RR_LUTWE, RR_LUTWE_LOK, 0);
+    hal.write_rf(path, RR_RCKD, RR_RCKD_POW, 0);
+    hal.write_rf(path, RR_LUTWE, RR_LUTWE_LOK, 0);
+    hal.write_rf(path, RR_MOD, RR_MOD_MASK, RR_MOD_V_RX);
+    hal.write_rf(path, RR_TXRSV, RR_TXRSV_GAPK, 0);
+    hal.write_rf(path, RR_BIAS, RR_BIAS_GAPK, 0);
+    hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 1);
+    rfk(hal, RTW8852A_RFK_IQK_RESTORE_DEFS_NONDBCC_PATH01);
+    for (&reg, &value) in BACKUP_BB_REGS.iter().zip(&bb) {
+        hal.phy_w32_mask(reg, MASKDWORD, value);
+    }
+    for (&reg, &value) in BACKUP_RF_REGS.iter().zip(&rf) {
+        hal.write_rf(path, reg, RFREG_MASK, value);
+    }
+}
+
+/// `rtw8852a_iqk`.
+fn iqk(hal: &Hal, info: &mut IqkInfo, chan: &Chan) {
+    crate::sta::stop_sch_tx(hal, true);
+    wait_rx_mode(hal);
+    hal.phy_clr(R_IQKINF, MASKDWORD);
+    for path in 0..2u8 {
+        doiqk(hal, info, path, chan);
+    }
+    crate::sta::stop_sch_tx(hal, false);
+}
+
+// ---- The RX DC offset. ----
+
+/// `rtw8852a_rx_dck` (`_rx_dck`, by the AFE): each path's RX DC offset,
+/// the TSSI paused (bit 30 of its tracking) around it.
+pub(crate) fn rx_dck(hal: &Hal, tssi_mode: &[bool; 2]) {
+    crate::sta::stop_sch_tx(hal, true);
+    wait_rx_mode(hal);
+    for path in 0..2u8 {
+        let p = (path as u32) << 13;
+        let reg5 = hal.read_rf(path, RR_RSV1, RFREG_MASK);
+        let tune = hal.read_rf(path, RR_DCK, RR_DCK_FINE);
+        if tssi_mode[path as usize] {
+            hal.phy_set(0x5818 + p, 1 << 30);
+        }
+        hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 0);
+        hal.write_rf(path, RR_DCK, RR_DCK_FINE, 0);
+        hal.write_rf(path, RR_MOD, RR_MOD_MASK, RR_MOD_V_RX);
+        // `_set_rx_dck` by the AFE.
+        let rxck = hal.phy_r32_mask(R_P0_RXCK + p, MASKDWORD);
+        hal.phy_set(R_P0_NRBW + p, B_P0_NRBW_DBG);
+        hal.phy_set(R_P0_RXCK + p, B_P0_RXCK_ON);
+        hal.phy_w32_mask(R_P0_RXCK + p, B_P0_RXCK_VAL, 0x3);
+        hal.phy_set(R_S0_RXDC2 + p, B_S0_RXDC2_MEN);
+        hal.phy_w32_mask(R_S0_RXDC2 + p, B_S0_RXDC2_AVG, 0x3);
+        hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15_H, 0x3);
+        hal.phy_clr(R_ANAPAR, B_ANAPAR_ADCCLK);
+        hal.phy_clr(R_ANAPAR, B_ANAPAR_FLTRST);
+        hal.phy_set(R_ANAPAR, B_ANAPAR_FLTRST);
+        hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_CRXBB, 0x1);
+        hal.write_rf(path, RR_DCK2, RR_DCK2_CYCLE, 0x3f);
+        hal.write_rf(path, RR_DCK1, RR_DCK1_SEL, 1);
+        hal.write_rf(path, RR_DCK, RR_DCK_LV, 0);
+        hal.write_rf(path, RR_DCK, RR_DCK_LV, 1);
+        crate::delay_us(600);
+        hal.write_rf(path, RR_DCK, RR_DCK_LV, 0);
+        hal.phy_clr(R_P0_NRBW + p, B_P0_NRBW_DBG);
+        hal.phy_w32_mask(R_P0_RXCK + p, MASKDWORD, rxck);
+        hal.write_rf(path, RR_DCK, RR_DCK_FINE, tune);
+        hal.write_rf(path, RR_RSV1, RFREG_MASK, reg5);
+        if tssi_mode[path as usize] {
+            hal.phy_clr(0x5818 + p, 1 << 30);
+        }
+    }
+    crate::sta::stop_sch_tx(hal, false);
+}
+
+// ---- DPK. ----
+
+/// `enum rtw8852a_dpk_id`: the one-shots the host starts.
+const LBK_RXIQK: u32 = 0x06;
+const SYNC: u32 = 0x10;
+const MDPK_IDL: u32 = 0x11;
+const GAIN_LOSS: u32 = 0x13;
+/// The TX gains the AGC keeps to, an invalid one; the TX gain it starts
+/// from.
+const DPK_TXAGC_LOWER: u32 = 0x2e;
+const DPK_TXAGC_UPPER: u32 = 0x3f;
+const DPK_TXAGC_INVAL: u32 = 0xff;
+const DPK_TXAGC_INIT: u32 = 0x38;
+/// The digital gain's range that needs no new sync (`DPK_DGAIN_*`).
+const DPK_DGAIN_UPPER: u32 = 1922;
+const DPK_DGAIN_LOWER: u32 = 342;
+const DPK_GL_CRIT: u32 = 7;
+const DPK_PWSF: u32 = 0x78;
+
+/// A path's DPK result (table 0: no reload).
+#[derive(Clone, Copy, Default)]
+struct DpkPath {
+    band: u8,
+    ch: u8,
+    bw: u8,
+    ok: bool,
+    ther_dpk: u32,
+}
+
+/// `_dpk_one_shot`.
+fn dpk_one_shot(hal: &Hal, path: u8, id: u32) {
+    hal.phy_w32_mask(R_NCTL_CFG, MASKDWORD, (id << 8) | (0x19 + ((path as u32) << 4)));
+    hal.phy_set(R_DPK_CTL, B_DPK_CTL_EN);
+    poll(|| hal.phy_r32_mask(R_RFK_ST, MASKBYTE0) == NCTL_DONE, 10, 20_000);
+    hal.phy_clr(R_NCTL_N1, MASKBYTE0);
+}
+
+/// `_set_rx_dck` by the RF (the DPK's).
+fn set_rx_dck_rfc(hal: &Hal, path: u8) {
+    hal.write_rf(path, RR_DCK2, RR_DCK2_CYCLE, 0x3f);
+    hal.write_rf(path, RR_DCK1, RR_DCK1_SEL, 0);
+    hal.write_rf(path, RR_DCK, RR_DCK_LV, 0);
+    hal.write_rf(path, RR_DCK, RR_DCK_LV, 1);
+    crate::delay_us(600);
+    hal.write_rf(path, RR_DCK, RR_DCK_LV, 0);
+}
+
+/// `_dpk_lbk_rxiqk`: the RX IQ through the loopback, its attenuation by
+/// the RX gain.
+fn dpk_lbk_rxiqk(hal: &Hal, path: u8) {
+    let rxbb = hal.read_rf(path, RR_MOD, RR_MOD_M_RXBB);
+    rfk(hal, RTW8852A_RFK_DPK_LBK_RXIQK_DEFS_F);
+    hal.write_rf(path, RR_MOD, RR_MOD_MASK, 0xc);
+    hal.write_rf(path, RR_RXK, RR_RXK_PLLEN, 1);
+    hal.write_rf(path, RR_RXPOW, RR_RXPOW_IQK, 0x2);
+    let rf18 = hal.read_rf(path, RR_CFGCH, RFREG_MASK);
+    hal.write_rf(path, RR_RSV4, RFREG_MASK, rf18);
+    hal.write_rf(path, RR_RXKPLL, RR_RXKPLL_OFF, 0x13);
+    hal.write_rf(path, RR_RXKPLL, RR_RXKPLL_POW, 0);
+    hal.write_rf(path, RR_RXKPLL, RR_RXKPLL_POW, 1);
+    crate::delay_us(70);
+    hal.write_rf(path, RR_RXIQGEN, RR_RXIQGEN_ATTL, 0x1f);
+    let atth = match rxbb {
+        0..=0xa => 0x3,
+        0xb..=0x10 => 0x1,
+        _ => 0x0,
+    };
+    hal.write_rf(path, RR_RXIQGEN, RR_RXIQGEN_ATTH, atth);
+    hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_RXT, 0x11);
+    dpk_one_shot(hal, path, LBK_RXIQK);
+    hal.write_rf(path, RR_RXK, RR_RXK_PLLEN, 0);
+    hal.write_rf(path, RR_RXPOW, RR_RXPOW_IQK, 0);
+    hal.write_rf(path, RR_RXKPLL, RR_RXKPLL_POW, 0);
+    hal.write_rf(path, RR_MOD, RR_MOD_MASK, RR_MOD_V_DPK);
+    rfk(hal, RTW8852A_RFK_DPK_LBK_RXIQK_DEFS_R);
+}
+
+/// `_dpk_table_select` (table 0).
+fn dpk_table_select(hal: &Hal, path: u8, gain: u32) {
+    hal.phy_w32_mask(R_DPD_CH0 + ((path as u32) << 8), MASKBYTE3, 0x80 + gain * 0x10);
+}
+
+/// `_dpk_sync`: whether it failed (`_dpk_sync_check`).
+fn dpk_sync(hal: &Hal, path: u8, bw: u8) -> bool {
+    rtw8852b_rfk::dpk_tpg_sel(hal, bw);
+    dpk_one_shot(hal, path, SYNC);
+    rtw8852b_rfk::dpk_sync_check(hal)
+}
+
+/// `_dpk_dgain_mapping`: the RX gain step a digital gain asks for.
+fn dpk_dgain_mapping(dgain: u32) -> i32 {
+    match dgain {
+        0x783.. => 6,
+        0x551..=0x782 => 3,
+        0x3c4..=0x550 => 0,
+        0x2aa..=0x3c3 => -3,
+        0x1e3..=0x2a9 => -6,
+        0x156..=0x1e2 => -9,
+        _ => -12,
+    }
+}
+
+/// `_dpk_set_offset`: the TX gain (in RF register 1) moved down by an
+/// offset, within the AGC's range.
+fn dpk_set_offset(hal: &Hal, path: u8, offset: i32) -> u32 {
+    let txagc = hal.read_rf(path, RR_MODOPT, RFREG_MASK) as u8 as i32;
+    let txagc = (txagc - offset).clamp(DPK_TXAGC_LOWER as i32, DPK_TXAGC_UPPER as i32) as u32;
+    hal.write_rf(path, RR_MODOPT, RFREG_MASK, txagc);
+    txagc
+}
+
+/// `_dpk_pas_read` (the check): the first sample compressed against the
+/// last.
+fn dpk_pas_compressed(hal: &Hal) -> bool {
+    rfk(hal, RTW8852A_RFK_DPK_PAS_READ_DEFS);
+    let sample = |index: u32| {
+        hal.phy_w32_mask(R_DPK_CFG3, MASKBYTE3, index);
+        let i = sign_extend12(hal.phy_r32_mask(R_RPT_COM, MASKHWORD)).unsigned_abs();
+        let q = sign_extend12(hal.phy_r32_mask(R_RPT_COM, MASKLWORD)).unsigned_abs();
+        i * i + q * q
+    };
+    let (first, last) = (sample(0x00), sample(0x1f));
+    first >= last * 8 / 5
+}
+
+/// `_dpk_agc`: the RX gain for the sync's digital gain, then the TX gain
+/// by the gain loss; `DPK_TXAGC_INVAL` when the sync failed.
+fn dpk_agc(hal: &Hal, path: u8, bw: u8) -> u32 {
+    #[derive(Clone, Copy)]
+    enum Step {
+        SyncDgain,
+        GainAdj,
+        GainLossIdx,
+        GlGt,
+        GlLt,
+        SetTxGain,
+    }
+    let (mut step, mut txagc, mut count, mut limited) = (Step::SyncDgain, DPK_TXAGC_INIT, 0u32, false);
+    let (mut dgain, mut gl_idx) = (0u32, 0u32);
+    loop {
+        let mut out = false;
+        match step {
+            Step::SyncDgain => {
+                if dpk_sync(hal, path, bw) {
+                    txagc = DPK_TXAGC_INVAL;
+                    out = true;
+                } else {
+                    // `_dpk_dgain_read`.
+                    hal.phy_clr(R_KIP_RPT1, B_KIP_RPT1_SEL);
+                    dgain = hal.phy_r32_mask(R_RPT_COM, B_PRT_COM_DCI);
+                    step = if limited { Step::GainLossIdx } else { Step::GainAdj };
+                }
+            }
+            Step::GainAdj => {
+                let offset = dpk_dgain_mapping(dgain);
+                let wanted = hal.read_rf(path, RR_MOD, RR_MOD_M_RXBB) as i32 + offset;
+                let rxbb = if wanted > 0x1f {
+                    limited = true;
+                    0x1f
+                } else if wanted < 0 {
+                    limited = true;
+                    0
+                } else {
+                    wanted as u32
+                };
+                hal.write_rf(path, RR_MOD, RR_MOD_M_RXBB, rxbb);
+                if offset != 0 || count == 0 {
+                    if bw < 2 {
+                        rtw8852b_rfk::dpk_bypass_rxcfir(hal, path, true);
+                    } else {
+                        dpk_lbk_rxiqk(hal, path);
+                    }
+                }
+                step = if !(DPK_DGAIN_LOWER..=DPK_DGAIN_UPPER).contains(&dgain) { Step::SyncDgain } else { Step::GainLossIdx };
+                count += 1;
+            }
+            Step::GainLossIdx => {
+                // `_dpk_gainloss`.
+                dpk_table_select(hal, path, 1);
+                dpk_one_shot(hal, path, GAIN_LOSS);
+                gl_idx = rtw8852b_rfk::dpk_gainloss_read(hal);
+                step = if (gl_idx == 0 && dpk_pas_compressed(hal)) || gl_idx > DPK_GL_CRIT {
+                    Step::GlGt
+                } else if gl_idx == 0 {
+                    Step::GlLt
+                } else {
+                    Step::SetTxGain
+                };
+            }
+            Step::GlGt => {
+                if txagc == DPK_TXAGC_LOWER {
+                    out = true;
+                } else {
+                    txagc = dpk_set_offset(hal, path, 3);
+                }
+                step = Step::GainLossIdx;
+                count += 1;
+            }
+            Step::GlLt => {
+                if txagc == DPK_TXAGC_UPPER {
+                    out = true;
+                } else {
+                    txagc = dpk_set_offset(hal, path, -2);
+                }
+                step = Step::GainLossIdx;
+                count += 1;
+            }
+            Step::SetTxGain => {
+                txagc = dpk_set_offset(hal, path, gl_idx as i32);
+                out = true;
+                count += 1;
+            }
+        }
+        if out || count >= 6 {
+            break;
+        }
+    }
+    txagc
+}
+
+/// `_dpk_onoff` (table 0): the order's bits with the switch.
+fn dpk_onoff(hal: &Hal, path: &DpkPath, index: u8, off: bool) {
+    let on = !off && path.ok;
+    hal.phy_w32_mask(R_DPD_CH0A + ((index as u32) << 8), MASKBYTE3, 0x6 | on as u32);
+}
+
+/// `_dpk_manual_txcfir`: the TX gain the CFIR takes by hand.
+fn dpk_manual_txcfir(hal: &Hal, path: u8, manual: bool) {
+    let p = (path as u32) << 8;
+    if manual {
+        hal.phy_w32_mask(R_KIP + p, B_KIP_RFGAIN, 1);
+        let pad = hal.read_rf(path, RR_GAINTX, RR_GAINTX_PAD);
+        hal.phy_w32_mask(R_RFGAIN + p, B_RFGAIN_PAD, pad);
+        let txbb = hal.read_rf(path, RR_GAINTX, RR_GAINTX_BB);
+        hal.phy_w32_mask(R_RFGAIN + p, B_RFGAIN_TXBB, txbb);
+        hal.phy_w32_mask(R_LOAD_COEF + p, B_LOAD_COEF_CFIR, 1);
+        hal.phy_clr(R_LOAD_COEF + p, B_LOAD_COEF_CFIR);
+        hal.phy_w32_mask(R_LOAD_COEF + p, 1 << 1, 1);
+    } else {
+        hal.phy_clr(R_KIP + p, B_KIP_RFGAIN);
+    }
+}
+
+/// `_dpk_main` of a path: whether it failed.
+fn dpk_main(hal: &Hal, state: &mut State, path: u8) -> bool {
+    let p = (path as u32) << 8;
+    let result = state.dpk[path as usize];
+    hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 0);
+    // `_dpk_set_tx_pwr`, `_dpk_rf_setting`.
+    hal.write_rf(path, RR_MODOPT, RFREG_MASK, DPK_TXAGC_INIT);
+    if result.band == phy::BAND_2G {
+        hal.write_rf(path, RR_MOD, RR_MOD_DPK, 0x280b);
+        hal.write_rf(path, RR_RXBB, RR_RXBB_ATTC, 0);
+        hal.write_rf(path, RR_RXBB, RR_RXBB_ATTR, 0x4);
+        hal.write_rf(path, RR_MIXER, RR_MIXER_GN, 0);
+    } else {
+        hal.write_rf(path, RR_MOD, RR_MOD_DPK, 0x282e);
+        hal.write_rf(path, RR_BIASA2, RR_BIASA2_LB, 0x7);
+        hal.write_rf(path, RR_TXATANK, RR_TXATANK_LBSW, 0x3);
+        hal.write_rf(path, RR_RXA, RR_RXA_DPK, 0x3);
+    }
+    hal.write_rf(path, RR_RCKD, RR_RCKD_BW, 1);
+    hal.write_rf(path, RR_BTC, RR_BTC_TXBB, result.bw as u32 + 1);
+    hal.write_rf(path, RR_BTC, RR_BTC_RXBB, 0);
+    // `_dpk_rx_dck`.
+    hal.write_rf(path, RR_RXBB2, RR_EN_TIA_IDA, 0x3);
+    set_rx_dck_rfc(hal, path);
+    // `_dpk_kip_setting` (table 0).
+    hal.phy_w32_mask(R_NCTL_RPT, MASKDWORD, 0x0000_0080);
+    hal.phy_w32_mask(R_KIP_CLK, MASKDWORD, 0x0009_3f3f);
+    hal.phy_w32_mask(R_KIP_SYSCFG, MASKDWORD, 0x807f_030a);
+    hal.phy_w32_mask(R_CFIR_SYS + p, MASKDWORD, 0xce00_0a08);
+    hal.phy_w32_mask(R_DPK_CFG, B_DPK_CFG_IDX, 0x2);
+    hal.phy_w32_mask(R_NCTL_CFG, B_NCTL_CFG_SPAGE, path as u32);
+    hal.phy_w32_mask(R_DPD_CH0 + p, MASKDWORD, 0x003f_2e2e);
+    hal.phy_w32_mask(R_DPD_CH0A + p, MASKDWORD, 0x005b_5b5b);
+    dpk_manual_txcfir(hal, path, true);
+    let txagc = dpk_agc(hal, path, result.bw);
+    let failed = txagc == DPK_TXAGC_INVAL;
+    // `_dpk_get_thermal`: the averaged value.
+    state.dpk[path as usize].ther_dpk = state.thermal.read(path);
+    // `_dpk_idl_mpa` with `_dpk_set_mdpd_para(0)`.
+    hal.phy_w32_mask(R_LDL_NORM, B_LDL_NORM_OP, 0);
+    hal.phy_w32_mask(R_LDL_NORM, B_LDL_NORM_PN, 0x3);
+    hal.phy_w32_mask(R_MDPK_SYNC, B_MDPK_SYNC_MAN, 1);
+    dpk_table_select(hal, path, 1);
+    dpk_one_shot(hal, path, MDPK_IDL);
+    hal.write_rf(path, RR_MOD, RR_MOD_MASK, RR_MOD_V_RX);
+    // `_dpk_fill_result` (gain 1, table 0).
+    hal.phy_w32_mask(R_COEF_SEL + p, B_COEF_SEL_MDPD, 0);
+    hal.phy_w32_mask(R_TXAGC_RFK + p, 0x3f << (1 << 3), txagc);
+    hal.phy_w32_mask(R_DPD_BND + p, 0x1ff << (1 << 4), DPK_PWSF);
+    hal.phy_w32_mask(R_LOAD_COEF + p, B_LOAD_COEF_MDPD, 1);
+    hal.phy_clr(R_LOAD_COEF + p, B_LOAD_COEF_MDPD);
+    hal.phy_w32_mask(R_DPD_CH0A + p, MASKDWORD, 0x065b_5b5b);
+    hal.phy_clr(R_DPD_V1 + p, MASKDWORD);
+    hal.phy_clr(R_MDPK_SYNC, B_MDPK_SYNC_SEL);
+    dpk_manual_txcfir(hal, path, false);
+    state.dpk[path as usize].ok = !failed;
+    failed
+}
+
+/// `rtw8852a_dpk` (`_dpk_cal_select`, no reload): both paths on table 0,
+/// the BB and AFE set for both, the KIP's registers and the RF's kept.
+fn dpk(hal: &Hal, state: &mut State, chan: &Chan) {
+    const KIP_REGS: [u32; 2] = [R_RXIQC, R_IQK_RES];
+    crate::sta::stop_sch_tx(hal, true);
+    wait_rx_mode(hal);
+    let bb = BACKUP_BB_REGS.map(|reg| hal.phy_r32_mask(reg, MASKDWORD));
+    let mut kip = [[0u32; 2]; 2];
+    let mut rf = [[0u32; 8]; 2];
+    for path in 0..2u8 {
+        let p = (path as u32) << 8;
+        if state.tssi_mode[path as usize] {
+            hal.phy_w32_mask(R_P0_TSSI_TRK + ((path as u32) << 13), B_P0_TSSI_TRK_EN, 1);
+        }
+        kip[path as usize] = KIP_REGS.map(|reg| hal.phy_r32_mask(reg + p, MASKDWORD));
+        rf[path as usize] = BACKUP_RF_REGS.map(|reg| hal.read_rf(path, reg, RFREG_MASK));
+        state.dpk[path as usize] = DpkPath { band: chan.band, ch: chan.channel, bw: chan.bw, ..Default::default() };
+    }
+    rfk(hal, RTW8852A_RFK_DPK_BB_AFE_S_DEFS_AB);
+    for path in 0..2u8 {
+        let failed = dpk_main(hal, state, path);
+        dpk_onoff(hal, &state.dpk[path as usize], path, failed);
+    }
+    rfk(hal, RTW8852A_RFK_DPK_BB_AFE_R_DEFS_AB);
+    for (&reg, &value) in BACKUP_BB_REGS.iter().zip(&bb) {
+        hal.phy_w32_mask(reg, MASKDWORD, value);
+    }
+    for path in 0..2u8 {
+        let p = (path as u32) << 8;
+        // `_dpk_kip_restore`.
+        hal.phy_clr(R_NCTL_RPT, MASKDWORD);
+        hal.phy_w32_mask(R_KIP_SYSCFG, MASKDWORD, 0x8000_0000);
+        hal.phy_w32_mask(R_CFIR_SYS + p, MASKDWORD, 0x1001_0000);
+        hal.phy_clr(R_KIP_CLK, MASKDWORD);
+        if hal.cv > CHIP_CBV as u8 {
+            hal.phy_w32_mask(R_DPD_COM + p, 1 << 15, 1);
+        }
+        for (&reg, &value) in KIP_REGS.iter().zip(&kip[path as usize]) {
+            hal.phy_w32_mask(reg + p, MASKDWORD, value);
+        }
+        for (&reg, &value) in BACKUP_RF_REGS.iter().zip(&rf[path as usize]) {
+            hal.write_rf(path, reg, RFREG_MASK, value);
+        }
+        if state.tssi_mode[path as usize] {
+            hal.phy_w32_mask(R_P0_TSSI_TRK + ((path as u32) << 13), B_P0_TSSI_TRK_EN, 0);
+        }
+    }
+    crate::sta::stop_sch_tx(hal, false);
+}
+
+/// `_dpk_track`: the DPD's power scaling factor with the temperature
+/// (and the TSSI's gains, its extra offset, in its mode).
+fn dpk_track(hal: &Hal, state: &State) {
+    let mut ini_diff: i32 = 0;
+    for path in 0..2u8 {
+        let result = state.dpk[path as usize];
+        let current = state.thermal.read(path);
+        let mut delta: i32 = 0;
+        if result.ch != 0 && current != 0 {
+            delta = (result.ther_dpk as i32 - current as i32) as i8 as i32;
+        }
+        delta = if result.band == phy::BAND_2G { (delta * 3 / 2) as i8 as i32 } else { (delta * 5 / 2) as i8 as i32 };
+        let bb = R_TXAGC_BB + ((path as u32) << 13);
+        let txagc_rf = hal.phy_r32_mask(bb, RR_MODOPT_M_TXPWR);
+        let pwsf = if state.tssi_mode[path as usize] {
+            let txagc_bb = hal.phy_r32_mask(bb, MASKBYTE2) as u8 as i8 as i32;
+            let txagc_bb_tp = hal.phy_r32_mask(R_TXAGC_TP + ((path as u32) << 13), B_TXAGC_TP) as u8 as i32;
+            let mut offset = hal.phy_r32_mask(bb, MASKBYTE3) as u8 as i8 as i32;
+            if hal.phy_r32_mask(R_DPD_COM + ((path as u32) << 8), 1 << 15) == 1 {
+                offset = 0;
+            }
+            if txagc_rf != 0 && current != 0 {
+                ini_diff = (offset + delta) as i8 as i32;
+            }
+            let extra = state.extra_ofst[path as usize] as i32;
+            if hal.phy_r32_mask(R_P0_TXDPD + ((path as u32) << 13), B_P0_TXDPD) == 0 {
+                (DPK_PWSF as i32 + txagc_bb_tp - txagc_bb + ini_diff + extra) as u16 as u32
+            } else {
+                (DPK_PWSF as i32 + ini_diff + extra) as u16 as u32
+            }
+        } else {
+            ((DPK_PWSF as i32 + delta) as u32) & 0x1ff
+        };
+        if hal.phy_r32_mask(R_DPK_TRK, B_DPK_TRK_DIS) == 0 && txagc_rf != 0 {
+            let reg = R_DPD_BND + ((path as u32) << 8);
+            hal.phy_w32_mask(reg, 0x0000_01ff, pwsf);
+            hal.phy_w32_mask(reg, 0x01ff_0000, pwsf);
+        }
+    }
+}
+
+// ---- TSSI. ----
+
+/// `_tssi_get_trim_group`: eight groups, none between two.
+fn trim_group(ch: u8) -> usize {
+    match ch {
+        9..=14 => 1,
+        36..=48 => 2,
+        52..=64 => 3,
+        100..=112 => 4,
+        116..=128 => 5,
+        132..=144 => 6,
+        149..=177 => 7,
+        _ => 0,
+    }
+}
+
+/// `_tssi_pak`: the PA's table for the channel's subband.
+fn tssi_pak(hal: &Hal, path: u8, chan: &Chan) {
+    let a = path == 0;
+    let table = match (chan.band, chan.channel) {
+        (phy::BAND_2G, _) => if a { RTW8852A_TSSI_PAK_DEFS_A_2G } else { RTW8852A_TSSI_PAK_DEFS_B_2G },
+        (_, 100..=144) => if a { RTW8852A_TSSI_PAK_DEFS_A_5G_3 } else { RTW8852A_TSSI_PAK_DEFS_B_5G_3 },
+        (_, 149..=177) => if a { RTW8852A_TSSI_PAK_DEFS_A_5G_4 } else { RTW8852A_TSSI_PAK_DEFS_B_5G_4 },
+        _ => if a { RTW8852A_TSSI_PAK_DEFS_A_5G_1 } else { RTW8852A_TSSI_PAK_DEFS_B_5G_1 },
+    };
+    rfk(hal, table);
+}
+
+/// `rtw8852a_tssi` and `rtw8852a_tssi_scan` (`scan`: only when the loop is
+/// on, the band's parts again): the closed loop set up per path, turned on
+/// with the eFuse's offsets; then `_tssi_high_power`. Linux's `_tssi_pre_tx`
+/// (packets from the baseband's generator to settle the loop, the TX gain
+/// it ends at kept for scans) is not run.
+fn tssi(hal: &Hal, state: &mut State, efuse: &Tssi, track: Option<&TxPowerTrack>, chan: &Chan, scan: bool) {
+    if scan && !(state.tssi_mode[0] && state.tssi_mode[1]) {
+        return;
+    }
+    let two_g = chan.band == phy::BAND_2G;
+    // `_tssi_disable`.
+    rfk(hal, RTW8852A_TSSI_DISABLE_DEFS);
+    state.tssi_mode = [false; 2];
+    for path in 0..2u8 {
+        let a = path == 0;
+        // `_tssi_rf_setting`, `_tssi_set_sys`.
+        hal.write_rf(path, RR_TXPOW, if two_g { RR_TXPOW_TXG } else { RR_TXPOW_TXA }, 1);
+        rfk(hal, RTW8852A_TSSI_SYS_DEFS);
+        rfk(hal, if two_g { RTW8852A_TSSI_SYS_DEFS_2G } else { RTW8852A_TSSI_SYS_DEFS_5G });
+        if !scan {
+            rfk_by(hal, a, RTW8852A_TSSI_TXPWR_CTRL_BB_DEFS_A, RTW8852A_TSSI_TXPWR_CTRL_BB_DEFS_B);
+            rfk(hal, if two_g { RTW8852A_TSSI_TXPWR_CTRL_BB_DEFS_2G } else { RTW8852A_TSSI_TXPWR_CTRL_BB_DEFS_5G });
+            rfk_by(hal, a, RTW8852A_TSSI_TXPWR_CTRL_BB_HE_TB_DEFS_A, RTW8852A_TSSI_TXPWR_CTRL_BB_HE_TB_DEFS_B);
+            rfk_by(hal, a, RTW8852A_TSSI_DCK_DEFS_A, RTW8852A_TSSI_DCK_DEFS_B);
+        }
+        rtw8852b_rfk::tssi_set_tmeter_tbl(hal, path, chan, efuse, track);
+        if !scan {
+            rfk_by(hal, a, RTW8852A_TSSI_DAC_GAIN_TBL_DEFS_A, RTW8852A_TSSI_DAC_GAIN_TBL_DEFS_B);
+            rfk_by(hal, a, RTW8852A_TSSI_SLOPE_CAL_ORG_DEFS_A, RTW8852A_TSSI_SLOPE_CAL_ORG_DEFS_B);
+            rfk_by(hal, a, RTW8852A_TSSI_RF_GAP_TBL_DEFS_A, RTW8852A_TSSI_RF_GAP_TBL_DEFS_B);
+            rfk_by(hal, a, RTW8852A_TSSI_SLOPE_DEFS_A, RTW8852A_TSSI_SLOPE_DEFS_B);
+        }
+        tssi_pak(hal, path, chan);
+    }
+    // `_tssi_enable`.
+    for path in 0..2u8 {
+        let a = path == 0;
+        rfk_by(hal, a, RTW8852A_TSSI_TRACK_DEFS_A, RTW8852A_TSSI_TRACK_DEFS_B);
+        rfk_by(hal, a, RTW8852A_TSSI_TXAGC_OFST_MV_AVG_DEFS_A, RTW8852A_TSSI_TXAGC_OFST_MV_AVG_DEFS_B);
+        rfk_by(hal, a, RTW8852A_TSSI_ENABLE_DEFS_A, RTW8852A_TSSI_ENABLE_DEFS_B);
+        state.base_thermal[path as usize] = state.thermal.read(path);
+        state.tssi_mode[path as usize] = true;
+    }
+    // `_tssi_set_efuse_to_de`.
+    for path in 0..2usize {
+        let trim = efuse.trim[path][trim_group(chan.channel)] as i32;
+        let cck = (efuse.cck[path][phy::cck_group(chan.channel)] as i32 + trim) as u32;
+        for reg in rtw8852b_rfk::TSSI_DE_CCK[path] {
+            hal.phy_w32_mask(reg, rtw8852b_rfk::TSSI_DE_MASK, cck);
+        }
+        let ofdm = (phy::group_value(&efuse.mcs[path], phy::ofdm_group(chan.channel)) as i32 + trim) as u32;
+        for reg in rtw8852b_rfk::TSSI_DE_MCS[path] {
+            hal.phy_w32_mask(reg, rtw8852b_rfk::TSSI_DE_MASK, ofdm);
+        }
+    }
+    if !scan {
+        // `_tssi_high_power`: the tracking only above 18 dBm on 2.4 GHz,
+        // which the TX power's cap keeps under.
+        if !(phy::LIMIT_CAP_CENTI_DBM > 1800 && two_g) {
+            rfk(hal, RTW8852A_TSSI_TRACKING_DEFS);
+            state.extra_ofst = [0; 2];
+            state.tracking = false;
+        } else {
+            state.tracking = true;
+        }
+    }
+}
+
+/// `_tssi_track`: with the tracking on, the TX gain's scale from the
+/// temperature's change since the loop started.
+fn tssi_track(hal: &Hal, state: &mut State) {
+    const TX_GAIN_SCALE: [u32; 16] = [0x400, 0x40e, 0x41d, 0x427, 0x43c, 0x44c, 0x45c, 0x46c, 0x400, 0x39d, 0x3ab, 0x3b8, 0x3c6, 0x3d4, 0x3e2, 0x3f1];
+    if !(state.tssi_mode[0] && state.tssi_mode[1]) || !state.tracking {
+        return;
+    }
+    for path in 0..2u8 {
+        let p = (path as u32) << 13;
+        let current = hal.phy_r32_mask(R_TSSI_THER + p, B_TSSI_THER);
+        let base = state.base_thermal[path as usize];
+        if current == 0 || base == 0 {
+            continue;
+        }
+        let delta = current as i32 - base as i32;
+        let offset = ((delta as i8 as i32) * 15 / 10) as i8;
+        state.extra_ofst[path as usize] = offset;
+        let int = ((offset as i32) >> 3).clamp(-16, 15);
+        let float = (offset as i32 & 7) as usize;
+        hal.phy_w32_mask(R_DPD_OFT_EN + p, B_DPD_OFT_EN, 1);
+        hal.phy_w32_mask(R_TXGAIN_SCALE + p, B_TXGAIN_SCALE_EN, 1);
+        hal.phy_w32_mask(R_DPD_OFT_ADDR + p, B_DPD_OFT_ADDR, int as u32);
+        hal.phy_w32_mask(R_TXGAIN_SCALE + p, B_TXGAIN_SCALE_OFT, TX_GAIN_SCALE[float]);
+    }
+}
+
+// ---- The state, the entry points. ----
+
+/// What the RTL8852A's calibrations keep.
+#[derive(Default)]
+pub(crate) struct State {
+    pub(crate) tssi_mode: [bool; 2],
+    thermal: Thermal,
+    iqk: IqkInfo,
+    dpk: [DpkPath; 2],
+    /// The TSSI's thermal values when it started, its tracking and the
+    /// offsets it found (`base_thermal`, `tssi_tracking_check`,
+    /// `extra_ofst`).
+    base_thermal: [u32; 2],
+    tracking: bool,
+    extra_ofst: [i8; 2],
+}
+
+/// `rtw8852a_rfk_init`'s state: the TSSI off.
+pub(crate) fn init(state: &mut State) {
+    state.tssi_mode = [false; 2];
+}
+
+/// `rtw8852a_rfk_channel` after the RX DC offset: IQK, TSSI, DPK.
+pub(crate) fn channel(hal: &Hal, state: &mut State, tssi_efuse: Option<&Tssi>, track: Option<&TxPowerTrack>, chan: &Chan) {
+    iqk(hal, &mut state.iqk, chan);
+    if let Some(efuse) = tssi_efuse {
+        tssi(hal, state, efuse, track, chan, false);
+    }
+    dpk(hal, state, chan);
+}
+
+/// `rtw8852a_tssi_scan` on a band change.
+pub(crate) fn tssi_scan(hal: &Hal, state: &mut State, tssi_efuse: &Tssi, track: Option<&TxPowerTrack>, chan: &Chan) {
+    tssi(hal, state, tssi_efuse, track, chan, true);
+}
+
+/// `rtw89_phy_stat_thermal_update` and `rtw8852a_rfk_track`: the DPD and
+/// the TSSI with the temperature.
+pub(crate) fn track(hal: &Hal, state: &mut State) {
+    state.thermal.update(hal, &state.tssi_mode);
+    dpk_track(hal, state);
+    tssi_track(hal, state);
+}
diff --git a/kernel/comps/rtw89/src/rtw8852b.rs b/kernel/comps/rtw89/src/rtw8852b.rs
new file mode 100644
index 0000000..fedc527
--- /dev/null
+++ b/kernel/comps/rtw89/src/rtw8852b.rs
@@ -0,0 +1,625 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The RTL8852B and RTL8852BT's own parts, as Linux's `rtw8852b.c`,
+//! `rtw8852bt.c`, `rtw8852b_common.c` and their `_rfk.c` have them: the
+//! baseband's reset, the channel (MAC, baseband, the RF's synthesizer),
+//! both paths for RX and TX, the antenna shared with Bluetooth, and the
+//! calibrations at power on (RC, the DAC on the RTL8852B, the RX DC
+//! offset) and on each channel (the RX DC offset).
+
+use crate::{
+    chan::Chan,
+    hal::{ChipId, Hal, INV_RF_DATA, RFREG_MASK, field},
+    phy::{rfk, rfk_by},
+    regs::*,
+    rfk_tables::*,
+    rtw8852b_rfk, rtw8852bt_rfk,
+};
+
+const SCO_BARKER: [u32; 14] = [0x1cfea, 0x1d0e1, 0x1d1d7, 0x1d2cd, 0x1d3c3, 0x1d4b9, 0x1d5b0, 0x1d6a6, 0x1d79c, 0x1d892, 0x1d988, 0x1da7f, 0x1db75, 0x1ddc4];
+const SCO_CCK: [u32; 14] = [0x27de3, 0x27f35, 0x28088, 0x281da, 0x2832d, 0x2847f, 0x285d2, 0x28724, 0x28877, 0x289c9, 0x28b1c, 0x28c6e, 0x28dc1, 0x290ed];
+
+/// `rtw8852b_bb_reset` (and the RTL8852BT's).
+pub(crate) fn bb_reset(hal: &Hal) {
+    if hal.id() == ChipId::Rtl8852bt {
+        hal.phy_w32_mask(R_P0_TXPW_RSTB, B_P0_TXPW_RSTB_MANON | B_P0_TXPW_RSTB_TSSI, 1);
+        hal.phy_set(R_P0_TSSI_TRK, B_P0_TSSI_TRK_EN);
+        hal.phy_w32_mask(R_P1_TXPW_RSTB, B_P1_TXPW_RSTB_MANON | B_P1_TXPW_RSTB_TSSI, 1);
+        hal.phy_set(R_P1_TSSI_TRK, B_P1_TSSI_TRK_EN);
+        bb_reset_all(hal);
+        hal.phy_w32_mask(R_P0_TXPW_RSTB, B_P0_TXPW_RSTB_MANON | B_P0_TXPW_RSTB_TSSI, 3);
+        hal.phy_clr(R_P0_TSSI_TRK, B_P0_TSSI_TRK_EN);
+        hal.phy_w32_mask(R_P1_TXPW_RSTB, B_P1_TXPW_RSTB_MANON | B_P1_TXPW_RSTB_TSSI, 3);
+        hal.phy_clr(R_P1_TSSI_TRK, B_P1_TSSI_TRK_EN);
+        return;
+    }
+    hal.phy_set(R_P0_TXPW_RSTB, B_P0_TXPW_RSTB_MANON);
+    hal.phy_set(R_P0_TSSI_TRK, B_P0_TSSI_TRK_EN);
+    hal.phy_set(R_P1_TXPW_RSTB, B_P1_TXPW_RSTB_MANON);
+    hal.phy_set(R_P1_TSSI_TRK, B_P1_TSSI_TRK_EN);
+    bb_reset_all(hal);
+    hal.phy_clr(R_P0_TXPW_RSTB, B_P0_TXPW_RSTB_MANON);
+    hal.phy_clr(R_P0_TSSI_TRK, B_P0_TSSI_TRK_EN);
+    hal.phy_clr(R_P1_TXPW_RSTB, B_P1_TXPW_RSTB_MANON);
+    hal.phy_clr(R_P1_TSSI_TRK, B_P1_TSSI_TRK_EN);
+}
+
+/// `__rtw8852bx_bb_reset_all`.
+fn bb_reset_all(hal: &Hal) {
+    hal.phy_w32_idx(R_S0_HW_SI_DIS, B_S0_HW_SI_DIS_W_R_TRIG, 0x7);
+    hal.phy_w32_idx(R_S1_HW_SI_DIS, B_S1_HW_SI_DIS_W_R_TRIG, 0x7);
+    crate::delay_us(1);
+    hal.phy_w32_idx(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 1);
+    hal.phy_w32_idx(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 0);
+    hal.phy_w32_idx(R_S0_HW_SI_DIS, B_S0_HW_SI_DIS_W_R_TRIG, 0);
+    hal.phy_w32_idx(R_S1_HW_SI_DIS, B_S1_HW_SI_DIS_W_R_TRIG, 0);
+    hal.phy_w32_idx(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 1);
+}
+
+fn bb_reset_en(hal: &Hal, band_2g: bool, enable: bool) {
+    if enable {
+        hal.phy_w32_idx(R_S0_HW_SI_DIS, B_S0_HW_SI_DIS_W_R_TRIG, 0);
+        hal.phy_w32_idx(R_S1_HW_SI_DIS, B_S1_HW_SI_DIS_W_R_TRIG, 0);
+        hal.phy_w32_idx(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 1);
+        if band_2g {
+            hal.phy_w32_mask(R_RXCCA, B_RXCCA_DIS, 0);
+        }
+        hal.phy_w32_mask(R_PD_CTRL, B_PD_HIT_DIS, 0);
+    } else {
+        hal.phy_w32_mask(R_RXCCA, B_RXCCA_DIS, 1);
+        hal.phy_w32_mask(R_PD_CTRL, B_PD_HIT_DIS, 1);
+        hal.phy_w32_idx(R_S0_HW_SI_DIS, B_S0_HW_SI_DIS_W_R_TRIG, 0x7);
+        hal.phy_w32_idx(R_S1_HW_SI_DIS, B_S1_HW_SI_DIS_W_R_TRIG, 0x7);
+        crate::delay_us(1);
+        hal.phy_w32_idx(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 0);
+    }
+}
+
+fn tssi_cont(hal: &Hal, enable: bool) {
+    for (rst, trk) in [(R_P0_TXPW_RSTB, R_P0_TSSI_TRK), (R_P1_TXPW_RSTB, R_P1_TSSI_TRK)] {
+        hal.phy_w32_mask(rst, B_P0_TXPW_RSTB_MANON, !enable as u32);
+        hal.phy_w32_mask(trk, B_P0_TSSI_TRK_EN, !enable as u32);
+    }
+}
+
+/// `rtw8852b_set_channel_help`: TX stopped, PPDU reports and the ADC off,
+/// the baseband held, around a change of channel.
+pub(crate) fn channel_help(hal: &Hal, enter: bool, band_2g: bool) {
+    if enter {
+        crate::sta::stop_sch_tx(hal, true);
+        hal.clr32(R_AX_PPDU_STAT, B_AX_PPDU_STAT_RPT_EN);
+        tssi_cont(hal, false);
+        hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RST, 0xf);
+        crate::delay_us(40);
+        bb_reset_en(hal, band_2g, false);
+    } else {
+        crate::sta::ppdu_status(hal, true);
+        hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RST, 0);
+        tssi_cont(hal, true);
+        bb_reset_en(hal, band_2g, true);
+        crate::sta::stop_sch_tx(hal, false);
+    }
+}
+
+/// `__rtw8852bx_set_channel_mac`: the width the MAC sends at and the
+/// band's CCK checks.
+pub(crate) fn set_channel_mac(hal: &Hal, chan: &Chan) {
+    let txsc20 = chan.txsc(0);
+    let txsc40 = chan.txsc(1);
+    match chan.bw {
+        2 => {
+            hal.w8_mask(R_AX_WMAC_RFMOD, B_AX_WMAC_RFMOD_MASK, 1 << 1);
+            hal.w32(R_AX_TX_SUB_CARRIER_VALUE, txsc20 | (txsc40 << 4));
+        }
+        1 => {
+            hal.w8_mask(R_AX_WMAC_RFMOD, B_AX_WMAC_RFMOD_MASK, 1 << 0);
+            hal.w32(R_AX_TX_SUB_CARRIER_VALUE, txsc20);
+        }
+        _ => {
+            hal.clr8(R_AX_WMAC_RFMOD, B_AX_WMAC_RFMOD_MASK);
+            hal.w32(R_AX_TX_SUB_CARRIER_VALUE, 0);
+        }
+    }
+    if chan.channel > 14 {
+        hal.clr8(R_AX_TXRATE_CHK, B_AX_BAND_MODE);
+        hal.set8(R_AX_TXRATE_CHK, B_AX_CHECK_CCK_EN | B_AX_RTS_LIMIT_IN_OFDM6);
+    } else {
+        hal.set8(R_AX_TXRATE_CHK, B_AX_BAND_MODE);
+        hal.clr8(R_AX_TXRATE_CHK, B_AX_CHECK_CCK_EN | B_AX_RTS_LIMIT_IN_OFDM6);
+    }
+}
+
+fn sco_mapping(central: u8) -> u32 {
+    match central {
+        1 => 109,
+        2..=6 => 108,
+        7..=10 => 107,
+        11..=14 => 106,
+        36 | 38 => 51,
+        40..=58 => 50,
+        60..=64 => 49,
+        100 | 102 => 48,
+        104..=126 => 47,
+        128..=151 => 46,
+        153..=177 => 45,
+        _ => 0,
+    }
+}
+
+/// `__rtw8852bx_set_channel_bb`.
+pub(crate) fn set_channel_bb(hal: &Hal, chan: &Chan) {
+    let id = hal.id();
+    let cck = chan.channel <= 14;
+    if cck {
+        let element = (chan.primary as usize).saturating_sub(1).min(13);
+        hal.phy_w32_mask(R_RXSCOBC, B_RXSCOBC_TH, SCO_BARKER[element]);
+        hal.phy_w32_mask(R_RXSCOCCK, B_RXSCOCCK_TH, SCO_CCK[element]);
+    }
+    // `rtw8852bx_ctrl_ch`.
+    hal.phy_w32_idx(R_PATH0_BAND_SEL_V1, B_PATH0_BAND_SEL_MSK_V1, cck as u32);
+    hal.phy_w32_idx(R_PATH1_BAND_SEL_V1, B_PATH1_BAND_SEL_MSK_V1, cck as u32);
+    hal.phy_w32_idx(R_FC0_BW_V1, B_FC0_BW_INV, sco_mapping(chan.channel));
+    let fir: [u32; 8] = if chan.channel == 14 {
+        [0x3b13ff, 0x1c42de, 0xfdb0ad, 0xf60f6e, 0xfd8f92, 0x2d011, 0x1c02c, 0xfff00a]
+    } else {
+        [0x3d23ff, 0x29b354, 0xfc1c8, 0xfdb053, 0xf86f9a, 0xfaef92, 0xfe5fcc, 0xffdff5]
+    };
+    let regs = [(R_TXFIR0, B_TXFIR_C01), (R_TXFIR2, B_TXFIR_C23), (R_TXFIR4, B_TXFIR_C45), (R_TXFIR6, B_TXFIR_C67), (R_TXFIR8, B_TXFIR_C89), (R_TXFIRA, B_TXFIR_CAB), (R_TXFIRC, B_TXFIR_CCD), (R_TXFIRE, B_TXFIR_CEF)];
+    for ((reg, mask), value) in regs.iter().zip(fir) {
+        hal.phy_w32_mask(*reg, *mask, value);
+    }
+    // `rtw8852bx_ctrl_bw`.
+    let rx_path_0 = hal.phy_r32_mask(R_CHBW_MOD_V1, B_ANT_RX_SEG0);
+    let (bw_set, prich) = match chan.bw {
+        1 => (1, chan.pri_ch_idx as u32),
+        2 => (2, chan.pri_ch_idx as u32),
+        _ => (0, 0),
+    };
+    hal.phy_w32_idx(R_FC0_BW_V1, B_FC0_BW_SET, bw_set);
+    hal.phy_w32_idx(R_CHBW_MOD_V1, B_CHBW_MOD_SBW, 0);
+    hal.phy_w32_idx(R_CHBW_MOD_V1, B_CHBW_MOD_PRICH, prich);
+    hal.phy_w32_idx(R_P0_RFMODE_ORI_RX, B_P0_RFMODE_ORI_RX_ALL, 0x333);
+    hal.phy_w32_idx(R_P1_RFMODE_ORI_RX, B_P1_RFMODE_ORI_RX_ALL, 0x333);
+    if chan.bw == 0 && id == ChipId::Rtl8852bt {
+        hal.phy_w32_idx(R_PATH0_BAND_SEL_V1, B_PATH0_BAND_NRBW_EN_V1, 1);
+        hal.phy_w32_idx(R_PATH1_BAND_SEL_V1, B_PATH1_BAND_NRBW_EN_V1, 1);
+    }
+    if chan.bw == 1 {
+        hal.phy_w32_mask(R_RXSC, B_RXSC_EN, (chan.pri_ch_idx == RTW89_SC_20_UPPER as u8) as u32);
+    }
+    for path in 0..2u32 {
+        if id == ChipId::Rtl8852b {
+            // `rtw8852b_bw_setting`: the ADC at 20, 40 and 80 MHz alike.
+            hal.phy_w32_mask(0xc0ec + path * 0x100, 0x6000, 0);
+            hal.phy_w32_mask(0xc0e4 + path * 0x100, 0x30, 2);
+        } else {
+            adc_cfg_8852bt(hal, chan.bw, path);
+        }
+    }
+    if rx_path_0 == 1 {
+        hal.phy_w32_idx(R_P1_RFMODE_ORI_RX, B_P1_RFMODE_ORI_RX_ALL, 0x111);
+    } else if rx_path_0 == 2 {
+        hal.phy_w32_idx(R_P0_RFMODE_ORI_RX, B_P0_RFMODE_ORI_RX_ALL, 0x111);
+    }
+    // `rtw8852bx_ctrl_cck_en`.
+    hal.phy_w32_mask(R_UPD_CLK_ADC, B_ENABLE_CCK, cck as u32);
+    hal.phy_w32_mask(R_RXCCA, B_RXCCA_DIS, !cck as u32);
+    if id == ChipId::Rtl8852bt {
+        hal.phy_w32_idx(R_SEG0CSI_EN_V1, B_SEG0CSI_EN, 0);
+    }
+    if id == ChipId::Rtl8852b && !cck {
+        hal.phy_w32_mask(R_PATH0_BT_SHARE_V1, B_PATH0_BT_SHARE_V1, 0);
+        hal.phy_w32_mask(R_PATH0_BTG_PATH_V1, B_PATH0_BTG_PATH_V1, 0);
+        hal.phy_w32_mask(R_PATH1_BT_SHARE_V1, B_PATH1_BT_SHARE_V1, 0);
+        hal.phy_w32_mask(R_PATH1_BTG_PATH_V1, B_PATH1_BTG_PATH_V1, 0);
+        hal.phy_w32_mask(R_CHBW_MOD_V1, B_BT_SHARE, 0);
+        hal.phy_w32_mask(R_FC0_BW_V1, B_ANT_RX_BT_SEG0, 0);
+        hal.phy_w32_mask(R_BT_DYN_DC_EST_EN_V1, B_BT_DYN_DC_EST_EN_MSK, 0);
+        hal.phy_w32_mask(R_GNT_BT_WGT_EN, B_GNT_BT_WGT_EN, 0);
+    }
+    hal.phy_w32_mask(R_MAC_PIN_SEL, B_CH_IDX_SEG0, chan.encoded_index() as u32);
+    mask_5m(hal, chan);
+    bb_reset_all(hal);
+}
+
+pub(crate) fn adc_cfg_8852bt(hal: &Hal, bw: u8, path: u32) {
+    let at = |base: u32| base + path * 0x100;
+    hal.phy_w32_mask(at(0xc0d4), B_P0_CFCH_CTL, 0x8);
+    hal.phy_w32_mask(at(0xc0e8), B_ADCMOD_LP, 0x9);
+    hal.phy_w32_mask(at(0xc0e4), B_WDADC_SEL, 0x2);
+    hal.phy_w32_mask(0x12a0 + path * 0x2000, B_P0_RXCK_ADJ, 0x49);
+    hal.phy_w32_mask(at(0xc0ec), B_DCIM_FR, 0);
+    if bw == 2 {
+        hal.phy_w32_mask(at(0xc0d4), B_P0_CFCH_EN, 0x2);
+        hal.phy_w32_mask(at(0xc0d4), B_P0_CFCH_BW0, 0x2);
+        hal.phy_w32_mask(at(0xc0d8), B_P0_CFCH_BW1, 0x8);
+        hal.phy_w32_mask(at(0xc0c4), B_DRCK_MUL, 0);
+        hal.phy_w32_mask(at(0xc0ec), B_DCIM_RC, 0x3);
+        hal.phy_w32_mask(0x704, B_RSTB_ASYNC_BW80, 1);
+    } else {
+        hal.phy_w32_mask(at(0xc0d4), B_P0_CFCH_EN, 0x2);
+        hal.phy_w32_mask(at(0xc0d4), B_P0_CFCH_BW0, 0x3);
+        hal.phy_w32_mask(at(0xc0d8), B_P0_CFCH_BW1, 0xf);
+        hal.phy_w32_mask(at(0xc0c4), B_DRCK_MUL, 0);
+        hal.phy_w32_mask(0x704, B_RSTB_ASYNC_BW80, 0);
+        hal.phy_w32_mask(at(0xc0ec), B_DCIM_RC, if hal.rfe_type >= 51 { 0x2 } else { 0x3 });
+    }
+}
+
+/// `rtw8852bx_5m_mask`.
+fn mask_5m(hal: &Hal, chan: &Chan) {
+    let pri = chan.pri_ch_idx as u32;
+    let (enable, low) = match chan.bw {
+        1 => (true, pri == RTW89_SC_20_LOWER),
+        2 => (pri == RTW89_SC_20_UPMOST || pri == RTW89_SC_20_LOWEST, pri == RTW89_SC_20_LOWEST),
+        _ => (false, false),
+    };
+    if !enable {
+        hal.phy_w32_mask(R_PATH0_5MDET_V1, B_PATH0_5MDET_EN, 0);
+        hal.phy_w32_mask(R_PATH1_5MDET_V1, B_PATH1_5MDET_EN, 0);
+        hal.phy_w32_idx(R_ASSIGN_SBD_OPT_V1, B_ASSIGN_SBD_OPT_EN_V1, 0);
+        return;
+    }
+    for (reg, th, en, sb2, sb0) in [
+        (R_PATH0_5MDET_V1, B_PATH0_5MDET_TH, B_PATH0_5MDET_EN, B_PATH0_5MDET_SB2, B_PATH0_5MDET_SB0),
+        (R_PATH1_5MDET_V1, B_PATH1_5MDET_TH, B_PATH1_5MDET_EN, B_PATH1_5MDET_SB2, B_PATH1_5MDET_SB0),
+    ] {
+        hal.phy_w32_mask(reg, th, 0x4);
+        hal.phy_w32_mask(reg, en, 1);
+        hal.phy_w32_mask(reg, sb2, !low as u32);
+        hal.phy_w32_mask(reg, sb0, low as u32);
+    }
+    hal.phy_w32_idx(R_ASSIGN_SBD_OPT_V1, B_ASSIGN_SBD_OPT_EN_V1, 1);
+}
+
+// ---- The RF's synthesizer. ----
+
+fn set_s0_arfc18(hal: &Hal, value: u32) -> bool {
+    let backup = hal.read_rf(0, RR_LDO, RFREG_MASK);
+    hal.write_rf(0, RR_LDO, RR_LDO_SEL, 1);
+    hal.write_rf(0, RR_CFGCH, RFREG_MASK, value);
+    let busy = aster_linuxkpi::delay::read_poll_timeout(|| hal.read_rf(0, RR_LPF, RR_LPF_BUSY), |value| *value == 0, 1, 1000).is_err();
+    hal.write_rf(0, RR_LDO, RFREG_MASK, backup);
+    busy
+}
+
+/// `_lck_check`: the synthesizer locked, retried if not.
+fn lck_check(hal: &Hal) {
+    let locked = || hal.read_rf(0, RR_SYNFB, RR_SYNFB_LK) != 0;
+    if !locked() {
+        hal.write_rf(0, RR_MMD, RR_MMD_RST_EN, 1);
+        hal.write_rf(0, RR_MMD, RR_MMD_RST_SYN, 0);
+        hal.write_rf(0, RR_MMD, RR_MMD_RST_SYN, 1);
+        hal.write_rf(0, RR_MMD, RR_MMD_RST_EN, 0);
+    }
+    crate::delay_us(10);
+    if !locked() {
+        hal.write_rf(0, RR_LCK_TRG, RR_LCK_TRGSEL, 1);
+        let value = hal.read_rf(0, RR_CFGCH, RFREG_MASK);
+        set_s0_arfc18(hal, value);
+        hal.write_rf(0, RR_LCK_TRG, RR_LCK_TRGSEL, 0);
+    }
+    if !locked() {
+        let pow = hal.read_rf(0, RR_POW, RFREG_MASK);
+        hal.write_rf(0, RR_POW, RFREG_MASK, pow);
+        let sx = hal.read_rf(0, RR_SX, RFREG_MASK);
+        hal.write_rf(0, RR_SX, RFREG_MASK, sx);
+        hal.write_rf(0, RR_SYNLUT, RR_SYNLUT_MOD, 1);
+        hal.write_rf(0, RR_POW, RR_POW_SYN, 0);
+        hal.write_rf(0, RR_POW, RR_POW_SYN, 3);
+        hal.write_rf(0, RR_SYNLUT, RR_SYNLUT_MOD, 0);
+        hal.write_rf(0, RR_LCK_TRG, RR_LCK_TRGSEL, 1);
+        let value = hal.read_rf(0, RR_CFGCH, RFREG_MASK);
+        set_s0_arfc18(hal, value);
+        hal.write_rf(0, RR_LCK_TRG, RR_LCK_TRGSEL, 0);
+    }
+}
+
+/// `rtw8852b_set_channel_rf`: channel then width on both copies of RF
+/// register 0x18 of each path, the RX baseband's filter.
+pub(crate) fn set_channel_rf(hal: &Hal, chan: &Chan) {
+    let two_g = chan.channel <= 14;
+    for dav in [true, false] {
+        for path in 0..2u8 {
+            let reg = if dav { RR_CFGCH } else { RR_CFGCH_V1 };
+            let mut value = hal.read_rf(path, reg, RFREG_MASK);
+            value &= !(RR_CFGCH_BAND1 | RR_CFGCH_POW_LCK | RR_CFGCH_TRX_AH | RR_CFGCH_BCN | RR_CFGCH_BAND0 | RR_CFGCH_CH);
+            value |= field(RR_CFGCH_CH, chan.channel as u32);
+            if !two_g {
+                value |= field(RR_CFGCH_BAND1, CFGCH_BAND1_5G) | field(RR_CFGCH_BAND0, CFGCH_BAND0_5G);
+            }
+            value = (value & !(RR_CFGCH_POW_LCK | RR_CFGCH_TRX_AH | RR_CFGCH_BCN | RR_CFGCH_BW2) & RFREG_MASK) | RR_CFGCH_BW2;
+            if path == 0 && dav {
+                if !set_s0_arfc18(hal, value) {
+                    lck_check(hal);
+                }
+            } else {
+                hal.write_rf(path, reg, RFREG_MASK, value);
+            }
+            hal.write_rf(path, RR_LCKST, RR_LCKST_BIN, 0);
+            hal.write_rf(path, RR_LCKST, RR_LCKST_BIN, 1);
+        }
+    }
+    for dav in [true, false] {
+        for path in 0..2u8 {
+            let reg = if dav { RR_CFGCH } else { RR_CFGCH_V1 };
+            let mut value = hal.read_rf(path, reg, RFREG_MASK);
+            if value == INV_RF_DATA {
+                continue;
+            }
+            value &= !RR_CFGCH_BW;
+            value |= field(RR_CFGCH_BW, match chan.bw {
+                1 => CFGCH_BW_40M,
+                2 => CFGCH_BW_80M,
+                _ => CFGCH_BW_20M,
+            });
+            value = (value & !(RR_CFGCH_POW_LCK | RR_CFGCH_TRX_AH | RR_CFGCH_BCN | RR_CFGCH_BW2) & RFREG_MASK) | RR_CFGCH_BW2;
+            hal.write_rf(path, reg, RFREG_MASK, value);
+        }
+    }
+    for path in 0..2u8 {
+        hal.write_rf(path, RR_LUTWE2, RR_LUTWE2_RTXBW, 1);
+        hal.write_rf(path, RR_LUTWA, RR_LUTWA_M2, 0x12);
+        hal.write_rf(path, RR_LUTWD0, RR_LUTWD0_LB, match chan.bw {
+            0 => 0x1b,
+            1 => 0x13,
+            2 => 0xb,
+            _ => 0x3,
+        });
+        hal.write_rf(path, RR_LUTWE2, RR_LUTWE2_RTXBW, 0);
+    }
+}
