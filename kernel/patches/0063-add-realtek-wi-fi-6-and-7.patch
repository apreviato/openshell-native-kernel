+    try_ce_fw: false,
+    scc: DleMem { ple_h2d: (0, 0), ..mem(WDE_SIZE0_V1, PLE_SIZE0_V1, WDE_QT0_V1, WDE_QT0_V1, PLE_QT0_BE, PLE_QT1_BE) },
+    dlfw: mem(WDE_SIZE3_V1, PLE_SIZE3_V1, WDE_QT4, WDE_QT4, PLE_QT9_BE, PLE_QT9_BE),
+    hfc: Hfc {
+        channels: [
+            (2, 1641, G0), (2, 1641, G0), (2, 1641, G0), (2, 1641, G0),
+            (2, 1641, G1), (2, 1641, G1), (2, 1641, G1), (2, 1641, G1),
+            (2, 1641, G0), (2, 1641, G0), (2, 1641, G1), (2, 1641, G1),
+        ],
+        public: (1651, 1651, 3302, 0),
+    },
+    rf_base: [0xe000, 0xf000],
+    rf_paths: 2,
+    physical_efuse: 0x1300,
+    logical_efuse: 0x70000,
+    dav_physical_efuse: 0,
+    dav_logical_efuse: 0,
+    txwd_body: 32,
+    h2c_desc: 24,
+    dma_ch_mask: 0,
+    v1: false,
+    be: true,
+    band_6: true,
+};
+
+/// The PHY's registers are past this in BAR 2 (`rtw89_phy_gen_ax.cr_base`,
+/// `rtw89_phy_gen_be`'s further on).
+const PHY_BASE: u32 = 0x10000;
+const PHY_BASE_BE: u32 = 0x20000;
+/// `RFREG_MASK`, `RTW89_RF_ADDR_ADSEL_MASK`, `INV_RF_DATA`.
+pub(crate) const RFREG_MASK: u32 = 0xfffff;
+/// `MASKBYTE0` to `MASKDWORD` (`core.h`).
+pub(crate) const MASKBYTE0: u32 = 0x0000_00ff;
+pub(crate) const MASKBYTE2: u32 = 0x00ff_0000;
+pub(crate) const MASKBYTE3: u32 = 0xff00_0000;
+pub(crate) const MASKHWORD: u32 = 0xffff_0000;
+pub(crate) const MASKLWORD: u32 = 0x0000_ffff;
+pub(crate) const MASKDWORD: u32 = 0xffff_ffff;
+const RF_ADDR_ADSEL: u32 = 1 << 16;
+pub(crate) const INV_RF_DATA: u32 = 0xffff_ffff;
+const XTAL_SI_NORMAL_WRITE: u32 = 0;
+const XTAL_SI_NORMAL_READ: u32 = 1;
+
+fn shift_of(mask: u32) -> u32 {
+    if mask == 0 { 0 } else { mask.trailing_zeros() }
+}
+
+pub(crate) struct Hal {
+    mmio: Mmio,
+    pub(crate) chip: &'static Chip,
+    /// The chip's cut (`hal.cv`) and its analog part's (`hal.acv`).
+    pub(crate) cv: u8,
+    pub(crate) acv: u8,
+    /// The BE chips' chip ID (`hal.aid`): firmware elements may be for it.
+    pub(crate) aid: u16,
+    pub(crate) rfe_type: u8,
+    pub(crate) xtal_cap: u8,
+    pub(crate) efuse_valid: bool,
+    /// The firmware wants its signature for this key (secure boot).
+    pub(crate) secure_boot: bool,
+    pub(crate) mss_idx: u8,
+    /// No 802.11be (`hal.no_eht`: the firmware's PHY capabilities name an
+    /// older protocol), no MCS 12 and 13 (`hal.no_mcs_12_13`: the VS
+    /// variant, or no 4096-QAM in them).
+    pub(crate) no_eht: bool,
+    pub(crate) no_mcs_12_13: bool,
+}
+
+impl Hal {
+    pub(crate) fn new(mmio: Mmio, chip: &'static Chip) -> Self {
+        Self { mmio, chip, cv: 0, acv: 0, aid: 0, rfe_type: 0, xtal_cap: 0, efuse_valid: false, secure_boot: false, mss_idx: 0, no_eht: false, no_mcs_12_13: false }
+    }
+
+    pub(crate) fn id(&self) -> ChipId {
+        self.chip.id
+    }
+
+    fn phy_base(&self) -> u32 {
+        if self.chip.be { PHY_BASE_BE } else { PHY_BASE }
+    }
+
+    /// The RTL8852B, RTL8852BT and RTL8851B (`rtw89_is_rtl885xb`).
+    pub(crate) fn is_885xb(&self) -> bool {
+        matches!(self.chip.id, ChipId::Rtl8852b | ChipId::Rtl8852bt | ChipId::Rtl8851b)
+    }
+
+    // ---- The MAC. ----
+
+    pub(crate) fn r8(&self, addr: u32) -> u8 {
+        self.mmio.ioread8(addr as usize)
+    }
+
+    pub(crate) fn r16(&self, addr: u32) -> u16 {
+        self.mmio.ioread16(addr as usize)
+    }
+
+    pub(crate) fn r32(&self, addr: u32) -> u32 {
+        self.mmio.ioread32(addr as usize)
+    }
+
+    pub(crate) fn w8(&self, addr: u32, value: u8) {
+        self.mmio.iowrite8(addr as usize, value);
+    }
+
+    pub(crate) fn w16(&self, addr: u32, value: u16) {
+        self.mmio.iowrite16(addr as usize, value);
+    }
+
+    pub(crate) fn w32(&self, addr: u32, value: u32) {
+        self.mmio.iowrite32(addr as usize, value);
+    }
+
+    pub(crate) fn r32_mask(&self, addr: u32, mask: u32) -> u32 {
+        (self.r32(addr) & mask) >> shift_of(mask)
+    }
+
+    pub(crate) fn w32_mask(&self, addr: u32, mask: u32, value: u32) {
+        let shift = shift_of(mask);
+        self.w32(addr, (self.r32(addr) & !mask) | ((value << shift) & mask));
+    }
+
+    pub(crate) fn w16_mask(&self, addr: u32, mask: u32, value: u32) {
+        let shift = shift_of(mask);
+        let old = self.r16(addr) as u32;
+        self.w16(addr, ((old & !mask) | ((value << shift) & mask)) as u16);
+    }
+
+    pub(crate) fn w8_mask(&self, addr: u32, mask: u32, value: u32) {
+        let shift = shift_of(mask);
+        let old = self.r8(addr) as u32;
+        self.w8(addr, ((old & !mask) | ((value << shift) & mask)) as u8);
+    }
+
+    pub(crate) fn set32(&self, addr: u32, bits: u32) {
+        self.w32(addr, self.r32(addr) | bits);
+    }
+
+    pub(crate) fn clr32(&self, addr: u32, bits: u32) {
+        self.w32(addr, self.r32(addr) & !bits);
+    }
+
+    pub(crate) fn set16(&self, addr: u32, bits: u32) {
+        self.w16(addr, self.r16(addr) | bits as u16);
+    }
+
+    pub(crate) fn clr16(&self, addr: u32, bits: u32) {
+        self.w16(addr, self.r16(addr) & !(bits as u16));
+    }
+
+    pub(crate) fn set8(&self, addr: u32, bits: u32) {
+        self.w8(addr, self.r8(addr) | bits as u8);
+    }
+
+    pub(crate) fn clr8(&self, addr: u32, bits: u32) {
+        self.w8(addr, self.r8(addr) & !(bits as u8));
+    }
+
+    /// Waits for `done` on the register every `delay` µs for `timeout`.
+    pub(crate) fn poll32(&self, addr: u32, done: impl Fn(u32) -> bool, delay: u64, timeout: u64) -> Result<u32, u32> {
+        read_poll_timeout(|| self.r32(addr), |value| done(*value), delay, timeout)
+    }
+
+    pub(crate) fn poll8(&self, addr: u32, done: impl Fn(u8) -> bool, delay: u64, timeout: u64) -> Result<u8, u8> {
+        read_poll_timeout(|| self.r8(addr), |value| done(*value), delay, timeout)
+    }
+
+    pub(crate) fn present(&self) -> bool {
+        let value = self.r32(R_AX_SYS_CFG1);
+        value != u32::MAX && value != 0xeaea_eaea && value != 0xdead_beef
+    }
+
+    // ---- The baseband. ----
+
+    pub(crate) fn phy_r32(&self, addr: u32) -> u32 {
+        self.r32(addr + self.phy_base())
+    }
+
+    pub(crate) fn phy_w32(&self, addr: u32, value: u32) {
+        self.w32(addr + self.phy_base(), value);
+    }
+
+    pub(crate) fn phy_r32_mask(&self, addr: u32, mask: u32) -> u32 {
+        self.r32_mask(addr + self.phy_base(), mask)
+    }
+
+    pub(crate) fn phy_w32_mask(&self, addr: u32, mask: u32, value: u32) {
+        self.w32_mask(addr + self.phy_base(), mask, value);
+    }
+
+    pub(crate) fn phy_set(&self, addr: u32, bits: u32) {
+        self.set32(addr + self.phy_base(), bits);
+    }
+
+    pub(crate) fn phy_clr(&self, addr: u32, bits: u32) {
+        self.clr32(addr + self.phy_base(), bits);
+    }
+
+    /// `rtw89_phy_write32_idx` on PHY 0 (no DBCC here).
+    pub(crate) fn phy_w32_idx(&self, addr: u32, mask: u32, value: u32) {
+        self.phy_w32_mask(addr, mask, value);
+    }
+
+    // ---- The RF. ----
+
+    fn rf_direct(&self, path: u8, addr: u32) -> u32 {
+        self.chip.rf_base[path as usize & 1] + ((addr & 0xff) << 2)
+    }
+
+    fn swsi_busy(&self) -> bool {
+        self.phy_r32_mask(R_SWSI_V1, B_SWSI_W_BUSY_V1) != 0 || self.phy_r32_mask(R_SWSI_V1, B_SWSI_R_BUSY_V1) != 0
+    }
+
+    /// `rtw89_read_rf`: the RTL8852A's directly; the others' directly when
+    /// the address says so, else through the serial interface.
+    pub(crate) fn read_rf(&self, path: u8, addr: u32, mask: u32) -> u32 {
+        if path >= self.chip.rf_paths {
+            return INV_RF_DATA;
+        }
+        if self.chip.be && addr & RF_ADDR_ADSEL == 0 {
+            let value = self.read_full_rf_v2(path, addr);
+            return if value == INV_RF_DATA { value } else { (value & mask) >> shift_of(mask) };
+        }
+        let mask = mask & RFREG_MASK;
+        if self.chip.id == ChipId::Rtl8852a || addr & RF_ADDR_ADSEL != 0 {
+            return self.phy_r32_mask(self.rf_direct(path, addr), mask);
+        }
+        if read_poll_timeout(|| self.swsi_busy(), |busy| !*busy, 1, 30).is_err() {
+            return INV_RF_DATA;
+        }
+        let value = ((path as u32) << shift_of(B_SWSI_READ_ADDR_PATH_V1)) & B_SWSI_READ_ADDR_PATH_V1
+            | ((addr << shift_of(B_SWSI_READ_ADDR_ADDR_V1)) & B_SWSI_READ_ADDR_ADDR_V1);
+        self.phy_w32_mask(R_SWSI_READ_ADDR_V1, B_SWSI_READ_ADDR_V1, value);
+        crate::delay_us(2);
+        if read_poll_timeout(|| self.phy_r32_mask(R_SWSI_V1, B_SWSI_R_DATA_DONE_V1), |done| *done != 0, 1, 30).is_err() {
+            return INV_RF_DATA;
+        }
+        self.phy_r32_mask(R_SWSI_V1, mask)
+    }
+
+    /// `rtw89_write_rf`.
+    pub(crate) fn write_rf(&self, path: u8, addr: u32, mask: u32, data: u32) {
+        if path >= self.chip.rf_paths {
+            return;
+        }
+        if self.chip.be && addr & RF_ADDR_ADSEL == 0 {
+            // `rtw89_phy_write_rf_a_v2`: a masked write reads the register
+            // first.
+            let value = if mask == RFREG_MASK {
+                data
+            } else {
+                let old = self.read_full_rf_v2(path, addr);
+                if old == INV_RF_DATA {
+                    return;
+                }
+                (old & !mask) | ((data << shift_of(mask)) & mask)
+            };
+            self.write_full_rf_v2(path, addr, value);
+            return;
+        }
+        let mask = mask & RFREG_MASK;
+        if self.chip.id == ChipId::Rtl8852a || addr & RF_ADDR_ADSEL != 0 {
+            self.phy_w32_mask(self.rf_direct(path, addr), mask, data);
+            crate::delay_us(1);
+            return;
+        }
+        if read_poll_timeout(|| self.swsi_busy(), |busy| !*busy, 1, 30).is_err() {
+            return;
+        }
+        let mut data = data & RFREG_MASK;
+        let masked = mask != RFREG_MASK;
+        if masked {
+            self.phy_w32_mask(R_SWSI_BIT_MASK_V1, RFREG_MASK, mask);
+            data = (data << shift_of(mask)) & RFREG_MASK;
+        }
+        let field = |mask: u32, value: u32| (value << shift_of(mask)) & mask;
+        let value = field(B_SWSI_DATA_BIT_MASK_EN_V1, masked as u32)
+            | field(B_SWSI_DATA_PATH_V1, path as u32)
+            | field(B_SWSI_DATA_ADDR_V1, addr)
+            | field(B_SWSI_DATA_VAL_V1, data);
+        self.phy_w32_mask(R_SWSI_DATA_V1, 0xffff_ffff, value);
+    }
+
+    /// `rtw89_phy_read_full_rf_v2_a`: the BE chips' hardware serial
+    /// interface (HWSI) of a path.
+    fn read_full_rf_v2(&self, path: u8, addr: u32) -> u32 {
+        let (value_reg, addr_reg) = if path == 0 { (0x2c24, 0x2adc) } else { (0x2d24, 0x2bdc) };
+        self.phy_w32_mask(addr_reg, B_HWSI_ADD_CTL_MASK, 1);
+        if read_poll_timeout(|| self.phy_r32_mask(value_reg, B_HWSI_VAL_BUSY), |busy| *busy == 0, 1, 3800).is_err() {
+            return INV_RF_DATA;
+        }
+        self.phy_w32_mask(addr_reg, B_HWSI_ADD_MASK, addr);
+        self.phy_w32_mask(addr_reg, B_HWSI_ADD_RD, 1);
+        crate::delay_us(2);
+        let value = match read_poll_timeout(|| self.phy_r32_mask(value_reg, B_HWSI_VAL_RDONE), |done| *done != 0, 1, 3800) {
+            Ok(_) => self.phy_r32_mask(value_reg, RFREG_MASK),
+            Err(_) => INV_RF_DATA,
+        };
+        self.phy_w32_mask(addr_reg, B_HWSI_ADD_POLL_MASK, 0);
+        value
+    }
+
+    /// `rtw89_phy_write_full_rf_v2_a`.
+    fn write_full_rf_v2(&self, path: u8, addr: u32, data: u32) {
+        let (idle_reg, data_reg) = if path == 0 { (0x2c24, 0x2ae0) } else { (0x2d24, 0x2be0) };
+        if read_poll_timeout(|| self.phy_r32_mask(idle_reg, 1 << 29), |busy| *busy == 0, 1, 3800).is_err() {
+            return;
+        }
+        let field = |mask: u32, value: u32| (value << shift_of(mask)) & mask;
+        self.phy_w32(data_reg, field(B_HWSI_DATA_ADDR, addr) | field(B_HWSI_DATA_VAL, data));
+    }
+
+    // ---- The crystal's serial interface. ----
+
+    pub(crate) fn write_xtal_si(&self, offset: u8, value: u8, mask: u8) -> Result<(), ()> {
+        let field = |mask: u32, value: u32| (value << shift_of(mask)) & mask;
+        let command = field(B_AX_WL_XTAL_SI_ADDR_MASK, offset as u32)
+            | field(B_AX_WL_XTAL_SI_DATA_MASK, value as u32)
+            | field(B_AX_WL_XTAL_SI_BITMASK_MASK, mask as u32)
+            | field(B_AX_WL_XTAL_SI_MODE_MASK, XTAL_SI_NORMAL_WRITE)
+            | B_AX_WL_XTAL_SI_CMD_POLL;
+        self.w32(R_AX_WLAN_XTAL_SI_CTRL, command);
+        self.poll32(R_AX_WLAN_XTAL_SI_CTRL, |value| value & B_AX_WL_XTAL_SI_CMD_POLL == 0, 50, 50_000).map(|_| ()).map_err(|_| ())
+    }
+
+    pub(crate) fn read_xtal_si(&self, offset: u8) -> Result<u8, ()> {
+        let field = |mask: u32, value: u32| (value << shift_of(mask)) & mask;
+        let command = field(B_AX_WL_XTAL_SI_ADDR_MASK, offset as u32) | field(B_AX_WL_XTAL_SI_MODE_MASK, XTAL_SI_NORMAL_READ) | B_AX_WL_XTAL_SI_CMD_POLL;
+        self.w32(R_AX_WLAN_XTAL_SI_CTRL, command);
+        let value = self.poll32(R_AX_WLAN_XTAL_SI_CTRL, |value| value & B_AX_WL_XTAL_SI_CMD_POLL == 0, 50, 50_000).map_err(|_| ())?;
+        Ok(((value & B_AX_WL_XTAL_SI_DATA_MASK) >> shift_of(B_AX_WL_XTAL_SI_DATA_MASK)) as u8)
+    }
+
+    /// `rtw89_read_chip_ver`.
+    pub(crate) fn read_chip_version(&mut self) {
+        let mut cv = self.r32_mask(R_AX_SYS_CFG1, B_AX_CHIP_VER_MASK) as u8;
+        if self.chip.id == ChipId::Rtl8852a && cv <= CHIP_CBV as u8 {
+            cv = if self.r32(R_AX_GPIO0_7_FUNC_SEL) == 0xdead_beef { CHIP_CAV as u8 } else { CHIP_CBV as u8 };
+        }
+        self.cv = cv;
+        if (self.is_885xb() || self.chip.be)
+            && let Ok(value) = self.read_xtal_si(XTAL_SI_CV as u8)
+        {
+            self.acv = get(XTAL_SI_ACV_MASK, value as u32) as u8;
+        }
+        if self.chip.be
+            && let (Ok(low), Ok(high)) = (self.read_xtal_si(XTAL_SI_CHIP_ID_L as u8), self.read_xtal_si(XTAL_SI_CHIP_ID_H as u8))
+        {
+            self.aid = low as u16 | (high as u16) << 8;
+        }
+    }
+}
+
+/// `FIELD_PREP`.
+pub(crate) fn field(mask: u32, value: u32) -> u32 {
+    (value << shift_of(mask)) & mask
+}
+
+/// `FIELD_GET`.
+pub(crate) fn get(mask: u32, value: u32) -> u32 {
+    (value & mask) >> shift_of(mask)
+}
