@@ -0,0 +1,325 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Realtek's 802.11ax and 802.11be Wi-Fi on PCIe, as Linux's rtw89 runs
+//! it: the RTL8852AE (10ec:8852, 10ec:a85a), RTL8852BE (10ec:b852,
+//! 10ec:b85b), RTL8852BTE (10ec:b520), RTL8851BE (10ec:b851, one path),
+//! RTL8852CE (10ec:c852) and the 802.11be RTL8922AE (10ec:8922, its VS
+//! variant 10ec:892b): another MAC ([`be`]), PCIe and descriptor
+//! generation, H2C commands of their own, the firmware's calibrations
+//! ([`rtw8922a`]).
+//!
+//! The chip ([`hal`], [`pci`]) is brought up as Linux's `rtw89_core_start`
+//! does: power ([`mac`]), the eFuse, the firmware ([`fw`]: linux-firmware's
+//! `rtw89/rtw8852b_fw-2.bin` and the others, signed for the chip's key on
+//! secure-boot boards) through the H2C ring, the MAC's blocks, the PHY's
+//! tables from the firmware's elements ([`phy`]), each chip's channel and
+//! calibrations ([`rtw8852b`], [`rtw88xx`]), the antenna shared with
+//! Bluetooth ([`coex`]). The station on it is [`sta`]: a software scan, the
+//! interface and the access point in the firmware's tables, its rate
+//! adaptation, keys in the security CAM.
+//!
+//! The 802.11ax chips are calibrated on the host as Linux's `rtw8852*_rfk.c`
+//! and `rtw8851b_rfk.c` do it ([`rtw8852a_rfk`], [`rtw8852b_rfk`],
+//! [`rtw8852bt_rfk`], [`rtw8852c_rfk`], [`rtw8851b_rfk`]): the DAC and ADC
+//! at power on, then per channel the RX DC offset, the IQ imbalance, the
+//! digital predistortion and the TX power's closed loop (TSSI), with their
+//! thermal tracking (`rtw89.nocal`: none per channel). The RTL8922AE's
+//! firmware calibrates, its TSSI too. The RTL8852CE runs 6 GHz, the
+//! RTL8922AE 6 GHz and EHT; block-ack sessions and power save on all.
+//! Not yet: the TSSI's alignment measured with the baseband's own packets
+//! (the tables' defaults stand in), the RTL8922AE's second band.
+//! `dmesg | grep rtw89` says how far a card gets; `rtw89.off` leaves the
+//! cards alone.
+
+#![no_std]
+#![deny(unsafe_code)]
+
+extern crate alloc;
+
+macro_rules! __log_prefix {
+    () => {
+        "rtw89: "
+    };
+}
+
+mod be;
+mod chan;
+mod coex;
+mod fw;
+mod hal;
+mod mac;
+mod pci;
+mod phy;
+#[allow(clippy::all)]
+mod regs;
+mod rfk_tables;
+mod rtw8852b;
+mod rtw8852b_rfk;
+mod rtw8852bt_rfk;
+mod rtw8851b_rfk;
+mod rtw8852a_rfk;
+mod rtw8852c_rfk;
+mod rtw88xx;
+mod rtw8922a;
+mod sta;
+
+use alloc::{sync::Arc, vec::Vec};
+use core::sync::atomic::{AtomicBool, Ordering};
+
+pub(crate) use aster_linuxkpi::delay::{mdelay as delay_ms, now_ms, udelay as delay_us};
+use aster_linuxkpi::{
+    io::Mmio,
+    pci::{self as kpi_pci, Devices},
+    wait::Waker,
+};
+use aster_pci::common_device::PciCommonDevice;
+use aster_wlan::{
+    ieee80211::Address,
+    radio::{self, ApConfig, Association, BeaconTemplate, BlockAck, Join, Key, LinkStats, Radio, Reorder, ScanRequest, StationEntry},
+};
+use component::{ComponentInitError, init_component};
+use ostd::sync::Mutex;
+
+use crate::{
+    fw::Firmware,
+    hal::{Chip, Hal},
+    pci::Pci,
+    sta::Rtw89,
+};
+
+/// The cards' tasks sleep here: woken by their interrupt, and by the timer
+/// every 5 ms (scans step on time).
+static WAKER: Waker = Waker::new(5);
+static DEVICES: Devices = Devices::new();
+
+const VENDOR_REALTEK: u16 = 0x10ec;
+
+/// The RTL8922AE's VS variant's device ID.
+const RTL8922AE_VS: u16 = 0x892b;
+
+/// Linux's `rtw89_885*e_id_table`s.
+fn chip_of(vendor: u16, device: u16) -> Option<&'static Chip> {
+    if vendor != VENDOR_REALTEK {
+        return None;
+    }
+    match device {
+        0x8852 | 0xa85a => Some(&hal::RTL8852A),
+        0xb852 | 0xb85b => Some(&hal::RTL8852B),
+        0xb520 => Some(&hal::RTL8852BT),
+        0xb851 => Some(&hal::RTL8851B),
+        0xc852 => Some(&hal::RTL8852C),
+        0x8922 | RTL8922AE_VS => Some(&hal::RTL8922A),
+        _ => None,
+    }
+}
+
+fn claims(vendor: u16, device: u16) -> bool {
+    chip_of(vendor, device).is_some()
+}
+
+static DISABLED: AtomicBool = AtomicBool::new(false);
+aster_cmdline::define_flag_param!("rtw89.off", DISABLED);
+/// `rtw89.nocal`: no calibration of the channel on the host (the AX chips'
+/// IQK, DPK and TSSI), should a board not take them.
+pub(crate) static NO_HOST_CAL: AtomicBool = AtomicBool::new(false);
+aster_cmdline::define_flag_param!("rtw89.nocal", NO_HOST_CAL);
+
+#[init_component]
+fn init() -> Result<(), ComponentInitError> {
+    if !DISABLED.load(Ordering::Relaxed) && DEVICES.register(claims) {
+        WAKER.start_timer();
+    }
+    Ok(())
+}
+
+#[init_component(kthread)]
+fn start() -> Result<(), ComponentInitError> {
+    DEVICES.spawn(run);
+    Ok(())
+}
+
+struct Card {
+    state: Mutex<Rtw89>,
+}
+
+struct RealtekRadio {
+    card: Arc<Card>,
+}
+
+impl Radio for RealtekRadio {
+    fn start(&self) -> radio::Result<()> {
+        if self.card.state.lock().dead { Err(radio::Error::Down) } else { Ok(()) }
+    }
+
+    fn stop(&self) {
+        let mut state = self.card.state.lock();
+        state.abort_scan();
+        state.stop_ap();
+        state.leave();
+    }
+
+    fn scan(&self, request: &ScanRequest) -> radio::Result<()> {
+        self.card.state.lock().scan(request)
+    }
+
+    fn abort_scan(&self) {
+        self.card.state.lock().abort_scan();
+        WAKER.wake();
+    }
+
+    fn join(&self, network: &Join) -> radio::Result<()> {
+        self.card.state.lock().join(network)
+    }
+
+    fn associated(&self, association: &Association) -> radio::Result<()> {
+        self.card.state.lock().associated(association)
+    }
+
+    fn leave(&self) {
+        self.card.state.lock().leave();
+    }
+
+    fn set_key(&self, key: &Key) -> radio::Result<()> {
+        self.card.state.lock().set_key(key, false)
+    }
+
+    fn remove_key(&self, index: u8, pairwise: bool) {
+        let key = Key { index, cipher: radio::CIPHER_CCMP, pairwise, address: None, key: Vec::new(), seq: Vec::new() };
+        let _ = self.card.state.lock().set_key(&key, true);
+    }
+
+    fn authorize(&self, _authorized: bool) {}
+
+    fn send_management(&self, frame: &[u8]) -> radio::Result<()> {
+        self.card.state.lock().transmit(frame.to_vec())
+    }
+
+    fn send(&self, ethernet: &[u8], plain: bool) -> radio::Result<()> {
+        self.card.state.lock().send(ethernet, plain)
+    }
+
+    fn link_stats(&self) -> LinkStats {
+        LinkStats { signal: self.card.state.lock().signal, tx_rate: None }
+    }
+
+    fn start_ap(&self, config: &ApConfig) -> radio::Result<()> {
+        self.card.state.lock().start_ap(config)
+    }
+
+    fn set_beacon(&self, beacon: &BeaconTemplate) -> radio::Result<()> {
+        self.card.state.lock().set_beacon(beacon)
+    }
+
+    fn stop_ap(&self) {
+        self.card.state.lock().stop_ap();
+    }
+
+    fn add_station(&self, station: &StationEntry) -> radio::Result<()> {
+        self.card.state.lock().add_station(station)
+    }
+
+    fn remove_station(&self, address: &Address) {
+        self.card.state.lock().remove_station(address);
+    }
+
+    // The keys decide what the chip lets through (as `authorize`).
+    fn authorize_station(&self, _address: &Address, _authorized: bool) {}
+
+    fn set_power_save(&self, enabled: bool) -> radio::Result<()> {
+        self.card.state.lock().set_power_save(enabled)
+    }
+
+    fn rx_ba_start(&self, ba: &mut BlockAck) -> radio::Result<Reorder> {
+        self.card.state.lock().rx_ba_start(ba)
+    }
+
+    fn rx_ba_stop(&self, peer: &Address, tid: u8) {
+        self.card.state.lock().rx_ba_stop(peer, tid);
+    }
+
+    fn tx_ba_start(&self, peer: &Address, tid: u8) -> radio::Result<u16> {
+        self.card.state.lock().tx_ba_start(peer, tid)
+    }
+
+    fn tx_ba_operational(&self, ba: &BlockAck) -> radio::Result<()> {
+        self.card.state.lock().tx_ba_operational(ba)
+    }
+
+    fn tx_ba_stop(&self, peer: &Address, tid: u8) {
+        self.card.state.lock().tx_ba_stop(peer, tid);
+    }
+}
+
+/// A card's task: the chip up, the station registered, then what the chip
+/// says.
+fn run(index: usize, mut device: PciCommonDevice) {
+    let id = *device.device_id();
+    let Some(chip) = chip_of(id.vendor_id, id.device_id) else { return };
+    let location = *device.location();
+    let name = kpi_pci::device_name("rtw89", index, &location);
+    kpi_pci::enable_device(&location);
+    kpi_pci::disable_aspm(&location);
+    let vectors = kpi_pci::alloc_irq_vector(&mut device, false, &name, || WAKER.wake());
+    // Linux maps BAR 2.
+    let Some(bar) = kpi_pci::iomap(&mut device, 2) else {
+        ostd::warn!("{}: no registers in BAR 2", name);
+        return;
+    };
+    let mut hal = Hal::new(Mmio::new(bar), chip);
+    // The RTL8922AE's VS variant (`rtw8922ae_vs_variant`): no MCS 12 and 13.
+    hal.no_mcs_12_13 = id.device_id == RTL8922AE_VS;
+    if !hal.present() {
+        ostd::warn!("{}: the card does not answer", name);
+        return;
+    }
+    hal.read_chip_version();
+    if chip.be {
+        Pci::disable_eq_be(&hal);
+    }
+    ostd::notice!("{}: Realtek {} ({:04x}, cut {})", name, chip.name, id.device_id, hal.cv);
+    if let Err(error) = mac::power_on(&mut hal) {
+        ostd::warn!("{}: power on: {}", name, error);
+        return;
+    }
+    let (efuse, secure) = match mac::read_efuse(&mut hal) {
+        Ok(read) => read,
+        Err(error) => {
+            ostd::warn!("{}: eFuse: {}", name, error);
+            return;
+        }
+    };
+    let firmware = match Firmware::load(&hal).and_then(|fw| fw.check_elements(&hal).map(|()| fw)) {
+        Ok(firmware) => firmware,
+        Err(error) => {
+            ostd::warn!("{}: {}", name, error);
+            return;
+        }
+    };
+    let pci = match Pci::new(&hal) {
+        Ok(pci) => pci,
+        Err(error) => {
+            ostd::warn!("{}: {}", name, error);
+            return;
+        }
+    };
+    let mut state = Rtw89::new(hal, pci, firmware, secure, efuse);
+    if let Err(error) = state.bring_up() {
+        ostd::warn!("{}: {}", name, error);
+        mac::power_off(&state.hal);
+        return;
+    }
+    let info = state.info();
+    ostd::notice!("{}: ready, MAC {:02x?}, RFE type {}", name, state.address, state.hal.rfe_type);
+    let card = Arc::new(Card { state: Mutex::new(state) });
+    let wlan = aster_wlan::register(info, Arc::new(RealtekRadio { card: card.clone() }));
+    card.state.lock().device = Some(wlan);
+    loop {
+        WAKER.sleep();
+        let mut state = card.state.lock();
+        state.poll();
+        if state.dead {
+            break;
+        }
+    }
+    drop((vectors, device));
+}
