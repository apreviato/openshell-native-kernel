+// ---- What power save tells the firmware (`rtw89_enter_lps`). ----
+
+/// `rtw89_fw_h2c_rf_ps_info` (`struct rtw89_h2c_rf_ps_info`, 14 bytes):
+/// path A's RF 0x18 for the channel, the MLO mode, the primary channel.
+pub(crate) fn rf_ps_info(chan: &Chan) -> Vec<u8> {
+    let mut out = Vec::with_capacity(14);
+    out.extend_from_slice(&rf18(chan).to_le_bytes());
+    out.extend_from_slice(&0u32.to_le_bytes());
+    out.extend_from_slice(&MLO_2_PLUS_0_1RF.to_le_bytes());
+    out.extend_from_slice(&[chan.primary, 0]);
+    out
+}
+
+/// `rtw89_fw_h2c_lps_ch_info` (`struct rtw89_h2c_lps_ch_info`, 12 bytes):
+/// PHY 0's channel, the MLO mode.
+pub(crate) fn lps_ch_info(chan: &Chan) -> Vec<u8> {
+    let mut out = alloc::vec![chan.primary, chan.channel, chan.bw, chan.band, 0, 0, 0, 0];
+    out.extend_from_slice(&MLO_2_PLUS_0_1RF.to_le_bytes());
+    out
+}
+
+/// `rtw89_fw_h2c_lps_ml_cmn_info` (`struct rtw89_h2c_lps_ml_cmn_info`, 76
+/// bytes, format 3): PHY 0's channel and its beacons' rate type (CCK at
+/// 2.4 GHz), path A's 20/40 MHz receive gains for the beacons.
+pub(crate) fn lps_ml_cmn_info(g: &BbGain, chan: &Chan, rfe_type: u8) -> Vec<u8> {
+    let (band, bw, path) = (gain_band(chan), 0, 0);
+    let mut out = alloc::vec![3, rfe_type, 0, 0];
+    out.extend_from_slice(&MLO_2_PLUS_0_1RF.to_le_bytes());
+    out.extend_from_slice(&[chan.channel, 0, chan.primary, 0, chan.bw, 0, chan.band, 0]);
+    out.extend_from_slice(&[if chan.band == 0 { 1 } else { 2 }, 0, 0, 0]);
+    for phy in 0..2 {
+        for gain in g.tia[band][bw][path] {
+            let value = if phy == 0 { gain as i16 as u16 } else { 0 };
+            out.extend_from_slice(&value.to_le_bytes());
+        }
+    }
+    for phy in 0..2 {
+        out.extend(g.lna[band][bw][path].iter().map(|&gain| if phy == 0 { gain as u8 } else { 0 }));
+    }
+    out.extend_from_slice(&[0, 0]);
+    for phy in 0..2 {
+        out.extend(g.tia_lna_op1db[band][bw][path].iter().map(|&gain| if phy == 0 { gain as u8 } else { 0 }));
+    }
+    for phy in 0..2 {
+        out.extend(g.lna_op1db[band][bw][path].iter().map(|&gain| if phy == 0 { gain as u8 } else { 0 }));
+    }
+    out.extend_from_slice(&[0, 0]);
+    debug_assert_eq!(out.len(), 76);
+    out
+}
+
+/// The first of 6 GHz's gain bands (`RTW89_BB_GAIN_BAND_6G_L0_BE`).
+const GAIN_BAND_6G_FIRST: usize = RTW89_BB_GAIN_BAND_6G_L0_BE as usize;
+
+/// `rtw89_subband_to_gain_band_be` of the channel's subband.
+fn gain_band(chan: &Chan) -> usize {
+    match chan.band {
+        0 => 0,
+        1 => match chan.channel {
+            100..=144 => 2,
+            149..=177 => 3,
+            _ => 1,
+        },
+        _ => GAIN_BAND_6G_FIRST + (chan.channel.max(1) as usize - 1).min(255) / 32,
+    }
+    .min(GAIN_BANDS - 1)
+}
+
+/// The gains' registers (`bb_gain_lna`, `_tia`, `bb_op1db_lna`,
+/// `_tia_lna`): 2.4 GHz path A and B, 5 GHz path A and B, the masks.
+type GainReg = (u32, u32, u32, u32, u32, u32);
+const BB_GAIN_LNA: [GainReg; LNA_GAINS] = [
+    (0x409c, 0x449c, 0x406c, 0x446c, 0xff00, 0xff),
+    (0x409c, 0x449c, 0x406c, 0x446c, 0xff00_0000, 0xff_0000),
+    (0x40a0, 0x44a0, 0x4070, 0x4470, 0xff00, 0xff),
+    (0x40a0, 0x44a0, 0x4070, 0x4470, 0xff00_0000, 0xff_0000),
+    (0x40a4, 0x44a4, 0x4074, 0x4474, 0xff00, 0xff),
+    (0x40a4, 0x44a4, 0x4074, 0x4474, 0xff00_0000, 0xff_0000),
+    (0x40a8, 0x44a8, 0x4078, 0x4478, 0xff00, 0xff),
+];
+const BB_GAIN_TIA: [GainReg; TIA_GAINS] = [(0x4054, 0x4454, 0x4054, 0x4454, 0x7fc_0000, 0x1ff), (0x4058, 0x4458, 0x4054, 0x4454, 0x1ff, 0x3fe00)];
+const BB_OP1DB_LNA: [GainReg; LNA_GAINS] = [
+    (0x40ac, 0x44ac, 0x4078, 0x4478, 0xff00, 0xff00_0000),
+    (0x40ac, 0x44ac, 0x407c, 0x447c, 0xff_0000, 0xff),
+    (0x40ac, 0x44ac, 0x407c, 0x447c, 0xff00_0000, 0xff00),
+    (0x40b0, 0x44b0, 0x407c, 0x447c, 0xff, 0xff_0000),
+    (0x40b0, 0x44b0, 0x407c, 0x447c, 0xff00, 0xff00_0000),
+    (0x40b0, 0x44b0, 0x4080, 0x4480, 0xff_0000, 0xff),
+    (0x40b0, 0x44b0, 0x4080, 0x4480, 0xff00_0000, 0xff00),
+];
+const BB_OP1DB_TIA_LNA: [GainReg; TIA_LNA_OP1DB] = [
+    (0x40b4, 0x44b4, 0x4080, 0x4480, 0xff_0000, 0xff00_0000),
+    (0x40b4, 0x44b4, 0x4084, 0x4484, 0xff00_0000, 0xff),
+    (0x40b8, 0x44b8, 0x4084, 0x4484, 0xff, 0xff00),
+    (0x40b8, 0x44b8, 0x4084, 0x4484, 0xff00, 0xff_0000),
+    (0x40b8, 0x44b8, 0x4084, 0x4484, 0xff_0000, 0xff00_0000),
+    (0x40b8, 0x44b8, 0x4088, 0x4488, 0xff00_0000, 0xff),
+    (0x40bc, 0x44bc, 0x4088, 0x4488, 0xff, 0xff00),
+    (0x40bc, 0x44bc, 0x4088, 0x4488, 0xff00, 0xff_0000),
+];
+/// `rpl_comp_bw160`, `_bw80`, `_bw40`, `_bw20` (path B 0x400 on).
+const RPL_160: [(u32, u32); 8] = [(0x41e8, 0xff00), (0x41e8, 0xff_0000), (0x41e8, 0xff00_0000), (0x41ec, 0xff), (0x41ec, 0xff00), (0x41ec, 0xff_0000), (0x41ec, 0xff00_0000), (0x41f0, 0xff)];
+const RPL_80: [(u32, u32); 4] = [(0x41f4, 0xff), (0x41f4, 0xff00), (0x41f4, 0xff_0000), (0x41f4, 0xff00_0000)];
+const RPL_40: [(u32, u32); 2] = [(0x41f0, 0xff_0000), (0x41f0, 0xff00_0000)];
+const RPL_20: [(u32, u32); 1] = [(0x41f0, 0xff00)];
+
+/// `rtw8922a_set_gain` of a path: LNA, TIA and their 1 dB compression
+/// points, then the RPL offsets of each width.
+fn set_gain(hal: &Hal, g: &BbGain, chan: &Chan, path: usize) {
+    let band = gain_band(chan);
+    let bw = if chan.bw <= 1 { 0 } else { 1 };
+    let two_g = chan.band == 0;
+    let write = |regs: &[GainReg], values: &[i8]| {
+        for (&(g0, g1, a0, a1, g_mask, a_mask), &value) in regs.iter().zip(values) {
+            let (reg, mask) = match (two_g, path) {
+                (true, 0) => (g0, g_mask),
+                (true, _) => (g1, g_mask),
+                (false, 0) => (a0, a_mask),
+                (false, _) => (a1, a_mask),
+            };
+            hal.phy_w32_mask(reg, mask, value as i32 as u32);
+        }
+    };
+    write(&BB_GAIN_LNA, &g.lna[band][bw][path]);
+    write(&BB_GAIN_TIA, &g.tia[band][bw][path]);
+    write(&BB_OP1DB_LNA, &g.lna_op1db[band][bw][path]);
+    write(&BB_OP1DB_TIA_LNA, &g.tia_lna_op1db[band][bw][path]);
+    let path_ofst = if path == 1 { 0x400 } else { 0 };
+    let rpl = |regs: &[(u32, u32)], values: &[i8]| {
+        for (&(addr, mask), &value) in regs.iter().zip(values) {
+            hal.phy_w32_mask(addr | path_ofst, mask, value as i32 as u32);
+        }
+    };
+    rpl(&RPL_160, &g.rpl160[band][path]);
+    rpl(&RPL_80, &g.rpl80[band][path]);
+    rpl(&RPL_40, &g.rpl40[band][path]);
+    rpl(&RPL_20, &g.rpl20[band][path]);
+}
+
+// ---- The channel. ----
+
+/// `rtw89_phy_get_txsb`: where a narrower PPDU (`dbw`) goes in the
+/// channel.
+fn txsb(chan: &Chan, dbw: u8) -> u32 {
+    let (pri, center) = (chan.primary as i32, chan.channel as i32);
+    if chan.bw == dbw || chan.bw == 0 {
+        return 0;
+    }
+    let index = match (chan.bw, dbw) {
+        (2, 0) => (pri - center + 6) / 4,
+        (3, 0) => (pri - center + 14) / 4,
+        (3, 1) => (pri - center + 12) / 8,
+        _ => (pri > center) as i32,
+    };
+    index.max(0) as u32
+}
+
+/// `rtw89_get_primary_sb_idx`.
+fn pri_sb(chan: &Chan) -> u32 {
+    const OFST: [i32; 5] = [0, 2, 6, 14, 30];
+    let index = (OFST[chan.bw.min(4) as usize] + chan.primary as i32 - chan.channel as i32) / 4;
+    index.max(0) as u32
+}
+
+/// `rtw8922a_set_channel_mac`: the RF mode (width), the TX sub-bands and
+/// the primary 20 MHz, CCK allowed on 2.4 GHz only, the SIFS of the width.
+pub(crate) fn set_channel_mac(hal: &Hal, chan: &Chan) {
+    let (txsb20, txsb40, txsb80) = match chan.bw {
+        3 => (txsb(chan, 0), txsb(chan, 1), txsb(chan, 2)),
+        2 => (txsb(chan, 0), txsb(chan, 1), 0),
+        1 => (txsb(chan, 0), 0, 0),
+        _ => (0, 0, 0),
+    };
+    let (rf_mod, mut sb) = match chan.bw {
+        3 => (BE_WMAC_RFMOD_160M, field(B_BE_TXSB_20M_MASK, txsb20) | field(B_BE_TXSB_40M_MASK, txsb40) | field(B_BE_TXSB_80M_MASK, txsb80)),
+        2 => (BE_WMAC_RFMOD_80M, field(B_BE_TXSB_20M_MASK, txsb20) | field(B_BE_TXSB_40M_MASK, txsb40)),
+        1 => (BE_WMAC_RFMOD_40M, field(B_BE_TXSB_20M_MASK, txsb20)),
+        _ => (BE_WMAC_RFMOD_20M, 0),
+    };
+    if txsb20 <= BE_PRI20_BITMAP_MAX {
+        sb |= field(B_BE_PRI20_BITMAP_MASK, 1 << txsb20);
+    }
+    hal.w8_mask(R_BE_WMAC_RFMOD, B_BE_WMAC_RFMOD_MASK, rf_mod);
+    hal.w32(R_BE_TX_SUB_BAND_VALUE, sb);
+    let check = if chan.band == 0 { B_BE_BAND_MODE } else { B_BE_CHECK_CCK_EN | B_BE_RTS_LIMIT_IN_OFDM6 };
+    hal.clr8(R_BE_TXRATE_CHK, B_BE_BAND_MODE | B_BE_CHECK_CCK_EN | B_BE_RTS_LIMIT_IN_OFDM6);
+    hal.set8(R_BE_TXRATE_CHK, check);
+    let (t1, tb) = if chan.bw >= 1 { (0x41, 0x41) } else { (0x3f, 0x3e) };
+    hal.w32_mask(R_BE_PREBKF_CFG_1, B_BE_SIFS_MACTXEN_T1_MASK, t1);
+    hal.w32_mask(R_BE_MUEDCA_EN, B_BE_SIFS_MACTXEN_TB_T1_MASK, tb);
+}
+
+/// `rtw8922a_set_channel_bb`: CCK's thresholds, the channel (gains, band,
+/// frequency), the width, CCK on or off, no spur notch, the reset.
+pub(crate) fn set_channel_bb(hal: &Hal, gain: &BbGain, chan: &Chan) {
+    let cck = chan.band == 0;
+    if cck && (1..=14).contains(&chan.primary) {
+        let element = chan.primary as usize - 1;
+        hal.phy_w32_mask(R_BK_FC0INV, B_BK_FC0INV, rtw88xx::SCO_BARKER_8852C[element]);
+        hal.phy_w32_mask(R_CCK_FC0INV, B_CCK_FC0INV, rtw88xx::SCO_CCK_8852C[element]);
+    }
+    // `rtw8922a_ctrl_ch` (no eFuse gain offsets).
+    set_gain(hal, gain, chan, 0);
+    set_gain(hal, gain, chan, 1);
+    for reg in [0x4160, 0x4560] {
+        hal.phy_w32_mask(reg, 1 << 26, cck as u32);
+    }
+    let freq = chan.center_freq();
+    hal.phy_w32_mask(R_FC0, B_FC0, freq);
+    hal.phy_w32_mask(R_FC0INV_SBW, B_FC0_INV, ((1u32 << 18) + freq / 2) / freq);
+    if cck {
+        let coeffs: [u32; 8] = if chan.channel == 14 {
+            [0x3b13ff, 0x1c42de, 0xfdb0ad, 0xf60f6e, 0xfd8f92, 0x02d011, 0x01c02c, 0xfff00a]
+        } else {
+            [0x3a63ca, 0x2a833f, 0x1491f8, 0x03c0b0, 0xfccff1, 0xfccfc3, 0xfebfdc, 0xffdff7]
+        };
+        let regs = [(R_PCOEFF01, B_PCOEFF01), (R_PCOEFF23, B_PCOEFF23), (R_PCOEFF45, B_PCOEFF45), (R_PCOEFF67, B_PCOEFF67), (R_PCOEFF89, B_PCOEFF89), (R_PCOEFFAB, B_PCOEFFAB), (R_PCOEFFCD, B_PCOEFFCD), (R_PCOEFFEF, B_PCOEFFEF)];
+        for ((reg, mask), value) in regs.iter().zip(coeffs) {
+            hal.phy_w32_mask(*reg, *mask, value);
+        }
+    }
+    hal.phy_w32_mask(R_MAC_PIN_SEL, B_CH_IDX_SEG0, chan.encoded_index() as u32);
+    // `rtw8922a_ctrl_bw`.
+    let (chbw, prich, gain_map) = match chan.bw {
+        0 => (0, 0, 0),
+        1 => (1, pri_sb(chan), 0),
+        2 => (2, pri_sb(chan), 1),
+        _ => (3, pri_sb(chan), 1),
+    };
+    hal.phy_w32_mask(R_ANT_CHBW, B_CHBW_BW, chbw);
+    hal.phy_w32_mask(R_FC0INV_SBW, B_SMALLBW, 0);
+    hal.phy_w32_mask(R_ANT_CHBW, B_CHBW_PRICH, prich);
+    hal.phy_w32_mask(R_DAC_CLK, B_DAC_CLK, 1);
+    hal.phy_w32_mask(R_GAIN_MAP0, B_GAIN_MAP0_EN, gain_map);
+    hal.phy_w32_mask(R_GAIN_MAP1, B_GAIN_MAP1_EN, gain_map);
+    hal.phy_w32_mask(R_FC0, B_BW40_2XFFT, (chan.bw == 1) as u32);
+    // `rtw8922a_ctrl_cck_en`.
+    hal.phy_w32_mask(R_RXCCA_BE1, B_RXCCA_BE1_DIS, !cck as u32);
+    hal.phy_w32_mask(R_UPD_CLK_ADC, B_ENABLE_CCK, cck as u32);
+    hal.phy_w32_mask(R_PD_ARBITER_OFF, B_PD_ARBITER_OFF, !cck as u32);
+    // `rtw8922a_spur_elimination`: no spur on this chip.
+    hal.phy_w32_mask(R_S0S1_CSI_WGT, B_S0S1_CSI_WGT_EN, 0);
+    for base in [0x41a0, 0x45a0] {
+        hal.phy_w32_mask(base, 0x1000, 0);
+        hal.phy_w32_mask(base + 0xc, 0x1000, 0);
+    }
+    hal.phy_w32_mask(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 1);
+    tssi_reset(hal);
+}
+
+fn tssi_reset(hal: &Hal) {
+    hal.phy_w32_mask(R_TXPWR_RSTA, B_TXPWR_RSTA, 0);
+    hal.phy_w32_mask(R_TXPWR_RSTA, B_TXPWR_RSTA, 1);
+    hal.phy_w32_mask(R_TXPWR_RSTB, B_TXPWR_RSTB, 0);
+    hal.phy_w32_mask(R_TXPWR_RSTB, B_TXPWR_RSTB, 1);
+}
+
+/// `rtw8922a_chan_to_rf18_val`.
+pub(crate) fn rf18(chan: &Chan) -> u32 {
+    let mut value = field(RR_CFGCH_CH, chan.channel as u32);
+    match chan.band {
+        1 => value |= field(RR_CFGCH_BAND1, CFGCH_BAND1_5G) | field(RR_CFGCH_BAND0, CFGCH_BAND0_5G),
+        2 => value |= field(RR_CFGCH_BAND1, CFGCH_BAND1_6G) | field(RR_CFGCH_BAND0, CFGCH_BAND0_6G),
+        _ => {}
+    }
+    match chan.bw {
+        1 => value |= field(RR_CFGCH_BW_V2, CFGCH_BW_V2_40M),
+        2 => value |= field(RR_CFGCH_BW_V2, CFGCH_BW_V2_80M),
+        3 => value |= field(RR_CFGCH_BW_V2, CFGCH_BW_V2_160M),
+        _ => {}
+    }
+    value
+}
+
+/// `rtw8922a_ctl_band_ch_bw`: both RF channel registers of each path.
+pub(crate) fn set_channel_rf(hal: &Hal, chan: &Chan) {
+    let value = rf18(chan);
+    for path in 0..2u8 {
+        for addr in [RR_CFGCH, RR_CFGCH_V1] {
+            let old = hal.read_rf(path, addr, RFREG_MASK);
+            if old == INV_RF_DATA {
+                ostd::warn!("rtw89: the RF's channel register of path {} did not read", path);
+                return;
+            }
+            hal.write_rf(path, addr, RFREG_MASK, (old & !(RR_CFGCH_BAND1 | RR_CFGCH_BW_V2 | RR_CFGCH_BAND0 | RR_CFGCH_CH)) | value);
+            crate::delay_us(100);
+        }
+    }
+    if hal.cv == CHIP_CAV as u8 {
+        let lut = if chan.band == 0 { 0x0c990 } else { 0x0c190 };
+        for (addr, data) in [(RR_LUTWE, 0x80000), (RR_LUTWA, 0x00003), (RR_LUTWD1, lut), (RR_LUTWD0, 0xebe38), (RR_LUTWE, 0)] {
+            hal.write_rf(0, addr, RFREG_MASK, data);
+        }
+    }
+}
+
+/// `rtw8922a_bb_reset_en`.
+fn bb_reset_en(hal: &Hal, two_g: bool, enable: bool) {
+    if enable {
+        hal.phy_w32_mask(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 1);
+        if two_g {
+            hal.phy_w32_mask(R_RXCCA_BE1, B_RXCCA_BE1_DIS, 0);
+        }
+        hal.phy_w32_mask(R_PD_CTRL, B_PD_HIT_DIS, 0);
+    } else {
+        hal.phy_w32_mask(R_RXCCA_BE1, B_RXCCA_BE1_DIS, 1);
+        hal.phy_w32_mask(R_PD_CTRL, B_PD_HIT_DIS, 1);
+        crate::delay_us(1);
+        hal.phy_w32_mask(R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 0);
+    }
+}
+
+/// `rtw8922a_hal_reset`: the scheduler's TX, PPDU reports, DFS, TSSI's
+/// tracking, the ADCs and the baseband off around a change; on again
+/// after.
+fn hal_reset(hal: &Hal, two_g: bool, enter: bool, tx_en: &mut u32) {
+    let adc = |enable: bool| {
+        let value = hal.phy_r32_mask(R_ADC_FIFO_V1, B_ADC_FIFO_EN_V1);
+        hal.phy_w32_mask(R_ADC_FIFO_V1, B_ADC_FIFO_EN_V1, if enable { value & !0x3 } else { value | 0x3 });
+    };
+    let dfs = |enable: bool| {
+        for base in [0x2800, 0x2900] {
+            hal.phy_w32_mask(base, 1 << 1, enable as u32);
+        }
+    };
+    let tssi_cont = |enable: bool| {
+        for reg in [R_TSSI_PWR_P0, R_TSSI_PWR_P1] {
+            hal.phy_w32_mask(reg, B_TSSI_CONT_EN, !enable as u32);
+        }
+    };
+    if enter {
+        *tx_en = be::sch_tx(hal, None);
+        be::ppdu_status(hal, false);
+        dfs(false);
+        tssi_cont(false);
+        adc(false);
+        crate::delay_us(40);
+        bb_reset_en(hal, two_g, false);
+    } else {
+        be::ppdu_status(hal, true);
+        adc(true);
+        dfs(true);
+        tssi_cont(true);
+        bb_reset_en(hal, two_g, true);
+        be::sch_tx(hal, Some(*tx_en));
+    }
+}
+
+/// `rtw8922a_set_channel_help` (one band: only the reset around it), then
+/// after it the calibrations' table (`rtw8922a_chlk_reload`, table 0).
+pub(crate) fn channel_help(hal: &Hal, enter: bool, two_g: bool, tx_en: &mut u32) {
+    hal_reset(hal, two_g, enter, tx_en);
+    if !enter {
+        ktbl_sel(hal, 0);
+    }
+}
+
+/// `rtw8922a_chlk_ktbl_sel`: the coefficient table both paths use.
+fn ktbl_sel(hal: &Hal, index: u32) {
+    for (path, sel, lut) in [(0u8, R_COEF_SEL, R_CFIR_LUT), (1, R_COEF_SEL_C1, R_CFIR_LUT_C1)] {
+        hal.phy_w32_mask(sel, B_COEF_SEL_EN, 1);
+        hal.phy_w32_mask(sel, B_COEF_SEL_IQC_V1, index);
+        hal.phy_w32_mask(sel, B_COEF_SEL_MDPD_V1, index);
+        hal.write_rf(path, RR_MODOPT, RR_TXG_SEL, 0x4 | index);
+        let g3 = hal.phy_r32_mask(sel, 1 << 0);
+        hal.phy_w32_mask(lut, B_CFIR_LUT_G3, g3);
+        let g5 = hal.phy_r32_mask(sel, 1 << 1);
+        hal.phy_w32_mask(lut, B_CFIR_LUT_G5, g5);
+    }
+}
+
+/// `rtw8922a_cfg_rx_nss_limit`.
+fn rx_nss_limit(hal: &Hal, nss: u32) {
+    let v = nss.saturating_sub(1);
+    for (addr, mask, value) in [
+        (R_BRK_R, B_HTMCS_LMT, v),
+        (R_BRK_R, B_VHTMCS_LMT, v),
+        (R_BRK_HE, B_N_USR_MAX, HE_N_USER_MAX_8922A),
+        (R_BRK_HE, B_NSS_MAX, v),
+        (R_BRK_HE, B_TB_NSS_MAX, v),
+        (R_BRK_EHT, B_RXEHT_NSS_MAX, v),
+        (R_BRK_RXEHT, B_RXEHTTB_NSS_MAX, v),
+        (R_BRK_RXEHT, B_RXEHT_N_USER_MAX, HE_N_USER_MAX_8922A),
+    ] {
+        hal.phy_w32_mask(addr, mask, value);
+    }
+}
+
+/// `rtw8922a_bb_cfg_txrx_path`: both paths for TX (the TMAC's path
+/// settings) and RX, two streams, inside the reset.
+pub(crate) fn cfg_txrx_path(hal: &Hal, two_g: bool) {
+    let mut tx_en = 0;
+    hal_reset(hal, two_g, true, &mut tx_en);
+    // `rtw8922a_ctrl_tx_path_tmac` for both paths.
+    hal.phy_w32_mask(R_MAC_SEL, B_MAC_SEL, 0);
+    for (addr, data) in [(0x11a00, 0x21c8_6900), (0x11a04, 0x00e4_e433), (0x11a08, 0x3939_0cc9), (0x11a0c, 0x4e43_3240), (0x11a10, 0x90cc_900e), (0x11a14, 0x0024_0393), (0x11a18, 0x201c_8600)] {
+        hal.w32(addr, data);
+    }
+    // `rtw8922a_ctrl_rx_path_tmac` for both paths.
+    hal.phy_w32_mask(R_ANT_CHBW, B_ANT_RX_SG0, 0);
+    hal.phy_w32_mask(R_ANT_CHBW, B_ANT_RX_SG0, 3);
+    hal.phy_w32_mask(R_FC0INV_SBW, B_RX_1RCCA, 3);
+    rx_nss_limit(hal, 2);
+    tssi_reset(hal);
+    rx_nss_limit(hal, 2);
+    hal_reset(hal, two_g, false, &mut tx_en);
+}
+
+/// `rtw8922a_bb_sethw` and `rtw8922a_ctrl_mlo` for one 2x2 band.
+pub(crate) fn bb_sethw(hal: &Hal, bw: u8) {
+    hal.phy_clr(R_EN_SND_WO_NDP, B_EN_SND_WO_NDP);
+    hal.phy_clr(R_EN_SND_WO_NDP_C1, B_EN_SND_WO_NDP);
+    hal.w32_mask(R_BE_PWR_BOOST, B_BE_PWR_CTRL_SEL, 0);
+    hal.phy_w32_mask(R_DBCC, B_DBCC_EN, 0);
+    hal.phy_w32_mask(R_DBCC_FA, B_DBCC_FA, 1);
+    afe_dac(hal, bw);
+    for value in [0x6180, 0xbbab, 0xaba9, 0xeba9, 0xeaa9] {
+        hal.phy_w32_mask(R_EMLSR, B_EMLSR_PARM, value);
+    }
+}
+
+/// `rtw8922a_ctrl_afe_dac` for both paths.
+fn afe_dac(hal: &Hal, bw: u8) {
+    let (dac0, dac1) = if bw == 3 { (0xd, 0x6) } else { (0xe, 0x7) };
+    for ofst in [0, 0x100] {
+        hal.phy_w32_mask(R_AFEDAC0 + ofst, B_AFEDAC0, dac0);
+        hal.phy_w32_mask(R_AFEDAC1 + ofst, B_AFEDAC1, dac1);
+    }
+}
+
+/// `rtw8922a_power_trim`: the PA's and PAD's bias of the eFuse
+/// (`pa_bias_trim`, `pad_bias_trim`).
+pub(crate) fn power_trim(hal: &Hal, bias: Option<[[u8; 2]; 2]>) {
+    let Some([pa, pad]) = bias else { return };
+    for path in 0..2u8 {
+        let (pa, pad) = (pa[path as usize], pad[path as usize]);
+        hal.write_rf(path, RR_BIASA, RR_BIASA_TXG_V1, (pa & 0xf) as u32);
+        hal.write_rf(path, RR_BIASA, RR_BIASA_TXA_V1, (pa >> 4) as u32);
+        hal.write_rf(path, RR_BIASA, RR_BIASD_TXG_V1, (pad & 0xf) as u32);
+        hal.write_rf(path, RR_BIASA, RR_BIASD_TXA_V1, (pad >> 4) as u32);
+    }
+}
+
+/// `rtw8922a_btc_init_cfg` for two antennas shared with Bluetooth on path
+/// B (`rtw8922a_btc_set_rfe`): each path's TX/RX mask by Bluetooth's
+/// state, the WLAN's high-priority frames, the break table; both radios'
+/// grants left to the hardware's arbitration.
+pub(crate) fn btc_init(hal: &Hal) {
+    for path in 0..2u8 {
+        hal.write_rf(path, RR_LUTWE, RFREG_MASK, 1 << 17);
+        for (group, value) in [(BTC_BT_SS_GROUP, 0x5ff), (BTC_BT_RX_GROUP, 0x5df), (BTC_BT_TX_GROUP, if path == 1 { 0x55f } else { 0x5ff })] {
+            hal.write_rf(path, RR_LUTWA, RFREG_MASK, group);
+            hal.write_rf(path, RR_LUTWD0, RFREG_MASK, value);
+        }
+        hal.write_rf(path, RR_LUTWE, RFREG_MASK, 0);
+    }
+    hal.w32(R_BTC_COEX_WL_REQ_BE, B_BTC_RSP_ACK_HI | B_BTC_TX_BCN_HI | B_BTC_TX_TRI_HI | B_BTC_TX_NULL_HI);
+    hal.w32(R_BE_BT_BREAK_TABLE, BTC_BREAK_PARAM);
+    hal.w32(R_BTC_ZB_COEX_TBL_0, 0xda5a_5a5a);
+    hal.w32(R_BTC_ZB_COEX_TBL_1, 0xda5a_5a5a);
+    hal.w32(R_BTC_ZB_BREAK_TBL, 0xf0ff_ffff);
+    hal.w32(R_BE_GNT_SW_CTRL, 0);
+}
+
+// ---- TX power (`rtw8922a_set_txpwr`). ----
+
+/// The cap on every rate and the target without a table, half dB steps
+/// (as [`phy`]'s for the 802.11ax chips).
+const LIMIT_CAP: i8 = 32;
+const DEFAULT_TARGET: i8 = 28;
+/// `RTW89_SAR_TXPWR_MAC_MAX` in the RF's quarter dB.
+const SAR_RF_MAX: u32 = 63 << 1;
+const RS_CCK: u8 = 0;
+const RS_OFDM: u8 = 1;
+const RS_MCS: u8 = 2;
+const RS_HEDCM: u8 = 3;
+const RS_OFFSET: u8 = 4;
+
+/// `struct rtw89_txpwr_byrate` of a band and width, in the RF's quarter
+/// dB: [OFDMA][NSS][index] for MCS and HE DCM.
+#[derive(Clone)]
+struct ByRate {
+    cck: [i8; 4],
+    ofdm: [i8; 8],
+    mcs: [[[i8; 16]; 2]; 2],
+    hedcm: [[[i8; 4]; 2]; 2],
+    offset: [i8; 8],
+}
+
+/// The firmware's by-rate entries (`struct rtw89_fw_txpwr_byrate_entry`)
+/// for a band and width; CCK's are 2.4 GHz's.
+fn byrate(fw: &Firmware, band: u8, bw: u8) -> ByRate {
+    let fill = DEFAULT_TARGET * 2;
+    let mut out = ByRate { cck: [fill; 4], ofdm: [fill; 8], mcs: [[[fill; 16]; 2]; 2], hedcm: [[[fill; 4]; 2]; 2], offset: [0; 8] };
+    let Some(table) = &fw.elements.byrate else { return out };
+    for entry in table.entries() {
+        if entry.len() < 9 {
+            continue;
+        }
+        let (e_band, nss, rs, shf, len) = (entry[0], entry[1] as usize, entry[2], entry[3] as usize, entry[4] as usize);
+        let data = u32::from_le_bytes([entry[5], entry[6], entry[7], entry[8]]);
+        let (e_bw, ofdma) = (entry.get(9).copied().unwrap_or(0), entry.get(10).copied().unwrap_or(0) as usize);
+        let band_ok = if rs == RS_CCK { e_band == 0 } else { e_band == band };
+        if !band_ok || e_bw != bw || nss > 1 || ofdma > 1 {
+            continue;
+        }
+        for i in 0..len.min(4) {
+            let value = (data >> (8 * i)) as u8 as i8;
+            let index = shf + i;
+            let slot = match rs {
+                RS_CCK => out.cck.get_mut(index),
+                RS_OFDM => out.ofdm.get_mut(index),
+                RS_MCS => out.mcs[ofdma][nss].get_mut(index),
+                RS_HEDCM => out.hedcm[ofdma][nss].get_mut(index),
+                RS_OFFSET => out.offset.get_mut(index),
+                _ => None,
+            };
+            if let Some(slot) = slot {
+                *slot = value;
+            }
+        }
+    }
+    out
+}
+
+/// `rtw89_phy_set_txpwr_byrate_be` (`rtw89_byr_spec_be`'s order: each
+/// width, each NSS), `_offset_be`, the limits and their RU ones at the
+/// cap, then the paths' difference, the reference, the SAR cap and the
+/// TX shape.
+pub(crate) fn set_txpwr(hal: &Hal, fw: &Firmware, chan: &Chan) {
+    let to_mac = |value: i8| (value >> 1) as u8;
+    let mut bytes: Vec<u8> = Vec::with_capacity(428);
+    for bw in 0..=4u8 {
+        let table = byrate(fw, chan.band, bw);
+        for nss in 0..2usize {
+            if nss == 0 {
+                if bw <= 1 {
+                    bytes.extend(table.cck.iter().map(|&v| to_mac(v)));
+                }
+                bytes.extend(table.ofdm.iter().map(|&v| to_mac(v)));
+                bytes.extend(table.mcs[0][0][14..16].iter().map(|&v| to_mac(v)));
+                bytes.extend(table.mcs[1][0][14..16].iter().map(|&v| to_mac(v)));
+            }
+            bytes.extend(table.mcs[0][nss][..14].iter().map(|&v| to_mac(v)));
+            bytes.extend(table.hedcm[0][nss].iter().map(|&v| to_mac(v)));
+            bytes.extend(table.mcs[1][nss][..14].iter().map(|&v| to_mac(v)));
+            bytes.extend(table.hedcm[1][nss].iter().map(|&v| to_mac(v)));
+        }
+    }
+    let mut addr = R_BE_PWR_BY_RATE;
+    for four in bytes.chunks(4) {
+        if addr >= R_BE_PWR_LMT {
+            break;
+        }
+        let mut word = [0u8; 4];
+        word[..four.len()].copy_from_slice(four);
+        hal.w32(addr, u32::from_le_bytes(word));
+        addr += 4;
+    }
+    let offsets = byrate(fw, chan.band, 0).offset;
+    let offset = offsets.iter().enumerate().fold(0u32, |value, (i, &v)| value | (((to_mac(v) as u32) & 0xf) << (4 * i)));
+    hal.w32(R_BE_PWR_RATE_OFST_CTRL, offset);
+    let cap = LIMIT_CAP as u8 as u32;
+    let cap_word = cap | (cap << 8) | (cap << 16) | (cap << 24);
+    for addr in (R_BE_PWR_LMT..=R_BE_PWR_BY_RATE_END).step_by(4) {
+        hal.w32(addr, cap_word);
+    }
+    for addr in (R_BE_PWR_RULMT_START..=R_BE_PWR_RULMT_END).step_by(4) {
+        hal.w32(addr, cap_word);
+    }
+    // `rtw8922a_set_txpwr_diff` without an antenna gain: no difference
+    // between the paths, the first cut's reference 16 dBm up.
+    let pwr_ref = if hal.cv == CHIP_CAV as u8 { 16u32 << 2 } else { 0 };
+    for ofst in [0, 0x100] {
+        hal.phy_w32_mask(R_TXAGC_REF_DBM_P0 + ofst, B_TXAGC_OFDM_REF_DBM_P0, pwr_ref);
+        hal.phy_w32_mask(R_TXAGC_REF_DBM_P0 + ofst, B_TXAGC_CCK_REF_DBM_P0, pwr_ref);
+        hal.phy_w32_mask(R_TSSI_K_P0 + ofst, B_TSSI_K_OFDM_P0, 0x12);
+    }
+    set_txpwr_ref(hal);
+    hal.phy_w32_mask(R_P0_TXPWRB_BE, B_TXPWRB_MAX_BE, SAR_RF_MAX);
+    hal.phy_w32_mask(R_P1_TXPWRB_BE, B_TXPWRB_MAX_BE, SAR_RF_MAX);
+    hal.phy_w32_mask(R_BEDGE3, B_BEDGE_CFG, 0);
+}
+
+/// `rtw8922a_set_txpwr_ref`: no reference offset.
+pub(crate) fn set_txpwr_ref(hal: &Hal) {
+    hal.w32_mask(R_BE_PWR_REF_CTRL, B_BE_PWR_REF_CTRL_OFDM, 0);
+    hal.w32_mask(R_BE_PWR_REF_CTRL, B_BE_PWR_REF_CTRL_CCK, 0);
+}
+
+// ---- The firmware's calibrations. ----
+
+/// `RTW89_TSSI_NORMAL` and `RTW89_TSSI_SCAN`.
+pub(crate) const TSSI_NORMAL: u8 = RTW89_TSSI_NORMAL as u8;
+pub(crate) const TSSI_SCAN: u8 = RTW89_TSSI_SCAN as u8;
+/// The thermal value Linux takes for an uncalibrated path.
+const TSSI_THERMAL_DEFAULT: u8 = 0x38;
+/// `struct rtw89_h2c_rf_tssi`'s length.
+const H2C_RF_TSSI_LEN: usize = 300;
+
+/// `rtw89_fw_h2c_rf_tssi` with `rtw89_phy_rfk_tssi_fill_fwcmd_efuse_to_de`
+/// and `_tmeter_tbl`: the channel, TX by hardware, the eFuse's offsets for
+/// it at every width (no trim on this chip), each path's thermal value and
+/// the 128-step table of the TX power's thermal tracking (up, then down
+/// from the end; in fours, each four reversed). `None` without the
+/// firmware's tracking table.
+pub(crate) fn tssi_command(hal: &Hal, tssi: &Tssi, track: &TxPowerTrack, chan: &Chan, mode: u8) -> Option<Vec<u8>> {
+    let mut out = Vec::with_capacity(H2C_RF_TSSI_LEN);
+    out.extend_from_slice(&(H2C_RF_TSSI_LEN as u16).to_le_bytes());
+    out.extend_from_slice(&[0, chan.channel, chan.bw, chan.band, 1, hal.cv]);
+    let mut cck = [0u8; 2];
+    let mut ofdm = [0u8; 2];
+    for path in 0..2 {
+        cck[path] = tssi.cck[path][phy::cck_group(chan.channel)] as u8;
+        ofdm[path] = if chan.band == phy::BAND_6G {
+            phy::group_value(&tssi.mcs_6g[path], phy::ofdm_group_6g(chan.channel))
+        } else {
+            phy::group_value(&tssi.mcs[path], phy::ofdm_group(chan.channel))
+        } as u8;
+    }
+    // CCK's: no common one, 20 and 40 MHz, the eFuse's.
+    out.extend_from_slice(&[0, 0]);
+    out.extend_from_slice(&cck);
+    out.extend_from_slice(&cck);
+    out.extend_from_slice(&cck);
+    // OFDM's: no common one, 20 to 320 MHz, the eFuse's; no differences
+    // between widths; no trim.
+    out.extend_from_slice(&[0, 0]);
+    for _ in 0..5 {
+        out.extend_from_slice(&ofdm);
+    }
+    out.extend_from_slice(&ofdm);
+    out.extend_from_slice(&[0; 8]);
+    out.extend_from_slice(&[0, 0]);
+    // The tracking table's subband.
+    let (kinds, subband) = match chan.band {
+        phy::BAND_2G => ([RTW89_FW_TXPWR_TRK_TYPE_2GA_P, RTW89_FW_TXPWR_TRK_TYPE_2GA_N, RTW89_FW_TXPWR_TRK_TYPE_2GB_P, RTW89_FW_TXPWR_TRK_TYPE_2GB_N], 0),
+        phy::BAND_6G => (
+            [RTW89_FW_TXPWR_TRK_TYPE_6GA_P, RTW89_FW_TXPWR_TRK_TYPE_6GA_N, RTW89_FW_TXPWR_TRK_TYPE_6GB_P, RTW89_FW_TXPWR_TRK_TYPE_6GB_N],
+            (gain_band(chan) - GAIN_BAND_6G_FIRST) / 2,
+        ),
+        _ => (
+            [RTW89_FW_TXPWR_TRK_TYPE_5GA_P, RTW89_FW_TXPWR_TRK_TYPE_5GA_N, RTW89_FW_TXPWR_TRK_TYPE_5GB_P, RTW89_FW_TXPWR_TRK_TYPE_5GB_N],
+            gain_band(chan) - 1,
+        ),
+    };
+    let size = DELTA_SWINGIDX_SIZE as usize;
+    let mut tables = [[0u8; 128]; 2];
+    for path in 0..2 {
+        let thermal = tssi.thermal[path];
+        out.push(if thermal == 0xff { TSSI_THERMAL_DEFAULT } else { thermal });
+        if thermal == 0xff {
+            continue;
+        }
+        let (up, down) = (track.delta(kinds[path * 2], subband)?, track.delta(kinds[path * 2 + 1], subband)?);
+        let mut offsets = [0i8; 128];
+        for (step, offset) in offsets[..64].iter_mut().enumerate() {
+            *offset = up[step.min(size - 1)];
+        }
+        for (step, offset) in offsets[64..].iter_mut().rev().enumerate() {
+            *offset = down[(step + 1).min(size - 1)].wrapping_neg();
+        }
+        for (four, table) in offsets.chunks(4).zip(tables[path].chunks_mut(4)) {
+            for (slot, value) in table.iter_mut().zip(four.iter().rev()) {
+                *slot = *value as u8;
+            }
+        }
+    }
+    for table in &tables {
+        out.extend_from_slice(table);
+    }
+    out.extend_from_slice(&[mode, hal.rfe_type]);
+    debug_assert_eq!(out.len(), H2C_RF_TSSI_LEN);
+    Some(out)
+}
+
+/// The channel the calibrations' table 0 is for (`struct
+/// rtw89_rfk_mcc_info` with one table used): band, width, channel, its RF
+/// value.
+#[derive(Clone, Copy, Default)]
+pub(crate) struct RfkMcc {
+    pub(crate) band: u32,
+    pub(crate) bw: u32,
+    pub(crate) ch: u32,
+    pub(crate) rf18: u32,
+}
+
+impl RfkMcc {
+    pub(crate) fn of(chan: &Chan) -> Self {
+        Self { band: chan.band as u32, bw: chan.bw as u32, ch: chan.channel as u32, rf18: rf18(chan) }
+    }
+}
+
+/// `rtw89_fw_h2c_rf_pre_ntfy` (formats 0 to 2): the tables' channels per
+/// path (table 0 the current one), the mode, the current channel.
+pub(crate) fn pre_ntfy(hal: &Hal, version: u8, mcc: &RfkMcc, rfe_type: u8) -> Vec<u32> {
+    let mut w = Vec::with_capacity(32);
+    // `dbcc.ch[path][table]`, `dbcc.band[path][table]`.
+    for _ in 0..2 {
+        w.extend_from_slice(&[mcc.ch, 0, 0]);
+    }
+    for _ in 0..2 {
+        w.extend_from_slice(&[mcc.band, 0, 0]);
+    }
+    w.push(MLO_2_PLUS_0_1RF);
+    w.extend_from_slice(&[mcc.ch, mcc.ch, mcc.band, mcc.band]);
+    w.push(0);
+    match version {
+        0 => {
+            w.extend_from_slice(&[mcc.band, mcc.bw, mcc.ch]);
+            w.push(hal.phy_r32_mask(R_COEF_SEL, B_COEF_SEL_IQC_V1));
+            w.push(hal.phy_r32_mask(R_COEF_SEL_C1, B_COEF_SEL_IQC_V1));
+            w.push(hal.read_rf(0, RR_CFGCH, RFREG_MASK));
+            w.push(hal.read_rf(1, RR_CFGCH, RFREG_MASK));
+            w.extend_from_slice(&[0, rfe_type as u32, 0, 0, 0, 0, 0]);
+        }
+        1 => w.push(0),
+        _ => w.extend_from_slice(&[0, mcc.bw, mcc.bw]),
+    }
+    w
+}
+
+/// `rtw89_fw_h2c_rf_pre_ntfy_mcc` (formats 0 and 1): the tables' RF
+/// values, the current one per path, the mode.
+pub(crate) fn pre_ntfy_mcc(version: u8, mcc: &RfkMcc) -> Vec<u8> {
+    let mut out = Vec::new();
+    let mut push = |value: u32| out.extend_from_slice(&value.to_le_bytes());
+    if version == 0 {
+        for table in 0..3 {
+            let value = if table == 0 { mcc.rf18 } else { 0 };
+            push(value);
+            push(value);
+        }
+        push(mcc.rf18);
+        push(mcc.rf18);
+        push(MLO_2_PLUS_0_1RF);
+    } else {
+        push(mcc.rf18);
+        push(0);
+        push(0);
+        push(mcc.rf18);
+        push(mcc.rf18);
+        push(MLO_2_PLUS_0_1RF);
+        push(0);
+        out.extend_from_slice(&[0, 0]);
+    }
+    out
+}
+
+/// The calibrations the firmware runs (`H2C_FUNC_RFK_*_OFFLOAD`) and how
+/// long Linux waits for each (ms).
+#[derive(Clone, Copy)]
+pub(crate) enum Rfk {
+    Dack,
+    RxDck { channel: bool },
+    TxGapK,
+    Iqk,
+    Dpk,
+}
+
+impl Rfk {
+    /// The command's function and payload (`struct rtw89_h2c_rf_*`), the
+    /// time it takes.
+    pub(crate) fn command(self, hal: &Hal, features: &Features, chan: &Chan) -> (u32, Vec<u8>, u64) {
+        let (band, bw, ch) = (chan.band, chan.bw, chan.channel);
+        let rf_ab = RF_AB as u8;
+        match self {
+            Rfk::Dack => (H2C_FUNC_RFK_DACK_OFFLOAD, alloc::vec![3, 0, 0], 58),
+            Rfk::RxDck { channel } => {
+                let mut v = alloc::vec![8, 0, 0, rf_ab, band, bw, ch, 0];
+                if !features.rxdck_v0 {
+                    v[0] = 9;
+                    v.push(channel as u8);
+                }
+                (H2C_FUNC_RFK_RXDCK_OFFLOAD, v, if channel { 32 } else { 128 })
+            }
+            Rfk::TxGapK => (H2C_FUNC_RFK_TXGAPK_OFFLOAD, alloc::vec![8, 2, 0, rf_ab, band, bw, ch, hal.cv], 54),
+            Rfk::Iqk => {
+                let payload = if features.iqk_v0 { alloc::vec![0; 8] } else { alloc::vec![8, 0, 0, rf_ab, band, bw, ch, hal.cv] };
+                (H2C_FUNC_RFK_IQK_OFFLOAD, payload, 84)
+            }
+            Rfk::Dpk => (H2C_FUNC_RFK_DPK_OFFLOAD, alloc::vec![8, 0, 1, rf_ab, band, bw, ch, 0], 34),
+        }
+    }
+}
