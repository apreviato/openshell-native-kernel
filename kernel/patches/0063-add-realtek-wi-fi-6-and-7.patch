+/// The register sequences of a chip's TSSI (`rtw8852b_rfk_table.c`'s, or
+/// the RTL8852BT's): system (common, path A and B by band), TX power
+/// control and its HE TB part, DC, DAC gains, slope by band, the default
+/// alignment of each path by band (2.4, 5 GHz low, middle, high), the
+/// slopes; the RTL8852BT's extras: the 80 MHz bit of the asynchronous
+/// reset, the DPD off meanwhile.
+pub(crate) struct TssiTables {
+    sys: &'static [Rfk],
+    sys_path: [[&'static [Rfk]; 2]; 2],
+    init_txpwr: [&'static [Rfk]; 2],
+    init_txpwr_he_tb: [&'static [Rfk]; 2],
+    dck: [&'static [Rfk]; 2],
+    dac_gain: [&'static [Rfk]; 2],
+    slope_cal: [[&'static [Rfk]; 2]; 2],
+    align: [[&'static [Rfk]; 4]; 2],
+    slope: [&'static [Rfk]; 2],
+    bw80_async: bool,
+    dpk_off: bool,
+}
