+/// `_tssi_disable`.
+fn tssi_disable(hal: &Hal, tssi_mode: &mut [bool; 2]) {
+    hal.phy_w32_mask(R_P0_TSSI_AVG, B_P0_TSSI_EN, 0);
+    hal.phy_w32_mask(R_P0_TSSI_TRK, B_P0_TSSI_RFC, 0x1);
+    hal.phy_w32_mask(R_P0_TSSI_MV_AVG, B_P0_TSSI_MV_CLR, 0x1);
+    hal.phy_w32_mask(R_P1_TSSI_AVG, B_P1_TSSI_EN, 0);
+    hal.phy_w32_mask(R_P1_TSSI_TRK, B_P1_TSSI_RFC, 0x1);
+    hal.phy_w32_mask(R_P1_TSSI_MV_AVG, B_P1_TSSI_MV_CLR, 0x1);
+    *tssi_mode = [false; 2];
+}
+
+/// `_tssi_enable`: tracking on, the moving average, the loop.
+fn tssi_enable(hal: &Hal, tssi_mode: &mut [bool; 2]) {
+    for path in 0..2u8 {
+        let (tssic, bypass, mv_avg, mv_mix, mv_clr, avg, en, trk, rfc, oft, oft_en) = if path == 0 {
+            (R_P0_TSSIC, B_P0_TSSIC_BYPASS, R_P0_TSSI_MV_AVG, B_P0_TSSI_MV_MIX, B_P0_TSSI_MV_CLR, R_P0_TSSI_AVG, B_P0_TSSI_EN, R_P0_TSSI_TRK, B_P0_TSSI_RFC, B_P0_TSSI_OFT, B_P0_TSSI_OFT_EN)
+        } else {
+            (R_P1_TSSIC, B_P1_TSSIC_BYPASS, R_P1_TSSI_MV_AVG, B_P1_RFCTM_DEL, B_P1_TSSI_MV_CLR, R_P1_TSSI_AVG, B_P1_TSSI_EN, R_P1_TSSI_TRK, B_P1_TSSI_RFC, B_P1_TSSI_OFT, B_P1_TSSI_OFT_EN)
+        };
+        hal.phy_w32_mask(tssic, bypass, 0);
+        hal.phy_w32_mask(mv_avg, mv_mix, 0x010);
+        hal.phy_w32_mask(mv_avg, mv_clr, 0);
+        hal.phy_w32_mask(avg, en, 0);
+        hal.phy_w32_mask(avg, en, 1);
+        hal.write_rf(path, RR_TXGA_V1, RR_TXGA_V1_TRK_EN, 1);
+        hal.phy_w32_mask(trk, rfc, 0x3);
+        hal.phy_w32_mask(trk, oft, 0xc0);
+        hal.phy_w32_mask(trk, oft_en, 0);
+        hal.phy_w32_mask(trk, oft_en, 1);
+        tssi_mode[path as usize] = true;
+    }
+}
+
+/// `_tssi_set_tmeter_tbl` (the AX chips'): each path's thermal value from
+/// the eFuse and the 64 steps of its tracking (down, then up from the
+/// end) for the channel's subband, none without the eFuse's value or the
+/// firmware's table.
+pub(crate) fn tssi_set_tmeter_tbl(hal: &Hal, path: u8, chan: &Chan, tssi: &Tssi, track: Option<&TxPowerTrack>) {
+    let (kind_up, kind_down) = match (chan.band, path) {
+        (phy::BAND_2G, 0) => (RTW89_FW_TXPWR_TRK_TYPE_2GA_P, RTW89_FW_TXPWR_TRK_TYPE_2GA_N),
+        (phy::BAND_2G, _) => (RTW89_FW_TXPWR_TRK_TYPE_2GB_P, RTW89_FW_TXPWR_TRK_TYPE_2GB_N),
+        (phy::BAND_6G, 0) => (RTW89_FW_TXPWR_TRK_TYPE_6GA_P, RTW89_FW_TXPWR_TRK_TYPE_6GA_N),
+        (phy::BAND_6G, _) => (RTW89_FW_TXPWR_TRK_TYPE_6GB_P, RTW89_FW_TXPWR_TRK_TYPE_6GB_N),
+        (_, 0) => (RTW89_FW_TXPWR_TRK_TYPE_5GA_P, RTW89_FW_TXPWR_TRK_TYPE_5GA_N),
+        (_, _) => (RTW89_FW_TXPWR_TRK_TYPE_5GB_P, RTW89_FW_TXPWR_TRK_TYPE_5GB_N),
+    };
+    // `rtw89_get_subband_type`, the table's row in the band.
+    let subband = match (chan.band, chan.channel) {
+        (phy::BAND_5G, 100..=144) => 1,
+        (phy::BAND_5G, 149..=177) => 2,
+        (phy::BAND_6G, 65..=93 | 97..=125) => 1,
+        (phy::BAND_6G, 129..=157 | 161..=189) => 2,
+        (phy::BAND_6G, 193..=221 | 225..=253) => 3,
+        _ => 0,
+    };
+    let (tmeter, tmeter_dis, tmeter_trk, tmeter_val, rfctm, rfctm_val, rfctm_rdy, base) = if path == 0 {
+        (R_P0_TMETER, B_P0_TMETER_DIS, B_P0_TMETER_TRK, B_P0_TMETER, R_P0_RFCTM, B_P0_RFCTM_VAL, R_P0_RFCTM_RDY, R_P0_TSSI_BASE)
+    } else {
+        (R_P1_TMETER, B_P1_TMETER_DIS, B_P1_TMETER_TRK, B_P1_TMETER, R_P1_RFCTM, B_P1_RFCTM_VAL, R_P1_RFCTM_RDY, R_TSSI_THOF)
+    };
+    let thermal = tssi.thermal[path as usize];
+    hal.phy_w32_mask(tmeter, tmeter_dis, 0);
+    hal.phy_w32_mask(tmeter, tmeter_trk, 1);
+    let deltas = track.and_then(|track| Some((track.delta(kind_up, subband)?, track.delta(kind_down, subband)?)));
+    match deltas.filter(|_| thermal != 0xff) {
+        None => {
+            let value = if thermal == 0xff { TSSI_THERMAL_DEFAULT } else { thermal as u32 };
+            hal.phy_w32_mask(tmeter, tmeter_val, value);
+            hal.phy_w32_mask(rfctm, rfctm_val, value);
+            for at in (0..64).step_by(4) {
+                hal.phy_w32(base + at, 0);
+            }
+        }
+        Some((up, down)) => {
+            hal.phy_w32_mask(tmeter, tmeter_val, thermal as u32);
+            hal.phy_w32_mask(rfctm, rfctm_val, thermal as u32);
+            let last = DELTA_SWINGIDX_SIZE as usize - 1;
+            let mut offsets = [0i8; 64];
+            for (step, offset) in offsets[..32].iter_mut().enumerate() {
+                *offset = down[step.min(last)].wrapping_neg();
+            }
+            for (step, offset) in offsets[32..].iter_mut().rev().enumerate() {
+                *offset = up[(step + 1).min(last)];
+            }
+            for (index, four) in offsets.chunks(4).enumerate() {
+                let word = four.iter().enumerate().fold(0u32, |word, (i, &value)| word | ((value as u8 as u32) << (8 * i)));
+                hal.phy_w32(base + 4 * index as u32, word);
+            }
+        }
+    }
+    hal.phy_w32_mask(rfctm, rfctm_rdy, 1);
+    hal.phy_w32_mask(rfctm, rfctm_rdy, 0);
+}
+
+/// `_tssi_alignment_default` (all of it): the alignment the tables give the
+/// channel's band.
+fn tssi_alignment_default(hal: &Hal, tables: &TssiTables, path: u8, chan: &Chan) {
+    let band = match chan.channel {
+        1..=14 => 0,
+        36..=64 => 1,
+        100..=144 => 2,
+        149..=177 => 3,
+        _ => return,
+    };
+    rfk(hal, tables.align[path as usize][band]);
+}
+
+/// `_tssi_set_efuse_to_de`: the eFuse's offsets (and trims) for the
+/// channel in each path's DE registers.
+fn tssi_set_efuse_to_de(hal: &Hal, tssi: &Tssi, chan: &Chan) {
+    for path in 0..2usize {
+        let trim = tssi.trim[path][trim_group(chan.channel)] as i32;
+        let cck = (tssi.cck[path][phy::cck_group(chan.channel)] as i32 + trim) as u32;
+        for reg in TSSI_DE_CCK[path] {
+            hal.phy_w32_mask(reg, TSSI_DE_MASK, cck);
+        }
+        let ofdm = (phy::group_value(&tssi.mcs[path], phy::ofdm_group(chan.channel)) as i32 + trim) as u32;
+        for reg in TSSI_DE_MCS[path] {
+            hal.phy_w32_mask(reg, TSSI_DE_MASK, ofdm);
+        }
+    }
+}
+
+/// `rtw8852b_tssi` (and `_tssi_scan`, `scan`): the closed loop set up per
+/// path (RF, system, baseband, DC, thermal table, DAC gains, slope,
+/// alignment) and turned on with the eFuse's offsets. The alignment is the
+/// tables' (as Linux's own scans keep it), not one measured with the
+/// baseband's packet generator.
+pub(crate) fn tssi(hal: &Hal, tssi_mode: &mut [bool; 2], tables: &TssiTables, tssi: &Tssi, track: Option<&TxPowerTrack>, chan: &Chan, scan: bool) {
+    let two_g = chan.band == phy::BAND_2G;
+    let band = (!two_g) as usize;
+    // The RTL8852BT's DPD off meanwhile (`_tssi_dpk_off`), as it was after.
+    const DPD_REGS: [u32; 2] = [R_DPD_CH0A, R_DPD_CH0B];
+    const DPD_ON: u32 = 1 << 24;
+    let dpd = (tables.dpk_off && !scan).then(|| DPD_REGS.map(|reg| hal.phy_r32_mask(reg, MASKDWORD)));
+    tssi_disable(hal, tssi_mode);
+    if dpd.is_some() {
+        for reg in DPD_REGS {
+            hal.phy_w32_mask(reg, DPD_ON, 0);
+        }
+    }
+    for path in 0..2u8 {
+        let p = path as usize;
+        // `_tssi_rf_setting`.
+        hal.write_rf(path, RR_TXPOW, if two_g { RR_TXPOW_TXG } else { RR_TXPOW_TXA }, 1);
+        // `_tssi_set_sys`.
+        rfk(hal, tables.sys);
+        if tables.bw80_async {
+            hal.phy_w32_mask(R_RSTB_ASYNC, B_RSTB_ASYNC_BW80, (chan.bw == 2) as u32);
+        }
+        rfk(hal, tables.sys_path[p][band]);
+        if !scan {
+            rfk(hal, tables.init_txpwr[p]);
+            rfk(hal, tables.init_txpwr_he_tb[p]);
+            rfk(hal, tables.dck[p]);
+        }
+        tssi_set_tmeter_tbl(hal, path, chan, tssi, track);
+        if !scan {
+            rfk(hal, tables.dac_gain[p]);
+            rfk(hal, tables.slope_cal[p][band]);
+        }
+        tssi_alignment_default(hal, tables, path, chan);
+        if !scan {
+            rfk(hal, tables.slope[p]);
+        }
+    }
+    tssi_enable(hal, tssi_mode);
+    tssi_set_efuse_to_de(hal, tssi, chan);
+    if let Some(values) = dpd {
+        for (reg, value) in DPD_REGS.iter().zip(values) {
+            hal.phy_w32_mask(*reg, MASKDWORD, value);
+        }
+    }
+}
+
+/// `rtw8852b_rfk_channel`'s host part after the RX DC offset: IQK, TSSI,
+/// DPK.
+pub(crate) fn channel(hal: &Hal, state: &mut State, tssi_efuse: Option<&Tssi>, track: Option<&TxPowerTrack>, chan: &Chan) {
+    iqk(hal, &mut state.iqk, chan);
+    if let Some(efuse) = tssi_efuse {
+        tssi(hal, &mut state.tssi_mode, &TSSI_8852B, efuse, track, chan, false);
+    }
+    dpk(hal, state, chan);
+}
diff --git a/kernel/comps/rtw89/src/rtw8852bt_rfk.rs b/kernel/comps/rtw89/src/rtw8852bt_rfk.rs
new file mode 100644
index 0000000..b24010a
--- /dev/null
+++ b/kernel/comps/rtw89/src/rtw8852bt_rfk.rs
@@ -0,0 +1,1118 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The RTL8852BT's calibrations on the host, as Linux's `rtw8852bt_rfk.c`
+//! runs them: the DAC's (DACK, at power on), the RX DC offset, the IQ
+//! imbalance (IQK by band: the LO leakage, TX and RX by gain groups), the
+//! digital predistortion (DPK, two tables taken in turn) and its thermal
+//! tracking; the TSSI is the RTL8852B's procedure with this chip's tables
+//! ([`rtw8852b_rfk::tssi`]). One channel context, both paths.
+
+use crate::{
+    chan::Chan,
+    fw::TxPowerTrack,
+    hal::{Hal, MASKBYTE0, MASKBYTE2, MASKBYTE3, MASKDWORD, MASKHWORD, MASKLWORD, RFREG_MASK},
+    mac::Tssi,
+    phy,
+    regs::*,
+    rtw8852b,
+    rtw8852b_rfk::{
+        self, CFIR_FAILED, CFIR_WIDE, DPK_GAIN_LOSS, DPK_GS_BB, DPK_GS_DEFAULT, DPK_KIP_PRESET, DPK_LBK_RXIQK, DPK_MDPK_IDL, DPK_PWSF, DPK_RXAGC, DPK_SYNC,
+        DPK_TXAGC, DPK_TXAGC_INVAL, DPK_TXAGC_LOWER, DPK_TXAGC_UPPER, NCTL_DONE, RFREG_MASKMODE, RFREG_MASKRXBB, TSSI_8852BT, Thermal, dpk_bypass_rxcfir,
+        dpk_dgain_mapping, dpk_gainloss_read, dpk_pas_compressed, dpk_sync_check, dpk_tpg_sel, wait_rx_mode,
+    },
+};
+
+/// The NCTL report's readiness.
+const REPORT_READY: u32 = 0x8000;
+/// `enum rf_mode`: RX.
+const RF_RX: u32 = 0x3;
+
+/// `enum dac_ck`, `enum adc_ck`.
+const DAC_160M: u32 = 3;
+const DAC_960M: u32 = 7;
+const ADC_480M: u32 = 1;
+const ADC_960M: u32 = 2;
+const ADC_1920M: u32 = 3;
+
+/// `rtw8852bt_backup_bb_regs`, `_rf_regs`, `_kip_regs`.
+const BACKUP_BB_REGS: [u32; 4] = [0x2344, 0x5800, 0x7800, 0x0704];
+const BACKUP_RF_REGS: [u32; 8] = [0xde, 0xdf, 0x8b, 0x90, 0x97, 0x85, 0x5, 0x10005];
+const BACKUP_KIP_REGS: [u32; 14] = [0x813c, 0x8124, 0x8120, 0xc0d4, 0xc0d8, 0xc0c4, 0xc0ec, 0x823c, 0x8224, 0x8220, 0xc1d4, 0xc1d8, 0xc1c4, 0xc1ec];
+
+fn backup(hal: &Hal, regs: &[u32]) -> alloc::vec::Vec<u32> {
+    regs.iter().map(|&reg| hal.phy_r32_mask(reg, MASKDWORD)).collect()
+}
+
+fn reload(hal: &Hal, regs: &[u32], values: &[u32]) {
+    for (&reg, &value) in regs.iter().zip(values) {
+        hal.phy_w32_mask(reg, MASKDWORD, value);
+    }
+}
+
+fn backup_rf(hal: &Hal, path: u8) -> [u32; 8] {
+    BACKUP_RF_REGS.map(|reg| hal.read_rf(path, reg, RFREG_MASK))
+}
+
+fn reload_rf(hal: &Hal, path: u8, values: &[u32; 8]) {
+    for (&reg, &value) in BACKUP_RF_REGS.iter().zip(values) {
+        hal.write_rf(path, reg, RFREG_MASK, value);
+    }
+}
+
+fn poll(done: impl Fn() -> bool, step_us: u64, timeout_us: u64) -> bool {
+    aster_linuxkpi::delay::read_poll_timeout(&done, |ok| *ok, step_us, timeout_us).is_ok()
+}
+
+/// `_txck_force`.
+fn txck_force(hal: &Hal, path: u8, force: bool, ck: u32) {
+    let reg = R_P0_RXCK | ((path as u32) << 13);
+    hal.phy_w32_mask(reg, B_P0_TXCK_ON, 0);
+    if force {
+        hal.phy_w32_mask(reg, B_P0_TXCK_VAL, ck);
+        hal.phy_w32_mask(reg, B_P0_TXCK_ON, 1);
+    }
+}
+
+/// `_rxck_force`: the ADC's clock, and the ADC set for its width.
+fn rxck_force(hal: &Hal, path: u8, force: bool, ck: u32) {
+    let reg = R_P0_RXCK | ((path as u32) << 13);
+    hal.phy_w32_mask(reg, B_P0_RXCK_ON, 0);
+    if !force {
+        return;
+    }
+    hal.phy_w32_mask(reg, B_P0_RXCK_VAL, ck);
+    hal.phy_w32_mask(reg, B_P0_RXCK_ON, 1);
+    let bw: u8 = match ck {
+        ADC_480M => 1,
+        ADC_960M => 2,
+        ADC_1920M => 3,
+        _ => 0,
+    };
+    rtw8852b::adc_cfg_8852bt(hal, bw, path as u32);
+}
+
+/// `_rfk_bb_afe_setting`: the baseband's clocks and the AFE forced for a
+/// calibration.
+fn bb_afe_setting(hal: &Hal) {
+    hal.phy_w32_mask(R_ADC_FIFO, MASKHWORD, 0x0303);
+    hal.phy_w32_mask(R_P0_ADCFF_EN, B_P0_ADCFF_EN, 1);
+    hal.phy_w32_mask(R_P1_ADCFF_EN, B_P1_ADCFF_EN, 1);
+    hal.phy_w32_mask(R_P0_RFCTM, B_P0_CLKG_FORCE, 0x3);
+    hal.phy_w32_mask(R_P1_RFCTM, B_P1_CLKG_FORCE, 0x3);
+    hal.phy_w32_mask(R_TXCKEN_FORCE, B_TXCKEN_FORCE_ALL, 0x1ffffff);
+    hal.phy_w32_mask(R_FAHM, B_RXTD_CKEN, 1);
+    hal.phy_w32_mask(R_UPD_CLK_ADC, B_UPD_GEN_ON, 1);
+    hal.phy_w32_mask(R_TX_COLLISION_T2R_ST, B_TXRX_FORCE_VAL, 0x3ff);
+    hal.phy_w32_mask(R_IOQ_IQK_DPK, B_IOQ_IQK_DPK_CLKEN, 0x3);
+    hal.phy_w32_mask(R_IQK_DPK_RST, B_IQK_DPK_RST, 1);
+    hal.phy_w32_mask(R_P0_PATH_RST, B_P0_PATH_RST, 1);
+    hal.phy_w32_mask(R_P1_PATH_RST, B_P1_PATH_RST, 1);
+    hal.phy_w32_mask(R_PD_CTRL, B_PD_HIT_DIS, 1);
+    hal.phy_w32_mask(R_RXCCA, B_RXCCA_DIS, 1);
+    hal.phy_w32_mask(R_DCFO_WEIGHT, B_DAC_CLK_IDX, 1);
+    txck_force(hal, 0, true, DAC_960M);
+    txck_force(hal, 1, true, DAC_960M);
+    rxck_force(hal, 0, true, ADC_1920M);
+    rxck_force(hal, 1, true, ADC_1920M);
+    hal.phy_w32_mask(R_UPD_CLK_ADC, B_UPD_CLK_ADC_VAL | B_UPD_CLK_ADC_ON, 0x5);
+    hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_DBG, 1);
+    hal.phy_w32_mask(R_P1_DBGMOD, B_P1_DBGMOD_ON, 1);
+    hal.phy_w32_mask(R_ANAPAR_PW15, MASKBYTE3, 0x1f);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_ANAPAR_PW15, MASKBYTE3, 0x13);
+    hal.phy_w32_mask(R_ANAPAR, MASKHWORD, 0x0001);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_ANAPAR, MASKHWORD, 0x0041);
+    hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_RSTB, 1);
+    hal.phy_w32_mask(R_ADC_FIFO, MASKHWORD, 0x3333);
+    hal.phy_w32_mask(R_TXPWRB_H, B_TXPWRB_RDY, 1);
+    hal.phy_w32_mask(R_DPD_OFT_EN, MASKLWORD, 0x0000);
+    hal.phy_w32_mask(R_P1_TXPW_FORCE, B_P1_TXPW_RDY, 1);
+    hal.phy_w32_mask(R_P1_TXAGC_TH, MASKLWORD, 0x0000);
+}
+
+/// `_rfk_bb_afe_restore`.
+fn bb_afe_restore(hal: &Hal) {
+    hal.phy_w32_mask(R_ADC_FIFO, MASKHWORD, 0x0303);
+    hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_DBG, 0);
+    hal.phy_w32_mask(R_P1_DBGMOD, B_P1_DBGMOD_ON, 0);
+    hal.phy_w32_mask(R_P0_RFCTM, B_P0_CLKG_FORCE, 0);
+    hal.phy_w32_mask(R_P1_RFCTM, B_P1_CLKG_FORCE, 0);
+    hal.phy_w32_mask(R_TXCKEN_FORCE, B_TXCKEN_FORCE_ALL, 0);
+    hal.phy_w32_mask(R_FAHM, B_RXTD_CKEN, 0);
+    hal.phy_w32_mask(R_UPD_CLK_ADC, B_UPD_GEN_ON, 0);
+    hal.phy_w32_mask(R_TX_COLLISION_T2R_ST, B_TXRX_FORCE_VAL, 0x63);
+    hal.phy_w32_mask(R_P0_RXCK, B_P0_TXCK_ALL, 0);
+    hal.phy_w32_mask(R_P1_RXCK, B_P1_TXCK_ALL, 0);
+    hal.phy_w32_mask(R_UPD_CLK_ADC, B_UPD_CLK_ADC_VAL | B_UPD_CLK_ADC_ON, 0);
+    hal.phy_w32_mask(R_ADC_FIFO, MASKHWORD, 0x0000);
+    hal.phy_w32_mask(R_P0_ADCFF_EN, B_P0_ADCFF_EN, 0);
+    hal.phy_w32_mask(R_P1_ADCFF_EN, B_P1_ADCFF_EN, 0);
+    hal.phy_w32_mask(R_PD_CTRL, B_PD_HIT_DIS, 0);
+    hal.phy_w32_mask(R_TXPWRB_H, B_TXPWRB_RDY, 0);
+    hal.phy_w32_mask(R_P0_TSSI_MV_AVG, B_P0_TXPW_RSTB, 0x1);
+    hal.phy_w32_mask(R_P0_TSSI_MV_AVG, B_P0_TXPW_RSTB, 0x2);
+    hal.phy_w32_mask(R_P1_TXPW_FORCE, B_P1_TXPW_RDY, 0);
+    hal.phy_w32_mask(R_P1_TSSI_MV_AVG, B_P1_TXPW_RSTB, 0x1);
+    hal.phy_w32_mask(R_P1_TSSI_MV_AVG, B_P1_TXPW_RSTB, 0x2);
+}
+
+/// What the RTL8852BT's calibrations keep.
+#[derive(Default)]
+pub(crate) struct State {
+    pub(crate) tssi_mode: [bool; 2],
+    thermal: Thermal,
+    iqk: [IqkPath; 2],
+    dpk: Dpk,
+}
+
+#[derive(Clone, Copy, Default)]
+struct IqkPath {
+    band: u8,
+    bw: u8,
+    nb_txcfir: u32,
+    nb_rxcfir: u32,
+}
+
+#[derive(Clone, Copy, Default)]
+struct DpkResult {
+    band: u8,
+    ch: u8,
+    bw: u8,
+    ok: bool,
+    ther_dpk: u32,
+    pwsf: u32,
+}
+
+/// `struct rtw89_dpk_info`: two tables a path, the one in use, the DPD's
+/// order, the backoff, the TX gain's ceiling.
+#[derive(Default)]
+struct Dpk {
+    enabled: bool,
+    bp: [[DpkResult; 2]; 2],
+    cur: [usize; 2],
+    order: [u32; 2],
+    gs: u32,
+    max_txagc: [u32; 2],
+}
+
+// ---- DACK. ----
+
+/// `_drck`.
+fn drck(hal: &Hal) {
+    hal.phy_w32_mask(R_DRCK, B_DRCK_EN, 1);
+    poll(|| hal.phy_r32_mask(R_DRCK_RES, B_DRCK_POL) != 0, 1, 10_000);
+    hal.phy_w32_mask(R_DRCK, B_DRCK_EN, 0);
+    hal.phy_w32_mask(R_DRCK_FH, B_DRCK_LAT, 1);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_DRCK_FH, B_DRCK_LAT, 0);
+    let rck_d = hal.phy_r32_mask(R_DRCK_RES, 0x7c00);
+    hal.phy_w32_mask(R_DRCK, B_DRCK_IDLE, 0);
+    hal.phy_w32_mask(R_DRCK, B_DRCK_VAL, rck_d);
+}
+
+/// A path's DAC results (`struct rtw89_dack_info`): the MSB codes of both
+/// halves, their bias and DADCK.
+#[derive(Default)]
+struct DackPath {
+    msbk: [[u32; 16]; 2],
+    biask: [u32; 2],
+    dadck: [u32; 2],
+}
+
+/// `_dack_reload_by_path` of both halves: the results back in the
+/// registers the DAC takes them from.
+fn dack_reload(hal: &Hal, path: u8, d: &DackPath) {
+    for index in 0..2usize {
+        let offset = if index == 0 { 0 } else { 0x14 } + if path == 0 { 0 } else { 0x28 };
+        hal.phy_w32_mask(R_DCOF1, B_DCOF1_RST, 1);
+        hal.phy_w32_mask(R_DCOF9, B_DCOF9_RST, 1);
+        hal.phy_w32_mask(R_DACK1_K, B_DACK1_RST, 1);
+        hal.phy_w32_mask(R_DACK2_K, B_DACK2_RST, 1);
+        for (word, first) in [12usize, 8, 4, 0].into_iter().enumerate() {
+            let value = (0..4).fold(0u32, |value, i| value | (d.msbk[index][first + i] << (i * 8)));
+            hal.phy_w32(0xc200 + offset + 4 * word as u32, value);
+        }
+        hal.phy_w32(0xc210 + offset, (d.biask[index] << 22) | (d.dadck[index] << 14));
+        hal.phy_w32_mask(R_DACKN0_CTL + offset, B_DACKN0_EN, 1);
+    }
+}
+
+/// `_dack_s0` and `_dack_s1`: a path's DAC calibrated at 160 MHz, its
+/// results kept and reloaded.
+fn dack_path(hal: &Hal, path: u8) {
+    let a = path == 0;
+    txck_force(hal, path, true, DAC_160M);
+    if a {
+        hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_DBG, 1);
+    } else {
+        hal.phy_w32_mask(R_P1_DBGMOD, B_P1_DBGMOD_ON, 1);
+    }
+    hal.phy_w32_mask(R_ANAPAR_PW15, 1 << 28, 1);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_EN1, 0);
+    crate::delay_us(100);
+    if a {
+        hal.phy_w32_mask(R_DCOF1, B_DCOF1_VAL, 0x30);
+        hal.phy_w32_mask(R_DCOF9, B_DCOF9_VAL, 0x30);
+        hal.phy_w32_mask(R_DCOF0, B_DCOF0_RST, 0);
+        hal.phy_w32_mask(R_DCOF0, B_DCOF0_RST, 1);
+        hal.phy_w32_mask(R_DCOF1, B_DCOF1_S, 1);
+    } else {
+        hal.phy_w32_mask(R_DACK1_K, B_DACK1_VAL, 0x30);
+        hal.phy_w32_mask(R_DACK2_K, B_DACK2_VAL, 0x30);
+        hal.phy_w32_mask(R_DACK10, B_DACK10_RST, 0);
+        hal.phy_w32_mask(R_DACK10, B_DACK10_RST, 1);
+        hal.phy_w32_mask(R_DACK1_K, B_DACK1_EN, 1);
+    }
+    crate::delay_us(1);
+    let ok = |reg, mask| hal.phy_r32_mask(reg, mask) != 0;
+    if a {
+        poll(|| ok(R_DACK_S0P0, B_DACK_S0P0_OK) && ok(R_DACK_S0P1, B_DACK_S0P1_OK) && ok(R_DACK_S0P2, B_DACK_S0P2_OK) && ok(R_DACK_S0P3, B_DACK_S0P3_OK), 1, 20_000);
+        hal.phy_w32_mask(R_DCOF1, B_DCOF1_S, 0);
+    } else {
+        poll(|| ok(R_DACK_S1P0, B_DACK_S1P0_OK) && ok(R_DACK_S1P1, B_DACK_S1P1_OK) && ok(R_DACK_S1P2, B_DACK_S1P2_OK) && ok(R_DACK_S1P3, B_DACK_S1P3_OK), 1, 10_000);
+        hal.phy_w32_mask(R_DACK1_K, B_DACK1_EN, 0);
+    }
+    txck_force(hal, path, false, DAC_960M);
+    // `_dack_backup_s0`/`_s1`.
+    let mut d = DackPath::default();
+    for i in 0..16u32 {
+        if a {
+            hal.phy_w32_mask(R_DCOF0, B_DCOF0_V, i);
+            d.msbk[0][i as usize] = hal.phy_r32_mask(R_DACK_S0P2, B_DACK_S0M0);
+            hal.phy_w32_mask(R_DCOF8, B_DCOF8_V, i);
+            d.msbk[1][i as usize] = hal.phy_r32_mask(R_DACK_S0P3, B_DACK_S0M1);
+        } else {
+            hal.phy_w32_mask(R_DACK10, B_DACK10, i);
+            d.msbk[0][i as usize] = hal.phy_r32_mask(R_DACK10S, B_DACK10S);
+            hal.phy_w32_mask(R_DACK11, B_DACK11, i);
+            d.msbk[1][i as usize] = hal.phy_r32_mask(R_DACK11S, B_DACK11S);
+        }
+    }
+    if a {
+        d.biask = [hal.phy_r32_mask(R_DACK_BIAS00, B_DACK_BIAS00), hal.phy_r32_mask(R_DACK_BIAS01, B_DACK_BIAS01)];
+        d.dadck = [hal.phy_r32_mask(R_DACK_DADCK00, B_DACK_DADCK00), hal.phy_r32_mask(R_DACK_DADCK01, B_DACK_DADCK01)];
+    } else {
+        d.biask = [hal.phy_r32_mask(R_DACK_BIAS10, B_DACK_BIAS10), hal.phy_r32_mask(R_DACK_BIAS11, B_DACK_BIAS11)];
+        d.dadck = [hal.phy_r32_mask(R_DACK_DADCK10, B_DACK_DADCK10), hal.phy_r32_mask(R_DACK_DADCK11, B_DACK_DADCK11)];
+    }
+    dack_reload(hal, path, &d);
+    if a {
+        hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_DBG, 0);
+    } else {
+        hal.phy_w32_mask(R_P1_DBGMOD, B_P1_DBGMOD_ON, 0);
+    }
+}
+
+/// `_addck_ori` of a path: the ADC's DC offsets.
+fn addck_path(hal: &Hal, path: u8) -> [u32; 2] {
+    let (ck, trg, en, dly, result, a0, a1) = if path == 0 {
+        (R_ADDCK0, B_ADDCK0_TRG, B_ADDCK0, R_PATH0_SAMPL_DLY_T_V1, R_ADDCKR0, B_ADDCKR0_A0, B_ADDCKR0_A1)
+    } else {
+        (R_ADDCK1, B_ADDCK1_TRG, B_ADDCK1, R_PATH1_SAMPL_DLY_T_V1, R_ADDCKR1, B_ADDCKR1_A0, B_ADDCKR1_A1)
+    };
+    if path == 0 {
+        hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_DBG, 1);
+    } else {
+        hal.phy_w32_mask(R_P1_DBGMOD, B_P1_DBGMOD_ON, 1);
+    }
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_ADCCLK, 0);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_FLTRST, 0);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_FLTRST, 1);
+    hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15_H, 0xf);
+    crate::delay_us(100);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_EN, 0);
+    hal.phy_w32_mask(dly, 1 << 4, 1);
+    hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15_H, 0x3);
+    hal.phy_w32_mask(ck, trg, 1);
+    hal.phy_w32_mask(ck, trg, 0);
+    crate::delay_us(1);
+    hal.phy_w32_mask(ck, en, 1);
+    poll(|| hal.phy_r32_mask(result, 1 << 0) != 0, 1, 10_000);
+    hal.phy_w32_mask(dly, 1 << 4, 0);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_EN, 1);
+    hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15_H, 0xc);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_ADCCLK, 1);
+    hal.phy_w32_mask(ck, en, 0);
+    let values = [hal.phy_r32_mask(result, a0), hal.phy_r32_mask(result, a1)];
+    if path == 0 {
+        hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_DBG, 0);
+    } else {
+        hal.phy_w32_mask(R_P1_DBGMOD, B_P1_DBGMOD_ON, 0);
+    }
+    values
+}
+
+/// `_dac_cal` of the RTL8852BT (`rtw8852bt_dack`): the RC clock, manual
+/// results off, the ADC's offsets at 960 MHz, then each path's DAC.
+pub(crate) fn dac_cal(hal: &Hal) {
+    drck(hal);
+    // `_dack_manual_off`.
+    hal.phy_w32_mask(R_ADDCK0_RL, B_ADDCK0_RLS, 0);
+    hal.phy_w32_mask(R_ADDCK1_RL, B_ADDCK1_RLS, 0);
+    hal.phy_w32_mask(R_DACKN0_CTL, B_DACKN0_EN, 0);
+    hal.phy_w32_mask(R_DACKN1_CTL, B_DACKN1_ON, 0);
+    hal.phy_w32_mask(R_DACKN2_CTL, B_DACKN2_ON, 0);
+    hal.phy_w32_mask(R_DACKN3_CTL, B_DACKN3_ON, 0);
+    for path in 0..2u8 {
+        hal.write_rf(path, RR_RSV1, RFREG_MASK, 0);
+    }
+    for path in 0..2u8 {
+        hal.write_rf(path, RR_MOD, RFREG_MASK, 0x337e1);
+    }
+    rxck_force(hal, 0, true, ADC_960M);
+    rxck_force(hal, 1, true, ADC_960M);
+    hal.phy_w32_mask(R_ADDCK0, B_ADDCK0_MAN, 0);
+    hal.phy_w32_mask(R_ADDCK1, B_ADDCK1_MAN, 0);
+    let a = addck_path(hal, 0);
+    let b = addck_path(hal, 1);
+    rxck_force(hal, 0, false, ADC_960M);
+    rxck_force(hal, 1, false, ADC_960M);
+    // `_addck_reload`.
+    hal.phy_w32_mask(R_ADDCK0_RL, B_ADDCK0_RL1, a[0]);
+    hal.phy_w32_mask(R_ADDCK0_RL, B_ADDCK0_RL0, a[1]);
+    hal.phy_w32_mask(R_ADDCK0_RL, B_ADDCK0_RLS, 0x3);
+    hal.phy_w32_mask(R_ADDCK1_RL, B_ADDCK1_RL1, b[0]);
+    hal.phy_w32_mask(R_ADDCK1_RL, B_ADDCK1_RL0, b[1]);
+    hal.phy_w32_mask(R_ADDCK1_RL, B_ADDCK1_RLS, 0x3);
+    for path in 0..2u8 {
+        hal.write_rf(path, RR_MODOPT, RFREG_MASK, 0);
+    }
+    dack_path(hal, 0);
+    dack_path(hal, 1);
+    for path in 0..2u8 {
+        hal.write_rf(path, RR_RSV1, RFREG_MASK, 1);
+    }
+}
+
+// ---- IQK. ----
+
+/// `_iqk_check_cal`: whether the NCTL's report did not come.
+fn iqk_check_cal(hal: &Hal) -> bool {
+    poll(|| hal.phy_r32_mask(R_RFK_ST, MASKBYTE0) == NCTL_DONE, 10, 8200);
+    crate::delay_us(10);
+    let not_ready = !poll(|| hal.phy_r32_mask(R_RPT_COM, B_RPT_COM_RDY) == REPORT_READY, 10, 400);
+    crate::delay_us(10);
+    hal.phy_w32_mask(R_NCTL_N1, MASKBYTE0, 0);
+    not_ready
+}
+
+/// `enum rtw8852bt_iqk_type`, the one-shots the host starts.
+#[derive(Clone, Copy)]
+enum Iqk {
+    Txk,
+    Rxagc,
+    Rxk,
+    Nbtxk,
+    Nbrxk,
+}
+
+/// `_iqk_one_shot`: the NCTL's command for the kind (TX and RX with the
+/// width in it), whether its report did not come.
+fn iqk_one_shot(hal: &Hal, path: u8, kind: Iqk, bw: u8) -> bool {
+    let (p, bw) = (path as u32, bw as u32);
+    let cmd = match kind {
+        Iqk::Txk => 0x008 | (1 << (p + 4)) | (((0x8 + bw) & 0xf) << 8),
+        Iqk::Rxagc => 0x508 | (1 << (4 + p)) | (p << 1),
+        Iqk::Rxk => 0x008 | (1 << (p + 4)) | (((0xb + bw) & 0xf) << 8),
+        Iqk::Nbtxk => 0x408 | (1 << (4 + p)),
+        Iqk::Nbrxk => 0x608 | (1 << (4 + p)),
+    };
+    hal.phy_w32_mask(R_NCTL_CFG, MASKDWORD, cmd + 1);
+    iqk_check_cal(hal)
+}
+
+/// `_iqk_txk_setting`.
+fn iqk_txk_setting(hal: &Hal, path: u8, two_g: bool) {
+    if two_g {
+        hal.write_rf(path, RR_TXG1, RR_TXG1_ATT2, 0);
+        hal.write_rf(path, RR_TXG1, RR_TXG1_ATT1, 0);
+        hal.write_rf(path, RR_TXG2, RR_TXG2_ATT0, 1);
+    } else {
+        hal.write_rf(path, RR_BIASA, RR_BIASA_A, 1);
+    }
+    hal.write_rf(path, RR_TXGA, RR_TXGA_LOK_EXT, 0);
+    hal.write_rf(path, RR_LUTWE, RR_LUTWE_LOK, 1);
+    hal.write_rf(path, RR_LUTWA, RR_LUTWA_M1, if two_g { 0x00 } else { 0x80 });
+    hal.write_rf(path, RR_MOD, RR_MOD_IQK, 0x403e);
+    hal.write_rf(path, RR_TXIG, RR_TXIG_GR0, 0);
+    hal.write_rf(path, RR_TXIG, RR_TXIG_GR1, if two_g { 0x5 } else { 0x4 });
+    crate::delay_us(1);
+}
+
+/// `_iqk_2g_lok`, `_iqk_5g_lok` (the same steps): coarse, buffer, fine,
+/// buffer; Linux takes none as failed.
+fn iqk_lok(hal: &Hal, path: u8) -> bool {
+    let iqp = R_KIP_IQP + ((path as u32) << 8);
+    let p = (path as u32) << 4;
+    for (tg, iqsw, cmd) in [(0x0, 0x09, 0x119), (0x12, 0x24, 0x319), (0x0, 0x09, 0x219), (0x12, 0x24, 0x319)] {
+        hal.write_rf(path, RR_TXIG, RR_TXIG_TG, tg);
+        hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 1);
+        hal.phy_w32_mask(iqp, B_KIP_IQP_IQSW, iqsw);
+        if cmd == 0x119 {
+            hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_TXT, 0x021);
+        }
+        hal.phy_w32_mask(R_NCTL_CFG, MASKDWORD, cmd + p);
+        let _ = iqk_check_cal(hal);
+        hal.phy_w32_mask(R_NCTL_N1, B_NCTL_N1_CIP, 0);
+        hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 0);
+    }
+    false
+}
+
+/// `_iqk_2g_tx`, `_iqk_5g_tx`: four groups, narrow then wide band.
+fn iqk_tx(hal: &Hal, state: &mut IqkPath, path: u8) -> bool {
+    let two_g = state.band == phy::BAND_2G;
+    const G_TRACK: [u32; 4] = [0x4, 0x4, 0x6, 0x6];
+    const G_GAIN: [u32; 4] = [0x08, 0x0e, 0x08, 0x0e];
+    const A_TRACK: [u32; 4] = [0x3, 0x3, 0x6, 0x6];
+    const A_GAIN: [u32; 4] = [0x08, 0x10, 0x08, 0x0e];
+    const ITQT: [u32; 4] = [0x09, 0x12, 0x1b, 0x24];
+    let p = (path as u32) << 8;
+    let mut not_ready = false;
+    for group in 0..4usize {
+        hal.write_rf(path, RR_TXIG, RR_TXIG_GR0, 0);
+        hal.write_rf(path, RR_TXIG, RR_TXIG_GR1, if two_g { G_TRACK[group] } else { A_TRACK[group] });
+        hal.write_rf(path, RR_TXIG, RR_TXIG_TG, if two_g { G_GAIN[group] } else { A_GAIN[group] });
+        if !two_g {
+            hal.phy_w32_mask(R_KIP_IQP + p, MASKDWORD, ITQT[group]);
+        }
+        hal.phy_w32_mask(R_CFIR_LUT + p, 0x100, 1);
+        hal.phy_w32_mask(R_CFIR_LUT + p, 0x010, 1);
+        hal.phy_w32_mask(R_CFIR_LUT + p, 0x004, 0);
+        hal.phy_w32_mask(R_CFIR_LUT + p, 0x003, group as u32);
+        hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_TXT, 0x009);
+        hal.phy_w32_mask(R_KIP_IQP + p, B_KIP_IQP_IQSW, ITQT[group]);
+        let _ = iqk_one_shot(hal, path, Iqk::Nbtxk, state.bw);
+        state.nb_txcfir = hal.phy_r32_mask(R_TXIQC + p, MASKDWORD);
+        hal.phy_w32_mask(R_KIP_IQP + p, B_KIP_IQP_IQSW, ITQT[group]);
+        not_ready = iqk_one_shot(hal, path, Iqk::Txk, state.bw);
+        hal.phy_w32_mask(R_NCTL_N1, B_NCTL_N1_CIP, 0);
+    }
+    let failed = !not_ready && hal.phy_r32_mask(R_NCTL_RPT, B_NCTL_RPT_FLG) != 0;
+    if failed {
+        state.nb_txcfir = CFIR_FAILED;
+        hal.phy_w32_mask(R_IQK_RES + p, B_IQK_RES_TXCFIR, 0);
+    }
+    failed
+}
+
+/// `_iqk_rxclk_setting`: the ADC at 960 or 480 MHz for the width.
+fn iqk_rxclk_setting(hal: &Hal, bw: u8) {
+    let eighty = bw == 2;
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RXK, 0x0303);
+    let ck = if eighty { ADC_960M } else { ADC_480M };
+    rxck_force(hal, 0, true, ck);
+    rxck_force(hal, 1, true, ck);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_UPD_CLK_ADC, B_UPD_CLK_ADC_ON, 1);
+    hal.phy_w32_mask(R_UPD_CLK_ADC, B_UPD_CLK_ADC_VAL, eighty as u32);
+    let (dly, sel) = if eighty { (0x2, 0x8) } else { (0x3, 0xf) };
+    hal.phy_w32_mask(R_PATH0_SAMPL_DLY_T_V1, B_PATH0_SAMPL_DLY_T_MSK_V1, dly);
+    hal.phy_w32_mask(R_PATH1_SAMPL_DLY_T_V1, B_PATH1_SAMPL_DLY_T_MSK_V1, dly);
+    hal.phy_w32_mask(R_P0_CFCH_BW1, B_P0_CFCH_BW1, sel);
+    hal.phy_w32_mask(R_PATH1_BW_SEL_V1, B_PATH1_BW_SEL_MSK_V1, sel);
+    hal.phy_w32_mask(R_PATH0_SAMPL_DLY_T_V1, 0x0000_0780, 0x8);
+    hal.phy_w32_mask(R_PATH1_SAMPL_DLY_T_V1, 0x0000_0780, 0x8);
+    hal.phy_w32_mask(R_PATH0_SAMPL_DLY_T_V1, 0x0000_7800, 0x2);
+    hal.phy_w32_mask(R_PATH1_SAMPL_DLY_T_V1, 0x0000_7800, 0x2);
+    hal.phy_w32_mask(R_DRCK, B_DRCK_MUL, 0);
+    hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_DBG, 1);
+    hal.phy_w32_mask(R_P1_DBGMOD, B_P1_DBGMOD_ON, 1);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15, 0x0f);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15, 0x03);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_15, 0xa001);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_15, 0xa041);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RXK, 0x3333);
+}
+
+/// `_iqk_2g_rx`, `_iqk_5g_rx`: two groups, the RX AGC, narrow then wide.
+fn iqk_rx(hal: &Hal, state: &mut IqkPath, path: u8) -> bool {
+    let two_g = state.band == phy::BAND_2G;
+    const G_RXGAIN: [u32; 2] = [0x212, 0x310];
+    const G_ATTC2: [u32; 2] = [0x00, 0x20];
+    const G_ATTC1: [u32; 2] = [0x3, 0x2];
+    const G_RXAGC: [u32; 2] = [0x0, 0x2];
+    const A_RXGAIN: [u32; 2] = [0x110, 0x290];
+    const A_ATTC2: [u32; 2] = [0x0f, 0x0f];
+    const A_ATTC1: [u32; 2] = [0x2, 0x2];
+    const A_RXAGC: [u32; 2] = [0x4, 0x6];
+    const IDX: [u32; 2] = [0x0, 0x2];
+    let p = (path as u32) << 8;
+    hal.write_rf(path, RR_MOD, RR_MOD_MASK, 0xc);
+    hal.write_rf(path, RR_RXK, if two_g { RR_RXK_SEL2G } else { RR_RXK_SEL5G }, 1);
+    let rf18 = hal.read_rf(path, RR_CFGCH, RFREG_MASK);
+    hal.write_rf(path, RR_RSV4, RFREG_MASK, rf18);
+    let mut not_ready = false;
+    for group in 0..2usize {
+        if two_g {
+            hal.write_rf(path, RR_MOD, RR_MOD_RGM, G_RXGAIN[group]);
+            hal.write_rf(path, RR_RXBB, RR_RXBB_C2G, G_ATTC2[group]);
+            hal.write_rf(path, RR_RXBB, RR_RXBB_C1G, G_ATTC1[group]);
+        } else {
+            hal.write_rf(path, RR_MOD, RR_MOD_RGM, A_RXGAIN[group]);
+            hal.write_rf(path, RR_RXA2, RR_RXA2_HATT, A_ATTC2[group]);
+            hal.write_rf(path, RR_RXA2, RR_RXA2_CC2, A_ATTC1[group]);
+        }
+        hal.phy_w32_mask(R_CFIR_LUT + p, 0x100, 1);
+        hal.phy_w32_mask(R_CFIR_LUT + p, 0x010, 0);
+        hal.phy_w32_mask(R_CFIR_LUT + p, 0x007, IDX[group]);
+        hal.write_rf(path, RR_RXKPLL, RFREG_MASK, 0x80013);
+        crate::delay_us(200);
+        let mode = hal.read_rf(path, RR_MOD, RFREG_MASK);
+        hal.phy_w32_mask(R_IQK_DIF2, B_IQK_DIF2_RXPI, mode);
+        hal.phy_w32_mask(R_IQK_RXA, B_IQK_RXAGC, if two_g { G_RXAGC[group] } else { A_RXAGC[group] });
+        hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 1);
+        hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_RXT, 0x11);
+        let _ = iqk_one_shot(hal, path, Iqk::Rxagc, state.bw);
+        hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 0);
+        hal.write_rf(path, RR_RXKPLL, RFREG_MASK, 0x80013);
+        crate::delay_us(200);
+        hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 1);
+        hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_RXT, 0x011);
+        let _ = iqk_one_shot(hal, path, Iqk::Nbrxk, state.bw);
+        state.nb_rxcfir = hal.phy_r32_mask(R_RXIQC + p, MASKDWORD) | 0x2;
+        hal.phy_w32_mask(R_NCTL_N1, B_NCTL_N1_CIP, 0);
+        hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 0);
+        hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 1);
+        not_ready = iqk_one_shot(hal, path, Iqk::Rxk, state.bw);
+        hal.phy_w32_mask(R_NCTL_N1, B_NCTL_N1_CIP, 0);
+        hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 0);
+    }
+    let failed = !not_ready && hal.phy_r32_mask(R_NCTL_RPT, B_NCTL_RPT_FLG) != 0;
+    if failed {
+        // Linux keeps the TX one aside here (and the RX one as it was).
+        state.nb_txcfir = CFIR_FAILED;
+        hal.phy_w32_mask(R_IQK_RES + p, B_IQK_RES_RXCFIR, 0);
+    }
+    hal.write_rf(path, RR_RXK, RR_RXK_SEL2G, 0);
+    failed
+}
+
+/// `_iqk_macbb_setting`.
+fn iqk_macbb_setting(hal: &Hal) {
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RXK, 0x0303);
+    hal.phy_w32_mask(R_P0_RFCTM, B_P0_GOT_TXRX, 0x3);
+    hal.phy_w32_mask(R_P1_RFCTM, B_P1_GOT_TXRX, 0x3);
+    hal.phy_w32_mask(R_P0_ADCFF_EN, B_P0_ADCFF_EN, 1);
+    hal.phy_w32_mask(R_P1_ADCFF_EN, B_P1_ADCFF_EN, 1);
+    hal.phy_w32_mask(R_P0_RFCTM, B_P0_CLKG_FORCE, 0x3);
+    hal.phy_w32_mask(R_P1_RFCTM, B_P0_CLKG_FORCE, 0x3);
+    hal.phy_w32_mask(R_TXCKEN_FORCE, B_TXCKEN_FORCE_ALL, 0x1ffffff);
+    hal.phy_w32_mask(R_FAHM, B_RXTD_CKEN, 1);
+    hal.phy_w32_mask(R_UPD_CLK_ADC, B_UPD_GEN_ON, 1);
+    hal.phy_w32_mask(R_TX_COLLISION_T2R_ST, B_TXRX_FORCE_VAL, 0x3ff);
+    hal.phy_w32_mask(R_IOQ_IQK_DPK, B_IOQ_IQK_DPK_CLKEN, 0x3);
+    hal.phy_w32_mask(R_IQK_DPK_RST, B_IQK_DPK_RST, 1);
+    hal.phy_w32_mask(R_P0_PATH_RST, B_P0_PATH_RST, 1);
+    hal.phy_w32_mask(R_P1_PATH_RST, B_P1_PATH_RST, 1);
+    hal.phy_w32_mask(R_PD_CTRL, B_PD_HIT_DIS, 1);
+    hal.phy_w32_mask(R_RXCCA, B_RXCCA_DIS, 1);
+    hal.phy_w32_mask(R_DCFO_WEIGHT, B_DAC_CLK_IDX, 1);
+    txck_force(hal, 0, true, DAC_960M);
+    txck_force(hal, 1, true, DAC_960M);
+    rxck_force(hal, 0, true, ADC_1920M);
+    rxck_force(hal, 1, true, ADC_1920M);
+    hal.phy_w32_mask(R_UPD_CLK_ADC, B_UPD_CLK_ADC_ON, 1);
+    hal.phy_w32_mask(R_UPD_CLK_ADC, B_UPD_CLK_ADC_VAL, 0x2);
+    hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_DBG, 1);
+    hal.phy_w32_mask(R_P1_DBGMOD, B_P1_DBGMOD_ON, 1);
+    crate::delay_us(10);
+    hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15, 0x1f);
+    crate::delay_us(10);
+    hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15, 0x13);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_15, 0x0001);
+    crate::delay_us(10);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_15, 0x0041);
+    hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_RSTB, 1);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RXK, 0x3333);
+}
+
+/// `_iqk_afebb_restore`.
+fn iqk_afebb_restore(hal: &Hal) {
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RXK, 0x0303);
+    hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_DBG, 0);
+    hal.phy_w32_mask(R_P1_DBGMOD, B_P1_DBGMOD_ON, 0);
+    hal.phy_w32_mask(R_P0_RFCTM, B_P0_CLKG_FORCE, 0);
+    hal.phy_w32_mask(R_P1_RFCTM, B_P1_CLKG_FORCE, 0);
+    hal.phy_w32_mask(R_TXCKEN_FORCE, B_TXCKEN_FORCE_ALL, 0);
+    hal.phy_w32_mask(R_FAHM, B_RXTD_CKEN, 0);
+    hal.phy_w32_mask(R_UPD_CLK_ADC, B_UPD_GEN_ON, 0);
+    hal.phy_w32_mask(R_TX_COLLISION_T2R_ST, 0x0000_001f, 0x03);
+    hal.phy_w32_mask(R_TX_COLLISION_T2R_ST, 0x0000_03e0, 0x03);
+    hal.phy_w32_mask(R_P0_RXCK, B_P0_TXCK_ALL, 0);
+    hal.phy_w32_mask(R_P1_RXCK, B_P1_TXCK_ALL, 0);
+    hal.phy_w32_mask(R_UPD_CLK_ADC, B_UPD_CLK_ADC_VAL | B_UPD_CLK_ADC_ON, 0);
+    hal.phy_w32_mask(R_PD_CTRL, B_PD_HIT_DIS, 0);
+    hal.phy_w32_mask(R_RXCCA, B_RXCCA_DIS, 0);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RXK, 0x0000);
+    hal.phy_w32_mask(R_P0_ADCFF_EN, B_P0_ADCFF_EN, 0);
+    hal.phy_w32_mask(R_P1_ADCFF_EN, B_P1_ADCFF_EN, 0);
+}
+
+/// `_doiqk` of a path.
+fn doiqk(hal: &Hal, state: &mut IqkPath, path: u8, chan: &Chan) {
+    state.band = chan.band;
+    state.bw = chan.bw;
+    let p = (path as u32) << 8;
+    let bb = backup(hal, &BACKUP_BB_REGS);
+    let rf = backup_rf(hal, path);
+    iqk_macbb_setting(hal);
+    // `_iqk_preset`: table 0.
+    hal.phy_w32_mask(R_COEF_SEL + p, 0x1, 0);
+    hal.phy_w32_mask(R_CFIR_LUT + p, 0x8, 0);
+    hal.phy_w32_mask(R_TXIQC + p, MASKDWORD, CFIR_WIDE);
+    hal.phy_w32_mask(R_RXIQC + p, MASKDWORD, CFIR_WIDE);
+    hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 0);
+    hal.write_rf(path, RR_BBDC, RR_BBDC_SEL, 0);
+    hal.phy_w32_mask(R_NCTL_RPT, MASKDWORD, 0x0000_0080);
+    hal.phy_w32_mask(R_KIP_SYSCFG, MASKDWORD, 0x81ff_010a);
+    // `_iqk_by_path`.
+    let two_g = chan.band == phy::BAND_2G;
+    let mut lok_failed = false;
+    for _ in 0..3 {
+        iqk_txk_setting(hal, path, two_g);
+        lok_failed = iqk_lok(hal, path);
+        if !lok_failed {
+            break;
+        }
+    }
+    if lok_failed {
+        for reg in [RR_DTXLOK, RR_RSV2, RR_LOKVB] {
+            hal.write_rf(path, reg, RFREG_MASK, 0x80200);
+        }
+    }
+    let _ = iqk_tx(hal, state, path);
+    iqk_rxclk_setting(hal, chan.bw);
+    // `_iqk_adc_fifo_rst`.
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RXK, 0x0303);
+    crate::delay_us(10);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RXK, 0x3333);
+    let _ = iqk_rx(hal, state, path);
+    // `_iqk_restore` (wide band).
+    hal.phy_w32_mask(R_TXIQC + p, MASKDWORD, CFIR_WIDE);
+    hal.phy_w32_mask(R_RXIQC + p, MASKDWORD, CFIR_WIDE);
+    hal.phy_w32_mask(R_NCTL_CFG, MASKDWORD, 0x0000_0e19 + ((path as u32) << 4));
+    let _ = iqk_check_cal(hal);
+    hal.phy_w32_mask(R_NCTL_N1, B_NCTL_N1_CIP, 0);
+    hal.phy_w32_mask(R_NCTL_RPT, MASKDWORD, 0);
+    hal.phy_w32_mask(R_KIP_SYSCFG, MASKDWORD, 0x8000_0000);
+    hal.phy_w32_mask(R_KIP_CLK, MASKDWORD, 0);
+    hal.phy_w32_mask(R_IQRSN, B_IQRSN_K2, 0);
+    hal.phy_w32_mask(R_CFIR_SYS + p, 1 << 28, 0);
+    hal.write_rf(path, RR_LUTWE, RR_LUTWE_LOK, 0);
+    hal.write_rf(path, RR_LUTWE, RR_LUTWE_LOK, 0);
+    hal.write_rf(path, RR_MOD, RR_MOD_MASK, 0x3);
+    hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 1);
+    hal.write_rf(path, RR_BBDC, RR_BBDC_SEL, 1);
+    iqk_afebb_restore(hal);
+    reload(hal, &BACKUP_BB_REGS, &bb);
+    reload_rf(hal, path, &rf);
+}
+
+/// `rtw8852bt_iqk`.
+fn iqk(hal: &Hal, state: &mut State, chan: &Chan) {
+    crate::sta::stop_sch_tx(hal, true);
+    wait_rx_mode(hal);
+    hal.phy_w32_mask(R_IQKINF, MASKDWORD, 0);
+    for path in 0..2u8 {
+        doiqk(hal, &mut state.iqk[path as usize], path, chan);
+    }
+    crate::sta::stop_sch_tx(hal, false);
+}
+
+// ---- DPK. ----
+
+/// The DPD's switch in a table's configuration.
+const DPD_ON: u32 = 1 << 24;
+
+/// `_dpk_onoff`.
+fn dpk_onoff(hal: &Hal, dpk: &Dpk, path: u8, off: bool) {
+    let kidx = dpk.cur[path as usize];
+    let on = dpk.enabled && !off && dpk.bp[path as usize][kidx].ok;
+    hal.phy_w32_mask(R_DPD_CH0A + ((path as u32) << 8) + ((kidx as u32) << 2), DPD_ON, on as u32);
+}
+
+/// `_dpk_one_shot`.
+fn dpk_one_shot(hal: &Hal, path: u8, id: u32) {
+    hal.phy_w32_mask(R_NCTL_CFG, MASKDWORD, (id << 8) | (0x19 + ((path as u32) << 4)));
+    poll(|| hal.phy_r32_mask(R_RFK_ST, MASKBYTE0) == NCTL_DONE, 1, 30_000);
+    crate::delay_us(1);
+    hal.phy_w32_mask(R_KIP_RPT1, MASKDWORD, 0x0003_0000);
+    poll(|| hal.phy_r32_mask(R_RPT_COM, MASKLWORD) == REPORT_READY, 1, 2000);
+    hal.phy_w32_mask(R_NCTL_N1, MASKBYTE0, 0);
+}
+
+/// `_dpk_lbk_rxiqk`.
+fn dpk_lbk_rxiqk(hal: &Hal, path: u8, rxbb: u32, rf18: u32) {
+    let p = (path as u32) << 8;
+    hal.phy_w32_mask(R_MDPK_RX_DCK, B_MDPK_RX_DCK_EN, 1);
+    hal.phy_w32_mask(R_IQK_RES + p, B_IQK_RES_RXCFIR, 0);
+    hal.write_rf(path, RR_RSV4, RFREG_MASK, rf18);
+    hal.write_rf(path, RR_MOD, RFREG_MASKMODE, 0xd);
+    hal.write_rf(path, RR_RXK, RR_RXK_PLLEN, 1);
+    let att = if rxbb >= 0x11 {
+        0x13
+    } else if rxbb <= 0xa {
+        0x00
+    } else {
+        0x05
+    };
+    hal.write_rf(path, RR_TXIQK, RR_TXIQK_ATT1, att);
+    hal.write_rf(path, RR_XGLNA2, RR_XGLNA2_SW, 0);
+    hal.write_rf(path, RR_RXKPLL, RR_RXKPLL_POW, 0);
+    hal.write_rf(path, RR_RXKPLL, RFREG_MASK, 0x80014);
+    crate::delay_us(100);
+    hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 1);
+    hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_RXT, 0x025);
+    dpk_one_shot(hal, path, DPK_LBK_RXIQK);
+    hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 0);
+    hal.write_rf(path, RR_RXK, RR_RXK_PLLEN, 0);
+    hal.phy_w32_mask(R_MDPK_RX_DCK, B_MDPK_RX_DCK_EN, 0);
+    hal.phy_w32_mask(R_KPATH_CFG, B_KPATH_CFG_ED, 0);
+    hal.phy_w32_mask(R_LOAD_COEF + p, B_LOAD_COEF_DI, 1);
+    hal.write_rf(path, RR_MOD, RFREG_MASKMODE, 0x5);
+}
+
+/// `_dpk_kip_set_txagc` (no higher than the path's ceiling).
+fn dpk_kip_set_txagc(hal: &Hal, dpk: &Dpk, path: u8, txagc: u32) {
+    hal.write_rf(path, RR_TXAGC, RFREG_MASK, txagc.min(dpk.max_txagc[path as usize]));
+    hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 1);
+    dpk_one_shot(hal, path, DPK_TXAGC);
+    hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 0);
+}
+
+/// `_dpk_set_offset`.
+fn dpk_set_offset(hal: &Hal, dpk: &Dpk, path: u8, offset: i32) -> u32 {
+    let txagc = hal.read_rf(path, RR_TXAGC, RFREG_MASK) as u8 as i32;
+    let txagc = (txagc - offset).clamp(DPK_TXAGC_LOWER as i32, DPK_TXAGC_UPPER as i32) as u32;
+    dpk_kip_set_txagc(hal, dpk, path, txagc);
+    txagc
+}
+
+/// `_dpk_agc` of the RTL8852BT.
+fn dpk_agc(hal: &Hal, dpk: &Dpk, path: u8, init_txagc: u32, bw: u8) -> u32 {
+    #[derive(Clone, Copy, PartialEq)]
+    enum Step {
+        SyncDgain,
+        GainAdj,
+        GainLossIdx,
+        GlGt,
+        GlLt,
+        SetTxGain,
+    }
+    let max = dpk.max_txagc[path as usize];
+    let mut txagc = init_txagc;
+    let mut rxbb = hal.read_rf(path, RR_MOD, RFREG_MASKRXBB);
+    let rf18 = hal.read_rf(path, RR_CFGCH, RFREG_MASK);
+    let (mut step, mut count, mut gl_count, mut limited) = (Step::SyncDgain, 0u32, 0u32, false);
+    let (mut dgain, mut offset, mut gl_idx, mut limit) = (0u32, 0i32, 0u32, 200);
+    loop {
+        let mut out = false;
+        match step {
+            Step::SyncDgain => {
+                dpk_one_shot(hal, path, DPK_SYNC);
+                if count == 0 {
+                    if bw < 2 {
+                        dpk_bypass_rxcfir(hal, path, true);
+                    } else {
+                        dpk_lbk_rxiqk(hal, path, rxbb, rf18);
+                    }
+                }
+                if dpk_sync_check(hal) {
+                    txagc = DPK_TXAGC_INVAL;
+                    out = true;
+                } else {
+                    hal.phy_w32_mask(R_KIP_RPT1, B_KIP_RPT1_SEL, 0);
+                    dgain = hal.phy_r32_mask(R_RPT_COM, B_PRT_COM_DCI);
+                    offset = dpk_dgain_mapping(dgain);
+                    step = if limited || offset == 0 { Step::GainLossIdx } else { Step::GainAdj };
+                }
+            }
+            Step::GainAdj => {
+                let wanted = hal.read_rf(path, RR_MOD, RFREG_MASKRXBB) as i32 + offset;
+                rxbb = if wanted > 0x1f {
+                    limited = true;
+                    0x1f
+                } else if wanted < 0 {
+                    limited = true;
+                    0
+                } else {
+                    wanted as u32
+                };
+                hal.write_rf(path, RR_MOD, RFREG_MASKRXBB, rxbb);
+                if bw == 2 {
+                    dpk_lbk_rxiqk(hal, path, rxbb, rf18);
+                }
+                step = if !(342..=1922).contains(&dgain) { Step::SyncDgain } else { Step::GainLossIdx };
+                count += 1;
+            }
+            Step::GainLossIdx => {
+                dpk_one_shot(hal, path, DPK_GAIN_LOSS);
+                hal.phy_w32_mask(R_KIP_RPT1, B_KIP_RPT1_SEL, 0x6);
+                hal.phy_w32_mask(R_DPK_CFG2, B_DPK_CFG2_ST, 1);
+                gl_idx = dpk_gainloss_read(hal);
+                step = if (gl_idx == 0 && dpk_pas_compressed(hal)) || gl_idx >= 7 {
+                    Step::GlGt
+                } else if gl_idx == 0 {
+                    Step::GlLt
+                } else {
+                    Step::SetTxGain
+                };
+                gl_count += 1;
+            }
+            Step::GlGt => {
+                if txagc == DPK_TXAGC_LOWER || txagc == max {
+                    out = true;
+                } else {
+                    txagc = dpk_set_offset(hal, dpk, path, 3);
+                }
+                step = Step::GainLossIdx;
+                count += 1;
+            }
+            Step::GlLt => {
+                if txagc == DPK_TXAGC_UPPER || txagc == max {
+                    out = true;
+                } else {
+                    txagc = dpk_set_offset(hal, dpk, path, -2);
+                }
+                step = Step::GainLossIdx;
+                count += 1;
+            }
+            Step::SetTxGain => {
+                txagc = dpk_set_offset(hal, dpk, path, gl_idx as i32);
+                out = true;
+                count += 1;
+            }
+        }
+        limit -= 1;
+        if out || count >= 6 || limit <= 0 {
+            break;
+        }
+    }
+    if gl_count >= 6 {
+        // `_dpk_pas_read` without the check: the samples walked through.
+        hal.phy_w32_mask(R_KIP_RPT1, MASKBYTE2, 0x06);
+        hal.phy_w32_mask(R_DPK_CFG2, B_DPK_CFG2_ST, 0);
+        hal.phy_w32_mask(R_DPK_CFG3, MASKBYTE2, 0x08);
+        for index in 0..32 {
+            hal.phy_w32_mask(R_DPK_CFG3, MASKBYTE3, index);
+        }
+    }
+    txagc
+}
+
+/// `_dpk_main` of a path: whether it failed.
+fn dpk_main(hal: &Hal, dpk: &mut Dpk, path: u8, gain: u32) -> bool {
+    let p = (path as u32) << 8;
+    let kidx = dpk.cur[path as usize];
+    let (band, bw) = (dpk.bp[path as usize][kidx].band, dpk.bp[path as usize][kidx].bw);
+    hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 0);
+    hal.write_rf(path, RR_BBDC, RR_BBDC_SEL, 0);
+    // `_dpk_kip_pwr_clk_on`.
+    hal.phy_w32_mask(R_NCTL_RPT, MASKDWORD, 0x0000_0080);
+    hal.phy_w32_mask(R_KIP_SYSCFG, MASKDWORD, 0x807f_030a);
+    hal.phy_w32_mask(R_CFIR_SYS + p, MASKDWORD, 0xce00_0a08);
+    let txagc = 0x38;
+    dpk_kip_set_txagc(hal, dpk, path, txagc);
+    // `_dpk_rf_setting`.
+    hal.write_rf(path, RR_MOD, RFREG_MASK, 0x50220);
+    if band == phy::BAND_2G {
+        hal.write_rf(path, RR_RXBB, RR_RXBB_FATT, 0xf2);
+        hal.write_rf(path, RR_LUTDBG, RR_LUTDBG_TIA, 1);
+        hal.write_rf(path, RR_TIA, RR_TIA_N6, 1);
+    } else {
+        hal.write_rf(path, RR_RXA2, RR_RAA2_SWATT, 0x5);
+        hal.write_rf(path, RR_LUTDBG, RR_LUTDBG_TIA, 1);
+        hal.write_rf(path, RR_TIA, RR_TIA_N6, 1);
+        hal.write_rf(path, RR_RXA_LNA, RFREG_MASK, 0x920FC);
+        hal.write_rf(path, RR_XALNA2, RFREG_MASK, 0x002C0);
+        hal.write_rf(path, RR_IQGEN, RFREG_MASK, 0x38800);
+    }
+    hal.write_rf(path, RR_RCKD, RR_RCKD_BW, 1);
+    hal.write_rf(path, RR_BTC, RR_BTC_TXBB, bw as u32 + 1);
+    hal.write_rf(path, RR_BTC, RR_BTC_RXBB, 0);
+    // `_dpk_rx_dck`.
+    hal.write_rf(path, RR_DCK, RR_DCK_LV, 0);
+    hal.write_rf(path, RR_DCK, RR_DCK_LV, 1);
+    crate::delay_us(600);
+    // `_dpk_kip_preset`.
+    dpk_tpg_sel(hal, bw);
+    dpk_one_shot(hal, path, DPK_KIP_PRESET);
+    // `_dpk_kip_set_rxagc`.
+    hal.phy_w32_mask(R_KIP_MOD, B_KIP_MOD, 0x50220);
+    hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 1);
+    dpk_one_shot(hal, path, DPK_RXAGC);
+    hal.phy_w32_mask(R_P0_RFCTM, B_P0_RFCTM_EN, 0);
+    // `_dpk_table_select`.
+    hal.phy_w32_mask(R_DPD_CH0 + p, MASKBYTE3, 0x80 + kidx as u32 * 0x20 + gain * 0x10);
+    let txagc = dpk_agc(hal, dpk, path, txagc, bw);
+    dpk.bp[path as usize][kidx].ther_dpk = rtw8852b_rfk::rf_thermal(hal, path);
+    let failed = txagc == DPK_TXAGC_INVAL;
+    if !failed {
+        // `_dpk_idl_mpa` with `_dpk_set_mdpd_para`.
+        let order = if bw < 2 && band == phy::BAND_5G { 2 } else { 0 };
+        hal.phy_w32_mask(R_LDL_NORM, B_LDL_NORM_OP, order);
+        hal.phy_w32_mask(R_LDL_NORM, B_LDL_NORM_PN, if order == 0 { 0x3 } else { 0 });
+        hal.phy_w32_mask(R_MDPK_SYNC, B_MDPK_SYNC_MAN, (order == 0) as u32);
+        dpk.order[path as usize] = if order == 0 { 0x3 } else { 0x0 };
+        dpk_one_shot(hal, path, DPK_MDPK_IDL);
+        hal.write_rf(path, RR_MOD, RFREG_MASKMODE, RF_RX);
+        // `_dpk_fill_result`.
+        let k = (kidx as u32) << 2;
+        hal.phy_w32_mask(R_COEF_SEL + p, 1 << 8, kidx as u32);
+        hal.phy_w32_mask(R_TXAGC_RFK + p, 0x3f << ((gain << 3) + ((kidx as u32) << 4)), txagc);
+        dpk.bp[path as usize][kidx].pwsf = DPK_PWSF;
+        hal.phy_w32_mask(R_DPD_BND + p + k, 0x1ff << (gain << 4), DPK_PWSF);
+        hal.phy_w32_mask(R_LOAD_COEF + p, B_LOAD_COEF_MDPD, 1);
+        hal.phy_w32_mask(R_LOAD_COEF + p, B_LOAD_COEF_MDPD, 0);
+        hal.phy_w32_mask(R_DPD_CH0A + p + k, MASKDWORD, if dpk.gs == DPK_GS_BB { 0x007f_7f7f } else { 0x005b_5b5b });
+        hal.phy_w32_mask(R_DPD_CH0A + p + k, B_DPD_ORDER_V1, dpk.order[path as usize]);
+        hal.phy_w32_mask(R_DPD_V1 + p, MASKDWORD, 0);
+        hal.phy_w32_mask(R_MDPK_SYNC, B_MDPK_SYNC_SEL, 0);
+    }
+    dpk.bp[path as usize][kidx].ok = !failed;
+    dpk_onoff(hal, dpk, path, failed);
+    failed
+}
+
+/// `rtw8852bt_dpk` (`_dpk_cal_select`): the table for the channel (a
+/// stored one, else the other one), both paths calibrated with the
+/// registers kept around it.
+fn dpk(hal: &Hal, state: &mut State, chan: &Chan) {
+    let dpk = &mut state.dpk;
+    for path in 0..2usize {
+        // `_dpk_reload_check`.
+        let mut reloaded = false;
+        for index in 0..2 {
+            let result = dpk.bp[path][index];
+            if result.band == chan.band && result.ch == chan.channel {
+                hal.phy_w32_mask(R_COEF_SEL + ((path as u32) << 8), B_COEF_SEL_MDPD, index as u32);
+                dpk.cur[path] = index;
+                reloaded = true;
+            }
+        }
+        if !reloaded && dpk.bp[path][0].ch != 0 {
+            dpk.cur[path] ^= 1;
+        } else {
+            dpk_onoff(hal, dpk, path as u8, false);
+        }
+    }
+    let bb = backup(hal, &BACKUP_BB_REGS);
+    let kip = backup(hal, &BACKUP_KIP_REGS);
+    let mut rf = [[0u32; 8]; 2];
+    for path in 0..2u8 {
+        rf[path as usize] = backup_rf(hal, path);
+        let kidx = dpk.cur[path as usize];
+        let result = &mut dpk.bp[path as usize][kidx];
+        result.band = chan.band;
+        result.ch = chan.channel;
+        result.bw = chan.bw;
+        if state.tssi_mode[path as usize] {
+            hal.phy_w32_mask(R_P0_TSSI_TRK + ((path as u32) << 13), B_P0_TSSI_TRK_EN, 1);
+        }
+    }
+    bb_afe_setting(hal);
+    for path in 0..2u8 {
+        let _ = dpk_main(hal, dpk, path, 1);
+    }
+    bb_afe_restore(hal);
+    // `_dpk_kip_restore`, as Linux calls it after the loop (its path index
+    // past the last).
+    hal.phy_w32_mask(R_NCTL_RPT, MASKDWORD, 0);
+    hal.phy_w32_mask(R_KIP_SYSCFG, MASKDWORD, 0x8000_0000);
+    if hal.cv > CHIP_CAV as u8 {
+        hal.phy_w32_mask(R_DPD_COM + (2 << 8), B_DPD_COM_OF, 1);
+    }
+    reload(hal, &BACKUP_BB_REGS, &bb);
+    reload(hal, &BACKUP_KIP_REGS, &kip);
+    for path in 0..2u8 {
+        reload_rf(hal, path, &rf[path as usize]);
+        if state.tssi_mode[path as usize] {
+            hal.phy_w32_mask(R_P0_TSSI_TRK + ((path as u32) << 13), B_P0_TSSI_TRK_EN, 0);
+        }
+    }
+}
+
+/// `rtw8852bt_dpk_init` (`_set_dpd_backoff`, the TX gain's ceiling); the
+/// TSSI off, as `rtw8852bt_rfk_init` starts.
+pub(crate) fn dpk_init(hal: &Hal, state: &mut State) {
+    state.dpk.cur = [0; 2];
+    state.dpk.max_txagc = [0x3f; 2];
+    state.dpk.enabled = true;
+    state.tssi_mode = [false; 2];
+    let backoff = hal.phy_r32_mask(R_DPD_BF, B_DPD_BF_OFDM);
+    let scale = hal.phy_r32_mask(R_DPD_BF, B_DPD_BF_SCA);
+    if backoff + scale >= 44 {
+        state.dpk.gs = DPK_GS_BB;
+        for path in 0..2u32 {
+            hal.phy_w32_mask(R_DPD_CH0A + (path << 8), B_DPD_CFG, 0x7f7f7f);
+        }
+    } else {
+        state.dpk.gs = DPK_GS_DEFAULT;
+    }
+}
+
+/// `rtw8852bt_dpk_track` with the thermal values' update.
+pub(crate) fn track(hal: &Hal, state: &mut State) {
+    if state.dpk.bp.iter().all(|path| path.iter().all(|result| result.ch == 0)) {
+        return;
+    }
+    state.thermal.update(hal, &state.tssi_mode);
+    let mut ini_diff: i32 = 0;
+    for path in 0..2u8 {
+        let kidx = state.dpk.cur[path as usize];
+        let result = state.dpk.bp[path as usize][kidx];
+        let current = state.thermal.read(path);
+        let mut delta: i32 = 0;
+        if result.ch != 0 && current != 0 {
+            delta = (result.ther_dpk as i32 - current as i32) as i8 as i32;
+        }
+        delta = if result.band == phy::BAND_2G { (delta * 3 / 2) as i8 as i32 } else { (delta * 5 / 2) as i8 as i32 };
+        let bb_reg = R_TXAGC_BB + ((path as u32) << 13);
+        let txagc_rf = hal.phy_r32_mask(bb_reg, B_TXAGC_RF);
+        let pwsf = if state.tssi_mode[path as usize] {
+            let txagc_bb = hal.phy_r32_mask(bb_reg, MASKBYTE2) as u8 as i8 as i32;
+            let txagc_bb_tp = hal.phy_r32_mask(R_TXAGC_TP + ((path as u32) << 13), B_TXAGC_TP) as u8 as i8 as i32;
+            let mut offset = hal.phy_r32_mask(bb_reg, MASKBYTE3) as u8 as i8 as i32;
+            if hal.phy_r32_mask(R_DPD_COM + ((path as u32) << 8), B_DPD_COM_OF) == 1 {
+                offset = 0;
+            }
+            if txagc_rf != 0 && current != 0 {
+                ini_diff = (offset + delta) as i8 as i32;
+            }
+            if hal.phy_r32_mask(R_P0_TXDPD + ((path as u32) << 13), B_P0_TXDPD) == 0 {
+                (result.pwsf as i32 + txagc_bb_tp - txagc_bb + ini_diff) as u16 as u32
+            } else {
+                (result.pwsf as i32 + ini_diff) as u16 as u32
+            }
+        } else {
+            ((result.pwsf as i32 + delta) as u32) & 0x1ff
+        };
+        if hal.phy_r32_mask(R_DPK_TRK, B_DPK_TRK_DIS) == 0 && txagc_rf != 0 {
+            let reg = R_DPD_BND + ((path as u32) << 8) + ((kidx as u32) << 2);
+            hal.phy_w32_mask(reg, B_DPD_BND_0, pwsf);
+            hal.phy_w32_mask(reg, B_DPD_BND_1, pwsf);
+        }
+    }
+}
+
+/// `rtw8852bt_rfk_channel` after the RX DC offset: IQK, TSSI, DPK.
+pub(crate) fn channel(hal: &Hal, state: &mut State, tssi_efuse: Option<&Tssi>, track: Option<&TxPowerTrack>, chan: &Chan) {
+    iqk(hal, state, chan);
+    if let Some(efuse) = tssi_efuse {
+        rtw8852b_rfk::tssi(hal, &mut state.tssi_mode, &TSSI_8852BT, efuse, track, chan, false);
+    }
+    crate::sta::stop_sch_tx(hal, true);
+    wait_rx_mode(hal);
+    dpk(hal, state, chan);
+    crate::sta::stop_sch_tx(hal, false);
+}
+
+/// `rtw8852bt_tssi_scan` on a band change.
+pub(crate) fn tssi_scan(hal: &Hal, state: &mut State, tssi_efuse: &Tssi, track: Option<&TxPowerTrack>, chan: &Chan) {
+    rtw8852b_rfk::tssi(hal, &mut state.tssi_mode, &TSSI_8852BT, tssi_efuse, track, chan, true);
+}
diff --git a/kernel/comps/rtw89/src/rtw8852c_rfk.rs b/kernel/comps/rtw89/src/rtw8852c_rfk.rs
new file mode 100644
index 0000000..d837257
--- /dev/null
+++ b/kernel/comps/rtw89/src/rtw8852c_rfk.rs
@@ -0,0 +1,1494 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The RTL8852C's calibrations on the host, as Linux's `rtw8852c_rfk.c`
+//! runs them: the DAC's and the ADC's offsets (DACK, at power on), the RX
+//! DC offset (checked against the baseline and redone with the
+//! temperature), the IQ imbalance (IQK: the LO leakage, TX and RX by gain
+//! groups, wide band), the digital predistortion (DPK, two tables taken in
+//! turn, its thermal tracking), the TX power's closed loop (TSSI, on all
+//! three bands) and the LO's calibration again with the temperature (LCK).
+//! One channel context (table 0), both paths, no DBCC.
+
+use crate::{
+    chan::Chan,
+    fw::TxPowerTrack,
+    hal::{Hal, MASKBYTE0, MASKBYTE2, MASKBYTE3, MASKDWORD, MASKHWORD, MASKLWORD, RFREG_MASK, field, get},
+    mac::Tssi,
+    phy::{self, rfk, rfk_by},
+    regs::*,
+    rfk_tables::*,
+    rtw8852b_rfk::{self, CFIR_FAILED, CFIR_WIDE, NCTL_DONE, THM_MASK_SIGN, THM_MASK_VAL8, Thermal, sign_extend12, wait_rx_mode},
+};
+
+/// `rtw8852c_backup_bb_regs`, `_rf_regs`.
+const BACKUP_BB_REGS: [u32; 8] = [0x8120, 0xc0d4, 0xc0d8, 0xc0e8, 0x8220, 0xc1d4, 0xc1d8, 0xc1e8];
+const BACKUP_RF_REGS: [u32; 7] = [0xdf, 0x5f, 0x8f, 0x97, 0xa3, 0x5, 0x10005];
+
+/// The RX and TX gain groups by band (`_rxk_*_idx*`, `_txk_*`): 2.4, 5
+/// and 6 GHz.
+const RXK_GROUPS: usize = 4;
+const RXK_RXGAIN: [[u32; RXK_GROUPS]; 3] = [[0x252, 0x26c, 0x350, 0x360], [0x190, 0x198, 0x310, 0x318], [0x190, 0x196, 0x290, 0x316]];
+const RXK_ATTC2: [[u32; RXK_GROUPS]; 3] = [[0x00, 0x07, 0x00, 0x3], [0x00, 0x00, 0x00, 0x00], [0x00, 0x0, 0x00, 0x00]];
+const TXK_GROUPS: usize = 3;
+const TXK_POWER_RANGE: [[u32; TXK_GROUPS]; 3] = [[0x0; TXK_GROUPS]; 3];
+const TXK_TRACK_RANGE: [[u32; TXK_GROUPS]; 3] = [[0x5, 0x6, 0x6], [0x5, 0x6, 0x7], [0x6, 0x7, 0x7]];
+const TXK_GAIN_BB: [[u32; TXK_GROUPS]; 3] = [[0x0e, 0x0a, 0x0e], [0x12, 0x09, 0x0e], [0x12, 0x09, 0x0e]];
+const TXK_ITQT: [[u32; TXK_GROUPS]; 3] = [[0x12; TXK_GROUPS]; 3];
+
+/// The band's row in the tables above.
+fn band_row(band: u8) -> usize {
+    match band {
+        phy::BAND_2G => 0,
+        phy::BAND_6G => 2,
+        _ => 1,
+    }
+}
+
+/// `RTW8852C_IQK_VER`, `RTW8852C_NCTL_VER`; `IQK_DF4_TXT_8_25MHZ`.
+const IQK_VER: u32 = 0x2a;
+const NCTL_VER: u32 = 0xd;
+const IQK_DF4_TXT_8_25MHZ: u32 = 0x021;
+
+/// `enum dac_ck`, `enum adc_ck`.
+const DAC_160M: u32 = 3;
+const DAC_960M: u32 = 7;
+const ADC_480M: u32 = 1;
+const ADC_960M: u32 = 2;
+const ADC_1920M: u32 = 3;
+
+/// `struct rxck_def` (`_ck480M`, `_ck960M`, `_ck1920M`): the ADC's
+/// filter, its clock's multiplier and power for a rate.
+struct RxckDef {
+    ctl: u32,
+    en: u32,
+    bw0: u32,
+    bw1: u32,
+    mul: u32,
+    lp: u32,
+}
+const CK480M: RxckDef = RxckDef { ctl: 0x8, en: 0x2, bw0: 0x3, bw1: 0xf, mul: 0x0, lp: 0x9 };
+const CK960M: RxckDef = RxckDef { ctl: 0x8, en: 0x2, bw0: 0x2, bw1: 0x8, mul: 0x0, lp: 0x9 };
+const CK1920M: RxckDef = RxckDef { ctl: 0x8, en: 0x0, bw0: 0x2, bw1: 0x4, mul: 0x6, lp: 0x9 };
+
+/// The RX DC offset's gain entries checked against their baselines
+/// (`_dck_addr_bs`, `_dck_addr`) and the largest difference taken.
+const DCK_ADDR_BS: [u32; 2] = [0x0, 0x10];
+const DCK_ADDR: [u32; 2] = [0xc, 0x1c];
+const DCK_TH: i32 = 10;
+
+fn backup_bb(hal: &Hal) -> [u32; 8] {
+    BACKUP_BB_REGS.map(|reg| hal.phy_r32_mask(reg, MASKDWORD))
+}
+
+fn restore_bb(hal: &Hal, values: &[u32; 8]) {
+    for (&reg, &value) in BACKUP_BB_REGS.iter().zip(values) {
+        hal.phy_w32_mask(reg, MASKDWORD, value);
+    }
+}
+
+fn backup_rf(hal: &Hal, path: u8) -> [u32; 7] {
+    BACKUP_RF_REGS.map(|reg| hal.read_rf(path, reg, RFREG_MASK))
+}
+
+fn restore_rf(hal: &Hal, path: u8, values: &[u32; 7]) {
+    for (&reg, &value) in BACKUP_RF_REGS.iter().zip(values) {
+        hal.write_rf(path, reg, RFREG_MASK, value);
+    }
+}
+
+fn poll(done: impl Fn() -> bool, step_us: u64, timeout_us: u64) -> bool {
+    aster_linuxkpi::delay::read_poll_timeout(&done, |ok| *ok, step_us, timeout_us).is_ok()
+}
+
+/// `rtw8852c_txck_force`.
+fn txck_force(hal: &Hal, path: u8, force: bool, ck: u32) {
+    let reg = R_P0_RXCK | ((path as u32) << 13);
+    hal.phy_w32_mask(reg, B_P0_TXCK_ON, 0);
+    if force {
+        hal.phy_w32_mask(reg, B_P0_TXCK_VAL, ck);
+        hal.phy_w32_mask(reg, B_P0_TXCK_ON, 1);
+    }
+}
+
+/// `rtw8852c_rxck_force`: the ADC's clock and its filter for the rate.
+fn rxck_force(hal: &Hal, path: u8, force: bool, ck: u32) {
+    let reg = R_P0_RXCK | ((path as u32) << 13);
+    hal.phy_w32_mask(reg, B_P0_RXCK_ON, 0);
+    if !force {
+        return;
+    }
+    hal.phy_w32_mask(reg, B_P0_RXCK_VAL, ck);
+    hal.phy_w32_mask(reg, B_P0_RXCK_ON, 1);
+    let def = match ck {
+        ADC_480M => &CK480M,
+        ADC_960M => &CK960M,
+        _ => &CK1920M,
+    };
+    let p = (path as u32) << 8;
+    hal.phy_w32_mask(R_P0_CFCH_BW0 | p, B_P0_CFCH_CTL, def.ctl);
+    hal.phy_w32_mask(R_P0_CFCH_BW0 | p, B_P0_CFCH_EN, def.en);
+    hal.phy_w32_mask(R_P0_CFCH_BW0 | p, B_P0_CFCH_BW0, def.bw0);
+    hal.phy_w32_mask(R_P0_CFCH_BW1 | p, B_P0_CFCH_BW1, def.bw1);
+    hal.phy_w32_mask(R_DRCK | p, B_DRCK_MUL, def.mul);
+    hal.phy_w32_mask(R_ADCMOD | p, B_ADCMOD_LP, def.lp);
+}
+
+// ---- DACK. ----
+
+/// A path's DAC results (`struct rtw89_dack_info`).
+#[derive(Default)]
+struct DackPath {
+    msbk: [[u32; 16]; 2],
+    biask: [u32; 2],
+    dadck: [u32; 2],
+}
+
+/// `_dack_reload_by_path` of both halves.
+fn dack_reload(hal: &Hal, path: u8, d: &DackPath) {
+    for index in 0..2usize {
+        let offset = if index == 0 { 0 } else { 0x14 } + if path == 0 { 0 } else { 0x28 };
+        rfk(hal, RTW8852C_DACK_RELOAD_DEFS);
+        for (word, first) in [12usize, 8, 4, 0].into_iter().enumerate() {
+            let value = (0..4).fold(0u32, |value, i| value | (d.msbk[index][first + i] << (i * 8)));
+            hal.phy_w32(0xc200 + offset + 4 * word as u32, value);
+        }
+        let addr = 0xc210 + offset;
+        hal.phy_w32(addr, (d.biask[index] << 22) | (d.dadck[index] << 14));
+        hal.phy_set(addr, 1 << 0);
+    }
+}
+
+/// `_check_dack_done`.
+fn dack_done(hal: &Hal, s0: bool) -> bool {
+    let ok = |reg, mask| hal.phy_r32_mask(reg, mask) != 0;
+    if s0 {
+        ok(R_DACK_S0P0, B_DACK_S0P0_OK) && ok(R_DACK_S0P1, B_DACK_S0P1_OK) && ok(R_DACK_S0P2, B_DACK_S0P2_OK) && ok(R_DACK_S0P3, B_DACK_S0P3_OK)
+    } else {
+        ok(R_DACK_S1P0, B_DACK_S1P0_OK) && ok(R_DACK_S1P1, B_DACK_S1P1_OK) && ok(R_DACK_S1P2, B_DACK_S1P2_OK) && ok(R_DACK_S1P3, B_DACK_S1P3_OK)
+    }
+}
+
+/// `_dack_s0`, `_dack_s1`: a path's DAC at 160 MHz, its results kept
+/// (`_dack_backup_s0`/`_s1`) and reloaded.
+fn dack_path(hal: &Hal, path: u8) {
+    let a = path == 0;
+    txck_force(hal, path, true, DAC_160M);
+    rfk(hal, if a { RTW8852C_DACK_DEFS_S0 } else { RTW8852C_DACK_DEFS_S1 });
+    rfk_by(hal, a, RTW8852C_DACK_RESET_DEFS_A, RTW8852C_DACK_RESET_DEFS_B);
+    if a {
+        hal.phy_w32_mask(R_DCOF1, B_DCOF1_S, 1);
+    } else {
+        hal.phy_w32_mask(R_DACK1_K, B_DACK1_EN, 1);
+    }
+    poll(|| dack_done(hal, a), 1, 10_000);
+    if a {
+        hal.phy_w32_mask(R_DCOF1, B_DCOF1_S, 0);
+    } else {
+        hal.phy_w32_mask(R_DACK1_K, B_DACK1_EN, 0);
+    }
+    txck_force(hal, path, false, DAC_960M);
+    let mut d = DackPath::default();
+    if a {
+        hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_DBG, 1);
+    } else {
+        hal.phy_w32_mask(R_P1_DBGMOD, B_P1_DBGMOD_ON, 1);
+    }
+    for i in 0..16u32 {
+        if a {
+            hal.phy_w32_mask(R_DCOF0, B_DCOF0_V, i);
+            d.msbk[0][i as usize] = hal.phy_r32_mask(R_DACK_S0P2, B_DACK_S0M0);
+            hal.phy_w32_mask(R_DCOF8, B_DCOF8_V, i);
+            d.msbk[1][i as usize] = hal.phy_r32_mask(R_DACK_S0P3, B_DACK_S0M1);
+        } else {
+            hal.phy_w32_mask(R_DACK10, B_DACK10, i);
+            d.msbk[0][i as usize] = hal.phy_r32_mask(R_DACK10S, B_DACK10S);
+            hal.phy_w32_mask(R_DACK11, B_DACK11, i);
+            d.msbk[1][i as usize] = hal.phy_r32_mask(R_DACK11S, B_DACK11S);
+        }
+    }
+    if a {
+        d.biask = [hal.phy_r32_mask(R_DACK_BIAS00, B_DACK_BIAS00), hal.phy_r32_mask(R_DACK_BIAS01, B_DACK_BIAS01)];
+        d.dadck = [hal.phy_r32_mask(R_DACK_DADCK00, B_DACK_DADCK00), hal.phy_r32_mask(R_DACK_DADCK01, B_DACK_DADCK01)];
+    } else {
+        d.biask = [hal.phy_r32_mask(R_DACK_BIAS10, B_DACK_BIAS10), hal.phy_r32_mask(R_DACK_BIAS11, B_DACK_BIAS11)];
+        d.dadck = [hal.phy_r32_mask(R_DACK_DADCK10, B_DACK_DADCK10), hal.phy_r32_mask(R_DACK_DADCK11, B_DACK_DADCK11)];
+    }
+    dack_reload(hal, path, &d);
+    if a {
+        hal.phy_w32_mask(R_P0_NRBW, B_P0_NRBW_DBG, 0);
+    } else {
+        hal.phy_w32_mask(R_P1_DBGMOD, B_P1_DBGMOD_ON, 0);
+    }
+}
+
+/// `_addck` of a path: the ADC's DC offset measured (its report's ready
+/// bit at 0xc0fc, 0xc1fc).
+fn addck_path(hal: &Hal, path: u8) {
+    let (reg, rst, en, all, done) = if path == 0 {
+        (R_ADDCK0, B_ADDCK0_RST, B_ADDCK0_EN, B_ADDCK0, 0xc0fc)
+    } else {
+        (R_ADDCK1, B_ADDCK1_RST, B_ADDCK1_EN, B_ADDCK1, 0xc1fc)
+    };
+    hal.phy_w32_mask(reg, rst, 1);
+    hal.phy_w32_mask(reg, en, 1);
+    hal.phy_w32_mask(reg, en, 0);
+    crate::delay_us(1);
+    hal.phy_w32_mask(reg, all, 1);
+    poll(|| hal.phy_r32_mask(done, 1 << 0) != 0, 1, 10_000);
+    hal.phy_w32_mask(reg, rst, 0);
+}
+
+/// `_drck`.
+fn drck(hal: &Hal) {
+    hal.phy_w32_mask(R_DRCK, B_DRCK_EN, 1);
+    poll(|| hal.phy_r32_mask(0xc0c8, 1 << 3) != 0, 1, 10_000);
+    rfk(hal, RTW8852C_DRCK_DEFS);
+    let value = hal.phy_r32_mask(R_DRCK_RES, B_DRCK_RES);
+    hal.phy_w32_mask(R_DRCK, B_DRCK_IDLE, 0);
+    hal.phy_w32_mask(R_DRCK, B_DRCK_VAL, value);
+}
+
+/// `rtw8852c_dack` (`_dac_cal`): the RC clock, both ADCs' offsets, both
+/// DACs; RF register 0 kept around it.
+pub(crate) fn dac_cal(hal: &Hal) {
+    let rf0 = [hal.read_rf(0, RR_MOD, RFREG_MASK), hal.read_rf(1, RR_MOD, RFREG_MASK)];
+    drck(hal);
+    for path in 0..2u8 {
+        hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 0);
+    }
+    for path in 0..2u8 {
+        hal.write_rf(path, RR_MOD, RFREG_MASK, 0x337e1);
+    }
+    for path in 0..2u8 {
+        addck_path(hal, path);
+    }
+    // `_addck_backup`, `_addck_reload`.
+    hal.phy_w32_mask(R_ADDCK0, B_ADDCK0, 0);
+    let a = [hal.phy_r32_mask(R_ADDCKR0, B_ADDCKR0_A0), hal.phy_r32_mask(R_ADDCKR0, B_ADDCKR0_A1)];
+    hal.phy_w32_mask(R_ADDCK1, B_ADDCK1, 0);
+    let b = [hal.phy_r32_mask(R_ADDCKR1, B_ADDCKR1_A0), hal.phy_r32_mask(R_ADDCKR1, B_ADDCKR1_A1)];
+    hal.phy_w32_mask(R_ADDCK0_RL, B_ADDCK0_RL1, a[0]);
+    hal.phy_w32_mask(R_ADDCK0_RL, B_ADDCK0_RL0, a[1]);
+    hal.phy_w32_mask(R_ADDCK0_RL, B_ADDCK0_RLS, 0x3);
+    hal.phy_w32_mask(R_ADDCK1_RL, B_ADDCK1_RL1, b[0]);
+    hal.phy_w32_mask(R_ADDCK1_RL, B_ADDCK1_RL0, b[1]);
+    hal.phy_w32_mask(R_ADDCK1_RL, B_ADDCK1_RLS, 0x3);
+    for path in 0..2u8 {
+        hal.write_rf(path, RR_MODOPT, RFREG_MASK, 0);
+    }
+    dack_path(hal, 0);
+    dack_path(hal, 1);
+    for path in 0..2u8 {
+        hal.write_rf(path, RR_MOD, RFREG_MASK, rf0[path as usize]);
+    }
+    for path in 0..2u8 {
+        hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 1);
+    }
+}
+
+// ---- IQK. ----
+
+/// `enum rtw8852c_iqk_type`: the one-shots the host starts.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Iqk {
+    GFlokCoarse,
+    AFlokCoarse,
+    GFlokFine,
+    AFlokFine,
+    FlokVbuffer,
+    Txk,
+    Rxk,
+}
+
+/// What a path's IQK keeps (`struct rtw89_iqk_info`, the parts used).
+#[derive(Clone, Copy, Default)]
+struct IqkPath {
+    band: u8,
+    bw: u8,
+    nb_txcfir: u32,
+    nb_rxcfir: u32,
+    lok_cor_fail: bool,
+    lok_fin_fail: bool,
+}
+
+#[derive(Default)]
+struct IqkInfo {
+    path: [IqkPath; 2],
+    times: u32,
+    fail_count: u32,
+}
+
+/// `rtw8852c_disable_rxagc` (1 enables it).
+fn rxagc(hal: &Hal, path: u8, enable: u32) {
+    if path == 0 {
+        hal.phy_w32_mask(R_P0_AGC_CTL, B_P0_AGC_EN, enable);
+    } else {
+        hal.phy_w32_mask(R_P1_AGC_CTL, B_P1_AGC_EN, enable);
+    }
+}
+
+/// `_iqk_check_cal`: the NCTL done (or 8.2 ms gone); Linux takes none as
+/// failed.
+fn iqk_check_cal(hal: &Hal) {
+    poll(|| hal.phy_r32_mask(R_RFK_ST, MASKBYTE0) == NCTL_DONE, 1, 8200);
+    hal.phy_clr(R_NCTL_N1, MASKBYTE0);
+}
+
+/// `_iqk_one_shot`: the RF's control by the KIP for the kind, the NCTL's
+/// command (the width in TX's and RX's).
+fn iqk_one_shot(hal: &Hal, path: u8, kind: Iqk, bw: u8) {
+    let rfc_ctl = R_UPD_CLK + ((path as u32) << 13);
+    let (p, bw) = (path as u32, bw as u32);
+    let (by_kip, cmd) = match kind {
+        Iqk::AFlokCoarse => (1, 0x008 | (1 << (4 + p))),
+        Iqk::GFlokCoarse => (1, 0x108 | (1 << (4 + p))),
+        Iqk::AFlokFine => (1, 0x508 | (1 << (4 + p))),
+        Iqk::GFlokFine => (1, 0x208 | (1 << (4 + p))),
+        Iqk::FlokVbuffer => (1, 0x308 | (1 << (4 + p))),
+        Iqk::Txk => (0, 0x008 | (1 << (4 + p)) | ((0x8 + bw) << 8)),
+        Iqk::Rxk => (1, 0x008 | (1 << (4 + p)) | ((0xc + bw) << 8)),
+    };
+    hal.phy_w32_mask(rfc_ctl, 1 << 1, by_kip);
+    hal.phy_w32_mask(R_NCTL_CFG, MASKDWORD, cmd + 1);
+    crate::delay_us(15);
+    iqk_check_cal(hal);
+    hal.phy_w32_mask(rfc_ctl, 1 << 1, 0);
+}
+
+/// `_iqk_rxk_setting`: the ADC's clock for the width.
+fn iqk_rxk_setting(hal: &Hal, path: u8, bw: u8) {
+    let upd = R_UPD_CLK + ((path as u32) << 13);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RXK, if path == 0 { 0x0101 } else { 0x0202 });
+    let (ck, ack) = match bw {
+        0 | 1 => (ADC_480M, 0x0),
+        2 => (ADC_960M, 0x1),
+        _ => (ADC_1920M, 0x2),
+    };
+    hal.phy_w32_mask(upd, B_DPD_GDIS, 1);
+    rxck_force(hal, path, true, ck);
+    hal.phy_w32_mask(upd, B_ACK_VAL, ack);
+    hal.write_rf(path, RR_RXBB2, RR_RXBB2_CKT, 1);
+    hal.phy_w32_mask(R_P0_NRBW + ((path as u32) << 13), B_P0_NRBW_DBG, 1);
+    rfk(hal, RTW8852C_IQK_RXK_CFG_DEFS);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_RXK, if path == 0 { 0x1101 } else { 0x2202 });
+}
+
+/// `_rxk_group_sel`: the four RX gain groups, wide band; path B's PLL as
+/// path A's.
+fn rxk_group_sel(hal: &Hal, info: &mut IqkPath, path: u8) {
+    let row = band_row(info.band);
+    let bkrf0 = hal.read_rf(path, RR_MOD, RR_MOD_NBW);
+    if path == 1 {
+        hal.write_rf(1, RR_IQKPLL, RR_IQKPLL_MOD, 0x3);
+        let value = hal.read_rf(1, RR_CHTR, RR_CHTR_MOD);
+        hal.write_rf(1, RR_RSV4, RR_RSV4_AGH, value);
+        let value = hal.read_rf(1, RR_CHTR, RR_CHTR_TXRX);
+        hal.write_rf(1, RR_RSV4, RR_RSV4_PLLCH, value);
+    }
+    hal.write_rf(path, RR_MOD, RR_MOD_MASK, 0xc);
+    hal.write_rf(path, RR_MOD, RR_MOD_NBW, 0);
+    match info.band {
+        phy::BAND_5G => hal.write_rf(path, RR_RXAE, RR_RXAE_IQKMOD, 0x8),
+        phy::BAND_6G => hal.write_rf(path, RR_RXAE, RR_RXAE_IQKMOD, 0x9),
+        _ => hal.write_rf(path, RR_RXG, RR_RXG_IQKMOD, 0x9),
+    }
+    crate::delay_us(10);
+    for group in 0..RXK_GROUPS {
+        hal.write_rf(path, RR_MOD, RR_MOD_M_RXG, RXK_RXGAIN[row][group]);
+        if info.band == phy::BAND_2G {
+            hal.write_rf(path, RR_RXBB, RR_RXBB_VOBUF, RXK_ATTC2[row][group]);
+        } else {
+            hal.write_rf(path, RR_RXA2, RR_RXA2_IATT, RXK_ATTC2[row][group]);
+        }
+        let lut = R_CFIR_LUT + ((path as u32) << 8);
+        hal.phy_w32_mask(lut, B_CFIR_LUT_SEL, 1);
+        hal.phy_w32_mask(lut, B_CFIR_LUT_SET, 0);
+        hal.phy_w32_mask(lut, B_CFIR_LUT_GP_V1, group as u32);
+        iqk_one_shot(hal, path, Iqk::Rxk, info.bw);
+    }
+    if path == 1 {
+        hal.write_rf(path, RR_IQKPLL, RR_IQKPLL_MOD, 0);
+    }
+    hal.write_rf(path, RR_MOD, RR_MOD_NBW, bkrf0);
+    info.nb_rxcfir = CFIR_WIDE;
+}
+
+/// `_txk_group_sel`: the three TX gain groups, wide band.
+fn txk_group_sel(hal: &Hal, info: &mut IqkPath, path: u8) {
+    let row = band_row(info.band);
+    for group in 0..TXK_GROUPS {
+        hal.write_rf(path, RR_TXIG, RR_TXIG_GR0, TXK_POWER_RANGE[row][group]);
+        hal.write_rf(path, RR_TXIG, RR_TXIG_GR1, TXK_TRACK_RANGE[row][group]);
+        hal.write_rf(path, RR_TXIG, RR_TXIG_TG, TXK_GAIN_BB[row][group]);
+        hal.phy_w32_mask(R_KIP_IQP + ((path as u32) << 8), MASKDWORD, TXK_ITQT[row][group]);
+        let lut = R_CFIR_LUT + ((path as u32) << 8);
+        hal.phy_w32_mask(lut, B_CFIR_LUT_SEL, 1);
+        hal.phy_w32_mask(lut, B_CFIR_LUT_SET, 1);
+        hal.phy_w32_mask(lut, B_CFIR_LUT_G2, 0);
+        hal.phy_w32_mask(lut, B_CFIR_LUT_GP, group as u32 + 1);
+        hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_TXT, 0x00b);
+        hal.phy_w32_mask(R_NCTL_N1, B_NCTL_N1_CIP, 0);
+        iqk_one_shot(hal, path, Iqk::Txk, info.bw);
+    }
+    info.nb_txcfir = CFIR_WIDE;
+}
+
+/// `_lok_finetune_check`: the LO leakage's codes within their ranges.
+fn lok_finetune_check(hal: &Hal, path: u8) -> bool {
+    let core = hal.read_rf(path, RR_TXMO, RFREG_MASK);
+    let (core_i, core_q) = (get(RR_TXMO_COI, core), get(RR_TXMO_COQ, core));
+    let vbuff = hal.read_rf(path, RR_LOKVB, RFREG_MASK);
+    let (vbuff_i, vbuff_q) = (get(RR_LOKVB_COI, vbuff), get(RR_LOKVB_COQ, vbuff));
+    !(0x2..=0x1d).contains(&core_i) || !(0x2..=0x1d).contains(&core_q) || !(0x2..=0x3d).contains(&vbuff_i) || !(0x2..=0x3d).contains(&vbuff_q)
+}
+
+/// `_iqk_lok`: coarse, buffer, fine, buffer at the large gain.
+fn iqk_lok(hal: &Hal, info: &mut IqkPath, path: u8) -> bool {
+    let two_g = info.band == phy::BAND_2G;
+    let iqp = R_KIP_IQP + ((path as u32) << 8);
+    hal.phy_w32_mask(R_IQK_DIF4, B_IQK_DIF4_TXT, IQK_DF4_TXT_8_25MHZ);
+    let steps = [
+        (0x6, 0x9, if two_g { Iqk::GFlokCoarse } else { Iqk::AFlokCoarse }),
+        (0x12, 0x1b, Iqk::FlokVbuffer),
+        (0x6, 0x9, if two_g { Iqk::GFlokFine } else { Iqk::AFlokFine }),
+        (0x12, 0x1b, Iqk::FlokVbuffer),
+    ];
+    for (tg, iqsw, kind) in steps {
+        hal.write_rf(path, RR_TXIG, RR_TXIG_TG, tg);
+        hal.phy_w32_mask(iqp, B_KIP_IQP_IQSW, iqsw);
+        iqk_one_shot(hal, path, kind, info.bw);
+    }
+    // The one-shots report no failure (`_iqk_check_cal`).
+    info.lok_cor_fail = false;
+    info.lok_fin_fail = false;
+    lok_finetune_check(hal, path)
+}
+
+/// `_iqk_txk_setting` (`syn1to2` 1: no DBCC).
+fn iqk_txk_setting(hal: &Hal, band: u8, path: u8) {
+    if band == phy::BAND_2G {
+        hal.write_rf(path, RR_TXG1, RR_TXG1_ATT2, 0);
+        hal.write_rf(path, RR_TXG1, RR_TXG1_ATT1, 0);
+        hal.write_rf(path, RR_TXG2, RR_TXG2_ATT0, 1);
+    } else {
+        hal.write_rf(path, RR_TXATANK, RR_TXATANK_LBSW2, 0);
+        hal.write_rf(path, RR_TXPOW, RR_TXPOW_TXAS, 1);
+    }
+    hal.write_rf(path, RR_TXA2, RR_TXA2_LDO, 0xf);
+    hal.write_rf(path, RR_TXGA, RR_TXGA_LOK_EXT, 0);
+    hal.write_rf(path, RR_LUTWE, RR_LUTWE_LOK, 1);
+    hal.write_rf(path, RR_MOD, RFREG_MASK, 0x403e0 | 0x1);
+    crate::delay_us(10);
+    hal.write_rf(path, RR_TXIG, RR_TXIG_GR0, 0);
+    hal.write_rf(path, RR_TXIG, RR_TXIG_GR1, 0x6);
+}
+
+/// `_iqk_info_iqk`: the results where the firmware's reports keep them.
+fn iqk_info_iqk(hal: &Hal, info: &mut IqkInfo, path: u8) {
+    let state = info.path[path as usize];
+    let shift = path as u32 * 4;
+    hal.phy_w32_mask(R_IQKINF, B_IQKINF_FCOR << shift, state.lok_cor_fail as u32);
+    hal.phy_w32_mask(R_IQKINF, B_IQKINF_FFIN << shift, state.lok_fin_fail as u32);
+    hal.phy_w32_mask(R_IQKINF, B_IQKINF_FTX << shift, 0);
+    hal.phy_w32_mask(R_IQKINF, B_IQKINF_F_RX << shift, 0);
+    hal.phy_w32_mask(R_IQKINF2, B_IQKINF2_KCNT, info.times);
+    if hal.phy_r32_mask(R_IQKINF, B_IQKINF_FAIL << shift) != 0 {
+        info.fail_count += 1;
+    }
+    hal.phy_w32_mask(R_IQKINF2, B_IQKINF2_FCNT << shift, info.fail_count);
+}
+
+/// `_doiqk` of a path.
+fn doiqk(hal: &Hal, info: &mut IqkInfo, path: u8, chan: &Chan) {
+    info.times += 1;
+    let p = (path as u32) << 8;
+    // `_iqk_get_ch_info`.
+    let state = &mut info.path[path as usize];
+    state.band = chan.band;
+    state.bw = chan.bw;
+    hal.phy_w32_mask(R_IQKINF, B_IQKINF_VER, IQK_VER);
+    let shift = path as u32 * 16;
+    hal.phy_w32_mask(R_IQKCH, B_IQKCH_BAND << shift, chan.band as u32);
+    hal.phy_w32_mask(R_IQKCH, B_IQKCH_BW << shift, chan.bw as u32);
+    hal.phy_w32_mask(R_IQKCH, B_IQKCH_CH << shift, chan.channel as u32);
+    hal.phy_w32_mask(R_IQKINF2, B_IQKINF2_NCTLV, NCTL_VER);
+    let bb = backup_bb(hal);
+    let rf = backup_rf(hal, path);
+    // `_iqk_macbb_setting`.
+    let upd = R_UPD_CLK | ((path as u32) << 13);
+    hal.write_rf(path, RR_BBDC, RR_BBDC_SEL, 0);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_A0 << path, 1);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_A1 << path, 0);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_A2 << path, 1);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_A3 << path, 0);
+    rxagc(hal, path, 0);
+    hal.phy_w32_mask(upd, MASKDWORD, 0xf801_fffd);
+    hal.phy_w32_mask(upd, B_DPD_DIS, 1);
+    hal.phy_w32_mask(upd, B_DAC_VAL, 1);
+    txck_force(hal, path, true, DAC_960M);
+    hal.phy_w32_mask(upd, B_DPD_GDIS, 1);
+    rxck_force(hal, path, true, ADC_1920M);
+    hal.phy_w32_mask(upd, B_ACK_VAL, 0x2);
+    hal.phy_w32_mask(R_P0_NRBW | ((path as u32) << 13), B_P0_NRBW_DBG, 1);
+    hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15, 0x1f);
+    hal.phy_w32_mask(R_ANAPAR_PW15, B_ANAPAR_PW15, 0x13);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_15, 0x0001);
+    hal.phy_w32_mask(R_ANAPAR, B_ANAPAR_15, 0x0041);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_A1 << path, 1);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_A3 << path, 1);
+    // `_iqk_preset`: table 0.
+    hal.phy_w32_mask(R_COEF_SEL + p, B_COEF_SEL_IQC, 0);
+    hal.phy_w32_mask(R_CFIR_LUT + p, B_CFIR_LUT_G3, 0);
+    hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 0);
+    hal.phy_w32_mask(R_NCTL_RPT, MASKDWORD, 0x0000_0080);
+    hal.phy_w32_mask(R_KIP_SYSCFG, MASKDWORD, 0x81ff_010a);
+    // `_iqk_by_path`.
+    let state = &mut info.path[path as usize];
+    iqk_txk_setting(hal, state.band, path);
+    let _ = iqk_lok(hal, state, path);
+    txk_group_sel(hal, state, path);
+    iqk_rxk_setting(hal, path, state.bw);
+    rxk_group_sel(hal, state, path);
+    iqk_info_iqk(hal, info, path);
+    // `_iqk_restore`.
+    let state = info.path[path as usize];
+    hal.phy_w32_mask(R_TXIQC + p, MASKDWORD, state.nb_txcfir);
+    hal.phy_w32_mask(R_RXIQC + p, MASKDWORD, state.nb_rxcfir);
+    hal.phy_w32_mask(R_NCTL_CFG, MASKDWORD, 0x0000_1219 + ((path as u32) << 4));
+    crate::delay_us(200);
+    iqk_check_cal(hal);
+    hal.phy_w32_mask(R_NCTL_N1, B_NCTL_N1_CIP, 0);
+    hal.phy_w32_mask(R_NCTL_RPT, MASKDWORD, 0);
+    hal.phy_w32_mask(R_KIP_SYSCFG, MASKDWORD, 0x8000_0000);
+    hal.write_rf(path, RR_LUTWE, RR_LUTWE_LOK, 0);
+    hal.write_rf(path, RR_MOD, RR_MOD_MASK, RR_MOD_V_RX);
+    hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 1);
+    // `_iqk_afebb_restore`.
+    rfk_by(hal, path == 0, RTW8852C_IQK_AFEBB_RESTORE_DEFS_A, RTW8852C_IQK_AFEBB_RESTORE_DEFS_B);
+    rxagc(hal, path, 1);
+    restore_bb(hal, &bb);
+    restore_rf(hal, path, &rf);
+}
+
+/// `rtw8852c_iqk`.
+fn iqk(hal: &Hal, info: &mut IqkInfo, chan: &Chan) {
+    crate::sta::stop_sch_tx(hal, true);
+    wait_rx_mode(hal);
+    hal.phy_clr(R_IQKINF, MASKDWORD);
+    for path in 0..2u8 {
+        doiqk(hal, info, path, chan);
+    }
+    crate::sta::stop_sch_tx(hal, false);
+}
+
+// ---- The RX DC offset. ----
+
+/// `_rx_dck_value_rewrite`: an entry's offsets (7 bits to 6) written to
+/// the RF's table.
+fn rx_dck_value_rewrite(hal: &Hal, path: u8, addr: u32, val_i: u32, val_q: u32) {
+    let value = field(RR_LUTWD0_MB, val_q >> 1) | field(RR_LUTWD0_LB, val_i >> 1);
+    hal.write_rf(path, RR_LUTPLL, RR_CAL_RW, 1);
+    hal.write_rf(path, RR_RFC, RR_WCAL, 1);
+    hal.write_rf(path, RR_DCK, RR_DCK_FINE, 1);
+    hal.write_rf(path, RR_LUTWA, MASKBYTE0, addr);
+    hal.write_rf(path, RR_LUTWD0, RFREG_MASK, value);
+    hal.write_rf(path, RR_LUTWD0, RFREG_MASK, value);
+    hal.write_rf(path, RR_DCK, RR_DCK_FINE, 0);
+    hal.write_rf(path, RR_RFC, RR_WCAL, 0);
+    hal.write_rf(path, RR_LUTPLL, RR_CAL_RW, 0);
+}
+
+/// An entry's I and Q offsets (`RR_MOD_DCK` selecting it).
+fn dck_entry(hal: &Hal, path: u8, addr: u32) -> (i32, i32) {
+    hal.write_rf(path, RR_MOD, RR_MOD_DCK, addr);
+    (hal.read_rf(path, RR_DCK, RR_DCK_TIA) as i32, hal.read_rf(path, RR_DCK1, RR_DCK1_TIA) as i32)
+}
+
+/// `_rx_dck_rek_check`: whether an entry strays from its baseline.
+fn rx_dck_rek_check(hal: &Hal, path: u8) -> bool {
+    for i in 0..2 {
+        for odd in [0, 1] {
+            let (i_bs, q_bs) = dck_entry(hal, path, DCK_ADDR_BS[i] + odd);
+            let (i_v, q_v) = dck_entry(hal, path, DCK_ADDR[i] + odd);
+            if (i_bs - i_v).abs() > DCK_TH || (q_bs - q_v).abs() > DCK_TH {
+                return true;
+            }
+        }
+    }
+    false
+}
+
+/// `_rx_dck_recover`: the entries that stray put back to their baselines
+/// (`_rx_dck_fix_if_need`).
+fn rx_dck_recover(hal: &Hal, path: u8) {
+    for i in 0..2 {
+        let (i_even_bs, q_even_bs) = dck_entry(hal, path, DCK_ADDR_BS[i]);
+        let (i_odd_bs, q_odd_bs) = dck_entry(hal, path, DCK_ADDR_BS[i] + 1);
+        for (addr, (i_bs, q_bs)) in [(DCK_ADDR[i], (i_even_bs, q_even_bs)), (DCK_ADDR[i] + 1, (i_odd_bs, q_odd_bs))] {
+            let (mut i_v, mut q_v) = dck_entry(hal, path, addr);
+            if (i_bs - i_v).abs() < DCK_TH && (q_bs - q_v).abs() <= DCK_TH {
+                continue;
+            }
+            if (i_bs - i_v).abs() > DCK_TH {
+                i_v = i_bs;
+            }
+            if (q_bs - q_v).abs() > DCK_TH {
+                q_v = q_bs;
+            }
+            rx_dck_value_rewrite(hal, path, addr, i_v as u32, q_v as u32);
+        }
+    }
+}
+
+/// `_rx_dck_toggle`.
+fn rx_dck_toggle(hal: &Hal, path: u8) {
+    hal.write_rf(path, RR_DCK, RR_DCK_LV, 0);
+    hal.write_rf(path, RR_DCK, RR_DCK_LV, 1);
+    poll(|| hal.read_rf(path, RR_DCK1, RR_DCK1_DONE) != 0, 2, 2000);
+    hal.write_rf(path, RR_DCK, RR_DCK_LV, 0);
+}
+
+/// `_set_rx_dck`: again with the IDAC at the result when it is high.
+fn set_rx_dck(hal: &Hal, path: u8) {
+    hal.write_rf(path, RR_DCK1, RR_DCK1_CLR, 0);
+    rx_dck_toggle(hal, path);
+    if hal.read_rf(path, RR_DCKC, RR_DCKC_CHK) == 0 {
+        return;
+    }
+    let result = hal.read_rf(path, RR_DCK, RR_DCK_DONE);
+    if result > 1 {
+        hal.write_rf(path, RR_RXBB2, RR_RXBB2_IDAC, result);
+        rx_dck_toggle(hal, path);
+        hal.write_rf(path, RR_RXBB2, RR_RXBB2_IDAC, 1);
+    }
+}
+
+/// `_rx_dck`: each path's RX DC offset (TSSI paused), the last try taken
+/// as failed and recovered; the temperature it was done at.
+fn rx_dck_paths(hal: &Hal, state: &mut State, retry_limit: u32) {
+    for path in 0..2u8 {
+        let reg5 = hal.read_rf(path, RR_RSV1, RFREG_MASK);
+        let trk = R_P0_TSSI_TRK + ((path as u32) << 13);
+        if state.tssi_mode[path as usize] {
+            hal.phy_w32_mask(trk, B_P0_TSSI_TRK_EN, 1);
+        }
+        hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 0);
+        hal.write_rf(path, RR_MOD, RR_MOD_MASK, RR_MOD_V_RX);
+        hal.write_rf(path, RR_MOD, RR_MOD_LO_SEL, 0);
+        for count in 0..retry_limit {
+            set_rx_dck(hal, path);
+            if count == retry_limit - 1 {
+                rx_dck_recover(hal, path);
+                break;
+            }
+            if !rx_dck_rek_check(hal, path) {
+                break;
+            }
+        }
+        state.rx_dck_thermal[path as usize] = state.thermal.read(path);
+        hal.write_rf(path, RR_RSV1, RFREG_MASK, reg5);
+        if state.tssi_mode[path as usize] {
+            hal.phy_w32_mask(trk, B_P0_TSSI_TRK_EN, 0);
+        }
+    }
+}
+
+/// `rtw8852c_rx_dck`: one try, TX held.
+pub(crate) fn rx_dck(hal: &Hal, state: &mut State) {
+    crate::sta::stop_sch_tx(hal, true);
+    rx_dck_paths(hal, state, 1);
+    crate::sta::stop_sch_tx(hal, false);
+}
+
+/// `_rx_dck_channel_calc`: a channel away from the one in use for the
+/// calibration on 5 and 6 GHz.
+fn rx_dck_channel(chan: &Chan) -> u8 {
+    match chan.band {
+        phy::BAND_5G => match chan.channel {
+            36..=64 => 100,
+            100..=144 => {
+                if chan.channel + 32 > 144 {
+                    chan.channel + 33
+                } else {
+                    chan.channel + 32
+                }
+            }
+            149..=177 => chan.channel - 33,
+            _ => 0,
+        },
+        phy::BAND_6G => {
+            if chan.channel > 125 {
+                chan.channel - 32
+            } else {
+                chan.channel + 32
+            }
+        }
+        _ => chan.channel,
+    }
+}
+
+/// `RTW8852C_RX_DCK_TH`, `RTW8852C_LCK_TH`.
+const RX_DCK_TH: i32 = 12;
+const LCK_TH: i32 = 8;
+
+/// `rtw8852c_rx_dck_track`: on 5 and 6 GHz, the RX DC offset again on
+/// another channel when the temperature moved, up to twenty tries.
+fn rx_dck_track(hal: &Hal, state: &mut State, chan: &Chan) {
+    if chan.band == phy::BAND_2G {
+        return;
+    }
+    let moved = (0..2u8).any(|path| (state.thermal.read(path) as i32 - state.rx_dck_thermal[path as usize] as i32).abs() >= RX_DCK_TH);
+    if !moved {
+        return;
+    }
+    crate::sta::stop_sch_tx(hal, true);
+    crate::rtw88xx::ctrl_ch_8852c(hal, rx_dck_channel(chan), chan.band);
+    rx_dck_paths(hal, state, 20);
+    crate::rtw88xx::ctrl_ch_8852c(hal, chan.channel, chan.band);
+    crate::sta::stop_sch_tx(hal, false);
+}
+
+/// `_lck`: the LO calibrated again by writing the channel back (path A
+/// alone without DBCC); the temperature it was done at.
+fn lck(hal: &Hal, state: &mut State) {
+    let rf18 = hal.read_rf(0, RR_CFGCH, RFREG_MASK);
+    hal.write_rf(0, RR_LCK_TRG, RR_LCK_TRGSEL, 1);
+    hal.write_rf(0, RR_CFGCH, RFREG_MASK, rf18);
+    hal.write_rf(0, RR_LCK_TRG, RR_LCK_TRGSEL, 0);
+    state.lck_thermal = [state.thermal.read(0), state.thermal.read(1)];
+}
+
+/// `rtw8852c_lck_track`.
+fn lck_track(hal: &Hal, state: &mut State) {
+    if (0..2u8).any(|path| (state.thermal.read(path) as i32 - state.lck_thermal[path as usize] as i32).abs() >= LCK_TH) {
+        lck(hal, state);
+    }
+}
+
+// ---- DPK. ----
+
+/// `enum rtw8852c_dpk_id`: the one-shots the host starts.
+const D_KIP_PRESET: u32 = 0x28;
+const D_TXAGC: u32 = 0x29;
+const D_RXAGC: u32 = 0x2a;
+const D_SYNC: u32 = 0x2b;
+const D_GAIN_LOSS: u32 = 0x2c;
+const D_MDPK_IDL: u32 = 0x2d;
+const D_KIP_RESTORE: u32 = 0x31;
+const LBK_RXIQK: u32 = 0x06;
+/// `enum rf_mode`: DPK, RX.
+const RF_DPK: u32 = 0x5;
+const RF_RX: u32 = 0x3;
+/// The TX power the AGC starts from and keeps to, in dBm.
+const DPK_INIT_DBM: u32 = 15;
+const DPK_DBM_MIN: u32 = 7;
+const DPK_DBM_MAX: u32 = 24;
+/// The sync's limits (`DPK_SYNC_TH_*`).
+const DPK_SYNC_TH_DC: u32 = 200;
+const DPK_SYNC_TH_CORR: u32 = 170;
+/// The tone of the loopback RX IQK (Q.2, 9.25 MHz).
+const RX_TONE_IDX: u32 = 0x0025_0025;
+/// The registers the DPK keeps per path (`kip_reg`).
+const DPK_KIP_REGS: [u32; 7] = [0x813c, 0x8124, 0x8120, 0xc0c4, 0xc0e8, 0xc0d4, 0xc0d8];
+/// Each table's parameters by K set (`dpk_par_regs`), table 0's used.
+const DPK_PAR_REGS: [u32; 4] = [0x8190, 0x8194, 0x8198, 0x81a4];
+const DPK_PARA_TXAGC: u32 = 0x0000_fc00;
+const DPK_PARA_THER: u32 = 0xfc00_0000;
+const DPK_PARA_GS: u32 = 0x0000_007f;
+const DPK_GS_DEFAULT: u32 = 0x5b;
+/// The power scaling factor a result starts from.
+const DPK_PWSF: i32 = 0x78;
+
+/// A path's DPK result (table 0: Linux keeps no others without reload).
+#[derive(Clone, Copy, Default)]
+struct DpkResult {
+    band: u8,
+    ch: u8,
+    bw: u8,
+    ok: bool,
+    mdpd_en: u32,
+    txagc: u32,
+    ther_dpk: u32,
+    gs: u32,
+}
+
+#[derive(Default)]
+struct Dpk {
+    enabled: bool,
+    path: [DpkResult; 2],
+    cur_k_set: usize,
+}
+
+/// `_dpk_one_shot`: whether the NCTL did not finish in 20 ms.
+fn dpk_one_shot(hal: &Hal, path: u8, id: u32) -> bool {
+    let cmd = (id << 8) | (0x19 + path as u32 * 0x12);
+    hal.phy_w32_mask(R_NCTL_CFG, MASKDWORD, cmd);
+    let done = poll(|| hal.phy_r32_mask(R_RFK_ST, MASKBYTE0) == NCTL_DONE, 10, 20_000);
+    crate::delay_us(10);
+    hal.phy_clr(R_NCTL_N1, MASKBYTE0);
+    !done
+}
+
+/// `_dpk_kip_control_rfc`: the RF driven by the KIP or the baseband.
+fn dpk_kip_control_rfc(hal: &Hal, path: u8, by_kip: bool) {
+    hal.phy_w32_mask(R_UPD_CLK + ((path as u32) << 13), B_IQK_RFC_ON, by_kip as u32);
+}
+
+/// `_dpk_txpwr_bb_force`.
+fn dpk_txpwr_bb_force(hal: &Hal, path: u8, force: bool) {
+    let p = (path as u32) << 13;
+    hal.phy_w32_mask(R_TXPWRB + p, B_TXPWRB_ON, force as u32);
+    hal.phy_w32_mask(R_TXPWRB_H + p, B_TXPWRB_RDY, force as u32);
+}
+
+/// `_dpk_bb_afe_setting`.
+fn dpk_bb_afe_setting(hal: &Hal, path: u8) {
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_A0 << path, 1);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_A1 << path, 0);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_A2 << path, 1);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_A3 << path, 0);
+    hal.phy_w32_mask(R_UPD_CLK + ((path as u32) << 13), MASKDWORD, 0xd801_dffd);
+    txck_force(hal, path, true, DAC_960M);
+    rxck_force(hal, path, true, ADC_1920M);
+    hal.phy_w32_mask(R_P0_NRBW + ((path as u32) << 13), B_P0_NRBW_DBG, 1);
+    hal.phy_w32_mask(R_ANAPAR_PW15, MASKBYTE3, 0x1f);
+    hal.phy_w32_mask(R_ANAPAR_PW15, MASKBYTE3, 0x13);
+    hal.phy_w32_mask(R_ANAPAR, MASKHWORD, 0x0001);
+    hal.phy_w32_mask(R_ANAPAR, MASKHWORD, 0x0041);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_A1 << path, 1);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_A3 << path, 1);
+}
+
+/// `_dpk_bb_afe_restore`.
+fn dpk_bb_afe_restore(hal: &Hal, path: u8) {
+    hal.phy_w32_mask(R_P0_NRBW + ((path as u32) << 13), B_P0_NRBW_DBG, 0);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_A0 << path, 1);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_A1 << path, 0);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_A2 << path, 1);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_A3 << path, 0);
+    hal.phy_w32_mask(R_UPD_CLK + ((path as u32) << 13), MASKDWORD, 0);
+    hal.phy_w32_mask(R_P0_RXCK + ((path as u32) << 13), B_P0_TXCK_ALL, 0);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_A0 << path, 0);
+    hal.phy_w32_mask(R_ADC_FIFO, B_ADC_FIFO_A2 << path, 0);
+}
+
+/// `_dpk_lbk_rxiqk`: the RX IQ through the loopback at the largest RX
+/// gain, what it moved put back.
+fn dpk_lbk_rxiqk(hal: &Hal, path: u8) {
+    let iqp = R_KIP_IQP + ((path as u32) << 8);
+    hal.phy_w32_mask(R_DPD_V1 + ((path as u32) << 8), B_DPD_LBK, 1);
+    hal.phy_w32_mask(R_MDPK_RX_DCK, B_MDPK_RX_DCK_EN, 1);
+    dpk_kip_control_rfc(hal, path, false);
+    let rxbb = hal.read_rf(path, RR_MOD, RR_MOD_M_RXBB);
+    let rf11 = hal.read_rf(path, RR_TXIG, RFREG_MASK);
+    let sw = hal.phy_r32_mask(iqp, B_KIP_IQP_SW);
+    hal.write_rf(path, RR_TXIG, RR_TXIG_GR0, 0);
+    hal.write_rf(path, RR_TXIG, RR_TXIG_GR1, 0x3);
+    hal.write_rf(path, RR_TXIG, RR_TXIG_TG, 0xd);
+    hal.write_rf(path, RR_MOD, RR_MOD_M_RXBB, 0x1f);
+    hal.phy_w32_mask(iqp, B_KIP_IQP_IQSW, 0x12);
+    hal.phy_w32_mask(iqp, B_KIP_IQP_SW, 0x3);
+    dpk_kip_control_rfc(hal, path, true);
+    hal.phy_w32_mask(R_IQK_DIF4, MASKDWORD, RX_TONE_IDX);
+    dpk_one_shot(hal, path, LBK_RXIQK);
+    dpk_kip_control_rfc(hal, path, false);
+    hal.write_rf(path, RR_TXIG, RFREG_MASK, rf11);
+    hal.write_rf(path, RR_MOD, RR_MOD_M_RXBB, rxbb);
+    hal.phy_w32_mask(iqp, B_KIP_IQP_SW, sw);
+    hal.phy_w32_mask(R_MDPK_RX_DCK, B_MDPK_RX_DCK_EN, 0);
+    hal.phy_w32_mask(R_KPATH_CFG, B_KPATH_CFG_ED, 0);
+    hal.phy_w32_mask(R_LOAD_COEF + ((path as u32) << 8), B_LOAD_COEF_DI, 1);
+    dpk_kip_control_rfc(hal, path, true);
+}
+
+/// `_dpk_rf_setting` (no DBCC).
+fn dpk_rf_setting(hal: &Hal, path: u8, result: &DpkResult) {
+    if result.band == phy::BAND_2G {
+        hal.write_rf(path, RR_MOD, RFREG_MASK, 0x50121 | 1);
+        hal.write_rf(path, RR_MOD_V1, RR_MOD_MASK, RF_DPK);
+        hal.write_rf(path, RR_RXBB, RR_RXBB_ATTC, 0x2);
+        hal.write_rf(path, RR_RXBB, RR_RXBB_ATTR, 0x4);
+        hal.write_rf(path, RR_LUTDBG, RR_LUTDBG_TIA, 1);
+        hal.write_rf(path, RR_TIA, RR_TIA_N6, 1);
+    } else {
+        hal.write_rf(path, RR_MOD, RFREG_MASK, 0x50101 | 1);
+        hal.write_rf(path, RR_MOD_V1, RR_MOD_MASK, RF_DPK);
+        if result.band == phy::BAND_6G && result.ch >= 161 {
+            hal.write_rf(path, RR_IQGEN, RR_IQGEN_BIAS, 0x8);
+        }
+        hal.write_rf(path, RR_LOGEN, RR_LOGEN_RPT, 0xd);
+        hal.write_rf(path, RR_TXAC, RR_TXAC_IQG, 0x8);
+        hal.write_rf(path, RR_RXA2, RR_RXA2_ATT, 0);
+        hal.write_rf(path, RR_TXIQK, RR_TXIQK_ATT2, 0x3);
+        hal.write_rf(path, RR_LUTDBG, RR_LUTDBG_TIA, 1);
+        hal.write_rf(path, RR_TIA, RR_TIA_N6, 1);
+        if result.bw == 3 {
+            hal.write_rf(path, RR_RXBB2, RR_RXBB2_EBW, 0);
+        }
+    }
+}
+
+/// `_dpk_tpg_sel`: the test pattern for the width.
+fn dpk_tpg_sel(hal: &Hal, bw: u8) {
+    let (mode, sel) = match bw {
+        3 => (0x3, 0x0180_ff30),
+        2 => (0x0, 0xffe0_fa00),
+        1 => (0x2, 0xff40_09e0),
+        _ => (0x1, 0xf9f0_07d0),
+    };
+    hal.phy_w32_mask(R_TPG_MOD, B_TPG_MOD_F, mode);
+    hal.phy_w32_mask(R_TPG_SEL, MASKDWORD, sel);
+}
+
+/// `_dpk_sync_check`: whether the sync failed (DC too high, too little
+/// correlation).
+fn dpk_sync_check(hal: &Hal) -> bool {
+    hal.phy_w32_mask(R_KIP_RPT1, B_KIP_RPT1_SEL, 0);
+    let corr = hal.phy_r32_mask(R_RPT_COM, B_PRT_COM_CORV);
+    hal.phy_w32_mask(R_KIP_RPT1, B_KIP_RPT1_SEL, 0x9);
+    let dc_i = sign_extend12(hal.phy_r32_mask(R_RPT_COM, B_PRT_COM_DCI)).unsigned_abs();
+    let dc_q = sign_extend12(hal.phy_r32_mask(R_RPT_COM, B_PRT_COM_DCQ)).unsigned_abs();
+    dc_i > DPK_SYNC_TH_DC || dc_q > DPK_SYNC_TH_DC || corr < DPK_SYNC_TH_CORR
+}
+
+/// `_dpk_dgain_read`.
+fn dpk_dgain_read(hal: &Hal) -> u32 {
+    hal.phy_clr(R_KIP_RPT1, B_KIP_RPT1_SEL);
+    hal.phy_r32_mask(R_RPT_COM, B_PRT_COM_DCI)
+}
+
+/// `_dpk_kset_query`: the K set the KIP took.
+fn dpk_kset_query(hal: &Hal, dpk: &mut Dpk, path: u8) {
+    hal.phy_w32_mask(R_KIP_RPT + ((path as u32) << 8), B_KIP_RPT_SEL, 0x10);
+    let set = hal.phy_r32_mask(R_RPT_PER + ((path as u32) << 8), 0xe000_0000);
+    dpk.cur_k_set = (set.saturating_sub(1) as usize).min(DPK_PAR_REGS.len() - 1);
+}
+
+/// `_dpk_kip_set_txagc`: the TX power (dBm, kept to the AGC's range) when
+/// the baseband sets it.
+fn dpk_kip_set_txagc(hal: &Hal, dpk: &mut Dpk, path: u8, dbm: Option<u32>) {
+    if let Some(dbm) = dbm {
+        let dbm = dbm.clamp(DPK_DBM_MIN, DPK_DBM_MAX);
+        hal.phy_w32_mask(R_TXPWRB + ((path as u32) << 13), B_TXPWRB_VAL, dbm << 2);
+    }
+    dpk_one_shot(hal, path, D_TXAGC);
+    dpk_kset_query(hal, dpk, path);
+}
+
+/// `_dpk_gainloss`.
+fn dpk_gainloss(hal: &Hal, dpk: &mut Dpk, path: u8) -> u32 {
+    dpk_one_shot(hal, path, D_GAIN_LOSS);
+    dpk_kip_set_txagc(hal, dpk, path, None);
+    hal.phy_w32_mask(R_DPK_GL + ((path as u32) << 8), B_DPK_GL_A1, 0);
+    hal.phy_w32_mask(R_DPK_GL + ((path as u32) << 8), B_DPK_GL_A0, 0);
+    hal.phy_w32_mask(R_KIP_RPT1, B_KIP_RPT1_SEL, 0x6);
+    hal.phy_w32_mask(R_DPK_CFG2, B_DPK_CFG2_ST, 1);
+    hal.phy_r32_mask(R_RPT_COM, B_PRT_COM_GL)
+}
+
+/// `enum dpk_pas_result`.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Pas {
+    Normal,
+    Greater,
+    Less,
+}
+
+/// `_dpk_pas_read`: the first sample's power against the last's.
+fn dpk_pas_read(hal: &Hal) -> Pas {
+    hal.phy_w32_mask(R_KIP_RPT1, MASKBYTE2, 0x06);
+    hal.phy_w32_mask(R_DPK_CFG2, B_DPK_CFG2_ST, 0);
+    hal.phy_w32_mask(R_DPK_CFG3, MASKBYTE2, 0x08);
+    let sample = |index: u32| {
+        hal.phy_w32_mask(R_DPK_CFG3, MASKBYTE3, index);
+        let i = sign_extend12(hal.phy_r32_mask(R_RPT_COM, MASKHWORD)).unsigned_abs();
+        let q = sign_extend12(hal.phy_r32_mask(R_RPT_COM, MASKLWORD)).unsigned_abs();
+        i * i + q * q
+    };
+    let (first, last) = (sample(0x00), sample(0x1f));
+    if first < last {
+        Pas::Less
+    } else if first >= last * 8 / 5 {
+        Pas::Greater
+    } else {
+        Pas::Normal
+    }
+}
+
+/// `_dpk_kip_set_rxagc`: whether the sync failed.
+fn dpk_kip_set_rxagc(hal: &Hal, path: u8) -> bool {
+    dpk_kip_control_rfc(hal, path, false);
+    let mode = hal.read_rf(path, RR_MOD, RFREG_MASK);
+    hal.phy_w32_mask(R_KIP_MOD, B_KIP_MOD, mode);
+    dpk_kip_control_rfc(hal, path, true);
+    dpk_one_shot(hal, path, D_RXAGC);
+    dpk_sync_check(hal)
+}
+
+/// `_dpk_agc` (`enum dpk_agc_step`): the TX power by the gain loss and the
+/// compression, then the RX gain; whether the sync failed.
+fn dpk_agc(hal: &Hal, dpk: &mut Dpk, path: u8, band: u8) -> bool {
+    #[derive(Clone, Copy)]
+    enum Step {
+        SyncDgain,
+        GainLossIdx,
+        GlGt,
+        GlLt,
+        SetTxGain,
+    }
+    let (mut step, mut dbm, mut gl_idx, mut count, mut limit) = (Step::SyncDgain, DPK_INIT_DBM, 0u32, 0u32, 200);
+    let mut failed = false;
+    loop {
+        let mut out = false;
+        match step {
+            Step::SyncDgain => {
+                failed = dpk_kip_set_rxagc(hal, path);
+                if failed {
+                    out = true;
+                } else {
+                    let dgain = dpk_dgain_read(hal);
+                    if !(0x556..=0x5fc).contains(&dgain) {
+                        dpk_one_shot(hal, path, D_SYNC);
+                        dpk_dgain_read(hal);
+                    }
+                    if count == 0 {
+                        if band == phy::BAND_2G {
+                            // `_dpk_bypass_rxiqc`.
+                            hal.phy_w32_mask(R_DPD_V1 + ((path as u32) << 8), B_DPD_LBK, 1);
+                            hal.phy_w32_mask(R_RXIQC + ((path as u32) << 8), MASKDWORD, CFIR_FAILED);
+                        } else {
+                            dpk_lbk_rxiqk(hal, path);
+                        }
+                    }
+                    step = Step::GainLossIdx;
+                }
+            }
+            Step::GainLossIdx => {
+                gl_idx = dpk_gainloss(hal, dpk, path);
+                let pas = dpk_pas_read(hal);
+                step = if pas == Pas::Less && gl_idx > 0 {
+                    Step::GlLt
+                } else if (pas == Pas::Greater && gl_idx == 0) || gl_idx >= 7 {
+                    Step::GlGt
+                } else if gl_idx == 0 {
+                    Step::GlLt
+                } else {
+                    Step::SetTxGain
+                };
+            }
+            Step::GlGt => {
+                if dbm <= DPK_DBM_MIN {
+                    out = true;
+                } else {
+                    dbm = dbm.saturating_sub(3).max(DPK_DBM_MIN);
+                    dpk_kip_set_txagc(hal, dpk, path, Some(dbm));
+                }
+                step = Step::SyncDgain;
+                count += 1;
+            }
+            Step::GlLt => {
+                if dbm >= DPK_DBM_MAX {
+                    out = true;
+                } else {
+                    dbm = (dbm + 2).min(DPK_DBM_MAX);
+                    dpk_kip_set_txagc(hal, dpk, path, Some(dbm));
+                }
+                step = Step::SyncDgain;
+                count += 1;
+            }
+            Step::SetTxGain => {
+                dpk_kip_control_rfc(hal, path, false);
+                let rxbb = (hal.read_rf(path, RR_MOD, RR_MOD_M_RXBB) + gl_idx).min(0x1f);
+                hal.write_rf(path, RR_MOD, RR_MOD_M_RXBB, rxbb);
+                dpk_kip_control_rfc(hal, path, true);
+                out = true;
+            }
+        }
+        limit -= 1;
+        if out || count >= 6 || limit <= 0 {
+            break;
+        }
+    }
+    failed
+}
+
+/// `_dpk_set_mdpd_para`: the DPD's order (`(5,3,1)`, `(5,3,0)`, `(5,0,0)`,
+/// `(7,3,1)`).
+fn dpk_set_mdpd_para(hal: &Hal, order: usize) {
+    const ORDERS: [&[phy::Rfk]; 4] = [RTW8852C_DPK_MDPD_ORDER0_DEFS, RTW8852C_DPK_MDPD_ORDER1_DEFS, RTW8852C_DPK_MDPD_ORDER2_DEFS, RTW8852C_DPK_MDPD_ORDER3_DEFS];
+    rfk(hal, ORDERS[order]);
+}
+
+/// `_dpk_idl_mpa`: the order (a forced one, else by width), the model,
+/// again on an overflow (at most five times, then the smallest order).
+fn dpk_idl_mpa(hal: &Hal, path: u8, bw: u8) {
+    hal.phy_w32_mask(R_LDL_NORM, B_LDL_NORM_MA, 1);
+    let order = if hal.phy_r32_mask(R_DPK_MPA, B_DPK_MPA_T2) == 1 {
+        2
+    } else if hal.phy_r32_mask(R_DPK_MPA, B_DPK_MPA_T1) == 1 {
+        1
+    } else if hal.phy_r32_mask(R_DPK_MPA, B_DPK_MPA_T0) == 1 {
+        0
+    } else {
+        match bw {
+            0 => 2,
+            1 | 2 => 1,
+            _ => 0,
+        }
+    };
+    dpk_set_mdpd_para(hal, order);
+    hal.phy_w32_mask(R_DPK_IDL, B_DPK_IDL, 0);
+    crate::delay_ms(1);
+    dpk_one_shot(hal, path, D_MDPK_IDL);
+    let overflow = || {
+        hal.phy_w32_mask(R_KIP_RPT1, B_KIP_RPT1_SEL, 0xf);
+        hal.phy_r32_mask(R_RPT_COM, B_PRT_COM_SYNERR) == 1
+    };
+    let mut ov = overflow();
+    for _ in 0..5 {
+        if !ov {
+            break;
+        }
+        dpk_one_shot(hal, path, D_MDPK_IDL);
+        ov = overflow();
+    }
+    if ov {
+        dpk_set_mdpd_para(hal, 2);
+        dpk_one_shot(hal, path, D_MDPK_IDL);
+    }
+}
+
+/// `_dpk_order_convert`.
+fn dpk_order_convert(hal: &Hal) -> u32 {
+    match hal.phy_r32_mask(R_LDL_NORM, B_LDL_NORM_OP) {
+        0 => 0x6,
+        1 => 0x2,
+        2 => 0x0,
+        3 => 0x7,
+        _ => 0xff,
+    }
+}
+
+/// `_dpk_onoff` (table 0).
+fn dpk_onoff(hal: &Hal, dpk: &Dpk, path: u8, off: bool) {
+    let result = &dpk.path[path as usize];
+    let value = if dpk.enabled && !off && result.ok { result.mdpd_en } else { 0 };
+    hal.phy_w32_mask(R_DPD_CH0A + ((path as u32) << 8), B_DPD_MEN, value);
+}
+
+/// `_dpk_main` of a path: whether it failed.
+fn dpk_main(hal: &Hal, state: &mut State, path: u8) -> bool {
+    let p = (path as u32) << 8;
+    let result = state.dpk.path[path as usize];
+    dpk_kip_control_rfc(hal, path, false);
+    hal.write_rf(path, RR_RSV1, RR_RSV1_RST, 0);
+    hal.write_rf(path, RR_BBDC, RFREG_MASK, 0x03ffd);
+    dpk_rf_setting(hal, path, &result);
+    set_rx_dck(hal, path);
+    rfk(hal, RTW8852C_DPK_KIP_PWR_CLK_ON_DEFS);
+    // `_dpk_kip_preset_8852c`.
+    let mode = hal.read_rf(path, RR_MOD, RFREG_MASK);
+    hal.phy_w32_mask(R_KIP_MOD, B_KIP_MOD, mode);
+    hal.phy_w32_mask(R_DPD_CH0A + p, B_DPD_SEL, if hal.cv == CHIP_CAV as u8 { 0x01 } else { 0x0c });
+    dpk_kip_control_rfc(hal, path, true);
+    hal.phy_w32_mask(R_COEF_SEL + p, B_COEF_SEL_MDPD, 0);
+    dpk_one_shot(hal, path, D_KIP_PRESET);
+    dpk_txpwr_bb_force(hal, path, true);
+    dpk_kip_set_txagc(hal, &mut state.dpk, path, Some(DPK_INIT_DBM));
+    dpk_tpg_sel(hal, result.bw);
+    let failed = dpk_agc(hal, &mut state.dpk, path, result.band);
+    if !failed {
+        dpk_idl_mpa(hal, path, result.bw);
+        // `_dpk_para_query`.
+        let par = DPK_PAR_REGS[state.dpk.cur_k_set] + p;
+        let para = hal.phy_r32_mask(par, MASKDWORD);
+        let set = state.dpk.cur_k_set;
+        let entry = &mut state.dpk.path[path as usize];
+        entry.txagc = get(DPK_PARA_TXAGC, para);
+        entry.ther_dpk = get(DPK_PARA_THER, para);
+        // `_dpk_on`.
+        hal.phy_w32_mask(R_LOAD_COEF + p, B_LOAD_COEF_MDPD, 1);
+        hal.phy_w32_mask(R_LOAD_COEF + p, B_LOAD_COEF_MDPD, 0);
+        hal.phy_w32_mask(R_DPD_CH0A + p, B_DPD_ORDER, dpk_order_convert(hal));
+        entry.mdpd_en = 1 << set;
+        entry.ok = true;
+        hal.phy_w32_mask(R_DPD_CH0A + p, B_DPD_MEN, entry.mdpd_en);
+        // `_dpk_gain_normalize_8852c` (not executed): the default.
+        hal.phy_w32_mask(par, DPK_PARA_GS, DPK_GS_DEFAULT);
+        entry.gs = hal.phy_r32_mask(par, DPK_PARA_GS);
+    }
+    dpk_kip_control_rfc(hal, path, false);
+    hal.write_rf(path, RR_MOD, RR_MOD_MASK, RF_RX);
+    failed
+}
+
+/// `rtw8852c_dpk` (`_dpk`, `_dpk_cal_select` without reload): both paths
+/// on table 0, the KIP's registers and the RF's kept around them; none
+/// on the first cut outside 2.4 GHz. The RX DC offset again when its
+/// check asks.
+fn dpk(hal: &Hal, state: &mut State, chan: &Chan) {
+    crate::sta::stop_sch_tx(hal, true);
+    wait_rx_mode(hal);
+    if hal.cv == CHIP_CAV as u8 && chan.band != phy::BAND_2G {
+        for path in 0..2u8 {
+            dpk_onoff(hal, &state.dpk, path, true);
+        }
+    } else {
+        let mut kip = [[0u32; 7]; 2];
+        let mut rf = [[0u32; 7]; 2];
+        for path in 0..2u8 {
+            kip[path as usize] = DPK_KIP_REGS.map(|reg| hal.phy_r32_mask(reg + ((path as u32) << 8), MASKDWORD));
+            rf[path as usize] = backup_rf(hal, path);
+            state.dpk.path[path as usize] = DpkResult { band: chan.band, ch: chan.channel, bw: chan.bw, ..Default::default() };
+            if state.tssi_mode[path as usize] {
+                hal.phy_w32_mask(R_P0_TSSI_TRK + ((path as u32) << 13), B_P0_TSSI_TRK_EN, 1);
+            }
+        }
+        for path in 0..2u8 {
+            rxagc(hal, path, 0);
+            hal.write_rf(path, RR_BBDC, RR_BBDC_SEL, 0);
+            dpk_bb_afe_setting(hal, path);
+            let failed = dpk_main(hal, state, path);
+            dpk_onoff(hal, &state.dpk, path, failed);
+        }
+        for path in 0..2u8 {
+            // `_dpk_kip_restore`.
+            dpk_one_shot(hal, path, D_KIP_RESTORE);
+            dpk_kip_control_rfc(hal, path, false);
+            dpk_txpwr_bb_force(hal, path, false);
+            for (reg, value) in DPK_KIP_REGS.iter().zip(kip[path as usize]) {
+                hal.phy_w32_mask(reg + ((path as u32) << 8), MASKDWORD, value);
+            }
+            restore_rf(hal, path, &rf[path as usize]);
+            dpk_bb_afe_restore(hal, path);
+            rxagc(hal, path, 1);
+            if state.tssi_mode[path as usize] {
+                hal.phy_w32_mask(R_P0_TSSI_TRK + ((path as u32) << 13), B_P0_TSSI_TRK_EN, 0);
+            }
+        }
+        rfk(hal, RTW8852C_DPK_KIP_PWR_CLK_OFF_DEFS);
+    }
+    crate::sta::stop_sch_tx(hal, false);
+    if hal.read_rf(0, RR_DCKC, RR_DCKC_CHK) == 1 {
+        rx_dck(hal, state);
+    }
+}
+
+/// `_dpk_track`: on the first cut, the power scaling factor moved by half
+/// the temperature's change since the calibration.
+fn dpk_track(hal: &Hal, state: &State) {
+    if hal.cv != CHIP_CAV as u8 {
+        return;
+    }
+    let mut delta: i32 = 0;
+    for path in 0..2u8 {
+        let p = (path as u32) << 13;
+        let result = state.dpk.path[path as usize];
+        let txagc_rf = hal.phy_r32_mask(R_TXAGC_BB + p, 0x0000_003f);
+        let current = state.thermal.read(path);
+        if result.ch != 0 && current != 0 {
+            delta = (result.ther_dpk as i32 - current as i32) as i8 as i32;
+        }
+        delta = (delta / 2) as i8 as i32;
+        if hal.phy_r32_mask(R_DPK_WR, B_DPK_WR_ST) == 0 && txagc_rf != 0 {
+            hal.phy_w32_mask(R_DPD_BND + ((path as u32) << 8), 0x07fc_0000, (DPK_PWSF - delta) as u32);
+        }
+    }
+}
+
+// ---- TSSI. ----
+
+/// `_tssi_get_trim_group`: eight groups, two runs between two.
+fn trim_group(ch: u8) -> phy::Group {
+    use phy::Group::{Between, One};
+    match ch {
+        1..=8 => One(0),
+        9..=14 => One(1),
+        36..=48 => One(2),
+        49..=51 => Between(2),
+        52..=64 => One(3),
+        100..=112 => One(4),
+        113..=115 => Between(4),
+        116..=128 => One(5),
+        132..=144 => One(6),
+        149..=177 => One(7),
+        _ => One(0),
+    }
+}
+
+/// `_tssi_get_6g_trim_group`: two groups of thirteen channels in each 32
+/// (three between the first and the second), the last three alone.
+fn trim_group_6g(ch: u8) -> phy::Group {
+    use phy::Group::{Between, One};
+    if !(1..=253).contains(&ch) {
+        return One(0);
+    }
+    let pair = ((ch - 1) / 32) as usize * 2;
+    match (ch - 1) % 32 {
+        0..=12 => One(pair),
+        13..=15 => Between(pair),
+        16..=28 => One(pair + 1),
+        _ => One(0),
+    }
+}
+
+/// `_tssi_set_efuse_to_de`: the eFuse's offsets with their trims for the
+/// channel, 6 GHz's from its own groups.
+fn tssi_set_efuse_to_de(hal: &Hal, tssi: &Tssi, chan: &Chan) {
+    let six = chan.band == phy::BAND_6G;
+    for path in 0..2usize {
+        let trim = if six { phy::group_value(&tssi.trim_6g[path], trim_group_6g(chan.channel)) } else { phy::group_value(&tssi.trim[path], trim_group(chan.channel)) } as i32;
+        let cck = (tssi.cck[path][phy::cck_group(chan.channel)] as i32 + trim) as u32;
+        for reg in rtw8852b_rfk::TSSI_DE_CCK[path] {
+            hal.phy_w32_mask(reg, rtw8852b_rfk::TSSI_DE_MASK, cck);
+        }
+        let ofdm = if six { phy::group_value(&tssi.mcs_6g[path], phy::ofdm_group_6g(chan.channel)) } else { phy::group_value(&tssi.mcs[path], phy::ofdm_group(chan.channel)) } as i32;
+        for reg in rtw8852b_rfk::TSSI_DE_MCS[path] {
+            hal.phy_w32_mask(reg, rtw8852b_rfk::TSSI_DE_MASK, (ofdm + trim) as u32);
+        }
+    }
+}
+
+/// `rtw8852c_tssi` and `rtw8852c_tssi_scan` (`scan`: only when the loop is
+/// on, the band's parts again): the closed loop set up per path and turned
+/// on with the eFuse's offsets.
+fn tssi(hal: &Hal, state: &mut State, efuse: &Tssi, track: Option<&TxPowerTrack>, chan: &Chan, scan: bool) {
+    if scan && !(state.tssi_mode[0] && state.tssi_mode[1]) {
+        return;
+    }
+    let two_g = chan.band == phy::BAND_2G;
+    // `_tssi_disable`.
+    for path in 0..2u8 {
+        rfk_by(hal, path == 0, RTW8852C_TSSI_DISABLE_DEFS_A, RTW8852C_TSSI_DISABLE_DEFS_B);
+        state.tssi_mode[path as usize] = false;
+    }
+    for path in 0..2u8 {
+        let a = path == 0;
+        // `_tssi_set_sys`.
+        rfk(hal, RTW8852C_TSSI_SYS_DEFS);
+        let clk = match chan.bw {
+            2 => 0x1,
+            3 => 0x2,
+            _ => 0x0,
+        };
+        if a {
+            hal.phy_w32_mask(R_P0_TSSI_ADC_CLK, B_P0_TSSI_ADC_CLK, clk);
+            rfk_by(hal, two_g, RTW8852C_TSSI_SYS_DEFS_2G_A, RTW8852C_TSSI_SYS_DEFS_5G_A);
+        } else {
+            hal.phy_w32_mask(R_P1_TSSI_ADC_CLK, B_P1_TSSI_ADC_CLK, clk);
+            rfk_by(hal, two_g, RTW8852C_TSSI_SYS_DEFS_2G_B, RTW8852C_TSSI_SYS_DEFS_5G_B);
+        }
+        if !scan {
+            rfk_by(hal, a, RTW8852C_TSSI_TXPWR_CTRL_BB_DEFS_A, RTW8852C_TSSI_TXPWR_CTRL_BB_DEFS_B);
+            rfk_by(hal, a, RTW8852C_TSSI_TXPWR_CTRL_BB_HE_TB_DEFS_A, RTW8852C_TSSI_TXPWR_CTRL_BB_HE_TB_DEFS_B);
+        }
+        // `_tssi_set_dck`.
+        rfk_by(hal, a, RTW8852C_TSSI_DCK_DEFS_A, RTW8852C_TSSI_DCK_DEFS_B);
+        if a {
+            rfk_by(hal, two_g, RTW8852C_TSSI_DCK_DEFS_2G_A, RTW8852C_TSSI_DCK_DEFS_5G_A);
+        } else {
+            rfk_by(hal, two_g, RTW8852C_TSSI_DCK_DEFS_2G_B, RTW8852C_TSSI_DCK_DEFS_5G_B);
+        }
+        if !scan {
+            rfk_by(hal, a, RTW8852C_TSSI_SET_BBGAIN_SPLIT_A, RTW8852C_TSSI_SET_BBGAIN_SPLIT_B);
+        }
+        rtw8852b_rfk::tssi_set_tmeter_tbl(hal, path, chan, efuse, track);
+        // `_tssi_slope_cal_org`.
+        if a {
+            rfk_by(hal, two_g, RTW8852C_TSSI_SLOPE_CAL_ORG_DEFS_2G_A, RTW8852C_TSSI_SLOPE_CAL_ORG_DEFS_5G_A);
+        } else {
+            rfk_by(hal, two_g, RTW8852C_TSSI_SLOPE_CAL_ORG_DEFS_2G_B, RTW8852C_TSSI_SLOPE_CAL_ORG_DEFS_5G_B);
+        }
+        // `_tssi_set_aligk_default`.
+        let aligk: [[&[phy::Rfk]; 3]; 2] = [
+            [RTW8852C_TSSI_SET_ALIGK_DEFAULT_DEFS_2G_A, RTW8852C_TSSI_SET_ALIGK_DEFAULT_DEFS_5G_A, RTW8852C_TSSI_SET_ALIGK_DEFAULT_DEFS_6G_A],
+            [RTW8852C_TSSI_SET_ALIGK_DEFAULT_DEFS_2G_B, RTW8852C_TSSI_SET_ALIGK_DEFAULT_DEFS_5G_B, RTW8852C_TSSI_SET_ALIGK_DEFAULT_DEFS_6G_B],
+        ];
+        rfk(hal, aligk[path as usize][band_row(chan.band)]);
+        if !scan {
+            rfk_by(hal, a, RTW8852C_TSSI_SLOPE_DEFS_A, RTW8852C_TSSI_SLOPE_DEFS_B);
+            rfk_by(hal, a, RTW8852C_TSSI_RUN_SLOPE_DEFS_A, RTW8852C_TSSI_RUN_SLOPE_DEFS_B);
+        }
+    }
+    // `_tssi_enable`.
+    for path in 0..2u8 {
+        let a = path == 0;
+        rfk_by(hal, a, RTW8852C_TSSI_TRACK_DEFS_A, RTW8852C_TSSI_TRACK_DEFS_B);
+        rfk_by(hal, a, RTW8852C_TSSI_TXAGC_OFST_MV_AVG_DEFS_A, RTW8852C_TSSI_TXAGC_OFST_MV_AVG_DEFS_B);
+        rfk_by(hal, a, RTW8852C_TSSI_ENABLE_DEFS_A, RTW8852C_TSSI_ENABLE_DEFS_B);
+        state.tssi_mode[path as usize] = true;
+    }
+    tssi_set_efuse_to_de(hal, efuse, chan);
+}
+
+// ---- The state, the power trims, the entry points. ----
+
+/// What the RTL8852C's calibrations keep; the eFuse's thermal trims.
+#[derive(Default)]
+pub(crate) struct State {
+    pub(crate) tssi_mode: [bool; 2],
+    thermal: Thermal,
+    thermal_trim: Option<[u8; 2]>,
+    iqk: IqkInfo,
+    dpk: Dpk,
+    rx_dck_thermal: [u32; 2],
+    lck_thermal: [u32; 2],
+}
+
+/// `rtw8852c_get_thermal`: the RF's meter with the eFuse's trim (±8).
+fn read_thermal(hal: &Hal, trim: Option<[u8; 2]>, path: u8) -> u32 {
+    let value = rtw8852b_rfk::rf_thermal(hal, path);
+    let comp: i32 = match trim {
+        Some(trim) if trim[path as usize] & THM_MASK_VAL8 != 0 => {
+            if trim[path as usize] & THM_MASK_SIGN != 0 {
+                -8
+            } else {
+                8
+            }
+        }
+        _ => 0,
+    };
+    (value as i32 + comp) as u8 as u32
+}
+
+/// `rtw8852c_rfk_init`'s state (the TSSI off, `rtw8852c_lck_init`,
+/// `rtw8852c_dpk_init`); the RC, the DACs and the RX DC offset are the
+/// chip's power on.
+pub(crate) fn init(state: &mut State, efuse: &crate::mac::Efuse) {
+    state.tssi_mode = [false; 2];
+    state.thermal_trim = efuse.thermal_trim;
+    state.lck_thermal = [state.thermal.read(0), state.thermal.read(1)];
+    state.dpk.enabled = true;
+}
+
+/// `rtw8852c_rfk_channel` after the RX DC offset: IQK, TSSI, DPK.
+pub(crate) fn channel(hal: &Hal, state: &mut State, tssi_efuse: Option<&Tssi>, track: Option<&TxPowerTrack>, chan: &Chan) {
+    iqk(hal, &mut state.iqk, chan);
+    if let Some(efuse) = tssi_efuse {
+        tssi(hal, state, efuse, track, chan, false);
+    }
+    dpk(hal, state, chan);
+}
+
+/// `rtw8852c_tssi_scan` on a band change.
+pub(crate) fn tssi_scan(hal: &Hal, state: &mut State, tssi_efuse: &Tssi, track: Option<&TxPowerTrack>, chan: &Chan) {
+    tssi(hal, state, tssi_efuse, track, chan, true);
+}
+
+/// `rtw89_phy_stat_thermal_update` and `rtw8852c_rfk_track`: the DPD with
+/// the temperature, the LO's calibration and (not while scanning) the RX
+/// DC offset again when it moved.
+pub(crate) fn track(hal: &Hal, state: &mut State, chan: Option<&Chan>, scanning: bool) {
+    let trim = state.thermal_trim;
+    for path in 0..2u8 {
+        let value = read_thermal(hal, trim, path);
+        state.thermal.add(path, value);
+    }
+    dpk_track(hal, state);
+    lck_track(hal, state);
+    if let Some(chan) = chan
+        && !scanning
+    {
+        rx_dck_track(hal, state, chan);
+    }
+}
