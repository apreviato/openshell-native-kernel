+/// `rtw89_mac_port_update` for port 0: the network's type, beacon
+/// interval, the BSSID filter on once joined.
+pub(crate) fn port_update(hal: &Hal, net_type: u32, beacon_interval: u16, dtim: u8) {
+    let r = if hal.chip.be { &PORT_BE } else { &PORT_AX };
+    let cfg = r.cfg;
+    if hal.r32(cfg) & B_AX_PORT_FUNC_EN != 0 {
+        hal.clr32(cfg, B_AX_PORT_FUNC_EN | B_AX_BRK_SETUP);
+        hal.set32(cfg, B_AX_TSFTR_RST);
+        hal.w32(r.bcn_cnt_tmr, 0);
+    }
+    hal.w32_mask(cfg, B_AX_NET_TYPE_MASK, net_type);
+    let linked = net_type != RTW89_NET_TYPE_NO_LINK;
+    let infra = net_type == RTW89_NET_TYPE_INFRA;
+    for (bits, on) in [(B_AX_TBTT_PROHIB_EN | B_AX_BRK_SETUP, linked), (B_AX_RX_BSSID_FIT_EN, infra), (B_AX_TSF_UDT_EN, infra), (B_AX_BCNTX_EN, net_type == RTW89_NET_TYPE_AP_MODE)] {
+        if on {
+            hal.set32(cfg, bits);
+        } else {
+            hal.clr32(cfg, bits);
+        }
+    }
+    hal.w32_mask(r.bcn_space, B_AX_BCN_SPACE_MASK, if beacon_interval == 0 { BCN_INTERVAL } else { beacon_interval as u32 });
+    hal.w8(r.hiq_win, if net_type == RTW89_NET_TYPE_AP_MODE { 16 } else { 0 });
+    hal.set8(r.md_tsft, B_AX_UPD_HGQMD | B_AX_UPD_TIMIE);
+    hal.w16_mask(r.dtim_ctrl, B_AX_DTIM_NUM_MASK, dtim as u32);
+    let drop = hal.r32(r.mbssid_drop) & !field(B_AX_PORT_DROP_4_0_MASK, 1) & !1;
+    hal.w32(r.mbssid_drop, drop);
+    hal.w32_mask(r.tbtt_prohib, B_AX_TBTT_SETUP_MASK, BCN_SETUP_DEF);
+    hal.w32_mask(r.tbtt_prohib, B_AX_TBTT_HOLD_MASK, BCN_HOLD_DEF);
+    hal.w32_mask(r.bcn_area, B_AX_BCN_MSK_AREA_MASK, BCN_MASK_DEF);
+    hal.w16_mask(r.tbtt_early, B_AX_TBTTERLY_MASK, TBTT_ERLY_DEF);
+    if net_type != RTW89_NET_TYPE_AP_MODE {
+        hal.clr32(r.mbssid, B_AX_P0MB_ALL_MASK);
+    }
+    hal.set32(cfg, B_AX_PORT_FUNC_EN);
+    crate::delay_us(BCN_ERLY_SET_DLY as u64);
+    hal.w32_mask(r.bcn_early, B_AX_BCNERLY_MASK, BCN_ERLY_DEF);
+}
+
+/// Port 0's registers (`struct rtw89_port_reg`, `rtw89_port_base_ax` and
+/// `_be`: the same fields, other addresses).
+struct PortRegs {
+    cfg: u32,
+    bcn_cnt_tmr: u32,
+    bcn_space: u32,
+    hiq_win: u32,
+    md_tsft: u32,
+    dtim_ctrl: u32,
+    mbssid_drop: u32,
+    tbtt_prohib: u32,
+    bcn_area: u32,
+    tbtt_early: u32,
+    mbssid: u32,
+    bcn_early: u32,
+}
+
+const PORT_AX: PortRegs = PortRegs {
+    cfg: R_AX_PORT_CFG_P0,
+    bcn_cnt_tmr: R_AX_BCN_CNT_TMR_P0,
+    bcn_space: R_AX_BCN_SPACE_CFG_P0,
+    hiq_win: R_AX_P0MB_HGQ_WINDOW_CFG_0,
+    md_tsft: R_AX_MD_TSFT_STMP_CTL,
+    dtim_ctrl: R_AX_DTIM_CTRL_P0,
+    mbssid_drop: R_AX_MBSSID_DROP_0,
+    tbtt_prohib: R_AX_TBTT_PROHIB_P0,
+    bcn_area: R_AX_BCN_AREA_P0,
+    tbtt_early: R_AX_TBTTERLYINT_CFG_P0,
+    mbssid: R_AX_MBSSID_CTRL,
+    bcn_early: R_AX_BCNERLYINT_CFG_P0,
+};
+
+const PORT_BE: PortRegs = PortRegs {
+    cfg: R_BE_PORT_CFG_P0,
+    bcn_cnt_tmr: R_BE_BCN_CNT_TMR_P0,
+    bcn_space: R_BE_BCN_SPACE_CFG_P0,
+    hiq_win: R_BE_P0MB_HGQ_WINDOW_CFG_0,
+    md_tsft: R_BE_WMTX_MOREDATA_TSFT_STMP_CTL,
+    dtim_ctrl: R_BE_DTIM_CTRL_P0,
+    mbssid_drop: R_BE_MBSSID_DROP_0,
+    tbtt_prohib: R_BE_TBTT_PROHIB_P0,
+    bcn_area: R_BE_BCN_AREA_P0,
+    tbtt_early: R_BE_TBTTERLYINT_CFG_P0,
+    mbssid: R_BE_MBSSID_CTRL,
+    bcn_early: R_BE_BCNERLYINT_CFG_P0,
+};
+
+/// `rtw89_mac_dmac_tbl_init` and `rtw89_mac_cmac_tbl_init` (not on
+/// secure-boot chips, whose firmware owns them).
+pub(crate) fn tables_init(hal: &Hal, mac_id: u32) {
+    // The BE chips' tables are the firmware's (`rtw89_fw_h2c_default_dmac_tbl_v2`).
+    if hal.secure_boot || hal.chip.be {
+        return;
+    }
+    for word in 0..4 {
+        hal.w32(R_AX_FILTER_MODEL_ADDR, DMAC_TBL_BASE_ADDR + (mac_id << 4) + (word << 2));
+        hal.w32(R_AX_INDIR_ACCESS_ENTRY, 0);
+    }
+    hal.w32(R_AX_FILTER_MODEL_ADDR, CMAC_TBL_BASE_ADDR + mac_id * CCTL_INFO_SIZE);
+    for (at, value) in [(0, 0x4), (4, 0x400a_0004), (8, 0), (12, 0), (16, 0), (20, 0x0e43_000b), (24, 0), (28, 0xb_8109)] {
+        hal.w32(R_AX_INDIR_ACCESS_ENTRY + at, value);
+    }
+}
+
+/// The RX filter's options (`rtw89_mac_update_rts_threshold`'s sibling):
+/// while scanning, beacons of every network; joined, only ours.
+pub(crate) fn set_rx_filter(hal: &Hal, value: u32) {
+    if hal.chip.be {
+        return crate::be::set_rx_filter(hal, value);
+    }
+    hal.w32(R_AX_RX_FLTR_OPT, (hal.r32(R_AX_RX_FLTR_OPT) & B_AX_RX_MPDU_MAX_LEN_MASK) | (value & !B_AX_RX_MPDU_MAX_LEN_MASK));
+}
diff --git a/kernel/comps/rtw89/src/pci.rs b/kernel/comps/rtw89/src/pci.rs
new file mode 100644
index 0000000..ac3bff8
--- /dev/null
+++ b/kernel/comps/rtw89/src/pci.rs
@@ -0,0 +1,1153 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The PCIe side as Linux's rtw89 `pci.c` runs it on the 802.11ax chips:
+//! a ring of buffer descriptors per TX channel (data and management frames
+//! through a WD page each: the TX descriptor, the WP info naming the page,
+//! the address of the frame; firmware commands straight from their
+//! buffer), two RX rings (frames and firmware events; release reports of
+//! the frames sent), the PCIe settings Linux makes before the MAC starts.
+//! The 802.11be chips (`pci_be.c`) have their own ring registers, PCIe
+//! settings and interrupts, descriptors of the second version, and RX
+//! buffers tagged in order (the host's index one behind).
+
+use alloc::{vec, vec::Vec};
+
+use aster_linuxkpi::bits::{get_le16, get_le32};
+use ostd::mm::{HasDaddr, PAGE_SIZE, VmIo, dma::DmaCoherent};
+
+use crate::{
+    hal::{ChipId, Hal, field, get},
+    regs::*,
+};
+
+/// The TX channels (`enum rtw89_tx_channel`).
+pub(crate) const TXCH_ACH0: usize = 0;
+pub(crate) const TXCH_CH8: usize = 8;
+pub(crate) const TXCH_CH12: usize = 12;
+const TXCH_NUM: usize = 13;
+const RXCH_RXQ: usize = 0;
+const RXCH_RPQ: usize = 1;
+
+/// Ring depths: the channels this driver sends on, the others (their
+/// registers set all the same).
+const TXBD_USED: usize = 64;
+const TXBD_IDLE: usize = 16;
+const RXBD_NUM: usize = 64;
+const TX_BD: usize = 8;
+const RX_BD: usize = 8;
+/// A WD page (`RTW89_PCI_TXWD_PAGE_SIZE`), the frame after it in the same
+/// page of memory.
+const WD_PAGE: usize = 128;
+pub(crate) const TX_FRAME_MAX: usize = PAGE_SIZE - WD_PAGE;
+/// An RX buffer (`RTW89_PCI_RX_BUF_SIZE`), three pages for it.
+const RX_BUF: usize = 11454 + 40 + 4;
+const RX_SLOT: usize = 3 * PAGE_SIZE;
+const RPQ_SLOT: usize = PAGE_SIZE;
+/// `struct rtw89_pci_rxbd_info` and an RPP entry.
+const RXBD_INFO: usize = 4;
+const RPP_SIZE: usize = 4;
+/// A WD page sent but not released this long is taken back.
+const STALE_MS: u64 = 2_000;
+
+/// `RTW89_PCI_TXBD_OPT_LS`, `RTW89_PCI_TXWP_VALID`,
+/// `RTW89_PCI_ADDR_MSDU_LS`, `RTW89_PCI_ADDR_NUM(1)`.
+const TXBD_OPT_LS: u16 = 1 << 14;
+const TXWP_VALID: u16 = 1 << 15;
+const ADDR_MSDU_LS: u16 = 1 << 15;
+const ADDR_NUM_1: u16 = 1 << 10;
+
+/// A channel's registers (`struct rtw89_pci_ch_dma_addr`).
+#[derive(Clone, Copy)]
+struct ChAddr {
+    num: u32,
+    idx: u32,
+    bdram: u32,
+    desa_l: u32,
+}
+
+/// `rtw89_pci_ch_dma_addr_set_be`.
+fn tx_addrs_be(channel: usize) -> ChAddr {
+    let a = |num, idx, desa_l| ChAddr { num, idx, bdram: 0, desa_l };
+    match channel {
+        0 => a(R_BE_CH0_TXBD_NUM_V1, R_BE_CH0_TXBD_IDX_V1, R_BE_CH0_TXBD_DESA_L_V1),
+        1 => a(R_BE_CH1_TXBD_NUM_V1, R_BE_CH1_TXBD_IDX_V1, R_BE_CH1_TXBD_DESA_L_V1),
+        2 => a(R_BE_CH2_TXBD_NUM_V1, R_BE_CH2_TXBD_IDX_V1, R_BE_CH2_TXBD_DESA_L_V1),
+        3 => a(R_BE_CH3_TXBD_NUM_V1, R_BE_CH3_TXBD_IDX_V1, R_BE_CH3_TXBD_DESA_L_V1),
+        4 => a(R_BE_CH4_TXBD_NUM_V1, R_BE_CH4_TXBD_IDX_V1, R_BE_CH4_TXBD_DESA_L_V1),
+        5 => a(R_BE_CH5_TXBD_NUM_V1, R_BE_CH5_TXBD_IDX_V1, R_BE_CH5_TXBD_DESA_L_V1),
+        6 => a(R_BE_CH6_TXBD_NUM_V1, R_BE_CH6_TXBD_IDX_V1, R_BE_CH6_TXBD_DESA_L_V1),
+        7 => a(R_BE_CH7_TXBD_NUM_V1, R_BE_CH7_TXBD_IDX_V1, R_BE_CH7_TXBD_DESA_L_V1),
+        8 => a(R_BE_CH8_TXBD_NUM_V1, R_BE_CH8_TXBD_IDX_V1, R_BE_CH8_TXBD_DESA_L_V1),
+        9 => a(R_BE_CH9_TXBD_NUM_V1, R_BE_CH9_TXBD_IDX_V1, R_BE_CH9_TXBD_DESA_L_V1),
+        10 => a(R_BE_CH10_TXBD_NUM_V1, R_BE_CH10_TXBD_IDX_V1, R_BE_CH10_TXBD_DESA_L_V1),
+        11 => a(R_BE_CH11_TXBD_NUM_V1, R_BE_CH11_TXBD_IDX_V1, R_BE_CH11_TXBD_DESA_L_V1),
+        _ => a(R_BE_CH12_TXBD_NUM_V1, R_BE_CH12_TXBD_IDX_V1, R_BE_CH12_TXBD_DESA_L_V1),
+    }
+}
+
+fn rx_addrs_be(channel: usize) -> ChAddr {
+    let a = |num, idx, desa_l| ChAddr { num, idx, bdram: 0, desa_l };
+    if channel == RXCH_RXQ { a(R_BE_RXQ0_RXBD_NUM_V1, R_BE_RXQ0_RXBD_IDX_V1, R_BE_RXQ0_RXBD_DESA_L_V1) } else { a(R_BE_RPQ0_RXBD_NUM_V1, R_BE_RPQ0_RXBD_IDX_V1, R_BE_RPQ0_RXBD_DESA_L_V1) }
+}
+
+/// `pci_be.c`'s watchdog timers (`PL0_TMR_*`) and PCIe settings.
+const PL0_TMR_ANA_172US: u32 = 0x800;
+const PL0_TMR_MAC_1MS: u32 = 0x27100;
+const PL0_TMR_AUX_1MS: u32 = 0x1e848;
+const PCIE_RXBD_NORM: u32 = 0;
+/// `RTW89_PCI_RXBD_TAG`'s width: a buffer's tag counts from 1 and wraps.
+const RX_TAG_MASK: u32 = 0x1fff;
+
+fn replace(value: u32, mask: u32, new: u32) -> u32 {
+    (value & !mask) | field(mask, new)
+}
+
+/// `rtw89_pci_ch_dma_addr_set` and its `_v1` (the RTL8852C's).
+fn tx_addrs(v1: bool, channel: usize) -> ChAddr {
+    let a = |num, idx, bdram, desa_l| ChAddr { num, idx, bdram, desa_l };
+    if !v1 {
+        return match channel {
+            0 => a(R_AX_ACH0_TXBD_NUM, R_AX_ACH0_TXBD_IDX, R_AX_ACH0_BDRAM_CTRL, R_AX_ACH0_TXBD_DESA_L),
+            1 => a(R_AX_ACH1_TXBD_NUM, R_AX_ACH1_TXBD_IDX, R_AX_ACH1_BDRAM_CTRL, R_AX_ACH1_TXBD_DESA_L),
+            2 => a(R_AX_ACH2_TXBD_NUM, R_AX_ACH2_TXBD_IDX, R_AX_ACH2_BDRAM_CTRL, R_AX_ACH2_TXBD_DESA_L),
+            3 => a(R_AX_ACH3_TXBD_NUM, R_AX_ACH3_TXBD_IDX, R_AX_ACH3_BDRAM_CTRL, R_AX_ACH3_TXBD_DESA_L),
+            4 => a(R_AX_ACH4_TXBD_NUM, R_AX_ACH4_TXBD_IDX, R_AX_ACH4_BDRAM_CTRL, R_AX_ACH4_TXBD_DESA_L),
+            5 => a(R_AX_ACH5_TXBD_NUM, R_AX_ACH5_TXBD_IDX, R_AX_ACH5_BDRAM_CTRL, R_AX_ACH5_TXBD_DESA_L),
+            6 => a(R_AX_ACH6_TXBD_NUM, R_AX_ACH6_TXBD_IDX, R_AX_ACH6_BDRAM_CTRL, R_AX_ACH6_TXBD_DESA_L),
+            7 => a(R_AX_ACH7_TXBD_NUM, R_AX_ACH7_TXBD_IDX, R_AX_ACH7_BDRAM_CTRL, R_AX_ACH7_TXBD_DESA_L),
+            8 => a(R_AX_CH8_TXBD_NUM, R_AX_CH8_TXBD_IDX, R_AX_CH8_BDRAM_CTRL, R_AX_CH8_TXBD_DESA_L),
+            9 => a(R_AX_CH9_TXBD_NUM, R_AX_CH9_TXBD_IDX, R_AX_CH9_BDRAM_CTRL, R_AX_CH9_TXBD_DESA_L),
+            10 => a(R_AX_CH10_TXBD_NUM, R_AX_CH10_TXBD_IDX, R_AX_CH10_BDRAM_CTRL, R_AX_CH10_TXBD_DESA_L),
+            11 => a(R_AX_CH11_TXBD_NUM, R_AX_CH11_TXBD_IDX, R_AX_CH11_BDRAM_CTRL, R_AX_CH11_TXBD_DESA_L),
+            _ => a(R_AX_CH12_TXBD_NUM, R_AX_CH12_TXBD_IDX, R_AX_CH12_BDRAM_CTRL, R_AX_CH12_TXBD_DESA_L),
+        };
+    }
+    match channel {
+        0 => a(R_AX_ACH0_TXBD_NUM, R_AX_ACH0_TXBD_IDX, R_AX_ACH0_BDRAM_CTRL_V1, R_AX_ACH0_TXBD_DESA_L_V1),
+        1 => a(R_AX_ACH1_TXBD_NUM, R_AX_ACH1_TXBD_IDX, R_AX_ACH1_BDRAM_CTRL_V1, R_AX_ACH1_TXBD_DESA_L_V1),
+        2 => a(R_AX_ACH2_TXBD_NUM, R_AX_ACH2_TXBD_IDX, R_AX_ACH2_BDRAM_CTRL_V1, R_AX_ACH2_TXBD_DESA_L_V1),
+        3 => a(R_AX_ACH3_TXBD_NUM, R_AX_ACH3_TXBD_IDX, R_AX_ACH3_BDRAM_CTRL_V1, R_AX_ACH3_TXBD_DESA_L_V1),
+        4 => a(R_AX_ACH4_TXBD_NUM, R_AX_ACH4_TXBD_IDX, R_AX_ACH4_BDRAM_CTRL_V1, R_AX_ACH4_TXBD_DESA_L_V1),
+        5 => a(R_AX_ACH5_TXBD_NUM, R_AX_ACH5_TXBD_IDX, R_AX_ACH5_BDRAM_CTRL_V1, R_AX_ACH5_TXBD_DESA_L_V1),
+        6 => a(R_AX_ACH6_TXBD_NUM, R_AX_ACH6_TXBD_IDX, R_AX_ACH6_BDRAM_CTRL_V1, R_AX_ACH6_TXBD_DESA_L_V1),
+        7 => a(R_AX_ACH7_TXBD_NUM, R_AX_ACH7_TXBD_IDX, R_AX_ACH7_BDRAM_CTRL_V1, R_AX_ACH7_TXBD_DESA_L_V1),
+        8 => a(R_AX_CH8_TXBD_NUM, R_AX_CH8_TXBD_IDX, R_AX_CH8_BDRAM_CTRL_V1, R_AX_CH8_TXBD_DESA_L_V1),
+        9 => a(R_AX_CH9_TXBD_NUM, R_AX_CH9_TXBD_IDX, R_AX_CH9_BDRAM_CTRL_V1, R_AX_CH9_TXBD_DESA_L_V1),
+        10 => a(R_AX_CH10_TXBD_NUM_V1, R_AX_CH10_TXBD_IDX_V1, R_AX_CH10_BDRAM_CTRL_V1, R_AX_CH10_TXBD_DESA_L_V1),
+        11 => a(R_AX_CH11_TXBD_NUM_V1, R_AX_CH11_TXBD_IDX_V1, R_AX_CH11_BDRAM_CTRL_V1, R_AX_CH11_TXBD_DESA_L_V1),
+        _ => a(R_AX_CH12_TXBD_NUM, R_AX_CH12_TXBD_IDX, R_AX_CH12_BDRAM_CTRL_V1, R_AX_CH12_TXBD_DESA_L_V1),
+    }
+}
+
+fn rx_addrs(v1: bool, channel: usize) -> ChAddr {
+    let a = |num, idx, desa_l| ChAddr { num, idx, bdram: 0, desa_l };
+    match (v1, channel) {
+        (false, RXCH_RXQ) => a(R_AX_RXQ_RXBD_NUM, R_AX_RXQ_RXBD_IDX, R_AX_RXQ_RXBD_DESA_L),
+        (false, _) => a(R_AX_RPQ_RXBD_NUM, R_AX_RPQ_RXBD_IDX, R_AX_RPQ_RXBD_DESA_L),
+        (true, RXCH_RXQ) => a(R_AX_RXQ_RXBD_NUM_V1, R_AX_RXQ_RXBD_IDX_V1, R_AX_RXQ_RXBD_DESA_L_V1),
+        (true, _) => a(R_AX_RPQ_RXBD_NUM_V1, R_AX_RPQ_RXBD_IDX_V1, R_AX_RPQ_RXBD_DESA_L_V1),
+    }
+}
+
+/// `rtw89_bd_ram_table_single` and `_dual`: start, most, least.
+fn bd_ram(dual: bool, channel: usize) -> Option<(u32, u32, u32)> {
+    if dual {
+        return Some(match channel {
+            0..=7 => (channel as u32 * 5, 5, 2),
+            8 => (40, 5, 1),
+            9 => (45, 5, 1),
+            10 => (50, 5, 1),
+            11 => (55, 5, 1),
+            _ => (60, 4, 1),
+        });
+    }
+    match channel {
+        0..=3 => Some((channel as u32 * 5, 5, 2)),
+        8 => Some((20, 4, 1)),
+        9 => Some((24, 4, 1)),
+        12 => Some((28, 4, 1)),
+        _ => None,
+    }
+}
+
+struct TxRing {
+    addr: ChAddr,
+    bds: DmaCoherent,
+    /// Data and management channels: a page each (WD page, then the frame);
+    /// the firmware's: the command.
+    pages: DmaCoherent,
+    len: usize,
+    wp: usize,
+    rp: usize,
+    /// The WD pages the chip has not released yet: when each went out.
+    busy: Vec<u64>,
+    next_page: usize,
+}
+
+struct RxRing {
+    addr: ChAddr,
+    bds: DmaCoherent,
+    buffers: DmaCoherent,
+    slot: usize,
+    wp: usize,
+    /// The BE chips: the tag the next buffer carries, and whether a frame
+    /// over several buffers is being skipped (no first-segment bit).
+    tag: u32,
+    partial: bool,
+}
+
+/// What `rtw89_tx_desc_info` holds of a frame.
+#[derive(Clone, Copy, Default)]
+pub(crate) struct TxDesc {
+    pub(crate) channel: usize,
+    pub(crate) qsel: u32,
+    pub(crate) mac_id: u32,
+    pub(crate) seq: u32,
+    /// Management: the rate it goes at, no fallback, the hardware's
+    /// sequence numbers.
+    pub(crate) use_rate: bool,
+    pub(crate) rate: u32,
+    pub(crate) hw_seq: bool,
+    pub(crate) tid_indicate: bool,
+    pub(crate) hdr_llc_len: u32,
+    pub(crate) bmc: bool,
+    pub(crate) sec_type: u32,
+    pub(crate) sec_cam: u32,
+    pub(crate) key_id: u32,
+    /// The BE chips put the security header in themselves: its PN, and
+    /// room for it (in eight bytes) after the MAC header.
+    pub(crate) pn: Option<u64>,
+    pub(crate) wp_offset: u32,
+    /// The rate a data frame's retries go down to.
+    pub(crate) lowest_rate: u32,
+    /// In an aggregate (`agg_en`): the most frames in one less one
+    /// (`ampdu_num`) and the peer's spacing (`ampdu_density`).
+    pub(crate) agg_en: bool,
+    pub(crate) ampdu_num: u32,
+    pub(crate) ampdu_density: u32,
+}
+
+pub(crate) struct Pci {
+    tx: Vec<Option<TxRing>>,
+    rx: Vec<RxRing>,
+    intrs: [u32; 3],
+    ind_intrs: u32,
+    halt_c2h: u32,
+}
+
+fn alloc(bytes: usize) -> Result<DmaCoherent, &'static str> {
+    aster_linuxkpi::dma::alloc_coherent32(bytes).ok_or("no DMA memory below 4 GiB")
+}
+
+impl Pci {
+    pub(crate) fn new(hal: &Hal) -> Result<Self, &'static str> {
+        let chip = hal.chip;
+        let dual = matches!(chip.id, ChipId::Rtl8852a | ChipId::Rtl8852c) || chip.be;
+        let mut tx = Vec::with_capacity(TXCH_NUM);
+        for channel in 0..TXCH_NUM {
+            // The channels of the second band, on chips without it.
+            if !dual && matches!(channel, 4..=7 | 10 | 11) {
+                tx.push(None);
+                continue;
+            }
+            let used = matches!(channel, TXCH_ACH0 | 1 | 2 | 3 | TXCH_CH8 | TXCH_CH12);
+            let len = if used { TXBD_USED } else { TXBD_IDLE };
+            let bds = alloc(len * TX_BD)?;
+            let pages = alloc(len * PAGE_SIZE)?;
+            let addr = if chip.be { tx_addrs_be(channel) } else { tx_addrs(chip.v1, channel) };
+            tx.push(Some(TxRing { addr, bds, pages, len, wp: 0, rp: 0, busy: vec![0; len], next_page: 0 }));
+        }
+        let mut rx = Vec::with_capacity(2);
+        for (channel, slot) in [(RXCH_RXQ, RX_SLOT), (RXCH_RPQ, RPQ_SLOT)] {
+            let bds = alloc(RXBD_NUM * RX_BD)?;
+            let buffers = alloc(RXBD_NUM * slot)?;
+            for index in 0..RXBD_NUM {
+                let mut bd = [0u8; RX_BD];
+                let size = if channel == RXCH_RXQ { RX_BUF } else { slot };
+                bd[0..2].copy_from_slice(&(size as u16).to_le_bytes());
+                let dma = (buffers.daddr() + index * slot) as u32;
+                bd[4..8].copy_from_slice(&dma.to_le_bytes());
+                bds.write_bytes(index * RX_BD, &bd).map_err(|_| "RX ring")?;
+            }
+            let addr = if chip.be { rx_addrs_be(channel) } else { rx_addrs(chip.v1, channel) };
+            rx.push(RxRing { addr, bds, buffers, slot, wp: 0, tag: 0, partial: false });
+        }
+        Ok(Self { tx, rx, intrs: [0; 3], ind_intrs: 0, halt_c2h: 0 })
+    }
+
+    fn dma_stop1(hal: &Hal) -> (u32, u32) {
+        match hal.id() {
+            ChipId::Rtl8852c => (R_AX_HAXI_DMA_STOP1, B_AX_TX_STOP1_MASK),
+            ChipId::Rtl8852a => (R_AX_PCIE_DMA_STOP1, B_AX_TX_STOP1_MASK),
+            _ => (R_AX_PCIE_DMA_STOP1, B_AX_TX_STOP1_MASK_V1),
+        }
+    }
+
+    fn dma_stop2(hal: &Hal) -> Option<(u32, u32)> {
+        match hal.id() {
+            ChipId::Rtl8852c => Some((R_AX_HAXI_DMA_STOP2, B_AX_TX_STOP2_ALL)),
+            ChipId::Rtl8852a => Some((R_AX_PCIE_DMA_STOP2, B_AX_TX_STOP2_ALL)),
+            _ => None,
+        }
+    }
+
+    /// `rtw89_pci_ctrl_dma_all`: the DMA's I/O and its TX and RX.
+    fn ctrl_dma_all(hal: &Hal, enable: bool) {
+        let (io_reg, io_bit) = if hal.chip.v1 { (R_AX_HAXI_INIT_CFG1, B_AX_STOP_AXI_MST) } else { (R_AX_PCIE_DMA_STOP1, B_AX_STOP_PCIEIO) };
+        let (init, bits) = if hal.chip.v1 { (R_AX_HAXI_INIT_CFG1, B_AX_RXHCI_EN_V1 | B_AX_TXHCI_EN_V1) } else { (R_AX_PCIE_INIT_CFG1, B_AX_RXHCI_EN | B_AX_TXHCI_EN) };
+        if enable {
+            hal.clr32(io_reg, io_bit);
+            hal.set32(init, bits);
+        } else {
+            hal.set32(io_reg, io_bit);
+            hal.clr32(init, bits);
+        }
+    }
+
+    fn ctrl_txdma(hal: &Hal, enable: bool) {
+        let (stop1, mask1) = Self::dma_stop1(hal);
+        if enable {
+            hal.clr32(stop1, mask1);
+        } else {
+            hal.set32(stop1, mask1);
+        }
+        if let Some((stop2, mask2)) = Self::dma_stop2(hal) {
+            if enable {
+                hal.clr32(stop2, mask2);
+            } else {
+                hal.set32(stop2, mask2);
+            }
+        }
+    }
+
+    /// The PCIe PHY's registers through MDIO (`rtw89_write16_mdio_*`).
+    fn mdio_rmw(hal: &Hal, addr: u32, clear: u16, set: u16, gen2: bool) {
+        // `rtw89_pci_check_mdio`: the address, the PHY page of the speed,
+        // the read or write flag until it clears.
+        let start = |flag: u32| -> bool {
+            hal.w8(R_AX_MDIO_CFG, addr as u8 & 0x1f);
+            let page = match (gen2, addr < 0x20) {
+                (false, true) => MDIO_PG0_G1,
+                (false, false) => MDIO_PG1_G1,
+                (true, true) => MDIO_PG0_G2,
+                (true, false) => MDIO_PG1_G2,
+            };
+            let value = (hal.r16(R_AX_MDIO_CFG) as u32 & !B_AX_MDIO_PHY_ADDR_MASK) | field(B_AX_MDIO_PHY_ADDR_MASK, page);
+            hal.w16(R_AX_MDIO_CFG, value as u16);
+            hal.set16(R_AX_MDIO_CFG, flag);
+            aster_linuxkpi::delay::read_poll_timeout(|| hal.r16(R_AX_MDIO_CFG), |value| *value as u32 & flag == 0, 10, 2000).is_ok()
+        };
+        if !start(B_AX_MDIO_RFLAG) {
+            return;
+        }
+        let value = hal.r16(R_AX_MDIO_RDATA);
+        hal.w16(R_AX_MDIO_WDATA, (value & !clear) | set);
+        let _ = start(B_AX_MDIO_WFLAG);
+    }
+
+    /// `rtw89_pci_ops_mac_pre_init_ax`: the PCIe's settings, its DMA
+    /// stopped, the rings set, then the firmware's channel let through.
+    pub(crate) fn mac_pre_init(&mut self, hal: &Hal) -> Result<(), &'static str> {
+        if hal.chip.be {
+            return self.mac_pre_init_be(hal);
+        }
+        let id = hal.id();
+        let xb = hal.is_885xb();
+        if id == ChipId::Rtl8852a {
+            hal.set32(R_AX_PCIE_INIT_CFG1, B_AX_DIS_RXDMA_PRE);
+        }
+        if id == ChipId::Rtl8852a || xb {
+            hal.clr32(R_AX_PCIE_PS_CTRL, B_AX_L1OFF_PWR_OFF_EN);
+        }
+        // The deglitch and RX enable latency of the PHY.
+        if id == ChipId::Rtl8852a {
+            for gen2 in [false, true] {
+                Self::mdio_rmw(hal, RAC_ANA24, B_AX_DEGLITCH as u16, 0, gen2);
+                Self::mdio_rmw(hal, RAC_ANA26, B_AX_RXEN as u16, 0, gen2);
+            }
+        } else if id == ChipId::Rtl8852c {
+            hal.clr16(R_RAC_DIRECT_OFFSET_G1 + RAC_ANA24 * 2, B_AX_DEGLITCH);
+            hal.clr16(R_RAC_DIRECT_OFFSET_G2 + RAC_ANA24 * 2, B_AX_DEGLITCH);
+        }
+        if id == ChipId::Rtl8852a || xb {
+            hal.clr32(R_AX_SYS_PW_CTRL, B_AX_PSUS_OFF_CAPC_EN);
+            hal.set32(R_AX_SYS_SDIO_CTRL, B_AX_PCIE_DIS_L2_CTRL_LDO_HCI);
+            hal.clr32(R_AX_SYS_SDIO_CTRL, B_AX_PCIE_DIS_WLSUS_AFT_PDN);
+        } else {
+            hal.clr32(R_AX_SYS_SDIO_CTRL, B_AX_PCIE_DIS_L2_CTRL_LDO_HCI);
+        }
+        if xb {
+            // `rtw89_pci_dphy_delay`: 25 µs before the CMU.
+            let mask = BAC_CMU_EN_DLY_MASK as u16;
+            let shift = mask.trailing_zeros();
+            Self::mdio_rmw(hal, RAC_REG_REV2, mask, ((PCIE_DPHY_DLY_25US as u16) << shift) & mask, false);
+        }
+        hal.set32(R_AX_HCI_OPT_CTRL, BIT_WAKE_CTRL);
+        if id == ChipId::Rtl8852c {
+            hal.set32(R_AX_PCIE_BG_CLR, B_AX_BG_CLR_ASYNC_M3);
+            hal.clr32(R_AX_PCIE_BG_CLR, B_AX_BG_CLR_ASYNC_M3);
+            if hal.cv == CHIP_CAV as u8 {
+                hal.set32(R_AX_SYS_SDIO_CTRL, B_AX_PCIE_FORCE_PWR_NGAT);
+                hal.set32(R_AX_PMC_DBG_CTRL2, B_AX_SYSON_DIS_PMCR_AX_WRMSK);
+                hal.set32(R_AX_HCI_BG_CTRL, B_AX_BG_CLR_ASYNC_M3);
+                hal.clr32(R_AX_PMC_DBG_CTRL2, B_AX_SYSON_DIS_PMCR_AX_WRMSK);
+            }
+            hal.clr32(R_AX_PCIE_PS_CTRL_V1, B_AX_SEL_REQ_ENTR_L1);
+            hal.set32(R_AX_PCIE_PS_CTRL_V1, B_AX_DMAC0_EXIT_L1_EN);
+            // `rtw89_pci_set_io_rcy`: on, 6 ms.
+            let timer = field(B_AX_PCIE_WDT_TIMER_M1_MASK, MAC_AX_IO_RCY_ANA_TMR_6MS);
+            for reg in [R_AX_PCIE_WDT_TIMER_M1, R_AX_PCIE_WDT_TIMER_M2, R_AX_PCIE_WDT_TIMER_E0] {
+                hal.w32(reg, timer);
+            }
+            hal.set32(R_AX_PCIE_IO_RCY_M1, B_AX_PCIE_IO_RCY_WDT_MODE_M1);
+            hal.set32(R_AX_PCIE_IO_RCY_M2, B_AX_PCIE_IO_RCY_WDT_MODE_M2);
+            hal.set32(R_AX_PCIE_IO_RCY_E0, B_AX_PCIE_IO_RCY_WDT_MODE_E0);
+            hal.clr32(R_AX_PCIE_IO_RCY_S1, B_AX_PCIE_IO_RCY_WDT_MODE_S1);
+        } else {
+            hal.clr32(R_AX_PCIE_EXP_CTRL, B_AX_SIC_EN_FORCE_CLKREQ);
+            // `rtw89_pci_set_lbc`: the watchdog, 2 ms.
+            let mut lbc = hal.r32(R_AX_LBC_WATCHDOG);
+            lbc = (lbc & !B_AX_LBC_TIMER) | field(B_AX_LBC_TIMER, MAC_AX_LBC_TMR_2MS);
+            lbc |= B_AX_LBC_FLAG | B_AX_LBC_EN;
+            hal.w32(R_AX_LBC_WATCHDOG, lbc);
+            hal.set32(R_AX_PCIE_DBG_CTRL, B_AX_ASFF_FULL_NO_STK | B_AX_EN_STUCK_DBG);
+            hal.w32_mask(R_AX_PCIE_EXP_CTRL, B_AX_EN_STUCK_DBG | B_AX_ASFF_FULL_NO_STK, B_AX_EN_STUCK_DBG >> (B_AX_EN_STUCK_DBG | B_AX_ASFF_FULL_NO_STK).trailing_zeros());
+            if id == ChipId::Rtl8852a {
+                hal.set32(R_AX_PCIE_EXP_CTRL, B_AX_EN_CHKDSC_NO_RX_STUCK);
+            }
+            hal.set32(R_AX_PCIE_INIT_CFG1, B_AX_PCIE_TXRST_KEEP_REG | B_AX_PCIE_RXRST_KEEP_REG);
+        }
+        let (stop1, _) = Self::dma_stop1(hal);
+        hal.set32(stop1, B_AX_STOP_WPDMA);
+        Self::ctrl_dma_all(hal, false);
+        self.poll_dma_idle(hal);
+        self.clear_indices(hal);
+        self.mode_op(hal);
+        self.reset_rings(hal);
+        hal.set32(R_AX_PCIE_INIT_CFG1, B_AX_RST_BDRAM);
+        if hal.poll32(R_AX_PCIE_INIT_CFG1, |value| value & B_AX_RST_BDRAM == 0, 1, 1000).is_err() {
+            return Err("the PCIe's BD RAM did not reset");
+        }
+        Self::ctrl_txdma(hal, false);
+        hal.clr32(stop1, B_AX_STOP_CH12);
+        Self::ctrl_dma_all(hal, true);
+        Ok(())
+    }
+
+    /// `rtw89_pci_ctrl_trxdma_pcie_be`: TX DMA, RX DMA, the AXI master's
+    /// I/O, each on, off or left.
+    fn trxdma_be(hal: &Hal, tx: Option<bool>, rx: Option<bool>, io: Option<bool>) {
+        let mut value = hal.r32(R_BE_HAXI_INIT_CFG1);
+        for (on, bit) in [(tx, B_BE_TXDMA_EN), (rx, B_BE_RXDMA_EN)] {
+            match on {
+                Some(true) => value |= bit,
+                Some(false) => value &= !bit,
+                None => {}
+            }
+        }
+        match io {
+            Some(true) => value &= !B_BE_STOP_AXI_MST,
+            Some(false) => value |= B_BE_STOP_AXI_MST,
+            None => {}
+        }
+        hal.w32(R_BE_HAXI_INIT_CFG1, value);
+        if io == Some(true) {
+            hal.w32_mask(R_BE_HAXI_MST_WDT_TIMEOUT_SEL_V1, B_BE_HAXI_MST_WDT_TIMEOUT_SEL_MASK, 4);
+        }
+    }
+
+    /// `rtw89_pci_ctrl_txdma_ch_be` (the data and management channels; 13
+    /// and 14 stay stopped) and `_fw_ch_be` (the H2C channel).
+    fn txdma_be(hal: &Hal, enable: bool, firmware: bool) {
+        let all = (B_BE_STOP_CH0 | B_BE_STOP_CH1 | B_BE_STOP_CH2 | B_BE_STOP_CH3 | B_BE_STOP_CH4 | B_BE_STOP_CH5 | B_BE_STOP_CH6 | B_BE_STOP_CH7 | B_BE_STOP_CH8 | B_BE_STOP_CH9 | B_BE_STOP_CH10 | B_BE_STOP_CH11) & B_BE_TX_STOP1_MASK;
+        let mut value = hal.r32(R_BE_HAXI_DMA_STOP1) | B_BE_STOP_CH13 | B_BE_STOP_CH14;
+        value = if enable { value & !all } else { value | all };
+        value = if firmware { value & !B_BE_STOP_CH12 } else { value | B_BE_STOP_CH12 };
+        hal.w32(R_BE_HAXI_DMA_STOP1, value);
+    }
+
+    /// `rtw89_pci_clr_idx_all_be`: the host's RX indices one behind.
+    fn clear_indices_be(&self, hal: &Hal) {
+        hal.w32(R_BE_TXBD_RWPTR_CLR1, B_BE_CLR_ALL_IDX_MASK);
+        hal.w32(R_BE_RXBD_RWPTR_CLR1_V1, B_BE_CLR_RXQ0_IDX | B_BE_CLR_RPQ0_IDX);
+        hal.w16(R_BE_RXQ0_RXBD_IDX_V1, RXBD_NUM as u16 - 1);
+        hal.w16(R_BE_RPQ0_RXBD_IDX_V1, RXBD_NUM as u16 - 1);
+    }
+
+    /// `rtw89_pci_disable_eq_be` (`rtw89_pci_basic_cfg` on the RTL8922A):
+    /// unless the link's PHY already selects its OOBS level, the offset
+    /// calibrated and taken as the manual level, the OOBS sensitivity
+    /// measured and taken, on both speeds' PHY registers.
+    pub(crate) fn disable_eq_be(hal: &Hal) {
+        let mask16 = |addr: u32, mask: u32| (hal.r16(addr) as u32 & mask) >> mask.trailing_zeros();
+        let gens = [R_RAC_DIRECT_OFFSET_BE_LANE0_G1, R_RAC_DIRECT_OFFSET_BE_LANE0_G2];
+        let reg = |base: u32, ana: u32| base + ana * RAC_MULT;
+        if gens.iter().all(|&base| mask16(reg(base, RAC_ANA09), BAC_OOBS_SEL) != 0) {
+            return;
+        }
+        let backup = hal.r32(R_BE_PCIE_MIX_CFG);
+        hal.clr32(R_BE_PCIE_MIX_CFG, B_BE_RTK_ASPM_CTRL_MASK);
+        for base in gens {
+            hal.clr16(reg(base, RAC_ANA19), B_PCIE_BIT_RD_SEL);
+        }
+        let offset_cal = mask16(reg(gens[0], RAC_ANA1F), OFFSET_CAL_MASK);
+        for base in gens {
+            hal.w16_mask(reg(base, RAC_ANA0B), MANUAL_LVL_MASK, offset_cal);
+            hal.clr16(reg(base, RAC_ANA0D), OFFSET_CAL_MODE);
+        }
+        for base in gens {
+            hal.set16(reg(base, RAC_ANA0D), BAC_RX_TEST_EN);
+            hal.w16_mask(reg(base, RAC_ANA10), ADDR_SEL_MASK, ADDR_SEL_VAL);
+            hal.clr16(reg(base, RAC_ANA10), B_PCIE_BIT_PINOUT_DIS);
+            hal.set16(reg(base, RAC_ANA19), B_PCIE_BIT_RD_SEL);
+        }
+        let oobs = mask16(reg(gens[0], RAC_ANA1F), OOBS_LEVEL_MASK);
+        for base in gens {
+            hal.w16_mask(reg(base, RAC_ANA03), OOBS_SEN_MASK, oobs);
+            hal.set16(reg(base, RAC_ANA09), BAC_OOBS_SEL);
+        }
+        hal.w32(R_BE_PCIE_MIX_CFG, backup);
+    }
+
+    /// `rtw89_pci_ops_mac_pre_init_be`: the watchdogs' timers, wake on,
+    /// the DMA stopped and idle, its modes, the rings, the BD RAM's bound,
+    /// the power and error-recovery settings, then the H2C channel and the
+    /// DMA on.
+    fn mac_pre_init_be(&mut self, hal: &Hal) -> Result<(), &'static str> {
+        for reg in [R_BE_AON_WDT_TMR, R_BE_MDIO_WDT_TMR, R_BE_LA_MODE_WDT_TMR, R_BE_WDT_AR_TMR, R_BE_WDT_AW_TMR, R_BE_WDT_W_TMR, R_BE_WDT_B_TMR, R_BE_WDT_R_TMR] {
+            hal.w32(reg, PL0_TMR_ANA_172US);
+        }
+        hal.w32(R_BE_WLAN_WDT_TMR, PL0_TMR_MAC_1MS);
+        hal.w32(R_BE_AXIDMA_WDT_TMR, PL0_TMR_MAC_1MS);
+        hal.w32(R_BE_LOCAL_WDT_TMR, PL0_TMR_AUX_1MS);
+        hal.set32(R_BE_HCI_OPT_CTRL, BIT_WAKE_CTRL_V1);
+        hal.set32(R_BE_HAXI_DMA_STOP1, B_BE_STOP_WPDMA);
+        Self::trxdma_be(hal, Some(false), Some(false), Some(false));
+        self.clear_indices_be(hal);
+        if hal.poll32(R_BE_HAXI_DMA_BUSY1, |value| value & DMA_BUSY1_CHECK_BE == 0, 10, 1000).is_err() || hal.poll32(R_BE_HAXI_DMA_BUSY1, |value| value & (B_BE_RXQ0_BUSY_V1 | B_BE_RPQ0_BUSY_V1) == 0, 10, 1000).is_err() {
+            return Err("the PCIe's DMA did not go idle");
+        }
+        // `rtw89_pci_mode_op_be`.
+        let mut init1 = hal.r32(R_BE_HAXI_INIT_CFG1);
+        let rxapp = hal.r32(R_BE_RX_APPEND_MODE);
+        let exp = replace(hal.r32(R_BE_HAXI_EXP_CTRL_V1), B_BE_MAX_TAG_NUM_MASK, MAC_AX_TAG_NUM_8);
+        init1 = replace(init1, B_BE_RXQ_RXBD_MODE_MASK, PCIE_RXBD_NORM);
+        init1 = replace(init1, B_BE_MAX_TXDMA_MASK, MAC_AX_TX_BURST_V1_256B);
+        init1 = replace(init1, B_BE_MAX_RXDMA_MASK, MAC_AX_RX_BURST_V1_128B);
+        init1 = replace(init1, B_BE_CFG_WD_PERIOD_IDLE_MASK, MAC_AX_WD_DMA_INTVL_256NS);
+        init1 = replace(init1, B_BE_CFG_WD_PERIOD_ACTIVE_MASK, MAC_AX_WD_DMA_INTVL_256NS);
+        hal.w32(R_BE_HAXI_INIT_CFG1, init1);
+        hal.w32(R_BE_RX_APPEND_MODE, rxapp);
+        hal.w32(R_BE_HAXI_EXP_CTRL_V1, exp);
+        self.reset_rings(hal);
+        hal.set32(R_BE_HAXI_INIT_CFG1, B_BE_SET_BDRAM_BOUND);
+        if hal.poll32(R_BE_HAXI_INIT_CFG1, |value| value & B_BE_SET_BDRAM_BOUND == 0, 50, 500_000).is_err() {
+            return Err("the PCIe's BD RAM did not take its bound");
+        }
+        // `rtw89_pci_debounce_be`, `_ldo_low_pwr_be`, `_pcie_setting_be`.
+        hal.w32(R_BE_SYS_PAGE_CLK_GATED, replace(hal.r32(R_BE_SYS_PAGE_CLK_GATED), B_BE_PCIE_PRST_DEBUNC_PERIOD_MASK, 0) | B_BE_SYM_PRST_DEBUNC_SEL);
+        hal.set32(R_BE_SYS_PW_CTRL, B_BE_PSUS_OFF_CAPC_EN);
+        hal.set32(R_BE_SYS_PAGE_CLK_GATED, B_BE_SOP_OFFPOOBS_PC | B_BE_CPHY_AUXCLK_OP | B_BE_CPHY_POWER_READY_CHK);
+        hal.clr32(R_BE_SYS_SDIO_CTRL, B_BE_PCIE_FORCE_IBX_EN | B_BE_PCIE_DIS_L2_RTK_PERST | B_BE_PCIE_DIS_L2__CTRL_LDO_HCI);
+        hal.clr32(R_BE_L1_2_CTRL_HCILDO, B_BE_PCIE_DIS_L1_2_CTRL_HCILDO);
+        hal.set32(R_BE_PCIE_FRZ_CLK, B_BE_PCIE_EN_AUX_CLK);
+        hal.clr32(R_BE_PCIE_PS_CTRL, B_BE_CMAC_EXIT_L1_EN);
+        if hal.cv != CHIP_CAV as u8 {
+            hal.set32(R_BE_EFUSE_CTRL_2_V1, B_BE_R_SYM_AUTOLOAD_WITH_PMC_SEL);
+            hal.set32(R_BE_PCIE_LAT_CTRL, B_BE_SYM_AUX_CLK_SEL);
+        }
+        // `rtw89_pci_ser_setting_be` for the RTL8922A.
+        hal.w32(R_BE_PL1_DBG_INFO, 0);
+        hal.clr32(R_BE_SER_PL1_CTRL, B_BE_PL1_SER_PL1_EN);
+        let ser = B_BE_SER_PMU_IMR | B_BE_SER_L1SUB_IMR | B_BE_SER_PM_MASTER_IMR | B_BE_SER_LTSSM_IMR | B_BE_SER_PM_CLK_MASK | B_BE_SER_PCLKREQ_ACK_MASK;
+        if hal.cv <= CHIP_CBV as u8 {
+            hal.w32_mask(R_BE_SER_PL1_CTRL, B_BE_PL1_TIMER_UNIT_MASK, PCIE_SER_TIMER_UNIT);
+            hal.w32(R_BE_REG_PL1_MASK, hal.r32(R_BE_REG_PL1_MASK) & !ser);
+        } else {
+            let _ = hal.poll32(R_BE_REG_PL1_ISR, |value| value == 0, 1, 1000);
+            hal.w32_mask(R_BE_SER_PL1_CTRL, B_BE_PL1_TIMER_UNIT_MASK, PCIE_SER_TIMER_UNIT);
+            hal.set32(R_BE_SER_PL1_CTRL, B_BE_PL1_SER_PL1_EN);
+            hal.w32(R_BE_REG_PL1_MASK, (hal.r32(R_BE_REG_PL1_MASK) | ser) & !B_BE_SER_L1SUB_IMR);
+        }
+        Self::txdma_be(hal, false, true);
+        Self::trxdma_be(hal, Some(true), Some(true), Some(true));
+        Ok(())
+    }
+
+    /// `rtw89_pci_ops_mac_post_init_be`: latency tolerance
+    /// (`rtw89_pci_ltr_set_v2`), the DMA's I/O and channels on, RX
+    /// interrupts moderated.
+    fn mac_post_init_be(&self, hal: &Hal) {
+        let bad = |value: u32| value == 0xffff_ffff || value == 0xeaea_eaea;
+        let regs = [R_BE_LTR_CTRL_0, R_BE_LTR_CFG_0, R_BE_LTR_CFG_1, R_BE_LTR_DECISION_CTRL_V1];
+        let [mut ctrl0, mut cfg0, mut cfg1, mut dec] = regs.map(|reg| hal.r32(reg));
+        if ![ctrl0, cfg0, cfg1, dec].into_iter().any(bad) {
+            dec |= B_BE_ENABLE_LTR_CTL_DECISION | B_BE_LTR_HW_DEC_EN_V1;
+            ctrl0 |= B_BE_LTR_HW_EN;
+            dec = replace(dec, B_BE_LTR_SPACE_IDX_MASK, PCI_LTR_SPC_500US);
+            cfg0 = replace(cfg0, B_BE_LTR_IDLE_TIMER_IDX_MASK, PCI_LTR_IDLE_TIMER_3_2MS);
+            cfg1 = replace(cfg1, B_BE_LTR_CMAC0_RX_USE_PG_TH_MASK, 0xc0);
+            cfg1 = replace(cfg1, B_BE_LTR_CMAC1_RX_USE_PG_TH_MASK, 0xc0);
+            cfg0 = replace(cfg0, B_BE_LTR_IDX_ACTIVE_MASK, 1);
+            cfg0 = replace(cfg0, B_BE_LTR_IDX_IDLE_MASK, 3);
+            dec = replace(dec, B_BE_LTR_IDX_DISABLE_V1_MASK, 0);
+            hal.w32(R_BE_LTR_LATENCY_IDX3_V1, 0x9003_9003);
+            hal.w32(R_BE_LTR_LATENCY_IDX1_V1, 0x880b_880b);
+            hal.w32(R_BE_LTR_LATENCY_IDX0_V1, 0);
+            hal.w32(R_BE_LTR_DECISION_CTRL_V1, dec);
+            hal.w32(R_BE_LTR_CFG_0, cfg0);
+            hal.w32(R_BE_LTR_CFG_1, cfg1);
+            hal.w32(R_BE_LTR_CTRL_0, ctrl0);
+        }
+        Self::trxdma_be(hal, None, None, Some(true));
+        hal.clr32(R_BE_HAXI_DMA_STOP1, B_BE_STOP_WPDMA);
+        Self::txdma_be(hal, true, true);
+        // `rtw89_pci_configure_mit_be`: an interrupt per half ring, or 2 ms.
+        hal.w32_mask(R_BE_PCIE_MIT0_TMR, B_BE_PCIE_MIT0_RX_TMR_MASK, BE_MIT0_TMR_UNIT_1MS);
+        let mit = replace(replace(hal.r32(R_BE_PCIE_MIT0_CNT), B_BE_PCIE_RX_MIT0_CNT_MASK, (RXBD_NUM as u32 / 2).min(255)), B_BE_PCIE_RX_MIT0_TMR_CNT_MASK, 2);
+        hal.w32(R_BE_PCIE_MIT0_CNT, mit);
+    }
+
+    fn poll_dma_idle(&self, hal: &Hal) {
+        let (busy1, check) = match hal.id() {
+            ChipId::Rtl8852c => (R_AX_HAXI_DMA_BUSY1, DMA_BUSY1_CHECK),
+            ChipId::Rtl8852a => (R_AX_PCIE_DMA_BUSY1, DMA_BUSY1_CHECK),
+            _ => (R_AX_PCIE_DMA_BUSY1, DMA_BUSY1_CHECK_V1),
+        };
+        let _ = hal.poll32(busy1, |value| value & check == 0, 10, 100);
+        let busy3 = if hal.chip.v1 { R_AX_HAXI_DMA_BUSY3 } else { R_AX_PCIE_DMA_BUSY1 };
+        let _ = hal.poll32(busy3, |value| value & (B_AX_RXQ_BUSY | B_AX_RPQ_BUSY) == 0, 10, 100);
+    }
+
+    /// `rtw89_pci_clr_idx_all_ax`.
+    fn clear_indices(&self, hal: &Hal) {
+        let dual = matches!(hal.id(), ChipId::Rtl8852a | ChipId::Rtl8852c);
+        let mut value = B_AX_CLR_ACH0_IDX | B_AX_CLR_ACH1_IDX | B_AX_CLR_ACH2_IDX | B_AX_CLR_ACH3_IDX | B_AX_CLR_CH8_IDX | B_AX_CLR_CH9_IDX | B_AX_CLR_CH12_IDX;
+        if dual {
+            value |= B_AX_CLR_ACH4_IDX | B_AX_CLR_ACH5_IDX | B_AX_CLR_ACH6_IDX | B_AX_CLR_ACH7_IDX;
+        }
+        hal.set32(R_AX_TXBD_RWPTR_CLR1, value);
+        if dual {
+            let clr2 = if hal.chip.v1 { R_AX_TXBD_RWPTR_CLR2_V1 } else { R_AX_TXBD_RWPTR_CLR2 };
+            hal.set32(clr2, B_AX_CLR_CH10_IDX | B_AX_CLR_CH11_IDX);
+        }
+        let rx = if hal.chip.v1 { R_AX_RXBD_RWPTR_CLR_V1 } else { R_AX_RXBD_RWPTR_CLR };
+        hal.set32(rx, B_AX_CLR_RXQ_IDX | B_AX_CLR_RPQ_IDX);
+    }
+
+    /// `rtw89_pci_mode_op`: descriptors truncated, packet RX buffers, many
+    /// tags, the bursts and WD intervals of the chip.
+    fn mode_op(&self, hal: &Hal) {
+        let id = hal.id();
+        let xb = hal.is_885xb();
+        if id == ChipId::Rtl8852a && hal.cv == CHIP_CBV as u8 {
+            hal.set32(R_AX_PCIE_INIT_CFG1, B_AX_TX_TRUNC_MODE | B_AX_RX_TRUNC_MODE);
+        }
+        let (init, mode_bit) = if hal.chip.v1 { (R_AX_HAXI_INIT_CFG1, B_AX_RXBD_MODE_V1) } else { (R_AX_PCIE_INIT_CFG1, B_AX_RXBD_MODE) };
+        hal.clr32(init, mode_bit);
+        if id == ChipId::Rtl8852a || xb {
+            hal.w32_mask(R_AX_PCIE_INIT_CFG1, B_AX_PCIE_MAX_TXDMA_MASK, MAC_AX_TX_BURST_2048B);
+            hal.w32_mask(R_AX_PCIE_INIT_CFG1, B_AX_PCIE_MAX_RXDMA_MASK, MAC_AX_RX_BURST_128B);
+            hal.set32(R_AX_PCIE_INIT_CFG1, B_AX_LATENCY_CONTROL);
+            hal.w32_mask(R_AX_PCIE_EXP_CTRL, B_AX_MAX_TAG_NUM, MAC_AX_TAG_NUM_8);
+            hal.w32_mask(R_AX_PCIE_INIT_CFG2, B_AX_WD_ITVL_IDLE, MAC_AX_WD_DMA_INTVL_256NS);
+            hal.w32_mask(R_AX_PCIE_INIT_CFG2, B_AX_WD_ITVL_ACT, MAC_AX_WD_DMA_INTVL_256NS);
+        } else {
+            hal.w32_mask(R_AX_HAXI_INIT_CFG1, B_AX_HAXI_MAX_TXDMA_MASK, MAC_AX_TX_BURST_V1_256B);
+            hal.w32_mask(R_AX_HAXI_INIT_CFG1, B_AX_HAXI_MAX_RXDMA_MASK, MAC_AX_RX_BURST_V1_128B);
+            hal.w32_mask(R_AX_HAXI_EXP_CTRL, B_AX_MAX_TAG_NUM_V1_MASK, MAC_AX_TAG_NUM_8);
+            hal.w32_mask(R_AX_HAXI_INIT_CFG1, B_AX_WD_ITVL_IDLE_V1_MASK, MAC_AX_WD_DMA_INTVL_256NS);
+            hal.w32_mask(R_AX_HAXI_INIT_CFG1, B_AX_WD_ITVL_ACT_V1_MASK, MAC_AX_WD_DMA_INTVL_256NS);
+        }
+        hal.set32(R_AX_TX_ADDRESS_INFO_MODE_SETTING, B_AX_HOST_ADDR_INFO_8B_SEL);
+        hal.clr32(R_AX_PKTIN_SETTING, B_AX_WD_ADDR_INFO_LENGTH);
+    }
+
+    /// `rtw89_pci_reset_trx_rings`: each ring's depth, BD RAM share and
+    /// address; the RX rings full of buffers.
+    fn reset_rings(&mut self, hal: &Hal) {
+        let dual = matches!(hal.id(), ChipId::Rtl8852a | ChipId::Rtl8852c);
+        for (channel, ring) in self.tx.iter_mut().enumerate() {
+            let Some(ring) = ring else { continue };
+            ring.wp = 0;
+            ring.rp = 0;
+            ring.busy.iter_mut().for_each(|busy| *busy = 0);
+            hal.w16(ring.addr.num, ring.len as u16);
+            if let Some((start, max, min)) = bd_ram(dual, channel) {
+                hal.w32(ring.addr.bdram, field(BDRAM_SIDX_MASK, start) | field(BDRAM_MAX_MASK, max) | field(BDRAM_MIN_MASK, min));
+            }
+            let dma = ring.bds.daddr() as u64;
+            hal.w32(ring.addr.desa_l, dma as u32);
+            hal.w32(ring.addr.desa_l + 4, (dma >> 32) as u32);
+        }
+        for ring in &mut self.rx {
+            ring.wp = 0;
+            ring.tag = 0;
+            ring.partial = false;
+            hal.w16(ring.addr.num, RXBD_NUM as u16);
+            let dma = ring.bds.daddr() as u64;
+            hal.w32(ring.addr.desa_l, dma as u32);
+            hal.w32(ring.addr.desa_l + 4, (dma >> 32) as u32);
+            // `rx_ring_eq_is_full`: the host's index one behind the next.
+            if hal.chip.be {
+                hal.w16(ring.addr.idx, RXBD_NUM as u16 - 1);
+            }
+        }
+        if hal.chip.v1 || hal.chip.be {
+            let sel = if hal.chip.be { R_BE_WP_ADDR_H_SEL0_3_V1 } else { R_AX_WP_ADDR_H_SEL0_3 };
+            for at in (0..16u32).step_by(4) {
+                hal.w32(sel + at, u32::from_le_bytes([at as u8, at as u8 + 1, at as u8 + 2, at as u8 + 3]));
+            }
+        }
+    }
+
+    /// `rtw89_pci_ops_mac_post_init_ax`: latency tolerance, TX DMA on.
+    pub(crate) fn mac_post_init(&self, hal: &Hal) {
+        if hal.chip.be {
+            return self.mac_post_init_be(hal);
+        }
+        let id = hal.id();
+        if id == ChipId::Rtl8852c {
+            let mut dec = hal.r32(R_AX_LTR_DEC_CTRL);
+            dec |= B_AX_LTR_HW_DEC_EN;
+            dec = (dec & !B_AX_LTR_SPACE_IDX_V1_MASK) | field(B_AX_LTR_SPACE_IDX_V1_MASK, PCI_LTR_SPC_500US);
+            hal.set32(R_AX_LTR_CTRL_0, B_AX_LTR_WD_NOEMP_CHK_V1 | B_AX_LTR_HW_EN);
+            hal.w32_mask(R_AX_LTR_CTRL_0, B_AX_LTR_IDLE_TIMER_IDX_MASK, PCI_LTR_IDLE_TIMER_3_2MS);
+            hal.w32_mask(R_AX_LTR_CTRL_1, B_AX_LTR_RX0_TH_MASK, 0x28);
+            hal.w32_mask(R_AX_LTR_CTRL_1, B_AX_LTR_RX1_TH_MASK, 0x28);
+            hal.w32(R_AX_LTR_DEC_CTRL, dec);
+            hal.w32(R_AX_LTR_LATENCY_IDX3, 0x9003_9003);
+            hal.w32(R_AX_LTR_LATENCY_IDX0, 0x880b_880b);
+        } else {
+            hal.set32(R_AX_LTR_CTRL_0, B_AX_LTR_HW_EN | B_AX_LTR_EN | B_AX_LTR_WD_NOEMP_CHK);
+            hal.w32_mask(R_AX_LTR_CTRL_0, B_AX_LTR_SPACE_IDX_MASK, PCI_LTR_SPC_500US);
+            hal.w32_mask(R_AX_LTR_CTRL_0, B_AX_LTR_IDLE_TIMER_IDX_MASK, PCI_LTR_IDLE_TIMER_3_2MS);
+            hal.w32_mask(R_AX_LTR_CTRL_1, B_AX_LTR_RX0_TH_MASK, 0x28);
+            hal.w32_mask(R_AX_LTR_CTRL_1, B_AX_LTR_RX1_TH_MASK, 0x28);
+            hal.w32(R_AX_LTR_IDLE_LATENCY, 0x9003_9003);
+            hal.w32(R_AX_LTR_ACTIVE_LATENCY, 0x880b_880b);
+        }
+        if id == ChipId::Rtl8852a {
+            hal.set32(R_AX_LTR_CTRL_0, B_AX_APP_LTR_ACT);
+        }
+        if id == ChipId::Rtl8852a || hal.is_885xb() {
+            hal.set32(R_AX_TX_ADDRESS_INFO_MODE_SETTING, B_AX_HOST_ADDR_INFO_8B_SEL);
+            hal.clr32(R_AX_PKTIN_SETTING, B_AX_WD_ADDR_INFO_LENGTH);
+        }
+        Self::ctrl_txdma(hal, true);
+        let (stop1, _) = Self::dma_stop1(hal);
+        hal.clr32(stop1, B_AX_STOP_WPDMA | B_AX_STOP_PCIEIO);
+    }
+
+    // ---- Interrupts. ----
+
+    /// `rtw89_pci_config_intr_mask` (and `_v1`), then `enable_intr`.
+    pub(crate) fn enable_interrupts(&mut self, hal: &Hal) {
+        if hal.chip.be {
+            // `rtw89_pci_default_intr_mask_v2`, `rtw89_pci_enable_intr_v2`.
+            self.ind_intrs = B_BE_HCI_AXIDMA_INT_EN0 | B_BE_HS0_IND_INT_EN0;
+            self.halt_c2h = B_BE_HALT_C2H_INT_EN | B_BE_WDT_TIMEOUT_INT_EN;
+            self.intrs = [B_BE_RDU_CH1_INT_IMR_V1 | B_BE_RDU_CH0_INT_IMR_V1, B_BE_PCIE_RX_RX0P2_IMR0_V1 | B_BE_PCIE_RX_RPQ0_IMR0_V1, 0];
+            hal.w32(R_BE_HIMR0, self.halt_c2h);
+            hal.w32(R_BE_HAXI_HIMR00, self.intrs[0]);
+            hal.w32(R_BE_PCIE_DMA_IMR_0_V1, self.intrs[1]);
+            hal.w32(R_BE_PCIE_HIMR0, self.ind_intrs);
+            return;
+        }
+        let rings = B_AX_TXDMA_STUCK_INT_EN | B_AX_RXDMA_INT_EN | B_AX_RXP1DMA_INT_EN | B_AX_RPQDMA_INT_EN | B_AX_RXDMA_STUCK_INT_EN | B_AX_RDU_INT_EN | B_AX_RPQBD_FULL_INT_EN;
+        if hal.chip.v1 {
+            self.ind_intrs = B_AX_HCI_AXIDMA_INT_EN | B_AX_HS1ISR_IND_INT_EN | B_AX_HS0ISR_IND_INT_EN;
+            self.halt_c2h = B_AX_HALT_C2H_INT_EN | B_AX_WDT_TIMEOUT_INT_EN;
+            self.intrs = [rings, B_AX_GPIO18_INT_EN, 0];
+            hal.w32(R_AX_PCIE_HIMR00_V1, self.ind_intrs);
+            hal.w32(R_AX_HIMR0, self.halt_c2h);
+            hal.w32(R_AX_HAXI_HIMR00, self.intrs[0]);
+            hal.w32(R_AX_HIMR1, self.intrs[1]);
+        } else {
+            let hs0 = if hal.id() == ChipId::Rtl8851b { B_AX_HS0ISR_IND_INT_EN_WKARND } else { B_AX_HS0ISR_IND_INT_EN };
+            self.halt_c2h = B_AX_HALT_C2H_INT_EN;
+            self.intrs = [rings | hs0, B_AX_HC10ISR_IND_INT_EN, 0];
+            hal.w32(R_AX_HIMR0, self.halt_c2h);
+            hal.w32(R_AX_PCIE_HIMR00, self.intrs[0]);
+            hal.w32(R_AX_PCIE_HIMR10, self.intrs[1]);
+        }
+    }
+
+    pub(crate) fn disable_interrupts(&self, hal: &Hal) {
+        if hal.chip.be {
+            hal.w32(R_BE_PCIE_HIMR0, 0);
+            hal.w32(R_BE_PCIE_DMA_IMR_0_V1, 0);
+        } else if hal.chip.v1 {
+            hal.w32(R_AX_PCIE_HIMR00_V1, 0);
+        } else {
+            hal.w32(R_AX_HIMR0, 0);
+            hal.w32(R_AX_PCIE_HIMR00, 0);
+            hal.w32(R_AX_PCIE_HIMR10, 0);
+        }
+    }
+
+    /// `rtw89_pci_recognize_intrs` (and `_v1`): the causes, cleared; whether
+    /// the firmware halted.
+    pub(crate) fn acknowledge(&self, hal: &Hal) -> bool {
+        if hal.chip.be {
+            // `rtw89_pci_recognize_intrs_v2`.
+            let ind = hal.r32(R_BE_PCIE_HISR) & self.ind_intrs;
+            let halt = if ind & B_BE_HS0ISR_IND_INT != 0 { hal.r32(R_BE_HISR0) & self.halt_c2h } else { 0 };
+            let isr0 = if ind & B_BE_HCI_AXIDMA_INT != 0 { hal.r32(R_BE_HAXI_HISR00) & self.intrs[0] } else { 0 };
+            let isr1 = hal.r32(R_BE_PCIE_DMA_ISR) & self.intrs[1];
+            if halt != 0 {
+                hal.w32(R_BE_HISR0, halt);
+            }
+            if isr0 != 0 {
+                hal.w32(R_BE_HAXI_HISR00, isr0);
+            }
+            if isr1 != 0 {
+                hal.w32(R_BE_PCIE_DMA_ISR, isr1);
+            }
+            hal.w32(R_BE_PCIE_HISR, ind);
+            return halt & B_BE_HALT_C2H_INT != 0;
+        }
+        let halt;
+        if hal.chip.v1 {
+            let ind = hal.r32(R_AX_PCIE_HISR00_V1) & self.ind_intrs;
+            halt = if ind & B_AX_HS0ISR_IND_INT_EN != 0 { hal.r32(R_AX_HISR0) & self.halt_c2h } else { 0 };
+            let isr0 = if ind & B_AX_HCI_AXIDMA_INT_EN != 0 { hal.r32(R_AX_HAXI_HISR00) & self.intrs[0] } else { 0 };
+            let isr1 = if ind & B_AX_HS1ISR_IND_INT_EN != 0 { hal.r32(R_AX_HISR1) & self.intrs[1] } else { 0 };
+            if halt != 0 {
+                hal.w32(R_AX_HISR0, halt);
+            }
+            if isr0 != 0 {
+                hal.w32(R_AX_HAXI_HISR00, isr0);
+            }
+            if isr1 != 0 {
+                hal.w32(R_AX_HISR1, isr1);
+            }
+        } else {
+            halt = hal.r32(R_AX_HISR0) & self.halt_c2h;
+            let isr0 = hal.r32(R_AX_PCIE_HISR00) & self.intrs[0];
+            let isr1 = hal.r32(R_AX_PCIE_HISR10) & self.intrs[1];
+            hal.w32(R_AX_HISR0, halt);
+            hal.w32(R_AX_PCIE_HISR00, isr0);
+            hal.w32(R_AX_PCIE_HISR10, isr1);
+        }
+        halt & B_AX_HALT_C2H_INT_EN != 0
+    }
+
+    // ---- TX. ----
+
+    /// The BDs the chip took since last asked (`rtw89_pci_txbd_recalc`).
+    fn reclaim(hal: &Hal, ring: &mut TxRing) {
+        let hw = get(TXBD_HW_IDX_MASK, hal.r32(ring.addr.idx)) as usize;
+        if hw < ring.len {
+            ring.rp = hw;
+        }
+    }
+
+    fn room(ring: &TxRing) -> usize {
+        if ring.rp > ring.wp { ring.rp - ring.wp - 1 } else { ring.len - (ring.wp - ring.rp) - 1 }
+    }
+
+    fn kick(hal: &Hal, ring: &mut TxRing, length: usize, dma: u64) -> Result<(), ()> {
+        let mut bd = [0u8; TX_BD];
+        bd[0..2].copy_from_slice(&(length as u16).to_le_bytes());
+        let opt = TXBD_OPT_LS | (((dma >> 32) as u16 & 0xff) << 6);
+        bd[2..4].copy_from_slice(&opt.to_le_bytes());
+        bd[4..8].copy_from_slice(&(dma as u32).to_le_bytes());
+        ring.bds.write_bytes(ring.wp * TX_BD, &bd).map_err(|_| ())?;
+        ring.wp = (ring.wp + 1) % ring.len;
+        hal.w16(ring.addr.idx, ring.wp as u16);
+        Ok(())
+    }
+
+    /// A firmware command (`rtw89_pci_fwcmd_submit`): its descriptor
+    /// (`rtw89_core_fill_txdesc` with the H2C channel, or the RTL8852C's
+    /// short one), then the command, in one buffer.
+    pub(crate) fn send_h2c(&mut self, hal: &Hal, h2c: &[u8], fwdl: bool) -> Result<(), &'static str> {
+        let desc_size = hal.chip.h2c_desc;
+        let ring = self.tx[TXCH_CH12].as_mut().ok_or("no H2C ring")?;
+        Self::reclaim(hal, ring);
+        if Self::room(ring) == 0 {
+            return Err("the H2C ring is full");
+        }
+        if desc_size + h2c.len() > PAGE_SIZE {
+            return Err("an H2C too long");
+        }
+        let mut buffer = vec![0u8; desc_size + h2c.len()];
+        if hal.chip.be {
+            // `rtw89_core_fill_txdesc_fwcmd_v2`.
+            let kind = if fwdl { RTW89_CORE_RX_TYPE_FWDL } else { RTW89_CORE_RX_TYPE_H2C };
+            let word = field(BE_RXD_RPKT_LEN_MASK, h2c.len() as u32) | field(BE_RXD_RPKT_TYPE_MASK, kind);
+            buffer[0..4].copy_from_slice(&word.to_le_bytes());
+        } else if hal.chip.v1 {
+            let kind = if fwdl { RTW89_CORE_RX_TYPE_FWDL } else { RTW89_CORE_RX_TYPE_H2C };
+            let word = field(AX_RXD_RPKT_LEN_MASK, h2c.len() as u32) | field(AX_RXD_RPKT_TYPE_MASK, kind);
+            buffer[0..4].copy_from_slice(&word.to_le_bytes());
+        } else {
+            let word0 = field(RTW89_TXWD_BODY0_CHANNEL_DMA, RTW89_DMA_H2C) | field(RTW89_TXWD_BODY0_FW_DL, fwdl as u32);
+            let word2 = field(RTW89_TXWD_BODY2_TXPKT_SIZE, h2c.len() as u32);
+            buffer[0..4].copy_from_slice(&word0.to_le_bytes());
+            buffer[8..12].copy_from_slice(&word2.to_le_bytes());
+        }
+        buffer[desc_size..].copy_from_slice(h2c);
+        let slot = ring.wp;
+        ring.pages.write_bytes(slot * PAGE_SIZE, &buffer).map_err(|_| "H2C buffer")?;
+        let dma = (ring.pages.daddr() + slot * PAGE_SIZE) as u64;
+        Self::kick(hal, ring, buffer.len(), dma).map_err(|()| "H2C ring")
+    }
+
+    fn free_page(ring: &TxRing) -> Option<usize> {
+        let now = crate::now_ms().max(1);
+        (0..ring.len).map(|step| (ring.next_page + step) % ring.len).find(|&page| {
+            let busy = ring.busy[page];
+            busy == 0 || now >= busy + STALE_MS
+        })
+    }
+
+    /// A frame (`rtw89_pci_txwd_submit`): its WD page (the descriptor's
+    /// body and info, the WP info with the page's number, the frame's
+    /// address) and the frame after it.
+    pub(crate) fn send_frame(&mut self, hal: &Hal, desc: &TxDesc, frame: &[u8]) -> Result<(), &'static str> {
+        if frame.len() > TX_FRAME_MAX {
+            return Err("a frame too long");
+        }
+        let body = hal.chip.txwd_body;
+        let v1 = hal.chip.v1;
+        let ring = self.tx.get_mut(desc.channel).and_then(Option::as_mut).ok_or("no such TX channel")?;
+        Self::reclaim(hal, ring);
+        if Self::room(ring) == 0 {
+            return Err("the TX ring is full");
+        }
+        let page = Self::free_page(ring).ok_or("no WD page free")?;
+        ring.next_page = (page + 1) % ring.len;
+        ring.busy[page] = crate::now_ms().max(1);
+        let base = ring.pages.daddr() + page * PAGE_SIZE;
+        let frame_dma = (base + WD_PAGE) as u64;
+        let mut wd = [0u8; WD_PAGE];
+        if hal.chip.be {
+            let length = Self::wd_be(&mut wd, desc, frame.len(), page, frame_dma);
+            let offset = page * PAGE_SIZE;
+            ring.pages.write_bytes(offset + WD_PAGE, frame).map_err(|_| "TX buffer")?;
+            ring.pages.write_bytes(offset, &wd[..length]).map_err(|_| "WD page")?;
+            return Self::kick(hal, ring, length, base as u64).map_err(|()| "TX ring");
+        }
+        let mut words = [0u32; 8];
+        let wp_offset = 0u32;
+        words[0] = if v1 { field(RTW89_TXWD_BODY0_WP_OFFSET_V1, wp_offset) } else { field(RTW89_TXWD_BODY0_WP_OFFSET, wp_offset) }
+            | RTW89_TXWD_BODY0_WD_INFO_EN
+            | field(RTW89_TXWD_BODY0_CHANNEL_DMA, desc.channel as u32)
+            | field(RTW89_TXWD_BODY0_HDR_LLC_LEN, desc.hdr_llc_len)
+            | RTW89_TXWD_BODY0_WD_PAGE;
+        if desc.hw_seq && !v1 {
+            words[0] |= field(RTW89_TXWD_BODY0_HW_SSN_SEL, RTW89_MGMT_HW_SSN_SEL) | field(RTW89_TXWD_BODY0_HW_SSN_MODE, RTW89_MGMT_HW_SEQ_MODE);
+        }
+        words[2] = field(RTW89_TXWD_BODY2_TID_INDICATE, desc.tid_indicate as u32) | field(RTW89_TXWD_BODY2_QSEL, desc.qsel) | field(RTW89_TXWD_BODY2_TXPKT_SIZE, frame.len() as u32) | field(RTW89_TXWD_BODY2_MACID, desc.mac_id);
+        words[3] = field(RTW89_TXWD_BODY3_SW_SEQ, desc.seq) | field(RTW89_TXWD_BODY3_AGG_EN, desc.agg_en as u32);
+        if v1 {
+            words[1] = field(RTW89_TXWD_BODY1_ADDR_INFO_NUM, 1) | field(RTW89_TXWD_BODY1_SEC_KEYID, desc.key_id) | field(RTW89_TXWD_BODY1_SEC_TYPE, desc.sec_type);
+            words[7] = field(RTW89_TXWD_BODY7_USE_RATE_V1, desc.use_rate as u32) | field(RTW89_TXWD_BODY7_DATA_RATE, desc.rate);
+        }
+        for (index, word) in words.iter().take(body / 4).enumerate() {
+            wd[index * 4..index * 4 + 4].copy_from_slice(&word.to_le_bytes());
+        }
+        // The WD info.
+        let mut info = [0u32; 6];
+        info[0] = if v1 { 0 } else { field(RTW89_TXWD_INFO0_USE_RATE, desc.use_rate as u32) | field(RTW89_TXWD_INFO0_DATA_RATE, desc.rate) } | field(RTW89_TXWD_INFO0_DISDATAFB, desc.use_rate as u32);
+        let sec = desc.sec_type != 0;
+        info[2] = if v1 { field(RTW89_TXWD_INFO2_FORCE_KEY_EN, sec as u32) } else { field(RTW89_TXWD_INFO2_SEC_TYPE, desc.sec_type) | field(RTW89_TXWD_INFO2_SEC_HW_ENC, sec as u32) } | field(RTW89_TXWD_INFO2_SEC_CAM_IDX, desc.sec_cam);
+        info[4] = field(RTW89_TXWD_INFO4_RTS_EN, !desc.bmc as u32) | field(RTW89_TXWD_INFO4_HW_RTS_EN, 1);
+        info[1] |= field(RTW89_TXWD_INFO1_MAX_AGGNUM, desc.ampdu_num);
+        info[2] |= field(RTW89_TXWD_INFO2_AMPDU_DENSITY, desc.ampdu_density);
+        for (index, word) in info.iter().enumerate() {
+            wd[body + index * 4..body + index * 4 + 4].copy_from_slice(&word.to_le_bytes());
+        }
+        // The WP info, then the address.
+        let wp = body + 24;
+        wd[wp..wp + 2].copy_from_slice(&(page as u16 | TXWP_VALID).to_le_bytes());
+        let addr = wp + 8;
+        let length = if v1 {
+            let lsb = frame_dma as u16;
+            let msb = (frame_dma >> 16) as u16;
+            let opt = (frame.len() as u16 & 0x7ff) | (1 << 15) | ((((frame_dma >> 32) as u16) & 0xf) << 11);
+            wd[addr..addr + 2].copy_from_slice(&opt.to_le_bytes());
+            wd[addr + 2..addr + 4].copy_from_slice(&lsb.to_le_bytes());
+            wd[addr + 4..addr + 6].copy_from_slice(&msb.to_le_bytes());
+            addr + 6
+        } else {
+            let option = ADDR_MSDU_LS | ADDR_NUM_1 | ((frame_dma >> 32) as u16 & 0xff);
+            wd[addr..addr + 2].copy_from_slice(&(frame.len() as u16).to_le_bytes());
+            wd[addr + 2..addr + 4].copy_from_slice(&option.to_le_bytes());
+            wd[addr + 4..addr + 8].copy_from_slice(&(frame_dma as u32).to_le_bytes());
+            addr + 8
+        };
+        let offset = page * PAGE_SIZE;
+        ring.pages.write_bytes(offset + WD_PAGE, frame).map_err(|_| "TX buffer")?;
+        ring.pages.write_bytes(offset, &wd[..length]).map_err(|_| "WD page")?;
+        Self::kick(hal, ring, length, base as u64).map_err(|()| "TX ring")
+    }
+
+    /// A BE chip's WD page (`rtw89_core_fill_txdesc_v2`, the WP info,
+    /// `rtw89_pci_fill_txaddr_info_v1`); its length.
+    fn wd_be(wd: &mut [u8; WD_PAGE], desc: &TxDesc, len: usize, page: usize, frame_dma: u64) -> usize {
+        let sec = desc.sec_type != 0;
+        let pn = desc.pn.unwrap_or(0).to_le_bytes();
+        let mut body = [0u32; 8];
+        body[0] = field(BE_TXD_BODY0_WP_OFFSET_V1, desc.wp_offset) | BE_TXD_BODY0_WDINFO_EN | field(BE_TXD_BODY0_CH_DMA, desc.channel as u32) | field(BE_TXD_BODY0_HDR_LLC_LEN, desc.hdr_llc_len) | BE_TXD_BODY0_WD_PAGE;
+        body[1] = field(BE_TXD_BODY1_ADDR_INFO_NUM, 1) | field(BE_TXD_BODY1_SEC_KEYID, desc.key_id) | field(BE_TXD_BODY1_SEC_TYPE, desc.sec_type);
+        body[2] = field(BE_TXD_BODY2_TID_IND, desc.tid_indicate as u32) | field(BE_TXD_BODY2_QSEL, desc.qsel) | field(BE_TXD_BODY2_TXPKTSIZE, len as u32) | field(BE_TXD_BODY2_MACID, desc.mac_id) | field(BE_TXD_BODY2_AGG_EN, desc.agg_en as u32);
+        // Management frames' sequence numbers are the hardware's own.
+        body[3] = field(BE_TXD_BODY3_WIFI_SEQ, desc.seq) | field(BE_TXD_BODY3_IS_MLD_SW_EN, desc.hw_seq as u32);
+        if sec && desc.pn.is_some() {
+            body[4] = field(BE_TXD_BODY4_SEC_IV_L0, pn[0] as u32) | field(BE_TXD_BODY4_SEC_IV_L1, pn[1] as u32);
+            body[5] = field(BE_TXD_BODY5_SEC_IV_H2, pn[2] as u32) | field(BE_TXD_BODY5_SEC_IV_H3, pn[3] as u32) | field(BE_TXD_BODY5_SEC_IV_H4, pn[4] as u32) | field(BE_TXD_BODY5_SEC_IV_H5, pn[5] as u32);
+        }
+        body[7] = field(BE_TXD_BODY7_USERATE_SEL, desc.use_rate as u32) | field(BE_TXD_BODY7_DATARATE, desc.rate);
+        let mut info = [0u32; 8];
+        info[0] = field(BE_TXD_INFO0_DISDATAFB, desc.use_rate as u32);
+        info[1] = field(BE_TXD_INFO1_DATA_RTY_LOWEST_RATE, desc.lowest_rate) | field(BE_TXD_INFO1_MAX_AGG_NUM, desc.ampdu_num);
+        info[2] = field(BE_TXD_INFO2_FORCE_KEY_EN, sec as u32) | field(BE_TXD_INFO2_SEC_CAM_IDX, desc.sec_cam) | field(BE_TXD_INFO2_AMPDU_DENSITY, desc.ampdu_density);
+        info[4] = field(BE_TXD_INFO4_RTS_EN, !desc.bmc as u32) | field(BE_TXD_INFO4_HW_RTS_EN, 1);
+        for (index, word) in body.iter().chain(info.iter()).enumerate() {
+            wd[index * 4..index * 4 + 4].copy_from_slice(&word.to_le_bytes());
+        }
+        let wp = 64;
+        wd[wp..wp + 2].copy_from_slice(&(page as u16 | TXWP_VALID).to_le_bytes());
+        let addr = wp + 8;
+        let opt = (len as u16 & 0x7ff) | (1 << 15) | ((((frame_dma >> 32) as u16) & 0xf) << 11);
+        wd[addr..addr + 2].copy_from_slice(&opt.to_le_bytes());
+        wd[addr + 2..addr + 4].copy_from_slice(&(frame_dma as u16).to_le_bytes());
+        wd[addr + 4..addr + 6].copy_from_slice(&((frame_dma >> 16) as u16).to_le_bytes());
+        addr + 6
+    }
+
+    /// The release reports (`rtw89_pci_release_rpp`): each names the page
+    /// of a channel the chip is done with.
+    fn release(&mut self, entry: u32) {
+        let seq = get(RTW89_PCI_RPP_SEQ, entry) as usize;
+        let qsel = get(RTW89_PCI_RPP_QSEL, entry);
+        let channel = match qsel {
+            0 | 4 | 8 | 12 => TXCH_ACH0,
+            1 | 5 | 9 | 13 => 1,
+            2 | 6 | 10 | 14 => 2,
+            3 | 7 | 11 | 15 => 3,
+            0x12 => TXCH_CH8,
+            0x11 => 9,
+            0x1a => 10,
+            0x19 => 11,
+            _ => return,
+        };
+        if let Some(Some(ring)) = self.tx.get_mut(channel)
+            && let Some(busy) = ring.busy.get_mut(seq)
+        {
+            *busy = 0;
+        }
+    }
+
+    // ---- RX. ----
+
+    fn rx_count(hal: &Hal, ring: &RxRing) -> usize {
+        let hw = get(TXBD_HW_IDX_MASK, hal.r32(ring.addr.idx)) as usize;
+        if hw >= RXBD_NUM {
+            return 0;
+        }
+        (hw + RXBD_NUM - ring.wp) % RXBD_NUM
+    }
+
+    /// What arrived: frames and events on the RX ring (each one buffer,
+    /// its descriptor first; frames over several are dropped), release
+    /// reports on the other.
+    pub(crate) fn receive(&mut self, hal: &Hal) -> Vec<Vec<u8>> {
+        let mut out = Vec::new();
+        let be = hal.chip.be;
+        let ring = &mut self.rx[RXCH_RXQ];
+        let count = Self::rx_count(hal, ring);
+        for _ in 0..count {
+            let at = ring.wp * ring.slot;
+            if let Some(word) = Self::rx_info(be, ring, at) {
+                let (ls, length) = (word & RTW89_PCI_RXBD_LS != 0, get(RTW89_PCI_RXBD_WRITE_SIZE, word) as usize);
+                // The BE chips mark no first segment: one follows a last.
+                let fs = if be { !ring.partial } else { word & RTW89_PCI_RXBD_FS != 0 };
+                ring.partial = be && !ls;
+                if fs && ls && length <= RX_BUF {
+                    let mut data = vec![0u8; length];
+                    if ring.buffers.read_bytes(at + RXBD_INFO, &mut data).is_ok() {
+                        out.push(data);
+                    }
+                }
+            }
+            ring.wp = (ring.wp + 1) % RXBD_NUM;
+        }
+        if count > 0 {
+            hal.w16(ring.addr.idx, Self::host_index(be, ring.wp));
+        }
+        let ring = &mut self.rx[RXCH_RPQ];
+        let count = Self::rx_count(hal, ring);
+        let mut released = Vec::new();
+        for _ in 0..count {
+            let at = ring.wp * ring.slot;
+            let mut data = vec![0u8; ring.slot];
+            if Self::rx_info(be, ring, at).is_some() && ring.buffers.read_bytes(at, &mut data).is_ok() {
+                let word = get_le32(&data, 0);
+                let length = (get(RTW89_PCI_RXBD_WRITE_SIZE, word) as usize).min(ring.slot - RXBD_INFO);
+                let desc = &data[RXBD_INFO..RXBD_INFO + length];
+                if let Some(start) = crate::sta::rx_payload_offset(be, desc) {
+                    let mut offset = start;
+                    while offset + RPP_SIZE <= desc.len() {
+                        released.push(get_le32(desc, offset));
+                        offset += RPP_SIZE;
+                    }
+                }
+            }
+            ring.wp = (ring.wp + 1) % RXBD_NUM;
+        }
+        if count > 0 {
+            hal.w16(ring.addr.idx, Self::host_index(be, ring.wp));
+        }
+        for entry in released {
+            self.release(entry);
+        }
+        out
+    }
+
+    /// A buffer's RX BD info; on the BE chips once its tag is the next one
+    /// (`rtw89_pci_validate_rx_tag`: the chip may name a buffer before its
+    /// data is written).
+    fn rx_info(be: bool, ring: &mut RxRing, at: usize) -> Option<u32> {
+        let mut info = [0u8; RXBD_INFO];
+        if !be {
+            return ring.buffers.read_bytes(at, &mut info).ok().map(|()| u32::from_le_bytes(info));
+        }
+        let expected = match ring.tag & RX_TAG_MASK {
+            0 => 1,
+            tag => tag,
+        };
+        let mut word = 0;
+        for _ in 0..1000 {
+            ring.buffers.read_bytes(at, &mut info).ok()?;
+            word = u32::from_le_bytes(info);
+            if get(RTW89_PCI_RXBD_TAG, word) == expected {
+                break;
+            }
+            crate::delay_us(1);
+        }
+        ring.tag = get(RTW89_PCI_RXBD_TAG, word) + 1;
+        Some(word)
+    }
+
+    /// The RX index the host writes: the BE chips', the last buffer taken.
+    fn host_index(be: bool, next: usize) -> u16 {
+        if be { ((next + RXBD_NUM - 1) % RXBD_NUM) as u16 } else { next as u16 }
+    }
+
+    /// Whether the H2C ring's command went out (the chip took the BD).
+    pub(crate) fn h2c_idle(&mut self, hal: &Hal) -> bool {
+        let Some(ring) = self.tx[TXCH_CH12].as_mut() else { return true };
+        Self::reclaim(hal, ring);
+        ring.rp == ring.wp
+    }
+}
+
+/// The RX BD's length field, for tests of descriptors.
+#[allow(dead_code)]
+pub(crate) fn bd_length(bd: &[u8]) -> u16 {
+    get_le16(bd, 0)
+}
diff --git a/kernel/comps/rtw89/src/phy.rs b/kernel/comps/rtw89/src/phy.rs
new file mode 100644
index 0000000..7f01574
--- /dev/null
+++ b/kernel/comps/rtw89/src/phy.rs
@@ -0,0 +1,436 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The PHY as Linux's rtw89 `phy.c` sets it up on the 802.11ax chips: the
+//! baseband's and the radios' tables from the firmware's elements (each
+//! with conditions on the board's RFE type and the chip's cut), the RF
+//! values handed to the firmware too, the NCTL engine the calibrations
+//! use, the TX power (the board's by-rate targets, a cap for every rate)
+//! and the calibrations' register sequences ([`Rfk`]).
+
+use alloc::vec::Vec;
+
+use crate::{
+    fw::{Firmware, H2c, Table},
+    hal::{ChipId, Hal, RFREG_MASK, field},
+    pci::Pci,
+    regs::*,
+};
+
+/// A step of a calibration table (`struct rtw89_reg5_def`).
+#[derive(Clone, Copy)]
+pub(crate) enum Rfk {
+    /// An RF register of a path: path, address, mask, value.
+    Rf(u8, u32, u32, u32),
+    /// A baseband register: address, mask, value; its bits set; cleared.
+    Wm(u32, u32, u32),
+    Ws(u32, u32),
+    Wc(u32, u32),
+    /// Microseconds.
+    Delay(u32),
+}
+
+/// `rtw89_rfk_parser`.
+pub(crate) fn rfk(hal: &Hal, table: &[Rfk]) {
+    for step in table {
+        match *step {
+            Rfk::Rf(path, addr, mask, value) => hal.write_rf(path, addr, mask, value),
+            Rfk::Wm(addr, mask, value) => hal.phy_w32_mask(addr, mask, value),
+            Rfk::Ws(addr, mask) => hal.phy_set(addr, mask),
+            Rfk::Wc(addr, mask) => hal.phy_clr(addr, mask),
+            Rfk::Delay(us) => crate::delay_us(us as u64),
+        }
+    }
+}
+
+/// `rtw89_rfk_parser_by_cond`.
+pub(crate) fn rfk_by(hal: &Hal, first: bool, a: &[Rfk], b: &[Rfk]) {
+    rfk(hal, if first { a } else { b });
+}
+
+const HEADLINE_VALID: u32 = 0xf;
+const COND_BRANCH_IF: u32 = 0x8;
+const COND_BRANCH_ELIF: u32 = 0x9;
+const COND_BRANCH_ELSE: u32 = 0xa;
+const COND_BRANCH_END: u32 = 0xb;
+const COND_CHECK: u32 = 0x4;
+const DONT_CARE: u32 = 0xff;
+const BYPASS_CR_DATA: u32 = 0xbabe_cafe;
+
+/// `rtw89_phy_sel_headline`: the table's headlines name the boards and
+/// cuts it has settings for; the one for ours.
+fn headline(table: &Table, rfe: u8, cv: u8) -> Option<(usize, u32)> {
+    let size = table.iter().take_while(|(addr, _)| addr >> 28 == HEADLINE_VALID).count();
+    if size == 0 {
+        return Some((0, 0));
+    }
+    let target = |addr: u32| addr & 0x0fff_ffff;
+    let compare = |rfe: u32, cv: u32| (rfe << 16) | cv;
+    let (rfe, cv) = (rfe as u32, cv as u32);
+    for want in [compare(rfe, cv), compare(rfe, DONT_CARE)] {
+        if let Some(index) = table[..size].iter().position(|(addr, _)| target(*addr) == want) {
+            return Some((size, target(table[index].0)));
+        }
+    }
+    for want_rfe in [rfe, DONT_CARE] {
+        let best = table[..size].iter().filter(|(addr, _)| (addr >> 16) & 0xff == want_rfe).max_by_key(|(addr, _)| addr & 0xff);
+        if let Some((addr, _)) = best {
+            return Some((size, target(*addr)));
+        }
+    }
+    None
+}
+
+/// `rtw89_phy_init_reg`: the entries past the headlines, the branches
+/// for other boards skipped.
+pub(crate) fn walk(hal: &Hal, table: &Table, mut config: impl FnMut(u32, u32)) {
+    let Some((start, cfg_target)) = headline(table, hal.rfe_type, hal.cv) else {
+        ostd::warn!("rtw89: no PHY settings for RFE type {} cut {}", hal.rfe_type, hal.cv);
+        return;
+    };
+    let (mut matched, mut found, mut target) = (true, false, 0);
+    for &(addr, data) in &table[start..] {
+        match addr >> 28 {
+            COND_BRANCH_IF | COND_BRANCH_ELIF => target = addr & 0x0fff_ffff,
+            COND_BRANCH_ELSE => {
+                matched = false;
+                if !found {
+                    return;
+                }
+            }
+            COND_BRANCH_END => {
+                matched = true;
+                found = false;
+            }
+            COND_CHECK => {
+                if found {
+                    matched = false;
+                } else if target == cfg_target {
+                    matched = true;
+                    found = true;
+                } else {
+                    matched = false;
+                }
+            }
+            _ if matched => config(addr, data),
+            _ => {}
+        }
+    }
+}
+
+fn delay_of(addr: u32) -> Option<u64> {
+    match addr {
+        0xfe => Some(50_000),
+        0xfd => Some(5_000),
+        0xfc => Some(1_000),
+        0xfb => Some(50),
+        0xfa => Some(5),
+        0xf9 => Some(1),
+        _ => None,
+    }
+}
+
+/// `rtw89_phy_init_bb_reg`: the baseband's table, then its reset.
+pub(crate) fn init_bb(hal: &Hal, fw: &Firmware) {
+    if let Some(table) = &fw.elements.bb {
+        walk(hal, table, |addr, data| match delay_of(addr) {
+            Some(us) => crate::delay_us(us),
+            None if data == BYPASS_CR_DATA => {}
+            None => hal.phy_w32(addr, data),
+        });
+    }
+    // The BE chips have no TX power unit to set up (`init_txpwr_unit`).
+    if !hal.chip.be {
+        init_txpwr_unit(hal);
+    }
+}
+
+/// `rtw89_phy_init_rf_reg`: each path's table (written, and the values
+/// past 0x100 handed to the firmware, `rtw89_fw_h2c_rf_reg`).
+pub(crate) fn init_rf(hal: &Hal, fw: &Firmware, pci: &mut Pci, h2c: &mut H2c) {
+    for path in 0..hal.chip.rf_paths {
+        let Some(table) = &fw.elements.radio[path as usize] else { continue };
+        let mut stored: Vec<u32> = Vec::new();
+        let v1 = hal.id() != ChipId::Rtl8852a;
+        walk(hal, table, |addr, data| {
+            if addr == 0xfe {
+                crate::delay_ms(50);
+                return;
+            }
+            if !v1 && let Some(us) = delay_of(addr) {
+                crate::delay_us(us);
+                return;
+            }
+            hal.write_rf(path, addr, RFREG_MASK, data);
+            if !v1 || addr >= 0x100 {
+                stored.push((addr << 20) | data);
+            }
+        });
+        // `rtw89_phy_config_rf_reg_fw`: pages of 512 values.
+        let class = if path == 0 { H2C_CL_OUTSRC_RF_REG_A } else { H2C_CL_OUTSRC_RF_REG_B };
+        for (page, chunk) in stored.chunks(512).enumerate().take(6) {
+            let mut payload = Vec::with_capacity(chunk.len() * 4);
+            for value in chunk {
+                payload.extend_from_slice(&value.to_le_bytes());
+            }
+            let packet = h2c.packet(H2C_CAT_OUTSRC, class, page as u32, false, false, &payload);
+            if pci.send_h2c(hal, &packet, false).is_err() {
+                ostd::warn!("rtw89: the RF values did not reach the firmware");
+                break;
+            }
+            wait_h2c(hal, pci);
+        }
+    }
+}
+
+/// Lets the H2C ring drain (commands are taken in order).
+pub(crate) fn wait_h2c(hal: &Hal, pci: &mut Pci) {
+    let deadline = crate::now_ms() + 100;
+    while !pci.h2c_idle(hal) && crate::now_ms() < deadline {
+        crate::delay_us(20);
+    }
+}
+
+/// `rtw89_phy_init_rf_nctl`: the NCTL engine reset, then its table.
+pub(crate) fn init_nctl(hal: &Hal, fw: &Firmware) {
+    let id = hal.id();
+    hal.phy_set(R_IOQ_IQK_DPK, 0x3);
+    hal.phy_set(R_GNT_BT_WGT_EN, 0x1);
+    hal.phy_set(R_P0_PATH_RST, 0x0800_0000);
+    if id != ChipId::Rtl8851b {
+        hal.phy_set(R_P1_PATH_RST, 0x0800_0000);
+    }
+    if matches!(id, ChipId::Rtl8852b | ChipId::Rtl8852bt) {
+        hal.phy_set(R_IOQ_IQK_DPK, 0x2);
+    }
+    hal.phy_w32(R_NCTL_CFG, 0x8);
+    let ready = aster_linuxkpi::delay::read_poll_timeout(
+        || {
+            hal.phy_w32(0x8080, 0x4);
+            crate::delay_us(1);
+            hal.phy_r32(0x8080)
+        },
+        |value| *value == 0x4,
+        10,
+        1000,
+    );
+    if ready.is_err() {
+        ostd::warn!("rtw89: the NCTL did not get ready");
+    }
+    init_nctl_table(hal, fw);
+}
+
+/// The NCTL's table from the firmware's element.
+pub(crate) fn init_nctl_table(hal: &Hal, fw: &Firmware) {
+    if let Some(table) = &fw.elements.nctl {
+        walk(hal, table, |addr, data| match delay_of(addr) {
+            Some(us) => crate::delay_us(us),
+            None if data == BYPASS_CR_DATA => {}
+            None => hal.phy_w32(addr, data),
+        });
+    }
+}
+
+// ---- TX power. ----
+
+/// The bands as the TX power tables name them (`enum rtw89_band`).
+pub(crate) const BAND_2G: u8 = 0;
+pub(crate) const BAND_5G: u8 = RTW89_BAND_5G as u8;
+pub(crate) const BAND_6G: u8 = RTW89_BAND_6G as u8;
+const RS_CCK: u8 = 0;
+const RS_OFDM: u8 = 1;
+const RS_MCS: u8 = 2;
+const RS_HEDCM: u8 = 3;
+const RS_OFFSET: u8 = 4;
+/// The cap on every rate, half dB steps: 16 dBm, below what the
+/// worldwide limits allow on any channel (with a typical antenna).
+const LIMIT_CAP: i8 = 32;
+/// The cap in hundredths of a dBm (what the RTL8852A's TSSI compares).
+pub(crate) const LIMIT_CAP_CENTI_DBM: i32 = LIMIT_CAP as i32 * 100 / 2;
+/// Targets when the firmware has no by-rate table: 14 dBm.
+const DEFAULT_TARGET: i8 = 28;
+
+/// `struct rtw89_txpwr_byrate` for one band at 20 MHz, in the RF's
+/// quarter dB.
+#[derive(Clone)]
+struct ByRate {
+    cck: [i8; 4],
+    ofdm: [i8; 8],
+    mcs: [[i8; 12]; 2],
+    hedcm: [[i8; 4]; 2],
+    offset: [i8; 5],
+}
+
+fn byrate(fw: &Firmware, band: u8) -> ByRate {
+    let fill = (DEFAULT_TARGET * 2) as i8;
+    let mut out = ByRate { cck: [fill; 4], ofdm: [fill; 8], mcs: [[fill; 12]; 2], hedcm: [[fill; 4]; 2], offset: [0; 5] };
+    let Some(table) = &fw.elements.byrate else { return out };
+    // `struct rtw89_fw_txpwr_byrate_entry`: band, NSS, rate set, first
+    // index, count, the values (a byte each), width, OFDMA.
+    for entry in table.entries() {
+        // Older tables (9-byte entries) have no width or OFDMA: 20 MHz.
+        if entry.len() < 9 {
+            continue;
+        }
+        let (e_band, nss, rs, shf, len) = (entry[0], entry[1] as usize, entry[2], entry[3] as usize, entry[4] as usize);
+        let data = u32::from_le_bytes([entry[5], entry[6], entry[7], entry[8]]);
+        let (bw, ofdma) = (entry.get(9).copied().unwrap_or(0), entry.get(10).copied().unwrap_or(0));
+        if bw != 0 || ofdma != 0 {
+            continue;
+        }
+        let band_ok = e_band == band || (rs == RS_CCK && e_band == BAND_2G);
+        if !band_ok {
+            continue;
+        }
+        for i in 0..len.min(4) {
+            let value = (data >> (8 * i)) as u8 as i8;
+            let index = shf + i;
+            let slot = match rs {
+                RS_CCK => out.cck.get_mut(index),
+                RS_OFDM => out.ofdm.get_mut(index),
+                RS_MCS => out.mcs.get_mut(nss).and_then(|row| row.get_mut(index)),
+                RS_HEDCM => out.hedcm.get_mut(nss).and_then(|row| row.get_mut(index)),
+                RS_OFFSET => out.offset.get_mut(index),
+                _ => None,
+            };
+            if let Some(slot) = slot {
+                *slot = value;
+            }
+        }
+    }
+    out
+}
+
+/// `__rtw8852bx_init_txpwr_unit` (the same on every 802.11ax chip here).
+fn init_txpwr_unit(hal: &Hal) {
+    hal.w32(R_AX_PWR_UL_CTRL2, 0x0776_3333);
+    hal.w32(R_AX_PWR_COEXT_CTRL, 0x01eb_f000);
+    hal.w32(R_AX_PWR_UL_CTRL0, 0x0002_f8ff);
+    hal.set32(R_AX_PWR_UL_TB_CTRL, B_AX_PWR_UL_TB_CTRL_EN);
+    hal.w32_mask(R_AX_PWR_UL_TB_1T, B_AX_PWR_UL_TB_1T_MASK, 0);
+    hal.w32_mask(R_AX_PWR_UL_TB_2T, B_AX_PWR_UL_TB_2T_MASK, 0x1d);
+}
+
+/// The chip's `set_txpwr` for a band: by rate (`rtw89_phy_set_txpwr_byrate_ax`),
+/// the offsets, the limits and their RU ones (a cap), the reference
+/// (`rtw8852bx_set_txpwr_ref`, 0 dBm with no difference between paths).
+pub(crate) fn set_txpwr(hal: &Hal, fw: &Firmware, band: u8) {
+    let table = byrate(fw, band);
+    let to_mac = |value: i8| (value >> 1) as u8 as u32;
+    let mut words = Vec::new();
+    let pack = |values: &[i8]| -> Vec<u32> {
+        values.chunks(4).map(|four| (0..4).fold(0u32, |word, i| word | (to_mac(four[i]) << (8 * i)))).collect()
+    };
+    for nss in 0..hal.chip.rf_paths as usize {
+        if nss == 0 {
+            words.extend(pack(&table.cck));
+            words.extend(pack(&table.ofdm));
+        }
+        words.extend(pack(&table.mcs[nss]));
+        words.extend(pack(&table.hedcm[nss]));
+    }
+    for (index, word) in words.iter().enumerate() {
+        hal.w32(R_AX_PWR_BY_RATE + index as u32 * 4, *word);
+    }
+    let offset = (0..5).fold(0u32, |value, i| value | ((to_mac(table.offset[i]) & 0xf) << (4 * i)));
+    hal.w32_mask(R_AX_PWR_RATE_OFST_CTRL, 0xfffff, offset);
+    let cap = LIMIT_CAP as u8 as u32;
+    let cap_word = cap | (cap << 8) | (cap << 16) | (cap << 24);
+    for at in (0..40 * hal.chip.rf_paths as u32).step_by(4) {
+        hal.w32(R_AX_PWR_LMT + at, cap_word);
+    }
+    for at in (0..24 * hal.chip.rf_paths as u32).step_by(4) {
+        hal.w32(R_AX_PWR_RU_LMT + at, cap_word);
+    }
+    set_txpwr_ref(hal);
+}
+
+/// `rtw8852bx_set_txpwr_ref` with no offset (`rtw8852bx_bb_cal_txpwr_ref`).
+pub(crate) fn set_txpwr_ref(hal: &Hal) {
+    hal.w32_mask(R_AX_PWR_RATE_CTRL, B_AX_PWR_REF, 0);
+    let cw = {
+        let pwr_s10_3: i32 = 0x27 << 3;
+        let bb = (pwr_s10_3 & 0x7) as u32;
+        let rf = (((pwr_s10_3 >> 3) & 0x3f) as i32).clamp(15, 63) as u32;
+        let tssi = (0x12c - (16 << 3)) as u32;
+        field(B_DPD_TSSI_CW, tssi) | field(B_DPD_PWR_CW, (rf << 3) | bb) | field(B_DPD_REF, 0)
+    };
+    let mask = B_DPD_TSSI_CW | B_DPD_PWR_CW | B_DPD_REF;
+    let bases: &[u32] = if hal.chip.rf_paths > 1 { &[0x5800, 0x7800] } else { &[0x5800] };
+    for &base in bases {
+        hal.phy_w32_mask(base + 0x4, mask, cw);
+        hal.phy_w32_mask(base + 0x8, mask, cw);
+    }
+}
+
+// ---- TSSI: the eFuse's offsets by channel group. ----
+
+/// A TSSI channel group that sits between two (`PHY_TSSI_EXTRA_GROUP`):
+/// the offset is their mean.
+#[derive(Clone, Copy)]
+pub(crate) enum Group {
+    One(usize),
+    Between(usize),
+}
+
+/// `phy_tssi_get_cck_group`.
+pub(crate) fn cck_group(ch: u8) -> usize {
+    match ch {
+        3..=5 => 1,
+        6..=8 => 2,
+        9..=11 => 3,
+        12..=13 => 4,
+        14 => 5,
+        _ => 0,
+    }
+}
+
+/// `phy_tssi_get_ofdm_group`: 2.4 GHz's five groups, then 5 GHz's (36 to
+/// 64, 100 to 144, 149 to 177), some channels between two.
+pub(crate) fn ofdm_group(ch: u8) -> Group {
+    match ch {
+        1..=2 => Group::One(0),
+        3..=5 => Group::One(1),
+        6..=8 => Group::One(2),
+        9..=11 => Group::One(3),
+        12..=14 => Group::One(4),
+        36..=177 => {
+            const STARTS: [(u8, usize); 14] = [(36, 5), (44, 6), (52, 7), (60, 8), (100, 9), (108, 10), (116, 11), (124, 12), (132, 13), (140, 14), (149, 15), (157, 16), (165, 17), (173, 18)];
+            let Some(&(start, group)) = STARTS.iter().rev().find(|(start, _)| ch >= *start) else { return Group::One(0) };
+            // Five channels a group, the next three between it and the next.
+            // Channels past a group's run belong to none (group 0).
+            match ch - start {
+                0..=4 => Group::One(group),
+                5..=7 if !matches!(group, 8 | 14 | 18) => Group::Between(group),
+                _ => Group::One(0),
+            }
+        }
+        _ => Group::One(0),
+    }
+}
+
+/// `phy_tssi_get_6g_ofdm_group`: groups of 8 channels from 1 (five, then
+/// three between it and the next), the 32nd channel of each 32 alone.
+pub(crate) fn ofdm_group_6g(ch: u8) -> Group {
+    if !(1..=253).contains(&ch) {
+        return Group::One(0);
+    }
+    let group = ((ch - 1) / 8) as usize;
+    match (ch - 1) % 8 {
+        0..=4 => Group::One(group),
+        // Channels 30 to 32 of each 32 end a run of four groups: none.
+        _ if group % 4 == 3 => Group::One(0),
+        _ => Group::Between(group),
+    }
+}
+
+/// The TSSI offset of a group (`phy_tssi_get_ofdm_de`): its own, or the
+/// mean of the two it sits between.
+pub(crate) fn group_value(values: &[i8], group: Group) -> i8 {
+    match group {
+        Group::One(index) => values.get(index).copied().unwrap_or(0),
+        Group::Between(index) => {
+            let (first, second) = (values.get(index).copied().unwrap_or(0) as i32, values.get(index + 1).copied().unwrap_or(0) as i32);
+            ((first + second) / 2) as i8
+        }
+    }
+}
