@@ -0,0 +1,359 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The chip's registers as Linux's rtw88 reaches them over PCIe (BAR 2),
+//! its power sequences, its efuse, and its RF registers.
+
+use alloc::{string::String, vec, vec::Vec};
+
+use aster_pci::cfg_space::BarAccess;
+
+use crate::regs::*;
+
+/// One step of a power sequence (`struct rtw_pwr_seq_cmd`).
+#[derive(Clone, Copy)]
+pub(crate) struct PwrCmd {
+    pub(crate) offset: u16,
+    pub(crate) cut_mask: u8,
+    pub(crate) intf_mask: u8,
+    pub(crate) base: u8,
+    pub(crate) cmd: u8,
+    pub(crate) mask: u8,
+    pub(crate) value: u8,
+}
+
+/// A PCIe PHY parameter (`struct rtw_intf_phy_para`).
+#[derive(Clone, Copy)]
+pub(crate) struct IntfPara {
+    pub(crate) offset: u16,
+    pub(crate) value: u16,
+    pub(crate) ip_sel: u32,
+    pub(crate) cut_mask: u16,
+}
+
+/// The register's field selected by `mask`, shifted down.
+fn field(value: u32, mask: u32) -> u32 {
+    if mask == 0 { 0 } else { (value & mask) >> mask.trailing_zeros() }
+}
+
+pub(crate) struct Chip {
+    mmio: BarAccess,
+    pub(crate) name: String,
+    /// `hal.cut_version` and the RF paths (`REG_SYS_CFG1`).
+    pub(crate) cut: u8,
+    pub(crate) rf_paths: u8,
+}
+
+impl Chip {
+    pub(crate) fn new(mmio: BarAccess, name: String) -> Self {
+        let mut chip = Self { mmio, name, cut: 0, rf_paths: 1 };
+        let version = chip.r32(REG_SYS_CFG1);
+        chip.cut = field(version, BITS_CHIP_VER) as u8;
+        chip.rf_paths = if version & BIT_RF_TYPE_ID != 0 { 2 } else { 1 };
+        chip
+    }
+
+    pub(crate) fn present(&self) -> bool {
+        self.r32(REG_SYS_CFG1) != u32::MAX
+    }
+
+    // ---- Registers. ----
+
+    pub(crate) fn r8(&self, addr: u32) -> u8 {
+        self.mmio.read_once::<u8>(addr as usize).unwrap_or(u8::MAX)
+    }
+
+    pub(crate) fn r16(&self, addr: u32) -> u16 {
+        self.mmio.read_once::<u16>(addr as usize).unwrap_or(u16::MAX)
+    }
+
+    pub(crate) fn r32(&self, addr: u32) -> u32 {
+        self.mmio.read_once::<u32>(addr as usize).unwrap_or(u32::MAX)
+    }
+
+    pub(crate) fn w8(&self, addr: u32, value: u8) {
+        let _ = self.mmio.write_once::<u8>(addr as usize, value);
+    }
+
+    pub(crate) fn w16(&self, addr: u32, value: u16) {
+        let _ = self.mmio.write_once::<u16>(addr as usize, value);
+    }
+
+    pub(crate) fn w32(&self, addr: u32, value: u32) {
+        let _ = self.mmio.write_once::<u32>(addr as usize, value);
+    }
+
+    pub(crate) fn set8(&self, addr: u32, bits: u32) {
+        self.w8(addr, self.r8(addr) | bits as u8);
+    }
+
+    pub(crate) fn clr8(&self, addr: u32, bits: u32) {
+        self.w8(addr, self.r8(addr) & !(bits as u8));
+    }
+
+    pub(crate) fn set16(&self, addr: u32, bits: u32) {
+        self.w16(addr, self.r16(addr) | bits as u16);
+    }
+
+    pub(crate) fn set32(&self, addr: u32, bits: u32) {
+        self.w32(addr, self.r32(addr) | bits);
+    }
+
+    pub(crate) fn clr32(&self, addr: u32, bits: u32) {
+        self.w32(addr, self.r32(addr) & !bits);
+    }
+
+    pub(crate) fn r32_mask(&self, addr: u32, mask: u32) -> u32 {
+        field(self.r32(addr), mask)
+    }
+
+    pub(crate) fn w32_mask(&self, addr: u32, mask: u32, value: u32) {
+        let shift = mask.trailing_zeros();
+        self.w32(addr, (self.r32(addr) & !mask) | ((value << shift) & mask));
+    }
+
+    pub(crate) fn w8_mask(&self, addr: u32, mask: u32, value: u32) {
+        let shift = mask.trailing_zeros();
+        self.w8(addr, ((self.r8(addr) as u32 & !mask) | ((value << shift) & mask)) as u8);
+    }
+
+    /// Linux's `check_hw_ready`: the field reaches `target` within 10 ms.
+    pub(crate) fn ready(&self, addr: u32, mask: u32, target: u32) -> bool {
+        for _ in 0..1000 {
+            if self.r32_mask(addr, mask) == target {
+                return true;
+            }
+            crate::delay_us(10);
+        }
+        false
+    }
+
+    // ---- Power. ----
+
+    /// Linux's `rtw_pwr_seq_parser` for PCIe.
+    pub(crate) fn power_sequence(&self, flow: &[&[PwrCmd]]) -> Result<(), String> {
+        let cut_mask = 1u8 << (self.cut + 1);
+        for steps in flow {
+            for step in steps.iter() {
+                if step.cmd == RTW_PWR_CMD_END as u8 {
+                    break;
+                }
+                // PCIe's steps (an SDIO-local address is not reachable here).
+                if step.intf_mask & RTW_PWR_INTF_PCI_MSK as u8 == 0 || step.cut_mask & cut_mask == 0 || step.base as u32 == RTW_PWR_ADDR_SDIO {
+                    continue;
+                }
+                let offset = step.offset as u32;
+                match step.cmd as u32 {
+                    RTW_PWR_CMD_WRITE => {
+                        let value = (self.r8(offset) & !step.mask) | (step.value & step.mask);
+                        self.w8(offset, value);
+                    }
+                    RTW_PWR_CMD_POLLING => {
+                        if !self.power_poll(offset, step.mask, step.value) {
+                            // PCIe: toggle BIT_PFM_WOWL and try again.
+                            let value = self.r8(REG_SYS_PW_CTRL);
+                            self.w8(REG_SYS_PW_CTRL, value | BIT_PFM_WOWL as u8);
+                            self.w8(REG_SYS_PW_CTRL, value & !(BIT_PFM_WOWL as u8));
+                            if !self.power_poll(offset, step.mask, step.value) {
+                                return Err(alloc::format!("power sequence: {offset:#x} & {:#x} did not become {:#x}", step.mask, step.value));
+                            }
+                        }
+                    }
+                    RTW_PWR_CMD_DELAY => {
+                        if step.value as u32 == RTW_PWR_DELAY_US {
+                            crate::delay_us(step.offset as u64);
+                        } else {
+                            crate::delay_ms(step.offset as u64);
+                        }
+                    }
+                    _ => {}
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn power_poll(&self, offset: u32, mask: u8, target: u8) -> bool {
+        for _ in 0..RTW_PWR_POLLING_CNT {
+            if self.r8(offset) & mask == target & mask {
+                return true;
+            }
+            crate::delay_us(50);
+        }
+        false
+    }
+
+    /// Linux's `rtw_mac_pre_system_cfg` (PCIe, 3081 CPU).
+    pub(crate) fn pre_system_cfg(&self) {
+        self.w8(REG_RSV_CTRL, 0);
+        self.set32(REG_HCI_OPT_CTRL, BIT_USB_SUS_DIS);
+        self.set32(REG_PAD_CTRL1, BIT_PAPE_WLBT_SEL | BIT_LNAON_WLBT_SEL);
+        self.clr32(REG_LED_CFG, BIT_PAPE_SEL_EN | BIT_LNAON_SEL_EN);
+        self.set32(REG_GPIO_MUXCFG, BIT_WLRFE_4_5_EN);
+        // BB and RF off.
+        self.clr8(REG_SYS_FUNC_EN, BIT_FEN_BB_RSTB | BIT_FEN_BB_GLB_RST);
+        self.clr8(REG_RF_CTRL, BIT_RF_SDM_RSTB | BIT_RF_RSTB | BIT_RF_EN);
+        self.clr32(REG_WLRF1, BIT_WLRF1_BBRF_EN);
+    }
+
+    /// Whether the MAC is powered (`rtw_mac_power_switch`'s check), after
+    /// the firmware's RPWM toggle when one runs.
+    pub(crate) fn powered(&self) -> bool {
+        let rpwm = self.r8(RPWM_ADDR);
+        if self.r16(REG_MCUFW_CTRL) == 0xc078 {
+            self.w8(RPWM_ADDR, (rpwm ^ BIT_RPWM_TOGGLE as u8) & BIT_RPWM_TOGGLE as u8);
+        }
+        self.r8(REG_CR) != 0xea
+    }
+
+    /// Linux's `__rtw_mac_init_system_cfg`.
+    pub(crate) fn init_system_cfg(&self, sys_func_en: u8) {
+        self.set32(REG_CPU_DMEM_CON, BIT_WL_PLATFORM_RST | BIT_DDMA_EN);
+        self.set8(REG_SYS_FUNC_EN + 1, sys_func_en as u32);
+        let value = (self.r8(REG_CR_EXT + 3) & 0xf0) | 0x0c;
+        self.w8(REG_CR_EXT + 3, value);
+        let fw = self.r32(REG_MCUFW_CTRL);
+        if fw & BIT_BOOT_FSPI_EN != 0 {
+            self.w32(REG_MCUFW_CTRL, fw & !BIT_BOOT_FSPI_EN);
+            self.clr32(REG_GPIO_MUXCFG, BIT_FSPI_EN);
+        }
+    }
+
+    // ---- Efuse. ----
+
+    /// The physical efuse, then its logical map (Linux's
+    /// `rtw_dump_physical_efuse_map`, `rtw_dump_logical_efuse_map`).
+    pub(crate) fn read_efuse(&self, physical: usize, logical: usize, protect: usize, ldo25: impl Fn(&Self, bool)) -> Result<Vec<u8>, String> {
+        self.w32_mask(REG_LDO_EFUSE_CTRL, BIT_MASK_EFUSE_BANK_SEL, 0);
+        ldo25(self, false);
+        let mut map = vec![0u8; physical];
+        let mut control = self.r32(REG_EFUSE_CTRL);
+        for (addr, byte) in map.iter_mut().enumerate() {
+            control &= !(BIT_MASK_EF_DATA | BITS_EF_ADDR);
+            control |= (addr as u32 & BIT_MASK_EF_ADDR) << BIT_SHIFT_EF_ADDR;
+            self.w32(REG_EFUSE_CTRL, control & !BIT_EF_FLAG);
+            let mut tries = 0;
+            loop {
+                crate::delay_us(1);
+                control = self.r32(REG_EFUSE_CTRL);
+                if control & BIT_EF_FLAG != 0 {
+                    break;
+                }
+                tries += 1;
+                if tries > 100_000 {
+                    return Err(String::from("the efuse did not answer"));
+                }
+            }
+            *byte = (control & BIT_MASK_EF_DATA) as u8;
+        }
+        let mut log = vec![0xffu8; logical];
+        let mut at = 0;
+        while at + 1 < physical - protect {
+            let (hdr1, hdr2) = (map[at], map[at + 1]);
+            if hdr1 == 0xff || (hdr1 & 0x1f == 0x0f && hdr2 == 0xff) {
+                break;
+            }
+            let (block, word_en) = if hdr1 & 0x1f == 0x0f {
+                at += 2;
+                ((((hdr2 & 0xf0) >> 1) | ((hdr1 >> 5) & 0x07)) as usize, hdr2 & 0xf)
+            } else {
+                at += 1;
+                (((hdr1 & 0xf0) >> 4) as usize, hdr1 & 0xf)
+            };
+            for word in 0..4 {
+                if word_en & (1 << word) != 0 {
+                    continue;
+                }
+                let index = (block << 3) + (word << 1);
+                if at + 1 > physical - protect || index + 1 > logical {
+                    return Err(String::from("the efuse's map is broken"));
+                }
+                log[index] = map[at];
+                log[index + 1] = map[at + 1];
+                at += 2;
+            }
+        }
+        Ok(log)
+    }
+
+    // ---- RF. ----
+
+    /// Linux's `rtw_phy_read_rf`: the RF register through its direct window.
+    pub(crate) fn read_rf(&self, base: u32, addr: u32, mask: u32) -> u32 {
+        self.r32_mask(base + ((addr & 0xff) << 2), mask & RFREG_MASK)
+    }
+
+    /// Linux's `rtw_phy_write_rf_reg_sipi`.
+    pub(crate) fn write_rf_sipi(&self, base: u32, sipi: u32, addr: u32, mask: u32, data: u32) {
+        let addr = addr & 0xff;
+        let mask = mask & RFREG_MASK;
+        let mut data = data;
+        if mask != RFREG_MASK {
+            let old = self.read_rf(base, addr, RFREG_MASK);
+            data = (old & !mask) | (data << mask.trailing_zeros());
+        }
+        self.w32(sipi, ((addr << 20) | (data & 0x000f_ffff)) & 0x0fff_ffff);
+        crate::delay_us(13);
+    }
+
+    // ---- The LTE coexistence window (`ltecoex_read_reg`). ----
+
+    pub(crate) fn ltecoex_read(&self, offset: u16) -> Option<u32> {
+        if !self.ready(LTECOEX_ACCESS_CTRL, LTECOEX_READY, 1) {
+            return None;
+        }
+        self.w32(LTECOEX_ACCESS_CTRL, 0x800f_0000 | offset as u32);
+        Some(self.r32(LTECOEX_READ_DATA))
+    }
+
+    pub(crate) fn ltecoex_write(&self, offset: u16, value: u32) -> bool {
+        if !self.ready(LTECOEX_ACCESS_CTRL, LTECOEX_READY, 1) {
+            return false;
+        }
+        self.w32(LTECOEX_WRITE_DATA, value);
+        self.w32(LTECOEX_ACCESS_CTRL, 0xc00f_0000 | offset as u32);
+        true
+    }
+
+    /// `rtw_coex_write_indirect_reg`.
+    pub(crate) fn ltecoex_write_mask(&self, offset: u16, mask: u32, value: u32) {
+        let old = self.ltecoex_read(offset).unwrap_or(0);
+        let new = (old & !mask) | ((value << mask.trailing_zeros()) & mask);
+        if !self.ltecoex_write(offset, new) {
+            ostd::warn!("{}: an LTE coexistence register did not take its value", self.name);
+        }
+    }
+
+    // ---- PCIe PHY (`rtw_mdio_write`, `rtw_dbi_write8`). ----
+
+    pub(crate) fn mdio_write(&self, addr: u8, data: u16, g1: bool) {
+        self.w16(REG_MDIO_V1, data);
+        let mut page = if (addr as u32) < RTW_PCI_MDIO_PG_SZ { 0 } else { 1 };
+        page += if g1 { RTW_PCI_MDIO_PG_OFFS_G1 } else { RTW_PCI_MDIO_PG_OFFS_G2 };
+        self.w8(REG_PCIE_MIX_CFG, addr & BITS_MDIO_ADDR_MASK as u8);
+        self.w8(REG_PCIE_MIX_CFG + 3, page as u8);
+        self.w32_mask(REG_PCIE_MIX_CFG, BIT_MDIO_WFLAG_V1, 1);
+        for _ in 0..RTW_PCI_WR_RETRY_CNT {
+            if self.r32_mask(REG_PCIE_MIX_CFG, BIT_MDIO_WFLAG_V1) == 0 {
+                return;
+            }
+            crate::delay_us(10);
+        }
+    }
+
+    pub(crate) fn dbi_write8(&self, addr: u16, data: u8) {
+        let remainder = addr as u32 & !(BITS_DBI_WREN | BITS_DBI_ADDR_MASK);
+        let write = (addr as u32 & BITS_DBI_ADDR_MASK) | (((1u32 << remainder) << BITS_DBI_WREN.trailing_zeros()) & BITS_DBI_WREN);
+        self.w8(REG_DBI_WDATA_V1 + remainder, data);
+        self.w16(REG_DBI_FLAG_V1, write as u16);
+        self.w8(REG_DBI_FLAG_V1 + 2, (BIT_DBI_WFLAG >> 16) as u8);
+        for _ in 0..RTW_PCI_WR_RETRY_CNT {
+            if self.r8(REG_DBI_FLAG_V1 + 2) == 0 {
+                return;
+            }
+            crate::delay_us(10);
+        }
+    }
+}
+
+/// The RPWM register of PCIe (`rtw_chip_parameter_setup`).
+pub(crate) const RPWM_ADDR: u32 = 0x03d9;
