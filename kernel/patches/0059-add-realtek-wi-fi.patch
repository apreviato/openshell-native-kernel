@@ -0,0 +1,599 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The station as mac80211 runs it over rtw88: a software scan (the
+//! channel, probe requests, a dwell, the next channel), the access point's
+//! rates for the firmware's rate adaptation, keys in the security CAM, and
+//! frames with their TX and RX descriptors. The driver puts the CCMP header
+//! on data frames (`IEEE80211_KEY_FLAG_GENERATE_IV`); the chip encrypts.
+
+use alloc::{string::String, sync::Arc, vec, vec::Vec};
+
+use aster_wlan::{
+    Device,
+    ieee80211::{self as wifi, Address},
+    radio::{self, Association, Band, BandId, Channel, HtCap, Info, Join, Key, RxInfo, ScanRequest},
+};
+
+use crate::{
+    hw::Hw,
+    pci::{QUEUE_BE, QUEUE_BK, QUEUE_MGMT, QUEUE_VI, QUEUE_VO, TxInfo},
+    regs::*,
+};
+
+/// The interface's MAC ID and port (the first of each, as Linux takes them).
+const MAC_ID: u8 = 0;
+const PORT: u8 = 0;
+/// The security CAM: group keys at their index (default key search),
+/// pairwise keys from entry 4 (`RTW_SEC_DEFAULT_KEY_NUM`).
+const CAM_PAIRWISE: u8 = 4;
+/// Dwell times of a software scan (mac80211's `IEEE80211_CHANNEL_TIME`
+/// after the probe delay, `IEEE80211_PASSIVE_CHANNEL_TIME`).
+const DWELL_ACTIVE_MS: u64 = 60;
+const DWELL_PASSIVE_MS: u64 = 110;
+/// While associated, the operating channel between two scanned ones.
+const HOME_MS: u64 = 100;
+/// The rates of each band in the chip's bitmap order, 500 kbit/s each.
+const RATES_2GHZ: [u8; 12] = [2, 4, 11, 22, 12, 18, 24, 36, 48, 72, 96, 108];
+const RATES_5GHZ: [u8; 8] = [12, 18, 24, 36, 48, 72, 96, 108];
+/// The 5 GHz channels offered; the radar ones are scanned passively.
+const CHANNELS_5GHZ: [u16; 25] = [36, 40, 44, 48, 52, 56, 60, 64, 100, 104, 108, 112, 116, 120, 124, 128, 132, 136, 140, 144, 149, 153, 157, 161, 165];
+/// The CCK LNA gains (`lna_gain_table_0`, `_1`).
+const LNA_GAIN_0: [i8; 8] = [22, 8, -6, -22, -31, -40, -46, -52];
+const LNA_GAIN_1: [i8; 16] = [10, 6, 2, -2, -6, -10, -14, -17, -20, -24, -28, -31, -34, -37, -40, -44];
+/// HT: 20 MHz with its short guard interval, one stream of STBC received,
+/// no SM power save (`rtw_init_ht_cap` without 40 MHz).
+const HT_INFO: u16 = 0x0020 | 0x0100 | 0x000c;
+
+fn channel_freq(channel: u8) -> u16 {
+    match channel {
+        1..=13 => 2407 + 5 * channel as u16,
+        14 => 2484,
+        _ => 5000 + 5 * channel as u16,
+    }
+}
+
+/// The network being joined.
+#[derive(Clone)]
+struct Network {
+    join: Join,
+    channel: u8,
+    ht: Option<[u8; 26]>,
+    rates: u16,
+    basic: u16,
+}
+
+impl Network {
+    fn new(join: &Join) -> Self {
+        let elements = wifi::Elements(&join.elements);
+        let ht = elements.get(wifi::IE_HT_CAP).filter(|value| value.len() >= 26).map(|value| {
+            let mut cap = [0u8; 26];
+            cap.copy_from_slice(&value[..26]);
+            cap
+        });
+        let ghz2 = join.freq < 3000;
+        let table: &[u8] = if ghz2 { &RATES_2GHZ } else { &RATES_5GHZ };
+        let (mut rates, mut basic) = (0u16, 0u16);
+        for id in [wifi::IE_RATES, wifi::IE_EXT_RATES] {
+            for &rate in elements.get(id).unwrap_or(&[]) {
+                if let Some(index) = table.iter().position(|&known| known == rate & 0x7f) {
+                    rates |= 1 << index;
+                    if rate & 0x80 != 0 {
+                        basic |= 1 << index;
+                    }
+                }
+            }
+        }
+        if rates == 0 {
+            rates = (1 << table.len()) - 1;
+        }
+        Self { join: join.clone(), channel: wifi::channel_of(join.freq).unwrap_or(1), ht, rates, basic }
+    }
+
+    fn ghz2(&self) -> bool {
+        self.channel <= 14
+    }
+}
+
+/// A software scan in progress.
+struct Scan {
+    channels: Vec<u8>,
+    next: usize,
+    ssids: Vec<Vec<u8>>,
+    elements: Vec<u8>,
+    deadline: u64,
+    /// On the operating channel between two scanned ones.
+    home: bool,
+    aborted: bool,
+}
+
+pub(crate) struct Rtw88 {
+    pub(crate) hw: Hw,
+    pub(crate) address: Address,
+    pub(crate) device: Option<Arc<Device>>,
+    network: Option<Network>,
+    associated: bool,
+    qos: bool,
+    /// The pairwise key's index and the PN of the next protected frame.
+    pairwise: Option<(u8, u64)>,
+    scan: Option<Scan>,
+    sequence: u16,
+    /// When the watchdog runs next (Linux's every 2 s).
+    watchdog: u64,
+    pub(crate) signal: Option<i8>,
+    pub(crate) dead: bool,
+}
+
+impl Rtw88 {
+    pub(crate) fn new(hw: Hw) -> Self {
+        let address = hw.efuse.address;
+        Self { hw, address, device: None, network: None, associated: false, qos: false, pairwise: None, scan: None, sequence: 0, watchdog: 0, signal: None, dead: false }
+    }
+
+    /// `rtw_ops_add_interface` for a station on port 0, and the first
+    /// channel.
+    pub(crate) fn add_interface(&mut self) {
+        self.hw.port_address(&self.address);
+        self.hw.port_net_type(false);
+        self.hw.port_bcn_ctrl();
+        self.hw.set_rcr(false);
+        self.hw.set_channel(1, false);
+    }
+
+    // ---- Scans. ----
+
+    pub(crate) fn scan(&mut self, request: &ScanRequest) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if self.scan.is_some() {
+            return Err(radio::Error::Busy);
+        }
+        let mut channels: Vec<u8> = request.freqs.iter().filter_map(|&freq| wifi::channel_of(freq)).filter(|&channel| self.supports(channel)).collect();
+        if channels.is_empty() {
+            channels = (1..=13).chain(CHANNELS_5GHZ.iter().map(|&channel| channel as u8)).collect();
+        }
+        self.hw.set_rcr(true);
+        self.scan = Some(Scan { channels, next: 0, ssids: request.ssids.clone(), elements: request.elements.clone(), deadline: 0, home: false, aborted: false });
+        self.scan_step();
+        Ok(())
+    }
+
+    fn supports(&self, channel: u8) -> bool {
+        (1..=13).contains(&channel) || CHANNELS_5GHZ.contains(&(channel as u16))
+    }
+
+    pub(crate) fn abort_scan(&mut self) {
+        if let Some(scan) = &mut self.scan {
+            scan.aborted = true;
+            scan.deadline = 0;
+        }
+    }
+
+    /// The scan's next step when its time has come: the next channel and
+    /// its probe requests, the operating channel in between while
+    /// associated, or the end.
+    fn scan_step(&mut self) {
+        let now = crate::now_ms();
+        let Some(scan) = &mut self.scan else { return };
+        if now < scan.deadline {
+            return;
+        }
+        let home = self.network.as_ref().filter(|_| self.associated).map(|network| network.channel);
+        if scan.aborted || scan.next >= scan.channels.len() {
+            let aborted = scan.aborted;
+            self.scan = None;
+            let channel = self.network.as_ref().map_or(self.hw.channel, |network| network.channel);
+            self.hw.set_channel(channel, false);
+            self.hw.set_rcr(false);
+            if let Some(device) = &self.device {
+                device.scan_done(aborted);
+            }
+            return;
+        }
+        if let Some(home) = home
+            && !scan.home
+            && scan.next > 0
+        {
+            scan.home = true;
+            scan.deadline = now + HOME_MS;
+            self.hw.set_channel(home, false);
+            return;
+        }
+        scan.home = false;
+        let channel = scan.channels[scan.next];
+        scan.next += 1;
+        let passive = scan.ssids.is_empty() || (52..=144).contains(&channel);
+        scan.deadline = now + if passive { DWELL_PASSIVE_MS } else { DWELL_ACTIVE_MS };
+        let probes: Vec<Vec<u8>> = if passive {
+            Vec::new()
+        } else {
+            let rates: &[u8] = if channel <= 14 { &RATES_2GHZ } else { &RATES_5GHZ };
+            scan.ssids.iter().map(|ssid| wifi::probe_request(&self.address, ssid, rates, &scan.elements)).collect()
+        };
+        self.hw.set_channel(channel, true);
+        for probe in probes {
+            let _ = self.transmit(probe);
+        }
+    }
+
+    // ---- Joining. ----
+
+    /// The rates and capabilities of the access point for the firmware
+    /// (`rtw_update_sta_info`), 20 MHz.
+    fn update_ra(&mut self, init: bool) {
+        let Some(network) = &self.network else { return };
+        let ht = network.ht.filter(|_| self.associated);
+        let mut mask: u32;
+        let rate_id;
+        let ghz2 = network.ghz2();
+        if ghz2 {
+            mask = network.rates as u32;
+            if let Some(cap) = ht {
+                mask |= (cap[3] as u32) << 12;
+                mask &= 0x000f_f000 | 0x0000_0005 | 0x0000_0010;
+                rate_id = RTW_RATEID_BGN_20M_1SS;
+            } else if network.rates <= 0xf {
+                rate_id = RTW_RATEID_B_20M;
+            } else {
+                mask &= 0x0000_0ff0 | 0x0000_0005;
+                rate_id = RTW_RATEID_BG;
+            }
+        } else {
+            mask = (network.rates as u32) << 4;
+            if let Some(cap) = ht {
+                mask |= (cap[3] as u32) << 12;
+                mask &= 0x000f_f000 | 0x0000_0030;
+                rate_id = RTW_RATEID_GN_N1SS;
+            } else {
+                rate_id = RTW_RATEID_G;
+            }
+        }
+        if mask == 0 {
+            mask = if ghz2 { network.rates as u32 } else { (network.rates as u32) << 4 };
+        }
+        let (sgi, ldpc) = ht.map_or((false, false), |cap| {
+            let info = u16::from_le_bytes([cap[0], cap[1]]);
+            (info & 0x0020 != 0, false)
+        });
+        self.hw.ra_info(MAC_ID, rate_id as u8, mask, if init { 1 } else { 0 }, sgi, ldpc, true);
+    }
+
+    /// mac80211's `prep_connection` (the channel, the BSSID) and rtw88's
+    /// `rtw_sta_add` and `mgd_prepare_tx` (the calibration).
+    pub(crate) fn join(&mut self, join: &Join) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        self.leave();
+        if self.scan.is_some() {
+            self.abort_scan();
+            self.scan_step();
+        }
+        let network = Network::new(join);
+        if !self.supports(network.channel) {
+            return Err(radio::Error::Invalid);
+        }
+        self.hw.set_channel(network.channel, false);
+        self.hw.port_bssid(&join.bssid);
+        self.network = Some(network);
+        self.update_ra(true);
+        self.hw.media_status(MAC_ID, true);
+        self.hw.prepare_tx(false);
+        Ok(())
+    }
+
+    /// `bss_info_changed` (ASSOC): the link, the AID, the default port,
+    /// the EDCA of the network; the rates with HT.
+    pub(crate) fn associated(&mut self, association: &Association) -> radio::Result<()> {
+        if self.network.is_none() {
+            return Err(radio::Error::Invalid);
+        }
+        self.associated = true;
+        self.qos = association.qos;
+        self.hw.port_net_type(true);
+        self.hw.port_aid(association.aid & 0x3fff);
+        self.hw.default_port(PORT, MAC_ID);
+        self.conf_tx(&association.elements);
+        self.update_ra(false);
+        Ok(())
+    }
+
+    /// The access categories' EDCA (`rtw_ops_conf_tx`), from the WMM
+    /// element or the standard values.
+    fn conf_tx(&self, elements: &[u8]) {
+        // (cw_min, cw_max, aifsn, txop) for BE, BK, VI, VO.
+        let mut params: [(u16, u16, u8, u16); 4] = [(15, 1023, 3, 0), (15, 1023, 7, 0), (7, 15, 2, 94), (3, 7, 2, 47)];
+        let wmm = wifi::Elements(elements).iter().find(|(id, value)| *id == wifi::IE_VENDOR && value.len() >= 24 && value[..4] == wifi::WMM_OUI_TYPE && value[4] == 1);
+        if let Some((_, value)) = wmm {
+            for record in value[8..24].chunks(4) {
+                let aci = ((record[0] >> 5) & 3) as usize;
+                let (ecw_min, ecw_max) = (record[1] & 0xf, record[1] >> 4);
+                params[aci] = ((1 << ecw_min) - 1, (1 << ecw_max) - 1, record[0] & 0xf, u16::from_le_bytes([record[2], record[3]]));
+            }
+        }
+        let short_slot = self.network.as_ref().is_some_and(|network| network.join.capability & wifi::CAP_SHORT_SLOT != 0 || !network.ghz2());
+        let registers = [REG_EDCA_BE_PARAM, REG_EDCA_BK_PARAM, REG_EDCA_VI_PARAM, REG_EDCA_VO_PARAM];
+        for (register, (cw_min, cw_max, aifsn, txop)) in registers.iter().zip(params) {
+            self.hw.conf_tx(*register, cw_min, cw_max, aifsn, txop, short_slot);
+        }
+    }
+
+    /// `rtw_sta_remove` and the disassociation.
+    pub(crate) fn leave(&mut self) {
+        if self.network.is_none() {
+            return;
+        }
+        if !self.dead {
+            self.hw.media_status(MAC_ID, false);
+            self.hw.port_net_type(false);
+            self.hw.port_aid(0);
+            self.hw.port_bssid(&[0; 6]);
+            for entry in 0..=CAM_PAIRWISE {
+                self.hw.clear_cam(entry);
+            }
+        }
+        self.network = None;
+        self.associated = false;
+        self.qos = false;
+        self.pairwise = None;
+        self.signal = None;
+    }
+
+    /// `rtw_ops_set_key`: CCMP only (the chip's AES).
+    pub(crate) fn set_key(&mut self, key: &Key) -> radio::Result<()> {
+        if key.cipher != radio::CIPHER_CCMP || key.key.len() != 16 {
+            return Err(radio::Error::Unsupported);
+        }
+        let Some(network) = &self.network else { return Err(radio::Error::Invalid) };
+        if key.pairwise {
+            self.hw.write_cam(CAM_PAIRWISE, key.index, false, &network.join.bssid, &key.key);
+            self.pairwise = Some((key.index, 1));
+        } else {
+            self.hw.write_cam(key.index & 3, key.index, true, &wifi::BROADCAST, &key.key);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn remove_key(&mut self, index: u8, pairwise: bool) {
+        if pairwise {
+            self.hw.clear_cam(CAM_PAIRWISE);
+            self.pairwise = None;
+        } else {
+            self.hw.clear_cam(index & 3);
+        }
+    }
+
+    // ---- Frames. ----
+
+    /// A management frame on the management queue at the lowest basic
+    /// rate, its sequence number the hardware's
+    /// (`rtw_tx_mgmt_pkt_info_update`).
+    pub(crate) fn transmit(&mut self, frame: Vec<u8>) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if frame.len() < wifi::HEADER {
+            return Err(radio::Error::Invalid);
+        }
+        let mut frame = frame;
+        // Management frames go unprotected (no management frame protection).
+        frame[1] &= !wifi::PROTECTED;
+        let ghz2 = self.hw.channel <= 14;
+        let lowest = if ghz2 { DESC_RATE1M } else { DESC_RATE6M } as u8;
+        let basic = self.network.as_ref().map_or(0, |network| network.basic);
+        let rate = if basic == 0 { lowest } else { lowest + basic.trailing_zeros() as u8 };
+        let info = TxInfo {
+            offset: crate::pci::TX_DESC as u8,
+            bmc: frame[4] & 1 != 0,
+            ls: true,
+            dis_qselseq: true,
+            en_hwseq: true,
+            mac_id: MAC_ID,
+            qsel: TX_DESC_QSEL_MGMT as u8,
+            rate_id: if ghz2 { RTW_RATEID_B_20M } else { RTW_RATEID_G } as u8,
+            rate,
+            use_rate: true,
+            dis_rate_fallback: true,
+            ..TxInfo::default()
+        };
+        self.hw.pci.write(&self.hw.chip, QUEUE_MGMT, &info, &frame).map_err(|()| radio::Error::Busy)
+    }
+
+    /// A data frame: the CCMP header with the next PN when protected, the
+    /// queue and TID of its priority, the firmware's rate adaptation
+    /// (`rtw_tx_data_pkt_info_update`).
+    pub(crate) fn send(&mut self, ethernet: &[u8], plain: bool) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        let Some(network) = &self.network else { return Err(radio::Error::Down) };
+        let tid = self.qos.then(|| wifi::tid_of(ethernet));
+        let protected = !plain && self.pairwise.is_some();
+        let mut frame = wifi::data_from_ethernet(ethernet, &network.join.bssid, tid, protected).ok_or(radio::Error::Invalid)?;
+        let header = if tid.is_some() { 26 } else { 24 };
+        if protected && let Some((index, pn)) = self.pairwise.as_mut() {
+            let value = *pn;
+            *pn += 1;
+            let ccmp = [value as u8, (value >> 8) as u8, 0, 0x20 | (*index << 6), (value >> 16) as u8, (value >> 24) as u8, (value >> 32) as u8, (value >> 40) as u8];
+            drop(frame.splice(header..header, ccmp));
+        }
+        let sequence = self.sequence;
+        self.sequence = (sequence + 1) & 0x0fff;
+        frame[22..24].copy_from_slice(&(sequence << 4).to_le_bytes());
+        let tid = tid.unwrap_or(0);
+        let queue = match tid {
+            1 | 2 => QUEUE_BK,
+            4 | 5 => QUEUE_VI,
+            6 | 7 => QUEUE_VO,
+            _ => QUEUE_BE,
+        };
+        let ghz2 = network.ghz2();
+        let ht = network.ht.is_some() && self.associated;
+        let rate = if ht {
+            DESC_RATEMCS7
+        } else if ghz2 && network.rates <= 0xf {
+            DESC_RATE11M
+        } else {
+            DESC_RATE54M
+        } as u8;
+        let rate_id = if ht {
+            if ghz2 { RTW_RATEID_BGN_20M_1SS } else { RTW_RATEID_GN_N1SS }
+        } else if !ghz2 {
+            RTW_RATEID_G
+        } else if network.rates <= 0xf {
+            RTW_RATEID_B_20M
+        } else {
+            RTW_RATEID_BG
+        } as u8;
+        let info = TxInfo {
+            offset: crate::pci::TX_DESC as u8,
+            bmc: frame[4] & 1 != 0,
+            ls: true,
+            mac_id: MAC_ID,
+            qsel: tid,
+            rate_id,
+            rate,
+            sec_type: if protected { 3 } else { 0 },
+            seq: sequence,
+            ..TxInfo::default()
+        };
+        self.hw.pci.write(&self.hw.chip, queue, &info, &frame).map_err(|()| radio::Error::Busy)
+    }
+
+    // ---- What the chip says. ----
+
+    pub(crate) fn poll(&mut self) {
+        if self.dead {
+            return;
+        }
+        if !self.hw.chip.present() {
+            ostd::warn!("{}: the card is gone", self.hw.name());
+            self.dead = true;
+            if let Some(device) = &self.device {
+                device.connection_lost();
+            }
+            return;
+        }
+        let status = self.hw.pci.interrupts(&self.hw.chip);
+        if status[0] & IMR_C2HCMD != 0 && self.hw.chip.r8(REG_MCU_TST_CFG) == VAL_FW_TRIGGER as u8 {
+            ostd::warn!("{}: the firmware asked for a recovery; the card stays off until the next boot", self.hw.name());
+            self.dead = true;
+            if let Some(device) = &self.device {
+                device.connection_lost();
+            }
+            return;
+        }
+        for packet in self.hw.pci.receive(&self.hw.chip) {
+            self.rx(&packet);
+        }
+        if status[0] & (IMR_MGNTDOK | IMR_BEDOK | IMR_BKDOK | IMR_VIDOK | IMR_VODOK) != 0
+            && let Some(device) = &self.device
+        {
+            device.ready_to_send();
+        }
+        self.scan_step();
+        let now = crate::now_ms();
+        if now >= self.watchdog {
+            self.watchdog = now + 2000;
+            if self.associated
+                && let Some(signal) = self.signal
+            {
+                self.hw.rssi_info(MAC_ID, signal);
+            }
+        }
+    }
+
+    /// A received packet: its RX descriptor (`rtw_rx_query_rx_desc`), the
+    /// PHY status for the signal, the frame without its FCS (and MIC when
+    /// the chip decrypted it).
+    fn rx(&mut self, packet: &[u8]) {
+        if packet.len() < 24 {
+            return;
+        }
+        let word = |at: usize| u32::from_le_bytes([packet[at], packet[at + 1], packet[at + 2], packet[at + 3]]);
+        let (w0, w2) = (word(0), word(8));
+        if w2 & (1 << 28) != 0 {
+            // A C2H from the firmware: nothing the station needs.
+            return;
+        }
+        let length = (w0 & 0x3fff) as usize;
+        let (crc_err, icv_err) = (w0 & (1 << 14) != 0, w0 & (1 << 15) != 0);
+        let drv_info = (((w0 >> 16) & 0xf) * 8) as usize;
+        let enc_type = (w0 >> 20) & 7;
+        let shift = ((w0 >> 24) & 3) as usize;
+        let phy_status = w0 & (1 << 26) != 0;
+        let swdec = w0 & (1 << 27) != 0;
+        if crc_err || icv_err {
+            return;
+        }
+        let at = 24 + shift + drv_info;
+        let Some(frame) = packet.get(at..at + length) else { return };
+        if frame.len() < wifi::HEADER + 4 {
+            return;
+        }
+        let mut frame = frame[..frame.len() - 4].to_vec();
+        let decrypted = !swdec && enc_type != 0;
+        if decrypted && frame[1] & wifi::PROTECTED != 0 {
+            if frame.len() < wifi::HEADER + 16 {
+                return;
+            }
+            frame.truncate(frame.len() - 8);
+        }
+        let signal = if phy_status && drv_info >= 16 {
+            let status = &packet[24 + shift..24 + shift + drv_info];
+            match status[0] & 0xf {
+                0 => {
+                    let w3 = u32::from_le_bytes([status[12], status[13], status[14], status[15]]);
+                    let vga = ((w3 >> 8) & 0x1f) as i32;
+                    let lna = ((((w3 >> 23) & 1) << 3) | ((w3 >> 13) & 7)) as usize;
+                    let table: &[i8] = if self.hw.efuse.rfe_option == 0 { &LNA_GAIN_0 } else { &LNA_GAIN_1 };
+                    table.get(lna).map(|&gain| gain as i32 - 2 * vga)
+                }
+                1 => Some(status[1] as i32 - 110),
+                _ => None,
+            }
+        } else {
+            None
+        };
+        let signal = signal.unwrap_or(-100).clamp(-127, -1) as i8;
+        if let Some(network) = &self.network
+            && wifi::addresses(&frame).is_some_and(|(_, transmitter, _)| transmitter == network.join.bssid)
+        {
+            self.signal = Some(signal);
+        }
+        let freq = channel_freq(self.hw.channel);
+        if let Some(device) = &self.device {
+            device.received(&frame, RxInfo { freq, signal, decrypted, security_header: if decrypted { 8 } else { 0 } });
+        }
+    }
+
+    pub(crate) fn info(&self) -> Info {
+        let mut mcs = [0u8; 16];
+        mcs[0] = 0xff;
+        mcs[12] = 1;
+        let ht = HtCap { info: HT_INFO, ampdu_factor: 3, ampdu_density: 4, mcs };
+        let band = |id: BandId| {
+            let channels: Vec<Channel> = match id {
+                BandId::Ghz2 => (1..=13u8).map(|channel| Channel::new(channel_freq(channel))).collect(),
+                _ => CHANNELS_5GHZ
+                    .iter()
+                    .map(|&channel| {
+                        let mut entry = Channel::new(5000 + 5 * channel);
+                        entry.radar = (52..=144).contains(&channel);
+                        entry.passive = entry.radar;
+                        entry
+                    })
+                    .collect(),
+            };
+            Band { id, channels, ht: Some(ht.clone()), vht: None, he: None }
+        };
+        Info {
+            driver: String::from("rtw88"),
+            address: self.address,
+            bands: vec![band(BandId::Ghz2), band(BandId::Ghz5)],
+            ciphers: vec![radio::CIPHER_CCMP],
+            max_scan_ssids: 4,
+            max_scan_ie_len: 512,
+        }
+    }
+}
