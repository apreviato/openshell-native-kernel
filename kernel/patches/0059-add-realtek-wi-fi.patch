@@ -0,0 +1,1280 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The chip brought up as Linux's rtw88 does it for the RTL8821CE
+//! (`rtw_power_on`): MAC power, firmware download through the reserved
+//! pages, the TX/RX FIFOs and the H2C queue, the MAC's protocol settings,
+//! the PHY tables, the channel, the TX power, the BT coexistence's antenna
+//! and the firmware's commands (H2C).
+
+use alloc::{format, string::String, vec::Vec};
+
+use crate::{
+    chip::{Chip, PwrCmd},
+    pci::{Pci, TX_DESC, TxInfo},
+    regs::*,
+    tables,
+};
+
+/// The parts of the efuse the driver uses (`struct rtw_efuse`, from
+/// `struct rtw8821c_efuse`).
+#[derive(Clone)]
+pub(crate) struct Efuse {
+    pub(crate) address: [u8; 6],
+    pub(crate) rfe_option: u8,
+    pub(crate) rf_board_option: u8,
+    pub(crate) crystal_cap: u8,
+    pub(crate) bt_setting: u8,
+    pub(crate) tx_bb_swing_2g: u8,
+    pub(crate) tx_bb_swing_5g: u8,
+    pub(crate) pkg_type: u8,
+    pub(crate) rfe_btg: bool,
+    pub(crate) share_ant: bool,
+    pub(crate) btcoex: bool,
+    /// Path A's TX power index table (`struct rtw_txpwr_idx`, 42 bytes).
+    pub(crate) txpwr: [u8; 42],
+}
+
+impl Default for Efuse {
+    fn default() -> Self {
+        Self {
+            address: [0; 6],
+            rfe_option: 0,
+            rf_board_option: 0,
+            crystal_cap: 0,
+            bt_setting: 0,
+            tx_bb_swing_2g: 0,
+            tx_bb_swing_5g: 0,
+            pkg_type: 0,
+            rfe_btg: false,
+            share_ant: false,
+            btcoex: false,
+            txpwr: [0; 42],
+        }
+    }
+}
+
+/// The chip models (only the RTL8821C so far).
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub(crate) enum Model {
+    Rtl8821c,
+}
+
+impl Model {
+    pub(crate) fn firmware(self) -> &'static str {
+        match self {
+            Model::Rtl8821c => "rtw88/rtw8821c_fw.bin",
+        }
+    }
+
+    fn power_on(self) -> &'static [&'static [PwrCmd]] {
+        &tables::CARD_ENABLE_FLOW_8821C
+    }
+
+    fn power_off(self) -> &'static [&'static [PwrCmd]] {
+        &tables::CARD_DISABLE_FLOW_8821C
+    }
+}
+
+// The chip's facts (`rtw8821c_hw_spec`).
+const SYS_FUNC_EN: u8 = 0xd8;
+const PHY_EFUSE_SIZE: usize = 512;
+const LOG_EFUSE_SIZE: usize = 512;
+const PTCT_EFUSE_SIZE: usize = 96;
+const TXFF_SIZE: u32 = 65536;
+const RXFF_SIZE: u32 = 16384;
+const RSVD_DRV_PG_NUM: u32 = 8;
+const PAGE_SIZE: u32 = 128;
+const MAX_POWER_INDEX: i32 = 0x3f;
+const RF_BASE_A: u32 = 0x2800;
+const RF_SIPI_A: u32 = 0x0c90;
+/// The DIG register of path A (`rtw8821c_dig`).
+const DIG_ADDR: u32 = 0x0c50;
+/// The RFE types Linux knows for the RTL8821C (`rtw8821c_rfe_defs`), and
+/// those whose AGC table adds the BTG one.
+const RFE_SUPPORTED: [u8; 4] = [0, 2, 4, 6];
+const RFE_AGC_BTG: [u8; 2] = [2, 4];
+/// `rtw8821c_txscale_tbl` and the BB swing settings.
+const TXSCALE: [u32; 37] = [
+    0x081, 0x088, 0x090, 0x099, 0x0a2, 0x0ac, 0x0b6, 0x0c0, 0x0cc, 0x0d8, 0x0e5, 0x0f2, 0x101, 0x110, 0x120, 0x131, 0x143, 0x156, 0x16a, 0x180, 0x197, 0x1af, 0x1c8,
+    0x1e3, 0x200, 0x21e, 0x23e, 0x261, 0x285, 0x2ab, 0x2d3, 0x2fe, 0x32b, 0x35c, 0x38e, 0x3c4, 0x3fe,
+];
+// Coexistence (`rtw8821c.c`, `coex.c`).
+const COEX_TABLE_SANT: [(u32, u32); 3] = [(0x5555_5555, 0x5555_5555), (0x5555_5555, 0x5555_5555), (0x6655_5555, 0x6655_5555)];
+
+/// Where the antenna's switch points (`COEX_SWITCH_TO_*`).
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Switch {
+    Bt,
+    Wlg,
+    WlgBt,
+    Wla,
+}
+
+/// The RF front end's set (`enum rtw8821ce_rf_set`).
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum RfSet {
+    Btg,
+    Wlg,
+    Wla,
+}
+
+/// How the antenna's switch is controlled (`COEX_SWITCH_CTRL_*`).
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum SwitchCtrl {
+    Bbsw,
+    Pta,
+}
+
+pub(crate) struct Hw {
+    pub(crate) chip: Chip,
+    pub(crate) pci: Pci,
+    pub(crate) model: Model,
+    pub(crate) efuse: Efuse,
+    firmware: Vec<u8>,
+    h2c_box: u32,
+    h2c_seq: u16,
+    /// The FIFO's reserved pages (`struct rtw_fifo_conf`).
+    rsvd_boundary: u32,
+    rsvd_fw_txbuf_addr: u32,
+    rsvd_h2cq_addr: u32,
+    /// The RX filter (`hal.rcr`).
+    pub(crate) rcr: u32,
+    /// CCK TX filters read after the tables (`hal.ch_param`).
+    ch_param: [u32; 3],
+    pub(crate) channel: u8,
+    pub(crate) need_rfk: bool,
+    default_ofdm_index: u8,
+    bt_disabled: bool,
+    score_board: u16,
+}
+
+impl Hw {
+    pub(crate) fn new(chip: Chip, pci: Pci, model: Model, firmware: Vec<u8>) -> Self {
+        Self {
+            chip,
+            pci,
+            model,
+            efuse: Efuse::default(),
+            firmware,
+            h2c_box: 0,
+            h2c_seq: 0,
+            rsvd_boundary: 0,
+            rsvd_fw_txbuf_addr: 0,
+            rsvd_h2cq_addr: 0,
+            rcr: BIT_APP_FCS | BIT_APP_MIC | BIT_APP_ICV | BIT_PKTCTL_DLEN | BIT_HTC_LOC_CTRL | BIT_APP_PHYSTS | BIT_AB | BIT_AM | BIT_APM | BIT_VHT_DACK,
+            ch_param: [0; 3],
+            channel: 1,
+            need_rfk: true,
+            default_ofdm_index: 24,
+            bt_disabled: true,
+            score_board: 0,
+        }
+    }
+
+    pub(crate) fn name(&self) -> &str {
+        &self.chip.name
+    }
+
+    // ---- Power. ----
+
+    /// Linux's `rtw_mac_power_on`.
+    fn mac_power_on(&mut self) -> Result<(), String> {
+        self.chip.pre_system_cfg();
+        if self.chip.powered() {
+            // Already on: off first, then on again.
+            let _ = self.chip.power_sequence(self.model.power_off());
+            self.chip.pre_system_cfg();
+        }
+        self.chip.power_sequence(self.model.power_on()).map_err(|error| format!("MAC power-on: {error}"))?;
+        self.chip.init_system_cfg(SYS_FUNC_EN);
+        Ok(())
+    }
+
+    pub(crate) fn power_off(&mut self) {
+        self.pci.disable_interrupts(&self.chip);
+        self.chip.w16(REG_WIFI_BT_INFO, BIT_BT_INT_EN as u16);
+        let _ = self.chip.power_sequence(self.model.power_off());
+    }
+
+    /// Linux's `rtw_chip_efuse_info_setup` for the RTL8821CE: the MAC on,
+    /// the firmware (it reports the hardware's features), the efuse, the
+    /// MAC off again.
+    pub(crate) fn read_efuse(&mut self) -> Result<(), String> {
+        self.pci.setup(&self.chip);
+        self.mac_power_on()?;
+        self.chip.w8(REG_C2HEVT, C2H_HW_FEATURE_DUMP as u8);
+        self.download_firmware()?;
+        let ldo25 = |chip: &Chip, enable: bool| {
+            let value = chip.r8(REG_LDO_EFUSE_CTRL + 3);
+            chip.w8(REG_LDO_EFUSE_CTRL + 3, if enable { value | 0x80 } else { value & !0x80 });
+        };
+        let map = self.chip.read_efuse(PHY_EFUSE_SIZE, LOG_EFUSE_SIZE, PTCT_EFUSE_SIZE, ldo25);
+        // The hardware's features (`rtw_dump_hw_feature`): only read, to
+        // clear the report.
+        if self.chip.r8(REG_C2HEVT) == C2H_HW_FEATURE_REPORT as u8 {
+            self.chip.w8(REG_C2HEVT, 0);
+        }
+        self.power_off();
+        let map = map?;
+        // `struct rtw8821c_efuse`: the TX power table at 0x10, the rest
+        // after its four paths, the PCIe MAC address at 0xd0.
+        let e = &mut self.efuse;
+        e.txpwr.copy_from_slice(&map[0x10..0x10 + 42]);
+        e.crystal_cap = map[0xb9];
+        e.rf_board_option = map[0xc1];
+        e.bt_setting = map[0xc3];
+        e.tx_bb_swing_2g = map[0xc6];
+        e.tx_bb_swing_5g = map[0xc7];
+        e.rfe_option = map[0xca] & 0x1f;
+        e.pkg_type = (map[0xca] >> 5) & 1;
+        e.address.copy_from_slice(&map[0xd0..0xd6]);
+        e.rfe_btg = matches!(e.rfe_option, 0x2 | 0x4 | 0x7 | 0xa | 0xc | 0xf);
+        if e.rfe_option == 2 || e.rfe_option == 4 {
+            // Path B's 2.4 GHz table (`txpwr_idx_table[1].pwr_idx_2g`).
+            let at = 0x10 + 42;
+            e.txpwr[..18].copy_from_slice(&map[at..at + 18]);
+        }
+        if e.crystal_cap == 0xff {
+            e.crystal_cap = 0;
+        }
+        if e.rf_board_option == 0xff {
+            e.rf_board_option = 0;
+        }
+        if e.tx_bb_swing_2g == 0xff {
+            e.tx_bb_swing_2g = 0;
+        }
+        if e.tx_bb_swing_5g == 0xff {
+            e.tx_bb_swing_5g = 0;
+        }
+        e.share_ant = e.bt_setting & 1 != 0;
+        e.btcoex = e.rf_board_option & 0xe0 == 0x20;
+        if !RFE_SUPPORTED.contains(&e.rfe_option) {
+            return Err(format!("RFE type {} is not supported", e.rfe_option));
+        }
+        if e.address == [0; 6] || e.address == [0xff; 6] || e.address[0] & 1 != 0 {
+            return Err(String::from("the efuse has no MAC address"));
+        }
+        Ok(())
+    }
+
+    /// Linux's `rtw_power_on` and `rtw_core_start`.
+    pub(crate) fn power_on(&mut self) -> Result<(), String> {
+        self.pci.setup(&self.chip);
+        self.mac_power_on()?;
+        self.download_firmware()?;
+        self.mac_init()?;
+        self.phy_set_param();
+        self.pci.enable_interrupts(&self.chip);
+        self.send_general_info();
+        self.send_phydm_info();
+        self.coex_power_on_setting();
+        self.coex_init_hw_config(!self.efuse.btcoex);
+        self.enable_sec_engine();
+        self.chip.w32(REG_RCR, self.rcr);
+        Ok(())
+    }
+
+    // ---- Firmware. ----
+
+    /// Linux's `__rtw_download_firmware` (the 3081 CPU's).
+    fn download_firmware(&mut self) -> Result<(), String> {
+        let firmware = core::mem::take(&mut self.firmware);
+        let result = self.download(&firmware);
+        self.firmware = firmware;
+        if result.is_err() {
+            self.chip.clr8(REG_MCUFW_CTRL, BIT_MCUFWDL_EN);
+            self.chip.set8(REG_SYS_FUNC_EN + 1, BIT_FEN_CPUEN);
+        }
+        result
+    }
+
+    fn download(&mut self, data: &[u8]) -> Result<(), String> {
+        let le = |at: usize| data.get(at..at + 4).map_or(0, |b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]));
+        if data.len() < FW_HDR_SIZE as usize {
+            return Err(String::from("the firmware is too short"));
+        }
+        let mem_usage = data[0x18];
+        let (dmem, imem) = (le(0x24) + FW_HDR_CHKSUM_SIZE, le(0x30) + FW_HDR_CHKSUM_SIZE);
+        let emem = if mem_usage & (1 << 4) != 0 { le(0x34) + FW_HDR_CHKSUM_SIZE } else { 0 };
+        if FW_HDR_SIZE + dmem + imem + emem != data.len() as u32 {
+            return Err(String::from("the firmware's sizes do not add up"));
+        }
+        let lte = self.chip.ltecoex_read(0x38).ok_or_else(|| String::from("the LTE coexistence window is busy"))?;
+        self.wlan_cpu(false);
+        // Backup and the download's settings (`download_firmware_reg_backup`).
+        let c = &self.chip;
+        let backup_pq = c.r8(REG_TXDMA_PQ_MAP + 1);
+        c.w8(REG_TXDMA_PQ_MAP + 1, (RTW_DMA_MAPPING_HIGH << 6) as u8);
+        let backup_cr = c.r8(REG_CR);
+        c.w8(REG_CR, (BIT_HCI_TXDMA_EN | BIT_TXDMA_EN) as u8);
+        c.w32(REG_H2CQ_CSR, BIT_H2CQ_FULL);
+        let backup_fifo1 = c.r16(REG_FIFOPAGE_INFO_1);
+        let backup_rqpn = c.r32(REG_RQPN_CTRL_2) | BIT_LD_RQPN;
+        c.w16(REG_FIFOPAGE_INFO_1, 0x200);
+        c.w32(REG_RQPN_CTRL_2, backup_rqpn);
+        let backup_bcn = c.r8(REG_BCN_CTRL);
+        c.w8(REG_BCN_CTRL, (backup_bcn & !(BIT_EN_BCN_FUNCTION as u8)) | BIT_DIS_TSF_UDT as u8);
+        // The platform's reset.
+        c.clr8(REG_CPU_DMEM_CON + 2, BIT_WL_PLATFORM_RST >> 16);
+        c.clr8(REG_SYS_CLK_CTRL + 1, BIT_CPU_CLK_EN >> 8);
+        c.set8(REG_CPU_DMEM_CON + 2, BIT_WL_PLATFORM_RST >> 16);
+        c.set8(REG_SYS_CLK_CTRL + 1, BIT_CPU_CLK_EN >> 8);
+        // DMEM, IMEM, EMEM.
+        let value = (c.r16(REG_MCUFW_CTRL) & 0x3800) | BIT_MCUFWDL_EN as u16;
+        c.w16(REG_MCUFW_CTRL, value);
+        let mut at = FW_HDR_SIZE as usize;
+        let parts = [(le(0x20) & !(1 << 31), dmem), (le(0x3c) & !(1 << 31), imem), (le(0x38) & !(1 << 31), emem)];
+        for (dst, size) in parts {
+            if size == 0 {
+                continue;
+            }
+            self.download_to_mem(&data[at..at + size as usize], dst)?;
+            at += size as usize;
+        }
+        // Restore, then the end of the download (`download_firmware_end_flow`).
+        let c = &self.chip;
+        c.w8(REG_TXDMA_PQ_MAP + 1, backup_pq);
+        c.w8(REG_CR, backup_cr);
+        c.w32(REG_H2CQ_CSR, BIT_H2CQ_FULL);
+        c.w16(REG_FIFOPAGE_INFO_1, backup_fifo1);
+        c.w32(REG_RQPN_CTRL_2, backup_rqpn);
+        c.w8(REG_BCN_CTRL, backup_bcn);
+        c.w32(REG_TXDMA_STATUS, BTI_PAGE_OVF);
+        let control = c.r16(REG_MCUFW_CTRL);
+        if control as u32 & BIT_CHECK_SUM_OK == BIT_CHECK_SUM_OK {
+            c.w16(REG_MCUFW_CTRL, (control | BIT_FW_DW_RDY as u16) & !(BIT_MCUFWDL_EN as u16));
+        }
+        self.wlan_cpu(true);
+        if !self.chip.ltecoex_write(0x38, lte) {
+            return Err(String::from("the LTE coexistence window is busy"));
+        }
+        if !self.chip.ready(REG_MCUFW_CTRL, FW_READY_MASK, FW_READY) {
+            let key = self.chip.r32(REG_FW_DBG7) & FW_KEY_MASK;
+            return Err(format!("the firmware did not start (key {key:#x})"));
+        }
+        self.pci.setup(&self.chip);
+        self.h2c_box = 0;
+        self.h2c_seq = 0;
+        // The RTL8821CE's BT device after a firmware download.
+        let mut h2c = [0u8; 8];
+        h2c[0] = H2C_CMD_RECOVER_BT_DEV as u8;
+        h2c[1] = 1;
+        self.h2c(&h2c);
+        Ok(())
+    }
+
+    fn wlan_cpu(&self, enable: bool) {
+        if enable {
+            self.chip.set8(REG_RSV_CTRL + 1, BIT_WLMCU_IOIF);
+            self.chip.set8(REG_SYS_FUNC_EN + 1, BIT_FEN_CPUEN);
+        } else {
+            self.chip.clr8(REG_SYS_FUNC_EN + 1, BIT_FEN_CPUEN);
+            self.chip.clr8(REG_RSV_CTRL + 1, BIT_WLMCU_IOIF);
+        }
+    }
+
+    /// Linux's `download_firmware_to_mem`: 4 KiB at a time through the
+    /// reserved pages, then the DDMA into the CPU's memory.
+    fn download_to_mem(&mut self, data: &[u8], dst: u32) -> Result<(), String> {
+        self.chip.set32(REG_DDMA_CH0CTRL, BIT_DDMACH0_RESET_CHKSUM_STS);
+        let mut offset = 0usize;
+        let mut first = true;
+        while offset < data.len() {
+            let size = (data.len() - offset).min(0x1000);
+            self.write_rsvd_page(0, &data[offset..offset + size])?;
+            if !self.chip.ready(REG_DDMA_CH0CTRL, BIT_DDMACH0_OWN, 0) {
+                return Err(String::from("the DDMA is busy"));
+            }
+            let mut control = BIT_DDMACH0_CHKSUM_EN | BIT_DDMACH0_OWN | (size as u32 & BIT_MASK_DDMACH0_DLEN);
+            if !first {
+                control |= BIT_DDMACH0_CHKSUM_CONT;
+            }
+            self.chip.w32(REG_DDMA_CH0SA, OCPBASE_TXBUF_88XX + TX_DESC as u32);
+            self.chip.w32(REG_DDMA_CH0DA, dst + offset as u32);
+            self.chip.w32(REG_DDMA_CH0CTRL, control);
+            if !self.chip.ready(REG_DDMA_CH0CTRL, BIT_DDMACH0_OWN, 0) {
+                return Err(String::from("the DDMA did not finish"));
+            }
+            first = false;
+            offset += size;
+        }
+        // The checksum (`check_fw_checksum`).
+        let mut control = self.chip.r8(REG_MCUFW_CTRL) as u32;
+        let ok = self.chip.r32(REG_DDMA_CH0CTRL) & BIT_DDMACH0_CHKSUM_STS == 0;
+        let (done, good) = if dst < OCPBASE_DMEM_88XX { (BIT_IMEM_DW_OK, BIT_IMEM_CHKSUM_OK) } else { (BIT_DMEM_DW_OK, BIT_DMEM_CHKSUM_OK) };
+        control |= done;
+        if ok {
+            control |= good;
+        } else {
+            control &= !good;
+        }
+        self.chip.w8(REG_MCUFW_CTRL, control as u8);
+        if ok { Ok(()) } else { Err(String::from("the firmware's checksum is wrong")) }
+    }
+
+    /// Linux's `rtw_fw_write_data_rsvd_page`.
+    pub(crate) fn write_rsvd_page(&mut self, page: u32, data: &[u8]) -> Result<(), String> {
+        let c = &self.chip;
+        let backup_bcn = c.r8(REG_BCN_CTRL);
+        c.w16(REG_FIFOPAGE_CTRL_2, ((page & BIT_MASK_BCN_HEAD_1_V1) | BIT_BCN_VALID_V1) as u16);
+        let backup_cr = c.r8(REG_CR + 1);
+        c.w8(REG_CR + 1, backup_cr | (BIT_ENSWBCN >> 8) as u8);
+        c.w8(REG_BCN_CTRL, (backup_bcn & !(BIT_EN_BCN_FUNCTION as u8)) | BIT_DIS_TSF_UDT as u8);
+        let backup_txq = c.r8(REG_FWHW_TXQ_CTRL + 2);
+        c.w8(REG_FWHW_TXQ_CTRL + 2, backup_txq & !((BIT_EN_BCNQ_DL >> 16) as u8));
+        // `rtw_tx_rsvd_page_pkt_info_update` for the first (beacon) page.
+        let ghz2 = self.channel <= 14;
+        let info = TxInfo {
+            offset: TX_DESC as u8,
+            bmc: data.get(4).is_some_and(|byte| byte & 1 != 0),
+            ls: true,
+            dis_qselseq: true,
+            en_hwseq: true,
+            qsel: TX_DESC_QSEL_BEACON as u8,
+            rate_id: if ghz2 { RTW_RATEID_B_20M } else { RTW_RATEID_G } as u8,
+            rate: if ghz2 { DESC_RATE1M } else { DESC_RATE6M } as u8,
+            use_rate: true,
+            dis_rate_fallback: true,
+            ..TxInfo::default()
+        };
+        let mut result = self.pci.write_rsvd_page(&self.chip, &info, data).map_err(|()| String::from("a reserved page did not fit"));
+        if result.is_ok() && !self.chip.ready(REG_FIFOPAGE_CTRL_2, BIT_BCN_VALID_V1, 1) {
+            result = Err(String::from("the reserved page was not taken"));
+        }
+        let c = &self.chip;
+        c.w16(REG_FIFOPAGE_CTRL_2, (self.rsvd_boundary | BIT_BCN_VALID_V1) as u16);
+        c.w8(REG_BCN_CTRL, backup_bcn);
+        c.w8(REG_FWHW_TXQ_CTRL + 2, backup_txq);
+        c.w8(REG_CR + 1, backup_cr);
+        result
+    }
+
+    // ---- The firmware's commands. ----
+
+    /// Linux's `rtw_fw_send_h2c_command`: the next mailbox.
+    pub(crate) fn h2c(&mut self, command: &[u8; 8]) {
+        let (boxes, extras) = ([REG_HMEBOX0, REG_HMEBOX1, REG_HMEBOX2, REG_HMEBOX3], [REG_HMEBOX0_EX, REG_HMEBOX1_EX, REG_HMEBOX2_EX, REG_HMEBOX3_EX]);
+        let mailbox = self.h2c_box as usize;
+        let mut free = false;
+        for _ in 0..30 {
+            if (self.chip.r8(REG_HMETFR) >> mailbox) & 1 == 0 {
+                free = true;
+                break;
+            }
+            crate::delay_us(100);
+        }
+        if !free {
+            ostd::warn!("{}: the firmware did not take an H2C command ({:#x})", self.chip.name, command[0]);
+            return;
+        }
+        self.chip.w32(extras[mailbox], u32::from_le_bytes([command[4], command[5], command[6], command[7]]));
+        self.chip.w32(boxes[mailbox], u32::from_le_bytes([command[0], command[1], command[2], command[3]]));
+        self.h2c_box = (self.h2c_box + 1) % 4;
+    }
+
+    /// Linux's `rtw_fw_send_h2c_packet`: through the H2C queue.
+    pub(crate) fn h2c_packet(&mut self, sub_id: u8, payload: &[u8]) {
+        let mut packet = [0u8; H2C_PKT_SIZE as usize];
+        let word0 = (H2C_PKT_CATEGORY & 0x7f) | ((H2C_PKT_CMD_ID & 0xff) << 8) | ((sub_id as u32) << 16);
+        packet[0..4].copy_from_slice(&word0.to_le_bytes());
+        let total = (H2C_PKT_HDR_SIZE as usize + payload.len()) as u16;
+        packet[4..6].copy_from_slice(&total.to_le_bytes());
+        packet[6..8].copy_from_slice(&self.h2c_seq.to_le_bytes());
+        packet[8..8 + payload.len()].copy_from_slice(payload);
+        self.h2c_seq = self.h2c_seq.wrapping_add(1);
+        if self.pci.write_h2c(&self.chip, &packet).is_err() {
+            ostd::warn!("{}: the H2C queue is full", self.chip.name);
+        }
+    }
+
+    fn send_general_info(&mut self) {
+        let boundary = (self.rsvd_fw_txbuf_addr.wrapping_sub(self.rsvd_boundary)) as u8;
+        self.h2c_packet(H2C_PKT_GENERAL_INFO as u8, &[0, 0, boundary, 0]);
+    }
+
+    fn send_phydm_info(&mut self) {
+        let rf_type = if self.chip.rf_paths == 2 { FW_RF_2T2R } else { FW_RF_1T1R } as u8;
+        let paths = if self.chip.rf_paths == 2 { 3u8 } else { 1 };
+        self.h2c_packet(H2C_PKT_PHYDM_INFO as u8, &[self.efuse.rfe_option, rf_type, self.chip.cut, (paths & 0xf) | (paths << 4), 0, 0, 0, 0]);
+    }
+
+    /// The access point's rates for the firmware's rate adaptation
+    /// (`rtw_fw_send_ra_info`).
+    pub(crate) fn ra_info(&mut self, mac_id: u8, rate_id: u8, mask: u32, init_level: u8, sgi: bool, ldpc: bool, reset: bool) {
+        let word0 = H2C_CMD_RA_INFO | ((mac_id as u32) << 8) | ((rate_id as u32 & 0x1f) << 16) | ((init_level as u32 & 3) << 21) | ((sgi as u32) << 23) | ((ldpc as u32) << 26) | ((!reset as u32) << 27) | (1 << 30);
+        let mut command = [0u8; 8];
+        command[0..4].copy_from_slice(&word0.to_le_bytes());
+        command[4..8].copy_from_slice(&mask.to_le_bytes());
+        self.h2c(&command);
+    }
+
+    /// The link's signal for the rate adaptation (`rtw_fw_send_rssi_info`),
+    /// in Linux's 0..100 scale.
+    pub(crate) fn rssi_info(&mut self, mac_id: u8, signal: i8) {
+        let rssi = (signal as i32 + 100).clamp(0, 100) as u32;
+        let word0 = H2C_CMD_RSSI_MONITOR | ((mac_id as u32) << 8) | (rssi << 24);
+        let mut command = [0u8; 8];
+        command[0..4].copy_from_slice(&word0.to_le_bytes());
+        self.h2c(&command);
+    }
+
+    /// `rtw_fw_media_status_report`.
+    pub(crate) fn media_status(&mut self, mac_id: u8, connected: bool) {
+        let word0 = H2C_CMD_MEDIA_STATUS_RPT | ((connected as u32) << 8) | ((mac_id as u32) << 16);
+        let mut command = [0u8; 8];
+        command[0..4].copy_from_slice(&word0.to_le_bytes());
+        self.h2c(&command);
+    }
+
+    /// `rtw_fw_default_port`.
+    pub(crate) fn default_port(&mut self, port: u8, mac_id: u8) {
+        let word0 = H2C_CMD_DEFAULT_PORT | ((port as u32) << 8) | ((mac_id as u32) << 16);
+        let mut command = [0u8; 8];
+        command[0..4].copy_from_slice(&word0.to_le_bytes());
+        self.h2c(&command);
+    }
+
+    // ---- The MAC. ----
+
+    /// Linux's `rtw_mac_init`.
+    fn mac_init(&mut self) -> Result<(), String> {
+        let c = &self.chip;
+        // `txdma_queue_mapping` (PCIe: `rqpn_table_8821c[1]`).
+        let (vo, vi, be, bk, mg, hi) = (RTW_DMA_MAPPING_NORMAL, RTW_DMA_MAPPING_NORMAL, RTW_DMA_MAPPING_LOW, RTW_DMA_MAPPING_LOW, RTW_DMA_MAPPING_EXTRA, RTW_DMA_MAPPING_HIGH);
+        let map = (hi << BIT_SHIFT_TXDMA_HIQ_MAP) | (mg << BIT_SHIFT_TXDMA_MGQ_MAP) | (bk << BIT_SHIFT_TXDMA_BKQ_MAP) | (be << BIT_SHIFT_TXDMA_BEQ_MAP) | (vi << BIT_SHIFT_TXDMA_VIQ_MAP) | (vo << BIT_SHIFT_TXDMA_VOQ_MAP);
+        c.w16(REG_TXDMA_PQ_MAP, map as u16);
+        c.w8(REG_CR, 0);
+        c.w8(REG_CR, MAC_TRX_ENABLE as u8);
+        c.w32(REG_H2CQ_CSR, BIT_H2CQ_FULL);
+        // `rtw_set_trx_fifo_info` and `priority_queue_cfg` (`page_table_8821c[1]`).
+        let txff_pg_num = TXFF_SIZE / PAGE_SIZE;
+        let rsvd_pg_num = RSVD_DRV_PG_NUM + RSVD_PG_H2C_EXTRAINFO_NUM + RSVD_PG_H2C_STATICINFO_NUM + RSVD_PG_H2CQ_NUM + RSVD_PG_CPU_INSTRUCTION_NUM + RSVD_PG_FW_TXBUF_NUM;
+        let acq_pg_num = txff_pg_num - rsvd_pg_num;
+        self.rsvd_boundary = txff_pg_num - rsvd_pg_num;
+        let mut cur = txff_pg_num;
+        cur -= RSVD_PG_FW_TXBUF_NUM;
+        self.rsvd_fw_txbuf_addr = cur;
+        cur -= RSVD_PG_CPU_INSTRUCTION_NUM;
+        cur -= RSVD_PG_H2CQ_NUM;
+        self.rsvd_h2cq_addr = cur;
+        let (hq, nq, lq, exq, gapq) = (16u32, 16u32, 16u32, 14u32, 1u32);
+        let pubq = acq_pg_num - hq - lq - nq - exq - gapq;
+        let c = &self.chip;
+        c.w16(REG_FIFOPAGE_INFO_1, hq as u16);
+        c.w16(REG_FIFOPAGE_INFO_2, lq as u16);
+        c.w16(REG_FIFOPAGE_INFO_3, nq as u16);
+        c.w16(REG_FIFOPAGE_INFO_4, exq as u16);
+        c.w16(REG_FIFOPAGE_INFO_5, pubq as u16);
+        c.set32(REG_RQPN_CTRL_2, BIT_LD_RQPN);
+        c.w16(REG_FIFOPAGE_CTRL_2, self.rsvd_boundary as u16);
+        c.set8(REG_FWHW_TXQ_CTRL + 2, BIT_EN_WR_FREE_TAIL >> 16);
+        c.w16(REG_BCNQ_BDNY_V1, self.rsvd_boundary as u16);
+        c.w16(REG_FIFOPAGE_CTRL_2 + 2, self.rsvd_boundary as u16);
+        c.w16(REG_BCNQ1_BDNY_V1, self.rsvd_boundary as u16);
+        c.w32(REG_RXFF_BNDY, RXFF_SIZE - C2H_PKT_BUF - 1);
+        c.set8(REG_AUTO_LLT_V1, BIT_AUTO_INIT_LLT_V1);
+        if !c.ready(REG_AUTO_LLT_V1, BIT_AUTO_INIT_LLT_V1, 0) {
+            return Err(String::from("the FIFO's link list did not initialise"));
+        }
+        c.w8(REG_CR + 3, 0);
+        // `init_h2c`.
+        let h2cq_addr = self.rsvd_h2cq_addr << TX_PAGE_SIZE_SHIFT;
+        let h2cq_size = RSVD_PG_H2CQ_NUM << TX_PAGE_SIZE_SHIFT;
+        c.w32(REG_H2C_HEAD, (c.r32(REG_H2C_HEAD) & 0xfffc_0000) | h2cq_addr);
+        c.w32(REG_H2C_READ_ADDR, (c.r32(REG_H2C_READ_ADDR) & 0xfffc_0000) | h2cq_addr);
+        c.w32(REG_H2C_TAIL, (c.r32(REG_H2C_TAIL) & 0xfffc_0000) | (h2cq_addr + h2cq_size));
+        c.w8(REG_H2C_INFO, (c.r8(REG_H2C_INFO) & 0xfc) | 0x01);
+        c.w8(REG_H2C_INFO, (c.r8(REG_H2C_INFO) & 0xfb) | 0x04);
+        c.w8(REG_TXDMA_OFFSET_CHK + 1, (c.r8(REG_TXDMA_OFFSET_CHK + 1) & 0x7f) | 0x80);
+        let (wp, rp) = (c.r32(REG_H2C_PKT_WRITEADDR) & 0x3ffff, c.r32(REG_H2C_PKT_READADDR) & 0x3ffff);
+        let free = if wp >= rp { h2cq_size - (wp - rp) } else { rp - wp };
+        if free != h2cq_size {
+            return Err(String::from("the H2C queue does not match"));
+        }
+        self.mac_init_8821c();
+        // `rtw_drv_info_cfg`.
+        let c = &self.chip;
+        c.w8(REG_RX_DRVINFO_SZ, PHY_STATUS_SIZE as u8);
+        c.w8(REG_TRXFF_BNDY + 1, (c.r8(REG_TRXFF_BNDY + 1) & 0xf0) | 0x0f);
+        c.set32(REG_RCR, BIT_APP_PHYSTS);
+        c.clr32(REG_WMAC_OPTION_FUNCTION + 4, (1 << 8) | (1 << 9));
+        Ok(())
+    }
+
+    /// `rtw8821c_mac_init`.
+    fn mac_init_8821c(&self) {
+        let c = &self.chip;
+        c.w8(REG_AMPDU_MAX_TIME_V1, WLAN_AMPDU_MAX_TIME as u8);
+        c.set8(REG_TX_HANG_CTRL, BIT_EN_EOF_V1);
+        let pre_txcnt = WLAN_PRE_TXCNT_TIME_TH | BIT_EN_PRECNT;
+        c.w8(REG_PRECNT_CTRL, pre_txcnt as u8);
+        c.w8(REG_PRECNT_CTRL + 1, (pre_txcnt >> 8) as u8);
+        c.w32(REG_PROT_MODE_CTRL, WLAN_RTS_LEN_TH | (WLAN_RTS_TX_TIME_TH << 8) | (WLAN_MAX_AGG_PKT_LIMIT << 16) | (WLAN_RTS_MAX_AGG_PKT_LIMIT << 24));
+        c.w16(REG_BAR_MODE_CTRL + 2, (WLAN_BAR_RETRY_LIMIT | (WLAN_RA_TRY_RATE_AGG_LIMIT << 8)) as u16);
+        c.w8(REG_FAST_EDCA_VOVI_SETTING, FAST_EDCA_VO_TH as u8);
+        c.w8(REG_FAST_EDCA_VOVI_SETTING + 2, FAST_EDCA_VI_TH as u8);
+        c.w8(REG_FAST_EDCA_BEBK_SETTING, FAST_EDCA_BE_TH as u8);
+        c.w8(REG_FAST_EDCA_BEBK_SETTING + 2, FAST_EDCA_BK_TH as u8);
+        c.set8(REG_INIRTS_RATE_SEL, 1 << 5);
+        // EDCA.
+        c.clr8(REG_TIMER0_SRC_SEL, BIT_TSFT_SEL_TIMER0);
+        c.w16(REG_TXPAUSE, 0);
+        c.w8(REG_SLOT, WLAN_SLOT_TIME as u8);
+        c.w8(REG_PIFS, WLAN_PIFS_TIME as u8);
+        c.w32(REG_SIFS, WLAN_SIFS_CFG);
+        c.w16(REG_EDCA_VO_PARAM + 2, WLAN_VO_TXOP_LIMIT as u16);
+        c.w16(REG_EDCA_VI_PARAM + 2, WLAN_VI_TXOP_LIMIT as u16);
+        c.w32(REG_RD_NAV_NXT, WLAN_NAV_CFG);
+        c.w16(REG_RXTSF_OFFSET_CCK, WLAN_RX_TSF_CFG as u16);
+        // Beacon control: TSF and the related functions.
+        c.set8(REG_BCN_CTRL, BIT_EN_BCN_FUNCTION);
+        c.w32(REG_TBTT_PROHIBIT, WLAN_TBTT_TIME);
+        c.w8(REG_DRVERLYINT, WLAN_DRV_EARLY_INT as u8);
+        c.w8(REG_BCNDMATIM, WLAN_BCN_DMA_TIME as u8);
+        c.clr8(REG_TX_PTCL_CTRL + 1, BIT_SIFS_BK_EN >> 8);
+        // WMAC.
+        c.w32(REG_RXFLTMAP0, WLAN_RX_FILTER0);
+        c.w16(REG_RXFLTMAP2, WLAN_RX_FILTER2 as u16);
+        c.w32(REG_RCR, WLAN_RCR_CFG);
+        c.w8(REG_RX_PKT_LIMIT, WLAN_RXPKT_MAX_SZ_512 as u8);
+        c.w8(REG_TCR + 2, WLAN_TX_FUNC_CFG2 as u8);
+        c.w8(REG_TCR + 1, WLAN_TX_FUNC_CFG1 as u8);
+        c.w8(REG_ACKTO_CCK, 0x40);
+        c.set8(REG_WMAC_TRXPTCL_CTL_H, 1 << 1);
+        c.set8(REG_SND_PTCL_CTRL, BIT_DIS_CHK_VHTSIGB_CRC);
+        c.w32(REG_WMAC_OPTION_FUNCTION + 8, WLAN_MAC_OPT_FUNC2);
+        c.w8(REG_WMAC_OPTION_FUNCTION + 4, WLAN_MAC_OPT_NORM_FUNC1 as u8);
+    }
+
+    /// `rtw_sec_enable_sec_engine` (default key search).
+    fn enable_sec_engine(&self) {
+        self.chip.set16(REG_CR, RTW_SEC_ENGINE_EN);
+        let config = self.chip.r16(RTW_SEC_CONFIG) as u32 | RTW_SEC_TX_DEC_EN | RTW_SEC_RX_DEC_EN | RTW_SEC_TX_UNI_USE_DK | RTW_SEC_RX_UNI_USE_DK | RTW_SEC_TX_BC_USE_DK | RTW_SEC_RX_BC_USE_DK;
+        self.chip.w16(RTW_SEC_CONFIG, config as u16);
+    }
+
+    // ---- The PHY. ----
+
+    fn write_rf(&self, addr: u32, mask: u32, data: u32) {
+        self.chip.write_rf_sipi(RF_BASE_A, RF_SIPI_A, addr, mask, data);
+    }
+
+    fn read_rf(&self, addr: u32, mask: u32) -> u32 {
+        self.chip.read_rf(RF_BASE_A, addr, mask)
+    }
+
+    /// Linux's `rtw_parse_tbl_phy_cond` over one table.
+    fn load_table(&self, table: &[u32], apply: impl Fn(&Self, u32, u32)) {
+        let cut = if self.chip.cut != 0 { self.chip.cut as u32 } else { 15 };
+        let pkg = if self.efuse.pkg_type != 0 { self.efuse.pkg_type as u32 } else { 15 };
+        let rfe = self.efuse.rfe_option as u32;
+        let (mut matched, mut skipped) = (true, false);
+        let mut condition = 0u32;
+        for pair in table.chunks_exact(2) {
+            let (word, data) = (pair[0], pair[1]);
+            let (pos, neg, branch) = (word >> 31 & 1, word >> 30 & 1, (word >> 28) & 3);
+            if pos != 0 {
+                match branch {
+                    3 => {
+                        matched = true;
+                        skipped = false;
+                    }
+                    2 => matched = !skipped,
+                    _ => condition = word,
+                }
+            } else if neg != 0 {
+                if !skipped {
+                    let (c_rfe, c_intf, c_pkg, c_cut) = (condition & 0xff, (condition >> 8) & 0xf, (condition >> 12) & 0xf, (condition >> 24) & 0xf);
+                    let positive = (c_cut == 0 || c_cut == cut) && (c_pkg == 0 || c_pkg == pkg) && (c_intf == 0 || c_intf == INTF_PCIE) && c_rfe == rfe;
+                    matched = positive;
+                    skipped = positive;
+                } else {
+                    matched = false;
+                }
+            } else if matched {
+                apply(self, word, data);
+            }
+        }
+    }
+
+    /// `rtw8821c_phy_set_param`.
+    fn phy_set_param(&mut self) {
+        let c = &self.chip;
+        let mut value = c.r8(REG_SYS_FUNC_EN) | BIT_FEN_PCIEA as u8;
+        c.w8(REG_SYS_FUNC_EN, value);
+        let reset = (BIT_FEN_BB_RSTB | BIT_FEN_BB_GLB_RST) as u8;
+        value |= reset;
+        c.w8(REG_SYS_FUNC_EN, value);
+        value &= !reset;
+        c.w8(REG_SYS_FUNC_EN, value);
+        value |= reset;
+        c.w8(REG_SYS_FUNC_EN, value);
+        c.w8(REG_RF_CTRL, (BIT_RF_EN | BIT_RF_RSTB | BIT_RF_SDM_RSTB) as u8);
+        crate::delay_us(10);
+        c.w8(REG_WLRF1 + 3, (BIT_RF_EN | BIT_RF_RSTB | BIT_RF_SDM_RSTB) as u8);
+        crate::delay_us(10);
+        c.clr32(REG_RXPSEL, BIT_RX_PSEL_RST);
+        // `rtw_phy_load_tables`.
+        self.load_table(&tables::MAC_8821C, |hw, addr, data| hw.chip.w8(addr, data as u8));
+        self.load_table(&tables::BB_8821C, |hw, addr, data| match addr {
+            0xfe => crate::delay_ms(50),
+            0xfd => crate::delay_ms(5),
+            0xfc => crate::delay_ms(1),
+            0xfb => crate::delay_us(50),
+            0xfa => crate::delay_us(5),
+            0xf9 => crate::delay_us(1),
+            _ => hw.chip.w32(addr, data),
+        });
+        self.load_table(&tables::AGC_8821C, |hw, addr, data| hw.chip.w32(addr, data));
+        if RFE_AGC_BTG.contains(&self.efuse.rfe_option) {
+            self.load_table(&tables::AGC_BTG_TYPE2_8821C, |hw, addr, data| hw.chip.w32(addr, data));
+        }
+        self.load_table(&tables::RF_A_8821C, |hw, addr, data| match addr {
+            0xffe => crate::delay_ms(50),
+            0xfe => crate::delay_us(100),
+            _ => {
+                hw.write_rf(addr, RFREG_MASK, data);
+                crate::delay_us(1);
+            }
+        });
+        let c = &self.chip;
+        let crystal = (self.efuse.crystal_cap & 0x3f) as u32;
+        c.w32_mask(REG_AFE_XTAL_CTRL, 0x7e00_0000, crystal);
+        c.w32_mask(REG_AFE_PLL_CTRL, 0x7e, crystal);
+        c.w32_mask(REG_CCK0_FAREPORT, (1 << 18) | (1 << 22), 0);
+        c.set32(REG_RXPSEL, BIT_RX_PSEL_RST);
+        self.ch_param = [c.r32(REG_TXSF2), c.r32(REG_TXSF6), c.r32(REG_TXFILTER)];
+        let _ = c.r32_mask(DIG_ADDR, 0x7f);
+        self.pwrtrack_init();
+        // `rtw8821c_phy_bf_init` (`rtw_bf_phy_init`).
+        let c = &self.chip;
+        let mut mu = c.r32(REG_MU_TX_CTL);
+        mu |= BIT_MU_P1_WAIT_STATE_EN;
+        mu = (mu & !BIT_MASK_R_MU_RL) | ((0xa << BIT_SHIFT_R_MU_RL) & BIT_MASK_R_MU_RL);
+        mu &= !(BIT_EN_MU_MIMO | BIT_MASK_R_MU_TABLE_VALID);
+        c.w32(REG_MU_TX_CTL, mu);
+        c.w8(REG_WMAC_MU_BF_OPTION, ((3 << BIT_SHIFT_WMAC_TXMU_ACKPOLICY) | BIT_WMAC_TXMU_ACKPOLICY_EN) as u8);
+        c.w16(REG_WMAC_MU_BF_CTL, 0);
+        c.set32(REG_TXBF_CTRL, BIT_USE_NDPA_PARAMETER);
+        c.w8(REG_NDPA_OPT_CTRL, 0x10);
+        c.w32_mask(REG_BBPSF_CTRL, BIT_MASK_CSI_RATE, DESC_RATE6M);
+        c.w32(0x1c94, 0xafff_afff);
+    }
+
+    /// `rtw8821c_pwrtrack_init`: the OFDM swing in use.
+    fn pwrtrack_init(&mut self) {
+        let swing = self.chip.r32_mask(REG_TXSCALE_A, 0xffe0_0000);
+        self.default_ofdm_index = TXSCALE.iter().position(|&value| value == swing).unwrap_or(24) as u8;
+    }
+
+    // ---- The channel. ----
+
+    /// Linux's `rtw_set_channel` at 20 MHz: `rtw8821c_set_channel`, the
+    /// coexistence's band, the TX power.
+    pub(crate) fn set_channel(&mut self, channel: u8, scanning: bool) {
+        self.channel = channel;
+        self.set_channel_bb(channel);
+        // BB swing (`rtw8821c_set_channel_bb_swing`).
+        let swing = if channel <= 14 { self.efuse.tx_bb_swing_2g } else { self.efuse.tx_bb_swing_5g };
+        let swing = if swing > 9 { 0 } else { swing };
+        self.chip.w32_mask(REG_TXSCALE_A, 0xffe0_0000, [0x200, 0x16a, 0x101, 0x0b6][(swing / 3) as usize]);
+        self.pwrtrack_init();
+        self.set_channel_mac(channel);
+        self.set_channel_rf(channel);
+        // RX DFIR for 20 MHz.
+        let c = &self.chip;
+        c.w32_mask(REG_ACBB0, (1 << 29) | (1 << 28), 0x2);
+        c.w32_mask(REG_ACBBRXFIR, (1 << 29) | (1 << 28), 0x2);
+        c.w32_mask(REG_TXDFIR, 1 << 31, 0x1);
+        c.w32_mask(REG_CHFIR, 1 << 31, 0x0);
+        if channel > 14 {
+            self.coex_band_5g();
+        } else {
+            self.coex_band_2g();
+        }
+        self.set_tx_power(channel);
+        if !scanning {
+            self.need_rfk = true;
+        }
+    }
+
+    fn set_channel_bb(&self, channel: u8) {
+        let c = &self.chip;
+        if channel <= 14 {
+            c.w32_mask(REG_RXPSEL, 1 << 28, 0x1);
+            c.w32_mask(REG_CCK_CHECK, 1 << 7, 0x0);
+            c.w32_mask(REG_ENTXCCK, 1 << 18, 0x0);
+            c.w32_mask(REG_RXCCAMSK, 0x0000_fc00, 15);
+            c.w32_mask(REG_TXSCALE_A, 0xf00, 0x0);
+            c.w32_mask(REG_CLKTRK, 0x1ffe_0000, 0x96a);
+            if channel == 14 {
+                c.w32(REG_TXSF2, 0x0000_b81c);
+                c.w32_mask(REG_TXSF6, MASKLWORD, 0x0000);
+                c.w32(REG_TXFILTER, 0x0000_3667);
+            } else {
+                c.w32(REG_TXSF2, self.ch_param[0]);
+                c.w32_mask(REG_TXSF6, MASKLWORD, self.ch_param[1] & MASKLWORD);
+                c.w32(REG_TXFILTER, self.ch_param[2]);
+            }
+        } else {
+            c.w32_mask(REG_ENTXCCK, 1 << 18, 0x1);
+            c.w32_mask(REG_CCK_CHECK, 1 << 7, 0x1);
+            c.w32_mask(REG_RXPSEL, 1 << 28, 0x0);
+            c.w32_mask(REG_RXCCAMSK, 0x0000_fc00, 15);
+            let scale = match channel {
+                36..=64 => 0x1,
+                100..=144 => 0x2,
+                _ => 0x3,
+            };
+            c.w32_mask(REG_TXSCALE_A, 0xf00, scale);
+            let track = match channel {
+                36..=48 => 0x494,
+                52..=64 => 0x453,
+                100..=116 => 0x452,
+                _ => 0x412,
+            };
+            c.w32_mask(REG_CLKTRK, 0x1ffe_0000, track);
+        }
+        // 20 MHz.
+        let value = (c.r32(REG_ADCCLK) & 0xffcf_fc00) | 0x1001_0000;
+        c.w32(REG_ADCCLK, value);
+        c.w32_mask(REG_ADC160, 1 << 30, 0x1);
+    }
+
+    /// `rtw_set_channel_mac` at 20 MHz.
+    fn set_channel_mac(&self, channel: u8) {
+        let c = &self.chip;
+        c.w8(REG_DATA_SC, 0);
+        c.clr32(REG_WMAC_TRXPTCL_CTL, BIT_RFMOD);
+        let value = (c.r32(REG_AFE_CTRL1) & !BIT_MAC_CLK_SEL) | (MAC_CLK_HW_DEF_80M << BIT_SHIFT_MAC_CLK_SEL);
+        c.w32(REG_AFE_CTRL1, value);
+        c.w8(REG_USTIME_TSF, MAC_CLK_SPEED as u8);
+        c.w8(REG_USTIME_EDCA, MAC_CLK_SPEED as u8);
+        let mut cck = c.r8(REG_CCK_CHECK) & !(BIT_CHECK_CCK_EN as u8);
+        if channel > 14 {
+            cck |= BIT_CHECK_CCK_EN as u8;
+        }
+        c.w8(REG_CCK_CHECK, cck);
+    }
+
+    /// `rtw8821c_set_channel_rf`.
+    fn set_channel_rf(&self, channel: u8) {
+        let mut reg18 = self.read_rf(0x18, RFREG_MASK);
+        reg18 &= !(RF18_BAND_MASK | RF18_CHANNEL_MASK | RF18_RFSI_MASK | RF18_BW_MASK);
+        reg18 |= if channel <= 14 { RF18_BAND_2G } else { RF18_BAND_5G };
+        reg18 |= channel as u32 & RF18_CHANNEL_MASK;
+        if (100..=140).contains(&channel) {
+            reg18 |= RF18_RFSI_GE;
+        } else if channel > 140 {
+            reg18 |= RF18_RFSI_GT;
+        }
+        reg18 |= RF18_BW_20M;
+        if channel <= 14 {
+            self.switch_rf_set(if self.efuse.rfe_btg { RfSet::Btg } else { RfSet::Wlg });
+            self.write_rf(RF_LUTDBG, 1 << 6, 0x1);
+            self.write_rf(0x64, 0xf, 0xf);
+        } else {
+            self.switch_rf_set(RfSet::Wla);
+            self.write_rf(RF_LUTDBG, 1 << 6, 0x0);
+        }
+        self.write_rf(0x18, RFREG_MASK, reg18);
+        self.write_rf(RF_XTALX2, 1 << 19, 0);
+        self.write_rf(RF_XTALX2, 1 << 19, 1);
+    }
+
+    /// `rtw8821c_switch_rf_set`.
+    fn switch_rf_set(&self, set: RfSet) {
+        let c = &self.chip;
+        c.set32(REG_DMEM_CTRL, BIT_WL_RST);
+        c.set32(REG_SYS_CTRL, BIT_FEN_EN);
+        let mut reg = c.r32(REG_RFECTL);
+        match set {
+            RfSet::Btg => {
+                reg |= B_BTG_SWITCH;
+                reg &= !(B_CTRL_SWITCH | B_WL_SWITCH | B_WLG_SWITCH | B_WLA_SWITCH);
+                c.w32_mask(REG_ENRXCCA, MASKBYTE2, BTG_CCA);
+                c.w32_mask(REG_ENTXCCK, MASKLWORD, BTG_LNA);
+            }
+            RfSet::Wlg => {
+                reg |= B_WL_SWITCH | B_WLG_SWITCH;
+                reg &= !(B_BTG_SWITCH | B_CTRL_SWITCH | B_WLA_SWITCH);
+                c.w32_mask(REG_ENRXCCA, MASKBYTE2, WLG_CCA);
+                c.w32_mask(REG_ENTXCCK, MASKLWORD, WLG_LNA);
+            }
+            RfSet::Wla => {
+                reg |= B_WL_SWITCH | B_WLA_SWITCH;
+                reg &= !(B_BTG_SWITCH | B_CTRL_SWITCH | B_WLG_SWITCH);
+            }
+        }
+        c.w32(REG_RFECTL, reg);
+    }
+
+    /// The calibration before joining (`rtw8821c_do_iqk` through
+    /// `rtw_chip_prepare_tx`).
+    pub(crate) fn prepare_tx(&mut self, associated: bool) {
+        if !self.need_rfk {
+            return;
+        }
+        self.need_rfk = false;
+        self.h2c_packet(H2C_PKT_IQK as u8, &[(associated as u8) << 1]);
+        for _ in 0..300 {
+            if self.read_rf(RF_DTXLOK, RFREG_MASK) == 0xabcde {
+                break;
+            }
+            crate::sleep_ms(20);
+        }
+        self.write_rf(RF_DTXLOK, RFREG_MASK, 0);
+    }
+
+    // ---- TX power. ----
+
+    /// Linux's `rtw_phy_get_tx_power_index` for path A at 20 MHz with the
+    /// worldwide limits, and `rtw8821c_set_tx_power_index`.
+    fn set_tx_power(&self, channel: u8) {
+        let sections: &[(usize, core::ops::Range<u8>)] = &[(0, 0x00..0x04), (1, 0x04..0x0c), (2, 0x0c..0x14), (4, 0x2c..0x36)];
+        let mut word = 0u32;
+        for (section, rates) in sections {
+            if channel > 14 && *section == 0 {
+                continue;
+            }
+            for rate in rates.clone() {
+                let index = self.power_index(channel, rate, *section);
+                let shift = rate & 0x3;
+                word |= (index as u32) << (shift * 8);
+                if shift == 0x3 || rate == 0x35 {
+                    self.chip.w32(0x1d00 + (rate & 0xfc) as u32, word);
+                    word = 0;
+                }
+            }
+        }
+    }
+
+    fn power_index(&self, channel: u8, rate: u8, section: usize) -> u8 {
+        let diff = |byte: u8, high: bool| -> i32 {
+            let nibble = if high { byte >> 4 } else { byte & 0xf };
+            ((nibble << 4) as i8 >> 4) as i32
+        };
+        let t = &self.efuse.txpwr;
+        let group = channel_group(channel, rate);
+        let mcs = (0x0c..0x2c).contains(&rate) || (0x2c..0x54).contains(&rate);
+        let (base, offset, limit) = if channel <= 14 {
+            // `struct rtw_2g_txpwr_idx`: cck_base[6], bw40_base[5], ht_1s_diff.
+            let mut power = if rate <= 0x03 { t[group.min(5)] as i32 } else { t[6 + group.min(4)] as i32 };
+            if (0x04..=0x0b).contains(&rate) {
+                power += diff(t[11], false);
+            }
+            if mcs {
+                power += diff(t[11], true);
+            }
+            let row = &tables::TXPWR_LIMIT_2G_8821C[section];
+            (power, tables::TXPWR_OFFSET_2G_8821C[rate as usize] as i32, row[(channel as usize - 1).min(row.len() - 1)] as i32)
+        } else {
+            // `struct rtw_5g_txpwr_idx` at 18: bw40_base[14], ht_1s_diff.
+            let mut power = t[18 + group.min(13)] as i32;
+            power += if mcs { diff(t[18 + 14], true) } else { diff(t[18 + 14], false) };
+            let row = &tables::TXPWR_LIMIT_5G_8821C[section];
+            let index = CH_5G.iter().position(|&known| known == channel).unwrap_or(0);
+            (power, tables::TXPWR_OFFSET_5G_8821C[rate as usize] as i32, row[index] as i32)
+        };
+        (base + offset.min(limit)).clamp(0, MAX_POWER_INDEX) as u8
+    }
+
+    // ---- BT coexistence (`coex.c`, the shared antenna of the RTL8821CE). ----
+
+    fn read_scbd(&self) -> u16 {
+        self.chip.r16(REG_WIFI_BT_INFO) & !(BIT_BT_INT_EN as u16)
+    }
+
+    fn write_scbd(&mut self, bits: u16, set: bool) {
+        let mut value = 0x2 | self.score_board;
+        if bits & COEX_SCBD_FIX2M as u16 != 0 {
+            if set {
+                value &= !(COEX_SCBD_FIX2M as u16);
+            } else {
+                value |= COEX_SCBD_FIX2M as u16;
+            }
+        } else if set {
+            value |= bits;
+        } else {
+            value &= !bits;
+        }
+        if value != self.score_board {
+            self.score_board = value;
+            self.chip.w16(REG_WIFI_BT_INFO, value | BIT_BT_INT_EN as u16);
+        }
+    }
+
+    fn gnt(&self, bt: Option<u32>, wl: Option<u32>) {
+        if let Some(state) = bt {
+            self.chip.ltecoex_write_mask(LTE_COEX_CTRL as u16, 0xc000, state);
+            self.chip.ltecoex_write_mask(LTE_COEX_CTRL as u16, 0x0c00, state);
+        }
+        if let Some(state) = wl {
+            self.chip.ltecoex_write_mask(LTE_COEX_CTRL as u16, 0x3000, state);
+            self.chip.ltecoex_write_mask(LTE_COEX_CTRL as u16, 0x0300, state);
+        }
+    }
+
+    fn ctrl_owner(&self, wifi: bool) {
+        if wifi {
+            self.chip.set8(REG_SYS_SDIO_CTRL + 3, BIT_LTE_MUX_CTRL_PATH >> 24);
+        } else {
+            self.chip.clr8(REG_SYS_SDIO_CTRL + 3, BIT_LTE_MUX_CTRL_PATH >> 24);
+        }
+    }
+
+    /// `rtw8821c_coex_cfg_rfe_type`: polarity and the BTG switch.
+    fn coex_rfe(&self) -> (bool, bool, bool) {
+        let rfe = self.efuse.rfe_option;
+        let wlg_at_btg = matches!(rfe, 2 | 10 | 7 | 15 | 4 | 12);
+        let polarity = matches!(rfe, 3 | 11 | 4 | 12);
+        let exists = !matches!(rfe, 5 | 13 | 6 | 14);
+        (wlg_at_btg, polarity, exists)
+    }
+
+    /// `rtw8821c_coex_cfg_ant_switch`.
+    fn ant_switch(&self, ctrl: SwitchCtrl, position: Switch) {
+        let (wlg_at_btg, polarity, exists) = self.coex_rfe();
+        if !exists {
+            return;
+        }
+        let (mut ctrl, mut position) = (ctrl, position);
+        if wlg_at_btg {
+            ctrl = SwitchCtrl::Bbsw;
+            position = if polarity { Switch::Wla } else { Switch::WlgBt };
+        }
+        let c = &self.chip;
+        c.clr32(REG_LED_CFG, BIT_DPDT_SEL_EN);
+        c.set32(REG_LED_CFG, BIT_DPDT_WL_SEL);
+        let value = match ctrl {
+            SwitchCtrl::Bbsw => {
+                c.w8_mask(REG_RFE_CTRL8, BIT_MASK_RFE_SEL89, DPDT_CTRL_PIN);
+                match position {
+                    // WLG and BT together: the shared position, where there is one.
+                    Switch::WlgBt if !matches!(self.efuse.rfe_option, 4 | 2) => 0x3,
+                    Switch::WlgBt | Switch::Wlg => if polarity { 0x1 } else { 0x2 },
+                    Switch::Wla | Switch::Bt => if polarity { 0x2 } else { 0x1 },
+                }
+            }
+            SwitchCtrl::Pta => {
+                c.w8_mask(REG_RFE_CTRL8, BIT_MASK_RFE_SEL89, PTA_CTRL_PIN);
+                if polarity { 0x1 } else { 0x2 }
+            }
+        };
+        c.w32_mask(REG_RFE_CTRL8, BIT_MASK_R_RFE_SEL_15, value);
+        c.set8(REG_CTRL_TYPE, BIT_CTRL_TYPE1);
+        c.set8(REG_CTRL_TYPE, BIT_CTRL_TYPE2);
+    }
+
+    fn coex_table(&self, case: usize) {
+        let (bt, wl) = COEX_TABLE_SANT[case.min(COEX_TABLE_SANT.len() - 1)];
+        self.chip.w32(REG_BT_COEX_TABLE0, bt);
+        self.chip.w32(REG_BT_COEX_TABLE1, wl);
+        self.chip.w32(REG_BT_COEX_BRK_TABLE, 0xf0ff_ffff);
+    }
+
+    /// TDMA off (`tdma_sant_8821c[0]`).
+    fn coex_tdma_off(&mut self) {
+        let command = [H2C_CMD_COEX_TDMA_TYPE as u8, 0, 0, 0, 0, 0, 0, 0];
+        self.h2c(&command);
+    }
+
+    /// `rtw_coex_power_on_setting`.
+    fn coex_power_on_setting(&mut self) {
+        self.chip.set8(REG_SYS_FUNC_EN, BIT_FEN_BB_GLB_RST | BIT_FEN_BB_RSTB);
+        self.bt_disabled = self.read_scbd() & COEX_SCBD_ONOFF as u16 == 0;
+        // The antenna to BT at power-on.
+        self.ctrl_owner(self.bt_disabled);
+        self.ant_switch(SwitchCtrl::Bbsw, Switch::Bt);
+        self.coex_table(1);
+        self.chip.w8(0xff1a, 0x0);
+        // `rtw8821c_coex_cfg_gnt_debug`.
+        let c = &self.chip;
+        c.clr32(REG_PAD_CTRL1, BIT_BTGP_SPI_EN);
+        c.clr32(REG_PAD_CTRL1, BIT_BTGP_JTAG_EN);
+        c.clr32(REG_GPIO_MUXCFG, BIT_FSPI_EN);
+        c.clr32(REG_PAD_CTRL1, BIT_LED1DIS);
+        c.clr32(REG_SYS_SDIO_CTRL, BIT_SDIO_INT);
+        c.clr32(REG_SYS_SDIO_CTRL, BIT_DBG_GNT_WL_BT);
+    }
+
+    /// `__rtw_coex_init_hw_config`.
+    fn coex_init_hw_config(&mut self, wifi_only: bool) {
+        self.score_board = 0;
+        self.bt_disabled = self.read_scbd() & COEX_SCBD_ONOFF as u16 == 0;
+        // The 5 ms slot extension off (`rtw_coex_wl_slot_extend`).
+        let command = [H2C_CMD_BT_WIFI_CONTROL as u8, COEX_H2C69_WL_LEAKAP as u8, PARA1_H2C69_DIS_5MS as u8, 0, 0, 0, 0, 0];
+        self.h2c(&command);
+        self.chip.set8(REG_BCN_CTRL, BIT_EN_BCN_FUNCTION);
+        // `rtw8821c_coex_cfg_init`.
+        let c = &self.chip;
+        c.set8(REG_BCN_CTRL, BIT_EN_BCN_FUNCTION);
+        c.w8_mask(REG_BT_TDMA_TIME, BIT_MASK_SAMPLE_RATE, 0x5);
+        c.w8(REG_BT_STAT_CTRL, BT_CNT_ENABLE as u8);
+        c.set32(REG_GPIO_MUXCFG, BIT_BT_PTA_EN);
+        c.set32(REG_GPIO_MUXCFG, BIT_PO_BT_PTA_PINS);
+        c.set8(REG_QUEUE_CTRL, BIT_PTA_WL_TX_EN);
+        c.clr8(REG_QUEUE_CTRL, BIT_PTA_EDCCA_EN);
+        c.set16(REG_BT_COEX_V2, BIT_GNT_BT_POLARITY);
+        c.w8_mask(REG_BT_COEX_TABLE_H + 3, BIT_BCN_QUEUE, BCN_PRI_EN);
+        // TX responses, beacons and the beacon queue at high priority.
+        for bit in [COEX_WLPRI_TX_RSP, COEX_WLPRI_TX_BEACON, COEX_WLPRI_TX_BEACONQ] {
+            c.w8_mask(REG_BT_COEX_TABLE_H + bit / 8, 1 << (bit % 8), 1);
+        }
+        if wifi_only || self.bt_disabled {
+            self.gnt(Some(COEX_GNT_SET_SW_LOW), Some(COEX_GNT_SET_SW_HIGH));
+            self.ctrl_owner(true);
+            self.ant_switch(SwitchCtrl::Bbsw, Switch::Wlg);
+        } else {
+            self.gnt(Some(COEX_GNT_SET_SW_HIGH), Some(COEX_GNT_SET_SW_LOW));
+            self.ctrl_owner(true);
+            self.ant_switch(SwitchCtrl::Bbsw, Switch::Bt);
+        }
+        self.write_scbd((COEX_SCBD_ACTIVE | COEX_SCBD_ONOFF) as u16, true);
+        self.coex_table(1);
+        self.coex_tdma_off();
+    }
+
+    /// `rtw_coex_action_wl_under5g`.
+    fn coex_band_5g(&mut self) {
+        self.gnt(Some(COEX_GNT_SET_HW_PTA), Some(COEX_GNT_SET_SW_HIGH));
+        self.ctrl_owner(true);
+        self.ant_switch(SwitchCtrl::Bbsw, Switch::Wla);
+        self.write_scbd(COEX_SCBD_FIX2M as u16, false);
+        self.coex_table(0);
+        self.coex_tdma_off();
+    }
+
+    /// `rtw_coex_action_wl_only` (2.4 GHz, the PTA shares the antenna).
+    fn coex_band_2g(&mut self) {
+        self.gnt(Some(COEX_GNT_SET_HW_PTA), Some(COEX_GNT_SET_HW_PTA));
+        self.ctrl_owner(true);
+        self.ant_switch(SwitchCtrl::Pta, Switch::Wlg);
+        self.coex_table(2);
+        self.coex_tdma_off();
+    }
+
+    // ---- The interface's port (`rtw_vif_port_config`, port 0). ----
+
+    pub(crate) fn port_address(&self, address: &[u8; 6]) {
+        for (index, byte) in address.iter().enumerate() {
+            self.chip.w8(0x0610 + index as u32, *byte);
+        }
+    }
+
+    pub(crate) fn port_bssid(&self, bssid: &[u8; 6]) {
+        for (index, byte) in bssid.iter().enumerate() {
+            self.chip.w8(0x0618 + index as u32, *byte);
+        }
+    }
+
+    pub(crate) fn port_net_type(&self, linked: bool) {
+        let net = if linked { RTW_NET_MGD_LINKED } else { RTW_NET_NO_LINK };
+        self.chip.w32_mask(0x0100, 0x30000, net);
+    }
+
+    pub(crate) fn port_aid(&self, aid: u16) {
+        self.chip.w32_mask(0x06a8, 0x7ff, aid as u32);
+    }
+
+    pub(crate) fn port_bcn_ctrl(&self) {
+        self.chip.w8_mask(0x0550, 0xff, BIT_EN_BCN_FUNCTION);
+    }
+
+    pub(crate) fn set_rcr(&mut self, scanning: bool) {
+        if scanning {
+            self.rcr &= !(BIT_CBSSID_BCN | BIT_CBSSID_DATA);
+        } else {
+            self.rcr |= BIT_CBSSID_BCN;
+        }
+        self.chip.w32(REG_RCR, self.rcr);
+    }
+
+    /// The EDCA of an access category (`__rtw_conf_tx`).
+    pub(crate) fn conf_tx(&self, register: u32, cw_min: u16, cw_max: u16, aifsn: u8, txop: u16, short_slot: bool) {
+        let ecw = |cw: u16| (cw as u32 + 1).trailing_zeros().min(15);
+        let slot = if short_slot { 9 } else { 20 };
+        let sifs = if self.channel > 14 { 16 } else { 10 };
+        let aifs = aifsn as u32 * slot + sifs;
+        let c = &self.chip;
+        c.w32_mask(register, BIT_MASK_TXOP_LMT, txop as u32);
+        c.w32_mask(register, BIT_MASK_CWMAX, ecw(cw_max));
+        c.w32_mask(register, BIT_MASK_CWMIN, ecw(cw_min));
+        c.w32_mask(register, BIT_MASK_AIFS, aifs);
+    }
+
+    // ---- Keys (`rtw_sec_write_cam`, `rtw_sec_clear_cam`). ----
+
+    pub(crate) fn write_cam(&self, entry: u8, key_index: u8, group: bool, address: &[u8; 6], key: &[u8]) {
+        let addr = (entry as u32) << RTW_SEC_CAM_ENTRY_SHIFT;
+        let command = RTW_SEC_CMD_WRITE_ENABLE | RTW_SEC_CMD_POLLING;
+        for word in (0..8u32).rev() {
+            let content = match word {
+                0 => (key_index as u32 & 0x3) | ((RTW_CAM_AES & 0x7) << 2) | ((group as u32) << 6) | (1 << 15) | ((address[0] as u32) << 16) | ((address[1] as u32) << 24),
+                1 => u32::from_le_bytes([address[2], address[3], address[4], address[5]]),
+                6 | 7 => 0,
+                _ => {
+                    let at = ((word - 2) << 2) as usize;
+                    u32::from_le_bytes([key[at], key[at + 1], key[at + 2], key[at + 3]])
+                }
+            };
+            self.chip.w32(RTW_SEC_WRITE_REG, content);
+            self.chip.w32(RTW_SEC_CMD_REG, command | (addr + word));
+        }
+    }
+
+    pub(crate) fn clear_cam(&self, entry: u8) {
+        let addr = (entry as u32) << RTW_SEC_CAM_ENTRY_SHIFT;
+        self.chip.w32(RTW_SEC_WRITE_REG, 0);
+        self.chip.w32(RTW_SEC_CMD_REG, RTW_SEC_CMD_WRITE_ENABLE | RTW_SEC_CMD_POLLING | addr);
+    }
+
+    /// PCIe PHY parameters and link settings (`rtw_pci_phy_cfg`).
+    pub(crate) fn pci_phy_cfg(&self) {
+        let cut = 1u16 << self.chip.cut;
+        for (paras, g1) in [(&tables::PCIE_GEN1_8821C[..], true), (&tables::PCIE_GEN2_8821C[..], false)] {
+            for para in paras {
+                if para.cut_mask & cut == 0 {
+                    continue;
+                }
+                if para.offset == 0xffff {
+                    break;
+                }
+                if para.ip_sel == RTW_IP_SEL_PHY {
+                    self.chip.mdio_write(para.offset as u8, para.value, g1);
+                } else {
+                    self.chip.dbi_write8(para.offset, para.value as u8);
+                }
+            }
+        }
+    }
+}
+
+/// The 5 GHz channels of Linux's power limit tables (`rtw_channel_idx_5g`).
+const CH_5G: [u8; 49] = [
+    36, 38, 40, 42, 44, 46, 48, 52, 54, 56, 58, 60, 62, 64, 100, 102, 104, 106, 108, 110, 112, 116, 118, 120, 122, 124, 126, 128, 132, 134, 136, 138, 140, 142, 144, 149,
+    151, 153, 155, 157, 159, 161, 165, 167, 169, 171, 173, 175, 177,
+];
+
+/// Linux's `rtw_get_channel_group`.
+fn channel_group(channel: u8, rate: u8) -> usize {
+    match channel {
+        1 | 2 | 36 | 38 | 40 | 42 => 0,
+        3..=5 | 44 | 46 | 48 | 50 => 1,
+        6..=8 | 52 | 54 | 56 | 58 => 2,
+        9..=11 | 60 | 62 | 64 => 3,
+        12 | 13 | 100 | 102 | 104 | 106 => 4,
+        14 => {
+            if rate <= 0x03 { 5 } else { 4 }
+        }
+        108 | 110 | 112 | 114 => 5,
+        116 | 118 | 120 | 122 => 6,
+        124 | 126 | 128 | 130 => 7,
+        132 | 134 | 136 | 138 => 8,
+        140 | 142 | 144 => 9,
+        149 | 151 | 153 | 155 => 10,
+        157 | 159 | 161 => 11,
+        165 | 167 | 169 | 171 => 12,
+        _ => 13,
+    }
+}
