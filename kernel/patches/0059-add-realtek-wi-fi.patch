--- /dev/null
+++ b/kernel/comps/rtw88/src/lib.rs
@@ -0,0 +1,315 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Realtek Wi-Fi of Linux's rtw88 family: the RTL8821CE (10ec:b821,
+//! 10ec:c821), as Linux's `rtw88_8821ce` runs it.
+//!
+//! The chip ([`chip`], [`pci`]) is brought up by the host ([`hw`]): power
+//! sequences, the firmware (linux-firmware's `rtw88/rtw8821c_fw.bin`)
+//! through the reserved pages, the MAC, the PHY tables ([`tables`],
+//! generated from Linux's), the channel, the TX power, the antenna shared
+//! with Bluetooth. The station on it is [`sta`]: a software scan, the
+//! firmware's rate adaptation, keys in the security CAM.
+//!
+//! Not yet: the RTL8822CE/8822BE/8723DE (their own tables and channel
+//! code), 40/80 MHz, VHT, power save, the dynamic sensitivity (DIG) and
+//! the BT coexistence's run-time decisions beyond the band. `dmesg | grep
+//! rtw88` says how far a card gets; `rtw88.off` leaves the cards alone.
+
+#![no_std]
+#![deny(unsafe_code)]
+
+extern crate alloc;
+
+macro_rules! __log_prefix {
+    () => {
+        "rtw88: "
+    };
+}
+
+mod chip;
+mod hw;
+mod pci;
+#[allow(clippy::all)]
+mod regs;
+mod sta;
+mod tables;
+
+use alloc::{format, string::String, sync::Arc, vec::Vec};
+use core::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+use aster_pci::{
+    PCI_BUS, PciDeviceId,
+    bus::{PciDevice, PciDriver},
+    common_device::PciCommonDevice,
+};
+use aster_wlan::radio::{self, Association, Join, Key, LinkStats, Radio, ScanRequest};
+use component::{ComponentInitError, init_component};
+use ostd::{
+    bus::BusProbeError,
+    irq::IrqLine,
+    sync::{Mutex, SpinLock, WaitQueue},
+    timer::Jiffies,
+};
+
+use crate::{chip::Chip, hw::{Hw, Model}, pci::Pci, sta::Rtw88};
+
+static WAKE: WaitQueue = WaitQueue::new();
+static WOKEN: AtomicBool = AtomicBool::new(false);
+static TICKS: AtomicUsize = AtomicUsize::new(0);
+
+pub(crate) fn now_ms() -> u64 {
+    Jiffies::elapsed().as_duration().as_millis() as u64
+}
+
+fn wake() {
+    WOKEN.store(true, Ordering::Release);
+    WAKE.wake_all();
+}
+
+fn sleep() {
+    WAKE.wait_until(|| WOKEN.swap(false, Ordering::AcqRel).then_some(()));
+}
+
+/// A busy wait for the chip's handshakes (the timer's resolution is too
+/// coarse for microseconds).
+pub(crate) fn delay_us(us: u64) {
+    let start = ostd::arch::read_tsc();
+    let cycles = us * tsc_per_us();
+    while ostd::arch::read_tsc().wrapping_sub(start) < cycles {
+        core::hint::spin_loop();
+    }
+}
+
+fn tsc_per_us() -> u64 {
+    (ostd::arch::tsc_freq() / 1_000_000).max(1)
+}
+
+pub(crate) fn delay_ms(ms: u64) {
+    delay_us(ms * 1000);
+}
+
+/// Sleeps at least `ms` (the timer wakes the tasks every few ticks).
+pub(crate) fn sleep_ms(ms: u64) {
+    let deadline = now_ms() + ms;
+    while now_ms() < deadline {
+        sleep();
+    }
+}
+
+/// The timer wakes the tasks every few ticks: scans step on time and
+/// interrupts that do not arrive are made up for.
+fn tick() {
+    if TICKS.fetch_add(1, Ordering::Relaxed) % 5 == 0 {
+        wake();
+    }
+}
+
+const VENDOR_REALTEK: u16 = 0x10ec;
+
+fn model_of(vendor: u16, device: u16) -> Option<Model> {
+    match (vendor, device) {
+        (VENDOR_REALTEK, 0xb821 | 0xc821) => Some(Model::Rtl8821c),
+        _ => None,
+    }
+}
+
+#[derive(Debug)]
+struct Claimed(PciDeviceId);
+
+impl PciDevice for Claimed {
+    fn device_id(&self) -> PciDeviceId {
+        self.0
+    }
+}
+
+#[derive(Debug)]
+struct Driver {
+    found: SpinLock<Vec<PciCommonDevice>>,
+}
+
+impl PciDriver for Driver {
+    fn probe(&self, device: PciCommonDevice) -> Result<Arc<dyn PciDevice>, (BusProbeError, PciCommonDevice)> {
+        let id = *device.device_id();
+        if model_of(id.vendor_id, id.device_id).is_none() {
+            return Err((BusProbeError::DeviceNotMatch, device));
+        }
+        self.found.lock().push(device);
+        Ok(Arc::new(Claimed(id)))
+    }
+}
+
+static PENDING: SpinLock<Vec<PciCommonDevice>> = SpinLock::new(Vec::new());
+static DISABLED: AtomicBool = AtomicBool::new(false);
+aster_cmdline::define_flag_param!("rtw88.off", DISABLED);
+
+#[init_component]
+fn init() -> Result<(), ComponentInitError> {
+    if DISABLED.load(Ordering::Relaxed) {
+        return Ok(());
+    }
+    let driver = Arc::new(Driver { found: SpinLock::new(Vec::new()) });
+    PCI_BUS.lock().register_driver(driver.clone());
+    let cards = core::mem::take(&mut *driver.found.lock());
+    if cards.is_empty() {
+        return Ok(());
+    }
+    ostd::timer::register_callback_on_cpu(tick);
+    *PENDING.lock() = cards;
+    Ok(())
+}
+
+#[init_component(kthread)]
+fn start() -> Result<(), ComponentInitError> {
+    for (index, device) in core::mem::take(&mut *PENDING.lock()).into_iter().enumerate() {
+        aster_core::spawn_kernel_thread(move || run(index, device));
+    }
+    Ok(())
+}
+
+struct Card {
+    state: Mutex<Rtw88>,
+}
+
+struct RealtekRadio {
+    card: Arc<Card>,
+}
+
+impl Radio for RealtekRadio {
+    fn start(&self) -> radio::Result<()> {
+        if self.card.state.lock().dead { Err(radio::Error::Down) } else { Ok(()) }
+    }
+
+    fn stop(&self) {
+        let mut state = self.card.state.lock();
+        state.abort_scan();
+        state.leave();
+    }
+
+    fn scan(&self, request: &ScanRequest) -> radio::Result<()> {
+        self.card.state.lock().scan(request)
+    }
+
+    fn abort_scan(&self) {
+        self.card.state.lock().abort_scan();
+        wake();
+    }
+
+    fn join(&self, network: &Join) -> radio::Result<()> {
+        self.card.state.lock().join(network)
+    }
+
+    fn associated(&self, association: &Association) -> radio::Result<()> {
+        self.card.state.lock().associated(association)
+    }
+
+    fn leave(&self) {
+        self.card.state.lock().leave();
+    }
+
+    fn set_key(&self, key: &Key) -> radio::Result<()> {
+        self.card.state.lock().set_key(key)
+    }
+
+    fn remove_key(&self, index: u8, pairwise: bool) {
+        self.card.state.lock().remove_key(index, pairwise);
+    }
+
+    fn authorize(&self, _authorized: bool) {}
+
+    fn send_management(&self, frame: &[u8]) -> radio::Result<()> {
+        self.card.state.lock().transmit(frame.to_vec())
+    }
+
+    fn send(&self, ethernet: &[u8], plain: bool) -> radio::Result<()> {
+        self.card.state.lock().send(ethernet, plain)
+    }
+
+    fn link_stats(&self) -> LinkStats {
+        LinkStats { signal: self.card.state.lock().signal, tx_rate: None }
+    }
+}
+
+/// PCIe's Device Control 2: completion time-out disabled
+/// (`PCI_EXP_DEVCTL2_COMP_TMOUT_DIS`).
+fn disable_completion_timeout(location: &aster_pci::PciDeviceLocation) {
+    let mut at = location.read8(0x34) & 0xfc;
+    for _ in 0..48 {
+        if at < 0x40 {
+            return;
+        }
+        if location.read8(at as u16) == 0x10 {
+            let devctl2 = at as u16 + 0x28;
+            location.write16(devctl2, location.read16(devctl2) | 0x0010);
+            return;
+        }
+        at = location.read8(at as u16 + 1) & 0xfc;
+    }
+}
+
+/// A card's task: the chip up, the station registered, then what the chip
+/// says.
+fn run(index: usize, mut device: PciCommonDevice) {
+    let id = *device.device_id();
+    let Some(model) = model_of(id.vendor_id, id.device_id) else { return };
+    let location = *device.location();
+    let name: String = format!("rtw88 {} ({:02x}:{:02x}.{})", index, location.bus, location.device, location.function);
+    location.write16(0x04, location.read16(0x04) | 0x06);
+    // MSI, or none (the timer looks).
+    let msi = match (device.acquire_msi_capability(), IrqLine::alloc()) {
+        (Some(mut msi), Ok(mut irq)) => {
+            irq.on_active(|_| wake());
+            msi.set_interrupt_vector(irq);
+            Some(msi)
+        }
+        _ => None,
+    };
+    // Linux maps BAR 2.
+    let Some(mmio) = device.bar_manager_mut().bar_mut(2).and_then(|bar| bar.acquire().ok()) else {
+        ostd::warn!("{}: no registers in BAR 2", name);
+        return;
+    };
+    let chip = Chip::new(mmio, name.clone());
+    if !chip.present() {
+        ostd::warn!("{}: the card does not answer", name);
+        return;
+    }
+    ostd::notice!("{}: Realtek {:04x} ({:?}, cut {}, {} RF path(s))", name, id.device_id, model, chip.cut, chip.rf_paths);
+    let Some((_, firmware)) = aster_firmware::load_first([model.firmware()]) else {
+        ostd::warn!("{}: {} is not in /lib/firmware", name, model.firmware());
+        return;
+    };
+    let Some(pci) = Pci::new() else {
+        ostd::warn!("{}: no DMA memory below 4 GiB", name);
+        return;
+    };
+    let mut hw = Hw::new(chip, pci, model, firmware.to_vec());
+    if let Err(error) = hw.read_efuse() {
+        ostd::warn!("{}: {}", name, error);
+        return;
+    }
+    hw.pci_phy_cfg();
+    // Linux disables the RTL8821CE's completion time-out.
+    if model == Model::Rtl8821c {
+        disable_completion_timeout(&location);
+    }
+    if let Err(error) = hw.power_on() {
+        ostd::warn!("{}: {}", name, error);
+        return;
+    }
+    let mut state = Rtw88::new(hw);
+    state.add_interface();
+    let info = state.info();
+    ostd::notice!("{}: ready, MAC {:02x?}, RFE {}", name, state.address, state.hw.efuse.rfe_option);
+    let card = Arc::new(Card { state: Mutex::new(state) });
+    let wlan = aster_wlan::register(info, Arc::new(RealtekRadio { card: card.clone() }));
+    card.state.lock().device = Some(wlan);
+    loop {
+        sleep();
+        let mut state = card.state.lock();
+        state.poll();
+        if state.dead {
+            break;
+        }
+    }
+    drop((msi, device));
+}
diff --git a/kernel/comps/rtw88/src/pci.rs b/kernel/comps/rtw88/src/pci.rs
new file mode 100644
index 0000000..960fe49
--- /dev/null
+++ b/kernel/comps/rtw88/src/pci.rs
@@ -0,0 +1,306 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The PCIe side as Linux's rtw88 `pci.c` runs it: a ring of buffer
+//! descriptors per TX queue (each frame its TX descriptor and itself, one
+//! buffer), one RX ring, the interrupt status registers.
+
+use alloc::{vec, vec::Vec};
+
+use ostd::mm::{HasDaddr, PAGE_SIZE, VmIo, dma::DmaCoherent};
+
+use crate::{chip::Chip, regs::*};
+
+/// The queues, in Linux's order (`enum rtw_tx_queue_type`).
+pub(crate) const QUEUE_BK: usize = 0;
+pub(crate) const QUEUE_BE: usize = 1;
+pub(crate) const QUEUE_VI: usize = 2;
+pub(crate) const QUEUE_VO: usize = 3;
+pub(crate) const QUEUE_BCN: usize = 4;
+pub(crate) const QUEUE_MGMT: usize = 5;
+pub(crate) const QUEUE_HI0: usize = 6;
+pub(crate) const QUEUE_H2C: usize = 7;
+const QUEUES: usize = 8;
+
+/// The TX descriptor of the 8821C/8822B/8822C (`tx_pkt_desc_sz`) and the
+/// buffer descriptors (`tx_buf_desc_sz`, `rx_buf_desc_sz`).
+pub(crate) const TX_DESC: usize = 48;
+const TX_BD: usize = 16;
+const RX_BD: usize = 8;
+/// A TX slot: a page (the beacon queue two, for 4 KiB of firmware).
+const TX_SLOT: usize = PAGE_SIZE;
+const BCN_SLOT: usize = 2 * PAGE_SIZE;
+/// An RX buffer (`RTK_PCI_RX_BUF_SIZE`: 11 KiB and the RX descriptor).
+pub(crate) const RX_BUF: usize = 11454 + 24;
+const RX_SLOT: usize = RX_BUF.div_ceil(PAGE_SIZE) * PAGE_SIZE;
+const RX_SLOTS: usize = 128;
+const RX_TAG_MAX: u16 = 8192;
+
+/// The ring's registers: base address, depth, index (`rtw_pci.h`).
+fn registers(queue: usize) -> (u32, u32, u32) {
+    match queue {
+        QUEUE_BK => (RTK_PCI_TXBD_DESA_BKQ, RTK_PCI_TXBD_NUM_BKQ, RTK_PCI_TXBD_IDX_BKQ),
+        QUEUE_BE => (RTK_PCI_TXBD_DESA_BEQ, RTK_PCI_TXBD_NUM_BEQ, RTK_PCI_TXBD_IDX_BEQ),
+        QUEUE_VI => (RTK_PCI_TXBD_DESA_VIQ, RTK_PCI_TXBD_NUM_VIQ, RTK_PCI_TXBD_IDX_VIQ),
+        QUEUE_VO => (RTK_PCI_TXBD_DESA_VOQ, RTK_PCI_TXBD_NUM_VOQ, RTK_PCI_TXBD_IDX_VOQ),
+        QUEUE_MGMT => (RTK_PCI_TXBD_DESA_MGMTQ, RTK_PCI_TXBD_NUM_MGMTQ, RTK_PCI_TXBD_IDX_MGMTQ),
+        QUEUE_HI0 => (RTK_PCI_TXBD_DESA_HI0Q, RTK_PCI_TXBD_NUM_HI0Q, RTK_PCI_TXBD_IDX_HI0Q),
+        QUEUE_H2C => (RTK_PCI_TXBD_DESA_H2CQ, RTK_PCI_TXBD_NUM_H2CQ, RTK_PCI_TXBD_IDX_H2CQ),
+        _ => (RTK_PCI_TXBD_DESA_BCNQ, 0, 0),
+    }
+}
+
+/// DMA memory the buffer descriptors can name: their addresses are 32 bits.
+/// Asked for again until it lies below 4 GiB.
+pub(crate) fn dma32(bytes: usize) -> Option<DmaCoherent> {
+    let pages = bytes.div_ceil(PAGE_SIZE).max(1);
+    let mut rejected = Vec::new();
+    for _ in 0..64 {
+        let block = DmaCoherent::alloc(pages, true).ok()?;
+        if (block.daddr() as u64) + (pages * PAGE_SIZE) as u64 <= 1 << 32 {
+            return Some(block);
+        }
+        rejected.push(block);
+    }
+    None
+}
+
+struct TxRing {
+    bds: DmaCoherent,
+    buffers: DmaCoherent,
+    slot: usize,
+    len: usize,
+    wp: usize,
+}
+
+struct RxRing {
+    bds: DmaCoherent,
+    buffers: DmaCoherent,
+    rp: usize,
+    tag: u16,
+}
+
+/// What a TX descriptor says (Linux's `struct rtw_tx_pkt_info`, the fields
+/// this driver uses).
+#[derive(Clone, Copy, Default)]
+pub(crate) struct TxInfo {
+    pub(crate) offset: u8,
+    pub(crate) bmc: bool,
+    pub(crate) ls: bool,
+    pub(crate) dis_qselseq: bool,
+    pub(crate) mac_id: u8,
+    pub(crate) qsel: u8,
+    pub(crate) rate_id: u8,
+    pub(crate) sec_type: u8,
+    pub(crate) use_rate: bool,
+    pub(crate) dis_rate_fallback: bool,
+    pub(crate) rate: u8,
+    pub(crate) en_hwseq: bool,
+    pub(crate) seq: u16,
+    pub(crate) sn: u16,
+}
+
+impl TxInfo {
+    /// `rtw_tx_fill_tx_desc`.
+    fn descriptor(&self, size: usize) -> [u8; TX_DESC] {
+        let mut w = [0u32; 12];
+        let more_data = self.qsel == TX_DESC_QSEL_HIGH as u8;
+        w[0] = (size as u32 & 0xffff) | ((self.offset as u32) << 16) | ((self.bmc as u32) << 24) | ((self.ls as u32) << 26) | ((self.dis_qselseq as u32) << 31);
+        w[1] = (self.mac_id as u32 & 0x7f) | ((self.qsel as u32 & 0x1f) << 8) | ((self.rate_id as u32 & 0x1f) << 16) | ((self.sec_type as u32 & 3) << 22) | ((more_data as u32) << 29);
+        w[3] = ((self.use_rate as u32) << 8) | ((self.dis_rate_fallback as u32) << 10);
+        w[4] = self.rate as u32 & 0x7f;
+        w[6] = self.sn as u32 & 0xfff;
+        w[8] = (self.en_hwseq as u32) << 15;
+        w[9] = (self.seq as u32 & 0xfff) << 12;
+        let mut out = [0u8; TX_DESC];
+        for (index, word) in w.iter().enumerate() {
+            out[index * 4..index * 4 + 4].copy_from_slice(&word.to_le_bytes());
+        }
+        out
+    }
+}
+
+pub(crate) struct Pci {
+    tx: Vec<TxRing>,
+    rx: RxRing,
+    /// Interrupts to take (`irq_mask`).
+    mask: [u32; 4],
+}
+
+impl Pci {
+    /// Linux's `rtw_pci_init`: the rings.
+    pub(crate) fn new() -> Option<Self> {
+        let mut tx = Vec::with_capacity(QUEUES);
+        for queue in 0..QUEUES {
+            let (len, slot) = match queue {
+                QUEUE_BCN => (1, BCN_SLOT),
+                QUEUE_BE => (128, TX_SLOT),
+                _ => (64, TX_SLOT),
+            };
+            tx.push(TxRing { bds: dma32(len * TX_BD)?, buffers: dma32(len * slot)?, slot, len, wp: 0 });
+        }
+        let rx = RxRing { bds: dma32(RX_SLOTS * RX_BD)?, buffers: dma32(RX_SLOTS * RX_SLOT)?, rp: 0, tag: 0 };
+        let mask = [
+            IMR_HIGHDOK | IMR_MGNTDOK | IMR_BKDOK | IMR_BEDOK | IMR_VIDOK | IMR_VODOK | IMR_ROK | IMR_BCNDMAINT_E | IMR_C2HCMD,
+            IMR_TXFOVW,
+            0,
+            IMR_H2CDOK,
+        ];
+        Some(Self { tx, rx, mask })
+    }
+
+    /// Linux's `rtw_pci_setup` (`rtw_pci_reset_buf_desc`, `rtw_pci_dma_reset`).
+    pub(crate) fn setup(&mut self, chip: &Chip) {
+        let value = chip.r8(RTK_PCI_CTRL + 3);
+        chip.w8(RTK_PCI_CTRL + 3, value | 0xf7);
+        for (queue, ring) in self.tx.iter_mut().enumerate() {
+            let (desa, num, _) = registers(queue);
+            ring.wp = 0;
+            for slot in 0..ring.len {
+                let _ = ring.bds.write_bytes(slot * TX_BD, &[0u8; TX_BD]);
+            }
+            if queue != QUEUE_BCN {
+                chip.w16(num, (ring.len as u32 & TRX_BD_IDX_MASK) as u16);
+            }
+            chip.w32(desa, ring.bds.daddr() as u32);
+        }
+        for slot in 0..RX_SLOTS {
+            self.reset_rx(slot);
+        }
+        self.rx.rp = 0;
+        chip.w16(RTK_PCI_RXBD_NUM_MPDUQ, (RX_SLOTS as u32 & TRX_BD_IDX_MASK) as u16);
+        chip.w32(RTK_PCI_RXBD_DESA_MPDUQ, self.rx.bds.daddr() as u32);
+        chip.w32(RTK_PCI_TXBD_RWPTR_CLR, 0xffff_ffff);
+        chip.set32(RTK_PCI_TXBD_H2CQ_CSR, BIT_CLR_H2CQ_HOST_IDX | BIT_CLR_H2CQ_HW_IDX);
+        // The DMA's reset and the RX tag.
+        chip.set32(RTK_PCI_CTRL, BIT_RST_TRXDMA_INTF | BIT_RX_TAG_EN);
+        self.rx.tag = 0;
+    }
+
+    fn reset_rx(&mut self, slot: usize) {
+        let mut bd = [0u8; RX_BD];
+        bd[0..2].copy_from_slice(&(RX_BUF as u16).to_le_bytes());
+        let address = (self.rx.buffers.daddr() + slot * RX_SLOT) as u32;
+        bd[4..8].copy_from_slice(&address.to_le_bytes());
+        let _ = self.rx.bds.write_bytes(slot * RX_BD, &bd);
+    }
+
+    pub(crate) fn enable_interrupts(&self, chip: &Chip) {
+        chip.w32(RTK_PCI_HIMR0, self.mask[0]);
+        chip.w32(RTK_PCI_HIMR1, self.mask[1]);
+        chip.w32(RTK_PCI_HIMR3, self.mask[3]);
+    }
+
+    pub(crate) fn disable_interrupts(&self, chip: &Chip) {
+        chip.w32(RTK_PCI_HIMR0, 0);
+        chip.w32(RTK_PCI_HIMR1, 0);
+        chip.w32(RTK_PCI_HIMR3, 0);
+    }
+
+    /// The interrupt status, cleared (`rtw_pci_irq_recognized`).
+    pub(crate) fn interrupts(&self, chip: &Chip) -> [u32; 4] {
+        let status = [
+            chip.r32(RTK_PCI_HISR0) & self.mask[0],
+            chip.r32(RTK_PCI_HISR1) & self.mask[1],
+            0,
+            chip.r32(RTK_PCI_HISR3) & self.mask[3],
+        ];
+        chip.w32(RTK_PCI_HISR0, status[0]);
+        chip.w32(RTK_PCI_HISR1, status[1]);
+        chip.w32(RTK_PCI_HISR3, status[3]);
+        status
+    }
+
+    /// The slots of a TX ring the DMA has not taken yet.
+    fn free_slots(&self, chip: &Chip, queue: usize) -> usize {
+        let ring = &self.tx[queue];
+        let (_, _, index) = registers(queue);
+        let rp = ((chip.r32(index) >> 16) & TRX_BD_IDX_MASK) as usize % ring.len;
+        if rp > ring.wp { rp - ring.wp - 1 } else { ring.len - ring.wp + rp - 1 }
+    }
+
+    /// Linux's `rtw_pci_tx_write_data`: the TX descriptor and the frame in
+    /// the slot, the two buffer descriptors, the write index (except the
+    /// beacon queue, which the caller starts).
+    pub(crate) fn write(&mut self, chip: &Chip, queue: usize, info: &TxInfo, data: &[u8]) -> Result<(), ()> {
+        if queue != QUEUE_BCN && self.free_slots(chip, queue) == 0 {
+            return Err(());
+        }
+        let ring = &mut self.tx[queue];
+        if TX_DESC + data.len() > ring.slot {
+            return Err(());
+        }
+        let slot = ring.wp;
+        let at = slot * ring.slot;
+        ring.buffers.write_bytes(at, &info.descriptor(data.len())).map_err(|_| ())?;
+        ring.buffers.write_bytes(at + TX_DESC, data).map_err(|_| ())?;
+        let address = (ring.buffers.daddr() + at) as u32;
+        let total = TX_DESC + data.len();
+        let mut psb = ((total - 1) / 128 + 1) as u16;
+        if queue == QUEUE_BCN {
+            psb |= 1 << RTK_PCI_TXBD_OWN_OFFSET;
+        }
+        let mut bd = [0u8; TX_BD];
+        bd[0..2].copy_from_slice(&(TX_DESC as u16).to_le_bytes());
+        bd[2..4].copy_from_slice(&psb.to_le_bytes());
+        bd[4..8].copy_from_slice(&address.to_le_bytes());
+        bd[8..10].copy_from_slice(&(data.len() as u16).to_le_bytes());
+        bd[12..16].copy_from_slice(&(address + TX_DESC as u32).to_le_bytes());
+        ring.bds.write_bytes(slot * TX_BD, &bd).map_err(|_| ())?;
+        if queue == QUEUE_BCN {
+            return Ok(());
+        }
+        ring.wp = (ring.wp + 1) % ring.len;
+        let (_, _, index) = registers(queue);
+        chip.w16(index, (ring.wp as u32 & TRX_BD_IDX_MASK) as u16);
+        Ok(())
+    }
+
+    /// Linux's `rtw_pci_write_data_rsvd_page`: through the beacon queue.
+    pub(crate) fn write_rsvd_page(&mut self, chip: &Chip, info: &TxInfo, data: &[u8]) -> Result<(), ()> {
+        self.write(chip, QUEUE_BCN, info, data)?;
+        let work = chip.r8(RTK_PCI_TXBD_BCN_WORK);
+        chip.w8(RTK_PCI_TXBD_BCN_WORK, work | BIT_PCI_BCNQ_FLAG as u8);
+        Ok(())
+    }
+
+    /// Linux's `rtw_pci_write_data_h2c`.
+    pub(crate) fn write_h2c(&mut self, chip: &Chip, packet: &[u8]) -> Result<(), ()> {
+        let info = TxInfo { qsel: TX_DESC_QSEL_H2C as u8, ..TxInfo::default() };
+        self.write(chip, QUEUE_H2C, &info, packet)
+    }
+
+    /// The RX ring's packets since the last call (Linux's
+    /// `rtw_pci_rx_napi`): each from its RX descriptor on.
+    pub(crate) fn receive(&mut self, chip: &Chip) -> Vec<Vec<u8>> {
+        let mut out = Vec::new();
+        let hw = ((chip.r32(RTK_PCI_RXBD_IDX_MPDUQ) & TRX_BD_HW_IDX_MASK) >> 16) as usize % RX_SLOTS;
+        let count = if hw >= self.rx.rp { hw - self.rx.rp } else { RX_SLOTS - (self.rx.rp - hw) };
+        for _ in 0..count {
+            let slot = self.rx.rp;
+            // The RX tag says whether the bus delivered every buffer.
+            let mut bd = [0u8; RX_BD];
+            let _ = self.rx.bds.read_bytes(slot * RX_BD, &mut bd);
+            let tag = u16::from_le_bytes([bd[2], bd[3]]);
+            if tag != self.rx.tag {
+                ostd::warn!("{}: PCI bus time-out (RX tag {} instead of {})", chip.name, tag, self.rx.tag);
+            }
+            self.rx.tag = (self.rx.tag + 1) % RX_TAG_MAX;
+            let mut head = [0u8; 24];
+            let _ = self.rx.buffers.read_bytes(slot * RX_SLOT, &mut head);
+            let w0 = u32::from_le_bytes([head[0], head[1], head[2], head[3]]);
+            let length = (w0 & 0x3fff) as usize;
+            let drv_info = (((w0 >> 16) & 0xf) * 8) as usize;
+            let shift = ((w0 >> 24) & 3) as usize;
+            let total = (24 + drv_info + shift + length).min(RX_BUF);
+            let mut packet = vec![0u8; total];
+            let _ = self.rx.buffers.read_bytes(slot * RX_SLOT, &mut packet);
+            out.push(packet);
+            self.reset_rx(slot);
+            self.rx.rp = (self.rx.rp + 1) % RX_SLOTS;
+        }
+        if count > 0 {
+            chip.w16(RTK_PCI_RXBD_IDX_MPDUQ, self.rx.rp as u16);
+        }
+        out
+    }
+}
