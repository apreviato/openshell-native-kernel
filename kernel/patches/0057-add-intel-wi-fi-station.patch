@@ -0,0 +1,1180 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The card as a Wi-Fi station: the commands of Linux's `iwlmvm` for
+//! firmware API 77 (AX200 to AX211), in the order it sends them.
+//!
+//! After the firmware runs ([`Mvm::init`]): the platform's NVM data
+//! (AX210), the end of the firmware's start, the NVM's facts and the MAC
+//! address, the antennas, Bluetooth coexistence, the platform's latency,
+//! power (always awake), the region and the scan configuration; then the
+//! interface's MAC context. A scan is one UMAC scan request. Joining a
+//! network is a PHY context on its channel, the binding, the access
+//! point's station and its two queues (management and data) and session
+//! protection; once associated, the MAC context and the station say so and
+//! the firmware's rate control (TLC) gets the rates. Frames go as TX
+//! commands, with the CCMP/GCMP header this driver writes (the hardware
+//! encrypts); they come as RX MPDU packets, decrypted by the hardware with
+//! that header still in.
+//!
+//! Not yet: 40 MHz and wider (the station says 20 MHz HT, so access points
+//! send at 20 MHz), VHT and HE, block-ack agreements, power save, 6 GHz,
+//! TKIP and WEP, BIP (802.11w broadcast protection), restarting the
+//! firmware after an error.
+
+use alloc::{format, string::String, sync::Arc, vec, vec::Vec};
+use core::sync::atomic::Ordering;
+
+use aster_wlan::{
+    Device,
+    ieee80211::{self as wifi, Address},
+    radio::{self, Association, Band, BandId, Channel, HtCap, Info, Join, Key, LinkStats, RxInfo, ScanRequest},
+};
+
+use crate::{
+    fw::{self, Firmware},
+    ids::{self, Family, Mac},
+    trans::{Packet, Transport, TxQueue, TX_QUEUE_SIZE},
+};
+
+// Command groups.
+const LONG: u8 = 0x01;
+const SYSTEM: u8 = 0x02;
+const MAC_CONF: u8 = 0x03;
+const DATA_PATH: u8 = 0x05;
+const REGULATORY: u8 = 0x0c;
+
+// The long group's commands and notifications (Linux's legacy IDs).
+const INIT_COMPLETE_NOTIF: u8 = 0x04;
+const PHY_CONTEXT_CMD: u8 = 0x08;
+const SCAN_CFG_CMD: u8 = 0x0c;
+const SCAN_REQ_UMAC: u8 = 0x0d;
+const SCAN_ABORT_UMAC: u8 = 0x0e;
+const SCAN_COMPLETE_UMAC: u8 = 0x0f;
+const ADD_STA_KEY: u8 = 0x17;
+const ADD_STA: u8 = 0x18;
+const REMOVE_STA: u8 = 0x19;
+const TX_CMD: u8 = 0x1c;
+const MAC_CONTEXT_CMD: u8 = 0x28;
+const BINDING_CONTEXT_CMD: u8 = 0x2b;
+const POWER_TABLE_CMD: u8 = 0x77;
+const TX_ANT_CONFIGURATION_CMD: u8 = 0x98;
+const BT_CONFIG: u8 = 0x9b;
+const MISSED_BEACONS_NOTIFICATION: u8 = 0xa2;
+const MAC_PM_POWER_TABLE: u8 = 0xa9;
+const REPLY_RX_MPDU_CMD: u8 = 0xc1;
+const MCC_UPDATE_CMD: u8 = 0xc8;
+// The other groups'.
+const SOC_CONFIGURATION_CMD: u8 = 0x01;
+const INIT_EXTENDED_CFG_CMD: u8 = 0x03;
+const SESSION_PROTECTION_CMD: u8 = 0x05;
+const MISSED_BEACONS_NOTIF: u8 = 0xf6;
+const TLC_MNG_CONFIG_CMD: u8 = 0x0f;
+const SCD_QUEUE_CONFIG_CMD: u8 = 0x17;
+const NVM_ACCESS_COMPLETE: u8 = 0x00;
+const NVM_GET_INFO: u8 = 0x02;
+const PNVM_INIT_COMPLETE_NTFY: u8 = 0xfe;
+
+// Capabilities (`IWL_UCODE_TLV_CAPA_*`).
+const CAPA_LAR_SUPPORT: u32 = 1;
+const CAPA_SOC_LATENCY_SUPPORT: u32 = 37;
+const CAPA_CDB_SUPPORT: u32 = 40;
+const CAPA_ULTRA_HB_CHANNELS: u32 = 48;
+
+const FW_CTXT_ACTION_ADD: u32 = 1;
+const FW_CTXT_ACTION_MODIFY: u32 = 2;
+const FW_CTXT_ACTION_REMOVE: u32 = 3;
+const FW_CTXT_INVALID: u32 = 0xffff_ffff;
+const FW_MAC_TYPE_BSS_STA: u32 = 5;
+const MAC_FILTER_ACCEPT_GRP: u32 = 1 << 2;
+const MAC_FILTER_IN_BEACON: u32 = 1 << 6;
+const MAC_QOS_FLG_UPDATE_EDCA: u32 = 1 << 0;
+const MAC_QOS_FLG_TGN: u32 = 1 << 1;
+const MAC_FLG_SHORT_SLOT: u32 = 1 << 4;
+const MAC_FLG_SHORT_PREAMBLE: u32 = 1 << 5;
+const PHY_BAND_5: u8 = 0;
+const PHY_BAND_24: u8 = 1;
+const PHY_RX_CHAIN_VALID_POS: u32 = 1;
+const PHY_RX_CHAIN_CNT_POS: u32 = 10;
+const PHY_RX_CHAIN_MIMO_CNT_POS: u32 = 12;
+const STA_FLG_MAX_AGG_SIZE_64K: u32 = 3 << 19;
+const STA_FLG_FAT_EN_MSK: u32 = 3 << 26;
+const STA_FLG_MIMO_EN_MSK: u32 = 3 << 28;
+const STA_FLG_MIMO_EN_MIMO2: u32 = 1 << 28;
+const STA_FLG_RTS_MIMO_PROT: u32 = 1 << 17;
+const STA_FLG_AGG_MPDU_DENS_SHIFT: u32 = 23;
+const ADD_STA_SUCCESS: u32 = 1;
+const STA_KEY_FLG_CCM: u16 = 2;
+const STA_KEY_FLG_GCMP: u16 = 5;
+const STA_KEY_FLG_KEYID_POS: u16 = 8;
+const STA_KEY_NOT_VALID: u16 = 1 << 11;
+const STA_KEY_FLG_KEY_32BYTES: u16 = 1 << 12;
+const STA_KEY_MULTICAST: u16 = 1 << 14;
+const IWL_TX_FLAGS_ENCRYPT_DIS: u32 = 1 << 1;
+const IWL_TX_FLAGS_HIGH_PRI: u32 = 1 << 2;
+const TX_CMD_OFFLD_MH_SIZE: u32 = 8;
+const TX_CMD_OFFLD_PAD: u32 = 13;
+const TX_STATUS_SUCCESS: u16 = 0x01;
+const TX_STATUS_DIRECT_DONE: u16 = 0x02;
+const RX_STATUS_CRC_OK: u32 = 1 << 0;
+const RX_STATUS_OVERRUN_OK: u32 = 1 << 1;
+const RX_STATUS_MIC_OK: u32 = 1 << 6;
+const RX_STATUS_SEC_CCM: u32 = 2;
+const RX_STATUS_SEC_GCM: u32 = 5;
+const RX_MFLG2_PAD: u8 = 0x20;
+const SCAN_GEN_FLAGS_PASS_ALL: u16 = 1 << 1;
+const SCAN_GEN_FLAGS_USE_ALL_RX_CHAINS: u16 = 1 << 6;
+const SCAN_GEN_FLAGS_ADAPTIVE_DWELL: u16 = 1 << 7;
+const SCAN_GEN_FLAGS_FORCE_PASSIVE: u16 = 1 << 11;
+const SCAN_CHANNEL_FLAG_ENABLE_CHAN_ORDER: u8 = 1 << 5;
+const SCAN_OFFLOAD_COMPLETED: u8 = 1;
+const SCAN_MAX_CHANNELS: usize = 67;
+const PROBE_OPTION_MAX: usize = 20;
+const PROBE_TEMPLATE: usize = 512;
+const IWL_MGMT_TID: u8 = 15;
+const MCC_SOURCE_GET_CURRENT: u8 = 0x10;
+const BT_COEX_NW: u32 = 0x1;
+const SESSION_PROTECT_CONF_ASSOC: u32 = 0;
+const SOC_CONFIG_CMD_FLAGS_DISCRETE: u32 = 1 << 0;
+const SOC_CONFIG_CMD_FLAGS_LOW_LATENCY: u32 = 1 << 1;
+const NVM_MAC_SKU_24: u32 = 1 << 0;
+const NVM_MAC_SKU_52: u32 = 1 << 1;
+const NVM_MAC_SKU_11N: u32 = 1 << 2;
+const NVM_MAC_SKU_MIMO_DISABLED: u32 = 1 << 5;
+
+const COMMAND_TIMEOUT_MS: u64 = 2_000;
+/// How long a session protection keeps the card on the network's channel
+/// while it authenticates and associates, in time units (1.024 ms).
+const SESSION_PROTECTION_TU: u32 = 1_000;
+/// The firmware's missed-beacon count at which the link is given up.
+const MISSED_BEACONS_LOST: u32 = 16;
+
+/// The channels: 2.4 GHz 1 to 13, 5 GHz from 36 to 165. The firmware
+/// keeps to the region (LAR); radar channels are only listened to.
+fn channels(band: BandId) -> Vec<Channel> {
+    match band {
+        BandId::Ghz2 => (1..=13u16).map(|channel| Channel::new(2407 + 5 * channel)).collect(),
+        _ => [36u16, 40, 44, 48, 52, 56, 60, 64, 100, 104, 108, 112, 116, 120, 124, 128, 132, 136, 140, 144, 149, 153, 157, 161, 165]
+            .iter()
+            .map(|&channel| {
+                let mut entry = Channel::new(5000 + 5 * channel);
+                entry.radar = (52..=144).contains(&channel);
+                entry.passive = entry.radar;
+                entry
+            })
+            .collect(),
+    }
+}
+
+fn channel_number(freq: u16) -> u8 {
+    wifi::channel_of(freq).unwrap_or(0)
+}
+
+/// The 802.11 header's length: what precedes the body (and any cipher's
+/// header).
+pub(crate) fn header_len(frame: &[u8]) -> usize {
+    let (kind, flags) = (frame.first().copied().unwrap_or(0), frame.get(1).copied().unwrap_or(0));
+    let mut length = wifi::HEADER;
+    if kind & 0x0c == 0x08 {
+        if flags & 3 == 3 {
+            length += 6;
+        }
+        if kind & 0x80 != 0 {
+            length += 2;
+            if flags & wifi::ORDER != 0 {
+                length += 4;
+            }
+        }
+    }
+    length.min(frame.len())
+}
+
+/// Little-endian command bytes.
+#[derive(Default)]
+struct Out(Vec<u8>);
+
+impl Out {
+    fn u8(&mut self, value: u8) -> &mut Self {
+        self.0.push(value);
+        self
+    }
+    fn u16(&mut self, value: u16) -> &mut Self {
+        self.0.extend_from_slice(&value.to_le_bytes());
+        self
+    }
+    fn u32(&mut self, value: u32) -> &mut Self {
+        self.0.extend_from_slice(&value.to_le_bytes());
+        self
+    }
+    fn u64(&mut self, value: u64) -> &mut Self {
+        self.0.extend_from_slice(&value.to_le_bytes());
+        self
+    }
+    fn bytes(&mut self, value: &[u8]) -> &mut Self {
+        self.0.extend_from_slice(value);
+        self
+    }
+    fn zeros(&mut self, count: usize) -> &mut Self {
+        self.0.resize(self.0.len() + count, 0);
+        self
+    }
+}
+
+fn le16(data: &[u8], at: usize) -> u16 {
+    data.get(at..at + 2).map_or(0, |bytes| u16::from_le_bytes([bytes[0], bytes[1]]))
+}
+
+fn le32(data: &[u8], at: usize) -> u32 {
+    data.get(at..at + 4).map_or(0, |bytes| u32::from_le_bytes([bytes[0], bytes[1], bytes[2], bytes[3]]))
+}
+
+/// The pairwise key as frames to send need it: its cipher header.
+struct PairwiseKey {
+    index: u8,
+    /// The next packet number.
+    pn: u64,
+}
+
+/// What the network said of itself in its beacon, for the contexts.
+#[derive(Clone, Default)]
+struct Network {
+    bssid: Address,
+    freq: u16,
+    beacon_interval: u16,
+    dtim_period: u8,
+    capability: u16,
+    /// Its HT capabilities' MCS set, when it has HT.
+    ht_mcs: Option<[u8; 16]>,
+    ht_short_gi: bool,
+    ampdu_density: u8,
+}
+
+/// The firmware's state for this card.
+pub(crate) struct Mvm {
+    pub(crate) trans: Transport,
+    pub(crate) name: String,
+    mac: &'static Mac,
+    ax210: bool,
+    tx_cmd_v10: bool,
+    rx_desc_len: usize,
+    uhb: bool,
+    cdb: bool,
+    lar: bool,
+    soc_latency: bool,
+    tx_ant: u8,
+    rx_ant: u8,
+    pub(crate) address: Address,
+    band_24: bool,
+    band_52: bool,
+    ht: bool,
+    scan_channels: usize,
+    pub(crate) device: Option<Arc<Device>>,
+    pub(crate) dead: bool,
+    mac_added: bool,
+    phy_added: bool,
+    binding_added: bool,
+    station_added: bool,
+    network: Option<Network>,
+    associated: bool,
+    aid: u16,
+    qos: bool,
+    management_queue: Option<TxQueue>,
+    data_queue: Option<TxQueue>,
+    /// The next sequence number: per TID for QoS data, then the rest.
+    sequence: [u16; 17],
+    pairwise: Option<PairwiseKey>,
+    scanning: bool,
+    signal: Option<i8>,
+}
+
+impl Mvm {
+    pub(crate) fn new(trans: Transport, firmware: &Firmware) -> Self {
+        let mac = trans.mac;
+        let ax210 = mac.family == Family::Ax210;
+        let (tx_ant, rx_ant) = firmware.antennas();
+        Self {
+            name: trans.name.clone(),
+            mac,
+            ax210,
+            tx_cmd_v10: firmware.command_version(LONG, TX_CMD) >= 10,
+            rx_desc_len: if ax210 { 64 } else { 48 },
+            uhb: firmware.has_capability(CAPA_ULTRA_HB_CHANNELS),
+            cdb: firmware.has_capability(CAPA_CDB_SUPPORT),
+            lar: firmware.has_capability(CAPA_LAR_SUPPORT),
+            soc_latency: firmware.has_capability(CAPA_SOC_LATENCY_SUPPORT),
+            tx_ant: if tx_ant == 0 { 0x3 } else { tx_ant },
+            rx_ant: if rx_ant == 0 { 0x3 } else { rx_ant },
+            address: [0; 6],
+            band_24: true,
+            band_52: true,
+            ht: true,
+            scan_channels: (firmware.scan_channels as usize).clamp(1, SCAN_MAX_CHANNELS),
+            device: None,
+            dead: false,
+            mac_added: false,
+            phy_added: false,
+            binding_added: false,
+            station_added: false,
+            network: None,
+            associated: false,
+            aid: 0,
+            qos: false,
+            management_queue: None,
+            data_queue: None,
+            sequence: [0; 17],
+            pairwise: None,
+            scanning: false,
+            signal: None,
+            trans,
+        }
+    }
+
+    // ---- Commands and what comes back. ----
+
+    /// Sends a command and waits for its answer, handling what else comes
+    /// meanwhile. Legacy commands go in the long group, as Linux sends
+    /// them with the wide header.
+    fn command(&mut self, group: u8, id: u8, payload: &[u8]) -> Result<Vec<u8>, String> {
+        if self.dead {
+            return Err(String::from("the firmware stopped"));
+        }
+        let group = if group == 0 { LONG } else { group };
+        let sequence = self
+            .trans
+            .send_command(group, id, 0, payload)
+            .ok_or_else(|| format!("command {group:#x}/{id:#x} did not fit the queue"))?;
+        self.wait_for(COMMAND_TIMEOUT_MS, &format!("command {group:#x}/{id:#x}"), |packet| packet.answers(sequence))
+    }
+
+    /// A command whose answer is a status: `ok` is the good one.
+    fn command_status(&mut self, group: u8, id: u8, payload: &[u8], ok: u32) -> Result<(), String> {
+        let answer = self.command(group, id, payload)?;
+        let status = le32(&answer, 0);
+        if answer.len() >= 4 && status != ok {
+            return Err(format!("command {group:#x}/{id:#x} refused (status {status:#x})"));
+        }
+        Ok(())
+    }
+
+    /// Waits for a notification of the long group (or another `group`).
+    fn notification(&mut self, group: u8, id: u8, timeout_ms: u64) -> Result<Vec<u8>, String> {
+        self.wait_for(timeout_ms, &format!("notification {group:#x}/{id:#x}"), |packet| {
+            packet.command == id && (packet.group == group || (group <= LONG && packet.group <= LONG))
+        })
+    }
+
+    fn wait_for(&mut self, timeout_ms: u64, what: &str, wanted: impl Fn(&Packet) -> bool) -> Result<Vec<u8>, String> {
+        let deadline = crate::now_ms() + timeout_ms;
+        crate::WAITING.fetch_add(1, Ordering::AcqRel);
+        let result = loop {
+            let causes = self.trans.causes();
+            let mut found = None;
+            for packet in self.trans.receive() {
+                if found.is_none() && wanted(&packet) {
+                    found = Some(packet.data);
+                } else {
+                    self.handle(packet);
+                }
+            }
+            if let Some(data) = found {
+                break Ok(data);
+            }
+            if causes.error {
+                self.died();
+                break Err(String::from("the firmware stopped with an error"));
+            }
+            if crate::now_ms() >= deadline {
+                break Err(format!("no answer to {what}"));
+            }
+            crate::sleep();
+        };
+        crate::WAITING.fetch_sub(1, Ordering::AcqRel);
+        result
+    }
+
+    /// Reads what the card said: from its task, between commands.
+    pub(crate) fn poll(&mut self) {
+        if self.dead {
+            return;
+        }
+        let causes = self.trans.causes();
+        for packet in self.trans.receive() {
+            self.handle(packet);
+        }
+        if causes.error {
+            self.died();
+        }
+    }
+
+    fn died(&mut self) {
+        if self.dead {
+            return;
+        }
+        self.dead = true;
+        ostd::warn!("{}: the firmware stopped with an error; the card stays off until the next boot", self.name);
+        if let Some(device) = &self.device {
+            if self.scanning {
+                device.scan_done(true);
+            }
+            device.connection_lost();
+        }
+        self.scanning = false;
+    }
+
+    fn handle(&mut self, packet: Packet) {
+        let legacy = packet.group <= LONG;
+        match packet.command {
+            REPLY_RX_MPDU_CMD if legacy => self.rx_mpdu(&packet.data),
+            TX_CMD if legacy => self.tx_response(&packet.data),
+            SCAN_COMPLETE_UMAC if legacy => {
+                let status = packet.data.get(6).copied().unwrap_or(0);
+                if self.scanning {
+                    self.scanning = false;
+                    if let Some(device) = &self.device {
+                        device.scan_done(status != SCAN_OFFLOAD_COMPLETED);
+                    }
+                }
+            }
+            MISSED_BEACONS_NOTIFICATION if legacy => self.missed_beacons(&packet.data),
+            MISSED_BEACONS_NOTIF if packet.group == MAC_CONF => self.missed_beacons(&packet.data),
+            _ => {}
+        }
+    }
+
+    fn missed_beacons(&mut self, data: &[u8]) {
+        let missed = le32(data, 4);
+        if missed >= MISSED_BEACONS_LOST && self.associated {
+            ostd::info!("{}: {} beacons missed", self.name, missed);
+            if let Some(device) = &self.device {
+                device.connection_lost();
+            }
+        }
+    }
+
+    // ---- The firmware's start. ----
+
+    /// Everything between the firmware's ALIVE (`alive`, its notification)
+    /// and a radio ready to scan.
+    pub(crate) fn init(&mut self, alive: &[u8], prefix: &str) -> Result<(), String> {
+        if self.ax210 {
+            self.load_pnvm(alive, prefix)?;
+        }
+        self.command(SYSTEM, INIT_EXTENDED_CFG_CMD, &1u32.to_le_bytes())?;
+        self.command(REGULATORY, NVM_ACCESS_COMPLETE, &0u32.to_le_bytes())?;
+        self.notification(LONG, INIT_COMPLETE_NOTIF, COMMAND_TIMEOUT_MS)?;
+        let nvm = self.command(REGULATORY, NVM_GET_INFO, &0u32.to_le_bytes())?;
+        if nvm.len() >= 20 {
+            let sku = le32(&nvm, 8);
+            self.band_24 = sku & NVM_MAC_SKU_24 != 0;
+            self.band_52 = sku & NVM_MAC_SKU_52 != 0;
+            self.ht = sku & NVM_MAC_SKU_11N != 0;
+            let (tx, rx) = (le32(&nvm, 12) as u8, le32(&nvm, 16) as u8);
+            if tx & self.tx_ant != 0 {
+                self.tx_ant &= tx;
+            }
+            if rx & self.rx_ant != 0 {
+                self.rx_ant &= rx;
+            }
+            if sku & NVM_MAC_SKU_MIMO_DISABLED != 0 {
+                self.tx_ant &= self.tx_ant.wrapping_neg();
+                self.rx_ant &= self.rx_ant.wrapping_neg();
+            }
+        }
+        if !self.band_24 && !self.band_52 {
+            self.band_24 = true;
+        }
+        self.address = self.trans.mac_address();
+        if self.address == [0; 6] || self.address[0] & 1 != 0 {
+            return Err(String::from("the card has no MAC address"));
+        }
+        self.command(0, TX_ANT_CONFIGURATION_CMD, &(self.tx_ant as u32).to_le_bytes())?;
+        self.command(0, BT_CONFIG, &Out::default().u32(BT_COEX_NW).u32(0).0)?;
+        if self.soc_latency {
+            let (latency, ltr_delay, low_latency) = ids::soc_latency(self.mac);
+            let mut flags = if self.mac.integrated { 0 } else { SOC_CONFIG_CMD_FLAGS_DISCRETE };
+            if self.mac.integrated {
+                flags |= (ltr_delay as u32) << 2;
+            }
+            if low_latency {
+                flags |= SOC_CONFIG_CMD_FLAGS_LOW_LATENCY;
+            }
+            self.command(SYSTEM, SOC_CONFIGURATION_CMD, &Out::default().u32(flags).u32(latency).0)?;
+        }
+        // Always awake: no power save.
+        self.command(0, POWER_TABLE_CMD, &Out::default().u16(0).u16(0).0)?;
+        if self.lar {
+            // The firmware's region as it knows it ("ZZ": the world's
+            // until an access point says where it is).
+            let mut mcc = Out::default();
+            mcc.u16(u16::from_be_bytes(*b"ZZ")).u8(MCC_SOURCE_GET_CURRENT).u8(0).u32(0).zeros(20);
+            if let Err(error) = self.command(0, MCC_UPDATE_CMD, &mcc.0) {
+                ostd::info!("{}: region: {}", self.name, error);
+            }
+        }
+        let scan_config = Out::default().u8(0).u8(0).u8(0).u8(0).u32(self.tx_ant as u32).u32(self.rx_ant as u32).0.clone();
+        self.command(0, SCAN_CFG_CMD, &scan_config)?;
+        self.mac_context(FW_CTXT_ACTION_ADD)?;
+        self.mac_added = true;
+        Ok(())
+    }
+
+    /// The AX210 family's platform NVM data: the part of the `.pnvm` file
+    /// for this card's SKU (from ALIVE), then the doorbell, then the
+    /// firmware's word that it took it. Without the file the firmware runs
+    /// on its own defaults.
+    fn load_pnvm(&mut self, alive: &[u8], prefix: &str) -> Result<(), String> {
+        let sku = [le32(alive, 116), le32(alive, 120), le32(alive, 124)];
+        if sku == [0; 3] {
+            return Ok(());
+        }
+        let mut data = Vec::new();
+        let files = ids::pnvm_files(prefix);
+        match aster_firmware::load_first(files.iter().map(String::as_str)) {
+            Some((file_name, file)) => {
+                match fw::pnvm_data(&file, sku, ids::mac_type(self.trans.hw_rev), ids::rf_type(self.trans.hw_rf_id)) {
+                    Some(found) => {
+                        ostd::info!("{}: platform NVM data from {} ({} bytes)", self.name, file_name, found.len());
+                        data = found;
+                    }
+                    None => ostd::info!("{}: {} has nothing for this card", self.name, file_name),
+                }
+            }
+            None => ostd::info!("{}: no {} in /lib/firmware", self.name, files[0]),
+        }
+        self.trans.load_pnvm(&data).map_err(|error| format!("platform NVM data: {error:?}"))?;
+        if let Err(error) = self.notification(REGULATORY, PNVM_INIT_COMPLETE_NTFY, COMMAND_TIMEOUT_MS) {
+            ostd::info!("{}: platform NVM data: {}", self.name, error);
+        }
+        Ok(())
+    }
+
+    /// What this card is for the Wi-Fi component.
+    pub(crate) fn info(&self) -> Info {
+        let rx_streams = self.rx_ant.count_ones().clamp(1, 2) as usize;
+        let ht = self.ht.then(|| {
+            let mut mcs = [0u8; 16];
+            for stream in 0..rx_streams {
+                mcs[stream] = 0xff;
+            }
+            // The transmit MCS set is the receive one.
+            mcs[12] = 0x01;
+            // 20 MHz only, short GI at 20 MHz, static SM power save off,
+            // one receive STBC stream.
+            HtCap { info: 0x000c | 0x0020 | 0x0100, ampdu_factor: 3, ampdu_density: 5, mcs }
+        });
+        let mut bands = Vec::new();
+        if self.band_24 {
+            bands.push(Band { id: BandId::Ghz2, channels: channels(BandId::Ghz2), ht, vht: None, he: None });
+        }
+        if self.band_52 {
+            bands.push(Band { id: BandId::Ghz5, channels: channels(BandId::Ghz5), ht, vht: None, he: None });
+        }
+        Info {
+            driver: String::from("iwlwifi"),
+            address: self.address,
+            bands,
+            ciphers: vec![radio::CIPHER_CCMP, radio::CIPHER_GCMP, radio::CIPHER_GCMP_256, radio::CIPHER_CCMP_256],
+            max_scan_ssids: PROBE_OPTION_MAX as u8,
+            max_scan_ie_len: 300,
+        }
+    }
+
+    // ---- Contexts. ----
+
+    /// The MAC context (`struct iwl_mac_ctx_cmd`, 148 bytes): the station,
+    /// its network when there is one, associated or not.
+    fn mac_context(&mut self, action: u32) -> Result<(), String> {
+        let network = self.network.clone();
+        let bssid = network.as_ref().map_or(wifi::BROADCAST, |network| network.bssid);
+        let ghz2 = network.as_ref().is_none_or(|network| BandId::of(network.freq) == BandId::Ghz2);
+        let mut out = Out::default();
+        out.u32(0).u32(action).u32(FW_MAC_TYPE_BSS_STA).u32(0);
+        out.bytes(&self.address).u16(0).bytes(&bssid).u16(0);
+        // Basic rates: CCK 1, 2, 5.5 and 11 Mbit/s on 2.4 GHz; OFDM 6, 12
+        // and 24.
+        out.u32(if ghz2 { 0x0f } else { 0 }).u32(0x15);
+        out.u32(0);
+        let capability = network.as_ref().map_or(0, |network| network.capability);
+        out.u32(if capability & wifi::CAP_SHORT_PREAMBLE != 0 { MAC_FLG_SHORT_PREAMBLE } else { 0 });
+        out.u32(if capability & wifi::CAP_SHORT_SLOT != 0 || !ghz2 { MAC_FLG_SHORT_SLOT } else { 0 });
+        let mut filter = MAC_FILTER_ACCEPT_GRP;
+        if !self.associated {
+            filter |= MAC_FILTER_IN_BEACON;
+        }
+        out.u32(filter);
+        let ht = network.as_ref().is_some_and(|network| network.ht_mcs.is_some());
+        out.u32(MAC_QOS_FLG_UPDATE_EDCA | if ht && self.associated { MAC_QOS_FLG_TGN } else { 0 });
+        // EDCA by the firmware's AC order (BK, BE, VI, VO): the defaults,
+        // each on its FIFO (gen2: BK 1, BE 2, VI 3, VO 4).
+        for (cw_min, cw_max, aifsn, fifo, txop) in [(15u16, 1023u16, 7u8, 1u8, 0u16), (15, 1023, 3, 2, 0), (7, 15, 2, 3, 3008), (3, 7, 2, 4, 1504)] {
+            out.u16(cw_min).u16(cw_max).u8(aifsn).u8(1 << fifo).u16(txop);
+        }
+        out.zeros(8);
+        // The station's part of the union (48 bytes).
+        let (interval, dtim) = network.as_ref().map_or((0, 1), |network| (network.beacon_interval as u32, network.dtim_period.max(1) as u32));
+        out.u32(self.associated as u32).u32(0).u64(0).u32(interval).u32(0).u32(interval * dtim).u32(0).u32(1);
+        out.u32(if self.associated { self.aid as u32 } else { 0 }).u32(0);
+        out.zeros(4);
+        debug_assert_eq!(out.0.len(), 148);
+        self.command(0, MAC_CONTEXT_CMD, &out.0).map(|_| ())
+    }
+
+    fn lmac_id(&self, freq: u16) -> u32 {
+        if self.cdb && BandId::of(freq) != BandId::Ghz2 { 1 } else { 0 }
+    }
+
+    /// The PHY context on the network's channel, 20 MHz.
+    fn phy_context(&mut self, action: u32, freq: u16) -> Result<(), String> {
+        let band = if BandId::of(freq) == BandId::Ghz2 { PHY_BAND_24 } else { PHY_BAND_5 };
+        let channel = channel_number(freq);
+        let mut out = Out::default();
+        out.u32(0).u32(action);
+        if self.uhb {
+            out.u32(channel as u32).u8(band).u8(0).u8(0).u8(0);
+        } else {
+            out.u8(band).u8(channel).u8(0).u8(0).zeros(4);
+        }
+        out.u32(self.lmac_id(freq));
+        let chains = self.rx_ant.count_ones().clamp(1, 2);
+        out.u32(((self.rx_ant as u32) << PHY_RX_CHAIN_VALID_POS) | (chains << PHY_RX_CHAIN_CNT_POS) | (chains << PHY_RX_CHAIN_MIMO_CNT_POS));
+        out.u32(0).u8(0).zeros(3);
+        self.command(0, PHY_CONTEXT_CMD, &out.0).map(|_| ())
+    }
+
+    fn binding(&mut self, action: u32, freq: u16) -> Result<(), String> {
+        let mut out = Out::default();
+        out.u32(0).u32(action).u32(0).u32(FW_CTXT_INVALID).u32(FW_CTXT_INVALID).u32(0).u32(self.lmac_id(freq));
+        self.command_status(0, BINDING_CONTEXT_CMD, &out.0, 0)
+    }
+
+    /// The access point's station (`struct iwl_mvm_add_sta_cmd`, 48
+    /// bytes): added, or changed once associated.
+    fn station(&mut self, modify: bool) -> Result<(), String> {
+        let network = self.network.clone().unwrap_or_default();
+        let mut flags = 0;
+        if self.associated && let Some(mcs) = network.ht_mcs {
+            flags |= STA_FLG_MAX_AGG_SIZE_64K | ((network.ampdu_density as u32 & 7) << STA_FLG_AGG_MPDU_DENS_SHIFT);
+            if mcs[1] != 0 && self.rx_ant.count_ones() >= 2 && self.tx_ant.count_ones() >= 2 {
+                flags |= STA_FLG_MIMO_EN_MIMO2;
+            }
+        }
+        let mut out = Out::default();
+        out.u8(modify as u8).u8(0).u16(0xffff).u32(0).bytes(&network.bssid).u16(0);
+        out.u8(0).u8(0).u16(0).u32(flags).u32(STA_FLG_FAT_EN_MSK | STA_FLG_MIMO_EN_MSK | STA_FLG_RTS_MIMO_PROT);
+        out.u8(0).u8(0).u16(0).u16(0).u8(0);
+        // A link station.
+        out.u8(0).u16(if self.associated { self.aid } else { 0 }).u16(0).u32(0).u16(0).u8(0).u8(0);
+        self.command_status(0, ADD_STA, &out.0, ADD_STA_SUCCESS)
+    }
+
+    /// A queue of the access point's station for `tid`: its memory, then
+    /// the firmware's number for it.
+    fn add_queue(&mut self, tid: u8) -> Result<TxQueue, String> {
+        let mut queue = self.trans.new_tx_queue().map_err(|error| format!("queue memory: {error:?}"))?;
+        let mut out = Out::default();
+        out.u32(0).u32(1).u8(tid).zeros(3).u32(0).u32(TX_QUEUE_SIZE.ilog2() - 3).u64(queue.counts_address()).u64(queue.tfds_address());
+        let answer = self.command(DATA_PATH, SCD_QUEUE_CONFIG_CMD, &out.0)?;
+        if answer.len() < 6 {
+            return Err(String::from("the firmware gave no queue"));
+        }
+        self.trans.tx_queue_started(&mut queue, le16(&answer, 0), le16(&answer, 4));
+        Ok(queue)
+    }
+
+    fn remove_queue(&mut self, tid: u8) {
+        let mut out = Out::default();
+        out.u32(1).u32(1).u32(tid as u32).zeros(24);
+        let _ = self.command(DATA_PATH, SCD_QUEUE_CONFIG_CMD, &out.0);
+    }
+
+    fn session_protection(&mut self, action: u32) -> Result<(), String> {
+        let mut out = Out::default();
+        out.u32(0).u32(action).u32(SESSION_PROTECT_CONF_ASSOC).u32(SESSION_PROTECTION_TU).u32(1).u32(0);
+        self.command(MAC_CONF, SESSION_PROTECTION_CMD, &out.0).map(|_| ())
+    }
+
+    /// The firmware's rate control for the access point (`struct
+    /// iwl_tlc_config_cmd_v4`): the legacy rates of the band, and MCS 0 to 7
+    /// on each stream both sides have, at 20 MHz.
+    fn rate_control(&mut self) -> Result<(), String> {
+        let network = self.network.clone().unwrap_or_default();
+        let ghz2 = BandId::of(network.freq) == BandId::Ghz2;
+        let legacy: u16 = if ghz2 { 0x0fff } else { 0x0ff0 };
+        let mut out = Out::default();
+        out.u8(0).zeros(3).u8(0);
+        let mut ht_rates = [[0u16; 3]; 2];
+        let mode = match network.ht_mcs {
+            Some(mcs) if self.ht => {
+                let streams = (self.tx_ant.count_ones() as usize).clamp(1, 2);
+                for stream in 0..streams {
+                    if mcs[stream] != 0 {
+                        ht_rates[stream][0] = mcs[stream] as u16;
+                    }
+                }
+                1
+            }
+            _ => 0,
+        };
+        out.u8(mode).u8(self.tx_ant & 3).u8(if network.ht_short_gi { 1 } else { 0 }).u16(0).u16(legacy);
+        for stream in ht_rates {
+            for width in stream {
+                out.u16(width);
+            }
+        }
+        out.u16(3839).u16(0);
+        self.command(DATA_PATH, TLC_MNG_CONFIG_CMD, &out.0).map(|_| ())
+    }
+
+    fn mac_power(&mut self) -> Result<(), String> {
+        // Power management off; the access point is kept alive every 25 s.
+        let mut out = Out::default();
+        out.u32(0).u16(0).u16(25).zeros(32);
+        self.command(0, MAC_PM_POWER_TABLE, &out.0).map(|_| ())
+    }
+
+    // ---- The radio's operations. ----
+
+    pub(crate) fn scan(&mut self, request: &ScanRequest) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        if self.scanning {
+            return Err(radio::Error::Busy);
+        }
+        let freqs: Vec<u16> = request
+            .freqs
+            .iter()
+            .copied()
+            .filter(|&freq| match BandId::of(freq) {
+                BandId::Ghz2 => self.band_24,
+                BandId::Ghz5 => self.band_52,
+                BandId::Ghz6 => false,
+            })
+            .filter(|&freq| channel_number(freq) != 0)
+            .take(self.scan_channels)
+            .collect();
+        if freqs.is_empty() {
+            return Err(radio::Error::Invalid);
+        }
+        let command = self.scan_request(request, &freqs);
+        if let Err(error) = self.command(LONG, SCAN_REQ_UMAC, &command) {
+            ostd::warn!("{}: scan: {}", self.name, error);
+            return Err(radio::Error::Failed);
+        }
+        self.scanning = true;
+        Ok(())
+    }
+
+    /// `struct iwl_scan_req_umac_v17` as version 15 takes it (1940 bytes).
+    fn scan_request(&self, request: &ScanRequest, freqs: &[u16]) -> Vec<u8> {
+        let ssids: Vec<&Vec<u8>> = request.ssids.iter().take(PROBE_OPTION_MAX).collect();
+        let mut flags = SCAN_GEN_FLAGS_PASS_ALL | SCAN_GEN_FLAGS_ADAPTIVE_DWELL;
+        if ssids.is_empty() {
+            flags |= SCAN_GEN_FLAGS_FORCE_PASSIVE;
+        } else if ssids.len() == 1 && !ssids[0].is_empty() {
+            flags |= SCAN_GEN_FLAGS_USE_ALL_RX_CHAINS;
+        }
+        // Linux's timing for a scan without a link, and the wild one with.
+        let (max_out, suspend) = if self.associated { (120u32, 30u32) } else { (0, 0) };
+        let budget: u16 = if ssids.len() == 1 && !ssids[0].is_empty() { 100 } else { 300 };
+        let mut out = Out::default();
+        // uid, out-of-channel priority.
+        out.u32(0).u32(6);
+        // General parameters (36 bytes).
+        out.u16(flags).u8(0).u8(0).u8(10).u8(10).u8(2).u8(8).u8(10).u8(0).u16(budget);
+        out.u32(max_out).u32(max_out).u32(suspend).u32(suspend).u32(6).u8(110).u8(110).u8(0).u8(0);
+        // Channel parameters (540 bytes): each channel probes for all the
+        // names (bit i: the i-th of `direct_scan`).
+        let bitmap: u32 = if ssids.is_empty() { 0 } else { (1u32 << ssids.len()) - 1 };
+        out.u8(SCAN_CHANNEL_FLAG_ENABLE_CHAN_ORDER).u8(freqs.len() as u8).u8(10).u8(2);
+        for index in 0..SCAN_MAX_CHANNELS {
+            match freqs.get(index) {
+                Some(&freq) => {
+                    let band = if BandId::of(freq) == BandId::Ghz2 { PHY_BAND_24 } else { PHY_BAND_5 };
+                    out.u32(bitmap).u8(channel_number(freq)).u8(band).u8(1).u8(0);
+                }
+                None => {
+                    out.zeros(8);
+                }
+            }
+        }
+        // Periodic parameters: one iteration, now.
+        out.u16(0).u8(1).u8(0).zeros(4).u16(0).u16(0);
+        // Probe parameters: the template, then the names.
+        let (template, segments) = self.probe_template(&request.elements);
+        for (offset, length) in segments {
+            out.u16(offset).u16(length);
+        }
+        let mut buffer = template;
+        buffer.resize(PROBE_TEMPLATE, 0);
+        out.bytes(&buffer);
+        out.u8(0).u8(0).u16(0);
+        for index in 0..PROBE_OPTION_MAX {
+            match ssids.get(index) {
+                Some(ssid) => {
+                    let mut entry = [0u8; 34];
+                    entry[1] = ssid.len().min(32) as u8;
+                    entry[2..2 + ssid.len().min(32)].copy_from_slice(&ssid[..ssid.len().min(32)]);
+                    out.bytes(&entry);
+                }
+                None => {
+                    out.zeros(34);
+                }
+            }
+        }
+        out.zeros(8 * 4 + 16 * 6);
+        debug_assert_eq!(out.0.len(), 1940);
+        out.0
+    }
+
+    /// The probe request the firmware sends (`struct iwl_scan_probe_req`):
+    /// the header and an empty name (the firmware puts each name in), the
+    /// 2.4 GHz part (rates, DS parameters, HT), the 5 GHz part (rates, HT),
+    /// none for 6 GHz, and the supplicant's elements. Returns the bytes and
+    /// the five segments (header, three bands, common).
+    fn probe_template(&self, common: &[u8]) -> (Vec<u8>, [(u16, u16); 5]) {
+        let mut buf = wifi::probe_request(&self.address, &[], &[], &[]);
+        // Just the header and the empty name element.
+        buf.truncate(wifi::HEADER + 2);
+        let header = (0u16, buf.len() as u16);
+        let ht = self.info().bands.first().and_then(|band| band.ht);
+        let band_part = |buf: &mut Vec<u8>, rates: &[u8], ds: bool| -> (u16, u16) {
+            let start = buf.len();
+            wifi::put_rates(buf, rates);
+            if ds {
+                wifi::put_element(buf, wifi::IE_DS_PARAMS, &[0]);
+            }
+            if let Some(ht) = ht {
+                wifi::put_element(buf, wifi::IE_HT_CAP, &ht.element());
+            }
+            (start as u16, (buf.len() - start) as u16)
+        };
+        let ghz2 = band_part(&mut buf, BandId::Ghz2.rates(), true);
+        let ghz5 = band_part(&mut buf, BandId::Ghz5.rates(), false);
+        let ghz6 = (buf.len() as u16, 0);
+        let room = PROBE_TEMPLATE.saturating_sub(buf.len());
+        let common = &common[..common.len().min(room)];
+        let shared = (buf.len() as u16, common.len() as u16);
+        buf.extend_from_slice(common);
+        (buf, [header, ghz2, ghz5, ghz6, shared])
+    }
+
+    pub(crate) fn abort_scan(&mut self) {
+        if self.scanning {
+            let _ = self.command(LONG, SCAN_ABORT_UMAC, &Out::default().u32(0).u32(0).0);
+        }
+    }
+
+    pub(crate) fn join(&mut self, join: &Join) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        self.leave();
+        let elements = wifi::Elements(&join.elements);
+        let ht_cap = elements.get(wifi::IE_HT_CAP).filter(|value| value.len() >= 26);
+        let network = Network {
+            bssid: join.bssid,
+            freq: join.freq,
+            beacon_interval: join.beacon_interval.max(1),
+            // The TIM element: count, period, ...
+            dtim_period: elements.get(5).and_then(|value| value.get(1).copied()).unwrap_or(1).max(1),
+            capability: join.capability,
+            ht_mcs: ht_cap.map(|value| {
+                let mut mcs = [0u8; 16];
+                mcs.copy_from_slice(&value[3..19]);
+                mcs
+            }),
+            ht_short_gi: ht_cap.is_some_and(|value| u16::from_le_bytes([value[0], value[1]]) & 0x0020 != 0),
+            ampdu_density: ht_cap.map_or(0, |value| (value[2] >> 2) & 7),
+        };
+        self.network = Some(network);
+        let result = self.join_steps(join.freq);
+        if let Err(error) = &result {
+            ostd::warn!("{}: joining {}: {}", self.name, Hex(&join.bssid), error);
+            self.leave();
+            return Err(radio::Error::Failed);
+        }
+        Ok(())
+    }
+
+    fn join_steps(&mut self, freq: u16) -> Result<(), String> {
+        self.phy_context(FW_CTXT_ACTION_ADD, freq)?;
+        self.phy_added = true;
+        self.binding(FW_CTXT_ACTION_ADD, freq)?;
+        self.binding_added = true;
+        self.mac_context(FW_CTXT_ACTION_MODIFY)?;
+        self.station(false)?;
+        self.station_added = true;
+        let management = self.add_queue(IWL_MGMT_TID)?;
+        self.management_queue = Some(management);
+        let data = self.add_queue(0)?;
+        self.data_queue = Some(data);
+        self.session_protection(FW_CTXT_ACTION_ADD)?;
+        Ok(())
+    }
+
+    pub(crate) fn associated(&mut self, association: &Association) -> radio::Result<()> {
+        if self.network.is_none() {
+            return Err(radio::Error::Invalid);
+        }
+        self.associated = true;
+        self.aid = association.aid & 0x3fff;
+        self.qos = association.qos;
+        // The association response's HT capabilities are the ones that
+        // count.
+        if let Some(value) = wifi::Elements(&association.elements).get(wifi::IE_HT_CAP).filter(|value| value.len() >= 26)
+            && let Some(network) = self.network.as_mut()
+        {
+            let mut mcs = [0u8; 16];
+            mcs.copy_from_slice(&value[3..19]);
+            network.ht_mcs = Some(mcs);
+            network.ht_short_gi = u16::from_le_bytes([value[0], value[1]]) & 0x0020 != 0;
+            network.ampdu_density = (value[2] >> 2) & 7;
+        }
+        let result = (|| {
+            self.mac_context(FW_CTXT_ACTION_MODIFY)?;
+            self.station(true)?;
+            self.mac_power()?;
+            self.rate_control()?;
+            let _ = self.session_protection(FW_CTXT_ACTION_REMOVE);
+            Ok::<(), String>(())
+        })();
+        if let Err(error) = result {
+            ostd::warn!("{}: association: {}", self.name, error);
+            self.associated = false;
+            return Err(radio::Error::Failed);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn leave(&mut self) {
+        let Some(network) = self.network.clone() else { return };
+        let was_associated = self.associated;
+        self.associated = false;
+        self.pairwise = None;
+        if !self.dead {
+            if self.data_queue.take().is_some() {
+                self.remove_queue(0);
+            }
+            if self.management_queue.take().is_some() {
+                self.remove_queue(IWL_MGMT_TID);
+            }
+            if self.station_added {
+                let _ = self.command(0, REMOVE_STA, &[0, 0, 0, 0]);
+            }
+            if was_associated {
+                let _ = self.session_protection(FW_CTXT_ACTION_REMOVE);
+            }
+            self.network = None;
+            let _ = self.mac_context(FW_CTXT_ACTION_MODIFY);
+            if self.binding_added {
+                let _ = self.binding(FW_CTXT_ACTION_REMOVE, network.freq);
+            }
+            if self.phy_added {
+                let _ = self.phy_context(FW_CTXT_ACTION_REMOVE, network.freq);
+            }
+        }
+        self.network = None;
+        self.data_queue = None;
+        self.management_queue = None;
+        self.station_added = false;
+        self.binding_added = false;
+        self.phy_added = false;
+        self.signal = None;
+    }
+
+    pub(crate) fn set_key(&mut self, key: &Key) -> radio::Result<()> {
+        let flags = match key.cipher {
+            radio::CIPHER_CCMP | radio::CIPHER_CCMP_256 => STA_KEY_FLG_CCM,
+            radio::CIPHER_GCMP | radio::CIPHER_GCMP_256 => STA_KEY_FLG_GCMP,
+            _ => return Err(radio::Error::Unsupported),
+        };
+        if key.key.len() > 32 || key.index > 3 {
+            return Err(radio::Error::Invalid);
+        }
+        let mut flags = flags | ((key.index as u16) << STA_KEY_FLG_KEYID_POS);
+        if key.key.len() == 32 {
+            flags |= STA_KEY_FLG_KEY_32BYTES;
+        }
+        if !key.pairwise {
+            flags |= STA_KEY_MULTICAST;
+        }
+        let mut material = [0u8; 32];
+        material[..key.key.len()].copy_from_slice(&key.key);
+        // The pairwise key at offset 0, the group's at their index.
+        let offset = if key.pairwise { 0 } else { key.index.max(1) };
+        let mut out = Out::default();
+        out.u8(0).u8(offset).u16(flags).bytes(&material).zeros(16).u64(0).u64(0).u64(0);
+        if let Err(error) = self.command_status(0, ADD_STA_KEY, &out.0, ADD_STA_SUCCESS) {
+            ostd::warn!("{}: key: {}", self.name, error);
+            return Err(radio::Error::Failed);
+        }
+        if key.pairwise {
+            self.pairwise = Some(PairwiseKey { index: key.index, pn: 1 });
+        }
+        Ok(())
+    }
+
+    pub(crate) fn remove_key(&mut self, index: u8, pairwise: bool) {
+        let offset = if pairwise { 0 } else { index.max(1) };
+        let mut flags = STA_KEY_NOT_VALID | ((index as u16) << STA_KEY_FLG_KEYID_POS);
+        if !pairwise {
+            flags |= STA_KEY_MULTICAST;
+        }
+        let mut out = Out::default();
+        out.u8(0).u8(offset).u16(flags).zeros(32 + 16 + 24);
+        let _ = self.command(0, ADD_STA_KEY, &out.0);
+        if pairwise {
+            self.pairwise = None;
+        }
+    }
+
+    // ---- Frames. ----
+
+    /// Puts the cipher's header (CCMP and GCMP share it) after the 802.11
+    /// header, with the pairwise key's next packet number.
+    fn insert_cipher_header(&mut self, frame: &mut Vec<u8>) -> bool {
+        let Some(key) = self.pairwise.as_mut() else { return false };
+        let pn = key.pn;
+        key.pn += 1;
+        let at = header_len(frame);
+        let header = [pn as u8, (pn >> 8) as u8, 0, 0x20 | (key.index << 6), (pn >> 16) as u8, (pn >> 24) as u8, (pn >> 32) as u8, (pn >> 40) as u8];
+        drop(frame.splice(at..at, header));
+        true
+    }
+
+    fn next_sequence(&mut self, frame: &mut [u8]) {
+        let qos = wifi::is_data(frame) && frame[0] & 0x80 != 0;
+        let slot = if qos { (frame.get(header_len(frame).saturating_sub(2)).copied().unwrap_or(0) & 0x0f) as usize } else { 16 };
+        let sequence = self.sequence[slot];
+        self.sequence[slot] = (sequence + 1) & 0x0fff;
+        if frame.len() >= 24 {
+            frame[22..24].copy_from_slice(&(sequence << 4).to_le_bytes());
+        }
+    }
+
+    /// Sends an 802.11 frame on a queue of the access point's station.
+    fn transmit(&mut self, mut frame: Vec<u8>, data: bool, encrypt: bool) -> radio::Result<()> {
+        if self.dead {
+            return Err(radio::Error::Down);
+        }
+        let protected = frame.get(1).is_some_and(|flags| flags & wifi::PROTECTED != 0);
+        let encrypted = protected && encrypt && self.insert_cipher_header(&mut frame);
+        if protected && !encrypted {
+            // The Protected bit without a key: sent plain.
+            frame[1] &= !wifi::PROTECTED;
+        }
+        self.next_sequence(&mut frame);
+        let hdr = header_len(&frame);
+        let mut flags = if encrypted { 0 } else { IWL_TX_FLAGS_ENCRYPT_DIS };
+        if !data {
+            flags |= IWL_TX_FLAGS_HIGH_PRI;
+        }
+        let offload = ((hdr as u32 / 2) << TX_CMD_OFFLD_MH_SIZE) | if hdr % 4 != 0 { 1 << TX_CMD_OFFLD_PAD } else { 0 };
+        let queue = if data { self.data_queue.as_mut() } else { self.management_queue.as_mut() };
+        let Some(queue) = queue else { return Err(radio::Error::Down) };
+        let index = self.trans.tx_next_index(queue);
+        let mut bytes = Out::default();
+        bytes.u8(TX_CMD).u8(0).u16((((queue.id & 0x1f) as u16) << 8) | (index as u16 & 0xff));
+        if self.tx_cmd_v10 {
+            bytes.u16(frame.len() as u16).u16(flags as u16).u32(offload).zeros(8).u32(0).zeros(8);
+        } else {
+            bytes.u16(frame.len() as u16).u16(offload as u16).u32(flags).zeros(8).u32(0);
+        }
+        bytes.bytes(&frame[..hdr]);
+        let body_at = bytes.0.len().next_multiple_of(4);
+        bytes.0.resize(body_at, 0);
+        bytes.bytes(&frame[hdr..]);
