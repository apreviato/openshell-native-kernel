+    pub(crate) fn send_management(&mut self, frame: &[u8]) -> radio::Result<()> {
+        if frame.len() < wifi::HEADER {
+            return Err(radio::Error::Invalid);
+        }
+        self.transmit(frame.to_vec(), false, true)
+    }
+
+    pub(crate) fn send(&mut self, ethernet: &[u8], plain: bool) -> radio::Result<()> {
+        let Some(network) = self.network.as_ref() else { return Err(radio::Error::Down) };
