+/// The platform's crystal latency for the firmware (`SOC_CONFIGURATION`):
+/// microseconds, Linux's LTR delay code (200 us: 1, 2500 us: 2, 1820 us:
+/// 3) and whether the crystal is a low-latency one, by Linux's
+/// `iwl_mac_cfg` for each device number.
+pub(crate) fn soc_latency(mac: &Mac) -> (u32, u8, bool) {
+    match (mac.family, mac.integrated, mac.device) {
+        (_, false, _) => (if mac.family == Family::Ax210 { 500 } else { 0 }, 0, false),
+        (Family::Ax200, true, 0x34f0 | 0x3df0 | 0x4df0) => (1820, 3, false),
+        (Family::Ax200, true, 0x43f0 | 0xa0f0) => (12000, 2, true),
+        (Family::Ax210, true, 0x51f0 | 0x54f0 | 0x51f1) => (12000, 2, true),
+        _ => (500, 1, false),
+    }
+}
