+            body.to_vec()
+        };
+        let protected = frame[1] & wifi::PROTECTED != 0;
+        let security = (status >> 8) & 7;
+        let decrypted = protected && matches!(security, RX_STATUS_SEC_CCM | RX_STATUS_SEC_GCM) && status & RX_STATUS_MIC_OK != 0;
+        let energy = [energy_a, energy_b].into_iter().filter(|&energy| energy != 0).min().unwrap_or(127);
+        let signal = -(energy.min(127) as i16) as i8;
+        let freq = match channel {
+            1..=13 => 2407 + 5 * channel as u16,
+            14 => 2484,
+            _ => 5000 + 5 * channel as u16,
+        };
+        if let Some(network) = &self.network
+            && wifi::addresses(&frame).is_some_and(|(_, transmitter, _)| transmitter == network.bssid)
+        {
+            self.signal = Some(signal);
+        }
+        if let Some(device) = &self.device {
+            device.received(&frame, RxInfo { freq, signal, decrypted, security_header: if decrypted { 8 } else { 0 } });
+        }
+    }
+
+    pub(crate) fn link_stats(&self) -> LinkStats {
+        LinkStats { signal: self.signal, tx_rate: None }
+    }
+}
+
+/// An address for the log.
+struct Hex<'a>(&'a Address);
+
+impl core::fmt::Display for Hex<'_> {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        let a = self.0;
+        write!(f, "{:02x}:{:02x}:{:02x}:{:02x}:{:02x}:{:02x}", a[0], a[1], a[2], a[3], a[4], a[5])
+    }
+}
