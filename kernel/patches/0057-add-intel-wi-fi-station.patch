+        let flags2 = data[3];
+        let status = le32(data, 12);
+        if status & (RX_STATUS_CRC_OK | RX_STATUS_OVERRUN_OK) != (RX_STATUS_CRC_OK | RX_STATUS_OVERRUN_OK) {
+            return;
+        }
+        let (energy_a, energy_b, channel) = if self.ax210 { (data[40], data[41], data[42]) } else { (data[32], data[33], data[34]) };
+        let Some(body) = data.get(desc..(desc + length).min(data.len())) else { return };
