--- /dev/null
+++ b/kernel/core/src/process/posix_thread/seccomp.rs
@@ -0,0 +1,438 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Secure computing mode (seccomp).
+//!
+//! This module keeps the per-thread seccomp state and evaluates classic BPF
+//! filters against system calls. The filter semantics follow Linux:
+//! every installed filter runs for every system call and the most
+//! restrictive action wins.
+//!
+//! Reference: <https://elixir.bootlin.com/linux/v6.16.5/source/kernel/seccomp.c>
+
+use core::sync::atomic::{AtomicU32, Ordering};
+
+use crate::prelude::*;
+
+pub(crate) const SECCOMP_MODE_DISABLED: u32 = 0;
+pub(crate) const SECCOMP_MODE_STRICT: u32 = 1;
+pub(crate) const SECCOMP_MODE_FILTER: u32 = 2;
+
+pub(crate) const SECCOMP_RET_KILL_PROCESS: u32 = 0x8000_0000;
+pub(crate) const SECCOMP_RET_KILL_THREAD: u32 = 0x0000_0000;
+pub(crate) const SECCOMP_RET_TRAP: u32 = 0x0003_0000;
+pub(crate) const SECCOMP_RET_ERRNO: u32 = 0x0005_0000;
+pub(crate) const SECCOMP_RET_USER_NOTIF: u32 = 0x7fc0_0000;
+pub(crate) const SECCOMP_RET_TRACE: u32 = 0x7ff0_0000;
+pub(crate) const SECCOMP_RET_LOG: u32 = 0x7ffc_0000;
+pub(crate) const SECCOMP_RET_ALLOW: u32 = 0x7fff_0000;
+
+pub(crate) const SECCOMP_RET_ACTION_FULL: u32 = 0xffff_0000;
+pub(crate) const SECCOMP_RET_DATA: u32 = 0x0000_ffff;
+
+/// The maximum number of instructions in one classic BPF program.
+const BPF_MAXINSNS: usize = 4096;
+/// The maximum total size of all filters attached to one thread, in instructions.
+///
+/// Each filter additionally costs four instructions.
+const MAX_INSNS_PER_PATH: usize = (1 << 18) / size_of::<SockFilter>();
+/// The number of scratch memory slots of the classic BPF machine.
+const BPF_MEMWORDS: usize = 16;
+
+/// The size of `struct seccomp_data`.
+pub(crate) const SECCOMP_DATA_SIZE: usize = 64;
+
+/// A classic BPF instruction (`struct sock_filter`).
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Pod)]
+pub(crate) struct SockFilter {
+    code: u16,
+    jt: u8,
+    jf: u8,
+    k: u32,
+}
+
+/// The system call description that filters inspect (`struct seccomp_data`).
+pub(crate) struct SeccompData([u8; SECCOMP_DATA_SIZE]);
+
+impl SeccompData {
+    pub(crate) fn new(nr: i32, arch: u32, instruction_pointer: u64, args: &[u64; 6]) -> Self {
+        let mut bytes = [0u8; SECCOMP_DATA_SIZE];
+        bytes[0..4].copy_from_slice(&nr.to_ne_bytes());
+        bytes[4..8].copy_from_slice(&arch.to_ne_bytes());
+        bytes[8..16].copy_from_slice(&instruction_pointer.to_ne_bytes());
+        for (index, arg) in args.iter().enumerate() {
+            let start = 16 + index * 8;
+            bytes[start..start + 8].copy_from_slice(&arg.to_ne_bytes());
+        }
+        Self(bytes)
+    }
+
+    fn load_word(&self, offset: u32) -> u32 {
+        // The offset has been validated by `SeccompFilter::new`.
+        let offset = offset as usize;
+        u32::from_ne_bytes(self.0[offset..offset + 4].try_into().unwrap())
+    }
+}
+
+/// An installed seccomp filter, linked to the filters installed before it.
+pub(crate) struct SeccompFilter {
+    prev: Option<Arc<SeccompFilter>>,
+    program: Box<[SockFilter]>,
+    /// The cost of this filter and all of its ancestors.
+    total_cost: usize,
+}
+
+impl Drop for SeccompFilter {
+    fn drop(&mut self) {
+        // Unlink a long chain iteratively to keep the kernel stack usage bounded.
+        let mut prev = self.prev.take();
+        while let Some(filter) = prev {
+            match Arc::try_unwrap(filter) {
+                Ok(mut filter) => prev = filter.prev.take(),
+                Err(_) => break,
+            }
+        }
+    }
+}
+
+// Classic BPF instruction classes and fields.
+const BPF_LD: u16 = 0x00;
+const BPF_LDX: u16 = 0x01;
+const BPF_ST: u16 = 0x02;
+const BPF_STX: u16 = 0x03;
+const BPF_ALU: u16 = 0x04;
+const BPF_JMP: u16 = 0x05;
+const BPF_RET: u16 = 0x06;
+const BPF_MISC: u16 = 0x07;
+
+const BPF_W: u16 = 0x00;
+const BPF_IMM: u16 = 0x00;
+const BPF_ABS: u16 = 0x20;
+const BPF_MEM: u16 = 0x60;
+const BPF_LEN: u16 = 0x80;
+
+const BPF_ADD: u16 = 0x00;
+const BPF_SUB: u16 = 0x10;
+const BPF_MUL: u16 = 0x20;
+const BPF_DIV: u16 = 0x30;
+const BPF_OR: u16 = 0x40;
+const BPF_AND: u16 = 0x50;
+const BPF_LSH: u16 = 0x60;
+const BPF_RSH: u16 = 0x70;
+const BPF_NEG: u16 = 0x80;
+const BPF_XOR: u16 = 0xa0;
+
+const BPF_JA: u16 = 0x00;
+const BPF_JEQ: u16 = 0x10;
+const BPF_JGT: u16 = 0x20;
+const BPF_JGE: u16 = 0x30;
+const BPF_JSET: u16 = 0x40;
+
+const BPF_K: u16 = 0x00;
+const BPF_X: u16 = 0x08;
+const BPF_A: u16 = 0x10;
+
+const BPF_TAX: u16 = 0x00;
+const BPF_TXA: u16 = 0x80;
+
+const LD_W_ABS: u16 = BPF_LD | BPF_W | BPF_ABS;
+const LD_W_LEN: u16 = BPF_LD | BPF_W | BPF_LEN;
+const LDX_W_LEN: u16 = BPF_LDX | BPF_W | BPF_LEN;
+const LD_IMM: u16 = BPF_LD | BPF_IMM;
+const LDX_IMM: u16 = BPF_LDX | BPF_IMM;
+const LD_MEM: u16 = BPF_LD | BPF_MEM;
+const LDX_MEM: u16 = BPF_LDX | BPF_MEM;
+const RET_K: u16 = BPF_RET | BPF_K;
+const RET_A: u16 = BPF_RET | BPF_A;
+const MISC_TAX: u16 = BPF_MISC | BPF_TAX;
+const MISC_TXA: u16 = BPF_MISC | BPF_TXA;
+const ALU_NEG: u16 = BPF_ALU | BPF_NEG;
+const JMP_JA: u16 = BPF_JMP | BPF_JA;
+
+fn is_binary_alu(code: u16) -> bool {
+    code & 0x07 == BPF_ALU
+        && code & !(0x07 | 0x08 | 0xf0) == 0
+        && matches!(
+            code & 0xf0,
+            BPF_ADD | BPF_SUB | BPF_MUL | BPF_DIV | BPF_OR | BPF_AND | BPF_LSH | BPF_RSH | BPF_XOR
+        )
+}
+
+fn is_conditional_jump(code: u16) -> bool {
+    code & 0x07 == BPF_JMP
+        && code & !(0x07 | 0x08 | 0xf0) == 0
+        && matches!(code & 0xf0, BPF_JEQ | BPF_JGT | BPF_JGE | BPF_JSET)
+}
+
+impl SeccompFilter {
+    /// Checks the number of instructions of a new filter.
+    pub(crate) fn check_len(len: usize) -> Result<()> {
+        if len == 0 || len > BPF_MAXINSNS {
+            return_errno_with_message!(Errno::EINVAL, "invalid seccomp filter length");
+        }
+        Ok(())
+    }
+
+    /// Validates a program and links it after `prev`.
+    pub(crate) fn new(
+        program: Vec<SockFilter>,
+        prev: Option<Arc<SeccompFilter>>,
+    ) -> Result<Arc<Self>> {
+        Self::check_len(program.len())?;
+        Self::check_program(&program)?;
+
+        let prev_cost = prev.as_ref().map_or(0, |filter| filter.total_cost);
+        let total_cost = prev_cost + program.len() + 4;
+        if total_cost > MAX_INSNS_PER_PATH {
+            return_errno_with_message!(Errno::ENOMEM, "too many seccomp filter instructions");
+        }
+
+        Ok(Arc::new(Self {
+            prev,
+            program: program.into_boxed_slice(),
+            total_cost,
+        }))
+    }
+
+    fn check_program(program: &[SockFilter]) -> Result<()> {
+        let invalid = || Error::with_message(Errno::EINVAL, "invalid seccomp filter program");
+        let len = program.len();
+
+        // The scratch memory slots that are known to be initialized when reaching
+        // each instruction.
+        let mut masks = vec![u16::MAX; len];
+        let mut mem_valid = 0u16;
+
+        for (pc, insn) in program.iter().enumerate() {
+            mem_valid &= masks[pc];
+            let code = insn.code;
+            match code {
+                LD_W_ABS => {
+                    if insn.k as usize >= SECCOMP_DATA_SIZE || insn.k & 3 != 0 {
+                        return Err(invalid());
+                    }
+                }
+                LD_W_LEN | LDX_W_LEN | LD_IMM | LDX_IMM | RET_K | RET_A | MISC_TAX | MISC_TXA
+                | ALU_NEG => {}
+                LD_MEM | LDX_MEM => {
+                    if insn.k as usize >= BPF_MEMWORDS || mem_valid & (1 << insn.k) == 0 {
+                        return Err(invalid());
+                    }
+                }
+                BPF_ST | BPF_STX => {
+                    if insn.k as usize >= BPF_MEMWORDS {
+                        return Err(invalid());
+                    }
+                    mem_valid |= 1 << insn.k;
+                }
+                JMP_JA => {
+                    // The target must be a later instruction within the program.
+                    if insn.k as usize >= len - pc - 1 {
+                        return Err(invalid());
+                    }
+                    masks[pc + 1 + insn.k as usize] &= mem_valid;
+                    mem_valid = u16::MAX;
+                }
+                _ if is_conditional_jump(code) => {
+                    let jt = pc + 1 + insn.jt as usize;
+                    let jf = pc + 1 + insn.jf as usize;
+                    if jt >= len || jf >= len {
+                        return Err(invalid());
+                    }
+                    masks[jt] &= mem_valid;
+                    masks[jf] &= mem_valid;
+                    mem_valid = u16::MAX;
+                }
+                _ if is_binary_alu(code) => {
+                    if code & BPF_X == 0 {
+                        let op = code & 0xf0;
+                        if op == BPF_DIV && insn.k == 0 {
+                            return Err(invalid());
+                        }
+                        if (op == BPF_LSH || op == BPF_RSH) && insn.k >= 32 {
+                            return Err(invalid());
+                        }
+                    }
+                }
+                _ => return Err(invalid()),
+            }
+        }
+
+        // A program must end with a return so that it cannot fall off its end.
+        if !matches!(program[len - 1].code, RET_K | RET_A) {
+            return Err(invalid());
+        }
+        Ok(())
+    }
+
+    /// Runs this single program and returns the filter return value.
+    fn run_one(&self, data: &SeccompData) -> u32 {
+        let mut a = 0u32;
+        let mut x = 0u32;
+        let mut mem = [0u32; BPF_MEMWORDS];
+        let mut pc = 0usize;
+
+        // `check_program` guarantees that jumps only move forward and stay in
+        // bounds and that the last instruction returns, so the loop terminates.
+        loop {
+            let insn = &self.program[pc];
+            pc += 1;
+            let code = insn.code;
+            let k = insn.k;
+            match code {
+                LD_W_ABS => a = data.load_word(k),
+                LD_W_LEN => a = SECCOMP_DATA_SIZE as u32,
+                LDX_W_LEN => x = SECCOMP_DATA_SIZE as u32,
+                LD_IMM => a = k,
+                LDX_IMM => x = k,
+                LD_MEM => a = mem[k as usize],
+                LDX_MEM => x = mem[k as usize],
+                BPF_ST => mem[k as usize] = a,
+                BPF_STX => mem[k as usize] = x,
+                RET_K => return k,
+                RET_A => return a,
+                MISC_TAX => x = a,
+                MISC_TXA => a = x,
+                ALU_NEG => a = a.wrapping_neg(),
+                JMP_JA => pc += k as usize,
+                _ if code & 0x07 == BPF_JMP => {
+                    let operand = if code & BPF_X != 0 { x } else { k };
+                    let taken = match code & 0xf0 {
+                        BPF_JEQ => a == operand,
+                        BPF_JGT => a > operand,
+                        BPF_JGE => a >= operand,
+                        _ => a & operand != 0,
+                    };
+                    pc += if taken { insn.jt } else { insn.jf } as usize;
+                }
+                _ => {
+                    let operand = if code & BPF_X != 0 { x } else { k };
+                    a = match code & 0xf0 {
+                        BPF_ADD => a.wrapping_add(operand),
+                        BPF_SUB => a.wrapping_sub(operand),
+                        BPF_MUL => a.wrapping_mul(operand),
+                        BPF_DIV => {
+                            if operand == 0 {
+                                // Dividing by zero terminates the program with zero,
+                                // which is the most restrictive action.
+                                return SECCOMP_RET_KILL_THREAD;
+                            }
+                            a / operand
+                        }
+                        BPF_OR => a | operand,
+                        BPF_AND => a & operand,
+                        BPF_LSH => a.checked_shl(operand).unwrap_or(0),
+                        BPF_RSH => a.checked_shr(operand).unwrap_or(0),
+                        _ => a ^ operand,
+                    };
+                }
+            }
+        }
+    }
+
+    /// Runs this filter and all of its ancestors.
+    ///
+    /// Returns the return value with the most restrictive action.
+    pub(crate) fn run(&self, data: &SeccompData) -> u32 {
+        fn action_of(ret: u32) -> i32 {
+            (ret & SECCOMP_RET_ACTION_FULL) as i32
+        }
+
+        let mut result = SECCOMP_RET_ALLOW;
+        let mut current = Some(self);
+        while let Some(filter) = current {
+            let ret = filter.run_one(data);
+            if action_of(ret) < action_of(result) {
+                result = ret;
+            }
+            current = filter.prev.as_deref();
+        }
+        result
+    }
+
+    /// Returns the number of filters in the chain that ends with this filter.
+    pub(crate) fn chain_len(&self) -> usize {
+        let mut count = 1;
+        let mut current = self.prev.as_deref();
+        while let Some(filter) = current {
+            count += 1;
+            current = filter.prev.as_deref();
+        }
+        count
+    }
+
+    /// Returns whether `ancestor` is this filter or one of the filters before it.
+    fn has_ancestor(self: &Arc<Self>, ancestor: &Arc<SeccompFilter>) -> bool {
+        let mut current = Some(self);
+        while let Some(filter) = current {
+            if Arc::ptr_eq(filter, ancestor) {
+                return true;
+            }
+            current = filter.prev.as_ref();
+        }
+        false
+    }
+}
+
+/// The per-thread seccomp state.
+pub(crate) struct SeccompState {
+    mode: AtomicU32,
+    filter: SpinLock<Option<Arc<SeccompFilter>>>,
+}
+
+impl SeccompState {
+    pub(crate) fn new() -> Self {
+        Self {
+            mode: AtomicU32::new(SECCOMP_MODE_DISABLED),
+            filter: SpinLock::new(None),
+        }
+    }
+
+    /// Returns the current seccomp mode.
+    pub(crate) fn mode(&self) -> u32 {
+        self.mode.load(Ordering::Acquire)
+    }
+
+    /// Returns the most recently installed filter.
+    pub(crate) fn filter(&self) -> Option<Arc<SeccompFilter>> {
+        self.filter.lock().clone()
+    }
+
+    /// Enters the strict mode.
+    pub(crate) fn set_strict(&self) {
+        self.mode.store(SECCOMP_MODE_STRICT, Ordering::Release);
+    }
+
+    /// Replaces the filter chain and enters the filter mode.
+    pub(crate) fn set_filter(&self, filter: Arc<SeccompFilter>) {
+        let old = self.filter.lock().replace(filter);
+        self.mode.store(SECCOMP_MODE_FILTER, Ordering::Release);
+        // Drop the old chain outside the spin lock.
+        drop(old);
+    }
+
+    /// Copies the state of `parent` into this state.
+    ///
+    /// A new thread or process starts with the seccomp state of its creator.
+    pub(crate) fn inherit_from(&self, parent: &SeccompState) {
+        let filter = parent.filter();
+        let mode = parent.mode();
+        let old = core::mem::replace(&mut *self.filter.lock(), filter);
+        self.mode.store(mode, Ordering::Release);
+        drop(old);
+    }
+
+    /// Returns whether this state can be replaced by a filter chain that
+    /// extends `caller_filter` without lifting any restriction.
+    pub(crate) fn can_sync_to(&self, caller_filter: Option<&Arc<SeccompFilter>>) -> bool {
+        match self.mode() {
+            SECCOMP_MODE_DISABLED => true,
+            SECCOMP_MODE_FILTER => match (self.filter(), caller_filter) {
+                (None, _) => true,
+                (Some(own), Some(caller)) => caller.has_ancestor(&own),
+                (Some(_), None) => false,
+            },
+            _ => false,
+        }
+    }
+}
