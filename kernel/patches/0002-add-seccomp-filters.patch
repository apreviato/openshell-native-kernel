new file mode 100755
--- /dev/null
+++ b/kernel/core/src/syscall/seccomp.rs
@@ -0,0 +1,305 @@
+// SPDX-License-Identifier: MPL-2.0
+
+use ostd::{arch::cpu::context::UserContext, mm::VmIo, user::UserContextApi};
+
+use super::{SyscallArgument, SyscallReturn, arch};
+use crate::{
+    prelude::*,
+    security::lsm::hooks as lsm_hooks,
+    process::{
+        TermStatus,
+        credentials::capabilities::CapSet,
+        posix_thread::{
+            AsPosixThread, do_exit, do_exit_group,
+            seccomp::{
+                SECCOMP_MODE_DISABLED, SECCOMP_MODE_FILTER, SECCOMP_MODE_STRICT,
+                SECCOMP_RET_ACTION_FULL, SECCOMP_RET_ALLOW, SECCOMP_RET_DATA, SECCOMP_RET_ERRNO,
+                SECCOMP_RET_KILL_PROCESS, SECCOMP_RET_KILL_THREAD, SECCOMP_RET_LOG,
+                SECCOMP_RET_TRACE, SECCOMP_RET_TRAP, SECCOMP_RET_USER_NOTIF, SeccompData,
+                SeccompFilter, SockFilter,
+            },
+        },
+        signal::{
+            c_types::siginfo_t,
+            constants::{SIGKILL, SIGSYS},
+            sig_action::SigAction,
+            sig_num::SigNum,
+            signals::Signal,
+        },
+    },
+};
+
+const SECCOMP_SET_MODE_STRICT: u32 = 0;
+const SECCOMP_SET_MODE_FILTER: u32 = 1;
+const SECCOMP_GET_ACTION_AVAIL: u32 = 2;
+
+bitflags! {
+    struct SeccompFilterFlags: u32 {
+        const TSYNC = 1 << 0;
+        const LOG = 1 << 1;
+        const SPEC_ALLOW = 1 << 2;
+        const TSYNC_ESRCH = 1 << 4;
+    }
+}
+
+/// The `si_code` of a `SIGSYS` that is raised by a seccomp filter.
+const SYS_SECCOMP: i32 = 1;
+
+/// The largest errno value that `SECCOMP_RET_ERRNO` can report.
+const MAX_ERRNO: u32 = 4095;
+
+#[cfg(target_arch = "x86_64")]
+const AUDIT_ARCH: u32 = 0xc000_003e;
+#[cfg(target_arch = "riscv64")]
+const AUDIT_ARCH: u32 = 0xc000_00f3;
+#[cfg(target_arch = "aarch64")]
+const AUDIT_ARCH: u32 = 0xc000_00b7;
+#[cfg(target_arch = "loongarch64")]
+const AUDIT_ARCH: u32 = 0xc000_0102;
+
+pub(super) fn sys_seccomp(
+    operation: u32,
+    flags: u32,
+    uargs: Vaddr,
+    ctx: &Context,
+) -> Result<SyscallReturn> {
+    debug!(
+        "operation = {}, flags = {:#x}, uargs = {:#x}",
+        operation, flags, uargs
+    );
+
+    match operation {
+        SECCOMP_SET_MODE_STRICT => {
+            if flags != 0 || uargs != 0 {
+                return_errno_with_message!(Errno::EINVAL, "invalid strict seccomp arguments");
+            }
+            set_mode_strict(ctx)?;
+            Ok(SyscallReturn::Return(0))
+        }
+        SECCOMP_SET_MODE_FILTER => set_mode_filter(flags, uargs, ctx),
+        SECCOMP_GET_ACTION_AVAIL => {
+            if flags != 0 {
+                return_errno_with_message!(Errno::EINVAL, "invalid seccomp flags");
+            }
+            let action = ctx.user_space().read_val::<u32>(uargs)?;
+            match action {
+                SECCOMP_RET_KILL_PROCESS
+                | SECCOMP_RET_KILL_THREAD
+                | SECCOMP_RET_TRAP
+                | SECCOMP_RET_ERRNO
+                | SECCOMP_RET_LOG
+                | SECCOMP_RET_ALLOW => Ok(SyscallReturn::Return(0)),
+                _ => return_errno_with_message!(
+                    Errno::EOPNOTSUPP,
+                    "the seccomp action is not supported"
+                ),
+            }
+        }
+        _ => return_errno_with_message!(Errno::EINVAL, "unsupported seccomp operation"),
+    }
+}
+
+/// Handles `prctl(PR_GET_SECCOMP)`.
+pub(super) fn get_seccomp_mode(ctx: &Context) -> u32 {
+    ctx.posix_thread.seccomp().mode()
+}
+
+/// Handles `prctl(PR_SET_SECCOMP)`.
+pub(super) fn set_seccomp_mode(mode: u64, filter: Vaddr, ctx: &Context) -> Result<()> {
+    match mode {
+        mode if mode == SECCOMP_MODE_STRICT as u64 => set_mode_strict(ctx),
+        mode if mode == SECCOMP_MODE_FILTER as u64 => set_mode_filter(0, filter, ctx).map(|_| ()),
+        _ => return_errno_with_message!(Errno::EINVAL, "invalid seccomp mode"),
+    }
+}
+
+fn set_mode_strict(ctx: &Context) -> Result<()> {
+    let seccomp = ctx.posix_thread.seccomp();
+    match seccomp.mode() {
+        SECCOMP_MODE_DISABLED | SECCOMP_MODE_STRICT => {
+            seccomp.set_strict();
+            Ok(())
+        }
+        _ => return_errno_with_message!(Errno::EINVAL, "the seccomp mode cannot be changed"),
+    }
+}
+
+fn set_mode_filter(flags: u32, uargs: Vaddr, ctx: &Context) -> Result<SyscallReturn> {
+    let Some(flags) = SeccompFilterFlags::from_bits(flags) else {
+        return_errno_with_message!(Errno::EINVAL, "unsupported seccomp filter flags");
+    };
+    if flags.contains(SeccompFilterFlags::TSYNC_ESRCH) && !flags.contains(SeccompFilterFlags::TSYNC)
+    {
+        return_errno_with_message!(Errno::EINVAL, "TSYNC_ESRCH requires TSYNC");
+    }
+
+    // Read `struct sock_fprog`: a 16-bit length followed by an aligned pointer.
+    let user_space = ctx.user_space();
+    let len = user_space.read_val::<u16>(uargs)? as usize;
+    let insns_addr = user_space.read_val::<u64>(uargs + size_of::<u64>())? as Vaddr;
+    SeccompFilter::check_len(len)?;
+
+    // Installing a filter must not allow a process to confuse a more privileged
+    // program that it executes later.
+    let credentials = ctx.posix_thread.credentials();
+    if !credentials.no_new_privs() {
+        let has_sys_admin = lsm_hooks::on_capable(lsm_hooks::CapableContext::new(
+            ctx.thread_local.borrow_user_ns().as_ref(),
+            ctx.posix_thread,
+            CapSet::SYS_ADMIN,
+        ))
+        .is_ok();
+        if !has_sys_admin {
+            return_errno_with_message!(
+                Errno::EACCES,
+                "installing a seccomp filter requires no_new_privs or CAP_SYS_ADMIN"
+            );
+        }
+    }
+
+    let mut program = vec![SockFilter::new_zeroed(); len];
+    user_space.read_bytes(insns_addr, program.as_mut_slice().as_mut_bytes())?;
+
+    let seccomp = ctx.posix_thread.seccomp();
+    if seccomp.mode() == SECCOMP_MODE_STRICT {
+        return_errno_with_message!(Errno::EINVAL, "the seccomp mode cannot be changed");
+    }
+
+    if !flags.contains(SeccompFilterFlags::TSYNC) {
+        let filter = SeccompFilter::new(program, seccomp.filter())?;
+        seccomp.set_filter(filter);
+        return Ok(SyscallReturn::Return(0));
+    }
+
+    // Synchronize the new filter chain to all threads of the process. Holding the
+    // task set lock keeps new threads out until every thread has been updated.
+    let tasks = ctx.process.tasks().lock();
+    let caller_filter = seccomp.filter();
+    for task in tasks.as_slice() {
+        let posix_thread = task.as_posix_thread().unwrap();
+        if core::ptr::eq(posix_thread, ctx.posix_thread) {
+            continue;
+        }
+        if !posix_thread.seccomp().can_sync_to(caller_filter.as_ref()) {
+            if flags.contains(SeccompFilterFlags::TSYNC_ESRCH) {
+                return_errno_with_message!(Errno::ESRCH, "a thread has a diverging seccomp state");
+            }
+            return Ok(SyscallReturn::Return(posix_thread.tid() as isize));
+        }
+    }
+
+    let filter = SeccompFilter::new(program, caller_filter)?;
+    let no_new_privs = credentials.no_new_privs();
+    for task in tasks.as_slice() {
+        let posix_thread = task.as_posix_thread().unwrap();
+        if no_new_privs {
+            posix_thread.set_no_new_privs();
+        }
+        posix_thread.seccomp().set_filter(filter.clone());
+    }
+
+    Ok(SyscallReturn::Return(0))
+}
+
+/// The decision of seccomp for a system call.
+pub(super) enum SeccompVerdict {
+    /// The system call runs.
+    Allow,
+    /// The system call is skipped and fails with the error number.
+    Errno(i32),
+    /// The system call is skipped and the user registers stay untouched.
+    Skip,
+}
+
+/// Applies the seccomp state of the current thread to a system call.
+pub(super) fn check_syscall(
+    syscall: &SyscallArgument,
+    ctx: &Context,
+    user_ctx: &mut UserContext,
+) -> SeccompVerdict {
+    let seccomp = ctx.posix_thread.seccomp();
+    match seccomp.mode() {
+        SECCOMP_MODE_DISABLED => SeccompVerdict::Allow,
+        SECCOMP_MODE_STRICT => {
+            if matches!(
+                syscall.syscall_number,
+                arch::SYS_READ | arch::SYS_WRITE | arch::SYS_EXIT | arch::SYS_RT_SIGRETURN
+            ) {
+                return SeccompVerdict::Allow;
+            }
+            do_exit(TermStatus::Killed(SIGKILL), ctx, user_ctx);
+            SeccompVerdict::Skip
+        }
+        _ => {
+            let Some(filter) = seccomp.filter() else {
+                return SeccompVerdict::Allow;
+            };
+            let nr = syscall.syscall_number as i32;
+            let instruction_pointer = user_ctx.instruction_pointer();
+            let data = SeccompData::new(nr, AUDIT_ARCH, instruction_pointer as u64, &syscall.args);
+            let ret = filter.run(&data);
+            let data = ret & SECCOMP_RET_DATA;
+
+            match ret & SECCOMP_RET_ACTION_FULL {
+                SECCOMP_RET_ALLOW | SECCOMP_RET_LOG => SeccompVerdict::Allow,
+                SECCOMP_RET_ERRNO => SeccompVerdict::Errno(data.min(MAX_ERRNO) as i32),
+                // There is neither a tracer that handles seccomp events nor a
+                // user-space notification listener.
+                SECCOMP_RET_TRACE | SECCOMP_RET_USER_NOTIF => {
+                    SeccompVerdict::Errno(Errno::ENOSYS as i32)
+                }
+                SECCOMP_RET_TRAP => {
+                    // The system call does not happen, so the registers must stay as
+                    // they were at the system call entry for the signal handler.
+                    let is_blocked = ctx.posix_thread.sig_mask().contains(SIGSYS);
+                    let is_ignored = matches!(
+                        ctx.process.sig_dispositions().lock().lock().get(SIGSYS),
+                        SigAction::Ign
+                    );
+                    if is_blocked || is_ignored {
+                        // The signal is forced: a thread cannot continue past a
+                        // trapped system call by blocking or ignoring `SIGSYS`.
+                        do_exit_group(TermStatus::Killed(SIGSYS), ctx, user_ctx);
+                    } else {
+                        ctx.posix_thread.enqueue_signal(Box::new(SeccompSignal {
+                            call_addr: instruction_pointer,
+                            syscall: nr,
+                            errno: data as i32,
+                        }));
+                    }
+                    SeccompVerdict::Skip
+                }
+                SECCOMP_RET_KILL_THREAD => {
+                    do_exit(TermStatus::Killed(SIGSYS), ctx, user_ctx);
+                    SeccompVerdict::Skip
+                }
+                // `SECCOMP_RET_KILL_PROCESS` and unknown actions.
+                _ => {
+                    do_exit_group(TermStatus::Killed(SIGSYS), ctx, user_ctx);
+                    SeccompVerdict::Skip
+                }
+            }
+        }
+    }
+}
+
+/// The `SIGSYS` signal that reports a system call trapped by a seccomp filter.
+#[derive(Clone, Copy, Debug)]
+struct SeccompSignal {
+    call_addr: Vaddr,
+    syscall: i32,
+    errno: i32,
+}
+
+impl Signal for SeccompSignal {
+    fn num(&self) -> SigNum {
+        SIGSYS
+    }
+
+    fn to_info(&self) -> siginfo_t {
+        let mut info = siginfo_t::new(SIGSYS, SYS_SECCOMP);
+        info.si_errno = self.errno;
+        info.set_sigsys(self.call_addr, self.syscall, AUDIT_ARCH);
+        info
+    }
+}
