index 0000000..e9a095d
--- /dev/null
+++ b/kernel/comps/brcmfmac/src/chip.rs
@@ -0,0 +1,379 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The chip's backplane as Linux's brcmfmac `chip.c` sees it through PCIe:
+//! a 4 KiB window of BAR 0 moved over the backplane's addresses, the cores
+//! found in the enumeration ROM (AXI chips), their resets, the ARM core
+//! halted for the firmware's download and started after it, and the size
+//! of the RAM the firmware runs in.
+
+use alloc::vec::Vec;
+
+use aster_linuxkpi::io::Mmio;
+use aster_pci::PciDeviceLocation;
+
+use crate::{consts::*, delay_us};
+
+/// A core on the backplane: its registers and its wrapper's (the AXI
+/// agent that resets and clocks it).
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Core {
+    pub(crate) id: u16,
+    pub(crate) rev: u8,
+    pub(crate) base: u32,
+    pub(crate) wrap: u32,
+}
+
+/// BAR 0 and the configuration register that moves its window.
+pub(crate) struct Backplane {
+    pub(crate) location: PciDeviceLocation,
+    pub(crate) regs: Mmio,
+}
+
+impl Backplane {
+    /// `brcmf_pcie_buscore_prep_addr`: the window over `addr`'s 4 KiB.
+    fn window(&self, addr: u32) -> usize {
+        self.location.write32(PCIE_BAR0_WINDOW, addr & !(PCIE_BAR0_REG_SIZE - 1));
+        (addr & (PCIE_BAR0_REG_SIZE - 1)) as usize
+    }
+
+    pub(crate) fn read32(&self, addr: u32) -> u32 {
+        let at = self.window(addr);
+        self.regs.ioread32(at)
+    }
+
+    pub(crate) fn write32(&self, addr: u32, value: u32) {
+        let at = self.window(addr);
+        self.regs.iowrite32(at, value);
+    }
+
+    /// `brcmf_pcie_select_core`: the window over a core's registers, which
+    /// BAR 0's first 4 KiB then show.
+    pub(crate) fn select(&self, core: &Core) {
+        self.location.write32(PCIE_BAR0_WINDOW, core.base);
+        if self.location.read32(PCIE_BAR0_WINDOW) != core.base {
+            self.location.write32(PCIE_BAR0_WINDOW, core.base);
+        }
+    }
+}
+
+/// The chip: its number and revision, its cores, its RAM.
+pub(crate) struct Chip {
+    pub(crate) id: u32,
+    pub(crate) rev: u32,
+    pub(crate) cores: Vec<Core>,
+    pub(crate) rambase: u32,
+    pub(crate) ramsize: u32,
+}
+
+impl Chip {
+    /// `brcmf_chip_recognition`: the chip's identity and, from the
+    /// enumeration ROM, its cores.
+    pub(crate) fn recognize(bp: &Backplane) -> Result<Self, &'static str> {
+        let id = bp.read32(SI_ENUM_BASE + CC_CHIPID);
+        if id == u32::MAX {
+            return Err("the chip does not answer");
+        }
+        if (id >> CID_TYPE_SHIFT) & 0xf != SOCI_AI {
+            return Err("an SSB backplane (not driven over PCIe)");
+        }
+        let mut chip = Self { id: id & CID_ID_MASK, rev: (id >> CID_REV_SHIFT) & 0xf, cores: Vec::new(), rambase: 0, ramsize: 0 };
+        chip.scan_erom(bp);
+        let cpu = [CORE_ARM_CR4, CORE_ARM_CA7, CORE_ARM_CM3].iter().any(|id| chip.core(*id).is_some());
+        if !cpu {
+            return Err("no ARM core");
+        }
+        if chip.core(CORE_PCIE2).is_none() {
+            return Err("no PCIe Gen2 core");
+        }
+        Ok(chip)
+    }
+
+    pub(crate) fn core(&self, id: u16) -> Option<Core> {
+        self.cores.iter().find(|core| core.id == id).copied()
+    }
+
+    /// The chip's name as Linux prints it (`BCM4356/2`).
+    pub(crate) fn name(&self) -> alloc::string::String {
+        if self.id > 0xa000 || self.id < 0x4000 {
+            alloc::format!("BCM{}/{}", self.id, self.rev)
+        } else {
+            alloc::format!("BCM{:x}/{}", self.id, self.rev)
+        }
+    }
+
+    /// `brcmf_chip_dmp_erom_scan`.
+    fn scan_erom(&mut self, bp: &Backplane) {
+        let mut at = bp.read32(SI_ENUM_BASE + CC_EROMPTR);
+        // The ROM is a few hundred words; a broken one must not loop.
+        for _ in 0..4096 {
+            let (value, kind) = desc(bp, &mut at);
+            if kind == DMP_DESC_EOT {
+                break;
+            }
+            if value & DMP_DESC_VALID == 0 || kind != DMP_DESC_COMPONENT {
+                continue;
+            }
+            let id = ((value & DMP_COMP_PARTNUM) >> DMP_COMP_PARTNUM_S) as u16;
+            // The second word of a component descriptor.
+            let (value, _) = desc(bp, &mut at);
+            if value & DMP_DESC_TYPE_MSK != DMP_DESC_COMPONENT {
+                break;
+            }
+            let nmw = (value & DMP_COMP_NUM_MWRAP) >> DMP_COMP_NUM_MWRAP_S;
+            let nsw = (value & DMP_COMP_NUM_SWRAP) >> DMP_COMP_NUM_SWRAP_S;
+            let rev = ((value & DMP_COMP_REVISION) >> DMP_COMP_REVISION_S) as u8;
+            if nmw + nsw == 0 && id != CORE_PMU && id != CORE_GCI {
+                continue;
+            }
+            if let Some((base, wrap)) = regaddr(bp, &mut at) {
+                self.cores.push(Core { id, rev, base, wrap });
+            }
+        }
+    }
+
+    // ---- The AXI cores' resets (`brcmf_chip_ai_*`). ----
+
+    pub(crate) fn is_up(&self, bp: &Backplane, core: &Core) -> bool {
+        let ioctl = bp.read32(core.wrap + BCMA_IOCTL);
+        let reset = bp.read32(core.wrap + BCMA_RESET_CTL);
+        ioctl & (BCMA_IOCTL_FGC | BCMA_IOCTL_CLK) == BCMA_IOCTL_CLK && reset & BCMA_RESET_CTL_RESET == 0
+    }
+
+    pub(crate) fn disable(&self, bp: &Backplane, core: &Core, prereset: u32, reset: u32) {
+        if bp.read32(core.wrap + BCMA_RESET_CTL) & BCMA_RESET_CTL_RESET == 0 {
+            bp.write32(core.wrap + BCMA_IOCTL, prereset | BCMA_IOCTL_FGC | BCMA_IOCTL_CLK);
+            bp.read32(core.wrap + BCMA_IOCTL);
+            bp.write32(core.wrap + BCMA_RESET_CTL, BCMA_RESET_CTL_RESET);
+            delay_us(20);
+            for _ in 0..300 {
+                if bp.read32(core.wrap + BCMA_RESET_CTL) == BCMA_RESET_CTL_RESET {
+                    break;
+                }
+                delay_us(1);
+            }
+        }
+        bp.write32(core.wrap + BCMA_IOCTL, reset | BCMA_IOCTL_FGC | BCMA_IOCTL_CLK);
+        bp.read32(core.wrap + BCMA_IOCTL);
+    }
+
+    fn release(&self, bp: &Backplane, core: &Core) {
+        for _ in 0..50 {
+            if bp.read32(core.wrap + BCMA_RESET_CTL) & BCMA_RESET_CTL_RESET == 0 {
+                break;
+            }
+            bp.write32(core.wrap + BCMA_RESET_CTL, 0);
+            delay_us(60);
+        }
+    }
+
+    /// `brcmf_chip_ai_resetcore`: both 802.11 cores together when there
+    /// are two.
+    pub(crate) fn reset_core(&self, bp: &Backplane, core: &Core, prereset: u32, reset: u32, postreset: u32) {
+        let second = (core.id == CORE_80211).then(|| self.cores.iter().filter(|other| other.id == CORE_80211).nth(1).copied()).flatten();
+        self.disable(bp, core, prereset, reset);
+        if let Some(second) = &second {
+            self.disable(bp, second, prereset, reset);
+        }
+        self.release(bp, core);
+        if let Some(second) = &second {
+            self.release(bp, second);
+        }
+        bp.write32(core.wrap + BCMA_IOCTL, postreset | BCMA_IOCTL_CLK);
+        bp.read32(core.wrap + BCMA_IOCTL);
+        if let Some(second) = &second {
+            bp.write32(second.wrap + BCMA_IOCTL, postreset | BCMA_IOCTL_CLK);
+            bp.read32(second.wrap + BCMA_IOCTL);
+        }
+    }
+
+    fn arm(&self) -> Option<Core> {
+        self.core(CORE_ARM_CR4).or_else(|| self.core(CORE_ARM_CA7)).or_else(|| self.core(CORE_ARM_CM3))
+    }
+
+    /// `brcmf_chip_set_passive`: the ARM halted, the 802.11 cores held,
+    /// for the firmware's download.
+    pub(crate) fn set_passive(&self, bp: &Backplane) {
+        let Some(arm) = self.arm() else { return };
+        if arm.id == CORE_ARM_CM3 {
+            self.disable(bp, &arm, 0, 0);
+            if let Some(d11) = self.core(CORE_80211) {
+                self.reset_core(bp, &d11, D11_IOCTL_PHYRESET | D11_IOCTL_PHYCLOCKEN, D11_IOCTL_PHYCLOCKEN, D11_IOCTL_PHYCLOCKEN);
+            }
+            if let Some(ram) = self.core(CORE_INTERNAL_MEM) {
+                self.reset_core(bp, &ram, 0, 0, 0);
+            }
+            return;
+        }
+        // All IOCTL bits but the halt cleared, the CPU held halted.
+        let halt = bp.read32(arm.wrap + BCMA_IOCTL) & ARMCR4_IOCTL_CPUHALT;
+        self.reset_core(bp, &arm, halt, ARMCR4_IOCTL_CPUHALT, ARMCR4_IOCTL_CPUHALT);
+        if arm.id == CORE_ARM_CR4 {
+            // Disabled only: the firmware enables them (releasing them
+            // here breaks the BCM4387).
+            for d11 in self.cores.iter().filter(|core| core.id == CORE_80211) {
+                self.disable(bp, d11, D11_IOCTL_PHYRESET | D11_IOCTL_PHYCLOCKEN, D11_IOCTL_PHYCLOCKEN);
+            }
+        } else if let Some(d11) = self.core(CORE_80211) {
+            self.reset_core(bp, &d11, D11_IOCTL_PHYRESET | D11_IOCTL_PHYCLOCKEN, D11_IOCTL_PHYCLOCKEN, D11_IOCTL_PHYCLOCKEN);
+        }
+    }
+
+    /// `brcmf_chip_set_active` after the bus wrote the reset vector: the
+    /// ARM released.
+    pub(crate) fn set_active(&self, bp: &Backplane) -> bool {
+        let Some(arm) = self.arm() else { return false };
+        if arm.id == CORE_ARM_CM3 {
+            let Some(ram) = self.core(CORE_INTERNAL_MEM) else { return false };
+            if !self.is_up(bp, &ram) {
+                return false;
+            }
+            self.reset_core(bp, &arm, 0, 0, 0);
+        } else {
+            self.reset_core(bp, &arm, ARMCR4_IOCTL_CPUHALT, 0, 0);
+        }
+        true
+    }
+
+    /// `brcmf_chip_get_raminfo`: where the firmware's RAM is on the
+    /// backplane and how large.
+    pub(crate) fn read_raminfo(&mut self, bp: &Backplane) -> Result<(), &'static str> {
+        if let Some(cr4) = self.core(CORE_ARM_CR4) {
+            let cap = bp.read32(cr4.base + ARMCR4_CAP);
+            let banks = (cap & ARMCR4_TCBANB_MASK) + ((cap & ARMCR4_TCBBNB_MASK) >> ARMCR4_TCBBNB_SHIFT);
+            let mut size = 0;
+            for index in 0..banks {
+                bp.write32(cr4.base + ARMCR4_BANKIDX, index);
+                let info = bp.read32(cr4.base + ARMCR4_BANKINFO);
+                let block = if info & ARMCR4_BLK_1K_MASK != 0 { ARMCR4_BSZ_MULT >> 3 } else { ARMCR4_BSZ_MULT };
+                size += ((info & ARMCR4_BSZ_MASK) + 1) * block;
+            }
+            self.ramsize = size;
+            self.rambase = tcm_rambase(self.id, self.rev).ok_or("RAM base unknown for this ARM CR4 chip")?;
+        } else if let Some(sysmem) = self.core(CORE_SYS_MEM) {
+            if !self.is_up(bp, &sysmem) {
+                self.reset_core(bp, &sysmem, 0, 0, 0);
+            }
+            let info = bp.read32(sysmem.base + SOCRAM_COREINFO);
+            let banks = (info & SRCI_SRNB_MASK) >> SRCI_SRNB_SHIFT;
+            let mut size = 0;
+            for index in 0..banks {
+                size += socram_banksize(bp, &sysmem, index);
+            }
+            self.ramsize = size;
+            self.rambase = tcm_rambase(self.id, self.rev).ok_or("RAM base unknown for this ARM CA7 chip")?;
+        } else {
+            let ram = self.core(CORE_INTERNAL_MEM).ok_or("no memory core")?;
+            if !self.is_up(bp, &ram) {
+                self.reset_core(bp, &ram, 0, 0, 0);
+            }
+            let info = bp.read32(ram.base + SOCRAM_COREINFO);
+            let banks = (info & (SRCI_SRNB_MASK | SRCI_SRNB_MASK_EXT)) >> SRCI_SRNB_SHIFT;
+            let mut size = 0;
+            for index in 0..banks {
+                size += socram_banksize(bp, &ram, index);
+            }
+            self.ramsize = size;
+            self.rambase = 0;
+        }
+        if self.ramsize == 0 || self.ramsize > CHIP_MAX_MEMSIZE {
+            return Err("the RAM's size makes no sense");
+        }
+        Ok(())
+    }
+}
+
+/// `brcmf_chip_socram_banksize`.
+fn socram_banksize(bp: &Backplane, core: &Core, index: u32) -> u32 {
+    bp.write32(core.base + SOCRAM_BANKIDX, (SOCRAM_MEMTYPE_RAM << SOCRAM_BANKIDX_MEMTYPE_SHIFT) | index);
+    let info = bp.read32(core.base + SOCRAM_BANKINFO);
+    ((info & SOCRAM_BANKINFO_SZMASK) + 1) * SOCRAM_BANKINFO_SZBASE
+}
+
+/// `brcmf_chip_tcm_rambase`.
+fn tcm_rambase(chip: u32, rev: u32) -> Option<u32> {
+    Some(match chip {
+        CC_4345 | CC_43454 => 0x198000,
+        CC_4335 | CC_4339 | CC_4350 | CC_4354 | CC_4356 | CC_43567 | CC_43569 | CC_43570 | CC_4358 | CC_43602 | CC_4371 => 0x180000,
+        CC_43465 | CC_43525 | CC_4365 | CC_4366 | CC_43664 | CC_43666 => 0x200000,
+        CC_4355 | CC_4359 => {
+            if rev < 9 {
+                0x180000
+            } else {
+                0x160000
+            }
+        }
+        CC_4364 | CC_4373 => 0x160000,
+        CC_43751 | CC_43752 | CC_4377 => 0x170000,
+        CC_4378 => 0x352000,
+        CC_4387 => 0x740000,
+        _ => return None,
+    })
+}
+
+/// `brcmf_chip_dmp_get_desc`: a descriptor and its type.
+fn desc(bp: &Backplane, at: &mut u32) -> (u32, u32) {
+    let value = bp.read32(*at);
+    *at += 4;
+    let mut kind = value & DMP_DESC_TYPE_MSK;
+    if kind & !DMP_DESC_ADDRSIZE_GT32 == DMP_DESC_ADDRESS {
+        kind = DMP_DESC_ADDRESS;
+    }
+    (value, kind)
+}
+
+/// `brcmf_chip_dmp_get_regaddr`: a core's registers and its wrapper.
+fn regaddr(bp: &Backplane, at: &mut u32) -> Option<(u32, u32)> {
+    let (_, kind) = desc(bp, at);
+    let wraptype = if kind == DMP_DESC_MASTER_PORT {
+        DMP_SLAVE_TYPE_MWRAP
+    } else if kind == DMP_DESC_ADDRESS {
+        *at -= 4;
+        DMP_SLAVE_TYPE_SWRAP
+    } else {
+        *at -= 4;
+        return None;
+    };
+    let (mut base, mut wrap) = (0, 0);
+    for _ in 0..64 {
+        // The next address descriptor.
+        let (value, kind) = loop {
+            let (value, kind) = desc(bp, at);
+            if kind == DMP_DESC_EOT {
+                *at -= 4;
+                return None;
+            }
+            if kind == DMP_DESC_ADDRESS || kind == DMP_DESC_COMPONENT {
+                break (value, kind);
+            }
+        };
+        // The next component's border.
+        if kind == DMP_DESC_COMPONENT {
+            *at -= 4;
+            return Some((base, wrap));
+        }
+        if value & DMP_DESC_ADDRSIZE_GT32 != 0 {
+            desc(bp, at);
+        }
+        let sztype = (value & DMP_SLAVE_SIZE_TYPE) >> DMP_SLAVE_SIZE_TYPE_S;
+        if sztype == DMP_SLAVE_SIZE_DESC {
+            let (size, _) = desc(bp, at);
+            if size & DMP_DESC_ADDRSIZE_GT32 != 0 {
+                desc(bp, at);
+            }
+        }
+        if sztype != DMP_SLAVE_SIZE_4K && sztype != DMP_SLAVE_SIZE_8K {
+            continue;
+        }
+        let stype = (value & DMP_SLAVE_TYPE) >> DMP_SLAVE_TYPE_S;
+        if base == 0 && stype == DMP_SLAVE_TYPE_SLAVE {
+            base = value & DMP_SLAVE_ADDR_BASE;
+        }
+        if wrap == 0 && stype == wraptype {
+            wrap = value & DMP_SLAVE_ADDR_BASE;
+        }
+        if base != 0 && wrap != 0 {
+            return Some((base, wrap));
+        }
+    }
+    None
+}
