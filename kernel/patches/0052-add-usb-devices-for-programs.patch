+// ── sysfs: `/sys/bus/usb` ────────────────────────────────────────────────
+
+pub(crate) struct UsbBus;
+
+type SysDevice = BusDevice<UsbBus>;
+
+impl Bus for UsbBus {
+    const NAME: &'static str = "usb";
+    type Device = Arc<UsbDevice>;
+    type MatchData = ();
+
+    fn matches(&self, _device: &Arc<UsbDevice>, _data: &()) -> bool {
+        false
+    }
+
+    fn dev_attrs(&self) -> &'static [Attr<SysDevice>] {
+        ATTRS
+    }
+}
+
+static BUS: spin::Once<Option<Arc<BusHandle<UsbBus>>>> = spin::Once::new();
+
+fn bus() -> Option<&'static Arc<BusHandle<UsbBus>>> {
+    BUS.call_once(|| match bus::register(UsbBus) {
+        Ok(bus) => Some(bus),
+        Err(error) => {
+            ostd::notice!("no /sys/bus/usb: {:?}", error);
+            None
+        }
+    })
+    .as_ref()
+}
+
+static USB_DEVICE: SysDeviceType<SysDevice> =
+    SysDeviceType { name: "usb_device", attrs: &[], devnode: Some(devnode), has_device_link: true };
+
+/// `/dev/bus/usb/BBB/DDD`: anyone may use a device no kernel driver took,
+/// as the session's person may on Debian (udev's `uaccess`); the others
+/// may be read.
+fn devnode(device: &SysDevice) -> Option<DevNode> {
+    let free = device.state.lock().drivers.is_empty();
+    Some(DevNode { path: Some(SysStr::from(device.node_path())), mode: Some(if free { 0o666 } else { 0o664 }) })
+}
+
+fn show(w: &mut dyn Write, value: impl core::fmt::Display) -> aster_device::common::Result<()> {
+    writeln!(w, "{}", value)?;
+    Ok(())
+}
+
+fn show_string(w: &mut dyn Write, value: &Option<String>) -> aster_device::common::Result<()> {
+    if let Some(value) = value {
+        show(w, value)?;
+    }
+    Ok(())
+}
+
+fn show_header(device: &SysDevice, w: &mut dyn Write, field: fn(&[u8], u32) -> String) -> aster_device::common::Result<()> {
+    if let Some(header) = device.active_header() {
+        show(w, field(header, device.speed))?;
+    }
+    Ok(())
+}
+
+const ATTRS: &[Attr<SysDevice>] = &[
+    Attr::ro("busnum", |device, w| show(w, device.host.bus)),
+    Attr::ro("devnum", |device, w| show(w, device.devnum)),
+    Attr::ro("devpath", |device, w| {
+        if device.ports.is_empty() {
+            return show(w, 0);
+        }
+        let path: Vec<String> = device.ports.iter().map(|port| format!("{}", port)).collect();
+        show(w, path.join("."))
+    }),
+    Attr::ro("speed", |device, w| show(w, speed_of(device.speed).1)),
+    Attr::ro("version", |device, w| {
+        let bcd = device.descriptor_u16(2);
+        show(w, format_args!("{:2x}.{:02x}", bcd >> 8, bcd & 0xff))
+    }),
+    Attr::ro("idVendor", |device, w| show(w, format_args!("{:04x}", device.descriptor_u16(8)))),
+    Attr::ro("idProduct", |device, w| show(w, format_args!("{:04x}", device.descriptor_u16(10)))),
+    Attr::ro("bcdDevice", |device, w| show(w, format_args!("{:04x}", device.descriptor_u16(12)))),
+    Attr::ro("bDeviceClass", |device, w| show(w, format_args!("{:02x}", device.descriptors[4]))),
+    Attr::ro("bDeviceSubClass", |device, w| show(w, format_args!("{:02x}", device.descriptors[5]))),
+    Attr::ro("bDeviceProtocol", |device, w| show(w, format_args!("{:02x}", device.descriptors[6]))),
+    Attr::ro("bMaxPacketSize0", |device, w| show(w, device.descriptors[7])),
+    Attr::ro("bNumConfigurations", |device, w| show(w, device.descriptors[17])),
+    Attr::ro("bConfigurationValue", |device, w| {
+        let active = device.state.lock().active;
+        if active != 0 {
+            show(w, active)?;
+        }
+        Ok(())
+    }),
+    Attr::ro("bNumInterfaces", |device, w| show_header(device, w, |header, _| format!("{:2}", header[4]))),
+    Attr::ro("bmAttributes", |device, w| show_header(device, w, |header, _| format!("{:2x}", header[7]))),
+    Attr::ro("bMaxPower", |device, w| {
+        show_header(device, w, |header, speed| format!("{}mA", u32::from(header[8]) * if speed >= 4 { 8 } else { 2 }))
+    }),
+    Attr::ro("maxchild", |device, w| show(w, device.hub_ports)),
+    Attr::ro("manufacturer", |device, w| show_string(w, &device.strings[0])),
+    Attr::ro("product", |device, w| show_string(w, &device.strings[1])),
+    Attr::ro("serial", |device, w| show_string(w, &device.strings[2])),
+    Attr::ro("removable", |_device, w| show(w, "unknown")),
+    Attr::ro("authorized", |_device, w| show(w, 1)),
+    Attr::ro("avoid_reset_port", |_device, w| show(w, 0)),
+    Attr::ro("quirks", |_device, w| show(w, "0x0")),
+    Attr::ro("ltm_capable", |_device, w| show(w, "no")),
+    Attr::ro("urbnum", |_device, w| show(w, 0)),
+    Attr::ro("rx_lanes", |_device, w| show(w, 1)),
+    Attr::ro("tx_lanes", |_device, w| show(w, 1)),
+    Attr::bin("descriptors", |device| device.descriptors.clone()),
+    Attr::ro("uevent", |device, w| {
+        for (key, value) in device.environment() {
+            writeln!(w, "{}={}", key, value)?;
+        }
+        Ok(())
+    }),
+];
