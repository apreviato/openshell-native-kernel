new file mode 100755
index 0000000..2232032
--- /dev/null
+++ b/kernel/comps/usb/src/xhci/programs.rs
@@ -0,0 +1,689 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Programs' transfers, on the controller's task (`crate::usbfs`): their TDs
+//! on the device's rings (an endpoint's own, or the default control
+//! endpoint's beside the kernel's requests), their completions, cancels
+//! and timeouts, the endpoints that halted, and the requests that change a
+//! device's configuration or reset its endpoints. A device is published
+//! for programs once its drivers started, and taken back when it goes.
+//!
+//! Reference: Linux's `drivers/usb/host/xhci-ring.c` (`td_to_noop`,
+//! `xhci_handle_halted_endpoint`) and `drivers/usb/core/message.c`.
+
+use alloc::{collections::VecDeque, string::String, sync::Arc, vec::Vec};
+
+use ostd::mm::HasDaddr;
+
+use super::{
+    CLEAR_FEATURE, Controller, Data, Error, SET_CONFIGURATION, SET_INTERFACE, SHORT_PACKET, STALL, SUCCESS, Slot,
+    td_remainder,
+};
+use crate::{
+    desc::{Configuration, Endpoint},
+    ring::{CHAIN, IDT, IOC, ISP, ProducerRing, RING_TRBS, Trb, trb_type},
+    usbfs::{self, Action, Command, NewDevice, Request, URB_SHORT_NOT_OK, URB_ZERO_PACKET, Urb, UsbDevice, errno, urb_type},
+};
+
+/// Completion codes of transfers programs see.
+const DATA_BUFFER: u8 = 2;
+const BABBLE: u8 = 3;
+const RESOURCE: u8 = 7;
+const BANDWIDTH: u8 = 21;
+const STOPPED: u8 = 26;
+const STOPPED_LENGTH_INVALID: u8 = 27;
+const STOPPED_SHORT_PACKET: u8 = 28;
+
+/// The pages of a program endpoint's ring: room for one transfer of 16 MiB
+/// in 64 KiB pieces.
+const RING_PAGES: usize = 4;
+/// What programs' TDs may hold of the default control endpoint's ring; the
+/// rest is the kernel's own requests'.
+const EP0_ROOM: usize = RING_TRBS - 1 - 32;
+
+/// What programs have on one endpoint of a device.
+pub(super) struct ProgramEndpoint {
+    /// Its ring (none: the default control endpoint, the slot's own).
+    ring: Option<ProducerRing>,
+    /// TDs on the ring, in order.
+    tds: VecDeque<Td>,
+    /// Transfers waiting for room on the ring, or for the endpoint's reset.
+    waiting: VecDeque<Arc<Urb>>,
+    /// TRBs the TDs hold.
+    used: usize,
+    /// It halted: where it goes once reset, past the TD that failed.
+    halted: Option<u64>,
+}
+
+impl ProgramEndpoint {
+    fn new(ring: Option<ProducerRing>) -> Self {
+        Self { ring, tds: VecDeque::new(), waiting: VecDeque::new(), used: 0, halted: None }
+    }
+
+    fn room(&self) -> usize {
+        self.ring.as_ref().map_or(EP0_ROOM, |ring| ring.capacity() - 2)
+    }
+}
+
+/// A transfer on a ring.
+struct Td {
+    urb: Arc<Urb>,
+    /// Its TRBs: address, data bytes, whether it moves data.
+    trbs: Vec<(u64, usize, bool)>,
+    /// Where the ring is after it, with its cycle bit.
+    after: u64,
+    /// The TRBs it holds of the ring's room.
+    cost: usize,
+}
+
+/// A change a program made with a request of its own.
+pub(super) enum Change {
+    Configuration(u8),
+    Interface(u8, u8),
+}
+
+/// The error a transfer or a request ends with.
+fn errno_of(error: Error) -> i32 {
+    match error {
+        Error::Completion(STALL) => -errno::EPIPE,
+        Error::Completion(BANDWIDTH | RESOURCE) => -errno::ENOSPC,
+        Error::Completion(_) => -errno::EPROTO,
+        Error::Timeout => -errno::ETIMEDOUT,
+        Error::NoMemory => -errno::ENOMEM,
+        Error::Descriptor | Error::NoMedium => -errno::EINVAL,
+    }
+}
+
+/// The endpoint context's type: OUT 1–3, IN 5–7.
+fn kind_of(endpoint: &Endpoint) -> u32 {
+    u32::from(endpoint.transfer_type()) + if endpoint.is_in() { 4 } else { 0 }
+}
+
+fn target(slot_id: u8, dci: u8) -> u32 {
+    u32::from(dci) << 16 | u32::from(slot_id) << 24
+}
+
+/// A string descriptor's text.
+fn text_of(descriptor: &[u8]) -> Option<String> {
+    let units = descriptor.get(2..)?.chunks_exact(2).map(|pair| u16::from_le_bytes([pair[0], pair[1]]));
+    let text: String = char::decode_utf16(units).map(|unit| unit.unwrap_or('?')).collect();
+    let text = String::from(text.trim_end_matches('\0').trim());
+    (!text.is_empty()).then_some(text)
+}
+
+impl Controller {
+    // ── Devices ──────────────────────────────────────────────────────────
+
+    /// The root hub, for the tree of devices.
+    pub(super) fn publish_root(&mut self) {
+        let root = UsbDevice::root_hub(self.host.clone(), self.max_ports);
+        usbfs::publish(&root, None);
+        self.root = Some(root);
+    }
+
+    /// The ports from the root hub to a slot's device.
+    fn port_path(&self, slot_id: u8) -> Vec<u8> {
+        let mut path = Vec::new();
+        let mut current = slot_id;
+        while let Some(slot) = self.slots.get(&current) {
+            match slot.parent {
+                Some((hub, port)) => {
+                    path.push(port);
+                    current = hub;
+                }
+                None => {
+                    path.push(slot.port);
+                    break;
+                }
+            }
+            if path.len() > 7 {
+                break;
+            }
+        }
+        path.reverse();
+        path
+    }
+
+    /// A device number not in use, cycling as Linux's do (2–127; the root
+    /// hub is 1).
+    fn allocate_devnum(&mut self) -> Option<u8> {
+        let used: Vec<u8> = self.slots.values().filter_map(|slot| slot.usbfs.as_ref().map(|device| device.devnum)).collect();
+        for _ in 0..126 {
+            let candidate = self.next_devnum;
+            self.next_devnum = if candidate >= 127 { 2 } else { candidate + 1 };
+            if !used.contains(&candidate) {
+                return Some(candidate);
+            }
+        }
+        None
+    }
+
+    /// Gives programs a device whose drivers started: its descriptors as
+    /// read, its configurations, the interfaces its drivers took.
+    pub(super) fn publish_device(&mut self, slot_id: u8, mut device: Vec<u8>, configurations: Vec<(Vec<u8>, Configuration)>, active: u8) {
+        if device.len() < 18 {
+            return;
+        }
+        // The configurations it has here, should one not have been read.
+        device[17] = configurations.len() as u8;
+        let mut strings: [Option<String>; 3] = [None, None, None];
+        for (at, string) in strings.iter_mut().enumerate() {
+            let index = device[14 + at];
+            if index != 0 {
+                *string = self.get_string(slot_id, index).ok().and_then(|descriptor| text_of(&descriptor));
+            }
+        }
+        let ports = self.port_path(slot_id);
+        let Some(devnum) = self.allocate_devnum() else { return };
+        let Some(slot) = self.slots.get(&slot_id) else { return };
+        let parent = match slot.parent {
+            Some((hub, _)) => self.slots.get(&hub).and_then(|hub| hub.usbfs.clone()),
+            None => self.root.clone(),
+        };
+        let mut descriptors = device;
+        let mut parsed = Vec::with_capacity(configurations.len());
+        for (raw, configuration) in configurations {
+            descriptors.extend_from_slice(&raw);
+            parsed.push(configuration);
+        }
+        let usbfs = UsbDevice::new(NewDevice {
+            host: self.host.clone(),
+            slot_id,
+            devnum,
+            ports,
+            speed: slot.speed,
+            descriptors,
+            configurations: parsed,
+            strings,
+            hub_ports: slot.hub.as_ref().map_or(0, |hub| hub.ports),
+            active,
+            drivers: slot.drivers.clone(),
+        });
+        usbfs::publish(&usbfs, parent.as_ref());
+        if let Some(slot) = self.slots.get_mut(&slot_id) {
+            slot.usbfs = Some(usbfs);
+        }
+    }
+
+    /// A device went: what programs had on it ends.
+    pub(super) fn programs_gone(slot: &mut Slot) {
+        for (_, endpoint) in core::mem::take(&mut slot.programs) {
+            for td in endpoint.tds {
+                td.urb.complete(-errno::ESHUTDOWN, 0);
+            }
+            for urb in endpoint.waiting {
+                urb.complete(-errno::ESHUTDOWN, 0);
+            }
+        }
+        if let Some(device) = slot.usbfs.take() {
+            usbfs::remove(&device);
+        }
+    }
+
+    fn owns(&self, device: &Arc<UsbDevice>) -> bool {
+        self.slots
+            .get(&device.slot_id)
+            .and_then(|slot| slot.usbfs.as_ref())
+            .is_some_and(|own| Arc::ptr_eq(own, device))
+    }
+
+    // ── Serving programs ─────────────────────────────────────────────────
+
+    /// Serves programs: endpoints that halted are reset, changes programs
+    /// made are followed, waited-for transfers past their time end, what
+    /// programs asked is done, and transfers that waited for room go.
+    pub(super) fn serve_programs(&mut self) {
+        self.recover_endpoints();
+        for (slot_id, change) in core::mem::take(&mut self.changes) {
+            self.apply_change(slot_id, change);
+        }
+        self.expire_transfers();
+        for request in self.host.take() {
+            match request {
+                Request::Submit(urb) => self.start_transfer(urb),
+                Request::Cancel(urb) => self.cancel_transfer(&urb, -errno::ENOENT),
+                Request::Command(command) => {
+                    let result = self.run_command(&command);
+                    command.finish(result);
+                }
+            }
+        }
+        self.push_waiting();
+    }
+
+    fn start_transfer(&mut self, urb: Arc<Urb>) {
+        if !self.owns(&urb.device) {
+            urb.complete(-errno::ENODEV, 0);
+            return;
+        }
+        let slot_id = urb.device.slot_id;
+        let dci = urb.dci();
+        if !self.slots[&slot_id].programs.contains_key(&dci) {
+            let ring = if dci == 1 {
+                None
+            } else {
+                let Some(ring) = ProducerRing::with_pages(RING_PAGES) else {
+                    urb.complete(-errno::ENOMEM, 0);
+                    return;
+                };
+                if let Err(error) = self.configure_endpoint(slot_id, &urb.endpoint, kind_of(&urb.endpoint), &ring) {
+                    ostd::notice!("{}: slot {}: endpoint {:02x} not configured: {:?}", self.name, slot_id, urb.endpoint.address, error);
+                    urb.complete(errno_of(error), 0);
+                    return;
+                }
+                Some(ring)
+            };
+            if let Some(slot) = self.slots.get_mut(&slot_id) {
+                slot.programs.insert(dci, ProgramEndpoint::new(ring));
+            }
+        }
+        let queued = self
+            .slots
+            .get(&slot_id)
+            .and_then(|slot| slot.programs.get(&dci))
+            .is_none_or(|endpoint| endpoint.halted.is_some() || !endpoint.waiting.is_empty());
+        if queued || !self.push_td(slot_id, dci, &urb) {
+            if let Some(endpoint) = self.slots.get_mut(&slot_id).and_then(|slot| slot.programs.get_mut(&dci)) {
+                endpoint.waiting.push_back(urb);
+            }
+        }
+    }
+
+    /// Puts a transfer's TD on its ring and rings; `false` when the ring has
+    /// no room for it yet.
+    fn push_td(&mut self, slot_id: u8, dci: u8, urb: &Arc<Urb>) -> bool {
+        let version = self.version;
+        let Some(slot) = self.slots.get_mut(&slot_id) else { return false };
+        let Slot { ep0, programs, .. } = slot;
+        let Some(endpoint) = programs.get_mut(&dci) else { return false };
+        let control = urb.kind == urb_type::CONTROL;
+        let inward = urb.inward();
+        let max_packet = usize::from(urb.endpoint.max_packet & 0x7ff).max(1);
+        let mut pieces = urb.pieces();
+        if !control {
+            if pieces.is_empty() {
+                pieces.push((0, 0));
+            }
+            if !inward && urb.flags & URB_ZERO_PACKET != 0 && urb.length > 0 && urb.length % max_packet == 0 {
+                pieces.push((0, 0));
+            }
+        }
+        // Its TRBs, its setup and status stages, a link it may cross.
+        let cost = pieces.len() + 3;
+        if cost > endpoint.room() {
+            urb.complete(-errno::ENOMEM, 0);
+            return true;
+        }
+        if endpoint.used + cost > endpoint.room() {
+            return false;
+        }
+        let ring = match endpoint.ring.as_mut() {
+            Some(ring) => ring,
+            None => ep0,
+        };
+        let total = urb.length;
+        let mut trbs = Vec::with_capacity(cost);
+        if control {
+            let transfer_type = match (total, inward) {
+                (0, _) => 0,
+                (_, false) => 2,
+                (_, true) => 3,
+            };
+            let setup = Trb {
+                parameter: u64::from_le_bytes(urb.setup),
+                status: 8,
+                control: Trb::with_type(trb_type::SETUP) | IDT | transfer_type << 16,
+            };
+            trbs.push((ring.push(setup), 0, false));
+        }
+        let count = pieces.len();
+        let mut transferred = 0;
+        for (index, &(address, length)) in pieces.iter().enumerate() {
+            let last = index + 1 == count;
+            let mut flags = if inward { ISP } else { 0 };
+            let kind = if control && index == 0 {
+                flags |= u32::from(inward) << 16;
+                trb_type::DATA
+            } else {
+                trb_type::NORMAL
+            };
+            flags |= match (control, last) {
+                (_, false) => CHAIN,
+                (false, true) => IOC,
+                (true, true) => 0,
+            };
+            let remainder = td_remainder(version, transferred, length, total, max_packet, !last);
+            let trb = Trb { parameter: address, status: length as u32 | remainder.min(31) << 17, control: Trb::with_type(kind) | flags };
+            trbs.push((ring.push(trb), length, true));
+            transferred += length;
+        }
+        if control {
+            let status_in = total == 0 || !inward;
+            let status = Trb { control: Trb::with_type(trb_type::STATUS) | IOC | u32::from(status_in) << 16, ..Trb::default() };
+            trbs.push((ring.push(status), 0, false));
+        }
+        let after = ring.dequeue_pointer();
+        endpoint.used += cost;
+        endpoint.tds.push_back(Td { urb: urb.clone(), trbs, after, cost });
+        self.ring(slot_id, dci);
+        true
+    }
+
+    /// A transfer event on a program's endpoint.
+    pub(super) fn program_done(&mut self, slot_id: u8, dci: u8, event: &Trb) {
+        let code = event.completion_code();
+        // A stop programs asked for: the TD goes on once the endpoint does.
+        if matches!(code, STOPPED | STOPPED_LENGTH_INVALID | STOPPED_SHORT_PACKET) {
+            return;
+        }
+        let Some(endpoint) = self.slots.get_mut(&slot_id).and_then(|slot| slot.programs.get_mut(&dci)) else { return };
+        let Some(index) = endpoint.tds.iter().position(|td| td.trbs.iter().any(|trb| trb.0 == event.parameter)) else {
+            return;
+        };
+        let residual = (event.status & 0xff_ffff) as usize;
+        let td = &endpoint.tds[index];
+        let mut actual = 0;
+        for &(address, length, data) in &td.trbs {
+            if address == event.parameter {
+                if data {
+                    actual += length.saturating_sub(residual);
+                }
+                break;
+            }
+            if data {
+                actual += length;
+            }
+        }
+        let last = td.trbs.last().is_some_and(|trb| trb.0 == event.parameter);
+        let status = match code {
+            // An event the TD did not ask for.
+            SUCCESS if !last => return,
+            SUCCESS => 0,
+            SHORT_PACKET if td.urb.flags & URB_SHORT_NOT_OK != 0 => -errno::EREMOTEIO,
+            SHORT_PACKET => 0,
+            STALL => -errno::EPIPE,
+            DATA_BUFFER | BABBLE => -errno::EOVERFLOW,
+            _ => -errno::EPROTO,
+        };
+        let Some(td) = endpoint.tds.remove(index) else { return };
+        endpoint.used -= td.cost;
+        if !matches!(code, SUCCESS | SHORT_PACKET) {
+            endpoint.halted = Some(td.after);
+        }
+        if status == 0 && td.urb.kind == urb_type::CONTROL {
+            let setup = td.urb.setup;
+            match (setup[0], setup[1]) {
+                (0x00, SET_CONFIGURATION) => self.changes.push((slot_id, Change::Configuration(setup[2]))),
+                (0x01, SET_INTERFACE) => self.changes.push((slot_id, Change::Interface(setup[4], setup[2]))),
+                _ => {}
+            }
+        }
+        td.urb.complete(status, actual);
+    }
+
+    /// Endpoints that halted (a stall, a transaction error) are reset and
+    /// moved past the TD that failed; the TDs after it go on.
+    fn recover_endpoints(&mut self) {
+        let halted: Vec<(u8, u8, u64)> = self
+            .slots
+            .iter()
+            .flat_map(|(&slot_id, slot)| {
+                slot.programs.iter().filter_map(move |(&dci, endpoint)| endpoint.halted.map(|after| (slot_id, dci, after)))
+            })
+            .collect();
+        for (slot_id, dci, after) in halted {
+            let target = target(slot_id, dci);
+            if self.command(Trb { control: Trb::with_type(trb_type::RESET_ENDPOINT) | target, ..Trb::default() }).is_err() {
+                let _ = self.command(Trb { control: Trb::with_type(trb_type::STOP_ENDPOINT) | target, ..Trb::default() });
+            }
+            let _ = self.command(Trb { parameter: after, control: Trb::with_type(trb_type::SET_TR_DEQUEUE) | target, ..Trb::default() });
+            if let Some(endpoint) = self.slots.get_mut(&slot_id).and_then(|slot| slot.programs.get_mut(&dci)) {
+                endpoint.halted = None;
+            }
+            self.ring(slot_id, dci);
+        }
+    }
+
+    /// Waited-for transfers past their time end (`ETIMEDOUT`).
+    fn expire_transfers(&mut self) {
+        let now = crate::now_ms();
+        let expired: Vec<Arc<Urb>> = self
+            .slots
+            .values()
+            .flat_map(|slot| slot.programs.values())
+            .flat_map(|endpoint| endpoint.tds.iter().map(|td| &td.urb).chain(endpoint.waiting.iter()))
+            .filter(|urb| urb.deadline.is_some_and(|deadline| deadline <= now))
+            .cloned()
+            .collect();
+        for urb in expired {
+            self.cancel_transfer(&urb, -errno::ETIMEDOUT);
+        }
+    }
+
+    /// Takes a transfer back: the endpoint stops, its TD's TRBs become No
+    /// Ops (and the endpoint moves past it if it was on it), and it goes
+    /// on with the others (Linux's `td_to_noop`).
+    fn cancel_transfer(&mut self, urb: &Arc<Urb>, status: i32) {
+        let slot_id = urb.device.slot_id;
+        let dci = urb.dci();
+        if !self.owns(&urb.device) {
+            urb.complete(status, 0);
+            return;
+        }
+        let halted = {
+            let Some(endpoint) = self.slots.get_mut(&slot_id).and_then(|slot| slot.programs.get_mut(&dci)) else {
+                urb.complete(status, 0);
+                return;
+            };
+            if let Some(at) = endpoint.waiting.iter().position(|each| Arc::ptr_eq(each, urb)) {
+                if let Some(urb) = endpoint.waiting.remove(at) {
+                    urb.complete(status, 0);
+                }
+                return;
+            }
+            if !endpoint.tds.iter().any(|td| Arc::ptr_eq(&td.urb, urb)) {
+                return;
+            }
+            endpoint.halted.is_some()
+        };
+        let target = target(slot_id, dci);
+        let stopped = !halted && self.command(Trb { control: Trb::with_type(trb_type::STOP_ENDPOINT) | target, ..Trb::default() }).is_ok();
+        // Where the controller stopped.
+        let dequeue = self.slots.get(&slot_id).map_or(0, |slot| {
+            (u64::from(self.output_read(slot, usize::from(dci), 2)) | u64::from(self.output_read(slot, usize::from(dci), 3)) << 32) & !0xf
+        });
+        let Some(slot) = self.slots.get_mut(&slot_id) else { return };
+        let Slot { ep0, programs, .. } = slot;
+        let Some(endpoint) = programs.get_mut(&dci) else { return };
+        let Some(index) = endpoint.tds.iter().position(|td| Arc::ptr_eq(&td.urb, urb)) else {
+            // It ended while the endpoint stopped.
+            if stopped {
+                self.ring(slot_id, dci);
+            }
+            return;
+        };
+        let Some(td) = endpoint.tds.remove(index) else { return };
+        endpoint.used -= td.cost;
+        let ring: &ProducerRing = endpoint.ring.as_ref().unwrap_or(ep0);
+        for &(address, _, _) in &td.trbs {
+            ring.to_noop(address);
+        }
+        if td.trbs.windows(2).any(|pair| pair[1].0 < pair[0].0) {
+            ring.unchain_link();
+        }
+        let inside = td.trbs.iter().any(|trb| trb.0 == dequeue);
+        td.urb.complete(status, 0);
+        if stopped && inside {
+            let _ = self.command(Trb { parameter: td.after, control: Trb::with_type(trb_type::SET_TR_DEQUEUE) | target, ..Trb::default() });
+        }
+        if !halted {
+            self.ring(slot_id, dci);
+        }
+    }
+
+    /// Transfers that waited go, as their rings have room.
+    fn push_waiting(&mut self) {
+        let ready: Vec<(u8, u8)> = self
+            .slots
+            .iter()
+            .flat_map(|(&slot_id, slot)| {
+                slot.programs
+                    .iter()
+                    .filter(|(_, endpoint)| endpoint.halted.is_none() && !endpoint.waiting.is_empty())
+                    .map(move |(&dci, _)| (slot_id, dci))
+            })
+            .collect();
+        for (slot_id, dci) in ready {
+            loop {
+                let next = self.slots.get(&slot_id).and_then(|slot| slot.programs.get(&dci)).and_then(|endpoint| endpoint.waiting.front().cloned());
+                let Some(urb) = next else { break };
+                if !self.push_td(slot_id, dci, &urb) {
+                    break;
+                }
+                if let Some(endpoint) = self.slots.get_mut(&slot_id).and_then(|slot| slot.programs.get_mut(&dci)) {
+                    endpoint.waiting.pop_front();
+                }
+            }
+        }
+    }
+
+    // ── Configurations and endpoints ─────────────────────────────────────
+
+    /// The endpoints programs used on a slot (not the default one).
+    fn program_dcis(&self, slot_id: u8) -> Vec<u8> {
+        self.slots.get(&slot_id).map_or(Vec::new(), |slot| slot.programs.keys().copied().filter(|dci| *dci != 1).collect())
+    }
+
+    /// Endpoints programs used are let go: their transfers end with
+    /// `status`, the controller drops them (their data toggles start over
+    /// when they are used again).
+    fn forget_endpoints(&mut self, slot_id: u8, dcis: &[u8], status: i32) {
+        let known: Vec<u8> = match self.slots.get(&slot_id) {
+            Some(slot) => dcis.iter().copied().filter(|dci| *dci != 1 && slot.programs.contains_key(dci)).collect(),
+            None => return,
+        };
+        if known.is_empty() {
+            return;
+        }
+        for &dci in &known {
+            let busy = self.slots.get(&slot_id).and_then(|slot| slot.programs.get(&dci)).is_some_and(|endpoint| !endpoint.tds.is_empty());
+            if busy {
+                let _ = self.command(Trb { control: Trb::with_type(trb_type::STOP_ENDPOINT) | target(slot_id, dci), ..Trb::default() });
+            }
+        }
+        let mut ended = Vec::new();
+        if let Some(slot) = self.slots.get_mut(&slot_id) {
+            for dci in &known {
+                if let Some(endpoint) = slot.programs.remove(dci) {
+                    ended.extend(endpoint.tds.into_iter().map(|td| td.urb));
+                    ended.extend(endpoint.waiting);
+                }
+            }
+        }
+        self.drop_endpoints(slot_id, &known);
+        for urb in ended {
+            urb.complete(status, 0);
+        }
+    }
+
+    /// Drops endpoints from the slot's configuration.
+    fn drop_endpoints(&mut self, slot_id: u8, dcis: &[u8]) {
+        let Some(slot) = self.slots.get(&slot_id) else { return };
+        self.clear_input(slot);
+        let dropped = dcis.iter().fold(0u32, |flags, dci| flags | 1 << dci);
+        self.input_write(slot, 0, 0, dropped);
+        self.input_write(slot, 0, 1, 1);
+        for dword in 0..4 {
+            let value = if dword == 3 { 0 } else { self.output_read(slot, 0, dword) };
+            self.input_write(slot, 1, dword, value);
+        }
+        let input = slot.input.daddr() as u64;
+        let _ = self.command(Trb {
+            parameter: input,
+            control: Trb::with_type(trb_type::CONFIGURE_ENDPOINT) | u32::from(slot_id) << 24,
+            ..Trb::default()
+        });
+    }
+
+    fn apply_change(&mut self, slot_id: u8, change: Change) {
+        let Some(device) = self.slots.get(&slot_id).and_then(|slot| slot.usbfs.clone()) else { return };
+        match change {
+            Change::Configuration(value) => {
+                let dcis = self.program_dcis(slot_id);
+                self.forget_endpoints(slot_id, &dcis, -errno::ESHUTDOWN);
+                let mut state = device.state.lock();
+                state.active = value;
+                state.alternates.clear();
+            }
+            Change::Interface(interface, alternate) => {
+                let dcis = device.interface_dcis(interface);
+                self.forget_endpoints(slot_id, &dcis, -errno::ESHUTDOWN);
+                device.state.lock().alternates.insert(interface, alternate);
+            }
+        }
+    }
+
+    /// Does what a program asked of a device; returns 0 or a negative error.
+    fn run_command(&mut self, command: &Command) -> i32 {
+        let device = &command.device;
+        if !self.owns(device) {
+            return -errno::ENODEV;
+        }
+        let slot_id = device.slot_id;
+        match command.action {
+            Action::Configuration(value) => {
+                let value = value.clamp(0, 255) as u16;
+                let dcis = self.program_dcis(slot_id);
+                self.forget_endpoints(slot_id, &dcis, -errno::ESHUTDOWN);
+                if let Err(error) = self.control(slot_id, 0x00, SET_CONFIGURATION, value, 0, Data::None) {
+                    return errno_of(error);
+                }
+                let mut state = device.state.lock();
+                state.active = value as u8;
+                state.alternates.clear();
+                0
+            }
+            Action::Interface(interface, alternate) => {
+                let dcis = device.interface_dcis(interface);
+                self.forget_endpoints(slot_id, &dcis, -errno::ESHUTDOWN);
+                match self.control(slot_id, 0x01, SET_INTERFACE, u16::from(alternate), u16::from(interface), Data::None) {
+                    Ok(_) => {}
+                    // A device with one setting may refuse the request (Linux's `usb_set_interface`).
+                    Err(Error::Completion(STALL)) if device.settings_of(interface) == 1 => {}
+                    Err(error) => return errno_of(error),
+                }
+                if alternate == 0 {
+                    device.state.lock().alternates.remove(&interface);
+                } else {
+                    device.state.lock().alternates.insert(interface, alternate);
+                }
+                0
+            }
+            Action::ClearHalt(address) => {
+                let result = self.control(slot_id, 0x02, CLEAR_FEATURE, 0, u16::from(address), Data::None);
+                let dci = Endpoint { address, ..Endpoint::default() }.dci();
+                self.forget_endpoints(slot_id, &[dci], -errno::ENOENT);
+                result.map_or_else(errno_of, |_| 0)
+            }
+            Action::ResetEndpoint(address) => {
+                let dci = Endpoint { address, ..Endpoint::default() }.dci();
+                self.forget_endpoints(slot_id, &[dci], -errno::ENOENT);
+                0
+            }
+            Action::Reset => {
+                let dcis = self.program_dcis(slot_id);
+                self.forget_endpoints(slot_id, &dcis, -errno::ESHUTDOWN);
+                let (active, alternates) = {
+                    let state = device.state.lock();
+                    (state.active, state.alternates.clone())
+                };
+                if let Err(error) = self.control(slot_id, 0x00, SET_CONFIGURATION, u16::from(active), 0, Data::None) {
+                    return errno_of(error);
+                }
+                for (interface, alternate) in alternates {
+                    let _ = self.control(slot_id, 0x01, SET_INTERFACE, u16::from(alternate), u16::from(interface), Data::None);
+                }
+                0
+            }
+        }
+    }
+}
