+// SPDX-License-Identifier: MPL-2.0
+
+//! Programs' own access to USB devices, as Linux's usbfs gives it. Each
+//! device is `/dev/bus/usb/BBB/DDD` and `/sys/bus/usb/devices/B-P.P`
+//! (`busnum`, `devnum`, `descriptors`, `bConfigurationValue`, `speed`...),
+//! its arrival and departure are kernel uevents, and programs move data
+//! with the usbfs ioctls: control, bulk and interrupt transfers, waited for
+//! or submitted as URBs and reaped later, claims, configurations, alternate
+//! settings, halts. That is what libusb needs without udev, and with it
+//! CUPS's `usb` backend (printers), SANE (scanners), libmtp and gphoto2
+//! (phones and cameras), adb and fastboot, pcsc-lite's CCID driver (smart
+//! card readers), fwupd and dfu-util (firmware), and USB serial adapters
+//! without a kernel driver (libftdi).
+//!
+//! The controller's task does the transfers (`xhci::programs`); this side
+//! checks what a program asks, copies its data and gives back what is done.
+//! Interfaces a kernel driver took (keyboards, disks, network adapters,
+//! Bluetooth controllers, hubs) stay the kernel's: a program may not claim
+//! them, as on Linux while their driver is bound, though it may still read
+//! the device's descriptors and talk to its default control endpoint.
+//! Isochronous transfers are not offered.
+//!
+//! Reference: Linux's `drivers/usb/core/devio.c` and `sysfs.c`,
+//! `include/uapi/linux/usbdevice_fs.h`.
+
+use alloc::{
+    boxed::Box,
+    collections::{BTreeMap, VecDeque},
+    format,
+    string::String,
+    sync::{Arc, Weak},
+    vec,
+    vec::Vec,
+};
+use core::{
+    fmt::Write,
+    sync::atomic::{AtomicU64, AtomicUsize, Ordering},
+};
+
+use aster_core::{
+    context::with_current_userspace,
+    device::{Device, DeviceType, registry::char},
+    events::IoEvents,
+    fs::{
+        devtmpfs::DevtmpfsNodeMeta,
+        file::{PerOpenFileOps, StatusFlags},
+        vfs::{inode::FileOps, path::Path},
+    },
+    prelude::*,
+    process::signal::{PollHandle, PollSource, Pollable},
+    util::ioctl::RawIoctl,
+};
+use aster_device::{
+    bus::{self, Bus, BusDevice, BusHandle},
+    common::{AnyDevice, Attr, DevNode, DevNum, DeviceType as SysDeviceType, SysStr},
+};
+use device_id::{DeviceId, MajorId, MinorId};
+use ostd::{
+    mm::{FallibleVmWrite, HasDaddr, PAGE_SIZE, VmIo, VmReader, VmWriter, dma::DmaCoherent},
+    sync::{SpinLock, WaitQueue},
+};
+
+use crate::desc::{self, Configuration, Endpoint, TRANSFER_BULK, TRANSFER_INTERRUPT};
+
+/// The character device major of USB devices (`usb_device`), as on Linux.
+const USB_DEVICE_MAJOR: u16 = 189;
+/// The memory programs' transfers may hold at once (Linux's `usbfs_memory_mb`).
+const MEMORY_LIMIT: usize = 16 << 20;
+/// The pages of one DMA piece of a transfer's data.
+const SEGMENT_PAGES: usize = 16;
+
+static MEMORY: AtomicUsize = AtomicUsize::new(0);
+static NEXT_FILE: AtomicU64 = AtomicU64::new(1);
+
+/// URB types (`USBDEVFS_URB_TYPE_*`).
+pub(crate) mod urb_type {
+    pub(crate) const ISO: u8 = 0;
+    pub(crate) const INTERRUPT: u8 = 1;
+    pub(crate) const CONTROL: u8 = 2;
+    pub(crate) const BULK: u8 = 3;
+}
+
+/// URB flags (`USBDEVFS_URB_*`).
+pub(crate) const URB_SHORT_NOT_OK: u32 = 0x01;
+pub(crate) const URB_ZERO_PACKET: u32 = 0x40;
+
+/// What the device files can do (`USBDEVFS_CAP_*`): zero-length packets,
+/// transfers of any size in one URB, URBs reaped after the device went,
+/// dropped privileges and the long connection information.
+const CAPABILITIES: u32 = 0x01 | 0x04 | 0x08 | 0x10 | 0x40 | 0x80;
+
+/// The errors transfers end with (written to a URB as negative numbers).
+pub(crate) mod errno {
+    pub(crate) const ENOENT: i32 = 2;
+    pub(crate) const ENOMEM: i32 = 12;
+    pub(crate) const EBUSY: i32 = 16;
+    pub(crate) const ENODEV: i32 = 19;
+    pub(crate) const EINVAL: i32 = 22;
+    pub(crate) const ENOSPC: i32 = 28;
+    pub(crate) const EPIPE: i32 = 32;
+    pub(crate) const ENODATA: i32 = 61;
+    pub(crate) const EPROTO: i32 = 71;
+    pub(crate) const EOVERFLOW: i32 = 75;
+    pub(crate) const ESHUTDOWN: i32 = 108;
+    pub(crate) const ETIMEDOUT: i32 = 110;
+    pub(crate) const EREMOTEIO: i32 = 121;
+}
+
+/// The usbfs ioctls (`'U'`, by number).
+mod nr {
+    pub(super) const CONTROL: u32 = 0;
+    pub(super) const BULK: u32 = 2;
+    pub(super) const RESETEP: u32 = 3;
+    pub(super) const SETINTERFACE: u32 = 4;
+    pub(super) const SETCONFIGURATION: u32 = 5;
+    pub(super) const GETDRIVER: u32 = 8;
+    pub(super) const SUBMITURB: u32 = 10;
+    pub(super) const DISCARDURB: u32 = 11;
+    pub(super) const REAPURB: u32 = 12;
+    pub(super) const REAPURBNDELAY: u32 = 13;
+    pub(super) const DISCSIGNAL: u32 = 14;
+    pub(super) const CLAIMINTERFACE: u32 = 15;
+    pub(super) const RELEASEINTERFACE: u32 = 16;
+    pub(super) const CONNECTINFO: u32 = 17;
+    pub(super) const IOCTL: u32 = 18;
+    pub(super) const RESET: u32 = 20;
+    pub(super) const CLEAR_HALT: u32 = 21;
+    pub(super) const DISCONNECT: u32 = 22;
+    pub(super) const CONNECT: u32 = 23;
+    pub(super) const CLAIM_PORT: u32 = 24;
+    pub(super) const RELEASE_PORT: u32 = 25;
+    pub(super) const GET_CAPABILITIES: u32 = 26;
+    pub(super) const DISCONNECT_CLAIM: u32 = 27;
+    pub(super) const ALLOC_STREAMS: u32 = 28;
+    pub(super) const FREE_STREAMS: u32 = 29;
+    pub(super) const DROP_PRIVILEGES: u32 = 30;
+    pub(super) const GET_SPEED: u32 = 31;
+    pub(super) const CONNINFO_EX: u32 = 32;
+    pub(super) const FORBID_SUSPEND: u32 = 33;
+    pub(super) const ALLOW_SUSPEND: u32 = 34;
+    pub(super) const WAIT_FOR_RESUME: u32 = 35;
+}
+
+/// `USBDEVFS_DISCONNECT_CLAIM`'s flags.
+const CLAIM_IF_DRIVER: u32 = 0x01;
+const CLAIM_EXCEPT_DRIVER: u32 = 0x02;
+
+/// Standard requests the ioctls make themselves.
+const SET_CONFIGURATION: u8 = 0x09;
+const SET_INTERFACE: u8 = 0x0b;
+
+/// xHCI speeds: Linux's `enum usb_device_speed` and sysfs's `speed`.
+fn speed_of(speed: u32) -> (i32, &'static str) {
+    match speed {
+        1 => (2, "12"),
+        2 => (1, "1.5"),
+        3 => (3, "480"),
+        4 => (5, "5000"),
+        7 => (6, "20000"),
+        5 | 6 => (6, "10000"),
+        _ => (0, "unknown"),
+    }
+}
+
+fn fail(code: i32, message: &'static str) -> Error {
+    Error::with_message(Errno::try_from(code).unwrap_or(Errno::EIO), message)
+}
+
+fn read_user(address: usize, bytes: &mut [u8]) -> Result<()> {
+    with_current_userspace(|user| user.read_bytes(address, bytes))?;
+    Ok(())
+}
+
+fn write_user(address: usize, bytes: &[u8]) -> Result<()> {
+    with_current_userspace(|user| user.write_bytes(address, bytes))?;
+    Ok(())
+}
+
+fn read_u32(address: usize) -> Result<u32> {
+    let mut bytes = [0u8; 4];
+    read_user(address, &mut bytes)?;
+    Ok(u32::from_le_bytes(bytes))
+}
+
+fn u32_at(bytes: &[u8], at: usize) -> u32 {
+    u32::from_le_bytes([bytes[at], bytes[at + 1], bytes[at + 2], bytes[at + 3]])
+}
+
+fn u64_at(bytes: &[u8], at: usize) -> u64 {
+    let mut value = [0u8; 8];
+    value.copy_from_slice(&bytes[at..at + 8]);
+    u64::from_le_bytes(value)
+}
+
+fn interface_of(value: u32) -> Result<u8> {
+    u8::try_from(value).map_err(|_| fail(errno::EINVAL, "there is no such interface"))
+}
+
+// ── What programs ask of a controller's task ────────────────────────────
+
+/// A controller's queue of what programs ask of its task.
+pub(crate) struct Host {
+    pub(crate) bus: u8,
+    requests: SpinLock<VecDeque<Request>>,
+}
+
+pub(crate) enum Request {
+    Submit(Arc<Urb>),
+    Cancel(Arc<Urb>),
+    Command(Arc<Command>),
+}
+
+impl Host {
+    pub(crate) fn new(bus: u8) -> Arc<Self> {
+        Arc::new(Self { bus, requests: SpinLock::new(VecDeque::new()) })
+    }
+
+    fn ask(&self, request: Request) {
+        self.requests.lock().push_back(request);
+        crate::wake();
+    }
+
+    pub(crate) fn take(&self) -> VecDeque<Request> {
+        core::mem::take(&mut *self.requests.lock())
+    }
+}
+
+/// A change to a device the controller's task makes.
+#[derive(Clone, Copy)]
+pub(crate) enum Action {
+    /// `SET_CONFIGURATION` (−1: unconfigured).
+    Configuration(i32),
+    /// `SET_INTERFACE`: interface, alternate setting.
+    Interface(u8, u8),
+    /// The device's endpoint halt cleared, and the controller's.
+    ClearHalt(u8),
+    /// The controller's endpoint reset (its data toggle).
+    ResetEndpoint(u8),
+    /// The device reset: its configuration and settings again.
+    Reset,
+}
+
+pub(crate) struct Command {
+    pub(crate) device: Arc<UsbDevice>,
+    pub(crate) action: Action,
+    result: SpinLock<Option<i32>>,
+    done: WaitQueue,
+}
+
+impl Command {
+    /// Its end: 0, or a negative error.
+    pub(crate) fn finish(&self, result: i32) {
+        *self.result.lock() = Some(result);
+        self.done.wake_all();
+    }
+}
+
+/// A transfer a program asked for.
+pub(crate) struct Urb {
+    pub(crate) device: Arc<UsbDevice>,
+    /// The file of an asynchronous transfer (none: a program waits for it).
+    file: Option<Weak<FileState>>,
+    /// The program's `struct usbdevfs_urb`.
+    user: usize,
+    pub(crate) kind: u8,
+    pub(crate) endpoint: Endpoint,
+    pub(crate) flags: u32,
+    pub(crate) setup: [u8; 8],
+    /// Its data's length (a control transfer's without the setup packet).
+    pub(crate) length: usize,
+    /// Where its data is in the program.
+    buffer: usize,
+    /// Its data, in pieces the controller reaches: memory, bytes used.
+    segments: Vec<(DmaCoherent, usize)>,
+    /// When a waited-for transfer times out (ms since boot).
+    pub(crate) deadline: Option<u64>,
+    reserved: usize,
+    /// How it ended: status (0 or a negative error) and bytes moved.
+    result: SpinLock<Option<(i32, usize)>>,
+    done: WaitQueue,
+}
+
+impl Urb {
+    #[allow(clippy::too_many_arguments)]
+    fn new(
+        device: &Arc<UsbDevice>,
+        file: Option<&Arc<FileState>>,
+        user: usize,
+        kind: u8,
+        endpoint: Endpoint,
+        flags: u32,
+        setup: [u8; 8],
+        length: usize,
+        buffer: usize,
+        timeout_ms: u32,
+    ) -> Result<Arc<Self>> {
+        if length > MEMORY_LIMIT || MEMORY.fetch_add(length, Ordering::Relaxed) + length > MEMORY_LIMIT {
+            if length <= MEMORY_LIMIT {
+                MEMORY.fetch_sub(length, Ordering::Relaxed);
+            }
+            return Err(fail(errno::ENOMEM, "the transfers hold too much memory"));
+        }
+        let mut segments = Vec::new();
+        let mut left = length;
+        while left > 0 {
+            let mut pages = left.div_ceil(PAGE_SIZE).min(SEGMENT_PAGES);
+            let memory = loop {
+                match DmaCoherent::alloc(pages, true) {
+                    Ok(memory) => break Some(memory),
+                    Err(_) if pages > 1 => pages = 1,
+                    Err(_) => break None,
+                }
+            };
+            let Some(memory) = memory else {
+                MEMORY.fetch_sub(length, Ordering::Relaxed);
+                return Err(fail(errno::ENOMEM, "no memory for the transfer"));
+            };
+            let bytes = (pages * PAGE_SIZE).min(left);
+            segments.push((memory, bytes));
+            left -= bytes;
+        }
+        let urb = Arc::new(Self {
+            device: device.clone(),
+            file: file.map(Arc::downgrade),
+            user,
+            kind,
+            endpoint,
+            flags,
+            setup,
+            length,
+            buffer,
+            segments,
+            deadline: (timeout_ms > 0).then(|| crate::now_ms() + u64::from(timeout_ms)),
+            reserved: length,
+            result: SpinLock::new(None),
+            done: WaitQueue::new(),
+        });
+        // What goes out is copied now.
+        if !urb.inward() {
+            let mut offset = 0;
+            for (memory, bytes) in &urb.segments {
+                let mut chunk = vec![0u8; *bytes];
+                read_user(buffer + offset, &mut chunk)?;
+                memory.write_bytes(0, &chunk)?;
+                offset += bytes;
+            }
+        }
+        Ok(urb)
+    }
+
+    /// Its device context index: the default control endpoint's is 1.
+    pub(crate) fn dci(&self) -> u8 {
+        if self.kind == urb_type::CONTROL { 1 } else { self.endpoint.dci() }
+    }
+
+    pub(crate) fn inward(&self) -> bool {
+        if self.kind == urb_type::CONTROL { self.setup[0] & 0x80 != 0 } else { self.endpoint.is_in() }
+    }
+
+    /// Its data as the controller takes it: (bus address, bytes), none
+    /// across a 64 KiB boundary.
+    pub(crate) fn pieces(&self) -> Vec<(u64, usize)> {
+        let mut pieces = Vec::new();
+        for (memory, bytes) in &self.segments {
+            let mut address = memory.daddr() as u64;
+            let mut left = *bytes;
+            while left > 0 {
+                let boundary = (address | 0xffff) + 1;
+                let piece = left.min((boundary - address) as usize);
+                pieces.push((address, piece));
+                address += piece as u64;
+                left -= piece;
+            }
+        }
+        pieces
+    }
+
+    /// The controller is done with it.
+    pub(crate) fn complete(self: &Arc<Self>, status: i32, actual: usize) {
+        {
+            let mut result = self.result.lock();
+            if result.is_some() {
+                return;
+            }
+            *result = Some((status, actual.min(self.length)));
+        }
+        self.done.wake_all();
+        if let Some(file) = self.file.as_ref().and_then(Weak::upgrade) {
+            file.completed.lock().push_back(self.clone());
+            file.pollee.notify(IoEvents::OUT);
+        }
+    }
+
+    fn result(&self) -> Option<(i32, usize)> {
+        *self.result.lock()
+    }
+
+    /// Copies what came in to the program.
+    fn copy_out(&self, actual: usize) -> Result<()> {
+        let mut offset = 0;
+        for (memory, bytes) in &self.segments {
+            let length = (*bytes).min(actual - offset);
+            if length == 0 {
+                break;
+            }
+            let mut chunk = vec![0u8; length];
+            memory.read_bytes(0, &mut chunk)?;
+            write_user(self.buffer + offset, &chunk)?;
+            offset += length;
+        }
+        Ok(())
+    }
+
+    /// Hands it to the controller and waits for it.
+    fn run(self: &Arc<Self>) -> (i32, usize) {
+        self.device.host.ask(Request::Submit(self.clone()));
+        self.done.wait_until(|| self.result())
+    }
+}
+
+impl Drop for Urb {
+    fn drop(&mut self) {
+        MEMORY.fetch_sub(self.reserved, Ordering::Relaxed);
+    }
+}
+
+// ── Devices ──────────────────────────────────────────────────────────────
+
+/// A USB device as programs see it.
+pub(crate) struct UsbDevice {
+    pub(crate) host: Arc<Host>,
+    /// Its slot (0: the controller's root hub).
+    pub(crate) slot_id: u8,
+    pub(crate) devnum: u8,
+    /// Its sysfs name (`usb1`, `1-2`, `1-2.4`).
+    pub(crate) name: String,
+    /// The ports from the root hub to it.
+    ports: Vec<u8>,
+    /// Its xHCI speed.
+    speed: u32,
+    /// Its device descriptor and every configuration descriptor, as read.
+    descriptors: Vec<u8>,
+    configurations: Vec<Configuration>,
+    /// Manufacturer, product, serial number.
+    strings: [Option<String>; 3],
+    /// A hub's ports.
+    hub_ports: u8,
+    pub(crate) state: SpinLock<DeviceState>,
+    sysfs: SpinLock<Option<Arc<BusDevice<UsbBus>>>>,
+    weak: Weak<Self>,
+}
+
+pub(crate) struct DeviceState {
+    /// The configuration in use (0: none).
+    pub(crate) active: u8,
+    /// Interfaces' alternate settings other than 0.
+    pub(crate) alternates: BTreeMap<u8, u8>,
+    /// Interfaces a kernel driver took: its name.
+    drivers: BTreeMap<u8, &'static str>,
+    /// Interfaces programs claimed: the file.
+    claims: BTreeMap<u8, u64>,
+    gone: bool,
+    files: Vec<Weak<FileState>>,
+}
+
+/// What the controller knows of a device it gives programs.
+pub(crate) struct NewDevice {
+    pub(crate) host: Arc<Host>,
+    pub(crate) slot_id: u8,
+    pub(crate) devnum: u8,
+    pub(crate) ports: Vec<u8>,
+    pub(crate) speed: u32,
+    pub(crate) descriptors: Vec<u8>,
+    pub(crate) configurations: Vec<Configuration>,
+    pub(crate) strings: [Option<String>; 3],
+    pub(crate) hub_ports: u8,
+    pub(crate) active: u8,
+    pub(crate) drivers: BTreeMap<u8, &'static str>,
+}
+
+impl UsbDevice {
+    pub(crate) fn new(new: NewDevice) -> Arc<Self> {
+        let name = if new.ports.is_empty() {
+            format!("usb{}", new.host.bus)
+        } else {
+            let path: Vec<String> = new.ports.iter().map(|port| format!("{}", port)).collect();
+            format!("{}-{}", new.host.bus, path.join("."))
+        };
+        Arc::new_cyclic(|weak| Self {
+            host: new.host,
+            slot_id: new.slot_id,
+            devnum: new.devnum,
+            name,
+            ports: new.ports,
+            speed: new.speed,
+            descriptors: new.descriptors,
+            configurations: new.configurations,
+            strings: new.strings,
+            hub_ports: new.hub_ports,
+            state: SpinLock::new(DeviceState {
+                active: new.active,
+                alternates: BTreeMap::new(),
+                drivers: new.drivers,
+                claims: BTreeMap::new(),
+                gone: false,
+                files: Vec::new(),
+            }),
+            sysfs: SpinLock::new(None),
+            weak: weak.clone(),
+        })
+    }
+
+    /// A controller's root hub (`usbN`): the hub its ports are, as Linux
+    /// shows it (1d6b:0002), for the tree of devices.
+    pub(crate) fn root_hub(host: Arc<Host>, ports: u8) -> Arc<Self> {
+        let mut descriptors = vec![18, 1, 0x00, 0x02, 9, 0, 1, 64, 0x6b, 0x1d, 0x02, 0x00, 0x00, 0x01, 0, 0, 0, 1];
+        let configuration = [9, 2, 25, 0, 1, 1, 0, 0xe0, 0, 9, 4, 0, 0, 1, 9, 0, 0, 0, 7, 5, 0x81, 3, 4, 0, 12];
+        descriptors.extend_from_slice(&configuration);
+        let configurations = desc::parse_configuration(&configuration).into_iter().collect();
+        Self::new(NewDevice {
+            host,
+            slot_id: 0,
+            devnum: 1,
+            ports: Vec::new(),
+            speed: 3,
+            descriptors,
+            configurations,
+            strings: [None, Some(String::from("xHCI Host Controller")), None],
+            hub_ports: ports,
+            active: 1,
+            drivers: BTreeMap::from([(0, "hub")]),
+        })
+    }
+
+    fn minor(&self) -> u32 {
+        u32::from(self.host.bus - 1) * 128 + u32::from(self.devnum) - 1
+    }
+
+    fn node_path(&self) -> String {
+        format!("bus/usb/{:03}/{:03}", self.host.bus, self.devnum)
+    }
+
+    /// Its sysfs path, as uevents give it.
+    fn devpath(&self) -> String {
+        let mut path = format!("/devices/usb{}", self.host.bus);
+        let mut name = format!("{}-", self.host.bus);
+        for (index, port) in self.ports.iter().enumerate() {
+            if index > 0 {
+                name.push('.');
+            }
+            name.push_str(&format!("{}", port));
+            path.push('/');
+            path.push_str(&name);
+        }
+        path
+    }
+
+    fn descriptor_u16(&self, at: usize) -> u16 {
+        u16::from_le_bytes([self.descriptors[at], self.descriptors[at + 1]])
+    }
+
+    fn max_packet0(&self) -> u16 {
+        let size = u16::from(self.descriptors[7]);
+        if self.descriptor_u16(2) >= 0x0300 { 1 << size.min(9) } else { size }
+    }
+
+    /// The default control endpoint.
+    fn ep0(&self) -> Endpoint {
+        Endpoint { address: 0, max_packet: self.max_packet0(), ..Endpoint::default() }
+    }
+
+    /// The header of the configuration in use, as read.
+    fn active_header(&self) -> Option<&[u8]> {
+        let active = self.state.lock().active;
+        let mut at = 18;
+        while at + 9 <= self.descriptors.len() {
+            let total = usize::from(self.descriptor_u16(at + 2)).max(9);
+            if self.descriptors[at + 5] == active {
+                return Some(&self.descriptors[at..at + 9]);
+            }
+            at += total;
+        }
+        None
+    }
+
+    fn is_gone(&self) -> bool {
+        self.state.lock().gone
+    }
+
+    /// The configuration in use.
+    fn active(&self) -> Option<&Configuration> {
+        let active = self.state.lock().active;
+        self.configurations.iter().find(|configuration| active != 0 && configuration.value == active)
+    }
+
+    /// The endpoint with this address in its interface's current setting,
+    /// and the interface.
+    fn find_endpoint(&self, address: u8) -> Option<(u8, Endpoint)> {
+        let configuration = self.active()?;
+        let alternates = self.state.lock().alternates.clone();
+        configuration
+            .interfaces
+            .iter()
+            .filter(|interface| interface.alternate == alternates.get(&interface.number).copied().unwrap_or(0))
+            .find_map(|interface| {
+                interface.endpoints.iter().find(|endpoint| endpoint.address == address).map(|endpoint| (interface.number, *endpoint))
+            })
+    }
+
+    /// The settings an interface has (0: it is not there).
+    pub(crate) fn settings_of(&self, interface: u8) -> usize {
+        self.active().map_or(0, |configuration| configuration.interfaces.iter().filter(|each| each.number == interface).count())
+    }
+
+    /// The device context indexes an interface's endpoints may have.
+    pub(crate) fn interface_dcis(&self, interface: u8) -> Vec<u8> {
+        let mut dcis: Vec<u8> = self
+            .active()
+            .map(|configuration| {
+                configuration
+                    .interfaces
+                    .iter()
+                    .filter(|each| each.number == interface)
+                    .flat_map(|each| each.endpoints.iter().map(Endpoint::dci))
+                    .collect()
+            })
+            .unwrap_or_default();
+        dcis.sort_unstable();
+        dcis.dedup();
+        dcis
+    }
+
+    /// A program's file takes an interface (Linux's `claimintf`).
+    fn claim(&self, file: u64, interface: u8) -> Result<()> {
+        if self.settings_of(interface) == 0 {
+            return Err(fail(errno::ENOENT, "the configuration has no such interface"));
+        }
+        let mut state = self.state.lock();
+        if state.gone {
+            return Err(fail(errno::ENODEV, "the device is gone"));
+        }
+        match state.claims.get(&interface) {
+            Some(owner) if *owner == file => return Ok(()),
+            Some(_) => return Err(fail(errno::EBUSY, "another program has the interface")),
+            None => {}
+        }
+        if state.drivers.contains_key(&interface) {
+            return Err(fail(errno::EBUSY, "a kernel driver has the interface"));
+        }
+        state.claims.insert(interface, file);
+        Ok(())
+    }
+
+    fn release(&self, file: u64, interface: u8) -> Result<()> {
+        let mut state = self.state.lock();
+        if state.claims.get(&interface) != Some(&file) {
+            return Err(fail(errno::EINVAL, "the interface is not the program's"));
+        }
+        state.claims.remove(&interface);
+        Ok(())
+    }
+
+    /// Asks the controller's task to change the device, and waits.
+    fn command(&self, action: Action) -> Result<()> {
+        let device = self.weak.upgrade().ok_or_else(|| fail(errno::ENODEV, "the device is gone"))?;
+        let command = Arc::new(Command { device, action, result: SpinLock::new(None), done: WaitQueue::new() });
+        self.host.ask(Request::Command(command.clone()));
+        match command.done.wait_until(|| *command.result.lock()) {
+            0 => Ok(()),
+            code => Err(fail(-code, "the device did not take the request")),
+        }
+    }
+
+    /// Its uevent's variables (and its `uevent` attribute's).
+    fn environment(&self) -> Vec<(&'static str, String)> {
+        let mut environment = Vec::new();
+        if self.slot_id != 0 {
+            environment.push(("MAJOR", format!("{}", USB_DEVICE_MAJOR)));
+            environment.push(("MINOR", format!("{}", self.minor())));
+            environment.push(("DEVNAME", self.node_path()));
+        }
+        environment.push(("DEVTYPE", String::from("usb_device")));
+        environment.push(("DRIVER", String::from("usb")));
+        environment.push((
+            "PRODUCT",
+            format!("{:x}/{:x}/{:x}", self.descriptor_u16(8), self.descriptor_u16(10), self.descriptor_u16(12)),
+        ));
+        environment.push(("TYPE", format!("{}/{}/{}", self.descriptors[4], self.descriptors[5], self.descriptors[6])));
+        environment.push(("BUSNUM", format!("{:03}", self.host.bus)));
+        environment.push(("DEVNUM", format!("{:03}", self.devnum)));
+        environment
+    }
+
+    fn uevent(&self, action: &str) {
+        let environment = self.environment();
+        let pairs: Vec<(&str, &str)> = environment.iter().map(|(key, value)| (*key, value.as_str())).collect();
+        aster_core::device::uevent(action, &self.devpath(), "usb", &pairs);
+    }
+}
+
+impl Device for UsbDevice {
+    fn type_(&self) -> DeviceType {
+        DeviceType::Char
+    }
+
+    fn id(&self) -> DeviceId {
+        DeviceId::new(MajorId::new(USB_DEVICE_MAJOR), MinorId::new(self.minor()))
+    }
+
+    fn devtmpfs_meta(&self) -> Option<DevtmpfsNodeMeta> {
+        // The device model makes the node (`/dev/bus/usb/BBB/DDD`).
+        None
+    }
+
+    fn open(&self) -> Result<Box<dyn PerOpenFileOps>> {
+        let device = self.weak.upgrade().ok_or_else(|| fail(errno::ENODEV, "the device is gone"))?;
+        let file = Arc::new(FileState {
+            device,
+            id: NEXT_FILE.fetch_add(1, Ordering::Relaxed),
+            pending: SpinLock::new(Vec::new()),
+            completed: SpinLock::new(VecDeque::new()),
+            pollee: PollSource::new(),
+        });
+        let mut state = self.state.lock();
+        if state.gone {
+            return Err(fail(errno::ENODEV, "the device is gone"));
+        }
+        state.files.retain(|each| each.strong_count() > 0);
+        state.files.push(Arc::downgrade(&file));
+        drop(state);
+        Ok(Box::new(UsbFile(file)))
+    }
+}
+
+/// Gives programs a device: its device file, its sysfs directory, and the
+/// uevent that says it came.
+pub(crate) fn publish(device: &Arc<UsbDevice>, parent: Option<&Arc<UsbDevice>>) {
+    let Some(bus) = bus() else { return };
+    let mut builder = BusDevice::builder(bus, device.name.clone(), device.clone()).dev_type(&USB_DEVICE);
+    let parent = parent.and_then(|parent| parent.sysfs.lock().clone());
+    if let Some(parent) = parent {
+        builder = builder.parent(parent as Arc<dyn AnyDevice>);
+    }
+    let node = device.slot_id != 0 && device.devnum <= 128;
+    if node {
+        if let Err(error) = char::register(device.clone() as Arc<dyn Device>) {
+            ostd::notice!("{}: no device file: {:?}", device.name, error);
+            return;
+        }
+        builder = builder.devnum(DevNum::char(device.id()));
+    }
+    let sysfs = builder.build();
+    if let Err(error) = aster_device::add_device(&sysfs) {
+        ostd::notice!("{}: not in sysfs: {:?}", device.name, error);
+        if node {
+            let _ = char::unregister(device.id());
+        }
+        return;
+    }
+    *device.sysfs.lock() = Some(sysfs);
+    device.uevent("add");
+}
+
+/// The device went: programs' files see it, its sysfs directory and device
+/// file go, and a uevent says so.
+pub(crate) fn remove(device: &Arc<UsbDevice>) {
+    let files = {
+        let mut state = device.state.lock();
+        state.gone = true;
+        state.claims.clear();
+        core::mem::take(&mut state.files)
+    };
+    for file in files.iter().filter_map(Weak::upgrade) {
+        file.pollee.notify(IoEvents::HUP | IoEvents::ERR);
+    }
+    let sysfs = device.sysfs.lock().take();
+    let Some(sysfs) = sysfs else { return };
+    device.uevent("remove");
+    let _ = aster_device::remove_device(&sysfs);
+    if device.slot_id != 0 && device.devnum <= 128 {
+        let _ = char::unregister(device.id());
+    }
+}
+
+// ── Device files ─────────────────────────────────────────────────────────
+
+struct FileState {
+    device: Arc<UsbDevice>,
+    id: u64,
+    /// URBs submitted and not reaped.
+    pending: SpinLock<Vec<Arc<Urb>>>,
+    /// URBs done, to reap.
+    completed: SpinLock<VecDeque<Arc<Urb>>>,
+    pollee: PollSource,
+}
+
+struct UsbFile(Arc<FileState>);
+
+impl Drop for UsbFile {
+    // What the program left is taken back and its interfaces let go
+    // (Linux's `usbdev_release`).
+    fn drop(&mut self) {
+        let file = &self.0;
+        let running: Vec<Arc<Urb>> = file.pending.lock().iter().filter(|urb| urb.result().is_none()).cloned().collect();
+        for urb in running {
+            file.device.host.ask(Request::Cancel(urb));
+        }
+        let mut state = file.device.state.lock();
+        state.claims.retain(|_, owner| *owner != file.id);
+        state.files.retain(|each| each.strong_count() > 0 && !core::ptr::eq(each.as_ptr(), Arc::as_ptr(file)));
+    }
+}
+
+impl UsbFile {
+    /// Checks what a control request addresses (Linux's `check_ctrlrecip`):
+    /// an interface, or an endpoint's, must be the program's.
+    fn check_control(&self, setup: &[u8; 8]) -> Result<()> {
+        let device = &self.0.device;
+        let (request_type, request) = (setup[0], setup[1]);
+        let index = u16::from_le_bytes([setup[4], setup[5]]);
+        // Vendor requests go through.
+        if request_type & 0x60 == 0x40 {
+            return Ok(());
+        }
+        // The printer class's GET_DEVICE_ID, which CUPS asks of any printer.
+        if request_type == 0xa1 && request == 0 {
+            let printer = device.active().is_some_and(|configuration| {
+                configuration.interfaces.iter().any(|interface| {
+                    u16::from(interface.number) == index >> 8 && u16::from(interface.alternate) == index & 0xff && interface.class == 7
+                })
+            });
+            if printer {
+                return Ok(());
+            }
+        }
+        let index = (index & 0xff) as u8;
+        match request_type & 0x1f {
+            // An endpoint.
+            2 => {
+                if index & !0x80 == 0 {
+                    return Ok(());
+                }
+                let found = device.find_endpoint(index).or_else(|| device.find_endpoint(index ^ 0x80));
+                let (interface, _) = found.ok_or_else(|| fail(errno::ENOENT, "there is no such endpoint"))?;
+                device.claim(self.0.id, interface)
+            }
+            // An interface.
+            1 => device.claim(self.0.id, index),
+            _ => Ok(()),
+        }
+    }
+
+    /// `USBDEVFS_CONTROL`: a control transfer, waited for.
+    fn control(&self, arg: usize) -> Result<i32> {
+        let mut raw = [0u8; 24];
+        read_user(arg, &mut raw)?;
+        let mut setup = [0u8; 8];
+        setup.copy_from_slice(&raw[..8]);
+        let timeout = u32_at(&raw, 8);
+        let data = u64_at(&raw, 16) as usize;
+        self.check_control(&setup)?;
+        let value = u16::from_le_bytes([setup[2], setup[3]]);
+        let index = u16::from_le_bytes([setup[4], setup[5]]);
+        // Configuration changes are the ioctls' own, so endpoints follow.
+        if (setup[0], setup[1]) == (0x00, SET_CONFIGURATION) {
+            return self.set_configuration(i32::from(value)).map(|()| 0);
+        }
+        if (setup[0], setup[1]) == (0x01, SET_INTERFACE) {
+            return self.set_interface(u32::from(index), u32::from(value)).map(|()| 0);
+        }
+        let device = &self.0.device;
+        let length = usize::from(u16::from_le_bytes([setup[6], setup[7]]));
+        let urb = Urb::new(device, None, 0, urb_type::CONTROL, device.ep0(), 0, setup, length, data, timeout)?;
+        let (status, actual) = urb.run();
+        if status < 0 {
+            return Err(fail(-status, "the control transfer failed"));
+        }
+        if urb.inward() && actual > 0 {
+            urb.copy_out(actual)?;
+        }
+        Ok(actual as i32)
+    }
+
+    /// `USBDEVFS_BULK`: a bulk or interrupt transfer, waited for.
+    fn bulk(&self, arg: usize) -> Result<i32> {
+        let mut raw = [0u8; 24];
+        read_user(arg, &mut raw)?;
+        let address = u32_at(&raw, 0) as u8;
+        let length = u32_at(&raw, 4) as usize;
+        let timeout = u32_at(&raw, 8);
+        let data = u64_at(&raw, 16) as usize;
+        let device = &self.0.device;
+        let (interface, endpoint) = device.find_endpoint(address).ok_or_else(|| fail(errno::ENOENT, "there is no such endpoint"))?;
+        let kind = match endpoint.transfer_type() {
+            TRANSFER_BULK => urb_type::BULK,
+            TRANSFER_INTERRUPT => urb_type::INTERRUPT,
+            _ => return Err(fail(errno::EINVAL, "not a bulk or interrupt endpoint")),
+        };
+        device.claim(self.0.id, interface)?;
+        let urb = Urb::new(device, None, 0, kind, endpoint, 0, [0; 8], length, data, timeout)?;
+        let (status, actual) = urb.run();
+        if status < 0 {
+            return Err(fail(-status, "the transfer failed"));
+        }
+        if urb.inward() && actual > 0 {
+            urb.copy_out(actual)?;
+        }
+        Ok(actual as i32)
+    }
+
+    /// `USBDEVFS_SUBMITURB`: a transfer to reap later.
+    fn submit(&self, arg: usize) -> Result<()> {
+        let mut raw = [0u8; 56];
+        read_user(arg, &mut raw)?;
+        let (kind, address) = (raw[0], raw[1]);
+        let flags = u32_at(&raw, 8);
+        let buffer = u64_at(&raw, 16) as usize;
+        let buffer_length = u32_at(&raw, 24) as i32;
+        if buffer_length < 0 {
+            return Err(fail(errno::EINVAL, "the buffer's length is negative"));
+        }
+        let device = &self.0.device;
+        let (kind, endpoint, setup, length, data) = match kind {
+            urb_type::CONTROL => {
+                if buffer_length < 8 || address & 0x7f != 0 {
+                    return Err(fail(errno::EINVAL, "a control URB needs its setup packet, on endpoint 0"));
+                }
+                let mut setup = [0u8; 8];
+                read_user(buffer, &mut setup)?;
+                let length = usize::from(u16::from_le_bytes([setup[6], setup[7]]));
+                if length > buffer_length as usize - 8 {
+                    return Err(fail(errno::EINVAL, "the setup packet asks for more than the buffer holds"));
+                }
+                self.check_control(&setup)?;
+                (urb_type::CONTROL, device.ep0(), setup, length, buffer + 8)
+            }
+            urb_type::BULK | urb_type::INTERRUPT => {
+                let (interface, endpoint) =
+                    device.find_endpoint(address).ok_or_else(|| fail(errno::ENOENT, "there is no such endpoint"))?;
+                // A bulk URB on an interrupt endpoint is a single-shot interrupt transfer.
+                let kind = match (kind, endpoint.transfer_type()) {
+                    (_, TRANSFER_INTERRUPT) => urb_type::INTERRUPT,
+                    (urb_type::BULK, TRANSFER_BULK) => urb_type::BULK,
+                    _ => return Err(fail(errno::EINVAL, "the endpoint is of another type")),
+                };
+                device.claim(self.0.id, interface)?;
+                (kind, endpoint, [0; 8], buffer_length as usize, buffer)
+            }
+            urb_type::ISO => return Err(fail(errno::EINVAL, "isochronous transfers are not offered")),
+            _ => return Err(fail(errno::EINVAL, "unknown URB type")),
+        };
+        let urb = Urb::new(device, Some(&self.0), arg, kind, endpoint, flags, setup, length, data, 0)?;
+        self.0.pending.lock().push(urb.clone());
+        device.host.ask(Request::Submit(urb));
+        Ok(())
+    }
+
+    /// `USBDEVFS_DISCARDURB`: takes a submitted URB back.
+    fn discard(&self, arg: usize) -> Result<i32> {
+        let urb = self.0.pending.lock().iter().find(|urb| urb.user == arg && urb.result().is_none()).cloned();
+        let urb = urb.ok_or_else(|| fail(errno::EINVAL, "no such URB is running"))?;
+        self.0.device.host.ask(Request::Cancel(urb));
+        Ok(0)
+    }
+
+    /// `USBDEVFS_REAPURB(NDELAY)`: gives back a URB that is done.
+    fn reap(&self, arg: usize, block: bool) -> Result<i32> {
+        let file = &self.0;
+        let try_reap = || -> Result<i32> {
+            let urb = file.completed.lock().pop_front();
+            file.pollee.invalidate();
+            let Some(urb) = urb else {
+                if file.device.is_gone() {
+                    return Err(fail(errno::ENODEV, "the device is gone"));
+                }
+                return_errno_with_message!(Errno::EAGAIN, "no URB is done");
+            };
+            file.pending.lock().retain(|each| !Arc::ptr_eq(each, &urb));
+            let (status, actual) = urb.result().unwrap_or((-errno::EPROTO, 0));
+            if urb.inward() && actual > 0 {
+                urb.copy_out(actual)?;
+            }
+            write_user(urb.user + 4, &status.to_le_bytes())?;
+            write_user(urb.user + 28, &(actual as i32).to_le_bytes())?;
+            write_user(urb.user + 32, &0i32.to_le_bytes())?;
+            write_user(urb.user + 40, &0i32.to_le_bytes())?;
+            write_user(arg, &(urb.user as u64).to_le_bytes())?;
+            Ok(0)
+        };
+        if block { self.wait_events(IoEvents::OUT, None, try_reap) } else { try_reap() }
+    }
+
+    fn set_configuration(&self, value: i32) -> Result<()> {
+        let device = &self.0.device;
+        if value != -1 && value != 0 && !device.configurations.iter().any(|configuration| i32::from(configuration.value) == value) {
+            return Err(fail(errno::EINVAL, "there is no such configuration"));
+        }
+        {
+            let state = device.state.lock();
+            if !state.drivers.is_empty() || !state.claims.is_empty() {
+                return Err(fail(errno::EBUSY, "an interface is in use"));
+            }
+        }
+        device.command(Action::Configuration(value))
+    }
+
+    fn set_interface(&self, interface: u32, alternate: u32) -> Result<()> {
+        let device = &self.0.device;
+        let interface = interface_of(interface)?;
+        device.claim(self.0.id, interface)?;
+        let alternate = u8::try_from(alternate).map_err(|_| fail(errno::EINVAL, "there is no such setting"))?;
+        let exists = device.active().is_some_and(|configuration| {
+            configuration.interfaces.iter().any(|each| each.number == interface && each.alternate == alternate)
+        });
+        if !exists {
+            return Err(fail(errno::EINVAL, "there is no such setting"));
+        }
+        device.command(Action::Interface(interface, alternate))
+    }
+
+    /// The driver an interface has: a kernel driver's name, `usbfs` for a
+    /// program's.
+    fn driver_of(&self, interface: u8) -> Option<&'static str> {
+        let state = self.0.device.state.lock();
+        if state.claims.contains_key(&interface) {
+            return Some("usbfs");
+        }
+        state.drivers.get(&interface).copied()
+    }
+
+    /// `USBDEVFS_IOCTL`: an ioctl for an interface's driver (detaching one
+    /// or attaching it again).
+    fn interface_ioctl(&self, arg: usize) -> Result<i32> {
+        let mut raw = [0u8; 16];
+        read_user(arg, &mut raw)?;
+        let interface = interface_of(u32_at(&raw, 0))?;
+        let code = u32_at(&raw, 4);
+        if (code >> 8) & 0xff != u32::from(b'U') {
+            return_errno_with_message!(Errno::ENOTTY, "the interface's driver has no such ioctl");
+        }
+        let device = &self.0.device;
+        let mut state = device.state.lock();
+        match code & 0xff {
+            nr::DISCONNECT => {
+                if state.claims.remove(&interface).is_some() {
+                    return Ok(0);
+                }
+                if state.drivers.contains_key(&interface) {
+                    return Err(fail(errno::EBUSY, "the kernel's driver stays"));
+                }
+                Err(fail(errno::ENODATA, "the interface has no driver"))
+            }
+            nr::CONNECT => {
+                if state.claims.contains_key(&interface) {
+                    return Err(fail(errno::EBUSY, "a program has the interface"));
+                }
+                Ok(0)
+            }
+            _ => return_errno_with_message!(Errno::ENOTTY, "the interface's driver has no such ioctl"),
+        }
+    }
+
+    /// `USBDEVFS_DISCONNECT_CLAIM`: claims an interface, its driver let go.
+    fn disconnect_claim(&self, arg: usize) -> Result<i32> {
+        let mut raw = [0u8; 264];
+        read_user(arg, &mut raw)?;
+        let interface = interface_of(u32_at(&raw, 0))?;
+        let flags = u32_at(&raw, 4);
+        let name = &raw[8..];
+        let name = &name[..name.iter().position(|byte| *byte == 0).unwrap_or(name.len())];
+        if let Some(driver) = self.driver_of(interface) {
+            let same = driver.as_bytes() == name;
+            if (flags & CLAIM_IF_DRIVER != 0 && !same) || (flags & CLAIM_EXCEPT_DRIVER != 0 && same) {
+                return Err(fail(errno::EBUSY, "the interface's driver stays"));
+            }
+            if driver != "usbfs" {
+                return Err(fail(errno::EBUSY, "the kernel's driver stays"));
+            }
+        }
+        self.0.device.claim(self.0.id, interface)?;
+        Ok(0)
+    }
+
+    /// The interface of an endpoint a request names, claimed.
+    fn claim_endpoint(&self, address: u32) -> Result<u8> {
+        let address = address as u8;
+        let (interface, _) = self.0.device.find_endpoint(address).ok_or_else(|| fail(errno::ENOENT, "there is no such endpoint"))?;
+        self.0.device.claim(self.0.id, interface)?;
+        Ok(address)
+    }
+}
+
+impl Pollable for UsbFile {
+    fn poll(&self, mask: IoEvents, poller: Option<&mut PollHandle>) -> IoEvents {
+        let file = &self.0;
+        file.pollee.poll_with(mask, poller, || {
+            let mut events = IoEvents::empty();
+            if !file.completed.lock().is_empty() {
+                events |= IoEvents::OUT;
+            }
+            if file.device.is_gone() {
+                events |= IoEvents::HUP | IoEvents::ERR;
+            }
+            events
+        })
+    }
+}
+
+impl FileOps for UsbFile {
+    // The descriptors, as Linux's `usbdev_read` gives them.
+    fn read_at(&self, offset: usize, writer: &mut VmWriter, _status_flags: StatusFlags) -> Result<usize> {
+        let descriptors = &self.0.device.descriptors;
+        if offset >= descriptors.len() {
+            return Ok(0);
+        }
+        Ok(writer.write_fallible(&mut VmReader::from(&descriptors[offset..]))?)
+    }
+
+    fn write_at(&self, _offset: usize, _reader: &mut VmReader, _status_flags: StatusFlags) -> Result<usize> {
+        return_errno_with_message!(Errno::EINVAL, "a USB device file is not written");
+    }
+}
+
+impl PerOpenFileOps for UsbFile {
+    fn check_seekable(&self) -> Result<()> {
+        Ok(())
+    }
+
+    fn is_offset_aware(&self) -> bool {
+        true
+    }
+
+    fn ioctl(&self, _path: &Path, raw_ioctl: RawIoctl) -> Result<i32> {
+        let (cmd, arg) = (raw_ioctl.cmd(), raw_ioctl.arg());
+        if (cmd >> 8) & 0xff != u32::from(b'U') {
+            return_errno_with_message!(Errno::ENOTTY, "not a usbfs ioctl");
+        }
+        let size = ((cmd >> 16) & 0x3fff) as usize;
+        let file = &self.0;
+        let device = &file.device;
+        match cmd & 0xff {
+            nr::REAPURB => self.reap(arg, true),
+            nr::REAPURBNDELAY => self.reap(arg, false),
+            nr::GET_CAPABILITIES => {
+                write_user(arg, &CAPABILITIES.to_le_bytes())?;
+                Ok(0)
+            }
+            _ if device.is_gone() => Err(fail(errno::ENODEV, "the device is gone")),
+            nr::CONTROL => self.control(arg),
+            nr::BULK => self.bulk(arg),
+            nr::SUBMITURB => self.submit(arg).map(|()| 0),
+            nr::DISCARDURB => self.discard(arg),
+            nr::CLAIMINTERFACE => device.claim(file.id, interface_of(read_u32(arg)?)?).map(|()| 0),
+            nr::RELEASEINTERFACE => device.release(file.id, interface_of(read_u32(arg)?)?).map(|()| 0),
+            nr::SETINTERFACE => {
+                let mut raw = [0u8; 8];
+                read_user(arg, &mut raw)?;
+                self.set_interface(u32_at(&raw, 0), u32_at(&raw, 4)).map(|()| 0)
+            }
+            nr::SETCONFIGURATION => self.set_configuration(read_u32(arg)? as i32).map(|()| 0),
+            nr::GETDRIVER => {
+                let interface = interface_of(read_u32(arg)?)?;
+                let driver = self.driver_of(interface).ok_or_else(|| fail(errno::ENODATA, "the interface has no driver"))?;
+                let mut name = [0u8; 256];
+                name[..driver.len()].copy_from_slice(driver.as_bytes());
+                write_user(arg + 4, &name)?;
+                Ok(0)
+            }
+            nr::CONNECTINFO => {
+                let mut raw = [0u8; 8];
+                raw[..4].copy_from_slice(&u32::from(device.devnum).to_le_bytes());
+                raw[4] = u8::from(device.speed == 2);
+                write_user(arg, &raw)?;
+                Ok(0)
+            }
+            nr::CONNINFO_EX => {
+                let mut raw = [0u8; 24];
+                raw[..4].copy_from_slice(&24u32.to_le_bytes());
+                raw[4..8].copy_from_slice(&u32::from(device.host.bus).to_le_bytes());
+                raw[8..12].copy_from_slice(&u32::from(device.devnum).to_le_bytes());
+                raw[12..16].copy_from_slice(&(speed_of(device.speed).0 as u32).to_le_bytes());
+                raw[16] = device.ports.len() as u8;
+                for (at, port) in device.ports.iter().take(7).enumerate() {
+                    raw[17 + at] = *port;
+                }
+                write_user(arg, &raw[..size.min(raw.len())])?;
+                Ok(0)
+            }
+            nr::IOCTL => self.interface_ioctl(arg),
+            nr::DISCONNECT_CLAIM => self.disconnect_claim(arg),
+            nr::RESET => device.command(Action::Reset).map(|()| 0),
+            nr::CLEAR_HALT => {
+                let address = self.claim_endpoint(read_u32(arg)?)?;
+                device.command(Action::ClearHalt(address)).map(|()| 0)
+            }
+            nr::RESETEP => {
+                let address = self.claim_endpoint(read_u32(arg)?)?;
+                device.command(Action::ResetEndpoint(address)).map(|()| 0)
+            }
+            nr::GET_SPEED => Ok(speed_of(device.speed).0),
+            // Signals on disconnection are not sent; the rest has nothing to do here.
+            nr::DISCSIGNAL | nr::DROP_PRIVILEGES | nr::FORBID_SUSPEND | nr::ALLOW_SUSPEND | nr::WAIT_FOR_RESUME => Ok(0),
+            nr::CLAIM_PORT | nr::RELEASE_PORT | nr::ALLOC_STREAMS | nr::FREE_STREAMS | nr::DISCONNECT | nr::CONNECT => {
+                Err(fail(errno::EINVAL, "not offered"))
+            }
+            _ => return_errno_with_message!(Errno::ENOTTY, "unknown usbfs ioctl"),
+        }
+    }
+}
