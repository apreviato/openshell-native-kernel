+// SPDX-License-Identifier: MPL-2.0
+
+//! The wait queue of a driver's task (Linux drivers sleep on a
+//! `wait_queue_head_t` or a completion, woken from their interrupt
+//! handler): woken by the device's interrupt and by the timer, which also
+//! keeps time-outs going and looks at devices whose interrupts do not
+//! arrive.
+
+use core::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+use ostd::sync::WaitQueue;
+
+use crate::delay::now_ms;
+
+pub struct Waker {
+    queue: WaitQueue,
+    woken: AtomicBool,
+    ticks: AtomicUsize,
+    /// Timer ticks between wake-ups when nothing hurries it.
+    idle_period: usize,
+    /// Tasks sleeping on a time-out: woken every tick.
+    waiting: AtomicUsize,
+    /// Devices whose interrupts were not seen yet: woken every other tick.
+    hurried: AtomicUsize,
+    started: AtomicBool,
+}
+
+impl Waker {
+    /// A waker the timer also wakes every `idle_period` ticks (the timer
+    /// ticks once a millisecond).
+    pub const fn new(idle_period: usize) -> Self {
+        Self {
+            queue: WaitQueue::new(),
+            woken: AtomicBool::new(false),
+            ticks: AtomicUsize::new(0),
+            idle_period,
+            waiting: AtomicUsize::new(0),
+            hurried: AtomicUsize::new(0),
+            started: AtomicBool::new(false),
+        }
+    }
+
+    /// The timer starts waking this waker (once; from the driver's init).
+    pub fn start_timer(&'static self) {
+        if self.started.swap(true, Ordering::AcqRel) {
+            return;
+        }
+        ostd::timer::register_callback_on_cpu(move || self.tick());
+    }
+
+    fn tick(&self) {
+        let ticks = self.ticks.fetch_add(1, Ordering::Relaxed);
+        let period = if self.waiting.load(Ordering::Relaxed) > 0 {
+            1
+        } else if self.hurried.load(Ordering::Relaxed) > 0 {
+            2
+        } else {
+            self.idle_period.max(1)
+        };
+        if ticks % period == 0 {
+            self.wake();
+        }
+    }
+
+    /// `wake_up`: from an interrupt handler or another task.
+    pub fn wake(&self) {
+        self.woken.store(true, Ordering::Release);
+        self.queue.wake_all();
+    }
+
+    /// Sleeps until woken.
+    pub fn sleep(&self) {
+        self.queue.wait_until(|| self.woken.swap(false, Ordering::AcqRel).then_some(()));
+    }
+
+    /// `msleep`: sleeps at least `ms` milliseconds.
+    pub fn msleep(&self, ms: u64) {
+        let deadline = now_ms() + ms;
+        let _waiting = self.waiting();
+        while now_ms() < deadline {
+            self.sleep();
+        }
+    }
+
+    /// `wait_event_timeout`: sleeps until `done` holds or `ms` passed;
+    /// whether it held.
+    pub fn wait_event_timeout(&self, mut done: impl FnMut() -> bool, ms: u64) -> bool {
+        let deadline = now_ms() + ms;
+        let _waiting = self.waiting();
+        loop {
+            if done() {
+                return true;
+            }
+            if now_ms() >= deadline {
+                return false;
+            }
+            self.sleep();
+        }
+    }
+
+    /// While the guard lives, the timer wakes this waker every tick (a task
+    /// waits on a time-out).
+    pub fn waiting(&self) -> Guard<'_> {
+        self.waiting.fetch_add(1, Ordering::AcqRel);
+        Guard(&self.waiting)
+    }
+
+    /// While the guard lives, the timer wakes this waker every other tick
+    /// (a device whose interrupts were not seen to arrive).
+    pub fn hurried(&self) -> Guard<'_> {
+        self.hurried.fetch_add(1, Ordering::AcqRel);
+        Guard(&self.hurried)
+    }
+}
+
+/// Undoes [`Waker::waiting`] or [`Waker::hurried`] when dropped.
+pub struct Guard<'a>(&'a AtomicUsize);
+
+impl Drop for Guard<'_> {
+    fn drop(&mut self) {
+        self.0.fetch_sub(1, Ordering::AcqRel);
+    }
+}
