diff --git a/kernel/comps/linuxkpi/src/bits.rs b/kernel/comps/linuxkpi/src/bits.rs
new file mode 100644
index 0000000..a36247e
--- /dev/null
+++ b/kernel/comps/linuxkpi/src/bits.rs
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! `linux/bits.h`, `linux/bitfield.h` and the unaligned little-endian
+//! accessors (`get_unaligned_le32` and the like) over byte buffers.
+
+/// `BIT(n)`.
+pub const fn bit(n: u32) -> u32 {
+    1 << n
+}
+
+/// `GENMASK(high, low)`: bits `low` to `high`, both included.
+pub const fn genmask(high: u32, low: u32) -> u32 {
+    (u32::MAX >> (31 - high)) & (u32::MAX << low)
+}
+
+/// `FIELD_GET(mask, value)`.
+pub const fn field_get(mask: u32, value: u32) -> u32 {
+    (value & mask) >> mask.trailing_zeros()
+}
+
+/// `FIELD_PREP(mask, value)`.
+pub const fn field_prep(mask: u32, value: u32) -> u32 {
+    (value << mask.trailing_zeros()) & mask
+}
+
+/// `u32_replace_bits`: `value` with the field under `mask` set to `field`.
+pub const fn replace_bits(value: u32, field: u32, mask: u32) -> u32 {
+    (value & !mask) | field_prep(mask, field)
+}
+
+/// `get_unaligned_le16` at a byte offset; 0 past the end.
+pub fn get_le16(data: &[u8], at: usize) -> u16 {
+    data.get(at..at + 2).map_or(0, |b| u16::from_le_bytes([b[0], b[1]]))
+}
+
+/// `get_unaligned_le32` at a byte offset; 0 past the end.
+pub fn get_le32(data: &[u8], at: usize) -> u32 {
+    data.get(at..at + 4).map_or(0, |b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+}
+
+/// `get_unaligned_le64` at a byte offset; 0 past the end.
+pub fn get_le64(data: &[u8], at: usize) -> u64 {
+    data.get(at..at + 8).map_or(0, |b| u64::from_le_bytes([b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]]))
+}
+
+/// `put_unaligned_le16`; nothing past the end.
+pub fn put_le16(data: &mut [u8], at: usize, value: u16) {
+    if let Some(field) = data.get_mut(at..at + 2) {
+        field.copy_from_slice(&value.to_le_bytes());
+    }
+}
+
+/// `put_unaligned_le32`; nothing past the end.
+pub fn put_le32(data: &mut [u8], at: usize, value: u32) {
+    if let Some(field) = data.get_mut(at..at + 4) {
+        field.copy_from_slice(&value.to_le_bytes());
+    }
+}
+
+/// `put_unaligned_le64`; nothing past the end.
+pub fn put_le64(data: &mut [u8], at: usize, value: u64) {
+    if let Some(field) = data.get_mut(at..at + 8) {
+        field.copy_from_slice(&value.to_le_bytes());
+    }
+}
diff --git a/kernel/comps/linuxkpi/src/delay.rs b/kernel/comps/linuxkpi/src/delay.rs
new file mode 100644
index 0000000..0355d95
--- /dev/null
+++ b/kernel/comps/linuxkpi/src/delay.rs
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! `linux/delay.h`, `linux/iopoll.h` and the clock drivers read: busy
+//! waits measured by the TSC (the timer ticks once a millisecond, too
+//! coarse for a chip's handshakes) and milliseconds since boot.
+
+use ostd::timer::Jiffies;
+
+/// Milliseconds since boot (`jiffies_to_msecs(jiffies)`).
+pub fn now_ms() -> u64 {
+    Jiffies::elapsed().as_duration().as_millis() as u64
+}
+
+/// `udelay`: a busy wait of at least `us` microseconds. Without a known
+/// TSC frequency it falls back on the millisecond clock.
+pub fn udelay(us: u64) {
+    let frequency = ostd::arch::tsc_freq();
+    if frequency == 0 {
+        let deadline = now_ms() + us.div_ceil(1000) + 1;
+        while now_ms() < deadline {
+            core::hint::spin_loop();
+        }
+        return;
+    }
+    let cycles = us * (frequency / 1_000_000).max(1);
+    let start = ostd::arch::read_tsc();
+    while ostd::arch::read_tsc().wrapping_sub(start) < cycles {
+        core::hint::spin_loop();
+    }
+}
+
+/// `mdelay`.
+pub fn mdelay(ms: u64) {
+    udelay(ms * 1000);
+}
+
+/// `read_poll_timeout`: calls `read` every `delay_us` until `done` holds
+/// for its value or `timeout_us` passed. `Ok` with the last value when it
+/// held, `Err` with the last value when the time ran out.
+pub fn read_poll_timeout<T>(mut read: impl FnMut() -> T, done: impl Fn(&T) -> bool, delay_us: u64, timeout_us: u64) -> Result<T, T> {
+    let mut waited = 0u64;
+    loop {
+        let value = read();
+        if done(&value) {
+            return Ok(value);
+        }
+        if waited >= timeout_us {
+            return Err(value);
+        }
+        udelay(delay_us.max(1));
+        waited += delay_us.max(1);
+    }
+}
diff --git a/kernel/comps/linuxkpi/src/dma.rs b/kernel/comps/linuxkpi/src/dma.rs
new file mode 100644
index 0000000..3dc749c
--- /dev/null
+++ b/kernel/comps/linuxkpi/src/dma.rs
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! `dma_alloc_coherent`, and the same under `dma_set_mask(DMA_BIT_MASK(32))`
+//! for devices whose descriptors hold 32-bit addresses.
+
+use alloc::vec::Vec;
+
+use ostd::mm::{HasDaddr, PAGE_SIZE, dma::DmaCoherent};
+
+/// How many times memory above 4 GiB is set aside before giving up.
+const TRIES_BELOW_4G: usize = 64;
+
+fn pages(bytes: usize) -> usize {
+    bytes.div_ceil(PAGE_SIZE).max(1)
+}
+
+/// `dma_alloc_coherent`: zeroed, contiguous, cache-coherent memory.
+pub fn alloc_coherent(bytes: usize) -> Option<DmaCoherent> {
+    DmaCoherent::alloc(pages(bytes), true).ok()
+}
+
+/// `dma_alloc_coherent` under a 32-bit DMA mask: memory that lies below
+/// 4 GiB, asked for again (the blocks above held meanwhile) until it does.
+pub fn alloc_coherent32(bytes: usize) -> Option<DmaCoherent> {
+    let pages = pages(bytes);
+    let mut held = Vec::new();
+    for _ in 0..TRIES_BELOW_4G {
+        let block = DmaCoherent::alloc(pages, true).ok()?;
+        if (block.daddr() as u64) + (pages * PAGE_SIZE) as u64 <= 1 << 32 {
+            return Some(block);
+        }
+        held.push(block);
+    }
+    None
+}
