diff --git a/kernel/comps/i8042/src/i2c_touchpads.rs b/kernel/comps/i8042/src/i2c_touchpads.rs
new file mode 100755
index 0000000..db92b3f
--- /dev/null
+++ b/kernel/comps/i8042/src/i2c_touchpads.rs
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The HID-over-I2C touchpads the firmware declares, named in the log.
+//!
+//! Most laptops since about 2016 put the touchpad on an I2C bus (ACPI's
+//! `PNP0C50`, HID over I2C, the Windows Precision Touchpad) and keep a PS/2
+//! fallback that moves the pointer and clicks, often without the Synaptics or
+//! ELAN protocol this driver turns into gestures. The kernel has no I2C-HID
+//! driver yet, so on those the pad stays a PS/2 mouse and two fingers do not
+//! scroll; this says so in the kernel log, with the pad's IDs.
+//!
+//! No AML interpreter runs: the DSDT and SSDTs are searched for the
+//! compatible ID as AML encodes it (a string, or `EisaId ("PNP0C50")`), and
+//! the device IDs written near it are the candidates (a DSDT often declares
+//! several pads, one per vendor, and enables the one fitted with `_STA`).
+
+use alloc::{string::String, vec::Vec};
+
+/// HID over I2C, as strings.
+const HID_OVER_I2C: [&[u8]; 2] = [b"PNP0C50", b"ACPI0C50"];
+/// `EisaId ("PNP0C50")`: a DWord constant, the compressed letters first.
+const HID_OVER_I2C_EISA: [u8; 5] = [0x0c, 0x41, 0xd0, 0x0c, 0x50];
+/// AML's string prefix.
+const STRING_PREFIX: u8 = 0x0d;
+/// How far around the compatible ID the device's own IDs are looked for, in
+/// bytes of AML: a device's `_HID`, `_CID` and `_SUB` are close together.
+const BEFORE: usize = 160;
+const AFTER: usize = 96;
+/// At most this many names in the log line.
+const MAX_NAMES: usize = 16;
+
+/// Names the firmware's HID-over-I2C devices in the kernel log, if any.
+pub(crate) fn log() {
+    let mut found = Found::default();
+    ostd::arch::kernel::for_each_aml_table(|aml| found.scan(aml));
+    if found.declared == 0 {
+        return;
+    }
+    let mut names = String::new();
+    for name in &found.names {
+        if !names.is_empty() {
+            names.push_str(", ");
+        }
+        names.extend(name.iter().map(|&byte| byte as char));
+    }
+    if names.is_empty() {
+        names.push_str("no ID near it");
+    }
+    ostd::notice!(
+        "the firmware declares {} HID-over-I2C device(s) ({}): a touchpad among them has no \
+         I2C driver yet and works as the PS/2 mouse, without two-finger scrolling unless that \
+         speaks Synaptics or ELAN",
+        found.declared,
+        names
+    );
+}
+
+#[derive(Default)]
+struct Found {
+    /// Times the compatible ID appears.
+    declared: usize,
+    /// The device IDs near it, each once.
+    names: Vec<Vec<u8>>,
+}
+
+impl Found {
+    fn scan(&mut self, aml: &[u8]) {
+        for at in 0..aml.len() {
+            let compatible = aml[at..].starts_with(&HID_OVER_I2C_EISA)
+                || string_at(aml, at).is_some_and(|text| HID_OVER_I2C.contains(&text));
+            if !compatible {
+                continue;
+            }
+            self.declared += 1;
+            let around = at.saturating_sub(BEFORE)..(at + AFTER).min(aml.len());
+            for near in around {
+                let Some(text) = string_at(aml, near) else {
+                    continue;
+                };
+                if is_device_id(text)
+                    && !HID_OVER_I2C.contains(&text)
+                    && self.names.len() < MAX_NAMES
+                    && !self.names.iter().any(|name| name.as_slice() == text)
+                {
+                    self.names.push(text.to_vec());
+                }
+            }
+        }
+    }
+}
+
+/// The string AML has at `at` (its prefix, then the text up to a NUL), if
+/// it is a short printable one.
+fn string_at(aml: &[u8], at: usize) -> Option<&[u8]> {
+    if aml.get(at) != Some(&STRING_PREFIX) {
+        return None;
+    }
+    let rest = &aml[at + 1..];
+    let end = rest.iter().take(10).position(|&byte| byte == 0)?;
+    let text = &rest[..end];
+    (!text.is_empty() && text.iter().all(|byte| byte.is_ascii_graphic())).then_some(text)
+}
+
+/// A PNP ID (three letters, four hex digits: `PNP0C50`) or an ACPI ID (four
+/// letters or digits, four hex digits: `ELAN0718`, `SYNA3602`, `MSFT0001`).
+fn is_device_id(text: &[u8]) -> bool {
+    let (vendor, product) = match text.len() {
+        7 => text.split_at(3),
+        8 => text.split_at(4),
+        _ => return false,
+    };
+    vendor[0].is_ascii_uppercase()
+        && vendor
+            .iter()
+            .all(|byte| byte.is_ascii_uppercase() || byte.is_ascii_digit())
+        && product
+            .iter()
+            .all(|byte| byte.is_ascii_digit() || (b'A'..=b'F').contains(byte))
+}
+
+#[cfg(ktest)]
+mod test {
+    use alloc::vec::Vec;
+
+    use ostd::prelude::*;
+
+    use super::{Found, is_device_id};
+
+    fn string(text: &str) -> Vec<u8> {
+        let mut aml = Vec::from([0x0d]);
+        aml.extend_from_slice(text.as_bytes());
+        aml.push(0);
+        aml
+    }
+
+    #[ktest]
+    fn finds_the_pads_next_to_the_compatible_id() {
+        // Device (TPD0) { Name (_HID, "ELAN0718") Name (_CID, "PNP0C50") }
+        // and an EisaId one with a method's IDs (SYNA2393, then MSFT0001).
+        let mut aml = Vec::from(*b"[\x82TPD0");
+        aml.extend(string("ELAN0718"));
+        aml.extend(*b"\x08_CID");
+        aml.extend(string("PNP0C50"));
+        aml.extend([0u8; 300]);
+        aml.extend(string("SYNA2393"));
+        aml.extend(string("MSFT0001"));
+        aml.extend(*b"\x08_CID\x0c\x41\xd0\x0c\x50");
+        aml.extend([0u8; 300]);
+        aml.extend(string("INT33C3"));
+        let mut found = Found::default();
+        found.scan(&aml);
+        assert_eq!(found.declared, 2);
+        let names: Vec<&[u8]> = found.names.iter().map(Vec::as_slice).collect();
+        assert_eq!(names, [&b"ELAN0718"[..], b"SYNA2393", b"MSFT0001"]);
+    }
+
+    #[ktest]
+    fn device_ids() {
+        assert!(is_device_id(b"PNP0C50"));
+        assert!(is_device_id(b"ELAN0718"));
+        assert!(!is_device_id(b"10EC5682"));
+        assert!(!is_device_id(b"_SB_PCI0"));
+        assert!(!is_device_id(b"Elan0718"));
+    }
+}
