new file mode 100755
index 0000000..88b76bc
--- /dev/null
+++ b/kernel/core/src/net/socket/ip/multicast.rs
@@ -0,0 +1,282 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! IPv4 multicast for datagram sockets: the groups a socket is in
+//! (`IP_ADD_MEMBERSHIP`, `MCAST_JOIN_GROUP`), how its datagrams to a group
+//! leave (`IP_MULTICAST_IF`, `IP_MULTICAST_TTL`, `IP_MULTICAST_LOOP`), and
+//! where a datagram arrived (`IP_PKTINFO`, as a control message).
+
+use aster_bigtcp::{
+    iface::{InterfaceType, multicast},
+    wire::{IpAddress, Ipv4Address},
+};
+
+use crate::{
+    net::{
+        iface::Iface,
+        route,
+        socket::util::{CControlHeader, RecvFlags},
+    },
+    prelude::*,
+    util::net::CSocketOptionLevel,
+};
+
+/// A group to join or leave on an interface, as `ip_mreqn`, `ip_mreq` and
+/// `group_req` give it: by the interface's index, or by its address, or
+/// neither (the interface the route to the group goes through).
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct GroupRequest {
+    pub(crate) group: Ipv4Address,
+    pub(crate) address: Ipv4Address,
+    pub(crate) index: u32,
+}
+
+/// A group request in `group_req`'s layout (`MCAST_JOIN_GROUP`).
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct McastGroupRequest(pub(crate) GroupRequest);
+
+/// The interface `IP_MULTICAST_IF` names, by address or index (0: none).
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct MulticastInterface {
+    pub(crate) address: Ipv4Address,
+    pub(crate) index: u32,
+}
+
+/// The most groups one socket joins (`IP_MAX_MEMBERSHIPS` in Linux).
+const MAX_MEMBERSHIPS: usize = 20;
+
+/// Linux's default for `IP_MULTICAST_TTL`: datagrams to a group stay on the
+/// local network.
+const DEFAULT_MULTICAST_TTL: u8 = 1;
+
+/// A datagram socket's multicast settings.
+#[derive(Debug)]
+pub(crate) struct MulticastState {
+    /// The groups joined, each with its interface's index.
+    groups: Vec<(Ipv4Address, u32)>,
+    /// `IP_MULTICAST_IF`: the interface datagrams to a group leave by.
+    interface: Option<u32>,
+    ttl: u8,
+    looped: bool,
+    /// `IP_PKTINFO`: received datagrams say where they arrived.
+    packet_info: bool,
+    /// `IP_RECVTTL`, accepted; the hop limit of a received datagram is not
+    /// kept, so no `IP_TTL` message follows it.
+    receive_ttl: bool,
+    /// `IP_MULTICAST_ALL`, accepted: datagrams to every group the computer
+    /// is in reach the socket (the only behaviour there is).
+    all: bool,
+}
+
+impl MulticastState {
+    pub(crate) const fn new() -> Self {
+        Self {
+            groups: Vec::new(),
+            interface: None,
+            ttl: DEFAULT_MULTICAST_TTL,
+            looped: true,
+            packet_info: false,
+            receive_ttl: false,
+            all: true,
+        }
+    }
+
+    pub(crate) fn join(&mut self, request: &GroupRequest) -> Result<()> {
+        check_group(request.group)?;
+        let iface = request_iface(request)?;
+        if self.groups.contains(&(request.group, iface.index())) {
+            return_errno_with_message!(Errno::EADDRINUSE, "the group is already joined");
+        }
+        if self.groups.len() >= MAX_MEMBERSHIPS {
+            return_errno_with_message!(Errno::ENOBUFS, "the socket is in too many groups");
+        }
+        multicast::join(iface.index(), request.group);
+        self.groups.push((request.group, iface.index()));
+        Ok(())
+    }
+
+    pub(crate) fn leave(&mut self, request: &GroupRequest) -> Result<()> {
+        check_group(request.group)?;
+        // Leaving names the interface as joining did; with none named, the
+        // group on any interface.
+        let named = request.index != 0 || !request.address.is_unspecified();
+        let index = if named { Some(request_iface(request)?.index()) } else { None };
+        let Some(position) = self.groups.iter().position(|(group, iface)| {
+            *group == request.group && index.is_none_or(|index| index == *iface)
+        }) else {
+            return_errno_with_message!(Errno::EADDRNOTAVAIL, "the group is not joined");
+        };
+        let (group, iface) = self.groups.remove(position);
+        multicast::leave(iface, group);
+        Ok(())
+    }
+
+    /// Leaves every group (the socket closes).
+    pub(crate) fn leave_all(&mut self) {
+        for (group, iface) in self.groups.drain(..) {
+            multicast::leave(iface, group);
+        }
+    }
+
+    pub(crate) fn set_interface(&mut self, interface: &MulticastInterface) -> Result<()> {
+        self.interface = if interface.index == 0 && interface.address.is_unspecified() {
+            None
+        } else {
+            Some(
+                request_iface(&GroupRequest {
+                    group: Ipv4Address::UNSPECIFIED,
+                    address: interface.address,
+                    index: interface.index,
+                })?
+                .index(),
+            )
+        };
+        Ok(())
+    }
+
+    /// The address of the `IP_MULTICAST_IF` interface (0.0.0.0: none).
+    pub(crate) fn interface_address(&self) -> Ipv4Address {
+        self.interface
+            .and_then(|index| {
+                crate::net::iface::iter_all_ifaces().find(|iface| iface.index() == index)
+            })
+            .and_then(|iface| iface.ipv4_cidr())
+            .map(|cidr| cidr.address())
+            .unwrap_or(Ipv4Address::UNSPECIFIED)
+    }
+
+    /// The interface a datagram to `remote` leaves by, if one is set.
+    pub(crate) fn interface_for(&self, remote: &IpAddress) -> Option<u32> {
+        if remote.is_multicast() { self.interface } else { None }
+    }
+
+    /// The hop limit of a datagram to `remote`, given the socket's
+    /// `IP_TTL` for the others.
+    pub(crate) fn hop_limit_for(&self, remote: &IpAddress, unicast_ttl: u8) -> u8 {
+        if remote.is_multicast() { self.ttl } else { unicast_ttl }
+    }
+
+    pub(crate) fn ttl(&self) -> u8 {
+        self.ttl
+    }
+
+    pub(crate) fn set_ttl(&mut self, ttl: u8) {
+        self.ttl = ttl;
+    }
+
+    pub(crate) fn looped(&self) -> bool {
+        self.looped
+    }
+
+    /// `IP_MULTICAST_LOOP`. A datagram to a group the computer is in also
+    /// reaches the local sockets whatever this says.
+    pub(crate) fn set_looped(&mut self, looped: bool) {
+        self.looped = looped;
+    }
+
+    pub(crate) fn packet_info(&self) -> bool {
+        self.packet_info
+    }
+
+    pub(crate) fn set_packet_info(&mut self, on: bool) {
+        self.packet_info = on;
+    }
+
+    pub(crate) fn receive_ttl(&self) -> bool {
+        self.receive_ttl
+    }
+
+    pub(crate) fn set_receive_ttl(&mut self, on: bool) {
+        self.receive_ttl = on;
+    }
+
+    pub(crate) fn all(&self) -> bool {
+        self.all
+    }
+
+    pub(crate) fn set_all(&mut self, all: bool) {
+        self.all = all;
+    }
+}
+
+fn check_group(group: Ipv4Address) -> Result<()> {
+    if !group.is_multicast() {
+        return_errno_with_message!(Errno::EINVAL, "the address is not a multicast group");
+    }
+    Ok(())
+}
+
+/// The interface a request names: by index, by address, or (neither) the
+/// one the route to the group goes through, else the first that is not the
+/// loopback one.
+fn request_iface(request: &GroupRequest) -> Result<Arc<Iface>> {
+    let mut ifaces = crate::net::iface::iter_all_ifaces();
+    let found = if request.index != 0 {
+        ifaces.find(|iface| iface.index() == request.index)
+    } else if !request.address.is_unspecified() {
+        ifaces.find(|iface| {
+            iface
+                .ipv4_cidr()
+                .is_some_and(|cidr| cidr.address() == request.address)
+        })
+    } else {
+        route::lookup_iface(IpAddress::Ipv4(request.group))
+            .ok()
+            .or_else(|| ifaces.find(|iface| iface.type_() != InterfaceType::LOOPBACK))
+    };
+    found.ok_or_else(|| Error::with_message(Errno::ENODEV, "there is no such interface"))
+}
+
+/// Control messages of level `SOL_IP`.
+#[derive(Debug)]
+pub(crate) enum IpControlMessage {
+    /// `IP_PKTINFO`: where a datagram arrived, or (sent) the interface and
+    /// source address it leaves with.
+    PacketInfo(CPacketInfo),
+}
+
+/// `struct in_pktinfo`.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Pod)]
+pub(crate) struct CPacketInfo {
+    pub(crate) ifindex: i32,
+    /// The local address (a reply's source).
+    pub(crate) spec_dst: [u8; 4],
+    /// The address the datagram was sent to.
+    pub(crate) addr: [u8; 4],
+}
+
+/// `IP_PKTINFO` as a control message type.
+const IP_PKTINFO: i32 = 8;
+
+impl IpControlMessage {
+    pub(crate) fn read_from(header: &CControlHeader, reader: &mut VmReader) -> Result<Option<Self>> {
+        if header.type_() != IP_PKTINFO {
+            warn!("unsupported IP control message type in {:?}", header);
+            reader.skip(header.payload_len());
+            return Ok(None);
+        }
+        if header.payload_len() < size_of::<CPacketInfo>() {
+            return_errno_with_message!(Errno::EINVAL, "the IP_PKTINFO message is too short");
+        }
+        let info = reader.read_val::<CPacketInfo>()?;
+        reader.skip(header.payload_len() - size_of::<CPacketInfo>());
+        Ok(Some(Self::PacketInfo(info)))
+    }
+
+    pub(crate) fn write_to(&self, writer: &mut VmWriter) -> Result<(CControlHeader, RecvFlags)> {
+        let Self::PacketInfo(info) = self;
+        if CControlHeader::payload_len_from_total(writer.avail())? < size_of::<CPacketInfo>() {
+            return_errno_with_message!(Errno::EINVAL, "the control message buffer is too small");
+        }
+        let header = CControlHeader::new(CSocketOptionLevel::SOL_IP, IP_PKTINFO, size_of::<CPacketInfo>());
+        writer.write_val(&header)?;
+        writer.write_val(info)?;
+        Ok((header, RecvFlags::empty()))
+    }
+
+    /// The interface a sent `IP_PKTINFO` names (0: none).
+    pub(crate) fn interface(&self) -> Option<u32> {
+        let Self::PacketInfo(info) = self;
+        (info.ifindex > 0).then_some(info.ifindex as u32)
+    }
+}
