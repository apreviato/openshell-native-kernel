--- /dev/null
+++ b/kernel/core/src/net/socket/netlink/route/kernel/events.rs
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Notifications to the route sockets that joined a group, as Linux sends
+//! them: an address that comes or goes (`RTM_NEWADDR`, `RTM_DELADDR` to
+//! `RTNLGRP_IPV4_IFADDR`) and an interface that appears or changes state
+//! (`RTM_NEWLINK` to `RTNLGRP_LINK`). Avahi, Chromium's network-change
+//! notifier and other programs keep their interface lists this way: without
+//! them they never saw an address that arrived after they started (a Wi-Fi
+//! network joined, a late DHCP lease).
+
+use aster_bigtcp::wire::{IpCidr, Ipv4Cidr};
+
+use super::{addr::iface_to_new_addr, link::iface_to_new_link};
+use crate::{
+    net::{
+        iface::iter_all_ifaces,
+        socket::netlink::{
+            GroupIdSet,
+            message::{CMsgSegHdr, CSegmentType, SegHdrCommonFlags},
+            route::message::{RtnlMessage, RtnlSegment},
+            table::{NetlinkRouteProtocol, SupportedNetlinkProtocol},
+        },
+    },
+    prelude::*,
+};
+
+/// `RTNLGRP_LINK`.
+const GROUP_LINK: u32 = 1;
+/// `RTNLGRP_IPV4_IFADDR`.
+const GROUP_IPV4_ADDRESS: u32 = 5;
+
+/// The header of a message the kernel sends on its own.
+fn event_header(type_: CSegmentType) -> CMsgSegHdr {
+    CMsgSegHdr {
+        len: 0,
+        type_: type_ as _,
+        flags: SegHdrCommonFlags::empty().bits(),
+        seq: 0,
+        pid: 0,
+    }
+}
+
+fn send(group: u32, segment: RtnlSegment) {
+    let _ = NetlinkRouteProtocol::multicast(
+        GroupIdSet::new(1 << (group - 1)),
+        RtnlMessage::new(vec![segment]),
+    );
+}
+
+/// The IPv4 address of the interface with the index `index` changed from
+/// `old` to `new`.
+pub(in crate::net) fn address_changed(index: u32, old: Option<Ipv4Cidr>, new: Option<Ipv4Cidr>) {
+    let Some(iface) = iter_all_ifaces().find(|iface| iface.index() == index) else {
+        return;
+    };
+    if let Some(old) = old
+        && Some(old) != new
+    {
+        let mut segment = iface_to_new_addr(&event_header(CSegmentType::NEWADDR), &iface, IpCidr::Ipv4(old));
+        segment.header_mut().type_ = CSegmentType::DELADDR as _;
+        send(GROUP_IPV4_ADDRESS, RtnlSegment::NewAddr(segment));
+    }
+    if let Some(new) = new
+        && Some(new) != old
+    {
+        let segment = iface_to_new_addr(&event_header(CSegmentType::NEWADDR), &iface, IpCidr::Ipv4(new));
+        send(GROUP_IPV4_ADDRESS, RtnlSegment::NewAddr(segment));
+    }
+    link_changed(index);
+}
+
+/// The interface with the index `index` appeared or its state (up, link)
+/// changed.
+pub(in crate::net) fn link_changed(index: u32) {
+    let Some(iface) = iter_all_ifaces().find(|iface| iface.index() == index) else {
+        return;
+    };
+    let segment = iface_to_new_link(&event_header(CSegmentType::NEWLINK), &iface);
+    send(GROUP_LINK, RtnlSegment::NewLink(segment));
+}
