+    old: Option<aster_bigtcp::wire::Ipv4Cidr>,
+    new: Option<aster_bigtcp::wire::Ipv4Cidr>,
+) {
+    crate::thread::work_queue::submit_work_func(
+        move || crate::net::socket::netlink::address_changed(index, old, new),
+        crate::thread::work_queue::WorkPriority::Normal,
+    );
