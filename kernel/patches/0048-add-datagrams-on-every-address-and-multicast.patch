+// SPDX-License-Identifier: MPL-2.0
+
+//! The IPv4 multicast groups this computer takes part in, by interface.
+//!
+//! Sockets join and leave groups (`IP_ADD_MEMBERSHIP`); an interface takes
+//! the datagrams sent to a group while some socket is in it on that
+//! interface, and every socket bound to the group's port (on every address
+//! or on the group's) receives them, as on Linux with `IP_MULTICAST_ALL`.
+//!
+//! Membership is not announced with IGMP: the link-local groups (mDNS,
+//! SSDP's 239.255.255.250 on most home networks) reach every station
+//! anyway, and switches without IGMP snooping flood the others.
+
+use alloc::collections::BTreeMap;
+
+use ostd::sync::{LocalIrqDisabled, SpinLock};
+use smoltcp::wire::{EthernetAddress, Ipv4Address};
+
+static GROUPS: SpinLock<BTreeMap<(u32, Ipv4Address), usize>, LocalIrqDisabled> =
+    SpinLock::new(BTreeMap::new());
+
+/// The all-hosts group (224.0.0.1), which every interface is in.
+const ALL_HOSTS: Ipv4Address = Ipv4Address::new(224, 0, 0, 1);
+
+/// Takes part in `group` on the interface with the index `iface`; each
+/// join is undone by one [`leave`].
+pub fn join(iface: u32, group: Ipv4Address) {
+    *GROUPS.lock().entry((iface, group)).or_insert(0) += 1;
+}
+
+/// Undoes one [`join`].
+pub fn leave(iface: u32, group: Ipv4Address) {
+    let mut groups = GROUPS.lock();
+    if let Some(count) = groups.get_mut(&(iface, group)) {
+        *count -= 1;
+        if *count == 0 {
+            groups.remove(&(iface, group));
+        }
+    }
+}
+
+/// Whether the interface with the index `iface` takes datagrams sent to
+/// `group`.
+pub fn is_member(iface: u32, group: Ipv4Address) -> bool {
+    group == ALL_HOSTS || GROUPS.lock().contains_key(&(iface, group))
+}
+
+/// The Ethernet address frames to `group` go to (RFC 1112, section 6.4):
+/// 01:00:5e followed by the group's low 23 bits.
+pub(crate) fn ethernet_address(group: Ipv4Address) -> EthernetAddress {
+    let octets = group.octets();
+    EthernetAddress([0x01, 0x00, 0x5e, octets[1] & 0x7f, octets[2], octets[3]])
+}
