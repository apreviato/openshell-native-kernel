@@ -0,0 +1,177 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! USB mass storage's Bulk-Only Transport and the SCSI commands a disk, a
+//! pendrive or a card reader answers: their wrappers and replies, without
+//! hardware access (its tests run on the host).
+//!
+//! References: USB Mass Storage Class Bulk-Only Transport 1.0; SCSI Primary
+//! Commands (SPC-4) and Block Commands (SBC-3); Linux's `drivers/usb/storage`.
+
+use alloc::{string::String, vec::Vec};
+
+pub(crate) const CBW_LENGTH: usize = 31;
+pub(crate) const CSW_LENGTH: usize = 13;
+const CBW_SIGNATURE: u32 = 0x4342_5355;
+const CSW_SIGNATURE: u32 = 0x5342_5355;
+
+pub(crate) mod op {
+    pub(crate) const TEST_UNIT_READY: u8 = 0x00;
+    pub(crate) const REQUEST_SENSE: u8 = 0x03;
+    pub(crate) const INQUIRY: u8 = 0x12;
+    pub(crate) const START_STOP_UNIT: u8 = 0x1b;
+    pub(crate) const READ_CAPACITY_10: u8 = 0x25;
+    pub(crate) const READ_10: u8 = 0x28;
+    pub(crate) const WRITE_10: u8 = 0x2a;
+    pub(crate) const SYNCHRONIZE_CACHE_10: u8 = 0x35;
+    pub(crate) const READ_16: u8 = 0x88;
+    pub(crate) const WRITE_16: u8 = 0x8a;
+    pub(crate) const SERVICE_ACTION_IN_16: u8 = 0x9e;
+    pub(crate) const READ_CAPACITY_16: u8 = 0x10;
+}
+
+/// A Command Block Wrapper.
+pub(crate) fn cbw(tag: u32, length: u32, inward: bool, lun: u8, cdb: &[u8]) -> [u8; CBW_LENGTH] {
+    let mut wrapper = [0u8; CBW_LENGTH];
+    wrapper[0..4].copy_from_slice(&CBW_SIGNATURE.to_le_bytes());
+    wrapper[4..8].copy_from_slice(&tag.to_le_bytes());
+    wrapper[8..12].copy_from_slice(&length.to_le_bytes());
+    wrapper[12] = if inward { 0x80 } else { 0 };
+    wrapper[13] = lun & 0x0f;
+    let length = cdb.len().min(16);
+    wrapper[14] = length as u8;
+    wrapper[15..15 + length].copy_from_slice(&cdb[..length]);
+    wrapper
+}
+
+/// A Command Status Wrapper: its residue and status (0 passed, 1 failed,
+/// 2 phase error), if it is one and answers `tag`.
+pub(crate) fn csw(status: &[u8], tag: u32) -> Option<(u32, u8)> {
+    if status.len() < CSW_LENGTH
+        || u32::from_le_bytes(status[0..4].try_into().ok()?) != CSW_SIGNATURE
+        || u32::from_le_bytes(status[4..8].try_into().ok()?) != tag
+    {
+        return None;
+    }
+    Some((u32::from_le_bytes(status[8..12].try_into().ok()?), status[12]))
+}
+
+pub(crate) fn inquiry() -> [u8; 6] {
+    [op::INQUIRY, 0, 0, 0, 36, 0]
+}
+
+/// What INQUIRY says: a disk (direct access, or the simplified one of some
+/// card readers), whether removable, and its names.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct Inquiry {
+    pub disk: bool,
+    pub removable: bool,
+    pub vendor: String,
+    pub product: String,
+}
+
+pub(crate) fn parse_inquiry(data: &[u8]) -> Option<Inquiry> {
+    if data.len() < 32 {
+        return None;
+    }
+    let text = |bytes: &[u8]| String::from_utf8_lossy(bytes).trim().into();
+    Some(Inquiry {
+        disk: matches!(data[0] & 0x1f, 0x00 | 0x0e) && data[0] >> 5 == 0,
+        removable: data[1] & 0x80 != 0,
+        vendor: text(&data[8..16]),
+        product: text(&data[16..32]),
+    })
+}
+
+pub(crate) fn test_unit_ready() -> [u8; 6] {
+    [op::TEST_UNIT_READY, 0, 0, 0, 0, 0]
+}
+
+pub(crate) fn request_sense() -> [u8; 6] {
+    [op::REQUEST_SENSE, 0, 0, 0, 18, 0]
+}
+
+/// A fixed-format sense: key, additional sense code and qualifier.
+pub(crate) fn parse_sense(data: &[u8]) -> Option<(u8, u8, u8)> {
+    if data.len() < 14 || data[0] & 0x7e != 0x70 {
+        return None;
+    }
+    Some((data[2] & 0x0f, data[12], data[13]))
+}
+
+/// No medium in the drive (a card reader without a card).
+pub(crate) fn no_medium(sense: (u8, u8, u8)) -> bool {
+    sense.0 == 0x02 && sense.1 == 0x3a
+}
+
+/// START STOP UNIT: spin a disk up (or down), for the ones that wait to be told.
+pub(crate) fn start_stop_unit(start: bool) -> [u8; 6] {
+    [op::START_STOP_UNIT, 0, 0, 0, u8::from(start), 0]
+}
+
+pub(crate) fn read_capacity_10() -> [u8; 10] {
+    [op::READ_CAPACITY_10, 0, 0, 0, 0, 0, 0, 0, 0, 0]
+}
+
+pub(crate) fn read_capacity_16() -> [u8; 16] {
+    let mut cdb = [0u8; 16];
+    cdb[0] = op::SERVICE_ACTION_IN_16;
+    cdb[1] = op::READ_CAPACITY_16;
+    cdb[13] = 32;
+    cdb
+}
+
+/// READ CAPACITY: the number of blocks and their size. A 10-byte reply of
+/// 0xffffffff blocks means: ask READ CAPACITY(16).
+pub(crate) fn parse_capacity(data: &[u8]) -> Option<(u64, u32)> {
+    match data.len() {
+        8..=31 => {
+            let last = u32::from_be_bytes(data[0..4].try_into().ok()?);
+            let size = u32::from_be_bytes(data[4..8].try_into().ok()?);
+            Some((u64::from(last) + 1, size))
+        }
+        32.. => {
+            let last = u64::from_be_bytes(data[0..8].try_into().ok()?);
+            let size = u32::from_be_bytes(data[8..12].try_into().ok()?);
+            Some((last + 1, size))
+        }
+        _ => None,
+    }
+}
+
+/// READ or WRITE of `blocks` blocks at `lba`: the 10-byte commands while they
+/// reach, the 16-byte ones beyond 2 TiB.
+pub(crate) fn read_write(write: bool, lba: u64, blocks: u32) -> Vec<u8> {
+    if lba + u64::from(blocks) <= u64::from(u32::MAX) && blocks <= u32::from(u16::MAX) {
+        let mut cdb = alloc::vec![if write { op::WRITE_10 } else { op::READ_10 }, 0];
+        cdb.extend_from_slice(&(lba as u32).to_be_bytes());
+        cdb.push(0);
+        cdb.extend_from_slice(&(blocks as u16).to_be_bytes());
+        cdb.push(0);
+        cdb
+    } else {
+        let mut cdb = alloc::vec![if write { op::WRITE_16 } else { op::READ_16 }, 0];
+        cdb.extend_from_slice(&lba.to_be_bytes());
+        cdb.extend_from_slice(&blocks.to_be_bytes());
+        cdb.extend_from_slice(&[0, 0]);
+        cdb
+    }
+}
+
+pub(crate) fn synchronize_cache() -> [u8; 10] {
+    [op::SYNCHRONIZE_CACHE_10, 0, 0, 0, 0, 0, 0, 0, 0, 0]
+}
+
+/// The pieces of a DMA buffer, split where it would cross a 64 KiB boundary
+/// (xHCI 1.2, 4.11.7.1).
+pub(crate) fn split_64k(address: u64, length: usize) -> Vec<(u64, usize)> {
+    let mut pieces = Vec::new();
+    let (mut address, mut left) = (address, length);
+    while left > 0 {
+        let to_boundary = (0x1_0000 - (address & 0xffff)) as usize;
+        let piece = left.min(to_boundary);
+        pieces.push((address, piece));
+        address += piece as u64;
+        left -= piece;
+    }
+    pieces
+}
