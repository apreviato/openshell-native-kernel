diff --git a/kernel/comps/usb/src/netframe.rs b/kernel/comps/usb/src/netframe.rs
new file mode 100755
index 0000000..13b02ca
--- /dev/null
+++ b/kernel/comps/usb/src/netframe.rs
@@ -0,0 +1,223 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! How USB network devices carry Ethernet frames, whoever makes them:
+//!
+//! - CDC-ECM (USB-Ethernet adapters, iPhones and Macs sharing their network):
+//!   one frame per transfer, as it is.
+//! - CDC-NCM (recent Android phones, fast adapters): transfer blocks (NTB16)
+//!   of datagrams with their pointer tables.
+//! - RNDIS (Android tethering, Windows-era devices): each frame after a
+//!   44-byte message header; control messages on the default endpoint.
+//!
+//! No hardware access: its tests run on the host.
+//!
+//! References: USB CDC ECM 1.2, CDC NCM 1.0, Microsoft RNDIS 1.0 (and
+//! Linux's `cdc_ether.c`, `cdc_ncm.c`, `rndis_host.c`).
+
+use alloc::vec::Vec;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Framing {
+    Ecm,
+    Ncm,
+    Rndis,
+}
+
+const NTH16_SIGNATURE: &[u8; 4] = b"NCMH";
+const NDP16_SIGNATURE: &[u8; 4] = b"NCM0";
+const NDP16_CRC_SIGNATURE: &[u8; 4] = b"NCM1";
+/// Where a sent datagram starts in its block.
+const NCM_DATAGRAM_OFFSET: usize = 32;
+
+const RNDIS_PACKET_MSG: u32 = 1;
+const RNDIS_INITIALIZE_MSG: u32 = 2;
+const RNDIS_QUERY_MSG: u32 = 4;
+const RNDIS_SET_MSG: u32 = 5;
+pub(crate) const RNDIS_PACKET_HEADER: usize = 44;
+/// What the device may put in one transfer to us: a receive buffer.
+pub(crate) const RNDIS_MAX_TRANSFER: u32 = 0x1000;
+pub(crate) const OID_802_3_PERMANENT_ADDRESS: u32 = 0x0101_0101;
+pub(crate) const OID_GEN_CURRENT_PACKET_FILTER: u32 = 0x0001_010e;
+/// Directed, multicast, all multicast and broadcast frames.
+pub(crate) const RNDIS_PACKET_FILTER: u32 = 0x0000_000f;
+
+fn u16_at(b: &[u8], at: usize) -> Option<u16> {
+    Some(u16::from_le_bytes(b.get(at..at + 2)?.try_into().ok()?))
+}
+
+fn u32_at(b: &[u8], at: usize) -> Option<u32> {
+    Some(u32::from_le_bytes(b.get(at..at + 4)?.try_into().ok()?))
+}
+
+fn push32(out: &mut Vec<u8>, value: u32) {
+    out.extend_from_slice(&value.to_le_bytes());
+}
+
+fn push16(out: &mut Vec<u8>, value: u16) {
+    out.extend_from_slice(&value.to_le_bytes());
+}
+
+/// A frame as a transfer to the device; `sequence` numbers NCM's blocks.
+pub(crate) fn wrap(framing: Framing, frame: &[u8], sequence: u16) -> Vec<u8> {
+    match framing {
+        Framing::Ecm => frame.to_vec(),
+        Framing::Rndis => {
+            let mut out = Vec::with_capacity(RNDIS_PACKET_HEADER + frame.len());
+            push32(&mut out, RNDIS_PACKET_MSG);
+            push32(&mut out, (RNDIS_PACKET_HEADER + frame.len()) as u32);
+            // The data's offset counts from the offset field itself.
+            push32(&mut out, (RNDIS_PACKET_HEADER - 8) as u32);
+            push32(&mut out, frame.len() as u32);
+            out.resize(RNDIS_PACKET_HEADER, 0);
+            out.extend_from_slice(frame);
+            out
+        }
+        Framing::Ncm => {
+            let total = NCM_DATAGRAM_OFFSET + frame.len();
+            let mut out = Vec::with_capacity(total);
+            out.extend_from_slice(NTH16_SIGNATURE);
+            push16(&mut out, 12);
+            push16(&mut out, sequence);
+            push16(&mut out, total as u16);
+            push16(&mut out, 12);
+            // One datagram, then the table's end.
+            out.extend_from_slice(NDP16_SIGNATURE);
+            push16(&mut out, 16);
+            push16(&mut out, 0);
+            push16(&mut out, NCM_DATAGRAM_OFFSET as u16);
+            push16(&mut out, frame.len() as u16);
+            push16(&mut out, 0);
+            push16(&mut out, 0);
+            out.resize(NCM_DATAGRAM_OFFSET, 0);
+            out.extend_from_slice(frame);
+            out
+        }
+    }
+}
+
+/// The frames of a transfer from the device.
+pub(crate) fn unwrap(framing: Framing, transfer: &[u8]) -> Vec<Vec<u8>> {
+    let mut frames = Vec::new();
+    match framing {
+        Framing::Ecm => {
+            if transfer.len() >= 14 {
+                frames.push(transfer.to_vec());
+            }
+        }
+        Framing::Rndis => {
+            // Several messages may share a transfer.
+            let mut at = 0;
+            while let (Some(kind), Some(length)) = (u32_at(transfer, at), u32_at(transfer, at + 4)) {
+                let length = length as usize;
+                if kind != RNDIS_PACKET_MSG || length < RNDIS_PACKET_HEADER || at + length > transfer.len() {
+                    break;
+                }
+                if let (Some(offset), Some(data)) = (u32_at(transfer, at + 8), u32_at(transfer, at + 12)) {
+                    let start = at + 8 + offset as usize;
+                    if let Some(frame) = transfer.get(start..start + data as usize) {
+                        frames.push(frame.to_vec());
+                    }
+                }
+                at += length;
+            }
+        }
+        Framing::Ncm => {
+            if transfer.get(..4) != Some(NTH16_SIGNATURE) {
+                return frames;
+            }
+            let block = usize::from(u16_at(transfer, 8).unwrap_or(0)).min(transfer.len());
+            let block = if block == 0 { transfer.len() } else { block };
+            let mut ndp = usize::from(u16_at(transfer, 10).unwrap_or(0));
+            let mut tables = 0;
+            while ndp != 0 && ndp + 8 <= block && tables < 32 {
+                tables += 1;
+                let signature = transfer.get(ndp..ndp + 4);
+                if signature != Some(NDP16_SIGNATURE) && signature != Some(NDP16_CRC_SIGNATURE) {
+                    break;
+                }
+                let length = usize::from(u16_at(transfer, ndp + 4).unwrap_or(0));
+                let mut entry = ndp + 8;
+                while entry + 4 <= (ndp + length).min(block) {
+                    let index = usize::from(u16_at(transfer, entry).unwrap_or(0));
+                    let size = usize::from(u16_at(transfer, entry + 2).unwrap_or(0));
+                    if index == 0 || size == 0 {
+                        break;
+                    }
+                    if let Some(frame) = transfer.get(index..index + size).filter(|_| index + size <= block) {
+                        frames.push(frame.to_vec());
+                    }
+                    entry += 4;
+                }
+                ndp = usize::from(u16_at(transfer, ndp + 6).unwrap_or(0));
+            }
+        }
+    }
+    frames
+}
+
+pub(crate) fn rndis_initialize(request: u32) -> Vec<u8> {
+    let mut out = Vec::new();
+    for value in [RNDIS_INITIALIZE_MSG, 24, request, 1, 0, RNDIS_MAX_TRANSFER] {
+        push32(&mut out, value);
+    }
+    out
+}
+
+/// The information buffer a query carries, as Linux's `rndis_query` sends
+/// it: devices reject a query without one.
+const RNDIS_QUERY_BUFFER: u32 = 48;
+
+pub(crate) fn rndis_query(request: u32, oid: u32) -> Vec<u8> {
+    let mut out = Vec::new();
+    for value in [RNDIS_QUERY_MSG, 28 + RNDIS_QUERY_BUFFER, request, oid, RNDIS_QUERY_BUFFER, 20, 0] {
+        push32(&mut out, value);
+    }
+    out.resize(28 + RNDIS_QUERY_BUFFER as usize, 0);
+    out
+}
+
+pub(crate) fn rndis_set(request: u32, oid: u32, value: u32) -> Vec<u8> {
+    let mut out = Vec::new();
+    for field in [RNDIS_SET_MSG, 32, request, oid, 4, 20, 0, value] {
+        push32(&mut out, field);
+    }
+    out
+}
+
+/// A completion: its request ID, status and information.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct RndisReply {
+    pub kind: u32,
+    pub request: u32,
+    pub status: u32,
+    pub information: Vec<u8>,
+}
+
+pub(crate) fn rndis_reply(b: &[u8]) -> Option<RndisReply> {
+    let kind = u32_at(b, 0)?;
+    if kind & 0x8000_0000 == 0 {
+        return None;
+    }
+    let mut reply = RndisReply { kind, request: u32_at(b, 8)?, status: u32_at(b, 12)?, information: Vec::new() };
+    // A query's completion carries the information buffer (its offset from the request ID).
+    if kind == 0x8000_0000 | RNDIS_QUERY_MSG {
+        let length = u32_at(b, 16)? as usize;
+        let offset = 8 + u32_at(b, 20)? as usize;
+        reply.information = b.get(offset..offset + length)?.to_vec();
+    }
+    Some(reply)
+}
+
+/// The MAC address in a string descriptor (CDC's iMACAddress: twelve hex digits).
+pub(crate) fn mac_from_string(descriptor: &[u8]) -> Option<[u8; 6]> {
+    let units: Vec<u8> = descriptor.get(2..)?.chunks_exact(2).map(|unit| unit[0]).collect();
+    if units.len() < 12 {
+        return None;
+    }
+    let digit = |c: u8| (c as char).to_digit(16);
+    let mut mac = [0u8; 6];
+    for (index, byte) in mac.iter_mut().enumerate() {
+        *byte = (digit(units[index * 2])? << 4 | digit(units[index * 2 + 1])?) as u8;
+    }
+    Some(mac)
+}
