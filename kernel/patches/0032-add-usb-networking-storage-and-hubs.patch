+
+/// The host name the DHCP client gives the server.
+const DHCP_HOST_NAME: &[u8] = b"openshell";
+
+/// Gives an interface to each network device other than the VirtIO one,
+/// present at boot or added later (a USB adapter, a phone's tethering): an
+/// Ethernet interface named as the device, which asks a DHCP server for its
+/// address.
+pub(in crate::net) fn init_in_first_kthread() {
+    aster_network::set_device_hook(device_changed);
+    for (name, _) in aster_network::all_devices() {
+        device_changed(&name, true);
+    }
+}
+
+fn device_changed(name: &str, added: bool) {
+    if name == VIRTIO_DEVICE_NAME {
+        return;
+    }
+    let namespace = crate::net::net_ns::NetNamespace::get_init_singleton();
+    if !added {
+        if namespace.remove_iface(name).is_some() {
+            ostd::notice!("{}: removed", name);
+        }
+        return;
+    }
+    if namespace.ifaces().iter().any(|iface| iface.name().as_str() == Ok(name)) {
+        return;
+    }
+    let Some(device) = aster_network::get_device(name) else { return };
+    let iface = new_dhcp_ether(name, device);
+    let callback = {
+        let iface = iface.clone();
+        move || iface.poll()
+    };
+    aster_network::register_recv_callback(name, callback.clone());
+    aster_network::register_send_callback(name, callback);
+    namespace.add_iface(iface.clone());
+    super::poll::spawn_background_poll_thread(iface.clone());
+    iface.poll();
+    ostd::notice!("{}: asking for an address (DHCP)", name);
+}
+
+fn new_dhcp_ether(name: &str, device: Arc<SpinLock<dyn AnyNetworkDevice, BottomHalfDisabled>>) -> Arc<Iface> {
+    use aster_bigtcp::{device::Loopback, iface::EtherIface};
+
+    struct Wrapper(Arc<SpinLock<dyn AnyNetworkDevice, BottomHalfDisabled>>);
+
+    impl WithDevice for Wrapper {
+        // Its packets are allocated as the loopback's: plain buffers, which
+        // every driver takes.
+        type Device = Loopback;
+
+        fn with<F, R>(&self, f: F) -> R
+        where
+            F: FnOnce(&mut dyn AnyNetworkDevice) -> R,
+        {
+            let mut device = self.0.lock();
+            f(&mut *device)
+        }
+    }
+
+    let ether_addr = device.lock().mac_addr();
+    let flags = InterfaceFlags::UP
+        | InterfaceFlags::BROADCAST
+        | InterfaceFlags::RUNNING
+        | InterfaceFlags::MULTICAST
+        | InterfaceFlags::LOWER_UP;
+    EtherIface::new_dhcp(
+        Wrapper(device),
+        ether_addr,
+        InterfaceName::from_str_truncated(name),
+        PollScheduler::new(),
+        flags,
+        DHCP_HOST_NAME,
+    ) as Arc<Iface>
+}
+
+/// The DNS servers the DHCP leases gave, in resolv.conf's format (Linux's
+/// `/proc/net/pnp`, where /etc/resolv.conf points). QEMU's user network
+/// answers DNS on 10.0.2.3 for the VirtIO interface's fixed address.
+pub(in crate::net) fn resolv_conf() -> Vec<u8> {
+    let ifaces = crate::net::net_ns::NetNamespace::get_init_singleton().ifaces();
+    let leases: Vec<_> = ifaces.iter().filter_map(|iface| iface.dhcp_lease()).collect();
+    let mut text = aster_bigtcp::iface::resolv_conf(&leases);
+    if leases.iter().all(|lease| lease.dns.is_empty()) && virtio_iface().is_some() {
+        text.extend_from_slice(b"nameserver 10.0.2.3
+");
