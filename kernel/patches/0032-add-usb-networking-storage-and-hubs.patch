diff --git a/kernel/libs/aster-bigtcp/src/iface/dhcp.rs b/kernel/libs/aster-bigtcp/src/iface/dhcp.rs
new file mode 100755
index 0000000..7c11ae4
--- /dev/null
+++ b/kernel/libs/aster-bigtcp/src/iface/dhcp.rs
@@ -0,0 +1,362 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! A DHCPv4 client for an Ethernet interface, as Linux's `ip=dhcp` and the
+//! clients of a desktop system configure one: it asks for an address, takes
+//! the router and the DNS servers, renews the lease and starts over when the
+//! server refuses it.
+//!
+//! It works below IP: the interface has no address while it asks, so the
+//! client writes and reads whole Ethernet frames (IPv4 broadcast, UDP 68 to
+//! 67) itself. No hardware access: its tests run on the host.
+//!
+//! Reference: RFC 2131 (DHCP), RFC 2132 (options).
+
+use alloc::{vec, vec::Vec};
+
+const CLIENT_PORT: u16 = 68;
+const SERVER_PORT: u16 = 67;
+const MAGIC_COOKIE: [u8; 4] = [99, 130, 83, 99];
+/// Between attempts while asking.
+const RETRY_MS: u64 = 4_000;
+/// After this many unanswered requests, start over with a discover.
+const MAX_REQUESTS: u32 = 4;
+
+mod option {
+    pub(crate) const PAD: u8 = 0;
+    pub(crate) const SUBNET_MASK: u8 = 1;
+    pub(crate) const ROUTER: u8 = 3;
+    pub(crate) const DNS: u8 = 6;
+    pub(crate) const HOST_NAME: u8 = 12;
+    pub(crate) const DOMAIN_NAME: u8 = 15;
+    pub(crate) const REQUESTED_IP: u8 = 50;
+    pub(crate) const LEASE_TIME: u8 = 51;
+    pub(crate) const MESSAGE_TYPE: u8 = 53;
+    pub(crate) const SERVER_ID: u8 = 54;
+    pub(crate) const PARAMETERS: u8 = 55;
+    pub(crate) const RENEWAL_TIME: u8 = 58;
+    pub(crate) const REBINDING_TIME: u8 = 59;
+    pub(crate) const CLIENT_ID: u8 = 61;
+    pub(crate) const END: u8 = 255;
+}
+
+mod message {
+    pub(crate) const DISCOVER: u8 = 1;
+    pub(crate) const OFFER: u8 = 2;
+    pub(crate) const REQUEST: u8 = 3;
+    pub(crate) const ACK: u8 = 5;
+    pub(crate) const NAK: u8 = 6;
+}
+
+/// What the server gave.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Lease {
+    pub address: [u8; 4],
+    pub prefix_len: u8,
+    pub router: Option<[u8; 4]>,
+    pub dns: Vec<[u8; 4]>,
+    pub domain: Vec<u8>,
+    pub server: [u8; 4],
+    pub lease_secs: u32,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+enum State {
+    /// Sending discovers.
+    Selecting,
+    /// Requesting an offer.
+    Requesting { offer: Lease, attempts: u32 },
+    /// Holding a lease; renewing at `renew_ms`, rebinding at `rebind_ms`.
+    Bound { lease: Lease, renew_ms: u64, rebind_ms: u64, expire_ms: u64 },
+}
+
+/// What the interface should do with the client's news.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum Event {
+    /// Use this address, router and DNS servers.
+    Configure(Lease),
+    /// The address is gone: unconfigure it.
+    Deconfigure,
+}
+
+pub(crate) struct DhcpClient {
+    mac: [u8; 6],
+    xid: u32,
+    state: State,
+    /// When to send next.
+    next_ms: u64,
+    host_name: Vec<u8>,
+}
+
+/// A view of the options of a DHCP message.
+struct Options<'a>(&'a [u8]);
+
+impl<'a> Options<'a> {
+    fn get(&self, code: u8) -> Option<&'a [u8]> {
+        let mut at = 0;
+        while at < self.0.len() {
+            match self.0[at] {
+                option::PAD => at += 1,
+                option::END => return None,
+                found => {
+                    let length = usize::from(*self.0.get(at + 1)?);
+                    let value = self.0.get(at + 2..at + 2 + length)?;
+                    if found == code {
+                        return Some(value);
+                    }
+                    at += 2 + length;
+                }
+            }
+        }
+        None
+    }
+
+    fn address(&self, code: u8) -> Option<[u8; 4]> {
+        self.get(code)?.get(..4)?.try_into().ok()
+    }
+
+    fn seconds(&self, code: u8) -> Option<u32> {
+        Some(u32::from_be_bytes(self.get(code)?.get(..4)?.try_into().ok()?))
+    }
+}
+
+fn checksum(data: &[u8]) -> u16 {
+    let mut sum = 0u32;
+    for pair in data.chunks(2) {
+        let word = u16::from_be_bytes([pair[0], *pair.get(1).unwrap_or(&0)]);
+        sum += u32::from(word);
+    }
+    while sum >> 16 != 0 {
+        sum = (sum & 0xffff) + (sum >> 16);
+    }
+    !(sum as u16)
+}
+
+impl DhcpClient {
+    /// A client for the interface with this MAC; `seed` makes its
+    /// transaction IDs differ from boot to boot.
+    pub(crate) fn new(mac: [u8; 6], seed: u32, host_name: &[u8]) -> Self {
+        let xid = u32::from_be_bytes([mac[2], mac[3], mac[4], mac[5]]) ^ seed.rotate_left(13) ^ 0x5a5a_0000;
+        Self { mac, xid, state: State::Selecting, next_ms: 0, host_name: host_name.to_vec() }
+    }
+
+    /// The lease held, if any.
+    pub(crate) fn lease(&self) -> Option<&Lease> {
+        match &self.state {
+            State::Bound { lease, .. } => Some(lease),
+            _ => None,
+        }
+    }
+
+    /// When the client wants to be polled next.
+    pub(crate) fn next_ms(&self) -> u64 {
+        self.next_ms
+    }
+
+    /// At `now_ms`: a frame to send, and news for the interface.
+    pub(crate) fn poll(&mut self, now_ms: u64) -> (Option<Vec<u8>>, Option<Event>) {
+        if now_ms < self.next_ms {
+            return (None, None);
+        }
+        match self.state.clone() {
+            State::Selecting => {
+                self.next_ms = now_ms + RETRY_MS;
+                (Some(self.frame(message::DISCOVER, None, None, [0; 4])), None)
+            }
+            State::Requesting { offer, attempts } => {
+                if attempts >= MAX_REQUESTS {
+                    self.restart(now_ms);
+                    return (Some(self.frame(message::DISCOVER, None, None, [0; 4])), None);
+                }
+                self.state = State::Requesting { offer: offer.clone(), attempts: attempts + 1 };
+                self.next_ms = now_ms + RETRY_MS;
+                (Some(self.frame(message::REQUEST, Some(offer.address), Some(offer.server), [0; 4])), None)
+            }
+            State::Bound { lease, renew_ms, rebind_ms, expire_ms } => {
+                if now_ms >= expire_ms {
+                    self.restart(now_ms);
+                    return (Some(self.frame(message::DISCOVER, None, None, [0; 4])), Some(Event::Deconfigure));
+                }
+                if now_ms >= renew_ms {
+                    // Renewing, then rebinding: ask again, every few seconds,
+                    // with the address in ciaddr (RFC 2131, 4.4.5).
+                    let _ = rebind_ms;
+                    self.next_ms = (now_ms + RETRY_MS).min(expire_ms);
+                    return (Some(self.frame(message::REQUEST, None, None, lease.address)), None);
+                }
+                self.next_ms = renew_ms;
+                (None, None)
+            }
+        }
+    }
+
+    fn restart(&mut self, now_ms: u64) {
+        self.xid = self.xid.wrapping_mul(1_103_515_245).wrapping_add(12_345);
+        self.state = State::Selecting;
+        self.next_ms = now_ms + RETRY_MS;
+    }
+
+    /// A UDP datagram (an IPv4 packet's payload, from its UDP header) that
+    /// arrived for port 68: a reply to send at once, and news.
+    pub(crate) fn receive(&mut self, udp: &[u8], now_ms: u64) -> (Option<Vec<u8>>, Option<Event>) {
+        let Some(reply) = self.parse(udp) else { return (None, None) };
+        let (kind, lease) = reply;
+        match (&self.state, kind) {
+            (State::Selecting, message::OFFER) => {
+                self.state = State::Requesting { offer: lease.clone(), attempts: 1 };
+                self.next_ms = now_ms + RETRY_MS;
+                (Some(self.frame(message::REQUEST, Some(lease.address), Some(lease.server), [0; 4])), None)
+            }
+            (State::Requesting { .. }, message::ACK) | (State::Bound { .. }, message::ACK) => {
+                let lease_ms = u64::from(lease.lease_secs.max(60)) * 1000;
+                let renew_ms = now_ms + lease_ms / 2;
+                let rebind_ms = now_ms + lease_ms / 8 * 7;
+                let changed = self.lease() != Some(&lease);
+                self.state = State::Bound { lease: lease.clone(), renew_ms, rebind_ms, expire_ms: now_ms + lease_ms };
+                self.next_ms = renew_ms;
+                (None, changed.then_some(Event::Configure(lease)))
+            }
+            (State::Requesting { .. }, message::NAK) | (State::Bound { .. }, message::NAK) => {
+                let was_bound = self.lease().is_some();
+                self.restart(now_ms);
+                self.next_ms = now_ms;
+                (None, was_bound.then_some(Event::Deconfigure))
+            }
+            _ => (None, None),
+        }
+    }
+
+    /// A reply for this client: its type and what it offers.
+    fn parse(&self, udp: &[u8]) -> Option<(u8, Lease)> {
+        if udp.len() < 8 + 240 || u16::from_be_bytes([udp[2], udp[3]]) != CLIENT_PORT {
+            return None;
+        }
+        let bootp = &udp[8..];
+        // A reply (op 2) to our transaction, for our hardware address.
+        if bootp[0] != 2 || bootp[4..8] != self.xid.to_be_bytes() || bootp[28..34] != self.mac {
+            return None;
+        }
+        if bootp[236..240] != MAGIC_COOKIE {
+            return None;
+        }
+        let options = Options(&bootp[240..]);
+        let kind = *options.get(option::MESSAGE_TYPE)?.first()?;
+        let mask = options.address(option::SUBNET_MASK).unwrap_or([255, 255, 255, 0]);
+        let lease = Lease {
+            address: bootp[16..20].try_into().ok()?,
+            prefix_len: u32::from_be_bytes(mask).leading_ones() as u8,
+            router: options.address(option::ROUTER),
+            dns: options
+                .get(option::DNS)
+                .map(|servers| servers.chunks_exact(4).filter_map(|server| server.try_into().ok()).collect())
+                .unwrap_or_default(),
+            domain: options.get(option::DOMAIN_NAME).map(<[u8]>::to_vec).unwrap_or_default(),
+            server: options.address(option::SERVER_ID).unwrap_or(bootp[20..24].try_into().ok()?),
+            lease_secs: options.seconds(option::LEASE_TIME).unwrap_or(3600),
+        };
+        if kind != message::NAK && lease.address == [0; 4] {
+            return None;
+        }
+        Some((kind, lease))
+    }
+
+    /// A broadcast Ethernet frame with a DHCP message from this client.
+    fn frame(&self, kind: u8, requested: Option<[u8; 4]>, server: Option<[u8; 4]>, ciaddr: [u8; 4]) -> Vec<u8> {
+        let mut dhcp = vec![0u8; 240];
+        dhcp[0] = 1; // BOOTREQUEST
+        dhcp[1] = 1; // Ethernet
+        dhcp[2] = 6;
+        dhcp[4..8].copy_from_slice(&self.xid.to_be_bytes());
+        // Broadcast replies: there is no address to unicast to yet.
+        if ciaddr == [0; 4] {
+            dhcp[10] = 0x80;
+        }
+        dhcp[12..16].copy_from_slice(&ciaddr);
+        dhcp[28..34].copy_from_slice(&self.mac);
+        dhcp[236..240].copy_from_slice(&MAGIC_COOKIE);
+        dhcp.extend_from_slice(&[option::MESSAGE_TYPE, 1, kind]);
+        dhcp.extend_from_slice(&[option::CLIENT_ID, 7, 1]);
+        dhcp.extend_from_slice(&self.mac);
+        if let Some(address) = requested {
+            dhcp.extend_from_slice(&[option::REQUESTED_IP, 4]);
+            dhcp.extend_from_slice(&address);
+        }
+        if let Some(server) = server {
+            dhcp.extend_from_slice(&[option::SERVER_ID, 4]);
+            dhcp.extend_from_slice(&server);
+        }
+        if !self.host_name.is_empty() && self.host_name.len() < 64 {
+            dhcp.extend_from_slice(&[option::HOST_NAME, self.host_name.len() as u8]);
+            dhcp.extend_from_slice(&self.host_name);
+        }
+        dhcp.extend_from_slice(&[
+            option::PARAMETERS,
+            6,
+            option::SUBNET_MASK,
+            option::ROUTER,
+            option::DNS,
+            option::DOMAIN_NAME,
+            option::RENEWAL_TIME,
+            option::REBINDING_TIME,
+        ]);
+        dhcp.push(option::END);
+        // Some servers ignore messages shorter than a BOOTP one (300 bytes).
+        while dhcp.len() < 300 {
+            dhcp.push(option::PAD);
+        }
+
+        let udp_len = 8 + dhcp.len();
+        let ip_len = 20 + udp_len;
+        let mut frame = Vec::with_capacity(14 + ip_len);
+        frame.extend_from_slice(&[0xff; 6]);
+        frame.extend_from_slice(&self.mac);
+        frame.extend_from_slice(&[0x08, 0x00]);
+        let mut ip = [0u8; 20];
+        ip[0] = 0x45;
+        ip[2..4].copy_from_slice(&(ip_len as u16).to_be_bytes());
+        ip[4..6].copy_from_slice(&((self.xid & 0xffff) as u16).to_be_bytes());
+        ip[8] = 64;
+        ip[9] = 17;
+        ip[12..16].copy_from_slice(&ciaddr);
+        ip[16..20].copy_from_slice(&[255; 4]);
+        let sum = checksum(&ip);
+        ip[10..12].copy_from_slice(&sum.to_be_bytes());
+        frame.extend_from_slice(&ip);
+        frame.extend_from_slice(&CLIENT_PORT.to_be_bytes());
+        frame.extend_from_slice(&SERVER_PORT.to_be_bytes());
+        frame.extend_from_slice(&(udp_len as u16).to_be_bytes());
+        // A zero UDP checksum: none (allowed over IPv4).
+        frame.extend_from_slice(&[0, 0]);
+        frame.extend_from_slice(&dhcp);
+        frame
+    }
+}
+
+/// Whether an IPv4 packet (from its header) is UDP to the DHCP client port;
+/// returns the UDP datagram.
+pub(crate) fn dhcp_datagram(ipv4: &[u8]) -> Option<&[u8]> {
+    let header_len = usize::from(*ipv4.first()? & 0x0f) * 4;
+    if *ipv4.first()? >> 4 != 4 || *ipv4.get(9)? != 17 || ipv4.len() < header_len + 8 {
+        return None;
+    }
+    let total = usize::from(u16::from_be_bytes([ipv4[2], ipv4[3]])).min(ipv4.len());
+    let udp = ipv4.get(header_len..total)?;
+    (u16::from_be_bytes([udp[2], udp[3]]) == CLIENT_PORT).then_some(udp)
+}
+
+/// The DNS servers and domain of the leases, in resolv.conf's format (Linux's
+/// `/proc/net/pnp`).
+pub fn resolv_conf(leases: &[Lease]) -> Vec<u8> {
+    let mut text = Vec::new();
+    for lease in leases {
+        if !lease.domain.is_empty() {
+            text.extend_from_slice(b"domain ");
+            text.extend_from_slice(&lease.domain);
+            text.push(b'\n');
+        }
+    }
+    for server in leases.iter().flat_map(|lease| &lease.dns) {
+        let line = alloc::format!("nameserver {}.{}.{}.{}\n", server[0], server[1], server[2], server[3]);
+        text.extend_from_slice(line.as_bytes());
+    }
+    text
+}
