diff --git a/kernel/comps/usb/src/disk.rs b/kernel/comps/usb/src/disk.rs
new file mode 100755
index 0000000..31f059b
--- /dev/null
+++ b/kernel/comps/usb/src/disk.rs
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! A USB disk (a pendrive, an external disk, a card in a reader) as the
+//! kernel's block device `sda`, `sdb`, ...: its requests wait in a queue
+//! that the controller's thread serves (`crate::xhci`), moving the data
+//! straight between the device and the requests' memory.
+
+use alloc::{collections::VecDeque, string::String, sync::Arc};
+use core::sync::atomic::{AtomicBool, AtomicU32, Ordering};
+
+use aster_block::{
+    BlockDevice, BlockDeviceMeta, MajorIdOwner, PartitionManager,
+    bio::{BioEnqueueError, BioStatus, SubmittedBio},
+};
+use device_id::{DeviceId, MajorId, MinorId};
+use ostd::sync::{LocalIrqDisabled, SpinLock};
+use spin::Once;
+
+const SCSI_DISK_MAJOR: u16 = 8;
+static MAJOR: Once<Option<MajorIdOwner>> = Once::new();
+static NEXT_INDEX: AtomicU32 = AtomicU32::new(0);
+
+pub(crate) struct UsbDisk {
+    name: String,
+    id: DeviceId,
+    sectors: usize,
+    pub(crate) queue: SpinLock<VecDeque<SubmittedBio>, LocalIrqDisabled>,
+    partitions: PartitionManager,
+    /// Unplugged: requests fail at once.
+    gone: AtomicBool,
+}
+
+impl core::fmt::Debug for UsbDisk {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.debug_struct("UsbDisk").field("name", &self.name).field("sectors", &self.sectors).finish()
+    }
+}
+
+impl UsbDisk {
+    /// A disk of `sectors` 512-byte sectors, with the next name (sda, sdb, ...).
+    pub(crate) fn new(sectors: usize) -> Option<Arc<Self>> {
+        // SCSI disks' major number on Linux (8), or any free one.
+        let major = MAJOR
+            .call_once(|| aster_block::acquire_major(MajorId::new(SCSI_DISK_MAJOR)).or_else(|_| aster_block::allocate_major()).ok())
+            .as_ref()?
+            .get();
+        let index = NEXT_INDEX.fetch_add(1, Ordering::Relaxed);
+        let name = disk_name(index);
+        Some(Arc::new(Self {
+            name,
+            id: DeviceId::new(major, MinorId::new(index * aster_block::DEVICE_MINORS)),
+            sectors,
+            queue: SpinLock::new(VecDeque::new()),
+            partitions: PartitionManager::new(),
+            gone: AtomicBool::new(false),
+        }))
+    }
+
+    pub(crate) fn name(&self) -> &str {
+        &self.name
+    }
+
+    /// The disk was unplugged: what waits fails, and it leaves the system
+    /// with its partitions.
+    pub(crate) fn remove(self: &Arc<Self>) {
+        self.gone.store(true, Ordering::Release);
+        while let Some(bio) = self.queue.lock().pop_front() {
+            bio.complete(BioStatus::IoError);
+        }
+        self.partitions.remove_all();
+        let _ = aster_block::unregister(self.id);
+    }
+}
+
+/// sda .. sdz, then sdaa, as Linux names them.
+fn disk_name(index: u32) -> String {
+    let mut letters = alloc::vec::Vec::new();
+    let mut n = index + 1;
+    while n > 0 {
+        n -= 1;
+        letters.push(b'a' + (n % 26) as u8);
+        n /= 26;
+    }
+    letters.reverse();
+    alloc::format!("sd{}", String::from_utf8(letters).unwrap_or_default())
+}
+
+impl BlockDevice for UsbDisk {
+    fn enqueue(&self, bio: SubmittedBio) -> Result<(), BioEnqueueError> {
+        if self.gone.load(Ordering::Acquire) {
+            bio.complete(BioStatus::IoError);
+            return Ok(());
+        }
+        self.queue.lock().push_back(bio);
+        crate::wake();
+        Ok(())
+    }
+
+    fn metadata(&self) -> BlockDeviceMeta {
+        BlockDeviceMeta { max_nr_segments_per_bio: 64, nr_sectors: self.sectors }
+    }
+
+    fn name(&self) -> &str {
+        &self.name
+    }
+
+    fn id(&self) -> DeviceId {
+        self.id
+    }
+
+    fn partition_manager(&self) -> Option<&PartitionManager> {
+        Some(&self.partitions)
+    }
+}
