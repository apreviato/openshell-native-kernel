+// SPDX-License-Identifier: MPL-2.0
+
+//! `/proc/net`: `pnp`, the DNS servers of the kernel's DHCP leases in
+//! resolv.conf's format, as Linux's autoconfiguration gives them.
+
+use aster_util::printer::VmPrinter;
+
+use super::{
+    StaticEntry,
+    template::{
+        ProcDir, ProcDirOps, ProcFile, ProcFileOps, ReaddirEntry, listed_entries_from_table,
+        lookup_child_from_table, visit_listed_entries,
+    },
+};
+use crate::{
+    fs::{
+        file::{InodeType, mkmod},
+        vfs::inode::Inode,
+    },
+    prelude::*,
+};
+
+pub(super) struct NetDirOps;
+
+impl NetDirOps {
+    pub(super) fn new_inode(parent: Weak<dyn Inode>) -> Arc<dyn Inode> {
+        ProcDir::new(Self, parent, mkmod!(a+rx))
+    }
+
+    const STATIC_ENTRIES: &'static [StaticEntry] = &[("pnp", InodeType::File, PnpFileOps::new_inode)];
+}
+
+impl ProcDirOps for NetDirOps {
+    fn lookup_child(&self, this_dir: &ProcDir<Self>, name: &str) -> Result<Arc<dyn Inode>> {
+        if let Some(child) = lookup_child_from_table(name, Self::STATIC_ENTRIES, |f| {
+            (f)(this_dir.this_weak().clone())
+        }) {
+            return Ok(child);
+        }
+        return_errno_with_message!(Errno::ENOENT, "the file does not exist");
+    }
+
+    fn visit_entries_from_offset<'a, F>(&'a self, offset: usize, visit_fn: F) -> Result<()>
+    where
+        F: FnMut(ReaddirEntry<'a>) -> Result<()>,
+    {
+        visit_listed_entries(offset, listed_entries_from_table(Self::STATIC_ENTRIES), visit_fn)
+    }
+}
+
+struct PnpFileOps;
+
+impl PnpFileOps {
+    fn new_inode(parent: Weak<dyn Inode>) -> Arc<dyn Inode> {
+        ProcFile::new(Self, parent, mkmod!(a+r))
+    }
+}
+
+impl ProcFileOps for PnpFileOps {
+    fn read_at(&self, offset: usize, writer: &mut VmWriter) -> Result<usize> {
+        let mut printer = VmPrinter::new_skip(writer, offset);
+        let text = crate::net::resolv_conf();
+        write!(printer, "{}", core::str::from_utf8(&text).unwrap_or(""))?;
+        Ok(printer.bytes_written())
+    }
+}
