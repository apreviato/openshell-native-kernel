+                    }
+                    queued = true;
+                }
+                if queued {
+                    doorbells.push((*slot_id, net.tx_dci));
+                }
+            }
+        }
+        for (slot_id, dci) in doorbells {
+            self.ring(slot_id, dci);
+        }
+    }
+
+    // ── Hubs ─────────────────────────────────────────────────────────────
+
+    /// A hub: its descriptor, its slot fields, its ports powered, and its
+    /// status endpoint, which says which ports changed.
+    fn start_hub(&mut self, slot_id: u8, interface: &Interface) -> Result<()> {
+        let endpoint = *interface
+            .endpoints
+            .iter()
+            .find(|endpoint| endpoint.is_in() && endpoint.transfer_type() == TRANSFER_INTERRUPT)
+            .ok_or(Error::Descriptor)?;
+        let (speed, depth) = {
+            let slot = self.slots.get(&slot_id).ok_or(Error::Descriptor)?;
+            (slot.speed, slot.depth)
+        };
+        if depth >= MAX_HUB_DEPTH {
+            return Err(Error::Descriptor);
+        }
+        let superspeed = speed >= SPEED_SUPER;
+        let kind: u16 = if superspeed { 0x2a } else { 0x29 };
+        let length = self.control(slot_id, 0xa0, GET_DESCRIPTOR, kind << 8, 0, Data::In(16))?;
+        let mut descriptor = vec![0u8; length];
+        self.slots[&slot_id].buffer.read_bytes(0, &mut descriptor).map_err(|_| Error::NoMemory)?;
+        let ports = *descriptor.get(2).ok_or(Error::Descriptor)?;
+        let characteristics = u16::from_le_bytes([*descriptor.get(3).ok_or(Error::Descriptor)?, *descriptor.get(4).ok_or(Error::Descriptor)?]);
+        let power_good_ms = u64::from(*descriptor.get(5).unwrap_or(&50)) * 2;
+        let think = if superspeed { 0 } else { ((characteristics >> 5) & 3) as u8 };
+        let mtt = !superspeed && interface.protocol == 2;
+        if superspeed {
+            // A USB 3 hub needs its tier for the route strings.
+            self.control(slot_id, 0x20, SET_HUB_DEPTH, u16::from(depth), 0, Data::None)?;
+        }
+        self.slots.get_mut(&slot_id).ok_or(Error::Descriptor)?.hub_fields = Some((ports, mtt, think));
+        let ring = ProducerRing::new().ok_or(Error::NoMemory)?;
+        self.configure_endpoint(slot_id, &endpoint, EP_INTERRUPT_IN, &ring)?;
+        for port in 1..=ports {
+            let _ = self.control(slot_id, 0x23, SET_FEATURE, PORT_POWER_FEATURE, u16::from(port), Data::None);
+        }
+        self.sleep_ms(power_good_ms.max(100));
+        let hub = Hub {
+            ports,
+            superspeed,
+            children: BTreeMap::new(),
+            dci: endpoint.dci(),
+            ring,
+            buffer: DmaCoherent::alloc(1, true).map_err(|_| Error::NoMemory)?,
+            in_flight: None,
+        };
+        self.slots.get_mut(&slot_id).ok_or(Error::Descriptor)?.hub = Some(hub);
+        self.queue_hub_status(slot_id);
+        // Whatever is plugged in already.
+        for port in 1..=ports {
+            self.hub_changed.push((slot_id, port));
+        }
+        ostd::notice!("{}: slot {}: hub with {} ports{}", self.name, slot_id, ports, if superspeed { " (USB 3)" } else { "" });
+        Ok(())
+    }
+
+    fn queue_hub_status(&mut self, slot_id: u8) {
+        let Some(hub) = self.slots.get_mut(&slot_id).and_then(|slot| slot.hub.as_mut()) else { return };
+        let address = hub.ring.push(Trb {
+            parameter: hub.buffer.daddr() as u64,
+            status: 8,
+            control: Trb::with_type(trb_type::NORMAL) | IOC | ISP,
+        });
+        hub.in_flight = Some(address);
+        let dci = hub.dci;
+        self.ring(slot_id, dci);
+    }
+
+    /// The hub's status endpoint: a bitmap of the ports that changed.
+    fn hub_status_done(&mut self, slot_id: u8, event: &Trb) {
+        let code = event.completion_code();
+        let Some(hub) = self.slots.get_mut(&slot_id).and_then(|slot| slot.hub.as_mut()) else { return };
+        if hub.in_flight != Some(event.parameter) {
+            return;
+        }
+        hub.in_flight = None;
+        if code == SUCCESS || code == SHORT_PACKET {
+            let mut bitmap = [0u8; 8];
+            if hub.buffer.read_bytes(0, &mut bitmap).is_ok() {
+                for port in 1..=hub.ports {
+                    if bitmap[usize::from(port / 8)] & (1 << (port % 8)) != 0 && !self.hub_changed.contains(&(slot_id, port)) {
+                        self.hub_changed.push((slot_id, port));
+                    }
+                }
+            }
+        }
+        if code == STALL {
+            return;
+        }
+        self.queue_hub_status(slot_id);
+    }
+
+    /// A hub port's status and changes: wPortStatus, wPortChange.
+    fn hub_port_status(&mut self, hub_slot: u8, port: u8) -> Result<(u16, u16)> {
+        self.control(hub_slot, 0xa3, GET_STATUS, 0, u16::from(port), Data::In(4))?;
+        let mut status = [0u8; 4];
+        self.slots[&hub_slot].buffer.read_bytes(0, &mut status).map_err(|_| Error::NoMemory)?;
+        Ok((u16::from_le_bytes([status[0], status[1]]), u16::from_le_bytes([status[2], status[3]])))
+    }
+
+    fn hub_port_changed(&mut self, hub_slot: u8, port: u8) {
+        if let Err(error) = self.try_hub_port_changed(hub_slot, port) {
+            ostd::notice!("{}: hub slot {} port {}: {:?}", self.name, hub_slot, port, error);
+        }
+    }
+
+    fn try_hub_port_changed(&mut self, hub_slot: u8, port: u8) -> Result<()> {
+        let Some(slot) = self.slots.get(&hub_slot) else { return Ok(()) };
+        let Some(hub) = slot.hub.as_ref() else { return Ok(()) };
+        let superspeed = hub.superspeed;
+        let child = hub.children.get(&port).copied();
+        let (status, change) = self.hub_port_status(hub_slot, port)?;
+        // Acknowledge each change.
+        for (bit, feature) in HUB_CHANGE_FEATURES {
+            if change & (1 << bit) != 0 {
+                let _ = self.control(hub_slot, 0x23, CLEAR_FEATURE, feature, u16::from(port), Data::None);
+            }
+        }
+        if status & HUB_PORT_CONNECTION == 0 {
+            if let Some(child) = child {
+                if let Some(hub) = self.slots.get_mut(&hub_slot).and_then(|slot| slot.hub.as_mut()) {
+                    hub.children.remove(&port);
+                }
+                self.detach_slot(child);
+                ostd::notice!("{}: hub slot {} port {}: device removed", self.name, hub_slot, port);
+            }
+            return Ok(());
+        }
+        if child.is_some() {
+            return Ok(());
+        }
+        // Let the connection settle, then reset the port.
+        self.sleep_ms(100);
+        self.control(hub_slot, 0x23, SET_FEATURE, PORT_RESET_FEATURE, u16::from(port), Data::None)?;
+        let deadline = crate::now_ms() + 500;
+        let status = loop {
+            self.sleep_ms(10);
+            let (status, change) = self.hub_port_status(hub_slot, port)?;
+            if change & (1 << 4) != 0 || (superspeed && change & (1 << 5) != 0) {
+                let _ = self.control(hub_slot, 0x23, CLEAR_FEATURE, C_PORT_RESET, u16::from(port), Data::None);
+                if superspeed {
+                    let _ = self.control(hub_slot, 0x23, CLEAR_FEATURE, C_BH_PORT_RESET, u16::from(port), Data::None);
+                }
+                break status;
+            }
+            if crate::now_ms() >= deadline {
+                return Err(Error::Timeout);
+            }
+        };
+        if status & HUB_PORT_ENABLE == 0 {
+            return Err(Error::Timeout);
+        }
+        self.sleep_ms(10);
+        let (hub_speed, hub_route, hub_depth, hub_tt, root_port) = {
+            let slot = &self.slots[&hub_slot];
+            (slot.speed, slot.route, slot.depth, slot.tt, slot.port)
+        };
+        let speed = if superspeed {
+            SPEED_SUPER
+        } else if status & (1 << 9) != 0 {
+            SPEED_LOW
+        } else if status & (1 << 10) != 0 {
+            SPEED_HIGH
+        } else {
+            SPEED_FULL
+        };
+        // The hub's route, with this port at its tier.
+        let route = hub_route | u32::from(port.min(15)) << (4 * u32::from(hub_depth));
+        // A full- or low-speed device below a high-speed hub: that hub's
+        // translator; further down, the one above.
+        let tt = if hub_speed == SPEED_HIGH && (speed == SPEED_FULL || speed == SPEED_LOW) { (hub_slot, port) } else { hub_tt };
+        let child = self.enable_device(root_port, speed, route, hub_depth + 1, tt, Some((hub_slot, port)))?;
+        if let Some(hub) = self.slots.get_mut(&hub_slot).and_then(|slot| slot.hub.as_mut()) {
+            hub.children.insert(port, child);
+        }
+        Ok(())
+    }
+
+    // ── Mass storage ─────────────────────────────────────────────────────
+
+    /// A Bulk-Only mass storage interface: its LUNs that hold a disk with a
+    /// medium become block devices.
+    fn start_storage(&mut self, slot_id: u8, interface: &Interface) -> Result<()> {
+        // Bulk-Only Transport with SCSI (nearly all), or with the ATAPI,
+        // UFI or SFF-8070i command sets of old drives and floppies.
+        if interface.protocol != 0x50 || !matches!(interface.subclass, 0x01 | 0x02 | 0x04 | 0x05 | 0x06) {
+            return Err(Error::Descriptor);
+        }
+        let bulk = |inward: bool| {
+            interface.endpoints.iter().find(|e| e.transfer_type() == TRANSFER_BULK && e.is_in() == inward).copied()
+        };
+        let (in_endpoint, out_endpoint) = (bulk(true).ok_or(Error::Descriptor)?, bulk(false).ok_or(Error::Descriptor)?);
+        let in_ring = ProducerRing::new().ok_or(Error::NoMemory)?;
+        let out_ring = ProducerRing::new().ok_or(Error::NoMemory)?;
+        self.configure_endpoint(slot_id, &in_endpoint, EP_BULK_IN, &in_ring)?;
+        self.configure_endpoint(slot_id, &out_endpoint, EP_BULK_OUT, &out_ring)?;
+        let number = u16::from(interface.number);
+        // Card readers have several units; most devices stall the question.
+        let max_lun = match self.control(slot_id, 0xa1, GET_MAX_LUN, 0, number, Data::In(1)) {
+            Ok(1) => {
+                let mut lun = [0u8; 1];
+                let _ = self.slots[&slot_id].buffer.read_bytes(0, &mut lun);
+                lun[0].min(15)
+            }
+            _ => 0,
+        };
+        let storage = Storage {
+            interface: interface.number,
+            in_address: in_endpoint.address,
+            out_address: out_endpoint.address,
+            in_dci: in_endpoint.dci(),
+            out_dci: out_endpoint.dci(),
+            in_max_packet: usize::from(in_endpoint.max_packet & 0x7ff).max(8),
+            out_max_packet: usize::from(out_endpoint.max_packet & 0x7ff).max(8),
+            in_ring,
+            out_ring,
+            buffer: DmaCoherent::alloc(1, true).map_err(|_| Error::NoMemory)?,
+            tag: 1,
+            luns: Vec::new(),
+            empty: Vec::new(),
+            pad12: matches!(interface.subclass, 0x02 | 0x04 | 0x05),
+        };
+        let slot = self.slots.get_mut(&slot_id).ok_or(Error::Descriptor)?;
+        slot.storage.push(storage);
+        let index = slot.storage.len() - 1;
+        for lun in 0..=max_lun {
+            match self.start_lun(slot_id, index, lun) {
+                Ok(()) => {}
+                Err(error) => {
+                    ostd::notice!("{}: slot {} LUN {}: no disk ({:?})", self.name, slot_id, lun, error);
+                    if matches!(error, Error::NoMedium | Error::Timeout) {
+                        self.slots.get_mut(&slot_id).ok_or(Error::Descriptor)?.storage[index].empty.push(lun);
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn start_lun(&mut self, slot_id: u8, storage: usize, lun: u8) -> Result<()> {
+        let data = self.scsi_in(slot_id, storage, lun, &scsi::inquiry(), 36)?;
+        let inquiry = scsi::parse_inquiry(&data).ok_or(Error::Descriptor)?;
+        if !inquiry.disk {
+            return Err(Error::Descriptor);
+        }
+        // A disk spinning up, a reader looking at its card (Linux's
+        // `sd_spinup_disk`).
+        let mut ready = false;
+        let mut started = false;
+        for _ in 0..100 {
+            if self.scsi_status(slot_id, storage, lun, &scsi::test_unit_ready(), &[], false)? == 0 {
+                ready = true;
+                break;
+            }
+            let sense = self.scsi_in(slot_id, storage, lun, &scsi::request_sense(), 18).ok().and_then(|data| scsi::parse_sense(&data));
+            match sense {
+                Some(sense) if scsi::no_medium(sense) => return Err(Error::NoMedium),
+                // Power on, reset, medium changed: ask again at once.
+                Some((0x06, _, _)) => continue,
+                // It waits to be told to start.
+                Some((0x02, 0x04, 0x02)) if !started => {
+                    started = true;
+                    let _ = self.scsi_status(slot_id, storage, lun, &scsi::start_stop_unit(true), &[], false);
+                }
+                _ => {}
+            }
+            self.pause_ms(100);
+        }
+        if !ready {
+            return Err(Error::Timeout);
+        }
+        let mut capacity = scsi::parse_capacity(&self.scsi_in(slot_id, storage, lun, &scsi::read_capacity_10(), 8)?).ok_or(Error::Descriptor)?;
+        if capacity.0 > u64::from(u32::MAX) {
+            capacity = scsi::parse_capacity(&self.scsi_in(slot_id, storage, lun, &scsi::read_capacity_16(), 32)?).ok_or(Error::Descriptor)?;
+        }
+        let (blocks, block_size) = capacity;
+        if !matches!(block_size, 512 | 1024 | 2048 | 4096) || blocks == 0 {
+            return Err(Error::Descriptor);
+        }
+        let sectors = (blocks * u64::from(block_size) / 512) as usize;
+        let disk = UsbDisk::new(sectors).ok_or(Error::NoMemory)?;
+        ostd::notice!(
+            "{}: {}: {} {} ({} MB, {}-byte blocks{})",
+            self.name, disk.name(), inquiry.vendor, inquiry.product, sectors / 2048, block_size,
+            if inquiry.removable { ", removable" } else { "" }
+        );
+        self.slots.get_mut(&slot_id).ok_or(Error::Descriptor)?.storage[storage].luns.push(Lun {
+            number: lun,
+            disk: disk.clone(),
+            block_size,
+            blocks,
+            removable: inquiry.removable,
+        });
+        let device: alloc::sync::Arc<dyn aster_block::BlockDevice> = disk;
+        if aster_block::register(device.clone()).is_ok() {
+            // Reading the partition table takes this thread's service.
+            aster_core::spawn_kernel_thread(move || aster_block::scan_device_partitions(&device));
+        }
+        Ok(())
+    }
+
+    /// A transfer on a storage bulk endpoint of `pieces` (address, length),
+    /// waited for; returns the bytes moved.
+    fn bulk(&mut self, slot_id: u8, storage: usize, inward: bool, pieces: &[(u64, usize)]) -> Result<usize> {
+        let version = self.version;
+        let (dci, addresses) = {
+            let unit = &mut self.slots.get_mut(&slot_id).ok_or(Error::Descriptor)?.storage[storage];
+            let (ring, dci, max_packet) =
+                if inward { (&mut unit.in_ring, unit.in_dci, unit.in_max_packet) } else { (&mut unit.out_ring, unit.out_dci, unit.out_max_packet) };
+            let total: usize = pieces.iter().map(|(_, length)| length).sum();
+            let mut addresses = Vec::with_capacity(pieces.len());
+            let mut transferred = 0;
+            for (index, &(address, length)) in pieces.iter().enumerate() {
+                let last = index + 1 == pieces.len();
+                let control = Trb::with_type(trb_type::NORMAL)
+                    | if last { IOC } else { CHAIN }
+                    | if inward { ISP } else { 0 };
+                let remainder = td_remainder(version, transferred, length, total, max_packet, !last);
+                addresses.push((ring.push(Trb { parameter: address, status: length as u32 | remainder.min(31) << 17, control }), length));
+                transferred += length;
+            }
+            (dci, addresses)
+        };
+        self.ring(slot_id, dci);
+        let waited = self.wait_event(
+            &mut |event| {
+                event.kind() == trb_type::TRANSFER_EVENT
+                    && event.slot() == slot_id
+                    && event.endpoint() == dci
+                    && addresses.iter().any(|(address, _)| *address == event.parameter)
+            },
+            TRANSFER_TIMEOUT_MS * 2,
+        );
+        let event = match waited {
+            Ok(event) => event,
+            Err(error) => {
+                // What the controller still holds is taken back.
+                self.clear_halt(slot_id, storage, inward);
+                return Err(error);
+            }
+        };
+        let code = event.completion_code();
+        if code == SUCCESS || code == SHORT_PACKET {
+            let at = addresses.iter().position(|(address, _)| *address == event.parameter).unwrap_or(0);
+            let before: usize = addresses[..at].iter().map(|(_, length)| length).sum();
+            return Ok(before + addresses[at].1.saturating_sub((event.status & 0xff_ffff) as usize));
+        }
+        if code == STALL {
+            self.clear_halt(slot_id, storage, inward);
+        }
+        Err(Error::Completion(code))
+    }
+
+    /// After a stall: the controller's endpoint reset and moved on, and the
+    /// device's endpoint halt cleared.
+    fn clear_halt(&mut self, slot_id: u8, storage: usize, inward: bool) {
+        let Some(unit) = self.slots.get(&slot_id).and_then(|slot| slot.storage.get(storage)) else { return };
+        let (dci, address, dequeue) = if inward {
+            (unit.in_dci, unit.in_address, unit.in_ring.dequeue_pointer())
+        } else {
+            (unit.out_dci, unit.out_address, unit.out_ring.dequeue_pointer())
+        };
+        // A halted endpoint is reset; a running one (a transfer timed out)
+        // is stopped.
+        let target = u32::from(dci) << 16 | u32::from(slot_id) << 24;
+        if self.command(Trb { control: Trb::with_type(trb_type::RESET_ENDPOINT) | target, ..Trb::default() }).is_err() {
+            let _ = self.command(Trb { control: Trb::with_type(trb_type::STOP_ENDPOINT) | target, ..Trb::default() });
+        }
+        let _ = self.command(Trb {
+            parameter: dequeue,
+            control: Trb::with_type(trb_type::SET_TR_DEQUEUE) | u32::from(dci) << 16 | u32::from(slot_id) << 24,
+            ..Trb::default()
+        });
+        let _ = self.control(slot_id, 0x02, CLEAR_FEATURE, 0, u16::from(address), Data::None);
+    }
+
+    /// A SCSI command with its data: the CBW, the data, the CSW. Returns the
+    /// command's status (0: good) and the bytes of data moved.
+    fn scsi(&mut self, slot_id: u8, storage: usize, lun: u8, cdb: &[u8], data: &[(u64, usize)], inward: bool) -> Result<(u8, usize)> {
+        let (tag, buffer) = {
+            let unit = &mut self.slots.get_mut(&slot_id).ok_or(Error::Descriptor)?.storage[storage];
+            unit.tag = unit.tag.wrapping_add(1);
+            (unit.tag, unit.buffer.daddr() as u64)
+        };
+        let length: usize = data.iter().map(|(_, length)| length).sum();
+        let mut padded = [0u8; 12];
+        let cdb = if self.slots[&slot_id].storage[storage].pad12 && cdb.len() < 12 {
+            padded[..cdb.len()].copy_from_slice(cdb);
+            &padded[..]
+        } else {
+            cdb
+        };
+        let wrapper = scsi::cbw(tag, length as u32, inward, lun, cdb);
+        self.slots[&slot_id].storage[storage].buffer.write_bytes(0, &wrapper).map_err(|_| Error::NoMemory)?;
+        if let Err(error) = self.bulk(slot_id, storage, false, &[(buffer, scsi::CBW_LENGTH)]) {
+            self.reset_recovery(slot_id, storage);
+            return Err(error);
+        }
+        let mut moved = 0;
+        if length > 0 {
+            match self.bulk(slot_id, storage, inward, data) {
+                Ok(bytes) => moved = bytes,
+                // A stalled data phase still ends with a status.
+                Err(Error::Completion(STALL)) => {}
+                Err(error) => {
+                    self.reset_recovery(slot_id, storage);
+                    return Err(error);
+                }
+            }
+        }
+        let status_at = buffer + 512;
+        let mut status = self.bulk(slot_id, storage, true, &[(status_at, scsi::CSW_LENGTH)]);
+        if matches!(status, Err(Error::Completion(STALL))) {
+            status = self.bulk(slot_id, storage, true, &[(status_at, scsi::CSW_LENGTH)]);
+        }
+        status?;
+        let mut csw = [0u8; scsi::CSW_LENGTH];
+        self.slots[&slot_id].storage[storage].buffer.read_bytes(512, &mut csw).map_err(|_| Error::NoMemory)?;
+        match scsi::csw(&csw, tag) {
+            Some((_, 2)) | None => {
+                self.reset_recovery(slot_id, storage);
+                Err(Error::Descriptor)
+            }
+            Some((_, status)) => Ok((status, moved)),
+        }
+    }
+
+    /// A command without data: its status.
+    fn scsi_status(&mut self, slot_id: u8, storage: usize, lun: u8, cdb: &[u8], data: &[(u64, usize)], inward: bool) -> Result<u8> {
+        self.scsi(slot_id, storage, lun, cdb, data, inward).map(|(status, _)| status)
+    }
+
+    /// A command that reads a little (into the storage buffer's second half).
+    fn scsi_in(&mut self, slot_id: u8, storage: usize, lun: u8, cdb: &[u8], length: usize) -> Result<Vec<u8>> {
+        let buffer = self.slots[&slot_id].storage[storage].buffer.daddr() as u64;
+        let (status, moved) = self.scsi(slot_id, storage, lun, cdb, &[(buffer + 2048, length)], true)?;
+        if status != 0 {
+            return Err(Error::Completion(status));
+        }
+        let mut data = vec![0u8; moved];
+        self.slots[&slot_id].storage[storage].buffer.read_bytes(2048, &mut data).map_err(|_| Error::NoMemory)?;
+        Ok(data)
+    }
+
+    /// Bulk-Only Mass Storage Reset, then both endpoints' halts cleared.
+    fn reset_recovery(&mut self, slot_id: u8, storage: usize) {
+        let Some(interface) = self.slots.get(&slot_id).and_then(|slot| slot.storage.get(storage)).map(|unit| unit.interface) else { return };
+        let _ = self.control(slot_id, 0x21, BULK_ONLY_RESET, 0, u16::from(interface), Data::None);
+        self.clear_halt(slot_id, storage, true);
+        self.clear_halt(slot_id, storage, false);
+    }
+
+    /// Every two seconds: a medium put in an empty LUN becomes a disk; one
+    /// taken out of (or changed in) a removable LUN takes its disk away.
+    fn check_media(&mut self) {
+        let now = crate::now_ms();
+        if now < self.next_media_check {
+            return;
+        }
+        self.next_media_check = now + MEDIA_CHECK_MS;
+        let mut work = Vec::new();
+        for (&slot_id, slot) in &self.slots {
+            for (index, unit) in slot.storage.iter().enumerate() {
+                work.extend(unit.empty.iter().map(|&lun| (slot_id, index, lun, false)));
+                work.extend(unit.luns.iter().filter(|lun| lun.removable).map(|lun| (slot_id, index, lun.number, true)));
+            }
+        }
+        for (slot_id, storage, lun, present) in work {
+            let ready = matches!(self.scsi_status(slot_id, storage, lun, &scsi::test_unit_ready(), &[], false), Ok(0));
+            if present && ready {
+                continue;
+            }
+            let sense = if ready {
+                None
+            } else {
+                self.scsi_in(slot_id, storage, lun, &scsi::request_sense(), 18).ok().and_then(|data| scsi::parse_sense(&data))
+            };
+            if present {
+                // Gone (no medium) or changed (unit attention: medium changed).
+                let gone = sense.is_some_and(|sense| scsi::no_medium(sense) || (sense.0 == 0x06 && sense.1 == 0x28));
+                if gone {
+                    self.remove_lun(slot_id, storage, lun);
+                }
+            } else if ready || sense.is_some_and(|sense| sense.0 == 0x06 && sense.1 == 0x28) {
+                let Some(unit) = self.slots.get_mut(&slot_id).map(|slot| &mut slot.storage[storage]) else { continue };
+                unit.empty.retain(|&empty| empty != lun);
+                if let Err(error) = self.start_lun(slot_id, storage, lun) {
+                    if matches!(error, Error::NoMedium | Error::Timeout) {
+                        if let Some(slot) = self.slots.get_mut(&slot_id) {
+                            slot.storage[storage].empty.push(lun);
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    /// A LUN's medium went away: its disk too, and the LUN waits for another.
+    fn remove_lun(&mut self, slot_id: u8, storage: usize, lun: u8) {
+        let Some(unit) = self.slots.get_mut(&slot_id).map(|slot| &mut slot.storage[storage]) else { return };
+        let Some(position) = unit.luns.iter().position(|unit_lun| unit_lun.number == lun) else { return };
+        let removed = unit.luns.remove(position);
+        unit.empty.push(lun);
+        ostd::notice!("{}: {}: medium removed", self.name, removed.disk.name());
+        removed.disk.remove();
+    }
+
+    /// Serves what the disks were asked.
+    fn serve_disks(&mut self) {
+        let mut work = Vec::new();
+        for (&slot_id, slot) in &self.slots {
+            for (storage, unit) in slot.storage.iter().enumerate() {
+                for (lun, unit_lun) in unit.luns.iter().enumerate() {
+                    while let Some(bio) = unit_lun.disk.queue.lock().pop_front() {
+                        work.push((slot_id, storage, lun, bio));
+                    }
+                }
+            }
+        }
+        for (slot_id, storage, lun, bio) in work {
+            let status = self.serve_bio(slot_id, storage, lun, &bio);
+            bio.complete(status);
+        }
+    }
+
+    fn serve_bio(&mut self, slot_id: u8, storage: usize, lun: usize, bio: &SubmittedBio) -> BioStatus {
+        let Some((number, block_size, blocks)) = self
+            .slots
+            .get(&slot_id)
+            .and_then(|slot| slot.storage.get(storage))
+            .and_then(|unit| unit.luns.get(lun))
+            .map(|lun| (lun.number, lun.block_size, lun.blocks))
+        else {
+            return BioStatus::IoError;
+        };
+        let write = match bio.type_() {
+            BioType::Read => false,
+            BioType::Write => true,
+            BioType::Flush => {
+                return match self.scsi_status(slot_id, storage, number, &scsi::synchronize_cache(), &[], false) {
+                    Ok(_) => BioStatus::Complete,
+                    Err(_) => BioStatus::IoError,
+                };
+            }
+        };
+        let mut pieces = Vec::new();
+        for segment in bio.segments() {
+            let slice = segment.dma_slice();
+            pieces.extend(scsi::split_64k(slice.daddr() as u64, slice.size()));
+        }
+        // A partition's requests carry its start (`sid_offset`).
+        let mut byte = (bio.sid_range().start.to_raw() + bio.sid_offset()) * 512;
+        let mut command: Vec<(u64, usize)> = Vec::new();
+        let mut command_bytes = 0;
+        let run = |this: &mut Self, command: &mut Vec<(u64, usize)>, bytes: &mut usize, at: &mut u64| -> bool {
+            if command.is_empty() {
+                return true;
+            }
+            let size = u64::from(block_size);
+            if *at % size != 0 || *bytes as u64 % size != 0 {
+                return false;
+            }
+            let (lba, count) = (*at / size, *bytes as u64 / size);
+            if lba + count > blocks {
+                return false;
+            }
+            let cdb = scsi::read_write(write, lba, count as u32);
+            let done = matches!(this.scsi(slot_id, storage, number, &cdb, command, !write), Ok((0, moved)) if moved == *bytes);
+            *at += *bytes as u64;
+            command.clear();
+            *bytes = 0;
+            done
+        };
+        for piece in pieces {
+            if command_bytes + piece.1 > MAX_COMMAND_BYTES || command.len() >= MAX_COMMAND_PIECES {
+                if !run(self, &mut command, &mut command_bytes, &mut byte) {
+                    return BioStatus::IoError;
+                }
+            }
+            command.push(piece);
+            command_bytes += piece.1;
+        }
+        if !run(self, &mut command, &mut command_bytes, &mut byte) {
+            return BioStatus::IoError;
+        }
+        BioStatus::Complete
+    }
 }
