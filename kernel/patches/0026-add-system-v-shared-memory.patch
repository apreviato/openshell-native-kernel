@@ -0,0 +1,201 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! `shmget`, `shmat`, `shmdt` and `shmctl` (ipc/shared_memory.rs).
+
+use align_ext::AlignExt;
+use ostd::mm::VmIo;
+
+use super::SyscallReturn;
+use crate::{
+    ipc::{IpcFlags, IpcId},
+    prelude::*,
+    vm::{
+        perms::VmPerms,
+        vmar::{MmapMode, VMAR_CAP_ADDR, VmarMapOffset},
+    },
+};
+
+const SHM_RDONLY: i32 = 0o10000;
+const SHM_RND: i32 = 0o20000;
+const SHM_REMAP: i32 = 0o40000;
+const SHM_EXEC: i32 = 0o100000;
+/// Attach addresses are aligned to this (`SHMLBA`).
+const SHMLBA: usize = PAGE_SIZE;
+
+const IPC_RMID: i32 = 0;
+const IPC_STAT: i32 = 2;
+const SHM_LOCK: i32 = 11;
+const SHM_UNLOCK: i32 = 12;
+/// Some C libraries add this to the command for the 64-bit layout, which is the only one here.
+const IPC_64: i32 = 0x100;
+
+fn shm_id(shmid: i32) -> Result<IpcId> {
+    IpcId::try_from(shmid.cast_unsigned())
+        .map_err(|_| Error::with_message(Errno::EINVAL, "non-positive shared memory IDs are invalid"))
+}
+
+pub(super) fn sys_shmget(key: i32, size: usize, shmflg: i32, ctx: &Context) -> Result<SyscallReturn> {
+    let flags = IpcFlags::from_bits_truncate(shmflg.cast_unsigned());
+    let mode = (shmflg.cast_unsigned() & 0o777) as u16;
+    debug!("shmget: key = {}, size = {}, flags = {:?}, mode = {:03o}", key, size, flags, mode);
+
+    let ns_proxy = ctx.thread_local.borrow_ns_proxy();
+    let ipc_ns = ns_proxy.unwrap().ipc_ns();
+    let shmid = ipc_ns.get_or_create_shm(
+        key,
+        size,
+        flags,
+        mode,
+        ctx.posix_thread.credentials(),
+        ctx.process.pid(),
+    )?;
+    Ok(SyscallReturn::Return(shmid.get() as isize))
+}
+
+pub(super) fn sys_shmat(shmid: i32, shmaddr: Vaddr, shmflg: i32, ctx: &Context) -> Result<SyscallReturn> {
+    let shmid = shm_id(shmid)?;
+    debug!("shmat: shmid = {:?}, addr = {:#x}, flags = {:#o}", shmid, shmaddr, shmflg);
+
+    let read_only = shmflg & SHM_RDONLY != 0;
+    let addr = if shmflg & SHM_RND != 0 {
+        shmaddr.align_down(SHMLBA)
+    } else if !shmaddr.is_multiple_of(SHMLBA) {
+        return_errno_with_message!(Errno::EINVAL, "the attach address is not aligned");
+    } else {
+        shmaddr
+    };
+
+    let ns_proxy = ctx.thread_local.borrow_ns_proxy();
+    let ipc_ns = ns_proxy.unwrap().ipc_ns();
+    let credentials = ctx.posix_thread.credentials();
+    let (memory, len) = ipc_ns.with_shm(shmid, |shm| {
+        if !shm
+            .permission()
+            .allows(credentials.euid(), credentials.egid(), !read_only)
+        {
+            return_errno_with_message!(Errno::EACCES, "no access to the shared memory segment");
+        }
+        let memory = shm
+            .memory()
+            .ok_or_else(|| Error::with_message(Errno::EIDRM, "the segment was removed"))?;
+        Ok((memory, shm.size().align_up(PAGE_SIZE)))
+    })?;
+
+    let mut perms = VmPerms::READ;
+    let mut may_perms = VmPerms::ALL_MAY_PERMS;
+    if read_only {
+        may_perms.remove(VmPerms::MAY_WRITE);
+    } else {
+        perms |= VmPerms::WRITE;
+    }
+    if shmflg & SHM_EXEC != 0 {
+        perms |= VmPerms::EXEC;
+    }
+
+    let user_space = ctx.user_space();
+    let mut options = user_space
+        .vmar()
+        .new_map(len, perms)
+        .may_perms(may_perms)
+        .map_mode(MmapMode::Shared)
+        .vmo(memory);
+    if addr != 0 {
+        if VMAR_CAP_ADDR.checked_sub(addr).is_none_or(|gap| gap < len) {
+            return_errno_with_message!(Errno::EINVAL, "the attach address is not in userspace");
+        }
+        options = options.offset(if shmflg & SHM_REMAP != 0 {
+            VmarMapOffset::FixedReplace(addr)
+        } else {
+            VmarMapOffset::FixedNoReplace(addr)
+        });
+    } else if shmflg & SHM_REMAP != 0 {
+        return_errno_with_message!(Errno::EINVAL, "SHM_REMAP needs an address");
+    }
+    let mapped = options.build()?;
+
+    let _ = ipc_ns.with_shm(shmid, |shm| {
+        shm.note_attach(ctx.process.pid());
+        Ok(())
+    });
+    Ok(SyscallReturn::Return(mapped as isize))
+}
+
+pub(super) fn sys_shmdt(shmaddr: Vaddr, ctx: &Context) -> Result<SyscallReturn> {
+    debug!("shmdt: addr = {:#x}", shmaddr);
+    if !shmaddr.is_multiple_of(PAGE_SIZE) {
+        return_errno_with_message!(Errno::EINVAL, "the address is not aligned");
+    }
+
+    let user_space = ctx.user_space();
+    let vmar = user_space.vmar();
+    // The segment mapped at the address: its memory names it.
+    let memory = {
+        let query = vmar.query(shmaddr..shmaddr + 1);
+        let found = query
+            .iter()
+            .find(|mapping| mapping.map_to_addr() == shmaddr)
+            .and_then(|mapping| mapping.shared_vmo().cloned());
+        found
+    }
+    .ok_or_else(|| Error::with_message(Errno::EINVAL, "no shared memory segment is attached there"))?;
+
+    let ns_proxy = ctx.thread_local.borrow_ns_proxy();
+    let ipc_ns = ns_proxy.unwrap().ipc_ns();
+    let len = ipc_ns
+        .find_shm(|_, shm| {
+            shm.is_memory(&memory).then(|| {
+                shm.note_detach(ctx.process.pid());
+                shm.size().align_up(PAGE_SIZE)
+            })
+        })
+        .ok_or_else(|| Error::with_message(Errno::EINVAL, "no shared memory segment is attached there"))?;
+    drop(memory);
+
+    vmar.remove_mapping(shmaddr..shmaddr + len);
+    ipc_ns.reap_shm();
+    Ok(SyscallReturn::Return(0))
+}
+
+pub(super) fn sys_shmctl(shmid: i32, cmd: i32, buf: Vaddr, ctx: &Context) -> Result<SyscallReturn> {
+    let shmid = shm_id(shmid)?;
+    let cmd = cmd & !IPC_64;
+    debug!("shmctl: shmid = {:?}, cmd = {}, buf = {:#x}", shmid, cmd, buf);
+
+    let ns_proxy = ctx.thread_local.borrow_ns_proxy();
+    let ipc_ns = ns_proxy.unwrap().ipc_ns();
+    let credentials = ctx.posix_thread.credentials();
+
+    match cmd {
+        IPC_STAT => {
+            let shmid_ds = ipc_ns.with_shm(shmid, |shm| {
+                if !shm
+                    .permission()
+                    .allows(credentials.euid(), credentials.egid(), false)
+                {
+                    return_errno_with_message!(Errno::EACCES, "no access to the shared memory segment");
+                }
+                Ok(shm.shmid_ds())
+            })?;
+            ctx.user_space().write_val(buf, &shmid_ds)?;
+        }
+        IPC_RMID => {
+            let euid = credentials.euid();
+            ipc_ns.remove_shm(shmid, |shm| {
+                let permission = shm.permission();
+                if !(euid.is_root() || euid == permission.uid() || euid == permission.cuid()) {
+                    return_errno_with_message!(
+                        Errno::EPERM,
+                        "the process does not have permission to remove the segment"
+                    );
+                }
+                Ok(())
+            })?;
+        }
+        // Memory is never swapped out: locking it changes nothing.
+        SHM_LOCK | SHM_UNLOCK => {
+            ipc_ns.with_shm(shmid, |_| Ok(()))?;
+        }
+        _ => return_errno_with_message!(Errno::EINVAL, "unsupported shmctl command"),
+    }
+    Ok(SyscallReturn::Return(0))
+}
