diff --git a/kernel/core/src/ipc/shared_memory.rs b/kernel/core/src/ipc/shared_memory.rs
new file mode 100644
index 0000000..54b53b0
--- /dev/null
+++ b/kernel/core/src/ipc/shared_memory.rs
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! System V shared memory.
+//!
+//! A segment is a [`Vmo`] that every `shmat` maps shared into its caller. The X server's MIT-SHM
+//! extension relies on it: a client (Chromium, Xpra, GTK) draws into a segment that the server
+//! attaches too, instead of sending every image through the socket.
+//!
+//! As in Linux, `IPC_RMID` does not end a segment that is still attached: it is marked destroyed,
+//! loses its key, and lives until its last mapping goes. The namespace then keeps only a weak
+//! reference to the memory, which the mappings hold.
+
+use core::sync::atomic::{AtomicBool, AtomicI32, AtomicU64, Ordering};
+
+use align_ext::AlignExt;
+
+use aster_rights::ReadOp;
+
+use super::{IpcKey, IpcPerm, IpcPermission};
+use crate::{
+    prelude::*,
+    process::{Credentials, Pid},
+    time::clocks::RealTimeCoarseClock,
+    vm::page_cache::{Vmo, VmoOptions},
+};
+
+/// The most segments in a namespace.
+pub(crate) const SHMMNI: usize = 4096;
+/// The smallest segment.
+pub(crate) const SHMMIN: usize = 1;
+/// The largest segment (Linux's default `SHMMAX`).
+pub(crate) const SHMMAX: usize = usize::MAX - (1 << 24);
+/// `shm_perm.mode` of a destroyed segment.
+const SHM_DEST: u16 = 0o1000;
+
+// Reference: <https://elixir.bootlin.com/linux/v6.18/source/include/uapi/asm-generic/shmbuf.h>.
+#[padding_struct]
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default, Pod)]
+pub(crate) struct ShmidDs {
+    shm_perm: IpcPerm,
+    shm_segsz: u64,
+    shm_atime: u64,
+    shm_dtime: u64,
+    shm_ctime: u64,
+    shm_cpid: i32,
+    shm_lpid: i32,
+    shm_nattch: u64,
+    _unused4: u64,
+    _unused5: u64,
+}
+
+pub(crate) struct SharedMemory {
+    permission: IpcPermission,
+    size: usize,
+    /// The memory while the segment is not destroyed.
+    memory: Mutex<Option<Arc<Vmo>>>,
+    /// The memory, as long as anything maps it.
+    weak_memory: Weak<Vmo>,
+    destroyed: AtomicBool,
+    creator_pid: Pid,
+    last_pid: AtomicI32,
+    attach_time: AtomicU64,
+    detach_time: AtomicU64,
+    change_time: AtomicU64,
+}
+
+fn now() -> u64 {
+    RealTimeCoarseClock::get().read_time().as_secs()
+}
+
+impl SharedMemory {
+    pub(super) fn new(
+        key: IpcKey,
+        size: usize,
+        mode: u16,
+        credentials: &Credentials<ReadOp>,
+        creator_pid: Pid,
+    ) -> Result<Self> {
+        if !(SHMMIN..=SHMMAX).contains(&size) {
+            return_errno_with_message!(Errno::EINVAL, "the shared memory size is out of range");
+        }
+        let vmo = VmoOptions::new(size.align_up(PAGE_SIZE)).alloc()?;
+        Ok(Self {
+            permission: IpcPermission::new_sem_perm(
+                key,
+                credentials.euid(),
+                credentials.egid(),
+                mode,
+            ),
+            size,
+            weak_memory: Arc::downgrade(&vmo),
+            memory: Mutex::new(Some(vmo)),
+            destroyed: AtomicBool::new(false),
+            creator_pid,
+            last_pid: AtomicI32::new(0),
+            attach_time: AtomicU64::new(0),
+            detach_time: AtomicU64::new(0),
+            change_time: AtomicU64::new(now()),
+        })
+    }
+
+    pub(crate) fn permission(&self) -> &IpcPermission {
+        &self.permission
+    }
+
+    pub(crate) fn size(&self) -> usize {
+        self.size
+    }
+
+    pub(crate) fn is_destroyed(&self) -> bool {
+        self.destroyed.load(Ordering::Relaxed)
+    }
+
+    /// The memory to map, while anything can still map it.
+    pub(crate) fn memory(&self) -> Option<Arc<Vmo>> {
+        self.weak_memory.upgrade()
+    }
+
+    /// Whether `vmo` is this segment's memory.
+    pub(crate) fn is_memory(&self, vmo: &Arc<Vmo>) -> bool {
+        Weak::ptr_eq(&self.weak_memory, &Arc::downgrade(vmo))
+    }
+
+    /// The mappings of the segment (each holds the memory, as the namespace does until `IPC_RMID`).
+    pub(crate) fn attach_count(&self) -> usize {
+        let held = usize::from(!self.is_destroyed());
+        self.weak_memory.strong_count().saturating_sub(held)
+    }
+
+    /// Marks the segment destroyed; returns whether it is still attached.
+    pub(super) fn destroy(&self) -> bool {
+        self.destroyed.store(true, Ordering::Relaxed);
+        self.memory.lock().take();
+        self.change_time.store(now(), Ordering::Relaxed);
+        self.weak_memory.strong_count() > 0
+    }
+
+    pub(crate) fn note_attach(&self, pid: Pid) {
+        self.last_pid.store(pid as i32, Ordering::Relaxed);
+        self.attach_time.store(now(), Ordering::Relaxed);
+    }
+
+    pub(crate) fn note_detach(&self, pid: Pid) {
+        self.last_pid.store(pid as i32, Ordering::Relaxed);
+        self.detach_time.store(now(), Ordering::Relaxed);
+    }
+
+    pub(crate) fn shmid_ds(&self) -> ShmidDs {
+        let mut perm = self.permission.to_c();
+        // A destroyed segment has lost its key, as in Linux.
+        if self.is_destroyed() {
+            perm.key = super::IPC_PRIVATE.cast_unsigned();
+            perm.mode |= SHM_DEST;
+        }
+        ShmidDs {
+            shm_perm: perm,
+            shm_segsz: self.size as u64,
+            shm_atime: self.attach_time.load(Ordering::Relaxed),
+            shm_dtime: self.detach_time.load(Ordering::Relaxed),
+            shm_ctime: self.change_time.load(Ordering::Relaxed),
+            shm_cpid: self.creator_pid as i32,
+            shm_lpid: self.last_pid.load(Ordering::Relaxed),
+            shm_nattch: self.attach_count() as u64,
+            ..ShmidDs::default()
+        }
+    }
+}
