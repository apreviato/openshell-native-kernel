diff --git a/kernel/core/comps/framebuffer/src/splash.rs b/kernel/core/comps/framebuffer/src/splash.rs
new file mode 100644
index 0000000..7382759
--- /dev/null
+++ b/kernel/core/comps/framebuffer/src/splash.rs
@@ -0,0 +1,319 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The boot splash's bar, kept moving.
+//!
+//! The boot loader may leave a splash on the screen (OpenShell's GRUB draws
+//! one: the OPENSHELL wordmark over a 200x3 bar with a 60px segment in its
+//! middle, as Plymouth's first frame on OpenShell Live). On Live, Plymouth
+//! then moves the segment back and forth along the bar until the desktop's
+//! boot screen, which has the same bar, takes over. Here the kernel does it,
+//! from its start through unpacking the initramfs and the session's start,
+//! until a display server shows a frame with something on it (see
+//! `aster-simpledrm`), a console draws text, or a program draws on `/dev/fb0`
+//! ([`release`]).
+//!
+//! The splash is recognised on the screen, where the boot loader's stretch
+//! put it (the near-black around the bar, the bar, the brighter segment at
+//! its middle), so a screen without it is left as it is. The bar and the
+//! segment are taken from the screen as they were drawn, then the segment
+//! moves as Plymouth's script moves it: `(sin(frame / 12) + 1) / 2` of the
+//! way along the bar, 50 frames a second.
+
+use alloc::{sync::Arc, vec, vec::Vec};
+use core::{
+    ops::Range,
+    sync::atomic::{AtomicU8, AtomicU64, Ordering},
+};
+
+use ostd::{sync::SpinLock, timer::TIMER_FREQ};
+use spin::Once;
+
+use crate::{framebuffer::FrameBuffer, pixel::PixelFormat};
+
+// The splash's geometry on a 1920x1080 screen (OpenShell Live's Plymouth
+// theme; openshell-native distro/image/make-splash.py).
+const REFERENCE_WIDTH: usize = 1920;
+const REFERENCE_HEIGHT: usize = 1080;
+/// The bar's columns, its rounded ends included, and its rows.
+const BAR_X: Range<usize> = 860..1060;
+const BAR_Y: Range<usize> = 579..582;
+/// The segment's columns where the splash has it, in the bar's middle.
+const SEGMENT_X: Range<usize> = 930..990;
+/// Where the bar alone is, between its left end and the segment.
+const TRACK_X: usize = 900;
+/// Near-black around the bar: left and right of it, above it (under the
+/// wordmark) and under it (over the status line).
+const AROUND: [(usize, usize); 4] = [(820, 580), (1100, 580), (960, 569), (960, 589)];
+/// The splash's background, #050607.
+const BACKGROUND: [u8; 3] = [0x05, 0x06, 0x07];
+
+/// Plymouth's script moves the segment 50 times a second.
+const FRAMES_PER_SECOND: u64 = 50;
+/// `frame / 12` radians, in 1/65536 turns per frame: 65536 / (2 * pi * 12).
+const TURN_PER_FRAME: u64 = 869;
+
+const OFF: u8 = 0;
+const MOVING: u8 = 1;
+const RELEASED: u8 = 2;
+
+static STATE: AtomicU8 = AtomicU8::new(OFF);
+static TICKS: AtomicU64 = AtomicU64::new(0);
+static SPLASH: Once<SpinLock<Splash>> = Once::new();
+
+/// Looks for the boot splash on the screen and, where it is, keeps its bar
+/// moving.
+pub(crate) fn start(framebuffer: &Arc<FrameBuffer>) {
+    let Some(splash) = Splash::find(framebuffer) else {
+        return;
+    };
+    SPLASH.call_once(|| SpinLock::new(splash));
+    STATE.store(MOVING, Ordering::Release);
+    ostd::timer::register_callback_on_cpu(tick);
+    ostd::info!("the boot splash's bar moves until the session shows");
+}
+
+/// Whether the splash's bar is moving on the screen.
+pub fn is_moving() -> bool {
+    STATE.load(Ordering::Acquire) == MOVING
+}
+
+/// Stops moving the splash's bar: something else draws on the screen now.
+/// Returns whether it was moving. The screen keeps the last frame.
+pub fn release() -> bool {
+    if STATE
+        .compare_exchange(MOVING, RELEASED, Ordering::AcqRel, Ordering::Acquire)
+        .is_err()
+    {
+        return false;
+    }
+    // A frame being drawn right now ends first.
+    if let Some(splash) = SPLASH.get() {
+        drop(splash.disable_irq().lock());
+    }
+    true
+}
+
+fn tick() {
+    if STATE.load(Ordering::Relaxed) != MOVING {
+        return;
+    }
+    let ticks = TICKS.fetch_add(1, Ordering::Relaxed) + 1;
+    if ticks % (TIMER_FREQ / FRAMES_PER_SECOND).max(1) != 0 {
+        return;
+    }
+    let Some(splash) = SPLASH.get() else {
+        return;
+    };
+    // In the timer interrupt: a frame is skipped rather than waited for.
+    let Some(mut splash) = splash.try_lock() else {
+        return;
+    };
+    if STATE.load(Ordering::Acquire) == MOVING {
+        splash.next_frame();
+    }
+}
+
+struct Splash {
+    framebuffer: Arc<FrameBuffer>,
+    /// Bytes per pixel (4: the splash is only looked for at 32 bits).
+    bytes: usize,
+    /// The screen's rows the bar covers, with a row of its edge each side.
+    rows: Range<usize>,
+    /// The columns redrawn: the bar without its rounded ends.
+    span: Range<usize>,
+    /// One column of the bar alone, top to bottom over `rows`.
+    track: Vec<u8>,
+    /// The segment as drawn, row by row over `rows`, `segment_width` wide.
+    segment: Vec<u8>,
+    segment_width: usize,
+    /// The segment's left column at the bar's left end, and how far it goes.
+    first_column: usize,
+    travel: usize,
+    /// One row of `span`, composed before it is written.
+    line: Vec<u8>,
+    frame: u64,
+    drawn_at: Option<usize>,
+}
+
+impl core::fmt::Debug for Splash {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.debug_struct("Splash")
+            .field("rows", &self.rows)
+            .field("span", &self.span)
+            .field("segment_width", &self.segment_width)
+            .finish_non_exhaustive()
+    }
+}
+
+impl Splash {
+    /// The splash's bar as the boot loader drew it, if the screen has it.
+    fn find(framebuffer: &Arc<FrameBuffer>) -> Option<Self> {
+        if framebuffer.pixel_format() != PixelFormat::BgrReserved {
+            return None;
+        }
+        let bytes = 4;
+        let (width, height) = (framebuffer.width(), framebuffer.height());
+        // The boot loader stretches the 1920x1080 splash over the screen.
+        let x = |reference: usize| reference * width / REFERENCE_WIDTH;
+        let y = |reference: usize| reference * height / REFERENCE_HEIGHT;
+        if width < REFERENCE_WIDTH / 4 || height < REFERENCE_HEIGHT / 4 {
+            return None;
+        }
+        let pixel = |column: usize, row: usize| -> Option<[u8; 4]> {
+            let mut value = [0u8; 4];
+            framebuffer
+                .read_bytes_at(row * framebuffer.line_size() + column * bytes, &mut value)
+                .ok()?;
+            Some(value)
+        };
+        let brightest = |value: [u8; 4]| value[0].max(value[1]).max(value[2]);
+
+        let middle = y((BAR_Y.start + BAR_Y.end) / 2);
+        let background = pixel(x(AROUND[0].0), y(AROUND[0].1))?;
+        for (column, row) in AROUND {
+            if pixel(x(column), y(row))? != background {
+                return None;
+            }
+        }
+        // #050607, in either byte order.
+        let near = |a: u8, b: u8| a.abs_diff(b) <= 4;
+        if !(near(background[1], BACKGROUND[1])
+            && near(background[0].min(background[2]), BACKGROUND[0])
+            && near(background[0].max(background[2]), BACKGROUND[2]))
+        {
+            return None;
+        }
+        let track = pixel(x(TRACK_X), middle)?;
+        let segment = pixel(x((SEGMENT_X.start + SEGMENT_X.end) / 2), middle)?;
+        if brightest(track) < brightest(background) + 8
+            || brightest(segment) < brightest(track) + 64
+        {
+            return None;
+        }
+
+        // The rows with the bar, its blended edges included.
+        let top = y(BAR_Y.start).saturating_sub(1);
+        let bottom = ((BAR_Y.end * height).div_ceil(REFERENCE_HEIGHT) + 1).min(height);
+        let rows = top..bottom;
+        let span = (x(BAR_X.start) + 2)..x(BAR_X.end - 1).saturating_sub(1);
+        let first_segment_column = x(SEGMENT_X.start).saturating_sub(1);
+        let segment_end = ((SEGMENT_X.end * width).div_ceil(REFERENCE_WIDTH) + 1).min(width);
+        let segment_width = segment_end.checked_sub(first_segment_column)?;
+        if span.is_empty() || rows.is_empty() || segment_width > span.len() {
+            return None;
+        }
+
+        let mut track_column = vec![0u8; rows.len() * bytes];
+        for (index, row) in rows.clone().enumerate() {
+            let value = pixel(x(TRACK_X), row)?;
+            track_column[index * bytes..(index + 1) * bytes].copy_from_slice(&value);
+        }
+        let mut segment_pixels = vec![0u8; rows.len() * segment_width * bytes];
+        for (index, row) in rows.clone().enumerate() {
+            let start = index * segment_width * bytes;
+            framebuffer
+                .read_bytes_at(
+                    row * framebuffer.line_size() + first_segment_column * bytes,
+                    &mut segment_pixels[start..start + segment_width * bytes],
+                )
+                .ok()?;
+        }
+
+        // Plymouth's segment goes from the bar's left end to its right end.
+        let first_column = x(BAR_X.start).saturating_sub(1);
+        let last_column = x(BAR_X.end) + 1;
+        let travel = last_column.checked_sub(first_column + segment_width)?;
+
+        Some(Self {
+            framebuffer: framebuffer.clone(),
+            bytes,
+            rows,
+            line: vec![0u8; span.len() * bytes],
+            span,
+            track: track_column,
+            segment: segment_pixels,
+            segment_width,
+            first_column,
+            travel,
+            frame: 0,
+            drawn_at: None,
+        })
+    }
+
+    fn next_frame(&mut self) {
+        self.frame += 1;
+        let along = position((self.frame * TURN_PER_FRAME) as u32);
+        let left = self.first_column + (self.travel * along as usize >> 16);
+        if self.drawn_at == Some(left) {
+            return;
+        }
+        self.drawn_at = Some(left);
+
+        let bytes = self.bytes;
+        let line_size = self.framebuffer.line_size();
+        for (index, row) in self.rows.clone().enumerate() {
+            let track = &self.track[index * bytes..(index + 1) * bytes];
+            let segment_row = &self.segment
+                [index * self.segment_width * bytes..(index + 1) * self.segment_width * bytes];
+            for (offset, column) in self.span.clone().enumerate() {
+                let source = if column >= left && column < left + self.segment_width {
+                    let at = (column - left) * bytes;
+                    &segment_row[at..at + bytes]
+                } else {
+                    track
+                };
+                self.line[offset * bytes..(offset + 1) * bytes].copy_from_slice(source);
+            }
+            let _ = self
+                .framebuffer
+                .write_bytes_at(row * line_size + self.span.start * bytes, &self.line);
+        }
+    }
+}
+
+/// `(sin(turn) + 1) / 2` in 1/65536ths (0 to 65536), `turn` in 1/65536 turns.
+fn position(turn: u32) -> u32 {
+    // sin(k * pi / 128) for k in 0..=64, in 1/65536ths.
+    const QUARTER: [i32; 65] = [
+        0, 1608, 3216, 4821, 6424, 8022, 9616, 11204, 12785, 14359, 15924, 17479, 19024, 20557,
+        22078, 23586, 25080, 26558, 28020, 29466, 30893, 32303, 33692, 35062, 36410, 37736, 39040,
+        40320, 41576, 42806, 44011, 45190, 46341, 47464, 48559, 49624, 50660, 51665, 52639, 53581,
+        54491, 55368, 56212, 57022, 57798, 58538, 59244, 59914, 60547, 61145, 61705, 62228, 62714,
+        63162, 63572, 63944, 64277, 64571, 64827, 65043, 65220, 65358, 65457, 65516, 65536,
+    ];
+    let turn = turn & 0xFFFF;
+    let quadrant = turn >> 14;
+    let within = turn & 0x3FFF;
+    let angle = if quadrant & 1 == 0 {
+        within
+    } else {
+        0x4000 - within
+    };
+    let index = (angle >> 8) as usize;
+    let fraction = (angle & 0xFF) as i32;
+    let sine = if index >= 64 {
+        QUARTER[64]
+    } else {
+        QUARTER[index] + ((QUARTER[index + 1] - QUARTER[index]) * fraction >> 8)
+    };
+    let sine = if quadrant >= 2 { -sine } else { sine };
+    ((sine + 65536) / 2) as u32
+}
