+    fn position_follows_the_sine() {
+        assert_eq!(position(0), 32768);
+        assert_eq!(position(0x4000), 65536);
+        assert_eq!(position(0x8000), 32768);
+        assert_eq!(position(0xC000), 0);
+        // sin(30 degrees) = 0.5: three quarters of the way.
+        let thirty = position(65536 / 12);
+        assert!(thirty.abs_diff(49152) < 64, "{thirty}");
+    }
