+/// Parses the single line of an identity ID map: `<inside> <outside> <count>`.
+fn parse_id_map(text: &str) -> Result<IdRange> {
+    let invalid = || Error::with_message(Errno::EINVAL, "invalid ID map");
+
+    let mut lines = text.lines();
+    let line = lines.next().ok_or_else(invalid)?;
+    if lines.next().is_some() {
+        // Maps with several extents are not supported.
+        return Err(invalid());
+    }
+
+    let mut fields = line.split_ascii_whitespace();
+    let mut next_field = || -> Result<u32> {
+        fields
+            .next()
+            .and_then(|field| field.parse::<u32>().ok())
+            .ok_or_else(invalid)
+    };
+    let inside = next_field()?;
+    let outside = next_field()?;
+    let count = next_field()?;
+    if fields.next().is_some() || count == 0 {
+        return Err(invalid());
     }
+    // The range must not wrap or include the invalid ID.
+    if inside.checked_add(count).is_none() {
+        return Err(invalid());
+    }
+    if inside != outside {
+        return_errno_with_message!(
+            Errno::EINVAL,
+            "only identity ID maps are supported"
+        );
+    }
