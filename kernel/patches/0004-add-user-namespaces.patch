new file mode 100755
--- /dev/null
+++ b/kernel/core/src/fs/fs_impls/procfs/pid/task/setgroups.rs
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: MPL-2.0
+
+use aster_util::printer::VmPrinter;
+
+use super::{TidDirOps, uid_map::user_ns_of};
+use crate::{
+    fs::{
+        file::mkmod,
+        procfs::template::{ProcFile, ProcFileOps},
+        vfs::inode::Inode,
+    },
+    prelude::*,
+    process::posix_thread::AsPosixThread,
+    thread::Thread,
+};
+
+/// The longest accepted setting: `"allow\n"`.
+const MAX_SETTING_LEN: usize = 8;
+
+/// Represents the inode at `/proc/[pid]/task/[tid]/setgroups` (and also `/proc/[pid]/setgroups`).
+pub(super) struct SetgroupsFileOps(TidDirOps);
+
+impl SetgroupsFileOps {
+    pub(super) fn new_inode(dir: &TidDirOps, parent: Weak<dyn Inode>) -> Arc<dyn Inode> {
+        // Reference: <https://elixir.bootlin.com/linux/v6.16.5/source/fs/proc/base.c#L3405>
+        ProcFile::new(Self(dir.clone()), parent, mkmod!(a+r, u+w))
+    }
+}
+
+impl ProcFileOps for SetgroupsFileOps {
+    fn owner_thread(&self) -> Option<Arc<Thread>> {
+        self.0.thread()
+    }
+
+    fn read_at(&self, offset: usize, writer: &mut VmWriter) -> Result<usize> {
+        let mut printer = VmPrinter::new_skip(writer, offset);
+
+        let setting = if user_ns_of(&self.0)?.is_setgroups_denied() {
+            "deny"
+        } else {
+            "allow"
+        };
+        writeln!(printer, "{}", setting)?;
+
+        Ok(printer.bytes_written())
+    }
+
+    fn write_at(&self, offset: usize, reader: &mut VmReader) -> Result<usize> {
+        if offset != 0 {
+            return_errno_with_message!(Errno::EINVAL, "the setting must be written at once");
+        }
+        let (text, read_bytes) = reader.read_cstring_until_end(MAX_SETTING_LEN)?;
+        if reader.has_remain() {
+            return_errno_with_message!(Errno::EINVAL, "invalid setgroups setting");
+        }
+        let Ok(text) = text.to_str() else {
+            return_errno_with_message!(Errno::EINVAL, "invalid setgroups setting");
+        };
+
+        let current_thread = current_thread!();
+        let writer = current_thread.as_posix_thread().unwrap();
+        user_ns_of(&self.0)?.write_setgroups(text, writer)?;
+
+        Ok(read_bytes)
+    }
+}
