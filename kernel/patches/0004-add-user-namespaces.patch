+
+/// Returns the user namespace of the thread that the directory describes.
+pub(super) fn user_ns_of(dir: &TidDirOps) -> Result<Arc<UserNamespace>> {
+    let Some(thread) = dir.thread() else {
+        return_errno_with_message!(Errno::ESRCH, "the thread does not exist");
+    };
+    Ok(thread.as_posix_thread().unwrap().user_ns())
+}
+
+pub(super) fn read_id_map(
+    dir: &TidDirOps,
+    kind: IdKind,
+    offset: usize,
+    writer: &mut VmWriter,
+) -> Result<usize> {
+    let mut printer = VmPrinter::new_skip(writer, offset);
+
+    // A namespace without a map shows an empty file.
+    if let Some((inside, outside, count)) = user_ns_of(dir)?.id_map(kind) {
+        writeln!(printer, "{:>10} {:>10} {:>10}", inside, outside, count)?;
+    }
+
+    Ok(printer.bytes_written())
+}
+
+pub(super) fn write_id_map(
+    dir: &TidDirOps,
+    kind: IdKind,
+    offset: usize,
+    reader: &mut VmReader,
+) -> Result<usize> {
+    if offset != 0 {
+        return_errno_with_message!(Errno::EINVAL, "an ID map must be written at once");
+    }
+    let (text, read_bytes) = reader.read_cstring_until_end(MAX_ID_MAP_LEN)?;
+    if reader.has_remain() {
+        return_errno_with_message!(Errno::EINVAL, "the ID map is too long");
     }
+    let Ok(text) = text.to_str() else {
+        return_errno_with_message!(Errno::EINVAL, "the ID map is not valid text");
+    };
+
+    let current_thread = current_thread!();
+    let writer = current_thread.as_posix_thread().unwrap();
+    user_ns_of(dir)?.write_id_map(kind, text, writer)?;
+
+    Ok(read_bytes)
 }
