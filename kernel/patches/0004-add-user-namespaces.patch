+    if uids.iter().flatten().any(|uid| !user_ns.maps_uid(*uid)) {
+        return_errno_with_message!(
+            Errno::EINVAL,
+            "the UID is not mapped in the user namespace"
+        );
+    }
+    Ok(())
+}
