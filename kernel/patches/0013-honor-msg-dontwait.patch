diff --git a/kernel/core/src/net/socket/mod.rs b/kernel/core/src/net/socket/mod.rs
--- a/kernel/core/src/net/socket/mod.rs
+++ b/kernel/core/src/net/socket/mod.rs
@@ -68,6 +68,28 @@ mod private {
             }
         }
 
+        /// Runs `try_op` like [`Self::block_on`], but returns at once when `dont_wait` is set.
+        ///
+        /// Send and receive operations pass `MSG_DONTWAIT` here, which makes a single
+        /// call non-blocking regardless of the file status flags.
+        fn block_on_unless<F, R>(
+            &self,
+            events: IoEvents,
+            timeout: Option<Duration>,
+            dont_wait: bool,
+            mut try_op: F,
+        ) -> Result<R>
+        where
+            Self: Sized,
+            F: FnMut() -> Result<R>,
+        {
+            if dont_wait {
+                try_op()
+            } else {
+                self.block_on(events, timeout, try_op)
+            }
+        }
+
         /// Handles commands specific to its protocol or socket type.
         fn protocol_ioctl(&self, _raw_ioctl: RawIoctl) -> Result<i32> {
             return_errno_with_message!(Errno::ENOTTY, "the socket ioctl command is unknown");
