--- /dev/null
+++ b/kernel/comps/bluetooth/src/proto.rs
@@ -0,0 +1,1034 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The data sockets of `AF_BLUETOOTH`: L2CAP (`BTPROTO_L2CAP`), RFCOMM
+//! (`BTPROTO_RFCOMM`) and SCO (`BTPROTO_SCO`), the kernel's side. A socket
+//! is bound to an address of its protocol (a PSM or a fixed channel, an
+//! RFCOMM channel, a controller's address) and listens there, or connects
+//! to a device; its options are Linux's (`SOL_BLUETOOTH`, `SOL_L2CAP`,
+//! `SOL_RFCOMM`, `SOL_SCO`), as the program's bytes. The kernel's socket
+//! file (in `aster-core`) does the waiting.
+//!
+//! bluetoothd listens on these for each adapter (its SDP server, GATT's ATT
+//! channel, the profiles' PSMs), and so do the audio servers (SCO). An
+//! L2CAP socket that connects, or that a listener accepts, carries a
+//! channel (`l2cap`) on a link to the device (`link`).
+
+use alloc::{collections::VecDeque, sync::{Arc, Weak}, vec, vec::Vec};
+
+use ostd::sync::{LocalIrqDisabled, SpinLock};
+
+/// Linux's errno values.
+mod errno {
+    pub(super) const EAGAIN: i32 = 11;
+    pub(super) const EPIPE: i32 = 32;
+    pub(super) const EALREADY: i32 = 114;
+    pub(super) const EINPROGRESS: i32 = 115;
+    pub(super) const EISCONN: i32 = 106;
+    pub(super) const EOPNOTSUPP: i32 = 95;
+    pub(super) const EACCES: i32 = 13;
+    pub(super) const EINVAL: i32 = 22;
+    pub(super) const ENOPROTOOPT: i32 = 92;
+    pub(super) const EADDRINUSE: i32 = 98;
+    pub(super) const ENOTCONN: i32 = 107;
+    pub(super) const EBADFD: i32 = 77;
+}
+use errno::*;
+
+/// The protocols (`BTPROTO_*`).
+pub const BTPROTO_L2CAP: i32 = 0;
+pub const BTPROTO_SCO: i32 = 2;
+pub const BTPROTO_RFCOMM: i32 = 3;
+
+/// Option levels.
+pub const SOL_BLUETOOTH: i32 = 274;
+pub const SOL_L2CAP: i32 = 6;
+pub const SOL_SCO: i32 = 17;
+pub const SOL_RFCOMM: i32 = 18;
+
+/// `SOL_BLUETOOTH` options.
+const BT_SECURITY: i32 = 4;
+const BT_DEFER_SETUP: i32 = 7;
+const BT_FLUSHABLE: i32 = 8;
+const BT_POWER: i32 = 9;
+const BT_CHANNEL_POLICY: i32 = 10;
+const BT_VOICE: i32 = 11;
+const BT_SNDMTU: i32 = 12;
+const BT_RCVMTU: i32 = 13;
+const BT_PHY: i32 = 14;
+const BT_MODE: i32 = 15;
+const BT_PKT_STATUS: i32 = 16;
+
+/// `SOL_L2CAP`, `SOL_RFCOMM` and `SOL_SCO` options.
+const L2CAP_OPTIONS: i32 = 1;
+const L2CAP_CONNINFO: i32 = 2;
+const L2CAP_LM: i32 = 3;
+const RFCOMM_CONNINFO: i32 = 2;
+const RFCOMM_LM: i32 = 3;
+const SCO_OPTIONS: i32 = 1;
+const SCO_CONNINFO: i32 = 2;
+
+/// Link modes (`L2CAP_LM_*`, `RFCOMM_LM_*`: the same bits).
+const LM_AUTH: u32 = 0x02;
+const LM_ENCRYPT: u32 = 0x04;
+const LM_SECURE: u32 = 0x20;
+/// Security levels (`BT_SECURITY_*`).
+const SECURITY_SDP: u8 = 0;
+const SECURITY_LOW: u8 = 1;
+const SECURITY_MEDIUM: u8 = 2;
+const SECURITY_HIGH: u8 = 3;
+const SECURITY_FIPS: u8 = 4;
+
+/// Address types (`BDADDR_*`).
+pub const BDADDR_BREDR: u8 = 0;
+pub const BDADDR_LE_PUBLIC: u8 = 1;
+pub const BDADDR_LE_RANDOM: u8 = 2;
+
+/// How long a connection may take unless the program says
+/// (`SO_SNDTIMEO`; Linux's `L2CAP_CONN_TIMEOUT`).
+const CONNECT_TIMEOUT_MS: u64 = 40_000;
+const ETIMEDOUT: i32 = 110;
+
+/// L2CAP's fixed channel for ATT, PSMs from which programs may bind
+/// without `CAP_NET_BIND_SERVICE`, and its default MTU.
+const L2CAP_CID_ATT: u16 = 0x0004;
+const L2CAP_PSM_DYN_START: u16 = 0x1001;
+const L2CAP_PSM_LE_DYN_START: u16 = 0x0080;
+const L2CAP_DEFAULT_MTU: u16 = 672;
+const L2CAP_LE_MIN_MTU: u16 = 23;
+const RFCOMM_MAX_CHANNEL: u8 = 30;
+
+/// `SOCK_*` types.
+pub const SOCK_STREAM: u8 = 1;
+pub const SOCK_DGRAM: u8 = 2;
+pub const SOCK_RAW: u8 = 3;
+pub const SOCK_SEQPACKET: u8 = 5;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Protocol {
+    L2cap,
+    Rfcomm,
+    Sco,
+}
+
+impl Protocol {
+    pub fn from_raw(protocol: i32) -> Option<Self> {
+        match protocol {
+            BTPROTO_L2CAP => Some(Self::L2cap),
+            BTPROTO_RFCOMM => Some(Self::Rfcomm),
+            BTPROTO_SCO => Some(Self::Sco),
+            _ => None,
+        }
+    }
+
+    /// Whether the socket type goes with the protocol, as Linux has them.
+    pub fn takes_type(self, socket_type: u8) -> bool {
+        match self {
+            Self::L2cap => matches!(socket_type, SOCK_SEQPACKET | SOCK_STREAM | SOCK_DGRAM | SOCK_RAW),
+            Self::Rfcomm => matches!(socket_type, SOCK_STREAM | SOCK_RAW),
+            Self::Sco => socket_type == SOCK_SEQPACKET,
+        }
+    }
+
+    /// The levels its options are at.
+    pub fn option_level(self, level: i32) -> bool {
+        level == SOL_BLUETOOTH
+            || match self {
+                Self::L2cap => level == SOL_L2CAP,
+                Self::Rfcomm => level == SOL_RFCOMM,
+                Self::Sco => level == SOL_SCO,
+            }
+    }
+}
+
+/// What a socket is bound or connected to.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Address {
+    pub address: [u8; 6],
+    pub address_type: u8,
+    /// L2CAP's PSM, or its fixed channel.
+    pub psm: u16,
+    pub cid: u16,
+    /// RFCOMM's channel.
+    pub channel: u8,
+}
+
+impl Address {
+    fn is_le(&self) -> bool {
+        matches!(self.address_type, BDADDR_LE_PUBLIC | BDADDR_LE_RANDOM)
+    }
+
+    /// The socket address in Linux's layout (`sockaddr_l2`, `sockaddr_rc`,
+    /// `sockaddr_sco`), with its family.
+    pub fn to_bytes(&self, protocol: Protocol) -> Vec<u8> {
+        let mut bytes = Vec::with_capacity(14);
+        bytes.extend_from_slice(&AF_BLUETOOTH.to_ne_bytes());
+        match protocol {
+            Protocol::L2cap => {
+                bytes.extend_from_slice(&self.psm.to_le_bytes());
+                bytes.extend_from_slice(&self.address);
+                bytes.extend_from_slice(&self.cid.to_le_bytes());
+                bytes.push(self.address_type);
+                bytes.push(0);
+            }
+            Protocol::Rfcomm => {
+                bytes.extend_from_slice(&self.address);
+                bytes.push(self.channel);
+                bytes.push(0);
+            }
+            Protocol::Sco => bytes.extend_from_slice(&self.address),
+        }
+        bytes
+    }
+
+    /// Reads a socket address as Linux does: what is missing is zero.
+    pub fn from_bytes(protocol: Protocol, bytes: &[u8]) -> Self {
+        let mut raw = [0u8; 16];
+        let length = bytes.len().min(raw.len());
+        raw[..length].copy_from_slice(&bytes[..length]);
+        let address = |at: usize| -> [u8; 6] { raw[at..at + 6].try_into().unwrap() };
+        match protocol {
+            Protocol::L2cap => Self {
+                psm: u16::from_le_bytes([raw[2], raw[3]]),
+                address: address(4),
+                cid: u16::from_le_bytes([raw[10], raw[11]]),
+                address_type: raw[12],
+                channel: 0,
+            },
+            Protocol::Rfcomm => Self { address: address(2), channel: raw[8], ..Default::default() },
+            Protocol::Sco => Self { address: address(2), ..Default::default() },
+        }
+    }
+}
+
+const AF_BLUETOOTH: u16 = 31;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Phase {
+    Open,
+    Bound,
+    Listening,
+    Connecting,
+    Connected,
+    /// The program shut it for writing: it closes once the device answers.
+    Disconnecting,
+    Closed,
+}
+
+pub(crate) struct State {
+    pub(crate) phase: Phase,
+    pub(crate) local: Address,
+    /// The device, once connecting.
+    pub(crate) peer: Address,
+    backlog: usize,
+    /// Connections waiting for `accept`.
+    pub(crate) queue: VecDeque<Arc<ProtoSocket>>,
+    /// The channel to the device.
+    pub(crate) channel: Option<crate::l2cap::Channel>,
+    /// RFCOMM's channel: its session, its DLCI.
+    pub(crate) rfcomm: Option<crate::rfcomm::DlcRef>,
+    /// What came from the device, to be read.
+    pub(crate) rx: VecDeque<Vec<u8>>,
+    /// Why the connection failed or ended (`SO_ERROR`).
+    pub(crate) error: Option<i32>,
+    /// An accepted connection the program has yet to take (`BT_DEFER_SETUP`):
+    /// its first read lets it be set up.
+    pub(crate) deferred: bool,
+    pub(crate) security: u8,
+    pub(crate) key_size: u8,
+    pub(crate) defer_setup: bool,
+    flushable: bool,
+    force_active: bool,
+    channel_policy: u32,
+    /// L2CAP's options (`struct l2cap_options`).
+    pub(crate) imtu: u16,
+    pub(crate) omtu: u16,
+    flush_to: u16,
+    mode: u8,
+    fcs: u8,
+    max_tx: u8,
+    txwin_size: u16,
+    link_mode: u32,
+    /// SCO's voice setting and packet status, and its link.
+    pub(crate) voice: u16,
+    pkt_status: bool,
+    pub(crate) sco: Option<crate::sco::Sco>,
+    /// How long a connection may take (none: as long as it takes), and
+    /// when the one being made fails.
+    connect_timeout_ms: Option<u64>,
+    deadline: Option<u64>,
+    /// The program shut it for reading (`SHUT_RD`).
+    read_shut: bool,
+}
+
+pub struct ProtoSocket {
+    pub(crate) protocol: Protocol,
+    socket_type: u8,
+    pub(crate) state: SpinLock<State, LocalIrqDisabled>,
+    /// Tells the socket file its events changed.
+    notify: SpinLock<Option<Arc<dyn Fn() + Send + Sync>>, LocalIrqDisabled>,
+}
+
+static SOCKETS: SpinLock<Vec<Weak<ProtoSocket>>, LocalIrqDisabled> = SpinLock::new(Vec::new());
+/// Binding and listening take addresses one socket at a time.
+static BINDING: SpinLock<(), LocalIrqDisabled> = SpinLock::new(());
+
+pub(crate) fn sockets() -> Vec<Arc<ProtoSocket>> {
+    SOCKETS.lock().iter().filter_map(Weak::upgrade).collect()
+}
+
+/// The shared handle of a socket.
+pub(crate) fn arc_of(socket: &ProtoSocket) -> Option<Arc<ProtoSocket>> {
+    SOCKETS.lock().iter().filter_map(Weak::upgrade).find(|other| core::ptr::eq(other.as_ref(), socket))
+}
+
+/// Events of a socket for its file.
+pub mod events {
+    pub const IN: u32 = 0x1;
+    pub const OUT: u32 = 0x4;
+    pub const ERR: u32 = 0x8;
+    pub const HUP: u32 = 0x10;
+}
+
+impl ProtoSocket {
+    pub fn new(protocol: Protocol, socket_type: u8) -> Arc<Self> {
+        let socket = Arc::new(Self {
+            protocol,
+            socket_type,
+            state: SpinLock::new(State {
+                phase: Phase::Open,
+                local: Address::default(),
+                peer: Address::default(),
+                backlog: 0,
+                queue: VecDeque::new(),
+                channel: None,
+                rfcomm: None,
+                rx: VecDeque::new(),
+                error: None,
+                deferred: false,
+                security: SECURITY_LOW,
+                key_size: 0,
+                defer_setup: false,
+                flushable: false,
+                force_active: true,
+                channel_policy: 0,
+                imtu: L2CAP_DEFAULT_MTU,
+                omtu: 0,
+                flush_to: 0xffff,
+                mode: 0,
+                fcs: 1,
+                max_tx: 3,
+                txwin_size: 63,
+                link_mode: 0,
+                voice: 0x0060,
+                pkt_status: false,
+                sco: None,
+                connect_timeout_ms: Some(CONNECT_TIMEOUT_MS),
+                deadline: None,
+                read_shut: false,
+            }),
+            notify: SpinLock::new(None),
+        });
+        let mut all = SOCKETS.lock();
+        all.retain(|socket| socket.strong_count() > 0);
+        all.push(Arc::downgrade(&socket));
+        socket
+    }
+
+    pub fn protocol(&self) -> Protocol {
+        self.protocol
+    }
+
+    /// A stream (`SOCK_STREAM`): its bytes are read as they fit.
+    pub fn is_stream(&self) -> bool {
+        self.socket_type == SOCK_STREAM
+    }
+
+    /// The channel closes, waiting for the device's answer as long as a
+    /// connection may take.
+    pub(crate) fn start_disconnecting(&self) {
+        let mut state = self.state.lock();
+        state.phase = Phase::Disconnecting;
+        state.deadline = state.connect_timeout_ms.map(|timeout| crate::now_ms() + timeout);
+        drop(state);
+        crate::wake();
+    }
+
+    /// How long a connection may take (`SO_SNDTIMEO`; none: no limit).
+    pub fn set_connect_timeout(&self, timeout_ms: Option<u64>) {
+        self.state.lock().connect_timeout_ms = timeout_ms;
+    }
+
+    /// What tells the socket's file that its events changed.
+    pub fn set_notify(&self, notify: Arc<dyn Fn() + Send + Sync>) {
+        *self.notify.lock() = Some(notify);
+    }
+
+    pub(crate) fn wake(&self) {
+        let notify = self.notify.lock().clone();
+        if let Some(notify) = notify {
+            notify();
+        }
+    }
+
+    /// A connection a listener accepts: a socket like it, with its options.
+    pub(crate) fn child(&self) -> Arc<ProtoSocket> {
+        let child = Self::new(self.protocol, self.socket_type);
+        {
+            let parent = self.state.lock();
+            let mut state = child.state.lock();
+            state.local = parent.local;
+            state.security = parent.security;
+            state.defer_setup = parent.defer_setup;
+            state.imtu = parent.imtu;
+            state.flushable = parent.flushable;
+            state.link_mode = parent.link_mode;
+            state.mode = parent.mode;
+            state.phase = Phase::Connecting;
+        }
+        child
+    }
+
+    /// Hands an accepted connection to the listener's queue.
+    pub(crate) fn offer(&self, child: Arc<ProtoSocket>) -> bool {
+        {
+            let mut state = self.state.lock();
+            if state.phase != Phase::Listening || state.queue.len() >= state.backlog.max(1) {
+                return false;
+            }
+            state.queue.push_back(child);
+        }
+        self.wake();
+        true
+    }
+
+    /// Binds the socket. `privileged`: the program may take well-known
+    /// PSMs and channels (`CAP_NET_BIND_SERVICE`). `Err` is Linux's errno.
+    pub fn bind(&self, bytes: &[u8], privileged: bool) -> Result<(), i32> {
+        let mut address = Address::from_bytes(self.protocol, bytes);
+        if bytes.len() < 2 || u16::from_ne_bytes([bytes[0], bytes[1]]) != AF_BLUETOOTH {
+            return Err(EINVAL);
+        }
+        match self.protocol {
+            Protocol::L2cap => {
+                if address.psm != 0 && address.cid != 0 {
+                    return Err(EINVAL);
+                }
+                if address.address_type > BDADDR_LE_RANDOM {
+                    return Err(EINVAL);
+                }
+                if address.is_le() {
+                    // Only the ATT channel is a program's on LE.
+                    if address.cid != 0 && address.cid != L2CAP_CID_ATT {
+                        return Err(EINVAL);
+                    }
+                }
+                if address.psm != 0 {
+                    let psm = address.psm;
+                    if !address.is_le() && psm & 0x0101 != 0x0001 {
+                        return Err(EINVAL);
+                    }
+                    let dynamic = if address.is_le() { L2CAP_PSM_LE_DYN_START } else { L2CAP_PSM_DYN_START };
+                    if psm < dynamic && !privileged {
+                        return Err(EACCES);
+                    }
+                }
+            }
+            Protocol::Rfcomm => {
+                if address.channel > RFCOMM_MAX_CHANNEL {
+                    return Err(EINVAL);
+                }
+            }
+            Protocol::Sco => {}
+        }
+        // One socket at a time on a PSM, channel or SCO address.
+        let _binding = BINDING.lock();
+        if self.state.lock().phase != Phase::Open {
+            return Err(EBADFD);
+        }
+        let others: Vec<_> = sockets().into_iter().filter(|other| !core::ptr::eq(other.as_ref(), self)).collect();
+        if self.protocol == Protocol::L2cap && address.psm == 0 && address.cid == 0 {
+            // A free dynamic PSM.
+            let start = if address.is_le() { L2CAP_PSM_LE_DYN_START } else { L2CAP_PSM_DYN_START };
+            let step = if address.is_le() { 1 } else { 2 };
+            address.psm = (start..=0x10ff)
+                .step_by(step)
+                .find(|psm| !others.iter().any(|other| other.collides(&Address { psm: *psm, ..address }, false)))
+                .ok_or(EINVAL)?;
+        } else if others.iter().any(|other| other.collides(&address, false)) {
+            return Err(EADDRINUSE);
+        }
+        let mut state = self.state.lock();
+        state.local = address;
+        if self.protocol == Protocol::L2cap && address.is_le() {
+            state.imtu = L2CAP_LE_MIN_MTU.max(state.imtu.min(L2CAP_DEFAULT_MTU));
+        }
+        state.phase = Phase::Bound;
+        Ok(())
+    }
+
+    /// Whether this socket holds `address` already (bound, or listening if
+    /// `listening`).
+    fn collides(&self, address: &Address, listening: bool) -> bool {
+        let state = self.state.lock();
+        let held = match state.phase {
+            Phase::Bound => !listening,
+            Phase::Listening => true,
+            _ => false,
+        };
+        if !held || state.local.address != address.address {
+            return false;
+        }
+        match self.protocol {
+            Protocol::L2cap => {
+                state.local.psm != 0
+                    && state.local.psm == address.psm
+                    && state.local.is_le() == address.is_le()
+            }
+            Protocol::Rfcomm => state.local.channel != 0 && state.local.channel == address.channel,
+            Protocol::Sco => listening,
+        }
+    }
+
+    pub fn listen(&self, backlog: usize) -> Result<(), i32> {
+        self.listen_bound(backlog)?;
+        // RFCOMM's channels: the devices' sessions come to PSM 3.
+        if self.protocol == Protocol::Rfcomm {
+            crate::rfcomm::listen();
+        }
+        Ok(())
+    }
+
+    fn listen_bound(&self, backlog: usize) -> Result<(), i32> {
+        let _binding = BINDING.lock();
+        let all: Vec<_> = sockets().into_iter().filter(|other| !core::ptr::eq(other.as_ref(), self)).collect();
+        let mut state = self.state.lock();
+        if state.phase == Phase::Listening {
+            state.backlog = backlog;
+            return Ok(());
+        }
+        if state.phase != Phase::Bound {
+            return Err(EBADFD);
+        }
+        match self.protocol {
+            Protocol::L2cap => {
+                if !matches!(self.socket_type, SOCK_SEQPACKET | SOCK_STREAM) {
+                    return Err(EINVAL);
+                }
+                if state.local.psm == 0 && state.local.cid == 0 {
+                    return Err(EINVAL);
+                }
+            }
+            Protocol::Rfcomm => {
+                if state.local.channel == 0 {
+                    // The first free channel.
+                    let local = state.local;
+                    drop(state);
+                    let channel = (1..=RFCOMM_MAX_CHANNEL)
+                        .find(|channel| {
+                            !all.iter().any(|other| other.collides(&Address { channel: *channel, ..local }, false))
+                        })
+                        .ok_or(EINVAL)?;
+                    state = self.state.lock();
+                    state.local.channel = channel;
+                }
+            }
+            Protocol::Sco => {
+                let local = state.local;
+                drop(state);
+                if all.iter().any(|other| other.collides(&local, true)) {
+                    return Err(EADDRINUSE);
+                }
+                state = self.state.lock();
+            }
+        }
+        state.backlog = backlog.max(1);
+        state.phase = Phase::Listening;
+        Ok(())
+    }
+
+    /// A connection waiting for the program, or `EAGAIN`.
+    pub fn accept(&self) -> Result<Arc<ProtoSocket>, i32> {
+        let mut state = self.state.lock();
+        if state.phase != Phase::Listening {
+            return Err(EINVAL);
+        }
+        state.queue.pop_front().ok_or(EAGAIN)
+    }
+
+    /// Connects to a device: `EINPROGRESS` while the link and the channel
+    /// are made ([`Self::connect_result`] says how it went).
+    pub fn connect(&self, bytes: &[u8]) -> Result<(), i32> {
+        if bytes.len() < 2 || u16::from_ne_bytes([bytes[0], bytes[1]]) != AF_BLUETOOTH {
+            return Err(EINVAL);
+        }
+        let peer = Address::from_bytes(self.protocol, bytes);
+        {
+            let mut state = self.state.lock();
+            match state.phase {
+                Phase::Listening | Phase::Closed => return Err(EBADFD),
+                Phase::Connecting => return Err(EALREADY),
+                Phase::Connected | Phase::Disconnecting => return Err(EISCONN),
+                Phase::Open | Phase::Bound => {}
+            }
+            match self.protocol {
+                Protocol::Sco => {}
+                Protocol::Rfcomm => {
+                    if peer.channel == 0 || peer.channel > RFCOMM_MAX_CHANNEL {
+                        return Err(EINVAL);
+                    }
+                }
+                Protocol::L2cap => {
+                    if peer.is_le() && peer.cid != L2CAP_CID_ATT {
+                        // LE credit-based channels are not made yet.
+                        return Err(EOPNOTSUPP);
+                    }
+                    if !peer.is_le() && peer.psm == 0 {
+                        return Err(EINVAL);
+                    }
+                }
+            }
+            state.peer = peer;
+            state.error = None;
+            state.phase = Phase::Connecting;
+            state.deadline = state.connect_timeout_ms.map(|timeout| crate::now_ms() + timeout);
+        }
+        // The task watches the time.
+        crate::wake();
+        let started = match self.protocol {
+            Protocol::Rfcomm => crate::rfcomm::connect(self),
+            Protocol::Sco => crate::sco::connect(self),
+            _ => crate::l2cap::connect(self),
+        };
+        match started {
+            Ok(()) => Err(EINPROGRESS),
+            Err(error) => {
+                let mut state = self.state.lock();
+                state.phase = Phase::Closed;
+                state.error = Some(error);
+                Err(error)
+            }
+        }
+    }
+
+    /// How a connection that was started went: `EINPROGRESS` while it goes.
+    pub fn connect_result(&self) -> Result<(), i32> {
+        let mut state = self.state.lock();
+        match state.phase {
+            Phase::Connected => Ok(()),
+            Phase::Connecting => Err(EINPROGRESS),
+            _ => Err(state.error.take().unwrap_or(ENOTCONN)),
+        }
+    }
+
+    /// `SO_ERROR`: the error the socket has, once.
+    pub fn take_error(&self) -> Option<i32> {
+        let mut state = self.state.lock();
+        if state.phase == Phase::Connecting {
+            return None;
+        }
+        state.error.take()
+    }
+
+    pub fn local_address(&self) -> Vec<u8> {
+        self.state.lock().local.to_bytes(self.protocol)
+    }
+
+    pub fn peer_address(&self) -> Result<Vec<u8>, i32> {
+        let state = self.state.lock();
+        match state.phase {
+            Phase::Connected | Phase::Connecting => Ok(state.peer.to_bytes(self.protocol)),
+            _ => Err(ENOTCONN),
+        }
+    }
+
+    pub fn send(&self, data: &[u8]) -> Result<usize, i32> {
+        {
+            let state = self.state.lock();
+            match state.phase {
+                Phase::Connected => {}
+                Phase::Closed | Phase::Disconnecting => return Err(state.error.unwrap_or(EPIPE)),
+                _ => return Err(ENOTCONN),
+            }
+        }
+        match self.protocol {
+            Protocol::Rfcomm => crate::rfcomm::send(self, data),
+            Protocol::Sco => crate::sco::send(self, data),
+            _ => crate::l2cap::send(self, data),
+        }
+    }
+
+    /// The next message (a whole frame; a stream's bytes, up to `max`), an
+    /// empty one at the end, or `EAGAIN`; `peek`: left to be read again
+    /// (`MSG_PEEK`).
+    pub fn recv(&self, peek: bool, max: usize) -> Result<Vec<u8>, i32> {
+        let (data, rfcomm) = {
+            let mut state = self.state.lock();
+            if !state.rx.is_empty() {
+                let data = if self.is_stream() {
+                    take_stream(&mut state.rx, peek, max)
+                } else if peek {
+                    state.rx.front().unwrap().clone()
+                } else {
+                    state.rx.pop_front().unwrap()
+                };
+                (Some(data), state.rfcomm.clone())
+            } else {
+                match state.phase {
+                    Phase::Closed => return Ok(Vec::new()),
+                    // Shut for reading: the end.
+                    _ if state.read_shut => return Ok(Vec::new()),
+                    Phase::Disconnecting => return Err(EAGAIN),
+                    Phase::Connecting if state.deferred => {
+                        state.deferred = false;
+                        (None, None)
+                    }
+                    Phase::Connected | Phase::Connecting => return Err(EAGAIN),
+                    _ => return Err(ENOTCONN),
+                }
+            }
+        };
+        if let Some(data) = data {
+            // What was read leaves room: the device may send again.
+            if let Some(dlc) = rfcomm.filter(|_| !peek) {
+                crate::rfcomm::read_done(&dlc);
+            }
+            return Ok(data);
+        }
+        // The program takes a deferred connection: it is set up now, and
+        // the read returns nothing, as Linux's.
+        match self.protocol {
+            Protocol::Rfcomm => crate::rfcomm::accept_deferred(self),
+            Protocol::Sco => crate::sco::accept_deferred(self),
+            _ => crate::l2cap::accept_deferred(self),
+        }
+        Ok(Vec::new())
+    }
+
+    /// Shuts the socket: for reading (`read`), the end comes at once; for
+    /// writing, the connection closes (an L2CAP channel once the device
+    /// answers).
+    pub fn shutdown(&self, read: bool, write: bool) -> Result<(), i32> {
+        let listening = {
+            let mut state = self.state.lock();
+            let listening = state.phase == Phase::Listening;
+            if listening {
+                state.phase = Phase::Closed;
+                state.queue.clear();
+            }
+            if read {
+                state.read_shut = true;
+            }
+            listening
+        };
+        if !listening && write {
+            match self.protocol {
+                Protocol::Rfcomm => crate::rfcomm::close(self),
+                Protocol::Sco => crate::sco::close(self),
+                _ => crate::l2cap::shutdown(self),
+            }
+        }
+        self.wake();
+        Ok(())
+    }
+
+    /// The events the socket file reports ([`events`]).
+    pub fn events(&self) -> u32 {
+        // An RFCOMM channel takes data while it has room.
+        let rfcomm = self.state.lock().rfcomm.clone();
+        let writable = rfcomm.as_ref().is_none_or(crate::rfcomm::writable);
+        let state = self.state.lock();
+        match state.phase {
+            Phase::Listening if !state.queue.is_empty() => events::IN,
+            Phase::Listening | Phase::Connecting => 0,
+            Phase::Open | Phase::Bound => events::OUT,
+            Phase::Connected => {
+                let mut events = if writable { events::OUT } else { 0 };
+                if !state.rx.is_empty() || state.deferred || state.read_shut {
+                    events |= events::IN;
+                }
+                events
+            }
+            Phase::Disconnecting => {
+                if !state.rx.is_empty() || state.read_shut { events::IN } else { 0 }
+            }
+            Phase::Closed => {
+                let mut events = events::IN | events::OUT | events::HUP;
+                if state.error.is_some() {
+                    events |= events::ERR;
+                }
+                events
+            }
+        }
+    }
+
+    /// Sets an option at one of the protocol's levels. `Err` is Linux's
+    /// errno.
+    pub fn set_option(&self, level: i32, name: i32, value: &[u8]) -> Result<(), i32> {
+        let routed = self.protocol == Protocol::Sco && crate::l2cap::route(&self.state.lock().local).is_some();
+        let u32_value = || -> Result<u32, i32> {
+            value.get(..4).map(|bytes| u32::from_ne_bytes(bytes.try_into().unwrap())).ok_or(EINVAL)
+        };
+        let mut state = self.state.lock();
+        match (level, name) {
+            (SOL_BLUETOOTH, BT_SECURITY) => {
+                if self.protocol == Protocol::Sco {
+                    return Err(ENOPROTOOPT);
+                }
+                let level = *value.first().ok_or(EINVAL)?;
+                if !(SECURITY_SDP..=SECURITY_FIPS).contains(&level) {
+                    return Err(EINVAL);
+                }
+                let raise = state.phase == Phase::Connected && level > state.security;
+                state.security = level;
+                if raise {
+                    drop(state);
+                    crate::l2cap::raise_security(self, level);
+                    return Ok(());
+                }
+                state.link_mode = match level {
+                    SECURITY_MEDIUM => LM_AUTH,
+                    SECURITY_HIGH => LM_AUTH | LM_ENCRYPT,
+                    SECURITY_FIPS => LM_AUTH | LM_ENCRYPT | LM_SECURE,
+                    _ => 0,
+                };
+            }
+            (SOL_BLUETOOTH, BT_DEFER_SETUP) => {
+                if !matches!(state.phase, Phase::Bound | Phase::Listening) {
+                    return Err(EINVAL);
+                }
+                state.defer_setup = u32_value()? != 0;
+            }
+            (SOL_BLUETOOTH, BT_FLUSHABLE) if self.protocol == Protocol::L2cap => {
+                state.flushable = u32_value()? != 0;
+            }
+            (SOL_BLUETOOTH, BT_POWER) if self.protocol == Protocol::L2cap => {
+                state.force_active = *value.first().ok_or(EINVAL)? != 0;
+            }
+            (SOL_BLUETOOTH, BT_CHANNEL_POLICY) if self.protocol == Protocol::L2cap => {
+                state.channel_policy = u32_value()?;
+            }
+            (SOL_BLUETOOTH, BT_RCVMTU) if self.protocol == Protocol::L2cap => {
+                let mtu = u16::from_ne_bytes(value.get(..2).ok_or(EINVAL)?.try_into().unwrap());
+                if state.local.is_le() && mtu < L2CAP_LE_MIN_MTU {
+                    return Err(EINVAL);
+                }
+                state.imtu = mtu;
+            }
+            (SOL_BLUETOOTH, BT_MODE) if self.protocol == Protocol::L2cap => {
+                // Basic mode and LE's credit-based flow control.
+                match *value.first().ok_or(EINVAL)? {
+                    0x00 | 0x03 => state.mode = 0,
+                    _ => return Err(EINVAL),
+                }
+            }
+            (SOL_BLUETOOTH, BT_VOICE) if self.protocol == Protocol::Sco => {
+                let setting = u16::from_ne_bytes(value.get(..2).ok_or(EINVAL)?.try_into().unwrap());
+                // Before a link, or while the program decides on the
+                // device's (deferred), with a controller to route by.
+                if !(matches!(state.phase, Phase::Open | Phase::Bound) || (state.phase == Phase::Connecting && state.deferred)) {
+                    return Err(EINVAL);
+                }
+                if !routed {
+                    return Err(EBADFD);
+                }
+                state.voice = setting;
+            }
+            (SOL_BLUETOOTH, BT_PKT_STATUS) if self.protocol == Protocol::Sco => {
+                state.pkt_status = u32_value()? != 0;
+            }
+            (SOL_L2CAP, L2CAP_OPTIONS) => {
+                if value.len() < 12 {
+                    return Err(EINVAL);
+                }
+                let omtu = u16::from_ne_bytes([value[0], value[1]]);
+                let imtu = u16::from_ne_bytes([value[2], value[3]]);
+                let mode = value[6];
+                // Basic, ERTM and streaming modes are a BR/EDR link's.
+                if mode > 0x04 {
+                    return Err(EINVAL);
+                }
+                state.omtu = omtu;
+                state.imtu = imtu;
+                state.flush_to = u16::from_ne_bytes([value[4], value[5]]);
+                state.mode = mode;
+                state.fcs = value[7];
+                state.max_tx = value[8];
+                state.txwin_size = u16::from_ne_bytes([value[10], value[11]]);
+            }
+            (SOL_L2CAP, L2CAP_LM) | (SOL_RFCOMM, RFCOMM_LM) => {
+                let mode = u32_value()?;
+                state.link_mode = mode;
+                state.security = if mode & LM_SECURE != 0 {
+                    SECURITY_FIPS
+                } else if mode & LM_ENCRYPT != 0 {
+                    SECURITY_HIGH
+                } else if mode & LM_AUTH != 0 {
+                    SECURITY_MEDIUM
+                } else {
+                    SECURITY_LOW
+                };
+            }
+            (SOL_SCO, SCO_OPTIONS) => return Err(ENOPROTOOPT),
+            _ => return Err(ENOPROTOOPT),
+        }
+        Ok(())
+    }
+
+    /// Reads an option at one of the protocol's levels.
+    pub fn get_option(&self, level: i32, name: i32) -> Result<Vec<u8>, i32> {
+        let phys = self.state.lock().channel.clone().map(|channel| crate::l2cap::phys(&channel));
+        let rfcomm = self.state.lock().rfcomm.clone();
+        let rfcomm_handle = rfcomm.as_ref().and_then(|dlc| dlc.session.handle());
+        let state = self.state.lock();
+        // A SCO link's, once it is up (or the program decides on it).
+        let sco = state.sco.as_ref().filter(|_| state.phase == Phase::Connected || (state.phase == Phase::Connecting && state.deferred));
+        let bytes = match (level, name) {
+            (SOL_SCO, SCO_OPTIONS) => sco.ok_or(ENOTCONN)?.mtu.to_ne_bytes().to_vec(),
+            (SOL_SCO, SCO_CONNINFO) if state.phase == Phase::Connected && sco.is_some() => {
+                let mut bytes = sco.map_or(0, |sco| sco.handle).to_ne_bytes().to_vec();
+                bytes.extend_from_slice(&[0, 0, 0, 0]);
+                bytes
+            }
+            (SOL_BLUETOOTH, BT_SNDMTU | BT_RCVMTU) if self.protocol == Protocol::Sco => {
+                if state.phase != Phase::Connected {
+                    return Err(ENOTCONN);
+                }
+                sco.map_or(0, |sco| sco.mtu).to_ne_bytes().to_vec()
+            }
+            (SOL_BLUETOOTH, BT_SECURITY) if self.protocol != Protocol::Sco => vec![state.security, state.key_size],
+            (SOL_BLUETOOTH, BT_DEFER_SETUP) => (state.defer_setup as u32).to_ne_bytes().to_vec(),
+            (SOL_BLUETOOTH, BT_FLUSHABLE) if self.protocol == Protocol::L2cap => {
+                (state.flushable as u32).to_ne_bytes().to_vec()
+            }
+            (SOL_BLUETOOTH, BT_POWER) if self.protocol == Protocol::L2cap => vec![state.force_active as u8],
+            (SOL_BLUETOOTH, BT_CHANNEL_POLICY) if self.protocol == Protocol::L2cap => {
+                state.channel_policy.to_ne_bytes().to_vec()
+            }
+            (SOL_BLUETOOTH, BT_RCVMTU) if self.protocol == Protocol::L2cap => state.imtu.to_ne_bytes().to_vec(),
+            (SOL_BLUETOOTH, BT_SNDMTU) if state.phase == Phase::Connected => {
+                state.channel.as_ref().map_or(state.omtu, |channel| channel.omtu).to_ne_bytes().to_vec()
+            }
+            // LE 1M (and BR/EDR's basic rate): what links run on.
+            (SOL_BLUETOOTH, BT_PHY) if state.phase == Phase::Connected => phys.unwrap_or(0x0001).to_ne_bytes().to_vec(),
+            (SOL_BLUETOOTH, BT_SNDMTU | BT_PHY) => return Err(ENOTCONN),
+            (SOL_BLUETOOTH, BT_MODE) if self.protocol == Protocol::L2cap => vec![if state.local.is_le() { 0x03 } else { 0x00 }],
+            (SOL_BLUETOOTH, BT_VOICE) if self.protocol == Protocol::Sco => state.voice.to_ne_bytes().to_vec(),
+            (SOL_BLUETOOTH, BT_PKT_STATUS) if self.protocol == Protocol::Sco => {
+                (state.pkt_status as u32).to_ne_bytes().to_vec()
+            }
+            (SOL_L2CAP, L2CAP_OPTIONS) => {
+                let mut bytes = Vec::with_capacity(12);
+                let omtu = state.channel.as_ref().map_or(state.omtu, |channel| channel.omtu);
+                bytes.extend_from_slice(&omtu.to_ne_bytes());
+                bytes.extend_from_slice(&state.imtu.to_ne_bytes());
+                bytes.extend_from_slice(&state.flush_to.to_ne_bytes());
+                bytes.extend_from_slice(&[state.mode, state.fcs, state.max_tx, 0]);
+                bytes.extend_from_slice(&state.txwin_size.to_ne_bytes());
+                bytes
+            }
+            (SOL_L2CAP, L2CAP_LM) | (SOL_RFCOMM, RFCOMM_LM) => state.link_mode.to_ne_bytes().to_vec(),
+            (SOL_L2CAP, L2CAP_CONNINFO) if state.phase == Phase::Connected => {
+                let handle = state.channel.as_ref().map_or(0, |channel| channel.handle);
+                let mut bytes = handle.to_ne_bytes().to_vec();
+                bytes.extend_from_slice(&[0, 0, 0, 0]);
+                bytes
+            }
+            (SOL_RFCOMM, RFCOMM_CONNINFO) if state.phase == Phase::Connected => {
+                let mut bytes = rfcomm_handle.unwrap_or(0).to_ne_bytes().to_vec();
+                bytes.extend_from_slice(&[0, 0, 0, 0]);
+                bytes
+            }
+            (SOL_L2CAP, L2CAP_CONNINFO) | (SOL_RFCOMM, RFCOMM_CONNINFO) | (SOL_SCO, SCO_CONNINFO) => {
+                return Err(ENOTCONN);
+            }
+            _ => return Err(ENOPROTOOPT),
+        };
+        Ok(bytes)
+    }
+}
+
+impl Drop for ProtoSocket {
+    /// The program closed it: its channel goes too.
+    fn drop(&mut self) {
+        let state = self.state.get_mut();
+        let channel = state.channel.take();
+        let rfcomm = state.rfcomm.take();
+        let sco = state.sco.take();
+        if let Some(channel) = channel {
+            crate::l2cap::dropped(channel);
+        }
+        if let Some(dlc) = rfcomm {
+            crate::rfcomm::dropped(dlc);
+        }
+        if let Some(sco) = sco {
+            crate::sco::dropped(sco);
+        }
+    }
+}
+
+/// Connections that took too long fail (`ETIMEDOUT`). Whether one is
+/// still being made against the clock.
+pub(crate) fn expire_connects(now: u64) -> bool {
+    let mut waiting = false;
+    for socket in sockets() {
+        let expired = {
+            let mut state = socket.state.lock();
+            match (state.phase, state.deadline) {
+                (Phase::Connecting | Phase::Disconnecting, Some(deadline)) if !state.deferred => {
+                    let expired = now >= deadline;
+                    if expired {
+                        state.deadline = None;
+                    } else {
+                        waiting = true;
+                    }
+                    expired
+                }
+                _ => false,
+            }
+        };
+        if expired {
+            let connecting = socket.state.lock().phase == Phase::Connecting;
+            match socket.protocol {
+                Protocol::Rfcomm => crate::rfcomm::close(&socket),
+                Protocol::Sco => crate::sco::close(&socket),
+                _ => crate::l2cap::close(&socket),
+            }
+            if connecting {
+                socket.state.lock().error = Some(ETIMEDOUT);
+            }
+            socket.wake();
+        }
+    }
+    waiting
+}
+
+/// A stream's bytes, from as many messages as fit in `max`.
+fn take_stream(rx: &mut VecDeque<Vec<u8>>, peek: bool, max: usize) -> Vec<u8> {
+    let mut data = Vec::new();
+    if peek {
+        for message in rx.iter() {
+            if data.len() >= max {
+                break;
+            }
+            let take = (max - data.len()).min(message.len());
+            data.extend_from_slice(&message[..take]);
+        }
+        return data;
+    }
+    while data.len() < max {
+        let Some(front) = rx.front_mut() else { break };
+        let take = (max - data.len()).min(front.len());
+        if take == front.len() {
+            let message = rx.pop_front().unwrap();
+            if data.is_empty() {
+                data = message;
+            } else {
+                data.extend_from_slice(&message);
+            }
+        } else {
+            data.extend_from_slice(&front[..take]);
+            front.drain(..take);
+        }
+    }
+    data
+}
