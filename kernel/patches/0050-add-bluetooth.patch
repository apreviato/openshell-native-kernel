+/// The 16-bit form of a UUID built on the Bluetooth base UUID
+/// (0000xxxx-0000-1000-8000-00805F9B34FB, little-endian in management).
+pub(crate) fn uuid16(uuid: &[u8; 16]) -> Option<u16> {
+    const BASE: [u8; 12] = [0xfb, 0x34, 0x9b, 0x5f, 0x80, 0x00, 0x00, 0x80, 0x00, 0x10, 0x00, 0x00];
+    (uuid[..12] == BASE && uuid[14..16] == [0, 0]).then(|| u16::from_le_bytes([uuid[12], uuid[13]]))
+}
+
+fn packet(event: u16, index: u16, params: &[u8]) -> Vec<u8> {
+    let mut bytes = Vec::with_capacity(6 + params.len());
+    bytes.extend_from_slice(&event.to_le_bytes());
+    bytes.extend_from_slice(&index.to_le_bytes());
+    bytes.extend_from_slice(&(params.len() as u16).to_le_bytes());
+    bytes.extend_from_slice(params);
+    bytes
+}
+
+/// An event to every management socket, but `skip` (the one whose command
+/// caused it, which gets the command's reply instead).
+fn event(code: u16, index: u16, params: &[u8], skip: Option<&Arc<Socket>>) {
+    socket::control_event(&packet(code, index, params), skip);
+}
+
+/// An event to every management socket.
+pub(crate) fn event_to_all(code: u16, index: u16, params: &[u8]) {
+    event(code, index, params, None);
+}
+
+/// The answer to a command that took a while (`PAIR_DEVICE`).
+pub(crate) fn reply_later(socket: &Arc<Socket>, opcode: u16, index: u16, status: u8, data: &[u8]) {
+    let mut body = Vec::with_capacity(3 + data.len());
+    body.extend_from_slice(&opcode.to_le_bytes());
+    body.push(status);
+    body.extend_from_slice(data);
+    socket.queue(packet(ev::CMD_COMPLETE, index, &body));
+}
+
+pub(crate) fn index_added(index: u16) {
+    event(ev::INDEX_ADDED, index, &[], None);
+    if let Some(device) = device_at(index) {
+        event(ev::EXT_INDEX_ADDED, index, &[0x00, device.bus()], None);
+    }
+}
+
+pub(crate) fn index_removed(index: u16, bus: u8) {
+    event(ev::INDEX_REMOVED, index, &[], None);
+    event(ev::EXT_INDEX_REMOVED, index, &[0x00, bus], None);
+}
+
+pub(crate) fn new_settings(index: u16, skip: Option<&Arc<Socket>>) {
+    if let Some(device) = device_at(index) {
+        event(ev::NEW_SETTINGS, index, &device.settings().to_le_bytes(), skip);
+    }
+}
+
+pub(crate) fn discovering(index: u16, kind: u8, on: bool) {
+    event(ev::DISCOVERING, index, &[kind, on as u8], None);
+}
+
+pub(crate) fn device_found(index: u16, address: &[u8; 6], address_type: u8, rssi: i8, flags: u32, eir: &[u8]) {
+    let mut params = Vec::with_capacity(14 + eir.len());
+    params.extend_from_slice(address);
+    params.push(address_type);
+    params.push(rssi as u8);
+    params.extend_from_slice(&flags.to_le_bytes());
+    params.extend_from_slice(&(eir.len() as u16).to_le_bytes());
+    params.extend_from_slice(eir);
+    event(ev::DEVICE_FOUND, index, &params, None);
+}
+
+/// Commands waiting for the management task, in order, with their sockets.
+static QUEUE: SpinLock<VecDeque<(Weak<Socket>, Vec<u8>)>, LocalIrqDisabled> = SpinLock::new(VecDeque::new());
+static QUEUE_WAKE: WaitQueue = WaitQueue::new();
+static TASK_RUNS: AtomicBool = AtomicBool::new(false);
+
+/// A command a program wrote: checked, then left to the management task,
+/// as Linux runs them apart from the program (which may be the one that
+/// answers the controller, as BlueZ's emulators are). `Err` is Linux's
+/// errno for a malformed message.
+pub(crate) fn submit(socket: &Arc<Socket>, message: &[u8]) -> Result<(), i32> {
+    const EINVAL: i32 = 22;
+    if message.len() < 6 || u16::from_le_bytes([message[4], message[5]]) as usize != message.len() - 6 {
+        return Err(EINVAL);
+    }
+    if !TASK_RUNS.load(Ordering::Acquire) {
+        return handle(socket, message);
+    }
+    QUEUE.lock().push_back((Arc::downgrade(socket), message.to_vec()));
+    QUEUE_WAKE.wake_all();
+    Ok(())
+}
+
+/// The management task: the queued commands, one after the other.
+pub(crate) fn run() -> ! {
+    TASK_RUNS.store(true, Ordering::Release);
+    loop {
+        let (socket, message) = QUEUE_WAKE.wait_until(|| QUEUE.lock().pop_front());
+        if let Some(socket) = socket.upgrade() {
+            let _ = handle(&socket, &message);
+        }
+    }
+}
+
+/// Handles one command from a management socket: its reply is queued on
+/// that socket. `Err` is Linux's errno for a malformed message.
+pub(crate) fn handle(socket: &Arc<Socket>, message: &[u8]) -> Result<(), i32> {
+    const EINVAL: i32 = 22;
+    if message.len() < 6 {
+        return Err(EINVAL);
+    }
+    let opcode = u16::from_le_bytes([message[0], message[1]]);
+    let index = u16::from_le_bytes([message[2], message[3]]);
+    let length = u16::from_le_bytes([message[4], message[5]]) as usize;
+    if length != message.len() - 6 {
+        return Err(EINVAL);
+    }
+    let params = &message[6..];
+    let reply = |status: u8, data: &[u8]| {
+        let mut body = Vec::with_capacity(3 + data.len());
+        body.extend_from_slice(&opcode.to_le_bytes());
+        body.push(status);
+        body.extend_from_slice(data);
+        socket.queue(packet(ev::CMD_COMPLETE, index, &body));
+    };
+    let status_only = |status: u8| {
+        let mut body = opcode.to_le_bytes().to_vec();
+        body.push(status);
+        socket.queue(packet(ev::CMD_STATUS, index, &body));
+    };
+
+    // Commands about no controller.
+    match opcode {
+        op::READ_VERSION => {
+            let mut data = vec![VERSION];
+            data.extend_from_slice(&REVISION.to_le_bytes());
+            reply(STATUS_SUCCESS, &data);
+            return Ok(());
+        }
+        op::READ_COMMANDS => {
+            let mut data = Vec::new();
+            data.extend_from_slice(&(COMMANDS.len() as u16).to_le_bytes());
+            data.extend_from_slice(&(EVENTS.len() as u16).to_le_bytes());
+            for code in COMMANDS.iter().chain(EVENTS) {
+                data.extend_from_slice(&code.to_le_bytes());
+            }
+            reply(STATUS_SUCCESS, &data);
+            return Ok(());
+        }
+        op::READ_INDEX_LIST => {
+            let ready: Vec<u16> = devices().iter().filter(|device| device.state.lock().ready).map(|device| device.index).collect();
+            let mut data = (ready.len() as u16).to_le_bytes().to_vec();
+            for index in ready {
+                data.extend_from_slice(&index.to_le_bytes());
+            }
+            reply(STATUS_SUCCESS, &data);
+            return Ok(());
+        }
+        op::READ_EXT_INDEX_LIST => {
+            let ready: Vec<Arc<Device>> = devices().into_iter().filter(|device| device.state.lock().ready).collect();
+            let mut data = (ready.len() as u16).to_le_bytes().to_vec();
+            for device in ready {
+                data.extend_from_slice(&device.index.to_le_bytes());
+                data.push(0x00);
+                data.push(device.bus());
+            }
+            reply(STATUS_SUCCESS, &data);
+            return Ok(());
+        }
+        op::READ_UNCONF_INDEX_LIST => {
+            reply(STATUS_SUCCESS, &[0, 0]);
+            return Ok(());
+        }
+        op::READ_EXP_FEATURES_INFO => {
+            reply(STATUS_SUCCESS, &[0, 0]);
+            return Ok(());
+        }
+        op::SET_EXP_FEATURE => {
+            reply(STATUS_NOT_SUPPORTED, &[]);
+            return Ok(());
+        }
+        _ => {}
+    }
+
+    if !COMMANDS.contains(&opcode) && opcode != op::REMOVE_ADV_MONITOR {
+        status_only(STATUS_UNKNOWN_COMMAND);
+        return Ok(());
+    }
+    let Some(device) = device_at(index).filter(|device| device.state.lock().ready && !device.state.lock().removed) else {
+        status_only(STATUS_INVALID_INDEX);
+        return Ok(());
+    };
+    let _one_at_a_time = device.mgmt_lock.lock();
+    controller_command(&device, socket, opcode, params, &reply);
+    Ok(())
+}
+
+fn address_of(params: &[u8]) -> Option<([u8; 6], u8)> {
+    let mut address = [0u8; 6];
+    address.copy_from_slice(params.get(..6)?);
+    Some((address, *params.get(6)?))
+}
+
+fn controller_command(device: &Arc<Device>, socket: &Arc<Socket>, opcode: u16, params: &[u8], reply: &dyn Fn(u8, &[u8])) {
+    let index = device.index;
+    let powered = device.is_powered();
+    let settings_reply = |status: u8| reply(status, &device.settings().to_le_bytes());
+    match opcode {
+        op::READ_INFO => {
+            let state = device.state.lock();
+            let mut data = Vec::with_capacity(280);
+            data.extend_from_slice(&state.info.address);
+            data.push(state.info.hci_version);
+            data.extend_from_slice(&state.info.manufacturer.to_le_bytes());
+            data.extend_from_slice(&state.supported.to_le_bytes());
+            data.extend_from_slice(&(state.settings & !settings::HIDDEN).to_le_bytes());
+            data.extend_from_slice(&Device::class_of_device(&state));
+            let mut name = state.name.clone();
+            name.resize(249, 0);
+            data.extend_from_slice(&name);
+            let mut short_name = state.short_name.clone();
+            short_name.resize(11, 0);
+            data.extend_from_slice(&short_name);
+            drop(state);
+            reply(STATUS_SUCCESS, &data);
+        }
+        op::SET_POWERED => {
+            let Some(&value) = params.first().filter(|value| **value <= 1) else {
+                return settings_reply(STATUS_INVALID_PARAMS);
+            };
+            if (value == 1) == powered {
+                return settings_reply(STATUS_SUCCESS);
+            }
+            if value == 1 && device.is_rfkilled() {
+                return settings_reply(STATUS_RFKILLED);
+            }
+            if value == 1 {
+                device.state.lock().settings |= settings::POWERED;
+                device.apply();
+            } else {
+                device.power_off();
+            }
+            settings_reply(STATUS_SUCCESS);
+            new_settings(index, Some(socket));
+        }
+        op::SET_DISCOVERABLE => {
+            if params.len() != 3 || params[0] > 2 {
+                return settings_reply(STATUS_INVALID_PARAMS);
+            }
+            let timeout = u16::from_le_bytes([params[1], params[2]]);
+            let on = params[0] != 0;
+            if !on && timeout != 0 {
+                return settings_reply(STATUS_INVALID_PARAMS);
+            }
+            if !powered && timeout != 0 {
+                return settings_reply(STATUS_NOT_POWERED);
+            }
+            let changed = {
+                let mut state = device.state.lock();
+                if on && state.settings & settings::CONNECTABLE == 0 {
+                    drop(state);
+                    return settings_reply(STATUS_REJECTED);
+                }
+                let before = state.settings;
+                if on {
+                    state.settings |= settings::DISCOVERABLE;
+                } else {
+                    state.settings &= !settings::DISCOVERABLE;
+                }
+                state.discoverable_until = (on && timeout != 0).then(|| now_ms() + timeout as u64 * 1000);
+                before != state.settings
+            };
+            if powered {
+                device.apply_scan();
+            }
+            settings_reply(STATUS_SUCCESS);
+            if changed {
+                new_settings(index, Some(socket));
+            }
+            crate::wake_task(device);
+        }
+        op::SET_CONNECTABLE => {
+            let Some(&value) = params.first().filter(|value| **value <= 1) else {
+                return settings_reply(STATUS_INVALID_PARAMS);
+            };
+            let changed = {
+                let mut state = device.state.lock();
+                let before = state.settings;
+                if value == 1 {
+                    state.settings |= settings::CONNECTABLE;
+                } else {
+                    state.settings &= !(settings::CONNECTABLE | settings::DISCOVERABLE);
+                    state.discoverable_until = None;
+                }
+                before != state.settings
+            };
+            if powered {
+                device.apply_scan();
+            }
+            settings_reply(STATUS_SUCCESS);
+            if changed {
+                new_settings(index, Some(socket));
+            }
+        }
+        op::SET_FAST_CONNECTABLE | op::SET_BONDABLE | op::SET_LINK_SECURITY | op::SET_SSP | op::SET_LE | op::SET_BREDR => {
+            let bit = match opcode {
+                op::SET_FAST_CONNECTABLE => settings::FAST_CONNECTABLE,
+                op::SET_BONDABLE => settings::BONDABLE,
+                op::SET_LINK_SECURITY => settings::LINK_SECURITY,
+                op::SET_SSP => settings::SSP,
+                op::SET_LE => settings::LE,
+                _ => settings::BREDR,
+            };
+            let Some(&value) = params.first().filter(|value| **value <= 1) else {
+                return settings_reply(STATUS_INVALID_PARAMS);
+            };
+            let changed = {
+                let mut state = device.state.lock();
+                if state.supported & bit == 0 {
+                    drop(state);
+                    return settings_reply(STATUS_NOT_SUPPORTED);
+                }
+                let before = state.settings;
+                if value == 1 {
+                    state.settings |= bit;
+                } else {
+                    state.settings &= !bit;
+                }
+                before != state.settings
+            };
+            if changed && powered && matches!(opcode, op::SET_LINK_SECURITY | op::SET_SSP | op::SET_LE | op::SET_BREDR) {
+                device.apply();
+            }
+            settings_reply(STATUS_SUCCESS);
+            if changed {
+                new_settings(index, Some(socket));
+            }
+        }
+        op::SET_SECURE_CONN => {
+            // Off, on, or only Secure Connections.
+            let Some(&value) = params.first().filter(|value| **value <= 2) else {
+                return settings_reply(STATUS_INVALID_PARAMS);
+            };
+            let changed = {
+                let mut state = device.state.lock();
+                if state.supported & settings::SECURE_CONN == 0 {
+                    drop(state);
+                    return settings_reply(STATUS_NOT_SUPPORTED);
+                }
+                let before = state.settings;
+                state.settings &= !(settings::SECURE_CONN | settings::SC_ONLY);
+                if value >= 1 {
+                    state.settings |= settings::SECURE_CONN;
+                }
+                if value == 2 {
+                    state.settings |= settings::SC_ONLY;
+                }
+                before & !settings::SC_ONLY != state.settings & !settings::SC_ONLY
+            };
+            settings_reply(STATUS_SUCCESS);
+            if changed {
+                new_settings(index, Some(socket));
+            }
+        }
+        op::SET_DEV_CLASS => {
+            if params.len() != 2 {
+                return reply(STATUS_INVALID_PARAMS, &[0; 3]);
+            }
+            let class = {
+                let mut state = device.state.lock();
+                state.major_minor = (params[0] & 0x1f, params[1]);
+                Device::class_of_device(&state)
+            };
+            if powered {
+                device.apply();
+            }
+            reply(STATUS_SUCCESS, &class);
+            event(ev::CLASS_OF_DEV_CHANGED, index, &class, Some(socket));
+        }
+        op::ADD_UUID | op::REMOVE_UUID => {
+            let Some(uuid) = params.get(..16).map(|uuid| <[u8; 16]>::try_from(uuid).unwrap()) else {
+                return reply(STATUS_INVALID_PARAMS, &[0; 3]);
+            };
+            let (before, class) = {
+                let mut state = device.state.lock();
+                let before = Device::class_of_device(&state);
+                if opcode == op::ADD_UUID {
+                    let hint = params.get(16).copied().unwrap_or(0);
+                    state.uuids.push((uuid, hint));
+                } else if uuid == [0; 16] {
+                    state.uuids.clear();
+                } else {
+                    let count = state.uuids.len();
+                    state.uuids.retain(|(known, _)| *known != uuid);
+                    if state.uuids.len() == count {
+                        let class = Device::class_of_device(&state);
+                        drop(state);
+                        return reply(STATUS_INVALID_PARAMS, &class);
+                    }
+                }
+                (before, Device::class_of_device(&state))
+            };
+            if powered {
+                device.apply();
+            }
+            reply(STATUS_SUCCESS, &class);
+            if class != before {
+                event(ev::CLASS_OF_DEV_CHANGED, index, &class, Some(socket));
+            }
+        }
+        op::SET_LOCAL_NAME => {
+            if params.len() != 260 {
+                return reply(STATUS_INVALID_PARAMS, &[]);
+            }
+            let name_end = params[..249].iter().position(|byte| *byte == 0).unwrap_or(248);
+            let short_end = params[249..].iter().position(|byte| *byte == 0).unwrap_or(10);
+            {
+                let mut state = device.state.lock();
+                state.name = params[..name_end.min(248)].to_vec();
+                state.short_name = params[249..249 + short_end.min(10)].to_vec();
+            }
+            if powered {
+                device.apply();
+            }
+            reply(STATUS_SUCCESS, params);
+            event(ev::LOCAL_NAME_CHANGED, index, params, Some(socket));
+        }
+        op::SET_IO_CAPABILITY => {
+            let Some(&capability) = params.first().filter(|value| **value <= 4) else {
+                return reply(STATUS_INVALID_PARAMS, &[]);
+            };
+            device.state.lock().io_capability = capability;
+            reply(STATUS_SUCCESS, &[]);
+        }
+        op::LOAD_LINK_KEYS => {
+            let count = params.get(1..3).map(|count| u16::from_le_bytes([count[0], count[1]]) as usize);
+            let Some(count) = count.filter(|count| params.len() == 3 + count * 25) else {
+                return reply(STATUS_INVALID_PARAMS, &[]);
+            };
+            let keys = (0..count)
+                .map(|at| {
+                    let key = &params[3 + at * 25..3 + (at + 1) * 25];
+                    LinkKey {
+                        address: key[..6].try_into().unwrap(),
+                        address_type: key[6],
+                        kind: key[7],
+                        value: key[8..24].try_into().unwrap(),
+                        pin_length: key[24],
+                    }
+                })
+                .collect();
+            device.state.lock().link_keys = keys;
+            reply(STATUS_SUCCESS, &[]);
+        }
+        op::LOAD_LONG_TERM_KEYS => {
+            let count = params.get(..2).map(|count| u16::from_le_bytes([count[0], count[1]]) as usize);
+            let Some(count) = count.filter(|count| params.len() == 2 + count * 36) else {
+                return reply(STATUS_INVALID_PARAMS, &[]);
+            };
+            device.state.lock().ltks = (0..count).filter_map(|at| crate::smp::Ltk::parse(&params[2 + at * 36..])).collect();
+            reply(STATUS_SUCCESS, &[]);
+        }
+        op::DISCONNECT => {
+            let Some((address, address_type)) = address_of(params) else {
+                return reply(STATUS_INVALID_PARAMS, &[]);
+            };
+            match crate::link::handle_of(device, &address, crate::link::is_le_type(address_type)) {
+                Some(handle) => {
+                    let status = match crate::link::disconnect(device, handle, 0x13) {
+                        Ok(()) => STATUS_SUCCESS,
+                        Err(_) => STATUS_FAILED,
+                    };
+                    reply(status, &params[..7]);
+                }
+                None => reply(STATUS_NOT_CONNECTED, &params[..7]),
+            }
+        }
+        op::PAIR_DEVICE => {
+            let (Some((address, address_type)), Some(&io)) = (address_of(params), params.get(7)) else {
+                return reply(STATUS_INVALID_PARAMS, &[]);
+            };
+            if !powered {
+                return reply(STATUS_NOT_POWERED, &params[..7]);
+            }
+            let paired = {
+                let state = device.state.lock();
+                if crate::link::is_le_type(address_type) {
+                    state.ltks.iter().any(|key| key.address == address)
+                } else {
+                    state.link_keys.iter().any(|key| key.address == address)
+                }
+            };
+            if paired {
+                return reply(STATUS_ALREADY_PAIRED, &params[..7]);
+            }
+            // The answer comes when the pairing is done.
+            if let Err(status) = crate::pairing::pair(device, socket, address, address_type, io) {
+                reply(status, &params[..7]);
+            }
+        }
+        op::CANCEL_PAIR_DEVICE => {
+            let Some((address, _)) = address_of(params) else {
+                return reply(STATUS_INVALID_PARAMS, &[]);
+            };
+            let status = if crate::pairing::cancel(device, &address) { STATUS_SUCCESS } else { STATUS_INVALID_PARAMS };
+            reply(status, &params[..7]);
+        }
+        op::USER_CONFIRM_REPLY | op::USER_CONFIRM_NEG_REPLY | op::USER_PASSKEY_REPLY | op::USER_PASSKEY_NEG_REPLY
+        | op::PIN_CODE_REPLY | op::PIN_CODE_NEG_REPLY => {
+            let address = params.get(..7).unwrap_or(&[0; 7]).to_vec();
+            let status = match crate::pairing::agent_reply(device, opcode, params) {
+                Ok(()) => STATUS_SUCCESS,
+                Err(status) => status,
+            };
+            reply(status, &address);
+        }
+        op::GET_CONN_INFO => {
+            let Some((address, address_type)) = address_of(params) else {
+                return reply(STATUS_INVALID_PARAMS, &[]);
+            };
+            let mut data = params[..7].to_vec();
+            if crate::link::handle_of(device, &address, crate::link::is_le_type(address_type)).is_some() {
+                // RSSI, TX power, highest TX power: not read (127: unknown).
+                data.extend_from_slice(&[0, 127, 127]);
+                reply(STATUS_SUCCESS, &data);
+            } else {
+                data.extend_from_slice(&[0, 127, 127]);
+                reply(STATUS_NOT_CONNECTED, &data);
+            }
+        }
+        op::LOAD_IRKS => {
+            device.state.lock().settings |= settings::RPA_RESOLVING;
+            reply(STATUS_SUCCESS, &[]);
+        }
+        op::LOAD_CONN_PARAM | op::SET_BLOCKED_KEYS
+        | op::SET_SCAN_PARAMS | op::SET_DEF_SYSTEM_CONFIG | op::SET_DEF_RUNTIME_CONFIG => {
+            reply(STATUS_SUCCESS, &[]);
+        }
+        op::SET_APPEARANCE => {
+            let Some(appearance) = params.get(..2) else {
+                return reply(STATUS_INVALID_PARAMS, &[]);
+            };
+            device.state.lock().appearance = u16::from_le_bytes([appearance[0], appearance[1]]);
+            if powered {
+                device.apply_advertising();
+            }
+            reply(STATUS_SUCCESS, &[]);
+        }
+        op::SET_ADVERTISING => {
+            let Some(&value) = params.first().filter(|value| **value <= 2) else {
+                return settings_reply(STATUS_INVALID_PARAMS);
+            };
+            let changed = {
+                let mut state = device.state.lock();
+                if state.supported & settings::ADVERTISING == 0 {
+                    drop(state);
+                    return settings_reply(STATUS_NOT_SUPPORTED);
+                }
+                let before = state.settings;
+                state.settings &= !(settings::ADVERTISING | settings::ADV_CONNECTABLE);
+                if value != 0 {
+                    state.settings |= settings::ADVERTISING;
+                }
+                if value == 2 {
+                    state.settings |= settings::ADV_CONNECTABLE;
+                }
+                before != state.settings
+            };
+            if powered {
+                device.apply_advertising();
+            }
+            settings_reply(STATUS_SUCCESS);
+            if changed {
+                new_settings(index, Some(socket));
+            }
+        }
+        op::READ_ADV_FEATURES => {
+            let instance = device.state.lock().advertisement.as_ref().map(|advertisement| advertisement.instance);
+            let mut data = ADV_SUPPORTED_FLAGS.to_le_bytes().to_vec();
+            data.extend_from_slice(&[ADV_DATA_MAX as u8, ADV_DATA_MAX as u8, 1, instance.is_some() as u8]);
+            data.extend(instance);
+            reply(STATUS_SUCCESS, &data);
+        }
+        op::GET_ADV_SIZE_INFO => {
+            if params.len() != 5 || params[0] != 1 {
+                return reply(STATUS_INVALID_PARAMS, &[]);
+            }
+            let flags = u32::from_le_bytes(params[1..5].try_into().unwrap());
+            if flags & !ADV_SUPPORTED_FLAGS != 0 {
+                return reply(STATUS_INVALID_PARAMS, &[]);
+            }
+            let (data_room, scan_room) = {
+                let state = device.state.lock();
+                (
+                    ADV_DATA_MAX.saturating_sub(Device::advertising_fields(&state, flags, false).len()),
+                    ADV_DATA_MAX.saturating_sub(Device::advertising_fields(&state, flags, true).len()),
+                )
+            };
+            let mut data = params.to_vec();
+            data.extend_from_slice(&[data_room as u8, scan_room as u8]);
+            reply(STATUS_SUCCESS, &data);
+        }
+        op::ADD_ADVERTISING => {
+            if params.len() < 11 {
+                return reply(STATUS_INVALID_PARAMS, &[]);
+            }
+            let instance = params[0];
+            let flags = u32::from_le_bytes(params[1..5].try_into().unwrap());
+            let data_len = params[9] as usize;
+            let scan_len = params[10] as usize;
+            if instance != 1 || flags & !ADV_SUPPORTED_FLAGS != 0 || params.len() != 11 + data_len + scan_len {
+                return reply(STATUS_INVALID_PARAMS, &[instance]);
+            }
+            let fits = {
+                let state = device.state.lock();
+                Device::advertising_fields(&state, flags, false).len() + data_len <= ADV_DATA_MAX
+                    && Device::advertising_fields(&state, flags, true).len() + scan_len <= ADV_DATA_MAX
+            };
+            if !fits {
+                return reply(STATUS_INVALID_PARAMS, &[instance]);
+            }
+            let added = device
+                .state
+                .lock()
+                .advertisement
+                .replace(crate::device::Advertisement {
+                    instance,
+                    flags,
+                    data: params[11..11 + data_len].to_vec(),
+                    scan_rsp: params[11 + data_len..].to_vec(),
+                })
+                .is_none();
+            if powered {
+                device.apply_advertising();
+            }
+            reply(STATUS_SUCCESS, &[instance]);
+            if added {
+                event(ev::ADVERTISING_ADDED, index, &[instance], Some(socket));
+            }
+        }
+        op::REMOVE_ADVERTISING => {
+            let Some(&instance) = params.first() else {
+                return reply(STATUS_INVALID_PARAMS, &[]);
+            };
+            let removed = {
+                let mut state = device.state.lock();
+                let matches = state
+                    .advertisement
+                    .as_ref()
+                    .is_some_and(|advertisement| instance == 0 || instance == advertisement.instance);
+                if matches { state.advertisement.take().map(|advertisement| advertisement.instance) } else { None }
+            };
+            let Some(removed) = removed else {
+                return reply(STATUS_INVALID_PARAMS, &[instance]);
+            };
+            if powered {
+                device.apply_advertising();
+            }
+            reply(STATUS_SUCCESS, &[instance]);
+            event(ev::ADVERTISING_REMOVED, index, &[removed], Some(socket));
+        }
+        op::REMOVE_ADV_MONITOR => {
+            // No monitors are kept (none can be added): every handle is gone.
+            let handle = params.get(..2).unwrap_or(&[0, 0]);
+            reply(STATUS_SUCCESS, handle);
+        }
+        op::READ_DEF_SYSTEM_CONFIG | op::READ_DEF_RUNTIME_CONFIG => reply(STATUS_SUCCESS, &[]),
+        op::GET_CONNECTIONS => reply(STATUS_SUCCESS, &crate::link::connections(device)),
+        op::SET_DEVICE_ID => {
+            if params.len() != 8 {
+                return reply(STATUS_INVALID_PARAMS, &[]);
+            }
+            {
+                let mut state = device.state.lock();
+                for (at, value) in state.device_id.iter_mut().enumerate() {
+                    *value = u16::from_le_bytes([params[at * 2], params[at * 2 + 1]]);
+                }
+            }
+            if powered {
+                device.apply();
+            }
+            reply(STATUS_SUCCESS, &[]);
+        }
+        op::START_DISCOVERY | op::START_SERVICE_DISCOVERY | op::START_LIMITED_DISCOVERY => {
+            let Some(&kind) = params.first() else {
+                return reply(STATUS_INVALID_PARAMS, &[0]);
+            };
+            if !powered {
+                return reply(STATUS_NOT_POWERED, &[kind]);
+            }
+            match device.start_discovery(kind) {
+                Ok(()) => {
+                    reply(STATUS_SUCCESS, &[kind]);
+                    discovering(index, kind, true);
+                    device.discovery_announced();
+                    crate::wake_task(device);
+                }
+                Err(status) => reply(status, &[kind]),
+            }
+        }
+        op::STOP_DISCOVERY => {
+            let kind = params.first().copied().unwrap_or(0);
+            if device.state.lock().discovery.is_none() {
+                return reply(STATUS_REJECTED, &[kind]);
+            }
+            // The reply goes before the event, as Linux sends them.
+            let stopped = device.state.lock().discovery.as_ref().map(|discovery| discovery.kind);
+            reply(STATUS_SUCCESS, &[stopped.unwrap_or(kind)]);
+            device.stop_discovery();
+        }
+        op::CONFIRM_NAME => {
+            let Some((address, address_type)) = address_of(params) else {
+                return reply(STATUS_INVALID_PARAMS, &[]);
+            };
+            let known = params.get(7).copied().unwrap_or(1) != 0;
+            if address_type == ADDR_BREDR {
+                device.confirm_name(address, known);
+            }
+            reply(STATUS_SUCCESS, &params[..7]);
+        }
+        op::BLOCK_DEVICE | op::UNBLOCK_DEVICE => {
+            let Some(address) = params.get(..7) else {
+                return reply(STATUS_INVALID_PARAMS, &[]);
+            };
+            reply(STATUS_SUCCESS, address);
+        }
+        op::ADD_DEVICE | op::REMOVE_DEVICE => {
+            let Some(address) = params.get(..7) else {
+                return reply(STATUS_INVALID_PARAMS, &[]);
+            };
+            reply(STATUS_SUCCESS, address);
+            if opcode == op::ADD_DEVICE {
+                let mut data = address.to_vec();
+                data.push(params.get(7).copied().unwrap_or(0));
+                event(ev::DEVICE_ADDED, index, &data, Some(socket));
+            } else {
+                event(ev::DEVICE_REMOVED, index, address, Some(socket));
+            }
+        }
+        op::GET_DEVICE_FLAGS => {
+            let Some(address) = params.get(..7) else {
+                return reply(STATUS_INVALID_PARAMS, &[]);
+            };
+            let mut data = address.to_vec();
+            data.extend_from_slice(&[0; 8]);
+            reply(STATUS_SUCCESS, &data);
+        }
+        op::SET_DEVICE_FLAGS => {
+            let Some(address) = params.get(..7) else {
+                return reply(STATUS_INVALID_PARAMS, &[]);
+            };
+            reply(STATUS_SUCCESS, address);
+        }
+        op::UNPAIR_DEVICE => {
+            let Some((address, address_type)) = address_of(params) else {
+                return reply(STATUS_INVALID_PARAMS, &[]);
+            };
+            let known = {
+                let mut state = device.state.lock();
+                let count = state.link_keys.len() + state.ltks.len();
+                state.link_keys.retain(|key| key.address != address);
+                state.ltks.retain(|key| key.address != address);
+                count != state.link_keys.len() + state.ltks.len()
+            };
+            // Asked to: its link closes too.
+            if params.get(7).copied().unwrap_or(0) != 0 {
+                if let Some(handle) = crate::link::handle_of(device, &address, crate::link::is_le_type(address_type)) {
+                    let _ = crate::link::disconnect(device, handle, 0x13);
+                }
+            }
+            if known || address_type != ADDR_BREDR {
+                reply(STATUS_SUCCESS, &params[..7]);
+                event(ev::DEVICE_UNPAIRED, index, &params[..7], Some(socket));
+            } else {
+                reply(0x06, &params[..7]);
+            }
+        }
+        _ => reply(STATUS_UNKNOWN_COMMAND, &[]),
+    }
+}
diff --git a/kernel/comps/bluetooth/src/pairing.rs b/kernel/comps/bluetooth/src/pairing.rs
new file mode 100755
index 0000000..febbe83
--- /dev/null
+++ b/kernel/comps/bluetooth/src/pairing.rs
@@ -0,0 +1,478 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Pairing and link security on BR/EDR, as Linux's `hci_event.c` and
+//! `mgmt.c` run them with the controller doing Secure Simple Pairing: the
+//! management interface's `PAIR_DEVICE` (and its answer once done), keys
+//! bluetoothd loaded given back on `Link Key Request`, our IO capability
+//! and authentication requirements, the confirmation, passkey and PIN
+//! requests that go to bluetoothd's agent, new link keys for bluetoothd to
+//! store, and authentication then encryption when a channel needs them.
+//! Just Works with neither side asking for protection against a man in the
+//! middle is accepted without asking, as Linux does.
+
+use alloc::{sync::{Arc, Weak}, vec::Vec};
+
+use crate::{
+    device::Device,
+    hci,
+    link::{self, Action, SECURITY_HIGH, SECURITY_MEDIUM},
+    l2cap,
+    mgmt::{self, ADDR_BREDR, LinkKey, STATUS_AUTH_FAILED, STATUS_SUCCESS},
+    smp,
+    socket::Socket,
+};
+
+/// IO capabilities.
+pub(crate) const IO_DISPLAY_YESNO: u8 = 0x01;
+pub(crate) const IO_NO_INPUT_OUTPUT: u8 = 0x03;
+pub(crate) const IO_KEYBOARD_DISPLAY: u8 = 0x04;
+/// Authentication requirements.
+const AT_NO_BONDING: u8 = 0x00;
+const AT_DEDICATED_BONDING: u8 = 0x02;
+const AT_GENERAL_BONDING: u8 = 0x04;
+
+/// A pairing the management interface asked for, answered when done.
+pub(crate) struct Request {
+    pub socket: Weak<Socket>,
+    pub address: [u8; 6],
+    pub address_type: u8,
+    pub io_capability: u8,
+}
+
+/// Starts pairing with a device (`MGMT_OP_PAIR_DEVICE`).
+pub(crate) fn pair(device: &Device, socket: &Arc<Socket>, address: [u8; 6], address_type: u8, io_capability: u8) -> Result<(), u8> {
+    {
+        let mut request = device.pairing.lock();
+        if request.is_some() {
+            return Err(mgmt::STATUS_BUSY);
+        }
+        *request = Some(Request { socket: Arc::downgrade(socket), address, address_type, io_capability });
+    }
+    if link::connect(device, address, address_type) {
+        if let Some(handle) = link::handle_of(device, &address, link::is_le_type(address_type)) {
+            link_up(device, handle, &address, link::is_le_type(address_type));
+        }
+    }
+    Ok(())
+}
+
+/// Ends the pairing asked for, with the management interface's answer.
+pub(crate) fn finish(device: &Device, address: &[u8; 6], status: u8) {
+    let request = {
+        let mut request = device.pairing.lock();
+        if !request.as_ref().is_some_and(|request| request.address == *address) {
+            return;
+        }
+        request.take().unwrap()
+    };
+    let Some(socket) = request.socket.upgrade() else { return };
+    let mut data = request.address.to_vec();
+    data.push(request.address_type);
+    mgmt::reply_later(&socket, mgmt::op::PAIR_DEVICE, device.index, status, &data);
+}
+
+/// Cancels the pairing asked for (`MGMT_OP_CANCEL_PAIR_DEVICE`).
+pub(crate) fn cancel(device: &Device, address: &[u8; 6]) -> bool {
+    let pending = device.pairing.lock().as_ref().is_some_and(|request| request.address == *address);
+    if pending {
+        finish(device, address, mgmt::STATUS_CANCELLED);
+        if let Some(handle) = link::handle_of(device, address, false) {
+            device.queue_action(Action::Disconnect(handle, 0x13));
+        }
+    }
+    pending
+}
+
+pub(crate) fn busy(device: &Device, address: &[u8; 6]) -> bool {
+    device.pairing.lock().as_ref().is_some_and(|request| request.address == *address)
+}
+
+fn requested(device: &Device, address: &[u8; 6]) -> Option<u8> {
+    device.pairing.lock().as_ref().filter(|request| request.address == *address).map(|request| request.io_capability)
+}
+
+/// The link for a pairing is up: authentication (BR/EDR) or SMP (LE).
+pub(crate) fn link_up(device: &Device, handle: u16, address: &[u8; 6], le: bool) {
+    if requested(device, address).is_none() {
+        return;
+    }
+    if le {
+        smp::pair(device, handle);
+    } else {
+        if let Some(link) = device.links.lock().by_handle(handle) {
+            link.securing = true;
+            link.local_auth = AT_DEDICATED_BONDING;
+        }
+        device.queue_action(Action::Command(hci::OP_AUTH_REQUESTED, handle.to_le_bytes().to_vec()));
+    }
+}
+
+pub(crate) fn link_failed(device: &Device, address: &[u8; 6], status: u8) {
+    finish(device, address, mgmt::status_of_hci(status));
+}
+
+pub(crate) fn link_down(device: &Device, address: &[u8; 6], _reason: u8) {
+    finish(device, address, mgmt::STATUS_DISCONNECTED);
+}
+
+/// A BR/EDR channel needs `level`: authentication, then encryption.
+pub(crate) fn secure(device: &Device, handle: u16, level: u8) {
+    let (authenticated, encrypted, securing) = {
+        let mut links = device.links.lock();
+        let Some(link) = links.by_handle(handle) else { return };
+        let state = (link.security >= level && link.key_type != 0xff, link.encrypted, link.securing);
+        if !state.2 {
+            link.securing = true;
+            if link.local_auth == AT_NO_BONDING {
+                link.local_auth = AT_GENERAL_BONDING;
+            }
+        }
+        state
+    };
+    if securing {
+        return;
+    }
+    if authenticated && !encrypted {
+        device.queue_action(Action::Command(hci::OP_SET_CONN_ENCRYPT, {
+            let mut params = handle.to_le_bytes().to_vec();
+            params.push(0x01);
+            params
+        }));
+    } else {
+        device.queue_action(Action::Command(hci::OP_AUTH_REQUESTED, handle.to_le_bytes().to_vec()));
+    }
+}
+
+fn address_of(params: &[u8]) -> Option<[u8; 6]> {
+    params.get(..6).map(|address| address.try_into().unwrap())
+}
+
+/// `Link Key Request`: a key bluetoothd stored, if any.
+pub(crate) fn link_key_request(device: &Device, params: &[u8]) {
+    let Some(address) = address_of(params) else { return };
+    let key = device.state.lock().link_keys.iter().find(|key| key.address == address).copied();
+    match key {
+        Some(key) => {
+            let mut reply = address.to_vec();
+            reply.extend_from_slice(&key.value);
+            if let Some(link) = device.links.lock().by_address(&address, false) {
+                link.key_type = key.kind;
+                link.security = security_of(key.kind, key.pin_length);
+            }
+            device.queue_action(Action::Command(hci::OP_LINK_KEY_REPLY, reply));
+        }
+        None => device.queue_action(Action::Command(hci::OP_LINK_KEY_NEG_REPLY, address.to_vec())),
+    }
+}
+
+/// The security a link key gives: authenticated ones (P-192, P-256, a
+/// 16-digit PIN) high, the others medium.
+fn security_of(kind: u8, pin_length: u8) -> u8 {
+    match kind {
+        0x05 | 0x08 => SECURITY_HIGH,
+        0x00 if pin_length == 16 => SECURITY_HIGH,
+        _ => SECURITY_MEDIUM,
+    }
+}
+
+/// `IO Capability Request`: ours, with the protection we want.
+pub(crate) fn io_capability_request(device: &Device, params: &[u8]) {
+    let Some(address) = address_of(params) else { return };
+    let (bondable, default_io) = {
+        let state = device.state.lock();
+        (state.settings & mgmt::settings::BONDABLE != 0, state.io_capability)
+    };
+    let initiated = requested(device, &address);
+    let io = initiated.unwrap_or(default_io);
+    let io = if io == IO_KEYBOARD_DISPLAY { IO_DISPLAY_YESNO } else { io };
+    let reply = {
+        let mut links = device.links.lock();
+        let Some(link) = links.by_address(&address, false) else { return };
+        let remote_auth = link.remote_io.map(|(_, auth)| auth);
+        if !(bondable || initiated.is_some() || remote_auth.is_some_and(|auth| auth & !0x01 == AT_NO_BONDING)) {
+            None
+        } else {
+            let mut auth = if initiated.is_some() {
+                AT_DEDICATED_BONDING
+            } else if link.local_auth != AT_NO_BONDING {
+                link.local_auth
+            } else if bondable {
+                AT_GENERAL_BONDING
+            } else {
+                AT_NO_BONDING
+            };
+            match link.remote_io {
+                // We start: protection if our IO allows it.
+                None => {
+                    if io != IO_NO_INPUT_OUTPUT && auth != AT_NO_BONDING {
+                        auth |= 0x01;
+                    }
+                }
+                Some((remote_io, remote_auth)) => {
+                    auth = if remote_auth & !0x01 == AT_NO_BONDING {
+                        remote_auth | (auth & 0x01)
+                    } else if remote_io != IO_NO_INPUT_OUTPUT && io != IO_NO_INPUT_OUTPUT {
+                        remote_auth | 0x01
+                    } else {
+                        (remote_auth & !0x01) | (auth & 0x01)
+                    };
+                }
+            }
+            if !bondable && initiated.is_none() {
+                auth &= 0x01;
+            }
+            link.local_auth = auth;
+            Some((io, auth))
+        }
+    };
+    match reply {
+        Some((io, auth)) => {
+            let mut params = address.to_vec();
+            params.extend_from_slice(&[io, 0x00, auth]);
+            device.queue_action(Action::Command(hci::OP_IO_CAPABILITY_REPLY, params));
+        }
+        None => {
+            // Pairing not allowed.
+            let mut params = address.to_vec();
+            params.push(0x18);
+            device.queue_action(Action::Command(hci::OP_IO_CAPABILITY_NEG_REPLY, params));
+        }
+    }
+}
+
+/// `IO Capability Response`: the device's.
+pub(crate) fn io_capability_response(device: &Device, params: &[u8]) {
+    let Some(address) = address_of(params) else { return };
+    if params.len() < 9 {
+        return;
+    }
+    if let Some(link) = device.links.lock().by_address(&address, false) {
+        link.remote_io = Some((params[6], params[8]));
+    }
+}
+
+/// `User Confirmation Request`: accepted here when neither side wants
+/// protection (Just Works), else bluetoothd's agent decides.
+pub(crate) fn user_confirm_request(device: &Device, params: &[u8]) {
+    let Some(address) = address_of(params) else { return };
+    let value = params.get(6..10).map_or(0, |value| u32::from_le_bytes(value.try_into().unwrap()));
+    let initiated = requested(device, &address).is_some();
+    let default_io = device.state.lock().io_capability;
+    let io = requested(device, &address).unwrap_or(default_io);
+    let (local_mitm, remote_mitm, remote_io, securing) = {
+        let mut links = device.links.lock();
+        let Some(link) = links.by_address(&address, false) else { return };
+        let (remote_io, remote_auth) = link.remote_io.unwrap_or((IO_NO_INPUT_OUTPUT, 0));
+        (link.local_auth & 0x01 != 0, remote_auth & 0x01 != 0, remote_io, link.securing)
+    };
+    let has_key = device.state.lock().link_keys.iter().any(|key| key.address == address);
+    let mut confirm_hint = 0u8;
+    if (!local_mitm || remote_io == IO_NO_INPUT_OUTPUT) && (!remote_mitm || io == IO_NO_INPUT_OUTPUT) {
+        let we_started = initiated || securing;
+        if !we_started && io != IO_NO_INPUT_OUTPUT && (local_mitm || remote_mitm) {
+            confirm_hint = 1;
+        } else if has_key {
+            confirm_hint = 1;
+        } else {
+            device.queue_action(Action::Command(hci::OP_USER_CONFIRM_REPLY, address.to_vec()));
+            return;
+        }
+    }
+    let mut event = address.to_vec();
+    event.push(ADDR_BREDR);
+    event.push(confirm_hint);
+    event.extend_from_slice(&value.to_le_bytes());
+    mgmt::event_to_all(mgmt::ev::USER_CONFIRM_REQUEST, device.index, &event);
+}
+
+/// `User Passkey Request`: the agent asks the user.
+pub(crate) fn user_passkey_request(device: &Device, params: &[u8]) {
+    let Some(address) = address_of(params) else { return };
+    let mut event = address.to_vec();
+    event.push(ADDR_BREDR);
+    mgmt::event_to_all(mgmt::ev::USER_PASSKEY_REQUEST, device.index, &event);
+}
+
+/// `User Passkey Notification`: the agent shows it.
+pub(crate) fn passkey_notification(device: &Device, params: &[u8]) {
+    let Some(address) = address_of(params) else { return };
+    let passkey = params.get(6..10).map_or(0, |value| u32::from_le_bytes(value.try_into().unwrap()));
+    let mut event = address.to_vec();
+    event.push(ADDR_BREDR);
+    event.extend_from_slice(&passkey.to_le_bytes());
+    event.push(0);
+    mgmt::event_to_all(mgmt::ev::PASSKEY_NOTIFY, device.index, &event);
+}
+
+/// `PIN Code Request` (legacy pairing): the agent asks the user.
+pub(crate) fn pin_code_request(device: &Device, params: &[u8]) {
+    let Some(address) = address_of(params) else { return };
+    let mut event = address.to_vec();
+    event.push(ADDR_BREDR);
+    event.push(0);
+    mgmt::event_to_all(mgmt::ev::PIN_CODE_REQUEST, device.index, &event);
+}
+
+/// `Simple Pairing Complete`: a failure ends the pairing.
+pub(crate) fn simple_pairing_complete(device: &Device, params: &[u8]) {
+    let (Some(&status), Some(address)) = (params.first(), params.get(1..7)) else { return };
+    let address: [u8; 6] = address.try_into().unwrap();
+    if status != 0 {
+        auth_failed(device, &address, status);
+    }
+}
+
+fn auth_failed(device: &Device, address: &[u8; 6], status: u8) {
+    if busy(device, address) {
+        finish(device, address, STATUS_AUTH_FAILED);
+    } else {
+        let mut event = address.to_vec();
+        event.push(ADDR_BREDR);
+        event.push(mgmt::status_of_hci(status));
+        mgmt::event_to_all(mgmt::ev::AUTH_FAILED, device.index, &event);
+    }
+}
+
+/// `Link Key Notification`: bluetoothd stores the new key.
+pub(crate) fn link_key_notification(device: &Device, params: &[u8]) {
+    if params.len() < 23 {
+        return;
+    }
+    let address: [u8; 6] = params[..6].try_into().unwrap();
+    let value: [u8; 16] = params[6..22].try_into().unwrap();
+    let kind = params[22];
+    // Debug keys and keys of pairings without bonding are not kept.
+    let bonding = {
+        let mut links = device.links.lock();
+        let link = links.by_address(&address, false);
+        let local = link.as_ref().map_or(AT_GENERAL_BONDING, |link| link.local_auth);
+        let remote = link.as_ref().and_then(|link| link.remote_io).map_or(AT_GENERAL_BONDING, |(_, auth)| auth);
+        if let Some(link) = link {
+            link.key_type = kind;
+            link.security = security_of(kind, 0);
+        }
+        kind != 0x03 && (local & !0x01 != AT_NO_BONDING || remote & !0x01 != AT_NO_BONDING)
+    };
+    remember_link_key(device, address, kind, value, bonding);
+}
+
+/// Link key types (`HCI_LK_*`) Secure Connections gives: P-256, without and
+/// with a man-in-the-middle check.
+pub(crate) const KEY_UNAUTHENTICATED_P256: u8 = 0x07;
+pub(crate) const KEY_AUTHENTICATED_P256: u8 = 0x08;
+
+/// Keeps a device's link key (for its next authentication) and tells
+/// bluetoothd, which stores it when `bonding`.
+pub(crate) fn remember_link_key(device: &Device, address: [u8; 6], kind: u8, value: [u8; 16], bonding: bool) {
+    let key = LinkKey { address, address_type: ADDR_BREDR, kind, value, pin_length: 0 };
+    {
+        let mut state = device.state.lock();
+        state.link_keys.retain(|known| known.address != address);
+        state.link_keys.push(key);
+    }
+    let mut event = vec_with(bonding as u8);
+    event.extend_from_slice(&address);
+    event.push(ADDR_BREDR);
+    event.push(kind);
+    event.extend_from_slice(&value);
+    event.push(0);
+    mgmt::event_to_all(mgmt::ev::NEW_LINK_KEY, device.index, &event);
+}
+
+fn vec_with(byte: u8) -> Vec<u8> {
+    let mut bytes = Vec::with_capacity(26);
+    bytes.push(byte);
+    bytes
+}
+
+/// `Authentication Complete`: the pairing asked for is done; channels go
+/// on to encryption.
+pub(crate) fn authentication_complete(device: &Device, params: &[u8]) {
+    if params.len() < 3 {
+        return;
+    }
+    let (status, handle) = (params[0], u16::from_le_bytes([params[1], params[2]]) & 0x0fff);
+    let Some((address, _, false)) = link::peer_of(device, handle) else { return };
+    let encrypted = {
+        let mut links = device.links.lock();
+        let Some(link) = links.by_handle(handle) else { return };
+        if status != 0 {
+            link.securing = false;
+        }
+        link.encrypted
+    };
+    if status != 0 {
+        auth_failed(device, &address, status);
+        l2cap::secured(device, handle, false);
+        return;
+    }
+    finish(device, &address, STATUS_SUCCESS);
+    if encrypted {
+        if let Some(link) = device.links.lock().by_handle(handle) {
+            link.securing = false;
+        }
+        l2cap::secured(device, handle, true);
+    } else {
+        let mut params = handle.to_le_bytes().to_vec();
+        params.push(0x01);
+        device.queue_action(Action::Command(hci::OP_SET_CONN_ENCRYPT, params));
+    }
+}
+
+/// `Encryption Change`: channels waiting for it go on (LE: keys follow).
+pub(crate) fn encryption_change(device: &Device, params: &[u8]) {
+    if params.len() < 4 {
+        return;
+    }
+    let (status, handle, enabled) = (params[0], u16::from_le_bytes([params[1], params[2]]) & 0x0fff, params[3] != 0);
+    let le = {
+        let mut links = device.links.lock();
+        let Some(link) = links.by_handle(handle) else { return };
+        link.encrypted = status == 0 && enabled;
+        link.securing = false;
+        link.le
+    };
+    if le {
+        smp::encryption_changed(device, handle, status == 0 && enabled);
+    } else {
+        l2cap::secured(device, handle, status == 0 && enabled);
+    }
+}
+
+/// The management interface's answers to the agent's questions, sent to
+/// the controller (`USER_CONFIRM_REPLY`, `USER_PASSKEY_REPLY`,
+/// `PIN_CODE_REPLY`, and their negative forms).
+pub(crate) fn agent_reply(device: &Device, opcode: u16, params: &[u8]) -> Result<(), u8> {
+    let Some(address) = address_of(params) else { return Err(mgmt::STATUS_INVALID_PARAMS) };
+    let address_type = params.get(6).copied().unwrap_or(ADDR_BREDR);
+    if link::is_le_type(address_type) {
+        return smp::agent_reply(device, opcode, &address, params);
+    }
+    if link::handle_of(device, &address, false).is_none() {
+        return Err(mgmt::STATUS_NOT_CONNECTED);
+    }
+    let (command, data): (u16, Vec<u8>) = match opcode {
+        mgmt::op::USER_CONFIRM_REPLY => (hci::OP_USER_CONFIRM_REPLY, address.to_vec()),
+        mgmt::op::USER_CONFIRM_NEG_REPLY => (hci::OP_USER_CONFIRM_NEG_REPLY, address.to_vec()),
+        mgmt::op::USER_PASSKEY_REPLY => {
+            let mut data = address.to_vec();
+            data.extend_from_slice(params.get(7..11).ok_or(mgmt::STATUS_INVALID_PARAMS)?);
+            (hci::OP_USER_PASSKEY_REPLY, data)
+        }
+        mgmt::op::USER_PASSKEY_NEG_REPLY => (hci::OP_USER_PASSKEY_NEG_REPLY, address.to_vec()),
+        mgmt::op::PIN_CODE_REPLY => {
+            let length = *params.get(7).ok_or(mgmt::STATUS_INVALID_PARAMS)?;
+            let pin = params.get(8..24).ok_or(mgmt::STATUS_INVALID_PARAMS)?;
+            let mut data = address.to_vec();
+            data.push(length.min(16));
+            data.extend_from_slice(pin);
+            if let Some(link) = device.links.lock().by_address(&address, false) {
+                link.security = if length == 16 { SECURITY_HIGH } else { SECURITY_MEDIUM };
+            }
+            (hci::OP_PIN_CODE_REPLY, data)
+        }
+        mgmt::op::PIN_CODE_NEG_REPLY => (hci::OP_PIN_CODE_NEG_REPLY, address.to_vec()),
+        _ => return Err(mgmt::STATUS_INVALID_PARAMS),
+    };
+    device.command(command, &data).map(|_| ()).map_err(|_| mgmt::STATUS_FAILED)
+}
