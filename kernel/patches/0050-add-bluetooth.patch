diff --git a/kernel/comps/bluetooth/src/device.rs b/kernel/comps/bluetooth/src/device.rs
new file mode 100755
index 0000000..815a4b3
--- /dev/null
+++ b/kernel/comps/bluetooth/src/device.rs
@@ -0,0 +1,1039 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! A controller: what it said of itself when it was set up, what the
+//! management interface asked of it (its settings, name, class, services),
+//! the commands sent to it one at a time, and the events it sends back.
+//!
+//! Events are read where the driver hands them over (`receive`), without
+//! waiting for anything: a command's completion wakes whoever sent it,
+//! what discovery finds goes to the management sockets. Anything that has
+//! to send commands in answer runs in the component's task (`run`).
+
+use alloc::{
+    collections::{BTreeSet, VecDeque},
+    sync::Arc,
+    vec,
+    vec::Vec,
+};
+use core::sync::atomic::{AtomicBool, Ordering};
+
+use ostd::sync::{LocalIrqDisabled, Mutex, SpinLock, WaitQueue};
+
+use crate::{
+    Driver, hci, link,
+    mgmt::{self, settings},
+    now_ms, pairing, smp, socket,
+};
+
+/// How long a command may take before it is given up (Linux's
+/// `HCI_CMD_TIMEOUT`).
+const COMMAND_TIMEOUT_MS: u64 = 2000;
+/// How long LE scanning lasts in a discovery (Linux's 10.24 s).
+const LE_SCAN_MS: u64 = 10_240;
+
+/// Why a command did not complete.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum CommandError {
+    /// The controller answered with this status.
+    Status(u8),
+    Timeout,
+    /// The controller is gone, or the driver did not take the command.
+    Gone,
+}
+
+/// What the controller said of itself.
+#[derive(Clone, Copy, Debug, Default)]
+pub(crate) struct Info {
+    pub(crate) address: [u8; 6],
+    pub(crate) hci_version: u8,
+    pub(crate) manufacturer: u16,
+    pub(crate) features: [u8; 8],
+    pub(crate) acl_mtu: u16,
+    pub(crate) acl_packets: u16,
+    pub(crate) le_mtu: u16,
+    pub(crate) le_packets: u16,
+    /// The longest SCO packet's data the controller takes.
+    pub(crate) sco_mtu: u16,
+}
+
+impl Info {
+    pub(crate) fn bredr(&self) -> bool {
+        !hci::has_feature(&self.features, hci::FEATURE_NO_BREDR)
+    }
+
+    pub(crate) fn le(&self) -> bool {
+        hci::has_feature(&self.features, hci::FEATURE_LE)
+    }
+
+    pub(crate) fn ssp(&self) -> bool {
+        hci::has_feature(&self.features, hci::FEATURE_SIMPLE_PAIRING)
+    }
+
+    pub(crate) fn ext_inquiry(&self) -> bool {
+        hci::has_feature(&self.features, hci::FEATURE_EXT_INQUIRY)
+    }
+}
+
+/// A command in flight and, once it came, its outcome.
+struct Pending {
+    opcode: u16,
+    deadline: u64,
+    outcome: Option<Result<Vec<u8>, CommandError>>,
+}
+
+/// A discovery (`MGMT_OP_START_DISCOVERY`) under way.
+#[derive(Clone, Debug, Default)]
+pub(crate) struct Discovery {
+    /// The kinds of address asked for (BR/EDR, LE public, LE random).
+    pub(crate) kind: u8,
+    pub(crate) inquiry: bool,
+    pub(crate) le_scan: bool,
+    /// When LE scanning stops.
+    pub(crate) le_until: u64,
+    /// BR/EDR devices whose names are asked for once the inquiry is over.
+    pub(crate) names: Vec<[u8; 6]>,
+    /// A name request is out.
+    pub(crate) resolving: bool,
+    /// bluetoothd heard that it started: what is found goes out; until
+    /// then it waits, as Linux orders them.
+    pub(crate) announced: bool,
+    pub(crate) held: Vec<([u8; 6], u8, i8, u32, Vec<u8>)>,
+}
+
+/// An LE advertisement (`MGMT_OP_ADD_ADVERTISING`'s instance).
+pub(crate) struct Advertisement {
+    pub(crate) instance: u8,
+    /// `MGMT_ADV_FLAG_*`.
+    pub(crate) flags: u32,
+    pub(crate) data: Vec<u8>,
+    pub(crate) scan_rsp: Vec<u8>,
+}
+
+/// What the management interface set, and the controller's state.
+pub(crate) struct State {
+    /// Set up and announced (`MGMT_EV_INDEX_ADDED`).
+    pub(crate) ready: bool,
+    pub(crate) removed: bool,
+    pub(crate) info: Info,
+    pub(crate) settings: u32,
+    pub(crate) supported: u32,
+    /// The class of device (`MGMT_OP_SET_DEV_CLASS`), without the
+    /// service classes the UUIDs add.
+    pub(crate) major_minor: (u8, u8),
+    pub(crate) uuids: Vec<([u8; 16], u8)>,
+    pub(crate) name: Vec<u8>,
+    pub(crate) short_name: Vec<u8>,
+    pub(crate) io_capability: u8,
+    pub(crate) device_id: [u16; 4],
+    pub(crate) link_keys: Vec<mgmt::LinkKey>,
+    /// LE long-term keys bluetoothd loaded or pairing made.
+    pub(crate) ltks: Vec<smp::Ltk>,
+    pub(crate) discoverable_until: Option<u64>,
+    pub(crate) discovery: Option<Discovery>,
+    /// The LE appearance (`MGMT_OP_SET_APPEARANCE`).
+    pub(crate) appearance: u16,
+    /// The advertisement a program added.
+    pub(crate) advertisement: Option<Advertisement>,
+    /// Devices whose names the inquiry already gave.
+    pub(crate) named: BTreeSet<[u8; 6]>,
+    pending: Option<Pending>,
+    /// Vendor events (code 0xff) kept for a vendor set-up that waits for
+    /// them, while it does.
+    vendor_events: Option<VecDeque<Vec<u8>>>,
+}
+
+pub(crate) struct Device {
+    pub(crate) index: u16,
+    driver: Arc<dyn Driver>,
+    pub(crate) state: SpinLock<State, LocalIrqDisabled>,
+    /// One command at a time.
+    command_lock: Mutex<()>,
+    command_wait: WaitQueue,
+    /// One management operation at a time.
+    pub(crate) mgmt_lock: Mutex<()>,
+    /// The task has work for this device (set up, a discovery to end).
+    pub(crate) needs_task: AtomicBool,
+    /// Its links to devices.
+    pub(crate) links: SpinLock<link::Links, LocalIrqDisabled>,
+    /// Commands the task sends for the links, in order.
+    actions: SpinLock<VecDeque<link::Action>, LocalIrqDisabled>,
+    /// The pairing the management interface asked for.
+    pub(crate) pairing: SpinLock<Option<pairing::Request>, LocalIrqDisabled>,
+    /// Its radio switch, once set up.
+    pub(crate) rfkill: SpinLock<Option<Arc<aster_rfkill::Switch>>, LocalIrqDisabled>,
+}
+
+impl Device {
+    pub(crate) fn new(index: u16, driver: Arc<dyn Driver>) -> Arc<Self> {
+        Arc::new(Self {
+            index,
+            driver,
+            state: SpinLock::new(State {
+                ready: false,
+                removed: false,
+                info: Info::default(),
+                settings: 0,
+                supported: 0,
+                major_minor: (0, 0),
+                uuids: Vec::new(),
+                name: Vec::new(),
+                short_name: Vec::new(),
+                io_capability: 0x03,
+                device_id: [0; 4],
+                link_keys: Vec::new(),
+                ltks: Vec::new(),
+                discoverable_until: None,
+                discovery: None,
+                appearance: 0,
+                advertisement: None,
+                named: BTreeSet::new(),
+                pending: None,
+                vendor_events: None,
+            }),
+            command_lock: Mutex::new(()),
+            command_wait: WaitQueue::new(),
+            mgmt_lock: Mutex::new(()),
+            needs_task: AtomicBool::new(true),
+            links: SpinLock::new(link::Links::new()),
+            actions: SpinLock::new(VecDeque::new()),
+            pairing: SpinLock::new(None),
+            rfkill: SpinLock::new(None),
+        })
+    }
+
+    /// Its radio is switched off (rfkill).
+    pub(crate) fn is_rfkilled(&self) -> bool {
+        self.rfkill.lock().as_ref().is_some_and(|switch| switch.is_blocked())
+    }
+
+    /// Powers the controller off: discovery stops, links close (as Linux
+    /// closes them, "powered off"), scans and advertising stop.
+    pub(crate) fn power_off(&self) {
+        self.stop_discovery();
+        let handles: Vec<u16> = self.links.lock().links.iter().map(|link| link.handle).collect();
+        for handle in handles {
+            let _ = link::disconnect(self, handle, 0x15);
+        }
+        {
+            let mut state = self.state.lock();
+            state.settings &= !settings::POWERED;
+            state.discoverable_until = None;
+        }
+        self.apply_scan();
+        self.apply_advertising();
+    }
+
+    /// A command for the task to send (an answer to an event).
+    pub(crate) fn queue_action(&self, action: link::Action) {
+        self.actions.lock().push_back(action);
+        crate::wake_task(self);
+    }
+
+    pub(crate) fn bus(&self) -> u8 {
+        self.driver.bus()
+    }
+
+    /// The USB vendor and product ids, for a USB controller.
+    pub(crate) fn usb_ids(&self) -> Option<(u16, u16)> {
+        self.driver.usb_ids()
+    }
+
+    /// Tells the driver the controller is in its boot loader (Intel's), or
+    /// out of it.
+    pub(crate) fn set_bootloader(&self, on: bool) {
+        self.driver.set_bootloader(on);
+    }
+
+    /// Sends a command whose completion nobody waits for (one the
+    /// controller does not acknowledge: a reset into new firmware).
+    pub(crate) fn send_command(&self, opcode: u16, params: &[u8]) -> bool {
+        self.send_packet(hci::COMMAND_PKT, &hci::command(opcode, params))
+    }
+
+    /// Starts (afresh) or stops keeping vendor events.
+    pub(crate) fn watch_vendor_events(&self, on: bool) {
+        self.state.lock().vendor_events = on.then(VecDeque::new);
+    }
+
+    /// Waits for a vendor event whose first parameter is `kind`; returns
+    /// its parameters.
+    pub(crate) fn wait_vendor_event(&self, kind: u8, timeout_ms: u64) -> Option<Vec<u8>> {
+        let deadline = now_ms() + timeout_ms;
+        crate::COMMANDS_PENDING.fetch_add(1, Ordering::AcqRel);
+        let event = self.command_wait.wait_until(|| {
+            let mut state = self.state.lock();
+            if state.removed {
+                return Some(None);
+            }
+            if let Some(events) = state.vendor_events.as_mut()
+                && let Some(position) = events.iter().position(|event| event.first() == Some(&kind))
+            {
+                return Some(events.remove(position));
+            }
+            (now_ms() >= deadline).then_some(None)
+        });
+        crate::COMMANDS_PENDING.fetch_sub(1, Ordering::AcqRel);
+        event
+    }
+
+    /// The settings as the management interface reports them.
+    pub(crate) fn settings(&self) -> u32 {
+        self.state.lock().settings & !settings::HIDDEN
+    }
+
+    pub(crate) fn is_powered(&self) -> bool {
+        self.settings() & settings::POWERED != 0
+    }
+
+    /// Sends a packet to the controller, and to the monitor sockets.
+    pub(crate) fn send_packet(&self, packet_type: u8, packet: &[u8]) -> bool {
+        socket::monitor_packet(self.index, packet_type, false, packet);
+        self.driver.send(packet_type, packet)
+    }
+
+    /// Sends a command and waits for its completion (its return parameters
+    /// after the status) or, for a command the controller only starts, its
+    /// status.
+    pub(crate) fn command(&self, opcode: u16, params: &[u8]) -> Result<Vec<u8>, CommandError> {
+        let _one_at_a_time = self.command_lock.lock();
+        {
+            let mut state = self.state.lock();
+            if state.removed {
+                return Err(CommandError::Gone);
+            }
+            state.pending = Some(Pending {
+                opcode,
+                deadline: now_ms() + COMMAND_TIMEOUT_MS,
+                outcome: None,
+            });
+        }
+        crate::COMMANDS_PENDING.fetch_add(1, Ordering::AcqRel);
+        let outcome = if self.send_packet(hci::COMMAND_PKT, &hci::command(opcode, params)) {
+            self.command_wait.wait_until(|| {
+                let mut state = self.state.lock();
+                let (answered, deadline) = match &state.pending {
+                    Some(pending) => (pending.outcome.is_some(), pending.deadline),
+                    None => return Some(Err(CommandError::Gone)),
+                };
+                if answered {
+                    return state.pending.take().unwrap().outcome;
+                }
+                if state.removed {
+                    state.pending = None;
+                    return Some(Err(CommandError::Gone));
+                }
+                if now_ms() >= deadline {
+                    state.pending = None;
+                    return Some(Err(CommandError::Timeout));
+                }
+                None
+            })
+        } else {
+            self.state.lock().pending = None;
+            Err(CommandError::Gone)
+        };
+        crate::COMMANDS_PENDING.fetch_sub(1, Ordering::AcqRel);
+        if let Err(error) = outcome {
+            if error != CommandError::Status(hci::STATUS_UNKNOWN_COMMAND) {
+                ostd::debug!("hci{}: command {:#06x} failed: {:?}", self.index, opcode, error);
+            }
+        }
+        outcome
+    }
+
+    /// A device found: to the management sockets once they know the
+    /// discovery started.
+    fn report_found(&self, address: &[u8; 6], address_type: u8, rssi: i8, flags: u32, eir: &[u8]) {
+        {
+            let mut state = self.state.lock();
+            if let Some(discovery) = state.discovery.as_mut().filter(|discovery| !discovery.announced) {
+                discovery.held.push((*address, address_type, rssi, flags, eir.to_vec()));
+                return;
+            }
+        }
+        mgmt::device_found(self.index, address, address_type, rssi, flags, eir);
+    }
+
+    /// The discovery was announced: what it found meanwhile goes out.
+    pub(crate) fn discovery_announced(&self) {
+        let held = {
+            let mut state = self.state.lock();
+            let Some(discovery) = state.discovery.as_mut() else { return };
+            discovery.announced = true;
+            core::mem::take(&mut discovery.held)
+        };
+        for (address, address_type, rssi, flags, eir) in held {
+            mgmt::device_found(self.index, &address, address_type, rssi, flags, &eir);
+        }
+    }
+
+    /// Wakes a command waiting for its time-out (the timer does, now and
+    /// then, while one is out).
+    pub(crate) fn wake_commands(&self) {
+        self.command_wait.wake_all();
+    }
+
+    /// The controller's set-up, in the task: what Linux reads when it
+    /// registers a controller. Then the management sockets hear of it.
+    pub(crate) fn set_up(&self) -> Result<(), CommandError> {
+        // The vendor's part first: firmware to boot, a patch to load.
+        crate::vendor::setup(self)?;
+        self.command(hci::OP_RESET, &[])?;
+        let features = self.command(hci::OP_READ_LOCAL_FEATURES, &[])?;
+        let version = self.command(hci::OP_READ_LOCAL_VERSION, &[])?;
+        let address = self.command(hci::OP_READ_BD_ADDR, &[])?;
+        let buffers = self.command(hci::OP_READ_BUFFER_SIZE, &[])?;
+        let mut info = Info::default();
+        if features.len() < 8 || version.len() < 8 || address.len() < 6 || buffers.len() < 7 {
+            return Err(CommandError::Status(0xff));
+        }
+        info.features.copy_from_slice(&features[..8]);
+        info.hci_version = version[0];
+        info.manufacturer = hci::le16(&version, 4).unwrap_or(0);
+        info.address.copy_from_slice(&address[..6]);
+        info.acl_mtu = hci::le16(&buffers, 0).unwrap_or(0);
+        info.acl_packets = hci::le16(&buffers, 3).unwrap_or(0);
+        info.sco_mtu = buffers[2] as u16;
+
+        let name = self.command(hci::OP_READ_LOCAL_NAME, &[]).unwrap_or_default();
+        let class = self.command(hci::OP_READ_CLASS_OF_DEV, &[]).unwrap_or_default();
+
+        // Linux's event mask for a dual-mode controller, LE meta events in.
+        self.command(hci::OP_SET_EVENT_MASK, &[0xff, 0xff, 0xfb, 0xff, 0x07, 0xf8, 0xbf, 0x3d])?;
+        if info.le() {
+            let le_buffers = self.command(hci::OP_LE_READ_BUFFER_SIZE, &[]).unwrap_or_default();
+            info.le_mtu = hci::le16(&le_buffers, 0).unwrap_or(0);
+            info.le_packets = le_buffers.get(2).copied().unwrap_or(0) as u16;
+            let _ = self.command(hci::OP_LE_READ_LOCAL_FEATURES, &[]);
+            // Connections, advertising reports, connection updates, remote
+            // features, long-term key requests.
+            let _ = self.command(hci::OP_LE_SET_EVENT_MASK, &[0x1f, 0, 0, 0, 0, 0, 0, 0]);
+        }
+        if info.bredr() {
+            // Inquiry results with the extended response (names, services)
+            // or at least the signal strength.
+            let mode = if info.ext_inquiry() {
+                2
+            } else if hci::has_feature(&info.features, hci::FEATURE_RSSI_INQUIRY) {
+                1
+            } else {
+                0
+            };
+            let _ = self.command(hci::OP_WRITE_INQUIRY_MODE, &[mode]);
+            // Page and inquiry scans off until the host asks.
+            let _ = self.command(hci::OP_WRITE_SCAN_ENABLE, &[0]);
+        }
+
+        let mut state = self.state.lock();
+        state.info = info;
+        state.supported = mgmt::supported_settings(&info);
+        state.settings = if info.bredr() { settings::BREDR } else { settings::LE };
+        if let Some(class) = class.get(..3) {
+            state.major_minor = (class[1] & 0x1f, class[0]);
+        }
+        let end = name.iter().position(|byte| *byte == 0).unwrap_or(name.len());
+        state.name = name[..end].to_vec();
+        state.ready = true;
+        drop(state);
+        link::set_credits(self);
+        Ok(())
+    }
+
+    /// The class of device: major and minor class, and the service classes
+    /// the registered UUIDs name.
+    pub(crate) fn class_of_device(state: &State) -> [u8; 3] {
+        let services = state.uuids.iter().fold(0u8, |acc, (_, hint)| acc | hint);
+        [state.major_minor.1, state.major_minor.0, services]
+    }
+
+    /// The extended inquiry response: the name, the 16-bit service UUIDs,
+    /// the device ID.
+    pub(crate) fn eir(state: &State) -> Vec<u8> {
+        let mut eir = Vec::with_capacity(240);
+        if !state.name.is_empty() {
+            let (name, kind) = if state.name.len() > 48 { (&state.name[..48], 0x08) } else { (&state.name[..], 0x09) };
+            eir.push(name.len() as u8 + 1);
+            eir.push(kind);
+            eir.extend_from_slice(name);
+        }
+        if state.device_id[0] != 0 {
+            eir.extend_from_slice(&[9, 0x10]);
+            for value in state.device_id {
+                eir.extend_from_slice(&value.to_le_bytes());
+            }
+        }
+        let uuid16: Vec<u16> = state.uuids.iter().filter_map(|(uuid, _)| mgmt::uuid16(uuid)).collect();
+        if !uuid16.is_empty() {
+            let count = uuid16.len().min((240 - eir.len() - 2) / 2);
+            eir.push(count as u8 * 2 + 1);
+            eir.push(0x03);
+            for uuid in &uuid16[..count] {
+                eir.extend_from_slice(&uuid.to_le_bytes());
+            }
+        }
+        eir.resize(240, 0);
+        eir
+    }
+
+    /// Puts the settings, name, class and services in force on the
+    /// controller (it is powered).
+    pub(crate) fn apply(&self) {
+        let (info, settings, class, name, eir) = {
+            let state = self.state.lock();
+            let mut name = state.name.clone();
+            name.resize(248, 0);
+            (state.info, state.settings, Self::class_of_device(&state), name, Self::eir(&state))
+        };
+        if info.bredr() {
+            if info.ssp() {
+                let _ = self.command(hci::OP_WRITE_SSP_MODE, &[(settings & settings::SSP != 0) as u8]);
+            }
+            let _ = self.command(hci::OP_WRITE_AUTH_ENABLE, &[(settings & settings::LINK_SECURITY != 0) as u8]);
+            let _ = self.command(hci::OP_WRITE_CLASS_OF_DEV, &class);
+            let _ = self.command(hci::OP_WRITE_LOCAL_NAME, &name);
+            if info.ext_inquiry() {
+                let mut params = vec![0u8];
+                params.extend_from_slice(&eir);
+                let _ = self.command(hci::OP_WRITE_EXT_INQUIRY_RESPONSE, &params);
+            }
+        }
+        if info.le() && info.bredr() {
+            let _ = self.command(hci::OP_WRITE_LE_HOST_SUPPORTED, &[(settings & settings::LE != 0) as u8, 0]);
+        }
+        self.apply_scan();
+        self.apply_advertising();
+    }
+
+    /// The fields the kernel adds to an advertisement (`MGMT_ADV_FLAG_*`):
+    /// the flags and the TX power in the data; the appearance and the
+    /// local name in the scan response.
+    pub(crate) fn advertising_fields(state: &State, flags: u32, scan_rsp: bool) -> Vec<u8> {
+        let mut fields = Vec::new();
+        if !scan_rsp {
+            let discoverable = state.settings & settings::DISCOVERABLE != 0;
+            if flags & (mgmt::ADV_FLAG_DISCOV | mgmt::ADV_FLAG_LIMITED_DISCOV | mgmt::ADV_FLAG_MANAGED_FLAGS) != 0 {
+                let mut value = 0u8;
+                if flags & mgmt::ADV_FLAG_LIMITED_DISCOV != 0 {
+                    value |= 0x01;
+                } else if flags & mgmt::ADV_FLAG_DISCOV != 0 || (flags & mgmt::ADV_FLAG_MANAGED_FLAGS != 0 && discoverable) {
+                    value |= 0x02;
+                }
+                if state.settings & settings::BREDR == 0 || !state.info.bredr() {
+                    value |= 0x04;
+                }
+                if value != 0 {
+                    fields.extend_from_slice(&[2, 0x01, value]);
+                }
+            }
+            if flags & mgmt::ADV_FLAG_TX_POWER != 0 {
+                fields.extend_from_slice(&[2, 0x0a, 0]);
+            }
+        } else {
+            if flags & mgmt::ADV_FLAG_APPEARANCE != 0 && state.appearance != 0 {
+                fields.extend_from_slice(&[3, 0x19]);
+                fields.extend_from_slice(&state.appearance.to_le_bytes());
+            }
+            if flags & mgmt::ADV_FLAG_LOCAL_NAME != 0 && !state.name.is_empty() {
+                let room = 31usize.saturating_sub(fields.len() + 2);
+                let (name, kind) = if state.name.len() > room { (&state.name[..room], 0x08) } else { (&state.name[..], 0x09) };
+                if !name.is_empty() {
+                    fields.push(name.len() as u8 + 1);
+                    fields.push(kind);
+                    fields.extend_from_slice(name);
+                }
+            }
+        }
+        fields
+    }
+
+    /// LE advertising as the settings and the added advertisement say.
+    pub(crate) fn apply_advertising(&self) {
+        let (le, plan) = {
+            let state = self.state.lock();
+            let on = state.settings & settings::POWERED != 0 && state.settings & settings::LE != 0;
+            let plan = if !on {
+                None
+            } else if let Some(advertisement) = &state.advertisement {
+                let mut data = Self::advertising_fields(&state, advertisement.flags, false);
+                data.extend_from_slice(&advertisement.data);
+                let mut scan_rsp = Self::advertising_fields(&state, advertisement.flags, true);
+                scan_rsp.extend_from_slice(&advertisement.scan_rsp);
+                let connectable = advertisement.flags & mgmt::ADV_FLAG_CONNECTABLE != 0
+                    || state.settings & settings::CONNECTABLE != 0;
+                Some((data, scan_rsp, connectable))
+            } else if state.settings & settings::ADVERTISING != 0 {
+                let data = Self::advertising_fields(&state, mgmt::ADV_FLAGS_INSTANCE_0, false);
+                let scan_rsp = Self::advertising_fields(&state, mgmt::ADV_FLAGS_INSTANCE_0, true);
+                let connectable = state.settings & (settings::CONNECTABLE | settings::ADV_CONNECTABLE) != 0;
+                Some((data, scan_rsp, connectable))
+            } else {
+                None
+            };
+            (state.info.le(), plan)
+        };
+        if !le {
+            return;
+        }
+        let _ = self.command(hci::OP_LE_SET_ADV_ENABLE, &[0]);
+        let Some((data, scan_rsp, connectable)) = plan else {
+            return;
+        };
+        // ADV_IND when connectable, ADV_SCAN_IND with a scan response,
+        // ADV_NONCONN_IND otherwise: every 1.28 s on every channel, from
+        // the public address.
+        let kind = if connectable {
+            0x00
+        } else if !scan_rsp.is_empty() {
+            0x02
+        } else {
+            0x03
+        };
+        let mut params = Vec::with_capacity(15);
+        params.extend_from_slice(&0x0800u16.to_le_bytes());
+        params.extend_from_slice(&0x0800u16.to_le_bytes());
+        params.extend_from_slice(&[kind, 0x00, 0x00, 0, 0, 0, 0, 0, 0, 0x07, 0x00]);
+        let _ = self.command(hci::OP_LE_SET_ADV_PARAMS, &params);
+        for (opcode, bytes) in [(hci::OP_LE_SET_ADV_DATA, &data), (hci::OP_LE_SET_SCAN_RSP_DATA, &scan_rsp)] {
+            let length = bytes.len().min(31);
+            let mut params = vec![length as u8];
+            params.extend_from_slice(&bytes[..length]);
+            params.resize(32, 0);
+            let _ = self.command(opcode, &params);
+        }
+        let _ = self.command(hci::OP_LE_SET_ADV_ENABLE, &[1]);
+    }
+
+    /// Page and inquiry scans as the connectable and discoverable settings
+    /// say (none while powered off).
+    pub(crate) fn apply_scan(&self) {
+        let (bredr, settings) = {
+            let state = self.state.lock();
+            (state.info.bredr(), state.settings)
+        };
+        if !bredr {
+            return;
+        }
+        let mut scan = 0;
+        if settings & settings::POWERED != 0 && settings & settings::BREDR != 0 {
+            if settings & settings::CONNECTABLE != 0 {
+                scan |= 0x02;
+            }
+            if settings & settings::DISCOVERABLE != 0 {
+                scan |= 0x01;
+            }
+        }
+        let _ = self.command(hci::OP_WRITE_SCAN_ENABLE, &[scan]);
+    }
+
+    /// Starts a discovery of the kinds of address `kind` asks for.
+    pub(crate) fn start_discovery(&self, kind: u8) -> Result<(), u8> {
+        let (info, settings) = {
+            let state = self.state.lock();
+            if state.discovery.is_some() {
+                return Err(mgmt::STATUS_BUSY);
+            }
+            (state.info, state.settings)
+        };
+        let bredr = kind & mgmt::ADDR_BREDR_BIT != 0 && info.bredr() && settings & settings::BREDR != 0;
+        let le = kind & mgmt::ADDR_LE_BITS != 0 && info.le() && settings & settings::LE != 0;
+        if !bredr && !le {
+            return Err(mgmt::STATUS_REJECTED);
+        }
+        // The discovery is under way before the controller starts: what it
+        // finds at once is not lost.
+        {
+            let mut state = self.state.lock();
+            state.named.clear();
+            state.discovery = Some(Discovery {
+                kind,
+                le_scan: le,
+                le_until: now_ms() + LE_SCAN_MS,
+                inquiry: bredr,
+                ..Default::default()
+            });
+        }
+        let mut le_scan = false;
+        if le {
+            // Active scanning, as Linux's discovery: 60 ms window every 60 ms
+            // (0x60 Ã— 0.625 ms), from the public address, no filter.
+            let params = [0x01, 0x60, 0x00, 0x60, 0x00, 0x00, 0x00];
+            le_scan = self.command(hci::OP_LE_SET_SCAN_PARAMS, &params).is_ok()
+                && self.command(hci::OP_LE_SET_SCAN_ENABLE, &[0x01, 0x00]).is_ok();
+        }
+        let mut inquiry = false;
+        if bredr {
+            let mut params = hci::GIAC.to_vec();
+            params.extend_from_slice(&[hci::INQUIRY_LENGTH, 0x00]);
+            inquiry = self.command(hci::OP_INQUIRY, &params).is_ok();
+        }
+        let mut state = self.state.lock();
+        if !inquiry && !le_scan {
+            state.discovery = None;
+            return Err(mgmt::STATUS_FAILED);
+        }
+        if let Some(discovery) = state.discovery.as_mut() {
+            discovery.le_scan = le_scan;
+            discovery.inquiry &= inquiry;
+        }
+        Ok(())
+    }
+
+    /// Stops the discovery under way, if any, and says so.
+    pub(crate) fn stop_discovery(&self) -> Option<u8> {
+        let discovery = self.state.lock().discovery.clone()?;
+        if discovery.inquiry {
+            let _ = self.command(hci::OP_INQUIRY_CANCEL, &[]);
+        }
+        if discovery.le_scan {
+            let _ = self.command(hci::OP_LE_SET_SCAN_ENABLE, &[0x00, 0x00]);
+        }
+        if discovery.resolving {
+            let _ = self.command(hci::OP_REMOTE_NAME_REQ_CANCEL, &[0; 6]);
+        }
+        self.state.lock().discovery = None;
+        mgmt::discovering(self.index, discovery.kind, false);
+        Some(discovery.kind)
+    }
+
+    /// The task's work for this device: set it up, end LE scanning on
+    /// time, ask for names once the inquiry is over, end the discovery,
+    /// end discoverability on time. Whether it still waits on a time.
+    pub(crate) fn run(&self, now: u64) -> bool {
+        if !self.state.lock().ready && !self.state.lock().removed {
+            let _mgmt = self.mgmt_lock.lock();
+            match self.set_up() {
+                Ok(()) => {
+                    let info = self.state.lock().info;
+                    ostd::notice!(
+                        "hci{}: controller {:02x}:{:02x}:{:02x}:{:02x}:{:02x}:{:02x}, version {}, manufacturer {}{}{}",
+                        self.index,
+                        info.address[5], info.address[4], info.address[3], info.address[2], info.address[1], info.address[0],
+                        info.hci_version,
+                        info.manufacturer,
+                        if info.bredr() { ", BR/EDR" } else { "" },
+                        if info.le() { ", LE" } else { "" },
+                    );
+                    mgmt::index_added(self.index);
+                    // Its radio switch: blocked, it powers off.
+                    if let Some(me) = crate::device_at(self.index) {
+                        let weak = Arc::downgrade(&me);
+                        let switch = aster_rfkill::register(
+                            aster_rfkill::kind::BLUETOOTH,
+                            alloc::format!("hci{}", self.index),
+                            alloc::boxed::Box::new(move |blocked| {
+                                if let Some(device) = weak.upgrade() {
+                                    device.queue_action(link::Action::Rfkill(blocked));
+                                }
+                            }),
+                        );
+                        *self.rfkill.lock() = Some(switch);
+                    }
+                }
+                Err(error) => {
+                    ostd::warn!("hci{}: the controller did not set up: {:?}", self.index, error);
+                    self.state.lock().removed = true;
+                }
+            }
+        }
+
+        // Answers to events, in order; then the links' own business.
+        loop {
+            let Some(action) = self.actions.lock().pop_front() else { break };
+            link::act(self, action);
+        }
+        let mut waiting = link::tick(self, now);
+
+        let _mgmt = self.mgmt_lock.lock();
+
+        // Discoverable for a while only.
+        let expired = {
+            let mut state = self.state.lock();
+            match state.discoverable_until {
+                Some(until) if now >= until => {
+                    state.discoverable_until = None;
+                    state.settings &= !settings::DISCOVERABLE;
+                    true
+                }
+                Some(_) => {
+                    waiting = true;
+                    false
+                }
+                None => false,
+            }
+        };
+        if expired {
+            self.apply_scan();
+            mgmt::new_settings(self.index, None);
+        }
+
+        let Some(discovery) = self.state.lock().discovery.clone() else {
+            return waiting;
+        };
+        if discovery.le_scan && now >= discovery.le_until {
+            let _ = self.command(hci::OP_LE_SET_SCAN_ENABLE, &[0x00, 0x00]);
+            if let Some(discovery) = self.state.lock().discovery.as_mut() {
+                discovery.le_scan = false;
+            }
+        }
+        let discovery = self.state.lock().discovery.clone().unwrap_or_default();
+        if !discovery.inquiry && !discovery.resolving {
+            // Names after the inquiry, one at a time.
+            if let Some(address) = discovery.names.first().copied() {
+                let mut params = address.to_vec();
+                // Page scan repetition mode R2, clock offset unknown.
+                params.extend_from_slice(&[0x02, 0x00, 0x00, 0x00]);
+                let started = self.command(hci::OP_REMOTE_NAME_REQ, &params).is_ok();
+                if let Some(discovery) = self.state.lock().discovery.as_mut() {
+                    discovery.names.remove(0);
+                    discovery.resolving = started;
+                }
+                return true;
+            }
+            if !discovery.le_scan {
+                self.state.lock().discovery = None;
+                mgmt::discovering(self.index, discovery.kind, false);
+                return waiting;
+            }
+        }
+        true
+    }
+
+    /// A packet from the controller, as the driver hands it over.
+    pub(crate) fn receive(&self, packet_type: u8, packet: &[u8]) {
+        socket::monitor_packet(self.index, packet_type, true, packet);
+        if packet_type == hci::ACL_PKT {
+            link::receive_acl(self, packet);
+            return;
+        }
+        if packet_type == hci::SCO_PKT {
+            crate::sco::receive(self, packet);
+            return;
+        }
+        if packet_type != hci::EVENT_PKT || packet.len() < 2 {
+            return;
+        }
+        socket::raw_event(self.index, packet);
+        let (code, params) = (packet[0], &packet[2..]);
+        match code {
+            hci::EV_CMD_COMPLETE if params.len() >= 4 => {
+                let opcode = hci::le16(params, 1).unwrap();
+                let status = params[3];
+                let outcome = if status == hci::STATUS_SUCCESS {
+                    Ok(params[4..].to_vec())
+                } else {
+                    Err(CommandError::Status(status))
+                };
+                self.complete(opcode, outcome);
+            }
+            hci::EV_CMD_STATUS if params.len() >= 4 => {
+                let opcode = hci::le16(params, 2).unwrap();
+                let outcome = if params[0] == hci::STATUS_SUCCESS {
+                    Ok(Vec::new())
+                } else {
+                    Err(CommandError::Status(params[0]))
+                };
+                self.complete(opcode, outcome);
+            }
+            hci::EV_INQUIRY_COMPLETE => {
+                let mut state = self.state.lock();
+                if let Some(discovery) = state.discovery.as_mut() {
+                    discovery.inquiry = false;
+                }
+                drop(state);
+                crate::wake_task(self);
+            }
+            hci::EV_INQUIRY_RESULT | hci::EV_INQUIRY_RESULT_WITH_RSSI | hci::EV_EXTENDED_INQUIRY_RESULT => {
+                self.inquiry_result(code, params);
+            }
+            hci::EV_REMOTE_NAME if params.len() >= 7 => {
+                let mut address = [0u8; 6];
+                address.copy_from_slice(&params[1..7]);
+                if params[0] == hci::STATUS_SUCCESS {
+                    let name = &params[7..];
+                    let end = name.iter().position(|byte| *byte == 0).unwrap_or(name.len());
+                    let mut eir = vec![end as u8 + 1, 0x09];
+                    eir.extend_from_slice(&name[..end]);
+                    self.report_found(&address, mgmt::ADDR_BREDR, 0, 0, &eir);
+                } else {
+                    self.report_found(&address, mgmt::ADDR_BREDR, 0, mgmt::FOUND_NAME_REQUEST_FAILED, &[]);
+                }
+                if let Some(discovery) = self.state.lock().discovery.as_mut() {
+                    discovery.resolving = false;
+                }
+                crate::wake_task(self);
+            }
+            hci::EV_LE_META if !params.is_empty() && params[0] == hci::LE_EV_ADV_REPORT => {
+                self.advertising_report(&params[1..]);
+            }
+            hci::EV_LE_META if !params.is_empty() => match params[0] {
+                hci::LE_EV_CONN_COMPLETE => link::le_connection_complete(self, &params[1..], false),
+                hci::LE_EV_ENHANCED_CONN_COMPLETE => link::le_connection_complete(self, &params[1..], true),
+                hci::LE_EV_LTK_REQUEST => smp::ltk_request(self, &params[1..]),
+                _ => {}
+            },
+            hci::EV_CONN_REQUEST => link::connection_request(self, params),
+            hci::EV_CONN_COMPLETE => link::connection_complete(self, params),
+            hci::EV_DISCONN_COMPLETE => link::disconnection_complete(self, params),
+            hci::EV_SYNC_CONN_COMPLETE => link::sync_connection_complete(self, params),
+            hci::EV_SYNC_CONN_CHANGED => {}
+            hci::EV_REMOTE_FEATURES => link::remote_features(self, params),
+            hci::EV_REMOTE_EXT_FEATURES => link::remote_ext_features(self, params),
+            hci::EV_REMOTE_HOST_FEATURES => link::remote_host_features(self, params),
+            hci::EV_NUM_COMP_PKTS => link::completed_packets(self, params),
+            hci::EV_AUTH_COMPLETE => pairing::authentication_complete(self, params),
+            hci::EV_ENCRYPT_CHANGE => pairing::encryption_change(self, params),
+            hci::EV_ENCRYPT_KEY_REFRESH if params.len() >= 3 => {
+                pairing::encryption_change(self, &[params[0], params[1], params[2], (params[0] == 0) as u8]);
+            }
+            hci::EV_LINK_KEY_REQ => pairing::link_key_request(self, params),
+            hci::EV_LINK_KEY_NOTIFY => pairing::link_key_notification(self, params),
+            hci::EV_IO_CAPA_REQUEST => pairing::io_capability_request(self, params),
+            hci::EV_IO_CAPA_RESPONSE => pairing::io_capability_response(self, params),
+            hci::EV_USER_CONFIRM_REQUEST => pairing::user_confirm_request(self, params),
+            hci::EV_USER_PASSKEY_REQUEST => pairing::user_passkey_request(self, params),
+            hci::EV_USER_PASSKEY_NOTIFY => pairing::passkey_notification(self, params),
+            hci::EV_PIN_CODE_REQ => pairing::pin_code_request(self, params),
+            hci::EV_SIMPLE_PAIR_COMPLETE => pairing::simple_pairing_complete(self, params),
+            hci::EV_VENDOR => {
+                let mut state = self.state.lock();
+                if let Some(events) = state.vendor_events.as_mut() {
+                    events.push_back(params.to_vec());
+                    drop(state);
+                    self.command_wait.wake_all();
+                }
+            }
+            hci::EV_HARDWARE_ERROR => {
+                ostd::warn!("hci{}: hardware error {:#x}", self.index, params.first().copied().unwrap_or(0));
+            }
+            _ => {}
+        }
+    }
+
+    fn complete(&self, opcode: u16, outcome: Result<Vec<u8>, CommandError>) {
+        let mut state = self.state.lock();
+        if let Some(pending) = state.pending.as_mut()
+            && pending.opcode == opcode
+            && pending.outcome.is_none()
+        {
+            pending.outcome = Some(outcome);
+            drop(state);
+            self.command_wait.wake_all();
+        }
+    }
+
+    /// Inquiry results: each device found goes to the management sockets,
+    /// with its class (and RSSI and extended response when given).
+    fn inquiry_result(&self, code: u8, params: &[u8]) {
+        if self.state.lock().discovery.is_none() || params.is_empty() {
+            return;
+        }
+        let count = params[0] as usize;
+        let entry_len = match code {
+            hci::EV_INQUIRY_RESULT => 14,
+            hci::EV_INQUIRY_RESULT_WITH_RSSI => 14,
+            _ => 254,
+        };
+        for index in 0..count {
+            let Some(entry) = params.get(1 + index * entry_len..1 + (index + 1) * entry_len) else {
+                break;
+            };
+            let mut address = [0u8; 6];
+            address.copy_from_slice(&entry[..6]);
+            let class = &entry[8..11];
+            let (rssi, eir) = match code {
+                hci::EV_INQUIRY_RESULT => (127i8, &[][..]),
+                _ => (entry[13] as i8, if code == hci::EV_EXTENDED_INQUIRY_RESULT { &entry[14..] } else { &[][..] }),
+            };
+            let mut data = significant_eir(eir).to_vec();
+            if !has_field(&data, 0x0d) {
+                data.extend_from_slice(&[4, 0x0d]);
+                data.extend_from_slice(class);
+            }
+            let mut flags = 0;
+            if code != hci::EV_EXTENDED_INQUIRY_RESULT {
+                flags |= mgmt::FOUND_LEGACY_PAIRING;
+            }
+            let has_name = has_field(&data, 0x09) || has_field(&data, 0x08);
+            let mut state = self.state.lock();
+            if has_name {
+                state.named.insert(address);
+            } else if !state.named.contains(&address) {
+                flags |= mgmt::FOUND_CONFIRM_NAME;
+            }
+            drop(state);
+            self.report_found(&address, mgmt::ADDR_BREDR, rssi, flags, &data);
+        }
+    }
+
+    /// The host says whether it knows a device's name; one it does not is
+    /// asked for once the inquiry is over (`MGMT_OP_CONFIRM_NAME`).
+    pub(crate) fn confirm_name(&self, address: [u8; 6], known: bool) {
+        let mut state = self.state.lock();
+        let Some(discovery) = state.discovery.as_mut() else {
+            return;
+        };
+        if !known && !discovery.names.contains(&address) {
+            discovery.names.push(address);
+        }
+    }
+
+    /// LE advertising reports: each one goes to the management sockets
+    /// while a discovery scans.
+    fn advertising_report(&self, params: &[u8]) {
+        if !self.state.lock().discovery.as_ref().is_some_and(|discovery| discovery.le_scan) {
+            return;
+        }
+        let Some(&count) = params.first() else { return };
+        let mut at = 1;
+        for _ in 0..count {
+            let Some(header) = params.get(at..at + 9) else { break };
+            let event_type = header[0];
+            let address_type = header[1];
+            let mut address = [0u8; 6];
+            address.copy_from_slice(&header[2..8]);
+            let length = header[8] as usize;
+            let Some(data) = params.get(at + 9..at + 9 + length) else { break };
+            let rssi = params.get(at + 9 + length).copied().unwrap_or(127) as i8;
+            at += 10 + length;
+            let mut flags = 0;
+            // Not connectable: scannable and non-connectable advertising.
+            if event_type == 0x02 || event_type == 0x03 {
+                flags |= mgmt::FOUND_NOT_CONNECTABLE;
+            }
+            // A scan response.
+            if event_type == 0x04 {
+                flags |= mgmt::FOUND_SCAN_RSP;
+            }
+            let kind = if address_type & 0x01 != 0 { mgmt::ADDR_LE_RANDOM } else { mgmt::ADDR_LE_PUBLIC };
+            self.report_found(&address, kind, rssi, flags, significant_eir(data));
+        }
+    }
+}
+
+/// The fields of an extended inquiry response, without the zeros after.
+fn significant_eir(eir: &[u8]) -> &[u8] {
+    let mut at = 0;
+    while at < eir.len() {
+        let length = eir[at] as usize;
+        if length == 0 || at + 1 + length > eir.len() {
+            break;
+        }
+        at += 1 + length;
+    }
+    &eir[..at]
+}
+
+fn has_field(eir: &[u8], kind: u8) -> bool {
+    let mut at = 0;
+    while at + 1 < eir.len() {
+        let length = eir[at] as usize;
+        if length == 0 {
+            break;
+        }
+        if eir[at + 1] == kind {
+            return true;
+        }
+        at += 1 + length;
+    }
+    false
+}
