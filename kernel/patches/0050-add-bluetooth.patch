+
+/// The settings a controller supports.
+pub(crate) fn supported_settings(info: &Info) -> u32 {
+    let mut supported = settings::POWERED | settings::CONNECTABLE | settings::DISCOVERABLE | settings::BONDABLE;
+    if info.bredr() {
+        supported |= settings::BREDR | settings::FAST_CONNECTABLE | settings::LINK_SECURITY;
+        if info.ssp() {
+            supported |= settings::SSP;
+        }
+    }
+    if info.le() {
+        supported |= settings::LE | settings::ADVERTISING | settings::SECURE_CONN;
+    }
+    supported
+}
