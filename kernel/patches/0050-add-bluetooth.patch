diff --git a/kernel/core/src/net/socket/alg/crypto.rs b/kernel/core/src/net/socket/alg/crypto.rs
new file mode 100755
index 0000000..1e27a7d
--- /dev/null
+++ b/kernel/core/src/net/socket/alg/crypto.rs
@@ -0,0 +1,492 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The algorithms of the kernel's crypto API that programs reach through
+//! `AF_ALG` sockets: AES in ECB, CBC and CTR modes (`skcipher`), and
+//! AES-CMAC, SHA-1, SHA-256 and their HMACs (`hash`). All are computed in
+//! software (AES through the `aes` crate, without CPU instructions whose
+//! state the kernel does not keep).
+
+use aes::{Aes128, Aes192, Aes256, BlockDecrypt, BlockEncrypt, NewBlockCipher};
+
+use crate::prelude::*;
+
+/// The kind of an algorithm (`salg_type`).
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(super) enum Kind {
+    Skcipher,
+    Hash,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(super) enum Algorithm {
+    EcbAes,
+    CbcAes,
+    CtrAes,
+    CmacAes,
+    Sha1,
+    Sha256,
+    HmacSha1,
+    HmacSha256,
+}
+
+impl Algorithm {
+    /// The algorithm a program names, by Linux's names (and its drivers'
+    /// generic names).
+    pub(super) fn find(kind: &str, name: &str) -> Option<Self> {
+        let algorithm = match name {
+            "ecb(aes)" | "ecb(aes-generic)" | "ecb-aes-generic" => Self::EcbAes,
+            "cbc(aes)" | "cbc(aes-generic)" | "cbc-aes-generic" => Self::CbcAes,
+            "ctr(aes)" | "ctr(aes-generic)" | "ctr-aes-generic" => Self::CtrAes,
+            "cmac(aes)" | "cmac(aes-generic)" | "cmac-aes-generic" => Self::CmacAes,
+            "sha1" | "sha1-generic" => Self::Sha1,
+            "sha256" | "sha256-generic" => Self::Sha256,
+            "hmac(sha1)" | "hmac(sha1-generic)" => Self::HmacSha1,
+            "hmac(sha256)" | "hmac(sha256-generic)" => Self::HmacSha256,
+            _ => return None,
+        };
+        let wanted = match kind {
+            "skcipher" => Kind::Skcipher,
+            "hash" => Kind::Hash,
+            _ => return None,
+        };
+        (algorithm.kind() == wanted).then_some(algorithm)
+    }
+
+    pub(super) fn kind(self) -> Kind {
+        match self {
+            Self::EcbAes | Self::CbcAes | Self::CtrAes => Kind::Skcipher,
+            _ => Kind::Hash,
+        }
+    }
+
+    /// Whether operations need a key first.
+    pub(super) fn needs_key(self) -> bool {
+        !matches!(self, Self::Sha1 | Self::Sha256)
+    }
+
+    /// Checks a key for the algorithm (`ALG_SET_KEY`).
+    pub(super) fn check_key(self, key: &[u8]) -> Result<()> {
+        match self {
+            Self::EcbAes | Self::CbcAes | Self::CtrAes | Self::CmacAes => {
+                if !matches!(key.len(), 16 | 24 | 32) {
+                    return_errno_with_message!(Errno::EINVAL, "AES keys have 16, 24 or 32 bytes");
+                }
+            }
+            Self::HmacSha1 | Self::HmacSha256 => {}
+            Self::Sha1 | Self::Sha256 => {
+                return_errno_with_message!(Errno::ENOSYS, "the hash has no key");
+            }
+        }
+        Ok(())
+    }
+
+    /// The IV's length (`ALG_SET_IV`).
+    pub(super) fn iv_len(self) -> usize {
+        match self {
+            Self::CbcAes | Self::CtrAes => 16,
+            _ => 0,
+        }
+    }
+
+    /// The unit the cipher works in: whole blocks, or any length.
+    pub(super) fn block_len(self) -> usize {
+        match self {
+            Self::EcbAes | Self::CbcAes => 16,
+            _ => 1,
+        }
+    }
+}
+
+/// An AES key, ready to use.
+pub(super) enum Aes {
+    Aes128(Aes128),
+    Aes192(Aes192),
+    Aes256(Aes256),
+}
+
+impl Aes {
+    /// `key` has 16, 24 or 32 bytes ([`Algorithm::check_key`]).
+    pub(super) fn new(key: &[u8]) -> Self {
+        match key.len() {
+            16 => Self::Aes128(Aes128::new(&<[u8; 16]>::try_from(key).unwrap().into())),
+            24 => Self::Aes192(Aes192::new(&<[u8; 24]>::try_from(key).unwrap().into())),
+            _ => Self::Aes256(Aes256::new(&<[u8; 32]>::try_from(&key[..32]).unwrap().into())),
+        }
+    }
+
+    pub(super) fn encrypt(&self, block: &mut [u8; 16]) {
+        let mut state = (*block).into();
+        match self {
+            Self::Aes128(aes) => aes.encrypt_block(&mut state),
+            Self::Aes192(aes) => aes.encrypt_block(&mut state),
+            Self::Aes256(aes) => aes.encrypt_block(&mut state),
+        }
+        block.copy_from_slice(&state);
+    }
+
+    pub(super) fn decrypt(&self, block: &mut [u8; 16]) {
+        let mut state = (*block).into();
+        match self {
+            Self::Aes128(aes) => aes.decrypt_block(&mut state),
+            Self::Aes192(aes) => aes.decrypt_block(&mut state),
+            Self::Aes256(aes) => aes.decrypt_block(&mut state),
+        }
+        block.copy_from_slice(&state);
+    }
+}
+
+/// Runs a cipher over `data` in place. `iv` is the IV (CBC, CTR), which
+/// becomes the next one: the operation goes on from there, as Linux's.
+/// `data` is whole blocks for ECB and CBC.
+pub(super) fn cipher(algorithm: Algorithm, aes: &Aes, encrypt: bool, iv: &mut [u8; 16], data: &mut [u8]) {
+    match algorithm {
+        Algorithm::EcbAes => {
+            for chunk in data.chunks_exact_mut(16) {
+                let block: &mut [u8; 16] = chunk.try_into().unwrap();
+                if encrypt { aes.encrypt(block) } else { aes.decrypt(block) }
+            }
+        }
+        Algorithm::CbcAes => {
+            for chunk in data.chunks_exact_mut(16) {
+                let block: &mut [u8; 16] = chunk.try_into().unwrap();
+                if encrypt {
+                    xor(block, iv);
+                    aes.encrypt(block);
+                    *iv = *block;
+                } else {
+                    let ciphertext = *block;
+                    aes.decrypt(block);
+                    xor(block, iv);
+                    *iv = ciphertext;
+                }
+            }
+        }
+        Algorithm::CtrAes => {
+            for chunk in data.chunks_mut(16) {
+                let mut stream = *iv;
+                aes.encrypt(&mut stream);
+                for (byte, key) in chunk.iter_mut().zip(stream) {
+                    *byte ^= key;
+                }
+                // The counter is the whole IV, big-endian.
+                for byte in iv.iter_mut().rev() {
+                    *byte = byte.wrapping_add(1);
+                    if *byte != 0 {
+                        break;
+                    }
+                }
+            }
+        }
+        _ => unreachable!("not a cipher"),
+    }
+}
+
+fn xor(block: &mut [u8; 16], other: &[u8; 16]) {
+    for (byte, other) in block.iter_mut().zip(other) {
+        *byte ^= other;
+    }
+}
+
+/// A digest being computed.
+pub(super) enum Hash {
+    Cmac(Cmac),
+    Sha1(Md<Sha1>),
+    Sha256(Md<Sha256>),
+    HmacSha1(Hmac<Sha1>),
+    HmacSha256(Hmac<Sha256>),
+}
+
+impl Hash {
+    /// A new digest; `key` is checked ([`Algorithm::check_key`]).
+    pub(super) fn new(algorithm: Algorithm, key: Option<&[u8]>) -> Self {
+        let key = key.unwrap_or(&[]);
+        match algorithm {
+            Algorithm::CmacAes => Self::Cmac(Cmac::new(Aes::new(key))),
+            Algorithm::Sha1 => Self::Sha1(Md::new()),
+            Algorithm::Sha256 => Self::Sha256(Md::new()),
+            Algorithm::HmacSha1 => Self::HmacSha1(Hmac::new(key)),
+            Algorithm::HmacSha256 => Self::HmacSha256(Hmac::new(key)),
+            _ => unreachable!("not a hash"),
+        }
+    }
+
+    pub(super) fn update(&mut self, data: &[u8]) {
+        match self {
+            Self::Cmac(hash) => hash.update(data),
+            Self::Sha1(hash) => hash.update(data),
+            Self::Sha256(hash) => hash.update(data),
+            Self::HmacSha1(hash) => hash.update(data),
+            Self::HmacSha256(hash) => hash.update(data),
+        }
+    }
+
+    pub(super) fn finish(self) -> Vec<u8> {
+        match self {
+            Self::Cmac(hash) => hash.finish().to_vec(),
+            Self::Sha1(hash) => hash.finish(),
+            Self::Sha256(hash) => hash.finish(),
+            Self::HmacSha1(hash) => hash.finish(),
+            Self::HmacSha256(hash) => hash.finish(),
+        }
+    }
+}
+
+/// AES-CMAC (RFC 4493). The last block waits for the end, which decides
+/// its subkey.
+pub(super) struct Cmac {
+    aes: Aes,
+    state: [u8; 16],
+    pending: [u8; 16],
+    pending_len: usize,
+}
+
+impl Cmac {
+    fn new(aes: Aes) -> Self {
+        Self { aes, state: [0; 16], pending: [0; 16], pending_len: 0 }
+    }
+
+    fn update(&mut self, mut data: &[u8]) {
+        while !data.is_empty() {
+            if self.pending_len == 16 {
+                xor(&mut self.state, &self.pending);
+                self.aes.encrypt(&mut self.state);
+                self.pending_len = 0;
+            }
+            let taken = (16 - self.pending_len).min(data.len());
+            self.pending[self.pending_len..self.pending_len + taken].copy_from_slice(&data[..taken]);
+            self.pending_len += taken;
+            data = &data[taken..];
+        }
+    }
+
+    fn finish(mut self) -> [u8; 16] {
+        let mut subkey = [0u8; 16];
+        self.aes.encrypt(&mut subkey);
+        subkey = double(&subkey);
+        let mut last = self.pending;
+        if self.pending_len < 16 {
+            subkey = double(&subkey);
+            last[self.pending_len] = 0x80;
+            last[self.pending_len + 1..].fill(0);
+        }
+        xor(&mut last, &subkey);
+        xor(&mut self.state, &last);
+        self.aes.encrypt(&mut self.state);
+        self.state
+    }
+}
+
+/// Doubling in GF(2^128), for CMAC's subkeys.
+fn double(block: &[u8; 16]) -> [u8; 16] {
+    let mut out = [0u8; 16];
+    for i in 0..16 {
+        out[i] = (block[i] << 1) | block.get(i + 1).map_or(0, |next| next >> 7);
+    }
+    if block[0] & 0x80 != 0 {
+        out[15] ^= 0x87;
+    }
+    out
+}
+
+/// A Merkle-Damgård hash's compression (SHA-1, SHA-256).
+pub(super) trait Compress: Default {
+    fn compress(&mut self, block: &[u8; 64]);
+    fn output(&self) -> Vec<u8>;
+}
+
+/// A SHA-1 or SHA-256 digest being computed.
+pub(super) struct Md<C: Compress> {
+    state: C,
+    block: [u8; 64],
+    block_len: usize,
+    total: u64,
+}
+
+impl<C: Compress> Md<C> {
+    fn new() -> Self {
+        Self { state: C::default(), block: [0; 64], block_len: 0, total: 0 }
+    }
+
+    fn update(&mut self, mut data: &[u8]) {
+        self.total = self.total.wrapping_add(data.len() as u64);
+        while !data.is_empty() {
+            let taken = (64 - self.block_len).min(data.len());
+            self.block[self.block_len..self.block_len + taken].copy_from_slice(&data[..taken]);
+            self.block_len += taken;
+            data = &data[taken..];
+            if self.block_len == 64 {
+                let block = self.block;
+                self.state.compress(&block);
+                self.block_len = 0;
+            }
+        }
+    }
+
+    fn finish(mut self) -> Vec<u8> {
+        let bits = self.total.wrapping_mul(8);
+        self.update(&[0x80]);
+        while self.block_len != 56 {
+            self.update(&[0]);
+        }
+        self.update(&bits.to_be_bytes());
+        self.state.output()
+    }
+}
+
+pub(super) struct Sha1([u32; 5]);
+
+impl Default for Sha1 {
+    fn default() -> Self {
+        Self([0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0])
+    }
+}
+
+impl Compress for Sha1 {
+    fn compress(&mut self, block: &[u8; 64]) {
+        let mut w = [0u32; 80];
+        for i in 0..16 {
+            w[i] = u32::from_be_bytes(block[i * 4..i * 4 + 4].try_into().unwrap());
+        }
+        for i in 16..80 {
+            w[i] = (w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16]).rotate_left(1);
+        }
+        let [mut a, mut b, mut c, mut d, mut e] = self.0;
+        for (i, word) in w.iter().enumerate() {
+            let (f, k) = match i {
+                0..=19 => ((b & c) | (!b & d), 0x5A827999),
+                20..=39 => (b ^ c ^ d, 0x6ED9EBA1),
+                40..=59 => ((b & c) | (b & d) | (c & d), 0x8F1BBCDC),
+                _ => (b ^ c ^ d, 0xCA62C1D6),
+            };
+            let next = a.rotate_left(5).wrapping_add(f).wrapping_add(e).wrapping_add(k).wrapping_add(*word);
+            e = d;
+            d = c;
+            c = b.rotate_left(30);
+            b = a;
+            a = next;
+        }
+        for (state, value) in self.0.iter_mut().zip([a, b, c, d, e]) {
+            *state = state.wrapping_add(value);
+        }
+    }
+
+    fn output(&self) -> Vec<u8> {
+        self.0.iter().flat_map(|word| word.to_be_bytes()).collect()
+    }
+}
+
+pub(super) struct Sha256([u32; 8]);
+
+impl Default for Sha256 {
+    fn default() -> Self {
+        Self([
+            0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
+        ])
+    }
+}
+
+const SHA256_K: [u32; 64] = [
+    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
+];
+
+impl Compress for Sha256 {
+    fn compress(&mut self, block: &[u8; 64]) {
+        let mut w = [0u32; 64];
+        for i in 0..16 {
+            w[i] = u32::from_be_bytes(block[i * 4..i * 4 + 4].try_into().unwrap());
+        }
+        for i in 16..64 {
+            let s0 = w[i - 15].rotate_right(7) ^ w[i - 15].rotate_right(18) ^ (w[i - 15] >> 3);
+            let s1 = w[i - 2].rotate_right(17) ^ w[i - 2].rotate_right(19) ^ (w[i - 2] >> 10);
+            w[i] = w[i - 16].wrapping_add(s0).wrapping_add(w[i - 7]).wrapping_add(s1);
+        }
+        let mut v = self.0;
+        for i in 0..64 {
+            let [a, b, c, d, e, f, g, h] = v;
+            let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);
+            let choice = (e & f) ^ (!e & g);
+            let t1 = h.wrapping_add(s1).wrapping_add(choice).wrapping_add(SHA256_K[i]).wrapping_add(w[i]);
+            let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);
+            let majority = (a & b) ^ (a & c) ^ (b & c);
+            let t2 = s0.wrapping_add(majority);
+            v = [t1.wrapping_add(t2), a, b, c, d.wrapping_add(t1), e, f, g];
+        }
+        for (state, value) in self.0.iter_mut().zip(v) {
+            *state = state.wrapping_add(value);
+        }
+    }
+
+    fn output(&self) -> Vec<u8> {
+        self.0.iter().flat_map(|word| word.to_be_bytes()).collect()
+    }
+}
+
+/// HMAC (RFC 2104) over SHA-1 or SHA-256.
+pub(super) struct Hmac<C: Compress> {
+    inner: Md<C>,
+    outer_key: [u8; 64],
+}
+
+impl<C: Compress> Hmac<C> {
+    fn new(key: &[u8]) -> Self {
+        let mut block = [0u8; 64];
+        if key.len() > 64 {
+            let mut hash = Md::<C>::new();
+            hash.update(key);
+            let digest = hash.finish();
+            block[..digest.len()].copy_from_slice(&digest);
+        } else {
+            block[..key.len()].copy_from_slice(key);
+        }
+        let mut inner = Md::new();
+        inner.update(&block.map(|byte| byte ^ 0x36));
+        Self { inner, outer_key: block.map(|byte| byte ^ 0x5c) }
+    }
+
+    fn update(&mut self, data: &[u8]) {
+        self.inner.update(data);
+    }
+
+    fn finish(self) -> Vec<u8> {
+        let inner = self.inner.finish();
+        let mut outer = Md::<C>::new();
+        outer.update(&self.outer_key);
+        outer.update(&inner);
+        outer.finish()
+    }
+}
+
+#[cfg(ktest)]
+mod test {
+    use ostd::prelude::*;
+
+    use super::*;
+
+    fn digest(algorithm: Algorithm, key: Option<&[u8]>, message: &[u8]) -> Vec<u8> {
+        let mut hash = Hash::new(algorithm, key);
+        hash.update(message);
+        hash.finish()
+    }
+
+    #[ktest]
+    fn known_answers() {
+        // RFC 4493's examples.
+        let key = [0x2b, 0x7e, 0x15, 0x16, 0x28, 0xae, 0xd2, 0xa6, 0xab, 0xf7, 0x15, 0x88, 0x09, 0xcf, 0x4f, 0x3c];
+        assert_eq!(
+            digest(Algorithm::CmacAes, Some(&key), &[]),
+            [0xbb, 0x1d, 0x69, 0x29, 0xe9, 0x59, 0x37, 0x28, 0x7f, 0xa3, 0x7d, 0x12, 0x9b, 0x75, 0x67, 0x46]
+        );
+        assert_eq!(
+            &digest(Algorithm::Sha256, None, b"abc")[..4],
+            &[0xba, 0x78, 0x16, 0xbf]
+        );
+        assert_eq!(&digest(Algorithm::Sha1, None, b"abc")[..4], &[0xa9, 0x99, 0x3e, 0x36]);
+    }
+}
diff --git a/kernel/core/src/net/socket/alg/mod.rs b/kernel/core/src/net/socket/alg/mod.rs
new file mode 100755
index 0000000..bc7defd
--- /dev/null
+++ b/kernel/core/src/net/socket/alg/mod.rs
@@ -0,0 +1,399 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! `AF_ALG` sockets: the kernel's crypto API for programs. A program binds
+//! a socket to an algorithm (`sockaddr_alg`: `skcipher` `ecb(aes)`, `hash`
+//! `cmac(aes)`, ...), sets its key (`ALG_SET_KEY`), and accepts operation
+//! sockets from it: it writes data to one (with `ALG_SET_OP` and
+//! `ALG_SET_IV` for a cipher; `MSG_MORE` while more is to come) and reads
+//! the result. BlueZ computes Bluetooth LE's keys and GATT's hashes so, and
+//! its emulator its controllers' crypto.
+
+mod crypto;
+
+use crypto::{Aes, Algorithm, Hash, Kind};
+
+use super::{
+    Socket, new_socket_common,
+    options::{Error as SocketError, SocketOption, macros::{impl_socket_options, sock_option_mut, sock_option_ref}},
+    private::SocketPrivate,
+    util::{ControlMessage, MessageHeader, RecvFlags, RecvOutput, SendFlags, SocketAddr},
+};
+use crate::{
+    events::IoEvents,
+    fs::file::{FileCommon, FileLike},
+    prelude::*,
+    process::signal::{PollHandle, Pollable, Pollee},
+    util::{MultiRead, MultiWrite},
+};
+
+impl_socket_options!(
+    /// `ALG_SET_KEY`.
+    pub(crate) struct AlgKey(Vec<u8>);
+);
+
+/// The most a cipher socket holds unprocessed.
+const MAX_QUEUED: usize = 1 << 20;
+
+/// An algorithm's address (`struct sockaddr_alg`).
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) struct AlgSocketAddr {
+    pub kind: [u8; 14],
+    pub name: [u8; 64],
+}
+
+impl AlgSocketAddr {
+    fn text(bytes: &[u8]) -> &str {
+        let end = bytes.iter().position(|byte| *byte == 0).unwrap_or(bytes.len());
+        core::str::from_utf8(&bytes[..end]).unwrap_or("")
+    }
+}
+
+/// A control message of `SOL_ALG`.
+#[derive(Debug)]
+pub(crate) enum AlgControlMessage {
+    /// `ALG_SET_OP`: encrypt (1) or decrypt (0).
+    Op(u32),
+    /// `ALG_SET_IV`.
+    Iv(Vec<u8>),
+    /// `ALG_SET_AEAD_ASSOCLEN`, which no algorithm here uses.
+    AssocLen,
+}
+
+impl AlgControlMessage {
+    const ALG_SET_IV: i32 = 2;
+    const ALG_SET_OP: i32 = 3;
+    const ALG_SET_AEAD_ASSOCLEN: i32 = 4;
+
+    pub(crate) fn read_from(type_: i32, payload_len: usize, reader: &mut VmReader) -> Result<Option<Self>> {
+        let message = match type_ {
+            Self::ALG_SET_OP | Self::ALG_SET_AEAD_ASSOCLEN => {
+                if payload_len < 4 {
+                    return_errno_with_message!(Errno::EINVAL, "the ALG control message is too short");
+                }
+                let value = reader.read_val::<u32>()?;
+                reader.skip((payload_len - 4).min(reader.remain()));
+                if type_ == Self::ALG_SET_OP { Self::Op(value) } else { Self::AssocLen }
+            }
+            Self::ALG_SET_IV => {
+                if payload_len < 4 {
+                    return_errno_with_message!(Errno::EINVAL, "the ALG control message is too short");
+                }
+                let iv_len = reader.read_val::<u32>()? as usize;
+                if iv_len > payload_len - 4 {
+                    return_errno_with_message!(Errno::EINVAL, "the IV is longer than its message");
+                }
+                let mut iv = vec![0u8; iv_len];
+                reader.read_fallible(&mut VmWriter::from(&mut iv[..])).map_err(|(error, _)| error)?;
+                reader.skip((payload_len - 4 - iv_len).min(reader.remain()));
+                Self::Iv(iv)
+            }
+            _ => {
+                reader.skip(payload_len.min(reader.remain()));
+                return Ok(None);
+            }
+        };
+        Ok(Some(message))
+    }
+}
+
+/// A socket bound to an algorithm, which operation sockets are accepted
+/// from.
+pub(crate) struct AlgSocket {
+    state: Mutex<TransformState>,
+    pollee: Pollee,
+    common: FileCommon,
+}
+
+struct TransformState {
+    bound: Option<(Algorithm, AlgSocketAddr)>,
+    key: Option<Vec<u8>>,
+}
+
+impl AlgSocket {
+    pub(crate) fn new(is_nonblocking: bool) -> Arc<Self> {
+        Arc::new(Self {
+            state: Mutex::new(TransformState { bound: None, key: None }),
+            pollee: Pollee::new(),
+            common: new_socket_common(is_nonblocking),
+        })
+    }
+}
+
+impl Socket for AlgSocket {
+    fn bind(&self, socket_addr: SocketAddr) -> Result<()> {
+        let SocketAddr::Alg(address) = socket_addr else {
+            return_errno_with_message!(Errno::EINVAL, "not an ALG socket address");
+        };
+        let kind = AlgSocketAddr::text(&address.kind);
+        let name = AlgSocketAddr::text(&address.name);
+        let Some(algorithm) = Algorithm::find(kind, name) else {
+            return_errno_with_message!(Errno::ENOENT, "the algorithm is not available");
+        };
+        let mut state = self.state.lock();
+        if state.bound.is_some() {
+            return_errno_with_message!(Errno::EBUSY, "the socket is bound already");
+        }
+        state.bound = Some((algorithm, address));
+        Ok(())
+    }
+
+    fn addr(&self) -> Result<SocketAddr> {
+        match self.state.lock().bound {
+            Some((_, address)) => Ok(SocketAddr::Alg(address)),
+            None => Ok(SocketAddr::Alg(AlgSocketAddr { kind: [0; 14], name: [0; 64] })),
+        }
+    }
+
+    fn accept(&self, is_nonblocking: bool) -> Result<(Arc<dyn FileLike>, SocketAddr)> {
+        let state = self.state.lock();
+        let Some((algorithm, address)) = state.bound else {
+            return_errno_with_message!(Errno::EINVAL, "the socket is not bound to an algorithm");
+        };
+        if algorithm.needs_key() && state.key.is_none() {
+            return_errno_with_message!(Errno::ENOKEY, "the algorithm needs a key first");
+        }
+        let operation = AlgOperationSocket::new(is_nonblocking, algorithm, state.key.as_deref());
+        Ok((operation as Arc<dyn FileLike>, SocketAddr::Alg(address)))
+    }
+
+    fn set_option(&self, option: &dyn SocketOption) -> Result<()> {
+        sock_option_ref!(match option {
+            key @ AlgKey => {
+                let key = key.get().unwrap();
+                let mut state = self.state.lock();
+                let Some((algorithm, _)) = state.bound else {
+                    return_errno_with_message!(Errno::ENOPROTOOPT, "the socket is not bound to an algorithm");
+                };
+                algorithm.check_key(key)?;
+                state.key = Some(key.clone());
+                return Ok(());
+            }
+            _ => (),
+        });
+        return_errno_with_message!(Errno::ENOPROTOOPT, "the socket option is not supported")
+    }
+
+    fn get_option(&self, option: &mut dyn SocketOption) -> Result<()> {
+        sock_option_mut!(match option {
+            socket_errors @ SocketError => {
+                socket_errors.set(None);
+                return Ok(());
+            }
+            _ => (),
+        });
+        return_errno_with_message!(Errno::ENOPROTOOPT, "the socket option is not supported")
+    }
+
+    fn sendmsg(&self, _reader: &mut dyn MultiRead, _message_header: MessageHeader, _flags: SendFlags) -> Result<usize> {
+        return_errno_with_message!(Errno::EOPNOTSUPP, "data goes to an accepted socket")
+    }
+
+    fn recvmsg(&self, _writer: &mut dyn MultiWrite, _flags: RecvFlags) -> Result<(RecvOutput, MessageHeader)> {
+        return_errno_with_message!(Errno::EOPNOTSUPP, "results come from an accepted socket")
+    }
+
+    fn common(&self) -> &FileCommon {
+        &self.common
+    }
+}
+
+impl SocketPrivate for AlgSocket {
+    fn is_nonblocking(&self) -> bool {
+        self.common.is_nonblocking()
+    }
+}
+
+impl Pollable for AlgSocket {
+    fn poll(&self, mask: IoEvents, poller: Option<&mut PollHandle>) -> IoEvents {
+        self.pollee.poll_with(mask, poller, || IoEvents::empty())
+    }
+}
+
+/// An operation of an algorithm: data in, a result out.
+struct AlgOperationSocket {
+    algorithm: Algorithm,
+    key: Option<Vec<u8>>,
+    state: Mutex<OperationState>,
+    pollee: Pollee,
+    common: FileCommon,
+}
+
+enum OperationState {
+    Hash {
+        /// The digest of the data written with `MSG_MORE` so far.
+        running: Option<Hash>,
+        /// The result of the last message, to be read.
+        result: Option<Vec<u8>>,
+    },
+    Cipher {
+        aes: Aes,
+        encrypt: bool,
+        iv: [u8; 16],
+        /// Data written and not yet processed.
+        queued: Vec<u8>,
+        /// The last message ended (without `MSG_MORE`).
+        complete: bool,
+    },
+}
+
+impl AlgOperationSocket {
+    fn new(is_nonblocking: bool, algorithm: Algorithm, key: Option<&[u8]>) -> Arc<Self> {
+        let state = match algorithm.kind() {
+            Kind::Hash => OperationState::Hash { running: None, result: None },
+            Kind::Skcipher => OperationState::Cipher {
+                aes: Aes::new(key.unwrap_or(&[0; 16])),
+                encrypt: false,
+                iv: [0; 16],
+                queued: Vec::new(),
+                complete: false,
+            },
+        };
+        Arc::new(Self {
+            algorithm,
+            key: key.map(<[u8]>::to_vec),
+            state: Mutex::new(state),
+            pollee: Pollee::new(),
+            common: new_socket_common(is_nonblocking),
+        })
+    }
+
+    fn check_io_events(&self) -> IoEvents {
+        let mut events = IoEvents::OUT;
+        match &*self.state.lock() {
+            OperationState::Hash { .. } => events |= IoEvents::IN,
+            OperationState::Cipher { queued, complete, .. } => {
+                if !queued.is_empty() || *complete {
+                    events |= IoEvents::IN;
+                }
+            }
+        }
+        events
+    }
+
+    fn try_recv(&self, writer: &mut dyn MultiWrite, flags: RecvFlags) -> Result<RecvOutput> {
+        let mut state = self.state.lock();
+        match &mut *state {
+            OperationState::Hash { running, result } => {
+                // The digest of what was written, or of nothing.
+                let digest = match result.take() {
+                    Some(digest) => digest,
+                    None => running.take().unwrap_or_else(|| Hash::new(self.algorithm, self.key.as_deref())).finish(),
+                };
+                drop(state);
+                let copied = digest.len().min(writer.sum_lens());
+                writer.write(&mut VmReader::from(&digest[..copied]))?;
+                Ok(RecvOutput::new_for_packet(flags, copied, digest.len()))
+            }
+            OperationState::Cipher { aes, encrypt, iv, queued, complete } => {
+                let unit = self.algorithm.block_len();
+                if queued.is_empty() {
+                    if *complete {
+                        *complete = false;
+                        return Ok(RecvOutput::new_for_stream(0));
+                    }
+                    return_errno_with_message!(Errno::EAGAIN, "no data is waiting");
+                }
+                if *complete && queued.len() % unit != 0 {
+                    queued.clear();
+                    *complete = false;
+                    return_errno_with_message!(Errno::EINVAL, "the data is not whole blocks");
+                }
+                let length = (queued.len().min(writer.sum_lens()) / unit) * unit;
+                if length == 0 {
+                    if writer.sum_lens() < unit {
+                        return_errno_with_message!(Errno::EINVAL, "the buffer is shorter than a block");
+                    }
+                    return_errno_with_message!(Errno::EAGAIN, "a whole block is not written yet");
+                }
+                let mut data: Vec<u8> = queued.drain(..length).collect();
+                crypto::cipher(self.algorithm, aes, *encrypt, iv, &mut data);
+                if queued.is_empty() {
+                    *complete = false;
+                }
+                drop(state);
+                writer.write(&mut VmReader::from(&data[..]))?;
+                Ok(RecvOutput::new_for_stream(length))
+            }
+        }
+    }
+}
+
+impl Socket for AlgOperationSocket {
+    fn sendmsg(&self, reader: &mut dyn MultiRead, message_header: MessageHeader, flags: SendFlags) -> Result<usize> {
+        let length = reader.sum_lens();
+        let more = flags.contains(SendFlags::MSG_MORE);
+        let mut data = vec![0u8; length];
+        reader.read(&mut VmWriter::from(&mut data[..]))?;
+        let mut state = self.state.lock();
+        match &mut *state {
+            OperationState::Hash { running, result } => {
+                let hash = running.get_or_insert_with(|| Hash::new(self.algorithm, self.key.as_deref()));
+                hash.update(&data);
+                if !more {
+                    *result = running.take().map(Hash::finish);
+                }
+            }
+            OperationState::Cipher { encrypt, iv, queued, complete, .. } => {
+                for message in &message_header.control_messages {
+                    let ControlMessage::Alg(message) = message else {
+                        continue;
+                    };
+                    match message {
+                        AlgControlMessage::Op(op) => *encrypt = *op == 1,
+                        AlgControlMessage::Iv(given) => {
+                            if given.len() != self.algorithm.iv_len() {
+                                return_errno_with_message!(Errno::EINVAL, "the IV's length is wrong");
+                            }
+                            iv[..given.len()].copy_from_slice(given);
+                        }
+                        AlgControlMessage::AssocLen => {}
+                    }
+                }
+                if queued.len() + data.len() > MAX_QUEUED {
+                    return_errno_with_message!(Errno::ENOBUFS, "too much data waits to be processed");
+                }
+                queued.extend_from_slice(&data);
+                *complete = !more;
+            }
+        }
+        drop(state);
+        self.pollee.notify(IoEvents::IN);
+        Ok(length)
+    }
+
+    fn recvmsg(&self, writer: &mut dyn MultiWrite, flags: RecvFlags) -> Result<(RecvOutput, MessageHeader)> {
+        let output = self.block_on_unless(IoEvents::IN, None, flags.contains(RecvFlags::MSG_DONTWAIT), || {
+            let output = self.try_recv(writer, flags);
+            self.pollee.invalidate();
+            output
+        })?;
+        Ok((output, MessageHeader::new(None, Vec::new())))
+    }
+
+    fn get_option(&self, option: &mut dyn SocketOption) -> Result<()> {
+        sock_option_mut!(match option {
+            socket_errors @ SocketError => {
+                socket_errors.set(None);
+                return Ok(());
+            }
+            _ => (),
+        });
+        return_errno_with_message!(Errno::ENOPROTOOPT, "the socket option is not supported")
+    }
+
+    fn common(&self) -> &FileCommon {
+        &self.common
+    }
+}
+
+impl SocketPrivate for AlgOperationSocket {
+    fn is_nonblocking(&self) -> bool {
+        self.common.is_nonblocking()
+    }
+}
+
+impl Pollable for AlgOperationSocket {
+    fn poll(&self, mask: IoEvents, poller: Option<&mut PollHandle>) -> IoEvents {
+        self.pollee.poll_with(mask, poller, || self.check_io_events())
+    }
+}
diff --git a/kernel/core/src/net/socket/bluetooth.rs b/kernel/core/src/net/socket/bluetooth.rs
new file mode 100755
index 0000000..f313027
--- /dev/null
+++ b/kernel/core/src/net/socket/bluetooth.rs
@@ -0,0 +1,503 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Bluetooth sockets (`AF_BLUETOOTH`), over the `aster-bluetooth`
+//! component:
+//!
+//! - `BTPROTO_HCI` raw sockets reach the controllers: the management
+//!   interface that bluetoothd uses (`HCI_CHANNEL_CONTROL`), the monitor
+//!   that btmon reads (`HCI_CHANNEL_MONITOR`), a controller's own events and
+//!   commands (`HCI_CHANNEL_RAW`) and bluetoothd's log lines
+//!   (`HCI_CHANNEL_LOGGING`). Each message is read and written whole.
+//! - `BTPROTO_L2CAP`, `BTPROTO_RFCOMM` and `BTPROTO_SCO` sockets carry
+//!   data to and from devices.
+//!
+//! Their addresses and their options (`SOL_BLUETOOTH`, `SOL_HCI`,
+//! `SOL_L2CAP`, ...) are each protocol's own layouts, which the protocol
+//! reads, as on Linux.
+
+use core::sync::atomic::{AtomicBool, Ordering};
+
+use aster_bluetooth::proto::{self, ProtoSocket, Protocol};
+
+use super::{
+    Socket, new_socket_common,
+    options::{Error as SocketError, RecvTimeout, SendTimeout, SocketOption, Timestamp, macros::{sock_option_mut, sock_option_ref}},
+    private::SocketPrivate,
+    util::{
+        ControlMessage, MessageHeader, RecvFlags, RecvOutput, SendFlags, SockShutdownCmd, SocketAddr, SocketTimeout,
+        options::SocketTimeouts,
+    },
+};
+use crate::{
+    events::IoEvents,
+    fs::file::{FileCommon, FileLike},
+    prelude::*,
+    process::{
+        UserNamespace,
+        credentials::capabilities::CapSet,
+        posix_thread::AsPosixThread,
+        signal::{PollHandle, Pollable, Pollee},
+    },
+    time::clocks::RealTimeClock,
+    util::{MultiRead, MultiWrite},
+};
+
+/// `BTPROTO_HCI`.
+pub(crate) const BTPROTO_HCI: i32 = 1;
+const AF_BLUETOOTH: i32 = 31;
+/// `SOL_HCI`'s options: the data direction, the event filter, time stamps.
+const SOL_HCI: i32 = 0;
+const HCI_FILTER: i32 = 2;
+
+/// A Bluetooth socket address: each protocol's own layout, with the family.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) struct BluetoothSocketAddr {
+    bytes: [u8; Self::MAX_LEN],
+    len: usize,
+}
+
+impl BluetoothSocketAddr {
+    pub(crate) const MAX_LEN: usize = 64;
+
+    pub(crate) fn new(bytes: &[u8]) -> Self {
+        let len = bytes.len().min(Self::MAX_LEN);
+        let mut address = Self { bytes: [0; Self::MAX_LEN], len };
+        address.bytes[..len].copy_from_slice(&bytes[..len]);
+        address
+    }
+
+    pub(crate) fn as_bytes(&self) -> &[u8] {
+        &self.bytes[..self.len]
+    }
+}
+
+/// The largest message: a management command with its header.
+const MAX_MESSAGE: usize = 6 + 0xffff;
+
+fn errno(code: i32) -> Error {
+    let errno = Errno::try_from(code).unwrap_or(Errno::EINVAL);
+    Error::with_message(errno, "the Bluetooth socket refused the request")
+}
+
+fn has_capability(capability: CapSet) -> Result<()> {
+    crate::security::lsm::hooks::on_capable(crate::security::lsm::hooks::CapableContext::new(
+        UserNamespace::get_init_singleton().as_ref(),
+        current_thread!().as_posix_thread().unwrap(),
+        capability,
+    ))
+}
+
+pub(crate) struct HciSocket {
+    inner: Arc<aster_bluetooth::Socket>,
+    /// The controller and channel bound: `struct sockaddr_hci`.
+    bound: SpinLock<(u16, u16)>,
+    /// `SO_TIMESTAMP`: each message read comes with its time.
+    timestamps: AtomicBool,
+    /// `HCI_FILTER`, as the program set it.
+    filter: SpinLock<[u8; 14]>,
+    pollee: Pollee,
+    common: FileCommon,
+}
+
+impl HciSocket {
+    pub(crate) fn new(is_nonblocking: bool) -> Arc<Self> {
+        let pollee = Pollee::new();
+        let notified = pollee.clone();
+        let inner = aster_bluetooth::Socket::new(Box::new(move || notified.notify(IoEvents::IN)));
+        Arc::new(Self {
+            inner,
+            bound: SpinLock::new((0xffff, 0)),
+            timestamps: AtomicBool::new(false),
+            filter: SpinLock::new([0; 14]),
+            pollee,
+            common: new_socket_common(is_nonblocking),
+        })
+    }
+
+    fn address(&self) -> SocketAddr {
+        let (dev, channel) = *self.bound.lock();
+        let mut bytes = [0u8; 6];
+        bytes[..2].copy_from_slice(&31u16.to_ne_bytes());
+        bytes[2..4].copy_from_slice(&dev.to_ne_bytes());
+        bytes[4..].copy_from_slice(&channel.to_ne_bytes());
+        SocketAddr::Bluetooth(BluetoothSocketAddr::new(&bytes))
+    }
+
+    fn check_io_events(&self) -> IoEvents {
+        let mut events = IoEvents::OUT;
+        if self.inner.readable() {
+            events |= IoEvents::IN;
+        }
+        events
+    }
+
+    fn try_recv(&self, writer: &mut dyn MultiWrite, flags: RecvFlags) -> Result<RecvOutput> {
+        let Some(message) = self.inner.recv(flags.contains(RecvFlags::MSG_PEEK)) else {
+            return_errno_with_message!(Errno::EAGAIN, "no message is waiting");
+        };
+        self.pollee.invalidate();
+        let copied = message.len().min(writer.sum_lens());
+        writer.write(&mut VmReader::from(&message[..copied]))?;
+        Ok(RecvOutput::new_for_packet(flags, copied, message.len()))
+    }
+}
+
+impl Socket for HciSocket {
+    fn bind(&self, socket_addr: SocketAddr) -> Result<()> {
+        let SocketAddr::Bluetooth(address) = socket_addr else {
+            return_errno_with_message!(Errno::EINVAL, "not a Bluetooth socket address");
+        };
+        let bytes = address.as_bytes();
+        if bytes.len() < 6 {
+            return_errno_with_message!(Errno::EINVAL, "the HCI socket address is too short");
+        }
+        let dev = u16::from_ne_bytes([bytes[2], bytes[3]]);
+        let channel = u16::from_ne_bytes([bytes[4], bytes[5]]);
+        // Running controllers is the administrator's; watching every
+        // packet needs CAP_NET_RAW, as on Linux.
+        match aster_bluetooth::Channel::from_raw(channel) {
+            Some(aster_bluetooth::Channel::Monitor) => has_capability(CapSet::NET_RAW)?,
+            Some(aster_bluetooth::Channel::Control | aster_bluetooth::Channel::Raw) => {
+                has_capability(CapSet::NET_ADMIN)?
+            }
+            _ => {}
+        }
+        self.inner.bind(dev, channel).map_err(errno)?;
+        *self.bound.lock() = (dev, channel);
+        Ok(())
+    }
+
+    fn addr(&self) -> Result<SocketAddr> {
+        Ok(self.address())
+    }
+
+    fn sendmsg(&self, reader: &mut dyn MultiRead, _message_header: MessageHeader, _flags: SendFlags) -> Result<usize> {
+        let length = reader.sum_lens();
+        if length > MAX_MESSAGE {
+            return_errno_with_message!(Errno::EMSGSIZE, "the message is too long");
+        }
+        let mut message = vec![0u8; length];
+        reader.read(&mut VmWriter::from(&mut message[..]))?;
+        self.inner.send(&message).map_err(errno)
+    }
+
+    fn recvmsg(&self, writer: &mut dyn MultiWrite, flags: RecvFlags) -> Result<(RecvOutput, MessageHeader)> {
+        let output = self.block_on_unless(IoEvents::IN, None, flags.contains(RecvFlags::MSG_DONTWAIT), || {
+            self.try_recv(writer, flags)
+        })?;
+        // When it was read stands for when it came (btmon's times).
+        let mut control_messages = Vec::new();
+        if self.timestamps.load(Ordering::Relaxed) {
+            control_messages.push(ControlMessage::Timestamp(RealTimeClock::get().read_time().into()));
+        }
+        Ok((output, MessageHeader::new(Some(self.address()), control_messages)))
+    }
+
+    fn get_option(&self, option: &mut dyn SocketOption) -> Result<()> {
+        sock_option_mut!(match option {
+            socket_errors @ SocketError => {
+                socket_errors.set(None);
+                return Ok(());
+            }
+            timestamp @ Timestamp => {
+                timestamp.set(self.timestamps.load(Ordering::Relaxed));
+                return Ok(());
+            }
+            _ => (),
+        });
+        return_errno_with_message!(Errno::ENOPROTOOPT, "the socket option is not supported");
+    }
+
+    fn set_option(&self, option: &dyn SocketOption) -> Result<()> {
+        sock_option_ref!(match option {
+            timestamp @ Timestamp => {
+                self.timestamps.store(*timestamp.get().unwrap(), Ordering::Relaxed);
+                return Ok(());
+            }
+            _ => (),
+        });
+        // Buffer sizes, priorities: taken, without effect.
+        Ok(())
+    }
+
+    fn family_and_protocol(&self) -> Option<(i32, i32)> {
+        Some((AF_BLUETOOTH, BTPROTO_HCI))
+    }
+
+    fn reads_own_options(&self, level: i32) -> bool {
+        level == SOL_HCI
+    }
+
+    fn set_own_option(&self, _level: i32, name: i32, value: &[u8]) -> Result<()> {
+        // The filter is kept for the program to read back; the data
+        // direction and time stamps are taken, without effect.
+        if name == HCI_FILTER {
+            let mut filter = self.filter.lock();
+            let length = value.len().min(filter.len());
+            filter[..length].copy_from_slice(&value[..length]);
+        }
+        Ok(())
+    }
+
+    fn get_own_option(&self, _level: i32, name: i32) -> Result<Vec<u8>> {
+        match name {
+            HCI_FILTER => Ok(self.filter.lock().to_vec()),
+            _ => Ok(0u32.to_ne_bytes().to_vec()),
+        }
+    }
+
+    fn common(&self) -> &FileCommon {
+        &self.common
+    }
+}
+
+impl SocketPrivate for HciSocket {
+    fn is_nonblocking(&self) -> bool {
+        self.common.is_nonblocking()
+    }
+}
+
+impl Pollable for HciSocket {
+    fn poll(&self, mask: IoEvents, poller: Option<&mut PollHandle>) -> IoEvents {
+        self.pollee.poll_with(mask, poller, || self.check_io_events())
+    }
+}
+
+/// An L2CAP, RFCOMM or SCO socket.
+pub(crate) struct BluetoothSocket {
+    inner: Arc<ProtoSocket>,
+    pollee: Pollee,
+    common: FileCommon,
+    timeouts: SocketTimeouts,
+}
+
+impl BluetoothSocket {
+    /// A socket of `protocol` (`BTPROTO_*`) and `socket_type`, if they go
+    /// together.
+    pub(crate) fn new(is_nonblocking: bool, protocol: i32, socket_type: u8) -> Result<Arc<Self>> {
+        let Some(protocol) = Protocol::from_raw(protocol) else {
+            return_errno_with_message!(Errno::EPROTONOSUPPORT, "the Bluetooth protocol is not supported");
+        };
+        if !protocol.takes_type(socket_type) {
+            return_errno_with_message!(Errno::ESOCKTNOSUPPORT, "the socket type does not go with the protocol");
+        }
+        Ok(Self::wrap(ProtoSocket::new(protocol, socket_type), is_nonblocking))
+    }
+
+    fn wrap(inner: Arc<ProtoSocket>, is_nonblocking: bool) -> Arc<Self> {
+        let pollee = Pollee::new();
+        let notified = pollee.clone();
+        inner.set_notify(Arc::new(move || notified.notify(IoEvents::IN | IoEvents::OUT | IoEvents::HUP | IoEvents::ERR)));
+        Arc::new(Self { inner, pollee, common: new_socket_common(is_nonblocking), timeouts: SocketTimeouts::new() })
+    }
+
+    fn check_io_events(&self) -> IoEvents {
+        let events = self.inner.events();
+        let mut io_events = IoEvents::empty();
+        for (bit, event) in [
+            (proto::events::IN, IoEvents::IN),
+            (proto::events::OUT, IoEvents::OUT),
+            (proto::events::ERR, IoEvents::ERR),
+            (proto::events::HUP, IoEvents::HUP),
+        ] {
+            if events & bit != 0 {
+                io_events |= event;
+            }
+        }
+        io_events
+    }
+
+    fn address_of(bytes: Vec<u8>) -> SocketAddr {
+        SocketAddr::Bluetooth(BluetoothSocketAddr::new(&bytes))
+    }
+}
+
+impl BluetoothSocket {
+    fn take_error(&self) -> Option<Error> {
+        self.inner.take_error().map(errno)
+    }
+}
+
+impl Socket for BluetoothSocket {
+    fn bind(&self, socket_addr: SocketAddr) -> Result<()> {
+        let SocketAddr::Bluetooth(address) = socket_addr else {
+            return_errno_with_message!(Errno::EINVAL, "not a Bluetooth socket address");
+        };
+        let privileged = has_capability(CapSet::NET_BIND_SERVICE).is_ok();
+        self.inner.bind(address.as_bytes(), privileged).map_err(errno)
+    }
+
+    fn listen(&self, backlog: usize) -> Result<()> {
+        self.inner.listen(backlog).map_err(errno)
+    }
+
+    fn accept(&self, is_nonblocking: bool) -> Result<(Arc<dyn FileLike>, SocketAddr)> {
+        let connection = self.block_on(IoEvents::IN, None, || {
+            let result = self.inner.accept().map_err(errno);
+            self.pollee.invalidate();
+            result
+        })?;
+        let peer = connection.peer_address().unwrap_or_default();
+        let socket = Self::wrap(connection, is_nonblocking);
+        Ok((socket as Arc<dyn FileLike>, Self::address_of(peer)))
+    }
+
+    fn connect(&self, socket_addr: SocketAddr) -> Result<()> {
+        /// `EINPROGRESS`: the link and the channel are being made.
+        const EINPROGRESS: i32 = 115;
+        let SocketAddr::Bluetooth(address) = socket_addr else {
+            return_errno_with_message!(Errno::EINVAL, "not a Bluetooth socket address");
+        };
+        match self.inner.connect(address.as_bytes()) {
+            Ok(()) => return Ok(()),
+            Err(EINPROGRESS) if !self.is_nonblocking() => {}
+            Err(code) => return Err(errno(code)),
+        }
+        // Until it is connected or it failed.
+        self.block_on(IoEvents::OUT | IoEvents::ERR | IoEvents::HUP, None, || {
+            let result = match self.inner.connect_result() {
+                Err(EINPROGRESS) => Err(Error::with_message(Errno::EAGAIN, "the connection is being made")),
+                other => other.map_err(errno),
+            };
+            self.pollee.invalidate();
+            result
+        })
+    }
+
+    fn shutdown(&self, cmd: SockShutdownCmd) -> Result<()> {
+        let write = matches!(cmd, SockShutdownCmd::SHUT_WR | SockShutdownCmd::SHUT_RDWR);
+        self.inner.shutdown(cmd.shut_read(), write).map_err(errno)
+    }
+
+    fn addr(&self) -> Result<SocketAddr> {
+        Ok(Self::address_of(self.inner.local_address()))
+    }
+
+    fn peer_addr(&self) -> Result<SocketAddr> {
+        Ok(Self::address_of(self.inner.peer_address().map_err(errno)?))
+    }
+
+    fn sendmsg(&self, reader: &mut dyn MultiRead, _message_header: MessageHeader, flags: SendFlags) -> Result<usize> {
+        let stream = self.inner.is_stream();
+        let mut length = reader.sum_lens();
+        if length > MAX_MESSAGE {
+            if !stream {
+                return_errno_with_message!(Errno::EMSGSIZE, "the message is too long");
+            }
+            // A stream takes it in parts.
+            length = MAX_MESSAGE;
+        }
+        let mut data = vec![0u8; length];
+        reader.read(&mut VmWriter::from(&mut data[..]))?;
+        let dont_wait = flags.contains(SendFlags::MSG_DONTWAIT);
+        let mut sent = 0;
+        loop {
+            // Waits for room; once some went, a socket that does not wait
+            // says how much.
+            let result = self.block_on_unless(IoEvents::OUT, self.timeouts.send_timeout(), dont_wait || (sent > 0 && self.is_nonblocking()), || {
+                let result = self.inner.send(&data[sent..]).map_err(errno);
+                self.pollee.invalidate();
+                result
+            });
+            match result {
+                Ok(count) => {
+                    sent += count;
+                    if !stream || sent >= data.len() {
+                        return Ok(sent);
+                    }
+                }
+                Err(_) if sent > 0 => return Ok(sent),
+                Err(error) => return Err(error),
+            }
+        }
+    }
+
+    fn recvmsg(&self, writer: &mut dyn MultiWrite, flags: RecvFlags) -> Result<(RecvOutput, MessageHeader)> {
+        let max = writer.sum_lens();
+        let data = self.block_on_unless(IoEvents::IN, self.timeouts.recv_timeout(), flags.contains(RecvFlags::MSG_DONTWAIT), || {
+            let result = self.inner.recv(flags.contains(RecvFlags::MSG_PEEK), max).map_err(errno);
+            self.pollee.invalidate();
+            result
+        })?;
+        let copied = data.len().min(writer.sum_lens());
+        writer.write(&mut VmReader::from(&data[..copied]))?;
+        let peer = self.inner.peer_address().ok().map(Self::address_of);
+        Ok((RecvOutput::new_for_packet(flags, copied, data.len()), MessageHeader::new(peer, Vec::new())))
+    }
+
+    fn get_option(&self, option: &mut dyn SocketOption) -> Result<()> {
+        sock_option_mut!(match option {
+            socket_errors @ SocketError => {
+                socket_errors.set(self.take_error());
+                return Ok(());
+            }
+            send_timeout @ SendTimeout => {
+                send_timeout.set(SocketTimeout::new(self.timeouts.send_timeout()));
+                return Ok(());
+            }
+            recv_timeout @ RecvTimeout => {
+                recv_timeout.set(SocketTimeout::new(self.timeouts.recv_timeout()));
+                return Ok(());
+            }
+            _ => (),
+        });
+        return_errno_with_message!(Errno::ENOPROTOOPT, "the socket option is not supported");
+    }
+
+    fn set_option(&self, option: &dyn SocketOption) -> Result<()> {
+        sock_option_ref!(match option {
+            send_timeout @ SendTimeout => {
+                let timeout = send_timeout.get().unwrap().duration();
+                self.timeouts.set_send_timeout(timeout);
+                // Also how long a connection may take, as Linux's L2CAP
+                // has it.
+                self.inner.set_connect_timeout(timeout.map(|timeout| timeout.as_millis() as u64));
+                return Ok(());
+            }
+            recv_timeout @ RecvTimeout => {
+                self.timeouts.set_recv_timeout(recv_timeout.get().unwrap().duration());
+                return Ok(());
+            }
+            _ => (),
+        });
+        // Priorities and buffer sizes (bluetoothd's profiles): taken.
+        Ok(())
+    }
+
+    fn family_and_protocol(&self) -> Option<(i32, i32)> {
+        let protocol = match self.inner.protocol() {
+            Protocol::L2cap => proto::BTPROTO_L2CAP,
+            Protocol::Rfcomm => proto::BTPROTO_RFCOMM,
+            Protocol::Sco => proto::BTPROTO_SCO,
+        };
+        Some((AF_BLUETOOTH, protocol))
+    }
+
+    fn reads_own_options(&self, level: i32) -> bool {
+        self.inner.protocol().option_level(level)
+    }
+
+    fn set_own_option(&self, level: i32, name: i32, value: &[u8]) -> Result<()> {
+        self.inner.set_option(level, name, value).map_err(errno)
+    }
+
+    fn get_own_option(&self, level: i32, name: i32) -> Result<Vec<u8>> {
+        self.inner.get_option(level, name).map_err(errno)
+    }
+
+    fn common(&self) -> &FileCommon {
+        &self.common
+    }
+}
+
+impl SocketPrivate for BluetoothSocket {
+    fn is_nonblocking(&self) -> bool {
+        self.common.is_nonblocking()
+    }
+}
+
+impl Pollable for BluetoothSocket {
+    fn poll(&self, mask: IoEvents, poller: Option<&mut PollHandle>) -> IoEvents {
+        self.pollee.poll_with(mask, poller, || self.check_io_events())
+    }
+}
