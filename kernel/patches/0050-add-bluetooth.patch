+            let length = size.saturating_sub((event.status & 0xff_ffff) as usize);
+            let mut data = vec![0u8; length];
+            let buffers = if inward_events { &bluetooth.event_buffers } else { &bluetooth.rx_buffers };
+            if buffers.read_bytes(index * slot_size, &mut data).is_ok() {
+                let bootloader = bluetooth.shared.bootloader.load(Ordering::Acquire);
+                let (packets, kind) = if inward_events {
+                    (bluetooth.events.push(&data), aster_bluetooth::hci::EVENT_PKT)
+                } else if bootloader {
+                    (bluetooth.bulk_events.push(&data), aster_bluetooth::hci::EVENT_PKT)
+                } else {
+                    (bluetooth.acl.push(&data), aster_bluetooth::hci::ACL_PKT)
+                };
+                for packet in packets {
+                    bluetooth.controller.receive(kind, &packet);
+                }
+            }
+        }
+        if code == STALL {
+            ostd::notice!("{}: hci{}: endpoint {} stalled", self.name, bluetooth.controller.index(), dci);
+            bluetooth.events.clear();
+            bluetooth.acl.clear();
+            return;
+        }
+        if inward_events {
+            Self::queue_bt_event(bluetooth, index);
+        } else {
+            Self::queue_bt_rx(bluetooth, index);
+        }
+        self.ring(slot_id, dci);
+    }
+
+    /// Moves what the Bluetooth stack sent to the controllers: commands as
+    /// control transfers (Intel's firmware on the bulk endpoint), ACL data
+    /// on the bulk endpoint.
+    fn send_bluetooth(&mut self) {
+        let slot_ids: Vec<u8> = self.slots.iter().filter(|(_, slot)| !slot.bt.is_empty()).map(|(id, _)| *id).collect();
+        for slot_id in slot_ids {
+            for which in 0..self.slots.get(&slot_id).map_or(0, |slot| slot.bt.len()) {
+                loop {
+                    let Some(bluetooth) = self.slots.get_mut(&slot_id).and_then(|slot| slot.bt.get_mut(which)) else { break };
+                    let next = {
+                        let mut tx = bluetooth.shared.tx.lock();
+                        match tx.front() {
+                            // Bulk sends wait for a free buffer.
+                            Some((kind, packet))
+                                if (*kind == aster_bluetooth::hci::ACL_PKT || bt::command_on_bulk(&bluetooth.shared, packet))
+                                    && bluetooth.tx_free.is_empty() =>
+                            {
+                                None
+                            }
+                            Some(_) => tx.pop_front(),
+                            None => None,
+                        }
+                    };
+                    let Some((kind, packet)) = next else { break };
+                    if kind == aster_bluetooth::hci::COMMAND_PKT && !bt::command_on_bulk(&bluetooth.shared, &packet) {
+                        if let Err(error) = self.control(slot_id, 0x20, 0x00, 0, 0, Data::Out(&packet)) {
+                            ostd::notice!("{}: slot {}: a Bluetooth command did not go out: {:?}", self.name, slot_id, error);
+                        }
+                        continue;
+                    }
+                    let index = bluetooth.tx_free.pop().unwrap();
+                    let length = packet.len().min(BT_BUFFER);
+                    if bluetooth.tx_buffers.write_bytes(index * BT_BUFFER, &packet[..length]).is_err() {
+                        bluetooth.tx_free.push(index);
+                        continue;
+                    }
+                    let address = bluetooth.tx_ring.push(Trb {
+                        parameter: bluetooth.tx_buffers.daddr() as u64 + (index * BT_BUFFER) as u64,
+                        status: length as u32,
+                        control: Trb::with_type(trb_type::NORMAL) | IOC,
+                    });
+                    bluetooth.tx_in_flight.push((address, index));
+                    let dci = bluetooth.tx_dci;
+                    self.ring(slot_id, dci);
+                }
+            }
+        }
+    }
+
