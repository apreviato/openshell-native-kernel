+// SPDX-License-Identifier: MPL-2.0
+
+//! L2CAP channels on the links, as Linux's `l2cap_core` makes them for
+//! sockets: on BR/EDR, the signaling channel connects a socket's channel to
+//! a PSM of the device (connection request and response, configuration
+//! both ways, disconnection), answers the device's requests (to our
+//! listeners, echo, information); on LE, the fixed channels: ATT (GATT,
+//! bluetoothd's), the security manager (`smp`), LE signaling (connection
+//! parameters). Data goes in basic-mode frames.
+//!
+//! Lock order: never a socket's lock while sending on a link.
+
+use alloc::{
+    sync::{Arc, Weak},
+    vec,
+    vec::Vec,
+};
+
+use ostd::sync::{LocalIrqDisabled, SpinLock};
+
+use crate::{
+    device::Device,
+    device_at, devices,
+    link::{self, SECURITY_LOW, SECURITY_MEDIUM},
+    pairing,
+    proto::{self, Address, BDADDR_BREDR, Phase, ProtoSocket, Protocol},
+    smp,
+};
+
+pub(crate) const CID_SIGNALING: u16 = 0x0001;
+pub(crate) const CID_ATT: u16 = 0x0004;
+pub(crate) const CID_LE_SIGNALING: u16 = 0x0005;
+pub(crate) const CID_SMP: u16 = 0x0006;
+const CID_DYNAMIC: u16 = 0x0040;
+/// SDP's PSM: its channels need no security.
+const PSM_SDP: u16 = 0x0001;
+const DEFAULT_MTU: u16 = 672;
+
+/// Signaling commands.
+const COMMAND_REJECT: u8 = 0x01;
+const CONNECTION_REQUEST: u8 = 0x02;
+const CONNECTION_RESPONSE: u8 = 0x03;
+const CONFIGURE_REQUEST: u8 = 0x04;
+const CONFIGURE_RESPONSE: u8 = 0x05;
+const DISCONNECTION_REQUEST: u8 = 0x06;
+const DISCONNECTION_RESPONSE: u8 = 0x07;
+const ECHO_REQUEST: u8 = 0x08;
+const ECHO_RESPONSE: u8 = 0x09;
+const INFORMATION_REQUEST: u8 = 0x0a;
+const INFORMATION_RESPONSE: u8 = 0x0b;
+const CONNECTION_PARAMETER_UPDATE_REQUEST: u8 = 0x12;
+const CONNECTION_PARAMETER_UPDATE_RESPONSE: u8 = 0x13;
+const LE_CREDIT_CONNECTION_REQUEST: u8 = 0x14;
+const LE_CREDIT_CONNECTION_RESPONSE: u8 = 0x15;
+
+/// Connection results.
+const RESULT_SUCCESS: u16 = 0x0000;
+const RESULT_PENDING: u16 = 0x0001;
+const RESULT_PSM_NOT_SUPPORTED: u16 = 0x0002;
+const RESULT_SECURITY_BLOCK: u16 = 0x0003;
+const STATUS_NO_INFO: u16 = 0x0000;
+const STATUS_AUTHENTICATION_PENDING: u16 = 0x0001;
+const STATUS_AUTHORIZATION_PENDING: u16 = 0x0002;
+/// Command reject reasons.
+const REJECT_NOT_UNDERSTOOD: u16 = 0x0000;
+const REJECT_INVALID_CID: u16 = 0x0002;
+/// The information request for the device's features (its extended
+/// feature mask).
+const INFO_FEATURE_MASK: u16 = 0x0002;
+
+/// Linux's errno values for what happens to channels.
+const ECONNREFUSED: i32 = 111;
+const ECONNRESET: i32 = 104;
+const EACCES: i32 = 13;
+const EHOSTUNREACH: i32 = 113;
+const EHOSTDOWN: i32 = 112;
+const ETIMEDOUT: i32 = 110;
+const EMSGSIZE: i32 = 90;
+const ENOTCONN: i32 = 107;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Stage {
+    /// The link is being made.
+    WaitLink,
+    /// The link's security is being raised.
+    WaitSecurity,
+    /// The device's features are being asked for (once per link, before
+    /// any channel goes on, as Linux asks).
+    WaitInfo,
+    /// The device's request waits for what its host supports (unanswered).
+    WaitRemote,
+    /// Our connection request is out.
+    WaitResponse,
+    /// The program has yet to take it (`BT_DEFER_SETUP`).
+    Deferred,
+    /// Configuration: ours accepted, theirs accepted.
+    Config(bool, bool),
+    Open,
+    /// Our disconnection request is out.
+    Disconnecting,
+}
+
+/// A socket's channel.
+#[derive(Clone, Debug)]
+pub(crate) struct Channel {
+    pub device: u16,
+    pub handle: u16,
+    pub le: bool,
+    /// Our channel id and theirs.
+    pub scid: u16,
+    pub dcid: u16,
+    /// The most the device takes in a frame.
+    pub omtu: u16,
+    pub psm: u16,
+    pub stage: Stage,
+    /// The identifier of the request we answer or wait an answer for.
+    pub ident: u8,
+    pub incoming: bool,
+    /// The security the channel needs.
+    pub security: u8,
+}
+
+/// Accepted connections not yet handed to their listener (they are, once
+/// configured), with the listener.
+static PENDING: SpinLock<Vec<(Arc<ProtoSocket>, Weak<ProtoSocket>)>, LocalIrqDisabled> = SpinLock::new(Vec::new());
+
+pub(crate) fn errno_of(status: u8) -> i32 {
+    match status {
+        0x04 => EHOSTDOWN,
+        0x05 | 0x06 | 0x18 => EACCES,
+        0x08 | 0x22 => ETIMEDOUT,
+        0x0d..=0x0f => ECONNREFUSED,
+        0x13..=0x15 => ECONNRESET,
+        _ => EHOSTUNREACH,
+    }
+}
+
+/// Every socket with a channel on `device`, and the pending ones.
+fn channel_sockets(device: u16) -> Vec<Arc<ProtoSocket>> {
+    let mut all: Vec<_> = proto::sockets()
+        .into_iter()
+        .filter(|socket| socket.state.lock().channel.as_ref().is_some_and(|channel| channel.device == device))
+        .collect();
+    for (child, _) in PENDING.lock().iter() {
+        if !all.iter().any(|socket| Arc::ptr_eq(socket, child))
+            && child.state.lock().channel.as_ref().is_some_and(|channel| channel.device == device)
+        {
+            all.push(child.clone());
+        }
+    }
+    all
+}
+
+fn find(device: u16, handle: u16, scid: u16) -> Option<Arc<ProtoSocket>> {
+    channel_sockets(device).into_iter().find(|socket| {
+        socket.state.lock().channel.as_ref().is_some_and(|channel| channel.handle == handle && channel.scid == scid)
+    })
+}
+
+fn find_by_ident(device: u16, handle: u16, ident: u8) -> Option<Arc<ProtoSocket>> {
+    channel_sockets(device).into_iter().find(|socket| {
+        socket.state.lock().channel.as_ref().is_some_and(|channel| {
+            channel.handle == handle && channel.ident == ident && channel.stage == Stage::WaitResponse
+        })
+    })
+}
+
+/// How many channels a link carries.
+pub(crate) fn channels_on(device: u16, handle: u16) -> usize {
+    channel_sockets(device)
+        .iter()
+        .filter(|socket| socket.state.lock().channel.as_ref().is_some_and(|channel| channel.handle == handle))
+        .count()
+}
+
+/// A dynamic channel id free on the device.
+fn allocate_cid(device: u16) -> u16 {
+    let used: Vec<u16> = channel_sockets(device)
+        .iter()
+        .filter_map(|socket| socket.state.lock().channel.as_ref().map(|channel| channel.scid))
+        .collect();
+    (CID_DYNAMIC..=0xffff).find(|cid| !used.contains(cid)).unwrap_or(CID_DYNAMIC)
+}
+
+/// A signaling command on a link.
+fn signal(device: &Device, handle: u16, cid: u16, code: u8, ident: u8, data: &[u8]) {
+    let mut frame = Vec::with_capacity(8 + data.len());
+    frame.extend_from_slice(&((4 + data.len()) as u16).to_le_bytes());
+    frame.extend_from_slice(&cid.to_le_bytes());
+    frame.push(code);
+    frame.push(ident);
+    frame.extend_from_slice(&(data.len() as u16).to_le_bytes());
+    frame.extend_from_slice(data);
+    link::send_frame(device, handle, &frame);
+}
+
+fn next_ident(device: &Device, handle: u16) -> u8 {
+    device.links.lock().by_handle(handle).map_or(1, |link| link.next_signal_id())
+}
+
+/// A frame on a link, by its channel.
+pub(crate) fn receive(device: &Device, handle: u16, cid: u16, payload: &[u8]) {
+    match cid {
+        CID_SIGNALING => signaling(device, handle, payload),
+        CID_LE_SIGNALING => le_signaling(device, handle, payload),
+        CID_SMP => smp::receive(device, handle, payload),
+        _ => {
+            if cid == CID_ATT && find(device.index, handle, CID_ATT).is_none() {
+                offer_att(device, handle);
+            }
+            let Some(socket) = find(device.index, handle, cid) else {
+                return;
+            };
+            {
+                let mut state = socket.state.lock();
+                if !state.channel.as_ref().is_some_and(|channel| channel.stage == Stage::Open) {
+                    return;
+                }
+                // Messages wait for the program; past a backlog, the device
+                // is out-paced and the oldest go.
+                if state.rx.len() >= 1024 {
+                    state.rx.pop_front();
+                }
+                state.rx.push_back(payload.to_vec());
+            }
+            socket.wake();
+        }
+    }
+}
+
+/// The device a socket connects through: the controller its address names,
+/// or the first one powered.
+pub(crate) fn route(local: &Address) -> Option<Arc<Device>> {
+    devices().into_iter().find(|device| {
+        let state = device.state.lock();
+        state.ready
+            && !state.removed
+            && state.settings & crate::mgmt::settings::POWERED != 0
+            && (local.address == [0; 6] || local.address == state.info.address)
+    })
+}
+
+/// A socket connects (its peer set): a channel waits for the link.
+pub(crate) fn connect(socket: &ProtoSocket) -> Result<(), i32> {
+    let socket = &proto::arc_of(socket).ok_or(ENOTCONN)?;
+    let (local, peer, security) = {
+        let state = socket.state.lock();
+        (state.local, state.peer, state.security)
+    };
+    let device = route(&local).ok_or(EHOSTUNREACH)?;
+    let le = peer.address_type != BDADDR_BREDR;
+    let scid = if le { CID_ATT } else { allocate_cid(device.index) };
+    {
+        let mut state = socket.state.lock();
+        state.local.address = device.state.lock().info.address;
+        state.local.address_type = if le { proto::BDADDR_LE_PUBLIC } else { BDADDR_BREDR };
+        state.channel = Some(Channel {
+            device: device.index,
+            handle: 0,
+            le,
+            scid,
+            dcid: if le { CID_ATT } else { 0 },
+            omtu: DEFAULT_MTU,
+            psm: peer.psm,
+            stage: Stage::WaitLink,
+            ident: 0,
+            incoming: false,
+            security,
+        });
+    }
+    if link::connect(&device, peer.address, peer.address_type) {
+        if let Some(handle) = link::handle_of(&device, &peer.address, le) {
+            start(&device, socket, handle);
+        }
+    }
+    Ok(())
+}
+
+/// The link is up: on BR/EDR the device's features first (its host's and
+/// L2CAP's, as Linux learns them), then the security the channel needs
+/// (when it needs more than the link has), then the channel.
+fn start(device: &Device, socket: &Arc<ProtoSocket>, handle: u16) {
+    let le = {
+        let mut state = socket.state.lock();
+        let Some(channel) = state.channel.as_mut() else { return };
+        channel.handle = handle;
+        channel.le
+    };
+    if !le && !features_known(device, handle) {
+        set_stage(socket, Stage::WaitInfo);
+        request_info(device, handle);
+        return;
+    }
+    secure_outgoing(device, socket);
+}
+
+/// An outgoing channel's security.
+fn secure_outgoing(device: &Device, socket: &Arc<ProtoSocket>) {
+    let Some(channel) = socket.state.lock().channel.clone() else { return };
+    let needed = required_security(device, &channel);
+    if needed > current_security(device, channel.handle).max(SECURITY_LOW) {
+        set_stage(socket, Stage::WaitSecurity);
+        if channel.le {
+            smp::secure(device, channel.handle, needed);
+        } else {
+            pairing::secure(device, channel.handle, needed);
+        }
+        return;
+    }
+    proceed(device, socket);
+}
+
+/// The security a channel needs: what it asks for, and on a link both
+/// sides pair with Simple Pairing at least an encrypted one, SDP's
+/// excepted (Linux's security mode 4).
+fn required_security(device: &Device, channel: &Channel) -> u8 {
+    if !channel.le && channel.psm != PSM_SDP && ssp_link(device, channel.handle) {
+        channel.security.max(SECURITY_MEDIUM)
+    } else {
+        channel.security
+    }
+}
+
+/// Both sides of a BR/EDR link do Simple Pairing.
+fn ssp_link(device: &Device, handle: u16) -> bool {
+    let local = device.settings() & crate::mgmt::settings::SSP != 0;
+    local && device.links.lock().by_handle(handle).is_some_and(|link| link.remote_ssp == Some(true))
+}
+
+fn set_stage(socket: &ProtoSocket, stage: Stage) {
+    if let Some(channel) = socket.state.lock().channel.as_mut() {
+        channel.stage = stage;
+    }
+}
+
+/// After the link (and its security): an LE channel is open; a BR/EDR one
+/// asks the device for its PSM, or answers the device's request.
+fn proceed(device: &Device, socket: &Arc<ProtoSocket>) {
+    let Some(channel) = socket.state.lock().channel.clone() else { return };
+    if channel.le {
+        opened(socket);
+        return;
+    }
+    if channel.incoming {
+        respond_connection(device, &channel, RESULT_SUCCESS, 0);
+        configure(device, socket);
+    } else {
+        request_connection(device, socket);
+    }
+}
+
+/// Whether the link's device features are known: its host's (Simple
+/// Pairing) and L2CAP's.
+fn features_known(device: &Device, handle: u16) -> bool {
+    device.links.lock().by_handle(handle).is_none_or(|link| link.features.is_some() && link.remote_ssp.is_some())
+}
+
+/// Asks the device for its features, once per link.
+fn request_info(device: &Device, handle: u16) {
+    let ident = {
+        let mut links = device.links.lock();
+        let Some(link) = links.by_handle(handle) else { return };
+        if link.features.is_some() || link.info_request.is_some() {
+            return;
+        }
+        let ident = link.next_signal_id();
+        link.info_request = Some((ident, crate::now_ms()));
+        ident
+    };
+    signal(device, handle, CID_SIGNALING, INFORMATION_REQUEST, ident, &INFO_FEATURE_MASK.to_le_bytes());
+    // Its answer is waited for a while only.
+    crate::wake_task(device);
+}
+
+/// The device said its features (or did not, `features` 0): the channels
+/// waiting for them go on.
+pub(crate) fn info_done(device: &Device, handle: u16, ident: Option<u8>, features: u32) {
+    {
+        let mut links = device.links.lock();
+        let Some(link) = links.by_handle(handle) else { return };
+        match link.info_request {
+            Some((sent, _)) if ident.is_none_or(|ident| ident == sent) => {}
+            _ => return,
+        }
+        link.info_request = None;
+        link.features = Some(features);
+    }
+    progress(device, handle);
+}
+
+/// The device's host features are known (`link`): the channels waiting
+/// for them go on.
+pub(crate) fn remote_known(device: &Device, handle: u16) {
+    progress(device, handle);
+}
+
+/// The channels waiting for the device's features go on, as far as what
+/// is known lets them.
+fn progress(device: &Device, handle: u16) {
+    for socket in channel_sockets(device.index) {
+        let Some(channel) = socket.state.lock().channel.clone() else { continue };
+        if channel.handle != handle || !matches!(channel.stage, Stage::WaitInfo | Stage::WaitRemote) {
+            continue;
+        }
+        if channel.incoming {
+            incoming_step(device, &socket);
+        } else if features_known(device, handle) {
+            secure_outgoing(device, &socket);
+        }
+    }
+}
+
+/// Our connection request, for an outgoing channel.
+fn request_connection(device: &Device, socket: &Arc<ProtoSocket>) {
+    let Some(channel) = socket.state.lock().channel.clone() else { return };
+    {
+        let ident = next_ident(device, channel.handle);
+        if let Some(stored) = socket.state.lock().channel.as_mut() {
+            stored.ident = ident;
+            stored.stage = Stage::WaitResponse;
+        }
+        let mut data = channel.psm.to_le_bytes().to_vec();
+        data.extend_from_slice(&channel.scid.to_le_bytes());
+        signal(device, channel.handle, CID_SIGNALING, CONNECTION_REQUEST, ident, &data);
+    }
+}
+
+fn respond_connection(device: &Device, channel: &Channel, result: u16, status: u16) {
+    let mut data = Vec::with_capacity(8);
+    let dcid = if result == RESULT_SUCCESS || result == RESULT_PENDING { channel.scid } else { 0 };
+    data.extend_from_slice(&dcid.to_le_bytes());
+    data.extend_from_slice(&channel.dcid.to_le_bytes());
+    data.extend_from_slice(&result.to_le_bytes());
+    data.extend_from_slice(&status.to_le_bytes());
+    signal(device, channel.handle, CID_SIGNALING, CONNECTION_RESPONSE, channel.ident, &data);
+}
+
+/// Our configuration request: the MTU we take.
+fn configure(device: &Device, socket: &ProtoSocket) {
+    let (channel, imtu) = {
+        let mut state = socket.state.lock();
+        let imtu = state.imtu;
+        let Some(channel) = state.channel.as_mut() else { return };
+        channel.stage = Stage::Config(false, matches!(channel.stage, Stage::Config(_, true)));
+        (channel.clone(), imtu)
+    };
+    let ident = next_ident(device, channel.handle);
+    let mut data = channel.dcid.to_le_bytes().to_vec();
+    data.extend_from_slice(&0u16.to_le_bytes());
+    data.extend_from_slice(&[0x01, 2]);
+    data.extend_from_slice(&imtu.to_le_bytes());
+    signal(device, channel.handle, CID_SIGNALING, CONFIGURE_REQUEST, ident, &data);
+}
+
+/// Both sides configured: the channel carries data.
+fn opened(socket: &Arc<ProtoSocket>) {
+    let incoming = {
+        let mut state = socket.state.lock();
+        let Some(channel) = state.channel.as_mut() else { return };
+        channel.stage = Stage::Open;
+        let incoming = channel.incoming;
+        state.phase = Phase::Connected;
+        incoming
+    };
+    socket.wake();
+    if incoming {
+        hand_over(socket);
+    }
+}
+
+/// An accepted connection goes to its listener once it is set up.
+fn hand_over(socket: &Arc<ProtoSocket>) {
+    let listener = {
+        let mut pending = PENDING.lock();
+        let Some(position) = pending.iter().position(|(child, _)| Arc::ptr_eq(child, socket)) else { return };
+        pending.remove(position).1
+    };
+    let offered = listener.upgrade().is_some_and(|listener| listener.offer(socket.clone()));
+    if !offered {
+        close(socket);
+    }
+}
+
+/// The BR/EDR signaling channel: several commands in a frame.
+fn signaling(device: &Device, handle: u16, mut data: &[u8]) {
+    while data.len() >= 4 {
+        let (code, ident) = (data[0], data[1]);
+        let length = u16::from_le_bytes([data[2], data[3]]) as usize;
+        let Some(body) = data.get(4..4 + length) else { break };
+        data = &data[4 + length..];
+        let le16 = |at: usize| body.get(at..at + 2).map(|b| u16::from_le_bytes([b[0], b[1]])).unwrap_or(0);
+        // A command too short for what it is: not understood (Linux's
+        // command reject).
+        let minimum = match code {
+            CONNECTION_REQUEST | DISCONNECTION_REQUEST | DISCONNECTION_RESPONSE | CONFIGURE_REQUEST | INFORMATION_RESPONSE => 4,
+            CONNECTION_RESPONSE => 8,
+            CONFIGURE_RESPONSE => 6,
+            INFORMATION_REQUEST | COMMAND_REJECT => 2,
+            _ => 0,
+        };
+        if body.len() < minimum {
+            signal(device, handle, CID_SIGNALING, COMMAND_REJECT, ident, &REJECT_NOT_UNDERSTOOD.to_le_bytes());
+            continue;
+        }
+        match code {
+            CONNECTION_REQUEST => incoming_connection(device, handle, ident, le16(0), le16(2)),
+            CONNECTION_RESPONSE => connection_response(device, handle, ident, le16(0), le16(2), le16(4)),
+            CONFIGURE_REQUEST => configure_request(device, handle, ident, le16(0), le16(2), body.get(4..).unwrap_or(&[])),
+            CONFIGURE_RESPONSE => configure_response(device, handle, le16(0), le16(4), body.get(6..).unwrap_or(&[])),
+            DISCONNECTION_REQUEST => {
+                let (ours, theirs) = (le16(0), le16(2));
+                let socket = find(device.index, handle, ours).filter(|socket| {
+                    socket.state.lock().channel.as_ref().is_some_and(|channel| channel.dcid == theirs)
+                });
+                match socket {
+                    Some(socket) => {
+                        signal(device, handle, CID_SIGNALING, DISCONNECTION_RESPONSE, ident, &body[..4]);
+                        closed(device, &socket, Some(ECONNRESET));
+                    }
+                    None => {
+                        // No such channel: an invalid CID, both said back.
+                        let mut data = REJECT_INVALID_CID.to_le_bytes().to_vec();
+                        data.extend_from_slice(&body[..4]);
+                        signal(device, handle, CID_SIGNALING, COMMAND_REJECT, ident, &data);
+                    }
+                }
+            }
+            DISCONNECTION_RESPONSE => {
+                // Our request answered: the channel closes (`SHUT_WR`).
+                if let Some(socket) = find(device.index, handle, le16(2)).filter(|socket| {
+                    socket.state.lock().channel.as_ref().is_some_and(|channel| channel.stage == Stage::Disconnecting)
+                }) {
+                    closed(device, &socket, None);
+                }
+            }
+            ECHO_REQUEST => signal(device, handle, CID_SIGNALING, ECHO_RESPONSE, ident, body),
+            INFORMATION_REQUEST => {
+                let kind = le16(0);
+                let mut reply = kind.to_le_bytes().to_vec();
+                match kind {
+                    // Features: fixed channels (basic mode only).
+                    0x0002 => {
+                        reply.extend_from_slice(&RESULT_SUCCESS.to_le_bytes());
+                        reply.extend_from_slice(&0x0000_0080u32.to_le_bytes());
+                    }
+                    // Fixed channels: signaling.
+                    0x0003 => {
+                        reply.extend_from_slice(&RESULT_SUCCESS.to_le_bytes());
+                        reply.extend_from_slice(&0x02u64.to_le_bytes());
+                    }
+                    _ => reply.extend_from_slice(&0x0001u16.to_le_bytes()),
+                }
+                signal(device, handle, CID_SIGNALING, INFORMATION_RESPONSE, ident, &reply);
+            }
+            INFORMATION_RESPONSE => {
+                let (kind, result) = (le16(0), le16(2));
+                let features = match body.get(4..8) {
+                    Some(mask) if kind == INFO_FEATURE_MASK && result == RESULT_SUCCESS => u32::from_le_bytes(mask.try_into().unwrap()),
+                    _ => 0,
+                };
+                info_done(device, handle, Some(ident), features);
+            }
+            COMMAND_REJECT => {
+                // Our information request refused: the channels go on.
+                info_done(device, handle, Some(ident), 0);
+                if let Some(socket) = find_by_ident(device.index, handle, ident) {
+                    closed(device, &socket, Some(ECONNREFUSED));
+                }
+            }
+            _ => signal(device, handle, CID_SIGNALING, COMMAND_REJECT, ident, &[0, 0]),
+        }
+    }
+}
+
+/// The device connects to one of our PSMs.
+fn incoming_connection(device: &Device, handle: u16, ident: u8, psm: u16, their_cid: u16) {
+    let Some((address, _, _)) = link::peer_of(device, handle) else { return };
+    let own = device.state.lock().info.address;
+    let listener = proto::sockets().into_iter().find(|socket| {
+        let state = socket.state.lock();
+        socket.protocol == Protocol::L2cap
+            && state.phase == Phase::Listening
+            && state.local.psm == psm
+            && state.local.address_type == BDADDR_BREDR
+            && (state.local.address == [0; 6] || state.local.address == own)
+    });
+    let refuse = |result: u16| {
+        let mut data = 0u16.to_le_bytes().to_vec();
+        data.extend_from_slice(&their_cid.to_le_bytes());
+        data.extend_from_slice(&result.to_le_bytes());
+        data.extend_from_slice(&0u16.to_le_bytes());
+        signal(device, handle, CID_SIGNALING, CONNECTION_RESPONSE, ident, &data);
+    };
+    let Some(listener) = listener else {
+        refuse(RESULT_PSM_NOT_SUPPORTED);
+        return;
+    };
+    let child = listener.child();
+    let needed = listener.state.lock().security;
+    let scid = allocate_cid(device.index);
+    let channel = Channel {
+        device: device.index,
+        handle,
+        le: false,
+        scid,
+        dcid: their_cid,
+        omtu: DEFAULT_MTU,
+        psm,
+        stage: Stage::Config(false, false),
+        ident,
+        incoming: true,
+        security: needed,
+    };
+    {
+        let mut state = child.state.lock();
+        state.local.address = own;
+        state.peer = Address { address, address_type: BDADDR_BREDR, psm, cid: their_cid, channel: 0 };
+        state.channel = Some(channel.clone());
+    }
+    PENDING.lock().push((child.clone(), Arc::downgrade(&listener)));
+    incoming_step(device, &child);
+}
+
+/// The device's request goes on as what it needs is known: its host's
+/// features (on a link both sides pair with Simple Pairing, the device
+/// encrypts before any channel but SDP's, or it is blocked: Linux's
+/// security mode 4), L2CAP's (the answer pending meanwhile), then the
+/// listener's security.
+fn incoming_step(device: &Device, child: &Arc<ProtoSocket>) {
+    let Some(channel) = child.state.lock().channel.clone() else { return };
+    let (remote_ssp, features, encrypted) = device
+        .links
+        .lock()
+        .by_handle(channel.handle)
+        .map_or((Some(false), Some(0), false), |link| (link.remote_ssp, link.features, link.encrypted));
+    let Some(remote_ssp) = remote_ssp else {
+        // Unanswered until the device's host is known.
+        set_stage(child, Stage::WaitRemote);
+        return;
+    };
+    let ssp = remote_ssp && device.settings() & crate::mgmt::settings::SSP != 0;
+    if channel.psm != PSM_SDP && ssp && !encrypted {
+        respond_connection(device, &channel, RESULT_SECURITY_BLOCK, 0);
+        closed(device, child, Some(EACCES));
+        return;
+    }
+    if features.is_none() {
+        if channel.stage != Stage::WaitInfo {
+            set_stage(child, Stage::WaitInfo);
+            respond_connection(device, &channel, RESULT_PENDING, STATUS_NO_INFO);
+            request_info(device, channel.handle);
+        }
+        return;
+    }
+    admit(device, child);
+}
+
+/// The device's channel goes on: the security it needs, then the program
+/// (deferred) or the configuration.
+fn admit(device: &Device, child: &Arc<ProtoSocket>) {
+    let Some(channel) = child.state.lock().channel.clone() else { return };
+    let listener = PENDING.lock().iter().find(|(pending, _)| Arc::ptr_eq(pending, child)).and_then(|(_, listener)| listener.upgrade());
+    let Some(listener) = listener else {
+        respond_connection(device, &channel, RESULT_PSM_NOT_SUPPORTED, 0);
+        closed(device, child, Some(ECONNREFUSED));
+        return;
+    };
+    let defer = listener.state.lock().defer_setup;
+    let needed = channel.security;
+    if needed > current_security(device, channel.handle).max(SECURITY_LOW) {
+        set_stage(child, Stage::WaitSecurity);
+        respond_connection(device, &channel, RESULT_PENDING, STATUS_AUTHENTICATION_PENDING);
+        pairing::secure(device, channel.handle, needed);
+        return;
+    }
+    if defer {
+        // The program decides: it is handed over now, and set up when it
+        // reads.
+        set_stage(child, Stage::Deferred);
+        child.state.lock().deferred = true;
+        respond_connection(device, &channel, RESULT_PENDING, STATUS_AUTHORIZATION_PENDING);
+        PENDING.lock().retain(|(pending, _)| !Arc::ptr_eq(pending, child));
+        if !listener.offer(child.clone()) {
+            respond_connection(device, &channel, RESULT_SECURITY_BLOCK, 0);
+            child.state.lock().channel = None;
+        }
+        return;
+    }
+    respond_connection(device, &channel, RESULT_SUCCESS, 0);
+    configure(device, child);
+}
+
+/// The program takes a deferred connection.
+pub(crate) fn accept_deferred(socket: &ProtoSocket) {
+    let Some(channel) = socket.state.lock().channel.clone() else { return };
+    let Some(device) = device_at(channel.device) else { return };
+    if channel.stage != Stage::Deferred {
+        return;
+    }
+    respond_connection(&device, &channel, RESULT_SUCCESS, 0);
+    configure(&device, socket);
+}
+
+fn connection_response(device: &Device, handle: u16, ident: u8, their_cid: u16, our_cid: u16, result: u16) {
+    let socket = find(device.index, handle, our_cid).or_else(|| find_by_ident(device.index, handle, ident));
+    let Some(socket) = socket else { return };
+    match result {
+        RESULT_SUCCESS => {
+            if let Some(channel) = socket.state.lock().channel.as_mut() {
+                channel.dcid = their_cid;
+            }
+            configure(device, &socket);
+        }
+        RESULT_PENDING => {}
+        RESULT_SECURITY_BLOCK => closed(device, &socket, Some(EACCES)),
+        _ => closed(device, &socket, Some(ECONNREFUSED)),
+    }
+}
+
+fn configure_request(device: &Device, handle: u16, ident: u8, our_cid: u16, flags: u16, mut options: &[u8]) {
+    let Some(socket) = find(device.index, handle, our_cid) else {
+        // An invalid channel id.
+        let mut data = 0x0002u16.to_le_bytes().to_vec();
+        data.extend_from_slice(&our_cid.to_le_bytes());
+        data.extend_from_slice(&0u16.to_le_bytes());
+        signal(device, handle, CID_SIGNALING, COMMAND_REJECT, ident, &data);
+        return;
+    };
+    let mut omtu = None;
+    let mut result = 0x0000u16;
+    let mut reply_options = Vec::new();
+    while options.len() >= 2 {
+        let (kind, length) = (options[0], options[1] as usize);
+        let Some(value) = options.get(2..2 + length) else { break };
+        match kind & 0x7f {
+            0x01 if length >= 2 => omtu = Some(u16::from_le_bytes([value[0], value[1]])),
+            0x02 | 0x03 | 0x05 | 0x06 | 0x07 => {}
+            // Retransmission and flow control: basic mode only.
+            0x04 => {
+                if value.first().copied().unwrap_or(0) != 0 {
+                    result = 0x0001;
+                    reply_options.extend_from_slice(&[0x04, 9, 0, 0, 0, 0, 0, 0, 0, 0, 0]);
+                }
+            }
+            _ if kind & 0x80 == 0 => {
+                result = 0x0003;
+                reply_options.push(kind);
+            }
+            _ => {}
+        }
+        options = &options[2 + length..];
+    }
+    let (dcid, open) = {
+        let mut state = socket.state.lock();
+        let Some(channel) = state.channel.as_mut() else { return };
+        if result == 0 {
+            channel.omtu = omtu.unwrap_or(DEFAULT_MTU).max(48);
+            if flags & 0x0001 == 0 {
+                channel.stage = match channel.stage {
+                    Stage::Config(ours, _) => Stage::Config(ours, true),
+                    other => other,
+                };
+            }
+        }
+        (channel.dcid, matches!(channel.stage, Stage::Config(true, true)))
+    };
+    let mut data = dcid.to_le_bytes().to_vec();
+    data.extend_from_slice(&(flags & 0x0001).to_le_bytes());
+    data.extend_from_slice(&result.to_le_bytes());
+    data.extend_from_slice(&reply_options);
+    signal(device, handle, CID_SIGNALING, CONFIGURE_RESPONSE, ident, &data);
+    if open {
+        opened(&socket);
+    }
+}
+
+fn configure_response(device: &Device, handle: u16, our_cid: u16, result: u16, options: &[u8]) {
+    let Some(socket) = find(device.index, handle, our_cid) else { return };
+    match result {
+        0x0000 => {
+            let open = {
+                let mut state = socket.state.lock();
+                let Some(channel) = state.channel.as_mut() else { return };
+                channel.stage = match channel.stage {
+                    Stage::Config(_, theirs) => Stage::Config(true, theirs),
+                    other => other,
+                };
+                matches!(channel.stage, Stage::Config(true, true))
+            };
+            if open {
+                opened(&socket);
+            }
+        }
+        // Their values instead (the MTU they take): asked again with them.
+        0x0001 => {
+            let Some(channel) = socket.state.lock().channel.clone() else { return };
+            let ident = next_ident(device, handle);
+            let mut data = channel.dcid.to_le_bytes().to_vec();
+            data.extend_from_slice(&0u16.to_le_bytes());
+            data.extend_from_slice(options);
+            signal(device, handle, CID_SIGNALING, CONFIGURE_REQUEST, ident, &data);
+        }
+        _ => {
+            close(&socket);
+            closed(device, &socket, Some(ECONNREFUSED));
+        }
+    }
+}
+
+/// LE signaling: connection parameters the peripheral asks for.
+fn le_signaling(device: &Device, handle: u16, data: &[u8]) {
+    if data.len() < 4 {
+        return;
+    }
+    let (code, ident) = (data[0], data[1]);
+    let body = &data[4..];
+    match code {
+        CONNECTION_PARAMETER_UPDATE_REQUEST if body.len() >= 8 => {
+            let central = device.links.lock().by_handle(handle).is_some_and(|link| link.outgoing);
+            let accepted = central;
+            signal(device, handle, CID_LE_SIGNALING, CONNECTION_PARAMETER_UPDATE_RESPONSE, ident, &(!accepted as u16).to_le_bytes());
+            if accepted {
+                let mut params = handle.to_le_bytes().to_vec();
+                params.extend_from_slice(&body[..8]);
+                params.extend_from_slice(&[0, 0, 0, 0]);
+                device.queue_action(link::Action::Command(crate::hci::OP_LE_CONN_UPDATE, params));
+            }
+        }
+        LE_CREDIT_CONNECTION_REQUEST if body.len() >= 10 => {
+            // No LE credit-based channels: the PSM is not served.
+            let mut reply = vec![0u8; 8];
+            reply.extend_from_slice(&RESULT_PSM_NOT_SUPPORTED.to_le_bytes());
+            signal(device, handle, CID_LE_SIGNALING, LE_CREDIT_CONNECTION_RESPONSE, ident, &reply);
+        }
+        COMMAND_REJECT | CONNECTION_PARAMETER_UPDATE_RESPONSE => {}
+        _ => signal(device, handle, CID_LE_SIGNALING, COMMAND_REJECT, ident, &[0, 0]),
+    }
+}
+
+/// Sends a message on a socket's channel.
+pub(crate) fn send(socket: &ProtoSocket, data: &[u8]) -> Result<usize, i32> {
+    let channel = socket.state.lock().channel.clone().ok_or(ENOTCONN)?;
+    if channel.stage != Stage::Open {
+        return Err(ENOTCONN);
+    }
+    if data.len() > channel.omtu as usize && !channel.le {
+        return Err(EMSGSIZE);
+    }
+    let device = device_at(channel.device).ok_or(ENOTCONN)?;
+    let mut frame = Vec::with_capacity(4 + data.len());
+    frame.extend_from_slice(&(data.len() as u16).to_le_bytes());
+    frame.extend_from_slice(&channel.dcid.to_le_bytes());
+    frame.extend_from_slice(data);
+    link::send_frame(&device, channel.handle, &frame);
+    Ok(data.len())
+}
+
+/// The PHYs a channel's link uses (`BT_PHY`), as Linux's
+/// `hci_conn_get_phy` counts them from the packet types the controller
+/// allows (its 3- and 5-slot packets; every EDR packet type).
+pub(crate) fn phys(channel: &Channel) -> u32 {
+    const BR_1M_1SLOT: u32 = 1 << 0;
+    const BR_1M_3SLOT: u32 = 1 << 1;
+    const BR_1M_5SLOT: u32 = 1 << 2;
+    const EDR_ALL: u32 = 0x3f << 3;
+    const LE_1M_TX: u32 = 1 << 9;
+    const LE_1M_RX: u32 = 1 << 10;
+    if channel.le {
+        return LE_1M_TX | LE_1M_RX;
+    }
+    let features = device_at(channel.device).map_or([0; 8], |device| device.state.lock().info.features);
+    let mut phys = BR_1M_1SLOT | EDR_ALL;
+    if features[0] & 0x01 != 0 {
+        phys |= BR_1M_3SLOT;
+    }
+    if features[0] & 0x02 != 0 {
+        phys |= BR_1M_5SLOT;
+    }
+    phys
+}
+
+/// The program shuts a socket for writing: an open BR/EDR channel asks the
+/// device to close and closes on its answer; the others close now.
+pub(crate) fn shutdown(socket: &ProtoSocket) {
+    let channel = socket.state.lock().channel.clone();
+    let Some(channel) = channel.filter(|channel| channel.stage == Stage::Open && !channel.le && channel.dcid != 0) else {
+        return close(socket);
+    };
+    let Some(device) = device_at(channel.device) else { return close(socket) };
+    let ident = next_ident(&device, channel.handle);
+    if let Some(stored) = socket.state.lock().channel.as_mut() {
+        stored.stage = Stage::Disconnecting;
+        stored.ident = ident;
+    }
+    socket.start_disconnecting();
+    let mut data = channel.dcid.to_le_bytes().to_vec();
+    data.extend_from_slice(&channel.scid.to_le_bytes());
+    signal(&device, channel.handle, CID_SIGNALING, DISCONNECTION_REQUEST, ident, &data);
+}
+
+/// The program shuts a socket's channel.
+pub(crate) fn close(socket: &ProtoSocket) {
+    let channel = {
+        let mut state = socket.state.lock();
+        if matches!(state.phase, Phase::Connecting | Phase::Connected | Phase::Disconnecting) {
+            state.phase = Phase::Closed;
+        }
+        state.channel.take()
+    };
+    if let Some(channel) = channel {
+        dropped(channel);
+    }
+}
+
+/// A channel whose socket is gone: the device hears of it, and the link
+/// goes once it carries nothing.
+pub(crate) fn dropped(channel: Channel) {
+    let Some(device) = device_at(channel.device) else { return };
+    // (Asked already, for a channel being disconnected.)
+    if !channel.le && channel.dcid != 0 && channel.handle != 0 && !matches!(channel.stage, Stage::WaitLink | Stage::Disconnecting) {
+        let ident = next_ident(&device, channel.handle);
+        let mut data = channel.dcid.to_le_bytes().to_vec();
+        data.extend_from_slice(&channel.scid.to_le_bytes());
+        signal(&device, channel.handle, CID_SIGNALING, DISCONNECTION_REQUEST, ident, &data);
+    }
+    if channel.handle != 0 {
+        link::note_idle(&device, channel.handle);
+    }
+}
+
+/// The channel ended (the device closed it, the link went, it failed).
+fn closed(device: &Device, socket: &Arc<ProtoSocket>, error: Option<i32>) {
+    let handle = {
+        let mut state = socket.state.lock();
+        state.phase = Phase::Closed;
+        if error.is_some() {
+            state.error = error;
+        }
+        state.channel.take().map(|channel| channel.handle)
+    };
+    PENDING.lock().retain(|(child, _)| !Arc::ptr_eq(child, socket));
+    socket.wake();
+    if let Some(handle) = handle.filter(|handle| *handle != 0) {
+        link::note_idle(device, handle);
+    }
+}
+
+/// An LE link is up: bluetoothd's ATT listener gets the channel.
+fn offer_att(device: &Device, handle: u16) {
+    let Some((address, address_type, true)) = link::peer_of(device, handle) else { return };
+    let own = device.state.lock().info.address;
+    let listener = proto::sockets().into_iter().find(|socket| {
+        let state = socket.state.lock();
+        socket.protocol == Protocol::L2cap
+            && state.phase == Phase::Listening
+            && state.local.cid == CID_ATT
+            && state.local.address_type != BDADDR_BREDR
+            && (state.local.address == [0; 6] || state.local.address == own)
+    });
+    let Some(listener) = listener else { return };
+    let child = listener.child();
+    {
+        let mut state = child.state.lock();
+        state.local.address = own;
+        state.peer = Address { address, address_type, psm: 0, cid: CID_ATT, channel: 0 };
+        state.channel = Some(Channel {
+            device: device.index,
+            handle,
+            le: true,
+            scid: CID_ATT,
+            dcid: CID_ATT,
+            omtu: DEFAULT_MTU,
+            psm: 0,
+            stage: Stage::Open,
+            ident: 0,
+            incoming: true,
+            security: SECURITY_LOW,
+        });
+        state.phase = Phase::Connected;
+    }
+    if !listener.offer(child.clone()) {
+        child.state.lock().channel = None;
+    }
+}
+
+/// A link came up: channels waiting for it go on.
+pub(crate) fn link_up(device: &Device, handle: u16, address: &[u8; 6], le: bool) {
+    let waiting: Vec<_> = channel_sockets(device.index)
+        .into_iter()
+        .filter(|socket| {
+            let state = socket.state.lock();
+            state.peer.address == *address
+                && state.channel.as_ref().is_some_and(|channel| channel.stage == Stage::WaitLink && channel.le == le)
+        })
+        .collect();
+    for socket in &waiting {
+        start(device, socket, handle);
+    }
+    if le && find(device.index, handle, CID_ATT).is_none() {
+        offer_att(device, handle);
+    }
+    if channels_on(device.index, handle) == 0 {
+        link::note_idle(device, handle);
+    }
+}
+
+/// A link could not be made.
+pub(crate) fn link_failed(device: &Device, address: &[u8; 6], le: bool, status: u8) {
+    for socket in channel_sockets(device.index) {
+        let waiting = {
+            let state = socket.state.lock();
+            state.peer.address == *address
+                && state.channel.as_ref().is_some_and(|channel| channel.stage == Stage::WaitLink && channel.le == le)
+        };
+        if waiting {
+            closed(device, &socket, Some(errno_of(status)));
+        }
+    }
+}
+
+/// A link went: its channels end.
+pub(crate) fn link_down(device: &Device, handle: u16, _address: &[u8; 6], _le: bool) {
+    for socket in channel_sockets(device.index) {
+        let on = socket.state.lock().channel.as_ref().is_some_and(|channel| channel.handle == handle);
+        if on {
+            let mut state = socket.state.lock();
+            state.phase = Phase::Closed;
+            state.error = Some(ECONNRESET);
+            state.channel = None;
+            drop(state);
+            PENDING.lock().retain(|(child, _)| !Arc::ptr_eq(child, &socket));
+            socket.wake();
+        }
+    }
+}
+
+/// The security a link has: its own once encrypted.
+pub(crate) fn current_security(device: &Device, handle: u16) -> u8 {
+    device.links.lock().by_handle(handle).map_or(SECURITY_LOW, |link| if link.encrypted { link.security } else { SECURITY_LOW })
+}
+
+/// The controller went away: the channels left on it end.
+pub(crate) fn device_removed(device: &Device) {
+    for socket in channel_sockets(device.index) {
+        closed(device, &socket, Some(ECONNRESET));
+    }
+}
+
+/// The link's security changed (`ok`: as asked): channels waiting for it
+/// go on, or fail, RFCOMM's too.
+pub(crate) fn secured(device: &Device, handle: u16, ok: bool) {
+    secured_channels(device, handle, ok);
+    crate::rfcomm::secured(device, handle, ok);
+}
+
+fn secured_channels(device: &Device, handle: u16, ok: bool) {
+    for socket in channel_sockets(device.index) {
+        let channel = socket.state.lock().channel.clone();
+        let Some(channel) = channel.filter(|channel| channel.handle == handle && channel.stage == Stage::WaitSecurity) else {
+            continue;
+        };
+        if ok {
+            let defer = socket.state.lock().defer_setup;
+            if channel.incoming && defer {
+                // Now the program decides, as with any deferred one.
+                set_stage(&socket, Stage::Deferred);
+                socket.state.lock().deferred = true;
+                respond_connection(device, &channel, RESULT_PENDING, STATUS_AUTHORIZATION_PENDING);
+                hand_over(&socket);
+            } else {
+                proceed(device, &socket);
+            }
+        } else {
+            if channel.incoming {
+                respond_connection(device, &channel, RESULT_SECURITY_BLOCK, 0);
+            }
+            closed(device, &socket, Some(EACCES));
+        }
+    }
+}
+
+/// A connected LE channel asks for more security (`BT_SECURITY`).
+pub(crate) fn raise_security(socket: &ProtoSocket, level: u8) {
+    let Some(channel) = socket.state.lock().channel.clone() else { return };
+    if channel.stage != Stage::Open || !channel.le {
+        return;
+    }
+    if let Some(device) = device_at(channel.device) {
+        smp::secure(&device, channel.handle, level);
+    }
+}
diff --git a/kernel/comps/bluetooth/src/lib.rs b/kernel/comps/bluetooth/src/lib.rs
new file mode 100755
index 0000000..de6b7fb
--- /dev/null
+++ b/kernel/comps/bluetooth/src/lib.rs
@@ -0,0 +1,228 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Bluetooth: the host side of the controllers, as Linux's
+//! `net/bluetooth` gives it to BlueZ. A driver registers each controller
+//! (its transport: USB, `/dev/vhci`) with the operations of [`Driver`] and
+//! hands over what the controller sends to the [`Controller`] it gets back;
+//! the controller becomes `hci0`, `hci1`, ... set up as Linux does, and
+//! bluetoothd runs it through the management interface (`mgmt`) of the HCI
+//! sockets (`socket`), unchanged from Debian's.
+//!
+//! The kernel starts this component's task (`run`), which sets the
+//! controllers up and keeps their time-outs.
+
+#![no_std]
+#![deny(unsafe_code)]
+
+extern crate alloc;
+
+// This crate's log prefix for `ostd::log`, as Linux's.
+macro_rules! __log_prefix {
+    () => {
+        "Bluetooth: "
+    };
+}
+
+mod device;
+pub mod hci;
+mod intel;
+mod l2cap;
+mod link;
+mod mgmt;
+mod pairing;
+pub mod proto;
+mod realtek;
+mod rfcomm;
+mod sc;
+mod sco;
+mod smp;
+pub mod socket;
+mod vendor;
+
+use alloc::{sync::Arc, vec::Vec};
+use core::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+use component::{ComponentInitError, init_component};
+use device::Device;
+use ostd::{
+    sync::{LocalIrqDisabled, SpinLock, WaitQueue},
+    timer::Jiffies,
+};
+
+pub use socket::{Channel, Socket};
+
+/// The buses of `struct hci_dev` (`HCI_VIRTUAL`, `HCI_USB`, ...).
+pub mod bus {
+    pub const VIRTUAL: u8 = 0;
+    pub const USB: u8 = 1;
+    pub const UART: u8 = 3;
+}
+
+/// What a controller's driver does for the stack.
+pub trait Driver: Send + Sync {
+    /// Sends a packet (a command or data, without its type byte) to the
+    /// controller; false if the transport could not take it.
+    fn send(&self, packet_type: u8, packet: &[u8]) -> bool;
+    /// The bus it is on ([`bus`]).
+    fn bus(&self) -> u8;
+    /// Its USB vendor and product ids, which say what vendor set-up it
+    /// needs (firmware, a patch).
+    fn usb_ids(&self) -> Option<(u16, u16)> {
+        None
+    }
+    /// The controller entered (or left) its boot loader: Intel's then
+    /// sends events on the data endpoint too, and takes firmware there.
+    fn set_bootloader(&self, _on: bool) {}
+}
+
+/// A registered controller, which its driver reports to.
+pub struct Controller {
+    device: Arc<Device>,
+}
+
+impl Controller {
+    /// Its index (`hciN`).
+    pub fn index(&self) -> u16 {
+        self.device.index
+    }
+
+    /// A packet the controller sent (an event, data), without its type byte.
+    /// Never waits: drivers call it from where their transport completes.
+    pub fn receive(&self, packet_type: u8, packet: &[u8]) {
+        self.device.receive(packet_type, packet);
+    }
+
+    /// The controller went away (unplugged, its `/dev/vhci` closed).
+    pub fn unregister(&self) {
+        let (was_ready, address) = {
+            let mut state = self.device.state.lock();
+            state.removed = true;
+            (state.ready, state.info.address)
+        };
+        self.device.wake_commands();
+        link::device_removed(&self.device);
+        // Taken first: the switch's sysfs directory goes without the lock.
+        let switch = self.device.rfkill.lock().take();
+        if let Some(switch) = switch {
+            aster_rfkill::unregister(&switch);
+        }
+        DEVICES.lock().retain(|device| !Arc::ptr_eq(device, &self.device));
+        socket::monitor_index(self.device.index, self.device.bus(), &address, false);
+        if was_ready {
+            mgmt::index_removed(self.device.index, self.device.bus());
+        }
+        ostd::notice!("hci{}: removed", self.device.index);
+    }
+}
+
+static DEVICES: SpinLock<Vec<Arc<Device>>, LocalIrqDisabled> = SpinLock::new(Vec::new());
+
+/// Wakes the task (a controller to set up, a discovery to end).
+static WAKE: WaitQueue = WaitQueue::new();
+static WOKEN: AtomicBool = AtomicBool::new(false);
+/// Something waits on a time: the timer wakes the task now and then.
+static WAITING: AtomicBool = AtomicBool::new(false);
+/// Commands waiting for their controller: the timer wakes them now and then
+/// so that they see their time-out.
+pub(crate) static COMMANDS_PENDING: AtomicUsize = AtomicUsize::new(0);
+/// Tasks sleeping a while ([`sleep_ms`]): the timer wakes them now and then.
+static SLEEP: WaitQueue = WaitQueue::new();
+static SLEEPERS: AtomicUsize = AtomicUsize::new(0);
+static TICKS: AtomicUsize = AtomicUsize::new(0);
+
+pub(crate) fn now_ms() -> u64 {
+    Jiffies::elapsed().as_duration().as_millis() as u64
+}
+
+/// Waits `ms` milliseconds (to the timer's 20 ms).
+pub(crate) fn sleep_ms(ms: u64) {
+    let deadline = now_ms() + ms;
+    SLEEPERS.fetch_add(1, Ordering::AcqRel);
+    SLEEP.wait_until(|| (now_ms() >= deadline).then_some(()));
+    SLEEPERS.fetch_sub(1, Ordering::AcqRel);
+}
+
+pub(crate) fn devices() -> Vec<Arc<Device>> {
+    DEVICES.lock().clone()
+}
+
+pub(crate) fn device_at(index: u16) -> Option<Arc<Device>> {
+    DEVICES.lock().iter().find(|device| device.index == index).cloned()
+}
+
+/// Wakes the task (something waits on a time).
+pub(crate) fn wake() {
+    WOKEN.store(true, Ordering::Release);
+    WAKE.wake_all();
+}
+
+pub(crate) fn wake_task(device: &Device) {
+    device.needs_task.store(true, Ordering::Release);
+    WOKEN.store(true, Ordering::Release);
+    WAKE.wake_all();
+}
+
+/// A driver registers a controller: it gets the lowest free index and is
+/// set up in the task; the management sockets hear of it then.
+pub fn register(driver: Arc<dyn Driver>) -> Arc<Controller> {
+    let device = {
+        let mut devices = DEVICES.lock();
+        let index = (0u16..).find(|index| !devices.iter().any(|device| device.index == *index)).unwrap();
+        let device = Device::new(index, driver);
+        devices.push(device.clone());
+        device
+    };
+    socket::monitor_index(device.index, device.bus(), &[0; 6], true);
+    wake_task(&device);
+    Arc::new(Controller { device })
+}
+
+/// The management task (the commands programs write), which the kernel
+/// starts beside [`run`].
+pub fn run_management() -> ! {
+    mgmt::run()
+}
+
+/// The component's task, which the kernel starts once it has a scheduler.
+pub fn run() -> ! {
+    loop {
+        WAKE.wait_until(|| WOKEN.swap(false, Ordering::AcqRel).then_some(()));
+        let now = now_ms();
+        let mut waiting = false;
+        for device in devices() {
+            device.needs_task.store(false, Ordering::Release);
+            waiting |= device.run(now);
+        }
+        waiting |= proto::expire_connects(now);
+        WAITING.store(waiting, Ordering::Relaxed);
+    }
+}
+
+/// Each timer tick (1 ms): every 20, the task while something waits on a
+/// time, and the commands waiting for their controllers.
+fn tick() {
+    let ticks = TICKS.fetch_add(1, Ordering::Relaxed);
+    if ticks % 20 != 0 {
+        return;
+    }
+    if WAITING.load(Ordering::Relaxed) {
+        WOKEN.store(true, Ordering::Release);
+        WAKE.wake_all();
+    }
+    if SLEEPERS.load(Ordering::Relaxed) != 0 {
+        SLEEP.wake_all();
+    }
+    if COMMANDS_PENDING.load(Ordering::Relaxed) != 0
+        && let Some(devices) = DEVICES.try_lock()
+    {
+        for device in devices.iter() {
+            device.wake_commands();
+        }
+    }
+}
+
+#[init_component]
+fn init() -> Result<(), ComponentInitError> {
+    ostd::timer::register_callback_on_cpu(tick);
+    Ok(())
+}
diff --git a/kernel/comps/bluetooth/src/link.rs b/kernel/comps/bluetooth/src/link.rs
new file mode 100755
index 0000000..8e68287
--- /dev/null
+++ b/kernel/comps/bluetooth/src/link.rs
@@ -0,0 +1,773 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Links to devices: ACL connections on BR/EDR and LE connections, as
+//! Linux's `hci_conn` keeps them. A link is made when a socket connects or
+//! the management interface pairs (`Create Connection`, `LE Create
+//! Connection`), or when a device connects (`Connection Request`, or an LE
+//! connection to our advertising); the management sockets hear of each
+//! (`MGMT_EV_DEVICE_CONNECTED`, `..._DISCONNECTED`, `CONNECT_FAILED`).
+//! L2CAP frames go out in ACL packets of the controller's size as its
+//! buffers allow (`Number Of Completed Packets` gives them back) and come
+//! in from ACL packets put back together. A link that carries no channel
+//! for a while is closed, as Linux does.
+//!
+//! Commands a link needs in answer to an event (accepting a connection, a
+//! key, a pairing step) go to the component's task ([`Action`]), which
+//! sends them one at a time.
+
+use alloc::{collections::VecDeque, vec::Vec};
+
+use crate::{
+    device::Device,
+    hci, l2cap,
+    mgmt::{self, ADDR_BREDR, ADDR_LE_PUBLIC, ADDR_LE_RANDOM},
+    now_ms, pairing, smp,
+};
+
+/// How long a link without channels stays (Linux's `HCI_DISCONN_TIMEOUT`).
+const IDLE_MS: u64 = 2000;
+/// How long a link being made may take.
+const CONNECT_MS: u64 = 20_000;
+/// How long the device may take to say its L2CAP features (Linux's
+/// `L2CAP_INFO_TIMEOUT`).
+const INFO_MS: u64 = 4000;
+
+/// Security levels (`BT_SECURITY_*`) a link has reached.
+pub(crate) const SECURITY_LOW: u8 = 1;
+pub(crate) const SECURITY_MEDIUM: u8 = 2;
+pub(crate) const SECURITY_HIGH: u8 = 3;
+/// Secure Connections with a man-in-the-middle check (`BT_SECURITY_FIPS`).
+pub(crate) const SECURITY_FIPS: u8 = 4;
+
+/// A connection to a device.
+pub(crate) struct Link {
+    pub handle: u16,
+    pub address: [u8; 6],
+    /// The management interface's address type.
+    pub address_type: u8,
+    pub le: bool,
+    /// We started it (central on LE, the pager on BR/EDR).
+    pub outgoing: bool,
+    pub encrypted: bool,
+    /// The security the link's keys give (`SECURITY_*`).
+    pub security: u8,
+    /// An authentication or encryption is under way.
+    pub securing: bool,
+    /// What the remote side said in its IO capability response.
+    pub remote_io: Option<(u8, u8)>,
+    /// The authentication requirements we sent.
+    pub local_auth: u8,
+    /// The key type of the link key the pairing made (BR/EDR).
+    pub key_type: u8,
+    /// An L2CAP frame being put together.
+    rx: Vec<u8>,
+    rx_expected: usize,
+    /// The next signaling identifier.
+    pub signal_id: u8,
+    /// Since when no channel uses it.
+    pub idle_since: Option<u64>,
+    /// LE pairing (SMP) under way.
+    pub smp: Option<smp::Smp>,
+    /// L2CAP's information exchange: our request (its identifier, since
+    /// when) while it is out; the device's features once known (none if it
+    /// did not say).
+    pub info_request: Option<(u8, u64)>,
+    pub features: Option<u32>,
+    /// Whether the device's host does Simple Pairing, once known (its
+    /// features, page 1), and since when we ask.
+    pub remote_ssp: Option<bool>,
+    pub remote_asked: u64,
+    /// The device's LMP features (page 0), once read: its eSCO.
+    pub remote_features: [u8; 8],
+}
+
+impl Link {
+    fn new(handle: u16, address: [u8; 6], address_type: u8, le: bool, outgoing: bool) -> Self {
+        Self {
+            handle,
+            address,
+            address_type,
+            le,
+            outgoing,
+            encrypted: false,
+            security: SECURITY_LOW,
+            securing: false,
+            remote_io: None,
+            local_auth: 0,
+            key_type: 0xff,
+            rx: Vec::new(),
+            rx_expected: 0,
+            signal_id: 1,
+            idle_since: None,
+            smp: None,
+            info_request: None,
+            features: None,
+            // (LE links have no host features to learn.)
+            remote_ssp: le.then_some(false),
+            remote_asked: now_ms(),
+            remote_features: [0; 8],
+        }
+    }
+
+    pub(crate) fn next_signal_id(&mut self) -> u8 {
+        let id = self.signal_id;
+        self.signal_id = if id == 0xff { 1 } else { id + 1 };
+        id
+    }
+}
+
+/// A connection being made.
+pub(crate) struct Connecting {
+    pub address: [u8; 6],
+    pub address_type: u8,
+    pub since: u64,
+    /// The command is out (the controller makes one LE connection at a time).
+    pub started: bool,
+}
+
+/// A device's links, and what waits to be sent on them.
+pub(crate) struct Links {
+    pub links: Vec<Link>,
+    pub connecting: Vec<Connecting>,
+    tx_acl: VecDeque<Vec<u8>>,
+    tx_le: VecDeque<Vec<u8>>,
+    acl_credits: u16,
+    le_credits: u16,
+    /// Packets out per link, given back by `Number Of Completed Packets`
+    /// (and freed when a link goes).
+    in_flight: Vec<(u16, bool)>,
+}
+
+impl Links {
+    pub(crate) fn new() -> Self {
+        Self {
+            links: Vec::new(),
+            connecting: Vec::new(),
+            tx_acl: VecDeque::new(),
+            tx_le: VecDeque::new(),
+            acl_credits: 0,
+            le_credits: 0,
+            in_flight: Vec::new(),
+        }
+    }
+
+    pub(crate) fn by_handle(&mut self, handle: u16) -> Option<&mut Link> {
+        self.links.iter_mut().find(|link| link.handle == handle)
+    }
+
+    pub(crate) fn by_address(&mut self, address: &[u8; 6], le: bool) -> Option<&mut Link> {
+        self.links.iter_mut().find(|link| link.address == *address && link.le == le)
+    }
+}
+
+/// Commands the task sends for the links.
+#[derive(Clone, Debug)]
+pub(crate) enum Action {
+    Connect([u8; 6], u8),
+    Accept([u8; 6]),
+    Reject([u8; 6], u8),
+    Disconnect(u16, u8),
+    /// A command with its parameters, no answer awaited beyond its
+    /// completion (pairing steps).
+    Command(u16, Vec<u8>),
+    /// Advertising again (the controller stops it for a connection).
+    Advertise,
+    /// The radio switch changed: blocked, the controller powers off.
+    Rfkill(bool),
+}
+
+pub(crate) fn is_le_type(address_type: u8) -> bool {
+    matches!(address_type, ADDR_LE_PUBLIC | ADDR_LE_RANDOM)
+}
+
+/// The buffers the controller said it has, once set up.
+pub(crate) fn set_credits(device: &Device) {
+    let info = device.state.lock().info;
+    let mut links = device.links.lock();
+    links.acl_credits = info.acl_packets;
+    links.le_credits = info.le_packets;
+}
+
+/// Sends an L2CAP frame (its header included) on a link, in ACL packets.
+pub(crate) fn send_frame(device: &Device, handle: u16, frame: &[u8]) {
+    let info = device.state.lock().info;
+    let mut links = device.links.lock();
+    let Some(link) = links.by_handle(handle) else {
+        return;
+    };
+    let le = link.le;
+    link.idle_since = None;
+    // LE links use the LE buffers when the controller has its own.
+    let (mtu, separate) = if le && info.le_mtu != 0 {
+        (info.le_mtu as usize, true)
+    } else {
+        (info.acl_mtu.max(23) as usize, false)
+    };
+    // The first packet: LE's non-flushable start, BR/EDR's flushable one.
+    let mut first = true;
+    for piece in frame.chunks(mtu.max(1)) {
+        let flags: u16 = if !first { 0x1 } else if le { 0x0 } else { 0x2 };
+        first = false;
+        let mut packet = Vec::with_capacity(4 + piece.len());
+        packet.extend_from_slice(&(handle | flags << 12).to_le_bytes());
+        packet.extend_from_slice(&(piece.len() as u16).to_le_bytes());
+        packet.extend_from_slice(piece);
+        if separate {
+            links.tx_le.push_back(packet);
+        } else {
+            links.tx_acl.push_back(packet);
+        }
+    }
+    drop(links);
+    flush(device);
+}
+
+/// Sends what the controller's buffers allow.
+fn flush(device: &Device) {
+    loop {
+        let packet = {
+            let mut links = device.links.lock();
+            if links.le_credits > 0 && !links.tx_le.is_empty() {
+                links.le_credits -= 1;
+                let packet = links.tx_le.pop_front().unwrap();
+                let handle = u16::from_le_bytes([packet[0], packet[1]]) & 0x0fff;
+                links.in_flight.push((handle, true));
+                packet
+            } else if links.acl_credits > 0 && !links.tx_acl.is_empty() {
+                links.acl_credits -= 1;
+                let packet = links.tx_acl.pop_front().unwrap();
+                let handle = u16::from_le_bytes([packet[0], packet[1]]) & 0x0fff;
+                links.in_flight.push((handle, false));
+                packet
+            } else {
+                return;
+            }
+        };
+        device.send_packet(hci::ACL_PKT, &packet);
+    }
+}
+
+/// An ACL packet from the controller.
+pub(crate) fn receive_acl(device: &Device, packet: &[u8]) {
+    if packet.len() < 4 {
+        return;
+    }
+    let header = u16::from_le_bytes([packet[0], packet[1]]);
+    let (handle, flags) = (header & 0x0fff, (header >> 12) & 0x3);
+    let length = (u16::from_le_bytes([packet[2], packet[3]]) as usize).min(packet.len() - 4);
+    let data = &packet[4..4 + length];
+    let frame = {
+        let mut links = device.links.lock();
+        let Some(link) = links.by_handle(handle) else {
+            return;
+        };
+        if flags == 0x1 {
+            // A continuation.
+            if link.rx.is_empty() {
+                return;
+            }
+            link.rx.extend_from_slice(data);
+        } else {
+            link.rx.clear();
+            link.rx.extend_from_slice(data);
+            if data.len() < 4 {
+                link.rx_expected = 4;
+            } else {
+                link.rx_expected = 4 + u16::from_le_bytes([data[0], data[1]]) as usize;
+            }
+        }
+        if link.rx.len() >= 4 && link.rx_expected == 4 {
+            link.rx_expected = 4 + u16::from_le_bytes([link.rx[0], link.rx[1]]) as usize;
+        }
+        if link.rx.len() < link.rx_expected {
+            return;
+        }
+        let mut frame = core::mem::take(&mut link.rx);
+        frame.truncate(link.rx_expected);
+        frame
+    };
+    let cid = u16::from_le_bytes([frame[2], frame[3]]);
+    l2cap::receive(device, handle, cid, &frame[4..]);
+}
+
+/// `Number Of Completed Packets`: buffers back.
+pub(crate) fn completed_packets(device: &Device, params: &[u8]) {
+    let count = *params.first().unwrap_or(&0) as usize;
+    {
+        let mut links = device.links.lock();
+        for entry in 0..count {
+            let Some(bytes) = params.get(1 + entry * 4..5 + entry * 4) else { break };
+            let handle = u16::from_le_bytes([bytes[0], bytes[1]]) & 0x0fff;
+            let done = u16::from_le_bytes([bytes[2], bytes[3]]);
+            for _ in 0..done {
+                let Some(position) = links.in_flight.iter().position(|(h, _)| *h == handle) else { break };
+                let (_, le) = links.in_flight.remove(position);
+                if le {
+                    links.le_credits += 1;
+                } else {
+                    links.acl_credits += 1;
+                }
+            }
+        }
+    }
+    flush(device);
+}
+
+/// Asks for a link to a device, unless one exists or is being made.
+/// Returns whether one is up already.
+pub(crate) fn connect(device: &Device, address: [u8; 6], address_type: u8) -> bool {
+    let le = is_le_type(address_type);
+    {
+        let mut links = device.links.lock();
+        if links.by_address(&address, le).is_some() {
+            return true;
+        }
+        if links.connecting.iter().any(|connecting| connecting.address == address) {
+            return false;
+        }
+        links.connecting.push(Connecting { address, address_type, since: now_ms(), started: false });
+    }
+    device.queue_action(Action::Connect(address, address_type));
+    false
+}
+
+/// The task makes a link.
+pub(crate) fn start_connect(device: &Device, address: [u8; 6], address_type: u8) {
+    let le = is_le_type(address_type);
+    let started = {
+        let mut links = device.links.lock();
+        let Some(connecting) = links.connecting.iter_mut().find(|connecting| connecting.address == address) else {
+            return;
+        };
+        connecting.started = true;
+        connecting.since = now_ms();
+        true
+    };
+    if !started {
+        return;
+    }
+    let result = if le {
+        // 60 ms scans of 60 ms, 30 to 50 ms intervals, a 420 ms timeout:
+        // Linux's defaults.
+        let mut params = Vec::with_capacity(25);
+        params.extend_from_slice(&0x0060u16.to_le_bytes());
+        params.extend_from_slice(&0x0060u16.to_le_bytes());
+        params.push(0x00);
+        params.push(if address_type == ADDR_LE_RANDOM { 0x01 } else { 0x00 });
+        params.extend_from_slice(&address);
+        params.push(0x00);
+        for value in [0x0018u16, 0x0028, 0x0000, 0x002a, 0x0000, 0x0000] {
+            params.extend_from_slice(&value.to_le_bytes());
+        }
+        // Scanning stops while the controller connects.
+        let scanning = device.state.lock().discovery.as_ref().is_some_and(|discovery| discovery.le_scan);
+        if scanning {
+            let _ = device.command(hci::OP_LE_SET_SCAN_ENABLE, &[0x00, 0x00]);
+        }
+        device.command(hci::OP_LE_CREATE_CONN, &params)
+    } else {
+        let mut params = address.to_vec();
+        params.extend_from_slice(&0xcc18u16.to_le_bytes());
+        params.extend_from_slice(&[0x02, 0x00]);
+        params.extend_from_slice(&0u16.to_le_bytes());
+        params.push(0x01);
+        device.command(hci::OP_CREATE_CONN, &params)
+    };
+    if let Err(error) = result {
+        let status = match error {
+            crate::device::CommandError::Status(status) => status,
+            _ => 0x1f,
+        };
+        connect_failed(device, address, address_type, status);
+    }
+}
+
+/// A link could not be made: those waiting for it hear why.
+fn connect_failed(device: &Device, address: [u8; 6], address_type: u8, status: u8) {
+    device.links.lock().connecting.retain(|connecting| connecting.address != address);
+    let mut params = address.to_vec();
+    params.push(address_type);
+    params.push(mgmt::status_of_hci(status));
+    mgmt::event_to_all(mgmt::ev::CONNECT_FAILED, device.index, &params);
+    l2cap::link_failed(device, &address, is_le_type(address_type), status);
+    if !is_le_type(address_type) {
+        crate::sco::acl_down(device, &address, l2cap::errno_of(status));
+    }
+    pairing::link_failed(device, &address, status);
+}
+
+/// `Connection Request`: a device pages us.
+pub(crate) fn connection_request(device: &Device, params: &[u8]) {
+    if params.len() < 10 {
+        return;
+    }
+    let address: [u8; 6] = params[..6].try_into().unwrap();
+    let link_type = params[9];
+    // A synchronous link (SCO, eSCO): a listener's.
+    if link_type != 0x01 {
+        return crate::sco::connection_request(device, address, link_type);
+    }
+    let connectable = device.settings() & mgmt::settings::CONNECTABLE != 0;
+    if link_type == 0x01 && connectable {
+        device.queue_action(Action::Accept(address));
+    } else {
+        // Limited resources (SCO is not served), or not connectable.
+        device.queue_action(Action::Reject(address, if link_type == 0x01 { 0x0f } else { 0x0d }));
+    }
+}
+
+/// `Connection Complete` (BR/EDR).
+pub(crate) fn connection_complete(device: &Device, params: &[u8]) {
+    // A plain SCO link (a controller without eSCO).
+    if params.len() >= 11 && params[9] == 0x00 {
+        let address: [u8; 6] = params[3..9].try_into().unwrap();
+        crate::sco::connection_complete(device, params[0], u16::from_le_bytes([params[1], params[2]]) & 0x0fff, address);
+        return;
+    }
+    if params.len() < 11 || params[9] != 0x01 {
+        return;
+    }
+    let (status, handle) = (params[0], u16::from_le_bytes([params[1], params[2]]) & 0x0fff);
+    let address: [u8; 6] = params[3..9].try_into().unwrap();
+    let encrypted = params[10] != 0;
+    let outgoing = device.links.lock().connecting.iter().any(|connecting| connecting.address == address);
+    if status != 0 {
+        if outgoing {
+            connect_failed(device, address, ADDR_BREDR, status);
+        }
+        return;
+    }
+    link_up(device, Link { encrypted, ..Link::new(handle, address, ADDR_BREDR, false, outgoing) });
+    // What the device supports, as Linux asks right away: its host's
+    // Simple Pairing decides the security its channels need.
+    device.queue_action(Action::Command(hci::OP_READ_REMOTE_FEATURES, handle.to_le_bytes().to_vec()));
+}
+
+/// `Synchronous Connection Complete`.
+pub(crate) fn sync_connection_complete(device: &Device, params: &[u8]) {
+    if params.len() < 17 {
+        return;
+    }
+    let address: [u8; 6] = params[3..9].try_into().unwrap();
+    crate::sco::connection_complete(device, params[0], u16::from_le_bytes([params[1], params[2]]) & 0x0fff, address);
+}
+
+/// `Read Remote Supported Features Complete`: the host's own features
+/// (page 1) come next, if the device has more pages.
+pub(crate) fn remote_features(device: &Device, params: &[u8]) {
+    if params.len() < 11 {
+        return;
+    }
+    let (status, handle) = (params[0], u16::from_le_bytes([params[1], params[2]]) & 0x0fff);
+    if status == 0
+        && let Some(link) = device.links.lock().by_handle(handle)
+    {
+        link.remote_features.copy_from_slice(&params[3..11]);
+    }
+    if status == 0 && params[10] & 0x80 != 0 {
+        let mut command = handle.to_le_bytes().to_vec();
+        command.push(1);
+        device.queue_action(Action::Command(hci::OP_READ_REMOTE_EXT_FEATURES, command));
+    } else {
+        remote_host(device, handle, false);
+    }
+}
+
+/// `Read Remote Extended Features Complete`: page 1 says whether the
+/// device's host does Simple Pairing.
+pub(crate) fn remote_ext_features(device: &Device, params: &[u8]) {
+    if params.len() < 13 {
+        return;
+    }
+    let (status, handle, page) = (params[0], u16::from_le_bytes([params[1], params[2]]) & 0x0fff, params[3]);
+    if status != 0 {
+        remote_host(device, handle, false);
+    } else if page == 1 {
+        remote_host(device, handle, params[5] & 0x01 != 0);
+    }
+}
+
+/// `Remote Host Supported Features Notification` (while a link is made).
+pub(crate) fn remote_host_features(device: &Device, params: &[u8]) {
+    if params.len() < 14 {
+        return;
+    }
+    let address: [u8; 6] = params[..6].try_into().unwrap();
+    let handle = device.links.lock().by_address(&address, false).map(|link| link.handle);
+    if let Some(handle) = handle {
+        remote_host(device, handle, params[6] & 0x01 != 0);
+    }
+}
+
+fn remote_host(device: &Device, handle: u16, ssp: bool) {
+    {
+        let mut links = device.links.lock();
+        let Some(link) = links.by_handle(handle) else { return };
+        link.remote_ssp = Some(ssp);
+    }
+    l2cap::remote_known(device, handle);
+}
+
+/// `LE Connection Complete`, plain or enhanced.
+pub(crate) fn le_connection_complete(device: &Device, params: &[u8], enhanced: bool) {
+    if params.len() < 18 {
+        return;
+    }
+    let (status, handle, role) = (params[0], u16::from_le_bytes([params[1], params[2]]) & 0x0fff, params[3]);
+    let address_type = if params[4] & 0x01 != 0 { ADDR_LE_RANDOM } else { ADDR_LE_PUBLIC };
+    let address: [u8; 6] = params[5..11].try_into().unwrap();
+    let _ = enhanced;
+    let pending = device.links.lock().connecting.iter().find(|connecting| connecting.started && is_le_type(connecting.address_type)).map(|connecting| (connecting.address, connecting.address_type));
+    if status != 0 {
+        if let Some((address, address_type)) = pending {
+            connect_failed(device, address, address_type, status);
+        }
+        return;
+    }
+    // Our advertising goes on after a connection only if asked again.
+    let outgoing = role == 0x00;
+    link_up(device, Link::new(handle, address, address_type, true, outgoing));
+}
+
+fn link_up(device: &Device, link: Link) {
+    let (address, address_type, le, handle) = (link.address, link.address_type, link.le, link.handle);
+    {
+        let mut links = device.links.lock();
+        links.connecting.retain(|connecting| connecting.address != address);
+        links.links.push(link);
+    }
+    ostd::debug!("hci{}: link {:#x} to {:02x?} up", device.index, handle, address);
+    // bluetoothd hears of it, with what is known of the device.
+    let mut params = address.to_vec();
+    params.push(address_type);
+    params.extend_from_slice(&0u32.to_le_bytes());
+    params.extend_from_slice(&0u16.to_le_bytes());
+    mgmt::event_to_all(mgmt::ev::DEVICE_CONNECTED, device.index, &params);
+    l2cap::link_up(device, handle, &address, le);
+    if !le {
+        crate::sco::acl_up(device, handle, &address);
+    }
+    pairing::link_up(device, handle, &address, le);
+    // Other LE connections may be waiting for this one to be made.
+    crate::wake_task(device);
+}
+
+/// `Disconnection Complete`.
+pub(crate) fn disconnection_complete(device: &Device, params: &[u8]) {
+    if params.len() < 4 || params[0] != 0 {
+        return;
+    }
+    let (handle, reason) = (u16::from_le_bytes([params[1], params[2]]) & 0x0fff, params[3]);
+    let link = {
+        let mut links = device.links.lock();
+        let Some(position) = links.links.iter().position(|link| link.handle == handle) else {
+            // A synchronous link's, perhaps.
+            drop(links);
+            crate::sco::disconnected(device, handle, reason);
+            return;
+        };
+        let link = links.links.remove(position);
+        // Its packets will not complete: their buffers are free again.
+        let mut freed = (0u16, 0u16);
+        links.in_flight.retain(|(h, le)| {
+            if *h == handle {
+                if *le { freed.1 += 1 } else { freed.0 += 1 }
+                false
+            } else {
+                true
+            }
+        });
+        links.acl_credits += freed.0;
+        links.le_credits += freed.1;
+        let separate = device.state.lock().info.le_mtu != 0;
+        let queue = if link.le && separate { &mut links.tx_le } else { &mut links.tx_acl };
+        queue.retain(|packet| u16::from_le_bytes([packet[0], packet[1]]) & 0x0fff != handle);
+        link
+    };
+    let mut event = link.address.to_vec();
+    event.push(link.address_type);
+    event.push(match reason {
+        0x08 => 1,
+        0x16 => 2,
+        0x13..=0x15 => 3,
+        0x05 => 4,
+        _ => 0,
+    });
+    mgmt::event_to_all(mgmt::ev::DEVICE_DISCONNECTED, device.index, &event);
+    l2cap::link_down(device, handle, &link.address, link.le);
+    if !link.le {
+        crate::sco::acl_down(device, &link.address, l2cap::errno_of(reason));
+    }
+    pairing::link_down(device, &link.address, reason);
+    // An LE link we were advertised for: advertising again, as Linux does.
+    if link.le && !link.outgoing {
+        device.queue_action(Action::Advertise);
+    }
+}
+
+/// The controller went away: its links end, as if disconnected (the local
+/// host terminated them), and channels waiting for one fail.
+pub(crate) fn device_removed(device: &Device) {
+    let handles: Vec<u16> = device.links.lock().links.iter().map(|link| link.handle).collect();
+    for handle in handles {
+        let handle = handle.to_le_bytes();
+        disconnection_complete(device, &[0, handle[0], handle[1], 0x16]);
+    }
+    l2cap::device_removed(device);
+}
+
+/// A link's channels are all closed: it goes after a while.
+pub(crate) fn note_idle(device: &Device, handle: u16) {
+    if let Some(link) = device.links.lock().by_handle(handle) {
+        link.idle_since.get_or_insert(now_ms());
+    }
+    crate::wake_task(device);
+}
+
+/// The task's look at the links: idle ones close, slow connections end.
+/// Returns whether it has to look again later.
+pub(crate) fn tick(device: &Device, now: u64) -> bool {
+    let mut waiting = false;
+    // Lock order: the links, then (never inside them) the sockets.
+    let (candidates, stale, next_le, silent) = {
+        let mut links = device.links.lock();
+        let mut candidates = Vec::new();
+        // Devices that did not say their L2CAP features in time: their
+        // channels go on without.
+        let mut silent = Vec::new();
+        let mut hostless = Vec::new();
+        for link in links.links.iter_mut() {
+            if let Some((_, since)) = link.info_request {
+                if now >= since + INFO_MS {
+                    silent.push(link.handle);
+                } else {
+                    waiting = true;
+                }
+            }
+            if link.remote_ssp.is_none() {
+                if now >= link.remote_asked + INFO_MS {
+                    hostless.push(link.handle);
+                } else {
+                    waiting = true;
+                }
+            }
+            if let Some(since) = link.idle_since {
+                if link.securing || link.smp.is_some() {
+                    link.idle_since = None;
+                } else if now >= since + IDLE_MS {
+                    candidates.push((link.handle, link.address));
+                } else {
+                    waiting = true;
+                }
+            }
+        }
+        let stale: Vec<_> = links
+            .connecting
+            .iter()
+            .filter(|connecting| connecting.started && now >= connecting.since + CONNECT_MS)
+            .map(|connecting| (connecting.address, connecting.address_type))
+            .collect();
+        // One LE connection at a time: the next waits for the controller.
+        let le_busy = links.connecting.iter().any(|connecting| connecting.started && is_le_type(connecting.address_type));
+        let next_le = (!le_busy)
+            .then(|| links.connecting.iter().find(|connecting| !connecting.started && is_le_type(connecting.address_type)))
+            .flatten()
+            .map(|connecting| (connecting.address, connecting.address_type));
+        waiting |= !links.connecting.is_empty();
+        (candidates, stale, next_le, (silent, hostless))
+    };
+    let (silent, hostless) = silent;
+    for handle in silent {
+        l2cap::info_done(device, handle, None, 0);
+    }
+    for handle in hostless {
+        remote_host(device, handle, false);
+    }
+    for (handle, address) in candidates {
+        let used = l2cap::channels_on(device.index, handle) > 0 || pairing::busy(device, &address) || crate::sco::uses_acl(device.index, &address);
+        if let Some(link) = device.links.lock().by_handle(handle) {
+            link.idle_since = None;
+        }
+        if !used {
+            let _ = disconnect(device, handle, 0x13);
+        }
+    }
+    for (address, address_type) in stale {
+        if is_le_type(address_type) {
+            let _ = device.command(hci::OP_LE_CREATE_CONN_CANCEL, &[]);
+        } else {
+            let _ = device.command(hci::OP_CREATE_CONN_CANCEL, &address);
+        }
+        connect_failed(device, address, address_type, 0x04);
+    }
+    if let Some((address, address_type)) = next_le {
+        start_connect(device, address, address_type);
+    }
+    waiting
+}
+
+/// Closes a link (`reason`: an HCI error code, 0x13 the user's).
+pub(crate) fn disconnect(device: &Device, handle: u16, reason: u8) -> Result<(), crate::device::CommandError> {
+    let mut params = handle.to_le_bytes().to_vec();
+    params.push(reason);
+    device.command(hci::OP_DISCONNECT, &params).map(|_| ())
+}
+
+/// Runs an action, in the task.
+pub(crate) fn act(device: &Device, action: Action) {
+    match action {
+        Action::Connect(address, address_type) => {
+            // LE connections wait their turn (`tick`).
+            if is_le_type(address_type) {
+                crate::wake_task(device);
+                return;
+            }
+            start_connect(device, address, address_type);
+        }
+        Action::Accept(address) => {
+            let mut params = address.to_vec();
+            // Stay the peripheral: the device that pages leads.
+            params.push(0x01);
+            let _ = device.command(hci::OP_ACCEPT_CONN_REQ, &params);
+        }
+        Action::Reject(address, reason) => {
+            let mut params = address.to_vec();
+            params.push(reason);
+            let _ = device.command(hci::OP_REJECT_CONN_REQ, &params);
+        }
+        Action::Disconnect(handle, reason) => {
+            let _ = disconnect(device, handle, reason);
+        }
+        Action::Command(opcode, params) => {
+            let _ = device.command(opcode, &params);
+        }
+        Action::Advertise => device.apply_advertising(),
+        Action::Rfkill(blocked) => {
+            if blocked && device.is_powered() {
+                device.power_off();
+                mgmt::new_settings(device.index, None);
+            }
+        }
+    }
+}
+
+/// The links the management interface lists (`MGMT_OP_GET_CONNECTIONS`).
+pub(crate) fn connections(device: &Device) -> Vec<u8> {
+    let links = device.links.lock();
+    let mut data = (links.links.len() as u16).to_le_bytes().to_vec();
+    for link in &links.links {
+        data.extend_from_slice(&link.address);
+        data.push(link.address_type);
+    }
+    data
+}
+
+/// The link to `address`, if any: its handle.
+pub(crate) fn handle_of(device: &Device, address: &[u8; 6], le: bool) -> Option<u16> {
+    device.links.lock().by_address(address, le).map(|link| link.handle)
+}
+
+/// The address and type of the device on a link.
+pub(crate) fn peer_of(device: &Device, handle: u16) -> Option<([u8; 6], u8, bool)> {
+    device.links.lock().by_handle(handle).map(|link| (link.address, link.address_type, link.le))
+}
