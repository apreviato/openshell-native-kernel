+++ b/kernel/comps/bluetooth/src/socket.rs
@@ -0,0 +1,270 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! HCI sockets (`BTPROTO_HCI`), the kernel's side: each is bound to a
+//! channel and holds the messages it has to read. The kernel's socket file
+//! (in `aster-core`) does the reading, writing and waiting.
+//!
+//! - **Control** (`HCI_CHANNEL_CONTROL`): the management interface
+//!   (`mgmt`), which bluetoothd runs controllers through.
+//! - **Monitor** (`HCI_CHANNEL_MONITOR`): every packet to and from every
+//!   controller, and the controllers coming and going, as btmon reads them.
+//! - **Raw** (`HCI_CHANNEL_RAW`): the events of one controller, and the
+//!   commands a tool sends it (hcitool).
+//! - **Logging** (`HCI_CHANNEL_LOGGING`): bluetoothd's log lines for btmon,
+//!   taken and dropped.
+
+use alloc::{boxed::Box, collections::VecDeque, sync::{Arc, Weak}, vec, vec::Vec};
+use core::sync::atomic::{AtomicUsize, Ordering};
+
+use ostd::sync::{LocalIrqDisabled, SpinLock};
+
+use crate::{device_at, hci, mgmt};
+
+/// Linux's errno values the sockets return.
+const EINVAL: i32 = 22;
+const ENODEV: i32 = 19;
+const EOPNOTSUPP: i32 = 95;
+const EALREADY: i32 = 114;
+const EBADFD: i32 = 77;
+
+/// The channels of `struct sockaddr_hci`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Channel {
+    Raw,
+    Monitor,
+    Control,
+    Logging,
+}
+
+impl Channel {
+    pub fn from_raw(channel: u16) -> Option<Self> {
+        match channel {
+            0 => Some(Self::Raw),
+            2 => Some(Self::Monitor),
+            3 => Some(Self::Control),
+            4 => Some(Self::Logging),
+            _ => None,
+        }
+    }
+}
+
+/// Monitor opcodes (`struct hci_mon_hdr`).
+const MON_NEW_INDEX: u16 = 0;
+const MON_DEL_INDEX: u16 = 1;
+const MON_COMMAND_PKT: u16 = 2;
+const MON_EVENT_PKT: u16 = 3;
+const MON_ACL_TX: u16 = 4;
+const MON_ACL_RX: u16 = 5;
+const MON_SCO_TX: u16 = 6;
+const MON_SCO_RX: u16 = 7;
+const MON_OPEN_INDEX: u16 = 8;
+
+/// The most a socket keeps unread before messages are dropped.
+const QUEUE_MESSAGES: usize = 1024;
+
+struct State {
+    channel: Option<Channel>,
+    /// The controller a raw socket is bound to (`0xffff`: none).
+    index: u16,
+    queue: VecDeque<Vec<u8>>,
+}
+
+pub struct Socket {
+    state: SpinLock<State, LocalIrqDisabled>,
+    /// Tells the socket file there is something to read.
+    notify: Box<dyn Fn() + Send + Sync>,
+}
+
+static SOCKETS: SpinLock<Vec<Weak<Socket>>, LocalIrqDisabled> = SpinLock::new(Vec::new());
+/// Monitor sockets open: without them, packets are not copied.
+static MONITORS: AtomicUsize = AtomicUsize::new(0);
+
+impl Socket {
+    pub fn new(notify: Box<dyn Fn() + Send + Sync>) -> Arc<Self> {
+        let socket = Arc::new(Self {
+            state: SpinLock::new(State { channel: None, index: mgmt::INDEX_NONE, queue: VecDeque::new() }),
+            notify,
+        });
+        let mut sockets = SOCKETS.lock();
+        sockets.retain(|socket| socket.strong_count() > 0);
+        sockets.push(Arc::downgrade(&socket));
+        socket
+    }
+
+    /// Binds the socket to a channel (and, for a raw socket, a controller).
+    /// `Err` is Linux's errno.
+    pub fn bind(&self, index: u16, channel: u16) -> Result<(), i32> {
+        let channel = Channel::from_raw(channel).ok_or(EINVAL)?;
+        match channel {
+            Channel::Raw => {
+                if index != mgmt::INDEX_NONE && device_at(index).is_none() {
+                    return Err(ENODEV);
+                }
+            }
+            _ => {
+                if index != mgmt::INDEX_NONE {
+                    return Err(EINVAL);
+                }
+            }
+        }
+        {
+            let mut state = self.state.lock();
+            if state.channel.is_some() {
+                return Err(EALREADY);
+            }
+            state.channel = Some(channel);
+            state.index = index;
+        }
+        if channel == Channel::Monitor {
+            MONITORS.fetch_add(1, Ordering::AcqRel);
+            // The controllers there are, as btmon expects first.
+            for device in crate::devices() {
+                let address = device.state.lock().info.address;
+                self.queue(monitor_message(MON_NEW_INDEX, device.index, &new_index(device.bus(), &address, device.index)));
+                self.queue(monitor_message(MON_OPEN_INDEX, device.index, &[]));
+            }
+        }
+        Ok(())
+    }
+
+    pub fn channel(&self) -> Option<Channel> {
+        self.state.lock().channel
+    }
+
+    /// A message the program writes. `Err` is Linux's errno.
+    pub fn send(self: &Arc<Self>, message: &[u8]) -> Result<usize, i32> {
+        let (channel, index) = {
+            let state = self.state.lock();
+            (state.channel, state.index)
+        };
+        match channel {
+            Some(Channel::Control) => mgmt::submit(self, message).map(|()| message.len()),
+            Some(Channel::Logging) => Ok(message.len()),
+            Some(Channel::Raw) => {
+                // A command (its packet type first) to the bound controller.
+                let device = device_at(index).ok_or(EBADFD)?;
+                if message.len() < 4 || message[0] != hci::COMMAND_PKT {
+                    return Err(EINVAL);
+                }
+                if !device.send_packet(hci::COMMAND_PKT, &message[1..]) {
+                    return Err(ENODEV);
+                }
+                Ok(message.len())
+            }
+            Some(Channel::Monitor) => Err(EOPNOTSUPP),
+            None => Err(EBADFD),
+        }
+    }
+
+    /// The next message to read, if any; `peek`: left to be read again.
+    pub fn recv(&self, peek: bool) -> Option<Vec<u8>> {
+        let mut state = self.state.lock();
+        if peek { state.queue.front().cloned() } else { state.queue.pop_front() }
+    }
+
+    pub fn readable(&self) -> bool {
+        !self.state.lock().queue.is_empty()
+    }
+
+    pub fn queue(&self, message: Vec<u8>) {
+        {
+            let mut state = self.state.lock();
+            if state.queue.len() >= QUEUE_MESSAGES {
+                return;
+            }
+            state.queue.push_back(message);
+        }
+        (self.notify)();
+    }
+}
+
+impl Drop for Socket {
+    fn drop(&mut self) {
+        if self.state.get_mut().channel == Some(Channel::Monitor) {
+            MONITORS.fetch_sub(1, Ordering::AcqRel);
+        }
+    }
+}
+
+fn sockets_on(channel: Channel) -> Vec<Arc<Socket>> {
+    SOCKETS
+        .lock()
+        .iter()
+        .filter_map(Weak::upgrade)
+        .filter(|socket| socket.channel() == Some(channel))
+        .collect()
+}
+
+/// A management event to every management socket but `skip`.
+pub fn control_event(message: &[u8], skip: Option<&Arc<Socket>>) {
+    for socket in sockets_on(Channel::Control) {
+        if skip.is_some_and(|skip| Arc::ptr_eq(skip, &socket)) {
+            continue;
+        }
+        socket.queue(message.to_vec());
+    }
+}
+
+/// An event of a controller to the raw sockets bound to it.
+pub fn raw_event(index: u16, event: &[u8]) {
+    for socket in sockets_on(Channel::Raw) {
+        if socket.state.lock().index == index {
+            let mut message = Vec::with_capacity(1 + event.len());
+            message.push(hci::EVENT_PKT);
+            message.extend_from_slice(event);
+            socket.queue(message);
+        }
+    }
+}
+
+fn monitor_message(opcode: u16, index: u16, payload: &[u8]) -> Vec<u8> {
+    let mut message = Vec::with_capacity(6 + payload.len());
+    message.extend_from_slice(&opcode.to_le_bytes());
+    message.extend_from_slice(&index.to_le_bytes());
+    message.extend_from_slice(&(payload.len() as u16).to_le_bytes());
+    message.extend_from_slice(payload);
+    message
+}
+
+/// `struct hci_mon_new_index`: type (primary), bus, address, name.
+fn new_index(bus: u8, address: &[u8; 6], index: u16) -> Vec<u8> {
+    let mut payload = vec![0x00, bus];
+    payload.extend_from_slice(address);
+    let mut name = alloc::format!("hci{index}").into_bytes();
+    name.resize(8, 0);
+    payload.extend_from_slice(&name);
+    payload
+}
+
+fn monitor(opcode: u16, index: u16, payload: &[u8]) {
+    if MONITORS.load(Ordering::Acquire) == 0 {
+        return;
+    }
+    let message = monitor_message(opcode, index, payload);
+    for socket in sockets_on(Channel::Monitor) {
+        socket.queue(message.clone());
+    }
+}
+
+/// A packet to (`received` false) or from a controller, to the monitors.
+pub fn monitor_packet(index: u16, packet_type: u8, received: bool, packet: &[u8]) {
+    let opcode = match (packet_type, received) {
+        (hci::COMMAND_PKT, _) => MON_COMMAND_PKT,
+        (hci::EVENT_PKT, _) => MON_EVENT_PKT,
+        (hci::ACL_PKT, false) => MON_ACL_TX,
+        (hci::ACL_PKT, true) => MON_ACL_RX,
+        (hci::SCO_PKT, false) => MON_SCO_TX,
+        (hci::SCO_PKT, true) => MON_SCO_RX,
+        _ => return,
+    };
+    monitor(opcode, index, packet);
+}
+
+pub fn monitor_index(index: u16, bus: u8, address: &[u8; 6], added: bool) {
+    if added {
+        monitor(MON_NEW_INDEX, index, &new_index(bus, address, index));
+        monitor(MON_OPEN_INDEX, index, &[]);
+    } else {
+        monitor(MON_DEL_INDEX, index, &[]);
+    }
+}
