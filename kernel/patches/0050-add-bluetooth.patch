new file mode 100755
index 0000000..c26655f
--- /dev/null
+++ b/kernel/libs/aster-rfkill/src/lib.rs
@@ -0,0 +1,256 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Radio switches (rfkill), as Linux keeps them: each radio a driver has
+//! (a Wi-Fi interface, a Bluetooth controller) registers a switch; a
+//! program blocks or unblocks them through `/dev/rfkill` (the Desktop's
+//! `rfkill unblock bluetooth`, airplane mode), and the driver turns its
+//! radio off or lets it on. Every open `/dev/rfkill` hears of switches
+//! that come, change and go, in Linux's `struct rfkill_event_ext`.
+
+#![no_std]
+#![deny(unsafe_code)]
+
+extern crate alloc;
+
+use alloc::{
+    boxed::Box,
+    collections::VecDeque,
+    string::String,
+    sync::{Arc, Weak},
+    vec::Vec,
+};
+use core::sync::atomic::{AtomicBool, AtomicU32, Ordering};
+
+use ostd::sync::{LocalIrqDisabled, SpinLock};
+
+/// Radio types (`enum rfkill_type`).
+pub mod kind {
+    pub const ALL: u8 = 0;
+    pub const WLAN: u8 = 1;
+    pub const BLUETOOTH: u8 = 2;
+    pub const UWB: u8 = 3;
+    pub const WIMAX: u8 = 4;
+    pub const WWAN: u8 = 5;
+    pub const GPS: u8 = 6;
+    pub const FM: u8 = 7;
+    pub const NFC: u8 = 8;
+
+    /// The type's name, as sysfs' `type` and `rfkill(8)` give it.
+    pub fn name(kind: u8) -> &'static str {
+        match kind {
+            ALL => "all",
+            WLAN => "wlan",
+            BLUETOOTH => "bluetooth",
+            UWB => "ultrawideband",
+            WIMAX => "wimax",
+            WWAN => "wwan",
+            GPS => "gps",
+            FM => "fm",
+            NFC => "nfc",
+            _ => "unknown",
+        }
+    }
+}
+
+/// Event operations (`enum rfkill_operation`).
+pub mod op {
+    pub const ADD: u8 = 0;
+    pub const DEL: u8 = 1;
+    pub const CHANGE: u8 = 2;
+    pub const CHANGE_ALL: u8 = 3;
+}
+
+/// `struct rfkill_event_ext`: index, type, operation, soft and hard
+/// blocks, the hard block's reasons.
+pub const EVENT_SIZE: usize = 9;
+pub type Event = [u8; EVENT_SIZE];
+
+/// A radio's switch.
+pub struct Switch {
+    index: u32,
+    kind: u8,
+    name: String,
+    soft: AtomicBool,
+    /// What the driver does when the switch changes (`true`: blocked).
+    apply: Box<dyn Fn(bool) + Send + Sync>,
+}
+
+impl Switch {
+    pub fn index(&self) -> u32 {
+        self.index
+    }
+
+    pub fn kind(&self) -> u8 {
+        self.kind
+    }
+
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+
+    /// Whether the radio must stay off.
+    pub fn is_blocked(&self) -> bool {
+        self.soft.load(Ordering::Acquire)
+    }
+
+    fn event(&self, operation: u8) -> Event {
+        let mut event = [0u8; EVENT_SIZE];
+        event[..4].copy_from_slice(&self.index.to_ne_bytes());
+        event[4] = self.kind;
+        event[5] = operation;
+        event[6] = self.is_blocked() as u8;
+        event
+    }
+}
+
+/// An open `/dev/rfkill`: the events it has to read.
+pub struct Listener {
+    queue: SpinLock<VecDeque<Event>, LocalIrqDisabled>,
+    notify: Box<dyn Fn() + Send + Sync>,
+}
+
+impl Listener {
+    pub fn next(&self) -> Option<Event> {
+        self.queue.lock().pop_front()
+    }
+
+    pub fn has_events(&self) -> bool {
+        !self.queue.lock().is_empty()
+    }
+
+    fn push(&self, event: Event) {
+        {
+            let mut queue = self.queue.lock();
+            // A reader that does not read loses the oldest.
+            if queue.len() >= 256 {
+                queue.pop_front();
+            }
+            queue.push_back(event);
+        }
+        (self.notify)();
+    }
+}
+
+static SWITCHES: SpinLock<Vec<Arc<Switch>>, LocalIrqDisabled> = SpinLock::new(Vec::new());
+static LISTENERS: SpinLock<Vec<Weak<Listener>>, LocalIrqDisabled> = SpinLock::new(Vec::new());
+static NEXT_INDEX: AtomicU32 = AtomicU32::new(0);
+/// The block a new switch starts with, per type (a radio blocked before
+/// its driver came, as airplane mode leaves them).
+static BLOCKED_KINDS: SpinLock<[bool; 16], LocalIrqDisabled> = SpinLock::new([false; 16]);
+
+/// What hears of switches that come (`true`) and go: the kernel's
+/// `/sys/class/rfkill`.
+pub type Hook = Arc<dyn Fn(&Arc<Switch>, bool) + Send + Sync>;
+static HOOK: SpinLock<Option<Hook>, LocalIrqDisabled> = SpinLock::new(None);
+
+/// Sets the hook; it hears first of every switch there is.
+pub fn set_hook(hook: Hook) {
+    *HOOK.lock() = Some(hook.clone());
+    let switches: Vec<_> = SWITCHES.lock().clone();
+    for switch in &switches {
+        hook(switch, true);
+    }
+}
+
+fn run_hook(switch: &Arc<Switch>, added: bool) {
+    let hook = HOOK.lock().clone();
+    if let Some(hook) = hook {
+        hook(switch, added);
+    }
+}
+
+fn broadcast(event: Event) {
+    let listeners: Vec<_> = LISTENERS.lock().iter().filter_map(Weak::upgrade).collect();
+    for listener in listeners {
+        listener.push(event);
+    }
+}
+
+/// A driver registers a radio; `apply` turns it off (`true`) or lets it on.
+pub fn register(kind: u8, name: String, apply: Box<dyn Fn(bool) + Send + Sync>) -> Arc<Switch> {
+    let blocked = BLOCKED_KINDS.lock().get(kind as usize).copied().unwrap_or(false);
+    let switch = Arc::new(Switch {
+        index: NEXT_INDEX.fetch_add(1, Ordering::Relaxed),
+        kind,
+        name,
+        soft: AtomicBool::new(blocked),
+        apply,
+    });
+    // Its sysfs directory comes first: a program that hears of it reads
+    // its name there (BlueZ finds `hciN` so).
+    run_hook(&switch, true);
+    SWITCHES.lock().push(switch.clone());
+    broadcast(switch.event(op::ADD));
+    if blocked {
+        (switch.apply)(true);
+    }
+    switch
+}
+
+/// The radio went away.
+pub fn unregister(switch: &Arc<Switch>) {
+    SWITCHES.lock().retain(|known| !Arc::ptr_eq(known, switch));
+    broadcast(switch.event(op::DEL));
+    run_hook(switch, false);
+}
+
+/// Blocks or unblocks one switch (sysfs' `soft` and `state`).
+pub fn set_blocked(switch: &Arc<Switch>, blocked: bool) {
+    set(switch, blocked);
+}
+
+/// Opens a listener: it hears first of every switch there is.
+pub fn listen(notify: Box<dyn Fn() + Send + Sync>) -> Arc<Listener> {
+    let listener = Arc::new(Listener { queue: SpinLock::new(VecDeque::new()), notify });
+    for switch in SWITCHES.lock().iter() {
+        listener.queue.lock().push_back(switch.event(op::ADD));
+    }
+    let mut listeners = LISTENERS.lock();
+    listeners.retain(|listener| listener.strong_count() > 0);
+    listeners.push(Arc::downgrade(&listener));
+    listener
+}
+
+fn set(switch: &Arc<Switch>, blocked: bool) {
+    if switch.soft.swap(blocked, Ordering::AcqRel) == blocked {
+        return;
+    }
+    (switch.apply)(blocked);
+    broadcast(switch.event(op::CHANGE));
+}
+
+/// A program's request (`struct rfkill_event` written to `/dev/rfkill`):
+/// one switch (`CHANGE`) or every one of a type (`CHANGE_ALL`). `Err` is
+/// Linux's errno.
+pub fn request(bytes: &[u8]) -> Result<(), i32> {
+    const EINVAL: i32 = 22;
+    if bytes.len() < 7 {
+        return Err(EINVAL);
+    }
+    let index = u32::from_ne_bytes(bytes[..4].try_into().unwrap());
+    let (kind, operation, blocked) = (bytes[4], bytes[5], bytes[6] != 0);
+    let switches: Vec<_> = SWITCHES.lock().clone();
+    match operation {
+        op::CHANGE => {
+            let Some(switch) = switches.iter().find(|switch| switch.index == index) else {
+                return Err(EINVAL);
+            };
+            set(switch, blocked);
+        }
+        op::CHANGE_ALL => {
+            {
+                let mut kinds = BLOCKED_KINDS.lock();
+                if kind == kind::ALL {
+                    kinds.fill(blocked);
+                } else if let Some(entry) = kinds.get_mut(kind as usize) {
+                    *entry = blocked;
+                }
+            }
+            for switch in switches.iter().filter(|switch| kind == kind::ALL || switch.kind == kind) {
+                set(switch, blocked);
+            }
+        }
+        _ => return Err(EINVAL),
+    }
+    Ok(())
+}
