+    pub(crate) const USER_CONFIRM_NEG_REPLY: u16 = 0x001d;
+    pub(crate) const USER_PASSKEY_REPLY: u16 = 0x001e;
+    pub(crate) const USER_PASSKEY_NEG_REPLY: u16 = 0x001f;
+    pub(crate) const ADD_REMOTE_OOB_DATA: u16 = 0x0021;
+    pub(crate) const REMOVE_REMOTE_OOB_DATA: u16 = 0x0022;
