index 0000000..2cd160d
--- /dev/null
+++ b/kernel/comps/bluetooth/src/vendor.rs
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Which vendor set-up a controller needs before the standard one, by its
+//! USB ids, as Linux's `btusb` table says: Intel's firmware (`intel`),
+//! Realtek's patch (`realtek`), or none.
+
+use crate::{
+    device::{CommandError, Device},
+    intel, realtek,
+};
+
+/// Intel products that boot firmware (`BTUSB_INTEL_COMBINED`).
+const INTEL: &[u16] = &[
+    0x0025, 0x0026, 0x0029, 0x0032, 0x0033, 0x0035, 0x0036, 0x0037, 0x0038, 0x0039, 0x07dc, 0x0a2a, 0x0a2b,
+    0x0aa7, 0x0aaa,
+];
+
+/// Realtek chips under other makers' ids (`BTUSB_REALTEK`); every
+/// Realtek-made one (`0bda`) is Realtek's too.
+const REALTEK: &[(u16, u16)] = &[
+    (0x0489, 0xe085), (0x0489, 0xe08b), (0x0489, 0xe112), (0x0489, 0xe122), (0x0489, 0xe123),
+    (0x0489, 0xe125), (0x0489, 0xe12f), (0x0489, 0xe130), (0x04c5, 0x161f), (0x04c5, 0x165c),
+    (0x04c5, 0x1675), (0x04ca, 0x4005), (0x04ca, 0x4006), (0x04ca, 0x4007), (0x04f2, 0xb49f),
+    (0x0930, 0x021d), (0x0b05, 0x17dc), (0x0b05, 0x185c), (0x0b05, 0x18ef), (0x0b05, 0x190e),
+    (0x0cb5, 0xc547), (0x0cb8, 0xc549), (0x0cb8, 0xc558), (0x0cb8, 0xc559), (0x1358, 0xc123),
+    (0x13d3, 0x3394), (0x13d3, 0x3410), (0x13d3, 0x3414), (0x13d3, 0x3416), (0x13d3, 0x3458),
+    (0x13d3, 0x3459), (0x13d3, 0x3461), (0x13d3, 0x3462), (0x13d3, 0x3494), (0x13d3, 0x3526),
+    (0x13d3, 0x3529), (0x13d3, 0x3533), (0x13d3, 0x3548), (0x13d3, 0x3549), (0x13d3, 0x3553),
+    (0x13d3, 0x3555), (0x13d3, 0x3570), (0x13d3, 0x3571), (0x13d3, 0x3572), (0x13d3, 0x3586),
+    (0x13d3, 0x3587), (0x13d3, 0x3591), (0x13d3, 0x3592), (0x13d3, 0x3600), (0x13d3, 0x3601),
+    (0x13d3, 0x3612), (0x13d3, 0x3616), (0x13d3, 0x3617), (0x13d3, 0x3618), (0x2001, 0x332a),
+    (0x2357, 0x0604), (0x2550, 0x8761), (0x2b89, 0x6275), (0x2b89, 0x8761), (0x2c0a, 0x8761),
+    (0x2c4e, 0x0128), (0x2ff8, 0x3051), (0x2ff8, 0xb011), (0x3625, 0x010b), (0x6655, 0x8771),
+    (0x7392, 0xa611), (0x7392, 0xc611), (0x7392, 0xe611),
+];
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Vendor {
+    Generic,
+    Intel(u16),
+    Realtek,
+}
+
+impl Vendor {
+    pub(crate) fn of_usb(vendor: u16, product: u16) -> Self {
+        match vendor {
+            0x8087 if INTEL.contains(&product) => Self::Intel(product),
+            0x0bda => Self::Realtek,
+            _ if REALTEK.contains(&(vendor, product)) => Self::Realtek,
+            _ => Self::Generic,
+        }
+    }
+}
+
+/// The vendor's set-up, before the standard one.
+pub(crate) fn setup(device: &Device) -> Result<(), CommandError> {
+    let Some((vendor, product)) = device.usb_ids() else {
+        return Ok(());
+    };
+    match Vendor::of_usb(vendor, product) {
+        Vendor::Generic => Ok(()),
+        Vendor::Intel(product) => intel::setup(device, product),
+        Vendor::Realtek => realtek::setup(device),
+    }
+}
