+// SPDX-License-Identifier: MPL-2.0
+
+//! Intel controllers (USB `8087:*`): the operational firmware they boot
+//! into, as Linux's `btintel` loads it from `/lib/firmware/intel`.
+//!
+//! A controller starts in its boot loader. Its version says which firmware
+//! it takes: the TLV form (AX210 and later, `ibt-<cnvi>-<cnvr>.sfi`) or the
+//! legacy one (8260 to AX201, `ibt-<variant>-<revision>-<revision>.sfi`).
+//! The file's signed header and its commands go to the boot loader in
+//! "secure send" fragments; once it says they arrived, an Intel reset
+//! boots the firmware, which says when it is up. Its configuration (the
+//! `.ddc` file) follows. A controller already running its firmware (a warm
+//! reboot) keeps it. The 7260 and 7265 (`07dc`, `0a2a`, `0aa7`) run from
+//! ROM and need nothing.
+
+use alloc::{format, string::String, vec, vec::Vec};
+
+use crate::{
+    device::{CommandError, Device},
+    hci,
+};
+
+const OP_INTEL_RESET: u16 = 0xfc01;
+const OP_READ_VERSION: u16 = 0xfc05;
+const OP_SECURE_SEND: u16 = 0xfc09;
+const OP_READ_BOOT_PARAMS: u16 = 0xfc0d;
+const OP_WRITE_BOOT_PARAMS: u16 = 0xfc0e;
+const OP_SET_EVENT_MASK: u16 = 0xfc52;
+const OP_WRITE_DDC: u16 = 0xfc8b;
+
+/// The parts of a `.sfi` file: the RSA header, then (variants 0x17 on)
+/// the ECDSA one, then the commands.
+const RSA_HEADER_LEN: usize = 644;
+const ECDSA_OFFSET: usize = 644;
+const ECDSA_HEADER_LEN: usize = 320;
+const CSS_HEADER_OFFSET: usize = 8;
+
+/// Image types of the TLV version.
+const IMG_BOOTLOADER: u8 = 0x01;
+const IMG_IML: u8 = 0x02;
+const IMG_OP: u8 = 0x03;
+/// The legacy version's firmware variant when operational.
+const FW_VARIANT_OP: u8 = 0x23;
+
+/// Vendor events of the boot loader: the firmware booted, the download's
+/// result.
+const EVENT_BOOTUP: u8 = 0x02;
+const EVENT_SECURE_SEND_RESULT: u8 = 0x06;
+
+/// How long the download and the boot may take (Linux's 5 s each).
+const DOWNLOAD_MS: u64 = 5000;
+const BOOT_MS: u64 = 5000;
+
+/// The legacy `HCI_Intel_Read_Version` reply, without its status.
+#[derive(Clone, Copy, Debug, Default)]
+struct Version {
+    hw_platform: u8,
+    hw_variant: u8,
+    hw_revision: u8,
+    fw_variant: u8,
+    fw_revision: u8,
+    fw_build_num: u8,
+    fw_build_ww: u8,
+    fw_build_yy: u8,
+}
+
+impl Version {
+    fn parse(bytes: &[u8]) -> Option<Self> {
+        (bytes.len() == 9 && bytes[0] == 0x37).then(|| Self {
+            hw_platform: bytes[0],
+            hw_variant: bytes[1],
+            hw_revision: bytes[2],
+            fw_variant: bytes[3],
+            fw_revision: bytes[4],
+            fw_build_num: bytes[5],
+            fw_build_ww: bytes[6],
+            fw_build_yy: bytes[7],
+        })
+    }
+}
+
+/// The TLV `HCI_Intel_Read_Version` reply's fields this side uses.
+#[derive(Clone, Debug, Default)]
+pub(crate) struct VersionTlv {
+    pub cnvi_top: u32,
+    pub cnvr_top: u32,
+    pub cnvi_bt: u32,
+    pub img_type: u8,
+    pub build_num: u32,
+    pub min_fw_build_nn: u8,
+    pub min_fw_build_cw: u8,
+    pub min_fw_build_yy: u8,
+    pub limited_cce: u8,
+    pub sbe_type: u8,
+    pub otp_bdaddr: [u8; 6],
+    pub fw_id: String,
+}
+
+impl VersionTlv {
+    /// Parses the reply (after its status): type, length, value.
+    pub(crate) fn parse(mut bytes: &[u8]) -> Option<Self> {
+        let mut version = Self::default();
+        let le32 = |value: &[u8]| value.get(..4).map(|b| u32::from_le_bytes(b.try_into().unwrap())).unwrap_or(0);
+        while !bytes.is_empty() {
+            if bytes.len() < 2 || bytes.len() < 2 + bytes[1] as usize {
+                return None;
+            }
+            let (kind, value) = (bytes[0], &bytes[2..2 + bytes[1] as usize]);
+            let first = value.first().copied().unwrap_or(0);
+            match kind {
+                0x10 => version.cnvi_top = le32(value),
+                0x11 => version.cnvr_top = le32(value),
+                0x12 => version.cnvi_bt = le32(value),
+                0x1c => version.img_type = first,
+                0x1d => {
+                    version.min_fw_build_cw = first;
+                    version.min_fw_build_yy = value.get(1).copied().unwrap_or(0);
+                }
+                0x1f => {
+                    version.min_fw_build_nn = first;
+                    version.build_num = le32(value);
+                }
+                0x2d => {
+                    version.min_fw_build_nn = first;
+                    version.min_fw_build_cw = value.get(1).copied().unwrap_or(0);
+                    version.min_fw_build_yy = value.get(2).copied().unwrap_or(0);
+                }
+                0x2e => version.limited_cce = first,
+                0x2f => version.sbe_type = first,
+                0x30 if value.len() >= 6 => version.otp_bdaddr.copy_from_slice(&value[..6]),
+                0x50 => {
+                    let end = value.iter().position(|byte| *byte == 0).unwrap_or(value.len());
+                    version.fw_id = String::from_utf8_lossy(&value[..end]).into();
+                }
+                _ => {}
+            }
+            bytes = &bytes[2 + bytes[1] as usize..];
+        }
+        Some(version)
+    }
+
+    pub(crate) fn platform(&self) -> u8 {
+        ((self.cnvi_bt >> 8) & 0xff) as u8
+    }
+
+    pub(crate) fn variant(&self) -> u8 {
+        ((self.cnvi_bt >> 16) & 0x3f) as u8
+    }
+
+    /// `intel/ibt-<cnvi>-<cnvr>[-iml|-<fw id>].<suffix>`, as Linux names it.
+    pub(crate) fn file_name(&self, suffix: &str) -> String {
+        let pack = |top: u32| -> u16 { ((((top & 0xfff) << 4) | ((top >> 24) & 0xf)) as u16).swap_bytes() };
+        let (cnvi, cnvr) = (pack(self.cnvi_top), pack(self.cnvr_top));
+        if self.variant() >= 0x1e {
+            if self.img_type == IMG_BOOTLOADER {
+                return format!("intel/ibt-{cnvi:04x}-{cnvr:04x}-iml.{suffix}");
+            }
+            if !self.fw_id.is_empty() {
+                return format!("intel/ibt-{cnvi:04x}-{cnvr:04x}-{}.{suffix}", self.fw_id);
+            }
+        }
+        format!("intel/ibt-{cnvi:04x}-{cnvr:04x}.{suffix}")
+    }
+}
+
+/// Where a `.sfi` file's commands begin and how its header is sent.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Header {
+    Rsa { commands: usize },
+    Ecdsa { commands: usize },
+}
+
+/// Checks a `.sfi` file against the controller's variant and secure boot
+/// engine (0: RSA, 1: ECDSA), as Linux does.
+pub(crate) fn header(file: &[u8], variant: u8, sbe_type: u8) -> Result<Header, &'static str> {
+    let le32 = |at: usize| file.get(at..at + 4).map(|b| u32::from_le_bytes(b.try_into().unwrap()));
+    if file.len() < RSA_HEADER_LEN {
+        return Err("the firmware file is too short");
+    }
+    if le32(CSS_HEADER_OFFSET) != Some(0x0001_0000) {
+        return Err("the firmware's CSS header version is wrong");
+    }
+    if variant <= 0x14 {
+        if sbe_type != 0 {
+            return Err("the secure boot engine does not go with the variant");
+        }
+        return Ok(Header::Rsa { commands: RSA_HEADER_LEN });
+    }
+    if file.get(ECDSA_OFFSET) != Some(&0x06) || le32(ECDSA_OFFSET + CSS_HEADER_OFFSET) != Some(0x0002_0000) {
+        return Err("the firmware's ECDSA header is wrong");
+    }
+    let commands = RSA_HEADER_LEN + ECDSA_HEADER_LEN;
+    match sbe_type {
+        0 => Ok(Header::Rsa { commands }),
+        1 => Ok(Header::Ecdsa { commands }),
+        _ => Err("the secure boot engine is unknown"),
+    }
+}
+
+/// The commands of the file from `offset`, in the 4-byte aligned groups
+/// the boot loader takes (the file pads them with no-ops), and the boot
+/// address its Write Boot Params command gives.
+pub(crate) fn command_groups(file: &[u8], offset: usize) -> Result<(Vec<(usize, usize)>, Option<u32>), &'static str> {
+    let mut groups = Vec::new();
+    let mut boot_address = None;
+    let (mut start, mut at) = (offset, offset);
+    while at < file.len() {
+        let header = file.get(at..at + 3).ok_or("a firmware command is cut short")?;
+        let opcode = u16::from_le_bytes([header[0], header[1]]);
+        let length = 3 + header[2] as usize;
+        if at + length > file.len() {
+            return Err("a firmware command is cut short");
+        }
+        if opcode == OP_WRITE_BOOT_PARAMS && length >= 7 {
+            boot_address = Some(u32::from_le_bytes(file[at + 3..at + 7].try_into().unwrap()));
+        }
+        at += length;
+        if (at - start) % 4 == 0 {
+            groups.push((start, at - start));
+            start = at;
+        }
+    }
+    if start != at {
+        return Err("the firmware's commands are not 4-byte aligned");
+    }
+    Ok((groups, boot_address))
+}
+
+/// Sets an Intel controller up. `product` is its USB product id.
+pub(crate) fn setup(device: &Device, product: u16) -> Result<(), CommandError> {
+    // Some answer their first command with no command credits, or sit in
+    // a radio-off state after a shutdown: a reset first sorts both.
+    if matches!(product, 0x07dc | 0x0a2a | 0x0aa7) {
+        device.command(hci::OP_RESET, &[])?;
+    }
+    // The TLV request; older controllers answer it in the legacy form.
+    let reply = device.command(OP_READ_VERSION, &[0xff])?;
+    if let Some(version) = Version::parse(&reply) {
+        return match version.hw_variant {
+            // 7260, 7265: ROM firmware.
+            0x07 | 0x08 => Ok(()),
+            0x0b | 0x0c | 0x11..=0x14 => bootloader_setup(device, version),
+            variant => {
+                ostd::warn!("hci{}: Intel: hardware variant {variant:#x} is not supported", device.index);
+                Err(CommandError::Status(hci::STATUS_UNKNOWN_COMMAND))
+            }
+        };
+    }
+    let version = VersionTlv::parse(&reply).ok_or(CommandError::Status(hci::STATUS_UNKNOWN_COMMAND))?;
+    if version.platform() != 0x37 {
+        ostd::warn!("hci{}: Intel: hardware platform {:#x} is not supported", device.index, version.platform());
+        return Err(CommandError::Status(hci::STATUS_UNKNOWN_COMMAND));
+    }
+    match version.variant() {
+        // Legacy boot loaders that also answer in TLV form: their firmware
+        // is named by the legacy version.
+        0x11..=0x14 => {
+            let reply = device.command(OP_READ_VERSION, &[])?;
+            let version = Version::parse(&reply).ok_or(CommandError::Status(hci::STATUS_UNKNOWN_COMMAND))?;
+            bootloader_setup(device, version)
+        }
+        0x17..=0x19 | 0x1b..=0x1f | 0x22 => bootloader_setup_tlv(device, version),
+        variant => {
+            ostd::warn!("hci{}: Intel: hardware variant {variant:#x} is not supported", device.index);
+            Err(CommandError::Status(hci::STATUS_UNKNOWN_COMMAND))
+        }
+    }
+}
+
+/// The legacy boot loader (8260 to AX201).
+fn bootloader_setup(device: &Device, version: Version) -> Result<(), CommandError> {
+    ostd::notice!(
+        "hci{}: Intel: variant {:#x} revision {} firmware {}.{} build {} week {} 20{}",
+        device.index, version.hw_variant, version.hw_revision, version.fw_revision >> 4,
+        version.fw_revision & 0xf, version.fw_build_num, version.fw_build_ww, version.fw_build_yy
+    );
+    let _ = version.hw_platform;
+    if version.fw_variant != FW_VARIANT_OP {
+        device.set_bootloader(true);
+        let params = device.command(OP_READ_BOOT_PARAMS, &[])?;
+        if params.len() != 22 {
+            return Err(CommandError::Status(hci::STATUS_UNKNOWN_COMMAND));
+        }
+        let dev_revid = u16::from_le_bytes([params[3], params[4]]);
+        // Every fragment must be acknowledged.
+        if params[20] != 0 {
+            ostd::warn!("hci{}: Intel: the boot loader does not acknowledge fragments", device.index);
+            device.set_bootloader(false);
+            return Err(CommandError::Status(hci::STATUS_UNKNOWN_COMMAND));
+        }
+        let name = legacy_file_name(&version, dev_revid, "sfi").ok_or(CommandError::Status(hci::STATUS_UNKNOWN_COMMAND))?;
+        let result = download(device, &name, Header::Rsa { commands: RSA_HEADER_LEN }).and_then(|boot| boot_firmware(device, boot));
+        device.set_bootloader(false);
+        result?;
+        if let Some(ddc) = legacy_file_name(&version, dev_revid, "ddc") {
+            load_ddc(device, &ddc);
+        }
+        if let Ok(reply) = device.command(OP_READ_VERSION, &[]) {
+            if let Some(running) = Version::parse(&reply) {
+                ostd::notice!(
+                    "hci{}: Intel: firmware build {} week {} 20{} running",
+                    device.index, running.fw_build_num, running.fw_build_ww, running.fw_build_yy
+                );
+            }
+        }
+    }
+    // A few vendor events (none for debugging); optional.
+    let _ = device.command(OP_SET_EVENT_MASK, &[0x87, 0x0c, 0, 0, 0, 0, 0, 0]);
+    Ok(())
+}
+
+fn legacy_file_name(version: &Version, dev_revid: u16, suffix: &str) -> Option<String> {
+    match version.hw_variant {
+        0x0b | 0x0c => Some(format!("intel/ibt-{}-{}.{suffix}", version.hw_variant, dev_revid)),
+        0x11..=0x14 => Some(format!(
+            "intel/ibt-{}-{}-{}.{suffix}",
+            version.hw_variant, version.hw_revision, version.fw_revision
+        )),
+        _ => None,
+    }
+}
+
+/// The TLV boot loader (AX210 and later).
+fn bootloader_setup_tlv(device: &Device, mut version: VersionTlv) -> Result<(), CommandError> {
+    ostd::notice!(
+        "hci{}: Intel: variant {:#x} image {} build {}",
+        device.index, version.variant(), version.img_type, version.build_num
+    );
+    if version.img_type != IMG_OP {
+        if version.limited_cce != 0 || version.sbe_type > 1 {
+            ostd::warn!("hci{}: Intel: the boot loader's loading method is not supported", device.index);
+            return Err(CommandError::Status(hci::STATUS_UNKNOWN_COMMAND));
+        }
+        device.set_bootloader(true);
+        let result = (|| {
+            let boot = download_tlv(device, &version)?;
+            boot_firmware(device, boot)?;
+            version = read_version_tlv(device)?;
+            // An intermediate loader (Blazar) takes the firmware next.
+            if version.img_type == IMG_IML {
+                let boot = download_tlv(device, &version)?;
+                boot_firmware(device, boot)?;
+                version = read_version_tlv(device)?;
+            }
+            Ok(())
+        })();
+        device.set_bootloader(false);
+        result?;
+        load_ddc(device, &version.file_name("ddc"));
+        ostd::notice!("hci{}: Intel: firmware build {} running", device.index, version.build_num);
+    }
+    let _ = device.command(OP_SET_EVENT_MASK, &[0x87, 0x0c, 0, 0, 0, 0, 0, 0]);
+    Ok(())
+}
+
+fn read_version_tlv(device: &Device) -> Result<VersionTlv, CommandError> {
+    let reply = device.command(OP_READ_VERSION, &[0xff])?;
+    VersionTlv::parse(&reply).ok_or(CommandError::Status(hci::STATUS_UNKNOWN_COMMAND))
+}
+
+fn download_tlv(device: &Device, version: &VersionTlv) -> Result<u32, CommandError> {
+    let name = version.file_name("sfi");
+    let file = aster_firmware::load(&name).ok_or_else(|| {
+        ostd::warn!("hci{}: Intel: firmware {name} is missing", device.index);
+        CommandError::Gone
+    })?;
+    let layout = header(&file, version.variant(), version.sbe_type).map_err(|reason| {
+        ostd::warn!("hci{}: Intel: {name}: {reason}", device.index);
+        CommandError::Gone
+    })?;
+    send_firmware(device, &name, &file, layout)
+}
+
+/// Loads and sends a firmware file; returns its boot address.
+fn download(device: &Device, name: &str, layout: Header) -> Result<u32, CommandError> {
+    let file = aster_firmware::load(name).ok_or_else(|| {
+        ostd::warn!("hci{}: Intel: firmware {name} is missing", device.index);
+        CommandError::Gone
+    })?;
+    if file.len() < RSA_HEADER_LEN {
+        return Err(CommandError::Gone);
+    }
+    send_firmware(device, name, &file, layout)
+}
+
+fn send_firmware(device: &Device, name: &str, file: &[u8], layout: Header) -> Result<u32, CommandError> {
+    let commands = match layout {
+        Header::Rsa { commands } | Header::Ecdsa { commands } => commands,
+    };
+    let (groups, boot_address) = command_groups(file, commands).map_err(|reason| {
+        ostd::warn!("hci{}: Intel: {name}: {reason}", device.index);
+        CommandError::Gone
+    })?;
+    ostd::notice!("hci{}: Intel: loading {name}", device.index);
+    let started = crate::now_ms();
+    device.watch_vendor_events(true);
+    let sent = (|| {
+        // The signed header: the CSS part, the public key, the signature.
+        match layout {
+            Header::Rsa { .. } => {
+                secure_send(device, 0x00, &file[..128])?;
+                secure_send(device, 0x03, &file[128..384])?;
+                secure_send(device, 0x02, &file[388..644])?;
+            }
+            Header::Ecdsa { .. } => {
+                secure_send(device, 0x00, &file[ECDSA_OFFSET..ECDSA_OFFSET + 128])?;
+                secure_send(device, 0x03, &file[ECDSA_OFFSET + 128..ECDSA_OFFSET + 224])?;
+                secure_send(device, 0x02, &file[ECDSA_OFFSET + 224..ECDSA_OFFSET + 320])?;
+            }
+        }
+        for (start, length) in groups {
+            secure_send(device, 0x01, &file[start..start + length])?;
+        }
+        // The boot loader says once everything arrived.
+        let result = device
+            .wait_vendor_event(EVENT_SECURE_SEND_RESULT, DOWNLOAD_MS)
+            .ok_or(CommandError::Timeout)?;
+        if result.get(1).copied().unwrap_or(1) != 0 {
+            ostd::warn!("hci{}: Intel: the boot loader rejected {name}", device.index);
+            return Err(CommandError::Status(result[1]));
+        }
+        Ok(())
+    })();
+    if let Err(error) = sent {
+        device.watch_vendor_events(false);
+        reset_to_bootloader(device);
+        return Err(error);
+    }
+    ostd::notice!("hci{}: Intel: firmware loaded in {} ms", device.index, crate::now_ms() - started);
+    Ok(boot_address.unwrap_or(0))
+}
+
+/// Secure send: the data in fragments of 252 bytes, each acknowledged.
+fn secure_send(device: &Device, kind: u8, mut data: &[u8]) -> Result<(), CommandError> {
+    while !data.is_empty() {
+        let length = data.len().min(252);
+        let mut params = Vec::with_capacity(length + 1);
+        params.push(kind);
+        params.extend_from_slice(&data[..length]);
+        device.command(OP_SECURE_SEND, &params)?;
+        data = &data[length..];
+    }
+    Ok(())
+}
+
+/// Boots the loaded firmware: an Intel reset to its boot address (which
+/// the boot loader does not acknowledge), then its boot-up event.
+fn boot_firmware(device: &Device, boot_address: u32) -> Result<(), CommandError> {
+    let mut params = vec![0x00, 0x01, 0x00, 0x01];
+    params.extend_from_slice(&boot_address.to_le_bytes());
+    device.watch_vendor_events(true);
+    let started = crate::now_ms();
+    if !device.send_command(OP_INTEL_RESET, &params) {
+        device.watch_vendor_events(false);
+        return Err(CommandError::Gone);
+    }
+    let booted = device.wait_vendor_event(EVENT_BOOTUP, BOOT_MS);
+    device.watch_vendor_events(false);
+    if booted.is_none() {
+        ostd::warn!("hci{}: Intel: the firmware did not boot", device.index);
+        reset_to_bootloader(device);
+        return Err(CommandError::Timeout);
+    }
+    ostd::notice!("hci{}: Intel: booted in {} ms", device.index, crate::now_ms() - started);
+    Ok(())
+}
+
+/// After a failed download: a hard reset back to the boot loader, which
+/// makes the device come again on its bus, for another try.
+fn reset_to_bootloader(device: &Device) {
+    device.send_command(OP_INTEL_RESET, &[0x01, 0x01, 0x01, 0x00, 0, 0, 0, 0]);
+}
+
+/// The device configuration: entries of a length, an id and a value, each
+/// a Write DDC command. The controller works without it.
+fn load_ddc(device: &Device, name: &str) {
+    let Some(file) = aster_firmware::try_load(name) else {
+        return;
+    };
+    let mut at = 0;
+    while at < file.len() {
+        let length = file[at] as usize + 1;
+        if at + length > file.len() || device.command(OP_WRITE_DDC, &file[at..at + length]).is_err() {
+            ostd::warn!("hci{}: Intel: {name} did not apply", device.index);
+            return;
+        }
+        at += length;
+    }
+    ostd::notice!("hci{}: Intel: {name} applied", device.index);
+}
