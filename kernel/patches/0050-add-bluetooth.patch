diff --git a/kernel/comps/usb/src/bt.rs b/kernel/comps/usb/src/bt.rs
new file mode 100755
index 0000000..788dabf
--- /dev/null
+++ b/kernel/comps/usb/src/bt.rs
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Bluetooth controllers on USB (Linux's `btusb`): commands go out as
+//! control transfers, events come on the interrupt endpoint, ACL data on
+//! the bulk endpoints, each packet in as many transfers as it takes. The
+//! controller task (`xhci`) moves them; this side keeps what goes out and
+//! puts packets back together.
+
+use alloc::{collections::VecDeque, sync::Arc, vec::Vec};
+use core::sync::atomic::{AtomicBool, Ordering};
+
+use aster_bluetooth::{Driver, bus, hci};
+use ostd::sync::{LocalIrqDisabled, SpinLock};
+
+/// Makers whose Bluetooth interfaces carry their own class (0xff) but
+/// speak plain HCI (Linux's `USB_VENDOR_AND_INTERFACE_INFO(…, 0xff, 1, 1)`).
+const VENDOR_CLASS_MAKERS: &[u16] = &[
+    0x05ac, 0x105b, 0x0bb4, 0x0489, 0x04ca, 0x0a5c, 0x0b05, 0x050d, 0x13d3, 0x413c, 0x0930,
+];
+
+/// Whether an interface (class, subclass, protocol) of a device by
+/// `vendor` is a Bluetooth controller's.
+pub(crate) fn is_controller(vendor: u16, class: u8, subclass: u8, protocol: u8) -> bool {
+    match (class, subclass, protocol) {
+        (0xe0, 0x01, 0x01) => true,
+        (0xff, 0x01, 0x01) => VENDOR_CLASS_MAKERS.contains(&vendor),
+        _ => false,
+    }
+}
+
+/// What the stack sends, for the controller task to move.
+pub(crate) struct Shared {
+    pub tx: SpinLock<VecDeque<(u8, Vec<u8>)>, LocalIrqDisabled>,
+    /// Intel's boot loader: events on the bulk endpoint, firmware out on it.
+    pub bootloader: AtomicBool,
+    ids: (u16, u16),
+}
+
+impl Shared {
+    pub(crate) fn new(ids: (u16, u16)) -> Arc<Self> {
+        Arc::new(Self { tx: SpinLock::new(VecDeque::new()), bootloader: AtomicBool::new(false), ids })
+    }
+}
+
+/// The controller's transport, as the stack sees it.
+pub(crate) struct UsbBluetooth(pub Arc<Shared>);
+
+impl Driver for UsbBluetooth {
+    fn send(&self, packet_type: u8, packet: &[u8]) -> bool {
+        if !matches!(packet_type, hci::COMMAND_PKT | hci::ACL_PKT) {
+            return false;
+        }
+        self.0.tx.lock().push_back((packet_type, packet.to_vec()));
+        crate::wake();
+        true
+    }
+
+    fn bus(&self) -> u8 {
+        bus::USB
+    }
+
+    fn usb_ids(&self) -> Option<(u16, u16)> {
+        Some(self.0.ids)
+    }
+
+    fn set_bootloader(&self, on: bool) {
+        self.0.bootloader.store(on, Ordering::Release);
+    }
+}
+
+/// Whether a command goes on the bulk endpoint: Intel's secure send in its
+/// boot loader.
+pub(crate) fn command_on_bulk(shared: &Shared, packet: &[u8]) -> bool {
+    shared.bootloader.load(Ordering::Acquire) && packet.get(..2) == Some(&[0x09, 0xfc])
+}
+
+/// Puts packets back together from the pieces transfers bring: events
+/// (a 2-byte header, the length in its second byte) or ACL data (4 bytes,
+/// the length in the last two).
+pub(crate) struct Reassembly {
+    header: usize,
+    buffer: Vec<u8>,
+}
+
+impl Reassembly {
+    pub(crate) const fn events() -> Self {
+        Self { header: 2, buffer: Vec::new() }
+    }
+
+    pub(crate) const fn acl() -> Self {
+        Self { header: 4, buffer: Vec::new() }
+    }
+
+    fn expected(&self) -> Option<usize> {
+        if self.buffer.len() < self.header {
+            return None;
+        }
+        Some(
+            self.header
+                + if self.header == 2 {
+                    self.buffer[1] as usize
+                } else {
+                    u16::from_le_bytes([self.buffer[2], self.buffer[3]]) as usize
+                },
+        )
+    }
+
+    /// Takes a transfer's bytes; returns the packets they complete.
+    pub(crate) fn push(&mut self, mut data: &[u8]) -> Vec<Vec<u8>> {
+        let mut packets = Vec::new();
+        while !data.is_empty() {
+            let wanted = match self.expected() {
+                Some(total) => total - self.buffer.len(),
+                None => self.header - self.buffer.len(),
+            };
+            let taken = wanted.min(data.len());
+            self.buffer.extend_from_slice(&data[..taken]);
+            data = &data[taken..];
+            if self.expected() == Some(self.buffer.len()) {
+                packets.push(core::mem::take(&mut self.buffer));
+            }
+        }
+        packets
+    }
+
+    /// Drops a packet cut off (an endpoint stalled or was reset).
+    pub(crate) fn clear(&mut self) {
+        self.buffer.clear();
+    }
+}
