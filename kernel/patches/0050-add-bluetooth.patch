diff --git a/kernel/core/src/device/misc/rfkill.rs b/kernel/core/src/device/misc/rfkill.rs
new file mode 100755
index 0000000..766f373
--- /dev/null
+++ b/kernel/core/src/device/misc/rfkill.rs
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! `/dev/rfkill`: the radio switches (`aster-rfkill`). Reading gives the
+//! switches there are, then each change, as Linux's `struct rfkill_event`;
+//! writing one blocks or unblocks a switch, or every switch of a type. The
+//! session's person may, as udev's `uaccess` lets them on Debian (the
+//! Desktop's `rfkill unblock bluetooth`, airplane mode). Each switch is
+//! also `/sys/class/rfkill/rfkillN` (`name`, `type`, `soft`, `state`...),
+//! where BlueZ, NetworkManager and systemd-rfkill look a switch up.
+
+use alloc::format;
+use core::{
+    fmt::Write,
+    sync::atomic::{AtomicUsize, Ordering},
+};
+
+use aster_device::{
+    class::{self, Class, ClassDevice, ClassHandle},
+    common::{Attr, Error as AttrError},
+};
+use device_id::{DeviceId, MinorId};
+use ostd::mm::VmIo;
+use spin::Once;
+
+use crate::{
+    context::current_userspace,
+    device::{Device, DeviceType, registry::char},
+    events::IoEvents,
+    fs::{
+        devtmpfs::DevtmpfsNodeMeta,
+        file::{PerOpenFileOps, StatusFlags, mkmod},
+        vfs::{inode::FileOps, path::Path},
+    },
+    prelude::*,
+    process::signal::{PollHandle, Pollable, Pollee},
+    util::ioctl::RawIoctl,
+};
+
+/// `/dev/rfkill`'s minor number (misc devices), as on Linux.
+const RFKILL_MINOR: u32 = 242;
+/// The first form of the event (`struct rfkill_event`), what is read unless
+/// the program asks for more (`RFKILL_IOCTL_MAX_SIZE`).
+const EVENT_SIZE_V1: usize = 8;
+const RFKILL_IOCTL_NOINPUT: u32 = 0x5201;
+const RFKILL_IOCTL_MAX_SIZE: u32 = 0x4004_5202;
+
+#[derive(Debug)]
+struct RfkillDevice {
+    id: DeviceId,
+}
+
+impl Device for RfkillDevice {
+    fn type_(&self) -> DeviceType {
+        DeviceType::Char
+    }
+
+    fn id(&self) -> DeviceId {
+        self.id
+    }
+
+    fn devtmpfs_meta(&self) -> Option<DevtmpfsNodeMeta> {
+        Some(DevtmpfsNodeMeta::with_mode("rfkill", mkmod!(a+rw)).unwrap())
+    }
+
+    fn open(&self) -> Result<Box<dyn PerOpenFileOps>> {
+        let pollee = Pollee::new();
+        let notified = pollee.clone();
+        let listener = aster_rfkill::listen(Box::new(move || notified.notify(IoEvents::IN)));
+        Ok(Box::new(RfkillFile { listener, pollee, max_size: AtomicUsize::new(EVENT_SIZE_V1) }))
+    }
+}
+
+struct RfkillFile {
+    listener: Arc<aster_rfkill::Listener>,
+    pollee: Pollee,
+    max_size: AtomicUsize,
+}
+
+impl Pollable for RfkillFile {
+    fn poll(&self, mask: IoEvents, poller: Option<&mut PollHandle>) -> IoEvents {
+        self.pollee.poll_with(mask, poller, || {
+            let mut events = IoEvents::OUT;
+            if self.listener.has_events() {
+                events |= IoEvents::IN;
+            }
+            events
+        })
+    }
+}
+
+impl FileOps for RfkillFile {
+    fn read_at(&self, _offset: usize, writer: &mut VmWriter, status_flags: StatusFlags) -> Result<usize> {
+        let mut try_read = || {
+            let event = self.listener.next();
+            self.pollee.invalidate();
+            let Some(event) = event else {
+                return_errno_with_message!(Errno::EAGAIN, "no event is waiting");
+            };
+            let length = event.len().min(self.max_size.load(Ordering::Relaxed)).min(writer.avail());
+            writer.write_fallible(&mut VmReader::from(&event[..length]))?;
+            Ok(length)
+        };
+        if status_flags.contains(StatusFlags::O_NONBLOCK) {
+            try_read()
+        } else {
+            self.wait_events(IoEvents::IN, None, try_read)
+        }
+    }
+
+    fn write_at(&self, _offset: usize, reader: &mut VmReader, _status_flags: StatusFlags) -> Result<usize> {
+        let length = reader.remain();
+        let mut bytes = [0u8; aster_rfkill::EVENT_SIZE];
+        let taken = length.min(bytes.len());
+        reader.read_fallible(&mut VmWriter::from(&mut bytes[..taken])).map_err(|(error, _)| error)?;
+        aster_rfkill::request(&bytes[..taken]).map_err(|code| {
+            Error::with_message(Errno::try_from(code).unwrap_or(Errno::EINVAL), "the rfkill request is invalid")
+        })?;
+        Ok(length)
+    }
+}
+
+impl PerOpenFileOps for RfkillFile {
+    fn check_seekable(&self) -> Result<()> {
+        return_errno_with_message!(Errno::ESPIPE, "/dev/rfkill is not seekable")
+    }
+
+    fn is_offset_aware(&self) -> bool {
+        false
+    }
+
+    fn ioctl(&self, _path: &Path, raw_ioctl: RawIoctl) -> Result<i32> {
+        match raw_ioctl.cmd() {
+            RFKILL_IOCTL_NOINPUT => Ok(0),
+            RFKILL_IOCTL_MAX_SIZE => {
+                let size: u32 = current_userspace!().read_val(raw_ioctl.arg())?;
+                self.max_size.store((size as usize).clamp(EVENT_SIZE_V1, aster_rfkill::EVENT_SIZE), Ordering::Relaxed);
+                Ok(0)
+            }
+            _ => return_errno_with_message!(Errno::ENOTTY, "the rfkill ioctl is unknown"),
+        }
+    }
+}
+
+/// Linux's `rfkill` class: `/sys/class/rfkill/rfkillN`.
+struct RfkillClass;
+
+type SwitchDevice = ClassDevice<RfkillClass>;
+
+impl Class for RfkillClass {
+    const NAME: &'static str = "rfkill";
+    type Device = Arc<aster_rfkill::Switch>;
+
+    fn dev_attrs(&self) -> &'static [Attr<SwitchDevice>] {
+        ATTRS
+    }
+}
+
+/// `state` (`enum rfkill_user_states`): soft-blocked, unblocked.
+const STATE_SOFT_BLOCKED: u8 = 0;
+const STATE_UNBLOCKED: u8 = 1;
+
+fn show(w: &mut dyn Write, value: impl core::fmt::Display) -> aster_device::common::Result<()> {
+    writeln!(w, "{}", value).map_err(|_| AttrError::Format)
+}
+
+fn parse(value: &str) -> aster_device::common::Result<u8> {
+    value.trim().parse().map_err(|_| AttrError::InvalidValue)
+}
+
+const ATTRS: &[Attr<SwitchDevice>] = &[
+    Attr::ro("name", |dev, w| show(w, dev.payload().name())),
+    Attr::ro("type", |dev, w| show(w, aster_rfkill::kind::name(dev.payload().kind()))),
+    Attr::ro("index", |dev, w| show(w, dev.payload().index())),
+    // No switch keeps its state across boots, none is hard-blocked (a
+    // laptop's key reaches the drivers as their own switch).
+    Attr::ro("persistent", |_dev, w| show(w, 0)),
+    Attr::ro("hard", |_dev, w| show(w, 0)),
+    Attr::ro("hard_block_reasons", |_dev, w| show(w, "0x0")),
+    Attr::ro("claim", |_dev, w| show(w, 0)),
+    Attr::rw(
+        "soft",
+        |dev, w| show(w, dev.payload().is_blocked() as u8),
+        |dev, value| match parse(value)? {
+            blocked @ (0 | 1) => {
+                aster_rfkill::set_blocked(dev.payload(), blocked == 1);
+                Ok(())
+            }
+            _ => Err(AttrError::InvalidValue),
+        },
+    ),
+    Attr::rw(
+        "state",
+        |dev, w| {
+            let state = if dev.payload().is_blocked() { STATE_SOFT_BLOCKED } else { STATE_UNBLOCKED };
+            show(w, state)
+        },
+        |dev, value| match parse(value)? {
+            STATE_SOFT_BLOCKED => {
+                aster_rfkill::set_blocked(dev.payload(), true);
+                Ok(())
+            }
+            STATE_UNBLOCKED => {
+                aster_rfkill::set_blocked(dev.payload(), false);
+                Ok(())
+            }
+            _ => Err(AttrError::InvalidValue),
+        },
+    ),
+];
+
+static CLASS: Once<Arc<ClassHandle<RfkillClass>>> = Once::new();
+
+/// A switch came (`added`) or went: its sysfs directory follows.
+fn switch_changed(switch: &Arc<aster_rfkill::Switch>, added: bool) {
+    let Some(class) = CLASS.get() else { return };
+    let name = format!("rfkill{}", switch.index());
+    if added {
+        let device = SwitchDevice::builder(class, name.clone(), switch.clone()).build();
+        if let Err(error) = aster_device::add_device(&device) {
+            warn!("rfkill: could not add {}: {:?}", name, error);
+        }
+    } else if let Some(device) = class.find_device(&name) {
+        let _ = aster_device::remove_device(&device);
+    }
+}
+
+pub(super) fn init_in_first_kthread() {
+    let major = super::MISC_MAJOR.get().unwrap().get();
+    let id = DeviceId::new(major, MinorId::new(RFKILL_MINOR));
+    char::register(Arc::new(RfkillDevice { id })).unwrap();
+    match class::register(RfkillClass) {
+        Ok(class) => {
+            CLASS.call_once(|| class);
+            aster_rfkill::set_hook(Arc::new(switch_changed));
+        }
+        Err(error) => warn!("rfkill: no /sys/class/rfkill: {:?}", error),
+    }
+}
diff --git a/kernel/core/src/device/misc/uhid.rs b/kernel/core/src/device/misc/uhid.rs
new file mode 100755
index 0000000..4b80eb0
--- /dev/null
+++ b/kernel/core/src/device/misc/uhid.rs
@@ -0,0 +1,226 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! `/dev/uhid`: HID devices a program drives, as Linux's `uhid`. bluetoothd
+//! makes one for each Bluetooth keyboard or mouse (classic HID and HID over
+//! GATT): it writes the device's report descriptor (`UHID_CREATE2`), then
+//! each report the device sends (`UHID_INPUT2`), and the kernel reads them
+//! as the USB HID class does (`aster_input::hid`), into the same keyboard
+//! and mouse. The program reads that the device started and is open.
+
+use aster_input::{hid, hid_input};
+use device_id::{DeviceId, MinorId};
+
+use crate::{
+    device::{Device, DeviceType, registry::char},
+    events::IoEvents,
+    fs::{
+        devtmpfs::DevtmpfsNodeMeta,
+        file::{PerOpenFileOps, StatusFlags},
+        vfs::inode::FileOps,
+    },
+    prelude::*,
+    process::signal::{PollHandle, Pollable, Pollee},
+};
+
+/// `/dev/uhid`'s minor number (misc devices), as on Linux.
+const UHID_MINOR: u32 = 239;
+
+/// `struct uhid_event`: its type, then its requests' union (the largest,
+/// `uhid_create2_req`, padded to 8 bytes).
+const EVENT_SIZE: usize = 4 + 4376;
+
+// Event types.
+const LEGACY_CREATE: u32 = 0;
+const DESTROY: u32 = 1;
+const START: u32 = 2;
+const OPEN: u32 = 4;
+const LEGACY_INPUT: u32 = 8;
+const GET_REPORT_REPLY: u32 = 10;
+const CREATE2: u32 = 11;
+const INPUT2: u32 = 12;
+const SET_REPORT_REPLY: u32 = 14;
+
+/// Offsets in `uhid_create2_req` (after the type): the descriptor's size,
+/// then the descriptor.
+const CREATE2_RD_SIZE: usize = 4 + 256;
+const CREATE2_RD_DATA: usize = 4 + 276;
+const MAX_DESCRIPTOR: usize = 4096;
+
+#[derive(Debug)]
+struct UhidDevice {
+    id: DeviceId,
+}
+
+impl Device for UhidDevice {
+    fn type_(&self) -> DeviceType {
+        DeviceType::Char
+    }
+
+    fn id(&self) -> DeviceId {
+        self.id
+    }
+
+    fn devtmpfs_meta(&self) -> Option<DevtmpfsNodeMeta> {
+        Some(DevtmpfsNodeMeta::new("uhid").unwrap())
+    }
+
+    fn open(&self) -> Result<Box<dyn PerOpenFileOps>> {
+        Ok(Box::new(UhidFile { state: SpinLock::new(State::default()), pollee: Pollee::new() }))
+    }
+}
+
+#[derive(Default)]
+struct State {
+    created: Option<Created>,
+    /// Events for the program to read.
+    queue: VecDeque<Vec<u8>>,
+}
+
+struct Created {
+    descriptor: hid::ReportDescriptor,
+    /// Controls held, per report ID.
+    pressed: BTreeMap<u8, Vec<u32>>,
+}
+
+impl Created {
+    /// What it held is let go (the device went).
+    fn release(&mut self) {
+        for held in core::mem::take(&mut self.pressed).values() {
+            hid_input::report(held, &[], &[]);
+        }
+    }
+}
+
+struct UhidFile {
+    state: SpinLock<State>,
+    pollee: Pollee,
+}
+
+impl UhidFile {
+    fn queue(&self, kind: u32) {
+        let mut event = vec![0u8; EVENT_SIZE];
+        event[..4].copy_from_slice(&kind.to_ne_bytes());
+        self.state.lock().queue.push_back(event);
+        self.pollee.notify(IoEvents::IN);
+    }
+
+    fn input(&self, report: &[u8]) {
+        let mut state = self.state.lock();
+        let Some(created) = state.created.as_mut() else { return };
+        if let Some(report) = created.descriptor.decode(report) {
+            let before = created.pressed.insert(report.report_id, report.pressed.clone()).unwrap_or_default();
+            hid_input::report(&before, &report.pressed, &report.relative);
+        }
+    }
+}
+
+impl Pollable for UhidFile {
+    fn poll(&self, mask: IoEvents, poller: Option<&mut PollHandle>) -> IoEvents {
+        self.pollee.poll_with(mask, poller, || {
+            let mut events = IoEvents::OUT;
+            if !self.state.lock().queue.is_empty() {
+                events |= IoEvents::IN;
+            }
+            events
+        })
+    }
+}
+
+impl FileOps for UhidFile {
+    fn read_at(&self, _offset: usize, writer: &mut VmWriter, status_flags: StatusFlags) -> Result<usize> {
+        let mut try_read = || {
+            let event = self.state.lock().queue.pop_front();
+            self.pollee.invalidate();
+            let Some(event) = event else {
+                return_errno_with_message!(Errno::EAGAIN, "no event is waiting");
+            };
+            let length = event.len().min(writer.avail());
+            writer.write_fallible(&mut VmReader::from(&event[..length]))?;
+            Ok(length)
+        };
+        if status_flags.contains(StatusFlags::O_NONBLOCK) {
+            try_read()
+        } else {
+            self.wait_events(IoEvents::IN, None, try_read)
+        }
+    }
+
+    fn write_at(&self, _offset: usize, reader: &mut VmReader, _status_flags: StatusFlags) -> Result<usize> {
+        let length = reader.remain();
+        if length < 4 {
+            return_errno_with_message!(Errno::EINVAL, "the event has no type");
+        }
+        let mut event = vec![0u8; EVENT_SIZE];
+        let taken = length.min(EVENT_SIZE);
+        reader.read_fallible(&mut VmWriter::from(&mut event[..taken])).map_err(|(error, _)| error)?;
+        let le16 = |at: usize| u16::from_ne_bytes([event[at], event[at + 1]]) as usize;
+        match u32::from_ne_bytes(event[..4].try_into().unwrap()) {
+            CREATE2 => {
+                let size = le16(CREATE2_RD_SIZE).min(MAX_DESCRIPTOR);
+                let Some(descriptor) = hid::parse(&event[CREATE2_RD_DATA..CREATE2_RD_DATA + size]) else {
+                    return_errno_with_message!(Errno::EINVAL, "the report descriptor is not understood");
+                };
+                {
+                    let mut state = self.state.lock();
+                    if state.created.is_some() {
+                        return_errno_with_message!(Errno::EALREADY, "the device exists");
+                    }
+                    state.created = Some(Created { descriptor, pressed: BTreeMap::new() });
+                }
+                // The keyboard and mouse the reports go to.
+                hid_input::init();
+                let end = event[4..132].iter().position(|byte| *byte == 0).unwrap_or(128);
+                info!("uhid: {}", core::str::from_utf8(&event[4..4 + end]).unwrap_or("a HID device"));
+                // Started, and open: input is always read.
+                self.queue(START);
+                self.queue(OPEN);
+            }
+            LEGACY_CREATE => return_errno_with_message!(Errno::EINVAL, "the old create request is not served"),
+            INPUT2 => {
+                let size = le16(4).min(4096);
+                self.input(&event[6..6 + size]);
+            }
+            // `uhid_input_req`: the data, then its size.
+            LEGACY_INPUT => {
+                let size = le16(4 + 4096).min(4096);
+                self.input(&event[4..4 + size]);
+            }
+            DESTROY => {
+                if let Some(mut created) = self.state.lock().created.take() {
+                    created.release();
+                }
+            }
+            GET_REPORT_REPLY | SET_REPORT_REPLY => {}
+            _ => return_errno_with_message!(Errno::EINVAL, "the event type is unknown"),
+        }
+        Ok(length)
+    }
+}
+
+impl PerOpenFileOps for UhidFile {
+    fn check_seekable(&self) -> Result<()> {
+        return_errno_with_message!(Errno::ESPIPE, "/dev/uhid is not seekable")
+    }
+
+    fn is_offset_aware(&self) -> bool {
+        false
+    }
+
+    fn writes_whole_messages(&self) -> bool {
+        true
+    }
+}
+
+impl Drop for UhidFile {
+    fn drop(&mut self) {
+        if let Some(mut created) = self.state.get_mut().created.take() {
+            created.release();
+        }
+    }
+}
+
+pub(super) fn init_in_first_kthread() {
+    let major = super::MISC_MAJOR.get().unwrap().get();
+    let id = DeviceId::new(major, MinorId::new(UHID_MINOR));
+    char::register(Arc::new(UhidDevice { id })).unwrap();
+}
diff --git a/kernel/core/src/device/misc/vhci.rs b/kernel/core/src/device/misc/vhci.rs
new file mode 100755
index 0000000..c157627
--- /dev/null
+++ b/kernel/core/src/device/misc/vhci.rs
@@ -0,0 +1,193 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! `/dev/vhci`: a Bluetooth controller made by a program (BlueZ's
+//! emulator, `btvirt`, and its tests). The program writes a create request
+//! (`HCI_VENDOR_PKT`, then the kind) and reads back the controller's index;
+//! then it reads the commands and data the stack sends, and writes the
+//! events and data a controller would send, each packet whole with its
+//! type first, as Linux's `hci_vhci` driver takes them. Closing the file
+//! removes the controller.
+
+use aster_bluetooth::{Controller, Driver, bus, hci};
+use device_id::{DeviceId, MinorId};
+
+use crate::{
+    device::{Device, DeviceType, registry::char},
+    events::IoEvents,
+    fs::{
+        devtmpfs::DevtmpfsNodeMeta,
+        file::{PerOpenFileOps, StatusFlags},
+        vfs::inode::FileOps,
+    },
+    prelude::*,
+    process::signal::{PollHandle, Pollable, Pollee},
+};
+
+/// `/dev/vhci`'s minor number (misc devices), as on Linux.
+const VHCI_MINOR: u32 = 137;
+/// The most packets waiting for the program before they are dropped.
+const QUEUE_PACKETS: usize = 512;
+
+#[derive(Debug)]
+struct VhciDevice {
+    id: DeviceId,
+}
+
+impl Device for VhciDevice {
+    fn type_(&self) -> DeviceType {
+        DeviceType::Char
+    }
+
+    fn id(&self) -> DeviceId {
+        self.id
+    }
+
+    fn devtmpfs_meta(&self) -> Option<DevtmpfsNodeMeta> {
+        Some(DevtmpfsNodeMeta::new("vhci").unwrap())
+    }
+
+    fn open(&self) -> Result<Box<dyn PerOpenFileOps>> {
+        Ok(Box::new(VhciFile {
+            shared: Arc::new(Shared { queue: SpinLock::new(VecDeque::new()), pollee: Pollee::new() }),
+            controller: SpinLock::new(None),
+        }))
+    }
+}
+
+/// What the stack sends the program, waiting to be read.
+struct Shared {
+    queue: SpinLock<VecDeque<Vec<u8>>>,
+    pollee: Pollee,
+}
+
+impl Shared {
+    fn push(&self, packet: Vec<u8>) {
+        {
+            let mut queue = self.queue.lock();
+            if queue.len() >= QUEUE_PACKETS {
+                return;
+            }
+            queue.push_back(packet);
+        }
+        self.pollee.notify(IoEvents::IN);
+    }
+}
+
+/// The controller's transport, for the stack: packets go to the program.
+struct VhciDriver(Arc<Shared>);
+
+impl Driver for VhciDriver {
+    fn send(&self, packet_type: u8, packet: &[u8]) -> bool {
+        let mut bytes = Vec::with_capacity(1 + packet.len());
+        bytes.push(packet_type);
+        bytes.extend_from_slice(packet);
+        self.0.push(bytes);
+        true
+    }
+
+    fn bus(&self) -> u8 {
+        bus::VIRTUAL
+    }
+}
+
+struct VhciFile {
+    shared: Arc<Shared>,
+    controller: SpinLock<Option<Arc<Controller>>>,
+}
+
+impl Pollable for VhciFile {
+    fn poll(&self, mask: IoEvents, poller: Option<&mut PollHandle>) -> IoEvents {
+        self.shared.pollee.poll_with(mask, poller, || {
+            let mut events = IoEvents::OUT;
+            if !self.shared.queue.lock().is_empty() {
+                events |= IoEvents::IN;
+            }
+            events
+        })
+    }
+}
+
+impl FileOps for VhciFile {
+    fn read_at(&self, _offset: usize, writer: &mut VmWriter, status_flags: StatusFlags) -> Result<usize> {
+        let mut try_read = || {
+            let packet = self.shared.queue.lock().pop_front();
+            self.shared.pollee.invalidate();
+            let Some(packet) = packet else {
+                return_errno_with_message!(Errno::EAGAIN, "no packet is waiting");
+            };
+            let length = packet.len().min(writer.avail());
+            writer.write_fallible(&mut VmReader::from(&packet[..length]))?;
+            Ok(length)
+        };
+        if status_flags.contains(StatusFlags::O_NONBLOCK) {
+            try_read()
+        } else {
+            self.wait_events(IoEvents::IN, None, try_read)
+        }
+    }
+
+    fn write_at(&self, _offset: usize, reader: &mut VmReader, _status_flags: StatusFlags) -> Result<usize> {
+        let length = reader.remain();
+        if length < 2 || length > 4096 {
+            return_errno_with_message!(Errno::EINVAL, "the packet's length is invalid");
+        }
+        let mut packet = vec![0u8; length];
+        reader.read_fallible(&mut VmWriter::from(&mut packet[..])).map_err(|(error, _)| error)?;
+        match packet[0] {
+            hci::VENDOR_PKT => {
+                let opcode = packet[1];
+                // Bits 2 to 5 are reserved; only primary controllers.
+                if opcode & 0x3c != 0 || opcode & 0x03 != 0 {
+                    return_errno_with_message!(Errno::EINVAL, "only primary controllers are made");
+                }
+                let mut controller = self.controller.lock();
+                if controller.is_some() {
+                    return_errno_with_message!(Errno::EBADFD, "the controller is already made");
+                }
+                let made = aster_bluetooth::register(Arc::new(VhciDriver(self.shared.clone())));
+                let index = made.index();
+                *controller = Some(made);
+                drop(controller);
+                let mut answer = vec![hci::VENDOR_PKT, opcode];
+                answer.extend_from_slice(&index.to_le_bytes());
+                self.shared.push(answer);
+            }
+            hci::EVENT_PKT | hci::ACL_PKT | hci::SCO_PKT | hci::ISO_PKT => {
+                let Some(controller) = self.controller.lock().clone() else {
+                    return_errno_with_message!(Errno::ENODEV, "no controller is made yet");
+                };
+                controller.receive(packet[0], &packet[1..]);
+            }
+            _ => return_errno_with_message!(Errno::EINVAL, "the packet type is unknown"),
+        }
+        Ok(length)
+    }
+}
+
+impl PerOpenFileOps for VhciFile {
+    fn check_seekable(&self) -> Result<()> {
+        return_errno_with_message!(Errno::ESPIPE, "/dev/vhci is not seekable")
+    }
+
+    fn is_offset_aware(&self) -> bool {
+        false
+    }
+
+    fn writes_whole_messages(&self) -> bool {
+        true
+    }
+}
+
+impl Drop for VhciFile {
+    fn drop(&mut self) {
+        if let Some(controller) = self.controller.get_mut().take() {
+            controller.unregister();
+        }
+    }
+}
+
+pub(super) fn init_in_first_kthread() {
+    let major = super::MISC_MAJOR.get().unwrap().get();
+    let id = DeviceId::new(major, MinorId::new(VHCI_MINOR));
+    char::register(Arc::new(VhciDevice { id })).unwrap();
+}
