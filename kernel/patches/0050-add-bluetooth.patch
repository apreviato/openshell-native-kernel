+// SPDX-License-Identifier: MPL-2.0
+
+//! LE Secure Connections' cryptography, as the Core specification gives
+//! it (Vol 3, Part H, 2.2): P-256 key pairs and their shared secret (the
+//! DHKey), and the AES-CMAC functions: `f4` (confirm values), `f5` (the
+//! MacKey and the long-term key), `f6` (DHKey checks), `g2` (the number
+//! people compare). Values are as SMP sends them, least significant byte
+//! first.
+
+use aes::{Aes128, BlockEncrypt, NewBlockCipher};
+use p256::{
+    AffinePoint, EncodedPoint, FieldBytes, ProjectivePoint, Scalar,
+    elliptic_curve::{
+        PrimeField,
+        sec1::{FromEncodedPoint, ToEncodedPoint},
+    },
+};
+
+fn reversed<const N: usize>(bytes: &[u8; N]) -> [u8; N] {
+    let mut out = *bytes;
+    out.reverse();
+    out
+}
+
+/// AES-CMAC (RFC 4493), most significant byte first.
+fn cmac(key: &[u8; 16], message: &[u8]) -> [u8; 16] {
+    let cipher = Aes128::new(&(*key).into());
+    let encrypt = |block: &mut [u8; 16]| {
+        let mut state = (*block).into();
+        cipher.encrypt_block(&mut state);
+        block.copy_from_slice(&state);
+    };
+    let double = |block: &[u8; 16]| {
+        let mut out = [0u8; 16];
+        for i in 0..16 {
+            out[i] = (block[i] << 1) | block.get(i + 1).map_or(0, |next| next >> 7);
+        }
+        if block[0] & 0x80 != 0 {
+            out[15] ^= 0x87;
+        }
+        out
+    };
+    let mut l = [0u8; 16];
+    encrypt(&mut l);
+    let k1 = double(&l);
+    let k2 = double(&k1);
+    let blocks = message.len().div_ceil(16).max(1);
+    let mut x = [0u8; 16];
+    for block in message.chunks(16).take(blocks - 1) {
+        x.iter_mut().zip(block).for_each(|(x, byte)| *x ^= byte);
+        encrypt(&mut x);
+    }
+    let tail = &message[(blocks - 1) * 16..];
+    let mut last = [0u8; 16];
+    last[..tail.len()].copy_from_slice(tail);
+    if tail.len() == 16 {
+        last.iter_mut().zip(k1).for_each(|(byte, k)| *byte ^= k);
+    } else {
+        last[tail.len()] = 0x80;
+        last.iter_mut().zip(k2).for_each(|(byte, k)| *byte ^= k);
+    }
+    x.iter_mut().zip(last).for_each(|(x, byte)| *x ^= byte);
+    encrypt(&mut x);
+    x
+}
+
+/// `f4`: a confirm value, from the public keys' X, a nonce and `z`.
+pub(crate) fn f4(u: &[u8; 32], v: &[u8; 32], x: &[u8; 16], z: u8) -> [u8; 16] {
+    let mut message = [0u8; 65];
+    message[..32].copy_from_slice(&reversed(u));
+    message[32..64].copy_from_slice(&reversed(v));
+    message[64] = z;
+    reversed(&cmac(&reversed(x), &message))
+}
+
+/// `f5`: the MacKey and the long-term key, from the DHKey, the nonces and
+/// the addresses (each its 6 bytes, then its type).
+pub(crate) fn f5(w: &[u8; 32], n1: &[u8; 16], n2: &[u8; 16], a1: &[u8; 7], a2: &[u8; 7]) -> ([u8; 16], [u8; 16]) {
+    const SALT: [u8; 16] = [0x6c, 0x88, 0x83, 0x91, 0xaa, 0xf5, 0xa5, 0x38, 0x60, 0x37, 0x0b, 0xdb, 0x5a, 0x60, 0x83, 0xbe];
+    let t = cmac(&SALT, &reversed(w));
+    let mut message = [0u8; 53];
+    // The counter, "btle", the nonces, the addresses, 256 bits.
+    message[1..5].copy_from_slice(b"btle");
+    message[5..21].copy_from_slice(&reversed(n1));
+    message[21..37].copy_from_slice(&reversed(n2));
+    message[37..44].copy_from_slice(&reversed(a1));
+    message[44..51].copy_from_slice(&reversed(a2));
+    message[51..53].copy_from_slice(&[0x01, 0x00]);
+    let mackey = cmac(&t, &message);
+    message[0] = 1;
+    let ltk = cmac(&t, &message);
+    (reversed(&mackey), reversed(&ltk))
+}
+
+/// `f6`: a DHKey check, from the MacKey, the nonces, `r`, the IO
+/// capabilities (as the pairing PDU has them) and the addresses.
+pub(crate) fn f6(w: &[u8; 16], n1: &[u8; 16], n2: &[u8; 16], r: &[u8; 16], io_cap: &[u8; 3], a1: &[u8; 7], a2: &[u8; 7]) -> [u8; 16] {
+    let mut message = [0u8; 65];
+    message[..16].copy_from_slice(&reversed(n1));
+    message[16..32].copy_from_slice(&reversed(n2));
+    message[32..48].copy_from_slice(&reversed(r));
+    message[48..51].copy_from_slice(&reversed(io_cap));
+    message[51..58].copy_from_slice(&reversed(a1));
+    message[58..65].copy_from_slice(&reversed(a2));
+    reversed(&cmac(&reversed(w), &message))
+}
+
+/// `g2`: the six digits both sides show (numeric comparison).
+pub(crate) fn g2(u: &[u8; 32], v: &[u8; 32], x: &[u8; 16], y: &[u8; 16]) -> u32 {
+    let mut message = [0u8; 80];
+    message[..32].copy_from_slice(&reversed(u));
+    message[32..64].copy_from_slice(&reversed(v));
+    message[64..].copy_from_slice(&reversed(y));
+    let out = cmac(&reversed(x), &message);
+    u32::from_be_bytes(out[12..].try_into().unwrap()) % 1_000_000
+}
+
+/// `h6`: a key from a key and a 4-byte key id (cross-transport keys).
+pub(crate) fn h6(w: &[u8; 16], key_id: &[u8; 4]) -> [u8; 16] {
+    reversed(&cmac(&reversed(w), &reversed(key_id)))
+}
+
+/// `h7`: a key from a salt and a key (cross-transport keys, CT2).
+pub(crate) fn h7(salt: &[u8; 16], w: &[u8; 16]) -> [u8; 16] {
+    reversed(&cmac(&reversed(salt), &reversed(w)))
+}
+
+/// The BR/EDR link key an LE long-term key gives (`ct2`: the device takes
+/// `h7`): through the intermediate key `tmp1`, then `lebr`.
+pub(crate) fn link_key_of(ltk: &[u8; 16], ct2: bool) -> [u8; 16] {
+    // "tmp1" and "lebr", least significant byte first.
+    const TMP1: [u8; 4] = [0x31, 0x70, 0x6d, 0x74];
+    const LEBR: [u8; 4] = [0x72, 0x62, 0x65, 0x6c];
+    let ilk = if ct2 {
+        let mut salt = [0u8; 16];
+        salt[..4].copy_from_slice(&TMP1);
+        h7(&salt, ltk)
+    } else {
+        h6(ltk, &TMP1)
+    };
+    h6(&ilk, &LEBR)
+}
+
+/// A P-256 key pair: the private key, the public key as SMP sends it (X,
+/// then Y).
+#[derive(Clone)]
+pub(crate) struct KeyPair {
+    secret: [u8; 32],
+    pub(crate) public: [u8; 64],
+}
+
+impl core::fmt::Debug for KeyPair {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.debug_struct("KeyPair").finish_non_exhaustive()
+    }
+}
+
+fn scalar(bytes: &[u8; 32]) -> Option<Scalar> {
+    Option::from(Scalar::from_repr(FieldBytes::from(*bytes))).filter(|_| *bytes != [0; 32])
+}
+
+/// The public key of a private one (most significant byte first).
+pub(crate) fn key_pair_of(secret: [u8; 32]) -> Option<KeyPair> {
+    let point = (ProjectivePoint::GENERATOR * scalar(&secret)?).to_affine();
+    let encoded = point.to_encoded_point(false);
+    let mut public = [0u8; 64];
+    public[..32].copy_from_slice(encoded.x()?);
+    public[..32].reverse();
+    public[32..].copy_from_slice(encoded.y()?);
+    public[32..].reverse();
+    Some(KeyPair { secret, public })
+}
+
+/// A new key pair, from random bytes.
+pub(crate) fn key_pair(mut random: impl FnMut() -> [u8; 32]) -> KeyPair {
+    loop {
+        if let Some(pair) = key_pair_of(random()) {
+            return pair;
+        }
+    }
+}
+
+/// The DHKey with the device's public key, if it is a point of the curve.
+pub(crate) fn dhkey(pair: &KeyPair, theirs: &[u8; 64]) -> Option<[u8; 32]> {
+    let mut x: [u8; 32] = theirs[..32].try_into().unwrap();
+    let mut y: [u8; 32] = theirs[32..].try_into().unwrap();
+    x.reverse();
+    y.reverse();
+    let encoded = EncodedPoint::from_affine_coordinates(&x.into(), &y.into(), false);
+    let point: AffinePoint = Option::from(AffinePoint::from_encoded_point(&encoded))?;
+    let shared = (ProjectivePoint::from(point) * scalar(&pair.secret)?).to_affine();
+    let encoded = shared.to_encoded_point(false);
+    let mut key: [u8; 32] = (*encoded.x()?).into();
+    key.reverse();
+    Some(key)
+}
diff --git a/kernel/comps/bluetooth/src/sco.rs b/kernel/comps/bluetooth/src/sco.rs
new file mode 100755
index 0000000..3c040fc
--- /dev/null
+++ b/kernel/comps/bluetooth/src/sco.rs
@@ -0,0 +1,534 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! SCO and eSCO links (voice: a headset's microphone, calls), as Linux's
+//! `sco.c` and `hci_conn.c` make them for sockets. A socket connects to a
+//! device: its ACL link first, then the controller's synchronous link,
+//! with Linux's parameter sets (eSCO S3 down to D0 for CVSD, T2 and T1 for
+//! the transparent air mode mSBC wants, plain SCO on a controller without
+//! eSCO), tried down the list when the device refuses one. A listener
+//! takes the device's, when the program reads with `BT_DEFER_SETUP` (as
+//! the audio servers have it). Voice frames go each way in SCO packets of
+//! the controller's size.
+
+use alloc::{
+    sync::{Arc, Weak},
+    vec::Vec,
+};
+
+use ostd::sync::{LocalIrqDisabled, SpinLock};
+
+use crate::{
+    device::Device,
+    device_at, hci, l2cap,
+    link::{self, Action},
+    mgmt::ADDR_BREDR,
+    proto::{self, Address, BDADDR_BREDR, Phase, ProtoSocket, Protocol},
+};
+
+/// Voice settings' air mode (`SCO_AIRMODE_*`).
+const AIRMODE_MASK: u16 = 0x0003;
+const AIRMODE_TRANSPARENT: u16 = 0x0003;
+
+/// eSCO packet types (`ESCO_*`): the EDR ones are "do not use" bits.
+const ESCO_HV1: u16 = 0x0001;
+const ESCO_HV2: u16 = 0x0002;
+const ESCO_HV3: u16 = 0x0004;
+const ESCO_EV3: u16 = 0x0008;
+const ESCO_2EV3: u16 = 0x0040;
+const ESCO_3EV3: u16 = 0x0080;
+const ESCO_2EV5: u16 = 0x0100;
+const ESCO_3EV5: u16 = 0x0200;
+const EDR_ESCO_MASK: u16 = ESCO_2EV3 | ESCO_3EV3 | ESCO_2EV5 | ESCO_3EV5;
+/// SCO packet types on an ACL-style controller (`HCI_HV*`, for Add SCO).
+const HCI_HV1: u16 = 0x0020;
+const HCI_HV2: u16 = 0x0040;
+const HCI_HV3: u16 = 0x0080;
+
+/// A parameter set: packet types, the most latency, the retransmission
+/// effort.
+struct Params(u16, u16, u8);
+
+/// Linux's sets: eSCO for CVSD (S3, S2, S1, D1, D0), SCO for CVSD (D1,
+/// D0), eSCO for transparent data (T2, T1).
+const ESCO_CVSD: [Params; 5] = [
+    Params(EDR_ESCO_MASK & !ESCO_2EV3, 0x000a, 0x01),
+    Params(EDR_ESCO_MASK & !ESCO_2EV3, 0x0007, 0x01),
+    Params(EDR_ESCO_MASK | ESCO_EV3, 0x0007, 0x01),
+    Params(EDR_ESCO_MASK | ESCO_HV3, 0xffff, 0x01),
+    Params(EDR_ESCO_MASK | ESCO_HV1, 0xffff, 0x01),
+];
+const SCO_CVSD: [Params; 2] = [
+    Params(EDR_ESCO_MASK | ESCO_HV3, 0xffff, 0xff),
+    Params(EDR_ESCO_MASK | ESCO_HV1, 0xffff, 0xff),
+];
+const ESCO_TRANSPARENT: [Params; 2] = [
+    Params(EDR_ESCO_MASK & !ESCO_2EV3, 0x000d, 0x02),
+    Params(EDR_ESCO_MASK | ESCO_EV3, 0x0008, 0x02),
+];
+/// Each direction's bandwidth: 8000 bytes a second.
+const BANDWIDTH: u32 = 0x0000_1f40;
+/// The packet size when the controller does not say (Linux's).
+const DEFAULT_MTU: u16 = 60;
+
+/// Statuses after which the next parameter set is tried.
+const RETRY_STATUSES: [u8; 4] = [0x1a, 0x1e, 0x1f, 0x20];
+
+const EOPNOTSUPP: i32 = 95;
+const EHOSTUNREACH: i32 = 113;
+const ENOTCONN: i32 = 107;
+const EINVAL: i32 = 22;
+const ECONNRESET: i32 = 104;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Stage {
+    /// Ours: the ACL link is being made.
+    WaitAcl,
+    /// Ours: the controller sets the link up.
+    WaitSetup,
+    /// The device's: the program has yet to take it (`BT_DEFER_SETUP`).
+    Deferred,
+    /// The device's: accepted, the controller sets it up.
+    WaitAccept,
+    Open,
+}
+
+/// A socket's synchronous link.
+#[derive(Clone, Debug)]
+pub(crate) struct Sco {
+    pub(crate) device: u16,
+    pub(crate) address: [u8; 6],
+    /// The synchronous link once up; the ACL link it goes with.
+    pub(crate) handle: u16,
+    pub(crate) acl: u16,
+    pub(crate) stage: Stage,
+    /// The parameter set tried last (from 1, as Linux counts).
+    attempt: u8,
+    pub(crate) mtu: u16,
+}
+
+/// The device's links not yet handed to their listener, with it.
+static PENDING: SpinLock<Vec<(Arc<ProtoSocket>, Weak<ProtoSocket>)>, LocalIrqDisabled> = SpinLock::new(Vec::new());
+
+fn esco_capable(device: &Device) -> bool {
+    device.state.lock().info.features[3] & 0x80 != 0
+}
+
+fn transparent_capable(device: &Device) -> bool {
+    device.state.lock().info.features[2] & 0x08 != 0
+}
+
+fn mtu_of(device: &Device) -> u16 {
+    match device.state.lock().info.sco_mtu {
+        0 => DEFAULT_MTU,
+        mtu => mtu,
+    }
+}
+
+/// The SCO packet types the controller sends on a plain SCO link (Add SCO).
+fn sco_packet_types(device: &Device) -> u16 {
+    let features = device.state.lock().info.features;
+    let mut types = HCI_HV1;
+    if features[1] & 0x10 != 0 {
+        types |= HCI_HV2;
+    }
+    if features[1] & 0x20 != 0 {
+        types |= HCI_HV3;
+    }
+    types
+}
+
+/// The eSCO packet types it accepts a device's link with (Linux's
+/// `esco_type`, EDR ones it lacks marked "do not use").
+fn esco_packet_types(device: &Device) -> u16 {
+    let features = device.state.lock().info.features;
+    let mut types = ESCO_HV1;
+    if features[1] & 0x10 != 0 {
+        types |= ESCO_HV2;
+    }
+    if features[1] & 0x20 != 0 {
+        types |= ESCO_HV3;
+    }
+    if features[3] & 0x80 != 0 {
+        types |= ESCO_EV3;
+    }
+    if features[5] & 0x20 == 0 {
+        types |= ESCO_2EV3 | ESCO_2EV5;
+    }
+    if features[5] & 0x40 == 0 {
+        types |= ESCO_3EV3 | ESCO_3EV5;
+    }
+    types
+}
+
+fn sockets_on(device: u16) -> Vec<Arc<ProtoSocket>> {
+    let mut all: Vec<_> = proto::sockets()
+        .into_iter()
+        .filter(|socket| socket.state.lock().sco.as_ref().is_some_and(|sco| sco.device == device))
+        .collect();
+    for (child, _) in PENDING.lock().iter() {
+        if !all.iter().any(|socket| Arc::ptr_eq(socket, child)) {
+            all.push(child.clone());
+        }
+    }
+    all
+}
+
+fn find(device: u16, test: impl Fn(&Sco) -> bool) -> Option<Arc<ProtoSocket>> {
+    sockets_on(device).into_iter().find(|socket| socket.state.lock().sco.as_ref().is_some_and(&test))
+}
+
+/// Ends a socket's link.
+fn finish(socket: &Arc<ProtoSocket>, error: Option<i32>) {
+    {
+        let mut state = socket.state.lock();
+        state.sco = None;
+        state.phase = Phase::Closed;
+        state.deferred = false;
+        if error.is_some() {
+            state.error = error;
+        }
+    }
+    PENDING.lock().retain(|(child, _)| !Arc::ptr_eq(child, socket));
+    socket.wake();
+}
+
+/// A socket connects to a device (its peer set).
+pub(crate) fn connect(socket: &ProtoSocket) -> Result<(), i32> {
+    let socket = proto::arc_of(socket).ok_or(ENOTCONN)?;
+    let (local, peer, voice) = {
+        let state = socket.state.lock();
+        (state.local, state.peer, state.voice)
+    };
+    let device = l2cap::route(&local).ok_or(EHOSTUNREACH)?;
+    if voice & AIRMODE_MASK == AIRMODE_TRANSPARENT && (!transparent_capable(&device) || !esco_capable(&device)) {
+        return Err(EOPNOTSUPP);
+    }
+    let own = device.state.lock().info.address;
+    {
+        let mut state = socket.state.lock();
+        state.local.address = own;
+        state.sco = Some(Sco {
+            device: device.index,
+            address: peer.address,
+            handle: 0,
+            acl: 0,
+            stage: Stage::WaitAcl,
+            attempt: 0,
+            mtu: mtu_of(&device),
+        });
+    }
+    if link::connect(&device, peer.address, ADDR_BREDR) {
+        if let Some(acl) = link::handle_of(&device, &peer.address, false) {
+            setup(&device, &socket, acl);
+        }
+    }
+    Ok(())
+}
+
+/// The next parameter set the controller tries the link with; none left,
+/// the connection fails.
+fn setup(device: &Device, socket: &Arc<ProtoSocket>, acl: u16) {
+    let (voice, attempt) = {
+        let state = socket.state.lock();
+        let Some(sco) = state.sco.as_ref() else { return };
+        (state.voice, sco.attempt)
+    };
+    let esco = esco_capable(device);
+    if !esco {
+        // A Bluetooth 1.1 controller: plain SCO, one try.
+        if attempt > 0 {
+            return finish(socket, Some(l2cap::errno_of(0x1a)));
+        }
+        if let Some(sco) = socket.state.lock().sco.as_mut() {
+            sco.attempt = 1;
+            sco.acl = acl;
+            sco.stage = Stage::WaitSetup;
+        }
+        let mut params = acl.to_le_bytes().to_vec();
+        params.extend_from_slice(&sco_packet_types(device).to_le_bytes());
+        device.queue_action(Action::Command(hci::OP_ADD_SCO, params));
+        return;
+    }
+    // What the device's own controller has: eSCO, EDR 2 Mb/s eSCO.
+    let (remote_esco, remote_2m) = device
+        .links
+        .lock()
+        .by_handle(acl)
+        .map_or((false, false), |link| (link.remote_features[3] & 0x80 != 0, link.remote_features[5] & 0x20 != 0));
+    let table: &[Params] = if voice & AIRMODE_MASK == AIRMODE_TRANSPARENT {
+        &ESCO_TRANSPARENT
+    } else if remote_esco {
+        &ESCO_CVSD
+    } else {
+        &SCO_CVSD
+    };
+    // The sets with EDR 2 Mb/s packets want the device to have them.
+    let mut next = attempt as usize + 1;
+    while remote_esco && next <= table.len() && !remote_2m && table[next - 1].0 & ESCO_2EV3 == 0 {
+        next += 1;
+    }
+    if next > table.len() {
+        return finish(socket, Some(l2cap::errno_of(0x1a)));
+    }
+    let Params(packet_types, latency, effort) = table[next - 1];
+    if let Some(sco) = socket.state.lock().sco.as_mut() {
+        sco.attempt = next as u8;
+        sco.acl = acl;
+        sco.stage = Stage::WaitSetup;
+    }
+    let mut params = acl.to_le_bytes().to_vec();
+    params.extend_from_slice(&BANDWIDTH.to_le_bytes());
+    params.extend_from_slice(&BANDWIDTH.to_le_bytes());
+    params.extend_from_slice(&latency.to_le_bytes());
+    params.extend_from_slice(&voice.to_le_bytes());
+    params.push(effort);
+    params.extend_from_slice(&packet_types.to_le_bytes());
+    device.queue_action(Action::Command(hci::OP_SETUP_SYNC_CONN, params));
+}
+
+/// An ACL link came up: the synchronous links waiting for it go on.
+pub(crate) fn acl_up(device: &Device, handle: u16, address: &[u8; 6]) {
+    let waiting: Vec<_> = sockets_on(device.index)
+        .into_iter()
+        .filter(|socket| socket.state.lock().sco.as_ref().is_some_and(|sco| sco.address == *address && sco.stage == Stage::WaitAcl))
+        .collect();
+    for socket in waiting {
+        setup(device, &socket, handle);
+    }
+}
+
+/// An ACL link could not be made, or went: its synchronous links end.
+pub(crate) fn acl_down(device: &Device, address: &[u8; 6], error: i32) {
+    for socket in sockets_on(device.index) {
+        let on = socket.state.lock().sco.as_ref().is_some_and(|sco| sco.address == *address);
+        if on {
+            finish(&socket, Some(error));
+        }
+    }
+}
+
+/// Whether an ACL link carries (or waits to carry) a synchronous one.
+pub(crate) fn uses_acl(device: u16, address: &[u8; 6]) -> bool {
+    find(device, |sco| sco.address == *address).is_some()
+}
+
+/// The device asks for a synchronous link (`link_type` SCO or eSCO): a
+/// listener's (bound to the controller or to any), else refused.
+pub(crate) fn connection_request(device: &Device, address: [u8; 6], link_type: u8) {
+    let own = device.state.lock().info.address;
+    let listener = proto::sockets().into_iter().find(|socket| {
+        let state = socket.state.lock();
+        socket.protocol == Protocol::Sco
+            && state.phase == Phase::Listening
+            && (state.local.address == [0; 6] || state.local.address == own)
+    });
+    let esco = esco_capable(device);
+    let Some(listener) = listener else {
+        // Limited resources, as Linux refuses it.
+        let mut params = address.to_vec();
+        params.push(0x0d);
+        let opcode = if esco && link_type != 0x01 { hci::OP_REJECT_SYNC_CONN_REQ } else { hci::OP_REJECT_CONN_REQ };
+        device.queue_action(Action::Command(opcode, params));
+        return;
+    };
+    let (defer, voice) = {
+        let state = listener.state.lock();
+        (state.defer_setup, state.voice)
+    };
+    let child = listener.child();
+    {
+        let mut state = child.state.lock();
+        state.local.address = own;
+        state.local.address_type = BDADDR_BREDR;
+        state.peer = Address { address, address_type: BDADDR_BREDR, psm: 0, cid: 0, channel: 0 };
+        state.voice = voice;
+        state.deferred = defer;
+        state.phase = Phase::Connecting;
+        state.sco = Some(Sco {
+            device: device.index,
+            address,
+            handle: 0,
+            acl: link::handle_of(device, &address, false).unwrap_or(0),
+            stage: if defer { Stage::Deferred } else { Stage::WaitAccept },
+            attempt: 0,
+            mtu: mtu_of(device),
+        });
+    }
+    if defer {
+        // The program decides, when it reads.
+        if !listener.offer(child.clone()) {
+            child.state.lock().sco = None;
+            let mut params = address.to_vec();
+            params.push(0x0d);
+            device.queue_action(Action::Command(hci::OP_REJECT_SYNC_CONN_REQ, params));
+        }
+        return;
+    }
+    PENDING.lock().push((child.clone(), Arc::downgrade(&listener)));
+    accept(device, &child);
+}
+
+/// Accepts the device's link, with the socket's voice setting.
+fn accept(device: &Device, socket: &Arc<ProtoSocket>) {
+    let (address, voice) = {
+        let mut state = socket.state.lock();
+        let voice = state.voice;
+        let Some(sco) = state.sco.as_mut() else { return };
+        sco.stage = Stage::WaitAccept;
+        (sco.address, voice)
+    };
+    let mut params = address.to_vec();
+    if !esco_capable(device) {
+        // Plain SCO: the connection request's acceptance (the role is
+        // ignored).
+        params.push(0x00);
+        device.queue_action(Action::Command(hci::OP_ACCEPT_CONN_REQ, params));
+        return;
+    }
+    let packet_types = esco_packet_types(device);
+    let (latency, effort) = if voice & AIRMODE_MASK == AIRMODE_TRANSPARENT {
+        (if packet_types & ESCO_2EV3 != 0 { 0x0008u16 } else { 0x000d }, 0x02u8)
+    } else {
+        (0xffff, 0xff)
+    };
+    params.extend_from_slice(&BANDWIDTH.to_le_bytes());
+    params.extend_from_slice(&BANDWIDTH.to_le_bytes());
+    params.extend_from_slice(&latency.to_le_bytes());
+    params.extend_from_slice(&voice.to_le_bytes());
+    params.push(effort);
+    params.extend_from_slice(&packet_types.to_le_bytes());
+    device.queue_action(Action::Command(hci::OP_ACCEPT_SYNC_CONN_REQ, params));
+}
+
+/// The program takes a deferred link.
+pub(crate) fn accept_deferred(socket: &ProtoSocket) {
+    let Some(sco) = socket.state.lock().sco.clone() else { return };
+    if sco.stage != Stage::Deferred {
+        return;
+    }
+    let (Some(device), Some(socket)) = (device_at(sco.device), proto::arc_of(socket)) else { return };
+    accept(&device, &socket);
+}
+
+/// `Synchronous Connection Complete` (or `Connection Complete` for a plain
+/// SCO link): the link is up, or another parameter set is tried, or it
+/// failed.
+pub(crate) fn connection_complete(device: &Device, status: u8, handle: u16, address: [u8; 6]) {
+    let socket = find(device.index, |sco| sco.address == address && matches!(sco.stage, Stage::WaitSetup | Stage::WaitAccept));
+    let Some(socket) = socket else {
+        // Nobody waits for it any more.
+        if status == 0 {
+            device.queue_action(Action::Disconnect(handle, 0x13));
+        }
+        return;
+    };
+    let Some(sco) = socket.state.lock().sco.clone() else { return };
+    if status != 0 {
+        if sco.stage == Stage::WaitSetup && RETRY_STATUSES.contains(&status) {
+            setup(device, &socket, sco.acl);
+        } else {
+            finish(&socket, Some(l2cap::errno_of(status)));
+        }
+        return;
+    }
+    {
+        let mut state = socket.state.lock();
+        if let Some(stored) = state.sco.as_mut() {
+            stored.handle = handle;
+            stored.stage = Stage::Open;
+        }
+        state.phase = Phase::Connected;
+    }
+    socket.wake();
+    // The device's link goes to its listener.
+    let listener = {
+        let mut pending = PENDING.lock();
+        pending.iter().position(|(child, _)| Arc::ptr_eq(child, &socket)).map(|position| pending.remove(position).1)
+    };
+    if let Some(listener) = listener {
+        if !listener.upgrade().is_some_and(|listener| listener.offer(socket.clone())) {
+            device.queue_action(Action::Disconnect(handle, 0x13));
+            finish(&socket, None);
+        }
+    }
+}
+
+/// `Disconnection Complete` of a synchronous link: whether it was one.
+pub(crate) fn disconnected(device: &Device, handle: u16, reason: u8) -> bool {
+    let Some(socket) = find(device.index, |sco| sco.handle == handle && sco.stage == Stage::Open) else { return false };
+    finish(&socket, Some(l2cap::errno_of(reason)));
+    true
+}
+
+/// A SCO packet from the controller: the voice frame for its socket.
+pub(crate) fn receive(device: &Device, packet: &[u8]) {
+    if packet.len() < 3 {
+        return;
+    }
+    let handle = u16::from_le_bytes([packet[0], packet[1]]) & 0x0fff;
+    let length = (packet[2] as usize).min(packet.len() - 3);
+    if length == 0 {
+        return;
+    }
+    let Some(socket) = find(device.index, |sco| sco.handle == handle && sco.stage == Stage::Open) else { return };
+    {
+        let mut state = socket.state.lock();
+        // A reader that does not keep up loses the oldest frames.
+        if state.rx.len() >= 64 {
+            state.rx.pop_front();
+        }
+        state.rx.push_back(packet[3..3 + length].to_vec());
+    }
+    socket.wake();
+}
+
+/// A voice frame from the program: one SCO packet, the controller's size
+/// at most.
+pub(crate) fn send(socket: &ProtoSocket, data: &[u8]) -> Result<usize, i32> {
+    let sco = socket.state.lock().sco.clone().ok_or(ENOTCONN)?;
+    if sco.stage != Stage::Open {
+        return Err(ENOTCONN);
+    }
+    if data.len() > sco.mtu as usize || data.len() > 0xff {
+        return Err(EINVAL);
+    }
+    let device = device_at(sco.device).ok_or(ENOTCONN)?;
+    let mut packet = Vec::with_capacity(3 + data.len());
+    packet.extend_from_slice(&(sco.handle & 0x0fff).to_le_bytes());
+    packet.push(data.len() as u8);
+    packet.extend_from_slice(data);
+    if !device.send_packet(hci::SCO_PKT, &packet) {
+        return Err(ECONNRESET);
+    }
+    Ok(data.len())
+}
+
+/// The program shuts its socket's link.
+pub(crate) fn close(socket: &ProtoSocket) {
+    let sco = {
+        let mut state = socket.state.lock();
+        if matches!(state.phase, Phase::Connecting | Phase::Connected) {
+            state.phase = Phase::Closed;
+        }
+        state.deferred = false;
+        state.sco.take()
+    };
+    if let Some(sco) = sco {
+        dropped(sco);
+    }
+}
+
+/// A link whose socket is gone: it goes (a deferred one is refused).
+pub(crate) fn dropped(sco: Sco) {
+    let Some(device) = device_at(sco.device) else { return };
+    match sco.stage {
+        Stage::Open => device.queue_action(Action::Disconnect(sco.handle, 0x13)),
+        Stage::Deferred => {
+            let mut params = sco.address.to_vec();
+            params.push(0x0d);
+            device.queue_action(Action::Command(hci::OP_REJECT_SYNC_CONN_REQ, params));
+        }
+        // The controller's answer finds nobody, and the link goes then.
+        Stage::WaitAcl | Stage::WaitSetup | Stage::WaitAccept => {}
+    }
+}
diff --git a/kernel/comps/bluetooth/src/smp.rs b/kernel/comps/bluetooth/src/smp.rs
new file mode 100755
index 0000000..da53192
--- /dev/null
+++ b/kernel/comps/bluetooth/src/smp.rs
@@ -0,0 +1,1233 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The LE security manager (SMP, L2CAP channel 6), as Linux's `smp.c` runs
+//! it: pairing request and response, the method the IO capabilities give
+//! (Just Works, a passkey shown or typed, numbers compared), then the keys
+//! the devices hand each other (the long-term key bluetoothd stores, the
+//! identity key). LE Secure Connections, when both sides offer it: P-256
+//! public keys and their DHKey (`sc`), confirm values and nonces (`f4`,
+//! twenty rounds for a passkey), the DHKey checks (`f6`) and the long-term
+//! key (`f5`) that encrypts the link. Legacy pairing otherwise: confirm
+//! and random values (`c1`), the short-term key (`s1`). A link with a
+//! stored long-term key is encrypted with it again.
+
+use aes::{Aes128, BlockEncrypt, NewBlockCipher};
+use alloc::{vec, vec::Vec};
+
+use crate::{
+    device::Device,
+    hci,
+    link::{self, Action, SECURITY_FIPS, SECURITY_HIGH, SECURITY_MEDIUM},
+    l2cap::{self, CID_SMP},
+    mgmt::{self, ADDR_LE_RANDOM},
+    pairing::{self, IO_KEYBOARD_DISPLAY, IO_NO_INPUT_OUTPUT},
+    sc,
+};
+
+const PAIRING_REQUEST: u8 = 0x01;
+const PAIRING_RESPONSE: u8 = 0x02;
+const PAIRING_CONFIRM: u8 = 0x03;
+const PAIRING_RANDOM: u8 = 0x04;
+const PAIRING_FAILED: u8 = 0x05;
+const ENCRYPTION_INFORMATION: u8 = 0x06;
+const CENTRAL_IDENTIFICATION: u8 = 0x07;
+const IDENTITY_INFORMATION: u8 = 0x08;
+const IDENTITY_ADDRESS_INFORMATION: u8 = 0x09;
+const SIGNING_INFORMATION: u8 = 0x0a;
+const SECURITY_REQUEST: u8 = 0x0b;
+const PUBLIC_KEY: u8 = 0x0c;
+const DHKEY_CHECK: u8 = 0x0d;
+const KEYPRESS_NOTIFICATION: u8 = 0x0e;
+
+const AUTH_BONDING: u8 = 0x01;
+const AUTH_MITM: u8 = 0x04;
+const AUTH_SC: u8 = 0x08;
+/// The device derives cross-transport keys with `h7`.
+const AUTH_CT2: u8 = 0x20;
+/// Encryption key sizes a pairing may agree on.
+const MIN_KEY_SIZE: u8 = 7;
+const MAX_KEY_SIZE: u8 = 16;
+const DIST_ENC_KEY: u8 = 0x01;
+const DIST_ID_KEY: u8 = 0x02;
+const DIST_SIGN: u8 = 0x04;
+/// Keys Secure Connections derives instead of handing over.
+const DIST_LINK_KEY: u8 = 0x08;
+const SC_NO_DIST: u8 = DIST_ENC_KEY | DIST_LINK_KEY;
+
+/// Pairing failures.
+const PASSKEY_FAILED: u8 = 0x01;
+const AUTH_REQUIREMENTS: u8 = 0x03;
+const CONFIRM_FAILED: u8 = 0x04;
+const PAIRING_NOT_SUPPORTED: u8 = 0x05;
+const ENC_KEY_SIZE: u8 = 0x06;
+const CMD_NOT_SUPPORTED: u8 = 0x07;
+const UNSPECIFIED: u8 = 0x08;
+const INVALID_PARAMETERS: u8 = 0x0a;
+const DHKEY_CHECK_FAILED: u8 = 0x0b;
+const NUMERIC_COMPARISON_FAILED: u8 = 0x0c;
+
+/// Long-term key types (`MGMT_LTK_*`): legacy, Secure Connections; their
+/// low bit, authenticated.
+const LTK_P256_UNAUTHENTICATED: u8 = 0x02;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Method {
+    JustWorks,
+    /// Just Works, confirmed by the user.
+    JustConfirm,
+    /// The user types the passkey the device shows.
+    RequestPasskey,
+    /// We show a passkey the user types on the device.
+    ShowPasskey,
+    /// Both sides show a number the user compares (Secure Connections).
+    Compare,
+}
+
+impl Method {
+    /// Whether it guards against a man in the middle.
+    fn authenticated(self) -> bool {
+        matches!(self, Self::RequestPasskey | Self::ShowPasskey | Self::Compare)
+    }
+
+    fn is_passkey(self) -> bool {
+        matches!(self, Self::RequestPasskey | Self::ShowPasskey)
+    }
+}
+
+/// A pairing on an LE link.
+#[derive(Clone, Debug)]
+pub(crate) struct Smp {
+    initiator: bool,
+    preq: [u8; 7],
+    pres: [u8; 7],
+    tk: Option<[u8; 16]>,
+    ours: [u8; 16],
+    their_confirm: Option<[u8; 16]>,
+    their_random: Option<[u8; 16]>,
+    confirm_sent: bool,
+    method: Method,
+    stk: Option<[u8; 16]>,
+    /// The keys still to come from the device, and the ones we hand over.
+    expecting: u8,
+    giving: u8,
+    ltk: Option<[u8; 16]>,
+    irk: Option<[u8; 16]>,
+    identity: Option<([u8; 6], u8)>,
+    key_size: u8,
+    /// LE Secure Connections: our key pair, the device's public key, the
+    /// DHKey, the MacKey (with the long-term key, in `stk`).
+    sc: bool,
+    keys: Option<sc::KeyPair>,
+    remote_pk: Option<[u8; 64]>,
+    dhkey: Option<[u8; 32]>,
+    mackey: Option<[u8; 16]>,
+    /// The passkey (entry, shown or typed), and the round of the twenty.
+    passkey: Option<u32>,
+    round: u8,
+    /// Waiting for the user (to confirm, to type the passkey); the
+    /// device's confirm or DHKey check that came meanwhile.
+    waiting_user: bool,
+    confirm_pending: bool,
+    their_check: Option<[u8; 16]>,
+    /// The BR/EDR link key is derived from the long-term key (`ct2`: with
+    /// `h7`).
+    link_key: bool,
+    ct2: bool,
+}
+
+impl Smp {
+    fn new(initiator: bool, preq: [u8; 7]) -> Self {
+        Self {
+            initiator,
+            preq,
+            pres: [0; 7],
+            tk: None,
+            ours: random(),
+            their_confirm: None,
+            their_random: None,
+            confirm_sent: false,
+            method: Method::JustWorks,
+            stk: None,
+            expecting: 0,
+            giving: 0,
+            ltk: None,
+            irk: None,
+            identity: None,
+            key_size: 16,
+            sc: false,
+            keys: None,
+            remote_pk: None,
+            dhkey: None,
+            mackey: None,
+            passkey: None,
+            round: 0,
+            waiting_user: false,
+            confirm_pending: false,
+            their_check: None,
+            link_key: false,
+            ct2: false,
+        }
+    }
+
+    /// Both asked for bonding: the keys are kept.
+    fn bonded(&self) -> bool {
+        self.preq[3] & self.pres[3] & AUTH_BONDING != 0
+    }
+
+    /// The public keys' X: the initiator's, the responder's.
+    fn public_x(&self) -> Option<([u8; 32], [u8; 32])> {
+        let ours: [u8; 32] = self.keys.as_ref()?.public[..32].try_into().unwrap();
+        let theirs: [u8; 32] = self.remote_pk?[..32].try_into().unwrap();
+        Some(if self.initiator { (ours, theirs) } else { (theirs, ours) })
+    }
+
+    /// The nonces: the initiator's, the responder's.
+    fn nonces(&self) -> Option<([u8; 16], [u8; 16])> {
+        let theirs = self.their_random?;
+        Some(if self.initiator { (self.ours, theirs) } else { (theirs, self.ours) })
+    }
+
+    /// `f6`'s `r`: the passkey, for passkey entry.
+    fn check_r(&self) -> [u8; 16] {
+        let mut r = [0u8; 16];
+        if self.method.is_passkey() {
+            r[..4].copy_from_slice(&self.passkey.unwrap_or(0).to_le_bytes());
+        }
+        r
+    }
+
+    /// The bit of the passkey this round commits to (`f4`'s `z`).
+    fn round_bit(&self) -> u8 {
+        0x80 | ((self.passkey.unwrap_or(0) >> self.round) & 1) as u8
+    }
+}
+
+/// A long-term key bluetoothd loaded (`MGMT_OP_LOAD_LONG_TERM_KEYS`).
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Ltk {
+    pub address: [u8; 6],
+    pub address_type: u8,
+    pub key_type: u8,
+    /// Used when we are central (the device's key), or peripheral (ours).
+    pub central: bool,
+    pub enc_size: u8,
+    pub ediv: u16,
+    pub rand: [u8; 8],
+    pub value: [u8; 16],
+}
+
+impl Ltk {
+    /// `struct mgmt_ltk_info`.
+    pub(crate) fn parse(bytes: &[u8]) -> Option<Self> {
+        (bytes.len() >= 36).then(|| Self {
+            address: bytes[..6].try_into().unwrap(),
+            address_type: bytes[6],
+            key_type: bytes[7],
+            central: bytes[8] != 0,
+            enc_size: bytes[9],
+            ediv: u16::from_le_bytes([bytes[10], bytes[11]]),
+            rand: bytes[12..20].try_into().unwrap(),
+            value: bytes[20..36].try_into().unwrap(),
+        })
+    }
+
+    fn to_bytes(self) -> Vec<u8> {
+        let mut bytes = self.address.to_vec();
+        bytes.extend_from_slice(&[self.address_type, self.key_type, self.central as u8, self.enc_size]);
+        bytes.extend_from_slice(&self.ediv.to_le_bytes());
+        bytes.extend_from_slice(&self.rand);
+        bytes.extend_from_slice(&self.value);
+        bytes
+    }
+}
+
+/// Random bytes from the processor's generator.
+fn random<const N: usize>() -> [u8; N] {
+    let mut bytes = [0u8; N];
+    let mut fallback = crate::now_ms().wrapping_mul(0x9e37_79b9_7f4a_7c15) ^ (bytes.as_ptr() as u64);
+    for chunk in bytes.chunks_mut(8) {
+        let value = ostd::arch::read_random().unwrap_or_else(|| {
+            fallback ^= fallback << 13;
+            fallback ^= fallback >> 7;
+            fallback ^= fallback << 17;
+            fallback
+        });
+        chunk.copy_from_slice(&value.to_le_bytes()[..chunk.len()]);
+    }
+    bytes
+}
+
+/// SMP's `e`: AES-128 on values kept least significant byte first.
+fn e(key: &[u8; 16], data: &[u8; 16]) -> [u8; 16] {
+    let mut key = *key;
+    key.reverse();
+    let mut block = *data;
+    block.reverse();
+    let cipher = Aes128::new(&key.into());
+    let mut state = block.into();
+    cipher.encrypt_block(&mut state);
+    let mut out = [0u8; 16];
+    out.copy_from_slice(&state);
+    out.reverse();
+    out
+}
+
+/// `c1`: the confirm value.
+fn c1(k: &[u8; 16], r: &[u8; 16], preq: &[u8; 7], pres: &[u8; 7], iat: u8, ia: &[u8; 6], rat: u8, ra: &[u8; 6]) -> [u8; 16] {
+    let mut p1 = [0u8; 16];
+    p1[0] = iat;
+    p1[1] = rat;
+    p1[2..9].copy_from_slice(preq);
+    p1[9..16].copy_from_slice(pres);
+    let mut p2 = [0u8; 16];
+    p2[..6].copy_from_slice(ra);
+    p2[6..12].copy_from_slice(ia);
+    let mut value = *r;
+    value.iter_mut().zip(p1).for_each(|(byte, p)| *byte ^= p);
+    let mut value = e(k, &value);
+    value.iter_mut().zip(p2).for_each(|(byte, p)| *byte ^= p);
+    e(k, &value)
+}
+
+/// `s1`: the short-term key from the two randoms.
+fn s1(k: &[u8; 16], r1: &[u8; 16], r2: &[u8; 16]) -> [u8; 16] {
+    let mut r = [0u8; 16];
+    r[..8].copy_from_slice(&r2[..8]);
+    r[8..].copy_from_slice(&r1[..8]);
+    e(k, &r)
+}
+
+fn send(device: &Device, handle: u16, pdu: &[u8]) {
+    let mut frame = (pdu.len() as u16).to_le_bytes().to_vec();
+    frame.extend_from_slice(&CID_SMP.to_le_bytes());
+    frame.extend_from_slice(pdu);
+    link::send_frame(device, handle, &frame);
+}
+
+/// Our side's IO capability and requirements.
+fn local(device: &Device, address: &[u8; 6]) -> (u8, u8) {
+    let (default_io, bondable) = {
+        let state = device.state.lock();
+        (state.io_capability, state.settings & mgmt::settings::BONDABLE != 0)
+    };
+    let io = pairing_io(device, address).unwrap_or(default_io);
+    let mut auth = if bondable || pairing::busy(device, address) { AUTH_BONDING } else { 0 };
+    if io != IO_NO_INPUT_OUTPUT {
+        auth |= AUTH_MITM;
+    }
+    if secure_connections(device).0 {
+        auth |= AUTH_SC | AUTH_CT2;
+    }
+    (io, auth)
+}
+
+/// The keys we hand over and those we ask for (`SMP_DIST_*`), as Linux's
+/// `build_pairing_cmd` offers them: long-term and signing keys when
+/// bonding, the device's identity once bluetoothd resolves private
+/// addresses, the BR/EDR link key (derived) with Secure Connections and
+/// Simple Pairing.
+fn distribution(device: &Device, auth: u8) -> (u8, u8) {
+    let settings = device.state.lock().settings;
+    let (mut ours, mut theirs) = if auth & AUTH_BONDING != 0 {
+        (DIST_ENC_KEY | DIST_SIGN, DIST_ENC_KEY | DIST_SIGN)
+    } else {
+        (0, 0)
+    };
+    if settings & mgmt::settings::RPA_RESOLVING != 0 {
+        theirs |= DIST_ID_KEY;
+    }
+    if auth & AUTH_SC != 0 && settings & mgmt::settings::SSP != 0 {
+        ours |= DIST_LINK_KEY;
+        theirs |= DIST_LINK_KEY;
+    }
+    (ours, theirs)
+}
+
+/// Whether we are the link's central.
+fn is_central(device: &Device, handle: u16) -> bool {
+    device.links.lock().by_handle(handle).is_some_and(|link| link.outgoing)
+}
+
+/// Secure Connections: offered, required (bluetoothd's
+/// `MGMT_OP_SET_SECURE_CONN`).
+fn secure_connections(device: &Device) -> (bool, bool) {
+    let settings = device.state.lock().settings;
+    (settings & mgmt::settings::SECURE_CONN != 0, settings & mgmt::settings::SC_ONLY != 0)
+}
+
+fn pairing_io(device: &Device, address: &[u8; 6]) -> Option<u8> {
+    device.pairing.lock().as_ref().filter(|request| request.address == *address).map(|request| request.io_capability)
+}
+
+/// The addresses `c1` takes: the initiator's, then the responder's (with
+/// their types: 0 public, 1 random).
+fn addresses(device: &Device, handle: u16, initiator: bool) -> Option<(u8, [u8; 6], u8, [u8; 6])> {
+    let ours = device.state.lock().info.address;
+    let (theirs, their_type, _) = link::peer_of(device, handle)?;
+    let their_type = (their_type == ADDR_LE_RANDOM) as u8;
+    Some(if initiator { (0, ours, their_type, theirs) } else { (their_type, theirs, 0, ours) })
+}
+
+/// Pairs on an LE link (we are central): asked by `MGMT_OP_PAIR_DEVICE`
+/// or by a channel that needs security without a key to use.
+pub(crate) fn pair(device: &Device, handle: u16) {
+    let Some((address, _, true)) = link::peer_of(device, handle) else { return };
+    let (io, auth) = local(device, &address);
+    let (ours, theirs) = distribution(device, auth);
+    let preq = [PAIRING_REQUEST, io, 0x00, auth, MAX_KEY_SIZE, ours, theirs];
+    {
+        let mut links = device.links.lock();
+        let Some(link) = links.by_handle(handle) else { return };
+        if link.smp.is_some() {
+            return;
+        }
+        link.securing = true;
+        link.smp = Some(Smp::new(true, preq));
+    }
+    send(device, handle, &preq);
+}
+
+/// A channel needs `level` on an LE link: the stored key if there is one
+/// (or the device's own request when we are peripheral), else pairing.
+pub(crate) fn secure(device: &Device, handle: u16, level: u8) {
+    let Some((address, address_type, true)) = link::peer_of(device, handle) else { return };
+    let (central, encrypted, security, busy) = {
+        let mut links = device.links.lock();
+        let Some(link) = links.by_handle(handle) else { return };
+        (link.outgoing, link.encrypted, link.security, link.smp.is_some() || link.securing)
+    };
+    if encrypted && security >= level {
+        l2cap::secured(device, handle, true);
+        return;
+    }
+    if busy {
+        return;
+    }
+    if !central {
+        // A peripheral asks the central to secure the link.
+        let (_, auth) = local(device, &address);
+        send(device, handle, &[SECURITY_REQUEST, auth]);
+        return;
+    }
+    // The device's key, or a Secure Connections key (either role's).
+    let key = device.state.lock().ltks.iter().find(|key| {
+        key.address == address && key.address_type == address_type && (key.central || key.key_type >= LTK_P256_UNAUTHENTICATED)
+    }).copied();
+    match key {
+        Some(key) if level <= SECURITY_MEDIUM || key.key_type & 0x01 != 0 => {
+            if let Some(link) = device.links.lock().by_handle(handle) {
+                link.securing = true;
+                link.security = match (key.key_type & 0x01 != 0, key.key_type >= LTK_P256_UNAUTHENTICATED) {
+                    (true, true) => SECURITY_FIPS,
+                    (true, false) => SECURITY_HIGH,
+                    _ => SECURITY_MEDIUM,
+                };
+            }
+            start_encryption(device, handle, &key.rand, key.ediv, &key.value);
+        }
+        _ => pair(device, handle),
+    }
+}
+
+fn start_encryption(device: &Device, handle: u16, rand: &[u8; 8], ediv: u16, key: &[u8; 16]) {
+    let mut params = handle.to_le_bytes().to_vec();
+    params.extend_from_slice(rand);
+    params.extend_from_slice(&ediv.to_le_bytes());
+    params.extend_from_slice(key);
+    device.queue_action(Action::Command(hci::OP_LE_START_ENCRYPTION, params));
+}
+
+/// A PDU on the SMP channel.
+pub(crate) fn receive(device: &Device, handle: u16, pdu: &[u8]) {
+    let Some(&code) = pdu.first() else { return };
+    // Each command's length, as Linux checks it.
+    let minimum = match code {
+        PAIRING_REQUEST | PAIRING_RESPONSE => 7,
+        PAIRING_CONFIRM | PAIRING_RANDOM | ENCRYPTION_INFORMATION | IDENTITY_INFORMATION | SIGNING_INFORMATION
+        | DHKEY_CHECK => 17,
+        PAIRING_FAILED | SECURITY_REQUEST | KEYPRESS_NOTIFICATION => 2,
+        CENTRAL_IDENTIFICATION => 11,
+        IDENTITY_ADDRESS_INFORMATION => 8,
+        PUBLIC_KEY => 65,
+        _ => return refuse(device, handle, CMD_NOT_SUPPORTED),
+    };
+    if pdu.len() < minimum {
+        return refuse(device, handle, INVALID_PARAMETERS);
+    }
+    match code {
+        PAIRING_REQUEST if is_central(device, handle) => refuse(device, handle, CMD_NOT_SUPPORTED),
+        SECURITY_REQUEST if !is_central(device, handle) => refuse(device, handle, CMD_NOT_SUPPORTED),
+        PAIRING_REQUEST => pairing_request(device, handle, pdu),
+        PAIRING_RESPONSE => pairing_response(device, handle, pdu),
+        PAIRING_CONFIRM if pdu.len() >= 17 => {
+            let value: [u8; 16] = pdu[1..17].try_into().unwrap();
+            update(device, handle, |smp| smp.their_confirm = Some(value));
+            match get(device, handle) {
+                Some(smp) if smp.sc => sc_confirm(device, handle),
+                _ => advance(device, handle),
+            }
+        }
+        PAIRING_RANDOM if pdu.len() >= 17 => {
+            let value: [u8; 16] = pdu[1..17].try_into().unwrap();
+            update(device, handle, |smp| smp.their_random = Some(value));
+            match get(device, handle) {
+                Some(smp) if smp.sc => sc_random(device, handle),
+                _ => check_random(device, handle),
+            }
+        }
+        PUBLIC_KEY if pdu.len() >= 65 => public_key(device, handle, pdu[1..65].try_into().unwrap()),
+        DHKEY_CHECK if pdu.len() >= 17 => dhkey_check(device, handle, pdu[1..17].try_into().unwrap()),
+        KEYPRESS_NOTIFICATION => {}
+        PAIRING_FAILED => failed(device, handle, pdu.get(1).copied().unwrap_or(UNSPECIFIED), false),
+        ENCRYPTION_INFORMATION if pdu.len() >= 17 => {
+            let value: [u8; 16] = pdu[1..17].try_into().unwrap();
+            update(device, handle, |smp| smp.ltk = Some(value));
+        }
+        CENTRAL_IDENTIFICATION if pdu.len() >= 11 => {
+            let ediv = u16::from_le_bytes([pdu[1], pdu[2]]);
+            let rand: [u8; 8] = pdu[3..11].try_into().unwrap();
+            store_ltk(device, handle, ediv, rand);
+            update(device, handle, |smp| smp.expecting &= !DIST_ENC_KEY);
+            keys_done(device, handle);
+        }
+        IDENTITY_INFORMATION if pdu.len() >= 17 => {
+            let value: [u8; 16] = pdu[1..17].try_into().unwrap();
+            update(device, handle, |smp| smp.irk = Some(value));
+        }
+        IDENTITY_ADDRESS_INFORMATION if pdu.len() >= 8 => {
+            let address: [u8; 6] = pdu[2..8].try_into().unwrap();
+            let address_type = if pdu[1] == 0 { mgmt::ADDR_LE_PUBLIC } else { ADDR_LE_RANDOM };
+            update(device, handle, |smp| {
+                smp.identity = Some((address, address_type));
+                smp.expecting &= !DIST_ID_KEY;
+            });
+            store_irk(device, handle);
+            keys_done(device, handle);
+        }
+        SIGNING_INFORMATION => {
+            let value: [u8; 16] = pdu[1..17].try_into().unwrap();
+            store_csrk(device, handle, value, false);
+            update(device, handle, |smp| smp.expecting &= !DIST_SIGN);
+            keys_done(device, handle);
+        }
+        SECURITY_REQUEST => {
+            // The peripheral wants security: the key we have, or pairing.
+            let level = if pdu.get(1).is_some_and(|auth| auth & AUTH_MITM != 0) { SECURITY_HIGH } else { SECURITY_MEDIUM };
+            let bondable = device.state.lock().settings & mgmt::settings::BONDABLE != 0;
+            if bondable || pairing_io(device, &link::peer_of(device, handle).map_or([0; 6], |peer| peer.0)).is_some() {
+                secure(device, handle, level.min(SECURITY_MEDIUM));
+            } else {
+                send(device, handle, &[PAIRING_FAILED, PAIRING_NOT_SUPPORTED]);
+            }
+        }
+        _ => {}
+    }
+}
+
+/// Refuses a command: the pairing there is ends.
+fn refuse(device: &Device, handle: u16, reason: u8) {
+    if get(device, handle).is_some() {
+        abort(device, handle, reason);
+    } else {
+        send(device, handle, &[PAIRING_FAILED, reason]);
+    }
+}
+
+fn update(device: &Device, handle: u16, change: impl FnOnce(&mut Smp)) {
+    if let Some(smp) = device.links.lock().by_handle(handle).and_then(|link| link.smp.as_mut()) {
+        change(smp);
+    }
+}
+
+fn get(device: &Device, handle: u16) -> Option<Smp> {
+    device.links.lock().by_handle(handle).and_then(|link| link.smp.clone())
+}
+
+/// The device pairs with us (we are peripheral).
+fn pairing_request(device: &Device, handle: u16, pdu: &[u8]) {
+    let Some((address, _, true)) = link::peer_of(device, handle) else { return };
+    let bondable = device.state.lock().settings & mgmt::settings::BONDABLE != 0;
+    if !bondable && pdu[3] & AUTH_BONDING != 0 {
+        send(device, handle, &[PAIRING_FAILED, PAIRING_NOT_SUPPORTED]);
+        return;
+    }
+    let (io, auth) = local(device, &address);
+    let sc = auth & pdu[3] & AUTH_SC != 0;
+    if secure_connections(device).1 && !sc {
+        send(device, handle, &[PAIRING_FAILED, AUTH_REQUIREMENTS]);
+        return;
+    }
+    if !(MIN_KEY_SIZE..=MAX_KEY_SIZE).contains(&pdu[4]) {
+        send(device, handle, &[PAIRING_FAILED, ENC_KEY_SIZE]);
+        return;
+    }
+    let key_size = pdu[4];
+    let auth = auth & (AUTH_BONDING | AUTH_MITM | if sc { AUTH_SC | AUTH_CT2 } else { 0 });
+    // What each side hands over: what the device offers and we take.
+    let (ours, theirs) = distribution(device, auth);
+    let mut expecting = pdu[5] & theirs;
+    let mut giving = pdu[6] & ours;
+    let preq: [u8; 7] = pdu[..7].try_into().unwrap();
+    let pres = [PAIRING_RESPONSE, io, 0x00, auth, key_size, expecting, giving];
+    let link_key = sc && giving & DIST_LINK_KEY != 0;
+    if sc {
+        // Secure Connections derives these instead.
+        giving &= !SC_NO_DIST;
+        expecting &= !SC_NO_DIST;
+    }
+    let method = if sc { sc_method_of(io, pdu[1], (auth | pdu[3]) & AUTH_MITM != 0, false) } else { method_of(io, pdu[1], (auth | pdu[3]) & AUTH_MITM != 0, false) };
+    {
+        let mut links = device.links.lock();
+        let Some(link) = links.by_handle(handle) else { return };
+        link.securing = true;
+        let mut smp = Smp::new(false, preq);
+        smp.pres = pres;
+        smp.method = method;
+        smp.expecting = expecting;
+        smp.giving = giving;
+        smp.key_size = key_size;
+        smp.sc = sc;
+        smp.link_key = link_key;
+        smp.ct2 = sc && pdu[3] & AUTH_CT2 != 0;
+        if sc {
+            smp.keys = Some(sc::key_pair(random::<32>));
+        }
+        link.smp = Some(smp);
+    }
+    send(device, handle, &pres);
+    // Secure Connections waits for the initiator's public key.
+    if !sc {
+        ask_user(device, handle, &address);
+    }
+}
+
+fn pairing_response(device: &Device, handle: u16, pdu: &[u8]) {
+    let Some(mut smp) = get(device, handle).filter(|smp| smp.initiator) else { return };
+    let Some((address, _, _)) = link::peer_of(device, handle) else { return };
+    if !(MIN_KEY_SIZE..=MAX_KEY_SIZE).contains(&pdu[4]) {
+        return abort(device, handle, ENC_KEY_SIZE);
+    }
+    smp.pres = pdu[..7].try_into().unwrap();
+    smp.key_size = pdu[4];
+    smp.expecting = pdu[6] & smp.preq[6];
+    smp.giving = pdu[5] & smp.preq[5];
+    smp.sc = smp.preq[3] & pdu[3] & AUTH_SC != 0;
+    smp.link_key = smp.sc && smp.giving & DIST_LINK_KEY != 0;
+    smp.ct2 = smp.sc && pdu[3] & AUTH_CT2 != 0;
+    if secure_connections(device).1 && !smp.sc {
+        return abort(device, handle, AUTH_REQUIREMENTS);
+    }
+    let mitm = (smp.preq[3] | pdu[3]) & AUTH_MITM != 0;
+    if smp.sc {
+        smp.expecting &= !SC_NO_DIST;
+        smp.giving &= !SC_NO_DIST;
+        smp.method = sc_method_of(smp.preq[1], pdu[1], mitm, true);
+        let keys = sc::key_pair(random::<32>);
+        let mut key = vec![PUBLIC_KEY];
+        key.extend_from_slice(&keys.public);
+        smp.keys = Some(keys);
+        update(device, handle, |stored| *stored = smp);
+        send(device, handle, &key);
+        return;
+    }
+    smp.method = method_of(smp.preq[1], pdu[1], mitm, true);
+    update(device, handle, |stored| *stored = smp);
+    ask_user(device, handle, &address);
+    advance(device, handle);
+}
+
+/// Secure Connections' method (Linux's `sc_method`): numbers compared
+/// where both can show and confirm them.
+fn sc_method_of(local_io: u8, remote_io: u8, mitm: bool, initiator: bool) -> Method {
+    use Method::*;
+    const TABLE: [[Method; 5]; 5] = [
+        [JustWorks, JustConfirm, RequestPasskey, JustWorks, RequestPasskey],
+        [JustWorks, Compare, RequestPasskey, JustWorks, Compare],
+        [ShowPasskey, ShowPasskey, RequestPasskey, JustWorks, ShowPasskey],
+        [JustWorks, JustConfirm, JustWorks, JustWorks, JustConfirm],
+        [ShowPasskey, Compare, RequestPasskey, JustWorks, Compare],
+    ];
+    let method = if !mitm {
+        JustWorks
+    } else if local_io > IO_KEYBOARD_DISPLAY || remote_io > IO_KEYBOARD_DISPLAY {
+        JustConfirm
+    } else {
+        TABLE[remote_io as usize][local_io as usize]
+    };
+    // Pairing we started is not confirmed again.
+    if method == JustConfirm && initiator { JustWorks } else { method }
+}
+
+/// The method the IO capabilities give (Linux's table for legacy pairing).
+fn method_of(local_io: u8, remote_io: u8, mitm: bool, initiator: bool) -> Method {
+    use Method::*;
+    const TABLE: [[Method; 5]; 5] = [
+        [JustWorks, JustConfirm, RequestPasskey, JustWorks, RequestPasskey],
+        [JustWorks, JustConfirm, RequestPasskey, JustWorks, RequestPasskey],
+        [ShowPasskey, ShowPasskey, RequestPasskey, JustWorks, ShowPasskey],
+        [JustWorks, JustConfirm, JustWorks, JustWorks, JustConfirm],
+        [ShowPasskey, ShowPasskey, RequestPasskey, JustWorks, RequestPasskey],
+    ];
+    let mut method = if !mitm || local_io > IO_KEYBOARD_DISPLAY || remote_io > IO_KEYBOARD_DISPLAY {
+        JustConfirm
+    } else {
+        TABLE[remote_io as usize][local_io as usize]
+    };
+    if method == JustConfirm && (initiator || local_io == IO_NO_INPUT_OUTPUT) {
+        method = JustWorks;
+    }
+    method
+}
+
+/// Sets the temporary key, asking bluetoothd's agent when the method says.
+fn ask_user(device: &Device, handle: u16, address: &[u8; 6]) {
+    let Some(smp) = get(device, handle) else { return };
+    let (_, address_type, _) = link::peer_of(device, handle).unwrap_or((*address, 1, true));
+    let mut event = address.to_vec();
+    event.push(address_type);
+    match smp.method {
+        Method::JustWorks => update(device, handle, |smp| smp.tk = Some([0; 16])),
+        // Legacy pairing compares no numbers: just confirmed.
+        Method::JustConfirm | Method::Compare => {
+            event.push(1);
+            event.extend_from_slice(&0u32.to_le_bytes());
+            mgmt::event_to_all(mgmt::ev::USER_CONFIRM_REQUEST, device.index, &event);
+        }
+        Method::RequestPasskey => mgmt::event_to_all(mgmt::ev::USER_PASSKEY_REQUEST, device.index, &event),
+        Method::ShowPasskey => {
+            let passkey = u32::from_le_bytes(random::<4>()) % 1_000_000;
+            let mut tk = [0u8; 16];
+            tk[..4].copy_from_slice(&passkey.to_le_bytes());
+            update(device, handle, |smp| smp.tk = Some(tk));
+            event.extend_from_slice(&passkey.to_le_bytes());
+            event.push(0);
+            mgmt::event_to_all(mgmt::ev::PASSKEY_NOTIFY, device.index, &event);
+        }
+    }
+}
+
+/// The agent answered (an LE address): the temporary key, or the end.
+pub(crate) fn agent_reply(device: &Device, opcode: u16, address: &[u8; 6], params: &[u8]) -> Result<(), u8> {
+    let handle = link::handle_of(device, address, true).ok_or(mgmt::STATUS_NOT_CONNECTED)?;
+    if get(device, handle).is_some_and(|smp| smp.sc) {
+        return sc_user_reply(device, handle, opcode, params);
+    }
+    match opcode {
+        mgmt::op::USER_CONFIRM_REPLY => update(device, handle, |smp| smp.tk = Some([0; 16])),
+        mgmt::op::USER_PASSKEY_REPLY => {
+            let passkey = params.get(7..11).map(|b| u32::from_le_bytes(b.try_into().unwrap())).ok_or(mgmt::STATUS_INVALID_PARAMS)?;
+            let mut tk = [0u8; 16];
+            tk[..4].copy_from_slice(&passkey.to_le_bytes());
+            update(device, handle, |smp| smp.tk = Some(tk));
+        }
+        _ => {
+            send(device, handle, &[PAIRING_FAILED, PASSKEY_FAILED]);
+            failed(device, handle, PASSKEY_FAILED, true);
+            return Ok(());
+        }
+    }
+    advance(device, handle);
+    Ok(())
+}
+
+/// Sends our confirm value once the temporary key is known (the initiator
+/// first; the responder after the initiator's).
+fn advance(device: &Device, handle: u16) {
+    let Some(smp) = get(device, handle) else { return };
+    let (Some(tk), false) = (smp.tk, smp.confirm_sent) else {
+        // Ours is out: the initiator sends its random once theirs came.
+        if smp.initiator && smp.confirm_sent && smp.their_confirm.is_some() && smp.their_random.is_none() {
+            let mut pdu = vec![PAIRING_RANDOM];
+            pdu.extend_from_slice(&smp.ours);
+            send(device, handle, &pdu);
+        }
+        return;
+    };
+    if !smp.initiator && smp.their_confirm.is_none() {
+        return;
+    }
+    let Some((iat, ia, rat, ra)) = addresses(device, handle, smp.initiator) else { return };
+    let confirm = c1(&tk, &smp.ours, &smp.preq, &smp.pres, iat, &ia, rat, &ra);
+    update(device, handle, |smp| smp.confirm_sent = true);
+    let mut pdu = vec![PAIRING_CONFIRM];
+    pdu.extend_from_slice(&confirm);
+    send(device, handle, &pdu);
+}
+
+/// The device's random: its confirm checked, then the short-term key.
+fn check_random(device: &Device, handle: u16) {
+    let Some(smp) = get(device, handle) else { return };
+    let (Some(tk), Some(theirs), Some(their_confirm)) = (smp.tk, smp.their_random, smp.their_confirm) else { return };
+    let Some((iat, ia, rat, ra)) = addresses(device, handle, smp.initiator) else { return };
+    if c1(&tk, &theirs, &smp.preq, &smp.pres, iat, &ia, rat, &ra) != their_confirm {
+        send(device, handle, &[PAIRING_FAILED, CONFIRM_FAILED]);
+        failed(device, handle, CONFIRM_FAILED, true);
+        return;
+    }
+    let (initiator_random, responder_random) = if smp.initiator { (smp.ours, theirs) } else { (theirs, smp.ours) };
+    let mut stk = s1(&tk, &responder_random, &initiator_random);
+    // A shorter key is the first bytes of it.
+    stk[smp.key_size as usize..].fill(0);
+    update(device, handle, |smp| smp.stk = Some(stk));
+    if smp.initiator {
+        start_encryption(device, handle, &[0; 8], 0, &stk);
+    } else {
+        let mut pdu = vec![PAIRING_RANDOM];
+        pdu.extend_from_slice(&smp.ours);
+        send(device, handle, &pdu);
+    }
+}
+
+/// The device's address and type, as management events begin.
+fn peer_event(device: &Device, handle: u16) -> Option<Vec<u8>> {
+    let (address, address_type, _) = link::peer_of(device, handle)?;
+    let mut event = address.to_vec();
+    event.push(address_type);
+    Some(event)
+}
+
+/// Fails the pairing: the device hears why.
+fn abort(device: &Device, handle: u16, reason: u8) {
+    send(device, handle, &[PAIRING_FAILED, reason]);
+    failed(device, handle, reason, true);
+}
+
+fn send_value(device: &Device, handle: u16, code: u8, value: &[u8; 16]) {
+    let mut pdu = vec![code];
+    pdu.extend_from_slice(value);
+    send(device, handle, &pdu);
+}
+
+/// The device's public key (Secure Connections): the DHKey, then the
+/// method's first step.
+fn public_key(device: &Device, handle: u16, theirs: [u8; 64]) {
+    let Some(smp) = get(device, handle).filter(|smp| smp.sc && smp.remote_pk.is_none()) else { return };
+    let Some(keys) = smp.keys.clone() else { return };
+    if theirs == keys.public {
+        return abort(device, handle, DHKEY_CHECK_FAILED);
+    }
+    // A point off the curve is refused (the invalid-curve attack).
+    let Some(dhkey) = sc::dhkey(&keys, &theirs) else {
+        return abort(device, handle, DHKEY_CHECK_FAILED);
+    };
+    if !smp.initiator {
+        let mut pdu = vec![PUBLIC_KEY];
+        pdu.extend_from_slice(&keys.public);
+        send(device, handle, &pdu);
+    }
+    update(device, handle, |smp| {
+        smp.remote_pk = Some(theirs);
+        smp.dhkey = Some(dhkey);
+    });
+    let Some(mut event) = peer_event(device, handle) else { return };
+    match smp.method {
+        Method::ShowPasskey => {
+            let passkey = u32::from_le_bytes(random::<4>()) % 1_000_000;
+            update(device, handle, |smp| {
+                smp.passkey = Some(passkey);
+                smp.round = 0;
+            });
+            event.extend_from_slice(&passkey.to_le_bytes());
+            event.push(0);
+            mgmt::event_to_all(mgmt::ev::PASSKEY_NOTIFY, device.index, &event);
+            passkey_round(device, handle, Round::Start);
+        }
+        Method::RequestPasskey => {
+            update(device, handle, |smp| smp.waiting_user = true);
+            mgmt::event_to_all(mgmt::ev::USER_PASSKEY_REQUEST, device.index, &event);
+        }
+        _ => {
+            // The responder commits to its nonce; the initiator waits.
+            if !smp.initiator {
+                let Some((pkax, pkbx)) = get(device, handle).and_then(|smp| smp.public_x()) else { return };
+                send_value(device, handle, PAIRING_CONFIRM, &sc::f4(&pkbx, &pkax, &smp.ours, 0));
+            }
+        }
+    }
+}
+
+/// A confirm value (Secure Connections).
+fn sc_confirm(device: &Device, handle: u16) {
+    let Some(smp) = get(device, handle) else { return };
+    if smp.remote_pk.is_none() {
+        return;
+    }
+    if smp.method.is_passkey() {
+        passkey_round(device, handle, Round::Confirm);
+    } else if smp.initiator {
+        send_value(device, handle, PAIRING_RANDOM, &smp.ours);
+    }
+}
+
+/// A nonce (Secure Connections): the responder's confirm checked, then the
+/// user compares or confirms.
+fn sc_random(device: &Device, handle: u16) {
+    let Some(smp) = get(device, handle) else { return };
+    if smp.method.is_passkey() {
+        return passkey_round(device, handle, Round::Random);
+    }
+    let (Some((pkax, pkbx)), Some((na, nb))) = (smp.public_x(), smp.nonces()) else { return };
+    if smp.initiator {
+        if smp.their_confirm != Some(sc::f4(&pkbx, &pkax, &nb, 0)) {
+            return abort(device, handle, CONFIRM_FAILED);
+        }
+    } else {
+        send_value(device, handle, PAIRING_RANDOM, &smp.ours);
+    }
+    mackey_and_ltk(device, handle);
+    // The user confirms even Just Works (a hint, no number), as Linux has
+    // them do.
+    let value = sc::g2(&pkax, &pkbx, &na, &nb);
+    let Some(mut event) = peer_event(device, handle) else { return };
+    event.push((smp.method == Method::JustWorks) as u8);
+    event.extend_from_slice(&value.to_le_bytes());
+    update(device, handle, |smp| smp.waiting_user = true);
+    mgmt::event_to_all(mgmt::ev::USER_CONFIRM_REQUEST, device.index, &event);
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Round {
+    /// The initiator starts a round.
+    Start,
+    Confirm,
+    Random,
+}
+
+/// Passkey entry: twenty rounds, one bit of the passkey each.
+fn passkey_round(device: &Device, handle: u16, step: Round) {
+    let Some(smp) = get(device, handle) else { return };
+    if smp.round >= 20 {
+        return;
+    }
+    let Some((pkax, pkbx)) = smp.public_x() else { return };
+    let (ours_x, theirs_x) = if smp.initiator { (pkax, pkbx) } else { (pkbx, pkax) };
+    match step {
+        Round::Random => {
+            let Some(theirs) = smp.their_random else { return };
+            if smp.their_confirm != Some(sc::f4(&theirs_x, &ours_x, &theirs, smp.round_bit())) {
+                return abort(device, handle, CONFIRM_FAILED);
+            }
+            let round = smp.round + 1;
+            update(device, handle, |smp| smp.round = round);
+            if round == 20 {
+                mackey_and_ltk(device, handle);
+            }
+            if !smp.initiator {
+                // The responder's nonce ends the round.
+                send_value(device, handle, PAIRING_RANDOM, &smp.ours);
+            } else if round < 20 {
+                passkey_round(device, handle, Round::Start);
+            } else {
+                send_dhkey_check(device, handle);
+            }
+        }
+        Round::Confirm => {
+            if smp.waiting_user {
+                update(device, handle, |smp| smp.confirm_pending = true);
+            } else if smp.initiator {
+                send_value(device, handle, PAIRING_RANDOM, &smp.ours);
+            } else {
+                round_confirm(device, handle, &ours_x, &theirs_x);
+            }
+        }
+        Round::Start => {
+            if smp.initiator {
+                round_confirm(device, handle, &ours_x, &theirs_x);
+            }
+        }
+    }
+}
+
+/// A round's commitment: a new nonce, and the passkey's bit.
+fn round_confirm(device: &Device, handle: u16, ours_x: &[u8; 32], theirs_x: &[u8; 32]) {
+    let nonce: [u8; 16] = random();
+    update(device, handle, |smp| smp.ours = nonce);
+    let Some(smp) = get(device, handle) else { return };
+    send_value(device, handle, PAIRING_CONFIRM, &sc::f4(ours_x, theirs_x, &nonce, smp.round_bit()));
+}
+
+/// The addresses `f5` and `f6` take: the initiator's, the responder's
+/// (each its bytes, then its type).
+fn sc_addresses(device: &Device, handle: u16, initiator: bool) -> Option<([u8; 7], [u8; 7])> {
+    let (iat, ia, rat, ra) = addresses(device, handle, initiator)?;
+    let mut a = [0u8; 7];
+    a[..6].copy_from_slice(&ia);
+    a[6] = iat;
+    let mut b = [0u8; 7];
+    b[..6].copy_from_slice(&ra);
+    b[6] = rat;
+    Some((a, b))
+}
+
+/// The MacKey and the long-term key (`f5`).
+fn mackey_and_ltk(device: &Device, handle: u16) {
+    let Some(smp) = get(device, handle) else { return };
+    let (Some(dhkey), Some((na, nb)), Some((a, b))) = (smp.dhkey, smp.nonces(), sc_addresses(device, handle, smp.initiator)) else {
+        return;
+    };
+    let (mackey, ltk) = sc::f5(&dhkey, &na, &nb, &a, &b);
+    // A shorter key is the first bytes of it (the whole one gives the
+    // BR/EDR link key).
+    let mut short = ltk;
+    short[smp.key_size as usize..].fill(0);
+    update(device, handle, |smp| {
+        smp.mackey = Some(mackey);
+        smp.ltk = Some(ltk);
+        smp.stk = Some(short);
+    });
+}
+
+/// Our DHKey check (`f6`).
+fn send_dhkey_check(device: &Device, handle: u16) {
+    let Some(smp) = get(device, handle) else { return };
+    let (Some(mackey), Some(theirs), Some((a, b))) = (smp.mackey, smp.their_random, sc_addresses(device, handle, smp.initiator)) else {
+        return;
+    };
+    let (pdu, local, remote) = if smp.initiator { (&smp.preq, a, b) } else { (&smp.pres, b, a) };
+    let io_cap: [u8; 3] = pdu[1..4].try_into().unwrap();
+    send_value(device, handle, DHKEY_CHECK, &sc::f6(&mackey, &smp.ours, &theirs, &smp.check_r(), &io_cap, &local, &remote));
+}
+
+/// The device's DHKey check: the responder answers with its own (once the
+/// user confirmed); the initiator encrypts the link.
+fn dhkey_check(device: &Device, handle: u16, check: [u8; 16]) {
+    let Some(smp) = get(device, handle).filter(|smp| smp.sc) else { return };
+    let (Some(mackey), Some(theirs), Some((a, b))) = (smp.mackey, smp.their_random, sc_addresses(device, handle, smp.initiator)) else {
+        return abort(device, handle, UNSPECIFIED);
+    };
+    let (pdu, local, remote) = if smp.initiator { (&smp.pres, a, b) } else { (&smp.preq, b, a) };
+    let io_cap: [u8; 3] = pdu[1..4].try_into().unwrap();
+    if check != sc::f6(&mackey, &theirs, &smp.ours, &smp.check_r(), &io_cap, &remote, &local) {
+        return abort(device, handle, DHKEY_CHECK_FAILED);
+    }
+    if smp.initiator {
+        if let Some(ltk) = smp.stk {
+            start_encryption(device, handle, &[0; 8], 0, &ltk);
+        }
+    } else if smp.waiting_user {
+        update(device, handle, |smp| smp.their_check = Some(check));
+    } else {
+        send_dhkey_check(device, handle);
+    }
+}
+
+/// The agent answered a Secure Connections pairing.
+fn sc_user_reply(device: &Device, handle: u16, opcode: u16, params: &[u8]) -> Result<(), u8> {
+    update(device, handle, |smp| smp.waiting_user = false);
+    match opcode {
+        mgmt::op::USER_PASSKEY_REPLY => {
+            let passkey = params.get(7..11).map(|b| u32::from_le_bytes(b.try_into().unwrap())).ok_or(mgmt::STATUS_INVALID_PARAMS)?;
+            let pending = get(device, handle).is_some_and(|smp| smp.confirm_pending);
+            update(device, handle, |smp| {
+                smp.passkey = Some(passkey);
+                smp.round = 0;
+                smp.confirm_pending = false;
+            });
+            passkey_round(device, handle, if pending { Round::Confirm } else { Round::Start });
+        }
+        mgmt::op::USER_CONFIRM_REPLY => {
+            // The initiator's check goes first; the responder's answers it.
+            if get(device, handle).is_some_and(|smp| smp.initiator || smp.their_check.is_some()) {
+                send_dhkey_check(device, handle);
+            }
+        }
+        mgmt::op::USER_PASSKEY_NEG_REPLY => abort(device, handle, PASSKEY_FAILED),
+        _ => abort(device, handle, NUMERIC_COMPARISON_FAILED),
+    }
+    Ok(())
+}
+
+/// `LE Long Term Key Request` (we are peripheral): the short-term key
+/// while pairing, else the key we handed over before.
+pub(crate) fn ltk_request(device: &Device, params: &[u8]) {
+    if params.len() < 12 {
+        return;
+    }
+    let handle = u16::from_le_bytes([params[0], params[1]]) & 0x0fff;
+    let rand: [u8; 8] = params[2..10].try_into().unwrap();
+    let ediv = u16::from_le_bytes([params[10], params[11]]);
+    let stk = get(device, handle).and_then(|smp| smp.stk).filter(|_| ediv == 0 && rand == [0; 8]);
+    let key = stk.or_else(|| {
+        let (address, _, _) = link::peer_of(device, handle)?;
+        let state = device.state.lock();
+        state.ltks.iter().find(|key| key.address == address && !key.central && key.ediv == ediv && key.rand == rand).map(|key| key.value)
+    });
+    match key {
+        Some(key) => {
+            let mut reply = handle.to_le_bytes().to_vec();
+            reply.extend_from_slice(&key);
+            device.queue_action(Action::Command(hci::OP_LE_LTK_REPLY, reply));
+        }
+        None => device.queue_action(Action::Command(hci::OP_LE_LTK_NEG_REPLY, handle.to_le_bytes().to_vec())),
+    }
+}
+
+/// The link is encrypted (or failed to be): keys go both ways after
+/// pairing; channels waiting for it go on.
+pub(crate) fn encryption_changed(device: &Device, handle: u16, ok: bool) {
+    let Some(smp) = get(device, handle) else {
+        // A stored key: done.
+        if !ok {
+            // The device lost the key: pair again.
+            if let Some(link) = device.links.lock().by_handle(handle) {
+                link.security = link::SECURITY_LOW;
+            }
+        }
+        l2cap::secured(device, handle, ok);
+        return;
+    };
+    if !ok {
+        failed(device, handle, UNSPECIFIED, true);
+        return;
+    }
+    let mitm = smp.method.authenticated();
+    if let Some(link) = device.links.lock().by_handle(handle) {
+        link.security = match (mitm, smp.sc) {
+            (true, true) => SECURITY_FIPS,
+            (true, false) => SECURITY_HIGH,
+            _ => SECURITY_MEDIUM,
+        };
+    }
+    // The responder hands its keys first; the initiator after them.
+    if !smp.initiator {
+        give_keys(device, handle);
+    }
+    keys_done(device, handle);
+}
+
+/// Our keys for the device: a long-term key of our own, which bluetoothd
+/// stores for when the device comes back.
+fn give_keys(device: &Device, handle: u16) {
+    let Some(smp) = get(device, handle) else { return };
+    if smp.giving & DIST_ENC_KEY != 0 {
+        let Some((address, address_type, _)) = link::peer_of(device, handle) else { return };
+        let mut value: [u8; 16] = random();
+        value[smp.key_size as usize..].fill(0);
+        let ediv = u16::from_le_bytes(random::<2>());
+        let rand: [u8; 8] = random();
+        let mut pdu = vec![ENCRYPTION_INFORMATION];
+        pdu.extend_from_slice(&value);
+        send(device, handle, &pdu);
+        let mut pdu = vec![CENTRAL_IDENTIFICATION];
+        pdu.extend_from_slice(&ediv.to_le_bytes());
+        pdu.extend_from_slice(&rand);
+        send(device, handle, &pdu);
+        let mitm = smp.method.authenticated();
+        let key = Ltk { address, address_type, key_type: mitm as u8, central: false, enc_size: smp.key_size, ediv, rand, value };
+        remember(device, key);
+    }
+    // Our signing key (signed ATT writes), which bluetoothd stores too.
+    if smp.giving & DIST_SIGN != 0 {
+        let csrk: [u8; 16] = random();
+        send_value(device, handle, SIGNING_INFORMATION, &csrk);
+        store_csrk(device, handle, csrk, true);
+    }
+    update(device, handle, |smp| smp.giving = 0);
+}
+
+/// A signing key, ours (`local`) or the device's, for bluetoothd
+/// (`MGMT_EV_NEW_CSRK`).
+fn store_csrk(device: &Device, handle: u16, value: [u8; 16], local: bool) {
+    let Some(smp) = get(device, handle) else { return };
+    let Some((address, address_type, _)) = link::peer_of(device, handle) else { return };
+    // The device's identity, once it gave one.
+    let (address, address_type) = smp.identity.unwrap_or((address, address_type));
+    let mut event = vec![smp.bonded() as u8];
+    event.extend_from_slice(&address);
+    event.push(address_type);
+    // Local or remote, unauthenticated or authenticated.
+    event.push(!local as u8 | (smp.method.authenticated() as u8) << 1);
+    event.extend_from_slice(&value);
+    mgmt::event_to_all(mgmt::ev::NEW_CSRK, device.index, &event);
+}
+
+fn store_ltk(device: &Device, handle: u16, ediv: u16, rand: [u8; 8]) {
+    let Some(smp) = get(device, handle) else { return };
+    let (Some(value), Some((address, address_type, _))) = (smp.ltk, link::peer_of(device, handle)) else { return };
+    let mitm = smp.method != Method::JustWorks && smp.method != Method::JustConfirm;
+    let key = Ltk { address, address_type, key_type: mitm as u8, central: smp.initiator, enc_size: smp.key_size, ediv, rand, value };
+    remember(device, key);
+}
+
+/// Keeps a long-term key and tells bluetoothd to store it.
+fn remember(device: &Device, key: Ltk) {
+    {
+        let mut state = device.state.lock();
+        state.ltks.retain(|known| !(known.address == key.address && known.central == key.central));
+        state.ltks.push(key);
+    }
+    let mut event = vec![1u8];
+    event.extend_from_slice(&key.to_bytes());
+    mgmt::event_to_all(mgmt::ev::NEW_LONG_TERM_KEY, device.index, &event);
+}
+
+fn store_irk(device: &Device, handle: u16) {
+    let Some(smp) = get(device, handle) else { return };
+    let (Some(irk), Some((identity, identity_type))) = (smp.irk, smp.identity) else { return };
+    let Some((address, address_type, _)) = link::peer_of(device, handle) else { return };
+    let mut event = vec![1u8];
+    // The resolvable address the link used, if it was one.
+    event.extend_from_slice(if address_type == ADDR_LE_RANDOM { &address } else { &[0; 6] });
+    event.extend_from_slice(&identity);
+    event.push(identity_type);
+    event.extend_from_slice(&irk);
+    mgmt::event_to_all(mgmt::ev::NEW_IRK, device.index, &event);
+}
+
+/// Once every key came (and ours went), the pairing is done.
+fn keys_done(device: &Device, handle: u16) {
+    let Some(smp) = get(device, handle) else { return };
+    if smp.stk.is_none() || smp.expecting != 0 {
+        return;
+    }
+    if smp.initiator && smp.giving != 0 {
+        give_keys(device, handle);
+    }
+    // Secure Connections' long-term key, the same on both sides (either
+    // role uses it again).
+    if smp.sc
+        && let (Some(value), Some((address, address_type, _))) = (smp.stk, link::peer_of(device, handle))
+    {
+        let key_type = LTK_P256_UNAUTHENTICATED | smp.method.authenticated() as u8;
+        remember(device, Ltk { address, address_type, key_type, central: false, enc_size: smp.key_size, ediv: 0, rand: [0; 8], value });
+    }
+    // The BR/EDR link key it gives (cross-transport key derivation), for
+    // the device's public identity: a dual-mode device then connects on
+    // BR/EDR paired already.
+    if smp.sc && smp.link_key {
+        let identity = smp.identity.or_else(|| link::peer_of(device, handle).map(|(address, address_type, _)| (address, address_type)));
+        if let (Some(ltk), Some((address, mgmt::ADDR_LE_PUBLIC))) = (smp.ltk, identity) {
+            let kind = if smp.method.authenticated() { pairing::KEY_AUTHENTICATED_P256 } else { pairing::KEY_UNAUTHENTICATED_P256 };
+            pairing::remember_link_key(device, address, kind, sc::link_key_of(&ltk, smp.ct2), smp.bonded());
+        }
+    }
+    let address = link::peer_of(device, handle).map(|peer| peer.0);
+    if let Some(link) = device.links.lock().by_handle(handle) {
+        link.smp = None;
+        link.securing = false;
+    }
+    if let Some(address) = address {
+        pairing::finish(device, &address, mgmt::STATUS_SUCCESS);
+    }
+    l2cap::secured(device, handle, true);
+}
+
+/// The pairing failed (`ours`: we said so).
+fn failed(device: &Device, handle: u16, reason: u8, ours: bool) {
+    let _ = ours;
+    if let Some(link) = device.links.lock().by_handle(handle) {
+        link.smp = None;
+        link.securing = false;
+    }
+    if let Some((address, address_type, _)) = link::peer_of(device, handle) {
+        if pairing::busy(device, &address) {
+            pairing::finish(device, &address, mgmt::STATUS_AUTH_FAILED);
+        } else {
+            let mut event = address.to_vec();
+            event.push(address_type);
+            event.push(if reason == CONFIRM_FAILED { mgmt::STATUS_AUTH_FAILED } else { mgmt::STATUS_FAILED });
+            mgmt::event_to_all(mgmt::ev::AUTH_FAILED, device.index, &event);
+        }
+    }
+    l2cap::secured(device, handle, false);
+}
