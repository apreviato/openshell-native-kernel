+    now_ms,
+    socket::{self, Socket},
+};
+
+pub(crate) const VERSION: u8 = 1;
+pub(crate) const REVISION: u16 = 22;
+pub(crate) const INDEX_NONE: u16 = 0xffff;
+
+// Statuses.
+pub(crate) const STATUS_SUCCESS: u8 = 0x00;
+pub(crate) const STATUS_UNKNOWN_COMMAND: u8 = 0x01;
+pub(crate) const STATUS_NOT_CONNECTED: u8 = 0x02;
+pub(crate) const STATUS_FAILED: u8 = 0x03;
+pub(crate) const STATUS_BUSY: u8 = 0x0a;
+pub(crate) const STATUS_REJECTED: u8 = 0x0b;
+pub(crate) const STATUS_NOT_SUPPORTED: u8 = 0x0c;
+pub(crate) const STATUS_INVALID_PARAMS: u8 = 0x0d;
+pub(crate) const STATUS_NOT_POWERED: u8 = 0x0f;
+pub(crate) const STATUS_INVALID_INDEX: u8 = 0x11;
+pub(crate) const STATUS_CONNECT_FAILED: u8 = 0x04;
+pub(crate) const STATUS_AUTH_FAILED: u8 = 0x05;
+pub(crate) const STATUS_NO_RESOURCES: u8 = 0x07;
+pub(crate) const STATUS_TIMEOUT: u8 = 0x08;
+pub(crate) const STATUS_ALREADY_CONNECTED: u8 = 0x09;
+pub(crate) const STATUS_DISCONNECTED: u8 = 0x0e;
+pub(crate) const STATUS_CANCELLED: u8 = 0x10;
+pub(crate) const STATUS_RFKILLED: u8 = 0x12;
+pub(crate) const STATUS_ALREADY_PAIRED: u8 = 0x13;
+
+/// A controller's status as the management interface reports it (Linux's
+/// `mgmt_status`).
+pub(crate) fn status_of_hci(status: u8) -> u8 {
+    match status {
+        0x00 => STATUS_SUCCESS,
+        0x01 => STATUS_UNKNOWN_COMMAND,
+        0x02 => STATUS_NOT_CONNECTED,
+        0x04 | 0x3e => STATUS_CONNECT_FAILED,
+        0x05 | 0x06 => STATUS_AUTH_FAILED,
+        0x07 | 0x09 | 0x0a => STATUS_NO_RESOURCES,
+        0x08 | 0x10 | 0x22 => STATUS_TIMEOUT,
+        0x0b => STATUS_ALREADY_CONNECTED,
+        0x0c => STATUS_BUSY,
+        0x0d..=0x0f | 0x18 => STATUS_REJECTED,
+        0x11 => STATUS_NOT_SUPPORTED,
+        0x12 => STATUS_INVALID_PARAMS,
+        0x13..=0x16 => STATUS_DISCONNECTED,
+        _ => STATUS_FAILED,
+    }
+}
+
+// Address types.
+pub(crate) const ADDR_BREDR: u8 = 0x00;
+pub(crate) const ADDR_LE_PUBLIC: u8 = 0x01;
+pub(crate) const ADDR_LE_RANDOM: u8 = 0x02;
+/// Discovery kinds: bit 0 BR/EDR, bits 1 and 2 LE.
+pub(crate) const ADDR_BREDR_BIT: u8 = 0x01;
+pub(crate) const ADDR_LE_BITS: u8 = 0x06;
+
+// `MGMT_EV_DEVICE_FOUND` flags.
+pub(crate) const FOUND_CONFIRM_NAME: u32 = 0x01;
+pub(crate) const FOUND_LEGACY_PAIRING: u32 = 0x02;
+pub(crate) const FOUND_NOT_CONNECTABLE: u32 = 0x04;
+pub(crate) const FOUND_NAME_REQUEST_FAILED: u32 = 0x10;
+pub(crate) const FOUND_SCAN_RSP: u32 = 0x20;
+
+pub(crate) mod settings {
+    pub(crate) const POWERED: u32 = 1 << 0;
+    pub(crate) const CONNECTABLE: u32 = 1 << 1;
+    pub(crate) const FAST_CONNECTABLE: u32 = 1 << 2;
+    pub(crate) const DISCOVERABLE: u32 = 1 << 3;
+    pub(crate) const BONDABLE: u32 = 1 << 4;
+    pub(crate) const LINK_SECURITY: u32 = 1 << 5;
+    pub(crate) const SSP: u32 = 1 << 6;
+    pub(crate) const BREDR: u32 = 1 << 7;
+    pub(crate) const LE: u32 = 1 << 9;
+    pub(crate) const ADVERTISING: u32 = 1 << 10;
+    pub(crate) const SECURE_CONN: u32 = 1 << 11;
+    /// Not settings of their own, kept beside them and never reported:
+    /// connectable advertising (`MGMT_OP_SET_ADVERTISING` 2), Secure
+    /// Connections only (`MGMT_OP_SET_SECURE_CONN` 2).
+    pub(crate) const ADV_CONNECTABLE: u32 = 1 << 31;
+    pub(crate) const SC_ONLY: u32 = 1 << 30;
+    /// bluetoothd resolves private addresses (it loaded the identity keys):
+    /// pairing asks for the device's.
+    pub(crate) const RPA_RESOLVING: u32 = 1 << 29;
+    pub(crate) const HIDDEN: u32 = ADV_CONNECTABLE | SC_ONLY | RPA_RESOLVING;
+}
+
+// `MGMT_ADV_FLAG_*`.
+pub(crate) const ADV_FLAG_CONNECTABLE: u32 = 1 << 0;
+pub(crate) const ADV_FLAG_DISCOV: u32 = 1 << 1;
+pub(crate) const ADV_FLAG_LIMITED_DISCOV: u32 = 1 << 2;
+pub(crate) const ADV_FLAG_MANAGED_FLAGS: u32 = 1 << 3;
+pub(crate) const ADV_FLAG_TX_POWER: u32 = 1 << 4;
+pub(crate) const ADV_FLAG_APPEARANCE: u32 = 1 << 5;
+pub(crate) const ADV_FLAG_LOCAL_NAME: u32 = 1 << 6;
+/// What the advertisement of `MGMT_OP_SET_ADVERTISING` carries.
+pub(crate) const ADV_FLAGS_INSTANCE_0: u32 = ADV_FLAG_MANAGED_FLAGS | ADV_FLAG_LOCAL_NAME | ADV_FLAG_APPEARANCE;
+const ADV_SUPPORTED_FLAGS: u32 = ADV_FLAG_CONNECTABLE
+    | ADV_FLAG_DISCOV
+    | ADV_FLAG_LIMITED_DISCOV
+    | ADV_FLAG_MANAGED_FLAGS
+    | ADV_FLAG_TX_POWER
+    | ADV_FLAG_APPEARANCE
+    | ADV_FLAG_LOCAL_NAME;
+/// Legacy advertising data and scan responses.
+const ADV_DATA_MAX: usize = 31;
+
+#[allow(dead_code)]
+pub(crate) mod op {
