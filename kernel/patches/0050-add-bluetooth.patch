index 0000000..49dc971
--- /dev/null
+++ b/kernel/comps/bluetooth/src/realtek.rs
@@ -0,0 +1,317 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Realtek controllers: the patch they run on top of their ROM, as Linux's
+//! `btrtl` loads it from `/lib/firmware/rtl_bt`.
+//!
+//! The chip is known by its LMP subversion, HCI revision and version. Its
+//! file is an "epatch": the older layout ("Realtech": one patch per ROM
+//! version) or the newer one ("RTBTCore": sections of subsections per ROM
+//! version, ordered by priority, with security headers per key). The patch,
+//! with the chip's configuration after it, goes to the controller in
+//! numbered fragments of 252 bytes. A controller that already runs a patch
+//! (a warm reboot) is told to drop it first.
+
+use alloc::{vec, vec::Vec};
+
+use crate::{
+    device::{CommandError, Device},
+    hci,
+};
+
+const OP_DOWNLOAD: u16 = 0xfc20;
+const OP_READ_REG16: u16 = 0xfc61;
+const OP_DROP_FIRMWARE: u16 = 0xfc66;
+const OP_READ_ROM_VERSION: u16 = 0xfc6d;
+
+/// Registers read with `OP_READ_REG16`.
+const CHIP_SUBVER: [u8; 5] = [0x10, 0x38, 0x04, 0x28, 0x80];
+const CHIP_REV: [u8; 5] = [0x10, 0x3a, 0x04, 0x28, 0x80];
+const SEC_PROJ: [u8; 5] = [0x10, 0xa4, 0xad, 0x00, 0xb0];
+
+const LMP_8723A: u16 = 0x1200;
+const LMP_8723B: u16 = 0x8723;
+const LMP_8821A: u16 = 0x8821;
+const LMP_8761A: u16 = 0x8761;
+const LMP_8822B: u16 = 0x8822;
+const LMP_8852A: u16 = 0x8852;
+const LMP_8851B: u16 = 0x8851;
+const LMP_8922A: u16 = 0x8922;
+const LMP_8703B: u16 = 0x8703;
+
+const FRAGMENT: usize = 252;
+
+/// A chip on USB: what identifies it, its files, whether its ROM version
+/// picks the patch, whether it needs its configuration.
+pub(crate) struct Chip {
+    pub lmp_subver: u16,
+    pub hci_rev: u16,
+    pub hci_ver: u8,
+    pub firmware: &'static str,
+    pub config: &'static str,
+    pub config_needed: bool,
+    pub has_rom_version: bool,
+}
+
+const fn chip(lmp_subver: u16, hci_rev: u16, hci_ver: u8, firmware: &'static str, config: &'static str, config_needed: bool, has_rom_version: bool) -> Chip {
+    Chip { lmp_subver, hci_rev, hci_ver, firmware, config, config_needed, has_rom_version }
+}
+
+/// Linux's table, for USB.
+pub(crate) const CHIPS: &[Chip] = &[
+    chip(LMP_8723A, 0xb, 0x6, "rtl_bt/rtl8723a_fw", "", false, false),
+    chip(LMP_8723B, 0xb, 0x6, "rtl_bt/rtl8723b_fw", "rtl_bt/rtl8723b_config", false, true),
+    chip(LMP_8723B, 0xd, 0x8, "rtl_bt/rtl8723d_fw", "rtl_bt/rtl8723d_config", true, true),
+    chip(LMP_8821A, 0xa, 0x6, "rtl_bt/rtl8821a_fw", "rtl_bt/rtl8821a_config", false, true),
+    chip(LMP_8821A, 0xc, 0x8, "rtl_bt/rtl8821c_fw", "rtl_bt/rtl8821c_config", false, true),
+    chip(LMP_8761A, 0xa, 0x6, "rtl_bt/rtl8761a_fw", "rtl_bt/rtl8761a_config", false, true),
+    chip(LMP_8761A, 0xb, 0xa, "rtl_bt/rtl8761bu_fw", "rtl_bt/rtl8761bu_config", false, true),
+    chip(LMP_8822B, 0xc, 0xa, "rtl_bt/rtl8822cu_fw", "rtl_bt/rtl8822cu_config", false, true),
+    chip(LMP_8822B, 0xb, 0x7, "rtl_bt/rtl8822b_fw", "rtl_bt/rtl8822b_config", true, true),
+    chip(LMP_8852A, 0xa, 0xb, "rtl_bt/rtl8852au_fw", "rtl_bt/rtl8852au_config", false, true),
+    chip(LMP_8852A, 0xb, 0xb, "rtl_bt/rtl8852bu_fw", "rtl_bt/rtl8852bu_config", false, true),
+    chip(LMP_8852A, 0xc, 0xc, "rtl_bt/rtl8852cu_fw", "rtl_bt/rtl8852cu_config", false, true),
+    chip(LMP_8851B, 0xb, 0xc, "rtl_bt/rtl8851bu_fw", "rtl_bt/rtl8851bu_config", false, true),
+    chip(LMP_8922A, 0xa, 0xc, "rtl_bt/rtl8922au_fw", "rtl_bt/rtl8922au_config", false, true),
+    chip(LMP_8852A, 0x87, 0xc, "rtl_bt/rtl8852btu_fw", "rtl_bt/rtl8852btu_config", false, true),
+];
+
+pub(crate) fn find_chip(lmp_subver: u16, hci_rev: u16, hci_ver: u8) -> Option<&'static Chip> {
+    CHIPS.iter().find(|chip| chip.lmp_subver == lmp_subver && chip.hci_rev == hci_rev && chip.hci_ver == hci_ver)
+}
+
+/// The LMP subversion each project id in a patch file is for.
+const PROJECTS: &[(u8, u16)] = &[
+    (0, LMP_8723A), (1, LMP_8723B), (2, LMP_8821A), (3, LMP_8761A), (7, LMP_8703B),
+    (8, LMP_8822B), (9, LMP_8723B), (10, LMP_8821A), (13, LMP_8822B), (14, LMP_8761A),
+    (18, LMP_8852A), (20, LMP_8852A), (25, LMP_8852A), (36, LMP_8851B), (44, LMP_8922A),
+    (47, LMP_8852A),
+];
+
+const SIGNATURE_V1: &[u8; 8] = b"Realtech";
+const SIGNATURE_V2: &[u8; 8] = b"RTBTCore";
+const EXTENSION_SIGNATURE: [u8; 4] = [0x51, 0x04, 0xfd, 0x77];
+
+/// The patch for a chip of `lmp_subver` with ROM version `rom_version`
+/// (and security key `key_id`) out of an epatch file.
+pub(crate) fn patch(file: &[u8], lmp_subver: u16, rom_version: u8, key_id: u8) -> Result<Vec<u8>, &'static str> {
+    let le16 = |at: usize| file.get(at..at + 2).map(|b| u16::from_le_bytes([b[0], b[1]]));
+    let le32 = |at: usize| file.get(at..at + 4).map(|b| u32::from_le_bytes(b.try_into().unwrap()));
+    let v2 = file.starts_with(SIGNATURE_V2);
+    if !v2 && !file.starts_with(SIGNATURE_V1) {
+        return Err("the patch has no epatch signature");
+    }
+    let header = if v2 { 20 } else { 14 };
+    if file.len() < header + 4 + 3 || file[file.len() - 4..] != EXTENSION_SIGNATURE {
+        return Err("the patch's extension section is missing");
+    }
+    // The instructions at the end, read backwards, name the project.
+    let mut at = file.len() - 4;
+    let mut project = None;
+    while at >= header + 3 {
+        let (opcode, length, data) = (file[at - 1], file[at - 2], file[at - 3]);
+        at -= 3;
+        if opcode == 0xff {
+            break;
+        }
+        if length == 0 {
+            return Err("a patch instruction has no length");
+        }
+        if opcode == 0 && length == 1 {
+            project = Some(data);
+            break;
+        }
+        at = at.checked_sub(length as usize).ok_or("a patch instruction is cut short")?;
+    }
+    let project = project.ok_or("the patch names no project")?;
+    let for_lmp = PROJECTS.iter().find(|(id, _)| *id == project).map(|(_, lmp)| *lmp).ok_or("the patch's project is unknown")?;
+    if for_lmp != lmp_subver {
+        return Err("the patch is for another chip");
+    }
+    if v2 {
+        return patch_v2(&file[..file.len() - 7], rom_version, key_id);
+    }
+    // One patch per ROM version: chip ids, lengths, offsets.
+    let count = le16(12).ok_or("the patch is cut short")? as usize;
+    let lengths = 14 + 2 * count;
+    let offsets = lengths + 2 * count;
+    if file.len() < offsets + 4 * count {
+        return Err("the patch is cut short");
+    }
+    let index = (0..count)
+        .find(|index| le16(14 + 2 * index) == Some(u16::from(rom_version) + 1))
+        .ok_or("the patch has nothing for this ROM version")?;
+    let length = le16(lengths + 2 * index).unwrap() as usize;
+    let offset = le32(offsets + 4 * index).unwrap() as usize;
+    if offset == 0 || length < 4 || offset + length > file.len() {
+        return Err("the patch's entry is out of the file");
+    }
+    // The patch with the file's version in its last four bytes.
+    let mut patch = file[offset..offset + length - 4].to_vec();
+    patch.extend_from_slice(&file[8..12]);
+    Ok(patch)
+}
+
+/// The newer layout: sections (snippets, dummy and security headers) of
+/// subsections for each ROM version, joined in order of priority.
+fn patch_v2(file: &[u8], rom_version: u8, key_id: u8) -> Result<Vec<u8>, &'static str> {
+    let le32 = |at: usize| file.get(at..at + 4).map(|b| u32::from_le_bytes(b.try_into().unwrap()));
+    let sections = le32(16).ok_or("the patch is cut short")?;
+    let mut at = 20;
+    // (priority, data) in the order Linux keeps them.
+    let mut pieces: Vec<(u8, &[u8])> = Vec::new();
+    for _ in 0..sections {
+        let (Some(opcode), Some(length)) = (le32(at), le32(at + 4)) else { break };
+        let length = length as usize;
+        let data_at = at + 8;
+        if data_at + length > file.len() {
+            break;
+        }
+        at = data_at + length;
+        let wanted = match opcode {
+            0x01 | 0x02 => true,
+            0x03 => key_id != 0,
+            _ => false,
+        };
+        if !wanted {
+            continue;
+        }
+        let section = &file[data_at..data_at + length];
+        let count = le16_at(section, 0).ok_or("a patch section is cut short")?;
+        let mut sub = 4;
+        for _ in 0..count {
+            let Some(header) = section.get(sub..sub + 8) else { break };
+            let (eco, priority, key) = (header[0], header[1], header[2]);
+            let sub_length = u32::from_le_bytes(header[4..8].try_into().unwrap()) as usize;
+            let Some(data) = section.get(sub + 8..sub + 8 + sub_length) else { break };
+            sub += 8 + sub_length;
+            if eco != rom_version.wrapping_add(1) || (opcode == 0x03 && key != key_id) {
+                continue;
+            }
+            // Before the first piece of the same priority or higher.
+            let position = pieces.iter().position(|(other, _)| *other >= priority).unwrap_or(pieces.len());
+            pieces.insert(position, (priority, data));
+        }
+    }
+    if pieces.is_empty() {
+        return Err("the patch has nothing for this ROM version");
+    }
+    Ok(pieces.iter().flat_map(|(_, data)| data.iter().copied()).collect())
+}
+
+fn le16_at(bytes: &[u8], at: usize) -> Option<u16> {
+    bytes.get(at..at + 2).map(|b| u16::from_le_bytes([b[0], b[1]]))
+}
+
+/// The download fragments' index bytes: 0 to 0x7f, then 1 to 0x7f again,
+/// the last with 0x80.
+pub(crate) fn fragment_indexes(count: usize) -> Vec<u8> {
+    let mut indexes = Vec::with_capacity(count);
+    let mut next = 0u8;
+    for fragment in 0..count {
+        let mut index = next;
+        next = if next == 0x7f { 1 } else { next + 1 };
+        if fragment == count - 1 {
+            index |= 0x80;
+        }
+        indexes.push(index);
+    }
+    indexes
+}
+
+fn read_reg16(device: &Device, register: &[u8; 5]) -> Result<u16, CommandError> {
+    let reply = device.command(OP_READ_REG16, register)?;
+    le16_at(&reply, 0).ok_or(CommandError::Status(hci::STATUS_UNKNOWN_COMMAND))
+}
+
+/// Sets a Realtek controller up.
+pub(crate) fn setup(device: &Device) -> Result<(), CommandError> {
+    let mut dropped = false;
+    let (chip, lmp_subver) = loop {
+        let mut forced = None;
+        if read_reg16(device, &CHIP_SUBVER)? == LMP_8822B && read_reg16(device, &CHIP_REV)? == 0x000e {
+            // The 8822E answers as an 8822C.
+            forced = find_chip(LMP_8822B, 0xc, 0xa);
+        }
+        let version = device.command(hci::OP_READ_LOCAL_VERSION, &[])?;
+        if version.len() < 8 {
+            return Err(CommandError::Status(hci::STATUS_UNKNOWN_COMMAND));
+        }
+        let hci_ver = version[0];
+        let hci_rev = u16::from_le_bytes([version[1], version[2]]);
+        let lmp_subver = u16::from_le_bytes([version[6], version[7]]);
+        let chip = forced.or_else(|| find_chip(lmp_subver, hci_rev, hci_ver));
+        ostd::notice!(
+            "hci{}: Realtek: hci_ver {hci_ver:#04x} hci_rev {hci_rev:#06x} lmp_subver {lmp_subver:#06x}",
+            device.index
+        );
+        match chip {
+            Some(chip) => break (chip, chip.lmp_subver),
+            // Running a patch already: drop it and look again, once.
+            None if !dropped => {
+                dropped = true;
+                device.send_command(OP_DROP_FIRMWARE, &[]);
+                crate::sleep_ms(200);
+            }
+            None => {
+                ostd::notice!("hci{}: Realtek: an unknown chip, run as it is", device.index);
+                return Ok(());
+            }
+        }
+    };
+    let rom_version = if chip.has_rom_version {
+        let reply = device.command(OP_READ_ROM_VERSION, &[])?;
+        *reply.first().ok_or(CommandError::Status(hci::STATUS_UNKNOWN_COMMAND))?
+    } else {
+        0
+    };
+    let key_id = (read_reg16(device, &SEC_PROJ)? & 0xff) as u8;
+    let file = (lmp_subver == LMP_8852A && chip.hci_rev == 0xc)
+        .then(|| aster_firmware::try_load(&alloc::format!("{}_v2.bin", chip.firmware)))
+        .flatten()
+        .or_else(|| aster_firmware::load(&alloc::format!("{}.bin", chip.firmware)));
+    let Some(file) = file else {
+        ostd::warn!("hci{}: Realtek: firmware {}.bin is missing", device.index, chip.firmware);
+        return Err(CommandError::Gone);
+    };
+    let mut data = if lmp_subver == LMP_8723A {
+        if file.starts_with(SIGNATURE_V1) {
+            return Err(CommandError::Gone);
+        }
+        file.to_vec()
+    } else {
+        patch(&file, lmp_subver, rom_version, key_id).map_err(|reason| {
+            ostd::warn!("hci{}: Realtek: {}.bin: {reason}", device.index, chip.firmware);
+            CommandError::Gone
+        })?
+    };
+    // The configuration follows the patch (none with a security key).
+    if !chip.config.is_empty() && key_id == 0 {
+        match aster_firmware::try_load(&alloc::format!("{}.bin", chip.config)) {
+            Some(config) => data.extend_from_slice(&config),
+            None if chip.config_needed => {
+                ostd::warn!("hci{}: Realtek: configuration {}.bin is missing", device.index, chip.config);
+                return Err(CommandError::Gone);
+            }
+            None => {}
+        }
+    }
+    let count = data.len() / FRAGMENT + 1;
+    for (fragment, index) in fragment_indexes(count).into_iter().enumerate() {
+        let start = fragment * FRAGMENT;
+        let end = if fragment == count - 1 { start + data.len() % FRAGMENT } else { start + FRAGMENT };
+        let mut params = vec![index];
+        params.extend_from_slice(&data[start..end]);
+        device.command(OP_DOWNLOAD, &params)?;
+    }
+    let version = device.command(hci::OP_READ_LOCAL_VERSION, &[])?;
+    if version.len() >= 8 {
+        ostd::notice!(
+            "hci{}: Realtek: patch {} loaded, version {:04x}{:04x}",
+            device.index,
+            chip.firmware,
+            u16::from_le_bytes([version[1], version[2]]),
+            u16::from_le_bytes([version[6], version[7]])
+        );
+    }
+    Ok(())
+}
diff --git a/kernel/comps/bluetooth/src/rfcomm.rs b/kernel/comps/bluetooth/src/rfcomm.rs
new file mode 100755
index 0000000..29744c0
--- /dev/null
+++ b/kernel/comps/bluetooth/src/rfcomm.rs
@@ -0,0 +1,1151 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! RFCOMM, as Linux's `rfcomm/core.c` runs it: serial ports (TS 07.10's
+//! multiplexer) on an L2CAP channel to PSM 3 of a device, one session per
+//! device, a channel (DLC) per connection. bluetoothd's profiles listen on
+//! RFCOMM channels and connect them (hands-free and headset control,
+//! serial ports, dial-up, OBEX), and hand the sockets to the audio servers
+//! and obexd. Flow control is credit-based, as every device since Bluetooth
+//! 1.1 has it; without it, by the modem status' flow bit.
+//!
+//! A session runs in one place at a time ([`Session::run`]): the frames
+//! that came, what the programs asked for, the data to send; what asks
+//! while it runs leaves it more to do. Lock order: the sessions, a
+//! session's lock; no socket's lock under it, nothing sent under either.
+
+use alloc::{
+    collections::VecDeque,
+    sync::{Arc, Weak},
+    vec::Vec,
+};
+use core::sync::atomic::{AtomicBool, Ordering};
+
+use ostd::sync::{LocalIrqDisabled, SpinLock};
+
+use crate::{
+    device::Device,
+    device_at, l2cap,
+    link::SECURITY_LOW,
+    pairing,
+    proto::{self, Address, BDADDR_BREDR, Phase, ProtoSocket, Protocol},
+};
+
+/// RFCOMM's PSM.
+const PSM: u16 = 0x0003;
+/// The L2CAP MTU a session takes (Linux's `RFCOMM_MAX_L2CAP_MTU`).
+const L2CAP_MTU: u16 = 1013;
+/// A frame's header and check sequence (data frames carry no credits).
+const OVERHEAD: u16 = 5;
+/// A channel's frame size until it is negotiated (TS 07.10's N1).
+const DEFAULT_MTU: u16 = 127;
+const MAX_CHANNEL: u8 = 30;
+
+/// Frame types (the control field, without the poll/final bit).
+const SABM: u8 = 0x2f;
+const UA: u8 = 0x63;
+const DM: u8 = 0x0f;
+const DISC: u8 = 0x43;
+const UIH: u8 = 0xef;
+const PF: u8 = 0x10;
+
+/// Multiplexer commands, on DLCI 0.
+const MCC_PN: u8 = 0x20;
+const MCC_TEST: u8 = 0x08;
+const MCC_FCON: u8 = 0x28;
+const MCC_FCOFF: u8 = 0x18;
+const MCC_MSC: u8 = 0x38;
+const MCC_NSC: u8 = 0x04;
+const MCC_RPN: u8 = 0x24;
+const MCC_RLS: u8 = 0x14;
+
+/// Credit-based flow control, asked for and granted (PN's CL field).
+const CFC_REQUEST: u8 = 0xf0;
+const CFC_GRANT: u8 = 0xe0;
+/// A channel's priority (PN), as Linux gives it.
+const PRIORITY: u8 = 7;
+/// The credits the device starts with, those we keep it having, and how
+/// few it may have before it gets more...
+const INITIAL_CREDITS: u8 = 7;
+const RX_CREDITS: u16 = 16;
+const RX_REFILL: u16 = 8;
+/// ... unless the program has this many messages left to read.
+const RX_BACKLOG: usize = 64;
+/// Bytes a channel holds to send; past them a sender waits.
+const TX_LIMIT: usize = 32 * 1024;
+
+/// Modem status (V.24) signals: extension, flow control, ready to
+/// communicate, ready to receive, data valid.
+const V24_EA: u8 = 0x01;
+const V24_FC: u8 = 0x02;
+const V24_RTC: u8 = 0x04;
+const V24_RTR: u8 = 0x08;
+const V24_DV: u8 = 0x80;
+const V24_DEFAULT: u8 = V24_EA | V24_RTC | V24_RTR | V24_DV;
+
+/// Linux's errno values.
+const EAGAIN: i32 = 11;
+const EACCES: i32 = 13;
+const EBUSY: i32 = 16;
+const EINVAL: i32 = 22;
+const EPIPE: i32 = 32;
+const ECONNRESET: i32 = 104;
+const ENOTCONN: i32 = 107;
+const ECONNREFUSED: i32 = 111;
+const EHOSTUNREACH: i32 = 113;
+const EINPROGRESS: i32 = 115;
+
+/// TS 07.10's frame check sequence: CRC-8 (reflected 0x07).
+fn fcs(bytes: &[u8]) -> u8 {
+    let mut crc = 0xffu8;
+    for byte in bytes {
+        crc ^= byte;
+        for _ in 0..8 {
+            crc = if crc & 1 != 0 { (crc >> 1) ^ 0xe0 } else { crc >> 1 };
+        }
+    }
+    0xff - crc
+}
+
+/// A frame's address: its DLCI, command or response.
+fn address(cr: bool, dlci: u8) -> u8 {
+    (dlci << 2) | ((cr as u8) << 1) | 0x01
+}
+
+fn build(address: u8, control: u8, credits: Option<u8>, info: &[u8]) -> Vec<u8> {
+    let mut frame = Vec::with_capacity(6 + info.len());
+    frame.push(address);
+    frame.push(control);
+    let length = info.len();
+    if length <= 0x7f {
+        frame.push(((length << 1) | 0x01) as u8);
+    } else {
+        frame.push(((length & 0x7f) << 1) as u8);
+        frame.push((length >> 7) as u8);
+    }
+    // Data frames check their address and control; the others, their
+    // length too.
+    let checked = if control & !PF == UIH { 2 } else { frame.len() };
+    let check = fcs(&frame[..checked]);
+    if let Some(credits) = credits {
+        frame.push(credits);
+    }
+    frame.extend_from_slice(info);
+    frame.push(check);
+    frame
+}
+
+/// PN's value: DLCI, flow control, priority, timer, frame size,
+/// retransmissions, credits.
+fn pn_value(dlci: u8, cl: u8, priority: u8, mtu: u16, credits: u8) -> [u8; 8] {
+    let mtu = mtu.to_le_bytes();
+    [dlci, cl, priority, 0, mtu[0], mtu[1], 0, credits]
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Stage {
+    /// The L2CAP channel is being made.
+    Connecting,
+    /// Ours: our SABM on the control channel is out. The device's: its
+    /// SABM is to come.
+    Starting,
+    Open,
+    /// Our DISC on the control channel is out (the last channel went).
+    Closing,
+    Closed,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum DlcStage {
+    /// Ours: waiting for the session.
+    WaitSession,
+    /// Waiting for the link's security.
+    WaitSecurity,
+    /// Ours: our PN is out.
+    WaitPn,
+    /// Ours: our SABM is out.
+    WaitUa,
+    /// The device's: configured (its PN), its SABM to come.
+    Configured,
+    /// The device's: the program has yet to take it (`BT_DEFER_SETUP`).
+    Deferred,
+    Open,
+    /// Our DISC is out.
+    Closing,
+}
+
+struct Dlc {
+    dlci: u8,
+    socket: Weak<ProtoSocket>,
+    /// The device's: the listener it goes to.
+    listener: Weak<ProtoSocket>,
+    stage: DlcStage,
+    incoming: bool,
+    /// The security it needs.
+    security: u8,
+    mtu: u16,
+    /// Credit-based flow control, and the credits each way.
+    cfc: bool,
+    tx_credits: u16,
+    rx_credits: u16,
+    /// Data to send, in frames' worth.
+    tx: VecDeque<Vec<u8>>,
+    tx_bytes: usize,
+    /// A sender waits for room.
+    tx_waiting: bool,
+    /// Modem status: ours answered, theirs came; their flow bit.
+    msc_out: bool,
+    msc_in: bool,
+    remote_fc: bool,
+    /// The program closed it: its DISC goes once its data has.
+    close: bool,
+    /// The program took the deferred connection.
+    accept: bool,
+    /// How the link's security went, once it did.
+    secured: Option<bool>,
+}
+
+impl Dlc {
+    fn new(dlci: u8, incoming: bool, security: u8) -> Self {
+        Self {
+            dlci,
+            socket: Weak::new(),
+            listener: Weak::new(),
+            stage: if incoming { DlcStage::Configured } else { DlcStage::WaitSession },
+            incoming,
+            security,
+            mtu: DEFAULT_MTU,
+            cfc: false,
+            tx_credits: 0,
+            rx_credits: 0,
+            tx: VecDeque::new(),
+            tx_bytes: 0,
+            tx_waiting: false,
+            msc_out: false,
+            msc_in: false,
+            remote_fc: false,
+            close: false,
+            accept: false,
+            secured: None,
+        }
+    }
+}
+
+struct State {
+    stage: Stage,
+    /// The longest information field the L2CAP channel takes.
+    mtu: u16,
+    /// Credit-based flow control, once a PN decided it.
+    cfc: Option<bool>,
+    /// The device stopped every channel (FCoff).
+    flow_off: bool,
+    dlcs: Vec<Dlc>,
+    /// Some channel was on it: it closes when the last goes.
+    used: bool,
+}
+
+/// A session: the RFCOMM multiplexer on an L2CAP channel to a device.
+pub(crate) struct Session {
+    device: u16,
+    address: [u8; 6],
+    /// We made it (its commands' C/R bit, the DLCIs' direction bit).
+    initiator: bool,
+    l2cap: Arc<ProtoSocket>,
+    state: SpinLock<State, LocalIrqDisabled>,
+    busy: AtomicBool,
+    again: AtomicBool,
+}
+
+/// A socket's channel: its session and DLCI.
+#[derive(Clone)]
+pub(crate) struct DlcRef {
+    pub(crate) session: Arc<Session>,
+    pub(crate) dlci: u8,
+}
+
+static SESSIONS: SpinLock<Vec<Arc<Session>>, LocalIrqDisabled> = SpinLock::new(Vec::new());
+/// The L2CAP listener on PSM 3 the devices' sessions come to.
+static LISTENER: SpinLock<Option<Arc<ProtoSocket>>, LocalIrqDisabled> = SpinLock::new(None);
+
+/// `sockaddr_l2` for PSM 3 of `address`.
+fn l2cap_address(address: [u8; 6]) -> Vec<u8> {
+    Address { address, address_type: BDADDR_BREDR, psm: PSM, cid: 0, channel: 0 }.to_bytes(Protocol::L2cap)
+}
+
+/// Ends a socket's connection.
+fn finish(socket: &Weak<ProtoSocket>, error: Option<i32>) {
+    let Some(socket) = socket.upgrade() else { return };
+    {
+        let mut state = socket.state.lock();
+        state.phase = Phase::Closed;
+        state.deferred = false;
+        if error.is_some() {
+            state.error = error;
+        }
+    }
+    socket.wake();
+}
+
+impl Session {
+    fn new(device: u16, address: [u8; 6], initiator: bool, l2cap: Arc<ProtoSocket>) -> Arc<Self> {
+        let session = Arc::new(Self {
+            device,
+            address,
+            initiator,
+            l2cap,
+            state: SpinLock::new(State {
+                stage: Stage::Connecting,
+                mtu: DEFAULT_MTU,
+                cfc: None,
+                flow_off: false,
+                dlcs: Vec::new(),
+                used: false,
+            }),
+            busy: AtomicBool::new(false),
+            again: AtomicBool::new(false),
+        });
+        let weak = Arc::downgrade(&session);
+        session.l2cap.set_notify(Arc::new(move || {
+            if let Some(session) = weak.upgrade() {
+                session.run();
+            }
+        }));
+        SESSIONS.lock().push(session.clone());
+        session
+    }
+
+    /// The link's handle, once the L2CAP channel has one.
+    pub(crate) fn handle(&self) -> Option<u16> {
+        self.l2cap.state.lock().channel.as_ref().map(|channel| channel.handle).filter(|handle| *handle != 0)
+    }
+
+    /// Runs the session: one caller at a time.
+    fn run(self: &Arc<Self>) {
+        self.again.store(true, Ordering::SeqCst);
+        loop {
+            if self.busy.swap(true, Ordering::SeqCst) {
+                return;
+            }
+            while self.again.swap(false, Ordering::SeqCst) {
+                self.step();
+            }
+            self.busy.store(false, Ordering::SeqCst);
+            if !self.again.load(Ordering::SeqCst) {
+                return;
+            }
+        }
+    }
+
+    fn step(self: &Arc<Self>) {
+        if self.state.lock().stage == Stage::Closed {
+            return;
+        }
+        let (phase, omtu) = {
+            let state = self.l2cap.state.lock();
+            (state.phase, state.channel.as_ref().map(|channel| channel.omtu))
+        };
+        if phase == Phase::Connected {
+            let started = {
+                let mut state = self.state.lock();
+                let started = state.stage == Stage::Connecting;
+                if started {
+                    state.mtu = omtu.unwrap_or(DEFAULT_MTU + OVERHEAD).min(L2CAP_MTU).max(DEFAULT_MTU + OVERHEAD) - OVERHEAD;
+                    state.stage = Stage::Starting;
+                }
+                started
+            };
+            if started && self.initiator {
+                self.command(SABM, 0);
+            }
+        }
+        // What came.
+        while let Ok(frame) = self.l2cap.recv(false, usize::MAX) {
+            if frame.is_empty() {
+                break;
+            }
+            self.receive(&frame);
+        }
+        if phase == Phase::Closed {
+            let error = self.l2cap.take_error().unwrap_or(ECONNRESET);
+            self.end(error);
+            return;
+        }
+        self.process();
+    }
+
+    fn send(&self, frame: Vec<u8>) {
+        let _ = self.l2cap.send(&frame);
+    }
+
+    fn command(&self, control: u8, dlci: u8) {
+        self.send(build(address(self.initiator, dlci), control | PF, None, &[]));
+    }
+
+    fn response(&self, control: u8, dlci: u8) {
+        self.send(build(address(!self.initiator, dlci), control | PF, None, &[]));
+    }
+
+    /// A multiplexer command or response.
+    fn mux(&self, kind: u8, command: bool, value: &[u8]) {
+        let mut info = Vec::with_capacity(2 + value.len());
+        info.push((kind << 2) | ((command as u8) << 1) | 0x01);
+        info.push(((value.len() << 1) | 0x01) as u8);
+        info.extend_from_slice(value);
+        self.send(build(address(self.initiator, 0), UIH, None, &info));
+    }
+
+    /// Our modem status on a channel.
+    fn msc(&self, dlci: u8) {
+        self.mux(MCC_MSC, true, &[address(true, dlci), V24_DEFAULT]);
+    }
+
+    fn receive(self: &Arc<Self>, frame: &[u8]) {
+        if frame.len() < 4 {
+            return;
+        }
+        let (address, control) = (frame[0], frame[1]);
+        let dlci = address >> 2;
+        // The information is what follows the header, as Linux takes it
+        // (whatever the length field says).
+        let header = if frame[2] & 0x01 != 0 { 3 } else { 4 };
+        let kind = control & !PF;
+        if frame.len() < header + 1 {
+            return;
+        }
+        let checked = if kind == UIH { 2 } else { header };
+        if fcs(&frame[..checked]) != frame[frame.len() - 1] {
+            return;
+        }
+        let info = &frame[header..frame.len() - 1];
+        match kind {
+            SABM => self.sabm(dlci),
+            UA => self.ua(dlci),
+            DM => self.dm(dlci),
+            DISC => self.disc(dlci),
+            UIH if dlci == 0 => self.control(info),
+            UIH => self.data(dlci, control & PF != 0, info),
+            _ => {}
+        }
+    }
+
+    fn find_listener(&self, channel: u8) -> Option<Arc<ProtoSocket>> {
+        let own = device_at(self.device)?.state.lock().info.address;
+        proto::sockets().into_iter().find(|socket| {
+            let state = socket.state.lock();
+            socket.protocol == Protocol::Rfcomm
+                && state.phase == Phase::Listening
+                && state.local.channel == channel
+                && (state.local.address == [0; 6] || state.local.address == own)
+        })
+    }
+
+    /// The device's channel, if one of our listeners takes it.
+    fn incoming(&self, dlci: u8) -> bool {
+        let Some(listener) = self.find_listener(dlci >> 1) else { return false };
+        let security = listener.state.lock().security;
+        let mut dlc = Dlc::new(dlci, true, security);
+        dlc.listener = Arc::downgrade(&listener);
+        let mut state = self.state.lock();
+        state.used = true;
+        state.dlcs.push(dlc);
+        true
+    }
+
+    fn sabm(self: &Arc<Self>, dlci: u8) {
+        if dlci == 0 {
+            let accepted = {
+                let mut state = self.state.lock();
+                let accepted = matches!(state.stage, Stage::Starting | Stage::Open);
+                if accepted {
+                    state.stage = Stage::Open;
+                }
+                accepted
+            };
+            self.response(if accepted { UA } else { DM }, 0);
+            return;
+        }
+        if self.state.lock().stage != Stage::Open {
+            self.response(DM, dlci);
+            return;
+        }
+        let known = self.state.lock().dlcs.iter().find(|dlc| dlc.dlci == dlci).map(|dlc| dlc.stage);
+        match known {
+            Some(DlcStage::Configured) => {}
+            Some(DlcStage::Open) => {
+                self.response(UA, dlci);
+                return;
+            }
+            Some(_) => {
+                self.response(DM, dlci);
+                return;
+            }
+            None => {
+                if !self.incoming(dlci) {
+                    self.response(DM, dlci);
+                    return;
+                }
+            }
+        }
+        // Its security first.
+        let security = {
+            let mut state = self.state.lock();
+            let Some(dlc) = state.dlcs.iter_mut().find(|dlc| dlc.dlci == dlci) else { return };
+            dlc.stage = DlcStage::WaitSecurity;
+            dlc.secured = None;
+            dlc.security
+        };
+        self.secure(dlci, security);
+    }
+
+    /// The link's security for a channel: there already, or asked for.
+    fn secure(self: &Arc<Self>, dlci: u8, level: u8) {
+        let (Some(device), Some(handle)) = (device_at(self.device), self.handle()) else { return };
+        if level <= l2cap::current_security(&device, handle).max(SECURITY_LOW) {
+            if let Some(dlc) = self.state.lock().dlcs.iter_mut().find(|dlc| dlc.dlci == dlci) {
+                dlc.secured = Some(true);
+            }
+            self.again.store(true, Ordering::SeqCst);
+        } else {
+            pairing::secure(&device, handle, level);
+        }
+    }
+
+    fn ua(self: &Arc<Self>, dlci: u8) {
+        if dlci == 0 {
+            let stage = {
+                let mut state = self.state.lock();
+                if state.stage == Stage::Starting && self.initiator {
+                    state.stage = Stage::Open;
+                }
+                state.stage
+            };
+            if stage == Stage::Closing {
+                self.end(ECONNRESET);
+            }
+            return;
+        }
+        let (stage, socket) = {
+            let mut state = self.state.lock();
+            let Some(index) = state.dlcs.iter().position(|dlc| dlc.dlci == dlci) else { return };
+            let stage = state.dlcs[index].stage;
+            match stage {
+                DlcStage::WaitUa => state.dlcs[index].stage = DlcStage::Open,
+                DlcStage::Closing => {
+                    state.dlcs.remove(index);
+                }
+                _ => {}
+            }
+            (stage, state.dlcs.get(index).map(|dlc| dlc.socket.clone()))
+        };
+        if stage == DlcStage::WaitUa {
+            if let Some(socket) = socket.and_then(|socket| socket.upgrade()) {
+                socket.state.lock().phase = Phase::Connected;
+                socket.wake();
+            }
+            self.msc(dlci);
+        }
+    }
+
+    /// Takes a channel off the session.
+    fn remove(&self, dlci: u8) -> Option<Dlc> {
+        let mut state = self.state.lock();
+        let index = state.dlcs.iter().position(|dlc| dlc.dlci == dlci)?;
+        Some(state.dlcs.remove(index))
+    }
+
+    fn dm(self: &Arc<Self>, dlci: u8) {
+        if dlci == 0 {
+            self.end(ECONNREFUSED);
+            return;
+        }
+        if let Some(dlc) = self.remove(dlci) {
+            let error = match dlc.stage {
+                DlcStage::Open => Some(ECONNRESET),
+                DlcStage::Closing => None,
+                _ => Some(ECONNREFUSED),
+            };
+            finish(&dlc.socket, error);
+        }
+    }
+
+    fn disc(self: &Arc<Self>, dlci: u8) {
+        if dlci == 0 {
+            self.response(UA, 0);
+            let connecting = self.state.lock().stage != Stage::Open;
+            self.end(if connecting { ECONNREFUSED } else { ECONNRESET });
+            return;
+        }
+        match self.remove(dlci) {
+            Some(dlc) => {
+                self.response(UA, dlci);
+                let error = match dlc.stage {
+                    DlcStage::Open => Some(ECONNRESET),
+                    DlcStage::Closing => None,
+                    _ => Some(ECONNREFUSED),
+                };
+                finish(&dlc.socket, error);
+            }
+            None => self.response(DM, dlci),
+        }
+    }
+
+    /// Data on a channel, and credits (`poll`, with credit-based flow).
+    fn data(self: &Arc<Self>, dlci: u8, poll: bool, mut info: &[u8]) {
+        let socket = {
+            let mut state = self.state.lock();
+            let Some(dlc) = state.dlcs.iter_mut().find(|dlc| dlc.dlci == dlci) else {
+                drop(state);
+                self.response(DM, dlci);
+                return;
+            };
+            if poll && dlc.cfc {
+                let Some((&credits, rest)) = info.split_first() else { return };
+                dlc.tx_credits = dlc.tx_credits.saturating_add(credits as u16);
+                info = rest;
+            }
+            if info.is_empty() || dlc.stage != DlcStage::Open {
+                return;
+            }
+            dlc.rx_credits = dlc.rx_credits.saturating_sub(1);
+            dlc.socket.upgrade().map(|socket| (socket, info.to_vec()))
+        };
+        if let Some((socket, data)) = socket {
+            socket.state.lock().rx.push_back(data);
+            socket.wake();
+        }
+    }
+
+    /// The multiplexer's commands and responses.
+    fn control(self: &Arc<Self>, info: &[u8]) {
+        if info.len() < 2 {
+            return;
+        }
+        let kind = info[0] >> 2;
+        let command = info[0] & 0x02 != 0;
+        let (length, start) = if info[1] & 0x01 != 0 {
+            ((info[1] >> 1) as usize, 2)
+        } else {
+            (((info[1] >> 1) as usize) | ((info.get(2).copied().unwrap_or(0) as usize) << 7), 3)
+        };
+        let Some(value) = info.get(start..start + length) else { return };
+        match kind {
+            MCC_PN => self.pn(command, value),
+            MCC_MSC => self.msc_received(command, value),
+            MCC_RPN if command => self.rpn(value),
+            MCC_RLS | MCC_TEST if command => self.mux(kind, false, value),
+            MCC_FCON | MCC_FCOFF if command => {
+                self.state.lock().flow_off = kind == MCC_FCOFF;
+                self.mux(kind, false, &[]);
+            }
+            _ if command => self.mux(MCC_NSC, false, &[info[0]]),
+            _ => {}
+        }
+    }
+
+    /// Parameter negotiation: the device configures a channel, or answers
+    /// our configuration.
+    fn pn(self: &Arc<Self>, command: bool, value: &[u8]) {
+        if value.len() < 8 {
+            return;
+        }
+        let dlci = value[0] & 0x3f;
+        let cl = value[1] & 0xf0;
+        let priority = value[2];
+        let mtu = u16::from_le_bytes([value[4], value[5]]);
+        let credits = value[7] as u16;
+        if command {
+            let known = self.state.lock().dlcs.iter().any(|dlc| dlc.dlci == dlci);
+            if !known && (dlci == 0 || !self.incoming(dlci)) {
+                self.response(DM, dlci);
+                return;
+            }
+        }
+        let answer = {
+            let mut state = self.state.lock();
+            let session_mtu = state.mtu;
+            let session_cfc = state.cfc;
+            let Some(dlc) = state.dlcs.iter_mut().find(|dlc| dlc.dlci == dlci) else { return };
+            if !command && dlc.stage != DlcStage::WaitPn {
+                return;
+            }
+            // As Linux takes it: asked for (unless the session went
+            // without), or granted.
+            let cfc = (cl == CFC_REQUEST && session_cfc != Some(false)) || cl == CFC_GRANT;
+            dlc.cfc = cfc;
+            dlc.tx_credits = if cfc { credits } else { 0 };
+            dlc.rx_credits = if cfc { INITIAL_CREDITS as u16 } else { 0 };
+            dlc.remote_fc = false;
+            dlc.mtu = if mtu == 0 { DEFAULT_MTU } else { mtu.min(session_mtu) };
+            let mtu = dlc.mtu;
+            if !command {
+                dlc.stage = DlcStage::WaitUa;
+            }
+            if state.cfc.is_none() {
+                state.cfc = Some(cfc);
+            }
+            (cfc, mtu)
+        };
+        if command {
+            let (cfc, mtu) = answer;
+            let credits = if cfc { INITIAL_CREDITS } else { 0 };
+            self.mux(MCC_PN, false, &pn_value(dlci, if cfc { CFC_GRANT } else { 0 }, priority, mtu, credits));
+        } else {
+            self.command(SABM, dlci);
+        }
+    }
+
+    fn msc_received(self: &Arc<Self>, command: bool, value: &[u8]) {
+        if value.len() < 2 {
+            return;
+        }
+        let dlci = value[0] >> 2;
+        {
+            let mut state = self.state.lock();
+            let Some(dlc) = state.dlcs.iter_mut().find(|dlc| dlc.dlci == dlci) else { return };
+            if command {
+                dlc.msc_in = true;
+                if !dlc.cfc {
+                    dlc.remote_fc = value[1] & V24_FC != 0;
+                }
+            } else {
+                dlc.msc_out = true;
+            }
+        }
+        if command {
+            self.mux(MCC_MSC, false, &value[..2]);
+        }
+    }
+
+    /// Port settings: taken as asked; a query hears a serial port's.
+    fn rpn(&self, value: &[u8]) {
+        let Some(&dlci_address) = value.first() else { return };
+        if value.len() >= 8 {
+            self.mux(MCC_RPN, false, &value[..8]);
+        } else {
+            // 9600 baud, 8 data bits, a stop bit, no parity, no flow
+            // control, XON and XOFF, every parameter.
+            self.mux(MCC_RPN, false, &[dlci_address, 0x03, 0x03, 0x00, 0x11, 0x13, 0x7f, 0x3f]);
+        }
+    }
+
+    /// The channels go on: what the programs asked for, what the session
+    /// allows.
+    fn process(self: &Arc<Self>) {
+        if self.state.lock().stage != Stage::Open {
+            // Those the programs gave up on before the session opened.
+            self.state.lock().dlcs.retain(|dlc| !(dlc.close && dlc.stage == DlcStage::WaitSession));
+            return;
+        }
+        let dlcis: Vec<u8> = self.state.lock().dlcs.iter().map(|dlc| dlc.dlci).collect();
+        for dlci in dlcis {
+            self.advance(dlci);
+        }
+        let idle = {
+            let mut state = self.state.lock();
+            let idle = state.used && state.dlcs.is_empty();
+            if idle {
+                state.stage = Stage::Closing;
+            }
+            idle
+        };
+        if idle {
+            self.command(DISC, 0);
+        }
+    }
+
+    fn advance(self: &Arc<Self>, dlci: u8) {
+        enum Next {
+            Nothing,
+            Remove,
+            Secure(u8),
+            Pn(u16),
+            Disc,
+            Dm,
+            Admit,
+            Refuse,
+            Accept,
+            Flow,
+        }
+        let next = {
+            let mut state = self.state.lock();
+            let session_mtu = state.mtu;
+            let Some(dlc) = state.dlcs.iter_mut().find(|dlc| dlc.dlci == dlci) else { return };
+            match (dlc.stage, dlc.close) {
+                (DlcStage::WaitSession | DlcStage::WaitSecurity | DlcStage::WaitPn | DlcStage::Configured, true) => {
+                    Next::Remove
+                }
+                (DlcStage::WaitUa, true) => {
+                    dlc.stage = DlcStage::Closing;
+                    Next::Disc
+                }
+                (DlcStage::Deferred, true) => Next::Dm,
+                (DlcStage::Open, true) if dlc.tx.is_empty() => {
+                    dlc.stage = DlcStage::Closing;
+                    Next::Disc
+                }
+                (DlcStage::WaitSession, false) => {
+                    dlc.stage = DlcStage::WaitSecurity;
+                    Next::Secure(dlc.security)
+                }
+                (DlcStage::WaitSecurity, false) => match dlc.secured.take() {
+                    Some(true) if dlc.incoming => Next::Admit,
+                    Some(true) => {
+                        dlc.stage = DlcStage::WaitPn;
+                        Next::Pn(session_mtu)
+                    }
+                    Some(false) if dlc.incoming => Next::Dm,
+                    Some(false) => Next::Refuse,
+                    None => Next::Nothing,
+                },
+                (DlcStage::Deferred, false) if dlc.accept => {
+                    dlc.accept = false;
+                    dlc.stage = DlcStage::Open;
+                    Next::Accept
+                }
+                (DlcStage::Open, _) => Next::Flow,
+                _ => Next::Nothing,
+            }
+        };
+        match next {
+            Next::Nothing => {}
+            Next::Remove => {
+                self.remove(dlci);
+            }
+            Next::Secure(level) => self.secure(dlci, level),
+            Next::Pn(mtu) => {
+                let cl = if self.state.lock().cfc == Some(false) { 0 } else { CFC_REQUEST };
+                self.mux(MCC_PN, true, &pn_value(dlci, cl, PRIORITY, mtu, INITIAL_CREDITS));
+            }
+            Next::Disc => self.command(DISC, dlci),
+            Next::Dm => {
+                if let Some(dlc) = self.remove(dlci) {
+                    finish(&dlc.socket, Some(ECONNREFUSED));
+                }
+                self.response(DM, dlci);
+            }
+            Next::Refuse => {
+                if let Some(dlc) = self.remove(dlci) {
+                    finish(&dlc.socket, Some(EACCES));
+                }
+            }
+            Next::Admit => self.admit(dlci),
+            Next::Accept => {
+                let socket = self.state.lock().dlcs.iter().find(|dlc| dlc.dlci == dlci).map(|dlc| dlc.socket.clone());
+                self.response(UA, dlci);
+                self.msc(dlci);
+                if let Some(socket) = socket.and_then(|socket| socket.upgrade()) {
+                    socket.state.lock().phase = Phase::Connected;
+                    socket.wake();
+                }
+            }
+            Next::Flow => self.flow(dlci),
+        }
+    }
+
+    /// The device's channel, secured: a connection for the listener, set
+    /// up now or when the program takes it (`BT_DEFER_SETUP`).
+    fn admit(self: &Arc<Self>, dlci: u8) {
+        let listener = self.state.lock().dlcs.iter().find(|dlc| dlc.dlci == dlci).and_then(|dlc| dlc.listener.upgrade());
+        let Some(listener) = listener else {
+            self.remove(dlci);
+            self.response(DM, dlci);
+            return;
+        };
+        let own = device_at(self.device).map_or([0; 6], |device| device.state.lock().info.address);
+        let defer = listener.state.lock().defer_setup;
+        let child = listener.child();
+        {
+            let mut state = child.state.lock();
+            state.local.address = own;
+            state.local.address_type = BDADDR_BREDR;
+            state.peer = Address { address: self.address, address_type: BDADDR_BREDR, psm: 0, cid: 0, channel: dlci >> 1 };
+            state.rfcomm = Some(DlcRef { session: self.clone(), dlci });
+            state.deferred = defer;
+            state.phase = if defer { Phase::Connecting } else { Phase::Connected };
+        }
+        if let Some(dlc) = self.state.lock().dlcs.iter_mut().find(|dlc| dlc.dlci == dlci) {
+            dlc.socket = Arc::downgrade(&child);
+            dlc.stage = if defer { DlcStage::Deferred } else { DlcStage::Open };
+        }
+        if !listener.offer(child.clone()) {
+            // The listener's queue is full.
+            child.state.lock().rfcomm = None;
+            self.remove(dlci);
+            self.response(DM, dlci);
+            return;
+        }
+        if !defer {
+            self.response(UA, dlci);
+            self.msc(dlci);
+        }
+    }
+
+    /// An open channel: its data goes while the device takes it; the
+    /// device gets credits while the program keeps up.
+    fn flow(self: &Arc<Self>, dlci: u8) {
+        let (frames, socket, wake, refill, closing) = {
+            let mut state = self.state.lock();
+            let stopped = state.flow_off;
+            let initiator = self.initiator;
+            let Some(dlc) = state.dlcs.iter_mut().find(|dlc| dlc.dlci == dlci) else { return };
+            let mut frames = Vec::new();
+            if dlc.msc_out && dlc.msc_in && !stopped {
+                while !dlc.tx.is_empty() {
+                    if (dlc.cfc && dlc.tx_credits == 0) || (!dlc.cfc && dlc.remote_fc) {
+                        break;
+                    }
+                    let chunk = dlc.tx.pop_front().unwrap();
+                    dlc.tx_bytes -= chunk.len();
+                    if dlc.cfc {
+                        dlc.tx_credits -= 1;
+                    }
+                    frames.push(build(address(initiator, dlci), UIH, None, &chunk));
+                }
+            }
+            let wake = dlc.tx_waiting && dlc.tx_bytes < TX_LIMIT;
+            if wake {
+                dlc.tx_waiting = false;
+            }
+            let refill = dlc.cfc && dlc.rx_credits <= RX_REFILL;
+            (frames, dlc.socket.upgrade(), wake, refill, dlc.close && dlc.tx.is_empty())
+        };
+        for frame in frames {
+            self.send(frame);
+        }
+        if let Some(socket) = socket {
+            if wake {
+                socket.wake();
+            }
+            if refill && socket.state.lock().rx.len() < RX_BACKLOG {
+                let credits = {
+                    let mut state = self.state.lock();
+                    let Some(dlc) = state.dlcs.iter_mut().find(|dlc| dlc.dlci == dlci) else { return };
+                    let credits = RX_CREDITS - dlc.rx_credits.min(RX_CREDITS);
+                    dlc.rx_credits = RX_CREDITS;
+                    credits
+                };
+                if credits > 0 {
+                    self.send(build(address(self.initiator, dlci), UIH | PF, Some(credits as u8), &[]));
+                }
+            }
+        }
+        if closing {
+            self.advance(dlci);
+        }
+    }
+
+    /// The session ended: its channels with it.
+    fn end(self: &Arc<Self>, error: i32) {
+        let dlcs = {
+            let mut state = self.state.lock();
+            if state.stage == Stage::Closed {
+                return;
+            }
+            state.stage = Stage::Closed;
+            core::mem::take(&mut state.dlcs)
+        };
+        SESSIONS.lock().retain(|session| !Arc::ptr_eq(session, self));
+        for dlc in dlcs {
+            let error = match dlc.stage {
+                DlcStage::Open => Some(ECONNRESET),
+                DlcStage::Closing => None,
+                _ => Some(error),
+            };
+            finish(&dlc.socket, error);
+        }
+        l2cap::close(&self.l2cap);
+    }
+}
+
+/// The session to a device: the one there is, or a new one we make.
+fn session_to(device: &Arc<Device>, address: [u8; 6]) -> Result<Arc<Session>, i32> {
+    let existing = SESSIONS.lock().iter().find(|session| {
+        session.device == device.index
+            && session.address == address
+            && matches!(session.state.lock().stage, Stage::Connecting | Stage::Starting | Stage::Open)
+    }).cloned();
+    if let Some(session) = existing {
+        return Ok(session);
+    }
+    let l2cap = ProtoSocket::new(Protocol::L2cap, proto::SOCK_SEQPACKET);
+    {
+        let mut state = l2cap.state.lock();
+        state.imtu = L2CAP_MTU;
+        state.local.address = device.state.lock().info.address;
+    }
+    let session = Session::new(device.index, address, true, l2cap.clone());
+    match l2cap.connect(&l2cap_address(address)) {
+        Ok(()) | Err(EINPROGRESS) => Ok(session),
+        Err(error) => {
+            session.end(error);
+            Err(error)
+        }
+    }
+}
+
+/// A socket connects to a device's channel (its peer set).
+pub(crate) fn connect(socket: &ProtoSocket) -> Result<(), i32> {
+    let socket = proto::arc_of(socket).ok_or(ENOTCONN)?;
+    let (local, peer, security) = {
+        let state = socket.state.lock();
+        (state.local, state.peer, state.security)
+    };
+    if peer.channel == 0 || peer.channel > MAX_CHANNEL {
+        return Err(EINVAL);
+    }
+    let device = l2cap::route(&local).ok_or(EHOSTUNREACH)?;
+    let own = device.state.lock().info.address;
+    let session = session_to(&device, peer.address)?;
+    // The device's channels are on DLCIs of its direction.
+    let dlci = (peer.channel << 1) | (!session.initiator) as u8;
+    {
+        let mut state = session.state.lock();
+        if state.dlcs.iter().any(|dlc| dlc.dlci == dlci) {
+            return Err(EBUSY);
+        }
+        let mut dlc = Dlc::new(dlci, false, security);
+        dlc.socket = Arc::downgrade(&socket);
+        state.used = true;
+        state.dlcs.push(dlc);
+    }
+    {
+        let mut state = socket.state.lock();
+        state.local.address = own;
+        // Its channel, as Linux names it on both ends.
+        state.local.channel = peer.channel;
+        state.rfcomm = Some(DlcRef { session: session.clone(), dlci });
+    }
+    session.run();
+    Ok(())
+}
+
+/// Data from the program: as much as the channel has room for.
+pub(crate) fn send(socket: &ProtoSocket, data: &[u8]) -> Result<usize, i32> {
+    let dlc = socket.state.lock().rfcomm.clone().ok_or(ENOTCONN)?;
+    let accepted = {
+        let mut state = dlc.session.state.lock();
+        let Some(entry) = state.dlcs.iter_mut().find(|entry| entry.dlci == dlc.dlci) else { return Err(EPIPE) };
+        if entry.close {
+            return Err(EPIPE);
+        }
+        let room = TX_LIMIT.saturating_sub(entry.tx_bytes);
+        if room == 0 {
+            entry.tx_waiting = true;
+            return Err(EAGAIN);
+        }
+        let accepted = data.len().min(room);
+        for chunk in data[..accepted].chunks(entry.mtu.max(1) as usize) {
+            entry.tx.push_back(chunk.to_vec());
+        }
+        entry.tx_bytes += accepted;
+        accepted
+    };
+    dlc.session.run();
+    Ok(accepted)
+}
+
+/// Whether a channel takes more data.
+pub(crate) fn writable(dlc: &DlcRef) -> bool {
+    dlc.session.state.lock().dlcs.iter().find(|entry| entry.dlci == dlc.dlci).is_none_or(|entry| entry.tx_bytes < TX_LIMIT)
+}
+
+/// The program read: the device may get credits again.
+pub(crate) fn read_done(dlc: &DlcRef) {
+    let starved = dlc.session.state.lock().dlcs.iter().find(|entry| entry.dlci == dlc.dlci).is_some_and(|entry| {
+        entry.stage == DlcStage::Open && entry.cfc && entry.rx_credits <= RX_REFILL
+    });
+    if starved {
+        dlc.session.run();
+    }
+}
+
+/// The program takes a deferred connection.
+pub(crate) fn accept_deferred(socket: &ProtoSocket) {
+    let Some(dlc) = socket.state.lock().rfcomm.clone() else { return };
+    if let Some(entry) = dlc.session.state.lock().dlcs.iter_mut().find(|entry| entry.dlci == dlc.dlci) {
+        if entry.stage == DlcStage::Deferred {
+            entry.accept = true;
+        }
+    }
+    dlc.session.run();
+}
+
+/// The program shuts a socket's channel.
+pub(crate) fn close(socket: &ProtoSocket) {
+    let dlc = {
+        let mut state = socket.state.lock();
+        if matches!(state.phase, Phase::Connecting | Phase::Connected) {
+            state.phase = Phase::Closed;
+        }
+        state.deferred = false;
+        state.rfcomm.take()
+    };
+    if let Some(dlc) = dlc {
+        dropped(dlc);
+    }
+}
+
+/// A channel whose socket is gone: it closes once its data is out.
+pub(crate) fn dropped(dlc: DlcRef) {
+    if let Some(entry) = dlc.session.state.lock().dlcs.iter_mut().find(|entry| entry.dlci == dlc.dlci) {
+        entry.close = true;
+        entry.socket = Weak::new();
+    }
+    dlc.session.run();
+}
+
+/// A program listens on an RFCOMM channel: the devices' sessions come to
+/// PSM 3.
+pub(crate) fn listen() {
+    let mut listener = LISTENER.lock();
+    if listener.is_some() {
+        return;
+    }
+    let socket = ProtoSocket::new(Protocol::L2cap, proto::SOCK_SEQPACKET);
+    socket.state.lock().imtu = L2CAP_MTU;
+    if socket.bind(&l2cap_address([0; 6]), true).is_err() || socket.listen(8).is_err() {
+        return;
+    }
+    let weak = Arc::downgrade(&socket);
+    socket.set_notify(Arc::new(move || {
+        if let Some(listener) = weak.upgrade() {
+            accept_sessions(&listener);
+        }
+    }));
+    *listener = Some(socket);
+}
+
+fn accept_sessions(listener: &Arc<ProtoSocket>) {
+    while let Ok(l2cap) = listener.accept() {
+        let (device, address) = {
+            let state = l2cap.state.lock();
+            (state.channel.as_ref().map(|channel| channel.device), state.peer.address)
+        };
+        let Some(device) = device else { continue };
+        let session = Session::new(device, address, false, l2cap);
+        session.run();
+    }
+}
+
+/// The link's security changed (`ok`: as asked): channels waiting for it
+/// go on, or fail.
+pub(crate) fn secured(device: &Device, handle: u16, ok: bool) {
+    let sessions: Vec<_> = SESSIONS.lock().iter().filter(|session| session.device == device.index).cloned().collect();
+    let current = l2cap::current_security(device, handle);
+    for session in sessions {
+        if session.handle() != Some(handle) {
+            continue;
+        }
+        let waiting = {
+            let mut state = session.state.lock();
+            let mut waiting = false;
+            for dlc in state.dlcs.iter_mut().filter(|dlc| dlc.stage == DlcStage::WaitSecurity && dlc.secured.is_none()) {
+                dlc.secured = Some(ok && current >= dlc.security);
+                waiting = true;
+            }
+            waiting
+        };
+        if waiting {
+            session.run();
+        }
+    }
+}
