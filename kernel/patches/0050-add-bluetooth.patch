+// SPDX-License-Identifier: MPL-2.0
+
+//! The management interface (`HCI_CHANNEL_CONTROL`), as Linux's
+//! `net/bluetooth/mgmt.c` serves it to bluetoothd: each command (opcode,
+//! controller index, parameters) gets a `Command Complete` or `Command
+//! Status` on the socket that sent it, and the events (a controller added,
+//! new settings, a device found...) go to every management socket.
+//!
+//! Version 1.22. This part covers what bluetoothd needs to bring a
+//! controller up and find devices: power, the scan settings, name, class
+//! and services, the keys it loads, discovery with names; connections and
+//! pairing answer "not connected" or "not supported" for now.
+
+use alloc::{
+    collections::VecDeque,
+    sync::{Arc, Weak},
+    vec,
+    vec::Vec,
+};
+use core::sync::atomic::{AtomicBool, Ordering};
+
