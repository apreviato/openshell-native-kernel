@@ -0,0 +1,182 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The Host Controller Interface: packet types, the commands this stack
+//! sends and the events it reads (Bluetooth Core Specification, vol. 4
+//! part E), with the few helpers to build and read them.
+
+#![allow(dead_code)]
+
+/// Packet types, as the transports (USB, UART, `/dev/vhci`) carry them.
+pub const COMMAND_PKT: u8 = 0x01;
+pub const ACL_PKT: u8 = 0x02;
+pub const SCO_PKT: u8 = 0x03;
+pub const EVENT_PKT: u8 = 0x04;
+pub const ISO_PKT: u8 = 0x05;
+pub const VENDOR_PKT: u8 = 0xff;
+
+const fn op(ogf: u16, ocf: u16) -> u16 {
+    (ogf << 10) | ocf
+}
+
+// Link control.
+pub const OP_INQUIRY: u16 = op(0x01, 0x0001);
+pub const OP_INQUIRY_CANCEL: u16 = op(0x01, 0x0002);
+pub const OP_CREATE_CONN: u16 = op(0x01, 0x0005);
+pub const OP_DISCONNECT: u16 = op(0x01, 0x0006);
+pub const OP_CREATE_CONN_CANCEL: u16 = op(0x01, 0x0008);
+pub const OP_ACCEPT_CONN_REQ: u16 = op(0x01, 0x0009);
+pub const OP_REJECT_CONN_REQ: u16 = op(0x01, 0x000a);
+pub const OP_LINK_KEY_REPLY: u16 = op(0x01, 0x000b);
+pub const OP_LINK_KEY_NEG_REPLY: u16 = op(0x01, 0x000c);
+pub const OP_PIN_CODE_REPLY: u16 = op(0x01, 0x000d);
+pub const OP_PIN_CODE_NEG_REPLY: u16 = op(0x01, 0x000e);
+pub const OP_AUTH_REQUESTED: u16 = op(0x01, 0x0011);
+pub const OP_SET_CONN_ENCRYPT: u16 = op(0x01, 0x0013);
+pub const OP_REMOTE_NAME_REQ: u16 = op(0x01, 0x0019);
+pub const OP_REMOTE_NAME_REQ_CANCEL: u16 = op(0x01, 0x001a);
+pub const OP_ADD_SCO: u16 = op(0x01, 0x0007);
+pub const OP_READ_REMOTE_FEATURES: u16 = op(0x01, 0x001b);
+pub const OP_SETUP_SYNC_CONN: u16 = op(0x01, 0x0028);
+pub const OP_ACCEPT_SYNC_CONN_REQ: u16 = op(0x01, 0x0029);
+pub const OP_REJECT_SYNC_CONN_REQ: u16 = op(0x01, 0x002a);
+pub const OP_READ_REMOTE_EXT_FEATURES: u16 = op(0x01, 0x001c);
+pub const OP_IO_CAPABILITY_REPLY: u16 = op(0x01, 0x002b);
+pub const OP_USER_CONFIRM_REPLY: u16 = op(0x01, 0x002c);
+pub const OP_USER_CONFIRM_NEG_REPLY: u16 = op(0x01, 0x002d);
+pub const OP_USER_PASSKEY_REPLY: u16 = op(0x01, 0x002e);
+pub const OP_USER_PASSKEY_NEG_REPLY: u16 = op(0x01, 0x002f);
+pub const OP_IO_CAPABILITY_NEG_REPLY: u16 = op(0x01, 0x0034);
+
+// Link policy.
+pub const OP_WRITE_DEF_LINK_POLICY: u16 = op(0x02, 0x000f);
+
+// Controller and baseband.
+pub const OP_SET_EVENT_MASK: u16 = op(0x03, 0x0001);
+pub const OP_RESET: u16 = op(0x03, 0x0003);
+pub const OP_DELETE_STORED_LINK_KEY: u16 = op(0x03, 0x0012);
+pub const OP_WRITE_LOCAL_NAME: u16 = op(0x03, 0x0013);
+pub const OP_READ_LOCAL_NAME: u16 = op(0x03, 0x0014);
+pub const OP_WRITE_PAGE_TIMEOUT: u16 = op(0x03, 0x0018);
+pub const OP_WRITE_SCAN_ENABLE: u16 = op(0x03, 0x001a);
+pub const OP_WRITE_AUTH_ENABLE: u16 = op(0x03, 0x0020);
+pub const OP_READ_CLASS_OF_DEV: u16 = op(0x03, 0x0023);
+pub const OP_WRITE_CLASS_OF_DEV: u16 = op(0x03, 0x0024);
+pub const OP_WRITE_INQUIRY_MODE: u16 = op(0x03, 0x0045);
+pub const OP_WRITE_EXT_INQUIRY_RESPONSE: u16 = op(0x03, 0x0052);
+pub const OP_WRITE_SSP_MODE: u16 = op(0x03, 0x0056);
+pub const OP_SET_EVENT_MASK_PAGE_2: u16 = op(0x03, 0x0063);
+pub const OP_WRITE_LE_HOST_SUPPORTED: u16 = op(0x03, 0x006d);
+pub const OP_WRITE_SC_SUPPORT: u16 = op(0x03, 0x007a);
+
+// Informational.
+pub const OP_READ_LOCAL_VERSION: u16 = op(0x04, 0x0001);
+pub const OP_READ_LOCAL_COMMANDS: u16 = op(0x04, 0x0002);
+pub const OP_READ_LOCAL_FEATURES: u16 = op(0x04, 0x0003);
+pub const OP_READ_LOCAL_EXT_FEATURES: u16 = op(0x04, 0x0004);
+pub const OP_READ_BUFFER_SIZE: u16 = op(0x04, 0x0005);
+pub const OP_READ_BD_ADDR: u16 = op(0x04, 0x0009);
+
+// LE.
+pub const OP_LE_SET_EVENT_MASK: u16 = op(0x08, 0x0001);
+pub const OP_LE_READ_BUFFER_SIZE: u16 = op(0x08, 0x0002);
+pub const OP_LE_READ_LOCAL_FEATURES: u16 = op(0x08, 0x0003);
+pub const OP_LE_SET_RANDOM_ADDR: u16 = op(0x08, 0x0005);
+pub const OP_LE_SET_ADV_PARAMS: u16 = op(0x08, 0x0006);
+pub const OP_LE_SET_ADV_DATA: u16 = op(0x08, 0x0008);
+pub const OP_LE_SET_SCAN_RSP_DATA: u16 = op(0x08, 0x0009);
+pub const OP_LE_SET_ADV_ENABLE: u16 = op(0x08, 0x000a);
+pub const OP_LE_SET_SCAN_PARAMS: u16 = op(0x08, 0x000b);
+pub const OP_LE_SET_SCAN_ENABLE: u16 = op(0x08, 0x000c);
+pub const OP_LE_CREATE_CONN: u16 = op(0x08, 0x000d);
+pub const OP_LE_CREATE_CONN_CANCEL: u16 = op(0x08, 0x000e);
+pub const OP_LE_READ_SUPPORTED_STATES: u16 = op(0x08, 0x001c);
+pub const OP_LE_CONN_UPDATE: u16 = op(0x08, 0x0013);
+pub const OP_LE_START_ENCRYPTION: u16 = op(0x08, 0x0019);
+pub const OP_LE_LTK_REPLY: u16 = op(0x08, 0x001a);
+pub const OP_LE_LTK_NEG_REPLY: u16 = op(0x08, 0x001b);
+
+// Events.
+pub const EV_INQUIRY_COMPLETE: u8 = 0x01;
+/// Vendor-specific events.
+pub const EV_VENDOR: u8 = 0xff;
+pub const EV_INQUIRY_RESULT: u8 = 0x02;
+pub const EV_CONN_COMPLETE: u8 = 0x03;
+pub const EV_CONN_REQUEST: u8 = 0x04;
+pub const EV_DISCONN_COMPLETE: u8 = 0x05;
+pub const EV_AUTH_COMPLETE: u8 = 0x06;
+pub const EV_REMOTE_NAME: u8 = 0x07;
+pub const EV_ENCRYPT_CHANGE: u8 = 0x08;
+pub const EV_REMOTE_FEATURES: u8 = 0x0b;
+pub const EV_REMOTE_VERSION: u8 = 0x0c;
+pub const EV_CMD_COMPLETE: u8 = 0x0e;
+pub const EV_CMD_STATUS: u8 = 0x0f;
+pub const EV_HARDWARE_ERROR: u8 = 0x10;
+pub const EV_ROLE_CHANGE: u8 = 0x12;
+pub const EV_NUM_COMP_PKTS: u8 = 0x13;
+pub const EV_PIN_CODE_REQ: u8 = 0x16;
+pub const EV_LINK_KEY_REQ: u8 = 0x17;
+pub const EV_LINK_KEY_NOTIFY: u8 = 0x18;
+pub const EV_INQUIRY_RESULT_WITH_RSSI: u8 = 0x22;
+pub const EV_REMOTE_EXT_FEATURES: u8 = 0x23;
+pub const EV_SYNC_CONN_COMPLETE: u8 = 0x2c;
+pub const EV_SYNC_CONN_CHANGED: u8 = 0x2d;
+pub const EV_EXTENDED_INQUIRY_RESULT: u8 = 0x2f;
+pub const EV_ENCRYPT_KEY_REFRESH: u8 = 0x30;
+pub const EV_IO_CAPA_REQUEST: u8 = 0x31;
+pub const EV_IO_CAPA_RESPONSE: u8 = 0x32;
+pub const EV_USER_CONFIRM_REQUEST: u8 = 0x33;
+pub const EV_USER_PASSKEY_REQUEST: u8 = 0x34;
+pub const EV_SIMPLE_PAIR_COMPLETE: u8 = 0x36;
+pub const EV_USER_PASSKEY_NOTIFY: u8 = 0x3b;
+pub const EV_REMOTE_HOST_FEATURES: u8 = 0x3d;
+pub const EV_LE_META: u8 = 0x3e;
+
+pub const LE_EV_CONN_COMPLETE: u8 = 0x01;
+pub const LE_EV_ADV_REPORT: u8 = 0x02;
+pub const LE_EV_CONN_UPDATE_COMPLETE: u8 = 0x03;
+pub const LE_EV_REMOTE_FEATURES: u8 = 0x04;
+pub const LE_EV_LTK_REQUEST: u8 = 0x05;
+pub const LE_EV_ENHANCED_CONN_COMPLETE: u8 = 0x0a;
+
+/// The General Inquiry Access Code (GIAC), little-endian.
+pub const GIAC: [u8; 3] = [0x33, 0x8b, 0x9e];
+
+/// Inquiry length, in units of 1.28 s: 8 is 10.24 s, as Linux asks.
+pub const INQUIRY_LENGTH: u8 = 0x08;
+
+/// Status codes this stack looks at.
+pub const STATUS_SUCCESS: u8 = 0x00;
+pub const STATUS_UNKNOWN_COMMAND: u8 = 0x01;
+pub const STATUS_UNKNOWN_CONN: u8 = 0x02;
+pub const STATUS_AUTH_FAILURE: u8 = 0x05;
+pub const STATUS_PIN_OR_KEY_MISSING: u8 = 0x06;
+pub const STATUS_CONN_TIMEOUT: u8 = 0x08;
+pub const STATUS_REMOTE_USER_TERM: u8 = 0x13;
+pub const STATUS_LOCAL_HOST_TERM: u8 = 0x16;
+pub const STATUS_PAIRING_NOT_ALLOWED: u8 = 0x18;
+
+/// Feature bits of `Read Local Supported Features` (byte, mask).
+pub const FEATURE_RSSI_INQUIRY: (usize, u8) = (3, 0x40);
+pub const FEATURE_NO_BREDR: (usize, u8) = (4, 0x20);
+pub const FEATURE_LE: (usize, u8) = (4, 0x40);
+pub const FEATURE_EXT_INQUIRY: (usize, u8) = (6, 0x01);
+pub const FEATURE_SIMPLE_PAIRING: (usize, u8) = (6, 0x08);
+
+pub fn has_feature(features: &[u8; 8], (byte, mask): (usize, u8)) -> bool {
+    features[byte] & mask != 0
+}
+
+/// A command packet: its opcode, its parameters' length, its parameters
+/// (without the packet type, which the transport adds).
+pub fn command(opcode: u16, params: &[u8]) -> alloc::vec::Vec<u8> {
+    let mut packet = alloc::vec::Vec::with_capacity(3 + params.len());
+    packet.extend_from_slice(&opcode.to_le_bytes());
+    packet.push(params.len() as u8);
+    packet.extend_from_slice(params);
+    packet
+}
+
+/// A little-endian `u16` at `at`, if there.
+pub fn le16(bytes: &[u8], at: usize) -> Option<u16> {
+    Some(u16::from_le_bytes([*bytes.get(at)?, *bytes.get(at + 1)?]))
+}
