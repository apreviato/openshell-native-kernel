+++ b/kernel/core/src/net/socket/netlink/route/kernel/route.rs
@@ -0,0 +1,169 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Handle route-related requests: dumps (`ip route`) and lookups
+//! (`ip route get`).
+
+use core::net::IpAddr;
+
+use aster_bigtcp::wire::{IpAddress, IpCidr, Ipv4Address, Ipv6Address};
+
+use super::util::finish_response;
+use crate::{
+    net::{
+        route::{RouteInfo, RouteType, dump_routes, lookup_route},
+        socket::netlink::{
+            message::{CMsgSegHdr, CSegmentType, GetRequestFlags, SegHdrCommonFlags},
+            route::message::{
+                RT_TABLE_COMPAT, RouteAttr, RouteFlags, RouteKind, RouteProtocol, RouteSegment,
+                RouteSegmentBody, RtScope, RtnlSegment,
+            },
+        },
+    },
+    prelude::*,
+    util::net::CSocketAddrFamily,
+};
+
+pub(super) fn do_get_route(request_segment: &RouteSegment) -> Result<Vec<RtnlSegment>> {
+    let request_header = request_segment.header();
+    let dump_all =
+        GetRequestFlags::from_bits_truncate(request_header.flags).contains(GetRequestFlags::DUMP);
+    let family = request_segment.body().family;
+
+    let mut response_segments: Vec<RtnlSegment> = if dump_all {
+        // Linux dumps the requested family, or every family when it is
+        // neither AF_INET nor AF_INET6.
+        let dump_ipv4 = family != CSocketAddrFamily::AF_INET6 as i32;
+        let dump_ipv6 = family != CSocketAddrFamily::AF_INET as i32;
+        dump_routes()
+            .iter()
+            .filter(|route| match route.dst {
+                IpCidr::Ipv4(_) => dump_ipv4,
+                IpCidr::Ipv6(_) => dump_ipv6,
+            })
+            .map(|route| RtnlSegment::NewRoute(new_route(request_header, route, None)))
+            .collect()
+    } else {
+        // Without `RTA_DST`, Linux looks up the unspecified address.
+        let dst = request_segment.attrs().iter().find_map(|attr| match attr {
+            RouteAttr::Dst(address) => Some(*address),
+            _ => None,
+        });
+        let dst = match (dst, family) {
+            (Some(IpAddr::V4(address)), _) => IpAddress::Ipv4(address),
+            (Some(IpAddr::V6(address)), _) => IpAddress::Ipv6(address),
+            (None, family) if family == CSocketAddrFamily::AF_INET6 as i32 => {
+                IpAddress::Ipv6(Ipv6Address::UNSPECIFIED)
+            }
+            (None, _) => IpAddress::Ipv4(Ipv4Address::UNSPECIFIED),
+        };
+        let route = lookup_route(dst)?;
+        vec![RtnlSegment::NewRoute(new_route(
+            request_header,
+            &route,
+            Some(dst),
+        ))]
+    };
+
+    finish_response(request_header, dump_all, &mut response_segments);
+
+    Ok(response_segments)
+}
+
+/// Describes a route, or with `lookup` the route that a destination takes.
+fn new_route(
+    request_header: &CMsgSegHdr,
+    route: &RouteInfo,
+    lookup: Option<IpAddress>,
+) -> RouteSegment {
+    let header = CMsgSegHdr {
+        len: 0,
+        type_: CSegmentType::NEWROUTE as _,
+        flags: SegHdrCommonFlags::empty().bits(),
+        seq: request_header.seq,
+        pid: request_header.pid,
+    };
+
+    let (family, dst, dst_len) = match (lookup, route.dst) {
+        (Some(IpAddress::Ipv4(address)), _) => {
+            (CSocketAddrFamily::AF_INET, IpAddr::V4(address), 32)
+        }
+        (Some(IpAddress::Ipv6(address)), _) => {
+            (CSocketAddrFamily::AF_INET6, IpAddr::V6(address), 128)
+        }
+        (None, IpCidr::Ipv4(cidr)) => (
+            CSocketAddrFamily::AF_INET,
+            IpAddr::V4(cidr.address()),
+            cidr.prefix_len(),
+        ),
+        (None, IpCidr::Ipv6(cidr)) => (
+            CSocketAddrFamily::AF_INET6,
+            IpAddr::V6(cidr.address()),
+            cidr.prefix_len(),
+        ),
+    };
+    let gateway = route.gateway.map(|gateway| match gateway {
+        IpAddress::Ipv4(address) => IpAddr::V4(address),
+        IpAddress::Ipv6(address) => IpAddr::V6(address),
+    });
+
+    // The kernel's own routes come from the interfaces' addresses; a
+    // gateway came from DHCP or from the boot configuration.
+    let protocol = match (gateway, route.iface.dhcp_lease()) {
+        (None, _) => RouteProtocol::Kernel,
+        (Some(_), Some(_)) => RouteProtocol::Dhcp,
+        (Some(_), None) => RouteProtocol::Boot,
+    };
+    let (scope, kind) = match route.type_ {
+        RouteType::Local => (RtScope::HOST, RouteKind::Local),
+        RouteType::Broadcast => (RtScope::LINK, RouteKind::Broadcast),
+        RouteType::Unicast if gateway.is_none() => (RtScope::LINK, RouteKind::Unicast),
+        RouteType::Unicast => (RtScope::UNIVERSE, RouteKind::Unicast),
+    };
+    let body = RouteSegmentBody {
+        family: family as _,
+        dst_len,
+        table: u8::try_from(route.table).unwrap_or(RT_TABLE_COMPAT as u8),
+        protocol,
+        scope: scope as u8,
+        type_: kind,
+        flags: if lookup.is_some() {
+            RouteFlags::CLONED
+        } else {
+            RouteFlags::empty()
+        },
+    };
+
+    // The source address: the interface's, for the routes the kernel made
+    // from it and for a lookup (Linux's `src`).
+    let source = match route.iface.ipv4_cidr() {
+        Some(cidr) if dst.is_ipv4() && (gateway.is_none() || lookup.is_some()) => {
+            Some(IpAddr::V4(cidr.address()))
+        }
+        _ => None,
+    };
+
+    // In Linux's order: `RTA_TABLE`, `RTA_DST`, `RTA_PRIORITY`,
+    // `RTA_PREFSRC`, `RTA_GATEWAY`, `RTA_OIF` for a dump; `RTA_OIF` before
+    // `RTA_PREFSRC` and `RTA_GATEWAY` for a lookup.
+    // Reference: <https://elixir.bootlin.com/linux/v6.13/source/net/ipv4/fib_semantics.c#L1785>
+    // and <https://elixir.bootlin.com/linux/v6.13/source/net/ipv4/route.c#L2905>.
+    let mut attrs = vec![RouteAttr::Table(route.table)];
+    if dst_len > 0 {
+        attrs.push(RouteAttr::Dst(dst));
+    }
+    let oif = RouteAttr::Oif(route.iface.index());
+    if lookup.is_some() {
+        attrs.push(oif);
+        attrs.extend(source.map(RouteAttr::PrefSrc));
+        attrs.extend(gateway.map(RouteAttr::Gateway));
+    } else {
+        if route.metric != 0 {
+            attrs.push(RouteAttr::Priority(route.metric));
+        }
+        attrs.extend(source.map(RouteAttr::PrefSrc));
+        attrs.extend(gateway.map(RouteAttr::Gateway));
+        attrs.push(oif);
+    }
+
+    RouteSegment::new(header, body, attrs)
+}
