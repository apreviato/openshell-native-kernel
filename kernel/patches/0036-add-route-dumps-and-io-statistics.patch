diff --git a/kernel/core/comps/block/src/stats.rs b/kernel/core/comps/block/src/stats.rs
new file mode 100755
index 0000000..81a24cd
--- /dev/null
+++ b/kernel/core/comps/block/src/stats.rs
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The I/O of each block device, as Linux's `/proc/diskstats` reports it:
+//! requests and sectors read and written, and cache flushes. A partition's
+//! requests count for the partition and for its disk, as in Linux.
+
+use core::sync::atomic::{AtomicU64, Ordering};
+
+use device_id::DeviceId;
+use ostd::sync::{LocalIrqDisabled, SpinLock};
+
+use crate::{bio::BioType, prelude::*};
+
+/// A block device's I/O since it was registered.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct IoStats {
+    /// Read requests.
+    pub reads: u64,
+    /// 512-byte sectors read.
+    pub read_sectors: u64,
+    /// Write requests.
+    pub writes: u64,
+    /// 512-byte sectors written.
+    pub write_sectors: u64,
+    /// Cache flushes.
+    pub flushes: u64,
+}
+
+#[derive(Default)]
+struct Counters {
+    reads: AtomicU64,
+    read_sectors: AtomicU64,
+    writes: AtomicU64,
+    write_sectors: AtomicU64,
+    flushes: AtomicU64,
+}
+
+static COUNTERS: SpinLock<BTreeMap<u32, Arc<Counters>>, LocalIrqDisabled> =
+    SpinLock::new(BTreeMap::new());
+
+fn counters(id: DeviceId) -> Arc<Counters> {
+    COUNTERS.lock().entry(id.to_raw()).or_default().clone()
+}
+
+/// Counts a request that the device `id` accepted.
+pub(crate) fn account(id: DeviceId, type_: BioType, sectors: u64) {
+    let counters = counters(id);
+    let (requests, sectors_counter) = match type_ {
+        BioType::Read => (&counters.reads, Some(&counters.read_sectors)),
+        BioType::Write => (&counters.writes, Some(&counters.write_sectors)),
+        BioType::Flush => (&counters.flushes, None),
+    };
+    requests.fetch_add(1, Ordering::Relaxed);
+    if let Some(sectors_counter) = sectors_counter {
+        sectors_counter.fetch_add(sectors, Ordering::Relaxed);
+    }
+}
+
+/// Forgets a device that went away, so that one registered again under its
+/// numbers starts from zero.
+pub(crate) fn forget(id: DeviceId) {
+    COUNTERS.lock().remove(&id.to_raw());
+}
+
+/// Returns the I/O of the device `id` so far.
+pub fn io_stats(id: DeviceId) -> IoStats {
+    let Some(counters) = COUNTERS.lock().get(&id.to_raw()).cloned() else {
+        return IoStats::default();
+    };
+    IoStats {
+        reads: counters.reads.load(Ordering::Relaxed),
+        read_sectors: counters.read_sectors.load(Ordering::Relaxed),
+        writes: counters.writes.load(Ordering::Relaxed),
+        write_sectors: counters.write_sectors.load(Ordering::Relaxed),
+        flushes: counters.flushes.load(Ordering::Relaxed),
+    }
+}
