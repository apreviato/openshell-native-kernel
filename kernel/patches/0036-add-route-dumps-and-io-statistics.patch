+++ b/kernel/core/src/net/socket/netlink/route/message/attr/route.rs
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: MPL-2.0
+
+use core::net::{IpAddr, Ipv4Addr, Ipv6Addr};
+
+use crate::{
+    net::socket::netlink::message::{Attribute, CAttrHeader, ContinueRead},
+    prelude::*,
+    util::MultiRead,
+};
+
+/// Route attributes.
+///
+/// Reference: <https://elixir.bootlin.com/linux/v6.13/source/include/uapi/linux/rtnetlink.h#L365>.
+#[expect(non_camel_case_types)]
+#[expect(clippy::upper_case_acronyms)]
+#[repr(u16)]
+#[derive(Clone, Copy, Debug, Eq, PartialEq, TryFromInt)]
+enum RouteAttrClass {
+    UNSPEC = 0,
+    DST = 1,
+    SRC = 2,
+    IIF = 3,
+    OIF = 4,
+    GATEWAY = 5,
+    PRIORITY = 6,
+    PREFSRC = 7,
+    METRICS = 8,
+    MULTIPATH = 9,
+    PROTOINFO = 10,
+    FLOW = 11,
+    CACHEINFO = 12,
+    SESSION = 13,
+    MP_ALGO = 14,
+    TABLE = 15,
+    MARK = 16,
+}
+
+#[derive(Debug)]
+pub(crate) enum RouteAttr {
+    /// The destination (a network's address, or the address looked up).
+    Dst(IpAddr),
+    /// The output interface's index.
+    Oif(u32),
+    Gateway(IpAddr),
+    /// The metric.
+    Priority(u32),
+    /// The source address that packets on the route use.
+    PrefSrc(IpAddr),
+    /// The table's number.
+    Table(u32),
+}
+
+impl RouteAttr {
+    fn class(&self) -> RouteAttrClass {
+        match self {
+            RouteAttr::Dst(_) => RouteAttrClass::DST,
+            RouteAttr::Oif(_) => RouteAttrClass::OIF,
+            RouteAttr::Gateway(_) => RouteAttrClass::GATEWAY,
+            RouteAttr::Priority(_) => RouteAttrClass::PRIORITY,
+            RouteAttr::PrefSrc(_) => RouteAttrClass::PREFSRC,
+            RouteAttr::Table(_) => RouteAttrClass::TABLE,
+        }
+    }
+}
+
+impl Attribute for RouteAttr {
+    fn type_(&self) -> u16 {
+        self.class() as u16
+    }
+
+    fn payload_as_bytes(&self) -> &[u8] {
+        match self {
+            RouteAttr::Dst(address) | RouteAttr::Gateway(address) | RouteAttr::PrefSrc(address) => {
+                address.as_octets()
+            }
+            RouteAttr::Oif(value) | RouteAttr::Priority(value) | RouteAttr::Table(value) => {
+                value.as_bytes()
+            }
+        }
+    }
+
+    fn read_from(header: &CAttrHeader, reader: &mut dyn MultiRead) -> Result<ContinueRead<Self>>
+    where
+        Self: Sized,
+    {
+        let payload_len = header.payload_len();
+
+        // A dump's request may carry filters (`RTA_TABLE`, `RTA_OIF`, ...)
+        // that Linux reads only in strict mode, and a lookup's request
+        // (`ip route get`) the destination. Other attributes are ignored.
+        let address = |reader: &mut dyn MultiRead| -> Result<Option<IpAddr>> {
+            Ok(match payload_len {
+                4 => reader
+                    .read_val_opt::<[u8; 4]>()?
+                    .map(|octets| IpAddr::V4(Ipv4Addr::from(octets))),
+                16 => reader
+                    .read_val_opt::<[u8; 16]>()?
+                    .map(|octets| IpAddr::V6(Ipv6Addr::from(octets))),
+                _ => {
+                    reader.skip_some(payload_len);
+                    None
+                }
+            })
+        };
+        let attr = match (RouteAttrClass::try_from(header.type_()), payload_len) {
+            (Ok(RouteAttrClass::DST), _) => address(reader)?.map(RouteAttr::Dst),
+            (Ok(RouteAttrClass::OIF), 4) => reader.read_val_opt::<u32>()?.map(RouteAttr::Oif),
+            (Ok(RouteAttrClass::TABLE), 4) => reader.read_val_opt::<u32>()?.map(RouteAttr::Table),
+            _ => {
+                reader.skip_some(payload_len);
+                None
+            }
+        };
+
+        Ok(match attr {
+            Some(attr) => ContinueRead::Parsed(attr),
+            None => ContinueRead::Skipped,
+        })
+    }
+}
