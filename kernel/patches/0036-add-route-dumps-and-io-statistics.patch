+
+/// A route as the route netlink socket reports it (`ip route`).
+pub(in crate::net) struct RouteInfo {
+    /// The destination network.
+    pub(in crate::net) dst: IpCidr,
+    /// The next hop, if the destination is not on a connected network.
+    pub(in crate::net) gateway: Option<IpAddress>,
+    /// The output interface.
+    pub(in crate::net) iface: Arc<Iface>,
+    /// The number of the table holding the route.
+    pub(in crate::net) table: u32,
+    /// The route's metric (lower is preferred).
+    pub(in crate::net) metric: u32,
+    pub(in crate::net) type_: RouteType,
+}
+
+impl RouteInfo {
+    fn from_entry<A: RouteAddressFamily>(
+        entry: &RouteEntry<A>,
+        dst: impl Fn(&A::Cidr) -> IpCidr,
+        address: impl Fn(A) -> IpAddress,
+    ) -> Self {
+        Self {
+            dst: dst(entry.dst()),
+            gateway: entry.gateway().map(address),
+            iface: entry.output_iface().clone(),
+            table: entry.table_id().value(),
+            metric: entry.metric().value(),
+            type_: entry.type_(),
+        }
+    }
+}
+
+/// Returns the routes of the current namespace, IPv4 first, each family's
+/// ordered by table and destination.
+pub(in crate::net) fn dump_routes() -> Vec<RouteInfo> {
+    let net_ns = super::net_ns::current_net_ns();
+    let routes = net_ns.routes();
+    let ipv4 = routes
+        .0
+        .ipv4
+        .entries()
+        .map(|entry| RouteInfo::from_entry(entry, |cidr| IpCidr::Ipv4(*cidr), IpAddress::Ipv4));
+    let ipv6 = routes
+        .0
+        .ipv6
+        .entries()
+        .map(|entry| RouteInfo::from_entry(entry, |cidr| IpCidr::Ipv6(*cidr), IpAddress::Ipv6));
+    ipv4.chain(ipv6).collect()
+}
+
+/// Linux's `/proc/net/route`: the main table's IPv4 unicast routes, each
+/// address as the hexadecimal of its network-order word, lines padded to
+/// 127 columns.
+///
+/// Reference: <https://elixir.bootlin.com/linux/v6.13/source/net/ipv4/fib_trie.c#L2963>.
+pub(in crate::net) fn proc_net_route() -> String {
+    const RTF_UP: u32 = 0x1;
+    const RTF_GATEWAY: u32 = 0x2;
+    const RTF_HOST: u32 = 0x4;
+    let word = |address: Ipv4Address| u32::from_le_bytes(address.octets());
+
+    let mut text = format!(
+        "{:<127}\n",
+        "Iface\tDestination\tGateway \tFlags\tRefCnt\tUse\tMetric\tMask\t\tMTU\tWindow\tIRTT"
+    );
+    for route in dump_routes() {
+        let IpCidr::Ipv4(dst) = route.dst else {
+            continue;
+        };
+        if route.table != RouteTableId::MAIN.value() || route.type_ != RouteType::Unicast {
+            continue;
+        }
+        let gateway = match route.gateway {
+            Some(IpAddress::Ipv4(gateway)) => Some(gateway),
+            _ => None,
+        };
+        let mut flags = RTF_UP;
+        if gateway.is_some() {
+            flags |= RTF_GATEWAY;
+        }
+        if dst.prefix_len() == 32 {
+            flags |= RTF_HOST;
+        }
+        let line = format!(
+            "{}\t{:08X}\t{:08X}\t{:04X}\t0\t0\t{}\t{:08X}\t0\t0\t0",
+            route.iface.name().as_str().unwrap_or("?"),
+            word(dst.address()),
+            word(gateway.unwrap_or(Ipv4Address::UNSPECIFIED)),
+            flags,
+            route.metric,
+            word(dst.netmask()),
+        );
+        text.push_str(&format!("{:<127}\n", line));
+    }
+    text
+}
+
+/// Returns the route that packets to `dst` take (`ip route get`).
+pub(in crate::net) fn lookup_route(dst: IpAddress) -> Result<RouteInfo> {
+    let net_ns = super::net_ns::current_net_ns();
+    let routes = net_ns.routes();
+    let route = match dst {
+        IpAddress::Ipv4(dst) => RouteInfo::from_entry(
+            &routes.0.ipv4.lookup_entry(&RouteLookupKey::new(dst))?,
+            |cidr| IpCidr::Ipv4(*cidr),
+            IpAddress::Ipv4,
+        ),
+        IpAddress::Ipv6(dst) => RouteInfo::from_entry(
+            &routes.0.ipv6.lookup_entry(&RouteLookupKey::new(dst))?,
+            |cidr| IpCidr::Ipv6(*cidr),
+            IpAddress::Ipv6,
+        ),
+    };
+    Ok(route)
+}
 
