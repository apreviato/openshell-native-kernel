 }
+
+impl From<CRtGenMsg> for CRtMsg {
+    fn from(value: CRtGenMsg) -> Self {
+        Self {
+            family: value.family,
+            dst_len: 0,
+            src_len: 0,
+            tos: 0,
+            table: 0,
+            protocol: 0,
+            scope: 0,
+            type_: 0,
+            flags: 0,
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct RouteSegmentBody {
+    pub family: i32,
+    /// The destination's prefix length.
+    pub dst_len: u8,
+    /// The table (`RT_TABLE_COMPAT` when its number needs the `RTA_TABLE`
+    /// attribute).
+    pub table: u8,
+    pub protocol: RouteProtocol,
+    /// An `rt_scope_t`.
+    pub scope: u8,
+    pub type_: RouteKind,
+    pub flags: RouteFlags,
+}
+
+impl TryFrom<CRtMsg> for RouteSegmentBody {
+    type Error = Error;
+
+    fn try_from(value: CRtMsg) -> Result<Self> {
+        Ok(Self {
+            family: value.family as i32,
+            dst_len: value.dst_len,
+            table: value.table,
+            // Requests (`ip route show proto ...`) may name protocols this
+            // kernel never sets; only dumps' filters use them.
+            protocol: RouteProtocol::try_from(value.protocol).unwrap_or(RouteProtocol::Unspec),
+            scope: value.scope,
+            type_: RouteKind::try_from(value.type_).unwrap_or(RouteKind::Unspec),
+            flags: RouteFlags::from_bits_truncate(value.flags),
+        })
+    }
+}
+
+impl From<RouteSegmentBody> for CRtMsg {
+    fn from(value: RouteSegmentBody) -> Self {
+        Self {
+            family: value.family as u8,
+            dst_len: value.dst_len,
+            src_len: 0,
+            tos: 0,
+            table: value.table,
+            protocol: value.protocol as u8,
+            scope: value.scope,
+            type_: value.type_ as u8,
+            flags: value.flags.bits(),
+        }
+    }
+}
