+    /// Sends one byte and waits for the device's acknowledgment, trying again
+    /// as Linux's elantech driver does.
+    fn byte(&mut self, byte: u8) -> Result<(), I8042ControllerError> {
+        let mut result = Err(I8042ControllerError::DeviceResetFailed);
+        for _ in 0..3 {
+            self.write_to_port(byte)?;
+            match self.0.wait_for_specific_data(&[0xFA, 0xFE, 0xFC]) {
+                Ok(0xFA) => return Ok(()),
+                Ok(_) => result = Err(I8042ControllerError::DeviceResetFailed),
+                Err(error) => result = Err(error),
+            }
+        }
+        result
+    }
