+    /// The status request (`E9`): three bytes.
+    fn status(&mut self) -> Result<[u8; 3], I8042ControllerError> {
+        self.byte(raw::STATUS_REQUEST)?;
+        let mut answer = [0u8; 3];
+        for slot in answer.iter_mut() {
+            *slot = self.0.wait_and_recv_data()?;
+        }
+        Ok(answer)
+    }
