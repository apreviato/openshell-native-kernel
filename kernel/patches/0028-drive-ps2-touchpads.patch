+// SPDX-License-Identifier: MPL-2.0
+
+//! PS/2 touchpads in their absolute modes, turned into a mouse.
+//!
+//! Synaptics and ELAN touchpads report finger positions once the driver
+//! switches them to absolute mode; in the plain PS/2 mode they fall back to,
+//! they only move the pointer. This module reads their packets and gives the
+//! laptop the gestures OpenShell Live's libinput gives it: the pointer, tap to
+//! click (one finger: left, two: right, three: middle), natural two-finger
+//! scrolling, the clickpad's right-button area and two-finger click, and no
+//! taps from touches that begin while typing. The result is a mouse with
+//! wheels, which the X evdev driver takes as it is.
+//!
+//! It has no hardware access, so its tests run on the host.
+//!
+//! References: Linux `drivers/input/mouse/synaptics.c` and `elantech.c`, and
+//! libinput's touchpad defaults.
+
+use alloc::vec::Vec;
+
+/// What a touchpad reports at one moment, in its own units with y growing down.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct Frame {
+    /// Fingers on the pad (0 when none).
+    pub fingers: u8,
+    /// The position of the first finger, when there is one.
+    pub x: i32,
+    pub y: i32,
+    /// The pad's own buttons: on a clickpad, `left` is the pad being pressed.
+    pub left: bool,
+    pub right: bool,
+    pub middle: bool,
+    /// A palm rather than a finger: it neither moves the pointer nor taps.
+    pub palm: bool,
+}
+
+/// The pad's coordinates and resolution.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Geometry {
+    pub x_min: i32,
+    pub x_max: i32,
+    pub y_min: i32,
+    pub y_max: i32,
+    /// Units per millimetre.
+    pub x_res: i32,
+    pub y_res: i32,
+    /// One button under the whole pad: its bottom right is the right button.
+    pub clickpad: bool,
+}
+
+impl Geometry {
+    /// A resolution guessed from the range for pads that do not report one:
+    /// most laptop touchpads are about 100 mm wide and 60 mm high.
+    pub(crate) fn with_guessed_resolution(mut self) -> Self {
+        if self.x_res <= 0 {
+            self.x_res = ((self.x_max - self.x_min) / 100).max(1);
+        }
+        if self.y_res <= 0 {
+            self.y_res = ((self.y_max - self.y_min) / 60).max(1);
+        }
+        self
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Button {
+    Left,
+    Right,
+    Middle,
+}
+
+/// What the touchpad does, as a mouse.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Output {
+    /// Pointer motion in pixels, y growing down.
+    Motion { dx: i32, dy: i32 },
+    /// Wheel clicks: `vertical` > 0 scrolls up and `horizontal` > 0 right
+    /// (Linux's REL_WHEEL and REL_HWHEEL).
+    Wheel { vertical: i32, horizontal: i32 },
+    Button { button: Button, pressed: bool },
+}
+
+/// Pointer pixels per millimetre of finger travel; the X server accelerates fast motion.
+const PIXELS_PER_MM: i32 = 6;
+/// Finger travel per wheel click while scrolling, in tenths of a millimetre.
+const SCROLL_STEP_TENTHS_MM: i32 = 20;
+/// The longest touch that is still a tap (libinput's tap timeout).
+const TAP_TIMEOUT_MS: u64 = 180;
+/// The most a tap may move, in tenths of a millimetre.
+const TAP_TRAVEL_TENTHS_MM: i32 = 30;
+/// How long after a key a new touch is taken for the palm of a typing hand.
+pub(crate) const TYPING_TIMEOUT_MS: u64 = 500;
+/// The clickpad's button area: the bottom part of the pad, in percent of its height.
+const BUTTON_AREA_PERCENT: i32 = 18;
+
+/// One touch, from the first finger down to the last finger up.
+#[derive(Clone, Copy, Debug)]
+struct Touch {
+    start_ms: u64,
+    max_fingers: u8,
+    /// Travel in tenths of a millimetre.
+    travel: i32,
+    /// Began while typing: no tap.
+    typing: bool,
+    /// The pad was clicked or a palm seen: no tap.
+    no_tap: bool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum ScrollAxis {
+    Undecided,
+    Vertical,
+    Horizontal,
+}
+
+/// Turns touchpad frames into mouse output.
+pub(crate) struct Gestures {
+    geometry: Geometry,
+    /// The previous frame's fingers and position.
+    last: Option<(u8, i32, i32)>,
+    /// What is left of a pixel or a wheel click, in units times the factor applied.
+    rem_x: i32,
+    rem_y: i32,
+    scroll_x: i32,
+    scroll_y: i32,
+    axis: ScrollAxis,
+    touch: Option<Touch>,
+    /// The button the pad's click is holding down.
+    click: Option<Button>,
+    right: bool,
+    middle: bool,
+}
+
+impl Gestures {
+    pub(crate) fn new(geometry: Geometry) -> Self {
+        Self {
+            geometry: geometry.with_guessed_resolution(),
+            last: None,
+            rem_x: 0,
+            rem_y: 0,
+            scroll_x: 0,
+            scroll_y: 0,
+            axis: ScrollAxis::Undecided,
+            touch: None,
+            click: None,
+            right: false,
+            middle: false,
+        }
+    }
+
+    /// Takes one frame at `now_ms`; `last_key_ms` is when a key was last typed.
+    pub(crate) fn process(&mut self, frame: &Frame, now_ms: u64, last_key_ms: Option<u64>, out: &mut Vec<Output>) {
+        let typing = last_key_ms.is_some_and(|key| now_ms.saturating_sub(key) < TYPING_TIMEOUT_MS);
+        let fingers = if frame.palm { 0 } else { frame.fingers };
+
+        // The touch: its start, its fingers and its travel decide a tap at its end.
+        if frame.fingers > 0 {
+            let touch = self.touch.get_or_insert(Touch {
+                start_ms: now_ms,
+                max_fingers: 0,
+                travel: 0,
+                typing,
+                no_tap: false,
+            });
+            touch.max_fingers = touch.max_fingers.max(frame.fingers);
+            touch.no_tap |= frame.palm || frame.left || frame.right || frame.middle;
+        }
+
+        let buttons_changed = self.buttons(frame, out);
+
+        // Motion: relative to the previous frame with the same fingers.
+        let previous = self.last;
+        self.last = (fingers > 0).then_some((fingers, frame.x, frame.y));
+        if let Some((last_fingers, last_x, last_y)) = previous
+            && last_fingers == fingers
+            && fingers > 0
+        {
+            let (dx, dy) = (frame.x - last_x, frame.y - last_y);
+            if let Some(touch) = self.touch.as_mut() {
+                touch.travel += (dx.abs() * 10) / self.geometry.x_res + (dy.abs() * 10) / self.geometry.y_res;
+            }
+            if buttons_changed {
+                // The finger rolls as it presses the pad: keep the pointer still.
+            } else if fingers >= 2 && self.click.is_none() {
+                self.scroll(dx, dy, out);
+            } else if !typing {
+                self.motion(dx, dy, out);
+            }
+        } else {
+            // A finger more or less: start again from here.
+            self.rem_x = 0;
+            self.rem_y = 0;
+            self.scroll_x = 0;
+            self.scroll_y = 0;
+            self.axis = ScrollAxis::Undecided;
+        }
+
+        if frame.fingers == 0
+            && let Some(touch) = self.touch.take()
+        {
+            let quick = now_ms.saturating_sub(touch.start_ms) <= TAP_TIMEOUT_MS;
+            if quick && !touch.typing && !touch.no_tap && touch.travel <= TAP_TRAVEL_TENTHS_MM && self.click.is_none() {
+                let button = match touch.max_fingers {
+                    1 => Button::Left,
+                    2 => Button::Right,
+                    _ => Button::Middle,
+                };
+                out.push(Output::Button { button, pressed: true });
+                out.push(Output::Button { button, pressed: false });
+            }
+        }
+    }
+
+    /// The pad's buttons; returns whether one changed.
+    fn buttons(&mut self, frame: &Frame, out: &mut Vec<Output>) -> bool {
+        let mut changed = false;
+        match (frame.left, self.click) {
+            (true, None) => {
+                let button = if !self.geometry.clickpad {
+                    Button::Left
+                } else if frame.fingers >= 2 {
+                    // Two fingers on a clickpad click right.
+                    Button::Right
+                } else if frame.fingers == 1 && self.in_right_button_area(frame.x, frame.y) {
+                    Button::Right
+                } else {
+                    Button::Left
+                };
+                self.click = Some(button);
+                out.push(Output::Button { button, pressed: true });
+                changed = true;
+            }
+            (false, Some(button)) => {
+                self.click = None;
+                out.push(Output::Button { button, pressed: false });
+                changed = true;
+            }
+            _ => {}
+        }
+        if frame.right != self.right {
+            self.right = frame.right;
+            out.push(Output::Button { button: Button::Right, pressed: frame.right });
+            changed = true;
+        }
+        if frame.middle != self.middle {
+            self.middle = frame.middle;
+            out.push(Output::Button { button: Button::Middle, pressed: frame.middle });
+            changed = true;
+        }
+        changed
+    }
+
+    fn in_right_button_area(&self, x: i32, y: i32) -> bool {
+        let g = &self.geometry;
+        let height = g.y_max - g.y_min;
+        let top_of_area = g.y_max - height * BUTTON_AREA_PERCENT / 100;
+        y >= top_of_area && x >= (g.x_min + g.x_max) / 2
+    }
+
+    fn motion(&mut self, dx: i32, dy: i32, out: &mut Vec<Output>) {
+        // Pixels = units * PIXELS_PER_MM / resolution, keeping the remainder.
+        let total_x = dx * PIXELS_PER_MM + self.rem_x;
+        let total_y = dy * PIXELS_PER_MM + self.rem_y;
+        let (px, py) = (total_x / self.geometry.x_res, total_y / self.geometry.y_res);
+        self.rem_x = total_x - px * self.geometry.x_res;
+        self.rem_y = total_y - py * self.geometry.y_res;
+        if px != 0 || py != 0 {
+            out.push(Output::Motion { dx: px, dy: py });
+        }
+    }
+
+    /// Natural scrolling: the content follows the fingers. One axis at a time,
+    /// as libinput locks it.
+    fn scroll(&mut self, dx: i32, dy: i32, out: &mut Vec<Output>) {
+        self.scroll_x += dx * 10;
+        self.scroll_y += dy * 10;
+        let step_x = SCROLL_STEP_TENTHS_MM * self.geometry.x_res;
+        let step_y = SCROLL_STEP_TENTHS_MM * self.geometry.y_res;
+        if self.axis == ScrollAxis::Undecided {
+            let (ax, ay) = (self.scroll_x.abs() * step_y, self.scroll_y.abs() * step_x);
+            if self.scroll_y.abs() >= step_y || self.scroll_x.abs() >= step_x {
+                self.axis = if ay >= ax { ScrollAxis::Vertical } else { ScrollAxis::Horizontal };
+            } else {
+                return;
+            }
+        }
+        match self.axis {
+            ScrollAxis::Vertical => {
+                self.scroll_x = 0;
+                // Fingers moving down show what is above: the wheel turns up.
+                let clicks = self.scroll_y / step_y;
+                if clicks != 0 {
+                    self.scroll_y -= clicks * step_y;
+                    out.push(Output::Wheel { vertical: clicks, horizontal: 0 });
+                }
+            }
+            ScrollAxis::Horizontal => {
+                self.scroll_y = 0;
+                // Fingers moving right show what is to the left.
+                let clicks = self.scroll_x / step_x;
+                if clicks != 0 {
+                    self.scroll_x -= clicks * step_x;
+                    out.push(Output::Wheel { vertical: 0, horizontal: -clicks });
+                }
+            }
+            ScrollAxis::Undecided => {}
+        }
+    }
+}
+
+/// Collects a touchpad's packets from the byte stream, finding the packet
+/// boundary again after a lost byte.
+pub(crate) struct Framer {
+    buf: [u8; 6],
+    len: usize,
+    last_ms: u64,
+}
+
+/// After this long without a byte, the next byte starts a packet.
+const PACKET_GAP_MS: u64 = 50;
+
+impl Framer {
+    pub(crate) const fn new() -> Self {
+        Self { buf: [0; 6], len: 0, last_ms: 0 }
+    }
+
+    pub(crate) fn reset(&mut self) {
+        self.len = 0;
+    }
+
+    /// Adds a byte; returns a packet of `size` bytes once `valid` accepts it
+    /// whole. `valid` checks a packet's first bytes, whatever their number.
+    pub(crate) fn push(&mut self, byte: u8, now_ms: u64, size: usize, valid: impl Fn(&[u8]) -> bool) -> Option<[u8; 6]> {
+        if self.len > 0 && now_ms.saturating_sub(self.last_ms) > PACKET_GAP_MS {
+            self.len = 0;
+        }
+        self.last_ms = now_ms;
+        self.buf[self.len] = byte;
+        self.len += 1;
+        // Drop bytes from the front until what is left could start a packet.
+        while self.len > 0 && !valid(&self.buf[..self.len]) {
+            self.buf.copy_within(1..self.len, 0);
+            self.len -= 1;
+        }
+        if self.len < size {
+            return None;
+        }
+        self.len = 0;
+        Some(self.buf)
+    }
+}
+
+/// Synaptics touchpads in absolute mode with W mode (6-byte packets).
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Synaptics {
+    pub geometry: Geometry,
+    /// W reports two and three fingers.
+    pub multifinger: bool,
+    /// W tells a finger's width (extended capabilities).
+    pub width: bool,
+    /// A middle button, reported as the left bits disagreeing.
+    pub middle: bool,
+    /// A guest device such as a TrackPoint, whose packets come with W = 3.
+    pub pass_through: bool,
+}
+
+/// What one touchpad packet holds.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Packet {
+    Touch(Frame),
+    /// A standard 3-byte PS/2 packet from a guest device (TrackPoint).
+    Guest([u8; 3]),
+    /// Nothing to report (for example the first half of an ELAN v3 two-finger report).
+    Nothing,
+}
+
+/// Pressure below which nothing touches a Synaptics pad.
+const SYNAPTICS_TOUCH_Z: i32 = 25;
+
+impl Synaptics {
+    pub(crate) const PACKET_SIZE: usize = 6;
+
+    /// The constant bits of the new absolute format.
+    pub(crate) fn valid(prefix: &[u8]) -> bool {
+        prefix.iter().enumerate().all(|(index, &byte)| match index {
+            0 => byte & 0xC8 == 0x80,
+            3 => byte & 0xC8 == 0xC0,
+            _ => true,
+        })
+    }
+
+    pub(crate) fn decode(&self, p: &[u8; 6]) -> Packet {
+        let w = ((p[0] & 0x30) >> 2) | ((p[0] & 0x04) >> 1) | ((p[3] & 0x04) >> 2);
+        if self.width && self.pass_through && w == 3 {
+            return Packet::Guest([p[1], p[4], p[5]]);
+        }
+        let z = p[2] as i32;
+        let x = (((p[3] & 0x10) as i32) << 8) | (((p[1] & 0x0f) as i32) << 8) | p[4] as i32;
+        let y = (((p[3] & 0x20) as i32) << 7) | (((p[1] & 0xf0) as i32) << 4) | p[5] as i32;
+        let disagree = (p[0] ^ p[3]) & 0x01 != 0;
+        let g = &self.geometry;
+        let fingers = if z < SYNAPTICS_TOUCH_Z {
+            0
+        } else if self.width && self.multifinger && w == 0 {
+            2
+        } else if self.width && self.multifinger && w == 1 {
+            3
+        } else {
+            1
+        };
+        Packet::Touch(Frame {
+            fingers,
+            x: x.clamp(g.x_min, g.x_max),
+            // Synaptics counts y from the bottom.
+            y: (g.y_max + g.y_min - y).clamp(g.y_min, g.y_max),
+            left: p[0] & 0x01 != 0 || (disagree && (g.clickpad || !self.middle)),
+            right: p[0] & 0x02 != 0,
+            middle: disagree && self.middle && !g.clickpad,
+            // xf86-input-synaptics' palm: wide and pressing.
+            palm: self.width && fingers == 1 && w >= 11 && z >= 150,
+        })
+    }
+}
+
+/// ELAN touchpads of hardware versions 3 and 4 in absolute mode (6-byte packets).
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Elan {
+    pub geometry: Geometry,
+    pub version: u8,
+    /// Firmware with packet checksums: other constant bits.
+    pub crc: bool,
+    /// IC body 7 with sample byte 0x2A: other constant bits.
+    pub ic7_2a: bool,
+    /// Fingers present (bit per slot) and their positions (version 4).
+    present: u8,
+    slots: [(i32, i32); 5],
+    /// The first finger of a version 3 two-finger report.
+    head: (i32, i32),
+}
+
+impl Elan {
+    pub(crate) const PACKET_SIZE: usize = 6;
+    const V3_DEBOUNCE: [u8; 6] = [0xc4, 0xff, 0xff, 0x02, 0xff, 0xff];
+
+    pub(crate) fn new(geometry: Geometry, version: u8, crc: bool, ic7_2a: bool) -> Self {
+        Self { geometry, version, crc, ic7_2a, present: 0, slots: [(0, 0); 5], head: (0, 0) }
+    }
+
+    /// The constant bits of each packet.
+    pub(crate) fn valid(&self, prefix: &[u8]) -> bool {
+        let byte = |index: usize| prefix.get(index).copied();
+        if self.version == 4 {
+            if let Some(b0) = byte(0)
+                && !self.crc
+                && !self.ic7_2a
+                && b0 & 0x08 != 0
+            {
+                return false;
+            }
+            match byte(3) {
+                None => true,
+                Some(b3) if self.crc => b3 & 0x08 == 0 && b3 & 0x03 != 3,
+                Some(b3) => b3 & 0x1c == 0x10 && b3 & 0x03 != 3,
+            }
+        } else {
+            // Head (one finger, or the first of two) and tail packets; the
+            // debounce packet passes as a head.
+            if self.crc {
+                return byte(3).is_none_or(|b3| b3 & 0x08 == 0x08);
+            }
+            let Some(b0) = byte(0) else { return true };
+            if b0 & 0x0c != 0x04 && b0 & 0x0c != 0x0c {
+                return false;
+            }
+            byte(3).is_none_or(|b3| match b0 & 0x0c {
+                0x04 => b3 & 0xcf == 0x02,
+                _ => b3 & 0xce == 0x0c,
+            })
+        }
+    }
+
+    fn position(&self, p: &[u8; 6]) -> (i32, i32) {
+        let x = (((p[1] & 0x0f) as i32) << 8) | p[2] as i32;
+        let y = (((p[4] & 0x0f) as i32) << 8) | p[5] as i32;
+        // ELAN counts y from the bottom.
+        (x, self.geometry.y_max - y)
+    }
+
+    pub(crate) fn decode(&mut self, p: &[u8; 6]) -> Packet {
+        // On a clickpad the whole pad is the left button.
+        let (left, right, middle) = (p[0] & 0x01 != 0, p[0] & 0x02 != 0, p[0] & 0x04 != 0);
+        let frame = |fingers: u8, (x, y): (i32, i32), g: &Geometry| Frame {
+            fingers,
+            x: x.clamp(g.x_min, g.x_max),
+            y: y.clamp(g.y_min, g.y_max),
+            left,
+            right: right && !g.clickpad,
+            middle: middle && !g.clickpad,
+            palm: false,
+        };
+        if self.version == 4 {
+            match p[3] & 0x03 {
+                0 => {
+                    // Status: which fingers are down.
+                    self.present = p[1] & 0x1f;
+                }
+                1 => {
+                    // Head: where one finger is.
+                    let id = ((p[3] & 0xe0) >> 5) as usize;
+                    if (1..=5).contains(&id) {
+                        self.slots[id - 1] = self.position(p);
+                        self.present |= 1 << (id - 1);
+                    }
+                }
+                _ => {
+                    // Motion: how far one or two fingers moved.
+                    let weight = if p[0] & 0x10 != 0 { 5 } else { 1 };
+                    for (id, dx, dy) in [((p[0] & 0xe0) >> 5, p[1], p[2]), ((p[3] & 0xe0) >> 5, p[4], p[5])] {
+                        let id = id as usize;
+                        if (1..=5).contains(&id) {
+                            let slot = &mut self.slots[id - 1];
+                            slot.0 += (dx as i8) as i32 * weight;
+                            slot.1 -= (dy as i8) as i32 * weight;
+                        }
+                    }
+                }
+            }
+            let fingers = self.present.count_ones() as u8;
+            let first = (0..5).find(|i| self.present & (1 << i) != 0).map_or((0, 0), |i| self.slots[i]);
+            return Packet::Touch(frame(fingers, first, &self.geometry));
+        }
+        if p == &Self::V3_DEBOUNCE {
+            return Packet::Nothing;
+        }
+        let fingers = (p[0] & 0xc0) >> 6;
+        let head = if self.crc { p[3] & 0x09 == 0x08 } else { p[0] & 0x0c == 0x04 };
+        let position = match fingers {
+            2 if head => {
+                // The first finger; the second comes in the next packet.
+                self.head = self.position(p);
+                return Packet::Nothing;
+            }
+            2 => self.head,
+            _ => self.position(p),
+        };
+        Packet::Touch(frame(fingers, position, &self.geometry))
+    }
+}
+
+/// Decodes a standard 3-byte PS/2 packet: buttons (left, right, middle) and motion (y down).
+pub(crate) fn standard_packet(p: [u8; 3]) -> Option<((bool, bool, bool), i32, i32)> {
+    let status = p[0];
+    if status & 0x08 == 0 || status & 0xC0 != 0 {
+        return None;
+    }
+    let sign = |byte: u8, negative: bool| if negative { byte as i32 - 256 } else { byte as i32 };
+    let dx = sign(p[1], status & 0x10 != 0);
+    let dy = sign(p[2], status & 0x20 != 0);
+    Some(((status & 0x01 != 0, status & 0x02 != 0, status & 0x04 != 0), dx, -dy))
+}
+
+/// ELAN's hardware version from its firmware version (Linux `elantech_set_properties`).
+pub(crate) fn elan_hw_version(fw: u32) -> Option<u8> {
+    if fw < 0x020030 || fw == 0x020600 {
+        return Some(1);
+    }
+    match (fw & 0x0f0000) >> 16 {
+        2 | 4 => Some(2),
+        5 => Some(3),
+        6..=15 => Some(4),
+        _ => None,
+    }
+}
+
+/// Whether ELAN's firmware version answer looks real (Linux `elantech_is_signature_valid`).
+pub(crate) fn elan_signature_valid(p: [u8; 3]) -> bool {
+    const RATES: [u8; 7] = [200, 100, 80, 60, 40, 20, 10];
+    if p[0] == 0 {
+        return false;
+    }
+    if p[1] == 0 {
+        return true;
+    }
+    if p[0] & 0x0f >= 0x06 && p[1] & 0xaf == 0x0f && p[2] < 40 {
+        return true;
+    }
+    !RATES.contains(&p[2])
+}
+
+/// ELAN's resolution code in units per millimetre (Linux `elantech_convert_res`).
+pub(crate) fn elan_resolution(code: u8) -> i32 {
+    (code as i32 * 10 + 790) * 10 / 254
+}
