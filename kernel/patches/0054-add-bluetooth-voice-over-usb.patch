@@ -0,0 +1,271 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Bluetooth voice over USB (Linux's `btusb` with `CONFIG_BT_HCIBTUSB` SCO):
+//! a USB controller carries its SCO links' data on the isochronous
+//! endpoints of its second interface, whose alternate settings grow with
+//! the links (Bluetooth Core 5.4, Vol 4, Part B, 2.1.1): none in setting 0,
+//! and for CVSD the setting by the number of links and the samples' size
+//! (8-bit: 1, 2, 3; 16-bit: 2, 4, 5), for transparent data (mSBC) setting
+//! 6 where there is one, else 1 (Linux's `btusb_work`). The stack says
+//! which links are up (`aster_bluetooth::Voice`); the controller task puts
+//! the interface in their setting, keeps transfers in on the IN endpoint
+//! (each packet's piece of a SCO packet, put back together by its 3-byte
+//! header) and sends each SCO packet out in packets of the setting's size,
+//! one a (micro)frame.
+
+use alloc::vec::Vec;
+
+use aster_bluetooth::{Voice, hci};
+use ostd::mm::{HasDaddr, PAGE_SIZE, VmIo, dma::DmaCoherent};
+
+use super::{
+    Controller, Data, SET_INTERFACE, SHORT_PACKET, SUCCESS,
+    audio::{EP_ISOCH_IN, EP_ISOCH_OUT, SIA, TRB_ISOCH},
+};
+use crate::{
+    bt,
+    desc::{Configuration, Endpoint, Interface, TRANSFER_ISOCHRONOUS},
+    ring::{IOC, ProducerRing, Trb},
+};
+
+/// Transfers kept on the IN endpoint (16 ms at full speed), and buffers
+/// for what goes out.
+const IN_TDS: usize = 16;
+const OUT_SLOTS: usize = 48;
+
+/// One alternate setting: its endpoints.
+#[derive(Clone, Copy, Debug)]
+struct ScoAlt {
+    alternate: u8,
+    inward: Endpoint,
+    outward: Endpoint,
+}
+
+/// The setting in use, with its transfers.
+struct ScoActive {
+    in_dci: u8,
+    out_dci: u8,
+    in_ring: ProducerRing,
+    out_ring: ProducerRing,
+    /// IN slots first, then OUT slots, `slot` bytes each.
+    buffers: DmaCoherent,
+    slot: usize,
+    in_size: usize,
+    out_size: usize,
+    in_flight: Vec<(u64, usize)>,
+    out_flight: Vec<(u64, usize)>,
+    out_free: Vec<usize>,
+}
+
+/// A controller's voice interface.
+pub(super) struct ScoEndpoints {
+    interface: u8,
+    alts: Vec<ScoAlt>,
+    current: u8,
+    active: Option<ScoActive>,
+    reassembly: bt::Reassembly,
+}
+
+impl ScoEndpoints {
+    /// The interface after the controller's (`control`): its settings with
+    /// an isochronous endpoint each way.
+    pub(super) fn of(configuration: &Configuration, control: &Interface) -> Option<Self> {
+        let number = control.number + 1;
+        let alts: Vec<ScoAlt> = configuration
+            .interfaces
+            .iter()
+            .filter(|interface| interface.number == number && interface.alternate > 0)
+            .filter_map(|interface| {
+                let find = |inward: bool| {
+                    interface.endpoints.iter().find(|e| e.transfer_type() == TRANSFER_ISOCHRONOUS && e.is_in() == inward).copied()
+                };
+                Some(ScoAlt { alternate: interface.alternate, inward: find(true)?, outward: find(false)? })
+            })
+            .collect();
+        (!alts.is_empty()).then(|| Self { interface: number, alts, current: 0, active: None, reassembly: bt::Reassembly::sco() })
+    }
+
+    fn has(&self, alternate: u8) -> bool {
+        self.alts.iter().any(|alt| alt.alternate == alternate)
+    }
+
+    /// The setting the links need (Linux's `btusb_work`), or the largest
+    /// below it the controller has.
+    fn wanted(&self, voice: Voice) -> u8 {
+        let wanted = match voice {
+            Voice::None => return 0,
+            Voice::Cvsd { links, sixteen_bit: true } => [2, 4, 5][usize::from(links.clamp(1, 3)) - 1],
+            Voice::Cvsd { links, sixteen_bit: false } => links.clamp(1, 3),
+            Voice::Transparent { .. } => {
+                if self.has(6) {
+                    6
+                } else {
+                    1
+                }
+            }
+        };
+        self.alts.iter().map(|alt| alt.alternate).filter(|alternate| *alternate <= wanted).max().unwrap_or(0)
+    }
+}
+
+impl Controller {
+    /// Puts a controller's voice interface in the setting the stack's
+    /// latest voice links need.
+    pub(super) fn serve_bt_voice(&mut self, slot_id: u8, which: usize) {
+        let Some(bluetooth) = self.slots.get(&slot_id).and_then(|slot| slot.bt.get(which)) else { return };
+        let Some(voice) = bluetooth.shared.voice.lock().take() else { return };
+        let Some(sco) = bluetooth.sco.as_ref() else { return };
+        let wanted = sco.wanted(voice);
+        if wanted == sco.current {
+            return;
+        }
+        let (interface, index) = (sco.interface, bluetooth.controller.index());
+        let alt = sco.alts.iter().find(|alt| alt.alternate == wanted).copied();
+        // The setting in use goes first: its endpoints, then the interface.
+        if let Some(active) = self.slots.get_mut(&slot_id).and_then(|slot| slot.bt.get_mut(which)).and_then(|bt| bt.sco.as_mut()).and_then(|sco| sco.active.take()) {
+            self.drop_endpoints(slot_id, &[active.in_dci, active.out_dci]);
+        }
+        let switched = self.control(slot_id, 0x01, SET_INTERFACE, u16::from(wanted), u16::from(interface), Data::None).is_ok();
+        let active = match (switched, alt) {
+            (true, Some(alt)) => self.start_sco(slot_id, &alt),
+            _ => None,
+        };
+        let Some(sco) = self.slots.get_mut(&slot_id).and_then(|slot| slot.bt.get_mut(which)).and_then(|bt| bt.sco.as_mut()) else { return };
+        sco.current = if switched { wanted } else { 0 };
+        sco.reassembly.clear();
+        ostd::notice!("{}: hci{}: voice {:?}: setting {} of interface {}", self.name, index, voice, sco.current, interface);
+        if let Some(active) = active {
+            let in_dci = active.in_dci;
+            sco.active = Some(active);
+            self.ring(slot_id, in_dci);
+        }
+    }
+
+    /// A setting's endpoints configured, with its IN transfers queued.
+    fn start_sco(&mut self, slot_id: u8, alt: &ScoAlt) -> Option<ScoActive> {
+        let in_ring = ProducerRing::new()?;
+        let out_ring = ProducerRing::new()?;
+        self.configure_endpoint(slot_id, &alt.inward, EP_ISOCH_IN, &in_ring).ok()?;
+        self.configure_endpoint(slot_id, &alt.outward, EP_ISOCH_OUT, &out_ring).ok()?;
+        let in_size = usize::from(alt.inward.max_packet & 0x7ff).max(1);
+        let out_size = usize::from(alt.outward.max_packet & 0x7ff).max(1);
+        let slot = in_size.max(out_size).next_power_of_two().max(64);
+        let pages = ((IN_TDS + OUT_SLOTS) * slot).div_ceil(PAGE_SIZE);
+        let mut active = ScoActive {
+            in_dci: alt.inward.dci(),
+            out_dci: alt.outward.dci(),
+            in_ring,
+            out_ring,
+            buffers: DmaCoherent::alloc(pages, true).ok()?,
+            slot,
+            in_size,
+            out_size,
+            in_flight: Vec::new(),
+            out_flight: Vec::new(),
+            out_free: (IN_TDS..IN_TDS + OUT_SLOTS).rev().collect(),
+        };
+        for index in 0..IN_TDS {
+            Self::queue_sco_in(&mut active, index);
+        }
+        Some(active)
+    }
+
+    fn queue_sco_in(active: &mut ScoActive, index: usize) {
+        let trb = active.in_ring.push(Trb {
+            parameter: active.buffers.daddr() as u64 + (index * active.slot) as u64,
+            status: active.in_size as u32,
+            control: Trb::with_type(TRB_ISOCH) | IOC | SIA,
+        });
+        active.in_flight.push((trb, index));
+    }
+
+    /// A SCO packet from the stack: out in packets of the setting's size,
+    /// one each (micro)frame. Without a setting for voice, or room, it goes.
+    pub(super) fn send_sco(&mut self, slot_id: u8, which: usize, packet: &[u8]) {
+        let Some(active) = self
+            .slots
+            .get_mut(&slot_id)
+            .and_then(|slot| slot.bt.get_mut(which))
+            .and_then(|bt| bt.sco.as_mut())
+            .and_then(|sco| sco.active.as_mut())
+        else {
+            return;
+        };
+        let pieces = packet.chunks(active.out_size);
+        if pieces.len() > active.out_free.len() {
+            return;
+        }
+        for piece in packet.chunks(active.out_size) {
+            let index = active.out_free.pop().unwrap();
+            let at = index * active.slot;
+            if active.buffers.write_bytes(at, piece).is_err() {
+                active.out_free.push(index);
+                return;
+            }
+            let trb = active.out_ring.push(Trb {
+                parameter: active.buffers.daddr() as u64 + at as u64,
+                status: piece.len() as u32,
+                control: Trb::with_type(TRB_ISOCH) | IOC | SIA,
+            });
+            active.out_flight.push((trb, index));
+        }
+        let dci = active.out_dci;
+        self.ring(slot_id, dci);
+    }
+
+    /// Whether an endpoint is a controller's voice endpoint.
+    pub(super) fn is_sco_endpoint(&self, slot_id: u8, dci: u8) -> bool {
+        self.slots.get(&slot_id).is_some_and(|slot| {
+            slot.bt.iter().any(|bt| {
+                bt.sco.as_ref().and_then(|sco| sco.active.as_ref()).is_some_and(|active| active.in_dci == dci || active.out_dci == dci)
+            })
+        })
+    }
+
+    /// A voice packet's end: what came in goes to the stack, a piece that
+    /// went out frees its buffer.
+    pub(super) fn sco_done(&mut self, slot_id: u8, dci: u8, event: &Trb) {
+        let code = event.completion_code();
+        let Some(bluetooth) = self.slots.get_mut(&slot_id).and_then(|slot| {
+            slot.bt.iter_mut().find(|bt| {
+                bt.sco.as_ref().and_then(|sco| sco.active.as_ref()).is_some_and(|active| active.in_dci == dci || active.out_dci == dci)
+            })
+        }) else {
+            return;
+        };
+        let controller = bluetooth.controller.clone();
+        let Some(sco) = bluetooth.sco.as_mut() else { return };
+        let Some(active) = sco.active.as_mut() else { return };
+        if dci == active.out_dci {
+            // This piece and those before it (a missed one reports nothing).
+            if let Some(position) = active.out_flight.iter().position(|(trb, _)| *trb == event.parameter) {
+                for (_, index) in active.out_flight.drain(..=position) {
+                    active.out_free.push(index);
+                }
+            }
+            return;
+        }
+        let Some(position) = active.in_flight.iter().position(|(trb, _)| *trb == event.parameter) else { return };
+        let mut done: Vec<(u64, usize)> = active.in_flight.drain(..=position).collect();
+        let (_, index) = done.pop().unwrap();
+        let mut packets = Vec::new();
+        if code == SUCCESS || code == SHORT_PACKET {
+            let length = active.in_size.saturating_sub((event.status & 0xff_ffff) as usize);
+            if length > 0 {
+                let mut data = alloc::vec![0u8; length];
+                if active.buffers.read_bytes(index * active.slot, &mut data).is_ok() {
+                    packets = sco.reassembly.push(&data);
+                }
+            }
+        }
+        // Those missed before it, and it, go in again.
+        for (_, missed) in done {
+            Self::queue_sco_in(active, missed);
+        }
+        Self::queue_sco_in(active, index);
+        for packet in packets {
+            controller.receive(hci::SCO_PKT, &packet);
+        }
+        self.ring(slot_id, dci);
+    }
+}
