diff --git a/kernel/comps/sound/src/card.rs b/kernel/comps/sound/src/card.rs
new file mode 100755
index 0000000..e11a444
--- /dev/null
+++ b/kernel/comps/sound/src/card.rs
@@ -0,0 +1,434 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! A sound card as ALSA presents it: an HDA controller with its first codec
+//! that has analog outputs or inputs; a playback and a capture stream; the
+//! mixer controls (the master volume and switch, the capture ones, the
+//! jacks); and a task that follows the headphone jack, turning the speakers
+//! off while headphones are in.
+
+use alloc::{
+    boxed::Box,
+    format,
+    string::{String, ToString},
+    sync::Arc,
+    vec,
+    vec::Vec,
+};
+use core::sync::atomic::{AtomicU64, Ordering};
+
+use ostd::sync::{LocalIrqDisabled, SpinLock, WaitQueue};
+
+use crate::{
+    codec::{self, Amp, Codec, Kind, PinDevice, Route, parameter, verb},
+    hda::{self, Controller, Stream},
+    params::{HwLimits, Mask, format, info},
+    pcm::{Direction, Pcm},
+};
+
+/// `SNDRV_CTL_ELEM_IFACE_*`.
+pub const IFACE_CARD: i32 = 0;
+pub const IFACE_MIXER: i32 = 2;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ControlKind {
+    Boolean,
+    Integer { min: i64, max: i64 },
+}
+
+/// What a control does when set.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Target {
+    PlaybackVolume,
+    PlaybackSwitch,
+    CaptureVolume,
+    CaptureSwitch,
+    /// A jack's presence (read only).
+    Jack,
+}
+
+pub struct Control {
+    pub name: String,
+    pub iface: i32,
+    pub kind: ControlKind,
+    pub count: u32,
+    pub writable: bool,
+    /// A dB scale: (the lowest step's gain, the step, in hundredths of a
+    /// dB; whether the lowest is a mute).
+    pub db_scale: Option<(i32, u32, bool)>,
+    values: SpinLock<Vec<i64>, LocalIrqDisabled>,
+    target: Target,
+    /// When it last changed (the card's event counter).
+    pub changed: AtomicU64,
+}
+
+impl Control {
+    pub fn values(&self) -> Vec<i64> {
+        self.values.lock().clone()
+    }
+}
+
+pub struct Card {
+    pub index: u32,
+    pub id: String,
+    pub driver: String,
+    pub name: String,
+    pub longname: String,
+    pub mixer_name: String,
+    pub components: String,
+    pub pcm_name: String,
+    pub playback: Option<Arc<Pcm>>,
+    pub capture: Option<Arc<Pcm>>,
+    pub controls: Vec<Control>,
+    /// Counts control changes; readers of events wait for it to move.
+    pub events: AtomicU64,
+    pub event_wait: WaitQueue,
+    controller: Arc<Controller>,
+    codec: usize,
+    outputs: Vec<Route>,
+    inputs: Vec<Route>,
+    /// Whether each output plays now (headphones in: not the speakers).
+    enabled: SpinLock<Vec<bool>, LocalIrqDisabled>,
+}
+
+/// Makers' names for the codecs' vendor IDs (as Linux's `hda_codec.c`).
+fn vendor_name(vendor: u32) -> String {
+    let (maker, device) = ((vendor >> 16) as u16, vendor as u16);
+    match maker {
+        0x10ec => format!("Realtek ALC{:x}", device),
+        0x14f1 => format!("Conexant CX{:x}", device),
+        0x111d | 0x8384 => format!("IDT 92HD{:x}", device),
+        0x1013 => format!("Cirrus Logic CS{:x}", device),
+        0x11d4 => format!("Analog Devices AD{:x}", device),
+        0x1106 => format!("VIA VT{:x}", device),
+        0x8086 => format!("Intel {:x}", device),
+        0x1002 => format!("ATI {:x}", device),
+        0x10de => format!("Nvidia {:x}", device),
+        0x434d => format!("C-Media CMI{:x}", device),
+        0x1af4 => "QEMU".to_string(),
+        _ => format!("Generic {:04x} ID {:04x}", maker, device),
+    }
+}
+
+/// ALSA's names for the controller (card ID, name).
+fn card_names(vendor: u16) -> (&'static str, &'static str) {
+    match vendor {
+        0x8086 => ("PCH", "HDA Intel PCH"),
+        0x1022 | 0x1002 => ("Generic", "HD-Audio Generic"),
+        0x10de => ("NVidia", "HDA NVidia"),
+        _ => ("Intel", "HDA Intel"),
+    }
+}
+
+impl Card {
+    /// The card of a controller, if one of its codecs has analog outputs or
+    /// inputs (a GPU's HDMI-only controller has none).
+    pub(crate) fn new(index: u32, controller: Arc<Controller>, vendor: u16, location: String) -> Option<Arc<Self>> {
+        let (codec_index, codec) = controller
+            .codecs
+            .iter()
+            .enumerate()
+            .find(|(_, codec)| !codec.output_routes().is_empty() || !codec.input_routes().is_empty())?;
+        let outputs = codec.output_routes();
+        let inputs = codec.input_routes();
+        let mixer_name = vendor_name(codec.vendor);
+        let (id, name) = card_names(vendor);
+        let pcm_name = format!("{} Analog", mixer_name.split(' ').nth(1).unwrap_or("HDA"));
+
+        // Set the paths up: powered, routed, at 0 dB.
+        for route in &outputs {
+            for (nid, verb, payload) in codec.setup_verbs(route, true) {
+                controller.command(codec.address, nid, verb, payload);
+            }
+        }
+        for route in &inputs {
+            for (nid, verb, payload) in codec.setup_verbs(route, false) {
+                controller.command(codec.address, nid, verb, payload);
+            }
+        }
+
+        let playback = if outputs.is_empty() {
+            None
+        } else {
+            let mut converters: Vec<(u8, u8)> = outputs.iter().map(|route| (codec.address, route.path.converter)).collect();
+            converters.dedup();
+            let base = controller.output_descriptor(0)?;
+            let stream = Stream::new(controller.clone(), base, 1, converters.clone())?;
+            let limits = limits_of(&controller, codec, &converters);
+            Pcm::new(Direction::Playback, limits, pcm_name.clone(), pcm_name.clone(), Box::new(stream))
+        };
+        let capture = match inputs.first() {
+            None => None,
+            Some(route) => {
+                let converters = vec![(codec.address, route.path.converter)];
+                let base = controller.input_descriptor(0)?;
+                let stream = Stream::new(controller.clone(), base, 1, converters.clone())?;
+                let limits = limits_of(&controller, codec, &converters);
+                Pcm::new(Direction::Capture, limits, pcm_name.clone(), pcm_name.clone(), Box::new(stream))
+            }
+        };
+
+        let mut controls = Vec::new();
+        let mut add_amp_controls = |prefix: &str, amp: Option<Amp>, volume: Target, switch: Target| {
+            if let Some(amp) = amp {
+                let step = (amp.caps.step_size + 1) * 25;
+                controls.push(Control {
+                    name: format!("{} Volume", prefix),
+                    iface: IFACE_MIXER,
+                    kind: ControlKind::Integer { min: 0, max: i64::from(amp.caps.steps) },
+                    count: 2,
+                    writable: true,
+                    db_scale: Some((amp.caps.centibels(0), step, false)),
+                    values: SpinLock::new(vec![i64::from(amp.caps.offset); 2]),
+                    target: volume,
+                    changed: AtomicU64::new(0),
+                });
+            }
+            controls.push(Control {
+                name: format!("{} Switch", prefix),
+                iface: IFACE_MIXER,
+                kind: ControlKind::Boolean,
+                count: 2,
+                writable: true,
+                db_scale: None,
+                values: SpinLock::new(vec![1; 2]),
+                target: switch,
+                changed: AtomicU64::new(0),
+            });
+        };
+        if let Some(route) = outputs.first() {
+            add_amp_controls("Master Playback", codec.volume_amp(route, true), Target::PlaybackVolume, Target::PlaybackSwitch);
+        }
+        if let Some(route) = inputs.first() {
+            add_amp_controls("Capture", codec.volume_amp(route, false), Target::CaptureVolume, Target::CaptureSwitch);
+        }
+        for (device, label) in [(PinDevice::Headphone, "Headphone Jack"), (PinDevice::Mic, "Mic Jack")] {
+            let routes = if device == PinDevice::Headphone { &outputs } else { &inputs };
+            if routes.iter().any(|route| route.device == device && !route.internal && pin(codec, route.pin).is_some_and(|w| w.presence_detect())) {
+                controls.push(Control {
+                    name: label.to_string(),
+                    iface: IFACE_CARD,
+                    kind: ControlKind::Boolean,
+                    count: 1,
+                    writable: false,
+                    db_scale: None,
+                    values: SpinLock::new(vec![0]),
+                    target: Target::Jack,
+                    changed: AtomicU64::new(0),
+                });
+            }
+        }
+
+        let card = Arc::new(Self {
+            index,
+            id: id.to_string(),
+            driver: "HDA-Intel".to_string(),
+            name: name.to_string(),
+            longname: format!("{} at {}", name, location),
+            components: format!("HDA:{:08x}", codec.vendor),
+            mixer_name,
+            pcm_name,
+            playback,
+            capture,
+            controls,
+            events: AtomicU64::new(0),
+            event_wait: WaitQueue::new(),
+            controller: controller.clone(),
+            codec: codec_index,
+            enabled: SpinLock::new(vec![true; outputs.len()]),
+            outputs,
+            inputs,
+        });
+        card.apply_all();
+        Some(card)
+    }
+
+    fn codec(&self) -> &Codec {
+        &self.controller.codecs[self.codec]
+    }
+
+    /// Sets a control's values; returns whether they changed.
+    pub fn set_control(&self, index: usize, values: &[i64]) -> bool {
+        let Some(control) = self.controls.get(index) else { return false };
+        if !control.writable {
+            return false;
+        }
+        let clamped: Vec<i64> = (0..control.count as usize)
+            .map(|channel| {
+                let value = values.get(channel).copied().unwrap_or(0);
+                match control.kind {
+                    ControlKind::Boolean => i64::from(value != 0),
+                    ControlKind::Integer { min, max } => value.clamp(min, max),
+                }
+            })
+            .collect();
+        {
+            let mut current = control.values.lock();
+            if *current == clamped {
+                return false;
+            }
+            *current = clamped;
+        }
+        self.apply(control.target);
+        self.note_changed(index);
+        true
+    }
+
+    fn note_changed(&self, index: usize) {
+        let event = self.events.fetch_add(1, Ordering::AcqRel) + 1;
+        if let Some(control) = self.controls.get(index) {
+            control.changed.store(event, Ordering::Release);
+        }
+        self.event_wait.wake_all();
+        crate::note_activity();
+    }
+
+    fn control_values(&self, target: Target) -> Option<Vec<i64>> {
+        self.controls.iter().find(|control| control.target == target).map(Control::values)
+    }
+
+    fn apply_all(&self) {
+        for target in [Target::PlaybackVolume, Target::CaptureVolume] {
+            self.apply(target);
+        }
+    }
+
+    /// Puts a control's values on the codec: the volume and the mute on the
+    /// routes' amplifiers (or, without one, the pins).
+    fn apply(&self, target: Target) {
+        let (routes, output, volume, switch) = match target {
+            Target::PlaybackVolume | Target::PlaybackSwitch => (&self.outputs[..], true, Target::PlaybackVolume, Target::PlaybackSwitch),
+            Target::CaptureVolume | Target::CaptureSwitch => (&self.inputs[..self.inputs.len().min(1)], false, Target::CaptureVolume, Target::CaptureSwitch),
+            Target::Jack => return,
+        };
+        let codec = self.codec();
+        let levels = self.control_values(volume);
+        let on = self.control_values(switch).unwrap_or_else(|| vec![1, 1]);
+        let enabled = self.enabled.lock().clone();
+        for (index, route) in routes.iter().enumerate() {
+            let playing = !output || enabled.get(index).copied().unwrap_or(true);
+            match codec.volume_amp(route, output) {
+                Some(amp) => {
+                    for channel in 0..2usize {
+                        // Each route's amplifier at the same share of its range.
+                        let gain = match (&levels, self.controls.iter().find(|c| c.target == volume)) {
+                            (Some(levels), Some(Control { kind: ControlKind::Integer { max, .. }, .. })) if *max > 0 => {
+                                (levels[channel].max(0) as u64 * u64::from(amp.caps.steps) / *max as u64) as u32
+                            }
+                            _ => amp.caps.offset,
+                        };
+                        let mute = on.get(channel).copied().unwrap_or(1) == 0 || !playing;
+                        let side = if channel == 0 { 1 << 13 } else { 1 << 12 };
+                        let payload = (codec::amp_payload(&amp, gain, mute) & !(3 << 12)) | side;
+                        self.controller.command(codec.address, amp.nid, verb::SET_AMP_GAIN_MUTE, payload);
+                    }
+                }
+                None => {}
+            }
+            if output {
+                // The pin itself on or off (for routes without a mutable amplifier).
+                let audible = playing && on.iter().any(|&value| value != 0);
+                let control = if audible {
+                    codec::PIN_OUT | if route.device == PinDevice::Headphone && pin(codec, route.pin).is_some_and(|w| w.pin_caps & (1 << 3) != 0) { codec::PIN_HP } else { 0 }
+                } else {
+                    0
+                };
+                self.controller.command(codec.address, route.pin, verb::SET_PIN_WIDGET_CONTROL, control);
+            }
+        }
+    }
+
+    /// Whether something is plugged into a pin's jack.
+    fn sense(&self, nid: u8) -> bool {
+        let codec = self.codec();
+        if pin(codec, nid).is_some_and(|w| w.needs_sense_trigger()) {
+            self.controller.command(codec.address, nid, verb::SET_PIN_SENSE, 0);
+        }
+        self.controller.command(codec.address, nid, verb::GET_PIN_SENSE, 0).is_some_and(|sense| sense & (1 << 31) != 0)
+    }
+
+    /// Looks at the jacks: headphones in turn the speakers and line outs
+    /// off; the jack controls follow.
+    pub(crate) fn poll_jacks(&self) {
+        let headphones = self.outputs.iter().filter(|r| r.device == PinDevice::Headphone && !r.internal).find(|r| pin(self.codec(), r.pin).is_some_and(|w| w.presence_detect()));
+        let mic = self.inputs.iter().filter(|r| r.device == PinDevice::Mic && !r.internal).find(|r| pin(self.codec(), r.pin).is_some_and(|w| w.presence_detect()));
+        let headphones_in = headphones.is_some_and(|route| self.sense(route.pin));
+        let mic_in = mic.is_some_and(|route| self.sense(route.pin));
+        let enabled = codec::outputs_enabled(&self.outputs, headphones_in);
+        let changed = {
+            let mut current = self.enabled.lock();
+            let changed = *current != enabled;
+            *current = enabled;
+            changed
+        };
+        if changed {
+            self.apply(Target::PlaybackSwitch);
+        }
+        for (label, present) in [("Headphone Jack", headphones_in), ("Mic Jack", mic_in)] {
+            if let Some(index) = self.controls.iter().position(|control| control.name == label) {
+                let value = i64::from(present);
+                let moved = {
+                    let mut values = self.controls[index].values.lock();
+                    let moved = values[0] != value;
+                    values[0] = value;
+                    moved
+                };
+                if moved {
+                    self.note_changed(index);
+                }
+            }
+        }
+    }
+
+    /// A control of the user's changed (the device files keep those):
+    /// subscribers hear of it. Returns the event's number.
+    pub fn note_user_change(&self) -> u64 {
+        let event = self.events.fetch_add(1, Ordering::AcqRel) + 1;
+        self.event_wait.wake_all();
+        crate::note_activity();
+        event
+    }
+
+    pub fn pcms(&self) -> impl Iterator<Item = &Arc<Pcm>> {
+        self.playback.iter().chain(self.capture.iter())
+    }
+}
+
+fn pin(codec: &Codec, nid: u8) -> Option<&codec::Widget> {
+    codec.widgets.get(&nid).filter(|widget| widget.kind() == Kind::Pin)
+}
+
+/// What a stream over these converters can do: the rates and sample sizes
+/// all of them take (theirs, or the function group's).
+fn limits_of(controller: &Controller, codec: &Codec, converters: &[(u8, u8)]) -> HwLimits {
+    let group = controller.command(codec.address, codec.afg, verb::GET_PARAMETER, parameter::PCM).unwrap_or(0);
+    let mut rates: Option<Vec<u32>> = None;
+    let mut bits = 32;
+    for &(address, nid) in converters {
+        let own = controller.command(address, nid, verb::GET_PARAMETER, parameter::PCM).unwrap_or(0);
+        let pcm = if own & 0xfff != 0 { own } else { group };
+        let these = codec::rates_of(pcm);
+        rates = Some(match rates {
+            None => these,
+            Some(rates) => rates.into_iter().filter(|rate| these.contains(rate)).collect(),
+        });
+        bits = bits.min(codec::max_bits_of(pcm));
+    }
+    let mut rates = rates.unwrap_or_default();
+    // Rates the stream format cannot express go.
+    rates.retain(|&rate| codec::stream_format(rate, 16, 2).is_some());
+    if rates.is_empty() {
+        rates = vec![48000];
+    }
+    let formats = if bits >= 20 { Mask::of(&[format::S16_LE, format::S32_LE]) } else { Mask::of(&[format::S16_LE]) };
+    HwLimits {
+        info: info::MMAP | info::MMAP_VALID | info::INTERLEAVED | info::BLOCK_TRANSFER | info::PAUSE,
+        formats,
+        rates,
+        channels: (2, 2),
+        period_bytes: (128, 512 * 1024),
+        periods: (2, hda::MAX_PERIODS),
+        buffer_bytes_max: 1024 * 1024,
+        byte_step: 128,
+        msbits: bits.max(16),
+    }
+}
diff --git a/kernel/comps/sound/src/codec.rs b/kernel/comps/sound/src/codec.rs
new file mode 100755
index 0000000..f9165f9
--- /dev/null
+++ b/kernel/comps/sound/src/codec.rs
@@ -0,0 +1,551 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! An HDA codec's widgets and how sound gets through them: from each output
+//! jack or speaker back to a digital-to-analog converter, from an
+//! analog-to-digital converter back to each microphone, through mixers and
+//! selectors; the verbs that set those paths up (powered, selected,
+//! unmuted, at 0 dB, the pins driven, the external amplifiers on); stream
+//! formats; and turning speakers off while headphones are in, as Linux's
+//! generic HDA codec driver does. No hardware here: its tests run on the
+//! host.
+//!
+//! References: Intel High Definition Audio Specification 1.0a, chapter 7;
+//! Linux's `sound/pci/hda/hda_generic.c`.
+
+use alloc::{collections::BTreeMap, vec::Vec};
+
+/// Verbs (with a 12-bit identifier and an 8-bit payload, or a 4-bit one
+/// and a 16-bit payload).
+pub mod verb {
+    pub const GET_PARAMETER: u32 = 0xf00;
+    pub const GET_CONNECT_SELECT: u32 = 0xf01;
+    pub const SET_CONNECT_SELECT: u32 = 0x701;
+    pub const GET_CONNECTION_LIST: u32 = 0xf02;
+    pub const SET_POWER_STATE: u32 = 0x705;
+    pub const SET_CHANNEL_STREAM_ID: u32 = 0x706;
+    pub const SET_PIN_WIDGET_CONTROL: u32 = 0x707;
+    pub const SET_UNSOLICITED: u32 = 0x708;
+    pub const SET_PIN_SENSE: u32 = 0x709;
+    pub const GET_PIN_SENSE: u32 = 0xf09;
+    pub const SET_EAPD_BTL: u32 = 0x70c;
+    pub const SET_GPIO_DATA: u32 = 0x715;
+    pub const SET_GPIO_MASK: u32 = 0x716;
+    pub const SET_GPIO_DIRECTION: u32 = 0x717;
+    pub const GET_CONFIG_DEFAULT: u32 = 0xf1c;
+    pub const SET_CODEC_RESET: u32 = 0x7ff;
+    /// 4-bit verbs.
+    pub const SET_STREAM_FORMAT: u32 = 0x2;
+    pub const SET_AMP_GAIN_MUTE: u32 = 0x3;
+}
+
+/// `GET_PARAMETER` parameters.
+pub mod parameter {
+    pub const VENDOR_ID: u32 = 0x00;
+    pub const SUBNODE_COUNT: u32 = 0x04;
+    pub const FUNCTION_TYPE: u32 = 0x05;
+    pub const AUDIO_WIDGET_CAP: u32 = 0x09;
+    pub const PCM: u32 = 0x0a;
+    pub const STREAM_FORMATS: u32 = 0x0b;
+    pub const PIN_CAP: u32 = 0x0c;
+    pub const AMP_IN_CAP: u32 = 0x0d;
+    pub const CONNECTION_LIST_LENGTH: u32 = 0x0e;
+    pub const GPIO_COUNT: u32 = 0x11;
+    pub const AMP_OUT_CAP: u32 = 0x12;
+}
+
+/// A command for codec `codec`'s node `nid`.
+pub fn command(codec: u8, nid: u8, verb: u32, payload: u32) -> u32 {
+    let head = u32::from(codec & 0xf) << 28 | u32::from(nid) << 20;
+    if verb <= 0xf { head | verb << 16 | (payload & 0xffff) } else { head | (verb & 0xfff) << 8 | (payload & 0xff) }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Kind {
+    Output,
+    Input,
+    Mixer,
+    Selector,
+    Pin,
+    Power,
+    VolumeKnob,
+    Beep,
+    Vendor,
+}
+
+/// What a pin is connected to, from its configuration default.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub enum PinDevice {
+    LineOut,
+    Speaker,
+    Headphone,
+    LineIn,
+    Mic,
+    Digital,
+    Other,
+}
+
+const PIN_CAP_PRESENCE: u32 = 1 << 2;
+const PIN_CAP_TRIGGER: u32 = 1 << 1;
+const PIN_CAP_HEADPHONE: u32 = 1 << 3;
+const PIN_CAP_OUT: u32 = 1 << 4;
+const PIN_CAP_IN: u32 = 1 << 5;
+const PIN_CAP_HDMI: u32 = 1 << 7;
+const PIN_CAP_EAPD: u32 = 1 << 16;
+const PIN_CAP_DP: u32 = 1 << 24;
+/// Pin widget control bits.
+pub const PIN_OUT: u32 = 0x40;
+pub const PIN_HP: u32 = 0x80;
+pub const PIN_IN: u32 = 0x20;
+const PIN_VREF_80: u32 = 0x04;
+const PIN_VREF_50: u32 = 0x01;
+
+/// One widget of the audio function group.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Widget {
+    pub nid: u8,
+    pub caps: u32,
+    pub pin_caps: u32,
+    pub config: u32,
+    pub connections: Vec<u8>,
+    pub amp_in: u32,
+    pub amp_out: u32,
+}
+
+impl Widget {
+    pub fn kind(&self) -> Kind {
+        match (self.caps >> 20) & 0xf {
+            0 => Kind::Output,
+            1 => Kind::Input,
+            2 => Kind::Mixer,
+            3 => Kind::Selector,
+            4 => Kind::Pin,
+            5 => Kind::Power,
+            6 => Kind::VolumeKnob,
+            7 => Kind::Beep,
+            _ => Kind::Vendor,
+        }
+    }
+
+    pub fn has_in_amp(&self) -> bool {
+        self.caps & (1 << 1) != 0
+    }
+
+    pub fn has_out_amp(&self) -> bool {
+        self.caps & (1 << 2) != 0
+    }
+
+    /// Its amplifier capabilities are its own, not the function group's.
+    pub fn amp_override(&self) -> bool {
+        self.caps & (1 << 3) != 0
+    }
+
+    pub fn digital(&self) -> bool {
+        self.caps & (1 << 9) != 0
+    }
+
+    pub fn power_control(&self) -> bool {
+        self.caps & (1 << 10) != 0
+    }
+
+    pub fn stereo(&self) -> bool {
+        self.caps & 1 != 0
+    }
+
+    /// Not connected to anything (configuration default: "no connection").
+    pub fn unconnected(&self) -> bool {
+        self.config >> 30 == 1
+    }
+
+    pub fn device(&self) -> PinDevice {
+        if self.pin_caps & (PIN_CAP_HDMI | PIN_CAP_DP) != 0 {
+            return PinDevice::Digital;
+        }
+        match (self.config >> 20) & 0xf {
+            0x0 => PinDevice::LineOut,
+            0x1 => PinDevice::Speaker,
+            0x2 => PinDevice::Headphone,
+            0x4 | 0x5 | 0xc | 0xd => PinDevice::Digital,
+            0x8 => PinDevice::LineIn,
+            0xa => PinDevice::Mic,
+            _ => PinDevice::Other,
+        }
+    }
+
+    /// Built in (fixed: a laptop's speakers or microphone), not a jack.
+    pub fn internal(&self) -> bool {
+        self.config >> 30 == 2
+    }
+
+    pub fn can_output(&self) -> bool {
+        self.pin_caps & PIN_CAP_OUT != 0
+    }
+
+    pub fn can_input(&self) -> bool {
+        self.pin_caps & PIN_CAP_IN != 0
+    }
+
+    pub fn presence_detect(&self) -> bool {
+        self.pin_caps & PIN_CAP_PRESENCE != 0 && (self.config >> 8) & 1 == 0
+    }
+
+    pub fn needs_sense_trigger(&self) -> bool {
+        self.pin_caps & PIN_CAP_TRIGGER != 0
+    }
+}
+
+/// Expands a connection list's entries (`GET_CONNECTION_LIST`), where an
+/// entry with its top bit set ends a range starting at the one before.
+pub fn expand_connections(entries: &[u16], long_form: bool) -> Vec<u8> {
+    let range_bit = if long_form { 0x8000 } else { 0x80 };
+    let mut list: Vec<u8> = Vec::new();
+    for &entry in entries {
+        let nid = (entry & !range_bit) as u8;
+        if entry & range_bit != 0 {
+            if let Some(&previous) = list.last() {
+                for nid in previous.saturating_add(1)..=nid {
+                    list.push(nid);
+                }
+                continue;
+            }
+        }
+        list.push(nid);
+    }
+    list
+}
+
+/// Amplifier capabilities: the 0 dB step, how many steps, mute.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct AmpCaps {
+    pub offset: u32,
+    pub steps: u32,
+    pub step_size: u32,
+    pub mute: bool,
+}
+
+impl AmpCaps {
+    pub fn parse(raw: u32) -> Self {
+        Self { offset: raw & 0x7f, steps: (raw >> 8) & 0x7f, step_size: (raw >> 16) & 0x7f, mute: raw >> 31 != 0 }
+    }
+
+    /// The gain in hundredths of a dB of `step`.
+    pub fn centibels(&self, step: u32) -> i32 {
+        (step as i32 - self.offset as i32) * (self.step_size as i32 + 1) * 25
+    }
+}
+
+/// An amplifier: on a widget's output, or on one of its inputs.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Amp {
+    pub nid: u8,
+    pub output: bool,
+    pub index: u8,
+    pub caps: AmpCaps,
+}
+
+/// The payload of `SET_AMP_GAIN_MUTE` for both channels of `amp`.
+pub fn amp_payload(amp: &Amp, gain: u32, mute: bool) -> u32 {
+    let direction = if amp.output { 1 << 15 } else { 1 << 14 };
+    direction | 3 << 12 | u32::from(amp.index) << 8 | u32::from(mute) << 7 | gain.min(amp.caps.steps) & 0x7f
+}
+
+/// The widgets of a codec's audio function group, by node.
+#[derive(Clone, Debug, Default)]
+pub struct Codec {
+    pub address: u8,
+    pub afg: u8,
+    pub vendor: u32,
+    pub widgets: BTreeMap<u8, Widget>,
+    /// The function group's amplifier capabilities, for widgets without their own.
+    pub amp_in: u32,
+    pub amp_out: u32,
+    pub gpios: u32,
+}
+
+/// A path through the codec: its widgets from the pin (or converter) end,
+/// each with the input it takes (its connection index), the last one the
+/// converter.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Path {
+    pub hops: Vec<(u8, u8)>,
+    pub converter: u8,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Route {
+    pub pin: u8,
+    pub device: PinDevice,
+    pub internal: bool,
+    pub path: Path,
+}
+
+impl Codec {
+    fn amp_caps(&self, widget: &Widget, output: bool) -> AmpCaps {
+        let own = if output { widget.amp_out } else { widget.amp_in };
+        let shared = if output { self.amp_out } else { self.amp_in };
+        AmpCaps::parse(if widget.amp_override() || own != 0 { own } else { shared })
+    }
+
+    /// A path from `from` back to a converter of `kind`, at most `depth`
+    /// widgets long, avoiding `used` converters; the shortest found first.
+    fn find(&self, from: u8, kind: Kind, used: &[u8], seen: &mut Vec<u8>, depth: usize) -> Option<Path> {
+        let widget = self.widgets.get(&from)?;
+        if depth == 0 || seen.contains(&from) {
+            return None;
+        }
+        seen.push(from);
+        // Converters straight on the list first.
+        for (index, &source) in widget.connections.iter().enumerate() {
+            let Some(next) = self.widgets.get(&source) else { continue };
+            if next.kind() == kind && !next.digital() && !used.contains(&source) {
+                seen.pop();
+                return Some(Path { hops: alloc::vec![(from, index as u8)], converter: source });
+            }
+        }
+        for (index, &source) in widget.connections.iter().enumerate() {
+            let Some(next) = self.widgets.get(&source) else { continue };
+            if matches!(next.kind(), Kind::Mixer | Kind::Selector) {
+                if let Some(mut path) = self.find(source, kind, used, seen, depth - 1) {
+                    path.hops.insert(0, (from, index as u8));
+                    seen.pop();
+                    return Some(path);
+                }
+            }
+        }
+        seen.pop();
+        None
+    }
+
+    /// Where a path from a converter's side reaches it: for an input path
+    /// (the converter takes from the pin), the hops from the converter.
+    fn find_input(&self, converter: u8, pin: u8, seen: &mut Vec<u8>, depth: usize) -> Option<Vec<(u8, u8)>> {
+        let widget = self.widgets.get(&converter)?;
+        if depth == 0 || seen.contains(&converter) {
+            return None;
+        }
+        seen.push(converter);
+        for (index, &source) in widget.connections.iter().enumerate() {
+            if source == pin {
+                seen.pop();
+                return Some(alloc::vec![(converter, index as u8)]);
+            }
+        }
+        for (index, &source) in widget.connections.iter().enumerate() {
+            let Some(next) = self.widgets.get(&source) else { continue };
+            if matches!(next.kind(), Kind::Mixer | Kind::Selector) {
+                if let Some(mut hops) = self.find_input(source, pin, seen, depth - 1) {
+                    hops.insert(0, (converter, index as u8));
+                    seen.pop();
+                    return Some(hops);
+                }
+            }
+        }
+        seen.pop();
+        None
+    }
+
+    fn pins(&self, output: bool) -> Vec<&Widget> {
+        let mut pins: Vec<&Widget> = self
+            .widgets
+            .values()
+            .filter(|w| w.kind() == Kind::Pin && !w.unconnected() && w.device() != PinDevice::Digital)
+            .filter(|w| if output { w.can_output() } else { w.can_input() })
+            .collect();
+        // Pins without a configuration (all zero: a line out by default)
+        // are taken only when nothing else is there.
+        let configured: Vec<&Widget> = pins.iter().copied().filter(|w| w.config != 0).collect();
+        if !configured.is_empty() {
+            pins = configured;
+        }
+        if output {
+            pins.retain(|w| matches!(w.device(), PinDevice::LineOut | PinDevice::Speaker | PinDevice::Headphone));
+        } else {
+            pins.retain(|w| matches!(w.device(), PinDevice::Mic | PinDevice::LineIn));
+        }
+        pins.sort_by_key(|w| (w.device(), !w.internal(), w.nid));
+        pins
+    }
+
+    /// The outputs: each speaker, headphone and line-out pin with a path
+    /// from a converter, each its own converter while there are enough.
+    pub fn output_routes(&self) -> Vec<Route> {
+        let mut used = Vec::new();
+        let mut routes = Vec::new();
+        for pin in self.pins(true) {
+            let path = self.find(pin.nid, Kind::Output, &used, &mut Vec::new(), 6).or_else(|| self.find(pin.nid, Kind::Output, &[], &mut Vec::new(), 6));
+            if let Some(path) = path {
+                used.push(path.converter);
+                routes.push(Route { pin: pin.nid, device: pin.device(), internal: pin.internal(), path });
+            }
+        }
+        routes
+    }
+
+    /// The inputs: microphones and line inputs with a converter reaching them.
+    pub fn input_routes(&self) -> Vec<Route> {
+        let mut routes = Vec::new();
+        let converters: Vec<u8> = self.widgets.values().filter(|w| w.kind() == Kind::Input && !w.digital()).map(|w| w.nid).collect();
+        for pin in self.pins(false) {
+            for &converter in &converters {
+                if let Some(hops) = self.find_input(converter, pin.nid, &mut Vec::new(), 6) {
+                    routes.push(Route { pin: pin.nid, device: pin.device(), internal: pin.internal(), path: Path { hops, converter } });
+                    break;
+                }
+            }
+        }
+        routes
+    }
+
+    /// The amplifier that sets a route's volume: the first with steps from
+    /// the converter on (its output, the mixers', the pin's).
+    pub fn volume_amp(&self, route: &Route, output_route: bool) -> Option<Amp> {
+        let mut candidates: Vec<Amp> = Vec::new();
+        let mut push = |nid: u8, output: bool, index: u8| {
+            if let Some(widget) = self.widgets.get(&nid) {
+                let present = if output { widget.has_out_amp() } else { widget.has_in_amp() };
+                let caps = self.amp_caps(widget, output);
+                if present && caps.steps > 0 {
+                    candidates.push(Amp { nid, output, index, caps });
+                }
+            }
+        };
+        if output_route {
+            push(route.path.converter, true, 0);
+            for &(nid, index) in route.path.hops.iter().rev() {
+                push(nid, false, index);
+                push(nid, true, 0);
+            }
+        } else {
+            for &(nid, index) in &route.path.hops {
+                push(nid, false, index);
+            }
+            push(route.pin, true, 0);
+        }
+        candidates.into_iter().next()
+    }
+
+    /// The verbs that set a route up: powered, its inputs selected, its
+    /// amplifiers unmuted at 0 dB (other mixer inputs muted), the pin
+    /// driven or listening, an external amplifier on.
+    pub fn setup_verbs(&self, route: &Route, output_route: bool) -> Vec<(u8, u32, u32)> {
+        let mut verbs = Vec::new();
+        let mut nids: Vec<u8> = alloc::vec![route.pin];
+        nids.extend(route.path.hops.iter().map(|&(nid, _)| nid));
+        nids.push(route.path.converter);
+        nids.dedup();
+        for &nid in &nids {
+            if self.widgets.get(&nid).is_some_and(Widget::power_control) {
+                verbs.push((nid, verb::SET_POWER_STATE, 0));
+            }
+        }
+        let unmute = |verbs: &mut Vec<(u8, u32, u32)>, widget: &Widget, output: bool, index: u8, mute: bool| {
+            let present = if output { widget.has_out_amp() } else { widget.has_in_amp() };
+            if present {
+                let caps = self.amp_caps(widget, output);
+                let amp = Amp { nid: widget.nid, output, index, caps };
+                verbs.push((widget.nid, verb::SET_AMP_GAIN_MUTE, amp_payload(&amp, caps.offset, mute)));
+            }
+        };
+        for &(nid, index) in &route.path.hops {
+            let Some(widget) = self.widgets.get(&nid) else { continue };
+            match widget.kind() {
+                // A pin picks its source; its own amplifiers are set below.
+                Kind::Pin => {
+                    if widget.connections.len() > 1 {
+                        verbs.push((nid, verb::SET_CONNECT_SELECT, u32::from(index)));
+                    }
+                    continue;
+                }
+                Kind::Selector | Kind::Input if widget.connections.len() > 1 => {
+                    verbs.push((nid, verb::SET_CONNECT_SELECT, u32::from(index)));
+                }
+                _ => {}
+            }
+            // The input taken, unmuted; the others (the loopback mixer's
+            // inputs among them) muted.
+            for other in 0..widget.connections.len().max(1) as u8 {
+                unmute(&mut verbs, widget, false, other, other != index);
+            }
+            unmute(&mut verbs, widget, true, 0, false);
+        }
+        if output_route {
+            if let Some(converter) = self.widgets.get(&route.path.converter) {
+                unmute(&mut verbs, converter, true, 0, false);
+            }
+        }
+        if let Some(pin) = self.widgets.get(&route.pin) {
+            if output_route {
+                let control = PIN_OUT | if route.device == PinDevice::Headphone && pin.pin_caps & PIN_CAP_HEADPHONE != 0 { PIN_HP } else { 0 };
+                verbs.push((pin.nid, verb::SET_PIN_WIDGET_CONTROL, control));
+                unmute(&mut verbs, pin, true, 0, false);
+            } else {
+                // A microphone's bias voltage, where the pin offers it.
+                let vref_caps = (pin.pin_caps >> 8) & 0xff;
+                let vref = if route.device != PinDevice::Mic {
+                    0
+                } else if vref_caps & (1 << 4) != 0 {
+                    PIN_VREF_80
+                } else if vref_caps & (1 << 1) != 0 {
+                    PIN_VREF_50
+                } else {
+                    0
+                };
+                verbs.push((pin.nid, verb::SET_PIN_WIDGET_CONTROL, PIN_IN | vref));
+                unmute(&mut verbs, pin, false, 0, false);
+            }
+            if pin.pin_caps & PIN_CAP_EAPD != 0 {
+                verbs.push((pin.nid, verb::SET_EAPD_BTL, 0x02));
+            }
+        }
+        verbs
+    }
+}
+
+/// Which outputs play: with headphones in, not the speakers nor the line
+/// outs (Linux's auto-mute); otherwise all of them.
+pub fn outputs_enabled(routes: &[Route], headphones_in: bool) -> Vec<bool> {
+    let has_headphones = routes.iter().any(|route| route.device == PinDevice::Headphone);
+    routes.iter().map(|route| route.device == PinDevice::Headphone || !(has_headphones && headphones_in)).collect()
+}
+
+/// Sample rates a converter offers (`PCM` parameter bits 0..11).
+pub const RATES: [u32; 12] = [8000, 11025, 16000, 22050, 32000, 44100, 48000, 88200, 96000, 176400, 192000, 384000];
+
+pub fn rates_of(pcm: u32) -> Vec<u32> {
+    RATES.iter().enumerate().filter(|(bit, _)| pcm & (1 << bit) != 0).map(|(_, &rate)| rate).collect()
+}
+
+/// The largest sample size a converter takes (`PCM` bits 16..20).
+pub fn max_bits_of(pcm: u32) -> u32 {
+    [(20, 32), (19, 24), (18, 20), (17, 16), (16, 8)].iter().find(|(bit, _)| pcm & (1 << bit) != 0).map_or(16, |&(_, bits)| bits)
+}
+
+/// The stream format word for a rate, sample size and channel count.
+pub fn stream_format(rate: u32, bits: u32, channels: u32) -> Option<u16> {
+    let (base, mult, div): (u16, u16, u16) = match rate {
+        8000 => (0, 1, 6),
+        11025 => (1, 1, 4),
+        16000 => (0, 1, 3),
+        22050 => (1, 1, 2),
+        24000 => (0, 1, 2),
+        32000 => (0, 2, 3),
+        44100 => (1, 1, 1),
+        48000 => (0, 1, 1),
+        88200 => (1, 2, 1),
+        96000 => (0, 2, 1),
+        176400 => (1, 4, 1),
+        192000 => (0, 4, 1),
+        _ => return None,
+    };
+    let bits = match bits {
+        8 => 0,
+        16 => 1,
+        20 => 2,
+        24 => 3,
+        32 => 4,
+        _ => return None,
+    };
+    if !(1..=16).contains(&channels) {
+        return None;
+    }
+    Some(base << 14 | (mult - 1) << 11 | (div - 1) << 8 | bits << 4 | (channels as u16 - 1))
+}
