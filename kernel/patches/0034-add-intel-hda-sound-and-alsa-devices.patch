new file mode 100755
index 0000000..03db5f1
--- /dev/null
+++ b/kernel/core/src/device/snd/control.rs
@@ -0,0 +1,618 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! A card's control device: what the card is, its PCM devices, its mixer
+//! controls (listed, described, read, written, their dB scales) and the
+//! events of their changes for those who subscribe.
+
+use alloc::format;
+use core::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+use aster_sound::{Card, card::ControlKind};
+use device_id::DeviceId;
+use ostd::mm::VmIo;
+
+use super::{device_id, get_u32, put_str, put_u32, put_u64, watch};
+use crate::{
+    context::current_userspace,
+    device::{Device, DeviceType},
+    events::IoEvents,
+    fs::{
+        devtmpfs::DevtmpfsNodeMeta,
+        file::{PerOpenFileOps, StatusFlags},
+        vfs::{inode::FileOps, path::Path},
+    },
+    prelude::*,
+    process::signal::{PollHandle, Pollable, Pollee},
+    util::ioctl::RawIoctl,
+};
+
+/// `SNDRV_CTL_VERSION`: 2.0.9.
+const VERSION: u32 = 0x0002_0009;
+
+mod ioctl {
+    pub(super) const PVERSION: u32 = 0x8004_5500;
+    pub(super) const CARD_INFO: u32 = 0x8178_5501;
+    pub(super) const ELEM_LIST: u32 = 0xc050_5510;
+    pub(super) const ELEM_INFO: u32 = 0xc110_5511;
+    pub(super) const ELEM_READ: u32 = 0xc4c8_5512;
+    pub(super) const ELEM_WRITE: u32 = 0xc4c8_5513;
+    pub(super) const ELEM_LOCK: u32 = 0x4040_5514;
+    pub(super) const ELEM_ADD: u32 = 0xc110_5517;
+    pub(super) const ELEM_REPLACE: u32 = 0xc110_5518;
+    pub(super) const ELEM_REMOVE: u32 = 0xc040_5519;
+    pub(super) const TLV_WRITE: u32 = 0xc008_551b;
+    pub(super) const ELEM_UNLOCK: u32 = 0x4040_5515;
+    pub(super) const SUBSCRIBE_EVENTS: u32 = 0xc004_5516;
+    pub(super) const TLV_READ: u32 = 0xc008_551a;
+    pub(super) const HWDEP_NEXT_DEVICE: u32 = 0xc004_5520;
+    pub(super) const PCM_NEXT_DEVICE: u32 = 0xc004_5530;
+    pub(super) const PCM_INFO: u32 = 0xc120_5531;
+    pub(super) const PCM_PREFER_SUBDEVICE: u32 = 0x4004_5532;
+    pub(super) const RAWMIDI_NEXT_DEVICE: u32 = 0xc004_5540;
+    pub(super) const UMP_NEXT_DEVICE: u32 = 0xc004_5543;
+    pub(super) const POWER: u32 = 0xc004_55d0;
+    pub(super) const POWER_STATE: u32 = 0x8004_55d1;
+}
+
+const ID_SIZE: usize = 64;
+const INFO_SIZE: usize = 272;
+const VALUE_SIZE: usize = 1224;
+const EVENT_SIZE: usize = 72;
+/// `SNDRV_CTL_ELEM_TYPE_*`, `SNDRV_CTL_ELEM_ACCESS_*`.
+const TYPE_BOOLEAN: u32 = 1;
+const TYPE_INTEGER: u32 = 2;
+const ACCESS_READ: u32 = 1 << 0;
+const ACCESS_WRITE: u32 = 1 << 1;
+const ACCESS_TLV_READ: u32 = 1 << 4;
+const ACCESS_TLV_WRITE: u32 = 1 << 5;
+const ACCESS_USER: u32 = 1 << 29;
+const TYPE_INTEGER64: u32 = 6;
+/// Values a control holds at most (Linux's limit for integers).
+const MAX_VALUES: u32 = 128;
+/// TLV data a control of the user's keeps at most.
+const MAX_TLV: usize = 4096;
+const EVENT_ELEM: u32 = 0;
+const EVENT_MASK_VALUE: u32 = 1 << 0;
+/// `SNDRV_CTL_TLVT_DB_SCALE`.
+const TLV_DB_SCALE: u32 = 1;
+const TLV_DB_SCALE_MUTE: u32 = 0x10000;
+
+pub(super) struct ControlDevice {
+    card: Arc<Card>,
+}
+
+impl Debug for ControlDevice {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.debug_struct("ControlDevice").field("card", &self.card.index).finish()
+    }
+}
+
+impl ControlDevice {
+    pub(super) fn new(card: Arc<Card>) -> Self {
+        Self { card }
+    }
+}
+
+impl Device for ControlDevice {
+    fn type_(&self) -> DeviceType {
+        DeviceType::Char
+    }
+
+    fn id(&self) -> DeviceId {
+        device_id(self.card.index, 0)
+    }
+
+    fn devtmpfs_meta(&self) -> Option<DevtmpfsNodeMeta> {
+        DevtmpfsNodeMeta::new(format!("snd/controlC{}", self.card.index)).ok()
+    }
+
+    fn open(&self) -> Result<Box<dyn PerOpenFileOps>> {
+        let pollee = Arc::new(Pollee::new());
+        watch(&pollee);
+        Ok(Box::new(ControlHandle {
+            card: self.card.clone(),
+            subscribed: AtomicBool::new(false),
+            seen: AtomicU64::new(self.card.events.load(Ordering::Acquire)),
+            pollee,
+        }))
+    }
+}
+
+/// A control applications made (alsa-lib's softvol makes its volume one):
+/// it lasts as long as the card, as on Linux.
+#[derive(Clone, Debug)]
+struct UserControl {
+    numid: u32,
+    name: String,
+    iface: i32,
+    index: u32,
+    kind: u32,
+    min: i64,
+    max: i64,
+    step: i64,
+    access: u32,
+    values: Vec<i64>,
+    tlv: Vec<u8>,
+    changed: u64,
+}
+
+/// The user's controls of each card, by card.
+static USER_CONTROLS: Mutex<BTreeMap<u32, Vec<UserControl>>> = Mutex::new(BTreeMap::new());
+
+struct ControlHandle {
+    card: Arc<Card>,
+    subscribed: AtomicBool,
+    /// The card's event count this handle has reported up to.
+    seen: AtomicU64,
+    pollee: Arc<Pollee>,
+}
+
+impl Debug for ControlHandle {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.debug_struct("ControlHandle").field("card", &self.card.index).finish()
+    }
+}
+
+/// A control's identifier as ALSA lays it out (`struct snd_ctl_elem_id`).
+fn write_id(buf: &mut [u8], at: usize, card: &Card, index: usize) {
+    let control = &card.controls[index];
+    buf[at..at + ID_SIZE].fill(0);
+    put_u32(buf, at, index as u32 + 1);
+    put_u32(buf, at + 4, control.iface as u32);
+    put_str(buf, at + 16, 44, &control.name);
+}
+
+/// Which control an identifier names: the card's own (by its index) or
+/// one of the user's (by its number).
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Which {
+    Card(usize),
+    User(u32),
+}
+
+fn name_of(id: &[u8]) -> Option<&str> {
+    let end = id[16..60].iter().position(|&b| b == 0).unwrap_or(44);
+    core::str::from_utf8(&id[16..16 + end]).ok()
+}
+
+fn find_any(card: &Card, id: &[u8]) -> Option<Which> {
+    let numid = get_u32(id, 0);
+    let users = USER_CONTROLS.lock();
+    let mine = users.get(&card.index);
+    if numid != 0 {
+        if numid as usize <= card.controls.len() {
+            return Some(Which::Card(numid as usize - 1));
+        }
+        return mine.and_then(|list| list.iter().find(|c| c.numid == numid)).map(|c| Which::User(c.numid));
+    }
+    if let Some(index) = find(card, id) {
+        return Some(Which::Card(index));
+    }
+    let (iface, name, index) = (get_u32(id, 4) as i32, name_of(id)?, get_u32(id, 60));
+    mine.and_then(|list| list.iter().find(|c| c.iface == iface && c.name == name && c.index == index)).map(|c| Which::User(c.numid))
+}
+
+fn write_user_id(buf: &mut [u8], at: usize, control: &UserControl) {
+    buf[at..at + ID_SIZE].fill(0);
+    put_u32(buf, at, control.numid);
+    put_u32(buf, at + 4, control.iface as u32);
+    put_str(buf, at + 16, 44, &control.name);
+    put_u32(buf, at + 60, control.index);
+}
+
+fn with_user<R>(card: &Card, numid: u32, f: impl FnOnce(&mut UserControl) -> R) -> Option<R> {
+    let mut users = USER_CONTROLS.lock();
+    users.get_mut(&card.index)?.iter_mut().find(|c| c.numid == numid).map(f)
+}
+
+/// The control an identifier names: by number, or by interface, name and index.
+fn find(card: &Card, id: &[u8]) -> Option<usize> {
+    let numid = get_u32(id, 0) as usize;
+    if numid != 0 {
+        return (numid <= card.controls.len()).then(|| numid - 1);
+    }
+    let iface = get_u32(id, 4) as i32;
+    let name_end = id[16..60].iter().position(|&b| b == 0).unwrap_or(44);
+    let name = core::str::from_utf8(&id[16..16 + name_end]).ok()?;
+    let index = get_u32(id, 60);
+    if index != 0 {
+        return None;
+    }
+    card.controls.iter().position(|control| control.iface == iface && control.name == name)
+}
+
+impl ControlHandle {
+    /// Controls changed since this handle last looked.
+    fn pending(&self) -> Vec<Which> {
+        let seen = self.seen.load(Ordering::Acquire);
+        let mut pending: Vec<Which> = self
+            .card
+            .controls
+            .iter()
+            .enumerate()
+            .filter(|(_, control)| control.changed.load(Ordering::Acquire) > seen)
+            .map(|(index, _)| Which::Card(index))
+            .collect();
+        if let Some(list) = USER_CONTROLS.lock().get(&self.card.index) {
+            pending.extend(list.iter().filter(|c| c.changed > seen).map(|c| Which::User(c.numid)));
+        }
+        pending
+    }
+
+    fn has_events(&self) -> bool {
+        self.subscribed.load(Ordering::Acquire) && self.card.events.load(Ordering::Acquire) > self.seen.load(Ordering::Acquire)
+    }
+
+    fn pcm_info(&self, buf: &mut [u8]) -> Result<()> {
+        let device = get_u32(buf, 0);
+        let subdevice = get_u32(buf, 4);
+        let stream = get_u32(buf, 8);
+        let pcm = match stream {
+            0 => self.card.playback.as_ref(),
+            1 => self.card.capture.as_ref(),
+            _ => None,
+        };
+        let Some(pcm) = pcm.filter(|_| device == 0 && subdevice == 0) else {
+            return_errno_with_message!(Errno::ENXIO, "no such PCM device");
+        };
+        super::pcm::fill_info(buf, &self.card, pcm);
+        Ok(())
+    }
+}
+
+impl Pollable for ControlHandle {
+    fn poll(&self, mask: IoEvents, poller: Option<&mut PollHandle>) -> IoEvents {
+        self.pollee.poll_with(mask, poller, || if self.has_events() { IoEvents::IN } else { IoEvents::empty() })
+    }
+}
+
+impl FileOps for ControlHandle {
+    fn read_at(&self, _offset: usize, writer: &mut VmWriter, status_flags: StatusFlags) -> Result<usize> {
+        if writer.avail() < EVENT_SIZE {
+            return_errno!(Errno::EINVAL);
+        }
+        if !self.subscribed.load(Ordering::Acquire) {
+            return_errno!(Errno::EBADFD);
+        }
+        if !self.has_events() {
+            if status_flags.contains(StatusFlags::O_NONBLOCK) {
+                return_errno!(Errno::EAGAIN);
+            }
+            self.card.event_wait.pause_until(|| self.has_events().then_some(()))?;
+        }
+        let now = self.card.events.load(Ordering::Acquire);
+        let mut written = 0;
+        for which in self.pending() {
+            if writer.avail() < EVENT_SIZE {
+                break;
+            }
+            let mut event = [0u8; EVENT_SIZE];
+            put_u32(&mut event, 0, EVENT_ELEM);
+            put_u32(&mut event, 4, EVENT_MASK_VALUE);
+            match which {
+                Which::Card(index) => write_id(&mut event, 8, &self.card, index),
+                Which::User(numid) => {
+                    let _ = with_user(&self.card, numid, |c| write_user_id(&mut event, 8, c));
+                }
+            }
+            writer.write_fallible(&mut VmReader::from(&event[..]).to_fallible()).map_err(|(error, _)| error)?;
+            written += EVENT_SIZE;
+        }
+        self.seen.store(now, Ordering::Release);
+        self.pollee.invalidate();
+        Ok(written)
+    }
+
+    fn write_at(&self, _offset: usize, _reader: &mut VmReader, _status_flags: StatusFlags) -> Result<usize> {
+        return_errno!(Errno::EINVAL)
+    }
+}
+
+impl PerOpenFileOps for ControlHandle {
+    fn check_seekable(&self) -> Result<()> {
+        return_errno!(Errno::ESPIPE)
+    }
+
+    fn is_offset_aware(&self) -> bool {
+        false
+    }
+
+    fn ioctl(&self, _path: &Path, raw_ioctl: RawIoctl) -> Result<i32> {
+        let arg = raw_ioctl.arg();
+        let card = &self.card;
+        match raw_ioctl.cmd() {
+            ioctl::PVERSION => current_userspace!().write_val(arg, &VERSION)?,
+            ioctl::CARD_INFO => {
+                let mut info = [0u8; 376];
+                put_u32(&mut info, 0, card.index);
+                put_str(&mut info, 8, 16, &card.id);
+                put_str(&mut info, 24, 16, &card.driver);
+                put_str(&mut info, 40, 32, &card.name);
+                put_str(&mut info, 72, 80, &card.longname);
+                put_str(&mut info, 168, 80, &card.mixer_name);
+                put_str(&mut info, 248, 128, &card.components);
+                current_userspace!().write_bytes(arg, &info)?;
+            }
+            ioctl::ELEM_LIST => {
+                let mut list = [0u8; 80];
+                current_userspace!().read_bytes(arg, &mut list)?;
+                let (offset, space) = (get_u32(&list, 0) as usize, get_u32(&list, 4) as usize);
+                let pointer = super::get_u64(&list, 16) as usize;
+                let users = USER_CONTROLS.lock().get(&card.index).cloned().unwrap_or_default();
+                let count = card.controls.len() + users.len();
+                let used = space.min(count.saturating_sub(offset));
+                for slot in 0..used {
+                    let mut id = [0u8; ID_SIZE];
+                    let at = offset + slot;
+                    if at < card.controls.len() {
+                        write_id(&mut id, 0, card, at);
+                    } else {
+                        write_user_id(&mut id, 0, &users[at - card.controls.len()]);
+                    }
+                    current_userspace!().write_bytes(pointer + slot * ID_SIZE, &id)?;
+                }
+                put_u32(&mut list, 8, used as u32);
+                put_u32(&mut list, 12, count as u32);
+                current_userspace!().write_bytes(arg, &list)?;
+            }
+            ioctl::ELEM_INFO => {
+                let mut info = [0u8; INFO_SIZE];
+                current_userspace!().read_bytes(arg, &mut info)?;
+                let which = find_any(card, &info).ok_or(Error::new(Errno::ENOENT))?;
+                info.fill(0);
+                match which {
+                    Which::Card(index) => {
+                        let control = &card.controls[index];
+                        write_id(&mut info, 0, card, index);
+                        let mut access = ACCESS_READ;
+                        if control.writable {
+                            access |= ACCESS_WRITE;
+                        }
+                        if control.db_scale.is_some() {
+                            access |= ACCESS_TLV_READ;
+                        }
+                        match control.kind {
+                            ControlKind::Boolean => {
+                                put_u32(&mut info, 64, TYPE_BOOLEAN);
+                                put_u64(&mut info, 88, 1);
+                            }
+                            ControlKind::Integer { min, max } => {
+                                put_u32(&mut info, 64, TYPE_INTEGER);
+                                put_u64(&mut info, 80, min as u64);
+                                put_u64(&mut info, 88, max as u64);
+                                put_u64(&mut info, 96, 1);
+                            }
+                        }
+                        put_u32(&mut info, 68, access);
+                        put_u32(&mut info, 72, control.count);
+                    }
+                    Which::User(numid) => {
+                        with_user(card, numid, |control| {
+                            write_user_id(&mut info, 0, control);
+                            put_u32(&mut info, 64, control.kind);
+                            put_u32(&mut info, 68, control.access);
+                            put_u32(&mut info, 72, control.values.len() as u32);
+                            put_u64(&mut info, 80, control.min as u64);
+                            put_u64(&mut info, 88, control.max as u64);
+                            put_u64(&mut info, 96, control.step as u64);
+                        });
+                    }
+                }
+                put_u32(&mut info, 76, u32::MAX);
+                current_userspace!().write_bytes(arg, &info)?;
+            }
+            ioctl::ELEM_READ => {
+                let mut value = [0u8; VALUE_SIZE];
+                current_userspace!().read_bytes(arg, &mut value)?;
+                let which = find_any(card, &value).ok_or(Error::new(Errno::ENOENT))?;
+                value.fill(0);
+                let levels = match which {
+                    Which::Card(index) => {
+                        write_id(&mut value, 0, card, index);
+                        card.controls[index].values()
+                    }
+                    Which::User(numid) => with_user(card, numid, |control| {
+                        write_user_id(&mut value, 0, control);
+                        control.values.clone()
+                    })
+                    .unwrap_or_default(),
+                };
+                for (channel, level) in levels.iter().enumerate() {
+                    put_u64(&mut value, 72 + channel * 8, *level as u64);
+                }
+                current_userspace!().write_bytes(arg, &value)?;
+            }
+            ioctl::ELEM_WRITE => {
+                let mut value = [0u8; VALUE_SIZE];
+                current_userspace!().read_bytes(arg, &mut value)?;
+                let which = find_any(card, &value).ok_or(Error::new(Errno::ENOENT))?;
+                match which {
+                    Which::Card(index) => {
+                        let control = &card.controls[index];
+                        if !control.writable {
+                            return_errno_with_message!(Errno::EPERM, "the control is read-only");
+                        }
+                        let levels: Vec<i64> = (0..control.count as usize).map(|channel| super::get_u64(&value, 72 + channel * 8) as i64).collect();
+                        // Out of range: refused, as Linux's validation does.
+                        if let ControlKind::Integer { min, max } = control.kind {
+                            if levels.iter().any(|level| *level < min || *level > max) {
+                                return_errno_with_message!(Errno::EINVAL, "the value is out of range");
+                            }
+                        }
+                        return Ok(i32::from(card.set_control(index, &levels)));
+                    }
+                    Which::User(numid) => {
+                        let changed = with_user(card, numid, |control| {
+                            let levels: Vec<i64> = (0..control.values.len()).map(|channel| super::get_u64(&value, 72 + channel * 8) as i64).collect();
+                            if control.kind != TYPE_BOOLEAN && levels.iter().any(|level| *level < control.min || *level > control.max) {
+                                return Err(Error::with_message(Errno::EINVAL, "the value is out of range"));
+                            }
+                            let changed = control.values != levels;
+                            control.values = levels;
+                            Ok(changed)
+                        })
+                        .ok_or(Error::new(Errno::ENOENT))??;
+                        if changed {
+                            let event = card.note_user_change();
+                            with_user(card, numid, |control| control.changed = event);
+                        }
+                        return Ok(i32::from(changed));
+                    }
+                }
+            }
+            ioctl::ELEM_ADD | ioctl::ELEM_REPLACE => {
+                let mut info = [0u8; INFO_SIZE];
+                current_userspace!().read_bytes(arg, &mut info)?;
+                let kind = get_u32(&info, 64);
+                let count = get_u32(&info, 72);
+                if !matches!(kind, TYPE_BOOLEAN | TYPE_INTEGER | TYPE_INTEGER64) || count == 0 || count > MAX_VALUES {
+                    return_errno_with_message!(Errno::EINVAL, "this kind of control cannot be made");
+                }
+                let name = name_of(&info).ok_or(Error::new(Errno::EINVAL))?.to_string();
+                let (iface, index) = (get_u32(&info, 4) as i32, get_u32(&info, 60));
+                let (min, max, step) = if kind == TYPE_BOOLEAN {
+                    (0, 1, 1)
+                } else {
+                    (super::get_u64(&info, 80) as i64, super::get_u64(&info, 88) as i64, super::get_u64(&info, 96) as i64)
+                };
+                if min > max {
+                    return_errno!(Errno::EINVAL);
+                }
+                let replace = raw_ioctl.cmd() == ioctl::ELEM_REPLACE;
+                if card.controls.iter().any(|c| c.iface == iface && c.name == name) {
+                    return_errno_with_message!(Errno::EBUSY, "the card has a control of that name");
+                }
+                let access = (get_u32(&info, 68) & (ACCESS_READ | ACCESS_WRITE | ACCESS_TLV_READ | ACCESS_TLV_WRITE)).max(ACCESS_READ | ACCESS_WRITE) | ACCESS_USER;
+                let mut users = USER_CONTROLS.lock();
+                let list = users.entry(card.index).or_default();
+                let existing = list.iter().position(|c| c.iface == iface && c.name == name && c.index == index);
+                let numid = match (existing, replace) {
+                    (Some(_), false) => return_errno_with_message!(Errno::EBUSY, "the control exists"),
+                    (None, true) => return_errno_with_message!(Errno::ENOENT, "no control to replace"),
+                    (Some(at), true) => list.remove(at).numid,
+                    (None, false) => {
+                        let used = list.iter().map(|c| c.numid).max().unwrap_or(0);
+                        used.max(card.controls.len() as u32) + 1
+                    }
+                };
+                let control = UserControl {
+                    numid,
+                    name,
+                    iface,
+                    index,
+                    kind,
+                    min,
+                    max,
+                    step,
+                    access,
+                    values: vec![min.max(0).min(max); count as usize],
+                    tlv: Vec::new(),
+                    changed: 0,
+                };
+                write_user_id(&mut info, 0, &control);
+                list.push(control);
+                drop(users);
+                card.note_user_change();
+                current_userspace!().write_bytes(arg, &info)?;
+            }
+            ioctl::ELEM_REMOVE => {
+                let mut id = [0u8; ID_SIZE];
+                current_userspace!().read_bytes(arg, &mut id)?;
+                match find_any(card, &id) {
+                    Some(Which::User(numid)) => {
+                        if let Some(list) = USER_CONTROLS.lock().get_mut(&card.index) {
+                            list.retain(|c| c.numid != numid);
+                        }
+                        card.note_user_change();
+                    }
+                    Some(Which::Card(_)) => return_errno_with_message!(Errno::EPERM, "the card's own controls stay"),
+                    None => return_errno!(Errno::ENOENT),
+                }
+            }
+            ioctl::ELEM_LOCK | ioctl::ELEM_UNLOCK => {}
+            ioctl::SUBSCRIBE_EVENTS => {
+                let mut wanted: i32 = current_userspace!().read_val(arg)?;
+                match wanted {
+                    0 => self.subscribed.store(false, Ordering::Release),
+                    1 => {
+                        self.seen.store(card.events.load(Ordering::Acquire), Ordering::Release);
+                        self.subscribed.store(true, Ordering::Release);
+                    }
+                    _ => {
+                        wanted = i32::from(self.subscribed.load(Ordering::Acquire));
+                        current_userspace!().write_val(arg, &wanted)?;
+                    }
+                }
+            }
+            ioctl::TLV_READ => {
+                let numid = current_userspace!().read_val::<u32>(arg)?;
+                let length = current_userspace!().read_val::<u32>(arg + 4)? as usize;
+                if numid as usize > card.controls.len() {
+                    let tlv = with_user(card, numid, |control| control.tlv.clone()).ok_or(Error::new(Errno::ENOENT))?;
+                    if tlv.is_empty() {
+                        return_errno!(Errno::ENXIO);
+                    }
+                    if length < tlv.len() {
+                        return_errno!(Errno::ENOMEM);
+                    }
+                    current_userspace!().write_bytes(arg + 8, &tlv)?;
+                    return Ok(0);
+                }
+                let control = (numid as usize).checked_sub(1).and_then(|index| card.controls.get(index)).ok_or(Error::new(Errno::ENOENT))?;
+                let (min, step, mute) = control.db_scale.ok_or(Error::new(Errno::ENXIO))?;
+                if length < 16 {
+                    return_errno!(Errno::ENOMEM);
+                }
+                let mut tlv = [0u8; 16];
+                put_u32(&mut tlv, 0, TLV_DB_SCALE);
+                put_u32(&mut tlv, 4, 8);
+                put_u32(&mut tlv, 8, min as u32);
+                put_u32(&mut tlv, 12, step | if mute { TLV_DB_SCALE_MUTE } else { 0 });
+                current_userspace!().write_bytes(arg + 8, &tlv)?;
+            }
+            ioctl::TLV_WRITE => {
+                let numid = current_userspace!().read_val::<u32>(arg)?;
+                let length = current_userspace!().read_val::<u32>(arg + 4)? as usize;
+                if length > MAX_TLV {
+                    return_errno!(Errno::ENOMEM);
+                }
+                let mut tlv = vec![0u8; length];
+                current_userspace!().read_bytes(arg + 8, &mut tlv)?;
+                if numid as usize <= card.controls.len() {
+                    return_errno_with_message!(Errno::ENXIO, "the card's own controls keep their scales");
+                }
+                let changed = with_user(card, numid, |control| {
+                    let changed = control.tlv != tlv;
+                    control.tlv = tlv;
+                    control.access |= ACCESS_TLV_READ;
+                    changed
+                })
+                .ok_or(Error::new(Errno::ENOENT))?;
+                if changed {
+                    card.note_user_change();
+                }
+                return Ok(i32::from(changed));
+            }
+            ioctl::PCM_NEXT_DEVICE => {
+                let device: i32 = current_userspace!().read_val(arg)?;
+                let next = if device < 0 && (card.playback.is_some() || card.capture.is_some()) { 0 } else { -1 };
+                current_userspace!().write_val(arg, &next)?;
+            }
+            ioctl::PCM_INFO => {
+                let mut info = [0u8; super::pcm::INFO_SIZE];
+                current_userspace!().read_bytes(arg, &mut info)?;
+                self.pcm_info(&mut info)?;
+                current_userspace!().write_bytes(arg, &info)?;
+            }
+            ioctl::PCM_PREFER_SUBDEVICE => {}
+            ioctl::HWDEP_NEXT_DEVICE | ioctl::RAWMIDI_NEXT_DEVICE | ioctl::UMP_NEXT_DEVICE => current_userspace!().write_val(arg, &-1i32)?,
+            ioctl::POWER => {}
+            ioctl::POWER_STATE => current_userspace!().write_val(arg, &0u32)?,
+            other => {
+                warn!("sound: unknown control ioctl {:#x}", other);
+                return_errno_with_message!(Errno::ENOTTY, "unknown sound control ioctl")
+            }
+        }
+        Ok(0)
+    }
+}
diff --git a/kernel/core/src/device/snd/mod.rs b/kernel/core/src/device/snd/mod.rs
new file mode 100755
index 0000000..dcc0e92
--- /dev/null
+++ b/kernel/core/src/device/snd/mod.rs
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! ALSA's device files, `/dev/snd`: each sound card's control device
+//! (`controlC<card>`: its identity, its mixer controls and their events) and
+//! its PCM devices (`pcmC<card>D0p` to play, `pcmC<card>D0c` to record), with
+//! the ioctls, reads, writes and mappings alsa-lib uses, and Linux's device
+//! numbers (major 116). The cards are `aster-sound`'s.
+//!
+//! Reference: Linux's `include/uapi/sound/asound.h`, `sound/core/control.c`,
+//! `pcm_native.c`.
+
+mod control;
+mod pcm;
+mod timer;
+
+use aster_sound::Card;
+use device_id::{DeviceId, MajorId, MinorId};
+
+use super::registry::char;
+use crate::{
+    events::IoEvents,
+    prelude::*,
+    process::signal::Pollee,
+    thread::kernel_thread::ThreadOptions,
+};
+
+/// ALSA's major number.
+const MAJOR: u16 = 116;
+
+fn device_id(card: u32, minor: u32) -> DeviceId {
+    DeviceId::new(MajorId::new(MAJOR), MinorId::new(card * 32 + minor))
+}
+
+/// Open device files waiting on the cards: told when something moved.
+static POLLEES: SpinLock<Vec<Weak<Pollee>>> = SpinLock::new(Vec::new());
+
+pub(super) fn watch(pollee: &Arc<Pollee>) {
+    POLLEES.lock().push(Arc::downgrade(pollee));
+}
+
+/// A card's device files (and, with the first card, the timer device).
+fn card_ready(card: &Arc<Card>) {
+    static TIMER: spin::Once<()> = spin::Once::new();
+    TIMER.call_once(|| {
+        if let Err(error) = char::register(Arc::new(timer::TimerDevice)) {
+            warn!("sound: timer: {:?}", error);
+        }
+    });
+    let index = card.index;
+    if let Err(error) = char::register(Arc::new(control::ControlDevice::new(card.clone()))) {
+        warn!("sound: controlC{}: {:?}", index, error);
+    }
+    for pcm in card.pcms() {
+        if let Err(error) = char::register(Arc::new(pcm::PcmDevice::new(card.clone(), pcm.clone()))) {
+            warn!("sound: card {} PCM: {:?}", index, error);
+        }
+    }
+}
+
+pub(super) fn init_in_first_kthread() {
+    aster_sound::set_card_hook(card_ready);
+    for card in aster_sound::cards() {
+        card_ready(&card);
+    }
+    // The controllers are set up apart (that takes a while); the jacks
+    // are then followed there.
+    ThreadOptions::new(aster_sound::run).spawn();
+    // Pollers of the device files hear of what the cards' timer and jack
+    // task see (they run where pollers cannot be told directly).
+    ThreadOptions::new(|| {
+        let mut seen = aster_sound::activity_seq();
+        loop {
+            aster_sound::ACTIVITY.wait_until(|| {
+                let now = aster_sound::activity_seq();
+                (now != seen).then_some(now)
+            });
+            seen = aster_sound::activity_seq();
+            let pollees: Vec<Arc<Pollee>> = {
+                let mut list = POLLEES.lock();
+                list.retain(|pollee| pollee.strong_count() > 0);
+                list.iter().filter_map(Weak::upgrade).collect()
+            };
+            for pollee in pollees {
+                pollee.notify(IoEvents::IN | IoEvents::OUT | IoEvents::ERR);
+            }
+        }
+    })
+    .spawn();
+}
+
+/// Copies a NUL-padded name into a fixed field.
+fn put_str(buf: &mut [u8], at: usize, length: usize, value: &str) {
+    let bytes = value.as_bytes();
+    let count = bytes.len().min(length - 1);
+    buf[at..at + length].fill(0);
+    buf[at..at + count].copy_from_slice(&bytes[..count]);
+}
+
+fn get_u32(buf: &[u8], at: usize) -> u32 {
+    u32::from_le_bytes(buf[at..at + 4].try_into().unwrap())
+}
+
+fn get_u64(buf: &[u8], at: usize) -> u64 {
+    u64::from_le_bytes(buf[at..at + 8].try_into().unwrap())
+}
+
+fn put_u32(buf: &mut [u8], at: usize, value: u32) {
+    buf[at..at + 4].copy_from_slice(&value.to_le_bytes());
+}
+
+fn put_u64(buf: &mut [u8], at: usize, value: u64) {
+    buf[at..at + 8].copy_from_slice(&value.to_le_bytes());
+}
diff --git a/kernel/core/src/device/snd/pcm.rs b/kernel/core/src/device/snd/pcm.rs
new file mode 100755
index 0000000..f7d14c9
--- /dev/null
+++ b/kernel/core/src/device/snd/pcm.rs
@@ -0,0 +1,601 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! A PCM device file: the parameters' negotiation, the stream's control
+//! (prepare, start, drop, drain, pause), transfers through ioctls, reads
+//! and writes, and the mappings of the buffer and of the status and control
+//! pages alsa-lib reads and writes directly.
+
+use aster_sound::{
+    Card, Direction, Pcm,
+    params::{HwParams, Interval, Mask},
+    pcm::{PcmError, State, SwParams},
+};
+use device_id::DeviceId;
+use alloc::format;
+use ostd::mm::VmIo;
+
+use super::{device_id, get_u32, get_u64, put_str, put_u32, put_u64, watch};
+use crate::{
+    context::current_userspace,
+    device::{Device, DeviceType},
+    events::IoEvents,
+    fs::{
+        devtmpfs::DevtmpfsNodeMeta,
+        file::{Mappable, MappableObject, MappedObject, PerOpenFileOps, StatusFlags},
+        vfs::{inode::FileOps, path::Path},
+    },
+    prelude::*,
+    process::signal::{PollHandle, Pollable, Pollee},
+    util::ioctl::RawIoctl,
+    vm::vmar::{FileMmapRequest, MapHandle},
+};
+
+/// `SNDRV_PCM_VERSION`: 2.0.14.
+const VERSION: u32 = 0x0002_000e;
+
+mod ioctl {
+    pub(super) const PVERSION: u32 = 0x8004_4100;
+    pub(super) const INFO: u32 = 0x8120_4101;
+    pub(super) const TSTAMP: u32 = 0x4004_4102;
+    pub(super) const TTSTAMP: u32 = 0x4004_4103;
+    pub(super) const USER_PVERSION: u32 = 0x4004_4104;
+    pub(super) const HW_REFINE: u32 = 0xc260_4110;
+    pub(super) const HW_PARAMS: u32 = 0xc260_4111;
+    pub(super) const HW_FREE: u32 = 0x0000_4112;
+    pub(super) const SW_PARAMS: u32 = 0xc088_4113;
+    pub(super) const STATUS: u32 = 0x8098_4120;
+    pub(super) const DELAY: u32 = 0x8008_4121;
+    pub(super) const HWSYNC: u32 = 0x0000_4122;
+    pub(super) const SYNC_PTR: u32 = 0xc088_4123;
+    pub(super) const STATUS_EXT: u32 = 0xc098_4124;
+    pub(super) const CHANNEL_INFO: u32 = 0x8018_4132;
+    pub(super) const PREPARE: u32 = 0x0000_4140;
+    pub(super) const RESET: u32 = 0x0000_4141;
+    pub(super) const START: u32 = 0x0000_4142;
+    pub(super) const DROP: u32 = 0x0000_4143;
+    pub(super) const DRAIN: u32 = 0x0000_4144;
+    pub(super) const PAUSE: u32 = 0x4004_4145;
+    pub(super) const REWIND: u32 = 0x4008_4146;
+    pub(super) const RESUME: u32 = 0x0000_4147;
+    pub(super) const XRUN: u32 = 0x0000_4148;
+    pub(super) const FORWARD: u32 = 0x4008_4149;
+    pub(super) const WRITEI_FRAMES: u32 = 0x4018_4150;
+    pub(super) const READI_FRAMES: u32 = 0x8018_4151;
+    pub(super) const LINK: u32 = 0x4004_4160;
+    pub(super) const UNLINK: u32 = 0x0000_4161;
+}
+
+pub(super) const INFO_SIZE: usize = 288;
+const HW_PARAMS_SIZE: usize = 608;
+const SW_PARAMS_SIZE: usize = 136;
+const STATUS_SIZE: usize = 152;
+const SYNC_PTR_SIZE: usize = 136;
+/// Where the status and control pages are mapped (and their 64-bit-time
+/// variants of 32-bit programs).
+const MMAP_STATUS: usize = 0x8000_0000;
+const MMAP_CONTROL: usize = 0x8100_0000;
+const MMAP_STATUS_NEW: usize = 0x8200_0000;
+const MMAP_CONTROL_NEW: usize = 0x8300_0000;
+const SYNC_PTR_HWSYNC: u32 = 1 << 0;
+const SYNC_PTR_APPL: u32 = 1 << 1;
+const SYNC_PTR_AVAIL_MIN: u32 = 1 << 2;
+/// How long a transfer or a drain waits for the hardware before giving up
+/// (Linux's "DMA or IRQ trouble?").
+const STALL_TIMEOUT: core::time::Duration = core::time::Duration::from_secs(10);
+
+/// Waits for `cond` on the stream; a stream that does not move for
+/// [`STALL_TIMEOUT`] is an I/O error.
+fn wait_for(pcm: &Pcm, mut cond: impl FnMut() -> bool) -> Result<()> {
+    match pcm.wait.pause_until_or_timeout(|| cond().then_some(()), &STALL_TIMEOUT) {
+        Err(error) if error.error() == Errno::ETIME => {
+            warn!("sound: {} stalled: the hardware did not move for {:?} ({})", pcm.name, STALL_TIMEOUT, pcm.describe());
+            Err(Error::with_message(Errno::EIO, "the sound hardware stalled"))
+        }
+        other => other,
+    }
+}
+
+fn errno(error: PcmError) -> Error {
+    match error {
+        PcmError::BadState => Error::with_message(Errno::EBADFD, "the PCM stream is not in a state for that"),
+        PcmError::Xrun => Error::with_message(Errno::EPIPE, "the PCM stream underran or overran"),
+        PcmError::WouldBlock => Error::new(Errno::EAGAIN),
+        PcmError::Invalid => Error::with_message(Errno::EINVAL, "the PCM parameters are not supported"),
+        PcmError::NoMemory => Error::new(Errno::ENOMEM),
+        PcmError::Busy => Error::with_message(Errno::EBUSY, "the PCM device is open already"),
+        PcmError::Io => Error::new(Errno::EIO),
+    }
+}
+
+/// `struct snd_pcm_info`.
+pub(super) fn fill_info(buf: &mut [u8], card: &Card, pcm: &Pcm) {
+    buf.fill(0);
+    put_u32(buf, 8, if pcm.direction == Direction::Playback { 0 } else { 1 });
+    put_u32(buf, 12, card.index);
+    put_str(buf, 16, 64, &pcm.id);
+    put_str(buf, 80, 80, &pcm.name);
+    put_str(buf, 160, 32, "subdevice #0");
+    put_u32(buf, 200, 1);
+    put_u32(buf, 204, 1);
+}
+
+fn read_mask(buf: &[u8], at: usize) -> Mask {
+    let mut mask = Mask([0; 8]);
+    for (word, value) in mask.0.iter_mut().enumerate() {
+        *value = get_u32(buf, at + word * 4);
+    }
+    mask
+}
+
+fn write_mask(buf: &mut [u8], at: usize, mask: &Mask) {
+    for (word, value) in mask.0.iter().enumerate() {
+        put_u32(buf, at + word * 4, *value);
+    }
+}
+
+fn read_interval(buf: &[u8], at: usize) -> Interval {
+    let flags = get_u32(buf, at + 8);
+    Interval {
+        min: get_u32(buf, at),
+        max: get_u32(buf, at + 4),
+        openmin: flags & 1 != 0,
+        openmax: flags & 2 != 0,
+        integer: flags & 4 != 0,
+        empty: flags & 8 != 0,
+    }
+}
+
+fn write_interval(buf: &mut [u8], at: usize, interval: &Interval) {
+    put_u32(buf, at, interval.min);
+    put_u32(buf, at + 4, interval.max);
+    let flags = u32::from(interval.openmin) | u32::from(interval.openmax) << 1 | u32::from(interval.integer) << 2 | u32::from(interval.empty) << 3;
+    put_u32(buf, at + 8, flags);
+}
+
+/// `struct snd_pcm_hw_params`: flags, 3 masks (and 5 reserved), 12
+/// intervals (and 9 reserved), then the results.
+fn read_hw_params(buf: &[u8]) -> HwParams {
+    let mut params = HwParams::any();
+    params.flags = get_u32(buf, 0);
+    for (index, mask) in params.masks.iter_mut().enumerate() {
+        *mask = read_mask(buf, 4 + index * 32);
+    }
+    for (index, interval) in params.intervals.iter_mut().enumerate() {
+        *interval = read_interval(buf, 260 + index * 12);
+    }
+    params.rmask = get_u32(buf, 512);
+    params.cmask = get_u32(buf, 516);
+    params.info = get_u32(buf, 520);
+    params.msbits = get_u32(buf, 524);
+    params.rate_num = get_u32(buf, 528);
+    params.rate_den = get_u32(buf, 532);
+    params.fifo_size = get_u64(buf, 536);
+    params
+}
+
+fn write_hw_params(buf: &mut [u8], params: &HwParams) {
+    put_u32(buf, 0, params.flags);
+    for (index, mask) in params.masks.iter().enumerate() {
+        write_mask(buf, 4 + index * 32, mask);
+    }
+    for (index, interval) in params.intervals.iter().enumerate() {
+        write_interval(buf, 260 + index * 12, interval);
+    }
+    put_u32(buf, 512, params.rmask);
+    put_u32(buf, 516, params.cmask);
+    put_u32(buf, 520, params.info);
+    put_u32(buf, 524, params.msbits);
+    put_u32(buf, 528, params.rate_num);
+    put_u32(buf, 532, params.rate_den);
+    put_u64(buf, 536, params.fifo_size);
+}
+
+fn read_sw_params(buf: &[u8]) -> SwParams {
+    SwParams {
+        tstamp_mode: get_u32(buf, 0) as i32,
+        period_step: get_u32(buf, 4),
+        sleep_min: get_u32(buf, 8),
+        avail_min: get_u64(buf, 16),
+        xfer_align: get_u64(buf, 24),
+        start_threshold: get_u64(buf, 32),
+        stop_threshold: get_u64(buf, 40),
+        silence_threshold: get_u64(buf, 48),
+        silence_size: get_u64(buf, 56),
+        boundary: get_u64(buf, 64),
+        proto: get_u32(buf, 72),
+        tstamp_type: get_u32(buf, 76),
+    }
+}
+
+fn write_sw_params(buf: &mut [u8], sw: &SwParams) {
+    put_u32(buf, 0, sw.tstamp_mode as u32);
+    put_u32(buf, 4, sw.period_step);
+    put_u32(buf, 8, sw.sleep_min);
+    put_u64(buf, 16, sw.avail_min);
+    put_u64(buf, 24, sw.xfer_align);
+    put_u64(buf, 32, sw.start_threshold);
+    put_u64(buf, 40, sw.stop_threshold);
+    put_u64(buf, 48, sw.silence_threshold);
+    put_u64(buf, 56, sw.silence_size);
+    put_u64(buf, 64, sw.boundary);
+    put_u32(buf, 72, sw.proto);
+    put_u32(buf, 76, sw.tstamp_type);
+}
+
+pub(super) struct PcmDevice {
+    card: Arc<Card>,
+    pcm: Arc<Pcm>,
+}
+
+impl Debug for PcmDevice {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.debug_struct("PcmDevice").field("card", &self.card.index).field("direction", &self.pcm.direction).finish()
+    }
+}
+
+impl PcmDevice {
+    pub(super) fn new(card: Arc<Card>, pcm: Arc<Pcm>) -> Self {
+        Self { card, pcm }
+    }
+
+    fn suffix(&self) -> char {
+        if self.pcm.direction == Direction::Playback { 'p' } else { 'c' }
+    }
+}
+
+impl Device for PcmDevice {
+    fn type_(&self) -> DeviceType {
+        DeviceType::Char
+    }
+
+    fn id(&self) -> DeviceId {
+        device_id(self.card.index, if self.pcm.direction == Direction::Playback { 16 } else { 24 })
+    }
+
+    fn devtmpfs_meta(&self) -> Option<DevtmpfsNodeMeta> {
+        DevtmpfsNodeMeta::new(format!("snd/pcmC{}D0{}", self.card.index, self.suffix())).ok()
+    }
+
+    fn open(&self) -> Result<Box<dyn PerOpenFileOps>> {
+        self.pcm.open().map_err(errno)?;
+        let pollee = Arc::new(Pollee::new());
+        watch(&pollee);
+        Ok(Box::new(PcmHandle { card: self.card.clone(), pcm: self.pcm.clone(), pollee }))
+    }
+}
+
+struct PcmHandle {
+    card: Arc<Card>,
+    pcm: Arc<Pcm>,
+    pollee: Arc<Pollee>,
+}
+
+impl Debug for PcmHandle {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.debug_struct("PcmHandle").field("card", &self.card.index).field("direction", &self.pcm.direction).finish()
+    }
+}
+
+impl Drop for PcmHandle {
+    fn drop(&mut self) {
+        self.pcm.close();
+    }
+}
+
+impl PcmHandle {
+    fn events(&self) -> IoEvents {
+        let ready = match self.pcm.state() {
+            State::Xrun | State::Disconnected => return IoEvents::OUT | IoEvents::IN | IoEvents::ERR,
+            State::Running | State::Prepared | State::Draining | State::Paused => self.pcm.avail() >= self.pcm.avail_min(),
+            _ => false,
+        };
+        match (ready, self.pcm.direction) {
+            (false, _) => IoEvents::empty(),
+            (true, Direction::Playback) => IoEvents::OUT,
+            (true, Direction::Capture) => IoEvents::IN,
+        }
+    }
+
+    /// Moves `frames` between the application's memory at `addr` and the
+    /// buffer, waiting for room or data unless asked not to.
+    fn transfer(&self, addr: usize, frames: u64, nonblocking: bool) -> Result<u64> {
+        let setup = self.pcm.setup().ok_or(Error::new(Errno::EBADFD))?;
+        let buffer = self.pcm.buffer().ok_or(Error::new(Errno::EBADFD))?;
+        let playback = self.pcm.direction == Direction::Playback;
+        if !playback {
+            self.pcm.start_capture_for(frames).map_err(errno)?;
+        }
+        let mut done = 0u64;
+        while done < frames {
+            let (offset, count) = match self.pcm.transfer_window(frames - done) {
+                Ok(window) => window,
+                Err(error) if done > 0 => {
+                    let _ = error;
+                    break;
+                }
+                Err(error) => return Err(errno(error)),
+            };
+            if count == 0 {
+                if nonblocking {
+                    if done == 0 {
+                        return_errno!(Errno::EAGAIN);
+                    }
+                    break;
+                }
+                let wanted = frames - done;
+                let waited = wait_for(&self.pcm, || self.pcm.ready(wanted));
+                if let Err(error) = waited {
+                    if done > 0 {
+                        break;
+                    }
+                    return Err(error);
+                }
+                continue;
+            }
+            let bytes = count as usize * setup.frame_bytes;
+            let at = addr + done as usize * setup.frame_bytes;
+            // Through a bounce buffer: sound moves a few hundred KiB a
+            // second at most.
+            let mut bounce = vec![0u8; bytes];
+            if playback {
+                current_userspace!().read_bytes(at, &mut bounce)?;
+                buffer.frames.write_bytes(offset, &bounce)?;
+            } else {
+                buffer.frames.read_bytes(offset, &mut bounce)?;
+                current_userspace!().write_bytes(at, &bounce)?;
+            }
+            self.pcm.commit(count).map_err(errno)?;
+            done += count;
+        }
+        self.pollee.invalidate();
+        Ok(done)
+    }
+
+    fn status(&self, buf: &mut [u8]) {
+        let status = self.pcm.status();
+        buf.fill(0);
+        put_u32(buf, 0, status.state as u32);
+        put_u64(buf, 8, status.trigger.as_secs());
+        put_u64(buf, 16, u64::from(status.trigger.subsec_nanos()));
+        put_u64(buf, 24, status.now.as_secs());
+        put_u64(buf, 32, u64::from(status.now.subsec_nanos()));
+        put_u64(buf, 40, status.appl_ptr);
+        put_u64(buf, 48, status.hw_ptr);
+        put_u64(buf, 56, status.delay as u64);
+        put_u64(buf, 64, status.avail);
+        put_u64(buf, 72, status.avail_max);
+        put_u64(buf, 96, status.now.as_secs());
+        put_u64(buf, 104, u64::from(status.now.subsec_nanos()));
+        put_u64(buf, 112, status.now.as_secs());
+        put_u64(buf, 120, u64::from(status.now.subsec_nanos()));
+    }
+}
+
+impl Pollable for PcmHandle {
+    fn poll(&self, mask: IoEvents, poller: Option<&mut PollHandle>) -> IoEvents {
+        // What is ready changes as the stream plays (and as alsa-lib
+        // moves its pointer in the mapped control page): looked at anew.
+        self.pollee.invalidate();
+        self.pollee.poll_with(mask, poller, || self.events())
+    }
+}
+
+impl FileOps for PcmHandle {
+    fn read_at(&self, _offset: usize, _writer: &mut VmWriter, _status_flags: StatusFlags) -> Result<usize> {
+        return_errno_with_message!(Errno::EINVAL, "read from the PCM device through its ioctls")
+    }
+
+    fn write_at(&self, _offset: usize, _reader: &mut VmReader, _status_flags: StatusFlags) -> Result<usize> {
+        return_errno_with_message!(Errno::EINVAL, "write to the PCM device through its ioctls")
+    }
+}
+
+impl PerOpenFileOps for PcmHandle {
+    fn check_seekable(&self) -> Result<()> {
+        return_errno!(Errno::ESPIPE)
+    }
+
+    fn is_offset_aware(&self) -> bool {
+        false
+    }
+
+    fn mappable(&self, _request: FileMmapRequest) -> Result<MappableObject<'_>> {
+        Ok(MappableObject::Device(self as &dyn Mappable))
+    }
+
+    fn ioctl(&self, _path: &Path, raw_ioctl: RawIoctl) -> Result<i32> {
+        let arg = raw_ioctl.arg();
+        let pcm = &self.pcm;
+        let result = match raw_ioctl.cmd() {
+            ioctl::PVERSION => current_userspace!().write_val(arg, &VERSION).map(|_| 0)?,
+            ioctl::INFO => {
+                let mut info = [0u8; INFO_SIZE];
+                fill_info(&mut info, &self.card, pcm);
+                current_userspace!().write_bytes(arg, &info)?;
+                0
+            }
+            ioctl::TSTAMP | ioctl::TTSTAMP | ioctl::USER_PVERSION => 0,
+            ioctl::HW_REFINE | ioctl::HW_PARAMS => {
+                let mut buf = [0u8; HW_PARAMS_SIZE];
+                current_userspace!().read_bytes(arg, &mut buf)?;
+                let mut params = read_hw_params(&buf);
+                if raw_ioctl.cmd() == ioctl::HW_REFINE {
+                    pcm.hw_refine(&mut params).map_err(errno)?;
+                } else {
+                    pcm.hw_params(&mut params).map_err(errno)?;
+                }
+                write_hw_params(&mut buf, &params);
+                current_userspace!().write_bytes(arg, &buf)?;
+                0
+            }
+            ioctl::HW_FREE => pcm.hw_free().map(|()| 0).map_err(errno)?,
+            ioctl::SW_PARAMS => {
+                let mut buf = [0u8; SW_PARAMS_SIZE];
+                current_userspace!().read_bytes(arg, &mut buf)?;
+                let mut sw = read_sw_params(&buf);
+                pcm.sw_params(&mut sw).map_err(errno)?;
+                write_sw_params(&mut buf, &sw);
+                current_userspace!().write_bytes(arg, &buf)?;
+                0
+            }
+            ioctl::STATUS | ioctl::STATUS_EXT => {
+                let mut buf = [0u8; STATUS_SIZE];
+                self.status(&mut buf);
+                current_userspace!().write_bytes(arg, &buf)?;
+                0
+            }
+            ioctl::DELAY => {
+                let status = pcm.status();
+                if status.state == State::Xrun as i32 {
+                    return_errno!(Errno::EPIPE);
+                }
+                current_userspace!().write_val(arg, &status.delay)?;
+                0
+            }
+            ioctl::HWSYNC => {
+                pcm.update();
+                if pcm.state() == State::Xrun {
+                    return_errno!(Errno::EPIPE);
+                }
+                0
+            }
+            ioctl::SYNC_PTR => {
+                let mut buf = [0u8; SYNC_PTR_SIZE];
+                current_userspace!().read_bytes(arg, &mut buf)?;
+                let flags = get_u32(&buf, 0);
+                let appl_ptr = (flags & SYNC_PTR_APPL == 0).then(|| get_u64(&buf, 72));
+                let avail_min = (flags & SYNC_PTR_AVAIL_MIN == 0).then(|| get_u64(&buf, 80));
+                let (state, hw_ptr, appl, avail_min) = pcm.sync_ptr(flags & SYNC_PTR_HWSYNC != 0, appl_ptr, avail_min);
+                let now = ostd::timer::Jiffies::elapsed().as_duration();
+                put_u32(&mut buf, 8, state as u32);
+                put_u64(&mut buf, 16, hw_ptr);
+                put_u64(&mut buf, 24, now.as_secs());
+                put_u64(&mut buf, 32, u64::from(now.subsec_nanos()));
+                put_u64(&mut buf, 72, appl);
+                put_u64(&mut buf, 80, avail_min);
+                current_userspace!().write_bytes(arg, &buf)?;
+                self.pollee.invalidate();
+                0
+            }
+            ioctl::CHANNEL_INFO => {
+                let setup = pcm.setup().ok_or(Error::new(Errno::EBADFD))?;
+                let mut buf = [0u8; 24];
+                current_userspace!().read_bytes(arg, &mut buf)?;
+                let channel = get_u32(&buf, 0);
+                if channel >= setup.channels {
+                    return_errno!(Errno::EINVAL);
+                }
+                put_u64(&mut buf, 8, 0);
+                put_u32(&mut buf, 16, channel * setup.sample_bits);
+                put_u32(&mut buf, 20, setup.frame_bytes as u32 * 8);
+                current_userspace!().write_bytes(arg, &buf)?;
+                0
+            }
+            ioctl::PREPARE => pcm.prepare().map(|()| 0).map_err(errno)?,
+            ioctl::RESET => pcm.reset().map(|()| 0).map_err(errno)?,
+            ioctl::START => pcm.start().map(|()| 0).map_err(errno)?,
+            ioctl::DROP => pcm.drop_().map(|()| 0).map_err(errno)?,
+            ioctl::DRAIN => {
+                if !pcm.drain_begin().map_err(errno)? {
+                    if let Err(error) = wait_for(pcm, || pcm.drained()) {
+                        let _ = pcm.drop_();
+                        return Err(error);
+                    }
+                }
+                0
+            }
+            ioctl::PAUSE => {
+                let on: i32 = current_userspace!().read_val(arg)?;
+                pcm.pause(on != 0).map(|()| 0).map_err(errno)?
+            }
+            ioctl::RESUME => return_errno!(Errno::ENOSYS),
+            ioctl::XRUN => {
+                pcm.drop_().map_err(errno)?;
+                0
+            }
+            ioctl::REWIND | ioctl::FORWARD => {
+                // The frames asked for in, the frames moved back out.
+                let frames: u64 = current_userspace!().read_val(arg)?;
+                let moved = if raw_ioctl.cmd() == ioctl::REWIND { pcm.rewind(frames) } else { pcm.forward(frames) }.map_err(errno)?;
+                current_userspace!().write_val(arg, &moved)?;
+                0
+            }
+            ioctl::WRITEI_FRAMES | ioctl::READI_FRAMES => {
+                let mut buf = [0u8; 24];
+                current_userspace!().read_bytes(arg, &mut buf)?;
+                let (address, frames) = (get_u64(&buf, 8) as usize, get_u64(&buf, 16));
+                let wanted = if raw_ioctl.cmd() == ioctl::WRITEI_FRAMES { Direction::Playback } else { Direction::Capture };
+                if pcm.direction != wanted {
+                    return_errno!(Errno::EINVAL);
+                }
+                let nonblocking = false;
+                let moved = self.transfer(address, frames, nonblocking)?;
+                put_u64(&mut buf, 0, moved);
+                current_userspace!().write_bytes(arg, &buf)?;
+                0
+            }
+            ioctl::LINK | ioctl::UNLINK => return_errno!(Errno::EOPNOTSUPP),
+            other => {
+                warn!("sound: unknown PCM ioctl {:#x}", other);
+                return_errno_with_message!(Errno::ENOTTY, "unknown PCM ioctl")
+            }
+        };
+        self.pollee.invalidate();
+        Ok(result)
+    }
+}
+
+impl Mappable for PcmHandle {
+    fn map(&self, offset: usize, mut handle: MapHandle) -> Result<Box<dyn MappedObject>> {
+        match offset {
+            MMAP_STATUS | MMAP_STATUS_NEW => handle.map_frame(0, self.pcm.status_page().clone()),
+            MMAP_CONTROL | MMAP_CONTROL_NEW => handle.map_frame(0, self.pcm.control_page().clone()),
+            _ => {
+                let buffer = self.pcm.buffer().ok_or(Error::new(Errno::EBADFD))?;
+                let first = offset / PAGE_SIZE;
+                for (index, frame) in buffer.frames.clone().into_iter().enumerate().skip(first) {
+                    let at = (index - first) * PAGE_SIZE;
+                    if at >= handle.size() {
+                        break;
+                    }
+                    handle.map_frame(at, frame);
+                }
+                self.pcm.note_mapped(true);
+                return Ok(Box::new(BufferMapping(self.pcm.clone())));
+            }
+        }
+        Ok(Box::new(PageMapping))
+    }
+}
+
+/// A mapping of the status or control page.
+#[derive(Debug)]
+struct PageMapping;
+
+impl MappedObject for PageMapping {
+    fn dup_at_offset(&self, _offset: usize) -> Box<dyn MappedObject> {
+        Box::new(Self)
+    }
+}
+
+/// A mapping of the buffer: while one lasts, the buffer stays.
+struct BufferMapping(Arc<Pcm>);
+
+impl Debug for BufferMapping {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.debug_struct("BufferMapping").finish()
+    }
+}
+
+impl MappedObject for BufferMapping {
+    fn dup_at_offset(&self, _offset: usize) -> Box<dyn MappedObject> {
+        self.0.note_mapped(true);
+        Box::new(Self(self.0.clone()))
+    }
+}
+
+impl Drop for BufferMapping {
+    fn drop(&mut self) {
+        self.0.note_mapped(false);
+    }
+}
