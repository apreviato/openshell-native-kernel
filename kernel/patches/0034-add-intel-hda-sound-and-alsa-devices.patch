+// SPDX-License-Identifier: MPL-2.0
+
+//! ALSA's timer device, `/dev/snd/timer`, with the timers of the PCM
+//! streams (class PCM): each ticks when its stream completes a period.
+//! alsa-lib's hw plugin waits on one for period events, and its dmix plugin
+//! for its clients.
+//!
+//! Reference: Linux's `sound/core/timer.c`, `include/uapi/sound/asound.h`.
+
+use alloc::format;
+
+use aster_sound::{Card, Direction, Pcm};
+use device_id::{DeviceId, MajorId, MinorId};
+use ostd::mm::VmIo;
+
+use super::{MAJOR, get_u32, put_str, put_u32, put_u64, watch};
+use crate::{
+    context::current_userspace,
+    device::{Device, DeviceType},
+    events::IoEvents,
+    fs::{
+        devtmpfs::DevtmpfsNodeMeta,
+        file::{PerOpenFileOps, StatusFlags},
+        vfs::{inode::FileOps, path::Path},
+    },
+    prelude::*,
+    process::signal::{PollHandle, Pollable, Pollee},
+    util::ioctl::RawIoctl,
+};
+
+/// `SNDRV_TIMER_VERSION`: 2.0.8.
+const VERSION: u32 = 0x0002_0008;
+/// The timer device's minor number.
+const MINOR: u32 = 33;
+/// `SNDRV_TIMER_CLASS_*`, `SNDRV_TIMER_EVENT_TICK`.
+const CLASS_NONE: i32 = -1;
+const CLASS_PCM: i32 = 3;
+const EVENT_TICK: u32 = 1;
+const TREAD_SIZE: usize = 32;
+const READ_SIZE: usize = 8;
+
+mod ioctl {
+    pub(super) const PVERSION: u32 = 0x8004_5400;
+    pub(super) const NEXT_DEVICE: u32 = 0xc014_5401;
+    pub(super) const TREAD_OLD: u32 = 0x4004_5402;
+    pub(super) const TREAD64: u32 = 0x4004_54a4;
+    pub(super) const SELECT: u32 = 0x4034_5410;
+    pub(super) const INFO: u32 = 0x80e8_5411;
+    pub(super) const PARAMS: u32 = 0x4050_5412;
+    pub(super) const STATUS: u32 = 0x8060_5414;
+    pub(super) const START: u32 = 0x0000_54a0;
+    pub(super) const STOP: u32 = 0x0000_54a1;
+    pub(super) const CONTINUE: u32 = 0x0000_54a2;
+    pub(super) const PAUSE: u32 = 0x0000_54a3;
+}
+
+#[derive(Debug)]
+pub(super) struct TimerDevice;
+
+impl Device for TimerDevice {
+    fn type_(&self) -> DeviceType {
+        DeviceType::Char
+    }
+
+    fn id(&self) -> DeviceId {
+        DeviceId::new(MajorId::new(MAJOR), MinorId::new(MINOR))
+    }
+
+    fn devtmpfs_meta(&self) -> Option<DevtmpfsNodeMeta> {
+        DevtmpfsNodeMeta::new("snd/timer").ok()
+    }
+
+    fn open(&self) -> Result<Box<dyn PerOpenFileOps>> {
+        let pollee = Arc::new(Pollee::new());
+        watch(&pollee);
+        Ok(Box::new(TimerHandle { state: Mutex::new(TimerState::default()), pollee }))
+    }
+}
+
+/// The PCM timers there are: (card, device: the PCM device and its
+/// direction, as Linux numbers them).
+fn timers() -> Vec<(Arc<Card>, i32, Arc<Pcm>)> {
+    let mut list = Vec::new();
+    for card in aster_sound::cards() {
+        for pcm in card.pcms() {
+            let device = if pcm.direction == Direction::Playback { 0 } else { 1 };
+            list.push((card.clone(), device, pcm.clone()));
+        }
+    }
+    list
+}
+
+#[derive(Default)]
+struct TimerState {
+    tread: bool,
+    selected: Option<(Arc<Card>, i32, Arc<Pcm>)>,
+    /// Periods per tick.
+    ticks: u32,
+    running: bool,
+    /// The stream's period count the last event reported up to.
+    seen: u64,
+}
+
+struct TimerHandle {
+    state: Mutex<TimerState>,
+    pollee: Arc<Pollee>,
+}
+
+impl Debug for TimerHandle {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.debug_struct("TimerHandle").finish_non_exhaustive()
+    }
+}
+
+impl TimerHandle {
+    /// Ticks to report.
+    fn pending(state: &TimerState) -> u64 {
+        match &state.selected {
+            Some((_, _, pcm)) if state.running => pcm.periods_elapsed().saturating_sub(state.seen) / u64::from(state.ticks.max(1)),
+            _ => 0,
+        }
+    }
+}
+
+impl Pollable for TimerHandle {
+    fn poll(&self, mask: IoEvents, poller: Option<&mut PollHandle>) -> IoEvents {
+        // What is ready changes as the stream plays (and as alsa-lib
+        // moves its pointer in the mapped control page): looked at anew.
+        self.pollee.invalidate();
+        self.pollee.poll_with(mask, poller, || {
+            if Self::pending(&self.state.lock()) > 0 { IoEvents::IN } else { IoEvents::empty() }
+        })
+    }
+}
+
+impl FileOps for TimerHandle {
+    fn read_at(&self, _offset: usize, writer: &mut VmWriter, status_flags: StatusFlags) -> Result<usize> {
+        let size = if self.state.lock().tread { TREAD_SIZE } else { READ_SIZE };
+        if writer.avail() < size {
+            return_errno!(Errno::EINVAL);
+        }
+        let pcm = self.state.lock().selected.as_ref().map(|(_, _, pcm)| pcm.clone()).ok_or(Error::new(Errno::EBADFD))?;
+        if Self::pending(&self.state.lock()) == 0 {
+            if status_flags.contains(StatusFlags::O_NONBLOCK) {
+                return_errno!(Errno::EAGAIN);
+            }
+            pcm.wait.pause_until(|| (Self::pending(&self.state.lock()) > 0).then_some(()))?;
+        }
+        let mut state = self.state.lock();
+        let ticks = Self::pending(&state);
+        state.seen += ticks * u64::from(state.ticks.max(1));
+        let tread = state.tread;
+        drop(state);
+        self.pollee.invalidate();
+        let mut event = [0u8; TREAD_SIZE];
+        if tread {
+            let now = ostd::timer::Jiffies::elapsed().as_duration();
+            put_u32(&mut event, 0, EVENT_TICK);
+            put_u64(&mut event, 8, now.as_secs());
+            put_u64(&mut event, 16, u64::from(now.subsec_nanos()));
+            put_u32(&mut event, 24, ticks as u32);
+        } else {
+            put_u32(&mut event, 0, period_ns(&pcm));
+            put_u32(&mut event, 4, ticks as u32);
+        }
+        writer.write_fallible(&mut VmReader::from(&event[..size]).to_fallible()).map_err(|(error, _)| error)?;
+        Ok(size)
+    }
+
+    fn write_at(&self, _offset: usize, _reader: &mut VmReader, _status_flags: StatusFlags) -> Result<usize> {
+        return_errno!(Errno::EINVAL)
+    }
+}
+
+/// A period's length in nanoseconds (the timer's resolution).
+fn period_ns(pcm: &Pcm) -> u32 {
+    pcm.setup().map_or(1_000_000, |setup| (setup.period_size * 1_000_000_000 / u64::from(setup.rate.max(1))) as u32)
+}
+
+impl PerOpenFileOps for TimerHandle {
+    fn check_seekable(&self) -> Result<()> {
+        return_errno!(Errno::ESPIPE)
+    }
+
+    fn is_offset_aware(&self) -> bool {
+        false
+    }
+
+    fn ioctl(&self, _path: &Path, raw_ioctl: RawIoctl) -> Result<i32> {
+        let arg = raw_ioctl.arg();
+        match raw_ioctl.cmd() {
+            ioctl::PVERSION => current_userspace!().write_val(arg, &VERSION)?,
+            ioctl::NEXT_DEVICE => {
+                let mut id = [0u8; 20];
+                current_userspace!().read_bytes(arg, &mut id)?;
+                let (class, card, device) = (get_u32(&id, 0) as i32, get_u32(&id, 8) as i32, get_u32(&id, 12) as i32);
+                let list = timers();
+                let next = if class < CLASS_PCM {
+                    list.first()
+                } else if class == CLASS_PCM {
+                    list.iter().find(|(c, d, _)| (c.index as i32, *d) > (card, device))
+                } else {
+                    None
+                };
+                id.fill(0);
+                match next {
+                    Some((card, device, _)) => {
+                        put_u32(&mut id, 0, CLASS_PCM as u32);
+                        put_u32(&mut id, 8, card.index);
+                        put_u32(&mut id, 12, *device as u32);
+                    }
+                    None => put_u32(&mut id, 0, CLASS_NONE as u32),
+                }
+                current_userspace!().write_bytes(arg, &id)?;
+            }
+            ioctl::TREAD_OLD | ioctl::TREAD64 => {
+                let on: i32 = current_userspace!().read_val(arg)?;
+                self.state.lock().tread = on != 0;
+            }
+            ioctl::SELECT => {
+                let mut select = [0u8; 52];
+                current_userspace!().read_bytes(arg, &mut select)?;
+                let (class, card, device, subdevice) = (get_u32(&select, 0) as i32, get_u32(&select, 8), get_u32(&select, 12) as i32, get_u32(&select, 16));
+                if class != CLASS_PCM || subdevice > 1 {
+                    return_errno_with_message!(Errno::ENODEV, "only the PCM streams' timers are there");
+                }
+                // alsa-lib asks for the device as (subdevice << 1 | stream)
+                // with the PCM device in `device`.
+                let stream = if subdevice & 1 == 1 || device & 1 == 1 { 1 } else { 0 };
+                let found = timers().into_iter().find(|(c, d, _)| c.index == card && *d == stream);
+                let found = found.ok_or(Error::with_message(Errno::ENODEV, "no such PCM timer"))?;
+                let mut state = self.state.lock();
+                state.seen = found.2.periods_elapsed();
+                state.selected = Some(found);
+                state.running = false;
+                state.ticks = 1;
+            }
+            ioctl::INFO => {
+                let state = self.state.lock();
+                let (card, device, pcm) = state.selected.clone().ok_or(Error::new(Errno::EBADFD))?;
+                drop(state);
+                let mut info = [0u8; 232];
+                put_u32(&mut info, 0, 1);
+                put_u32(&mut info, 4, card.index);
+                let name = format!("PCM {} {}-{}-0", if device == 0 { "playback" } else { "capture" }, card.index, 0);
+                put_str(&mut info, 8, 64, &name);
+                put_str(&mut info, 72, 80, &name);
+                put_u64(&mut info, 160, u64::from(period_ns(&pcm)));
+                current_userspace!().write_bytes(arg, &info)?;
+            }
+            ioctl::PARAMS => {
+                let mut params = [0u8; 80];
+                current_userspace!().read_bytes(arg, &mut params)?;
+                let mut state = self.state.lock();
+                if state.selected.is_none() {
+                    return_errno!(Errno::EBADFD);
+                }
+                state.ticks = get_u32(&params, 4).max(1);
+            }
+            ioctl::STATUS => {
+                let state = self.state.lock();
+                let pcm = state.selected.as_ref().map(|(_, _, pcm)| pcm.clone()).ok_or(Error::new(Errno::EBADFD))?;
+                let queue = Self::pending(&state);
+                drop(state);
+                let now = ostd::timer::Jiffies::elapsed().as_duration();
+                let mut status = [0u8; 96];
+                put_u64(&mut status, 0, now.as_secs());
+                put_u64(&mut status, 8, u64::from(now.subsec_nanos()));
+                put_u32(&mut status, 16, period_ns(&pcm));
+                put_u32(&mut status, 28, queue.min(u64::from(u32::MAX)) as u32);
+                current_userspace!().write_bytes(arg, &status)?;
+            }
+            ioctl::START | ioctl::CONTINUE => {
+                let mut state = self.state.lock();
+                let pcm = state.selected.as_ref().map(|(_, _, pcm)| pcm.clone()).ok_or(Error::new(Errno::EBADFD))?;
+                if raw_ioctl.cmd() == ioctl::START || !state.running {
+                    state.seen = pcm.periods_elapsed();
+                }
+                state.running = true;
+            }
+            ioctl::STOP | ioctl::PAUSE => self.state.lock().running = false,
+            other => {
+                warn!("sound: unknown timer ioctl {:#x}", other);
+                return_errno_with_message!(Errno::ENOTTY, "unknown sound timer ioctl")
+            }
+        }
+        self.pollee.invalidate();
+        Ok(0)
+    }
+}
