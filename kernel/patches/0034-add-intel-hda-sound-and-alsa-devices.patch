+// SPDX-License-Identifier: MPL-2.0
+
+//! The Intel High Definition Audio controller: the sound of nearly every PC
+//! since 2004, whatever its maker (Intel, AMD, NVIDIA, VIA, SiS, ATI,
+//! Zhaoxin). It is reset and taken over, its codecs found through the
+//! command rings (or the immediate command registers, where the rings do not
+//! answer), each codec's widgets read, and its streams run over buffers
+//! described by buffer descriptor lists. Positions are polled; interrupts are
+//! not needed.
+//!
+//! References: Intel High Definition Audio Specification 1.0a, chapters 3
+//! and 4; Linux's `sound/pci/hda/hda_intel.c` and `sound/hda/hdac_*.c`.
+
+use alloc::{string::String, sync::Arc, vec::Vec};
+use core::sync::atomic::{AtomicBool, Ordering};
+
+use aster_pci::{cfg_space::BarAccess, common_device::PciCommonDevice};
+use ostd::{
+    mm::{HasDaddr, VmIo, dma::DmaCoherent},
+    sync::Mutex,
+};
+
+use crate::{
+    codec::{self, Codec, Widget, parameter, verb},
+    pcm::{self, PcmError, Setup, StreamHw},
+};
+
+mod reg {
+    pub(super) const GCAP: usize = 0x00;
+    pub(super) const GCTL: usize = 0x08;
+    pub(super) const STATESTS: usize = 0x0e;
+    pub(super) const INTCTL: usize = 0x20;
+    pub(super) const CORBLBASE: usize = 0x40;
+    pub(super) const CORBUBASE: usize = 0x44;
+    pub(super) const CORBWP: usize = 0x48;
+    pub(super) const CORBRP: usize = 0x4a;
+    pub(super) const CORBCTL: usize = 0x4c;
+    pub(super) const CORBSIZE: usize = 0x4e;
+    pub(super) const RIRBLBASE: usize = 0x50;
+    pub(super) const RIRBUBASE: usize = 0x54;
+    pub(super) const RIRBWP: usize = 0x58;
+    pub(super) const RINTCNT: usize = 0x5a;
+    pub(super) const RIRBCTL: usize = 0x5c;
+    pub(super) const RIRBSTS: usize = 0x5d;
+    pub(super) const RIRBSIZE: usize = 0x5e;
+    pub(super) const ICOI: usize = 0x60;
+    pub(super) const ICII: usize = 0x64;
+    pub(super) const ICIS: usize = 0x68;
+    pub(super) const DPLBASE: usize = 0x70;
+    pub(super) const DPUBASE: usize = 0x74;
+    pub(super) const SD_BASE: usize = 0x80;
+    pub(super) const SD_SIZE: usize = 0x20;
+    /// Stream descriptor registers.
+    pub(super) const SD_CTL: usize = 0x00;
+    pub(super) const SD_STS: usize = 0x03;
+    pub(super) const SD_LPIB: usize = 0x04;
+    pub(super) const SD_CBL: usize = 0x08;
+    pub(super) const SD_LVI: usize = 0x0c;
+    pub(super) const SD_FMT: usize = 0x12;
+    pub(super) const SD_BDPL: usize = 0x18;
+    pub(super) const SD_BDPU: usize = 0x1c;
+}
+
+const GCTL_RESET: u32 = 1 << 0;
+const SD_CTL_RESET: u8 = 1 << 0;
+const SD_CTL_RUN: u8 = 1 << 1;
+/// Busy-wait budget, in register reads (one takes about a microsecond).
+const WAIT_READS: usize = 200_000;
+/// Buffer descriptor list entries: one per period.
+pub(crate) const MAX_PERIODS: u32 = 32;
+
+/// The controller's registers, shared with its streams.
+#[derive(Clone)]
+pub(crate) struct Regs(BarAccess);
+
+impl Regs {
+    pub(crate) fn r8(&self, at: usize) -> u8 {
+        self.0.read_once::<u8>(at).unwrap_or(u8::MAX)
+    }
+    pub(crate) fn r16(&self, at: usize) -> u16 {
+        self.0.read_once::<u16>(at).unwrap_or(u16::MAX)
+    }
+    pub(crate) fn r32(&self, at: usize) -> u32 {
+        self.0.read_once::<u32>(at).unwrap_or(u32::MAX)
+    }
+    pub(crate) fn w8(&self, at: usize, value: u8) {
+        let _ = self.0.write_once::<u8>(at, value);
+    }
+    pub(crate) fn w16(&self, at: usize, value: u16) {
+        let _ = self.0.write_once::<u16>(at, value);
+    }
+    pub(crate) fn w32(&self, at: usize, value: u32) {
+        let _ = self.0.write_once::<u32>(at, value);
+    }
+
+    /// Waits until `done`, reading the registers meanwhile.
+    fn wait(&self, mut done: impl FnMut(&Self) -> bool) -> bool {
+        (0..WAIT_READS).any(|_| {
+            if done(self) {
+                return true;
+            }
+            core::hint::spin_loop();
+            false
+        })
+    }
+
+    /// About `micros` microseconds, by reading a register.
+    fn delay(&self, micros: usize) {
+        for _ in 0..micros {
+            let _ = self.r32(reg::GCAP);
+        }
+    }
+}
+
+/// How commands reach the codecs.
+struct Commands {
+    corb: DmaCoherent,
+    rirb: DmaCoherent,
+    corb_entries: u16,
+    rirb_entries: u16,
+    corb_wp: u16,
+    rirb_rp: u16,
+    /// The rings did not answer: the immediate command registers instead.
+    immediate: bool,
+}
+
+pub(crate) struct Controller {
+    pub(crate) regs: Regs,
+    pub(crate) name: String,
+    commands: Mutex<Commands>,
+    pub(crate) codecs: Vec<Codec>,
+    input_streams: usize,
+    output_streams: usize,
+    _positions: DmaCoherent,
+    _device: PciCommonDevice,
+}
+
+/// A ring size the controller offers: 256, 16 or 2 entries (and its code).
+fn ring_size(capability: u8) -> (u8, u16) {
+    if capability & 0x40 != 0 {
+        (2, 256)
+    } else if capability & 0x20 != 0 {
+        (1, 16)
+    } else {
+        (0, 2)
+    }
+}
+
+impl Controller {
+    pub(crate) fn new(mut device: PciCommonDevice, name: String) -> Option<Self> {
+        let location = *device.location();
+        let id = *device.device_id();
+        let mmio = device.bar_manager_mut().bar_mut(0)?.acquire().ok()?;
+        let regs = Regs(mmio);
+        // Memory decoding and bus mastering.
+        let command = location.read16(0x04);
+        location.write16(0x04, command | 0x06);
+        // Traffic class 0 (Linux clears TCSEL on every controller: static
+        // on some codecs otherwise).
+        let tcsel = location.read8(0x44);
+        location.write8(0x44, tcsel & !0x07);
+        // Intel's SCH-family controllers (Atom): snooping on.
+        if id.vendor_id == 0x8086 && matches!(id.device_id, 0x811b | 0x080a | 0x0f04 | 0x2284 | 0x5a98 | 0x3198) {
+            let devc = location.read16(0x78);
+            location.write16(0x78, devc & !(1 << 11));
+        }
+        let gcap = regs.r16(reg::GCAP);
+        if gcap == u16::MAX {
+            return None;
+        }
+        let output_streams = usize::from((gcap >> 12) & 0xf);
+        let input_streams = usize::from((gcap >> 8) & 0xf);
+
+        // Reset: in and out of it, then the codecs report themselves.
+        regs.w8(reg::RIRBCTL, 0);
+        regs.w8(reg::CORBCTL, 0);
+        regs.w32(reg::GCTL, regs.r32(reg::GCTL) & !GCTL_RESET);
+        if !regs.wait(|r| r.r32(reg::GCTL) & GCTL_RESET == 0) {
+            ostd::notice!("{}: the controller did not enter reset", name);
+        }
+        regs.delay(200);
+        regs.w32(reg::GCTL, regs.r32(reg::GCTL) | GCTL_RESET);
+        if !regs.wait(|r| r.r32(reg::GCTL) & GCTL_RESET != 0) {
+            ostd::warn!("{}: the controller did not leave reset", name);
+            return None;
+        }
+        // Codecs take 521 µs after the reset to ask for an address.
+        regs.delay(1500);
+        let present = regs.r16(reg::STATESTS) & 0x7fff;
+        regs.w16(reg::STATESTS, 0x7fff);
+        regs.w32(reg::INTCTL, 0);
+
+        let corb = DmaCoherent::alloc(1, true).ok()?;
+        let rirb = DmaCoherent::alloc(1, true).ok()?;
+        let positions = DmaCoherent::alloc(1, true).ok()?;
+        let (corb_code, corb_entries) = ring_size(regs.r8(reg::CORBSIZE));
+        let (rirb_code, rirb_entries) = ring_size(regs.r8(reg::RIRBSIZE));
+        regs.w32(reg::CORBLBASE, corb.daddr() as u32);
+        regs.w32(reg::CORBUBASE, (corb.daddr() as u64 >> 32) as u32);
+        regs.w8(reg::CORBSIZE, (regs.r8(reg::CORBSIZE) & !0x3) | corb_code);
+        regs.w16(reg::CORBWP, 0);
+        // The read pointer's reset: set, seen, cleared (some controllers
+        // never show it set; Linux carries on then).
+        regs.w16(reg::CORBRP, 1 << 15);
+        regs.wait(|r| r.r16(reg::CORBRP) & (1 << 15) != 0);
+        regs.w16(reg::CORBRP, 0);
+        regs.wait(|r| r.r16(reg::CORBRP) & (1 << 15) == 0);
+        regs.w8(reg::CORBCTL, 0x02);
+        regs.w32(reg::RIRBLBASE, rirb.daddr() as u32);
+        regs.w32(reg::RIRBUBASE, (rirb.daddr() as u64 >> 32) as u32);
+        regs.w8(reg::RIRBSIZE, (regs.r8(reg::RIRBSIZE) & !0x3) | rirb_code);
+        regs.w16(reg::RIRBWP, 1 << 15);
+        regs.w16(reg::RINTCNT, 1);
+        // DMA and its interrupt status (as Linux sets it): without the
+        // latter, some controllers stop taking commands once RINTCNT
+        // responses came. The interrupt itself stays off (INTCTL).
+        regs.w8(reg::RIRBCTL, 0x03);
+        regs.w32(reg::DPLBASE, positions.daddr() as u32 | 1);
+        regs.w32(reg::DPUBASE, (positions.daddr() as u64 >> 32) as u32);
+
+        let mut controller = Self {
+            regs,
+            name,
+            commands: Mutex::new(Commands {
+                corb,
+                rirb,
+                corb_entries,
+                rirb_entries,
+                corb_wp: 0,
+                rirb_rp: 0,
+                immediate: false,
+            }),
+            codecs: Vec::new(),
+            input_streams,
+            output_streams,
+            _positions: positions,
+            _device: device,
+        };
+        for address in 0..15u8 {
+            if present & (1 << address) == 0 {
+                continue;
+            }
+            match controller.read_codec(address) {
+                Some(codec) => controller.codecs.push(codec),
+                None => ostd::notice!("{}: codec {} did not answer", controller.name, address),
+            }
+        }
+        ostd::notice!(
+            "{}: HDA {:04x}:{:04x}, {} output and {} input streams, codecs {:?}",
+            controller.name,
+            id.vendor_id,
+            id.device_id,
+            output_streams,
+            input_streams,
+            controller.codecs.iter().map(|codec| alloc::format!("{:08x}", codec.vendor)).collect::<Vec<_>>()
+        );
+        Some(controller)
+    }
+
+    // ── Commands ─────────────────────────────────────────────────────────
+
+    /// Sends a verb and waits for the codec's answer.
+    pub(crate) fn command(&self, codec: u8, nid: u8, verb: u32, payload: u32) -> Option<u32> {
+        let word = codec::command(codec, nid, verb, payload);
+        let mut commands = self.commands.lock();
+        if !commands.immediate {
+            if let Some(answer) = self.ring_command(&mut commands, word, codec) {
+                return Some(answer);
+            }
+            ostd::notice!(
+                "{}: no answer on the command rings (CORBRP {:#x} CORBWP {:#x} RIRBWP {:#x} CORBCTL {:#x} RIRBCTL {:#x} RINTCNT {:#x} RIRBSTS {:#x} CORBSIZE {:#x}); using the immediate command registers",
+                self.name,
+                self.regs.r16(reg::CORBRP),
+                self.regs.r16(reg::CORBWP),
+                self.regs.r16(reg::RIRBWP),
+                self.regs.r8(reg::CORBCTL),
+                self.regs.r8(reg::RIRBCTL),
+                self.regs.r16(reg::RINTCNT),
+                self.regs.r8(reg::RIRBSTS),
+                self.regs.r8(reg::CORBSIZE)
+            );
+            commands.immediate = true;
+            self.regs.w8(reg::CORBCTL, 0);
+            self.regs.w8(reg::RIRBCTL, 0);
+        }
+        self.immediate_command(word)
+    }
+
+    fn ring_command(&self, commands: &mut Commands, word: u32, codec: u8) -> Option<u32> {
+        let wp = (commands.corb_wp + 1) % commands.corb_entries;
+        commands.corb.write_val(usize::from(wp) * 4, &word).ok()?;
+        commands.corb_wp = wp;
+        self.regs.w16(reg::CORBWP, wp);
+        let mut answer = None;
+        let found = self.regs.wait(|r| {
+            let written = r.r16(reg::RIRBWP) & 0xff;
+            while commands.rirb_rp != written % commands.rirb_entries {
+                commands.rirb_rp = (commands.rirb_rp + 1) % commands.rirb_entries;
+                let at = usize::from(commands.rirb_rp) * 8;
+                let response: u32 = commands.rirb.read_val(at).unwrap_or(0);
+                let extended: u32 = commands.rirb.read_val(at + 4).unwrap_or(0);
+                // Unsolicited responses (jacks) are not answers.
+                if extended & (1 << 4) == 0 && (extended & 0xf) as u8 == codec {
+                    answer = Some(response);
+                }
+            }
+            answer.is_some()
+        });
+        self.regs.w8(reg::RIRBSTS, 0x05);
+        if found { answer } else { None }
+    }
+
+    fn immediate_command(&self, word: u32) -> Option<u32> {
+        let regs = &self.regs;
+        if !regs.wait(|r| r.r16(reg::ICIS) & 1 == 0) {
+            return None;
+        }
+        regs.w16(reg::ICIS, regs.r16(reg::ICIS) | 0x2);
+        regs.w32(reg::ICOI, word);
+        regs.w16(reg::ICIS, regs.r16(reg::ICIS) | 0x1);
+        if !regs.wait(|r| r.r16(reg::ICIS) & 0x3 == 0x2) {
+            return None;
+        }
+        Some(regs.r32(reg::ICII))
+    }
+
+    fn parameter(&self, codec: u8, nid: u8, which: u32) -> u32 {
+        self.command(codec, nid, verb::GET_PARAMETER, which).unwrap_or(0)
+    }
+
+    /// A codec's audio function group and its widgets.
+    fn read_codec(&self, address: u8) -> Option<Codec> {
+        let vendor = self.command(address, 0, verb::GET_PARAMETER, parameter::VENDOR_ID)?;
+        let nodes = self.parameter(address, 0, parameter::SUBNODE_COUNT);
+        let (first, count) = (((nodes >> 16) & 0xff) as u8, (nodes & 0xff) as u8);
+        let afg = (first..first.saturating_add(count)).find(|&nid| self.parameter(address, nid, parameter::FUNCTION_TYPE) & 0xff == 1)?;
+        self.command(address, afg, verb::SET_POWER_STATE, 0);
+        let mut codec = Codec {
+            address,
+            afg,
+            vendor,
+            amp_in: self.parameter(address, afg, parameter::AMP_IN_CAP),
+            amp_out: self.parameter(address, afg, parameter::AMP_OUT_CAP),
+            gpios: self.parameter(address, afg, parameter::GPIO_COUNT) & 0xff,
+            ..Codec::default()
+        };
+        let widgets = self.parameter(address, afg, parameter::SUBNODE_COUNT);
+        let (first, count) = (((widgets >> 16) & 0xff) as u8, (widgets & 0xff) as u8);
+        for nid in first..first.saturating_add(count) {
+            let caps = self.parameter(address, nid, parameter::AUDIO_WIDGET_CAP);
+            let mut widget = Widget { nid, caps, ..Widget::default() };
+            if widget.has_in_amp() {
+                widget.amp_in = if widget.amp_override() { self.parameter(address, nid, parameter::AMP_IN_CAP) } else { 0 };
+            }
+            if widget.has_out_amp() {
+                widget.amp_out = if widget.amp_override() { self.parameter(address, nid, parameter::AMP_OUT_CAP) } else { 0 };
+            }
+            if widget.kind() == codec::Kind::Pin {
+                widget.pin_caps = self.parameter(address, nid, parameter::PIN_CAP);
+                widget.config = self.command(address, nid, verb::GET_CONFIG_DEFAULT, 0).unwrap_or(0);
+            }
+            if caps & (1 << 8) != 0 {
+                widget.connections = self.connections(address, nid);
+            }
+            codec.widgets.insert(nid, widget);
+        }
+        Some(codec)
+    }
+
+    fn connections(&self, codec: u8, nid: u8) -> Vec<u8> {
+        let length = self.parameter(codec, nid, parameter::CONNECTION_LIST_LENGTH);
+        let long_form = length & 0x80 != 0;
+        let count = (length & 0x7f) as usize;
+        let per_answer = if long_form { 2 } else { 4 };
+        let mut entries = Vec::with_capacity(count);
+        let mut index = 0;
+        while index < count {
+            let answer = self.command(codec, nid, verb::GET_CONNECTION_LIST, index as u32).unwrap_or(0);
+            for slot in 0..per_answer {
+                if index + slot >= count {
+                    break;
+                }
+                let entry = if long_form { (answer >> (16 * slot)) & 0xffff } else { (answer >> (8 * slot)) & 0xff };
+                entries.push(entry as u16);
+            }
+            index += per_answer;
+        }
+        codec::expand_connections(&entries, long_form)
+    }
+
+    // ── Streams ──────────────────────────────────────────────────────────
+
+    pub(crate) fn output_descriptor(&self, index: usize) -> Option<usize> {
+        (index < self.output_streams).then(|| reg::SD_BASE + reg::SD_SIZE * (self.input_streams + index))
+    }
+
+    pub(crate) fn input_descriptor(&self, index: usize) -> Option<usize> {
+        (index < self.input_streams).then(|| reg::SD_BASE + reg::SD_SIZE * index)
+    }
+}
+
+/// One stream of the controller, feeding (or fed by) converters.
+pub(crate) struct Stream {
+    pub(crate) controller: Arc<Controller>,
+    /// The stream descriptor's registers.
+    pub(crate) base: usize,
+    pub(crate) tag: u8,
+    /// The converters (codec, node) that play or record it.
+    pub(crate) converters: Vec<(u8, u8)>,
+    bdl: DmaCoherent,
+    running: AtomicBool,
+}
+
+impl Stream {
+    pub(crate) fn new(controller: Arc<Controller>, base: usize, tag: u8, converters: Vec<(u8, u8)>) -> Option<Self> {
+        Some(Self { controller, base, tag, converters, bdl: DmaCoherent::alloc(1, true).ok()?, running: AtomicBool::new(false) })
+    }
+
+    fn regs(&self) -> &Regs {
+        &self.controller.regs
+    }
+
+    fn reset(&self) {
+        let regs = self.regs();
+        let ctl = self.base + reg::SD_CTL;
+        regs.w8(ctl, regs.r8(ctl) & !SD_CTL_RUN);
+        regs.wait(|r| r.r8(ctl) & SD_CTL_RUN == 0);
+        regs.w8(ctl, regs.r8(ctl) | SD_CTL_RESET);
+        regs.wait(|r| r.r8(ctl) & SD_CTL_RESET != 0);
+        regs.w8(ctl, regs.r8(ctl) & !SD_CTL_RESET);
+        regs.wait(|r| r.r8(ctl) & SD_CTL_RESET == 0);
+        regs.w8(self.base + reg::SD_STS, 0x1c);
+    }
+}
+
+impl StreamHw for Stream {
+    fn prepare(&self, setup: &Setup, buffer: u64) -> pcm::Result<()> {
+        let bits = if setup.sample_bits == 16 { 16 } else { codec_bits(&self.controller, &self.converters) };
+        let format = codec::stream_format(setup.rate, bits, setup.channels).ok_or(PcmError::Invalid)?;
+        if setup.periods > MAX_PERIODS {
+            return Err(PcmError::Invalid);
+        }
+        self.reset();
+        let period = setup.period_bytes();
+        for period_index in 0..setup.periods as usize {
+            let at = period_index * 16;
+            let address = buffer + (period_index * period) as u64;
+            self.bdl.write_val(at, &address).map_err(|_| PcmError::Io)?;
+            self.bdl.write_val(at + 8, &(period as u32)).map_err(|_| PcmError::Io)?;
+            self.bdl.write_val(at + 12, &1u32).map_err(|_| PcmError::Io)?;
+        }
+        let regs = self.regs();
+        regs.w32(self.base + reg::SD_BDPL, self.bdl.daddr() as u32);
+        regs.w32(self.base + reg::SD_BDPU, (self.bdl.daddr() as u64 >> 32) as u32);
+        regs.w32(self.base + reg::SD_CBL, setup.buffer_bytes() as u32);
+        regs.w16(self.base + reg::SD_LVI, (setup.periods - 1) as u16);
+        regs.w16(self.base + reg::SD_FMT, format);
+        // The stream's tag, in bits 23:20 of the 24-bit control register.
+        let ctl2 = self.base + reg::SD_CTL + 2;
+        regs.w8(ctl2, (regs.r8(ctl2) & 0x0f) | self.tag << 4);
+        for &(codec, nid) in &self.converters {
+            self.controller.command(codec, nid, verb::SET_CHANNEL_STREAM_ID, u32::from(self.tag) << 4);
+            self.controller.command(codec, nid, verb::SET_STREAM_FORMAT, u32::from(format));
+        }
+        Ok(())
+    }
+
+    fn start(&self) {
+        let ctl = self.base + reg::SD_CTL;
+        self.regs().w8(ctl, self.regs().r8(ctl) | SD_CTL_RUN);
+        self.running.store(true, Ordering::Release);
+    }
+
+    fn stop(&self) {
+        let ctl = self.base + reg::SD_CTL;
+        self.regs().w8(ctl, self.regs().r8(ctl) & !SD_CTL_RUN);
+        self.running.store(false, Ordering::Release);
+    }
+
+    fn position(&self) -> usize {
+        self.regs().r32(self.base + reg::SD_LPIB) as usize
+    }
+
+    fn describe(&self) -> String {
+        let regs = self.regs();
+        alloc::format!(
+            "stream at {:#x}: CTL {:#x} STS {:#x} LPIB {} CBL {} LVI {} FMT {:#x} tag {}",
+            self.base,
+            regs.r32(self.base + reg::SD_CTL) & 0xff_ffff,
+            regs.r8(self.base + reg::SD_STS),
+            regs.r32(self.base + reg::SD_LPIB),
+            regs.r32(self.base + reg::SD_CBL),
+            regs.r16(self.base + reg::SD_LVI),
+            regs.r16(self.base + reg::SD_FMT),
+            self.tag
+        ) + &self
+            .converters
+            .iter()
+            .map(|&(codec, nid)| {
+                alloc::format!(
+                    "; converter {}:{:#x} stream {:#x} format {:#x}",
+                    codec,
+                    nid,
+                    self.controller.command(codec, nid, 0xf06, 0).unwrap_or(u32::MAX),
+                    self.controller.command(codec, nid, 0xa, 0).unwrap_or(u32::MAX)
+                )
+            })
+            .collect::<String>()
+    }
+
+    fn release(&self) {
+        self.stop();
+        for &(codec, nid) in &self.converters {
+            self.controller.command(codec, nid, verb::SET_CHANNEL_STREAM_ID, 0);
+        }
+    }
+}
+
+/// The sample size the converters take for 32-bit samples: their largest.
+fn codec_bits(controller: &Controller, converters: &[(u8, u8)]) -> u32 {
+    converters
+        .iter()
+        .map(|&(codec, nid)| codec::max_bits_of(controller.parameter(codec, nid, parameter::PCM)))
+        .min()
+        .unwrap_or(16)
+        .max(16)
+}
diff --git a/kernel/comps/sound/src/lib.rs b/kernel/comps/sound/src/lib.rs
new file mode 100755
index 0000000..985a067
--- /dev/null
+++ b/kernel/comps/sound/src/lib.rs
@@ -0,0 +1,193 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Sound: the HDA controllers (`hda`) and their codecs (`codec`) as ALSA
+//! cards (`card`), with their PCM streams (`pcm`, whose parameters `params`
+//! negotiates). The ALSA device files (`/dev/snd`) are the kernel's
+//! (`aster-core`'s `device::snd`), on top of this.
+
+#![no_std]
+#![deny(unsafe_code)]
+
+extern crate alloc;
+
+// This crate's log prefix for `ostd::log`.
+macro_rules! __log_prefix {
+    () => {
+        "sound: "
+    };
+}
+
+pub mod card;
+pub mod codec;
+mod hda;
+pub mod params;
+pub mod pcm;
+
+use alloc::{format, string::String, sync::Arc, vec::Vec};
+use core::sync::atomic::{AtomicBool, AtomicU64, AtomicUsize, Ordering};
+
+use aster_pci::{
+    PCI_BUS, PciDeviceId,
+    bus::{PciDevice, PciDriver},
+    common_device::PciCommonDevice,
+};
+use component::{ComponentInitError, init_component};
+use ostd::{
+    bus::BusProbeError,
+    sync::{SpinLock, WaitQueue},
+};
+
+pub use card::Card;
+pub use pcm::{Direction, Pcm};
+
+static CARDS: SpinLock<Vec<Arc<Card>>> = SpinLock::new(Vec::new());
+static CARD_HOOK: spin::Once<fn(&Arc<Card>)> = spin::Once::new();
+/// Streams running: the timer looks at their positions while there are some.
+static RUNNING: AtomicUsize = AtomicUsize::new(0);
+static TICKS: AtomicU64 = AtomicU64::new(0);
+/// Something a poller may wait for happened: a stream moved on or changed
+/// state, a control changed. The device files' notifier waits here.
+pub static ACTIVITY: WaitQueue = WaitQueue::new();
+static ACTIVITY_SEQ: AtomicU64 = AtomicU64::new(0);
+/// The jack task's half-second.
+static JACKS: WaitQueue = WaitQueue::new();
+static JACKS_DUE: AtomicBool = AtomicBool::new(false);
+
+pub fn activity_seq() -> u64 {
+    ACTIVITY_SEQ.load(Ordering::Acquire)
+}
+
+pub(crate) fn note_activity() {
+    ACTIVITY_SEQ.fetch_add(1, Ordering::AcqRel);
+    ACTIVITY.wake_all();
+}
+
+/// The sound cards found.
+pub fn cards() -> Vec<Arc<Card>> {
+    CARDS.lock().clone()
+}
+
+/// Sets the hook told of each card once it is ready (its device files).
+pub fn set_card_hook(hook: fn(&Arc<Card>)) {
+    CARD_HOOK.call_once(|| hook);
+}
+
+pub(crate) fn note_running(running: bool) {
+    if running {
+        RUNNING.fetch_add(1, Ordering::AcqRel);
+    } else {
+        let _ = RUNNING.try_update(Ordering::AcqRel, Ordering::Acquire, |count| count.checked_sub(1));
+    }
+}
+
+/// Every other millisecond while streams run: their positions move on and
+/// whoever waits for room or data wakes.
+fn tick() {
+    let ticks = TICKS.fetch_add(1, Ordering::Relaxed);
+    if ticks % 500 == 0 {
+        JACKS_DUE.store(true, Ordering::Release);
+        JACKS.wake_all();
+    }
+    if RUNNING.load(Ordering::Acquire) == 0 || ticks % 2 != 0 {
+        return;
+    }
+    let Some(cards) = CARDS.try_lock() else { return };
+    for card in cards.iter() {
+        for pcm in card.pcms() {
+            if pcm.is_running() {
+                pcm.update();
+            }
+        }
+    }
+}
+
+#[derive(Debug)]
+struct Claimed(PciDeviceId);
+
+impl PciDevice for Claimed {
+    fn device_id(&self) -> PciDeviceId {
+        self.0
+    }
+}
+
+/// Claims the HDA controllers: multimedia, audio device (0x0403); Intel's
+/// audio DSPs (0x0401) also present the HDA registers.
+#[derive(Debug)]
+struct Driver {
+    found: SpinLock<Vec<PciCommonDevice>>,
+}
+
+impl PciDriver for Driver {
+    fn probe(&self, device: PciCommonDevice) -> Result<Arc<dyn PciDevice>, (BusProbeError, PciCommonDevice)> {
+        let id = *device.device_id();
+        let hda = (id.class, id.subclass) == (0x04, 0x03) || (id.vendor_id == 0x8086 && (id.class, id.subclass) == (0x04, 0x01));
+        if !hda {
+            return Err((BusProbeError::DeviceNotMatch, device));
+        }
+        self.found.lock().push(device);
+        Ok(Arc::new(Claimed(id)))
+    }
+}
+
+static PENDING: SpinLock<Vec<PciCommonDevice>> = SpinLock::new(Vec::new());
+
+#[init_component]
+fn init() -> Result<(), ComponentInitError> {
+    let driver = Arc::new(Driver { found: SpinLock::new(Vec::new()) });
+    PCI_BUS.lock().register_driver(driver.clone());
+    let found = core::mem::take(&mut *driver.found.lock());
+    if !found.is_empty() {
+        ostd::timer::register_callback_on_cpu(tick);
+    }
+    PENDING.lock().extend(found);
+    Ok(())
+}
+
+/// Sets the controllers up and then follows their jacks, forever: the
+/// kernel runs it as a task of its own (resets and codec commands take a
+/// while), once its device files can be made.
+pub fn run() {
+    let devices = core::mem::take(&mut *PENDING.lock());
+    if devices.is_empty() {
+        return;
+    }
+    let mut index = 0;
+    for device in devices {
+        let id = *device.device_id();
+        let location = *device.location();
+        let name: String = format!("hda {:02x}:{:02x}.{}", location.bus, location.device, location.function);
+        let Some(controller) = hda::Controller::new(device, name.clone()) else {
+            ostd::warn!("{}: the controller did not start", name);
+            continue;
+        };
+        let place = format!("pci {:02x}:{:02x}.{}", location.bus, location.device, location.function);
+        match Card::new(index, Arc::new(controller), id.vendor_id, place) {
+            Some(card) => {
+                ostd::notice!(
+                    "card {}: {} ({}){}{}",
+                    index,
+                    card.name,
+                    card.mixer_name,
+                    if card.playback.is_some() { ", playback" } else { "" },
+                    if card.capture.is_some() { ", capture" } else { "" }
+                );
+                CARDS.lock().push(card.clone());
+                if let Some(hook) = CARD_HOOK.get() {
+                    hook(&card);
+                }
+                index += 1;
+            }
+            None => ostd::notice!("{}: no analog outputs or inputs (HDMI only)", name),
+        }
+    }
+    if index == 0 {
+        return;
+    }
+    // The jacks, twice a second.
+    loop {
+        for card in cards() {
+            card.poll_jacks();
+        }
+        JACKS.wait_until(|| JACKS_DUE.swap(false, Ordering::AcqRel).then_some(()));
+    }
+}
