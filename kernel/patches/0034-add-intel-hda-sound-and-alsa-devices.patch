new file mode 100755
index 0000000..f00c176
--- /dev/null
+++ b/kernel/comps/sound/src/params.rs
@@ -0,0 +1,657 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! ALSA's hardware parameter space, as `snd_pcm_hw_params` carries it: three
+//! masks (access, format, subformat) and twelve intervals (sample and frame
+//! bits, channels, rate, period and buffer sizes and times), narrowed by the
+//! hardware's limits and by the rules that tie them together until nothing
+//! changes, as Linux's `snd_pcm_hw_refine` does; and the final choice
+//! `snd_pcm_hw_params` makes. alsa-lib relies on these exact semantics. No
+//! hardware here: its tests run on the host.
+//!
+//! Reference: Linux's `sound/core/pcm_native.c`, `pcm_lib.c`.
+
+/// Parameter numbers (`SNDRV_PCM_HW_PARAM_*`).
+pub mod param {
+    pub const ACCESS: usize = 0;
+    pub const FORMAT: usize = 1;
+    pub const SUBFORMAT: usize = 2;
+    pub const SAMPLE_BITS: usize = 8;
+    pub const FRAME_BITS: usize = 9;
+    pub const CHANNELS: usize = 10;
+    pub const RATE: usize = 11;
+    pub const PERIOD_TIME: usize = 12;
+    pub const PERIOD_SIZE: usize = 13;
+    pub const PERIOD_BYTES: usize = 14;
+    pub const PERIODS: usize = 15;
+    pub const BUFFER_TIME: usize = 16;
+    pub const BUFFER_SIZE: usize = 17;
+    pub const BUFFER_BYTES: usize = 18;
+    pub const TICK_TIME: usize = 19;
+    pub const FIRST_INTERVAL: usize = SAMPLE_BITS;
+}
+
+/// Access types (`SNDRV_PCM_ACCESS_*`).
+pub mod access {
+    pub const MMAP_INTERLEAVED: u32 = 0;
+    pub const RW_INTERLEAVED: u32 = 3;
+}
+
+/// Sample formats (`SNDRV_PCM_FORMAT_*`) and their sizes in bits.
+pub mod format {
+    pub const S16_LE: u32 = 2;
+    pub const S32_LE: u32 = 10;
+
+    /// The bits a sample of `format` takes in memory.
+    pub fn physical_width(format: u32) -> Option<u32> {
+        match format {
+            0 | 1 => Some(8),
+            2..=5 => Some(16),
+            6..=9 => Some(32),
+            10..=13 => Some(32),
+            14 | 15 => Some(32),
+            16 | 17 => Some(64),
+            32..=35 => Some(24),
+            _ => None,
+        }
+    }
+}
+
+pub const SUBFORMAT_STD: u32 = 0;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Mask(pub [u32; 8]);
+
+impl Mask {
+    pub const fn any() -> Self {
+        Self([u32::MAX; 8])
+    }
+
+    pub fn of(values: &[u32]) -> Self {
+        let mut mask = Self([0; 8]);
+        for &value in values {
+            mask.set(value);
+        }
+        mask
+    }
+
+    pub fn test(&self, value: u32) -> bool {
+        value < 256 && self.0[(value / 32) as usize] & (1 << (value % 32)) != 0
+    }
+
+    pub fn set(&mut self, value: u32) {
+        if value < 256 {
+            self.0[(value / 32) as usize] |= 1 << (value % 32);
+        }
+    }
+
+    pub fn reset(&mut self, value: u32) {
+        if value < 256 {
+            self.0[(value / 32) as usize] &= !(1 << (value % 32));
+        }
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.0.iter().all(|&word| word == 0)
+    }
+
+    pub fn first(&self) -> Option<u32> {
+        (0..256).find(|&value| self.test(value))
+    }
+
+    pub fn is_single(&self) -> bool {
+        self.0.iter().map(|word| word.count_ones()).sum::<u32>() == 1
+    }
+
+    /// `self &= other`; whether it changed, or an error when it empties.
+    fn refine(&mut self, other: &Mask) -> Result<bool, ()> {
+        let old = *self;
+        for (word, other) in self.0.iter_mut().zip(other.0.iter()) {
+            *word &= other;
+        }
+        if self.is_empty() {
+            return Err(());
+        }
+        Ok(old != *self)
+    }
+
+    fn choose_first(&mut self) -> bool {
+        match self.first() {
+            Some(first) if !self.is_single() => {
+                *self = Self::of(&[first]);
+                true
+            }
+            _ => false,
+        }
+    }
+}
+
+/// A range of values, its ends open or closed, maybe integers only
+/// (`struct snd_interval`).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Interval {
+    pub min: u32,
+    pub max: u32,
+    pub openmin: bool,
+    pub openmax: bool,
+    pub integer: bool,
+    pub empty: bool,
+}
+
+fn mul(a: u32, b: u32) -> u32 {
+    a.checked_mul(b).unwrap_or(u32::MAX)
+}
+
+/// a / b and whether there is a remainder.
+fn div32(a: u32, b: u32) -> (u32, bool) {
+    if b == 0 {
+        return (u32::MAX, false);
+    }
+    (a / b, a % b != 0)
+}
+
+/// a * b / c and whether there is a remainder.
+fn muldiv32(a: u32, b: u32, c: u32) -> (u32, bool) {
+    if c == 0 {
+        return (u32::MAX, false);
+    }
+    let n = u64::from(a) * u64::from(b);
+    let (q, r) = (n / u64::from(c), n % u64::from(c));
+    if q > u64::from(u32::MAX) {
+        return (u32::MAX, false);
+    }
+    (q as u32, r != 0)
+}
+
+impl Interval {
+    pub const fn any() -> Self {
+        Self { min: 0, max: u32::MAX, openmin: false, openmax: false, integer: false, empty: false }
+    }
+
+    pub const fn range(min: u32, max: u32) -> Self {
+        Self { min, max, openmin: false, openmax: false, integer: false, empty: false }
+    }
+
+    pub const fn integer_range(min: u32, max: u32) -> Self {
+        Self { min, max, openmin: false, openmax: false, integer: true, empty: false }
+    }
+
+    pub const fn single(value: u32) -> Self {
+        Self::integer_range(value, value)
+    }
+
+    fn none() -> Self {
+        Self { empty: true, ..Self::any() }
+    }
+
+    fn check_empty(&self) -> bool {
+        self.min > self.max || ((self.openmin || self.openmax) && self.min == self.max)
+    }
+
+    pub fn is_single(&self) -> bool {
+        !self.empty && (self.min == self.max || (self.min + 1 == self.max && (self.openmin || self.openmax)))
+    }
+
+    /// Its value when single.
+    pub fn value(&self) -> u32 {
+        if self.openmin && !self.openmax { self.max } else { self.min }
+    }
+
+    /// Narrows `self` to `other` (`snd_interval_refine`).
+    pub fn refine(&mut self, other: &Interval) -> Result<bool, ()> {
+        if self.empty || other.empty {
+            return Err(());
+        }
+        let mut changed = false;
+        if self.min < other.min {
+            self.min = other.min;
+            self.openmin = other.openmin;
+            changed = true;
+        } else if self.min == other.min && !self.openmin && other.openmin {
+            self.openmin = true;
+            changed = true;
+        }
+        if self.max > other.max {
+            self.max = other.max;
+            self.openmax = other.openmax;
+            changed = true;
+        } else if self.max == other.max && !self.openmax && other.openmax {
+            self.openmax = true;
+            changed = true;
+        }
+        if !self.integer && other.integer {
+            self.integer = true;
+            changed = true;
+        }
+        if self.integer {
+            if self.openmin {
+                self.min = self.min.saturating_add(1);
+                self.openmin = false;
+            }
+            if self.openmax {
+                self.max = self.max.saturating_sub(1);
+                self.openmax = false;
+            }
+        } else if !self.openmin && !self.openmax && self.min == self.max {
+            self.integer = true;
+        }
+        if self.check_empty() {
+            *self = Self::none();
+            return Err(());
+        }
+        Ok(changed)
+    }
+
+    fn mul(a: &Self, b: &Self) -> Self {
+        if a.empty || b.empty {
+            return Self::none();
+        }
+        Self {
+            min: mul(a.min, b.min),
+            openmin: a.openmin || b.openmin,
+            max: mul(a.max, b.max),
+            openmax: a.openmax || b.openmax,
+            integer: a.integer && b.integer,
+            empty: false,
+        }
+    }
+
+    fn div(a: &Self, b: &Self) -> Self {
+        if a.empty || b.empty {
+            return Self::none();
+        }
+        let (min, r) = div32(a.min, b.max);
+        let mut c = Self { min, openmin: r || a.openmin || b.openmax, ..Self::any() };
+        if b.min > 0 {
+            let (max, r) = div32(a.max, b.min);
+            if r {
+                c.max = max.saturating_add(1);
+                c.openmax = true;
+            } else {
+                c.max = max;
+                c.openmax = a.openmax || b.openmin;
+            }
+        }
+        c
+    }
+
+    fn muldivk(a: &Self, b: &Self, k: u32) -> Self {
+        if a.empty || b.empty {
+            return Self::none();
+        }
+        let (min, r) = muldiv32(a.min, b.min, k);
+        let (max, rmax) = muldiv32(a.max, b.max, k);
+        Self {
+            min,
+            openmin: r || a.openmin || b.openmin,
+            max: if rmax { max.saturating_add(1) } else { max },
+            openmax: rmax || a.openmax || b.openmax,
+            integer: false,
+            empty: false,
+        }
+    }
+
+    fn mulkdiv(a: &Self, k: u32, b: &Self) -> Self {
+        if a.empty || b.empty {
+            return Self::none();
+        }
+        let (min, r) = muldiv32(a.min, k, b.max);
+        let mut c = Self { min, openmin: r || a.openmin || b.openmax, ..Self::any() };
+        if b.min > 0 {
+            let (max, r) = muldiv32(a.max, k, b.min);
+            if r {
+                c.max = max.saturating_add(1);
+                c.openmax = true;
+            } else {
+                c.max = max;
+                c.openmax = a.openmax || b.openmin;
+            }
+        }
+        c
+    }
+
+    /// Narrowed to its smallest value (`snd_interval_refine_first`): just
+    /// above its minimum when that is open.
+    fn refine_first(&mut self) -> bool {
+        if self.is_single() {
+            return false;
+        }
+        let last_max = self.max;
+        self.max = self.min;
+        if self.openmin {
+            self.max = self.max.saturating_add(1);
+        }
+        self.openmax = self.openmax && self.max >= last_max;
+        true
+    }
+
+    /// Narrowed to its largest value (`snd_interval_refine_last`).
+    fn refine_last(&mut self) -> bool {
+        if self.is_single() {
+            return false;
+        }
+        let last_min = self.min;
+        self.min = self.max;
+        if self.openmax {
+            self.min = self.min.saturating_sub(1);
+        }
+        self.openmin = self.openmin && self.min <= last_min;
+        true
+    }
+
+    /// The values of `list` within `self`, as an interval.
+    fn of_list(&self, list: &[u32]) -> Self {
+        let inside = |value: u32| {
+            let above = if self.openmin { value > self.min } else { value >= self.min };
+            let below = if self.openmax { value < self.max } else { value <= self.max };
+            above && below
+        };
+        let mut found = list.iter().copied().filter(|&value| inside(value));
+        match found.next() {
+            Some(first) => {
+                let (min, max) = found.fold((first, first), |(min, max), value| (min.min(value), max.max(value)));
+                Self::integer_range(min, max)
+            }
+            None => Self::none(),
+        }
+    }
+
+    /// Narrowed to multiples of `step` (`snd_pcm_hw_constraint_step`).
+    fn step(&self, step: u32) -> Self {
+        let mut c = *self;
+        if step <= 1 || self.empty {
+            return c;
+        }
+        let min = if self.openmin { self.min.saturating_add(1) } else { self.min };
+        let max = if self.openmax { self.max.saturating_sub(1) } else { self.max };
+        c.min = min.div_ceil(step).saturating_mul(step);
+        c.max = max / step * step;
+        c.openmin = false;
+        c.openmax = false;
+        if c.min > c.max { Self::none() } else { c }
+    }
+}
+
+/// `struct snd_pcm_hw_params`, without its reserved fields.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct HwParams {
+    pub flags: u32,
+    pub masks: [Mask; 3],
+    pub intervals: [Interval; 12],
+    pub rmask: u32,
+    pub cmask: u32,
+    pub info: u32,
+    pub msbits: u32,
+    pub rate_num: u32,
+    pub rate_den: u32,
+    pub fifo_size: u64,
+}
+
+impl HwParams {
+    /// Everything allowed (`snd_pcm_hw_params_any`).
+    pub fn any() -> Self {
+        Self {
+            flags: 0,
+            masks: [Mask::any(); 3],
+            intervals: [Interval::any(); 12],
+            rmask: u32::MAX,
+            cmask: 0,
+            info: 0,
+            msbits: 0,
+            rate_num: 0,
+            rate_den: 0,
+            fifo_size: 0,
+        }
+    }
+
+    pub fn interval(&self, param: usize) -> &Interval {
+        &self.intervals[param - param::FIRST_INTERVAL]
+    }
+
+    pub fn interval_mut(&mut self, param: usize) -> &mut Interval {
+        &mut self.intervals[param - param::FIRST_INTERVAL]
+    }
+
+    /// The single value of an interval parameter (after `HW_PARAMS`).
+    pub fn get(&self, param: usize) -> u32 {
+        self.interval(param).value()
+    }
+
+    pub fn access(&self) -> Option<u32> {
+        self.masks[param::ACCESS].first()
+    }
+
+    pub fn format(&self) -> Option<u32> {
+        self.masks[param::FORMAT].first()
+    }
+}
+
+/// What a stream's hardware can do.
+#[derive(Clone, Debug)]
+pub struct HwLimits {
+    pub info: u32,
+    pub formats: Mask,
+    pub rates: alloc::vec::Vec<u32>,
+    pub channels: (u32, u32),
+    pub period_bytes: (u32, u32),
+    pub periods: (u32, u32),
+    pub buffer_bytes_max: u32,
+    /// Period and buffer sizes in bytes must be multiples of this.
+    pub byte_step: u32,
+    /// The bits of a sample the converter uses (24 of a 32-bit sample).
+    pub msbits: u32,
+}
+
+/// The rules between parameters: (target, how, dependencies).
+#[derive(Clone, Copy)]
+enum Rule {
+    Mul(usize, usize, usize),
+    Div(usize, usize, usize),
+    MulDivK(usize, usize, usize, u32),
+    MulKDiv(usize, usize, u32, usize),
+}
+
+const RULES: [Rule; 18] = {
+    use param::*;
+    [
+        Rule::Div(SAMPLE_BITS, FRAME_BITS, CHANNELS),
+        Rule::Mul(FRAME_BITS, SAMPLE_BITS, CHANNELS),
+        Rule::MulKDiv(FRAME_BITS, PERIOD_BYTES, 8, PERIOD_SIZE),
+        Rule::MulKDiv(FRAME_BITS, BUFFER_BYTES, 8, BUFFER_SIZE),
+        Rule::Div(CHANNELS, FRAME_BITS, SAMPLE_BITS),
+        Rule::MulKDiv(RATE, PERIOD_SIZE, 1_000_000, PERIOD_TIME),
+        Rule::MulKDiv(RATE, BUFFER_SIZE, 1_000_000, BUFFER_TIME),
+        Rule::Div(PERIODS, BUFFER_SIZE, PERIOD_SIZE),
+        Rule::Div(PERIOD_SIZE, BUFFER_SIZE, PERIODS),
+        Rule::MulKDiv(PERIOD_SIZE, PERIOD_BYTES, 8, FRAME_BITS),
+        Rule::MulDivK(PERIOD_SIZE, PERIOD_TIME, RATE, 1_000_000),
+        Rule::Mul(BUFFER_SIZE, PERIOD_SIZE, PERIODS),
+        Rule::MulKDiv(BUFFER_SIZE, BUFFER_BYTES, 8, FRAME_BITS),
+        Rule::MulDivK(BUFFER_SIZE, BUFFER_TIME, RATE, 1_000_000),
+        Rule::MulDivK(PERIOD_BYTES, PERIOD_SIZE, FRAME_BITS, 8),
+        Rule::MulKDiv(PERIOD_TIME, PERIOD_SIZE, 1_000_000, RATE),
+        Rule::MulDivK(BUFFER_BYTES, BUFFER_SIZE, FRAME_BITS, 8),
+        Rule::MulKDiv(BUFFER_TIME, BUFFER_SIZE, 1_000_000, RATE),
+    ]
+};
+
+/// The parameter space the hardware allows, before any rule.
+fn constraints(limits: &HwLimits) -> HwParams {
+    use param::*;
+    let mut c = HwParams::any();
+    let mut access = alloc::vec::Vec::new();
+    access.push(access::RW_INTERLEAVED);
+    if limits.info & info::MMAP != 0 {
+        access.push(access::MMAP_INTERLEAVED);
+    }
+    c.masks[ACCESS] = Mask::of(&access);
+    c.masks[FORMAT] = limits.formats;
+    c.masks[SUBFORMAT] = Mask::of(&[SUBFORMAT_STD]);
+    for p in [CHANNELS, BUFFER_SIZE, BUFFER_BYTES, SAMPLE_BITS, FRAME_BITS] {
+        c.interval_mut(p).integer = true;
+    }
+    *c.interval_mut(CHANNELS) = Interval::integer_range(limits.channels.0, limits.channels.1);
+    let (rate_min, rate_max) = (limits.rates.iter().copied().min().unwrap_or(0), limits.rates.iter().copied().max().unwrap_or(0));
+    *c.interval_mut(RATE) = Interval::range(rate_min, rate_max);
+    *c.interval_mut(PERIOD_BYTES) = Interval::range(limits.period_bytes.0, limits.period_bytes.1);
+    *c.interval_mut(PERIODS) = Interval::integer_range(limits.periods.0, limits.periods.1);
+    *c.interval_mut(BUFFER_BYTES) = Interval::integer_range(limits.period_bytes.0, limits.buffer_bytes_max);
+    c
+}
+
+pub mod info {
+    pub const MMAP: u32 = 0x0000_0001;
+    pub const MMAP_VALID: u32 = 0x0000_0002;
+    pub const DOUBLE: u32 = 0x0000_0004;
+    pub const BATCH: u32 = 0x0000_0010;
+    pub const INTERLEAVED: u32 = 0x0000_0100;
+    pub const BLOCK_TRANSFER: u32 = 0x0001_0000;
+    pub const OVERRANGE: u32 = 0x0002_0000;
+    pub const RESUME: u32 = 0x0004_0000;
+    pub const PAUSE: u32 = 0x0008_0000;
+    pub const HALF_DUPLEX: u32 = 0x0010_0000;
+    pub const JOINT_DUPLEX: u32 = 0x0020_0000;
+    pub const SYNC_START: u32 = 0x0040_0000;
+    pub const NO_PERIOD_WAKEUP: u32 = 0x0080_0000;
+    pub const FIFO_IN_FRAMES: u32 = 0x8000_0000;
+}
+
+fn apply_rule(params: &mut HwParams, rule: Rule) -> Result<bool, ()> {
+    let i = |p: usize| *params.interval(p);
+    let (target, value) = match rule {
+        Rule::Mul(t, a, b) => (t, Interval::mul(&i(a), &i(b))),
+        Rule::Div(t, a, b) => (t, Interval::div(&i(a), &i(b))),
+        Rule::MulDivK(t, a, b, k) => (t, Interval::muldivk(&i(a), &i(b), k)),
+        Rule::MulKDiv(t, a, k, b) => (t, Interval::mulkdiv(&i(a), k, &i(b))),
+    };
+    params.interval_mut(target).refine(&value)
+}
+
+/// The formats of `mask` whose width is in `bits`, and the widths of the
+/// formats left.
+fn rule_formats(params: &mut HwParams) -> Result<bool, ()> {
+    let bits = *params.interval(param::SAMPLE_BITS);
+    let mut changed = false;
+    let mut formats = params.masks[param::FORMAT];
+    for format in 0..256 {
+        if !formats.test(format) {
+            continue;
+        }
+        let fits = format::physical_width(format).is_some_and(|width| {
+            let above = if bits.openmin { width > bits.min } else { width >= bits.min };
+            let below = if bits.openmax { width < bits.max } else { width <= bits.max };
+            above && below
+        });
+        if !fits {
+            formats.reset(format);
+            changed = true;
+        }
+    }
+    if formats.is_empty() {
+        return Err(());
+    }
+    params.masks[param::FORMAT] = formats;
+    let widths: alloc::vec::Vec<u32> = (0..256).filter(|&f| formats.test(f)).filter_map(format::physical_width).collect();
+    let (min, max) = (widths.iter().copied().min().unwrap_or(0), widths.iter().copied().max().unwrap_or(0));
+    Ok(params.interval_mut(param::SAMPLE_BITS).refine(&Interval::integer_range(min, max))? || changed)
+}
+
+/// Narrows `params` to what the hardware allows and the rules imply
+/// (`SNDRV_PCM_IOCTL_HW_REFINE`). An empty parameter: `Err`.
+pub fn refine(params: &mut HwParams, limits: &HwLimits) -> Result<(), ()> {
+    let c = constraints(limits);
+    let mut changed = 0u32;
+    for p in 0..3 {
+        if params.rmask & (1 << p) != 0 && params.masks[p].refine(&c.masks[p])? {
+            changed |= 1 << p;
+        }
+    }
+    for p in param::FIRST_INTERVAL..=param::TICK_TIME {
+        if params.rmask & (1 << p) != 0 && params.interval_mut(p).refine(c.interval(p))? {
+            changed |= 1 << p;
+        }
+    }
+    // The rates the hardware has, and the byte step of its DMA.
+    let rates = params.interval(param::RATE).of_list(&limits.rates);
+    if params.interval_mut(param::RATE).refine(&rates)? {
+        changed |= 1 << param::RATE;
+    }
+    for p in [param::PERIOD_BYTES, param::BUFFER_BYTES] {
+        let stepped = params.interval(p).step(limits.byte_step);
+        if params.interval_mut(p).refine(&stepped)? {
+            changed |= 1 << p;
+        }
+    }
+    // The rules, until nothing changes.
+    for _ in 0..64 {
+        let mut again = false;
+        if rule_formats(params)? {
+            changed |= 1 << param::FORMAT | 1 << param::SAMPLE_BITS;
+            again = true;
+        }
+        for rule in RULES {
+            let target = match rule {
+                Rule::Mul(t, ..) | Rule::Div(t, ..) | Rule::MulDivK(t, ..) | Rule::MulKDiv(t, ..) => t,
+            };
+            if apply_rule(params, rule)? {
+                changed |= 1 << target;
+                again = true;
+            }
+        }
+        for p in [param::PERIOD_BYTES, param::BUFFER_BYTES] {
+            let stepped = params.interval(p).step(limits.byte_step);
+            if params.interval_mut(p).refine(&stepped)? {
+                changed |= 1 << p;
+                again = true;
+            }
+        }
+        if !again {
+            break;
+        }
+    }
+    params.cmask = changed;
+    params.rmask = 0;
+    params.info = limits.info;
+    if params.msbits == 0 && params.interval(param::SAMPLE_BITS).is_single() {
+        let bits = params.get(param::SAMPLE_BITS);
+        params.msbits = if bits > limits.msbits && limits.msbits != 0 { limits.msbits } else { bits };
+    }
+    if params.rate_den == 0 && params.interval(param::RATE).is_single() {
+        params.rate_num = params.get(param::RATE);
+        params.rate_den = 1;
+    }
+    Ok(())
+}
+
+/// Makes every parameter single, as `snd_pcm_hw_params` does: the first
+/// access, format and subformat, the smallest value of each interval but
+/// the buffer size, the largest of that; refining after each choice.
+pub fn choose(params: &mut HwParams, limits: &HwLimits) -> Result<(), ()> {
+    use param::*;
+    params.rmask = u32::MAX;
+    refine(params, limits)?;
+    for p in [ACCESS, FORMAT, SUBFORMAT] {
+        if params.masks[p].choose_first() {
+            params.rmask = u32::MAX;
+            refine(params, limits)?;
+        }
+    }
+    for p in [CHANNELS, RATE, PERIOD_TIME, PERIOD_SIZE, PERIOD_BYTES, PERIODS, BUFFER_TIME, BUFFER_SIZE, BUFFER_BYTES, TICK_TIME] {
+        let interval = params.interval_mut(p);
+        let changed = if p == BUFFER_SIZE { interval.refine_last() } else { interval.refine_first() };
+        if changed {
+            params.rmask = u32::MAX;
+            refine(params, limits)?;
+        }
+    }
+    Ok(())
+}
+
+/// The boundary pointers wrap at: the buffer size doubled while it stays
+/// well inside a signed 64-bit number (Linux's `snd_pcm_hw_params`).
+pub fn boundary(buffer_size: u64) -> u64 {
+    let mut boundary = buffer_size.max(1);
+    while boundary * 2 <= (i64::MAX as u64) - buffer_size {
+        boundary *= 2;
+    }
+    boundary
+}
diff --git a/kernel/comps/sound/src/pcm.rs b/kernel/comps/sound/src/pcm.rs
new file mode 100755
index 0000000..c4f205f
--- /dev/null
+++ b/kernel/comps/sound/src/pcm.rs
@@ -0,0 +1,791 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! A PCM stream as ALSA's core keeps it (`snd_pcm_runtime`): its state, its
+//! parameters, its buffer, the hardware's position in it and the
+//! application's, the status and control pages applications map (alsa-lib
+//! reads the hardware pointer from one and writes its own pointer into the
+//! other), underruns and overruns, draining, pausing. The hardware itself is
+//! behind [`StreamHw`].
+//!
+//! Reference: Linux's `sound/core/pcm_native.c`, `pcm_lib.c`.
+
+use alloc::{boxed::Box, string::String, sync::Arc};
+use core::{
+    sync::atomic::{AtomicBool, AtomicU64, AtomicUsize, Ordering},
+    time::Duration,
+};
+
+use ostd::{
+    mm::{FrameAllocOptions, HasDaddr, HasSize, PAGE_SIZE, UFrame, USegment, VmIo, dma::DmaStream},
+    sync::{LocalIrqDisabled, SpinLock, WaitQueue},
+};
+
+use crate::params::{self, HwLimits, HwParams, param};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Direction {
+    Playback,
+    Capture,
+}
+
+/// `SNDRV_PCM_STATE_*`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(i32)]
+pub enum State {
+    Open = 0,
+    Setup = 1,
+    Prepared = 2,
+    Running = 3,
+    Xrun = 4,
+    Draining = 5,
+    Paused = 6,
+    Suspended = 7,
+    Disconnected = 8,
+}
+
+/// What a request can fail with; the device files turn it into an errno.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PcmError {
+    /// The stream is not in a state for it (EBADFD).
+    BadState,
+    /// An underrun or overrun (EPIPE).
+    Xrun,
+    /// Nothing can be done without waiting (EAGAIN).
+    WouldBlock,
+    Invalid,
+    NoMemory,
+    Busy,
+    Io,
+}
+
+pub type Result<T> = core::result::Result<T, PcmError>;
+
+/// The parameters a stream was set up with.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Setup {
+    pub access: u32,
+    pub format: u32,
+    pub channels: u32,
+    pub rate: u32,
+    pub sample_bits: u32,
+    pub frame_bytes: usize,
+    pub period_size: u64,
+    pub periods: u32,
+    pub buffer_size: u64,
+    pub boundary: u64,
+}
+
+impl Setup {
+    pub fn buffer_bytes(&self) -> usize {
+        self.buffer_size as usize * self.frame_bytes
+    }
+
+    pub fn period_bytes(&self) -> usize {
+        self.period_size as usize * self.frame_bytes
+    }
+}
+
+/// `struct snd_pcm_sw_params`'s values.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct SwParams {
+    pub tstamp_mode: i32,
+    pub period_step: u32,
+    pub sleep_min: u32,
+    pub avail_min: u64,
+    pub xfer_align: u64,
+    pub start_threshold: u64,
+    pub stop_threshold: u64,
+    pub silence_threshold: u64,
+    pub silence_size: u64,
+    pub boundary: u64,
+    pub proto: u32,
+    pub tstamp_type: u32,
+}
+
+/// The hardware side of a stream.
+pub trait StreamHw: Send + Sync {
+    /// Sets the stream up to run over a buffer at `buffer`, in periods.
+    fn prepare(&self, setup: &Setup, buffer: u64) -> Result<()>;
+    fn start(&self);
+    fn stop(&self);
+    /// Where in the buffer the hardware is, in bytes.
+    fn position(&self) -> usize;
+    /// The stream is let go (closed, or set up anew).
+    fn release(&self);
+    /// Its registers, for a stall's report.
+    fn describe(&self) -> String {
+        String::new()
+    }
+}
+
+/// A stream's buffer: frames applications may map, and their DMA mapping.
+pub struct Buffer {
+    pub frames: USegment,
+    pub dma: DmaStream,
+}
+
+/// Where the status and control pages keep each field.
+mod page {
+    pub(super) const STATE: usize = 0;
+    pub(super) const HW_PTR: usize = 8;
+    pub(super) const TSTAMP: usize = 16;
+    pub(super) const SUSPENDED_STATE: usize = 32;
+    pub(super) const AUDIO_TSTAMP: usize = 40;
+    pub(super) const APPL_PTR: usize = 0;
+    pub(super) const AVAIL_MIN: usize = 8;
+}
+
+/// What `SNDRV_PCM_IOCTL_STATUS` reports.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Status {
+    pub state: i32,
+    pub trigger: Duration,
+    pub now: Duration,
+    pub appl_ptr: u64,
+    pub hw_ptr: u64,
+    pub delay: i64,
+    pub avail: u64,
+    pub avail_max: u64,
+}
+
+struct Runtime {
+    state: State,
+    setup: Option<Setup>,
+    sw: SwParams,
+    hw_ptr: u64,
+    /// The hardware's last position, in bytes.
+    last_position: usize,
+    buffer: Option<Arc<Buffer>>,
+    avail_max: u64,
+    trigger: Duration,
+    /// The state before a pause.
+    paused_from: State,
+    /// Frames played (or recorded) since the last whole period.
+    partial: u64,
+}
+
+pub struct Pcm {
+    pub direction: Direction,
+    pub limits: HwLimits,
+    pub id: String,
+    pub name: String,
+    hw: Box<dyn StreamHw>,
+    runtime: SpinLock<Runtime, LocalIrqDisabled>,
+    status_page: UFrame,
+    control_page: UFrame,
+    /// Waits for room (playback) or data (capture), and for a state change.
+    pub wait: WaitQueue,
+    opened: AtomicBool,
+    /// Mappings of its buffer that applications hold.
+    mapped: AtomicUsize,
+    /// Periods completed, ever: its timer's ticks.
+    periods: AtomicU64,
+}
+
+fn now() -> Duration {
+    ostd::timer::Jiffies::elapsed().as_duration()
+}
+
+fn page() -> Option<UFrame> {
+    Some(FrameAllocOptions::new().zeroed(true).alloc_frame().ok()?.into())
+}
+
+impl Pcm {
+    pub fn new(direction: Direction, limits: HwLimits, id: String, name: String, hw: Box<dyn StreamHw>) -> Option<Arc<Self>> {
+        Some(Arc::new(Self {
+            direction,
+            limits,
+            id,
+            name,
+            hw,
+            runtime: SpinLock::new(Runtime {
+                state: State::Open,
+                setup: None,
+                sw: SwParams::default(),
+                hw_ptr: 0,
+                last_position: 0,
+                buffer: None,
+                avail_max: 0,
+                trigger: Duration::ZERO,
+                paused_from: State::Running,
+                partial: 0,
+            }),
+            status_page: page()?,
+            control_page: page()?,
+            wait: WaitQueue::new(),
+            opened: AtomicBool::new(false),
+            mapped: AtomicUsize::new(0),
+            periods: AtomicU64::new(0),
+        }))
+    }
+
+    /// Periods the stream completed, ever (its timer ticks with each).
+    pub fn periods_elapsed(&self) -> u64 {
+        self.periods.load(Ordering::Acquire)
+    }
+
+    pub fn status_page(&self) -> &UFrame {
+        &self.status_page
+    }
+
+    pub fn control_page(&self) -> &UFrame {
+        &self.control_page
+    }
+
+    pub fn appl_ptr(&self) -> u64 {
+        self.control_page.read_val::<u64>(page::APPL_PTR).unwrap_or(0)
+    }
+
+    fn set_appl_ptr(&self, value: u64) {
+        let _ = self.control_page.write_val(page::APPL_PTR, &value);
+    }
+
+    pub fn avail_min(&self) -> u64 {
+        self.control_page.read_val::<u64>(page::AVAIL_MIN).unwrap_or(1).max(1)
+    }
+
+    pub fn set_avail_min(&self, value: u64) {
+        let _ = self.control_page.write_val(page::AVAIL_MIN, &value.max(1));
+    }
+
+    /// The status page, as the runtime is.
+    fn publish(&self, runtime: &Runtime) {
+        let stamp = now();
+        let _ = self.status_page.write_val(page::STATE, &(runtime.state as i32));
+        let _ = self.status_page.write_val(page::HW_PTR, &runtime.hw_ptr);
+        let _ = self.status_page.write_val(page::TSTAMP, &(stamp.as_secs() as i64));
+        let _ = self.status_page.write_val(page::TSTAMP + 8, &i64::from(stamp.subsec_nanos()));
+        let _ = self.status_page.write_val(page::SUSPENDED_STATE, &0i32);
+        let _ = self.status_page.write_val(page::AUDIO_TSTAMP, &0i64);
+    }
+
+    // ── Opening and closing ──────────────────────────────────────────────
+
+    pub fn open(&self) -> Result<()> {
+        if self.opened.swap(true, Ordering::AcqRel) {
+            return Err(PcmError::Busy);
+        }
+        let mut runtime = self.runtime.lock();
+        runtime.state = State::Open;
+        runtime.setup = None;
+        runtime.buffer = None;
+        self.set_appl_ptr(0);
+        self.set_avail_min(1);
+        self.publish(&runtime);
+        Ok(())
+    }
+
+    pub fn close(&self) {
+        let buffer = {
+            let mut runtime = self.runtime.lock();
+            if matches!(runtime.state, State::Running | State::Draining | State::Paused) {
+                self.hw.stop();
+            }
+            runtime.state = State::Open;
+            runtime.setup = None;
+            self.publish(&runtime);
+            runtime.buffer.take()
+        };
+        self.hw.release();
+        drop(buffer);
+        self.opened.store(false, Ordering::Release);
+        self.wait.wake_all();
+        crate::note_activity();
+    }
+
+    pub fn state(&self) -> State {
+        self.runtime.lock().state
+    }
+
+    pub fn setup(&self) -> Option<Setup> {
+        self.runtime.lock().setup
+    }
+
+    pub fn buffer(&self) -> Option<Arc<Buffer>> {
+        self.runtime.lock().buffer.clone()
+    }
+
+    pub fn note_mapped(&self, mapped: bool) {
+        if mapped {
+            self.mapped.fetch_add(1, Ordering::AcqRel);
+        } else {
+            self.mapped.fetch_sub(1, Ordering::AcqRel);
+        }
+    }
+
+    // ── Parameters ───────────────────────────────────────────────────────
+
+    pub fn hw_refine(&self, params: &mut HwParams) -> Result<()> {
+        params::refine(params, &self.limits).map_err(|()| PcmError::Invalid)
+    }
+
+    pub fn hw_params(&self, params: &mut HwParams) -> Result<Setup> {
+        if matches!(self.state(), State::Running | State::Draining | State::Paused | State::Xrun) {
+            return Err(PcmError::BadState);
+        }
+        params::choose(params, &self.limits).map_err(|()| PcmError::Invalid)?;
+        let format = params.format().ok_or(PcmError::Invalid)?;
+        let access = params.access().ok_or(PcmError::Invalid)?;
+        let frame_bits = params.get(param::FRAME_BITS);
+        let buffer_size = u64::from(params.get(param::BUFFER_SIZE));
+        let setup = Setup {
+            access,
+            format,
+            channels: params.get(param::CHANNELS),
+            rate: params.get(param::RATE),
+            sample_bits: params.get(param::SAMPLE_BITS),
+            frame_bytes: (frame_bits / 8) as usize,
+            period_size: u64::from(params.get(param::PERIOD_SIZE)),
+            periods: params.get(param::PERIODS),
+            buffer_size,
+            boundary: params::boundary(buffer_size),
+        };
+        if setup.frame_bytes == 0 || setup.period_size == 0 || setup.periods == 0 {
+            return Err(PcmError::Invalid);
+        }
+        // A new buffer, unless one is mapped (it cannot change then).
+        let pages = setup.buffer_bytes().div_ceil(PAGE_SIZE);
+        let reuse = self.runtime.lock().buffer.as_ref().filter(|buffer| buffer.frames.size() / PAGE_SIZE == pages).cloned();
+        let buffer = match reuse {
+            Some(buffer) => buffer,
+            None => {
+                if self.mapped.load(Ordering::Acquire) > 0 {
+                    return Err(PcmError::BadState);
+                }
+                let segment = FrameAllocOptions::new().zeroed(true).alloc_segment(pages).map_err(|_| PcmError::NoMemory)?;
+                let frames: USegment = segment.into();
+                let dma = DmaStream::map(frames.clone(), true).map_err(|_| PcmError::NoMemory)?;
+                Arc::new(Buffer { frames, dma })
+            }
+        };
+        let mut runtime = self.runtime.lock();
+        runtime.setup = Some(setup);
+        runtime.buffer = Some(buffer);
+        runtime.sw = SwParams {
+            avail_min: setup.period_size,
+            start_threshold: 1,
+            stop_threshold: setup.buffer_size,
+            boundary: setup.boundary,
+            ..SwParams::default()
+        };
+        runtime.state = State::Setup;
+        runtime.hw_ptr = 0;
+        self.set_appl_ptr(0);
+        self.set_avail_min(setup.period_size);
+        self.publish(&runtime);
+        Ok(setup)
+    }
+
+    pub fn hw_free(&self) -> Result<()> {
+        let buffer = {
+            let mut runtime = self.runtime.lock();
+            if matches!(runtime.state, State::Running | State::Draining | State::Paused) {
+                return Err(PcmError::BadState);
+            }
+            if self.mapped.load(Ordering::Acquire) > 0 {
+                return Err(PcmError::BadState);
+            }
+            runtime.state = State::Open;
+            runtime.setup = None;
+            self.publish(&runtime);
+            runtime.buffer.take()
+        };
+        self.hw.release();
+        drop(buffer);
+        Ok(())
+    }
+
+    pub fn sw_params(&self, sw: &mut SwParams) -> Result<()> {
+        let mut runtime = self.runtime.lock();
+        let setup = runtime.setup.ok_or(PcmError::BadState)?;
+        if sw.avail_min == 0 || sw.silence_size > setup.boundary {
+            return Err(PcmError::Invalid);
+        }
+        sw.boundary = setup.boundary;
+        runtime.sw = *sw;
+        self.set_avail_min(sw.avail_min);
+        drop(runtime);
+        self.update();
+        Ok(())
+    }
+
+    // ── Running ──────────────────────────────────────────────────────────
+
+    /// Frames the application may transfer now: room to write (playback) or
+    /// data to read (capture).
+    fn avail_of(&self, runtime: &Runtime) -> u64 {
+        let Some(setup) = runtime.setup else { return 0 };
+        let (hw, appl, boundary) = (runtime.hw_ptr as i128, self.appl_ptr() as i128, setup.boundary as i128);
+        let mut avail = match self.direction {
+            Direction::Playback => hw + setup.buffer_size as i128 - appl,
+            Direction::Capture => hw - appl,
+        };
+        if avail < 0 {
+            avail += boundary;
+        } else if avail >= boundary {
+            avail -= boundary;
+        }
+        avail.max(0) as u64
+    }
+
+    pub fn prepare(&self) -> Result<()> {
+        let (setup, buffer) = {
+            let runtime = self.runtime.lock();
+            match runtime.state {
+                State::Open | State::Disconnected => return Err(PcmError::BadState),
+                State::Running | State::Draining | State::Paused => self.hw.stop(),
+                _ => {}
+            }
+            (runtime.setup.ok_or(PcmError::BadState)?, runtime.buffer.clone().ok_or(PcmError::BadState)?)
+        };
+        // Silence to start from (what a short write leaves is not noise).
+        let silence = alloc::vec![0u8; PAGE_SIZE];
+        let mut offset = 0;
+        while offset < buffer.frames.size() {
+            let _ = buffer.frames.write_bytes(offset, &silence);
+            offset += PAGE_SIZE;
+        }
+        self.hw.prepare(&setup, buffer.dma.daddr() as u64)?;
+        let mut runtime = self.runtime.lock();
+        runtime.hw_ptr = 0;
+        runtime.last_position = 0;
+        runtime.avail_max = 0;
+        runtime.partial = 0;
+        runtime.state = State::Prepared;
+        self.set_appl_ptr(0);
+        self.publish(&runtime);
+        Ok(())
+    }
+
+    fn start_locked(&self, runtime: &mut Runtime) -> Result<()> {
+        if runtime.state != State::Prepared {
+            return Err(PcmError::BadState);
+        }
+        runtime.last_position = 0;
+        self.hw.start();
+        runtime.state = State::Running;
+        runtime.trigger = now();
+        crate::note_running(true);
+        self.publish(runtime);
+        Ok(())
+    }
+
+    pub fn start(&self) -> Result<()> {
+        let mut runtime = self.runtime.lock();
+        // Playback with nothing written would underrun at once.
+        if self.direction == Direction::Playback && self.avail_of(&runtime) >= runtime.setup.map_or(0, |s| s.buffer_size) {
+            return Err(PcmError::Xrun);
+        }
+        self.start_locked(&mut runtime)
+    }
+
+    fn stop_locked(&self, runtime: &mut Runtime, state: State) {
+        if matches!(runtime.state, State::Running | State::Draining) {
+            self.hw.stop();
+            crate::note_running(false);
+        }
+        runtime.state = state;
+        runtime.trigger = now();
+        self.publish(runtime);
+    }
+
+    /// Stops at once, dropping what is pending.
+    pub fn drop_(&self) -> Result<()> {
+        let mut runtime = self.runtime.lock();
+        if matches!(runtime.state, State::Open | State::Disconnected) {
+            return Err(PcmError::BadState);
+        }
+        if runtime.state == State::Paused {
+            crate::note_running(true);
+            runtime.state = State::Running;
+        }
+        self.stop_locked(&mut runtime, State::Setup);
+        drop(runtime);
+        self.wait.wake_all();
+        crate::note_activity();
+        Ok(())
+    }
+
+    /// Starts draining: playback plays what was written, then stops.
+    /// Returns whether it is done already.
+    pub fn drain_begin(&self) -> Result<bool> {
+        let mut runtime = self.runtime.lock();
+        match runtime.state {
+            State::Open | State::Disconnected => Err(PcmError::BadState),
+            State::Setup | State::Xrun => {
+                runtime.state = State::Setup;
+                self.publish(&runtime);
+                Ok(true)
+            }
+            State::Prepared if self.direction == Direction::Playback => {
+                // Written but not started: play it.
+                if self.avail_of(&runtime) >= runtime.setup.map_or(0, |s| s.buffer_size) {
+                    runtime.state = State::Setup;
+                    self.publish(&runtime);
+                    return Ok(true);
+                }
+                self.start_locked(&mut runtime)?;
+                runtime.state = State::Draining;
+                self.publish(&runtime);
+                Ok(false)
+            }
+            State::Running | State::Paused if self.direction == Direction::Playback => {
+                if runtime.state == State::Paused {
+                    self.hw.start();
+                    crate::note_running(true);
+                }
+                runtime.state = State::Draining;
+                self.publish(&runtime);
+                Ok(false)
+            }
+            State::Draining => Ok(false),
+            // Capture: what was captured stays to be read.
+            _ => {
+                self.stop_locked(&mut runtime, State::Setup);
+                Ok(true)
+            }
+        }
+    }
+
+    pub fn pause(&self, on: bool) -> Result<()> {
+        let mut runtime = self.runtime.lock();
+        match (runtime.state, on) {
+            (State::Running, true) => {
+                self.hw.stop();
+                crate::note_running(false);
+                runtime.paused_from = State::Running;
+                runtime.state = State::Paused;
+            }
+            (State::Paused, false) => {
+                self.hw.start();
+                crate::note_running(true);
+                runtime.state = runtime.paused_from;
+            }
+            _ => return Err(PcmError::BadState),
+        }
+        runtime.trigger = now();
+        self.publish(&runtime);
+        Ok(())
+    }
+
+    /// Takes back up to `frames` the application gave (playback: written
+    /// but not yet played; capture: recorded but not yet read): its pointer
+    /// moves back. Returns how many (Linux's `snd_pcm_rewind`).
+    pub fn rewind(&self, frames: u64) -> Result<u64> {
+        self.update();
+        let runtime = self.runtime.lock();
+        let setup = runtime.setup.ok_or(PcmError::BadState)?;
+        match runtime.state {
+            State::Prepared | State::Running | State::Paused | State::Draining => {}
+            State::Xrun => return Err(PcmError::Xrun),
+            _ => return Err(PcmError::BadState),
+        }
+        let avail = self.avail_of(&runtime);
+        let rewindable = match self.direction {
+            Direction::Playback => setup.buffer_size.saturating_sub(avail),
+            Direction::Capture => avail,
+        };
+        let count = frames.min(rewindable);
+        let appl = (self.appl_ptr() + setup.boundary - count) % setup.boundary;
+        self.set_appl_ptr(appl);
+        Ok(count)
+    }
+
+    /// Skips up to `frames` ahead (playback: room left unwritten; capture:
+    /// recorded frames left unread). Returns how many.
+    pub fn forward(&self, frames: u64) -> Result<u64> {
+        self.update();
+        let runtime = self.runtime.lock();
+        let setup = runtime.setup.ok_or(PcmError::BadState)?;
+        match runtime.state {
+            State::Prepared | State::Running | State::Paused | State::Draining => {}
+            State::Xrun => return Err(PcmError::Xrun),
+            _ => return Err(PcmError::BadState),
+        }
+        let count = frames.min(self.avail_of(&runtime));
+        self.set_appl_ptr((self.appl_ptr() + count) % setup.boundary);
+        Ok(count)
+    }
+
+    pub fn reset(&self) -> Result<()> {
+        let runtime = self.runtime.lock();
+        if !matches!(runtime.state, State::Prepared | State::Running | State::Paused) {
+            return Err(PcmError::BadState);
+        }
+        self.set_appl_ptr(runtime.hw_ptr);
+        Ok(())
+    }
+
+    /// Takes the hardware's position: the hardware pointer moves on; an
+    /// underrun or overrun stops the stream; draining ends; waiters wake.
+    pub fn update(&self) {
+        let mut wake = false;
+        {
+            let mut runtime = self.runtime.lock();
+            let Some(setup) = runtime.setup else { return };
+            if !matches!(runtime.state, State::Running | State::Draining) {
+                return;
+            }
+            let bytes = setup.buffer_bytes();
+            let position = self.hw.position() % bytes.max(1);
+            let moved = (position + bytes - runtime.last_position) % bytes;
+            let frames = (moved / setup.frame_bytes) as u64;
+            if frames > 0 {
+                runtime.last_position = (runtime.last_position + frames as usize * setup.frame_bytes) % bytes;
+                runtime.hw_ptr = (runtime.hw_ptr + frames) % setup.boundary;
+                // Whole periods: the timer ticks, period waiters wake.
+                runtime.partial += frames;
+                let periods = runtime.partial / setup.period_size;
+                if periods > 0 {
+                    runtime.partial %= setup.period_size;
+                    self.periods.fetch_add(periods, Ordering::AcqRel);
+                    wake = true;
+                }
+            }
+            let avail = self.avail_of(&runtime);
+            runtime.avail_max = runtime.avail_max.max(avail);
+            if runtime.state == State::Draining && avail >= setup.buffer_size {
+                self.stop_locked(&mut runtime, State::Setup);
+                wake = true;
+            } else if avail >= runtime.sw.stop_threshold.max(1) && runtime.sw.stop_threshold < setup.boundary {
+                self.stop_locked(&mut runtime, State::Xrun);
+                wake = true;
+            } else {
+                self.publish(&runtime);
+                if frames > 0 && avail >= self.avail_min() {
+                    wake = true;
+                }
+            }
+        }
+        if wake {
+            self.wait.wake_all();
+            crate::note_activity();
+        }
+    }
+
+    pub fn avail(&self) -> u64 {
+        self.update();
+        let runtime = self.runtime.lock();
+        self.avail_of(&runtime)
+    }
+
+    pub fn status(&self) -> Status {
+        self.update();
+        let mut runtime = self.runtime.lock();
+        let avail = self.avail_of(&runtime);
+        let buffer_size = runtime.setup.map_or(0, |s| s.buffer_size);
+        let delay = match (self.direction, runtime.state) {
+            (_, State::Running | State::Draining | State::Paused) => match self.direction {
+                Direction::Playback => buffer_size as i64 - avail as i64,
+                Direction::Capture => avail as i64,
+            },
+            _ => 0,
+        };
+        let status = Status {
+            state: runtime.state as i32,
+            trigger: runtime.trigger,
+            now: now(),
+            appl_ptr: self.appl_ptr(),
+            hw_ptr: runtime.hw_ptr,
+            delay,
+            avail,
+            avail_max: runtime.avail_max.max(avail),
+        };
+        runtime.avail_max = 0;
+        status
+    }
+
+    /// The pointers for `SNDRV_PCM_IOCTL_SYNC_PTR`: the application's ones
+    /// taken (unless asked for), the hardware's given back.
+    pub fn sync_ptr(&self, hwsync: bool, appl_ptr: Option<u64>, avail_min: Option<u64>) -> (i32, u64, u64, u64) {
+        if let Some(setup) = self.setup() {
+            if let Some(appl_ptr) = appl_ptr {
+                self.set_appl_ptr(appl_ptr % setup.boundary);
+            }
+        }
+        if let Some(avail_min) = avail_min {
+            self.set_avail_min(avail_min);
+        }
+        if hwsync {
+            self.update();
+        }
+        let runtime = self.runtime.lock();
+        (runtime.state as i32, runtime.hw_ptr, self.appl_ptr(), self.avail_min())
+    }
+
+    // ── Transfers ────────────────────────────────────────────────────────
+
+    /// The part of the buffer the next transfer of at most `frames` uses:
+    /// (byte offset, frames), contiguous; none when there is no room or
+    /// data yet. An underrun or overrun, or a stream stopped: an error.
+    pub fn transfer_window(&self, frames: u64) -> Result<(usize, u64)> {
+        self.update();
+        let runtime = self.runtime.lock();
+        let setup = runtime.setup.ok_or(PcmError::BadState)?;
+        match runtime.state {
+            State::Xrun => return Err(PcmError::Xrun),
+            State::Prepared | State::Running | State::Paused => {}
+            State::Draining if self.direction == Direction::Capture => {}
+            _ => return Err(PcmError::BadState),
+        }
+        let avail = self.avail_of(&runtime);
+        let at = self.appl_ptr() % setup.buffer_size;
+        let contiguous = setup.buffer_size - at;
+        let count = frames.min(avail).min(contiguous);
+        Ok((at as usize * setup.frame_bytes, count))
+    }
+
+    /// The application moved `frames` on (written or read); playback starts
+    /// once enough is written, capture once a read asks.
+    pub fn commit(&self, frames: u64) -> Result<()> {
+        let mut runtime = self.runtime.lock();
+        let setup = runtime.setup.ok_or(PcmError::BadState)?;
+        self.set_appl_ptr((self.appl_ptr() + frames) % setup.boundary);
+        if runtime.state == State::Prepared && self.direction == Direction::Playback {
+            let written = setup.buffer_size - self.avail_of(&runtime).min(setup.buffer_size);
+            if written >= runtime.sw.start_threshold.max(1) {
+                self.start_locked(&mut runtime)?;
+            }
+        }
+        Ok(())
+    }
+
+    /// A read waits for data: capture starts when one is asked for.
+    pub fn start_capture_for(&self, frames: u64) -> Result<()> {
+        let mut runtime = self.runtime.lock();
+        if self.direction == Direction::Capture && runtime.state == State::Prepared && frames >= runtime.sw.start_threshold.max(1) {
+            self.start_locked(&mut runtime)?;
+        }
+        Ok(())
+    }
+
+    /// Whether a waiting transfer may go on: room or data enough, or the
+    /// stream no longer running.
+    pub fn ready(&self, wanted: u64) -> bool {
+        self.update();
+        let runtime = self.runtime.lock();
+        match runtime.state {
+            State::Prepared | State::Running | State::Draining | State::Paused => {
+                let avail = self.avail_of(&runtime);
+                avail >= wanted.min(self.avail_min()).max(1)
+                    || (runtime.state == State::Prepared && self.direction == Direction::Playback && avail > 0)
+            }
+            _ => true,
+        }
+    }
+
+    /// Whether a drain is over.
+    pub fn drained(&self) -> bool {
+        self.update();
+        !matches!(self.state(), State::Draining)
+    }
+
+    /// The hardware's state, for a stall's report.
+    pub fn describe(&self) -> String {
+        self.hw.describe()
+    }
+
+    pub fn is_running(&self) -> bool {
+        matches!(self.state(), State::Running | State::Draining)
+    }
+}
