+/// The UNIX sockets in flight of each user.
+///
+/// Reference: <https://elixir.bootlin.com/linux/v6.15/source/net/unix/af_unix.c#L1914>
+static INFLIGHT_SOCKETS: SpinLock<BTreeMap<u32, usize>> = SpinLock::new(BTreeMap::new());
+
+/// UNIX sockets that a user has sent and that no one has received yet.
+///
+/// Dropping the charge releases it, when the receiver takes the sockets or when the
+/// message is discarded.
+pub(super) struct InflightCharge {
+    uid: u32,
+    count: usize,
+}
+
+impl InflightCharge {
+    /// Charges the sockets to the current user.
+    ///
+    /// Fails with `ETOOMANYREFS` if the user would have more sockets in flight than its
+    /// `RLIMIT_NOFILE`, unless it has `CAP_SYS_RESOURCE` or `CAP_SYS_ADMIN`.
+    fn new(count: usize) -> Result<Option<Self>> {
+        if count == 0 {
+            return Ok(None);
+        }
+
+        let current = current_thread!();
+        let posix_thread = current.as_posix_thread().unwrap();
+        let uid = u32::from(posix_thread.credentials().ruid());
+        let limit = posix_thread
+            .process()
+            .resource_limits()
+            .get_rlimit(ResourceType::RLIMIT_NOFILE)
+            .get_cur();
+        let is_privileged = [CapSet::SYS_RESOURCE, CapSet::SYS_ADMIN].into_iter().any(|cap| {
+            lsm_hooks::on_capable(lsm_hooks::CapableContext::new(
+                UserNamespace::get_init_singleton().as_ref(),
+                posix_thread,
+                cap,
+            ))
+            .is_ok()
+        });
+
+        let mut inflight = INFLIGHT_SOCKETS.lock();
+        let charged = inflight.entry(uid).or_insert(0);
+        if !is_privileged && (*charged + count) as u64 > limit {
+            return_errno_with_message!(
+                Errno::ETOOMANYREFS,
+                "the user has too many UNIX sockets in flight"
+            );
+        }
+        *charged += count;
+
+        Ok(Some(Self { uid, count }))
+    }
+}
+
+impl Drop for InflightCharge {
+    fn drop(&mut self) {
+        let mut inflight = INFLIGHT_SOCKETS.lock();
+        if let Some(charged) = inflight.get_mut(&self.uid) {
+            *charged -= self.count;
+            if *charged == 0 {
+                inflight.remove(&self.uid);
+            }
+        }
+    }
 }
 
