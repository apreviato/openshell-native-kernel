+// SPDX-License-Identifier: MPL-2.0
+
+//! The backlight PWM of Intel graphics, as the firmware left it running.
+//!
+//! The layout depends on the chipset (PCH), which Linux's i915 tells from the
+//! ISA bridge's device ID (`intel_pch.c`), and the registers are those of
+//! `intel_backlight.c`:
+//!
+//! - Ibex Peak, Cougar Point, Panther Point (Ironlake to Ivy Bridge): the
+//!   period in the high half of `BLC_PWM_PCH_CTL2`, the duty cycle in the low
+//!   half of the CPU's `BLC_PWM_CPU_CTL`.
+//! - Lynx Point to Kaby Point (Haswell to Kaby Lake): period and duty cycle in
+//!   the halves of `BLC_PWM_PCH_CTL2`.
+//! - Cannon Point and later (Coffee Lake to today's), and Broxton and Gemini
+//!   Lake (Atom): a 32-bit period and duty cycle per PWM controller.
+
+use alloc::{sync::Arc, vec, vec::Vec};
+
+use aster_pci::{
+    PCI_BUS, PciDeviceId,
+    bus::{PciDevice, PciDriver},
+    cfg_space::{Bar, BarAccess},
+    common_device::PciCommonDevice,
+};
+use ostd::{
+    bus::BusProbeError,
+    sync::{LocalIrqDisabled, SpinLock},
+};
+
+use crate::Backlight;
+
+const INTEL: u16 = 0x8086;
+const CLASS_DISPLAY: u8 = 0x03;
+const CLASS_BRIDGE: u8 = 0x06;
+const SUBCLASS_ISA: u8 = 0x01;
+
+// South display engine registers (offsets in the GPU's MMIO BAR).
+const BLC_PWM_PCH_CTL1: usize = 0xC8250;
+const BLC_PWM_PCH_CTL2: usize = 0xC8254;
+const BLC_PWM_CPU_CTL: usize = 0x48254;
+const BXT_BLC_PWM_CTL: [usize; 2] = [0xC8250, 0xC8350];
+const BXT_BLC_PWM_FREQ: [usize; 2] = [0xC8254, 0xC8354];
+const BXT_BLC_PWM_DUTY: [usize; 2] = [0xC8258, 0xC8358];
+const PWM_ENABLE: u32 = 1 << 31;
+
+/// Where the duty cycle and the period are.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Layout {
+    /// Period in `BLC_PWM_PCH_CTL2[31:16]`, duty in `BLC_PWM_CPU_CTL[15:0]`.
+    Pch,
+    /// Period and duty in `BLC_PWM_PCH_CTL2[31:16]` and `[15:0]`.
+    Lpt,
+    /// A 32-bit period and duty cycle of PWM controller `n`.
+    Bxt(usize),
+}
+
+/// The chipset's layout, from the ISA bridge (i915's `intel_pch_type`).
+fn layout_of_pch(pch: u16) -> Option<Layout> {
+    let layout = match pch & 0xff80 {
+        // Ibex Peak, Cougar Point, Panther Point.
+        0x3b00 | 0x1c00 | 0x1e00 => Layout::Pch,
+        // Lynx Point, Wildcat Point, Sunrise Point, Kaby Point (and their LP).
+        0x8c00 | 0x9c00 | 0x8c80 | 0x9c80 | 0xa100 | 0x9d00 | 0xa280 => Layout::Lpt,
+        // Cannon Point, Comet Point, Ice Point, Jasper and Mule Creek, Tiger
+        // Point, Alder Point, Meteor Point and later.
+        0xa300 | 0x9d80 | 0x0280 | 0x0680 | 0xa380 | 0x3480 | 0x4d80 | 0x3880 | 0x4b00
+        | 0xa080 | 0x4380 | 0x7a80 | 0x5180 | 0x7a00 | 0x5480 | 0x7e00 | 0xae00 | 0x7700
+        | 0x7f00 | 0xa800 => Layout::Bxt(0),
+        _ => return None,
+    };
+    Some(layout)
+}
+
+/// Broxton and Gemini Lake (Atom laptops) have no PCH: their GPU tells.
+fn layout_of_gpu(gpu: u16) -> Option<Layout> {
+    matches!(gpu, 0x0a84 | 0x1a84 | 0x1a85 | 0x5a84 | 0x5a85 | 0x3184 | 0x3185).then_some(Layout::Bxt(0))
+}
+
+struct IntelBacklight {
+    mmio: BarAccess,
+    layout: Layout,
+    max: u32,
+    lock: SpinLock<(), LocalIrqDisabled>,
+    /// The GPU, kept with its mapped registers.
+    _gpu: PciCommonDevice,
+}
+
+impl IntelBacklight {
+    fn read(&self, offset: usize) -> u32 {
+        self.mmio.read_once::<u32>(offset).unwrap_or(0)
+    }
+
+    fn write(&self, offset: usize, value: u32) {
+        let _ = self.mmio.write_once::<u32>(offset, value);
+    }
+
+    /// The PWM as the firmware left it: its period and duty cycle, if it is on
+    /// and its values make sense.
+    fn probe(mmio: &BarAccess, layout: Layout) -> Option<(u32, u32)> {
+        let read = |offset: usize| mmio.read_once::<u32>(offset).ok();
+        let (enabled, period, duty) = match layout {
+            Layout::Pch => {
+                let ctl2 = read(BLC_PWM_PCH_CTL2)?;
+                (read(BLC_PWM_PCH_CTL1)? & PWM_ENABLE != 0, ctl2 >> 16, read(BLC_PWM_CPU_CTL)? & 0xffff)
+            }
+            Layout::Lpt => {
+                let ctl2 = read(BLC_PWM_PCH_CTL2)?;
+                (read(BLC_PWM_PCH_CTL1)? & PWM_ENABLE != 0, ctl2 >> 16, ctl2 & 0xffff)
+            }
+            Layout::Bxt(n) => (
+                read(BXT_BLC_PWM_CTL[n])? & PWM_ENABLE != 0,
+                read(BXT_BLC_PWM_FREQ[n])?,
+                read(BXT_BLC_PWM_DUTY[n])?,
+            ),
+        };
+        // An unpowered register reads as all ones.
+        let plausible = enabled && period >= 16 && period != u32::MAX && duty <= period;
+        plausible.then_some((period, duty))
+    }
+}
+
+impl Backlight for IntelBacklight {
+    fn max(&self) -> u32 {
+        self.max
+    }
+
+    fn get(&self) -> u32 {
+        match self.layout {
+            Layout::Pch => self.read(BLC_PWM_CPU_CTL) & 0xffff,
+            Layout::Lpt => self.read(BLC_PWM_PCH_CTL2) & 0xffff,
+            Layout::Bxt(n) => self.read(BXT_BLC_PWM_DUTY[n]),
+        }
+        .min(self.max)
+    }
+
+    fn set(&self, level: u32) {
+        let level = level.min(self.max);
+        let _guard = self.lock.lock();
+        match self.layout {
+            Layout::Pch => {
+                let ctl = self.read(BLC_PWM_CPU_CTL) & !0xffff;
+                self.write(BLC_PWM_CPU_CTL, ctl | level);
+            }
+            Layout::Lpt => {
+                let ctl2 = self.read(BLC_PWM_PCH_CTL2) & !0xffff;
+                self.write(BLC_PWM_PCH_CTL2, ctl2 | level);
+            }
+            Layout::Bxt(n) => self.write(BXT_BLC_PWM_DUTY[n], level),
+        }
+    }
+}
+
+#[derive(Debug)]
+struct Claimed(PciDeviceId);
+
+impl PciDevice for Claimed {
+    fn device_id(&self) -> PciDeviceId {
+        self.0
+    }
+}
+
+/// Keeps Intel's GPU and notes the chipset's ISA bridge, which it leaves alone.
+#[derive(Debug)]
+struct Driver {
+    gpus: SpinLock<Vec<PciCommonDevice>>,
+    pch: SpinLock<Option<u16>>,
+}
+
+impl Driver {
+    fn new() -> Self {
+        Self { gpus: SpinLock::new(Vec::new()), pch: SpinLock::new(None) }
+    }
+}
+
+impl PciDriver for Driver {
+    fn probe(&self, device: PciCommonDevice) -> Result<Arc<dyn PciDevice>, (BusProbeError, PciCommonDevice)> {
+        let id = *device.device_id();
+        if id.vendor_id != INTEL {
+            return Err((BusProbeError::DeviceNotMatch, device));
+        }
+        if id.class == CLASS_BRIDGE && id.subclass == SUBCLASS_ISA {
+            *self.pch.lock() = Some(id.device_id);
+            return Err((BusProbeError::DeviceNotMatch, device));
+        }
+        // The integrated GPU is on bus 0 (00:02.0); a discrete Intel GPU's
+        // backlight is not on this PWM.
+        if id.class != CLASS_DISPLAY || device.location().bus != 0 {
+            return Err((BusProbeError::DeviceNotMatch, device));
+        }
+        self.gpus.lock().push(device);
+        Ok(Arc::new(Claimed(id)))
+    }
+}
+
+pub(super) fn init() {
+    let driver = Arc::new(Driver::new());
+    PCI_BUS.lock().register_driver(driver.clone());
+    let pch = *driver.pch.lock();
+    for mut gpu in core::mem::take(&mut *driver.gpus.lock()) {
+        let gpu_id = gpu.device_id().device_id;
+        let Some(layout) = pch.and_then(layout_of_pch).or_else(|| layout_of_gpu(gpu_id)) else {
+            ostd::notice!("Intel GPU {:04x} with chipset {:04x?}: its backlight layout is unknown", gpu_id, pch);
+            continue;
+        };
+        let Some(Bar::Memory(_)) = gpu.bar_manager().bar(0) else { continue };
+        let Some(mmio) = gpu.bar_manager_mut().bar_mut(0).and_then(|bar| bar.acquire().ok()) else {
+            ostd::notice!("Intel GPU {:04x}: its registers cannot be mapped", gpu_id);
+            continue;
+        };
+        // The firmware may have used the second PWM controller.
+        let candidates = match layout {
+            Layout::Bxt(_) => vec![Layout::Bxt(0), Layout::Bxt(1)],
+            other => vec![other],
+        };
+        let Some((layout, (period, duty))) = candidates
+            .into_iter()
+            .find_map(|layout| IntelBacklight::probe(&mmio, layout).map(|values| (layout, values)))
+        else {
+            ostd::notice!("Intel GPU {:04x} with chipset {:04x?}: the firmware left no backlight PWM running", gpu_id, pch);
+            continue;
+        };
+        ostd::notice!(
+            "Intel GPU {:04x} with chipset {:04x?}: backlight {:?} at {} of {}",
+            gpu_id, pch, layout, duty, period
+        );
+        let backlight = IntelBacklight { mmio, layout, max: period, lock: SpinLock::new(()), _gpu: gpu };
+        crate::add("intel_backlight", Arc::new(backlight));
+        // One built-in screen.
+        break;
+    }
+}
