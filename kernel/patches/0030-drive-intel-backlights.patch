new file mode 100755
index 0000000..f2e1c46
--- /dev/null
+++ b/kernel/comps/backlight/src/lib.rs
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! The backlight of a laptop's built-in screen, as Linux's
+//! `/sys/class/backlight`.
+//!
+//! Without a GPU driver, the panel's backlight keeps what the firmware set.
+//! On Intel graphics (most laptops, and the built-in screen of most hybrid
+//! ones), the firmware leaves the backlight's PWM running in the south
+//! display engine, and its duty cycle is the brightness. This driver finds
+//! the PWM's layout from the chipset (PCH), as Linux's i915 does
+//! (`intel_backlight.c`), and offers `intel_backlight` with Linux's
+//! attributes: `brightness` (root may write it), `actual_brightness`,
+//! `max_brightness` and `type`. It refuses PWM values the firmware did not
+//! leave consistent, so that it never darkens a screen it does not understand.
+
+#![no_std]
+#![deny(unsafe_code)]
+#![cfg(target_arch = "x86_64")]
+
+extern crate alloc;
+
+// Set this crate's log prefix for `ostd::log`.
+macro_rules! __log_prefix {
+    () => {
+        "backlight: "
+    };
+}
+
+mod intel;
+
+use alloc::sync::Arc;
+use core::fmt::Write;
+
+use aster_device::{
+    class::{self, Class, ClassDevice, ClassHandle},
+    common::{Attr, Error},
+};
+use component::{ComponentInitError, init_component};
+use spin::Once;
+
+/// A panel backlight: its level, between 0 and `max`.
+pub trait Backlight: Send + Sync + 'static {
+    fn max(&self) -> u32;
+    fn get(&self) -> u32;
+    fn set(&self, level: u32);
+}
+
+/// Linux's `backlight` class.
+struct BacklightClass;
+
+type BacklightDevice = ClassDevice<BacklightClass>;
+
+impl Class for BacklightClass {
+    const NAME: &'static str = "backlight";
+    type Device = Arc<dyn Backlight>;
+
+    fn dev_attrs(&self) -> &'static [Attr<BacklightDevice>] {
+        ATTRS
+    }
+}
+
+const ATTRS: &[Attr<BacklightDevice>] = &[
+    Attr::rw("brightness", show_level, store_level),
+    Attr::ro("actual_brightness", show_level),
+    Attr::ro("max_brightness", |dev, w| {
+        writeln!(w, "{}", dev.payload().max()).map_err(|_| Error::Format)
+    }),
+    // A level the hardware applies as it is.
+    Attr::ro("type", |_dev, w| writeln!(w, "raw").map_err(|_| Error::Format)),
+];
+
+fn show_level(dev: &BacklightDevice, w: &mut dyn Write) -> aster_device::common::Result<()> {
+    writeln!(w, "{}", dev.payload().get()).map_err(|_| Error::Format)
+}
+
+fn store_level(dev: &BacklightDevice, value: &str) -> aster_device::common::Result<()> {
+    let level: u32 = value.trim().parse().map_err(|_| Error::InvalidValue)?;
+    let backlight = dev.payload();
+    if level > backlight.max() {
+        return Err(Error::InvalidValue);
+    }
+    backlight.set(level);
+    Ok(())
+}
+
+static CLASS: Once<Arc<ClassHandle<BacklightClass>>> = Once::new();
+
+/// Offers a backlight as `/sys/class/backlight/<name>`.
+fn add(name: &'static str, backlight: Arc<dyn Backlight>) {
+    let Some(class) = CLASS.get() else { return };
+    let device = BacklightDevice::builder(class, name, backlight).build();
+    if let Err(error) = aster_device::add_device(&device) {
+        ostd::warn!("could not add {}: {:?}", name, error);
+    }
+}
+
+#[init_component]
+fn init() -> Result<(), ComponentInitError> {
+    let class = class::register(BacklightClass).map_err(|_| ComponentInitError::Unknown)?;
+    CLASS.call_once(|| class);
+    intel::init();
+    Ok(())
+}
