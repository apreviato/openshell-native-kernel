rtw88/rtw8822c_fw.bin
rtw88/rtw8723d_fw.bin
rtw88/rtw8812a_fw.bin
rtw88/rtw8821a_fw.bin

# Realtek 802.11ax and 802.11be Wi-Fi (kernel/comps/rtw89): each chip's
# newest firmware format the driver reads (the BB tables, TX power and, on
# the RTL8922A, its baseband MCU's firmware are elements in the same file);
# the RTL8851BU, RTL8852AU, RTL8852BU and RTL8852CU adapters run the same.
rtw89/rtw8852a_fw-1.bin
rtw89/rtw8852b_fw-2.bin
rtw89/rtw8852bt_fw.bin
rtw89/rtw8851b_fw-1.bin
rtw89/rtw8852c_fw-2.bin
rtw89/rtw8922a_fw-4.bin

