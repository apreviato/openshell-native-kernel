<?xml version="1.0" encoding="utf-8"?>
<!-- The W4 test installer (wine-smoke.mjs): a program, its Start menu
     shortcut and a setting of the person's, as an application installs them. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="OpenShell Probe" Language="1033" Version="1.0.0" Manufacturer="OpenShell"
           UpgradeCode="6b0c2f1e-3a4d-4e5f-9a8b-1c2d3e4f5a6b">
    <Package InstallerVersion="200" Compressed="yes" />
    <Media Id="1" Cabinet="probe.cab" EmbedCab="yes" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="OpenShell Probe">
          <Component Id="Program" Guid="0e2a9d3c-5b7f-4c1e-8d2a-3f4b5c6d7e8f" Win64="yes">
            <File Id="ProbeExe" Name="probe.exe" Source="probe.exe" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="Shortcut" Guid="7c1d2e3f-4a5b-4c6d-9e8f-0a1b2c3d4e5f" Win64="yes">
          <Shortcut Id="ProbeShortcut" Name="OpenShell Probe" Target="[INSTALLDIR]probe.exe" WorkingDirectory="INSTALLDIR" />
          <RegistryValue Root="HKCU" Key="Software\OpenShell\Probe" Name="Setting" Type="string" Value="installed" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>
    <Feature Id="Main" Level="1">
      <ComponentRef Id="Program" />
      <ComponentRef Id="Shortcut" />
    </Feature>
  </Product>
</Wix>
